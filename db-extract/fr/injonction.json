        "fr-extract.jsonl": [
            {
                "entry_id": "d54bc0d5-0b8b-32b4-85eb-13919680051c",
                "word": "injonction",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9c672972-7da9-49b2-a605-3b5da3b66100",
                        "entry_id": "d54bc0d5-0b8b-32b4-85eb-13919680051c",
                        "tags": [
                            "plural"
                        ],
                        "form": "injonctions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3594a5f0-5544-35e4-b771-7d077c710b70",
                        "entry_id": "d54bc0d5-0b8b-32b4-85eb-13919680051c",
                        "glosses": [
                            "Commandement exprès, énoncé d’une manière formelle et impérative, émanant souvent de l’autorité judiciaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d61d67-509a-4b3c-8d75-462afcc2c861",
                                "sense_id": "3594a5f0-5544-35e4-b771-7d077c710b70",
                                "text": "Il paraît que le désespoir avait donné à cette courte, mais énergique injonction, un accent de menace qui résonna formidablement aux oreilles de Maurice, car il s'arrêta tout court."
                            },
                            {
                                "example_id": "6c56724f-740a-4c2c-a60b-70775f268515",
                                "sense_id": "3594a5f0-5544-35e4-b771-7d077c710b70",
                                "text": "Sa femme s’étant obstinément refusée à céder à ses injonctions, il se résigna de fort méchante humeur à vaquer à ses travaux quotidiens dans la ferme ; […]."
                            },
                            {
                                "example_id": "480ba451-1910-4b62-9f27-bf56a77bf488",
                                "sense_id": "3594a5f0-5544-35e4-b771-7d077c710b70",
                                "text": "Le notaire de Cazals m'informa qu'il avait pris cette disposition le jour où mon unique héritage familial – la maison de ma tante Agathe – venait d'être mis aux enchères sur injonction du ministère public."
                            },
                            {
                                "example_id": "7e805fa3-6e89-4217-8e6e-fd9d58a5883d",
                                "sense_id": "3594a5f0-5544-35e4-b771-7d077c710b70",
                                "text": "Et malgré l'injonction péremptoire de Socrate, il est impossible de se connaître soi-même."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbf88313-f95c-4ccd-a24c-19d0b11e6598",
                        "source_entry_id": "d54bc0d5-0b8b-32b4-85eb-13919680051c",
                        "source_sense_id": "3594a5f0-5544-35e4-b771-7d077c710b70",
                        "source_sense_description": "Commandement exprès, énoncé d’une manière formelle et impérative",
                        "target_lang_word": "Befehl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befehl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90dce275-b821-3638-baf8-413ab77a6333",
                                        "entry_id": "8fa35010-894a-3678-80b7-81eb27bb7c8a",
                                        "glosses": [
                                            "verbindliche Anweisung (bei Militär, Polizei und ähnlichen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3003aa55-4831-4c69-b377-ffd8153b79d0",
                                                "sense_id": "90dce275-b821-3638-baf8-413ab77a6333",
                                                "text": "Er gab den Befehl zum Auslaufen."
                                            },
                                            {
                                                "example_id": "50fde893-4f89-4a12-a33f-e1f0db16ff9a",
                                                "sense_id": "90dce275-b821-3638-baf8-413ab77a6333",
                                                "text": "Die Befehle des Generals kann ich nicht nachvollziehen."
                                            },
                                            {
                                                "example_id": "387ae6ec-f10b-4356-ae7e-cffd6c25aa1f",
                                                "sense_id": "90dce275-b821-3638-baf8-413ab77a6333",
                                                "text": "„Ohne Befehl hätt' ich nie gewagt, was ich gewagt hatte.“"
                                            },
                                            {
                                                "example_id": "f18276b8-dfa0-494a-b4c1-22acdb015c66",
                                                "sense_id": "90dce275-b821-3638-baf8-413ab77a6333",
                                                "text": "„Aber wir dürfen es nicht, wir müssen auf den Befehl oder wenigstens die Erlaubnis zum Treck warten, die ein bestempeltes Papier ausweist.“"
                                            },
                                            {
                                                "example_id": "b94b9cad-b14f-4c80-8b82-064b092f27ff",
                                                "sense_id": "90dce275-b821-3638-baf8-413ab77a6333",
                                                "text": "„Die zweite Gruppe von Befehlen besagt, Poniatowski solle in Richtung auf Utiza durch den Wald vorrücken und den linken russischen Flügel umgehen.“"
                                            },
                                            {
                                                "example_id": "b382fbf4-37d7-4e08-aeb9-f3c10124e07e",
                                                "sense_id": "90dce275-b821-3638-baf8-413ab77a6333",
                                                "text": "„Mir fiel ein, dieser Befehl könnte Barbaruccia oder ihrem Geliebten gelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3630a7a5-c8bf-376d-b1f5-de090e556c70",
                                        "entry_id": "8fa35010-894a-3678-80b7-81eb27bb7c8a",
                                        "glosses": [
                                            "kleinste Funktionseinheit eines Programmes in der Datenverarbeitung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e573dc0-f95e-4909-bf4f-3b8a95a433b2",
                                                "sense_id": "3630a7a5-c8bf-376d-b1f5-de090e556c70",
                                                "text": "Der Befehl lautete: print X."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d661bcc5-1e3a-471b-a88f-39ff97116126",
                        "source_entry_id": "d54bc0d5-0b8b-32b4-85eb-13919680051c",
                        "source_sense_id": "3594a5f0-5544-35e4-b771-7d077c710b70",
                        "source_sense_description": "Commandement exprès, énoncé d’une manière formelle et impérative",
                        "target_lang_word": "Weisung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weisung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ebda3c8-2e5a-3373-8506-e6392ef5ba3f",
                                        "entry_id": "fcc96116-948b-309a-8364-b3291ffdaf05",
                                        "glosses": [
                                            "verbindliche Aufforderung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aded68ef-d98c-44b7-a34f-70b4b31f82d7",
                                                "sense_id": "1ebda3c8-2e5a-3373-8506-e6392ef5ba3f",
                                                "text": "Meine Weisung lautet: Ruhe!"
                                            },
                                            {
                                                "example_id": "cb632d43-2df4-46a8-84a3-66a33a79381b",
                                                "sense_id": "1ebda3c8-2e5a-3373-8506-e6392ef5ba3f",
                                                "text": "„Jeden Dienstag gegen sechs Uhr morgens saß sie vor einem Kurzwellenempfänger und nahm Weisungen aus der Heimat entgegen.“"
                                            },
                                            {
                                                "example_id": "5365e0ed-f25e-44fe-a352-0bd6e042b6a5",
                                                "sense_id": "1ebda3c8-2e5a-3373-8506-e6392ef5ba3f",
                                                "text": "„Der Junge bestätigte die Weisung und entfernte sich mit den Stoffen.“"
                                            },
                                            {
                                                "example_id": "a28716a0-9219-4f32-9080-1d7d58206f00",
                                                "sense_id": "1ebda3c8-2e5a-3373-8506-e6392ef5ba3f",
                                                "text": "„Als er jetzt erwachte – es war Donnerstag –, da kam Saweljitsch zu ihm, um Weisungen wegen des Einpackens einzuholen.“"
                                            },
                                            {
                                                "example_id": "9e278f1a-80a8-43d8-80df-cdb559fac842",
                                                "sense_id": "1ebda3c8-2e5a-3373-8506-e6392ef5ba3f",
                                                "text": "„Ich ging zu Signor Grimani und versicherte ihm, ich würde mich stets an seine Weisungen halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0db6ae4-5d3f-3fa9-9849-7da81aa8b471",
                                        "entry_id": "fcc96116-948b-309a-8364-b3291ffdaf05",
                                        "glosses": [
                                            "Hilfestellung, Hinweis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2da80296-761e-4d8f-be70-d36d4c47f0b1",
                                                "sense_id": "b0db6ae4-5d3f-3fa9-9849-7da81aa8b471",
                                                "text": "Folgen Sie den Weisungen und Sie kommen zum Ziel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db3a4e63-92b1-45cf-a613-247c02c767c1",
                        "source_entry_id": "d54bc0d5-0b8b-32b4-85eb-13919680051c",
                        "source_sense_id": "3594a5f0-5544-35e4-b771-7d077c710b70",
                        "source_sense_description": "Commandement exprès, énoncé d’une manière formelle et impérative",
                        "target_lang_word": "Anweisung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anweisung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "749ffd1c-d235-37f9-9e95-e91720b73ad8",
                                        "entry_id": "fa394684-56ec-3a85-b2ed-d693cdf1b146",
                                        "glosses": [
                                            "Bestimmung oder Vorgabe, wer etwas bekommen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5738e051-00fa-48ac-8228-c88fa529b0e6",
                                                "sense_id": "749ffd1c-d235-37f9-9e95-e91720b73ad8",
                                                "text": "Die Anweisung einer Wohnung durch die Firma hat mir einigen Stress erspart."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff1546e3-88b8-3356-95e2-8569ae7e136b",
                                        "entry_id": "fa394684-56ec-3a85-b2ed-d693cdf1b146",
                                        "glosses": [
                                            "von einer Autorität erlassene Handlungsvorschrift; Anordnung, Befehl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "555f2bd8-4f9a-49a3-bef6-c180d6bbc066",
                                                "sense_id": "ff1546e3-88b8-3356-95e2-8569ae7e136b",
                                                "text": "Folgen Sie meiner Anweisung, sonst müssen Sie mit den Konsequenzen leben."
                                            },
                                            {
                                                "example_id": "4c45c8b0-aa95-4f39-95b4-8035db94b45d",
                                                "sense_id": "ff1546e3-88b8-3356-95e2-8569ae7e136b",
                                                "text": "„Henri schnippte mit den Fingern, der Oberkellner erschien, begrüßte Jackson Evans und nahm Henris Anweisungen entgegen.“"
                                            },
                                            {
                                                "example_id": "863c3184-a792-4baf-a395-a38fa00e3058",
                                                "sense_id": "ff1546e3-88b8-3356-95e2-8569ae7e136b",
                                                "text": "„Vor allem aber besteht die Möglichkeit, dass Flynn auf Anweisung Donald Trumps mit Sergej Kisljak sprach.“"
                                            },
                                            {
                                                "example_id": "b7b9ecf0-d2b5-4bb0-bcf6-02d30e4684df",
                                                "sense_id": "ff1546e3-88b8-3356-95e2-8569ae7e136b",
                                                "text": "„Die Gräfin gab ihren Leuten Anweisung, was sie auf ihre Fluchtwagen laden sollten.“"
                                            },
                                            {
                                                "example_id": "13b11d7e-2a7e-4862-9226-fd8c90edf2d3",
                                                "sense_id": "ff1546e3-88b8-3356-95e2-8569ae7e136b",
                                                "text": "„Sie versicherte mir, daß sie meine Anweisung getreulich befolgen werde; ich ging hinunter, ließ mich frisieren, kleidete mich an, hörte die Messe in Gegenwart des Kardinals, verließ dann den Palazzo und kehrte erst nach dem Mittagessen zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "abaa9081-45f1-312f-8111-e2aa6fdd506e",
                                        "entry_id": "fa394684-56ec-3a85-b2ed-d693cdf1b146",
                                        "glosses": [
                                            "schriftliche oder mündliche Erklärung, wie etwas durchzuführen oder zu benutzen ist; Anleitung, Gebrauchshinweis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9ea3702-46ea-4155-995f-3a6b68e8e0c0",
                                                "sense_id": "abaa9081-45f1-312f-8111-e2aa6fdd506e",
                                                "text": "In der Anweisung steht, dass erst „On“ gedrückt werden muss und dann eine beliebige Taste."
                                            },
                                            {
                                                "example_id": "1531b760-1066-4829-a01f-2618ef334bfd",
                                                "sense_id": "abaa9081-45f1-312f-8111-e2aa6fdd506e",
                                                "text": "„Die Typojis sind nicht so sehr Anweisungen zum Vorlesen, genauso wenig sind sie dazu gedacht, auf Gefühle einzustimmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "09fe44d9-4619-3e81-9eb8-e5089b305e4a",
                                        "entry_id": "fa394684-56ec-3a85-b2ed-d693cdf1b146",
                                        "glosses": [
                                            "Anordnung zur Auszahlung einer Geldsumme"
                                        ],
                                        "tags": [
                                            "Finanzwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "328b91f7-2fa2-423c-a1bf-d46c16c78b28",
                                                "sense_id": "09fe44d9-4619-3e81-9eb8-e5089b305e4a",
                                                "text": "Solange die Anweisung nicht erfolgt, schicken wir die Ware nicht los."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1d0eedd2-b305-34fc-993e-9518ef465f57",
                                        "entry_id": "fa394684-56ec-3a85-b2ed-d693cdf1b146",
                                        "glosses": [
                                            "zentrales Element imperativer Programmiersprachen"
                                        ],
                                        "tags": [
                                            "Programmierung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b904eaa8-11a9-4068-afda-3f5b61f2ec95",
                                                "sense_id": "1d0eedd2-b305-34fc-993e-9518ef465f57",
                                                "text": "Für die C0 Anweisungsüberdeckung müssen zur 100%-igen Abdeckung alle Anweisungen mindestens einmal ausgeführt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00baee25-1330-4bd8-9a26-583eda0d60de",
                        "source_entry_id": "d54bc0d5-0b8b-32b4-85eb-13919680051c",
                        "source_sense_id": "3594a5f0-5544-35e4-b771-7d077c710b70",
                        "source_sense_description": "Commandement exprès, énoncé d’une manière formelle et impérative",
                        "target_lang_word": "injunction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "injunction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1839c0ff-5e87-3724-ab52-19071f8463e6",
                                        "entry_id": "7bf4663e-ec15-35ce-8671-db42fe142802",
                                        "glosses": [
                                            "The act of enjoining; the act of directing, commanding, or prohibiting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f797a81-ff31-3ab5-9854-3298b67c3b50",
                                        "entry_id": "7bf4663e-ec15-35ce-8671-db42fe142802",
                                        "glosses": [
                                            "That which is enjoined; such as an order, mandate, decree, command, precept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76b0dbe5-0e69-4459-ac12-47b4f76a16cd",
                                                "sense_id": "9f797a81-ff31-3ab5-9854-3298b67c3b50",
                                                "text": "[…]she added, “Lizzy, I insist upon your staying and hearing Mr. Collins.” Elizabeth would not oppose such an injunction—and a moment's consideration making her also sensible that it would be wisest to get it over as soon and as quietly as possible, […]."
                                            },
                                            {
                                                "example_id": "f094f104-e1e4-4df9-9bba-d360a56796e3",
                                                "sense_id": "9f797a81-ff31-3ab5-9854-3298b67c3b50",
                                                "text": "Its verbs are conjugated in a way that defies all the injunctions of the grammar books; it has its contumacious rules of tense, number and case; […]"
                                            },
                                            {
                                                "example_id": "da16c009-9388-4335-8845-57a071e40e55",
                                                "sense_id": "9f797a81-ff31-3ab5-9854-3298b67c3b50",
                                                "text": "At the end of the Falklands war two years earlier too, the Queen, whose second son, Andrew, had served as a helicopter pilot with the task force, was singularly untriumphalist and showed no inclination to follow her prime minister’s injunction to rejoice at victory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81779dd2-7e01-3be4-82a2-c3f3b56cb787",
                                        "entry_id": "7bf4663e-ec15-35ce-8671-db42fe142802",
                                        "glosses": [
                                            "A writ or process, granted by a court of equity, and, in some cases, under statutes, by a court of law, whereby a party is required to do or to refrain from doing certain acts, according to the exigency of the writ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e18fec71-8ef4-460f-b34c-6d0a60c5a145",
                                                "sense_id": "81779dd2-7e01-3be4-82a2-c3f3b56cb787",
                                                "text": "Southwark council, which took out the injunction against Matt, believes YouTube has become the \"new playground\" for gang members."
                                            },
                                            {
                                                "example_id": "46dd861b-9215-4cfa-86d1-e857724c4baa",
                                                "sense_id": "81779dd2-7e01-3be4-82a2-c3f3b56cb787",
                                                "text": "The judges said Trump must issue new orders reflecting the permanent injunction within 10 days."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
