                                "sense_id": "7c7204c0-b256-3742-af3c-8ba11eb689db",
                                "text": "Чем ты расположил его к себе?"
                            },
                            {
                                "example_id": "9fc79be3-8ef1-4ba5-a946-c31c74080597",
                                "sense_id": "7c7204c0-b256-3742-af3c-8ba11eb689db",
