                "senses": [
                    {
                        "sense_id": "e56e0c72-de21-3a9b-bf74-352b62feae9e",
                        "entry_id": "d79e14a6-383f-373d-8c85-e6476304b091",
                        "glosses": [
                            "in die Ohrmuschel, meist ins Ohrläppchen gestochenes Loch, an dem Schmuck getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a78ba2d-1fc1-4817-b1c0-c0f6075f111d",
                                "sense_id": "e56e0c72-de21-3a9b-bf74-352b62feae9e",
                                "text": "„Mit einem Ohrloch sei er in seiner Jugend ein Rebell gewesen, heute müsse man sich dafür schon einen Bolzen in den Hintern schießen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ca05447d-00fe-348b-9faf-b8b6accc116d",
                        "entry_id": "d79e14a6-383f-373d-8c85-e6476304b091",
                        "glosses": [
                            "Öffnung des Gehörgangs nach außen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ed03f4f-26ba-4329-9a89-80d122590410",
                                "sense_id": "ca05447d-00fe-348b-9faf-b8b6accc116d",
                                "text": "„Wo immer sie einen entdecken, lassen sie sich zu Hunderten auf ihm nieder, kriechen in seine Nasen- und Ohrlöcher, krabbeln unter sein Hemd, fliegen geradewegs in seinen Mund.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
