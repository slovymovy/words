                                        "sense_id": "5bdae775-606a-3ca9-b598-afb22b33a8ed",
                                        "entry_id": "ab6af175-46a4-35cd-8b51-1c94e56decbd",
                                        "glosses": [
                                            "A country in Southern Africa. Capital: Gaborone.",
                                            "Bechuanaland, fully the Bechuanaland Protectorate, a colony of the United Kingdom from 1885 to 1966"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9d284de-8b89-3610-8843-2f4b1acf53eb",
                                        "entry_id": "ab6af175-46a4-35cd-8b51-1c94e56decbd",
                                        "glosses": [
                                            "A country in Southern Africa. Capital: Gaborone.",
                                            "The Republic of Botswana, since 1966."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7971da48-9a69-4283-ae3a-c7470f2c0384",
                                                "sense_id": "b9d284de-8b89-3610-8843-2f4b1acf53eb",
                                                "text": "After independence, Rhodesia changed its name to Zimbabwe, Nyasaland to Malawi, and Bechuanaland to Botswana."
                                            },
                                            {
                                                "example_id": "85fe63f7-9f18-4955-afe4-5e56b336f47a",
                                                "sense_id": "b9d284de-8b89-3610-8843-2f4b1acf53eb",
                                                "text": "According to Masisi, Botswana has seen its elephant population grow to some 130,000."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
