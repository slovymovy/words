                                    {
                                        "sense_id": "a6209b37-b314-3028-b2a8-5465d6f18b7c",
                                        "entry_id": "84884955-74d0-3159-be28-82bb2d3e1632",
                                        "glosses": [
                                            "An attempt at something."
