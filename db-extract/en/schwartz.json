                    {
                        "translation_id": "10c20104-1d10-4049-aace-38ea97622da1",
                        "source_entry_id": "d8789024-f120-3cdb-9e00-50788acb6cd5",
                        "source_sense_id": "cd591d7d-9102-3348-a538-50e39fa6cb7d",
                        "source_sense_description": "surname",
