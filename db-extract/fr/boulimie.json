                                "target_senses": [
                                    {
                                        "sense_id": "e6fb8dec-842e-3e38-8244-9197c92a8b71",
                                        "entry_id": "4cce2d7d-ee2c-33e0-a60f-c196bbdd4709",
                                        "glosses": [
                                            "Essstörung, bei der ein Patient immer wieder zwischen Esssucht und Erbrechen schwankt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a73ec7ab-d542-46c6-b217-e38895d0c3af",
                                                "sense_id": "e6fb8dec-842e-3e38-8244-9197c92a8b71",
                                                "text": "„Sie entwickelte Bulimie, richtete ihre Aggressionen gegen den eigenen Körper statt gegen die als unzulänglich erlebten Eltern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
