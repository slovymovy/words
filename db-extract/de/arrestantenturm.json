                "senses": [
                    {
                        "sense_id": "83633f8c-2b85-30b8-b8ef-1cf1e6b1fa69",
                        "entry_id": "de0980e8-04fc-38ec-87b3-472bd9dbd3be",
                        "glosses": [
                            "ein Turm in vielen mittelalterlichen Burgen, in denen Arrestanten festgesetzt wurden"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "39e48e3f-920f-41a9-bdf6-db546c907ca1",
                                "sense_id": "83633f8c-2b85-30b8-b8ef-1cf1e6b1fa69",
                                "text": "„Hinter der Zisterne im Hof ragen links das Zeughaus, rechts der Schüttkasten auf, dazwischen steht der Arrestantenturm.“"
                            },
                            {
                                "example_id": "ebe198fe-0026-4426-9841-8afce6a80c80",
                                "sense_id": "83633f8c-2b85-30b8-b8ef-1cf1e6b1fa69",
                                "text": "„Um jene Zeit hieß der Turm auch Arrestantenturm (1745, 1760). Dem Freiherrn vom Stein wurde erlaubt, die in den Langenauer Waldungen gefaßten Frevler auf Requisition des gemeinschaftlichen Amtes Nassau in den Grauen Turm einsperren zu lassen (1788).“"
                            },
                            {
                                "example_id": "5605eae7-2203-4357-a9a7-7478ed5cd928",
                                "sense_id": "83633f8c-2b85-30b8-b8ef-1cf1e6b1fa69",
                                "text": "Joseph Süß Oppenheimer (1698 - 1738), verunglimpft als „Jud Süß“, wurde unschuldig im Arrestantenturm der Burg Hohenneuffen gefangen gehalten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
