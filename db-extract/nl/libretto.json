                                    {
                                        "sense_id": "e7d031cb-c656-37e5-b6a7-7de38e5bc1ab",
                                        "entry_id": "6758bb44-83db-3abb-9eaf-289780cc3061",
                                        "glosses": [
                                            "The text of a dramatic musical work, such as an opera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64f5731c-9295-41b9-a828-885daab3a950",
                                                "sense_id": "e7d031cb-c656-37e5-b6a7-7de38e5bc1ab",
                                                "text": "From Mozart's letters we know that the composer decided to enlarge the part of Osmin, the harem keeper, because the originator of the part, Ludwig Fischer, had a freakishly low bass voice that Mozart wanted to exploit. Osmin's principal arias and ensembles were duly lengthened beyond what appeared in the original libretto, and he was given yet another song in the third act."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48f36292-0792-3ad6-9929-dedb715ea655",
                                        "entry_id": "6758bb44-83db-3abb-9eaf-289780cc3061",
                                        "glosses": [
                                            "A book containing such a text."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
