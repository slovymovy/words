                    "sense_definition": "Zich verzamelen of elkaar ontmoeten op een afgesproken plek",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hele familie zal met kerst bij ons thuis <w>samenkomen</w>.",
                            "target_lang_translations": {
                                "en": "The whole family will <w>gather</w> at our home for Christmas.",
                                "ru": "Вся семья <w>соберётся</w> у нас дома на Рождество.",
                                "pl": "Cała rodzina <w>zbierze się</w> u nas w domu na święta.",
                                "de": "Die ganze Familie wird zu Weihnachten bei uns zu Hause <w>zusammenkommen</w>.",
                                "fr": "Toute la famille va <w>se réunir</w> chez nous pour Noël.",
                                "it": "Tutta la famiglia si <w>riunirà</w> a casa nostra per Natale.",
                                "cs": "Celá rodina se o Vánocích <w>sejde</w> u nás doma.",
                                "tr": "Tüm aile Noel'de evimizde <w>toplanacak</w>.",
                                "es": "Toda la familia se <w>reunirá</w> en nuestra casa por Navidad.",
                                "zh": "圣诞节时，全家人都会到我们家<w>聚会</w>。"
                            }
                        },
                        {
                            "text": "We moeten binnenkort weer eens <w>samenkomen</w> om bij te praten.",
                            "target_lang_translations": {
                                "en": "We should <w>get together</w> again soon to catch up.",
                                "ru": "Нам нужно скоро снова <w>встретиться</w>, чтобы поболтать.",
                                "pl": "Musimy się wkrótce znowu <w>spotkać</w>, żeby porozmawiać.",
                                "de": "Wir sollten uns bald wieder einmal <w>treffen</w>, um uns auszutauschen.",
                                "fr": "Nous devons <w>nous retrouver</w> bientôt pour discuter.",
                                "it": "Dobbiamo <w>ritrovarci</w> presto per fare due chiacchiere.",
                                "cs": "Musíme se brzy zase <w>sejít</w>, abychom si popovídali.",
                                "tr": "Yakında sohbet etmek için tekrar <w>bir araya gelmeliyiz</w>.",
                                "es": "Tenemos que <w>juntarnos</w> pronto otra vez para ponernos al día.",
                                "zh": "我们应该找个时间再<w>见面</w>聊聊。"
                            }
                        }
