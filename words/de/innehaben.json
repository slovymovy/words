                {
                    "sense_id": "627f55d5-8836-3df0-86ba-a2eea6bf226a",
                    "sense_definition": "eine bestimmte Funktion, ein Amt oder eine offizielle Stellung ausüben und besitzen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "amt_ausueben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Herr Müller <w>hat</w> das Amt des Bürgermeisters seit über zehn Jahren <w>inne</w>."
                        },
                        {
                            "text": "Sie möchte sich beruflich verändern und eine leitende Position im Unternehmen <w>innehaben</w>."
                        }
                    ],
                    "synonyms": [
                        "bekleiden",
                        "einnehmen"
                    ],
                    "common_phrases": [
                        "ein Amt innehaben",
                        "eine Position innehaben",
                        "einen Posten innehaben"
                    ]
                },
                {
                    "sense_id": "56a90b52-e1f4-3529-8a84-ecd7b7bacf8b",
                    "sense_definition": "über etwas verfügen oder eine Räumlichkeit bewohnen und nutzen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "besitz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nachdem die Mieter die Wohnung drei Jahre lang <w>innehatten</w>, zogen sie in ein Haus."
                        },
                        {
                            "text": "Die Familie darf das Anwesen bis zum Ende des Jahres weiterhin rechtmäßig <w>innehaben</w>."
                        }
                    ],
                    "synonyms": [
                        "besitzen"
                    ],
                    "common_phrases": [
