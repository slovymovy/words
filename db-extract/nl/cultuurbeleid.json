                        "examples": [
                            {
                                "example_id": "151b4c5c-d0d3-4b6d-87e0-c72cb2bbd3f9",
                                "sense_id": "5d0824b4-1bee-3b7d-8fbd-8a42a59e68f6",
                                "text": "Dinsdagavond zit Van Spiegel in theater De Kappen aan tafel met culturele verenigingen. Zij kunnen hun mening geven over het cultuurbeleid in Haaksbergen. \"De praatsessie is voor alle mensen, die een mening over cultuur hebben. We willen inspiratie opdoen\", aldus cultuurwethouder Edith Van Spiegel."
                            },
                            {
                                "example_id": "6f225571-04a7-46d5-921f-7679ecd0af7a",
                                "sense_id": "5d0824b4-1bee-3b7d-8fbd-8a42a59e68f6",
                                "text": "De voorzitter van de Raad voor Cultuur, ooit zelf cultuurwethouder van Enschede, sluit met haar oproep aan bij het advies van haar eigen Raad. Die pleitte vorig jaar voor een grotere rol van de stedelijke regio’s in het cultuurbeleid. Minister van OCW Ingrid van Engelshoven komt later deze maand met een notitie over het cultuurbeleid van het nieuwe kabinet in de komende vier jaar."
                            }
                        ]
