                "senses": [
                    {
                        "sense_id": "48f7a37a-ebea-3cac-a8c0-071137083a9c",
                        "entry_id": "103c2006-6d87-38b6-9515-402ba32d2503",
                        "glosses": [
                            "Baum, der Marillen als Früchte trägt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "25757ca5-996f-47b7-9761-8ce2704ce6ac",
                                "sense_id": "48f7a37a-ebea-3cac-a8c0-071137083a9c",
                                "text": "In der Wachau wachsen viele Marillenbäume."
                            },
                            {
                                "example_id": "2750ada9-4201-4e34-b0ed-8121ce1c262f",
                                "sense_id": "48f7a37a-ebea-3cac-a8c0-071137083a9c",
                                "text": "„Die Marillenbäume verwandeln das Tal jedes Jahr im April in ein rosa-weißes Blütenmeer.“"
                            },
                            {
                                "example_id": "d6ae28ed-4dd2-498f-8319-44c7491ca193",
                                "sense_id": "48f7a37a-ebea-3cac-a8c0-071137083a9c",
                                "text": "„Ein Mandelbaum hat schon zartgrüne Triebe, der Marillenbaum ist bereits in voller Blüte.“"
                            },
                            {
                                "example_id": "1ea5b26f-d1fc-4bd6-9f48-d6f3b4b4629a",
                                "sense_id": "48f7a37a-ebea-3cac-a8c0-071137083a9c",
                                "text": "„Er ist Obmann des Vereins Wachauer Marille und bewirtschaftet nahe Aggsbach 1.200 Marillenbäume.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
