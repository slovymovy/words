                                "example_id": "f70ea0df-7e1a-4300-af63-402f429ab125",
                                "sense_id": "832104cc-3160-33ee-8fae-bc538b00bf99",
                                "text": "Bohater moralitetu pozbawiony był wszelkich cech jednostkowych, narodowych itp. i stanowił uosobienie całej ludzkości"
                            }
