                    {
                        "translation_id": "840f0433-e823-4d40-97c2-f32cb2250fe2",
                        "source_entry_id": "69801734-57c6-3823-a7ef-f90a26605dc9",
                        "source_sense_description": "one of the chief divisions of a long poem",
                        "target_lang_word": "Gesang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79243287-8a6c-3e2a-a30b-1c5acfd0c281",
                                        "entry_id": "7a6a1220-1dce-36f2-ac7b-764463a5c8a6",
                                        "glosses": [
                                            "Gebrauch der Stimme zur Klang- und Melodieerzeugung durch Menschen oder bestimmte Tiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f33156a5-2c66-42a5-807c-e8940ac9ce3d",
                                                "sense_id": "79243287-8a6c-3e2a-a30b-1c5acfd0c281",
                                                "text": "Der Gesang hat allen Zuhörern gefallen."
                                            },
                                            {
                                                "example_id": "2bdfb7b2-89bc-45d8-a7e7-a55f756d17fc",
                                                "sense_id": "79243287-8a6c-3e2a-a30b-1c5acfd0c281",
                                                "text": "„Die Wilden sangen eine Weile - wenn man ihren zittrigen, von Zungenschnalzen und Zähneklappern unterbrochenen Singsang als Gesang bezeichnen konnte, in dem die gellenden Frauenstimmen das Gebrummel der Männer übertönten.“"
                                            },
                                            {
                                                "example_id": "b75ed08c-8caf-45f4-b12b-57e88a527693",
                                                "sense_id": "79243287-8a6c-3e2a-a30b-1c5acfd0c281",
                                                "text": "„Ich wachte auf von einem Gesang nebenan.“"
                                            },
                                            {
                                                "example_id": "cced9c73-46bf-4335-aa63-ef1140093e3b",
                                                "sense_id": "79243287-8a6c-3e2a-a30b-1c5acfd0c281",
                                                "text": "„Der Gesang schwoll an, sammelte allen Aufruhr der See, des goldenen Sonnentreibens, wetteiferte mit dem Wind und schleuderte Töne in den Raum wie die Brücke eines Regenbogens.“"
                                            },
                                            {
                                                "example_id": "e2a09876-a286-4121-a1b3-d75c5eca9ece",
                                                "sense_id": "79243287-8a6c-3e2a-a30b-1c5acfd0c281",
                                                "text": "„Die Musiker schienen ihn vom Konzert her zu kennen; offenbar hatte sein Gesang ihnen gefallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a3be72e-1165-37ad-a96b-b3ac2c052980",
                                        "entry_id": "7a6a1220-1dce-36f2-ac7b-764463a5c8a6",
                                        "glosses": [
                                            "Vertonte Dichtung, Lied"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d324bbde-6763-439f-81d7-9eafbb79a83c",
                                                "sense_id": "7a3be72e-1165-37ad-a96b-b3ac2c052980",
                                                "text": "Die Gesänge der Afrikaner erzählen von der Schöpfung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "90200ae6-ac55-3fed-a460-27564cbaac02",
                                        "entry_id": "7a6a1220-1dce-36f2-ac7b-764463a5c8a6",
                                        "glosses": [
                                            "Kapitel/Abschnitt eines Dichtwerks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "566e4fc1-496e-4e02-82ca-f55e7f0e0d2e",
                                                "sense_id": "90200ae6-ac55-3fed-a460-27564cbaac02",
                                                "text": "„Sie fragte mich, ob der dreizehnte Gesang der Äneis von Signor Vegio schön sei.“"
                                            },
                                            {
                                                "example_id": "0ef446c9-e3ba-441a-9f38-325163a685e1",
                                                "sense_id": "90200ae6-ac55-3fed-a460-27564cbaac02",
                                                "text": "„Mehrfach hat Wieland den »Oberon« überarbeitet, am Ende hat er statt vierzehn nur zwölf Gesänge, die Zwölfzahl ist »klassischer«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f061b06-12d4-44a3-a85c-91c058c941c6",
