                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02290138-556e-40af-a184-a5f86f0d5073",
                                "sense_id": "94718214-b8d9-3410-8075-f2551436b083",
                                "text": "Ce dernier sentiment était si fort qu’on est allé jusqu’à envisager de démécaniser l’industrie pour lui faire employer plus de main-d'œuvre."
                            },
                            {
                                "example_id": "e32de69f-8c2b-4158-8fd2-f5ff4909eddc",
                                "sense_id": "94718214-b8d9-3410-8075-f2551436b083",
                                "text": "Il n’entend pas nier ce Jeu des parallèles pour lui substituer quelque fantaisie poétique, mais le démécaniser et le nuancer."
                            }
                        ]
                    }
