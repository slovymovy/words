                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8405f66-1132-44f9-83ae-0954e877ef6d",
                                "sense_id": "f5906caa-717e-39e2-bbfc-d221ec7da6ea",
                                "text": "Het was een turbulent jaar."
                            },
                            {
                                "example_id": "8df6b062-33de-4cd2-8b01-17d5acbf9781",
                                "sense_id": "f5906caa-717e-39e2-bbfc-d221ec7da6ea",
                                "text": "Liesbeth heeft een turbulente jeugd gehad en veel meegemaakt, maar iedere keer wist ze zich hieruit te vechten en is ze doorgegaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d7587fc-e646-331f-b0d3-f91d63d87d61",
                        "entry_id": "f12332ed-1796-32c0-9bdc-484d5ad40088",
                        "glosses": [
                            "met veel onbedoelde extra beweging, m.n. van vliegtuigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b27b92b-3ba8-4164-a60e-984a5de8dadb",
                                "sense_id": "0d7587fc-e646-331f-b0d3-f91d63d87d61",
                                "text": "Het vliegtuig maakte een turbulente landing."
                            }
                        ]
