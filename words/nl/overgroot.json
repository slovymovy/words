    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fc3890ec-3ef8-3dc8-aefe-f2e424aebe86",
                    "sense_definition": "een ruime meerderheid vormend",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>overgroot</w> deel van de stemmers wijst het nieuwe voorstel direct af.",
                            "target_lang_translations": {
                                "en": "A <w>vast</w> majority of the voters rejects the new proposal immediately."
                            }
                        },
                        {
                            "text": "De <w>overgrote</w> meerderheid van de bevolking is tevreden met de huidige situatie.",
                            "target_lang_translations": {
                                "en": "The <w>overwhelming</w> majority of the population is satisfied with the current situation."
                            }
                        }
                    ],
                    "common_phrases": [
                        "overgrote meerderheid",
                        "overgroot deel"
                    ],
                    "target_lang_definitions": {
                        "en": "forming a large majority or the vast part of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vast",
                                "target_lang_sense_clarification": "referring to a large majority or portion"
                            },
                            {
                                "target_lang_word": "overwhelming",
                                "target_lang_sense_clarification": "referring to a majority that is much larger than others"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c39396e-2420-3077-9ba9-119da8c007a4",
                    "sense_definition": "zeer omvangrijk of buitengewoon groot",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "omvang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn vreugde was <w>overgroot</w> toen hij hoorde dat hij de prijs had gewonnen.",
                            "target_lang_translations": {
                                "en": "His joy was <w>immense</w> when he heard that he had won the prize."
                            }
                        },
                        {
                            "text": "De impact van deze ontdekking op de wetenschap is werkelijk <w>overgroot</w>.",
                            "target_lang_translations": {
                                "en": "The impact of this discovery on science is truly <w>enormous</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "reuzegroot",
                        "supergroot"
                    ],
                    "antonyms": [
                        "minuscuul",
                        "piepklein"
                    ],
                    "target_lang_definitions": {
                        "en": "very extensive or extraordinarily large"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "immense",
                                "target_lang_sense_clarification": "extremely large or great in size or scale"
                            },
                            {
                                "target_lang_word": "enormous",
                                "target_lang_sense_clarification": "very large in size, quantity, or extent"
                            },
                            {
                                "target_lang_word": "huge",
                                "target_lang_sense_clarification": "extremely large"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b574e5b0-9dd6-34b3-a1d3-827d044e7b23",
                    "sense_definition": "te omvangrijk of buitensporig groot",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "omvang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stad bleef groeien tot ze <w>overgroot</w> werd en onbestuurbaar bleek.",
                            "target_lang_translations": {
                                "en": "The city continued to grow until it became <w>oversized</w> and proved ungovernable."
                            }
                        },
                        {
                            "text": "Door de <w>overgrote</w> belangstelling moesten we de deuren van de zaal sluiten.",
                            "target_lang_translations": {
                                "en": "Due to the <w>excessive</w> interest, we had to close the doors of the hall."
                            }
                        }
                    ],
                    "common_phrases": [
                        "overgrote belangstelling"
                    ],
                    "target_lang_definitions": {
                        "en": "too large or excessively big"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oversized",
                                "target_lang_sense_clarification": "larger than the usual or necessary size"
                            },
                            {
                                "target_lang_word": "excessive",
                                "target_lang_sense_clarification": "more than is necessary, normal, or desirable"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}