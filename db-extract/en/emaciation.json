                    {
                        "translation_id": "cd97b56e-eba3-462c-8a69-0ea04a19b7ab",
                        "source_entry_id": "2f4dfb3d-e282-3122-bdbe-3ec24bc7bb69",
                        "source_sense_description": "the act of making very lean",
