                ],
                "senses": [
                    {
                        "sense_id": "3801c451-1581-3dfb-9d9a-062ec6b157ca",
                        "entry_id": "b8ddba80-ef14-3a75-a751-795f6320f4c0",
                        "glosses": [
                            "Altstoffsammelzentrum"
                        ],
                        "tags": [
                            "Wien"
                        ],
                        "examples": [
                            {
                                "example_id": "aa361b4e-f58f-4033-826a-eed3d3f6fe37",
                                "sense_id": "3801c451-1581-3dfb-9d9a-062ec6b157ca",
                                "text": "„Die Mistplätze haben Montag bis Samstag (werktags) von 7 bis 18 Uhr geöffnet.“"
                            },
                            {
                                "example_id": "e154a834-14d9-4199-a148-d6de8e90ae89",
                                "sense_id": "3801c451-1581-3dfb-9d9a-062ec6b157ca",
                                "text": "„1913 fand die Hakoah am Floridsdorfer ‚Birnerplatz‘ (An der oberen Alten Donau 47) eine erste Heimstätte, die sich aber alsbald zu klein und zu unpraktisch für die Ausübung von Wettkämpfen erwies; der Platz lag in unmittelbarer Nähe zu einem großen Mistplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f7df4f17-5a1b-358a-b455-8f380e62fbc1",
                        "entry_id": "b8ddba80-ef14-3a75-a751-795f6320f4c0",
                        "glosses": [
                            "Ort, an dem der Mist der Tiere anfällt oder gesammelt wird"
                        ],
                        "tags": [
                            "Tierhaltung"
                        ],
                        "examples": [
                            {
                                "example_id": "bc294b99-c786-4213-9bea-087b0d5cf5c1",
                                "sense_id": "f7df4f17-5a1b-358a-b455-8f380e62fbc1",
                                "text": "Bei Trennung in Liege- und Mistplatz braucht nur der Liegeplatz wärmedämmend ausgeführt zu werden."
                            },
                            {
                                "example_id": "b8af6673-6180-40d8-a0b0-de036b2a58e8",
                                "sense_id": "f7df4f17-5a1b-358a-b455-8f380e62fbc1",
                                "text": "Die Kastenlänge beträgt 1,8-20 m (teilperforierter Mistplatz) mit 2% Gefälle auf dem 0,9 m langen planbefestigten Boden und ohne Gefälle der Gußroste bzw. den Betonelementen."
                            },
                            {
                                "example_id": "e24d39c0-f8ba-45d4-a6af-80be2fda53fc",
                                "sense_id": "f7df4f17-5a1b-358a-b455-8f380e62fbc1",
                                "text": "Die Bucht besteht aus einem Liegeplatz von 2,5 m Tiefe und einem Freß- und Mistplatz."
                            },
                            {
                                "example_id": "59e1212f-5315-46a2-a3fd-15e461bfacce",
                                "sense_id": "f7df4f17-5a1b-358a-b455-8f380e62fbc1",
                                "text": "Als Normalmaße für einen Pferdestall mit Kuttergang werden angegeben: Düngergang 1.50, Jaucherinne 0,20, Standlänge inkl. Mistplatz 2,50 — 3,00."
                            },
                            {
                                "example_id": "c0576a94-2679-4660-859c-c7c822de8cbe",
                                "sense_id": "f7df4f17-5a1b-358a-b455-8f380e62fbc1",
                                "text": "Das erste, was zur Erzeugung guten Düngers erfodert wird, ist ein guter Mistplatz, der nicht zu trocken und nicht zu naß ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
