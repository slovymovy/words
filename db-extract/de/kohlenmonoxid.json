                ],
                "senses": [
                    {
                        "sense_id": "dc29f3dd-79f4-3e18-86ff-1be9b786616c",
                        "entry_id": "983f1164-148a-3f37-92cc-c2e3f7e7e8a8",
                        "glosses": [
                            "sehr giftiges, farbloses, geruchloses und geschmackloses Gas, das bei unvollständiger Verbrennung entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319ae12b-19cd-47e7-87a7-718acfb0b0b4",
                                "sense_id": "dc29f3dd-79f4-3e18-86ff-1be9b786616c",
                                "text": "Kohlenmonoxid ist geschmacks- und geruchlos, und entsteht durch den Abgasrückstau bei unzureichender Zuluft."
                            },
                            {
                                "example_id": "0163e1b0-fc80-4651-bc17-d78e529ffbc7",
                                "sense_id": "dc29f3dd-79f4-3e18-86ff-1be9b786616c",
                                "text": "Kohlenmonoxid (CO) entsteht hauptsächlich bei der unvollständigen Verbrennung von Brenn- und Treibstoffen."
                            },
                            {
                                "example_id": "cb20ef63-9816-4007-8e2d-e920007ab424",
                                "sense_id": "dc29f3dd-79f4-3e18-86ff-1be9b786616c",
                                "text": "Kohlenmonoxid ist ein hochgiftiges Atemgas, das für ahnungslose Menschen eine oftmals unterschätzte Gefahr darstellt."
                            },
                            {
                                "example_id": "e07d8b04-dd5e-4aa0-835a-c7fcb99d9e3a",
                                "sense_id": "dc29f3dd-79f4-3e18-86ff-1be9b786616c",
                                "text": "Das menschliche Blut nimmt Kohlenmonoxid etwa 300 Mal schneller als Sauerstoff auf."
                            },
                            {
                                "example_id": "4641e663-2221-416a-a4ff-56009e79ea80",
                                "sense_id": "dc29f3dd-79f4-3e18-86ff-1be9b786616c",
                                "text": "Die sechs Freunde im Alter von 18 und 19 Jahren hatten das Kohlenmonoxid bei einer Feier in einer Gartenlaube in Arnstein in der Nacht zum Sonntag eingeatmet und waren gestorben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
