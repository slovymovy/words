                {
                    "sense_id": "61647c10-289e-3055-92db-f2d1462f018b",
                    "sense_definition": "A single operation of a processor defined by an instruction set architecture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer processor executes millions of <w>instructions</w> every second.",
                            "target_lang_translations": {
                                "ru": "Компьютерный процессор выполняет миллионы <w>инструкций</w> каждую секунду.",
                                "pl": "Procesor komputerowy wykonuje miliony <w>instrukcji</w> na sekundę.",
                                "zh": "计算机处理器每秒执行数百万条<w>指令</w>。"
                            }
                        },
                        {
                            "text": "A bug in the software caused an illegal <w>instruction</w> error.",
                            "target_lang_translations": {
                                "ru": "Ошибка в программном обеспечении вызвала ошибку недопустимой <w>инструкции</w>.",
                                "pl": "Błąd w oprogramowaniu spowodował błąd niedozwolonej <w>instrukcji</w>.",
                                "zh": "软件中的一个漏洞导致了非法<w>指令</w>错误。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "instruction set",
                        "execute an instruction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единичная операция процессора, определенная архитектурой набора команд",
                        "pl": "Pojedyncza operacja procesora zdefiniowana przez architekturę listy rozkazów.",
                        "zh": "由指令集架构定义的处理器单一操作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инструкция",
                                "target_lang_sense_clarification": "команда процессора"
                            },
                            {
                                "target_lang_word": "команда",
                                "target_lang_sense_clarification": "вычислительная операция"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "instrukcja",
                                "target_lang_sense_clarification": "polecenie dla procesora"
                            },
                            {
                                "target_lang_word": "rozkaz",
                                "target_lang_sense_clarification": "podstawowa operacja procesora"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指令",
                                "target_lang_sense_clarification": "计算机程序命令"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02a4c346-afd9-3cfe-ac49-24dc0e8cebe8",
                    "sense_definition": "The directions given by a client to their lawyer in relation to a particular legal matter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The solicitor took <w>instructions</w> from his client before proceeding with the case.",
                            "target_lang_translations": {
                                "ru": "Адвокат получил <w>указания</w> от своего клиента, прежде чем приступить к делу.",
                                "pl": "Adwokat przyjął <w>instrukcje</w> od swojego klienta przed podjęciem dalszych kroków w sprawie.",
                                "zh": "律师在继续处理案件前，先听取了客户的<w>指示</w>。"
                            }
                        },
                        {
                            "text": "He acted on the <w>instructions</w> of the defense attorney.",
                            "target_lang_translations": {
                                "ru": "Он действовал по <w>указаниям</w> адвоката защиты.",
                                "pl": "Działał zgodnie z <w>wytycznymi</w> obrońcy.",
                                "zh": "他按照辩护律师的<w>指示</w>行事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "take instructions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указания, даваемые клиентом своему юристу в отношении конкретного дела",
                        "pl": "Wytyczne lub pełnomocnictwo przekazywane przez klienta swojemu prawnikowi w odniesieniu do konkretnej sprawy.",
                        "zh": "客户就特定法律事务给予律师的指示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указание",
                                "target_lang_sense_clarification": "поручение клиентом"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "instrukcja",
                                "target_lang_sense_clarification": "wytyczne klienta dla prawnika"
                            },
                            {
                                "target_lang_word": "dyspozycja",
                                "target_lang_sense_clarification": "polecenie klienta dotyczące prowadzenia sprawy"
                            }
                        ],
                        "zh": [
