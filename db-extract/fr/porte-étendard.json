        "fr-extract.jsonl": [
            {
                "entry_id": "0eef183a-2b34-3ff1-b276-fe8614c5f1ea",
                "word": "porte-étendard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f2a88ba0-3038-4809-a8c0-f76b5851a48f",
                        "entry_id": "0eef183a-2b34-3ff1-b276-fe8614c5f1ea",
                        "tags": [
                            "plural"
                        ],
                        "form": "porte-étendards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd93e913-646f-31ed-bea3-dcece4e0acd2",
                        "entry_id": "0eef183a-2b34-3ff1-b276-fe8614c5f1ea",
                        "glosses": [
                            "Soldat qui porte l’étendard dans un corps de cavalerie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0de1f4be-6174-4ad8-9725-71c8fe2d88a7",
                                "sense_id": "dd93e913-646f-31ed-bea3-dcece4e0acd2",
                                "text": "Nous donnons la reproduction de deux porte-étendard et porte-parasol, copiés d'après une estampe originale venant du Japon."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2fd83fa-5009-335f-a5d3-4ef37d261ac2",
                        "entry_id": "0eef183a-2b34-3ff1-b276-fe8614c5f1ea",
                        "glosses": [
                            "Représentant le plus en vue d’une cause, d’un groupe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b2bc49-ba60-478b-bd09-5ee869bb92f4",
                                "sense_id": "d2fd83fa-5009-335f-a5d3-4ef37d261ac2",
                                "text": "L’image du pesant bourgeois ploutocrate, faisant régner à la fois autour de lui le luxe et l’austérité, nous poursuit depuis des siècles dans toutes les Sorties de la Garde civique et les Banquets de confréries, diversifiée çà et là par celle d’un jeune porte-étendard, beau comme saint Michel, que n’ont pas encore alourdi la graisse et l’argent."
                            },
                            {
                                "example_id": "5cfef848-6fca-4179-a5c3-484a0823488f",
                                "sense_id": "d2fd83fa-5009-335f-a5d3-4ef37d261ac2",
                                "text": "Éric est le porte-étendard de l’info ici."
                            },
                            {
                                "example_id": "335c7066-bafb-4b73-8080-34b5e1cc4a85",
                                "sense_id": "d2fd83fa-5009-335f-a5d3-4ef37d261ac2",
                                "text": "Écologique, Avatar? Bien au contraire, les plus récentes technologies du cinéma, et Avatar en est le porte-étendard, concourent à produire une irrésistible \"technologie de l’imaginaire\", qui, dans ce cas précis, comble du scandale, table sur l’écologisme pour mieux attirer les spectateurs-cyborgs et leur argent-sève, tant et si bien que le monde humain devient irréalisé, désécologisé."
                            }
                        ]
                    },
                    {
                        "sense_id": "42ab23c3-58e8-363e-aaad-f86fe4c03184",
                        "entry_id": "0eef183a-2b34-3ff1-b276-fe8614c5f1ea",
                        "glosses": [
                            "Pièce de cuir attachée à la selle, pour soutenir la hampe de l’étendard."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eeec6ac1-6057-3767-ae28-2f3917bc3128",
                        "entry_id": "0eef183a-2b34-3ff1-b276-fe8614c5f1ea",
                        "glosses": [
                            "Mât destiné à soutenir un étendard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be8ac68-d04f-43f2-a671-052c2507203f",
                                "sense_id": "eeec6ac1-6057-3767-ae28-2f3917bc3128",
                                "text": "Il est attaché par une longue laisse à l’un des porte-étendard de bronze dressés devant Saint-Marc et veille avec un soin jaloux sur le pardessus de son maître, sa canne, son étui à jumelles, toute une nature morte de voyageur 1900."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dad7865-b5f4-45fb-9a0a-019f78f986c7",
                        "source_entry_id": "0eef183a-2b34-3ff1-b276-fe8614c5f1ea",
                        "source_sense_description": "soldat",
                        "target_lang_word": "standard-bearer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "standard-bearer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c356cf6-fdcf-3ed0-abcb-4a67bd26f430",
                                        "entry_id": "a3fd45e2-c34f-3714-b81f-3d1e70f87259",
                                        "glosses": [
                                            "A person who carries a flag or banner (a standard)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09e8c0be-d0f7-4ae2-a8e5-e43caad68cf5",
                                                "sense_id": "4c356cf6-fdcf-3ed0-abcb-4a67bd26f430",
                                                "text": "The standard-bearer in battle is in the center of the front line so the following troops know where to go; unfortunately, it also shows the enemy where to shoot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07f5d050-3ca8-36be-a1d8-03b72b42c9bb",
                                        "entry_id": "a3fd45e2-c34f-3714-b81f-3d1e70f87259",
                                        "glosses": [
                                            "A person who visibly leads."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88008794-cda6-415b-99a4-1fb7f7a4e6ff",
                                                "sense_id": "07f5d050-3ca8-36be-a1d8-03b72b42c9bb",
                                                "text": "He became the standard-bearer for their cause because of his celebrity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc10ee58-468e-47c3-b551-6e41c76c3f0f",
                        "source_entry_id": "0eef183a-2b34-3ff1-b276-fe8614c5f1ea",
                        "source_sense_description": "soldat",
                        "target_lang_word": "flag carrier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flag carrier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aaa900a-0290-39ed-905e-dc27d9213852",
                                        "entry_id": "38954457-81f2-3bd7-9277-5e3e2a7b0600",
                                        "glosses": [
                                            "A person carrying a standard or flag, usually at sporting events and parades, previously on the battlefield."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17ba99f6-00ec-3137-820b-742a58ed0b17",
                                        "entry_id": "38954457-81f2-3bd7-9277-5e3e2a7b0600",
                                        "glosses": [
                                            "A strong supporter of a cause, or perhaps the strongest and most visible supporter of said cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a8def90-2ec0-4a64-9a1e-aad6c4511e29",
                                                "sense_id": "17ba99f6-00ec-3137-820b-742a58ed0b17",
                                                "text": "Bill was the flag carrier of the movement to improve inner city education."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56399894-a47d-3f4e-95a7-e9892034c31b",
                                        "entry_id": "38954457-81f2-3bd7-9277-5e3e2a7b0600",
                                        "glosses": [
                                            "A transportation company, such as a shipping or airline company, that is registered in a given state."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26a86d44-0b22-3fc7-a4c8-3228c29e28f2",
                                        "entry_id": "38954457-81f2-3bd7-9277-5e3e2a7b0600",
                                        "glosses": [
                                            "A national airline (typically having the flag, or other national insignia, on the tail)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e56345c-5f5e-4962-b1c8-427adf6bcc04",
                                                "sense_id": "26a86d44-0b22-3fc7-a4c8-3228c29e28f2",
                                                "text": "I'll be interested to see how this service does. It will be basic with fares to match, so will be akin to a budget airline taking on a flag-carrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "610f7bad-a4f4-3f04-9508-74b51e04bc51",
                                        "entry_id": "38954457-81f2-3bd7-9277-5e3e2a7b0600",
                                        "glosses": [
                                            "An aircraft carrier serving as a flagship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97f20f5a-ee05-4146-8519-3b6e9462b863",
