                        "source_sense_description": "antasten, berühren",
                        "target_lang_word": "berühren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berühren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a5540cb-c608-3ac1-8d8f-ad560ccbd046",
                                        "entry_id": "a30e4e44-a135-3fee-b460-7791fb97edb1",
                                        "glosses": [
                                            "mit dem Äußeren seines Körpers mit einer Sache oder einer Person in Kontakt kommen"
                                        ],
                                        "tags": [
                                            "jemanden / etwas berühren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6db0edf8-1f46-454b-8a59-b331588f6b2d",
                                                "sense_id": "6a5540cb-c608-3ac1-8d8f-ad560ccbd046",
                                                "text": "Er berührt behutsam die Schneide des Messers."
                                            },
                                            {
                                                "example_id": "6db63504-9a72-4134-ab7c-a68343c5e8be",
                                                "sense_id": "6a5540cb-c608-3ac1-8d8f-ad560ccbd046",
                                                "text": "„Spür mich, komm zu mir und berühr mich, nimm von mir die Erinnerung, lös mich aus meinem Bann.“ - „Erinnerung“, Cats"
                                            },
                                            {
                                                "example_id": "cddc7dae-ebd6-4096-9b01-404c31316ec7",
                                                "sense_id": "6a5540cb-c608-3ac1-8d8f-ad560ccbd046",
                                                "text": "Und berühr mir nicht die Uhren, hörst du!"
                                            },
                                            {
                                                "example_id": "4be31e5d-2624-4d79-a1cd-e863f0f868cd",
                                                "sense_id": "6a5540cb-c608-3ac1-8d8f-ad560ccbd046",
                                                "text": "Für den Bruchteil einer Sekunde berührten sich die Finger der beiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a4d2a3a5-f632-3899-a09d-df20033fd635",
                                        "entry_id": "a30e4e44-a135-3fee-b460-7791fb97edb1",
                                        "glosses": [
                                            "einen bestimmten Inhalt ansprechen, zum Beispiel ein Thema"
                                        ],
                                        "tags": [
                                            "etwas berühren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb89b3c-ea2e-41ef-ac7a-aed3b5945c94",
                                                "sense_id": "a4d2a3a5-f632-3899-a09d-df20033fd635",
                                                "text": "Haben Sie das Thema Menschenrechtsverletzungen berührt?"
                                            },
                                            {
                                                "example_id": "070f6500-f262-4d27-a4ec-879332afedcd",
                                                "sense_id": "a4d2a3a5-f632-3899-a09d-df20033fd635",
                                                "text": "Der Artikel berührte verschiedene Aspekte der Meinungsfreiheit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "081c396a-1f39-3531-8f50-d1410e048ab4",
                                        "entry_id": "a30e4e44-a135-3fee-b460-7791fb97edb1",
                                        "glosses": [
                                            "zu einem Gefühl anregen, zum Beispiel zu Trauer, Nachdenklichkeit oder Unmut"
                                        ],
                                        "tags": [
                                            "jemanden berühren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7226911-89e7-4f8f-83c4-b835ab7a5669",
                                                "sense_id": "081c396a-1f39-3531-8f50-d1410e048ab4",
                                                "text": "Der Anblick berührte sie unangenehm."
                                            },
                                            {
                                                "example_id": "5599d9c7-ea29-479a-8895-630fe5a52b3c",
                                                "sense_id": "081c396a-1f39-3531-8f50-d1410e048ab4",
                                                "text": "Dieses Lied berührte sie sehr."
                                            },
                                            {
                                                "example_id": "0d715db7-8a16-438a-93fd-d7663589ef0d",
                                                "sense_id": "081c396a-1f39-3531-8f50-d1410e048ab4",
                                                "text": "„Du berührst mich mit deiner Lebensgeschichte wirklich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2005e701-e6bb-368d-9733-51edda9f934e",
                                        "entry_id": "a30e4e44-a135-3fee-b460-7791fb97edb1",
                                        "glosses": [
