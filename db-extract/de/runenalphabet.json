                "senses": [
                    {
                        "sense_id": "b4b7049b-7ed9-3342-8de5-72664d926af8",
                        "entry_id": "22a54da3-484c-3b6f-bc66-6488077c03d5",
                        "glosses": [
                            "Alphabet, das aus den germanischen Runen besteht"
                        ],
                        "tags": [
                            "Germanistik",
                            "Skandinavistik"
                        ],
                        "examples": [
                            {
                                "example_id": "37c2103f-ee3c-4ad5-9251-44522739a201",
                                "sense_id": "b4b7049b-7ed9-3342-8de5-72664d926af8",
                                "text": "Es gab mehrere verschiedene Runenalphabete."
                            },
                            {
                                "example_id": "6c3501b3-f43c-41a8-ac2e-29b67d0e3320",
                                "sense_id": "b4b7049b-7ed9-3342-8de5-72664d926af8",
                                "text": "Die ersten Schriftzeichen des Runenalphabets stehen für \"f\", \"u\", \"th\", \"a\", \"r\" und \"k\"; daher heißen diese Runenalphabete auch Futhark."
                            },
                            {
                                "example_id": "f8ad5f69-e3aa-4920-9e70-d476abf16f0c",
                                "sense_id": "b4b7049b-7ed9-3342-8de5-72664d926af8",
                                "text": "„Das zeigen uns die bis ins 8. Jahrhundert im ältesten Runenalphabet, dem älteren Futhark (mit 24 Zeichen, ca. 220 kurze Inschriften, meist zu kultischen Zwecken), aufgezeichneten nordischen Runeninschriften (sogenanntes Urnordisch).“"
                            },
                            {
                                "example_id": "96441eb5-6cce-4b02-a524-1f6bd1741ec0",
                                "sense_id": "b4b7049b-7ed9-3342-8de5-72664d926af8",
                                "text": "„Die Tradition der Bildsteine wurde auch dann fortgesetzt, als man schon angefangen hatte, Texte im altnordischen Runenalphabet in Stein zu meißeln.“"
                            },
                            {
                                "example_id": "a3c894f7-aa0b-42e1-9503-a598745726dd",
                                "sense_id": "b4b7049b-7ed9-3342-8de5-72664d926af8",
                                "text": "„Der gleiche Gedanke liegt dem Einfall zugrunde, das Runenalphabet auf einem der Seitensteine eines unterirdischen Grabes bei Kylver auf Gotland aus dem 4. Jahrhundert nach Christri Geburt einzuhauen.“"
                            },
                            {
                                "example_id": "c9c9dd7d-0840-4450-953f-bdd65bab1567",
                                "sense_id": "b4b7049b-7ed9-3342-8de5-72664d926af8",
                                "text": "„Daß er sich mit seinem verbesserten Runenalphabet nicht durchsetzen konnte, mag teilweise daran liegen, daß bald danach der Verfasser des Ersten grammatischen Traktats sein vorzüglich ergänztes lateinisches Alphabets vorlegte.“"
                            },
                            {
                                "example_id": "29cfe328-e1e5-4e12-90f0-75d0c84c5fa4",
                                "sense_id": "b4b7049b-7ed9-3342-8de5-72664d926af8",
                                "text": "„Nach seinen ersten sechs Lauten heißt das Runenalphabet »Futhark«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
