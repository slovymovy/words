                ],
                "senses": [
                    {
                        "sense_id": "befaec52-72ef-34ed-90d6-4d4d898a49dd",
                        "entry_id": "89a79d1e-9e2a-326d-8f94-cd7fa7b796de",
                        "glosses": [
                            "проводить день где-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a87729b3-5ad4-4a67-9eb9-fc0143f24de5",
                                "sense_id": "befaec52-72ef-34ed-90d6-4d4d898a49dd",
                                "text": "Алкид мой пустился большой рысью, и на рассвете я приехала в селение, где дневал полк казаков."
                            },
                            {
                                "example_id": "048096e1-099f-45d1-8cd5-530c62bae7bd",
                                "sense_id": "befaec52-72ef-34ed-90d6-4d4d898a49dd",
                                "text": "Он объявил, что свежие лошади приведены уже из дома его в 2 верстах отсюда и пасутся теперь у станка, где мы и расположились дневать."
                            },
                            {
                                "example_id": "c9a415a4-6678-4ead-8890-b0ecc4caa7bd",
                                "sense_id": "befaec52-72ef-34ed-90d6-4d4d898a49dd",
                                "text": "На пятые сутки мы дневали на верховье Ассы, близ селения Зоти."
                            }
                        ]
                    }
                ],
