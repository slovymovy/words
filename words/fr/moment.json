                {
                    "sense_id": "daddc7cb-54ac-3e38-b2ab-79909c4ebc04",
                    "sense_definition": "Point précis ou circonstance déterminée dans le temps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est arrivé au <w>moment</w> où nous allions commencer à dîner.",
                            "target_lang_translations": {
                                "en": "He arrived at the very <w>moment</w> we were about to start dinner.",
                                "ru": "Он пришёл как раз в тот <w>момент</w>, когда мы собирались ужинать.",
                                "nl": "Hij kwam juist op het <w>moment</w> dat we op het punt stonden te gaan eten.",
                                "de": "Er kam genau in dem <w>Moment</w>, als wir gerade zu Abend essen wollten.",
                                "pl": "Przyszedł akurat w <w>momencie</w>, gdy mieliśmy właśnie jeść kolację.",
                                "it": "È arrivato proprio nel <w>momento</w> in cui stavamo per cenare.",
                                "cs": "Přišel přesně v <w>okamžiku</w>, kdy jsme se chystali sednout k večeři.",
                                "tr": "Tam akşam yemeğine oturacağımız <w>anda</w> geldi.",
                                "es": "Llegó justo en el <w>momento</w> en que íbamos a empezar a cenar.",
                                "zh": "他到得正是我们准备开始吃晚饭的<w>时候</w>。"
                            }
                        },
                        {
                            "text": "Elle a changé d'avis au dernier <w>moment</w> avant de monter dans le train.",
                            "target_lang_translations": {
                                "en": "She changed her mind at the last <w>moment</w> before getting on the train.",
                                "ru": "Она передумала в последний <w>момент</w>, перед тем как сесть в поезд.",
                                "nl": "Ze veranderde van gedachten op het laatste <w>moment</w>, vlak voordat ze in de trein stapte.",
                                "de": "Sie hat ihre Meinung im letzten <w>Moment</w> geändert, kurz bevor sie in den Zug stieg.",
                                "pl": "Zmieniła zdanie w ostatniej <w>chwili</w>, zanim wsiadła do pociągu.",
                                "it": "Ha cambiato idea all'ultimo <w>momento</w>, prima di salire sul treno.",
                                "cs": "Změnila názor na poslední <w>chvíli</w>, těsně předtím, než nastoupila do vlaku.",
                                "tr": "Trene binmeden önce son <w>anda</w> fikrini değiştirdi.",
                                "es": "Cambió de opinión en el último <w>momento</w>, justo antes de subir al tren.",
                                "zh": "她在上火车之前的最后<w>时刻</w>改变了主意。"
                            }
                        }
