                ],
                "senses": [
                    {
                        "sense_id": "f0976219-698f-3c3a-a6bd-75027462d646",
                        "entry_id": "70cbe090-6866-302a-8c0c-6b9bdbc7ee17",
                        "glosses": [
                            "ulica, aleja spacerowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33774120-28e7-4979-95ec-ee3df7b94c27",
                                "sense_id": "f0976219-698f-3c3a-a6bd-75027462d646",
                                "text": "W pobliskim parku znaleźć można urocze promenady."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0dd9fc7a-4083-347f-a38b-61955654c301",
                        "entry_id": "70cbe090-6866-302a-8c0c-6b9bdbc7ee17",
                        "glosses": [
                            "spacer"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0c33541d-5a6f-4aa6-8a43-79b9c3754f24",
                                "sense_id": "0dd9fc7a-4083-347f-a38b-61955654c301",
                                "text": "Wychodzimy na ulicę i siadamy na tarasie. Tu się odbywa cała promenada dziewczątek brazylijskich"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3736310-41ac-4baa-a8ff-5bcdb0c138d3",
                        "source_entry_id": "70cbe090-6866-302a-8c0c-6b9bdbc7ee17",
                        "source_sense_id": "f0976219-698f-3c3a-a6bd-75027462d646",
                        "target_lang_word": "promenade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promenade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e468deed-6db0-3f06-a069-e7f86741c61c",
                                        "entry_id": "49a9558b-1c82-32c7-b70e-f25512c1cc9f",
                                        "glosses": [
                                            "Action de se promener."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fd0accd-8ed0-451f-8b71-200887f240dd",
                                                "sense_id": "e468deed-6db0-3f06-a069-e7f86741c61c",
                                                "text": "Ni les Persans ni tous les Orientaux ne savent ce que c’est que des promenades comme nous les faisons, et ils ne peuvent assez s’étonner de nous voir marcher dans une allée de jardin, puis revenir sur nos pas, et ainsi continuer deux ou trois heures."
                                            },
                                            {
                                                "example_id": "4dd0a18e-2d0a-4d77-a7c7-74d34cf2f3a8",
                                                "sense_id": "e468deed-6db0-3f06-a069-e7f86741c61c",
                                                "text": "Que faire donc ? je ne fume jamais ; la fidélité matrimoniale est bien ennuyeuse ; dans une intrigue où le cœur n’est que chatouillé on ne vise qu’au dénoûment : la promenade est mon unique plaisir ; triste plaisir à vingt ans !"
                                            },
                                            {
                                                "example_id": "58c0be48-ace4-424d-b91e-311aea73fd1c",
                                                "sense_id": "e468deed-6db0-3f06-a069-e7f86741c61c",
                                                "text": "Le jardin des Pamplemousses est souvent pour elle et ses enfants un but de promenade matinale ; quelquefois même, pendant l’ardente saison, elle y va avec sa petite famille passer des journées entières."
                                            },
                                            {
                                                "example_id": "12cd9c7a-1682-40d8-bc9e-8a8028cd1834",
                                                "sense_id": "e468deed-6db0-3f06-a069-e7f86741c61c",
                                                "text": "Tous allaient tranquillement, bienheureusement, d’un pas qui voulait s’attarder, avec le dandinement allègre et la paresse heureuse de la promenade."
                                            },
                                            {
                                                "example_id": "b9b6f8e9-deae-40d5-ad12-6b62f38f6fbb",
                                                "sense_id": "e468deed-6db0-3f06-a069-e7f86741c61c",
                                                "text": "Donc tous les jours, de midi à deux heures, il passait devant la boutique un monsieur âgé qui s’en allait flânotant sur le trottoir comme un bon bourgeois qui fait sa petite promenade de digestion après déjeuner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54916b87-dabe-351e-80bb-016c47f2b4b2",
                                        "entry_id": "49a9558b-1c82-32c7-b70e-f25512c1cc9f",
                                        "glosses": [
                                            "Exercice de marche pour les troupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5777d4a-27b4-4001-9467-b901b8a33cad",
                                                "sense_id": "54916b87-dabe-351e-80bb-016c47f2b4b2",
                                                "text": "Promenade coutumière des clairons et tambours, qui ne savent où se placer et que chaque capitaine expédie au bout opposé du village."
                                            },
                                            {
                                                "example_id": "4ce01f26-ca7f-4d59-8db7-a401232549b7",
                                                "sense_id": "54916b87-dabe-351e-80bb-016c47f2b4b2",
                                                "text": "Mais déjà les tambours menaient la promenade,\nEt les sloughis rivalisaient avec le feu\nQuand tu rompis ta lance au sortir de Grenade,\nLe ciel laissa tomber son grand bouclier bleu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc093ef4-6fb1-3f23-aaf5-88dd9e170426",
                                        "entry_id": "49a9558b-1c82-32c7-b70e-f25512c1cc9f",
                                        "glosses": [
                                            "Itinéraire parcouru en imagination."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "652fc9bf-ac44-4313-ab14-4242606008ec",
                                                "sense_id": "fc093ef4-6fb1-3f23-aaf5-88dd9e170426",
                                                "text": "C’étaient nos vers grecs et latins traduits par Dieu lui-même en images grandioses et vivantes, une promenade à travers la poésie de sa création."
                                            },
                                            {
                                                "example_id": "f5baa3f3-e3d2-4557-904e-4efc6f7da9a4",
                                                "sense_id": "fc093ef4-6fb1-3f23-aaf5-88dd9e170426",
                                                "text": "Or le vrai rêve, cette promenade de notre pensée à travers des visions charmantes, est assurément ce qu’il y a de plus délicieux au monde ; mais il faut qu’il vienne naturellement, qu’il ne soit pas péniblement provoqué et qu’il soit accompagné d’un bien-être absolu du corps"
                                            },
                                            {
                                                "example_id": "65559a9f-2c29-4ae2-a30b-adecb3bd071c",
                                                "sense_id": "fc093ef4-6fb1-3f23-aaf5-88dd9e170426",
                                                "text": "Le siècle où j’ai vécu n’aura probablement pas été le plus grand, mais il sera tenu sans doute pour le plus amusant des siècles. à moins que mes dernières années ne me réservent des peines bien cruelles, je n’aurai, en disant adieu à la vie, qu’à remercier la cause de tout bien de la charmante promenade qu’il m’a été donné d’accomplir à travers la réalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b571a781-5683-3417-a479-f00ec196b91c",
                                        "entry_id": "49a9558b-1c82-32c7-b70e-f25512c1cc9f",
                                        "glosses": [
                                            "Trajet aisé à accomplir."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3049f257-b980-45b4-aa18-33738866ad63",
                                                "sense_id": "b571a781-5683-3417-a479-f00ec196b91c",
                                                "text": "Quant à la distance à parcourir, c’était une promenade en comparaison des courses que j’avais faites, et trois heures de marche nous suffirent pour atteindre le plateau."
                                            },
                                            {
                                                "example_id": "062d01b7-0a80-42c9-88f5-24c583529374",
                                                "sense_id": "b571a781-5683-3417-a479-f00ec196b91c",
                                                "text": "Une quinzaine de kilomètres de Dal aux célèbres chutes, autant pour en revenir, ce n’eût été qu’une promenade pour Joël, mais il fallait ménager les forces de Hulda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0936954d-766b-3d9c-a016-8568731d65d6",
                                        "entry_id": "49a9558b-1c82-32c7-b70e-f25512c1cc9f",
                                        "glosses": [
                                            "Lieu où l’on se promène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf5daab-b23a-46e0-8fbb-e9deaf872651",
                                                "sense_id": "0936954d-766b-3d9c-a016-8568731d65d6",
                                                "text": "À cinq heures et demie, cette foule nombreuse, équipages, cavaliers, piétons, sillonnait dans toute les directions le bois de Boulogne. Cette promenade unique venait d’ajouter un nouveau prestige à toutes les merveilles qui depuis quelques années en ont fait le plus beau parc du monde."
                                            },
                                            {
                                                "example_id": "d1088811-2682-459e-9eed-5014f6b8b472",
                                                "sense_id": "0936954d-766b-3d9c-a016-8568731d65d6",
                                                "text": "Estelle regardait la ville silencieuse, entourée des grands arbres de ses promenades ; et, dans l’eau dormante de ses yeux, une rêverie souriait."
                                            },
                                            {
                                                "example_id": "3a45d442-7247-4339-897f-add62cbade5a",
                                                "sense_id": "0936954d-766b-3d9c-a016-8568731d65d6",
                                                "text": "La promenade fut aménagée pour le bonheur des promeneurs : piste cyclable, crottoirs pour toutous à sa mémère, bancs nombreux et propres permettant de s'extasier devant l’ire des marées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1c9e866-1fb4-3827-8c61-f4915cdfdf1c",
                                        "entry_id": "49a9558b-1c82-32c7-b70e-f25512c1cc9f",
