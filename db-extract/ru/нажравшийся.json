        "ru-extract.jsonl": [
            {
                "entry_id": "6c638601-c1c7-3b42-ab79-d7b55837f4be",
                "word": "нажравшийся",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "18c477b6-7295-360e-81b7-16d39514a6fe",
                        "entry_id": "6c638601-c1c7-3b42-ab79-d7b55837f4be",
                        "glosses": [
                            "разг. много съевший; наевшийся чрезмерно, до отвала"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0725ec08-4167-4949-a6d5-a442f358f2b1",
                                "sense_id": "18c477b6-7295-360e-81b7-16d39514a6fe",
                                "text": "Могучие эти татуированные руки с вяло перекатывающимися под кожей шарами бицепсов напоминали нажравшегося питона."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7fe60ac-e6ac-39b5-97c6-67360f98c311",
                        "entry_id": "6c638601-c1c7-3b42-ab79-d7b55837f4be",
                        "glosses": [
                            "разг., сниж. напившийся (алкоголя); сильно напившийся"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346d60c2-2d96-4d9a-91b1-f24102f918cb",
                                "sense_id": "e7fe60ac-e6ac-39b5-97c6-67360f98c311",
                                "text": "Я живу неподалёку от Любы и раньше постоянно слышала, как «нажравшийся» Кардаполов ночью приходил домой и начинал крушить всё вокруг."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
