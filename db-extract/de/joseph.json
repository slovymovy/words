                                "example_id": "3ab93ce5-1cd8-46be-83c2-96922ebf5c7d",
                                "sense_id": "4a88f69a-12cc-3f35-82a7-a6d745b6719b",
                                "text": "Der eloquente Joseph arbeitet als Schuhverkäufer."
