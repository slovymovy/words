                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb393e47-a734-448e-bbb1-f097d554e3ee",
                                                "sense_id": "4f1ec3d0-4649-3b74-b667-d1f88dd36327",
                                                "text": "The names of the periods above trillion are as follows...18th, sexdecillion..."
                                            },
                                            {
                                                "example_id": "714d3b6b-d630-4542-badf-6ea2f28a5b3c",
                                                "sense_id": "4f1ec3d0-4649-3b74-b667-d1f88dd36327",
                                                "text": "1994, The Arithmetic Teacher, National Council of Teachers of Mathematics\nThe answer is read as: 13 sexdecillion, 253 quindecillion, 796 quattuordecillion, 742 tredecillion...."
                                            },
                                            {
                                                "example_id": "a482ee59-2a0e-4a54-8675-7ec29f04a221",
                                                "sense_id": "4f1ec3d0-4649-3b74-b667-d1f88dd36327",
                                                "text": "How many Stars Shine on Tiny Jennifer’s Hair? ... Two million, three hundred and forty nine thousand, eight hundred seventy five vigintillion, seven hundred fifty four novemdecillion, five hundred forty three octodecillion, four hundred fifty seven septendecillion, eight hundred ninety nine sexdecillion, eight hundred seventy three quindecillion, nine hundred forty five quattuordecillion, nine hundred eighty seven tredecillion, nine hundred eighty seven duodecillion, six hundred undecillion, nine hundred eighty three decillion..."
                                            },
                                            {
                                                "example_id": "b584e721-c9a3-4f46-a68e-eccfb002a6bf",
                                                "sense_id": "4f1ec3d0-4649-3b74-b667-d1f88dd36327",
                                                "text": "After the episode, which had several other startling “coincidences,” I computed the number of chances of it happening again as one in Six Septendecillion, Seven Hundred and Fifty Sexdecillion, with all circumstances the same."
                                            }
                                        ]
                                    },
