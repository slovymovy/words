                "senses": [
                    {
                        "sense_id": "34366700-6323-3e48-988a-bef687189259",
                        "entry_id": "7e9045df-cab8-32cd-aeb3-3d9281c176e1",
                        "glosses": [
                            "хим. вещество, введение которого в раствор приводит к выпадению осадка или образованию геля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e7a534-6a8c-468c-81be-c5d726a8c119",
                                "sense_id": "34366700-6323-3e48-988a-bef687189259",
                                "text": "Алюможелезный коагулянт относится к категории смешанных коагулянтов на основе сульфата алюминия."
                            }
                        ]
                    },
                    {
                        "sense_id": "a239f6d3-8dfd-3012-bc4a-442601a5d089",
                        "entry_id": "7e9045df-cab8-32cd-aeb3-3d9281c176e1",
                        "glosses": [
                            "фарм. лекарство, повышающее свёртываемость крови"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99b92502-b6fc-468d-ba3f-75c5f188baa8",
                                "sense_id": "a239f6d3-8dfd-3012-bc4a-442601a5d089",
                                "text": "Таблетированный коагулянт длительного действия."
                            }
                        ]
                    }
                ],
