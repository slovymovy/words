                        "glosses": [
                            "Élysée, séjour des hommes vertueux après leur mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e60b8be1-6d7b-4ae8-a3cf-d9404675fc6c",
                                "sense_id": "94c53ccb-6d14-3f58-aa0b-e8a0d74708f8",
                                "text": "Freude, schöner Götterfunken\nTochter aus Elysium,\nWir betreten feuertrunken,\nHimmlische, dein Heiligtum!",
                                "translation": "Joie ! Belle étincelle des dieux\nFille de l’Élysée,\nNous entrons l’âme enivrée\nDans ton temple glorieux."
                            }
                        ]
                    }
