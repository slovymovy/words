                "senses": [
                    {
                        "sense_id": "8c431995-0268-363a-997c-f2fea8ea4e97",
                        "entry_id": "894cfd09-20de-3b99-b5d4-aff5a5b51d81",
                        "glosses": [
                            "„Internetforum, über das hauptsächlich Bilder oder kleinere Binärdateien ausgetauscht werden“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b68a4ece-cdf9-41ae-8b09-56db749f57ef",
                                "sense_id": "8c431995-0268-363a-997c-f2fea8ea4e97",
                                "text": "„Unkenntnis der Web-Phänomene kann zu der Assoziation verleiten, alle Memes seien irgendwie böse. Oder auf Imageboards trieben sich nur frustrierte junge weiße Männer herum, die Juden hassen.“"
                            },
                            {
                                "example_id": "3fad0021-8196-4097-b51c-8a0a884dbabc",
                                "sense_id": "8c431995-0268-363a-997c-f2fea8ea4e97",
                                "text": "„In meiner Jugend trieb ich mich häufiger auf Imageboards herum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73e64c71-306a-4d9e-a6e5-64a2a963f591",
                        "source_entry_id": "894cfd09-20de-3b99-b5d4-aff5a5b51d81",
                        "source_sense_id": "8c431995-0268-363a-997c-f2fea8ea4e97",
                        "target_lang_word": "imageboard",
