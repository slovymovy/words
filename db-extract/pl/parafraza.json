                        "entry_id": "aebf8b61-8695-3783-99b4-d72f254d0cb9",
                        "glosses": [
                            "utwór stanowiący fantazję na tematy z innych utworów muzycznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da42dc05-12b7-4c8e-92a0-6cc4bb17eeee",
                                "sense_id": "5fdc244a-401a-3295-8a42-05c742aceaee",
                                "text": "Niektóre współczesne melodie pieśni kościelnych stanowią parafrazy melodii chorału gregoriańskiego."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
