                            },
                            {
                                "target_word": "attack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bdb768e-4417-3510-9480-b2ccb12d68ae",
                                        "entry_id": "f7bf062f-ea40-3f38-874b-e5d8f5af617f",
                                        "glosses": [
                                            "To apply violent force to someone or something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c550fe53-b0ef-45d2-aefa-eaf5a43097a3",
                                                "sense_id": "5bdb768e-4417-3510-9480-b2ccb12d68ae",
                                                "text": "This species of snake will only attack humans if it feels threatened."
                                            },
                                            {
                                                "example_id": "8dbc3678-2c8a-4925-961d-152cd08b03c0",
                                                "sense_id": "5bdb768e-4417-3510-9480-b2ccb12d68ae",
                                                "text": "Yesterday, December seventh, 1941, a date which will live in infamy, the United States of America was suddenly and deliberately attacked by naval and air forces of the Empire of Japan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ae3ed9f-7471-33af-a0a1-fc4747b478ab",
                                        "entry_id": "f7bf062f-ea40-3f38-874b-e5d8f5af617f",
                                        "glosses": [
                                            "To aggressively challenge a person, idea, etc., with words (particularly in newspaper headlines, because it typesets into less space than \\\"criticize\\\" or similar)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c733a06b-d89f-4419-978e-85b366a40559",
                                                "sense_id": "3ae3ed9f-7471-33af-a0a1-fc4747b478ab",
                                                "text": "She published an article attacking the recent pay cuts."
                                            },
                                            {
                                                "example_id": "02041982-602a-4f5d-b3dd-cb65d5c75f8e",
                                                "sense_id": "3ae3ed9f-7471-33af-a0a1-fc4747b478ab",
                                                "text": "It was puzzling to read a column that claimed to be attacking me, yet espoused the main ideas in my article."
                                            },
                                            {
                                                "example_id": "1b9f4924-30b4-449a-ad48-3c6318dae71c",
                                                "sense_id": "3ae3ed9f-7471-33af-a0a1-fc4747b478ab",
                                                "text": "In its God-like prime, The Simpsons attacked well-worn satirical fodder from unexpected angles, finding fresh laughs in the hoariest of subjects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acc826c0-476e-377b-9cd5-926e5fea3e49",
                                        "entry_id": "f7bf062f-ea40-3f38-874b-e5d8f5af617f",
                                        "glosses": [
                                            "To begin to affect; to act upon injuriously or destructively; to begin to decompose or waste."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9276b71-aa42-46ae-9b24-1963058ec351",
                                                "sense_id": "acc826c0-476e-377b-9cd5-926e5fea3e49",
                                                "text": "On the fourth of March he was attacked by fever."
                                            },
                                            {
                                                "example_id": "c94b8798-b3e5-49f4-8a86-069a3af5c772",
                                                "sense_id": "acc826c0-476e-377b-9cd5-926e5fea3e49",
                                                "text": "Hydrofluoric acid […] attacks the glass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63decb17-5b3c-3709-9115-ff2246ee5770",
                                        "entry_id": "f7bf062f-ea40-3f38-874b-e5d8f5af617f",
                                        "glosses": [
                                            "To deal with something in a direct way; to set to work upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cec1bb1-d54c-4e15-b56f-79fe05bb40a2",
                                                "sense_id": "63decb17-5b3c-3709-9115-ff2246ee5770",
                                                "text": "We’ll have dinner before we attack the biology homework."
                                            },
                                            {
                                                "example_id": "034982ab-9fdf-4162-a4af-a1cc6d434524",
                                                "sense_id": "63decb17-5b3c-3709-9115-ff2246ee5770",
                                                "text": "I attacked the meal with a hearty appetite."
                                            },
                                            {
                                                "example_id": "3dcd3913-a3d1-4196-a628-97649bbede65",
                                                "sense_id": "63decb17-5b3c-3709-9115-ff2246ee5770",
                                                "text": "He filled a basin with water, and, with an old brush and piece of sandsoap, attacked the stove."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c25eea83-79c7-330e-8430-a4020ab0c979",
                                        "entry_id": "f7bf062f-ea40-3f38-874b-e5d8f5af617f",
                                        "glosses": [
                                            "To aim balls at the batsman’s wicket."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "065fc881-20c7-33b5-bc0b-819f6a65f833",
                                        "entry_id": "f7bf062f-ea40-3f38-874b-e5d8f5af617f",
                                        "glosses": [
                                            "To set a field, or bowl in a manner designed to get wickets."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2972ad93-e601-3e53-8802-b3e402f4839c",
                                        "entry_id": "f7bf062f-ea40-3f38-874b-e5d8f5af617f",
                                        "glosses": [
                                            "To bat aggressively, so as to score runs quickly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68cf0600-749a-3498-9e2a-3b47b8b4953c",
                                        "entry_id": "f7bf062f-ea40-3f38-874b-e5d8f5af617f",
                                        "glosses": [
                                            "To move forward in an active attempt to score a point, as opposed to trying not to concede."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e79992f6-9f11-4271-8057-5afce2e43970",
                                                "sense_id": "68cf0600-749a-3498-9e2a-3b47b8b4953c",
                                                "text": "Six successive defeats had left them rooted to the bottom of the Premier League table but, clearly under instructions to attack from the outset, Bolton started far the brighter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da4b1638-5cd7-32c0-b95c-01d4ee8fa718",
                                        "entry_id": "f7bf062f-ea40-3f38-874b-e5d8f5af617f",
                                        "glosses": [
                                            "To accelerate quickly in an attempt to get ahead of the other riders."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
