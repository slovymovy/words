                    "frequency": "Middle",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le lieutenant a rassemblé son <w>peloton</w> avant de partir en patrouille."
                        },
                        {
                            "text": "Chaque <w>peloton</w> de la compagnie dispose de son propre équipement de transmission."
                        }
                    ],
                    "synonyms": [
                        "section"
                    ],
                    "common_phrases": [
