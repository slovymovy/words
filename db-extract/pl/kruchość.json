                        "cross_references": [
                            {
                                "target_word": "нежность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3706e910-4141-3949-8f11-d363337efdb9",
                                        "entry_id": "344b5b4c-4dc1-32b7-9c82-edc7c0be9c1f",
                                        "glosses": [
                                            "отвлеч. сущ. к нежный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c50c10a-c639-476a-8890-2d7a9f88f671",
                                                "sense_id": "3706e910-4141-3949-8f11-d363337efdb9",
                                                "text": "Нежность тела."
                                            },
                                            {
                                                "example_id": "36f83430-504a-4c94-b035-0d06cfdb5375",
                                                "sense_id": "3706e910-4141-3949-8f11-d363337efdb9",
                                                "text": "…образование Апеллес получил в Эфесе, в Ионической школе, которая отличалась мягкостью рисунка и нежностью колорита…"
                                            },
                                            {
                                                "example_id": "35f5a679-24e0-4fda-9fdc-baa745c33698",
                                                "sense_id": "3706e910-4141-3949-8f11-d363337efdb9",
                                                "text": "Различно окрашенные слои агата отличаются чрезвычайной нежностью и часто так тонки, что Брюстер мог насчитать их 17000 на куске толщиною в 1 дюйм."
                                            },
                                            {
                                                "example_id": "c34b0e7e-0757-4e31-9470-93c1489b9e82",
                                                "sense_id": "3706e910-4141-3949-8f11-d363337efdb9",
                                                "text": "Нежность голоса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "616c53b7-262e-3203-ad81-043701b988a2",
                                        "entry_id": "344b5b4c-4dc1-32b7-9c82-edc7c0be9c1f",
                                        "glosses": [
                                            "нежное чувство, ласковость и мягкость в отношениях к кому-нибудь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52fdba72-68ec-4b76-8527-bbc0df58620d",
                                                "sense_id": "616c53b7-262e-3203-ad81-043701b988a2",
                                                "text": "Глубокая нежность."
                                            },
                                            {
                                                "example_id": "b5df0e8c-5f7f-4538-8d99-4a3d3e50ce5e",
                                                "sense_id": "616c53b7-262e-3203-ad81-043701b988a2",
                                                "text": "С нежностью обнять кого-либо, смотреть на кого-либо."
                                            },
                                            {
                                                "example_id": "4f99555d-eae1-4151-829d-8922fc1e24c0",
                                                "sense_id": "616c53b7-262e-3203-ad81-043701b988a2",
                                                "text": "Испытывать, почувствовать нежность."
                                            },
                                            {
                                                "example_id": "f21ea9fb-0252-4820-9658-91e794bdc670",
                                                "sense_id": "616c53b7-262e-3203-ad81-043701b988a2",
                                                "text": "В нежности матушкиной я не сомневался."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e79ad67-5ef9-3cc2-8375-cce2e8a16979",
                                        "entry_id": "344b5b4c-4dc1-32b7-9c82-edc7c0be9c1f",
                                        "glosses": [
                                            "разг., поступки, выражающие нежные чувства, ласковые слова"
                                        ],
                                        "tags": [
                                            "преимущ. мн."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "586e71cd-4c8b-4016-9d62-e6e3a6cc23cd",
                                                "sense_id": "8e79ad67-5ef9-3cc2-8375-cce2e8a16979",
                                                "text": "Я даже не знаю, что вам отвечать на такие нежности."
                                            },
                                            {
                                                "example_id": "e044adf9-d546-4410-8c71-fac18caa635c",
                                                "sense_id": "8e79ad67-5ef9-3cc2-8375-cce2e8a16979",
                                                "text": "Говорить, шептать нежности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d309e37d-904c-3621-9d1f-93a7dd2e1a43",
                                        "entry_id": "344b5b4c-4dc1-32b7-9c82-edc7c0be9c1f",
                                        "glosses": [
                                            "разг., пренебр., проявление изнеженности, физической слабости"
                                        ],
                                        "tags": [
                                            "преимущ. мн."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e088d24d-f9a4-4b80-b403-19cf9de6ef69",
                                                "sense_id": "d309e37d-904c-3621-9d1f-93a7dd2e1a43",
                                                "text": "Что за нежности: боязнь выстрела."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
