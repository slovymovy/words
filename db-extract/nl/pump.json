                                    {
                                        "sense_id": "19b03ae9-346d-3321-b953-35256def3278",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "An enclosed space; a courtyard; an uncovered area shut in by the walls of a building, or by different buildings; also, a space opening from a street and nearly surrounded by houses; a blind alley."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9a8008-f917-4ef9-b8d0-392a8c485ed5",
                                                "sense_id": "19b03ae9-346d-3321-b953-35256def3278",
                                                "text": "The girls were playing in the court."
                                            },
                                            {
                                                "example_id": "58cbfe12-e051-45c2-8dfa-4568f140f54a",
                                                "sense_id": "19b03ae9-346d-3321-b953-35256def3278",
                                                "text": "All round the cool green courts there ran a row / Of cloisters, branched like mighty woods, / Echoing all night to that sonorous flow / Of spouted fountain floods."
                                            },
                                            {
                                                "example_id": "fb6b670c-f02b-49b5-83ec-f9dd7cada716",
                                                "sense_id": "19b03ae9-346d-3321-b953-35256def3278",
                                                "text": "Goldsmith took a garret in a miserable court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aa15115-aad2-3f44-b90f-f16439423cac",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
