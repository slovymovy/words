                    },
                    {
                        "form_id": "6068bb05-8032-4c20-95d4-67b24e95d725",
                        "entry_id": "ef6bdd36-0980-3554-938b-902a30108fe4",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "оцени́в"
                    },
                    {
                        "form_id": "018e5b06-2ea7-406f-87b9-7234383762e1",
                        "entry_id": "ef6bdd36-0980-3554-938b-902a30108fe4",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "оцени́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73afcffb-72d2-315e-ba61-fb491cd8947b",
                        "entry_id": "ef6bdd36-0980-3554-938b-902a30108fe4",
                        "glosses": [
                            "назначить цену кому-либо, чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbc158b3-e041-47ed-9eee-c112b2c5d8d8",
                                "sense_id": "73afcffb-72d2-315e-ba61-fb491cd8947b",
                                "text": "Свои услуги изменник оценил в полмиллиона долларов."
                            }
                        ]
                    },
                    {
                        "sense_id": "8edcc996-ced8-3efb-9643-069dc8d8d89b",
                        "entry_id": "ef6bdd36-0980-3554-938b-902a30108fe4",
                        "glosses": [
                            "определить, подсчитать стоимость чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c849c46e-6b8b-4dc8-9be6-21d40fa1c611",
                                "sense_id": "8edcc996-ced8-3efb-9643-069dc8d8d89b",
                                "text": "Она приехала в комиссионный ювелирный магазин, что на Липаевской, и попросила оценить украшение."
                            },
                            {
                                "example_id": "1283c71a-bcc5-45e6-a067-7c95d89fa4b5",
                                "sense_id": "8edcc996-ced8-3efb-9643-069dc8d8d89b",
                                "text": "Фамильные ценности и украшения были спасены, но, чтобы в точности оценить ювелирные изделия и камни, был приглашён непревзойдённый эксперт в данной области."
                            }
                        ]
                    },
                    {
                        "sense_id": "c085492e-87f6-35dd-8702-074f19c46288",
                        "entry_id": "ef6bdd36-0980-3554-938b-902a30108fe4",
                        "glosses": [
                            "определить, установить качество чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d638125-b4d0-44a1-8921-8f9dfce5994b",
                                "sense_id": "c085492e-87f6-35dd-8702-074f19c46288",
                                "text": "Если под верхним отделочным слоем обнаруживается более интересная первоначальная отделка, зондаж расширяют, делают его в нескольких местах, чтобы оценить состояние нижнего слоя."
                            }
                        ]
                    },
                    {
                        "sense_id": "80693918-0ea9-36f6-8757-14e9c787f16f",
                        "entry_id": "ef6bdd36-0980-3554-938b-902a30108fe4",
                        "glosses": [
                            "составить или высказать суждение о ком-либо, чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b40486-f03c-41a9-93f7-10e94a8f7269",
                                "sense_id": "80693918-0ea9-36f6-8757-14e9c787f16f",
                                "text": "Правильно понять и оценить эту роль сатиры в процессе обновления литературных языков и жанров можно только при постоянном учёте связи сатиры с пародией."
                            },
                            {
                                "example_id": "eddd36b7-e65f-4d03-a431-48cee19cd618",
                                "sense_id": "80693918-0ea9-36f6-8757-14e9c787f16f",
                                "text": "Наибольшую опасность эта неточность создаёт в ситуации, когда необходимо оценить степень вероятности попадания в руки организованных преступных групп ядерного оружия или материалов."
                            }
                        ]
                    },
                    {
                        "sense_id": "f643255a-fa9c-30ea-b88f-53a4ee4f494d",
                        "entry_id": "ef6bdd36-0980-3554-938b-902a30108fe4",
                        "glosses": [
                            "разг. то же, что оценить по достоинству; признать преимущества, позитивные качества чего-либо или кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc64ec97-e810-4e4b-966a-64f07742deb7",
                                "sense_id": "f643255a-fa9c-30ea-b88f-53a4ee4f494d",
                                "text": "Жизнь в самом деле становилась прекрасной, и только глупые волки не могли оценить преимуществ коллективной жизни."
                            },
                            {
                                "example_id": "f5cd3bcf-a6ff-463c-bdce-66693bcfb19b",
                                "sense_id": "f643255a-fa9c-30ea-b88f-53a4ee4f494d",
                                "text": "Нужно видеть такую собаку именно в лесу, чтобы в полной мере оценить все её достоинства."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4eb82f6-770c-4da7-80fd-1f952be5b7fe",
                        "source_entry_id": "ef6bdd36-0980-3554-938b-902a30108fe4",
                        "source_sense_description": "назначить цену",
                        "target_lang_word": "fix a price",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7fb2f0a7-b100-47e2-b59d-be1876929d2b",
                        "source_entry_id": "ef6bdd36-0980-3554-938b-902a30108fe4",
                        "source_sense_description": "назначить цену",
