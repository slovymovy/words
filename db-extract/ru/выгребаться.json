                        "sense_id": "3e188be1-be36-397d-a94e-a995cace6c5e",
                        "entry_id": "0f644e3d-f822-31d6-afee-8226a85e301c",
                        "glosses": [
                            "перен. вульг. уходить, убираться откуда-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bebc936d-460d-4a6c-b2f1-d579ba00ca6a",
                                "sense_id": "3e188be1-be36-397d-a94e-a995cace6c5e",
                                "text": "Ну, выгребайтесь отсюда!"
                            }
                        ]
                    }
