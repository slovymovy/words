                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "worship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monks gathered before dawn to begin the service of <w>lauds</w>.",
                            "target_lang_translations": {
                                "zh": "修士们在黎明前集合，开始举行<w>晨祷</w>仪式。"
