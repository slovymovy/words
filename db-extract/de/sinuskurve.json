                "senses": [
                    {
                        "sense_id": "d9d29f61-a26c-3dc6-99a3-1983c8420e40",
                        "entry_id": "5e866a0f-8c18-38cb-9467-12e7c09f5247",
                        "glosses": [
                            "grafische Darstellung des Sinus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce90f8fd-fbfa-4456-b07f-b4e6696042cf",
                                "sense_id": "d9d29f61-a26c-3dc6-99a3-1983c8420e40",
                                "text": "„Es peitscht seinen Schwanz schnell hin und her, statt ihn wie zuvor in Form einer Sinuskurve zu bewegen.“"
                            },
                            {
                                "example_id": "fc41e404-cbbd-42db-8ffb-50371bc4b01c",
                                "sense_id": "d9d29f61-a26c-3dc6-99a3-1983c8420e40",
                                "text": "„Der Grundriss dieses letztlich nicht realisierten Baus basiert auf einer logarithmischen Spirale, der Schnitt auf einer Sinuskurve.“"
                            },
                            {
                                "example_id": "35088642-2c2a-4475-8e78-756d12d81e65",
                                "sense_id": "d9d29f61-a26c-3dc6-99a3-1983c8420e40",
                                "text": "„Der erste integrierte Schaltkreis begann daraufhin, über ein angeschlossenes Oszilloskop eine Sinuskurve zu zeichnen, mehr nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
