                ],
                "senses": [
                    {
                        "sense_id": "d36540f7-9cd6-326a-becf-54e2bf48d772",
                        "entry_id": "790fdd8c-c891-37fe-86b0-f618f2a8e38e",
                        "glosses": [
                            "einem Gott ähnelnd, wie ein Gott"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7736eb48-d103-439a-b58c-7b554b52880e",
                                "sense_id": "d36540f7-9cd6-326a-becf-54e2bf48d772",
                                "text": "„Die Konquistadoren konnten sich unbehelligt und sicher bewegen, weil Atahualpa den Inka weiterhin als gottähnlicher Herrscher galt.“"
                            },
                            {
                                "example_id": "3bae35c1-e805-4335-9f57-1f859177e434",
                                "sense_id": "d36540f7-9cd6-326a-becf-54e2bf48d772",
                                "text": "„In den jämmerlichen, erschöpften Resten dessen, was einmal seine Seele war, wird er nichts finden, woraus sich das geringste gottähnliche Ding verfertigen ließe, das ihm in diesen letzten Tagen Orientierung geben könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
