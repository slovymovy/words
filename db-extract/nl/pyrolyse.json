                                "target_senses": [
                                    {
                                        "sense_id": "c5049870-ac00-3c3a-9486-4609433c6df9",
                                        "entry_id": "a64d7b64-332b-3b79-9071-d75369bc2e34",
                                        "glosses": [
                                            "The decomposition of a material or compound due to heat, in the absence of oxygen or other reagents."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2414c61f-72e2-42eb-ad80-db69ce3593c3",
                                                "sense_id": "c5049870-ac00-3c3a-9486-4609433c6df9",
                                                "text": "Techniques that have successfully identified ionic intermediates in solution have been applied to gas-phase pyrolyses."
                                            },
                                            {
                                                "example_id": "ead1661c-c3f8-4221-993e-94884c197ae9",
                                                "sense_id": "c5049870-ac00-3c3a-9486-4609433c6df9",
                                                "text": "Twenty years ago our real understanding of the mechanism of alkane pyrolyses was little better than rudimentary."
                                            },
                                            {
                                                "example_id": "2325ac87-759a-41ac-9c13-4dd1609e4b03",
                                                "sense_id": "c5049870-ac00-3c3a-9486-4609433c6df9",
                                                "text": "Pyrolysis involves the thermal degradation of the rubber of the tyre to give an oil and gas leaving a residual solid carbon and the steel casing of the tyre."
                                            },
                                            {
                                                "example_id": "a6df86a5-ca5f-4639-b278-5acb400ba7e8",
                                                "sense_id": "c5049870-ac00-3c3a-9486-4609433c6df9",
                                                "text": "Traditional pyrolysis of wood relies on low temperatures and long processing time to increase the charcoal yield. In contrast, modern or fast pyrolysis uses moderate temperatures (400-500°C) and very short residence times (typically only a few seconds) to maximize the production of liquids (Diebold and Bridgewater, 1997)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f699cb0d-3aae-4906-b517-f08529323086",
                        "source_entry_id": "e06a38fa-68a3-3ae5-b714-4ee0a4284437",
                        "source_sense_id": "883de455-8bc1-3681-a1f3-970e86d5e3ae",
