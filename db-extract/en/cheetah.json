                    {
                        "translation_id": "ca9075c5-6694-4f7e-b4af-e777db03333c",
                        "source_entry_id": "fd0bda32-b24a-3642-bb90-4f45f0f6775f",
                        "source_sense_id": "e9e75611-601f-385e-a23d-aa0c13d91133",
                        "source_sense_description": "Acinonyx jubatus",
                        "target_lang_word": "Gepard",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gepard",
