                    {
                        "translation_id": "f1eb6665-cc68-40b2-9e36-9aafde497913",
                        "source_entry_id": "0f4cd3c1-8b0b-33ce-a90d-ce932d3f5aef",
                        "source_sense_id": "809a37ea-357a-3f27-98ef-85415a64653e",
                        "target_lang_word": "librettista",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "librettista",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "95d826e1-534e-36c9-9245-88b20ff87bc0",
                                        "entry_id": "b030f969-a144-3b84-83c2-efd5c070e1e8",
                                        "glosses": [
                                            "chi scrive il libretto delle opere liriche e dei melodrammi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "875cf97b-ccfb-4736-abd0-4996ac7e3176",
                                                "sense_id": "95d826e1-534e-36c9-9245-88b20ff87bc0",
                                                "text": "Lorenzo Da Ponte è stato il librettista di tre opere di Mozart"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06b3b23a-6ed5-44f8-91d5-ac3d000bb369",
                        "source_entry_id": "0f4cd3c1-8b0b-33ce-a90d-ce932d3f5aef",
                        "source_sense_id": "809a37ea-357a-3f27-98ef-85415a64653e",
                        "target_lang_word": "Librettist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Librettist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4357973-fb32-3603-9009-90acb554e1c3",
                                        "entry_id": "d709a1e0-09ed-3e7e-b544-282b599d9360",
                                        "glosses": [
                                            "Person, die Texte für musikalische Bühnenstücke (Libretti) schreibt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5a31f77-21bb-42e3-ae7f-39b95cf40414",
                                                "sense_id": "c4357973-fb32-3603-9009-90acb554e1c3",
                                                "text": "„Wien hab ich mir sagen lassen ist bekanntlich das Mekka der Librettisten.“"
                                            },
                                            {
                                                "example_id": "cc65da5f-094b-48a9-ae21-43c5e1add86f",
                                                "sense_id": "c4357973-fb32-3603-9009-90acb554e1c3",
                                                "text": "„Wieland war eben nicht bloß Librettist, sondern löste als Librettist an Schweitzers Seite ein, was er konzeptionell entwarf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52007cc4-0da1-4036-9fed-14206e06d839",
                        "source_entry_id": "0f4cd3c1-8b0b-33ce-a90d-ce932d3f5aef",
                        "source_sense_id": "809a37ea-357a-3f27-98ef-85415a64653e",
                        "target_lang_word": "librettist",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "librettist",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "46651b24-aebd-3e86-9bfd-b4cef9b19466",
                                        "entry_id": "c2d94e4d-ebba-332b-b719-f6eb13f07f37",
                                        "glosses": [
                                            "iemand die de tekst maakt van een opera"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faa359b2-84d2-4ea9-8184-8d9daf91110d",
                                                "sense_id": "46651b24-aebd-3e86-9bfd-b4cef9b19466",
                                                "text": "Componist Klaas de Vries en librettist David Mitchell deden in hun opera niets anders dan wat de betere muziektheatermakers al honderden jaren doen: het geven van een eigen en eigentijdse artistieke verbeelding van universele menselijke gevoelens en ideeën. Leidend tot lering, troost, vermaak, of inzicht."
                                            },
                                            {
                                                "example_id": "b4a2d7a8-b729-4ad8-b306-e4d5c3021f4f",
                                                "sense_id": "46651b24-aebd-3e86-9bfd-b4cef9b19466",
                                                "text": "Hôtel de Pékin, geschreven door de Nederlandse componist Willem Jeths en librettist Friso Haverkamp, is een opera over het tragische leven van Cixi, de laatste keizerin van China."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6ff1a3e-387c-4132-b819-00a999f47a96",
                        "source_entry_id": "0f4cd3c1-8b0b-33ce-a90d-ce932d3f5aef",
                        "source_sense_id": "809a37ea-357a-3f27-98ef-85415a64653e",
                        "target_lang_word": "librecista",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1870024a-7fdf-4c23-8cb0-abe0254257c7",
                        "source_entry_id": "0f4cd3c1-8b0b-33ce-a90d-ce932d3f5aef",
                        "source_sense_id": "809a37ea-357a-3f27-98ef-85415a64653e",
                        "target_lang_word": "librettiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "librettiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f21642a1-974f-3d2d-a816-d20a466aada5",
                                        "entry_id": "f71430ea-03bd-3077-9237-12a7969a0e95",
                                        "glosses": [
                                            "Auteur d’un libretto, d’un livret, c’est-à-dire le texte d’une œuvre lyrique, comme un opéra, une cantate, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03b54f19-37bc-4622-9b6a-dfcda741c368",
                                                "sense_id": "f21642a1-974f-3d2d-a816-d20a466aada5",
                                                "text": "Une raison temporelle, liée au genre musical, peut expliquer la suppression, par le librettiste, des neuf personnages."
                                            },
                                            {
                                                "example_id": "b5f0b954-89c2-4942-a125-e4bde3ada455",
                                                "sense_id": "f21642a1-974f-3d2d-a816-d20a466aada5",
                                                "text": "Mozart était très exigeant pour ses livrets et il avait, autant qu’il le pouvait, des liens très étroits avec ses librettistes, afin que les textes fussent mis au point d’une façon qui le satisfit"
                                            },
                                            {
                                                "example_id": "c63035a8-d7b2-484b-8658-0ad18c3ac9f2",
                                                "sense_id": "f21642a1-974f-3d2d-a816-d20a466aada5",
                                                "text": "En Grèce, à Rome, en Gaule, le librettiste, au contraire, devait être doublé d'un poète de talent, puisque la musique suivait le rhythme du vers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
