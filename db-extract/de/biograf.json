                "senses": [
                    {
                        "sense_id": "fb4a497a-4ef5-373b-a6a8-ffcb5a9f020b",
                        "entry_id": "7fa26f81-d678-330b-815d-245f4c574e01",
                        "glosses": [
                            "jemand, der die Lebensgeschichte einer Person, ihre Biografie, erarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2381cb0c-7876-4029-9aa0-713d6197cf46",
                                "sense_id": "fb4a497a-4ef5-373b-a6a8-ffcb5a9f020b",
                                "text": "Der Biograf deckte in seinem Buch einige unbekannte Seiten des verstorbenen Stars auf."
                            },
                            {
                                "example_id": "ad9880b6-895b-4c68-a86f-8ecb718fcbd2",
                                "sense_id": "fb4a497a-4ef5-373b-a6a8-ffcb5a9f020b",
                                "text": "„Melanchthons Intimfreund und erster Biograf Joachim Camerarius machte sich über die Sterndeuterei des Faust lustig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dccdf1e-7413-41ce-ab7b-fa2b058429a1",
                        "source_entry_id": "7fa26f81-d678-330b-815d-245f4c574e01",
                        "source_sense_id": "fb4a497a-4ef5-373b-a6a8-ffcb5a9f020b",
                        "source_sense_description": "jemand, der die Lebensgeschichte einer Person, ihre Biografie, erarbeitet",
                        "target_lang_word": "biographer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biographer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b41d8c3b-d23a-3033-88a3-a06f9ee6d51a",
                                        "entry_id": "7ee55445-1158-3cf9-ab14-2aee39bb3c38",
                                        "glosses": [
                                            "The writer of a biography; a professional writer of biographies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5184c3a-117d-4d1b-8ee0-d35d17eb2a6d",
                                                "sense_id": "b41d8c3b-d23a-3033-88a3-a06f9ee6d51a",
                                                "text": "Albert Bigelow Paine, his biographer to be and literary executor, who has been constantly with him, said that for the last year at least Mr. Clemens had been weary of life. When Richard Watson Gilder died, he said: \"How fortunate he is. No good fortune of that kind ever comes to me.\""
                                            },
                                            {
                                                "example_id": "f50b0233-92af-4305-8f16-cf01d8f63ed9",
                                                "sense_id": "b41d8c3b-d23a-3033-88a3-a06f9ee6d51a",
                                                "text": "In May 1898, for example, the funeral train of our Mr Gladstone would be brought from his country estate at Hawarden to Westminster station on the District Line via Willesden Junction. One of his biographers notes, 'Victorians saw no indignity in a coffin for a state funeral arriving by Underground.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65d2906d-dc03-4025-b0c2-567893789ed0",
                        "source_entry_id": "7fa26f81-d678-330b-815d-245f4c574e01",
                        "source_sense_id": "fb4a497a-4ef5-373b-a6a8-ffcb5a9f020b",
                        "source_sense_description": "jemand, der die Lebensgeschichte einer Person, ihre Biografie, erarbeitet",
                        "target_lang_word": "biographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59c90e3d-a70e-3ba1-9567-905c3b93b31d",
                                        "entry_id": "ec9bfe1c-334f-326e-b7d5-d47a244e8f99",
                                        "glosses": [
                                            "Personne qui a écrit une ou plusieurs biographies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d43c2ab-2b75-47ee-a9de-6152d4c479f2",
                                                "sense_id": "59c90e3d-a70e-3ba1-9567-905c3b93b31d",
                                                "text": "Quelle fut, au juste, la sentence rendue par l'Official ? Les biographes nous racontent qu'il n'y en eut pas, […]."
                                            },
                                            {
                                                "example_id": "4dfa6071-69bb-499d-9924-ca419ed007ac",
                                                "sense_id": "59c90e3d-a70e-3ba1-9567-905c3b93b31d",
                                                "text": "Il n'est pas prudent, je le sais, de désavouer des biographes bien disposés en votre faveur, et qui peuvent vous menacer d'une édition revue et corrigée ; mais je n'ai jamais été prudente en quoi que ce soit."
                                            },
                                            {
                                                "example_id": "f1586e36-30cc-47c5-adb2-a3f7ecfdc356",
                                                "sense_id": "59c90e3d-a70e-3ba1-9567-905c3b93b31d",
                                                "text": "Déjà les biographes veillaient au grain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "537f0ee3-6bb7-41fd-8de6-a4e84a696dad",
                        "source_entry_id": "7fa26f81-d678-330b-815d-245f4c574e01",
                        "source_sense_id": "fb4a497a-4ef5-373b-a6a8-ffcb5a9f020b",
