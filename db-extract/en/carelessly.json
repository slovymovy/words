                                        "examples": [
                                            {
                                                "example_id": "5a9d93cb-1768-4ad0-a90b-6e5e355e41d2",
                                                "sense_id": "a2dae8f2-3bd6-37fe-b898-edd3b5d6a6b9",
                                                "text": "Wie schaffst du es nur, so sorglos in die Zukunft zu blicken?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
