                ],
                "senses": [
                    {
                        "sense_id": "f3008194-0c34-35c2-b9ae-c2035c2e16f6",
                        "entry_id": "f94e645c-c73f-3757-a7db-a431d08a70a8",
                        "glosses": [
                            "Wahrnehmung von Geruch der von Basilikum stammt; explizite Zuordnung eines natürlichen Geruchsstoffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46e2f3a8-5bfe-4294-b557-a3e445d858d6",
                                "sense_id": "f3008194-0c34-35c2-b9ae-c2035c2e16f6",
                                "text": "„Der typisch aromatische Basilikumgeruch schwindet bei der Trocknung zu großen Teilen.“"
                            },
                            {
                                "example_id": "06db5b66-2524-44d6-98ca-a8579ff4ea4b",
                                "sense_id": "f3008194-0c34-35c2-b9ae-c2035c2e16f6",
                                "text": "„Beim Basilikumtofu schlägt einem beim Öffnen wirklich ein intensiver und angenehmer Basilikumgeruch entgegen, der Tofu Rosso sieht sehr lecker aus, hat eine echt schöne Farbe.“"
                            },
                            {
                                "example_id": "bf7a39af-80d2-4259-a072-e4d5d55eabcd",
                                "sense_id": "f3008194-0c34-35c2-b9ae-c2035c2e16f6",
                                "text": "„Serviert wird der leicht scharfe, erfrischende Drink in einem Cocktailglas mit Basilikumgeruch, einer Chillischote und einer Erdbeere. Perfekter Ort für eine perfekte Cocktailnacht.“"
                            },
                            {
                                "example_id": "be6cf462-ce20-4f03-bc57-963d43f91a67",
                                "sense_id": "f3008194-0c34-35c2-b9ae-c2035c2e16f6",
                                "text": "„Hohe Decken schlugen mir entgegen, ein beißender Basilikumgeruch kombiniert mit Tabak und ein leerer Vogelkäfig, an dem ich mir den Hinterkopf stieß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
