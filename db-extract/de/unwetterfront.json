                "senses": [
                    {
                        "sense_id": "16f22607-7f27-35c9-a61c-3718e6def854",
                        "entry_id": "14824a89-295c-3a5d-b6c2-10c465ec3c5f",
                        "glosses": [
                            "vorderer Bereich eines aufziehenden Unwetters (meist mit viel Wind und vielen Niederschlägen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f974b6f-9ae9-4cf7-8b4d-0277162700b4",
                                "sense_id": "16f22607-7f27-35c9-a61c-3718e6def854",
                                "text": "„Eine heftige Unwetterfront hat am gestrigen Abend Hamburg und Schleswig-Holstein getroffen und zu weitreichenden Überschwemmungen geführt.“"
                            },
                            {
                                "example_id": "aa37aa29-01c1-4c34-a0e5-66a2388c2ea5",
                                "sense_id": "16f22607-7f27-35c9-a61c-3718e6def854",
                                "text": "„Eine Unwetterfront bringt Gewitter mit teils heftigen Folgen. Wie hier in Goslar kommt es zu Überschwemmungen.“"
                            },
                            {
                                "example_id": "bd0956f4-a82d-4e3c-a117-1cfd3d6d7366",
                                "sense_id": "16f22607-7f27-35c9-a61c-3718e6def854",
                                "text": "„Eine Unwetterfront hat Mecklenburg-Vorpommern am Mittwoch mit Starkregen und blitzintensiven Gewittern überzogen.“"
                            },
                            {
                                "example_id": "b3bbe4e2-4a0f-49db-9391-831fd116e4d1",
                                "sense_id": "16f22607-7f27-35c9-a61c-3718e6def854",
                                "text": "„Am Meteorologischen Institut der Freien Universität Berlin wurde am 7. Juli 1957 ein X-Band-Radar (9 GHz) in Betrieb genommen. Noch am selben Tag konnte vor einer herannahenden Unwetterfront gewarnt werden.“"
                            },
                            {
                                "example_id": "b7831b6f-6577-42fd-8977-10ba7bacde7e",
                                "sense_id": "16f22607-7f27-35c9-a61c-3718e6def854",
                                "text": "„Während des Fluges geraten sie in eine Unwetterfront.“"
                            },
                            {
                                "example_id": "e3b6d5b3-715f-4d4f-9c3f-c5330cbcbbf7",
                                "sense_id": "16f22607-7f27-35c9-a61c-3718e6def854",
                                "text": "[24. Mai 2010:] „Die Unwetterfront, aus Südwestbrandenburg nach Südostsachsen ziehend, wütete auf einer 80 bis 100 Kilometer langen Strecke und verursacht neben den Tornados auch starken Hagel.“"
                            },
                            {
                                "example_id": "83949b17-d95d-441a-9e00-f6da411e2918",
                                "sense_id": "16f22607-7f27-35c9-a61c-3718e6def854",
                                "text": "[12./13. April 2020:] „An einer langgestreckten Unwetterfront bildete sich am Ostersonntag in den Bundesstaaten Texas, Louisiana, Arkansas, Mississippi, Tennessee, Alabama, Georgia, North Carolina und South Carolina eine Serie von etwa 60 Tornados.“"
                            },
                            {
                                "example_id": "040e3d7b-be3e-4e7b-ab9a-6aaa24bc1586",
                                "sense_id": "16f22607-7f27-35c9-a61c-3718e6def854",
                                "text": "[…] „am Donnerstagabend traf erneut eine Unwetterfront auf den Kanton.“"
                            },
                            {
                                "example_id": "9865bd5a-a187-4b80-85de-a4390cb254d9",
                                "sense_id": "16f22607-7f27-35c9-a61c-3718e6def854",
                                "text": "„Erneut ist am Donnerstagabend eine Unwetterfront über Teile der Schweiz gezogen.“"
                            },
                            {
                                "example_id": "f65080a0-64da-436b-99c8-75d22ebd9bf7",
                                "sense_id": "16f22607-7f27-35c9-a61c-3718e6def854",
                                "text": "„Der Deutsche Wetterdienst hatte seit dem Nachmittag vor schweren Unwettern gewarnt. Wenig später zog eine Unwetterfront über den Süden Bayerns und löste zahlreiche Feuerwehreinsätze aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
