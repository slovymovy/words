            {
                "entry_id": "a2ffa336-ebd7-3eec-98cd-7d6fe1fd8175",
                "word": "transatlantique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "174191aa-4b3e-4be2-8456-027a7f345198",
                        "entry_id": "a2ffa336-ebd7-3eec-98cd-7d6fe1fd8175",
                        "tags": [
                            "plural"
                        ],
                        "form": "transatlantiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4e16bd6c-39ac-3fd2-b668-f06951021759",
                        "entry_id": "a2ffa336-ebd7-3eec-98cd-7d6fe1fd8175",
                        "glosses": [
                            "Paquebot qui fait le service entre l’Europe et l’Amérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "689fb39d-8835-4287-8288-79f46091ead9",
                                "sense_id": "4e16bd6c-39ac-3fd2-b668-f06951021759",
                                "text": "La ville était détruite et deux grands transatlantiques avaient sombré dans le port encore plein de cadavres."
                            },
                            {
                                "example_id": "eb345143-728b-4df8-bf17-682e45a01265",
                                "sense_id": "4e16bd6c-39ac-3fd2-b668-f06951021759",
                                "text": "Bellonte rangea à la hâte ses cartes et le tableau de position des transatlantiques croisant entre l’Europe et l’Amérique."
                            },
                            {
                                "example_id": "2e8abfcc-c0ee-4afd-a33d-7207e47e357d",
                                "sense_id": "4e16bd6c-39ac-3fd2-b668-f06951021759",
                                "text": "Il saisit rageusement sa perruque, qui lui redonnait pour un soir la chevelure bananoïde de ses chères sixties, et la jette dans le lavabo où elle se met à sombrer comme un transatlantique."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e53cb90-4c61-3998-acef-b95143b40970",
                        "entry_id": "a2ffa336-ebd7-3eec-98cd-7d6fe1fd8175",
                        "glosses": [
                            "Fauteuil pliant à siège en toile, qu’on trouvait sur les ponts des paquebots transatlantiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bc6834b-ba67-4d18-bcbb-df5776e394a2",
                                "sense_id": "4e53cb90-4c61-3998-acef-b95143b40970",
                                "text": "Maman de se baignait pas, elle restait sur son transatlantique et faisait de grands gestes pour nous faire revenir."
                            },
                            {
                                "example_id": "f9bdad96-b357-456f-a868-f39438b89f1a",
                                "sense_id": "4e53cb90-4c61-3998-acef-b95143b40970",
                                "text": "Après le déjeuner, lorsque le soleil africain tombe en pluie de feu sur l'herbe mourante, on nous forçait à nous « reposer » une heure, à l'ombre du figuier, sur ces fauteuils pliants nommés « transatlantiques » qu'il est difficile d'ouvrir correctement, qui pincent cruellement les doigts, et qui s'effondrent parfois sous le dormeur stupéfait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8916d0f8-89d7-4aca-8ee1-3e7938475570",
                        "source_entry_id": "a2ffa336-ebd7-3eec-98cd-7d6fe1fd8175",
                        "target_lang_word": "transatlántico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transatlántico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "1e131137-7843-324d-8653-409931295467",
                                        "entry_id": "df9284f5-2d34-340d-90d0-c8c38deb44c7",
