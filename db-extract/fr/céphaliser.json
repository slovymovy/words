                ],
                "senses": [
                    {
                        "sense_id": "ce9a8b6a-fed3-3b46-85bd-3e7deb415983",
                        "entry_id": "379792a4-d15e-394c-8f27-827350fbf3b8",
                        "glosses": [
                            "Considérer comme céphalique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2702a859-da50-4548-abfd-56a6dcf10c7c",
                                "sense_id": "ce9a8b6a-fed3-3b46-85bd-3e7deb415983",
                                "text": "Si la pathologie physique était trop souvent décapitée par souci ou par routine méthodologique, évitons maintenant de la « céphaliser » à l'excès."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d86d8c6-15f9-339a-9087-0c0a479597ad",
                        "entry_id": "379792a4-d15e-394c-8f27-827350fbf3b8",
                        "glosses": [
                            "Se concentrer, pour devenir une tête."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "71af15e9-7676-48b0-b1e3-6f0c89fe4d33",
                                "sense_id": "4d86d8c6-15f9-339a-9087-0c0a479597ad",
                                "text": "Une loi générale que, chez les animaux construits pour la marche, les organes ont une tendance à quitter la partie postérieure, pour se porter en avant, se céphaliser, comme on dit."
                            }
                        ]
                    }
