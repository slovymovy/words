            "senses": [
                {
                    "sense_id": "ee52f859-0d82-33d5-bc80-0cf10108d3bc",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>zijn</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verb_be_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>ben</w> erg blij met mijn nieuwe fiets.",
                            "target_lang_translations": {
                                "en": "I <w>am</w> very happy with my new bike.",
                                "ru": "Я очень <w>рад</w> своему новому велосипеду."
                            }
                        },
                        {
                            "text": "Vandaag <w>ben</w> ik jarig en geef ik een feestje.",
                            "target_lang_translations": {
                                "en": "Today it <w>is</w> my birthday and I am throwing a party.",
                                "ru": "Сегодня у меня <w>день рождения</w>, и я устраиваю вечеринку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ik ben",
                        "ik ben het"
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of <w>to be</w>",
                        "ru": "форма первого лица единственного числа настоящего времени глагола <w>zijn</w> (быть)"
                    },
                    "translations": {
                        "en": [
                            {
