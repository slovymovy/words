                        "glosses": [
                            "A person who keeps an aviary."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6539f25b-1752-4530-abb7-c7fe75d9d80c",
                                "sense_id": "b3cd17c9-5870-3b4e-8fe8-e32758015fbd",
                                "text": "But if the Aviarist be ambitious to keep the lovely, but destructive, members of the Parrot family, he must be content with grass alone, because Parrakeets (except the weak-billed Turquoisines and Elegants) would destroy the shrubs and trees in a day."
                            },
                            {
                                "example_id": "5d92621e-f60f-4e3a-a4de-97fb083e047b",
                                "sense_id": "b3cd17c9-5870-3b4e-8fe8-e32758015fbd",
                                "text": "Since then the price of these handsome Doves has fallen considerably, but it is still sufficiently high to make a good breeding pair of them a by no means unprofitable investment for the aviarist."
                            },
                            {
                                "example_id": "f3029bfd-9207-4089-bf13-694a7d20af91",
                                "sense_id": "b3cd17c9-5870-3b4e-8fe8-e32758015fbd",
                                "text": "1979, Al Shenk, Calculus and Analytic Geometry, 2nd Edition, Scott Foresman, page 385,\nAn aviarist is watching one of his birds that has escaped and is flying directly south from the aviary at a height of 100 feet above the aviarist’s eye level."
                            }
                        ]
                    }
