                "senses": [
                    {
                        "sense_id": "ac6583ff-8e2c-3a85-83af-4bd4c941a50a",
                        "entry_id": "b48c05c5-0478-3bbc-906a-28ab13ae185f",
                        "glosses": [
                            "устар., зоол. то же, что опоссум"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19a2c1b4-d95a-419f-bc87-6cd0302f30b8",
                                "sense_id": "ac6583ff-8e2c-3a85-83af-4bd4c941a50a",
                                "text": "Двуутробка забирает своих детёнышей и устремляется на верхушку дерева, услыхав треск сучьев под ногами кровожадного леопарда."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1c145d5-c330-3305-bd3b-e9c7285e454d",
                        "entry_id": "b48c05c5-0478-3bbc-906a-28ab13ae185f",
                        "glosses": [
                            "устар., зоол. любое сумчатое животное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62d4178d-216a-451c-b5ce-e6427fedc514",
                                "sense_id": "e1c145d5-c330-3305-bd3b-e9c7285e454d",
                                "text": "Оказывается, не только кенгуру, а самые разные животные в Австралии — все двуутробки, с сумками на животах!"
                            }
                        ]
                    }
                ],
