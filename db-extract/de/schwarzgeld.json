                "senses": [
                    {
                        "sense_id": "2771f33f-fd13-3dd6-8698-980a0d18afc6",
                        "entry_id": "9e185eb7-a6c6-32d2-b3aa-c7676dd64c4d",
                        "glosses": [
                            "Einkünfte, die nicht versteuert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9b4988-a936-47c2-9578-06f8c9304bb6",
                                "sense_id": "2771f33f-fd13-3dd6-8698-980a0d18afc6",
                                "text": "Bei diesem Geschäftsabschluss ist wahrscheinlich viel Schwarzgeld geflossen."
                            },
                            {
                                "example_id": "909021b1-aa42-4dbf-9e9f-915335f5d423",
                                "sense_id": "2771f33f-fd13-3dd6-8698-980a0d18afc6",
                                "text": "„Die Anleger hatten Geld in sogenannte Bermuda-Versicherungen gesteckt, spezielle »Lebensversicherungen«, mit denen sich Schwarzgeld angeblich risikolos reinwaschen ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9564e4ef-53aa-48ac-8abe-0051bb7e6ca6",
                        "source_entry_id": "9e185eb7-a6c6-32d2-b3aa-c7676dd64c4d",
                        "source_sense_id": "2771f33f-fd13-3dd6-8698-980a0d18afc6",
                        "source_sense_description": "Einkünfte, die nicht versteuert sind",
                        "target_lang_word": "dirty money",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dirty money",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8e1bf9c-6816-323b-aded-8c8e75ab0fb8",
                                        "entry_id": "045c8142-9ec1-37ee-9e4d-1db1d953baa1",
                                        "glosses": [
                                            "Money that is illegally gained, illegally transferred or illegally utilized, especially money gained through forgery, bribery, prostitution, money laundering, or theft."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c135facd-020f-461c-8236-266662bb94f6",
                                                "sense_id": "f8e1bf9c-6816-323b-aded-8c8e75ab0fb8",
                                                "text": "Corruption is a force multiplier for the West's enemies, and yet the West continues to accept dirty money into its economies by the billion."
                                            },
                                            {
                                                "example_id": "98fa361b-6453-40b3-a8fc-8e60c1bc062c",
                                                "sense_id": "f8e1bf9c-6816-323b-aded-8c8e75ab0fb8",
                                                "text": "Taken together, the articles exposed a dark truth: “Dirty money” — terrorist financing, drug cartel funds, fortunes embezzled from developing nations, the profits from organized crime — flows so freely through the world’s most powerful financial institutions that it has become inextricable from the so-called legitimate economy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e43aea7-956f-32c2-acc2-30ac5959e0a2",
                                        "entry_id": "045c8142-9ec1-37ee-9e4d-1db1d953baa1",
                                        "glosses": [
                                            "Extra money paid to workers as compensation for dirty or dangerous work."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a66835e-031a-48b4-8519-167fce00db9b",
                                                "sense_id": "1e43aea7-956f-32c2-acc2-30ac5959e0a2",
                                                "text": "The days should be long gone when workers are paid dirty money to do a risky job […]"
                                            },
                                            {
                                                "example_id": "496291fc-ae08-40fb-96ac-4e622cb4137c",
                                                "sense_id": "1e43aea7-956f-32c2-acc2-30ac5959e0a2",
                                                "text": "[…] much of the set was smeared with oil and grease. This did, however, lead to a very unpleasant working environment. 'Everyone working on the film was paid “dirty” money,' recalls Maurice. 'I got seven and six a week “dirty money”, which was wonderful for a fifteen-year-old.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f78fe05a-235a-40ec-b843-ca5239bba269",
                        "source_entry_id": "9e185eb7-a6c6-32d2-b3aa-c7676dd64c4d",
                        "source_sense_id": "2771f33f-fd13-3dd6-8698-980a0d18afc6",
                        "source_sense_description": "Einkünfte, die nicht versteuert sind",
                        "target_lang_word": "argent sale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argent sale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39d6be21-105c-3cf7-bd6b-42f205895179",
                                        "entry_id": "ad735005-c780-30d6-ac55-79604aa03917",
                                        "glosses": [
                                            "Argent obtenu d’une manière illégale, frauduleuse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ae5d831-c365-4670-b30a-e7e250f35eba",
                                                "sense_id": "39d6be21-105c-3cf7-bd6b-42f205895179",
                                                "text": "Le bitcoin est défini comme une donnée informatique qui passe directement de l'ordinateur du vendeur à celui de l'acheteur en P2P (peer to peer, d'ordinateur à ordinateur). Ces monnaies virtuelles représentent donc l'outil rêvé pour les transactions qui nécessitent une opacité extrême et une discrétion totale comme celles qui participent au blanchiment de l’argent sale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34d8d47e-464f-49a8-9f59-faf1036ead4a",
                        "source_entry_id": "9e185eb7-a6c6-32d2-b3aa-c7676dd64c4d",
                        "source_sense_id": "2771f33f-fd13-3dd6-8698-980a0d18afc6",
