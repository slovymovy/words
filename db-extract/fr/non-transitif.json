                        "sense_id": "6e35f7d8-30c0-3709-95d6-06e25b3e503b",
                        "entry_id": "a714ae52-a2fd-3fe7-9c28-6ba883feea1b",
                        "glosses": [
                            "Se dit d’une relation qui n’est ni transitive, ni intransitive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f08a99e-f7e3-436c-8447-219b53fabbd8",
                                "sense_id": "6e35f7d8-30c0-3709-95d6-06e25b3e503b",
                                "text": "L’inégalité n’est pas une relation transitive; elle n’est pas non plus intransitive. En effet, si x≠y et si y≠z, alors on ne peut rien dire sur l’inégalité de x et z (ils peuvent être différents ou non). C’est pourquoi l’inégalité est dite non-transitive."
                            }
                        ]
                    }
