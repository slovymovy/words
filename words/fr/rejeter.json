                    "frequency": "Middle",
                    "semantic_group_id": "attribuer_blame",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse d'assumer ses erreurs et préfère <w>rejeter</w> la faute sur ses partenaires."
