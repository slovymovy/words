                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea30f987-457e-4299-8a4d-a0b39aa3aaec",
                                "sense_id": "45831225-5003-388b-96c4-5215e3ec2f90",
                                "text": "Elle restait là où elle était, immobile, inconsolable et comme une chiffe aux mains des bonnes femmes qui s’efforçaient de la réconforter."
                            },
                            {
                                "example_id": "cc8d58bc-35ef-4cde-9cad-d4c5e5c64edf",
                                "sense_id": "45831225-5003-388b-96c4-5215e3ec2f90",
                                "text": "Je me rappellerai que je porte en moi une enfant inconsolable que le poème, parfois, illumine."
                            }
                        ]
                    },
