                "forms": [],
                "senses": [
                    {
                        "sense_id": "3d571faa-41d1-3643-a6d5-ad09dcbaa1ec",
                        "entry_id": "f86c8fbc-4e89-3ea4-9af1-b95b32ef8974",
                        "glosses": [
                            "Endroit où l’on demeure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fca979d4-99b3-46ee-acc5-59d63621889c",
                                "sense_id": "3d571faa-41d1-3643-a6d5-ad09dcbaa1ec",
                                "text": "La chatte inquiète a cherché un autre logis, et moi j’ai pris le chemin qui roule des pierres pour descendre dans la vallée."
                            },
                            {
                                "example_id": "1df31cbc-b834-4a41-b67b-157479e2467d",
                                "sense_id": "3d571faa-41d1-3643-a6d5-ad09dcbaa1ec",
                                "text": "Si une semaine s’écoulait sans escapade, on le voyait s’ennuyer, dépérir et fureter dans le logis pour trouver une issue."
                            },
                            {
                                "example_id": "9d3cbebb-36e1-4575-93bb-406309511272",
                                "sense_id": "3d571faa-41d1-3643-a6d5-ad09dcbaa1ec",
                                "text": "Ces ensembles sont composés d’un bon logis auquel s’accole une grange en large."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "430bb1a4-2fdc-45b8-9ce6-62f5e8321b34",
