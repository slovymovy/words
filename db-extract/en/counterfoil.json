                                "target_senses": [
                                    {
                                        "sense_id": "425383d1-8d89-3896-a144-44ab42b7b3b4",
                                        "entry_id": "da57234b-f6b4-319a-ae8c-9213ffa375df",
                                        "glosses": [
                                            "das Abgeschnittene, Abgetrennte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54b71171-a4a9-48f9-8e9d-35bc6ac70281",
                                                "sense_id": "425383d1-8d89-3896-a144-44ab42b7b3b4",
                                                "text": "Selbst nach dem Film, der so packend war, hielt ich noch den durchgeschwitzten Abschnitt der Eintrittskarte in meinen Händen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b116f34-dff8-3f85-b6c7-10a0ef9d9123",
                                        "entry_id": "da57234b-f6b4-319a-ae8c-9213ffa375df",
                                        "glosses": [
                                            "ein Teil eines Textes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb56b9b-addf-4d23-aa41-8147229de367",
                                                "sense_id": "4b116f34-dff8-3f85-b6c7-10a0ef9d9123",
                                                "text": "Das steht im nächsten Abschnitt."
                                            },
                                            {
                                                "example_id": "dc7b761e-0a37-4410-b93c-574245d3d948",
                                                "sense_id": "4b116f34-dff8-3f85-b6c7-10a0ef9d9123",
                                                "text": "„Drei weitere Schreibkräfte versuchten sich an den Seiten nach dem fehlenden Kirke-Kapitel, und schließlich konnte sie Monsieur Darantiere den ersten Teil zum Setzen schicken, mit dem Hinweis, dass sich darin noch eine Lücke befand, weil sie auf einen fehlenden Abschnitt aus Amerika wartete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bc6cc67c-ab47-3e5e-b44d-685a94993260",
                                        "entry_id": "da57234b-f6b4-319a-ae8c-9213ffa375df",
                                        "glosses": [
                                            "ein Teil eines Geländes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db3a813-8b57-4e34-b6ca-a2c2086de0cc",
                                                "sense_id": "bc6cc67c-ab47-3e5e-b44d-685a94993260",
                                                "text": "Dieser Abschnitt darf nicht betreten werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "18c20951-348c-3373-8a54-213a7cf23867",
                                        "entry_id": "da57234b-f6b4-319a-ae8c-9213ffa375df",
                                        "glosses": [
                                            "Teil der Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3848129c-e7c7-472f-85da-01969c97aa3c",
                                                "sense_id": "18c20951-348c-3373-8a54-213a7cf23867",
                                                "text": "Als ich den türkischen Touristenführer nach seiner Meinung über Deutsche fragte, nannte er als positive Eigenschaft, dass die Deutschen jeden Abschnitt ihres Lebens genießen können."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0429e22e-b745-35fa-b665-3559c65ce3c2",
                                        "entry_id": "da57234b-f6b4-319a-ae8c-9213ffa375df",
                                        "glosses": [
                                            "ein Teil der Kreisscheibe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3dc2c3c-a60f-4226-b0e6-eab6f2910ddd",
                                                "sense_id": "0429e22e-b745-35fa-b665-3559c65ce3c2",
                                                "text": "Der Abschnitt des Kreises ist gelb und wird mit der Kreissehne s vom Kreis getrennt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "2f1a6af2-3e54-36e2-adec-f851a7fd4673",
                                        "entry_id": "da57234b-f6b4-319a-ae8c-9213ffa375df",
                                        "glosses": [
                                            "Abriss einer Eintrittskarte oder eines Gutscheins: Kupon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ac60ab7-321c-4b8f-a4eb-5c9f9200af68",
                                                "sense_id": "2f1a6af2-3e54-36e2-adec-f851a7fd4673",
                                                "text": "Auf dem Abschnitt der Eintrittskarte steht, dass er bis zum Verlassen des Films aufbewahrt werden muss."
                                            }
