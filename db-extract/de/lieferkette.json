                "senses": [
                    {
                        "sense_id": "02191a9d-f71a-369e-a0b0-65ae1ef27d36",
                        "entry_id": "20037240-4c82-3c42-a64c-519608900f4f",
                        "glosses": [
                            "Chaîne d’approvisionnement ; aussi chaîne logistique."
                        ],
                        "tags": [
                            "Industrie",
                            "Logistique"
                        ],
                        "examples": [
                            {
                                "example_id": "2866984c-ab54-4322-8181-024b67a28b3d",
                                "sense_id": "02191a9d-f71a-369e-a0b0-65ae1ef27d36",
                                "text": "Die Ausbreitung des neuartigen Coronavirus wird zunehmend zum Problem der global verzahnten Lieferketten."
                            },
                            {
                                "example_id": "1851befd-7912-4884-bc88-562b1f29d3da",
                                "sense_id": "02191a9d-f71a-369e-a0b0-65ae1ef27d36",
                                "text": "Unterbrochene Lieferketten sorgen dafür, dass sich Unternehmen im Westen diversifizieren, nicht mehr alles in China einkaufen.",
                                "translation": "Les chaînes d’approvisionnement interrompues font en sorte que les entreprises occidentales se diversifient et n’achètent plus tout en Chine."
                            }
                        ]
                    }
                ],
