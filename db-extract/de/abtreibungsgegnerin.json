                "senses": [
                    {
                        "sense_id": "f50f886d-5da5-3d85-a549-46a70c5209ba",
                        "entry_id": "4a36cd99-e148-32b0-a3c5-d5de3a255270",
                        "glosses": [
                            "weibliche Person, welche aus moralischen Gründen die Abtreibung ablehnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a552bee7-e23a-4bc3-8c35-0a4ee5959051",
                                "sense_id": "f50f886d-5da5-3d85-a549-46a70c5209ba",
                                "text": "„Laut ‚Kölner Stadtanzeiger‘ hat sich eine Abtreibungsgegnerin in einem der betroffenen Krankenhäuser als schwanger ausgegeben und die ‚Pille danach‘ verlangt.“"
                            },
                            {
                                "example_id": "a2cc64a6-463d-4e4e-a8eb-24dbcf8eb015",
                                "sense_id": "f50f886d-5da5-3d85-a549-46a70c5209ba",
                                "text": "„Wenige Monate später schoss die Abtreibungsgegnerin Shelley Shannon meinem Freund Dr. George Tiller in beide Arme, als er aus seiner Einfahrt in Wichita in Kansas fuhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
