                "senses": [
                    {
                        "sense_id": "e4f7d739-f869-370b-8594-25a8d25631af",
                        "entry_id": "2c80aa2a-69f2-39a3-88dc-976213c82b18",
                        "glosses": [
                            "Mettre dans un baquet d’eau salée, et plus généralement, préparer les saucissons, la charcuterie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "21ee93e8-3186-4e46-9ba9-23bc7dc7762c",
                                "sense_id": "e4f7d739-f869-370b-8594-25a8d25631af",
                                "text": "Les saucissons doivent être fabriqués pendant l’hiver, par un temps frais et sec. On baconne dans une chambre non chauffée, mais si la viande subissait un froid trop rigoureux, elle resterait pâle et n’aurait jamais la couleur rose, un des attraits de la charcuterie."
                            }
                        ]
                    }
