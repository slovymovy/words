                    "frequency": "High",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie a enfin <w>cessé</w> de tomber après plusieurs heures de violent orage."
                        },
                        {
                            "text": "Il a décidé de <w>cesser</w> de fumer pour préserver sa santé."
                        }
                    ],
                    "synonyms": [
