                        "form": "несладка́"
                    },
                    {
                        "form_id": "37647ea5-72fc-4593-9db7-56c347fc74c5",
                        "entry_id": "f1bdceaf-1c26-3eb3-ae51-1aed8ce1d7d1",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "несла́дки"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2bae20d-5527-3af6-b859-7e657594d7a0",
                        "entry_id": "f1bdceaf-1c26-3eb3-ae51-1aed8ce1d7d1",
                        "glosses": [
                            "не имеющий сладкого вкуса; без сахара"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a908cd-95e2-49a0-8d35-ccbbd1618454",
                                "sense_id": "e2bae20d-5527-3af6-b859-7e657594d7a0",
                                "text": "Я пил школьный чай несладким и нёс драгоценные кусочки домой."
                            },
                            {
                                "example_id": "2e687a11-cd67-4ef8-b4e3-d5cb9f8e29d7",
                                "sense_id": "e2bae20d-5527-3af6-b859-7e657594d7a0",
                                "text": "Больше того, пряник был просто отвратительный: тугой, житный, несладкий, с сильным запахом патоки."
                            }
                        ]
                    },
                    {
                        "sense_id": "e46dfbac-344d-3500-8da6-5feb5a5f6c57",
                        "entry_id": "f1bdceaf-1c26-3eb3-ae51-1aed8ce1d7d1",
                        "glosses": [
                            "перен., разг. нерадостный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47ae5cea-81a9-4e5e-b486-39708ef298a9",
                                "sense_id": "e46dfbac-344d-3500-8da6-5feb5a5f6c57",
                                "text": "Да, моя жизнь несладкая, и в другой раз она меня тяготит какой-то своей ненужностью…"
                            },
                            {
                                "example_id": "4bb71785-bdee-47cd-9a46-9d2475d30b0d",
                                "sense_id": "e46dfbac-344d-3500-8da6-5feb5a5f6c57",
                                "text": "Теперь Синцов хорошо увидел её лицо в крупных морщинах, лицо женщины уже старой, но ещё сильной многолетнею привычкой к упорному и несладкому труду."
                            }
                        ]
                    }
                ],
