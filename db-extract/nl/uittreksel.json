                                    {
                                        "sense_id": "29e81169-1bdd-380e-aee1-98592c58a9ec",
                                        "entry_id": "b9be6e7d-a810-32dd-8372-acfdc7499619",
                                        "glosses": [
                                            "Ce qu’on tire de quelque livre, de quelque registre, de quelque acte, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7449fa43-bdf9-4335-a9b2-60d7d6ab2378",
                                                "sense_id": "29e81169-1bdd-380e-aee1-98592c58a9ec",
                                                "text": "La Centre de Documentation du C.N.R.S. publie mensuellement un « BULLETIN SIGNALÉTIQUE » en plusieurs fascicules dans lesquels figurent sous la forme de courts extraits classés par matière, tous les travaux scientifiques et techniques publiés dans le monde entier."
                                            },
                                            {
                                                "example_id": "ba787870-6954-482d-aea8-1142bb632356",
                                                "sense_id": "29e81169-1bdd-380e-aee1-98592c58a9ec",
                                                "text": "Je ne connais pas l’ouvrage entier, mais j’en ai lu des extraits."
                                            },
                                            {
                                                "example_id": "4c4fea30-9424-40b1-8114-7b38b5c5dce7",
                                                "sense_id": "29e81169-1bdd-380e-aee1-98592c58a9ec",
                                                "text": "Extrait des registres de l’état civil."
                                            },
                                            {
                                                "example_id": "10c85a9d-06d4-43aa-8e68-4920c8eb356a",
                                                "sense_id": "29e81169-1bdd-380e-aee1-98592c58a9ec",
                                                "text": "Extrait sur minute."
                                            },
                                            {
                                                "example_id": "4a77726c-6872-4ad9-9508-6abe4b4b2484",
                                                "sense_id": "29e81169-1bdd-380e-aee1-98592c58a9ec",
                                                "text": "Extrait de naissance : Extrait du registre des naissances."
                                            },
                                            {
                                                "example_id": "83d2fe8c-d37d-4cea-a05b-31e9fc13cbb1",
                                                "sense_id": "29e81169-1bdd-380e-aee1-98592c58a9ec",
                                                "text": "Extrait de baptême : Extrait du registre des baptêmes."
                                            },
                                            {
                                                "example_id": "2420cfff-d770-42a8-a75b-6a7cc5e4bd1a",
                                                "sense_id": "29e81169-1bdd-380e-aee1-98592c58a9ec",
                                                "text": "Extrait mortuaire : Extrait du registre des décès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de03defd-1ea4-3a6f-8c10-8bf30d0fe46d",
                                        "entry_id": "b9be6e7d-a810-32dd-8372-acfdc7499619",
                                        "glosses": [
                                            "Abrégé, sommaire, analyse."
                                        ],
                                        "tags": [],
                                        "examples": [
