                        ]
                    },
                    {
                        "translation_id": "4af7043a-66c2-4863-b04d-05f2aed9dccb",
                        "source_entry_id": "c57f11a9-51af-3c5a-84f9-92247af9d2b0",
                        "source_sense_id": "0e080d58-413e-35b6-a2c3-1b2de0149ae7",
                        "source_sense_description": "plechtige gebeurtenis in de katholieke kerk",
                        "target_lang_word": "sacrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c14fc52-4ceb-37bc-87c5-9bc529e1b192",
                                        "entry_id": "61063724-35e2-3cfb-9eb0-5c6b4a092b97",
                                        "glosses": [
                                            "Action de sacrer, consécration, sanctification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f121cde6-5d1d-434f-af7d-7c84900c32fb",
                                                "sense_id": "4c14fc52-4ceb-37bc-87c5-9bc529e1b192",
                                                "text": "Les sacrements de l’ancienne loi. Les sacrements de la nouvelle loi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d0001fd-3583-3244-bbe9-8d32980e9368",
                                        "entry_id": "61063724-35e2-3cfb-9eb0-5c6b4a092b97",
                                        "glosses": [
                                            "Chez les Chrétiens, cérémonie destinée à la consécration religieuse des diverses phases de la vie privée des fidèles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a9ac751-ec0e-43a8-bc9b-bbb93f9f1d48",
                                                "sense_id": "9d0001fd-3583-3244-bbe9-8d32980e9368",
                                                "text": "Les casuistes relâchés croyaient être les meilleurs et les plus utiles défenseurs de l’Église ; ils empêchaient, en effet les chrétiens faibles de tomber dans l’irreligion et les amenaient à pratiquer les sacrements."
                                            },
                                            {
                                                "example_id": "095b2fe2-53c6-4b0a-8fe6-5c60e59acca8",
                                                "sense_id": "9d0001fd-3583-3244-bbe9-8d32980e9368",
                                                "text": "Les protestants ne conservent que deux des sept sacrements professés par l'Église catholique et reconnus par les Églises orthodoxes : le baptême et l'eucharistie, sans retenir la confirmation, la confession, le sacrement des malades, le mariage et l'ordination."
                                            },
                                            {
                                                "example_id": "600eb0cc-6edf-40da-8e13-609e5ddab1f4",
                                                "sense_id": "9d0001fd-3583-3244-bbe9-8d32980e9368",
                                                "text": "En voyant que son pénitent en revenait toujours à la honte de son inertie et à cet état de comateuse doléance dans lequel le plongeait la transe du Sacrement, le vieux prêtre lui dit : […]"
                                            },
                                            {
                                                "example_id": "24766d5e-7dc2-4862-8b7a-04bbd430e613",
                                                "sense_id": "9d0001fd-3583-3244-bbe9-8d32980e9368",
                                                "text": "Tout d’abord, le mariage est un sacrement, qui entraîne l’indissolubilité, car il représente l’union du Christ avec l’Église, c’est-à-dire avec les hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd84f9ae-bbe0-33af-8c8c-10afdfda3c13",
                                        "entry_id": "61063724-35e2-3cfb-9eb0-5c6b4a092b97",
                                        "glosses": [
                                            "L’eucharistie."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ed2f4d2-df2a-4424-b92b-4a9ef6db9aff",
                                                "sense_id": "dd84f9ae-bbe0-33af-8c8c-10afdfda3c13",
                                                "text": "Chaque jour de nombreuses troupes de fidèles accouraient à Château-Thébaud, de tous les côtés, pour recevoir les sacrements."
                                            },
                                            {
                                                "example_id": "4fd0533b-7318-4fec-a22b-58488f41d60a",
                                                "sense_id": "dd84f9ae-bbe0-33af-8c8c-10afdfda3c13",
                                                "text": "Sa foi catholique crevassée, l’Irlandaise tourna le dos aux sacrements, puis à la messe dominicale, ne daignant même pas faire des Pâques de renard."
                                            },
                                            {
                                                "example_id": "2b694a0b-1e88-402f-9ba1-ace072a3e26b",
                                                "sense_id": "dd84f9ae-bbe0-33af-8c8c-10afdfda3c13",
                                                "text": "S’approcher des sacrements, se confesser et communier."
                                            },
                                            {
                                                "example_id": "4494edd0-3623-438c-836c-a718d3432b40",
                                                "sense_id": "dd84f9ae-bbe0-33af-8c8c-10afdfda3c13",
                                                "text": "L’humble princesse [après son retour à la foi] ne crut pas qu’il lui fût permis d’approcher d’abord des saints sacrements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c46ae8eb-1a95-357b-aa4d-0d395928b563",
                                        "entry_id": "61063724-35e2-3cfb-9eb0-5c6b4a092b97",
                                        "glosses": [
                                            "L’extrême-onction, et plus largement les derniers sacrements."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc2d6778-d5e6-4d63-b8fe-6a14803cec68",
                                                "sense_id": "c46ae8eb-1a95-357b-aa4d-0d395928b563",
                                                "text": "Je crains qu’il ne soit mort sans les sacrements, mais je me refuse à croire qu’il n’est pas sauvé."
                                            },
                                            {
                                                "example_id": "712554dd-2b1d-4bc0-9689-7cef9fc67307",
                                                "sense_id": "c46ae8eb-1a95-357b-aa4d-0d395928b563",
                                                "text": "Mon grand-père était sonneur à Lyon, défunte ma mère servante chez M. le curé de Wilman, et il n’y a pas d’exemple qu’un des nôtres soit mort sans sacrements."
                                            },
                                            {
                                                "example_id": "453c51e6-ea26-4c84-bfd8-3ed2ace210eb",
                                                "sense_id": "c46ae8eb-1a95-357b-aa4d-0d395928b563",
                                                "text": "Décédé muni des sacrements de l’église."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7863a6a-d2d7-3f43-a1f4-ce75ab704c83",
                                        "entry_id": "61063724-35e2-3cfb-9eb0-5c6b4a092b97",
                                        "glosses": [
                                            "Le mariage."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60d68e6b-2733-49d3-955e-87d7c0cd8aab",
                                                "sense_id": "d7863a6a-d2d7-3f43-a1f4-ce75ab704c83",
                                                "text": "Ils vivaient ensemble longtemps avant le sacrement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sacrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc92c995-d67f-36c0-97e8-12e45aa0f41a",
                                        "entry_id": "5d44dc56-ab39-3343-9a0e-e6b8f36ee227",
                                        "glosses": [
                                            "Absolument."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfcea67d-8fd0-40f2-b9de-abc89c2f5197",
                                                "sense_id": "dc92c995-d67f-36c0-97e8-12e45aa0f41a",
                                                "text": "J'y peux rien, sacrement rien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
