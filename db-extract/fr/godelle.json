                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "3fcfaecb-3af2-4cd9-9657-a28ddbb28c05",
                                "sense_id": "7699ebf1-3806-31fa-9613-46a069554b8b",
                                "text": "Les godelles de la ferme sont rentrées à l’étable."
                            }
                        ]
