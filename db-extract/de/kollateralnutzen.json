                ],
                "senses": [
                    {
                        "sense_id": "f474bc89-2f04-326e-869a-a8a55b2aac74",
                        "entry_id": "ea9e5a67-66b5-3d14-8c07-5ce8dec6a25a",
                        "glosses": [
                            "(mögliche, auch vorgebliche) positive zusätzliche Auswirkung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a3ca51c-1c68-40df-8688-1e9e07eee02c",
                                "sense_id": "f474bc89-2f04-326e-869a-a8a55b2aac74",
                                "text": "„Wenn sich dann auch die SPD stabilisieren könnte, wäre das ein Kollateralnutzen.“"
                            },
                            {
                                "example_id": "23c1ec89-78ad-47b8-af4f-0011a61ea07c",
                                "sense_id": "f474bc89-2f04-326e-869a-a8a55b2aac74",
                                "text": "„In diesen Fällen könnte man von Sekundärnutzen oder Kollateralnutzen sprechen.“"
                            },
                            {
                                "example_id": "b3c1d834-11fd-45f8-9ec2-a70fc3d28abc",
                                "sense_id": "f474bc89-2f04-326e-869a-a8a55b2aac74",
                                "text": "„Wie schön, wenn vom christlichen Glauben ein Kollateralnutzen für das Gemeinwohl abfällt.“"
                            },
                            {
                                "example_id": "62fa3082-5092-4f39-85ee-ee9b2ea87081",
                                "sense_id": "f474bc89-2f04-326e-869a-a8a55b2aac74",
                                "text": "„Ein weiterer Kollateralnutzen des massenhaften Baumsterbens ist die gestiegene Menge an Totholz im Wald. Zahlreiche Pilze, Insekten und Pflanzen sind auf Totholz angewiesen, zudem trägt der Zersetzungsprozess zur Humusbildung des Waldbodens bei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
