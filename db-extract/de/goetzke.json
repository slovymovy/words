                ],
                "senses": [
                    {
                        "sense_id": "f46411e9-6db4-3e5a-8d93-9adcf332f5a4",
                        "entry_id": "eff03c9e-23ef-39fd-ab65-fa6b1c3f7e15",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee98ddf8-aaae-46bc-b97b-14822da9c5a8",
                                "sense_id": "f46411e9-6db4-3e5a-8d93-9adcf332f5a4",
                                "text": "Frau Goetzke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e4afe31d-a0a5-428f-bd80-adf83407c871",
                                "sense_id": "f46411e9-6db4-3e5a-8d93-9adcf332f5a4",
                                "text": "Herr Goetzke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ebf5ca8c-5de8-4ba2-9ad9-b8f23e97ca08",
                                "sense_id": "f46411e9-6db4-3e5a-8d93-9adcf332f5a4",
                                "text": "Die Goetzkes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "244a081a-f8ac-4b2a-81e4-e157f5799a67",
                                "sense_id": "f46411e9-6db4-3e5a-8d93-9adcf332f5a4",
                                "text": "Der Goetzke trägt nie die Schals, die die Goetzke ihm strickt."
                            },
                            {
                                "example_id": "be9f0136-4e1e-405c-8483-dd65193fda87",
                                "sense_id": "f46411e9-6db4-3e5a-8d93-9adcf332f5a4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Goetzke kommt, geht der Herr Goetzke.“"
                            },
                            {
                                "example_id": "4cd51cf9-1805-4e95-b99a-9c25d8d2d2b0",
                                "sense_id": "f46411e9-6db4-3e5a-8d93-9adcf332f5a4",
                                "text": "Goetzke kommt und geht."
                            },
                            {
                                "example_id": "f5576c2f-3f6e-48db-b55a-beab9da57895",
                                "sense_id": "f46411e9-6db4-3e5a-8d93-9adcf332f5a4",
                                "text": "Goetzkes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
