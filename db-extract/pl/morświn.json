                    {
                        "sense_id": "806ac1f0-0d7a-3df8-8be6-7e77a6f33efb",
                        "entry_id": "d07aaa96-1c8a-3f16-82cb-50d8cbbe9a4a",
                        "glosses": [
                            "Phocoena Cuvier, rodzaj ssaka z rodziny morświnowatych"
                        ],
                        "tags": [
                            "syst."
                        ],
                        "examples": [
                            {
                                "example_id": "2af303db-fe9c-425c-b340-3f7037665dc3",
                                "sense_id": "806ac1f0-0d7a-3df8-8be6-7e77a6f33efb",
                                "text": "Nie miałem pojęcia, że morświny żyją również w Bałtyku!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "dd7ba025-494c-374b-917b-0a51e3e52608",
                        "entry_id": "d07aaa96-1c8a-3f16-82cb-50d8cbbe9a4a",
                        "glosses": [
                            "Phocoena phocoena Linnaeus, morświn zwyczajny"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ddbff494-097e-4175-9f95-425e5551744d",
                                "sense_id": "dd7ba025-494c-374b-917b-0a51e3e52608",
                                "text": "Spoglądał na mnie morświn, a ja marznąłem w zimnej bałtyckiej wodzie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb8a2108-fc52-4314-af81-3e2063dfdb51",
                        "source_entry_id": "d07aaa96-1c8a-3f16-82cb-50d8cbbe9a4a",
                        "source_sense_id": "dd7ba025-494c-374b-917b-0a51e3e52608",
                        "target_lang_word": "porpoise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porpoise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce3866c3-2d1d-3e8a-a4dd-b8ff066b449d",
                                        "entry_id": "d181eed8-8a50-3d16-b64f-d33ee1844e60",
                                        "glosses": [
                                            "Any small cetacean of the family Phocoenidae, related to dolphins and whales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ffc6010-0920-4c11-80ac-b67781008984",
                                                "sense_id": "ce3866c3-2d1d-3e8a-a4dd-b8ff066b449d",
                                                "text": "They captured 25 porpoises and set them free back into the Yangtze after raising them for a month in Puqi County, Hubei."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5378c3-7676-380c-82b4-d4133b34e403",
                                        "entry_id": "d181eed8-8a50-3d16-b64f-d33ee1844e60",
                                        "glosses": [
                                            "Any small dolphin."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "porpoise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14ee33ad-127a-394d-9303-db152f95561e",
                                        "entry_id": "ec02bab6-2911-3390-a8e2-6446186393c5",
                                        "glosses": [
                                            "Said of an air-breathing aquatic animal such as a porpoise or penguin: To repeatedly jump out of the water to take a breath and dive back in a continuous motion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e911e8-45e7-45b7-8acb-33b096090701",
                                                "sense_id": "14ee33ad-127a-394d-9303-db152f95561e",
                                                "text": "Urging them to join me, I raced in circles through the surging water, chased my tail for the children, blew spouts of foam through the sunfilled spray, porpoised to and fro across the river in shallow leaps that stitched the air and water into a table-lace of foam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f591fc78-d9c0-3618-809b-626bd31ccc7d",
                                        "entry_id": "ec02bab6-2911-3390-a8e2-6446186393c5",
                                        "glosses": [
                                            "Said of an aircraft: to make a series of plunges when taking off or landing; or of a watercraft: to successively plunge up and down in the water."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "228bf636-6e74-419d-a9a6-bad57dd39202",
                        "source_entry_id": "d07aaa96-1c8a-3f16-82cb-50d8cbbe9a4a",
                        "source_sense_id": "dd7ba025-494c-374b-917b-0a51e3e52608",
                        "target_lang_word": "marsouin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marsouin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b69a68d9-9ec4-38e4-b20e-e15291dba971",
                                        "entry_id": "09916d32-20c0-3322-9dff-985ea63ac064",
                                        "glosses": [
                                            "Petit cétacé à dents, au rostre court et aux dents pointues et courbées, plutôt noirs sur la face dorsale, et blancs sur la face ventrale."
                                        ],
                                        "tags": [
                                            "Cétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bcbf456-f179-42d9-b097-2ccf679dc2e2",
                                                "sense_id": "b69a68d9-9ec4-38e4-b20e-e15291dba971",
                                                "text": "Une fois passée l’embouchure de la Tamise, elle eut un peu de distraction, parce que les troupeaux de Neptune vinrent folâtrer autour du navire. Je crois que ces bêtes s’appellent des marsouins."
                                            },
                                            {
                                                "example_id": "ffa5fce2-7583-4501-b452-64c77bec27ee",
                                                "sense_id": "b69a68d9-9ec4-38e4-b20e-e15291dba971",
                                                "text": "Aussi le lendemain, quand nous partîmes, il vint gracieusement graisser nos souliers avec l’huile d'un marsouin qu'il avait tué et distillé lui-même."
                                            },
                                            {
                                                "example_id": "ad9b190e-1972-4586-b0e5-42e962cce49a",
                                                "sense_id": "b69a68d9-9ec4-38e4-b20e-e15291dba971",
                                                "text": "Il y a, dans le ciel, des montagnes violettes, de grands marsouins de cuivre et des oiseaux de sang."
                                            },
                                            {
                                                "example_id": "8d13520d-29af-4783-92f8-2dd6b5e8b97d",
                                                "sense_id": "b69a68d9-9ec4-38e4-b20e-e15291dba971",
                                                "text": "La capture des baleinoptères par des procédés modernes a remplacé la tuerie périodique des bandes de marsouins rabattus par les embarcations au fond des baies."
                                            },
                                            {
                                                "example_id": "b14b2333-66db-4f4f-abf3-632560630ffd",
                                                "sense_id": "b69a68d9-9ec4-38e4-b20e-e15291dba971",
                                                "text": "Jérôme, à la hauteur de Spartivento, avait remis le cap à l’Est, et les marsouins avaient accueilli le cargo à l’orée de la mer Ionienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81bd69f6-8ccf-311d-899a-a93f6cc8e14e",
                                        "entry_id": "09916d32-20c0-3322-9dff-985ea63ac064",
                                        "glosses": [
                                            "Soldat de l’infanterie coloniale, puis membre des troupes de marine (infanterie de marine)."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a434b913-cf99-47b8-8777-e1ca1099a6b1",
                                                "sense_id": "81bd69f6-8ccf-311d-899a-a93f6cc8e14e",
                                                "text": "Vint l’heure du noble devoir patriotique. Fagerolle tira ses mois d’embastillement militaire sans trop de dommages, dans un régiment de marsouins, à Toulon."
                                            },
                                            {
                                                "example_id": "ade79ae2-5dfb-495e-a7d7-c9e504645dd5",
                                                "sense_id": "81bd69f6-8ccf-311d-899a-a93f6cc8e14e",
                                                "text": "Très habilement, les marsouins profitent de l’absence de reconnaissance des États africains locaux et de leur implication dans la traite des esclaves pour légitimer une conquête souvent brutale en une forme d’intervention à but humanitaire avant la lettre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marsouin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9240975-74ff-3efb-8544-917b04711be0",
                                        "entry_id": "2ab57bc8-72ae-35db-97be-c5438c14acb8",
                                        "glosses": [
                                            "Personne qui mérite peu de considération."
                                        ],
                                        "tags": [
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f45135a8-48a1-4a6a-869c-e32e1d4ce0fd",
                                                "sense_id": "b9240975-74ff-3efb-8544-917b04711be0",
                                                "text": "Dans un monde où une gang de marsouins ne se gênent pas pour s’en mettre plein les poches, où les glaciers fondent, où les ours polaires se meurent, il me semble que nous avons le devoir moral de léguer un peu d’espoir à nos enfants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba18d3fb-756e-3d74-989c-67798256711c",
                                        "entry_id": "2ab57bc8-72ae-35db-97be-c5438c14acb8",
                                        "glosses": [
