                "senses": [
                    {
                        "sense_id": "637cb630-8525-32d6-97f3-d270bcfd112d",
                        "entry_id": "1ae6a69f-cfef-3268-bf5f-552b4d95df5f",
                        "glosses": [
                            "In an eerie manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19dc3579-be91-4161-9f53-96d93dc09444",
                                "sense_id": "637cb630-8525-32d6-97f3-d270bcfd112d",
                                "text": "And it was the voice of a human being—a known, loved, well-remembered voice—that of Edward Fairfax Rochester; and it spoke in pain and woe—wildly, eerily, urgently."
                            },
                            {
                                "example_id": "7e547009-34a5-4af3-924f-94275c3b3ae7",
                                "sense_id": "637cb630-8525-32d6-97f3-d270bcfd112d",
                                "text": "A woman whose fiancé died on Sept. 11, Maria Barreto-Mojica, said she noticed that something about yesterday had seemed eerily familiar. “I looked at the sky this morning. It was so blue, just the same as it was that morning,” said Ms. Barreto-Mojica, 48, who was to marry fire lieutenant Dennis Mojica."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7996c6a0-90c6-4f04-a4cf-e7cd7d1f0891",
                        "source_entry_id": "1ae6a69f-cfef-3268-bf5f-552b4d95df5f",
                        "source_sense_id": "637cb630-8525-32d6-97f3-d270bcfd112d",
                        "source_sense_description": "In an eerie manner",
                        "target_lang_word": "tajuplně",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c03bcc3f-a9a4-4c7a-b129-0dc0946a043f",
                        "source_entry_id": "1ae6a69f-cfef-3268-bf5f-552b4d95df5f",
                        "source_sense_id": "637cb630-8525-32d6-97f3-d270bcfd112d",
                        "source_sense_description": "In an eerie manner",
                        "target_lang_word": "étrangement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étrangement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                        "entry_id": "ee8d25b8-5827-31a7-9c99-e5de80d26270",
                                        "glosses": [
                                            "D'une manière étrange ; bizarrement, étonnamment, de manière peu commune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f922f6-f230-486b-b715-2fed1c9550bf",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Dix-sept îles, tufs et basaltes en amas pyramidaux ou étrangement déchiquetés, surgissent de la mer ; […]."
                                            },
                                            {
                                                "example_id": "810ed90e-05ac-4013-9cd6-2769f947e1d0",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Par contraste, le côté du lagon était étrangement calme, une eau merveilleusement tranquille, à peine ridée par les alizés, où passaient des poissons aux couleurs éblouissantes."
                                            },
                                            {
                                                "example_id": "cf56dc80-e5ed-4f66-b9d7-71144ee10f49",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Ces étudiantes national-socialistes cent pour cent affichent volontiers une allure soldatesque qui contraste, étrangement, avec leur pruderie réelle et touchante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5198de27-7cde-45d1-a42a-b9e94ad71868",
                        "source_entry_id": "1ae6a69f-cfef-3268-bf5f-552b4d95df5f",
                        "source_sense_id": "637cb630-8525-32d6-97f3-d270bcfd112d",
                        "source_sense_description": "In an eerie manner",
                        "target_lang_word": "sinistrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinistrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                                        "entry_id": "dd0d1698-7535-332b-8ebb-94be0ae13af6",
                                        "glosses": [
                                            "D’une manière sinistre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1359152-9ee3-4a1b-8969-d97c0fa14687",
                                                "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                                                "text": "Leurs yeux sinistrement étincellent dans l’ombre,"
                                            },
                                            {
                                                "example_id": "ddf7cc9d-c6e7-4017-b7cd-4e50d8cba8b7",
                                                "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                                                "text": "La chaloupe démarrée, on hissa les voiles dont les drisses crièrent sinistrement au long des mâts, […]."
                                            },
                                            {
                                                "example_id": "063e9ba6-2e11-4e12-b0f6-54476c3b79fe",
                                                "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                                                "text": "Le chantier, cette nuit-là, ne se creusait pas sinistrement comme par les nuits pluvieuses ; éclairé de larges nappes de lumière blanche, il s’étendait, dans le silence et l’immobilité du froid, avec une mélancolie douce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6acbbb1b-fcbd-3455-ba24-1fa296bacce4",
                                        "entry_id": "dd0d1698-7535-332b-8ebb-94be0ae13af6",
                                        "glosses": [
                                            "D'une manière pessimiste."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80bd2024-1b02-4405-8bb3-de3c140c7e36",
                                                "sense_id": "6acbbb1b-fcbd-3455-ba24-1fa296bacce4",
                                                "text": "En interprétant sinistrement de certaines actions…."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
