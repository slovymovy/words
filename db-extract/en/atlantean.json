    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1235f473-844d-3a01-b006-3218a2c18853",
                "word": "Atlantean",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eaecdd0c-f806-374d-a34d-342d9b88c305",
                        "entry_id": "1235f473-844d-3a01-b006-3218a2c18853",
                        "glosses": [
                            "Of or like the Greek titan Atlas, who carries the heavens on his shoulders, as in Atlantean strength"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e9254b73-fceb-4e97-b5d7-7b991617f504",
                                "sense_id": "eaecdd0c-f806-374d-a34d-342d9b88c305",
                                "text": "With Atlantean shoulders fit to bear / The weight of mightiest Monarchies."
                            }
                        ]
                    },
                    {
                        "sense_id": "828d422f-d268-3eb3-8a97-775de752c75c",
                        "entry_id": "1235f473-844d-3a01-b006-3218a2c18853",
                        "glosses": [
                            "Of the celestial spheres carried by Atlas"
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "11f8782d-58ad-4acc-9156-1ffff33faa8b",
                                "sense_id": "828d422f-d268-3eb3-8a97-775de752c75c",
                                "text": "1940, WHD Rouse, trans. of Nonnus, Dionysiaca\nI [Elektra] shall pass from the earth to the stars’ Atlantean vault, and dwell in heaven"
                            }
                        ]
                    },
                    {
                        "sense_id": "f28363d4-2689-355d-bef8-5cb880068a9f",
                        "entry_id": "1235f473-844d-3a01-b006-3218a2c18853",
                        "glosses": [
                            "Of an architectural atlas or atlantid, or reminiscent of such: atlantean figures"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "054be9cd-00a9-4765-9a8c-7d2345d26b6c",
                                "sense_id": "f28363d4-2689-355d-bef8-5cb880068a9f",
                                "text": "Arms outstretched, an Atlantean statue of Jesus welcomes a diver in the mysterious depths off Ambergris Caye"
                            }
                        ]
                    },
                    {
                        "sense_id": "a61a1c36-30da-364f-b506-382acb389336",
                        "entry_id": "1235f473-844d-3a01-b006-3218a2c18853",
                        "glosses": [
                            "Of the mythical island of Atlantis, its people, or its civilization."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3ca15f3c-d023-47e5-a0cc-1aef7c044d4a",
                                "sense_id": "a61a1c36-30da-364f-b506-382acb389336",
                                "text": "2002, Vadim Joseph Rossman, Vidal Sassoon, International Center for the Study of Antisemitism (Universiṭah ha-ʻIvrit bi-Yerushalayim), Russian Intellectual Antisemitism in the Post-Communist Era,\nBarkashov saw a critical difference between Atlantis and Hyperborea in the organization of labor. The Atlantean economy, he claims, was based on the use of the mass slave labor in agriculture and crafts, while the Aryan civilization did not employ slaves nor tolerate slavery."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e211045-d3e5-3567-8b3d-3152c433d943",
                        "entry_id": "1235f473-844d-3a01-b006-3218a2c18853",
                        "glosses": [
                            "flooded or submerged, especially in case of a natural disaster, reminiscent of the way Atlantis sank into the ocean"
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d6681583-144a-48a0-b151-713f5a2e4a53",
                                "sense_id": "3e211045-d3e5-3567-8b3d-3152c433d943",
                                "text": "So [after the tsunami], once again Hideaki navigated his way through the Atlantean city, picking his way through crumbling wreckage, splintered wood, and shredded metal to find his elderly mother."
                            }
                        ]
                    },
                    {
                        "sense_id": "b91e4081-2ef6-345f-aaa2-2100856a2d6b",
                        "entry_id": "1235f473-844d-3a01-b006-3218a2c18853",
                        "glosses": [
                            "of Saturn's moon Atlas"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7c572941-0c9c-3e9e-88be-398136cfc3ec",
                "word": "Atlantean",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "28f718bb-c1e7-3a09-83fd-3b25f8f35b6d",
                        "entry_id": "7c572941-0c9c-3e9e-88be-398136cfc3ec",
                        "glosses": [
                            "The language supposedly spoken by the inhabitants of Atlantis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e80e4daf-4c99-4f6e-a52a-2b0635e65433",
                                "sense_id": "28f718bb-c1e7-3a09-83fd-3b25f8f35b6d",
                                "text": "How Atlantean sounded or how the various alphabets worked is anyone's guess, of course, but since there is a certain logic to how language is constructed, we might allow that theirs may not have been so different from our own."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b2e83d7-5577-3bce-94e2-a048baf76e45",
                        "entry_id": "7c572941-0c9c-3e9e-88be-398136cfc3ec",
                        "glosses": [
                            "A constructed language invented for the 2001 animated film Atlantis: The Lost Empire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0ce17b9-d11c-455c-a859-9ba93a01edcf",
                                "sense_id": "1b2e83d7-5577-3bce-94e2-a048baf76e45",
                                "text": "Indeed, Okrand's goal in inventing Atlantean was to recreate Indo-European, and it thus borrows from several languages yet contains no recognizable words from these linguistic systems."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "48c745c6-e7de-318e-a3c5-fef180970918",
                "word": "Atlantean",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9d8f05ec-58eb-4f77-91cf-2503a81ae17f",
                        "entry_id": "48c745c6-e7de-318e-a3c5-fef180970918",
                        "tags": [
                            "plural"
                        ],
                        "form": "Atlanteans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d36de31c-8acf-3b72-ad19-1103dedd9b09",
                        "entry_id": "48c745c6-e7de-318e-a3c5-fef180970918",
                        "glosses": [
                            "An inhabitant of the mythical island of Atlantis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18c71314-5775-4871-b1b1-414585d1535e",
                                "sense_id": "d36de31c-8acf-3b72-ad19-1103dedd9b09",
                                "text": "1847, M. Bodichon, Études sur l'Algérie, translated in Nott & Gliddon, 1854, Types of mankind,\nThe Atlanteans, among the ancients, passed for the favorite children of Neptune; they made known the worship of this god to other nations"
                            }
                        ]
                    },
                    {
                        "sense_id": "a0a8d7fe-89fb-3447-a5b9-4446a9b597bd",
                        "entry_id": "48c745c6-e7de-318e-a3c5-fef180970918",
                        "glosses": [
                            "A pillar or statue in the form of an architectural atlas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37e96865-ee73-4bad-8bee-375afddaa7c1",
                                "sense_id": "a0a8d7fe-89fb-3447-a5b9-4446a9b597bd",
                                "text": "This pyramid has been restored and the tall statues, called Atlanteans (Los Atlantes), have been erected on its summit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf821d43-fb46-4250-86a8-66cd2d1d6405",
                        "source_entry_id": "48c745c6-e7de-318e-a3c5-fef180970918",
                        "source_sense_description": "an inhabitant of the mythical land",
                        "target_lang_word": "Atlanter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atlanter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b1e8390-eeba-3485-bff9-df953527b144",
                                        "entry_id": "7ace7c7e-58e7-3119-9e32-9df4c3ec8579",
                                        "glosses": [
                                            "Einwohner von Atlantis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb65414-2c20-478e-b84e-12ca74934d87",
                                                "sense_id": "4b1e8390-eeba-3485-bff9-df953527b144",
                                                "text": "„Anschließend stürzte er sich aus dem Fenster im dritten Stock. Beharrte darauf, dass das Wiederauftauchen von Atlantis dem Ende der Menschheit gleichkam. Behauptete, die Atlanter stünden kurz vor dem Erwachen.“"
                                            },
                                            {
                                                "example_id": "1fabdd9f-7720-4d32-9058-8bafdfaa0147",
                                                "sense_id": "4b1e8390-eeba-3485-bff9-df953527b144",
                                                "text": "„Er kannte deshalb, wie viele gebildete Atlanter der Oberklasse, aus erster Hand die außerordentlich hoch entwickelte Zivilisation des Stammkontinents.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
