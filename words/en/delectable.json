    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9f74e04a-7718-3110-aa1e-7f83dd20b7f0",
                    "sense_definition": "Highly pleasing or delightful, especially to the senses; delicious.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pleasing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a <w>delectable</w> meal that everyone enjoyed.",
                            "target_lang_translations": {
                                "es": "El chef preparó una comida <w>deliciosa</w> que todos disfrutaron."
                            }
                        },
                        {
                            "text": "The bakery is famous for its <w>delectable</w> chocolate tarts.",
                            "target_lang_translations": {
                                "es": "La panadería es famosa por sus <w>exquisitas</w> tartas de chocolate."
                            }
                        }
                    ],
                    "synonyms": [
                        "delicious",
                        "tasty",
                        "delightful"
                    ],
                    "antonyms": [
                        "disgusting",
                        "unpleasant"
                    ],
                    "common_phrases": [
                        "delectable meal",
                        "delectable dessert"
                    ],
                    "target_lang_definitions": {
                        "es": "Sumamente agradable o placentero, en especial para el gusto o el olfato; exquisito o delicioso."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "delicioso",
                                "target_lang_sense_clarification": "de sabor muy agradable"
                            },
                            {
                                "target_lang_word": "exquisito",
                                "target_lang_sense_clarification": "de sabor o calidad refinada y excelente"
                            },
                            {
                                "target_lang_word": "deleitable",
                                "target_lang_sense_clarification": "que causa gran placer o deleite"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
