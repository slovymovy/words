                        "entry_id": "1579aeb9-d8ce-398d-9304-c41cade7ad28",
                        "glosses": [
                            "członek ludu azjatyckiego, przedstawiciel narodowości tajskiej, zamieszkującej głównie Tajlandię"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "725e2653-341e-4ca8-9236-24e4d847fe60",
                                "sense_id": "3c1115c7-251b-3c4a-9924-edd07abbff8f",
                                "text": "Tytułowe „spojrzenie turysty” […] oznacza poszukiwanie przez nas znaków, które potwierdzą nasze wyobrażenia. Paryż ma być romantyczny, Anglicy dżentelmeńscy, Tajowie uśmiechnięci. Chcemy, żeby nasze wakacje były niepowtarzalne i wyjątkowe, z dala od pułapek turystycznych, ale to, czy uznamy je za udane, lub nie, zależy głównie od tego, czy potwierdzą się nasze wyobrażenia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
