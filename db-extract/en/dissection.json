                                    {
                                        "sense_id": "68ddcbc9-ed8d-3031-ada6-3a21bf8a5476",
                                        "entry_id": "bfa7c40a-b2ae-3398-9879-392338cc9713",
                                        "glosses": [
                                            "prozkoumání mrtvého těla použitím invazivních metod"
                                        ],
                                        "tags": [],
