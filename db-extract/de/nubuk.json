                ],
                "senses": [
                    {
                        "sense_id": "5028728e-f4a7-3c41-b4bc-a0c60c272d9c",
                        "entry_id": "0d35d8f4-a395-3725-9a74-8d632d47b6b4",
                        "glosses": [
                            "an der äußeren Lederschicht geschliffenes Kalbs- oder Rindsleder mit samtartiger Oberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b13eaab-2aec-4e9a-91ac-cfcf187edafc",
                                "sense_id": "5028728e-f4a7-3c41-b4bc-a0c60c272d9c",
                                "text": "Nubuk gilt aufgrund seines ungewöhnlichen, feinen Aussehens als die edelste Lederart, aus der die ausgesuchten Accessoires und Schuhe hergestellt werden."
                            },
                            {
                                "example_id": "d6864fb8-71db-491e-a9bb-b05578a22531",
                                "sense_id": "5028728e-f4a7-3c41-b4bc-a0c60c272d9c",
                                "text": "Nubuk fühlt sich weicher an – alles wegen der kürzeren Haare, die es bedecken."
                            },
                            {
                                "example_id": "27a5f318-90fb-49fa-8da9-7b18e4debb5f",
                                "sense_id": "5028728e-f4a7-3c41-b4bc-a0c60c272d9c",
                                "text": "Aber auch Ziegen-, Lamm- oder Hirschleder werden zu Nubuk verarbeitet."
                            },
                            {
                                "example_id": "158fb55a-ae26-48db-a4f1-76ea1ec5166e",
                                "sense_id": "5028728e-f4a7-3c41-b4bc-a0c60c272d9c",
                                "text": "Im Gegensatz zum sehr samtigen Nubuk ist das Veloursleder deutlich aufgerauter."
                            },
                            {
                                "example_id": "080676c1-8254-41c3-833e-dfb1531718ed",
                                "sense_id": "5028728e-f4a7-3c41-b4bc-a0c60c272d9c",
                                "text": "Bei Raulederbürsten unterscheidet man Messingbürsten für Veloursleder und Kautschuk- oder Gummibürsten für Nubuk."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
