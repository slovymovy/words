                        "source_entry_id": "1aaf36b7-4bae-3046-8374-214cf9016050",
                        "source_sense_id": "e27e7b8d-0fb8-3c9f-a09d-af62807128c2",
                        "source_sense_description": "of, relating to or being a cause of something",
