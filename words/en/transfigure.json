                    "frequency": "VeryLow",
                    "semantic_group_id": "transform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Through his romantic poetry, he sought to <w>transfigure</w> the mundane routines of everyday life."
                        },
                        {
                            "text": "The artist felt a sacred duty to <w>transfigure</w> human suffering into something profound."
                        }
