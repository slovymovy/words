                        "sense_id": "3cec0974-b9b2-31fe-9423-ffc12c6712f5",
                        "entry_id": "b7869507-a7d3-3c7a-aab1-c07a8c0f5616",
                        "glosses": [
                            "schip voor het vervoeren van handelswaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d264e98-be07-4d95-8bf1-8ef62a51f4c9",
                                "sense_id": "3cec0974-b9b2-31fe-9423-ffc12c6712f5",
                                "text": "In het Rijksmuseum is een van de topstukken van de Palmhoutwrak collectie onthuld: een oude zilveren pronkbeker. De vergulde beker behoort tot de objecten die zijn gevonden in het Palmhoutwrak, een handelsschip op de bodem van de Waddenzee."
                            },
                            {
                                "example_id": "41888a74-ce2e-43ef-98f9-0fde11d2351a",
                                "sense_id": "3cec0974-b9b2-31fe-9423-ffc12c6712f5",
                                "text": "Het handelsschip waarmee het tapijt werd vervoerd verging ergens tussen 1645 en 1660 voor de kust van Texel. Mogelijk is het vergaan in een storm toen het bij het Waddeneiland wachtte op een gunstige wind."
                            }
                        ]
                    }
