                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the <w>john</w> during a sting operation.",
                            "target_lang_translations": {
