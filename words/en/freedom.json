{
    "word_family": [
        "free",
        "freely",
        "freeman",
        "freedman"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65bc2031-7c36-38f9-92b1-440e05a91d77",
                    "sense_definition": "The general state of being free, independent, and not under the control or power of another.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "state_of_liberty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years in prison, the man finally regained his <w>freedom</w>.",
                            "target_lang_translations": {
                                "ru": "После долгих лет в тюрьме мужчина наконец обрел <w>свободу</w>.",
                                "zh": "在监狱里待了多年后，那个人终于重获了<w>自由</w>。"
                            }
                        },
                        {
                            "text": "The wild horses enjoyed their <w>freedom</w> on the open plains.",
                            "target_lang_translations": {
                                "ru": "Дикие лошади наслаждались своей <w>свободой</w> на открытых равнинах.",
                                "zh": "野马在开阔的平原上享受着它们的<w>自由</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "liberty",
                        "independence"
                    ],
                    "antonyms": [
                        "slavery",
                        "imprisonment",
                        "bondage"
                    ],
                    "common_phrases": [
                        "personal freedom",
                        "financial freedom",
                        "newfound freedom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее состояние свободы, независимости и отсутствия контроля или власти со стороны других.",
                        "zh": "指不受他人控制或束缚，处于独立自主的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свобода",
                                "target_lang_sense_clarification": "независимость, отсутствие заключения"
                            },
                            {
                                "target_lang_word": "воля",
                                "target_lang_sense_clarification": "отсутствие неволи (разг./поэт.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自由",
                                "target_lang_sense_clarification": "指摆脱了束缚或监禁的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e927f47-b0f6-3a72-b891-7421d627e02b",
                    "sense_definition": "The power or right to act, speak, or think as one wants without hindrance or restraint.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_of_liberty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constitution guarantees <w>freedom</w> of speech for all citizens.",
                            "target_lang_translations": {
                                "ru": "Конституция гарантирует <w>свободу</w> слова для всех граждан.",
                                "zh": "宪法保障所有公民的言论<w>自由</w>。"
                            }
                        },
                        {
                            "text": "We must protect our <w>freedom</w> from those who wish to take it away.",
                            "target_lang_translations": {
                                "ru": "Мы должны защищать нашу <w>свободу</w> от тех, кто хочет её отнять.",
                                "zh": "我们必须保护我们的<w>自由</w>，不让那些想夺走它的人得逞。"
                            }
                        }
                    ],
                    "synonyms": [
                        "liberty",
                        "independence"
                    ],
                    "antonyms": [
                        "constraint",
                        "unfreedom"
                    ],
                    "common_phrases": [
                        "freedom of speech",
                        "freedom of expression",
                        "freedom of choice",
                        "freedom of religion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Право или возможность действовать, говорить или мыслить по своему желанию без помех или ограничений.",
                        "zh": "指按照自己的意愿行事、说话或思考的权利，不受外界阻碍或限制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свобода",
                                "target_lang_sense_clarification": "гражданское право, отсутствие ограничений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自由",
                                "target_lang_sense_clarification": "指公民享有的权利或不受限制的自主权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76714ff1-a42d-34c0-b709-a8262c458cd4",
                    "sense_definition": "A special right or privilege of unrestricted access or use, often granted by a city or organization.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "privilege",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general was granted the <w>freedom</w> of the city after the war.",
                            "target_lang_translations": {
                                "ru": "После войны генералу было даровано <w>почётное гражданство</w> города.",
                                "zh": "战后，这位将军被授予了该市的<w>荣誉市民权</w>。"
                            }
                        },
                        {
                            "text": "He was given the <w>freedom</w> to use the laboratory whenever he wished.",
                            "target_lang_translations": {
                                "ru": "Ему дали <w>право</w> пользоваться лабораторией, когда он пожелает.",
                                "zh": "他获得了随时使用实验室的<w>特权</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exemption"
                    ],
                    "common_phrases": [
                        "freedom of the city"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in the phrase 'freedom of the city'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое право или привилегия неограниченного доступа или использования, часто предоставляемая городом или организацией.",
                        "zh": "指由城市或组织授予的特殊权利或特权，允许某人不受限制地进入或使用某处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "право",
                                "target_lang_sense_clarification": "привилегия доступа или использования"
                            },
                            {
                                "target_lang_word": "привилегия",
                                "target_lang_sense_clarification": "особое преимущество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特权",
                                "target_lang_sense_clarification": "指特殊的准入或使用权利"
                            },
                            {
                                "target_lang_word": "荣誉市民权",
                                "target_lang_sense_clarification": "指授予某人的城市特殊礼遇"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6e487c0-cf0e-3f49-a75e-545b7382771d",
                    "sense_definition": "The quality of being frank, open, or outspoken in speech or action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "frankness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke with a <w>freedom</w> that surprised the polite guests.",
                            "target_lang_translations": {
                                "ru": "Она говорила с такой <w>свободой</w>, которая удивила вежливых гостей.",
                                "zh": "她说话的<w>坦率</w>程度让那些彬彬有礼的客人们感到惊讶。"
                            }
                        },
                        {
                            "text": "I hope you will forgive my <w>freedom</w> in addressing you so directly.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, вы простите мою <w>смелость</w> в столь прямом обращении к вам.",
                                "zh": "希望你能原谅我如此直接地称呼你，实在太<w>冒昧</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "freeness"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество быть откровенным, открытым или прямым в речи или действиях.",
                        "zh": "指在言语或行为上表现出的坦率、开放或直言不讳的特质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свобода",
                                "target_lang_sense_clarification": "непринуждённость, легкость в общении"
                            },
                            {
                                "target_lang_word": "смелость",
                                "target_lang_sense_clarification": "откровенность, прямота"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坦率",
                                "target_lang_sense_clarification": "指说话直白、不加掩饰"
                            },
                            {
                                "target_lang_word": "直率",
                                "target_lang_sense_clarification": "指言行上的不拘束"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28a241b2-4260-3af4-ad1c-2b9efccac927",
                    "sense_definition": "Behavior that is overly familiar or violates social rules of decorum.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took the <w>freedom</w> of entering the room without knocking.",
                            "target_lang_translations": {
                                "ru": "Он позволил себе <w>вольность</w> войти в комнату без стука.",
                                "zh": "他没敲门就进屋，真是太<w>放肆</w>了。"
                            }
                        },
                        {
                            "text": "Such <w>freedom</w> with a superior was considered rude in the past.",
                            "target_lang_translations": {
                                "ru": "Такая <w>вольность</w> с начальником в прошлом считалась грубостью.",
                                "zh": "过去，对上级如此<w>放肆</w>被认为是无礼的行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "license"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поведение, которое является чрезмерно фамильярным или нарушает общественные нормы приличия.",
                        "zh": "指过于随意或违反社交礼仪的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вольность",
                                "target_lang_sense_clarification": "фамильярность, нарушение этикета"
                            },
                            {
                                "target_lang_word": "развязность",
                                "target_lang_sense_clarification": "излишняя непринуждённость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冒昧",
                                "target_lang_sense_clarification": "指言行失礼或过于随意"
                            },
                            {
                                "target_lang_word": "放肆",
                                "target_lang_sense_clarification": "指言行不守规矩、过于随便"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1c95f596-4796-3ecc-8603-cc0358f604ee",
                    "sense_definition": "A place name used for several towns and communities in the United States.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited a small town called <w>Freedom</w> in California.",
                            "target_lang_translations": {
                                "ru": "Они посетили маленький городок под названием <w>Фридом</w> в Калифорнии.",
                                "zh": "他们参观了加利福尼亚州一个叫<w>弗里敦</w>的小镇。"
                            }
                        },
                        {
                            "text": "We drove through <w>Freedom</w>, Pennsylvania, on our road trip.",
                            "target_lang_translations": {
                                "ru": "Мы проехали через <w>Фридом</w>, штат Пенсильвания, во время нашего автопутешествия.",
                                "zh": "我们在公路旅行中开车经过了宾夕法尼亚州的<w>弗里敦</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название, используемое для нескольких городов и общин в Соединенных Штатах.",
                        "zh": "美国多个城镇和社区的名称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фридом",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弗里敦",
                                "target_lang_sense_clarification": "地名音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}