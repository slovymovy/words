                        "cross_references": [
                            {
                                "target_word": "garage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "477edfa5-2c74-327a-ac07-7a0e6e9c0d97",
                                        "entry_id": "93db5f11-7014-3966-a7c2-6f22a0fac415",
                                        "glosses": [
                                            "A building (or section of a building) used to store a car or cars, tools and other miscellaneous items."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01dbda03-e02e-408b-8755-4aa771ba65c6",
                                                "sense_id": "477edfa5-2c74-327a-ac07-7a0e6e9c0d97",
                                                "text": "A little further on, to the right, was a large garage, where the charabancs stood, half in and half out of the yard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1547f3ec-b4c8-3559-9cdd-c851c2b996eb",
                                        "entry_id": "93db5f11-7014-3966-a7c2-6f22a0fac415",
                                        "glosses": [
                                            "A place where cars are serviced and repaired."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67950d92-1e80-4c78-9b72-13ad67e536be",
                                                "sense_id": "1547f3ec-b4c8-3559-9cdd-c851c2b996eb",
                                                "text": "The highway to the East Coast which ran through the borough of Ebbfield had always been a main road and even now, despite the vast garages, the pylons and the gaily painted factory glasshouses which had sprung up beside it, there still remained an occasional trace of past cultures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cc10734-5801-3ed3-af58-0bea26330df0",
                                        "entry_id": "93db5f11-7014-3966-a7c2-6f22a0fac415",
                                        "glosses": [
                                            "A petrol filling station."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a217a721-01af-3cb6-8517-022dac9148c9",
                                        "entry_id": "93db5f11-7014-3966-a7c2-6f22a0fac415",
                                        "glosses": [
                                            "A shed for housing an airship or aeroplane or a launchable missile; a hangar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9592150a-117c-3fac-aba4-753473132029",
                                        "entry_id": "93db5f11-7014-3966-a7c2-6f22a0fac415",
                                        "glosses": [
                                            "A side way or space in a canal to enable vessels to pass each other; a siding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67276646-b09e-30ba-b2d9-4b4f4b84c426",
                                        "entry_id": "93db5f11-7014-3966-a7c2-6f22a0fac415",
                                        "glosses": [
                                            "A type of guitar rock music, personified by amateur bands playing in the basement or garage; garage rock."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aebe8209-1a58-313e-aeb6-b8710f8df9dc",
                                        "entry_id": "93db5f11-7014-3966-a7c2-6f22a0fac415",
                                        "glosses": [
                                            "A type of electronic dance music related to house music, with warped and time-stretched sounds; UK garage."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "garage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21543839-8b0f-351f-b44a-d2c250d1ded7",
                                        "entry_id": "5f477b63-a4b8-3a44-9a5b-0f91b00f8152",
                                        "glosses": [
                                            "To store in a garage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852d3e09-2fa2-4eb5-bd3f-878edb902786",
                                                "sense_id": "21543839-8b0f-351f-b44a-d2c250d1ded7",
                                                "text": "We garaged the convertible during the monsoon months."
                                            },
                                            {
                                                "example_id": "6f191b10-4ed4-4e9f-8573-16876940fe9e",
                                                "sense_id": "21543839-8b0f-351f-b44a-d2c250d1ded7",
                                                "text": "I garaged the car and went to Aunt Dahlia's sanctum to ascertain whether she had cooled off at all since I had left her, for I was still anxious about that blood pressure of hers."
                                            },
                                            {
                                                "example_id": "2d44e065-aa40-46db-9d17-7a6e5806b15a",
                                                "sense_id": "21543839-8b0f-351f-b44a-d2c250d1ded7",
                                                "text": "In large cities cars are nuisances unless you have enough money to afford to garage the beasts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15d57d09-3dda-4069-84ba-9e5902e4fbe1",
