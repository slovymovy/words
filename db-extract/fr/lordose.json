            {
                "entry_id": "fdc8159f-17cf-3a26-9af2-1a0a0390156c",
                "word": "lordose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2614dbac-52a9-4e3c-b88c-6892d19afac6",
                        "entry_id": "fdc8159f-17cf-3a26-9af2-1a0a0390156c",
                        "tags": [
                            "plural"
                        ],
                        "form": "lordoses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1bd970a5-27db-3b2a-870a-a952014abc5d",
                        "entry_id": "fdc8159f-17cf-3a26-9af2-1a0a0390156c",
                        "glosses": [
                            "Courbure de la colonne vertébrale à convexité antérieure."
                        ],
                        "tags": [
                            "Squelette"
                        ],
                        "examples": [
                            {
                                "example_id": "d34df775-a174-4691-bf0f-3190660471ad",
                                "sense_id": "1bd970a5-27db-3b2a-870a-a952014abc5d",
                                "text": "Chez l'adulte, le rachis présente quatre courbures alternantes, de la tête jusqu'au coccyx, dans le plan sagittal … : lordose, cyphose, lordose et cyphose."
                            }
                        ]
                    },
                    {
                        "sense_id": "579c4d63-8d00-3238-b622-492660ae3e7d",
                        "entry_id": "fdc8159f-17cf-3a26-9af2-1a0a0390156c",
                        "glosses": [
                            "Position sexuelle réflexe chez les mammifères lors de la copulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70680e54-aa18-4930-9930-94761979d4ca",
                                "sense_id": "579c4d63-8d00-3238-b622-492660ae3e7d",
                                "text": "… 2 à 3 % seulement des mâles naïfs, que nous présentions à des congénères connus pour monter aussi vigoureusement des mâles que des femelles, leur répondaient en adoptant une posture de lordose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a2b8986-05eb-4a0a-8324-50bf188804c5",
                        "source_entry_id": "fdc8159f-17cf-3a26-9af2-1a0a0390156c",
                        "source_sense_id": "1bd970a5-27db-3b2a-870a-a952014abc5d",
                        "target_lang_word": "Lordose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lordose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89c23d55-94b8-3a96-9ecc-a038a507029c",
                                        "entry_id": "24879477-bf7b-39ed-ba03-0b2b6902f5b8",
                                        "glosses": [
                                            "konvexe Verkrümmung der Wirbelsäule nach ventral in der Medianebene"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f72a9e1f-e404-483e-8623-ff0860c09909",
                                                "sense_id": "89c23d55-94b8-3a96-9ecc-a038a507029c",
                                                "text": "Unter Lordose wird die natürliche Krümmung der Wirbelsäule im Bereich der Hals- und Lendenwirbelsäule verstanden."
                                            },
                                            {
                                                "example_id": "771793a3-e507-4376-8d6a-568622d228bb",
                                                "sense_id": "89c23d55-94b8-3a96-9ecc-a038a507029c",
                                                "text": "Im Hals- und Lendenbereich ist sie nach vorne gekrümmt (Lordose), im Brust- und Kreuzbeinbereich nach hinten (Kyphose)."
                                            },
                                            {
                                                "example_id": "af42850c-2c9d-4ff5-89c7-f5e777e2dbba",
                                                "sense_id": "89c23d55-94b8-3a96-9ecc-a038a507029c",
                                                "text": "Als Lordose bezeichnen Mediziner die nach vorn gerichtete natürliche Krümmung der menschlichen Wirbelsäule."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
