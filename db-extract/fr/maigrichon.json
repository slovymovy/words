                                    {
                                        "sense_id": "58752b25-d66a-3d7e-8046-e9cf371fc2ba",
                                        "entry_id": "7006362e-2500-36f0-b499-d5e557a4664c",
                                        "glosses": [
                                            "The details or facts; especially, those obtained by gossip or rumor."
