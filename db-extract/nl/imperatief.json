                        "examples": [
                            {
                                "example_id": "2d25b1bc-082a-42ab-bc72-08558179a6e4",
                                "sense_id": "55c22904-a0db-3489-aafa-7c6a32f9b41d",
                                "text": "In het Nederlands wordt de imperatief gebruikt om een bevel, verzoek of advies uit te drukken.",
                                "translation": "In Dutch, the imperative is used to express a command, request, or advice.",
                                "english": "In Dutch, the imperative is used to express a command, request, or advice."
                            },
                            {
                                "example_id": "7288f278-4000-4150-9658-f17fe0bc4452",
                                "sense_id": "55c22904-a0db-3489-aafa-7c6a32f9b41d",
                                "text": "Het werkwoord \"stoppen\" staat in de imperatief.",
                                "translation": "The verb \"stoppen\" (to stop) is in the imperative mood.",
                                "english": "The verb \"stoppen\" (to stop) is in the imperative mood."
                            },
                            {
                                "example_id": "482f82c1-5cca-407e-aab1-7426d539b061",
                                "sense_id": "55c22904-a0db-3489-aafa-7c6a32f9b41d",
                                "text": "Gebruik de imperatief om instructies duidelijk over te brengen.",
                                "translation": "Use the imperative mood to convey instructions clearly.",
                                "english": "Use the imperative mood to convey instructions clearly."
                            },
                            {
                                "example_id": "8f63c338-3a48-4171-a08e-8fa54b61c274",
                                "sense_id": "55c22904-a0db-3489-aafa-7c6a32f9b41d",
                                "text": "\"Kom\" is een voorbeeld van een imperatief in het Nederlands.",
                                "translation": "\"Kom\" (come) is an example of an imperative in Dutch.",
                                "english": "\"Kom\" (come) is an example of an imperative in Dutch."
                            }
                        ]
                    }
