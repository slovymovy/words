                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6736e66-b0a4-4115-b39c-f2c87efd1627",
                                "sense_id": "4000100b-9caf-336d-87f9-1d3d78c0af7c",
                                "text": "„In Niederschelden und der Umgebung gab es einige stillgelegte Bergwerksstollen und Höhlen.“"
                            },
                            {
                                "example_id": "3051a5bd-1b27-4732-b71b-6247a40a5a80",
                                "sense_id": "4000100b-9caf-336d-87f9-1d3d78c0af7c",
                                "text": "„Künftig könnten leer stehende Bergwerksstollen als Wasserspeicher genutzt werden und damit helfen, die Energiewende zu schaffen.“"
                            },
                            {
                                "example_id": "861dbdc7-c804-43c4-98fb-2eca9ba9fc59",
                                "sense_id": "4000100b-9caf-336d-87f9-1d3d78c0af7c",
                                "text": "„Im heimischen Raum sind Unglücke im Zusammenhang mit aufgelassenen Bergwerkstollen zwar nicht bekannt, doch erst 1988 kam ein 11-jähriger Junge in einem stillgelegten Schieferbergwerk im Siegerland durch den Sturz in einen Schacht ums Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
