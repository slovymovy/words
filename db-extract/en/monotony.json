                "translations": [
                    {
                        "translation_id": "8dbbbf74-d407-45b9-8932-35e77ce4899a",
                        "source_entry_id": "1022e481-c6d2-377f-b5f4-8e6f9f83ddae",
                        "source_sense_id": "9a836e8a-0ed4-35b6-9791-d335b3e1ccca",
                        "source_sense_description": "Eintönigkeit, Einerlei",
                        "target_lang_word": "Eintönigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eintönigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ca475f3-c750-3156-9ca3-68e75f4666c5",
                                        "entry_id": "eb063b53-0f24-3e4a-8cb1-8b9c8a53248b",
                                        "glosses": [
                                            "ermüdende Einförmigkeit; langweilige, ständige Wiederholung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37128508-af78-4e6d-b94e-03345203767d",
                                                "sense_id": "3ca475f3-c750-3156-9ca3-68e75f4666c5",
                                                "text": "Die Eintönigkeit dieser ganzen Neubausiedlungen macht einen ganz krank."
                                            },
                                            {
                                                "example_id": "3cc2b862-0df2-4aca-b265-db37205665d0",
                                                "sense_id": "3ca475f3-c750-3156-9ca3-68e75f4666c5",
                                                "text": "Peter mag keine Abwechslung, er liebt die Eintönigkeit seiner Arbeit, da muss er keine Angst haben, etwas falsch zu machen."
                                            },
                                            {
                                                "example_id": "15d95944-36cd-490d-bb9f-e49e7344a834",
                                                "sense_id": "3ca475f3-c750-3156-9ca3-68e75f4666c5",
                                                "text": "„Die Langeweile wiegt das Dorf mit Geborgenheit auf. Und es verführt seine Jugend. Zum Griff nach irgendetwas, das laut ist und wild und wüst, wenn die Eintönigkeit zu groß wird. Dann wartet alles auf Samstagnacht, wenn endlich der Bär steppt.“"
                                            },
                                            {
                                                "example_id": "6513158f-f14d-4231-ab29-092e1fc9ab56",
                                                "sense_id": "3ca475f3-c750-3156-9ca3-68e75f4666c5",
                                                "text": "„In die Eintönigkeit meiner Tage stahl sich zu Beginn des Jahres eine Begebenheit, die ich am allerwenigsten erwartete.“"
                                            },
                                            {
                                                "example_id": "1e00dab4-2666-4c08-96b1-10ed0a312ff6",
                                                "sense_id": "3ca475f3-c750-3156-9ca3-68e75f4666c5",
                                                "text": "„Die Eintönigkeit des Bürolebens wurde ihnen verhaßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8eb4e850-3b4e-4465-ac56-498d5c408da4",
                        "source_entry_id": "1022e481-c6d2-377f-b5f4-8e6f9f83ddae",
                        "source_sense_id": "9a836e8a-0ed4-35b6-9791-d335b3e1ccca",
                        "source_sense_description": "Eintönigkeit, Einerlei",
                        "target_lang_word": "Einerlei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einerlei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8bbf290f-5b41-3398-81bf-894e6ee79003",
                                        "entry_id": "ca9543d0-3ef0-342d-8f5c-dec854014020",
                                        "glosses": [
                                            "immer Gleiches, langweilige, ständige Wiederholung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "391b392e-5a5c-4ab1-951e-23f71eaea328",
                                                "sense_id": "8bbf290f-5b41-3398-81bf-894e6ee79003",
                                                "text": "„Die Zentrale des Edelmetallhändlers fällt in dem architektonischen Einerlei des neuen Stadtteils auf. Das Äußere ist einem Goldbarren nachempfunden und mit einer goldschimmernden Metallhaut überzogen.“"
                                            },
                                            {
                                                "example_id": "7b65450b-16b8-4cb9-a017-b48f7ee0514d",
                                                "sense_id": "8bbf290f-5b41-3398-81bf-894e6ee79003",
                                                "text": "„Doch ich teile ‚Mein Leben mit Musik‘ mit zwei Kindern und ihren Haustieren. Da sind Kochen, Putzen, Waschen kein Spaß, sondern tägliches Einerlei, und die Aufenthalte zwischen schmutzigen Töpfen und Riesenbergen zu verarbeitenden Gemüses dauern länger, als einer begeisterten Anhängerin des musikalischen Nachtlebens lieb sein kann.“"
                                            },
                                            {
                                                "example_id": "9df5a0e5-f0c0-4048-8af9-4d311001bc3b",
                                                "sense_id": "8bbf290f-5b41-3398-81bf-894e6ee79003",
                                                "text": "„An diesem Lächeln erkannte Rostow, in was für einer Stimmung Dolochow war: in derselben, die ihn während des Diners im Klub beherrscht hatte und die überhaupt manchmal über ihn kam, wenn ihn das Einerlei des täglichen Lebens langweilte und er das unabweisbare Bedürfnis empfand, sich durch irgendeine extravagante und meist von einer gewissen Grausamkeit nicht freie Handlung diesem Einerlei zu entreissen.“"
                                            },
                                            {
                                                "example_id": "9c148252-4592-45a8-ac45-3b53d63f39b6",
                                                "sense_id": "8bbf290f-5b41-3398-81bf-894e6ee79003",
                                                "text": "„Aber wo immer du in der Weltgeschichte hinschaust, es ist immer dasselbe Einerlei über Liebe, Sehnsucht und Verlangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac824bf4-1990-471c-989c-e00ff9241e18",
                        "source_entry_id": "1022e481-c6d2-377f-b5f4-8e6f9f83ddae",
