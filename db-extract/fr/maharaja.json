                ],
                "senses": [
                    {
                        "sense_id": "a78210f7-fc3f-3855-8527-fbbe07f10f0f",
                        "entry_id": "600f50d2-a55d-38b8-865a-11e90bdde4f0",
                        "glosses": [
                            "Roi en Inde, suzerain d’autres rajas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f932c8dd-e001-4be4-bb7e-9147a8b487e4",
                                "sense_id": "a78210f7-fc3f-3855-8527-fbbe07f10f0f",
                                "text": "Le maharaja de Mysore."
                            },
                            {
                                "example_id": "45f40a32-50d8-4d51-a9d9-542753bf1fdf",
                                "sense_id": "a78210f7-fc3f-3855-8527-fbbe07f10f0f",
                                "text": "Le maharaja n’avait pas 30 ans ; il avait été l’élève ; de Rachmaninov, mais il avait dû renoncer à une carrière de pianiste pour succéder à son père."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2ee465d-abb3-4465-81d6-ce005c8eeafb",
                        "source_entry_id": "600f50d2-a55d-38b8-865a-11e90bdde4f0",
                        "source_sense_id": "a78210f7-fc3f-3855-8527-fbbe07f10f0f",
                        "target_lang_word": "Maharaja",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maharaja",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be575d60-f141-3118-bce9-5845e8d9c51e",
                                        "entry_id": "fb6acf50-feb5-3f6f-ac8c-65ed81eb58ea",
                                        "glosses": [
                                            "alternative Schreibweise von Maharadscha"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06c4a933-9e2b-4e06-8c24-1a153d49f69f",
                                                "sense_id": "be575d60-f141-3118-bce9-5845e8d9c51e",
                                                "text": "„Überhaupt, erzählt der Maharaja, sein Reich habe früher mehr Kontakt zu Europa und Afrika gehabt als zum Rest Indiens. Das lag an den schlechten Straßen.“"
                                            },
                                            {
                                                "example_id": "1122a5e5-de86-4178-85b1-1b946a4a6d2d",
                                                "sense_id": "be575d60-f141-3118-bce9-5845e8d9c51e",
                                                "text": "„Um die wirtschaftliche Entwicklung ihrer Gebiete zu fördern, ließen die Maharajas des 19. Jhs. selbst in der Wüste Thar Eisenbahnen bauen - in Kooperation mit den Briten oder ganz auf eigene Rechnung.“"
                                            },
                                            {
                                                "example_id": "da0b37fb-ce1d-4b01-b5a8-3d98d5fab45a",
                                                "sense_id": "be575d60-f141-3118-bce9-5845e8d9c51e",
                                                "text": "„Er zog sich freilich gleich darauf wieder zurück, etablierte aber seine Macht im Gebiet südlich von Delhi, wo seine Heerführer Scindia, Gaekwad und Holkar später zu Maharajas von Gwalior, Baroda und Indore wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d775608-a342-498e-9ac1-edb094ecfe94",
                        "source_entry_id": "600f50d2-a55d-38b8-865a-11e90bdde4f0",
                        "source_sense_id": "a78210f7-fc3f-3855-8527-fbbe07f10f0f",
                        "target_lang_word": "maharaja",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maharaja",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27519dde-ab61-34d4-ae61-e2aaeefddd5f",
                                        "entry_id": "db6918e1-eddd-308b-9e7d-0b83c9399501",
                                        "glosses": [
                                            "A Hindu monarch ranking above a raja, an emperor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8edc727-e7aa-4d59-a66e-3a3e09ecbf7a",
                                                "sense_id": "27519dde-ab61-34d4-ae61-e2aaeefddd5f",
                                                "text": "I speak from a very intimate knowledge of their ways and habits after having spent a very happy twenty years amongst them with friends in every degree, from the Maharaja himself to some of the humblest coolies."
                                            },
                                            {
                                                "example_id": "d9a7ac13-e53e-43aa-937f-33a49a172eb0",
                                                "sense_id": "27519dde-ab61-34d4-ae61-e2aaeefddd5f",
                                                "text": "Benny: Hey, T.C., what's a maharaja?\nTop Cat: What's a what?\nBenny: A maharaja.\nTop Cat: Oh, do I look like Daniel Webster? I didn't write no dictionary."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "288d6c43-5066-4503-bb5e-02d390141c40",
                        "source_entry_id": "600f50d2-a55d-38b8-865a-11e90bdde4f0",
