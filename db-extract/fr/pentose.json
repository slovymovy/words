        "fr-extract.jsonl": [
            {
                "entry_id": "2210a061-347d-34ed-b8b3-b154acc703cf",
                "word": "pentose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "09d935a5-9428-4b29-9b3b-56034dcc6227",
                        "entry_id": "2210a061-347d-34ed-b8b3-b154acc703cf",
                        "tags": [
                            "plural"
                        ],
                        "form": "pentoses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d981d415-07e3-30aa-966a-82695dfc67ca",
                        "entry_id": "2210a061-347d-34ed-b8b3-b154acc703cf",
                        "glosses": [
                            "Famille de produits organiques à cinq carbones, appartenant au groupe des oses, ou sucres, de formule générale C₅H₁₀O₅, et à laquelle appartiennent le ribose et le désoxyribose, constituants principaux des chaînes d’acides nucléiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca08c1f-d035-4976-9975-0daad97d07e9",
                                "sense_id": "d981d415-07e3-30aa-966a-82695dfc67ca",
                                "text": "L’estérification d’un groupement hydroxyle du pentose d’un nucléoside par l’acide phosphorique conduit à la formation d’un nucléotide."
                            },
                            {
                                "example_id": "a7547e09-4912-4873-83d6-0dd34c51df14",
                                "sense_id": "d981d415-07e3-30aa-966a-82695dfc67ca",
                                "text": "Dans les nucléotides, les pentoses sont sous forme furanose et ont une configuration anomérique β."
                            },
                            {
                                "example_id": "8002cce1-d5e6-4d06-8a6b-55a98032a0f3",
                                "sense_id": "d981d415-07e3-30aa-966a-82695dfc67ca",
                                "text": "La cellule peut ainsi assurer une production de NADPH, de pentoses (ribose, ribulose, xylose et xylulose) ou même d'oses à sept carbones (des heptoses) comme le sédoheptulose ou à quatre carbone comme l’érythrose."
                            }
                        ]
                    }
                ],
