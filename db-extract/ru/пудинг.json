                    {
                        "sense_id": "0197e69a-0a5c-3003-b15e-2a0bbcefcf6f",
                        "entry_id": "17931ef2-e328-37e0-972f-cadf859ecc9c",
                        "glosses": [
                            "десерт-запеканка из крупы, муки, яиц и молока с приправами или сладостями, который готовится на водяной бане"
                        ],
                        "tags": [],
