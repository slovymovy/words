                                        "sense_id": "43797410-c0ee-322d-bcaf-a6a05605d9e7",
                                        "entry_id": "19f7a5b3-eb03-3202-ae1d-b4a39737096e",
                                        "glosses": [
                                            "durch Verleihung der Staatsbürgerschaft einbürgern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d63e7f8-0cf4-422c-ac0a-05038c148b49",
                                                "sense_id": "43797410-c0ee-322d-bcaf-a6a05605d9e7",
                                                "text": "Kaum jemand unter den Zuschauern wußte indessen, daß die beiden flachsblonden Schwestern Edda und Ilse Buding aus Buenos Aires gebürtige Rumäniendeutsche sind und erst knapp zwei Wochen vor ihrem Abflug nach Europa naturalisiert wurden, um als offizielle Vertreterinnen Argentiniens auftreten zu können."
                                            },
                                            {
                                                "example_id": "db654434-9823-4c58-a95d-28e9c98f7b51",
                                                "sense_id": "43797410-c0ee-322d-bcaf-a6a05605d9e7",
                                                "text": "„Sein Papa war ein deutscher Kaufmann gewesen, der sich in England hatte naturalisieren lassen und vor Jahren gestorben war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44fc50c3-c0c8-429f-8c4c-2394ee8999d3",
                        "source_entry_id": "87447057-84bb-3eed-ab8a-fe8050ad83c6",
                        "source_sense_id": "8902fa82-90d2-37f3-8304-77caf8c4f725",
                        "source_sense_description": "eine Pflanze in einem Gebiet heimisch machen, wo sie ursprünglich nicht vorkam",
                        "target_lang_word": "einführen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einführen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70329719-cfee-3149-8215-5cd0eec00c9b",
                                        "entry_id": "9b1dc1a3-5234-361f-8bc0-0c1ac53df20f",
                                        "glosses": [
                                            "eine Ware über eine Grenze in ein Land/Gebiet bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f559d313-6869-4ee0-96cd-ba4ae3c979a7",
                                                "sense_id": "70329719-cfee-3149-8215-5cd0eec00c9b",
                                                "text": "Der Importeur war darauf spezialisiert, Unterhaltungselektronik aus Asien einzuführen."
                                            },
                                            {
                                                "example_id": "59e6c6a1-ad00-4c21-b4e1-4df77dec5273",
                                                "sense_id": "70329719-cfee-3149-8215-5cd0eec00c9b",
                                                "text": "Jeder hätte illegal Drogen in das Land einführen können."
                                            },
                                            {
                                                "example_id": "2aeb0a1c-e40b-477c-a4dd-7c32c34d5e09",
                                                "sense_id": "70329719-cfee-3149-8215-5cd0eec00c9b",
                                                "text": "Auch der Walnußbaum wurde schon früh nach Deutschland eingeführt. (abgewandelt von Grottewitz, siehe unten)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80ee86d3-706a-3649-a9f3-eb7a4f8e4d69",
                                        "entry_id": "9b1dc1a3-5234-361f-8bc0-0c1ac53df20f",
                                        "glosses": [
                                            "etwas Neues zur Anwendung bringen; etwas Gültigkeit erlangen lassen; etwas bekannt machen, zur Benutzung bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5f287ef-d80a-464f-bcf7-99fcd0fe4a1c",
                                                "sense_id": "80ee86d3-706a-3649-a9f3-eb7a4f8e4d69",
                                                "text": "Auch der Walnußbaum wurde schon früh in Deutschland eingeführt. (Curt Grottewitz, Der Mensch als Beherrscher der Natur, III., z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "0153cdcb-9f18-4721-9e7f-54c8ac3ce72b",
                                                "sense_id": "80ee86d3-706a-3649-a9f3-eb7a4f8e4d69",
                                                "text": "Eine neue Steuer wurde eingeführt."
                                            },
                                            {
                                                "example_id": "7b534827-84c7-40c3-914b-5010b0922b33",
                                                "sense_id": "80ee86d3-706a-3649-a9f3-eb7a4f8e4d69",
                                                "text": "Jeder, der im praktischen Leben steht, weiß, wie mißtrauisch heute der Arbeiter jede Verbesserung, jede neue Erfindung, die eingeführt wird, aufnimmt. (August Bebel, Die Frau und der Sozialismus, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "33177d66-5e2e-409e-86dd-c1a88a8da95e",
                                                "sense_id": "80ee86d3-706a-3649-a9f3-eb7a4f8e4d69",
                                                "text": "Erst im dritten Kapitel führt der Schriftsteller die eigentliche Hauptperson ein."
                                            },
                                            {
                                                "example_id": "5e54ecb6-212b-4ef6-84be-8fa745cb29e3",
                                                "sense_id": "80ee86d3-706a-3649-a9f3-eb7a4f8e4d69",
                                                "text": "[BAFöG:] „Als es eingeführt wurde, 1971, bekamen 44 Prozent der Studierenden die Studienförderung. Heute sind es elf Prozent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "08584889-46f8-35b7-a21b-b51dcd87923e",
                                        "entry_id": "9b1dc1a3-5234-361f-8bc0-0c1ac53df20f",
                                        "glosses": [
                                            "eine Einführung geben"
                                        ],
                                        "tags": [
                                            "in etwas einführen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fb39aa3-7cf3-4613-952e-f680d7b34196",
                                                "sense_id": "08584889-46f8-35b7-a21b-b51dcd87923e",
                                                "text": "Der Lehrer führte uns in die unergründlichen Tiefen dieser Wissenschaft ein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4f0c0190-6ac5-3a60-aaf3-5a99c7ddc201",
                                        "entry_id": "9b1dc1a3-5234-361f-8bc0-0c1ac53df20f",
                                        "glosses": [
                                            "etwas in einen Raum, eine Lücke, eine Öffnung einbringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea8d6c5-92ff-4f52-8fc2-98c62f70158c",
                                                "sense_id": "4f0c0190-6ac5-3a60-aaf3-5a99c7ddc201",
                                                "text": "Es führte ein paarmal den Löffel in die große Schüssel ein, aus dem alle die saure Milch schöpften. (Johanna Spyri, Am Felsensprung, 1. Kapitel, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "9dbb3a87-88a7-4796-b687-8481ac65e345",
                                                "sense_id": "4f0c0190-6ac5-3a60-aaf3-5a99c7ddc201",
                                                "text": "Das Fieberthermometer wird rektal eingeführt."
                                            },
                                            {
                                                "example_id": "1c40bea3-4cb6-44ab-a17d-f7e69321029b",
                                                "sense_id": "4f0c0190-6ac5-3a60-aaf3-5a99c7ddc201",
                                                "text": "„Ein Herzkatheter ist ein etwa zwei Millimeter dicker und 1,5 Meter langer Plastikschlauch, der über eine Vene oder eine Schlagader ins Herz eingeführt wird.“"
                                            },
                                            {
                                                "example_id": "7c6a19c4-df03-476b-a0f9-e51325e3823d",
                                                "sense_id": "4f0c0190-6ac5-3a60-aaf3-5a99c7ddc201",
                                                "text": "„Am Abend vor der Operation müssen sie sich die Tabletten in die Vagina einführen.“"
                                            }
                                        ],
