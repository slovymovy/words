                    "frequency": "High",
                    "semantic_group_id": "horlogerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il consulte sa <w>montre</w> pour vérifier s'il est à l'heure au travail."
                        },
                        {
                            "text": "Elle a reçu une belle <w>montre</w> en or pour son diplôme universitaire."
                        }
                    ],
                    "common_phrases": [
