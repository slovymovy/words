    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "534a95cb-40ac-3dd9-94b4-8d240e7089f1",
                "word": "protestbeweging",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d952e01d-5184-42ca-82d7-70f729c29250",
                        "entry_id": "534a95cb-40ac-3dd9-94b4-8d240e7089f1",
                        "tags": [
                            "plural"
                        ],
                        "form": "protestbewegingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "578b693f-6d64-3397-b226-a9d1f9e4e6f8",
                        "entry_id": "534a95cb-40ac-3dd9-94b4-8d240e7089f1",
                        "glosses": [
                            "groep mensen die laat merken dat ze het ergens niet mee eens is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e95823-b445-4f4a-b2ee-ead286421598",
                                "sense_id": "578b693f-6d64-3397-b226-a9d1f9e4e6f8",
                                "text": "San Francisco 49ers nam aan het einde van dat jaar afscheid van Kaepernick, die als symbool van de protestbeweging tot zijn eigen frustratie nergens meer aan de bak kon komen."
                            },
                            {
                                "example_id": "1ff9bd07-e93a-412e-b9d7-84a803931a41",
                                "sense_id": "578b693f-6d64-3397-b226-a9d1f9e4e6f8",
                                "text": "\"Een duidelijke overeenkomst tussen de twee jaren is dat de machtshebbers meer en meer politie inzetten en niet ingaan op de oorzaken van de demonstraties\", zegt historicus Heather Ann Thompson, die onderzoek deed naar protestbewegingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8eb31f57-7089-4abd-9a0b-ff1ebe6dcdfd",
                        "source_entry_id": "534a95cb-40ac-3dd9-94b4-8d240e7089f1",
                        "source_sense_id": "578b693f-6d64-3397-b226-a9d1f9e4e6f8",
                        "target_lang_word": "mouvement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mouvement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0924a079-50cf-3ba6-ab0b-01b2eda7b509",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Transport d’un corps ou d’une de ses parties d’un lieu, d’une place dans une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b49be2e2-2124-445c-aa61-e9bc6104980d",
                                                "sense_id": "0924a079-50cf-3ba6-ab0b-01b2eda7b509",
                                                "text": "Rien de gracieux comme ses mouvements d’épaules, lorsqu’elle attire le menton pour se cacher entièrement la figure, qui, par instants, se montre à la dérobée."
                                            },
                                            {
                                                "example_id": "5ebdf9b6-16cb-4db3-a8a1-d54278e43051",
                                                "sense_id": "0924a079-50cf-3ba6-ab0b-01b2eda7b509",
                                                "text": "La musique enivre et règle le danseur, tandis que le curieux voit le mouvement seul et rit de ce pantin qui s’agite sans raison, car le curieux, lui, n’entend pas la musique."
                                            },
                                            {
                                                "example_id": "47181713-b030-4e88-837c-f9347d624141",
                                                "sense_id": "0924a079-50cf-3ba6-ab0b-01b2eda7b509",
                                                "text": "Il lui dit qu’il l’avait reconnue de loin au rythme de ses lignes et de ses mouvements, qui était bien à elle.\n— Les beaux mouvements, ajouta-t-il, c’est la musique des yeux."
                                            },
                                            {
                                                "example_id": "8e0e763d-c767-4b45-8a21-c5c6da0fc127",
                                                "sense_id": "0924a079-50cf-3ba6-ab0b-01b2eda7b509",
                                                "text": "Depuis deux heures Rabalan travaillait avec acharnement. Son casse-pierres se levait et s’abaissait en un mouvement rythmique, sur les cailloux."
                                            },
                                            {
                                                "example_id": "24fe9c42-7642-4c6f-b315-4c2f02037d8e",
                                                "sense_id": "0924a079-50cf-3ba6-ab0b-01b2eda7b509",
                                                "text": "Dans la prairie, les vaches lentement avançaient, broutant devant elles sans hâte et sans trêve. Le fanon musculeux ballottait de droite et de gauche comme une épaisse draperie qu’agitaient les mouvements de mufle réguliers et lents […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a83c732c-9b43-3067-8d83-dfa8c70281ce",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Changement de situation qu’un corps éprouve relativement à certains objets regardés comme fixes, par l’effet d’une force agissant sur lui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca0209dd-9db7-4171-9f42-cf20618167d0",
                                                "sense_id": "a83c732c-9b43-3067-8d83-dfa8c70281ce",
                                                "text": "[…] et une vis de rappel micrométrique peut ensuite soulever ou abaisser la lunette par un mouvement doux et modérable , pour faire atteindre plus exactement à son axe optique la hauteur voulue."
                                            },
                                            {
                                                "example_id": "499bacde-200a-406c-ab7d-8d5a0bf192d1",
                                                "sense_id": "a83c732c-9b43-3067-8d83-dfa8c70281ce",
                                                "text": "Ces mouvements sont assurés par un excentrique, sur la circonférence duquel court un galet qui est relié à une chaîne attachée au chariot avec un contrepoids."
                                            },
                                            {
                                                "example_id": "8676fc9f-c384-47f8-8057-40dee8f2e067",
                                                "sense_id": "a83c732c-9b43-3067-8d83-dfa8c70281ce",
                                                "text": "Les grands floes épais mis en liberté sont usés par la friction, rongés par les mouvements de la mer et par le dégel, ils constituent fréquemment des masses aux formes bizarres et élégantes d’une glace bleue-verdâtre très dure."
                                            },
                                            {
                                                "example_id": "7ce116ea-c13a-42c2-b45d-ae56d11e9e5d",
                                                "sense_id": "a83c732c-9b43-3067-8d83-dfa8c70281ce",
                                                "text": "[…] le progrès est un perpétuel devenir, nulle méthode ne saurait être considérée comme immuable, tout est en mouvement, tout est continuellement améliorable, tout ce qui existe aujourd’hui sera demain mieux encore…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e47c0a90-4925-3ee9-b7f3-e9ea81decf7d",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "(Spiritualité) (Avec une majuscule initiale) Force donnant lieu à des changements, à une évolution dans le monde matériel ou immatériel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae3a80f9-4d1e-4940-86d9-29792ad72edb",
                                                "sense_id": "e47c0a90-4925-3ee9-b7f3-e9ea81decf7d",
                                                "text": "Le Mouvement, en raison de la résistance, produit une combinaison qui est la vie; dès que l'un ou l'autre est plus fort, la vie cesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ad05410-bcc7-3776-9f1e-297ee55db001",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Révolution, marche, réelle ou apparente, des astres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b78fa940-d397-496e-9159-de1e98423031",
                                                "sense_id": "7ad05410-bcc7-3776-9f1e-297ee55db001",
                                                "text": "Mouvement d’un corps céleste autour de son centre. — Mouvement d’orient en occident, d’occident en orient."
                                            },
                                            {
                                                "example_id": "07bdef04-a2b4-4995-9f4c-d68c52e9ca61",
                                                "sense_id": "7ad05410-bcc7-3776-9f1e-297ee55db001",
                                                "text": "Mouvement apparent. — Mouvement géocentrique, héliocentrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1bf920c-07b1-3a3e-b695-71af43ad4f24",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Fonction animale qui change la situation, la figure, la grandeur de quelque partie intérieure ou extérieure du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32221ef2-cfa4-42ea-ae66-b81e4ee531a0",
                                                "sense_id": "c1bf920c-07b1-3a3e-b695-71af43ad4f24",
                                                "text": "Mouvement du cœur, des artères. — Mouvement péristaltique des intestins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "923ba142-c124-385d-9b00-223585df6694",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Petit accès d’une chose bénigne."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf5d65a-196b-4a6c-8f18-750950f678f1",
                                                "sense_id": "923ba142-c124-385d-9b00-223585df6694",
                                                "text": "Avoir un mouvement de fièvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e71703-adbd-3ab8-8870-2857b69647fd",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Ensemble des marches, des évolutions, des différentes manœuvres d’une armée, d’une troupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2565bd6b-4573-4313-8014-04709474dbb2",
                                                "sense_id": "23e71703-adbd-3ab8-8870-2857b69647fd",
                                                "text": "Mouvement stratégique. — Surveiller tous les mouvements de l’ennemi."
                                            },
                                            {
                                                "example_id": "17979318-bee0-4b98-b8d6-0ed15c83d542",
                                                "sense_id": "23e71703-adbd-3ab8-8870-2857b69647fd",
                                                "text": "Le champ de bataille de la Chipotte […] est lié à la guerre de mouvement, à la différence d'autres sites labellisés riches en vestiges et témoignages d'une longue guerre de tranchées ou de position."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "034e64c2-2cb8-37a8-a2d7-addeb8d470f4",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Circulation des personnes et des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba42bdaa-5039-4329-bf42-3b9b7def81ea",
                                                "sense_id": "034e64c2-2cb8-37a8-a2d7-addeb8d470f4",
                                                "text": "Il semble donc qu’on est en droit de conclure à l’existence d’un large mouvement humain se dirigeant, vers l’époque quaternaire, de l’Est du vieux monde à l’Ouest du nouveau."
                                            },
                                            {
                                                "example_id": "729c3e88-680f-4f87-abbf-dae35d06a4f8",
                                                "sense_id": "034e64c2-2cb8-37a8-a2d7-addeb8d470f4",
                                                "text": "Ils avaient terminé leur repas et sirotaient un café-filtre, en regardant de loin le mouvement de la rue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e5dd223-8e22-3948-bdac-7818a72056a0",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Circulation logistique et commerciale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74fa7578-8344-47b0-b8d2-73428492e43f",
                                                "sense_id": "8e5dd223-8e22-3948-bdac-7818a72056a0",
                                                "text": "Le mouvement commercial, le mouvement des affaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5def5151-8874-3d94-9ac2-8e077e64a5c0",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Ensemble des entrées et sorties d'un nombre indéterminé de navires ou d'aéronefs."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb26f2b7-6605-4182-8b68-f3550abaa73f",
                                                "sense_id": "5def5151-8874-3d94-9ac2-8e077e64a5c0",
                                                "text": "Le mouvement d’un port, d’un aéroport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10f1d8be-0309-3d03-a148-7342446e500a",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Ensemble des variations qui arrivent dans certains établissements publics, dans certains corps, par les changements de situation des personnes qui en font partie"
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9649d84d-29ca-456a-9c2e-bbd4a63adb36",
                                                "sense_id": "10f1d8be-0309-3d03-a148-7342446e500a",
                                                "text": "Le tableau du mouvement n’est pas encore achevé."
                                            },
                                            {
                                                "example_id": "89fe2635-3db4-4b79-a485-c53c2e79d5a6",
                                                "sense_id": "10f1d8be-0309-3d03-a148-7342446e500a",
                                                "text": "Mouvement du personnel, diplomatique, préfectoral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "965bface-6528-33a2-9a36-88bc39b09eef",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Marche des sons du grave à l’aigu et de l’aigu au grave, entre des parties qui concertent ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b6cddd5-d071-4a4e-9add-5395c3eeb62c",
                                                "sense_id": "965bface-6528-33a2-9a36-88bc39b09eef",
                                                "text": "Mouvement direct, contraire, oblique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3579af5-1fa2-30c8-b944-19c99f8ff2d7",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Degré de vitesse ou de lenteur que le caractère de l’air doit donner à la mesure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cdacfb7-7799-44b1-b4a8-479c2e5aa417",
                                                "sense_id": "d3579af5-1fa2-30c8-b944-19c99f8ff2d7",
                                                "text": "Cette pièce est d’un mouvement lent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e8e4bf2-5504-39aa-8c7d-9bb667ff85b2",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Partie d’une œuvre musicale constituant une unité mais s'insérant dans un tout plus grand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f022ab88-a564-49e5-baa4-ccd6d6692985",
                                                "sense_id": "6e8e4bf2-5504-39aa-8c7d-9bb667ff85b2",
                                                "text": "Le troisième mouvement de cette pièce est magnifique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e318eac-9054-3e1a-bfc4-4e497095b350",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Expression des mouvements du corps et des sentiments."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f547698-fb89-424f-9675-3a8f8a63961d",
                                                "sense_id": "6e318eac-9054-3e1a-bfc4-4e497095b350",
                                                "text": "Cette figure n’a pas de mouvement, est sans mouvement. — Ce tableau est plein de mouvement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd0b6b13-6e82-3b2f-995a-1d6862a717ff",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Plan de terrain s'inscrivant dans un ensemble hétéroclite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a78dd56-5afd-4aaa-9e7e-1d4e83f05f5f",
                                                "sense_id": "fd0b6b13-6e82-3b2f-995a-1d6862a717ff",
                                                "text": "Le 21 et le 28, il rejeta les assaillants au-delà du premier mouvement du terrain qui entoure la ville, puis passa à l’offensive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b04ade9-bb9e-38eb-9562-decbafebb17e",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Ce qui anime le style, de ce qui fait qu’un récit intéresse les lecteurs, qu’un discours entraîne les auditeurs."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a1381e-7e85-4597-be79-3c738197519b",
                                                "sense_id": "5b04ade9-bb9e-38eb-9562-decbafebb17e",
                                                "text": "Il y a beaucoup de mouvement dans son style."
                                            },
                                            {
                                                "example_id": "cc4aef64-f4f7-4c2a-a85b-f9733f1965d1",
                                                "sense_id": "5b04ade9-bb9e-38eb-9562-decbafebb17e",
                                                "text": "Un beau mouvement d’éloquence."
                                            },
                                            {
                                                "example_id": "26af759c-a82c-4242-ada6-d4c1b7370505",
                                                "sense_id": "5b04ade9-bb9e-38eb-9562-decbafebb17e",
                                                "text": "Les mouvements oratoires."
                                            },
                                            {
                                                "example_id": "7dd4adb8-bf9f-40f0-a031-a3a75d55f07c",
                                                "sense_id": "5b04ade9-bb9e-38eb-9562-decbafebb17e",
                                                "text": "Puis les discours.\nLa série en était ouverte par M. Cramouillat, député d’Issoire et conseiller général, président du Comité d’action. C’était même à la fin de son premier mouvement oratoire, sur les mots : « Te voici, Vercingétorix ! » que la statue devait soudain apparaître aux yeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b3a11e-145b-30f2-9a47-6ee41386a995",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Phénomène social, politique ou artistique mobilisant une masse non négligeable d'adhérents et s'inscrivant en propre dans un ensemble social plus vaste."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdc7d9b8-d98f-4ee5-9b85-d92d25ced6ec",
                                                "sense_id": "86b3a11e-145b-30f2-9a47-6ee41386a995",
                                                "text": "Mais la grande débâcle a commencé en 1875 et en 1876, quand, coïncidant avec le mouvement malthusien qui déjà gagnait les esprits, survint l’abominable phylloxera. […] Dès lors, tous les éléments jeunes et actifs s’orientèrent rapidement vers les villes […]"
                                            },
                                            {
                                                "example_id": "7172118b-bf8c-4f73-9a11-ef4a45296b2b",
                                                "sense_id": "86b3a11e-145b-30f2-9a47-6ee41386a995",
                                                "text": "J’ai d’abord soutenu le mouvement lettriste à cause des idées économiques qu’il présentait."
                                            },
                                            {
                                                "example_id": "0204443c-f761-498c-a16a-f55a52e84993",
                                                "sense_id": "86b3a11e-145b-30f2-9a47-6ee41386a995",
                                                "text": "Le Wahhabites, en Arabie, à la fin du XVIIIᵉ siècle, par exemple, recourant à l’autorité de certains théologiens médiévaux, lancèrent un mouvement virulent d’islam purifié […]"
                                            },
                                            {
                                                "example_id": "dab3cd8e-beff-4f18-8937-74300d2c0561",
                                                "sense_id": "86b3a11e-145b-30f2-9a47-6ee41386a995",
                                                "text": "Chef de file du mouvement zazou, Charles Trenet n’adhérera pas pour autant à la révolution be-bop qui déferle à la Libération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a055b202-51b6-3165-bc64-3ba582436dad",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Agitation, fermentation dans les esprits, de nature à faire craindre des troubles, une révolte."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46e6fbb7-1023-4afb-ad25-792da8928add",
                                                "sense_id": "a055b202-51b6-3165-bc64-3ba582436dad",
                                                "text": "On peut indéfiniment parler de révoltes sans provoquer jamais aucun mouvement révolutionnaire, tant qu’il n’y a pas de mythes acceptés par les masses […]"
                                            },
                                            {
                                                "example_id": "565b4140-40b5-4d88-8fb8-86d8bd376289",
                                                "sense_id": "a055b202-51b6-3165-bc64-3ba582436dad",
                                                "text": "Pendant ce temps, dans la cité géante, le mouvement insurrectionnel échappait à tout contrôle. […] Au début, la rébellion ne se manifesta que par des vociférations isolées, des harangues sur les places et des excitations dans la presse."
                                            },
                                            {
                                                "example_id": "c65b193f-8424-4a47-8863-0f7343b9910c",
                                                "sense_id": "a055b202-51b6-3165-bc64-3ba582436dad",
                                                "text": "Question : Godkin connaît le rôle joué par nombre d’Américaines dans le mouvement abolitionniste par exemple ; craint-il à ce point les « pétroleuses » que le vote des femmes lui paraisse si peu compatible avec ce suffrage universel auquel il semble attaché ?"
                                            },
                                            {
                                                "example_id": "f7d6197f-de81-4701-bc4b-cbce1599ce21",
                                                "sense_id": "a055b202-51b6-3165-bc64-3ba582436dad",
                                                "text": "Leur expérience de vie, les dommages vécus par leurs familles, ne s’agit-il pas de réalités concrètes qui illustrent les dangers associés aux mouvements révolutionnaires de gauche ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a1c37b9-240a-3af8-b8c3-6de017ff96fd",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Impulsion spontanée qui tend vers une action mais peut être refrénée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "056a313d-c016-42c2-a1d5-32dd0c08ab83",
                                                "sense_id": "3a1c37b9-240a-3af8-b8c3-6de017ff96fd",
                                                "text": "Saurez-vous vous garantir du premier mouvement, qui chez vous est terrible ?"
                                            },
                                            {
                                                "example_id": "891c8b02-eddc-4ba1-9261-b9c2f66062b8",
                                                "sense_id": "3a1c37b9-240a-3af8-b8c3-6de017ff96fd",
                                                "text": "Mais il fallait que ce bon mouvement ne demeurât point exceptionnel, et se prolongeât au-delà du succès."
                                            },
                                            {
                                                "example_id": "1569e9b6-acf4-4d24-a7e6-adac08cab358",
                                                "sense_id": "3a1c37b9-240a-3af8-b8c3-6de017ff96fd",
                                                "text": "Mouvements de l’âme. — On n’est pas maître d’un premier mouvement."
                                            },
                                            {
                                                "example_id": "9f4abb8c-d6b3-4a8a-a441-c649d1e953f3",
                                                "sense_id": "3a1c37b9-240a-3af8-b8c3-6de017ff96fd",
                                                "text": "Il a fait cela par un bon mouvement, par un mouvement d’équité, de pitié."
                                            },
                                            {
                                                "example_id": "20c1acad-28aa-4ad2-8ec3-2b98cf4a9793",
                                                "sense_id": "3a1c37b9-240a-3af8-b8c3-6de017ff96fd",
                                                "text": "Mouvement de colère, d’orgueil, de vanité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae58a394-9619-3d61-9273-74cc142240f8",
                                        "entry_id": "0f4b28b5-f64e-363b-b0fd-392d24204e71",
                                        "glosses": [
                                            "Assemblage des parties qui animent une horloge, une pendule, une montre."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13872abb-9ff5-4b6b-8584-a0db9d233377",
                                                "sense_id": "ae58a394-9619-3d61-9273-74cc142240f8",
                                                "text": "Le mouvement, excellent sans doute, n’avait pas été remonté depuis deux siècles. - Ce n’était pas pour savoir l’heure que j’avais acheté cette pendule en Touraine."
                                            },
                                            {
                                                "example_id": "f39e8823-c817-4f7c-ae59-7b41f4ce1de8",
                                                "sense_id": "ae58a394-9619-3d61-9273-74cc142240f8",
                                                "text": "Curieuse pendule en métal patiné représentant satyriquement Ménélik II, empereur d’Éthiopie entre 1889 et 1913. Le mouvement et le cadran inscrit dans son ventre."
                                            },
                                            {
                                                "example_id": "bac0783d-728e-4edb-a421-505428c057ab",
                                                "sense_id": "ae58a394-9619-3d61-9273-74cc142240f8",
                                                "text": "Une montre fonctionne grâce à son calibre, appelé aussi mouvement. Il se décline en 3 types de mouvement : le mouvement à quartz, le mouvement automatique et le mouvement mécanique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a1ebffa-310c-4a0d-8286-831b84591987",
                        "source_entry_id": "534a95cb-40ac-3dd9-94b4-8d240e7089f1",
                        "source_sense_id": "578b693f-6d64-3397-b226-a9d1f9e4e6f8",
                        "target_lang_word": "contestataire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contestataire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                                        "entry_id": "fc656d69-df04-3e12-b5c0-cc53777ecebb",
                                        "glosses": [
                                            "Qui conteste les valeurs dominantes d'une société avec refus de s'intégrer dans un ordre social."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e06e158-0943-43f7-88c1-cfeeb0b1bfea",
                                                "sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                                                "text": "Le punk est un mouvement contestataire."
                                            },
                                            {
                                                "example_id": "009b97f6-2dc5-43fc-9a1c-9498d47f1dde",
                                                "sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                                                "text": "Comme s'il avait retrouvé son ancien élan de dissident contestataire, il a refusé une déclaration exigée par cette loi, car il la trouvait indigne, contraire aux droits de l'homme et à la Constitution."
                                            },
                                            {
                                                "example_id": "a9c3f545-b948-4a29-813e-29f27f07c888",
                                                "sense_id": "9caad1e6-09bb-3d72-af9e-ed10e3252778",
                                                "text": "Quant aux mouvements contestataires de l'Ouest : Beatles, cheveux longs et musique rock, les Chinois n'y voyaient, dit-on, que des caprices d'adolescents et un leurre …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contestataire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "063f6234-71d0-3314-b168-b6a97fbe7a04",
                                        "entry_id": "f39eb30d-238c-3308-9eee-889f81db3901",
                                        "glosses": [
                                            "Personne contestataire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a799ae2b-a689-4771-aa28-ec91f9827fa0",
                                                "sense_id": "063f6234-71d0-3314-b168-b6a97fbe7a04",
                                                "text": "Les psychosociologues savent depuis longtemps que la présence d'un contestataire, même unique, au sein d'un groupe unanime peut suffire pour rendre le processus de création plus créatif et plus profond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
