    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "196e5f1c-5307-330b-94ba-1f5ea4fe0394",
                    "sense_definition": "A body temperature that is higher than normal, usually as a result of an illness.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medical condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child has a high <w>fever</w> and needs to stay in bed today.",
                            "target_lang_translations": {
                                "ru": "У ребенка высокая <w>температура</w>, и сегодня ему нужно оставаться в постели."
                            }
                        },
                        {
                            "text": "You should drink plenty of water to help your body recover from a <w>fever</w>.",
                            "target_lang_translations": {
                                "ru": "Вам следует пить много воды, чтобы помочь организму восстановиться после <w>жара</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "high temperature",
                        "temperature"
                    ],
                    "common_phrases": [
                        "high fever",
                        "run a fever",
                        "break a fever"
                    ],
                    "target_lang_definitions": {
                        "ru": "Температура тела выше нормы, обычно в результате болезни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жар",
                                "target_lang_sense_clarification": "повышенная температура тела"
                            },
                            {
                                "target_lang_word": "температура",
                                "target_lang_sense_clarification": "разг. повышенная температура тела"
                            },
                            {
                                "target_lang_word": "лихорадка",
                                "target_lang_sense_clarification": "состояние с жаром и ознобом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e72be6d6-b5e2-35f6-bc31-2ccd48231f22",
                    "sense_definition": "A state of intense excitement, nervous energy, or anxiety about something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city was gripped by election <w>fever</w> as the voting day approached.",
                            "target_lang_translations": {
                                "ru": "Город был охвачен предвыборной <w>лихорадкой</w> по мере приближения дня голосования."
                            }
                        },
                        {
                            "text": "The fans were in a <w>fever</w> of excitement waiting for the band to arrive.",
                            "target_lang_translations": {
                                "ru": "Фанаты были в <w>ажиотаже</w> от волнения, ожидая приезда группы."
                            }
                        }
                    ],
                    "synonyms": [
                        "excitement",
                        "passion"
                    ],
                    "common_phrases": [
                        "election fever",
                        "gold fever",
                        "cabin fever"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сильного возбуждения, нервной энергии или беспокойства по поводу чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лихорадка",
                                "target_lang_sense_clarification": "перен. состояние крайнего возбуждения"
                            },
                            {
                                "target_lang_word": "горячка",
                                "target_lang_sense_clarification": "перен. страстное увлечение или спешка"
                            },
                            {
                                "target_lang_word": "ажиотаж",
                                "target_lang_sense_clarification": "сильное возбуждение вокруг чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23cddbdd-c68b-3e1b-9c62-291ca5af3761",
                    "sense_definition": "Any of various infectious diseases characterized by a high body temperature.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the past, many people suffered from scarlet <w>fever</w> before modern medicine.",
                            "target_lang_translations": {
                                "ru": "В прошлом многие люди страдали от скарлатины (пурпурной <w>лихорадки</w>) до появления современной медицины."
                            }
                        },
                        {
                            "text": "Travelers are often required to get vaccinated against yellow <w>fever</w>.",
                            "target_lang_translations": {
                                "ru": "Путешественникам часто требуется сделать прививку от желтой <w>лихорадки</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scarlet fever",
                        "yellow fever",
                        "hay fever"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое из различных инфекционных заболеваний, характеризующихся высокой температурой тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лихорадка",
                                "target_lang_sense_clarification": "название болезни (например, желтая лихорадка)"
                            },
                            {
                                "target_lang_word": "горячка",
                                "target_lang_sense_clarification": "устар. название инфекционной болезни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7785c145-fb33-3ddb-b5ac-387fdbd02aab",
                    "sense_definition": "A collective term for a group of stingrays.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "collective noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The divers were amazed to see a <w>fever</w> of stingrays gliding through the water.",
                            "target_lang_translations": {
                                "ru": "Дайверы были поражены, увидев <w>стаю</w> скатов-хвостоколов, скользящих в воде."
                            }
                        },
                        {
                            "text": "A <w>fever</w> of stingrays passed right under our glass-bottom boat.",
                            "target_lang_translations": {
                                "ru": "<w>Скопление</w> скатов проплыло прямо под нашей лодкой с прозрачным дном."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fever of stingrays"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное название для группы скатов-хвостоколов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа морских животных"
                            },
                            {
                                "target_lang_word": "скопление",
                                "target_lang_sense_clarification": "группа животных в одном месте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea7642a0-7bd6-39d1-a18f-6a2e8e7ddba6",
                    "sense_definition": "An intense or obsessive sexual attraction toward a specific group of people.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term is sometimes used to describe a specific type of social <w>fever</w> or obsession.",
                            "target_lang_translations": {
                                "ru": "Этот термин иногда используется для описания определенного типа социальной <w>одержимости</w> или мании."
                            }
                        },
                        {
                            "text": "He realized his sudden obsession was just a passing <w>fever</w> for that subculture.",
                            "target_lang_translations": {
                                "ru": "Он понял, что его внезапная одержимость была лишь мимолетным <w>увлечением</w> этой субкультурой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in specific social contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Интенсивное или навязчивое сексуальное влечение к определенной группе людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фетиш",
                                "target_lang_sense_clarification": "навязчивое влечение"
                            },
                            {
                                "target_lang_word": "одержимость",
                                "target_lang_sense_clarification": "крайняя степень увлечения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf6ebe91-1e41-32b0-929a-0bdb9adf5598",
                    "sense_definition": "To cause someone to have a fever or to become highly excited.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cause state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat of the sun began to <w>fever</w> the stranded travelers.",
                            "target_lang_translations": {
                                "ru": "Сильная солнечная жара начала <w>вызывать жар</w> у застрявших путешественников."
                            }
                        },
                        {
                            "text": "The wild rumors served only to <w>fever</w> the minds of the angry crowd.",
                            "target_lang_translations": {
                                "ru": "Дикие слухи лишь еще больше <w>будоражили</w> умы разгневанной толпы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a transitive verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо жар или приводить в состояние сильного возбуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лихорадить",
                                "target_lang_sense_clarification": "вызывать состояние лихорадки"
                            },
                            {
                                "target_lang_word": "будоражить",
                                "target_lang_sense_clarification": "приводить в сильное возбуждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63c24378-2a92-3b36-b37f-16c0f72f77ee",
                    "sense_definition": "To develop a fever or to enter a state of high excitement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enter state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient began to <w>fever</w> as the infection spread through his system.",
                            "target_lang_translations": {
                                "ru": "Пациента начало <w>лихорадить</w>, когда инфекция распространилась по организму."
                            }
                        },
                        {
                            "text": "The audience started to <w>fever</w> with anticipation as the lights went down.",
                            "target_lang_translations": {
                                "ru": "Зрители начали <w>гореть</w> от нетерпения, когда погас свет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an intransitive verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заболеть лихорадкой или войти в состояние сильного возбуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лихорадить",
                                "target_lang_sense_clarification": "быть в состоянии жара или возбуждения"
                            },
                            {
                                "target_lang_word": "гореть",
                                "target_lang_sense_clarification": "быть в жару или в сильном нетерпении"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}