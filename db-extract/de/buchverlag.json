                "senses": [
                    {
                        "sense_id": "54485485-7f2b-3aab-bc88-83e539b583c2",
                        "entry_id": "6e2f4ec5-6acf-364a-b688-a07abe1da3fc",
                        "glosses": [
                            "Verlag, der Bücher veröffentlicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b61b1c4d-64ca-4e2e-94a8-f9a99a14df66",
                                "sense_id": "54485485-7f2b-3aab-bc88-83e539b583c2",
                                "text": "„Heute bin ich Marketingassistentin in einem Buchverlag, mit der Option, zur Marketingleitung aufzusteigen, und einfach rundherum glücklich.“"
                            },
                            {
                                "example_id": "99549123-2dd7-43c6-9735-012820353d77",
                                "sense_id": "54485485-7f2b-3aab-bc88-83e539b583c2",
                                "text": "„Und oft spielte Jakob Haringer mit dem geschenkten Geld den Verleger seiner Werke, die von den großen Buchverlagen nicht angenommen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
