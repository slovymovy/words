                                                "example_id": "553e24d1-5571-47d9-bbeb-0839803496ef",
                                                "sense_id": "3c0eb017-705a-30fb-8326-98ee940d5cea",
                                                "text": "I can meet you tomorrow because I have the day off."
                                            },
