                "senses": [
                    {
                        "sense_id": "7ed4586d-cd11-3d20-930c-f47f63d211e1",
                        "entry_id": "841c65dc-fa78-326c-87c7-39ec79e65486",
                        "glosses": [
                            "Fähigkeit, sich einen Gegenstand, eine Person oder eine Szene anschaulich und bildhaft vorzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "300bfcac-97a5-4574-999e-d91e7e46a368",
                                "sense_id": "7ed4586d-cd11-3d20-930c-f47f63d211e1",
                                "text": "„Eine noch bedeutsamere Rolle kommt der Anschauungskraft zu, dem glücklichen Blick für vorhandene Motive, der den wunden Punkt gleich herausfühlt.“"
                            },
                            {
                                "example_id": "50536de9-519a-4efb-97fd-5fd535335a4b",
                                "sense_id": "7ed4586d-cd11-3d20-930c-f47f63d211e1",
                                "text": "„Die Gottesdienste mit ihrer Leidenschaft und ihrer Anschauungskraft beeindruckten Bonhoeffer sehr.“"
                            },
                            {
                                "example_id": "5c72c6b6-2dea-47f5-8ada-e7ad81c77de1",
                                "sense_id": "7ed4586d-cd11-3d20-930c-f47f63d211e1",
                                "text": "„Sie, die Sprachlehre, ist also die wesentliche Mittelstufe zwischen dem geistig belebten Wesen der Anschauungskraft und demjenigen der Denkkraft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
