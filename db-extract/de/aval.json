                                                "example_id": "d53cfa01-947a-4324-af8d-460b5bae83fd",
                                                "sense_id": "a304067e-7c92-3eeb-a58c-3fd765fb4b4c",
                                                "text": "L’aval peut être fourni par acte séparé."
