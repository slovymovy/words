                        ],
                        "form": "die Dopplereffekte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca74acf4-6e79-3129-871c-9c240a470b37",
                        "entry_id": "8d90e7d0-5a3c-354c-a086-95223ea28768",
                        "glosses": [
                            "Veränderung der Frequenz von Wellen, die durch Bewegung von Sender und Empfänger (relativ) zueinander hervorgerufen wird"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "e626f6af-1d97-497e-8e44-255cd38f7994",
                                "sense_id": "ca74acf4-6e79-3129-871c-9c240a470b37",
                                "text": "Auch bei ruhender Schallquelle und bewegtem Beobachter tritt ein Dopplereffekt auf."
                            },
                            {
                                "example_id": "4224a902-86bb-4a83-84f6-7a3b50ee0cc2",
                                "sense_id": "ca74acf4-6e79-3129-871c-9c240a470b37",
                                "text": "„Sie maßen mit Hilfe des Dopplereffekts, wie schnell die Sterne sich umeinander drehen (ein Umlauf dauert nicht einmal vier Tage).“"
                            },
                            {
                                "example_id": "f6c36ace-de8e-4601-9b03-1e17afb4ef34",
                                "sense_id": "ca74acf4-6e79-3129-871c-9c240a470b37",
                                "text": "„Je schneller sie sich jedoch von uns entfernen, umso stärker ist ihr Licht ins Rote verschoben. (Die Rotverschiebung ist die optische Entsprechung des Dopplereffekts, dem gemäß etwa das Signalhorn eines sich entfernenden Rettungswagens tiefer tönt.)“"
                            },
                            {
                                "example_id": "4505bdc5-0fdf-40ca-9e6d-82de88051c68",
                                "sense_id": "ca74acf4-6e79-3129-871c-9c240a470b37",
                                "text": "„Die Dopplereffekte der etwas rascheren Strömungen in den Spicules der höheren Chromosphäre machen sich analog in den Dopplerkernen der starken Fraunhoferlinien bemerkbar.“"
                            },
                            {
                                "example_id": "0f654530-db33-4897-9c4d-4cc727b6ac41",
                                "sense_id": "ca74acf4-6e79-3129-871c-9c240a470b37",
                                "text": "„Die Dopplereffekte am Viellinienspektrum wurden etwa bei 60000 Volt beobachtet.“"
                            },
                            {
                                "example_id": "195f92b4-813b-4f4c-894c-247a2d14b4f9",
                                "sense_id": "ca74acf4-6e79-3129-871c-9c240a470b37",
                                "text": "„Die Dopplereffekte sind gewaltig, und die starke Schwerkraft bewirkt eine zusätzliche Rotverschiebung.“"
                            },
                            {
                                "example_id": "1b6d382f-d0e8-415d-8405-3a27664c7ba0",
                                "sense_id": "ca74acf4-6e79-3129-871c-9c240a470b37",
                                "text": "„R ist der mittlere Erdradius, h₁' und h₂' sind die aus den Dopplereffekten ermittelten Höhen, bezogen auf den mittleren Erdradius R.“"
                            },
                            {
                                "example_id": "a3ca8833-466d-43ec-a400-6c8a2df7d975",
                                "sense_id": "ca74acf4-6e79-3129-871c-9c240a470b37",
                                "text": "„Dadurch kompensieren sich die Dopplereffekte des Uplinks und des Downlinks weitgehend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
