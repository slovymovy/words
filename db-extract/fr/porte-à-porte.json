                                                "sense_id": "8e5a3515-e160-3542-a307-5ad688729cb1",
                                                "text": "He carried the petition door to door, collecting signatures."
                                            },
                                            {
                                                "example_id": "5c3053c9-805d-40c9-9638-66488f4b6971",
                                                "sense_id": "8e5a3515-e160-3542-a307-5ad688729cb1",
                                                "text": "He sold magazine subscriptions at inflated prices door to door."
                                            },
                                            {
                                                "example_id": "1d486dd1-4d5a-46e8-9f64-a7fdaabca18b",
                                                "sense_id": "8e5a3515-e160-3542-a307-5ad688729cb1",
                                                "text": "Selling door to door is the best training - and test - for a new salesman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "909967e4-c0db-3d77-9578-3a4cab27b79d",
                                        "entry_id": "103e74b5-76de-334a-bfca-315676f9026f",
                                        "glosses": [
                                            "From ultimate origin to ultimate destination."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f37cbf7-a629-428a-931f-72691072ca59",
                                                "sense_id": "909967e4-c0db-3d77-9578-3a4cab27b79d",
                                                "text": "The trip takes sixteen hours door to door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2984599-7369-3c9c-b9f3-f857146303b2",
                                        "entry_id": "103e74b5-76de-334a-bfca-315676f9026f",
                                        "glosses": [
                                            "From ultimate origin to ultimate destination.",
                                            "From shipper to recipient."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0de93dd4-f855-4af8-a04d-34fcf8b1431d",
                                                "sense_id": "f2984599-7369-3c9c-b9f3-f857146303b2",
                                                "text": "The express company could only handle shipments door to door on the West Coast, needing others to reach the rest of the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75f10bfa-502a-3161-b505-95e8127e6a8a",
                                        "entry_id": "103e74b5-76de-334a-bfca-315676f9026f",
                                        "glosses": [
                                            "From ultimate origin to ultimate destination.",
                                            "From inception to final completion."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "not-comparable"
