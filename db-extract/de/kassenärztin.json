                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e63b219a-543d-4d29-8142-2b73af763aa8",
                                "sense_id": "e2ab769f-bca6-3cef-a8a7-b727dbaf9534",
                                "text": "„Keine einzige Kassenärztin weit und breit, wenn ich eine brauche. Ich meine, wie würde es den Männern dabei gehen, wenn sie wegen Schwanzproblemen einen Urologen aufsuchen wollten, es aber nur Ärztinnen gibt, zu denen sie gehen können?“"
                            }
