                    },
                    {
                        "translation_id": "b85bc434-92bc-4702-8d55-330935b8cbb8",
                        "source_entry_id": "59101436-f6a9-3661-8fc3-6cbec94307dc",
                        "source_sense_id": "3981a45e-51f5-3b0f-89e1-1f73ba1ae357",
                        "target_lang_word": "Fugenelement",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fugenelement",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                        "entry_id": "2a168a21-797b-330c-a28a-88b22cd8242a",
                                        "glosses": [
                                            "eingeschobenes Element zwischen den Bestandteilen (Gliedern) einer Zusammensetzung (Kompositums), wobei der Status als Morphem oder kein Morphem offengelassen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ad1a7a-2a59-4bbf-8a82-3304382d510b",
                                                "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                                "text": "Das „s“ in „Arbeitsamt“ ist ein Fugenelement."
                                            },
                                            {
                                                "example_id": "781231cf-2f1c-4ad3-bd87-c3c875a7bad2",
                                                "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                                "text": "Der Begriff Fugenelement lässt offen, ob es sich bei diesen Wortbestandteilen um Morpheme handelt oder nicht."
                                            },
                                            {
                                                "example_id": "4b383d2b-29f8-4583-83a0-768fb6255a8a",
                                                "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                                "text": "„Allerdings ist das Fugenelement, einmal gesetzt, in den meisten Fällen verbindlich.“"
                                            },
                                            {
                                                "example_id": "ccf20722-f175-430f-a712-149190dc7f4a",
                                                "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                                "text": "„Bei der Komposition kann es vorkommen, daß zwischen den beiden Teilen ein besonderes Element, das Fugenelement, eingeschoben wird (…).“"
                                            },
                                            {
                                                "example_id": "e381c12f-08dc-4172-a272-d05974f24295",
                                                "sense_id": "85ae463e-b537-331d-9a12-bc77f5a4ec87",
                                                "text": "„Diese Varianten treten auf, weil es keine, wenngleich oft gewünschten, Regeln für die Verwendung der Fugenelemente gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f389236-f533-45e2-818f-4258439d2c22",
