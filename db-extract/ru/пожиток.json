                "senses": [
                    {
                        "sense_id": "a109501f-08a9-3c32-8f6b-d8bef8d35358",
                        "entry_id": "85e11d69-66da-3d2f-8521-abf2f8720aa4",
                        "glosses": [
                            "Effet personnel, affaires personnelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fce37c17-5346-4cae-9e3f-68296a9bd49f",
                                "sense_id": "a109501f-08a9-3c32-8f6b-d8bef8d35358",
                                "text": "Раз Ермилыч раскрыл свой сундучок, содержавшийся в величайшем порядке, и что-то перебирал из своих пожиток.",
                                "translation": "Ermilych ouvrit son coffre, qui était tenu dans le plus grand ordre, et se mit à trier quelque chose dans ses affaires."
                            },
                            {
                                "example_id": "c265fdfc-66f3-4589-846f-249787a95798",
                                "sense_id": "a109501f-08a9-3c32-8f6b-d8bef8d35358",
                                "text": "Ты их лелеял на соломе\nИ только применять их мог\nКо псу, который в жалком доме\nПожитки жалкие стерег.",
                                "translation": "[…] où étaient gardées ses pitoyables affaires."
                            }
                        ]
                    }
