                        ]
                    },
                    {
                        "translation_id": "8c8bbc6b-eb17-4438-9103-c283a3ce43ee",
                        "source_entry_id": "5fd55ef4-d6f9-36f5-822b-6c815b9a1a57",
                        "source_sense_id": "e6857701-9009-3a5b-b627-4abde86770d3",
                        "source_sense_description": "veraltet: sich heftig und schnell hin und her bewegen",
                        "target_lang_word": "zappeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zappeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6427d3f7-2b8d-38b7-995d-f3fc23edd629",
                                        "entry_id": "3e7954b9-1eed-3b0f-99fc-e123df178db9",
                                        "glosses": [
                                            "sich heftig und schnell hin und her bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc63786d-5ee5-4fa6-b277-edb577e9ec40",
                                                "sense_id": "6427d3f7-2b8d-38b7-995d-f3fc23edd629",
                                                "text": "Endlich zappelte ein Fisch an der Angel."
                                            },
                                            {
                                                "example_id": "ec9f132b-4849-4a41-8b76-cd7518e68a12",
                                                "sense_id": "6427d3f7-2b8d-38b7-995d-f3fc23edd629",
                                                "text": "Zappel nicht so, wenn du mit uns am Tisch sitzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "61ed115f-2313-3777-b690-bdee56579dd4",
                                        "entry_id": "3e7954b9-1eed-3b0f-99fc-e123df178db9",
                                        "glosses": [
                                            "bewegen (lassen) der Dämpfer beim Klavier, wenn man ihre Funktion durch kleine wackelnde Pedalbewegungen überprüft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e26c2792-ad8a-44bc-8da5-e97f31a16d96",
                                                "sense_id": "61ed115f-2313-3777-b690-bdee56579dd4",
                                                "text": "„Nur eine Dämpfung die perfekt zappelt, läßt die Möglichkeiten des Halb-Pedal Spiels optimal zu.“"
                                            },
                                            {
                                                "example_id": "0a331507-a017-4da1-abfb-da6cfeb3e7f4",
                                                "sense_id": "61ed115f-2313-3777-b690-bdee56579dd4",
                                                "text": "„Nach dem Kröpfen der Drähte und Zappeln der Püppchen auf der Leiste leime ich die Dämpfer mit Warmleim ein.“"
                                            },
                                            {
                                                "example_id": "bc25e8e7-2eb2-4d3e-94e3-18662a43f443",
                                                "sense_id": "61ed115f-2313-3777-b690-bdee56579dd4",
                                                "text": "„Dämpfer werden eingesetzt, gerichtet und das gleichzeitige Abheben (Zappeln) bei getretenem Pedal wird eingestellt“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
