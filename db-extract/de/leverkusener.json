                        "entry_id": "eb37831f-0137-3b2d-9908-51526055c913",
                        "glosses": [
                            "Person, die in Leverkusen lebt oder dort geboren ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd3b26f8-6722-4c93-a96e-a1fa454781ab",
                                "sense_id": "c1391403-b598-3b65-ad87-1aa589d7341b",
                                "text": "In Baden-Baden traf ich letzten Mittwoch zwei Leverkusener."
                            },
                            {
                                "example_id": "77ca05c2-378d-4867-b83f-8a0c131d7498",
                                "sense_id": "c1391403-b598-3b65-ad87-1aa589d7341b",
                                "text": "„Ehe der gebürtige Leverkusener von Wien aus Kunst, Blutplasma, Sachertorten und wichtige Dokumente zu den Adressaten beförderte, hatte der gelernte Speditionskaufmann selbst ein bewegtes Leben geführt: zehn Jahre bei einem internationalen Kunsttransport, anschließend Auslandstätigkeit als Geschäftsführer und Repräsentant in Luxemburg, Saudi-Arabien und Ägypten.“"
                            },
                            {
                                "example_id": "a8a3ac7c-94a2-47a8-9b28-edfe94bfaea0",
                                "sense_id": "c1391403-b598-3b65-ad87-1aa589d7341b",
                                "text": "„In der Nachspielzeit der ersten Halbzeit erzielte Miguel Samudio (45.+1) den dritten Treffer der Gäste, der eingewechselte Leverkusener Lars Bender (75.) setzte den Schlusspunkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
