                "senses": [
                    {
                        "sense_id": "cedbd932-756a-3203-8eff-2ca942de2440",
                        "entry_id": "c1a4309b-b12d-38b2-8d67-d3cce67e0f16",
                        "glosses": [
                            "durch elektrische Stromstöße erzeugter künstlicher Schock zur Behandlung bestimmter Psychosen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acc47c24-766d-4cd1-8bee-7a6b0457fd90",
                                "sense_id": "cedbd932-756a-3203-8eff-2ca942de2440",
                                "text": "„Neben Gruppen- und Psychotherapie, letztere bei 29 Fällen über ein Jahr lang durchgeführt, erhielten 15 Pat. eine Elektroplexie, 4 eine Insulinbehandlung, 19 die verschiedensten Medikamente, meist Tranquilizer."
                            },
                            {
                                "example_id": "00e63c5b-1286-433a-a66c-b4a1b2f04618",
                                "sense_id": "cedbd932-756a-3203-8eff-2ca942de2440",
                                "text": "„Bei akut erregten oder schwerst depressiven Kranken mit Selbstmordabsichten werden neuzeitliche Behandlungsmaßnahmen, wie gehäufte Elektroplexie, Dauernarkose usw., vom Tage der Aufnahme an angewandt […].“"
                            },
                            {
                                "example_id": "fdc2fe0e-372a-477d-81e4-bc9596b802e9",
                                "sense_id": "cedbd932-756a-3203-8eff-2ca942de2440",
                                "text": "„Der an sich glückliche englische Terminus “ Elektroplexie ” hat sich leider nicht einbürgern können. Andernfalls wäre vielleicht manches ängstliche Vorurteil gegenüber der Elektrokrampf behandlung in der Öffentlichkeit nie aufgekommen.“"
                            },
                            {
                                "example_id": "fb0c6075-2155-4cd5-9332-ae0a489bfcc5",
                                "sense_id": "cedbd932-756a-3203-8eff-2ca942de2440",
                                "text": "»Elektroplexie.« Norma schwenkte so abrupt zur Standardaussprache, dass es Helen wie ein Schock traf. »Elektrokonvulsionstherapie. EKT.« Sie lächelte stolz. »Das stimmt«, sagte Pauline zerstreut und schaute wieder zu Helen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
