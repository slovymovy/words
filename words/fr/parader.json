                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il aime <w>parader</w> dans sa nouvelle voiture dès que le soleil apparaît."
                        },
                        {
                            "text": "Au lieu d'aider ses collègues, il <w>paradait</w> fièrement dans les couloirs du bureau."
                        }
                    ],
                    "synonyms": [
                        "se pavaner",
                        "frimer"
                    ],
                    "common_phrases": [
