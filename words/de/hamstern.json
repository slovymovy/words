                    "frequency": "Middle",
                    "semantic_group_id": "horten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aus Angst vor Engpässen begannen viele Menschen, Mehl und Öl zu <w>hamstern</w>."
                        },
                        {
                            "text": "Experten raten dazu, ruhig zu bleiben und keine Vorräte zu <w>hamstern</w>."
                        }
                    ],
                    "synonyms": [
