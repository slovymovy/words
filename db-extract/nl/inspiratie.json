        "nl-extract.jsonl": [
            {
                "entry_id": "286f9b41-2218-3591-8529-3aa420b0d6ff",
                "word": "inspiratie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8199faaa-d3bd-4281-8b1e-dc6bd542119b",
                        "entry_id": "286f9b41-2218-3591-8529-3aa420b0d6ff",
                        "tags": [
                            "plural"
                        ],
                        "form": "inspiraties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4cda364c-b857-3ac0-988d-2efd3074917d",
                        "entry_id": "286f9b41-2218-3591-8529-3aa420b0d6ff",
                        "glosses": [
                            "een gevoel over hoe men iets kan aanpakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4afce8cf-7d0f-4186-aeaa-f3d3600a31e6",
                                "sense_id": "4cda364c-b857-3ac0-988d-2efd3074917d",
                                "text": "Hij kreeg inspiratie door naar een museum te gaan."
                            },
                            {
                                "example_id": "24b4e13c-6977-4d4a-b6b4-413d65221775",
                                "sense_id": "4cda364c-b857-3ac0-988d-2efd3074917d",
                                "text": "In de Nederlandse culinaire wereld wordt geschokt gereageerd op het onverwachtse overlijden van topchef Jonnie Boer, op 60-jarige leeftijd. Veel jonge koks met wie hij werkte, hebben nu hun eigen bekende restaurants. Voor hen was hij een grote inspiratie."
                            },
                            {
                                "example_id": "8e726c49-3a73-4c12-997d-7cac6923a013",
                                "sense_id": "4cda364c-b857-3ac0-988d-2efd3074917d",
                                "text": "\"Ze was voor veel mensen een inspiratie, haar muziek en stem hebben zo veel harten geraakt\", vertelt Van Wegberg."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d8bdadc-853f-33c2-be6f-0fa10a486c68",
                        "entry_id": "286f9b41-2218-3591-8529-3aa420b0d6ff",
                        "glosses": [
                            "inademing"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9693d378-e2f0-474f-ade8-ffe1ac88e710",
                        "source_entry_id": "286f9b41-2218-3591-8529-3aa420b0d6ff",
                        "source_sense_id": "4cda364c-b857-3ac0-988d-2efd3074917d",
                        "source_sense_description": "een gevoel over hoe men een klus kan aanpakken",
                        "target_lang_word": "inspiration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inspiration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58b45bb4-19ef-3cd3-9af0-03c727e4fd8b",
                                        "entry_id": "461bc126-1ece-379c-a311-d4efc2883f8f",
                                        "glosses": [
                                            "The drawing of air into the lungs, accomplished in mammals by elevation of the chest walls and flattening of the diaphragm, as part of the act of breathing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5937d2d-6c42-4ae0-8f9d-5fac35ee532e",
                                                "sense_id": "58b45bb4-19ef-3cd3-9af0-03c727e4fd8b",
                                                "text": "Holonym: respiration"
                                            },
                                            {
                                                "example_id": "a660f5c7-c86a-43e9-87a7-d2ed9b79b7f3",
                                                "sense_id": "58b45bb4-19ef-3cd3-9af0-03c727e4fd8b",
                                                "text": "The respiratory movements are no longer normal and rhythmic acts of inspiration and exspiration, but abnormal and irregular expiratory movements"
                                            },
                                            {
                                                "example_id": "c2d2830a-b6d3-48f7-95d9-a570d027958c",
                                                "sense_id": "58b45bb4-19ef-3cd3-9af0-03c727e4fd8b",
                                                "text": "If a reaction involves increased muscle tonus and too much inspiration, muscle relaxation and exhalation exercises might be of use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb503bc-89ef-3808-9a0a-434d82f12115",
                                        "entry_id": "461bc126-1ece-379c-a311-d4efc2883f8f",
                                        "glosses": [
                                            "A single inward breath (intake of air)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "015da839-1dbc-4dfa-89c5-4f8571171491",
                                                "sense_id": "deb503bc-89ef-3808-9a0a-434d82f12115",
                                                "text": "Laughing is produced by an inspiration succeeded by a succession of short imperfect expirations."
                                            },
                                            {
                                                "example_id": "db669abf-c072-4eff-b90d-c73537d22b4d",
                                                "sense_id": "deb503bc-89ef-3808-9a0a-434d82f12115",
                                                "text": "One of them had a temperature of 40° cent. 104° Fahr. and 97 inspirations per minute."
                                            },
                                            {
                                                "example_id": "49da1b9d-719f-4298-b472-b78d8a687b52",
                                                "sense_id": "deb503bc-89ef-3808-9a0a-434d82f12115",
                                                "text": "On physical examination, blood pressure was 145/70 mm Hg, pulse was 108 beats per minute, respiratory rate was 36 inspirations per minute, body temperature was 38 ºC and her oxygen saturation (during nasal oxygen intake) was 93%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa06e0d7-9959-371d-927d-3dca17bb836a",
                                        "entry_id": "461bc126-1ece-379c-a311-d4efc2883f8f",
                                        "glosses": [
                                            "A supernatural divine influence on the prophets, apostles, or sacred writers, by which they were qualified to communicate moral or religious truth with authority; a supernatural influence which qualifies people to receive and communicate divine truth; also, the truth communicated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f11dcffb-7f1e-4c00-9e6b-d555bba10d07",
                                                "sense_id": "fa06e0d7-9959-371d-927d-3dca17bb836a",
                                                "text": "The question, therefore, at issue is, not whether those external means be sufficient without grace and divine inspiration, for none pretends that\": but, in order to hinder men from feigning or imagining an inspiration, whether it has not been God's economy, and his usual conduct to make his inspiration walk hand in hand with certain means of fact, which men can neither feign in the air without being convicted of falsehood, nor imagine without illusion."
                                            },
                                            {
                                                "example_id": "2b7cc5b6-1f77-451c-8620-36045a7d6557",
                                                "sense_id": "fa06e0d7-9959-371d-927d-3dca17bb836a",
                                                "text": "The more strongly people felt about their ideas, the more potent the demons seemed to them: Christians believed that traditional paganism, far from being the work of men, was an 'opium of the masses', pumped into the human race by the non-human demons; and one scholar even ascribed bad reviews of his book to demonic inspiration!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c7d649e-c292-36f6-8b11-afe6f33f8347",
                                        "entry_id": "461bc126-1ece-379c-a311-d4efc2883f8f",
                                        "glosses": [
                                            "The act or process of an elevating or stimulating influence upon the intellect, emotions or creativity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a31a80a-997a-4494-8ce6-6e8d10949678",
                                                "sense_id": "8c7d649e-c292-36f6-8b11-afe6f33f8347",
                                                "text": "She was waiting for inspiration to write a book."
                                            },
                                            {
                                                "example_id": "3e23d656-5332-4b3e-81f2-a97e3ac09a9f",
                                                "sense_id": "8c7d649e-c292-36f6-8b11-afe6f33f8347",
                                                "text": "Usage notes: In this sense, it may be followed by the adposition to in relation to the person being influenced, and for or to in relation to the idea or activity:"
                                            },
                                            {
                                                "example_id": "50afb574-300b-45fa-89a5-d1c905eaecd1",
                                                "sense_id": "8c7d649e-c292-36f6-8b11-afe6f33f8347",
                                                "text": "We caught the inspiration of his joy; and imagination painted a glorious future near at hand for our land, quickly to develop itself under the guidance of his fostering wisdom, and fraternal counsels and care."
                                            },
                                            {
                                                "example_id": "d376bc1d-2c87-4653-a492-ea1eed8923ab",
                                                "sense_id": "8c7d649e-c292-36f6-8b11-afe6f33f8347",
                                                "text": "“Well,” I answered, at first with uncertainty, then with inspiration, “he would do splendidly to lead your cotillon, if you think of having one.” ¶ “So you do not dance, Mr. Crocker?” ¶ I was somewhat set back by her perspicuity."
                                            },
                                            {
                                                "example_id": "df649432-38ed-4fdc-b016-2139f7ce33e0",
                                                "sense_id": "8c7d649e-c292-36f6-8b11-afe6f33f8347",
                                                "text": "All this suggests that Andrea may, like the authors of the devotional panel, the fresco, and the print – and like Leonardo, as we shall see – have found his inspiration in Pollaiuolo."
                                            },
                                            {
                                                "example_id": "6522b037-e9b8-42f2-a044-a33163b3cf37",
                                                "sense_id": "8c7d649e-c292-36f6-8b11-afe6f33f8347",
                                                "text": "And now it is time for problem solving which, if successful, will create new ideas serving as an inspiration source for future research objects of the researcher in question as well as other researchers within the same field."
                                            },
                                            {
                                                "example_id": "195d47b9-8f7b-4d07-bc40-79472ca45968",
                                                "sense_id": "8c7d649e-c292-36f6-8b11-afe6f33f8347",
                                                "text": "As for United, this was a performance lacking in inspiration, purpose and threat and once again underlined the urgency for transfer business to be done in the closing hours of the transfer window."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "417201bc-ff21-3920-b0be-247bdcb2eedb",
                                        "entry_id": "461bc126-1ece-379c-a311-d4efc2883f8f",
                                        "glosses": [
                                            "A person, object, or situation which quickens or stimulates an influence upon the intellect, emotions or creativity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ac7ba5-d0e5-4029-a3ca-45a1a67428c4",
                                                "sense_id": "417201bc-ff21-3920-b0be-247bdcb2eedb",
                                                "text": "The trip was an inspiration to her for writing a book."
                                            },
                                            {
                                                "example_id": "215661de-b39c-48d9-8dc5-4bb30af51eb8",
                                                "sense_id": "417201bc-ff21-3920-b0be-247bdcb2eedb",
                                                "text": "She had grown accustomed to look upon Ethel as Walter's passion and inspiration: it was something far off and distant, which even she felt was sacred; but Lady Marchmont was a new rival, and come too actual, and too near."
                                            },
                                            {
                                                "example_id": "72b95894-e017-4398-9ff5-5fca83953d1a",
                                                "sense_id": "417201bc-ff21-3920-b0be-247bdcb2eedb",
                                                "text": "The people of Ukraine and Georgia are an inspiration to the world, and I was pleased that this week NATO declared that Ukraine and Georgia will become members of NATO."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d77321-b3da-356e-aaf1-55791ecc22d2",
                                        "entry_id": "461bc126-1ece-379c-a311-d4efc2883f8f",
                                        "glosses": [
                                            "A new idea, especially one which arises suddenly and is clever or creative."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccf49dd3-8827-4108-aae9-42aabf2c793f",
                                                "sense_id": "23d77321-b3da-356e-aaf1-55791ecc22d2",
                                                "text": "After an interval the Psychologist had an inspiration. \"It must have gone into the past if it has gone anywhere,\" he said."
                                            },
                                            {
                                                "example_id": "af1f40ef-9595-4a13-892c-baf6a66f6899",
                                                "sense_id": "23d77321-b3da-356e-aaf1-55791ecc22d2",
                                                "text": "Mrs. Balfame had an inspiration. \"My God!\" she exclaimed, springing to her feet, \"the murderer . . . was hidden in the cellar or attic all night, all the next day! He may be here yet!\""
                                            },
                                            {
                                                "example_id": "a57ae74e-4907-4894-94ce-09c363140765",
                                                "sense_id": "23d77321-b3da-356e-aaf1-55791ecc22d2",
                                                "text": "The weekend inventor has five U.S. patents and three more pending for inspirations such as a kickable Frisbee, a clothes-ironing mitt and a leak-proof shower curtain."
                                            },
                                            {
                                                "example_id": "b13badb3-c013-4cf6-99d9-2e272fcc517a",
                                                "sense_id": "23d77321-b3da-356e-aaf1-55791ecc22d2",
                                                "text": "[H]e accompanied her to a rehearsal of a skit satirizing “Casablanca,” and the director had an inspiration: Wouldn’t it be a laugh to cast a 10-year-old as Rick?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
