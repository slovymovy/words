                        "glosses": [
                            "organisatie die reizigers informeert, meestal met het doel meer bezoekers naar een land, streek of plaats te trekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3127ba9-01ab-4f4d-9bad-478d5efb6677",
                                "sense_id": "c8df87bb-d20d-3a86-bd6f-4dbbbc1dc673",
                                "text": "Een paar dagen weg met een jong kind, het is een trend, volgens Agnes van Duffelen, eigenaar van een pr-bedrijf voor de toeristische sector. „Ook verkeersbureaus zien dit”, zegt ze."
                            },
                            {
                                "example_id": "a3eacaaa-4c2b-4972-b5a2-d6eeaabe2bb7",
                                "sense_id": "c8df87bb-d20d-3a86-bd6f-4dbbbc1dc673",
                                "text": "Door het nationale verkeersbureau liet hij zich vorig jaar inschakelen als ‘toeristisch en culinair ambassadeur voor Spanje’."
                            }
                        ]
                    },
                    {
                        "sense_id": "79759b56-36c4-338b-8ecf-4f3c8d0c916f",
                        "entry_id": "1e13b5fe-a9a3-3897-aca9-2a42c277cd3e",
                        "glosses": [
                            "onderneming die adviezen uitbrengt over mogelijkheden om de veiligheid of doorstroming van wegvervoer te verbeteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d42831a-357d-4134-89eb-2e6cf5508f8b",
                                "sense_id": "79759b56-36c4-338b-8ecf-4f3c8d0c916f",
                                "text": "De meeste klappen – een verkeersbureau telde er 79 in de afgelopen vijf jaar – leiden tot verwondingen of blikschade, maar dit jaar vielen er ook drie doden kort na elkaar."
                            },
                            {
                                "example_id": "6bc60cc2-f69c-4ee0-9d5a-92ce0fa84e9c",
                                "sense_id": "79759b56-36c4-338b-8ecf-4f3c8d0c916f",
                                "text": "Om verdere opstoppingen en files op de S100 in Nijmegen te voorkomen, zijn extra maatregelen nodig, blijkt uit onderzoek van verkeersbureau Goudappel Coffeng."
                            }
                        ]
                    }
