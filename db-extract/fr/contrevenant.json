                ],
                "senses": [
                    {
                        "sense_id": "3173df24-dbc4-3916-b470-c96805425332",
                        "entry_id": "968efb1e-91f6-35eb-a57a-3e1c940f3468",
                        "glosses": [
                            "Celui qui contrevient, qui agit contre l’ordre établi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "914c685a-8224-4066-8e6d-234fc22323b0",
                                "sense_id": "3173df24-dbc4-3916-b470-c96805425332",
                                "text": "Les contrevenants aux lois du servage et les criminels encouraient de sévères punitions : de 100 à 1000 coups de fouet, selon l’offense ; amputation de main, de jambe ou des yeux pour les crimes les plus graves."
                            },
                            {
                                "example_id": "c55e0f8d-9159-4db7-8a2f-88e5a6ce0895",
                                "sense_id": "3173df24-dbc4-3916-b470-c96805425332",
                                "text": "Si les prisons sont remplies, c’est par les contrevenants à l’article 19, autrement dit par les immigrés clandestins ; nous ne parlons pas d’immigrés clandestins qui auraient « fait quelque chose », mais d’individus arrêtés et jugés pour la seule infraction à la police des étrangers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b94221a7-d332-45c6-8069-78ce5b198eee",
                        "source_entry_id": "968efb1e-91f6-35eb-a57a-3e1c940f3468",
                        "source_sense_id": "3173df24-dbc4-3916-b470-c96805425332",
