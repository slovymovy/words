                                                "example_id": "d5311cd7-ab39-404d-a3de-73cd92b8aa9d",
                                                "sense_id": "0884773d-6edb-3f4e-ab1b-f6029a3021ff",
                                                "text": "He was arrested for driving drunk."
                                            }
