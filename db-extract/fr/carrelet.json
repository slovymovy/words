                ],
                "senses": [
                    {
                        "sense_id": "612d85b7-277e-3db9-8fbc-b7f8ea32e2ed",
                        "entry_id": "4b4f04b5-427c-3ce9-81fb-9cf6862fb6a4",
                        "glosses": [
                            "Poisson de mer qui est plat et qui a de petites taches, la plie commune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ff84a7-67dc-43db-a588-7df20e3832bf",
                                "sense_id": "612d85b7-277e-3db9-8fbc-b7f8ea32e2ed",
                                "text": "Pêle-mêle, au hasard du coup de filet, les algues profondes, où dort la vie mystérieuse des grandes eaux, avaient tout livré : les cabillauds, les aigrefins, les carrelets, les plies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f6d411a-9573-4517-86cd-6c125a12c0c6",
                        "source_entry_id": "4b4f04b5-427c-3ce9-81fb-9cf6862fb6a4",
                        "source_sense_id": "612d85b7-277e-3db9-8fbc-b7f8ea32e2ed",
                        "target_lang_word": "Scholle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scholle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a20ceb9-f95e-3da1-9c60-5bf572c6f435",
                                        "entry_id": "6fb4c185-3f8b-346b-a62d-95123a20a871",
                                        "glosses": [
                                            "in allen Meeren verbreiteter, oft als Speisefisch genutzter Plattfisch mit stark abgeplattetem ovalem Körper, der an der Oberseite olivgrün bis dunkelbraun gefleckt und an der Unterseite weiß ist"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6711e584-edf2-4823-aa59-26d477903363",
                                                "sense_id": "3a20ceb9-f95e-3da1-9c60-5bf572c6f435",
                                                "text": "Die Scholle ist ein beliebter Speisefisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3384d169-7188-3580-b5a0-c037c17d2dfc",
                                        "entry_id": "6fb4c185-3f8b-346b-a62d-95123a20a871",
                                        "glosses": [
                                            "Erdklumpen, wie er beim Pflügen und Umgraben entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac728aa2-785e-4bdb-8734-ca20d0e46a17",
                                                "sense_id": "3384d169-7188-3580-b5a0-c037c17d2dfc",
                                                "text": "Man lässt die Schollen über Winter liegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b4b9757a-2876-3e81-997f-8a95a45c14bd",
                                        "entry_id": "6fb4c185-3f8b-346b-a62d-95123a20a871",
                                        "glosses": [
                                            "Bauernhof, Stück Land"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "105a97c2-5a74-4f56-b0d9-10f59f96bda3",
                                                "sense_id": "b4b9757a-2876-3e81-997f-8a95a45c14bd",
                                                "text": "„Erst 1906, nach der Revolution, bei der zahlreiche Bauern die Gutshäuser plünderten und in Brand steckten, erhielten Bauern das Recht, ihre Scholle zu verkaufen und endgültig in die Stadt zu ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "de1c90a2-06ac-3da1-ac7f-930abc189236",
                                        "entry_id": "6fb4c185-3f8b-346b-a62d-95123a20a871",
                                        "glosses": [
                                            "ein ebenes Stück Treibeis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b70552-1c31-4e36-a5d0-5a67c3042e05",
                                                "sense_id": "de1c90a2-06ac-3da1-ac7f-930abc189236",
                                                "text": "Der See taut langsam auf, man sieht nur noch einzelne Schollen herumschwimmen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "25194a91-e596-308d-a01a-c6f7fbf543e0",
                                        "entry_id": "6fb4c185-3f8b-346b-a62d-95123a20a871",
                                        "glosses": [
                                            "Ein Teil der Erdkruste, der durch tektonische Störungen von anderen getrennt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "795de626-9469-4305-a7c8-d7c892a67f77",
                                                "sense_id": "25194a91-e596-308d-a01a-c6f7fbf543e0",
                                                "text": "Wenn sich eine Scholle durch eine Verwerfung über eine benachbarte hebt, spricht man von einem Horst."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
