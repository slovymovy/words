{
    "word_family": [
        "mushrooming"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "638b0377-bc8e-343a-b6f4-0fbf0bac3edf",
                    "sense_definition": "The fleshy fruiting body of a fungus, typically appearing above ground and often used as food.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fungi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I added some sliced <w>mushrooms</w> to the pizza for extra flavor.",
                            "target_lang_translations": {
                                "ru": "Я добавил в пиццу немного нарезанных <w>грибов</w> для дополнительного вкуса."
                            }
                        },
                        {
                            "text": "Be careful when picking a <w>wild</w> <w>mushroom</w> because some species are very poisonous.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны при сборе <w>дикорастущих</w> <w>грибов</w>, так как некоторые виды очень ядовиты."
                            }
                        }
                    ],
                    "synonyms": [
                        "shroom"
                    ],
                    "common_phrases": [
                        "wild mushroom",
                        "mushroom soup",
                        "button mushroom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мясистое плодовое тело гриба, обычно появляющееся над землей и часто используемое в пищу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гриб",
                                "target_lang_sense_clarification": "плодовое тело"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d59e1bc-6de2-31d9-9726-b97d6b5c55f6",
                    "sense_definition": "Something that grows very quickly or appears suddenly, like the growth of a fungus.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rapid_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new tech startups were <w>overnight</w> <w>mushrooms</w> that appeared throughout the city.",
                            "target_lang_translations": {
                                "ru": "Новые технологические стартапы были <w>грибами-однодневками</w>, появившимися по всему городу."
                            }
                        },
                        {
                            "text": "The sudden craze for the new toy led to several <w>mushrooms</w> of imitation brands.",
                            "target_lang_translations": {
                                "ru": "Внезапное увлечение новой игрушкой привело к <w>быстрому появлению</w> нескольких брендов-имитаций."
                            }
                        }
                    ],
                    "common_phrases": [
                        "overnight mushroom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что растет очень быстро или появляется внезапно, подобно росту гриба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гриб",
                                "target_lang_sense_clarification": "о чем-то быстрорастущем"
                            },
                            {
                                "target_lang_word": "скороспелка",
                                "target_lang_sense_clarification": "о чем-то внезапно появившемся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f56ea4a3-d9ff-3ecb-8649-9d0166c157d0",
                    "sense_definition": "A person who has suddenly risen to a higher social or financial position; an upstart.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old aristocracy looked down on the new wealthy families as mere <w>mushrooms</w>.",
                            "target_lang_translations": {
                                "ru": "Старая аристократия смотрела на новые богатые семьи как на обычных <w>выскочек</w>."
                            }
                        },
                        {
                            "text": "He was considered a <w>mushroom</w> by his peers after his sudden success in the stock market.",
                            "target_lang_translations": {
                                "ru": "Сверстники считали его <w>выскочкой</w> после его внезапного успеха на фондовом рынке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used to describe social climbers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который внезапно поднялся до высокого социального или финансового положения; выскочка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выскочка",
                                "target_lang_sense_clarification": "человек, быстро добившийся успеха"
                            },
                            {
                                "target_lang_word": "нувориш",
                                "target_lang_sense_clarification": "быстро разбогатевший человек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "423a036d-8168-3384-8f30-9a8197b4e49d",
                    "sense_definition": "To grow or increase very quickly in size, number, or importance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rapid_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small village <w>mushroomed</w> into a large city within just a few decades.",
                            "target_lang_translations": {
                                "ru": "Маленькая деревня <w>разрослась</w> в большой город всего за несколько десятилетий."
                            }
                        },
                        {
                            "text": "Public interest in renewable energy has <w>mushroomed</w> in recent years.",
                            "target_lang_translations": {
                                "ru": "Интерес общественности к возобновляемым источникам энергии <w>стремительно вырос</w> в последние годы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mushroomed into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень быстро расти или увеличиваться в размере, количестве или значимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расти как грибы",
                                "target_lang_sense_clarification": "быстро появляться или увеличиваться"
                            },
                            {
                                "target_lang_word": "стремительно разрастаться",
                                "target_lang_sense_clarification": "о росте организации или города"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afec17f4-2a28-3574-89f3-5aa53e25b8de",
                    "sense_definition": "To go out and gather wild mushrooms.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every autumn, the family would <w>go</w> <w>mushrooming</w> in the nearby forest.",
                            "target_lang_translations": {
                                "ru": "Каждую осень семья <w>ходила за грибами</w> в близлежащий лес."
                            }
                        },
                        {
                            "text": "They spent the whole morning <w>mushrooming</w> but only found a few edible ones.",
                            "target_lang_translations": {
                                "ru": "Они все утро <w>собирали грибы</w>, но нашли лишь несколько съедобных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go mushrooming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ходить в лес и собирать дикорастущие грибы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать грибы",
                                "target_lang_sense_clarification": "процесс сбора"
                            },
                            {
                                "target_lang_word": "ходить по грибы",
                                "target_lang_sense_clarification": "отправляться в лес за грибами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91faa2e2-2221-3e3c-9ef7-c2eaab196282",
                    "sense_definition": "To flatten or spread out at the end, taking on the shape of a mushroom.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tip of the metal rod began to <w>mushroom</w> under the heavy pressure.",
                            "target_lang_translations": {
                                "ru": "Кончик металлического стержня начал <w>расплющиваться</w> под сильным давлением."
                            }
                        },
                        {
                            "text": "The bullet is designed to <w>mushroom</w> upon impact to cause maximum damage.",
                            "target_lang_translations": {
                                "ru": "Пуля сконструирована так, чтобы <w>деформироваться</w> при ударе для нанесения максимального урона."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "describes physical deformation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сплющиваться или расширяться на конце, принимая форму гриба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расплющиваться",
                                "target_lang_sense_clarification": "принимать форму шляпки"
                            },
                            {
                                "target_lang_word": "деформироваться",
                                "target_lang_sense_clarification": "о металле или пуле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5a5e3b5a-6b6f-3873-abe7-bb13b7f15df9",
                    "sense_definition": "Resembling a mushroom in shape, appearance, or speed of growth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explosion created a massive <w>mushroom</w> cloud that could be seen for miles.",
                            "target_lang_translations": {
                                "ru": "Взрыв создал массивное <w>грибовидное</w> облако, которое было видно за много миль."
                            }
                        },
                        {
                            "text": "The designer chose a <w>mushroom</w> shape for the new lampshade.",
                            "target_lang_translations": {
                                "ru": "Дизайнер выбрал форму <w>гриба</w> для нового абажура."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mushroom cloud",
                        "mushroom shape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий гриб по форме, внешнему виду или скорости роста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грибовидный",
                                "target_lang_sense_clarification": "имеющий форму гриба"
                            },
                            {
                                "target_lang_word": "грибной",
                                "target_lang_sense_clarification": "относящийся к грибам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}