                            {
                                "example_id": "ddbe3ea6-e8e8-40fc-8a45-c69532dc019f",
                                "sense_id": "9f1f6eb4-d72e-3a85-87c2-6f2689548cb3",
                                "text": "„Claude drehte sein Whiskeyglas zwischen den Handflächen und sagte, das Äußerste, was er erreichen könne, sei ein Schwarzflug mit einer C-130.“"
                            },
                            {
                                "example_id": "1befeecd-75c7-4968-a4f5-60fa0a0c0d18",
                                "sense_id": "9f1f6eb4-d72e-3a85-87c2-6f2689548cb3",
                                "text": "„Wilson verzichtete darauf, den Besucher nach seinem Getränkewunsch zu fragen, und griff zielstrebig nach zwei Whiskeygläsern.“"
                            }
                        ],
