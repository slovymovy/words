                                        "glosses": [
                                            "An opinion, stand, or stance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2815692b-8960-4964-9c9c-c322add3ef86",
                                                "sense_id": "d44071e7-dc2b-3f61-ab0a-1114f3f3724c",
                                                "text": "My position on this issue is unchanged."
