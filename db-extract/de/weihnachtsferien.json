                "senses": [
                    {
                        "sense_id": "f87d7152-f1da-3fdb-9e7b-6177fc6e38b2",
                        "entry_id": "360a2712-b981-36ef-bec2-37f080c06d5b",
                        "glosses": [
                            "zusammenhängende unterrichtsfreie Tage um Weihnachten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "821f9343-3368-40af-94b1-8562af2958e6",
                                "sense_id": "f87d7152-f1da-3fdb-9e7b-6177fc6e38b2",
                                "text": "In den Weihnachtsferien fahren wir zum Skifahren in die Alpen."
                            },
                            {
                                "example_id": "f137bf43-cf0e-4e05-b034-dc4847a2626f",
                                "sense_id": "f87d7152-f1da-3fdb-9e7b-6177fc6e38b2",
                                "text": "„So auch in den Weihnachtsferien des Jahres 1964, als die Temperaturen tief in den Keller gerutscht waren.“"
                            },
                            {
                                "example_id": "ad9f7afd-95ef-4d3f-8932-bbbca674e9ef",
                                "sense_id": "f87d7152-f1da-3fdb-9e7b-6177fc6e38b2",
                                "text": "„Am Tag bevor die Schüler in die kurzen Weihnachtsferien fuhren, hatten der erste Helfer und Schüler der Oberklasse im Wald eine besondere Tanne mit weißen Kerzen bestückt.“"
                            },
                            {
                                "example_id": "e60afdf8-0dd2-49a5-a01e-a102d656fb14",
                                "sense_id": "f87d7152-f1da-3fdb-9e7b-6177fc6e38b2",
                                "text": "„Als die Weihnachtsferien vorüber waren, stand er zum ersten Mal wieder auf.“"
                            },
                            {
                                "example_id": "150d2425-fb4e-45ba-8a3c-9cee152a4385",
                                "sense_id": "f87d7152-f1da-3fdb-9e7b-6177fc6e38b2",
                                "text": "„Er war inzwischen drei Jahre alt, seit Weihnachten, und Ari hatte ihn schon lange nicht mehr gesehen, noch nicht einmal in den Weihnachtsferien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
