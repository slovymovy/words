                                        "entry_id": "61dc432e-328a-3ddc-b019-4ed26f3ce488",
                                        "glosses": [
                                            "(najczęściej szybko) zmieniająca się sytuacja, przechodząca przy tym od skrajności w skrajność"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b7c59b1-73bf-4683-ba9b-3403c2e9fec0",
                                                "sense_id": "d5441b70-2c9a-3e21-91b5-d450597daf91",
                                                "text": "Popularność to sinusoida – raz jest się wysoko, a później się bywa zapomnianym"
                                            },
                                            {
                                                "example_id": "d4b32596-6b14-4fac-8830-d02e3acc08e6",
                                                "sense_id": "d5441b70-2c9a-3e21-91b5-d450597daf91",
                                                "text": "Kiedy 11 września 2001 r. Al-Kaida zaatakowała Stany Zjednoczone, sinusoida historii była już gotowa do zwrotu"
                                            }
