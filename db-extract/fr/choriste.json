        "fr-extract.jsonl": [
            {
                "entry_id": "108689c5-d3ee-356d-ba77-487cdf58a908",
                "word": "choriste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5fd4e0ff-2b03-4ee7-924b-1bf929f838ae",
                        "entry_id": "108689c5-d3ee-356d-ba77-487cdf58a908",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "choristes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                        "entry_id": "108689c5-d3ee-356d-ba77-487cdf58a908",
                        "glosses": [
                            "Chantre du chœur dans une église, chanteur dans une chorale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9823021-f286-4e3a-96da-367fa865a02b",
                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                "text": "Les heures comprennent surtout des psaumes et elles sont chantées au chœur dans le texte latin. Les choristes de l'Hôtel-Dieu de Québec se rendaient donc plusieurs fois par jour au chœur pour psalmodier."
                            },
                            {
                                "example_id": "e4fc7b27-805d-40bf-aef4-90eb318496e8",
                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                "text": "J’étais heureux pour Martine, petite choriste anonyme, dont personne ne connaîtrait jamais le nom, mais pourtant saluée chaque soir, applaudie, pour la portion de poésie qu’elle avait apportée à l’œuvre."
                            },
                            {
                                "example_id": "7e5b1491-ccbe-4189-9926-33df52e284f2",
                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                "text": "La maison de production fournissait les choristes et les musiciens, suggérait fortement les chansons, déterminait les arrangements, et quelques choubidous plus tard, Françoise Deldick, Agnès Loti, Michèle et ses Wouaps sortaient de l'ombre."
                            },
                            {
                                "example_id": "3386e23d-daad-4487-b71e-a961f4016076",
                                "sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                                "text": "Le moindre choriste dans un chœur chantant une Passion de Bach m'a toujours semblé pouvoir aller plus loin que moi dans mon travail de savant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74629d7b-99fa-458f-8b11-dccbe0645e15",
                        "source_entry_id": "108689c5-d3ee-356d-ba77-487cdf58a908",
                        "source_sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                        "target_lang_word": "Chorsänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chorsänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27319404-4de4-3fda-bb06-f75388ff110f",
                                        "entry_id": "d4eaf27c-a3a1-3359-9dbb-a2714db3b0a6",
                                        "glosses": [
                                            "(männliche^☆) Person, die in einem Chor singt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6c24755-3313-4ae0-ba3c-6cb3fb13f194",
                                                "sense_id": "27319404-4de4-3fda-bb06-f75388ff110f",
                                                "text": "„Einige Chorsänger hätten erklärt, sie würden \"nicht singen\", sollte das Problem nicht gelöst werden.“"
                                            },
                                            {
                                                "example_id": "1f940222-9aad-48ae-89f8-81391d9372ae",
                                                "sense_id": "27319404-4de4-3fda-bb06-f75388ff110f",
                                                "text": "„Das war anders, als sie selbst in Salzburg als Tochter zweier Chorsänger aufwuchs.“"
                                            },
                                            {
                                                "example_id": "fe830647-0964-4725-a90b-3916cf802234",
                                                "sense_id": "27319404-4de4-3fda-bb06-f75388ff110f",
                                                "text": "„Es war nicht für die einfachen Gläubigen bestimmt, von denen die meisten es ohnehin weder hätten bezahlen noch benutzen können, sondern für Chorsänger und Kantoren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c30fae2-3b80-4045-82cf-4197f7a5737c",
                        "source_entry_id": "108689c5-d3ee-356d-ba77-487cdf58a908",
                        "source_sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
                        "target_lang_word": "Chorsängerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chorsängerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76a99d13-bf4a-3a63-8def-b9f1a4de24a8",
                                        "entry_id": "3ee9f838-f294-30e5-a04c-d53ce67ffda1",
                                        "glosses": [
                                            "weibliche Person, die in einem Chor singt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0351e35e-e284-4d07-ac80-9b1f7bc32892",
                                                "sense_id": "76a99d13-bf4a-3a63-8def-b9f1a4de24a8",
                                                "text": "„Sie studierte in München Gesang und Ballett und wurde nach Engagements als Chorsängerin und Tänzerin an kleinen Bühnen 1936 von Karl Böhm an die Dresdner Staatsoper engagiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "487f109a-2994-46bb-8ae4-2c7011d282c0",
                        "source_entry_id": "108689c5-d3ee-356d-ba77-487cdf58a908",
                        "source_sense_id": "7a502ea2-bf2e-3618-b225-0cba25620e06",
