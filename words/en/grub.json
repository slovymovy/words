{
    "word_family": [
        "grubby",
        "grubbiness",
        "grubber"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee44a7e7-97c0-3037-a680-c09a573d78a4",
                    "sense_definition": "An informal term for food.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day of hiking, we were all ready for some good <w>grub</w>.",
                            "target_lang_translations": {
                                "ru": "После долгого дня в походе мы все были готовы к хорошей <w>жратве</w>."
                            }
                        },
                        {
                            "text": "The local tavern is famous for serving excellent pub <w>grub</w> at reasonable prices.",
                            "target_lang_translations": {
                                "ru": "Местная таверна славится тем, что там подают отличную пабную <w>еду</w> по разумным ценам."
                            }
                        }
                    ],
                    "synonyms": [
                        "chow",
                        "nosh",
                        "tucker",
                        "food",
                        "eats"
                    ],
                    "common_phrases": [
                        "pub grub",
                        "free grub",
                        "daily grub"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное обозначение еды или пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жратва́",
                                "target_lang_sense_clarification": "грубое, разговорное"
                            },
                            {
                                "target_lang_word": "ха́вчик",
                                "target_lang_sense_clarification": "молодежный сленг"
                            },
                            {
                                "target_lang_word": "харчи́",
                                "target_lang_sense_clarification": "просторечное"
                            },
                            {
                                "target_lang_word": "еда́",
                                "target_lang_sense_clarification": "нейтральное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99355e62-bdd5-32cc-a5e4-c8962322439f",
                    "sense_definition": "The larva of an insect, especially a beetle, often found in soil or wood.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener found a thick white <w>grub</w> while digging in the flower bed.",
                            "target_lang_translations": {
                                "ru": "Садовник нашел толстую белую <w>личинку</w>, когда копал клумбу."
                            }
                        },
                        {
                            "text": "Birds often search the lawn for a tasty <w>grub</w> to eat.",
                            "target_lang_translations": {
                                "ru": "Птицы часто ищут на газоне вкусных <w>личинок</w>, чтобы полакомиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "larva"
                    ],
                    "common_phrases": [
                        "white grub",
                        "beetle grub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Личинка насекомого, особенно жука, часто встречающаяся в почве или древесине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "личи́нка",
                                "target_lang_sense_clarification": "биологический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f167db3-bdb2-3d71-9a47-4df2bd60e3c5",
                    "sense_definition": "A person who is considered dirty, despicable, or a lowlife.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is such a <w>grub</w> for leaving his trash all over the park.",
                            "target_lang_translations": {
                                "ru": "Он такой <w>грязнуля</w>, раз разбрасывает мусор по всему парку."
                            }
                        },
                        {
                            "text": "Nobody wanted to work with him because he acted like a total <w>grub</w>.",
                            "target_lang_translations": {
                                "ru": "Никто не хотел с ним работать, потому что он вел себя как полное <w>ничтожество</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lowlife",
                        "slob"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которого считают грязным, подлым или никчемным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязну́ля",
                                "target_lang_sense_clarification": "о неопрятном человеке"
                            },
                            {
                                "target_lang_word": "ничто́жество",
                                "target_lang_sense_clarification": "о подлом человеке"
                            },
                            {
                                "target_lang_word": "подо́нок",
                                "target_lang_sense_clarification": "о низком человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a446246-0b85-3e70-be31-e7595f133335",
                    "sense_definition": "A short, thickset person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old story described a short clownish <w>grub</w> who possessed surprising strength.",
                            "target_lang_translations": {
                                "ru": "В старой сказке описывался невысокий комичный <w>коротышка</w>, обладавший удивительной силой."
                            }
                        },
                        {
                            "text": "He was a sturdy little <w>grub</w> of a man, built close to the ground.",
                            "target_lang_translations": {
                                "ru": "Он был крепким маленьким <w>крепышом</w>, приземистого телосложения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Невысокий, коренастый человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "короты́шка",
                                "target_lang_sense_clarification": "невысокий человек"
                            },
                            {
                                "target_lang_word": "крепы́ш",
                                "target_lang_sense_clarification": "плотный, коренастый человек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0171a8b5-dcd7-30a7-9509-3fb2e0ec5523",
                    "sense_definition": "To dig in the ground, especially to remove roots or search for something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers had to <w>grub</w> up the old tree stumps before planting new crops.",
                            "target_lang_translations": {
                                "ru": "Фермерам пришлось <w>выкорчевать</w> старые пни перед посадкой новых культур."
                            }
                        },
                        {
                            "text": "He began to <w>grub</w> around in the dirt looking for his lost keys.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>рыться</w> в грязи в поисках потерянных ключей."
                            }
                        }
                    ],
                    "synonyms": [
                        "dig",
                        "uproot"
                    ],
                    "common_phrases": [
                        "grub up",
                        "grub around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Копать в земле, особенно с целью удаления корней или поиска чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкорчёвывать",
                                "target_lang_sense_clarification": "удалять корни"
                            },
                            {
                                "target_lang_word": "рыться",
                                "target_lang_sense_clarification": "копаться в поисках чего-то"
                            },
                            {
                                "target_lang_word": "копа́ть",
                                "target_lang_sense_clarification": "делать яму"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "706b3d6d-17ca-3683-918e-3098d288ea1f",
                    "sense_definition": "To search for or obtain something, like food or money, by scrounging or scavenging.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "searching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry travelers managed to <w>grub</w> for some leftovers in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Голодным путешественникам удалось <w>раздобыть</w> немного остатков еды на кухне."
                            }
                        },
                        {
                            "text": "He spent the afternoon trying to <w>grub</w> together enough money for the bus fare.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, пытаясь <w>наскрести</w> достаточно денег на проезд в автобусе."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrounge",
                        "scavenge"
                    ],
                    "common_phrases": [
                        "grub for"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Искать или добывать что-либо (еду, деньги), побираясь или выпрашивая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выклянчивать",
                                "target_lang_sense_clarification": "просить настойчиво"
                            },
                            {
                                "target_lang_word": "наскрести́",
                                "target_lang_sense_clarification": "с трудом собрать (деньги)"
                            },
                            {
                                "target_lang_word": "раздобы́ть",
                                "target_lang_sense_clarification": "найти с трудом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af473648-bc6a-3fd8-9fdd-5cd7cf267965",
                    "sense_definition": "To eat food, especially in a messy or enthusiastic way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kids have been <w>grubbing</w> at their snacks since they got home from school.",
                            "target_lang_translations": {
                                "ru": "Дети <w>уплетают</w> свои перекусы с тех пор, как пришли домой из школы."
                            }
                        },
                        {
                            "text": "We sat down to <w>grub</w> on some pizza while watching the game.",
                            "target_lang_translations": {
                                "ru": "Мы уселись <w>похомячить</w> пиццу за просмотром матча."
                            }
                        }
                    ],
                    "synonyms": [
                        "eat",
                        "chow down"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Есть пищу, особенно неаккуратно или с большим аппетитом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уплета́ть",
                                "target_lang_sense_clarification": "есть с аппетитом"
                            },
                            {
                                "target_lang_word": "хомя́чить",
                                "target_lang_sense_clarification": "сленг, есть"
                            },
                            {
                                "target_lang_word": "жрать",
                                "target_lang_sense_clarification": "грубо, есть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}