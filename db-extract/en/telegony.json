                "senses": [
                    {
                        "sense_id": "20c168a4-4bf5-39a6-9a27-f78d4bddb00b",
                        "entry_id": "f81b52da-6acb-3677-bc4f-4013a22fe5a4",
                        "glosses": [
                            "The belief that, in the case of siblings from the same mother but different fathers, the second sibling could inherit characteristics from the father of the first."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ecd9c692-1175-46c4-9bbc-740294aa7891",
                                "sense_id": "20c168a4-4bf5-39a6-9a27-f78d4bddb00b",
                                "text": "\"And that telegony is still sub judice?\" \"Undoubtedly.\" \"And that the germ plasm is different from the parthenogenetic egg?\" \"Why, surely!\" I cried, and gloried in my own audacity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aee31bf5-193e-4bf1-9ca4-50103e826b9d",
