                    {
                        "sense_id": "eb355494-486a-321b-9c25-4a25a95db0cd",
                        "entry_id": "86807af4-4e4c-3e25-a5a5-6d653f234983",
                        "glosses": [
                            "Office d’amiral, de grand amiral dans l’ancienne marine française."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d56293c-cfd8-44dc-98a9-0d0589c99a26",
                                "sense_id": "eb355494-486a-321b-9c25-4a25a95db0cd",
                                "text": "L’Amirauté de France."
                            }
                        ]
                    },
                    {
                        "sense_id": "570a74a5-86e5-3279-ad2a-b21d03fc783b",
                        "entry_id": "86807af4-4e4c-3e25-a5a5-6d653f234983",
                        "glosses": [
                            "Juridiction, du tribunal qui connaissait de toutes les affaires contentieuses relatives à la marine et à la navigation."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "02cae2f8-a96f-4cbb-9f64-e1ce2f414bf2",
                                "sense_id": "570a74a5-86e5-3279-ad2a-b21d03fc783b",
                                "text": "Le siège de l’amirauté."
                            },
                            {
                                "example_id": "58979e5a-bffc-42a2-849c-ede0ff08c202",
                                "sense_id": "570a74a5-86e5-3279-ad2a-b21d03fc783b",
                                "text": "Lieutenant de l’amirauté."
                            },
                            {
                                "example_id": "f2a27004-161c-4c8f-ab33-d9f406adec05",
                                "sense_id": "570a74a5-86e5-3279-ad2a-b21d03fc783b",
                                "text": "Faire juger une prise par l’amirauté."
                            },
                            {
                                "example_id": "3a5e134f-dcbe-4cbd-a5b6-619d68c6d469",
                                "sense_id": "570a74a5-86e5-3279-ad2a-b21d03fc783b",
                                "text": "La Meuse est la première ; le siège de cette amirauté est à Rotterdam, Zélande est la seconde amirauté, elle a son siège à Middelbourg."
                            }
                        ]
                    },
                    {
                        "sense_id": "92fbaa60-1de2-3867-a9dd-2a7ffa6f1471",
                        "entry_id": "86807af4-4e4c-3e25-a5a5-6d653f234983",
                        "glosses": [
                            "En Angleterre, désigne l’administration supérieure de la Marine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23932cea-2e78-461b-86e1-65752bcac5be",
                                "sense_id": "92fbaa60-1de2-3867-a9dd-2a7ffa6f1471",
                                "text": "Les lords de l’Amirauté."
                            },
                            {
                                "example_id": "485f2515-44e9-48e4-bcaa-9dbf5964d408",
                                "sense_id": "92fbaa60-1de2-3867-a9dd-2a7ffa6f1471",
                                "text": "L’Amirauté anglaise."
                            },
                            {
                                "example_id": "746987f3-ad35-46a8-bba4-0e4cb17699e7",
                                "sense_id": "92fbaa60-1de2-3867-a9dd-2a7ffa6f1471",
                                "text": "Les bureaux de l’Amirauté. Il y avait de même, en France, un Conseil d’amirauté qui a été remplacé par un Conseil supérieur de la Marine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23ff4600-786c-4e1d-8797-6efdfeb129f8",
                        "source_entry_id": "86807af4-4e4c-3e25-a5a5-6d653f234983",
                        "target_lang_word": "Admiralität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Admiralität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce2a50ba-525d-37bd-9036-19b06919dadf",
                                        "entry_id": "a2868e35-3aa5-3364-9652-302d6762493b",
                                        "glosses": [
                                            "oberste Behörde für das Kommando und die Verwaltung der Kriegsmarine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af3d517-aa61-4d56-bd01-12ea3d0c2826",
                                                "sense_id": "ce2a50ba-525d-37bd-9036-19b06919dadf",
                                                "text": "„Am Heck wehte die Flagge der britischen Admiralität.“"
                                            },
                                            {
                                                "example_id": "929c38c7-8e2d-4ed4-aeaf-2f2876ad57c9",
                                                "sense_id": "ce2a50ba-525d-37bd-9036-19b06919dadf",
                                                "text": "„Cook hatte drei Jahrzehnte auf See verbracht, hatte ein volles und strapaziöses Berufsleben in der Schifffahrt hinter sich, wie schon aus der Tatsache zu ersehen ist, dass die Admiralität ihm anfänglich einen komfortablen Alterssitz im Hospital von Greenwich gewährt hatte.“"
                                            },
                                            {
                                                "example_id": "3f022fd7-27d9-4591-bab3-90bb14f06c5d",
                                                "sense_id": "ce2a50ba-525d-37bd-9036-19b06919dadf",
                                                "text": "„Ein Ort, wie geschaffen für die Admiralität und die deutsche Kriegsmarine, die ihren Stützpunkt im nur 14 Kilometer entfernten Hafen von Saint-Nazaire einrichtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "567e09c0-64a8-31ab-bfea-c6be08da8190",
                                        "entry_id": "a2868e35-3aa5-3364-9652-302d6762493b",
                                        "glosses": [
                                            "Gesamtheit der Admirale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "affb767c-1e67-420b-bc98-6a3869152f6e",
                                                "sense_id": "567e09c0-64a8-31ab-bfea-c6be08da8190",
                                                "text": "„Bald ist der sonnendurchleuchtete Raum gefüllt. Die gesamte Admiralität und die in Berlin anwesende Generalität war in der Trauerversammlung vertreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
