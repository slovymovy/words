                                        "entry_id": "016219e7-563f-301d-8e01-dd3f4cc37608",
                                        "glosses": [
                                            "The point at the root of the nose where the frontal and two nasal bones meet. (It is a cephalometric landmark.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0da877e4-6b1a-439b-be84-2ca07b81c401",
                                                "sense_id": "79bc77cb-a9e3-3e3f-879f-5441605dd444",
                                                "text": "Additional skull measurements, taken with small sliding calipers, were from zygomaxillare, the lowest point on the zygomatic-maxillary suture, to the points of alveolare, basion and nasion."
                                            }
                                        ]
                                    }
