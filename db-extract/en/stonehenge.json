                            {
                                "example_id": "5febe693-4006-46fb-8c61-725282c330ff",
                                "sense_id": "fdc007b0-6e21-3412-aa7e-fe505e150113",
                                "text": "The collection of rocks is a national landmark that looks something like a Stonehenge on the prairie."
                            },
                            {
                                "example_id": "f7b8dc6a-f3b2-45c7-ab5d-233d7f8b6667",
                                "sense_id": "fdc007b0-6e21-3412-aa7e-fe505e150113",
                                "text": "Within weeks of winning the General Election in July 2024, the government halted a planned tunnel for the A303 past Stonehenge in Wiltshire. It stated that the £2 billion scheme was \"poor value for money\". […] The West of England line carries a tiny fraction of the volumes on the parallel road [A303], and Stonehenge is a nationally notorious bottleneck."
                            }
