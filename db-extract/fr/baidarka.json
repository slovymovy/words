                "senses": [
                    {
                        "sense_id": "f6962c89-1eb0-39bf-8cf3-55d44a0a2d58",
                        "entry_id": "18a6e140-fbff-308c-a928-4d6d225014de",
                        "glosses": [
                            "Genre de kayak allant de une à trois places, spécifique au peuple aléoute."
                        ],
                        "tags": [
                            "Navigation",
                            "Navigation",
                            "Canoë-kayak"
                        ],
                        "examples": [
                            {
                                "example_id": "1bc283c0-215a-4097-8b8e-038af9eb0c01",
                                "sense_id": "f6962c89-1eb0-39bf-8cf3-55d44a0a2d58",
                                "text": "Son projet est simple : Il veut construire une baidarka et tout le matériel nécessaire (vêtements, matériel de bivouac) à l’ancienne avec des matériaux naturels."
                            },
                            {
                                "example_id": "d2de3c6f-45c8-4e5b-935e-dcfa15332a14",
                                "sense_id": "f6962c89-1eb0-39bf-8cf3-55d44a0a2d58",
                                "text": "Oubliez ce que vous connaissez du kayak, on entre ici dans une dimension nouvelle. Baidarka, est le nom donné par les navigateurs russes au kayak des Aléoutes. Donc la baidarka, est un kayak, avec tout un tas de particularités propres aux kayaks du Pacifique Nord."
                            }
                        ]
                    }
                ],
