                "senses": [
                    {
                        "sense_id": "f1149f42-f987-3172-a016-8190f61dd76a",
                        "entry_id": "6c22a04e-d9c1-3a08-b9b7-97cd915de08c",
                        "glosses": [
                            "Enlever son caractère belliciste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9df151b9-2e36-4053-827a-f377dcc5e158",
                                "sense_id": "f1149f42-f987-3172-a016-8190f61dd76a",
                                "text": "L’utilisation d’une terminologie ou d’une propagande non-politique ne peut pas dépolitiser la politique, pas plus que l’utilisation d’une terminologie pacifiste ne peut débelliciser la guerre."
                            },
                            {
                                "example_id": "fe9a462f-59b1-4fc3-9f8f-bcbe3bfc6917",
                                "sense_id": "f1149f42-f987-3172-a016-8190f61dd76a",
                                "text": "Virgile ne risque pas de rebuter les soldats qu’Auguste veut « débelliciser » en les convertissant à la terre."
                            }
                        ]
                    }
                ],
