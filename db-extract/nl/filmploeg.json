                        "examples": [
                            {
                                "example_id": "1669eed6-d2fc-4526-b833-5838236fd75d",
                                "sense_id": "5dac3f44-0b78-390a-b351-36d2a9da2723",
                                "text": "De Britse zangeres Adele heeft al tien Grammy Awards in de kast en is vijf keer genomineerd voor de komende editie van de awardshow, op 12 februari 2017. Ze is onder meer genomineerd voor ‘album van het jaar’ met 25. In deze special zingt ze nummers van die plaat in de beroemde Radio City Music Hall in New York. Ook maakt ze praatjes met fans in de zaal, iets wat ze graag doet. Tijdens de voorbereidingen werd Adele gevolgd door een filmploeg, dus we krijgen ook een kijkje achter de schermen."
                            },
                            {
                                "example_id": "c1ddf05e-4d20-460b-b3e5-01d20e16265c",
                                "sense_id": "5dac3f44-0b78-390a-b351-36d2a9da2723",
                                "text": "Een cameraman en geluidsman zijn een vast onderdeel van een cameraploeg."
                            }
                        ]
