                            "with-definite-article"
                        ],
                        "examples": [
                            {
                                "example_id": "c82ea5f6-7c53-41c7-92c8-e3f8428acd5c",
                                "sense_id": "456074c8-4c5c-30f4-af03-143644fdca4f",
                                "text": "We're going to the Med for four weeks this summer."
                            },
                            {
                                "example_id": "95acb76f-5618-4c4f-bc26-0e8a4095c72f",
                                "sense_id": "456074c8-4c5c-30f4-af03-143644fdca4f",
                                "text": "They used to go wild for villas by the Med and ski chalets in the Alps; now they are forking out for views of the Channel and hilly walks in Shropshire."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f19c0b76-cea3-3b2b-8ed2-b8fc420c2625",
                "word": "med",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "81d9597d-bb2c-46ac-9abc-1a2904f55f4c",
                        "entry_id": "f19c0b76-cea3-3b2b-8ed2-b8fc420c2625",
                        "tags": [
                            "plural"
                        ],
                        "form": "meds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6efd2618-a6c3-3c59-a896-92fb7ac9589c",
                        "entry_id": "f19c0b76-cea3-3b2b-8ed2-b8fc420c2625",
                        "glosses": [
                            "Medications, especially prescribed psychoactive medications."
                        ],
                        "tags": [
                            "countable",
                            "in-plural",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6594e4d5-d501-4eac-899d-0eecc33ba6b0",
                                "sense_id": "6efd2618-a6c3-3c59-a896-92fb7ac9589c",
                                "text": "He's been very strange. I wonder if he's not been taking his meds."
                            },
                            {
                                "example_id": "a9ed662e-4ce7-43a9-9b07-c84ee8918fb1",
                                "sense_id": "6efd2618-a6c3-3c59-a896-92fb7ac9589c",
                                "text": "Shepard: What's wrong with your assistant?\nDr. Warren: Manuel has a brilliant mind, but he's always been a bit... unstable. Genius and madness are two sides of the same coin.\nDr. Manuel: Is it madness to see the future? To see the destruction rushing towards us? To understand there is no escape? No hope? No, I am not mad. I'm the only sane one left!\nDr. Warren: I gave him an extra dose of his meds after the attack."
                            },
                            {
                                "example_id": "f78758f0-dd21-4f84-abb9-f3fd0d1ecbbb",
                                "sense_id": "6efd2618-a6c3-3c59-a896-92fb7ac9589c",
                                "text": "Take a med. […] BECAUSE you took a med you did not have a full-blown panic attack and faint."
                            },
                            {
                                "example_id": "dea40745-045f-47c3-afac-00e207db42d1",
                                "sense_id": "6efd2618-a6c3-3c59-a896-92fb7ac9589c",
                                "text": "“What meds?”\n“It's a long story.”\n“What meds?”\n“He's bipolar, Mark. Diagnosed a few years back.”"
                            },
                            {
                                "example_id": "536dc24d-acb7-4260-bc66-8eaccf646f41",
                                "sense_id": "6efd2618-a6c3-3c59-a896-92fb7ac9589c",
                                "text": "“I'd been trying to get my anti-depressants right and taking the meds,” he said. “That was my feeling at the time — of worrying if this was the right choice,” he added."
                            }
                        ]
                    },
                    {
                        "sense_id": "af3109f9-989e-33a4-9a39-48644c516787",
                        "entry_id": "f19c0b76-cea3-3b2b-8ed2-b8fc420c2625",
                        "glosses": [
                            "Clipping of medicine, as an academic subject."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5070b1c5-e874-4d76-97bb-66c0570948b7",
                                "sense_id": "af3109f9-989e-33a4-9a39-48644c516787",
                                "text": "My brother studied med at Cambridge."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0e4a805-f4ef-3082-a692-a0be064351d7",
                        "entry_id": "f19c0b76-cea3-3b2b-8ed2-b8fc420c2625",
                        "glosses": [
                            "A medic; a doctor."
                        ],
                        "tags": [
                            "countable",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "d7617935-ed19-4f0a-b5e9-fadf08aee023",
                                "sense_id": "f0e4a805-f4ef-3082-a692-a0be064351d7",
                                "text": "A stray dachshund the meds are keeping as a mascot."
                            }
                        ]
                    }
