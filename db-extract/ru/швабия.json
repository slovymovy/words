                                                "sense_id": "fecd8d8b-2ff8-341d-8adc-f89ce7901f56",
                                                "text": "Le duc de Marlborough était prince de Mindelheim en Souabe, de même que le duc de Wellington était prince de Waterloo en Belgique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e9a17a-5601-38c9-8982-caedfce807be",
