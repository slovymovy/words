                    {
                        "form_id": "53ba9eab-7e02-4f5d-883a-e012039e9ca6",
                        "entry_id": "6b1c5e60-62de-3597-b7d1-a2b5e5dc4816",
                        "tags": [
                            "accusative",
                            "plural"
