                "senses": [
                    {
                        "sense_id": "2e078962-c169-31ea-ac2c-cd03e3a8e351",
                        "entry_id": "81ade4e7-d19e-3f77-bfaf-1bf2719df1cd",
                        "glosses": [
                            "mittels Türflügel verschließbarer Zugang zu einem Garten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf6470e-e89c-4408-9770-beca6241a618",
                                "sense_id": "2e078962-c169-31ea-ac2c-cd03e3a8e351",
                                "text": "„Früh am Morgen öffnete Peter die Gartentür und trat hinaus auf die große, grüne Wiese.“"
                            },
                            {
                                "example_id": "6dfb2c39-0000-4f0c-8307-f65fa29cc790",
                                "sense_id": "2e078962-c169-31ea-ac2c-cd03e3a8e351",
                                "text": "„Nach Beendigung des Haarbaues mußte Schlehenblüte die Gartentür öffnen.“"
                            },
                            {
                                "example_id": "0c3ecc50-5ee8-478d-bd5b-41538ba91962",
                                "sense_id": "2e078962-c169-31ea-ac2c-cd03e3a8e351",
                                "text": "„Didier stand auf und ging zur Gartentür.“"
                            },
                            {
                                "example_id": "7a32be84-60a0-48c9-9359-988d30bbd434",
                                "sense_id": "2e078962-c169-31ea-ac2c-cd03e3a8e351",
                                "text": "„Durch die Gartentür sah man Monsieur Girbal, den Steureinnehmer, mit dem Hauptmann und Gutsbesitzer Heurteaux eintreten; und der Gastwirt Beljambe kam Arm in Arm mit dem Krämer Langlois, der wegen seines Katarrhs nur mühsam vorankam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
