    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1c95755e-64b6-3c06-84b6-76c6e2f63f4e",
                    "sense_definition": "Qui manque de force physique, de vigueur ou d'énergie corporelle.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "force_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue maladie, il se sent encore très <w>faible</w> pour marcher."
                        },
                        {
                            "text": "L'enfant était trop <w>faible</w> pour soulever cette lourde boîte en bois."
                        }
                    ],
                    "antonyms": [
                        "fort"
                    ],
                    "common_phrases": [
                        "se sentir faible"
                    ]
                },
                {
                    "sense_id": "b9752be8-d4aa-30a8-a7ef-8e221027bfc7",
                    "sense_definition": "Peu considérable en quantité, en intensité, en valeur ou en degré.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantite_degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le thermomètre affiche une température très <w>faible</w> en cette saison d'hiver."
                        },
                        {
                            "text": "Il y a un <w>faible</w> risque de pluie selon les prévisions météorologiques."
                        }
                    ],
                    "antonyms": [
                        "fort"
                    ],
                    "common_phrases": [
                        "faible dose",
                        "faible intensité",
                        "faible pourcentage"
                    ]
                },
                {
                    "sense_id": "5779d082-9abb-3323-8180-9dc5e9444dc5",
                    "sense_definition": "Qui manque d'énergie morale, de volonté, de fermeté ou de résolution.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "force_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce dirigeant est trop <w>faible</w> pour faire respecter les règles établies."
                        },
                        {
                            "text": "Elle a cédé à la tentation car elle était <w>faible</w> face aux pressions."
                        }
                    ],
                    "antonyms": [
                        "fort"
                    ],
                    "common_phrases": [
                        "caractère faible"
                    ]
