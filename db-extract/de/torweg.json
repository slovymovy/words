                    },
                    {
                        "translation_id": "8bdf5c85-beec-450e-ade0-0b2c9b75c897",
                        "source_entry_id": "0d5d6aca-4d93-3e31-9bdc-fb3311f8b097",
                        "source_sense_id": "f16ce7d8-041f-334b-a54f-ce735c4db566",
                        "source_sense_description": "Weg, auf dem man ein Tor passieren kann",
                        "target_lang_word": "porte cochère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porte cochère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9662a69c-1af4-3e92-be2c-c62d91e5ed45",
                                        "entry_id": "5afcb526-bcd5-3526-8bfb-3bb41e6fb50d",
                                        "glosses": [
                                            "Porte par laquelle les voitures peuvent passer pour entrer dans la cour d’une maison, d’un hôtel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a854635c-a79a-46da-8edd-ab19750c8619",
                                                "sense_id": "9662a69c-1af4-3e92-be2c-c62d91e5ed45",
                                                "text": "La tante et la nièce étaient en ce moment sur le seuil de la porte cochère, occupées à regarder la calèche qui fuyait."
                                            },
                                            {
                                                "example_id": "9fea5dce-b932-4b64-a66e-77900c9afa84",
                                                "sense_id": "9662a69c-1af4-3e92-be2c-c62d91e5ed45",
                                                "text": "Quelques jours après, Lucien, descendant de cabriolet pour monter chez madame Grandet, fut séduit par l’éclat d’un beau clair de lune qu’il apercevait par la porte cochère sur la place de la Madeleine. Au lieu de monter, il sortit, ce qui étonna fort MM. les cochers."
                                            },
                                            {
                                                "example_id": "95a7570d-8404-429a-bbef-2fe96ffc81ce",
                                                "sense_id": "9662a69c-1af4-3e92-be2c-c62d91e5ed45",
                                                "text": "En atteignant la porte cochère, les yeux baignés de larmes, le parfumeur vit à peine un beau cheval anglais en sueur qui arrêta net à la porte un des plus jolis cabriolets qui roulassent en ce moment sur les pavés de Paris."
                                            },
                                            {
                                                "example_id": "ca1f83ef-a026-4924-9573-cb12c27b4b53",
                                                "sense_id": "9662a69c-1af4-3e92-be2c-c62d91e5ed45",
                                                "text": "En cet endroit, nulle trace de commerce. À peine y voyait-on alors les luxueuses portes cochères des gens riches ! s’il y en avait, elles tournaient rarement sur leurs gonds, excepté celle de monsieur Martener, un médecin obligé d’avoir son cabriolet et de s’en servir."
                                            },
                                            {
                                                "example_id": "a69fca87-bd21-4991-98dd-fd554e927174",
                                                "sense_id": "9662a69c-1af4-3e92-be2c-c62d91e5ed45",
                                                "text": "[…] il crut revoir le même individu qui l’avait devancé en hâtant le pas et qui cherchait à se dissimuler dans renfoncement d'une porte cochère."
                                            },
                                            {
                                                "example_id": "5216f647-a23c-44e5-b97d-ff0442cdfd95",
                                                "sense_id": "9662a69c-1af4-3e92-be2c-c62d91e5ed45",
                                                "text": "Le wattman du taxi-auto payé, Juve faisait passer Fandor sous la porte cochère de l’immeuble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
