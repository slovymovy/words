                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd6505d3-3cda-443d-b287-3db0a1fb85c4",
                        "source_entry_id": "0fed0ae5-24b1-395f-a8ec-dbb2b513fa5e",
                        "target_lang_word": "homeopathy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homeopathy",
