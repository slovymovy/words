                "senses": [
                    {
                        "sense_id": "36c72933-db02-353e-84f9-0074b9b28cfa",
                        "entry_id": "eeea8f31-6888-3747-9135-df8c9dc97505",
                        "glosses": [
                            "A room, allocated as a children's play area, in which noisy or boisterous activities are tolerated."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e0eeb52f-4cf3-300c-81ef-c72721bdb9f9",
                        "entry_id": "eeea8f31-6888-3747-9135-df8c9dc97505",
                        "glosses": [
                            "A room dedicated to sadomasochistic sexual activity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90533e51-a16e-4d88-8e77-dde00a815ccc",
                                "sense_id": "e0eeb52f-4cf3-300c-81ef-c72721bdb9f9",
                                "text": "She'll take them to bed with her, and she'll give them stuff to make them feel like lords of creation, and they'll play round games. Then one day they'll wake up in shackles in her playroom."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eabb718b-fb55-4741-865e-f29b87a15b78",
                        "source_entry_id": "eeea8f31-6888-3747-9135-df8c9dc97505",
                        "source_sense_description": "room dedicated for playing",
                        "target_lang_word": "Spielzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spielzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90e334c8-cc69-38c6-82d7-cbbad77aae37",
                                        "entry_id": "1b904c84-f645-36ed-9434-02651782472f",
                                        "glosses": [
                                            "Innenraum, der vorrangig zum Spielen vorgesehen und eingerichtet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f61231fd-cc51-470a-822c-1f2cdd0d04de",
                                                "sense_id": "90e334c8-cc69-38c6-82d7-cbbad77aae37",
                                                "text": "„Spielplätze in jedem Stadtteil, aber auch in Waldlichtungen, Spielgeräte und Spielzeuge aller Schattierungen, eine Flut pädagogischer Spielliteratur, Kinder- bzw. Spielsendungen im Fernsehen, extra eingerichtete Spielzimmer usw. umstellen wohlwollend die Welt der Kinder.“"
                                            },
                                            {
                                                "example_id": "73a18607-77ce-4559-85ea-f76873b28283",
                                                "sense_id": "90e334c8-cc69-38c6-82d7-cbbad77aae37",
                                                "text": "„Wenn sich nach dieser Probephase herausstellt, dass es tatsächlich Bedarf für das Spielzimmer gibt, soll es dauerhaft einmal pro Woche geöffnet haben, heißt es aus der Pressestelle der Bundestagsverwaltung.“"
                                            },
                                            {
                                                "example_id": "487632c9-99ee-44ce-80c3-ac09a7280ddc",
                                                "sense_id": "90e334c8-cc69-38c6-82d7-cbbad77aae37",
                                                "text": "„Die geschilderte Spielszene liefert gleichzeitig einen Erklärungsansatz dafür, warum die heutigen, mit Spielsachen aller Art gefüllten Spielzimmer bei den Spielenden häufig nur eine innere Öde hinterlassen.“"
                                            },
                                            {
                                                "example_id": "c346e171-4447-4ce7-9fe4-92c0f1cda934",
                                                "sense_id": "90e334c8-cc69-38c6-82d7-cbbad77aae37",
                                                "text": "„In diesem Istanbuler Frauengefängnis sind Mutter-Kind-Beziehungen möglich, es gibt auch ein Spielzimmer, aber da darf Meşale Tolu mit Serkan nicht hin.“"
                                            },
                                            {
                                                "example_id": "fbd670a9-9268-40b9-ad8f-ebf418b935c4",
                                                "sense_id": "90e334c8-cc69-38c6-82d7-cbbad77aae37",
                                                "text": "„Die Bundespolizisten selbst tragen von zu Hause Kuscheltiere auf ihre Flensburger Dienststelle, wo sie ein Spielzimmer eingerichtet haben für die Flüchtlingskinder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
