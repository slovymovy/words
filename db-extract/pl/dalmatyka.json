                "senses": [
                    {
                        "sense_id": "9b29bd3d-25bc-3842-807c-ef4047521209",
                        "entry_id": "22012c44-9be1-37eb-94be-2f2f141f5026",
                        "glosses": [
                            "wierzchnia szata liturgiczna diakonów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b59dfe7-b956-49ee-81a7-b9375961029a",
                                "sense_id": "9b29bd3d-25bc-3842-807c-ef4047521209",
                                "text": "Diakoni nie noszą ornatów, ich strojem jest dalmatyka."
                            },
                            {
                                "example_id": "26e582d8-d5a4-4a46-8a90-99dbc236e381",
                                "sense_id": "9b29bd3d-25bc-3842-807c-ef4047521209",
                                "text": "Szafa była wypełniona barokowymi dalmatykami, ornatami i kapami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9497bbb1-7ab5-4978-8209-92489cad345f",
                        "source_entry_id": "22012c44-9be1-37eb-94be-2f2f141f5026",
                        "source_sense_id": "9b29bd3d-25bc-3842-807c-ef4047521209",
                        "target_lang_word": "dalmatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dalmatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe0fa47c-d02d-3f1b-8aca-c3fd8efe4303",
                                        "entry_id": "eca5949e-154e-3f4c-ba12-dd5a407d589f",
                                        "glosses": [
                                            "A long wide-sleeved tunic, which serves as a liturgical vestment in the Roman Catholic and Anglican Churches and is worn by a deacon at the Eucharist or Mass and, although infrequently, by bishops as an undergarment above the alb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7445ff45-7ca1-49cc-a6da-d26e221eba96",
                                                "sense_id": "fe0fa47c-d02d-3f1b-8aca-c3fd8efe4303",
                                                "text": "He had [...] dalmatics of white satin and pink silk damask, decorated with tulips and dolphins and fleurs-de-lis [...]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dalmatic",
                                "target_lang_code": "en",
                                "target_senses": [
