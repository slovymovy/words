                        ]
                    },
                    {
                        "translation_id": "52268312-049f-45d9-9edc-e1b8c8d690dd",
                        "source_entry_id": "b7b19406-ca99-38ab-904e-70f1f52af9db",
                        "target_lang_word": "Plusquamperfekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plusquamperfekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3da4f091-3513-352d-af8f-318f7569f5bb",
                                        "entry_id": "1184e2cc-ded1-3be4-8b6b-ace06322ad1b",
                                        "glosses": [
                                            "eines der Tempora, das ein Geschehen zeitlich vor einem anderen, vergangenen Geschehen einordnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d1959f-f2e7-46a9-8ab3-1f434e4f6f3e",
                                                "sense_id": "3da4f091-3513-352d-af8f-318f7569f5bb",
                                                "text": "„Nachdem das Flugzeug gelandet war, spielten die Passagiere Gitarre.“ Der temporale Nebensatz steht im Plusquamperfekt, da er sich vor dem Hauptsatz ereignete."
                                            },
                                            {
                                                "example_id": "9f82a5da-436c-486e-bf6f-4e3f8ae60ff0",
                                                "sense_id": "3da4f091-3513-352d-af8f-318f7569f5bb",
                                                "text": "„Hatte gespielt“ ist eine Verbform im Plusquamperfekt."
                                            },
                                            {
                                                "example_id": "68ea15fa-0f22-4467-ae74-ad9086b02b43",
                                                "sense_id": "3da4f091-3513-352d-af8f-318f7569f5bb",
                                                "text": "„Die Fragen nach Bestand und Veränderungen im Feld der Vergangenheitstempora konzentrieren sich mehr und mehr auf die Verwendungsweisen von Präteritum und Perfekt, nicht so sehr wegen der geringen Gebrauchsfrequenzen des Plusquamperfekts, sondern wegen der häufigen Konkurrenz zwischen Formen des Präteritums und des Perfekts.“"
                                            },
                                            {
                                                "example_id": "43c250e3-31cd-4225-80be-ff685c943458",
                                                "sense_id": "3da4f091-3513-352d-af8f-318f7569f5bb",
                                                "text": "„Schon die relativ späte Einführung der einfachen, analytisch gebildeten Vergangenheitsformen Perfekt und Plusquamperfekt ist aus dem Vorbild des Lateinischen allein nicht zu erklären.“"
                                            },
                                            {
                                                "example_id": "6c8fbc6d-6476-4611-a727-22b066dbd065",
                                                "sense_id": "3da4f091-3513-352d-af8f-318f7569f5bb",
                                                "text": "„Zu beiden Vergangenheitsformen gibt es als Abstufung das Plusquamperfekt (Vollendete Vergangenheit) hatte getroffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
