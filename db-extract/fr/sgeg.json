                        "examples": [
                            {
                                "example_id": "8fbf3277-330e-4072-88d8-a920716ee50f",
                                "sense_id": "41d41aaa-1083-30fa-ac4a-f9587bb991f0",
                                "text": "C’est à cette époque que je découvre, consternée, que n’importe quel connard doté d’un sgeg se sent le droit de parler au nom de tous les hommes, de la virilité, du peuple des guerriers, des seigneurs, des dominants, et – conséquemment – le droit de me donner des leçons de féminité."
                            },
                            {
                                "example_id": "662a1408-add1-473d-a731-85945a1b4ee5",
                                "sense_id": "41d41aaa-1083-30fa-ac4a-f9587bb991f0",
                                "text": "Elle se contenta de soulever sa jupe et, juchée sur ses Louboutin de chienne de luxe, se pencha sur le bureau, écarta bien les fesses, et attrapa mon sgeg pour se le ficher au cœur de sa cible, comme ça, fastoche."
                            }
                        ]
                    }
