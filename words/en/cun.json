{
    "word_family": [
        "cunning"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e27af88-d4a1-3125-9a3d-f8aed181032c",
                    "sense_definition": "A traditional Chinese unit of length, originally based on the width of a person's thumb at the knuckle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "units_of_measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The acupuncturist measured three <w>cun</w> below the knee to find the correct point.",
                            "target_lang_translations": {
                                "ru": "Иглотерапевт отмерил три <w>цуня</w> ниже колена, чтобы найти нужную точку."
                            }
                        },
                        {
                            "text": "In traditional Chinese medicine, a <w>cun</w> is a relative unit of measurement unique to each patient.",
                            "target_lang_translations": {
                                "ru": "В традиционной китайской медицине <w>цунь</w> — это относительная единица измерения, индивидуальная для каждого пациента."
                            }
                        }
                    ],
                    "synonyms": [
                        "Chinese inch"
                    ],
                    "common_phrases": [
                        "one cun"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in Chinese contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная китайская мера длины, изначально основанная на ширине сустава большого пальца человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цунь",
                                "target_lang_sense_clarification": "китайская мера длины"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c14160a3-2a36-37e7-b234-2f01be315085",
                    "sense_definition": "To know.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not <w>cun</w> the way to the old castle.",
                            "target_lang_translations": {
                                "ru": "Он не <w>знал</w> дороги к старому замку."
                            }
                        },
                        {
                            "text": "I would fain <w>cun</w> the truth of this matter.",
                            "target_lang_translations": {
                                "ru": "Я бы охотно <w>узнал</w> правду об этом деле."
                            }
                        }
                    ],
                    "synonyms": [
                        "know",
                        "ken"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historically used to mean 'to know'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Знать, ведать (устаревшее слово)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "устаревшее"
                            },
                            {
                                "target_lang_word": "ведать",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b038196e-3099-355e-9c09-58f7f18c1177",
                    "sense_definition": "Alternative form of <w>conn</w> (“direct or steer a ship”).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain ordered the officer to <w>cun</w> the vessel through the narrow channel.",
                            "target_lang_translations": {
                                "ru": "Капитан приказал офицеру <w>вести</w> судно через узкий канал."
                            }
                        },
                        {
                            "text": "He stood on the bridge to <w>cun</w> the ship safely into the harbor.",
                            "target_lang_translations": {
                                "ru": "Он стоял на мостике, чтобы безопасно <w>завести</w> корабль в гавань."
                            }
                        }
                    ],
                    "synonyms": [
                        "conn",
                        "steer",
                        "direct"
                    ],
                    "common_phrases": [
                        "cun the ship"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Alternative spelling of conn"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Управлять рулем, вести судно (альтернативная форма глагола conn)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "корабль"
                            },
                            {
                                "target_lang_word": "управлять",
                                "target_lang_sense_clarification": "курсом судна"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}