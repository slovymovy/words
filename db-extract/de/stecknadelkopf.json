                "senses": [
                    {
                        "sense_id": "f0981429-1b13-3519-8ac8-1aa3cbaea331",
                        "entry_id": "61bb8a18-cd8f-3612-9ce5-742e85f931d3",
                        "glosses": [
                            "kugelförmiger Aufsatz aus Plastik am Ende einer Stecknadel, der zum Anfassen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ad6e659-ebc5-4a04-8c1b-c485b79cd073",
                                "sense_id": "f0981429-1b13-3519-8ac8-1aa3cbaea331",
                                "text": "„Und das glich einer Sisyphus-Arbeit, denn das Hirn der Heuschrecken ist gerade mal so groß wie ein Stecknadelkopf.“"
                            },
                            {
                                "example_id": "38eece66-1c61-402d-9070-fb4fd3dde20d",
                                "sense_id": "f0981429-1b13-3519-8ac8-1aa3cbaea331",
                                "text": "„Die Nachrichten – Mikrofilme, nicht größer als ein Stecknadelkopf – sollten in Geldstücken, alten Papiertaschentüchern oder Orangenschalen verborgen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
