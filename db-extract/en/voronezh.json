                                    },
                                    {
                                        "sense_id": "f93367ec-7de2-3da2-96ec-5ee9e031112d",
                                        "entry_id": "1590779e-28c6-3741-99c3-9840a4c02dc4",
                                        "glosses": [
                                            "Ville de l’ouest de la Russie située sur le cours de cette rivière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfb8442f-703b-4a09-907c-beb280e14e9d",
                                                "sense_id": "f93367ec-7de2-3da2-96ec-5ee9e031112d",
                                                "text": "La tâche principale du Front de Voronej, dit-il, est de battre les Allemands à Akhtyrka."
                                            },
                                            {
                                                "example_id": "1c8a0a28-8ba2-45ec-a7d9-3b94c0d9cba3",
                                                "sense_id": "f93367ec-7de2-3da2-96ec-5ee9e031112d",
                                                "text": "Les combattants ont quitté les régions de Voronej et de Lipetsk, au sud de Moscou, étapes de leur tentative de rallier la capitale, selon les autorités locales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfe29e0e-e4bf-38bf-9df6-46d9e3033f3b",
                                        "entry_id": "1590779e-28c6-3741-99c3-9840a4c02dc4",
                                        "glosses": [
                                            "Oblast de Russie autour de cette ville."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
