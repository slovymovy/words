                                        "examples": [
                                            {
                                                "example_id": "cabd8fb7-7a5a-4118-b610-14429f98441f",
                                                "sense_id": "40a49b8e-0f7c-37d7-800b-f62c52ebbba4",
                                                "text": "Il circolo Pickwick è un romanzo episodico che narra le picaresche avventure del suo protagonista"
