                "senses": [
                    {
                        "sense_id": "a94c2447-dfc0-31e7-bc53-263a2957ba9a",
                        "entry_id": "e61b6e6e-2e97-396f-aae0-14289146c5c6",
                        "glosses": [
                            "osoba prowadząca występy, koncerty, rewie itp., zapowiada kolejne punkty programu, zabawia publiczność"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27c00e17-de7c-40d7-a69f-63f328b823f2",
                                "sense_id": "a94c2447-dfc0-31e7-bc53-263a2957ba9a",
                                "text": "Dosłownie przed chwilą konferansjerowi wypadł z ręki mikrofon."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66d5c110-9059-40ca-8690-9459362b3561",
                        "source_entry_id": "e61b6e6e-2e97-396f-aae0-14289146c5c6",
                        "source_sense_id": "a94c2447-dfc0-31e7-bc53-263a2957ba9a",
                        "target_lang_word": "announcer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "announcer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                        "entry_id": "446d08f8-7506-31ec-a3b8-f8aeb41f3058",
                                        "glosses": [
                                            "One who makes announcements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e150d7-0d3e-44a7-8949-3ad3500f4983",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "radio announcer"
                                            },
                                            {
                                                "example_id": "c153baa4-96cd-4e9e-a96f-cf89d00d822d",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "Even TV announcers at the last Winter Olympics were spotted with a swoosh on their jackets."
                                            },
                                            {
                                                "example_id": "511d5df9-6300-41a6-af6d-ddf49132aa94",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "Perlman devised a format inspired by the seminal mockumentary Spinal Tap, where the spot started with an ESPN announcer speaking to camera in a serious, straight voice, framing the story as “real” documentary."
                                            },
                                            {
                                                "example_id": "3dec8bff-9084-41aa-81fc-150a1477eff8",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "There were passing moments when it threatened to be a difficult night and, with the game goalless at half-time, the stadium announcer sounded almost apologetic when he relayed the news that Ukraine, kicking off an hour earlier, had gone to the top of the group by beating Poland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39ddd919-4025-4071-8cef-06e9ace6f91d",
                        "source_entry_id": "e61b6e6e-2e97-396f-aae0-14289146c5c6",
                        "source_sense_id": "a94c2447-dfc0-31e7-bc53-263a2957ba9a",
                        "target_lang_word": "compere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e2a7452-0126-36d8-8b7f-8a0a738dc5cf",
                                        "entry_id": "49a84aed-9102-3854-ae43-fc0a36fd91dd",
                                        "glosses": [
                                            "A master of ceremonies, especially for a television, variety, or quiz show."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a03ad3f6-9f06-4555-8b0a-1e8098c5f78a",
                                                "sense_id": "8e2a7452-0126-36d8-8b7f-8a0a738dc5cf",
                                                "text": "Every year I am the compere for our Church Quiz Night."
                                            },
                                            {
                                                "example_id": "558b6f02-a6e5-4891-8143-87199a18bfb8",
                                                "sense_id": "8e2a7452-0126-36d8-8b7f-8a0a738dc5cf",
                                                "text": "The compere came onto the stage holding the gold envelope that contained the winner's name."
                                            },
                                            {
                                                "example_id": "1350c9a4-82f4-4dfc-b618-ef5733f572d8",
                                                "sense_id": "8e2a7452-0126-36d8-8b7f-8a0a738dc5cf",
                                                "text": "Not only for his fighting expertise but also reminiscent of a compere in a cabaret show working the crowd, as a build up to the main event."
                                            },
                                            {
                                                "example_id": "0b00cb2c-bc05-4631-b3d6-c95773693697",
                                                "sense_id": "8e2a7452-0126-36d8-8b7f-8a0a738dc5cf",
                                                "text": "They were barely settled when the final song came to an end; the audience began to applaud and after a few more seconds the voice of the compere came over the PA."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d520e51f-5186-3869-b66e-c54e43056a9e",
                                        "entry_id": "e81b6594-6651-3691-af18-1373f5f111b7",
                                        "glosses": [
                                            "To emcee, to act as compere."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18e8646d-8a28-4738-a85c-a5290c1224d8",
                                                "sense_id": "d520e51f-5186-3869-b66e-c54e43056a9e",
                                                "text": "I will be compering for next week's Village Fete."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baee16ee-b581-45ce-aaf6-8c6abe756402",
                        "source_entry_id": "e61b6e6e-2e97-396f-aae0-14289146c5c6",
                        "source_sense_id": "a94c2447-dfc0-31e7-bc53-263a2957ba9a",
                        "target_lang_word": "ringmaster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ringmaster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed94e4db-ca0f-3d8a-85cf-7de48564df2e",
                                        "entry_id": "14105789-6b26-3486-b788-252ca9c76745",
                                        "glosses": [
                                            "The person who manages the performers in a circus ring."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cb56368-eee0-3bd8-9ac6-56fb5b97c25a",
                                        "entry_id": "14105789-6b26-3486-b788-252ca9c76745",
                                        "glosses": [
                                            "The person who maintains a webring."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0ff73e4-760b-437a-b65e-6cd85196631c",
                                                "sense_id": "6cb56368-eee0-3bd8-9ac6-56fb5b97c25a",
                                                "text": "Individuals looking to add their own homepage to a particular ring are, however, more or less at the mercy of the ringmaster, who often maintains a ring homepage listing its acceptance (or membership) policies and an index of its member sites."
                                            },
                                            {
                                                "example_id": "fb95330d-278f-4e15-b54c-b69e5bb847fc",
                                                "sense_id": "6cb56368-eee0-3bd8-9ac6-56fb5b97c25a",
                                                "text": "Each of the member websites in a webring had a navigation area at the bottom of the page that had “next” and “previous” buttons directing surfers to other sites in the ring. […] People needed ringmasters because the number of sites aimed at women was exploding."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ringmaster",
                                "target_lang_code": "en",
                                "target_senses": [
