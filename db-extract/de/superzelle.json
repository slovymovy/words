                ],
                "senses": [
                    {
                        "sense_id": "fc1b4966-2c00-3e81-86b9-fae6eaefc82a",
                        "entry_id": "28ad08f6-2c37-3ce4-ae34-9f3a369fc5b4",
                        "glosses": [
                            "Ansammlung von einzelnen Gewitterzellen, die durch ihren hohen Grad an organisierter Struktur ausgezeichnet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d4f3b8e-ae67-4dcc-9076-4d9dd04a43f0",
                                "sense_id": "fc1b4966-2c00-3e81-86b9-fae6eaefc82a",
                                "text": "Die Meteorologen versuchen so nahe wie möglich an das Zentrum der Superzelle heranzukommen."
                            },
                            {
                                "example_id": "b4e7395b-c71e-4a60-90fc-bea2109d3e9d",
                                "sense_id": "fc1b4966-2c00-3e81-86b9-fae6eaefc82a",
                                "text": "„Während ein Wärmegewitter eine begrenzte Menge feuchter Luft umsetzt und abstirbt, wenn dieser Vorrat erschöpft ist, bewegt sich die Superzelle deutlich nach links oder rechts von der mittleren Windrichtung, führt dabei dem Hauptaufwind immer neue feuchte Luft zu und erreicht so Lebenszeiten von mehreren Stunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4dca91f8-5b96-42da-b229-eb76397264e0",
                        "source_entry_id": "28ad08f6-2c37-3ce4-ae34-9f3a369fc5b4",
                        "source_sense_id": "fc1b4966-2c00-3e81-86b9-fae6eaefc82a",
                        "source_sense_description": "Ansammlung von einzelnen Gewitterzellen",
                        "target_lang_word": "supercell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supercell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d2505f1-01cd-3f61-841a-9f9439db987c",
                                        "entry_id": "f937526c-4726-32c4-890e-a5f97bb49a95",
                                        "glosses": [
                                            "A severe thunderstorm with updrafts and downdrafts that are in near balance, allowing the storm to maintain itself for several hours. Supercells often produce large hail, powerful downpours, very strong winds and sometimes tornadoes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cebd174-0985-4da8-93a9-24507c4d8bb1",
                                                "sense_id": "1d2505f1-01cd-3f61-841a-9f9439db987c",
                                                "text": "They watched the supercell that spawned the F5 killer that struck Oklahoma City spit out one tornado after another. In two cases, the researchers believe, the Dopplers captured tornadoes being formed — including the Oklahoma City monster."
                                            },
                                            {
                                                "example_id": "6792929a-4c5a-4d2a-ad83-20b231d0a833",
                                                "sense_id": "1d2505f1-01cd-3f61-841a-9f9439db987c",
                                                "text": "The storm system was a supercell, the kind that brew the deadliest tornadoes and most damaging hail in the United States, said Walker Ashley[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55fe80b6-10c4-3e97-abf5-4b4d20bdf0fc",
                                        "entry_id": "f937526c-4726-32c4-890e-a5f97bb49a95",
                                        "glosses": [
                                            "A repeating unit cell of a crystal that contains several primitive cells."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
