                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a4dfc2-6ee9-42dc-b272-66ca7ccea259",
                                "sense_id": "61307a50-2268-340c-9926-307f5a58250e",
                                "text": "– Chez toi, dans ta propriété fâmiliâle ? circonflexe Bertrand."
                            },
                            {
                                "example_id": "ce72d634-034c-4393-9caf-0db5486748e7",
                                "sense_id": "61307a50-2268-340c-9926-307f5a58250e",
                                "text": "Grmbl, j'arrive pas à circonflexer mes voyelles dans ce textarea fache."
                            },
                            {
                                "example_id": "e4b3b2aa-e13b-44fa-b131-fa75d85ed84c",
                                "sense_id": "61307a50-2268-340c-9926-307f5a58250e",
                                "text": "Vous excuserez mes non accents circonflexes, ils ne marchent que pour faire des smileys, et pas pour circonflexer une lettre."
                            }
                        ]
                    },
                    {
                        "sense_id": "0599b531-47d4-3d58-8f76-4b8d755da92f",
