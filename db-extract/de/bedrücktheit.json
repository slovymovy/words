                "senses": [
                    {
                        "sense_id": "f3834158-a82b-3955-909f-f15a5dba074d",
                        "entry_id": "ef4d107d-3587-3515-88b1-78cd2a72ea92",
                        "glosses": [
                            "Eigenschaft/Verfassung, niedergeschlagen zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d896f3c1-8e85-4e4d-bb1b-e1fb5d461372",
                                "sense_id": "f3834158-a82b-3955-909f-f15a5dba074d",
                                "text": "„Im Rostowschen Hause herrschte jene Atmosphäre poetisch verklärter Langeweile, Bedrücktheit und Schweigsamkeit, die ein Brautpaar immer zu umgeben pflegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b54ff14e-3808-4c66-8b20-85740170bb5f",
                        "source_entry_id": "ef4d107d-3587-3515-88b1-78cd2a72ea92",
                        "source_sense_id": "f3834158-a82b-3955-909f-f15a5dba074d",
                        "source_sense_description": "Eigenschaft/Verfassung, niedergeschlagen zu sein",
                        "target_lang_word": "despondency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despondency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "379d3fe6-9e7c-3858-ba22-20e5dc2add47",
                                        "entry_id": "bfeb0b6c-8ea1-3c6b-9d3e-0b6c98dd77c1",
                                        "glosses": [
                                            "The loss of hope or confidence; despair or dejection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f427d4c-5324-4237-98c4-8ae1b16524f0",
                                                "sense_id": "379d3fe6-9e7c-3858-ba22-20e5dc2add47",
                                                "text": "Not everyone succumbed to such nostalgia and despondency. Some saw the existential threat to Scots as a call to document what remained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c07e5ba-8b72-356c-b0f0-7fd0798878a9",
                                        "entry_id": "bfeb0b6c-8ea1-3c6b-9d3e-0b6c98dd77c1",
                                        "glosses": [
                                            "A feeling of depression or disheartenment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cefcf8b1-17e8-41f1-a01e-f14ef0a831e0",
                                                "sense_id": "4c07e5ba-8b72-356c-b0f0-7fd0798878a9",
                                                "text": "He kissed her brow, and left her. She watched him unconsciously, till the winding walk hid him from her sight, and then sank back on her seat, every nerve relaxing from its high-strained excitement into utter and still despondency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
