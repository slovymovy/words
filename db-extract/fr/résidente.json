                    {
                        "sense_id": "2f5022f2-8f9d-3dd3-a2c7-659aaad9ed0f",
                        "entry_id": "65760e82-f4cc-3615-918f-a8900809fcf8",
                        "glosses": [
                            "Habitante, femme qui réside quelque part."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e6ac947-6e40-4efb-9c28-3a34d2f33061",
                                "sense_id": "2f5022f2-8f9d-3dd3-a2c7-659aaad9ed0f",
                                "text": "Madame Declerc n’est pas une résidente comme les autres, c’est aussi l’ancienne gardienne de cet immeuble."
                            },
                            {
                                "example_id": "acb82c6e-ed2f-4791-9ff4-220ee4828719",
                                "sense_id": "2f5022f2-8f9d-3dd3-a2c7-659aaad9ed0f",
                                "text": "Il allait devoir arbitrer, une fois de plus, un différend entre deux résidentes de Bois-Joli, dont les susceptibilités étaient également à ménager : la comtesse de Raynouard, pensionnaire, et Yolande Beaucor, l’infirmière-major."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec7cbfa0-5ec7-3253-ab0b-f0423a24946d",
                        "entry_id": "65760e82-f4cc-3615-918f-a8900809fcf8",
                        "glosses": [
                            "Femme établie à demeure dans un pays étranger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc32c520-9a67-46e7-9526-10a209b15abb",
                                "sense_id": "ec7cbfa0-5ec7-3253-ab0b-f0423a24946d",
                                "text": "Les résidentes françaises au Canada, en Australie."
                            }
                        ]
                    }
                ],
