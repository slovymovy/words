                        "source_sense_id": "1fa10019-d20e-320c-a219-64f0d1ac5a68",
                        "target_lang_word": "anodizar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anodizar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "907bb9cd-8a1a-3ad6-8601-62866196ea12",
                                        "entry_id": "2ed0489a-148f-39d2-96fd-72b40df38013",
                                        "glosses": [
                                            "Someter algo a electrólisis para que su superficie quede recubierta por una película metálica que brindará protección, resistencia y durabilidad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a537f7f5-2bdb-40d7-9dc1-1e8ef3610274",
                                                "sense_id": "907bb9cd-8a1a-3ad6-8601-62866196ea12",
                                                "text": "«Esta evacuación se puede hacer por tres medios:\n—Radiación. Se procede a ennegrecer y anodizar el radiador, al ser el color negro el que más calor radia.\n—Conducción. Se realiza dotando al radiador de la mayor superficie posible.\n—Convección. En este caso, lo que suele hacerse es provocar corrientes de aire entre las aletas del propio radiador»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35b66995-723e-457d-a9fd-ec18219d83a5",
                        "source_entry_id": "6e3b80de-0fb7-377c-91fb-8125feba787a",
