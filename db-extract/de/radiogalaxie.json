                "senses": [
                    {
                        "sense_id": "cfcd6e99-cfa7-3fe6-a262-7e8fee8d7ee7",
                        "entry_id": "3c8a0c8c-40ab-3413-aa6e-d7fde3d4eafc",
                        "glosses": [
                            "Galaxie mit ungewöhnlich hoher Strahlungsleistung im Radiofrequenzbereich, welche bis zu eine Million mal stärker sein kann als bei normalen Galaxien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e53bb98-f1dd-45f3-a440-0ea6e683a12b",
                                "sense_id": "cfcd6e99-cfa7-3fe6-a262-7e8fee8d7ee7",
                                "text": "„Es sind Gebilde mit einem Durchmesser von ein paar Lichtjahren, die jedoch Radiowellen mit einer Intensität abstrahlen, wie man sie sonst nur von Systemen aus hundert Milliarden Sternen, den sogenannten Radiogalaxien, kennt.“"
                            },
                            {
                                "example_id": "73179a2b-09a0-41c9-b420-dac1f83c4b7e",
                                "sense_id": "cfcd6e99-cfa7-3fe6-a262-7e8fee8d7ee7",
                                "text": "„Das kosmische Objekt ist den Angaben zufolge so schwer wie 200 Millionen Sonnen. Es befindet sich im Zentrum der rund elf Millionen Lichtjahre entfernten Galaxie ‚Centaurus A‘, der erdnächsten und am wohl besten untersuchten Radiogalaxie im Universum, berichtete die Eso in Garching.“"
                            },
                            {
                                "example_id": "32a5a1fb-3e86-4bba-b133-29537666531a",
                                "sense_id": "cfcd6e99-cfa7-3fe6-a262-7e8fee8d7ee7",
                                "text": "„Im Gegensatz zu Radiogalaxien haben Quasare keine Ähnlichkeit mit gewöhnlichen Sternsystemen; auch emittieren 90 Prozent von ihnen – ganz im Gegensatz zu ihrem Namen – keine Strahlung im Radiofrequenzbereich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
