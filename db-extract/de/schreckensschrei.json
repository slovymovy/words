                "senses": [
                    {
                        "sense_id": "d8f897df-7741-3eeb-a13b-34787576e3b0",
                        "entry_id": "80f1515d-6c02-3ddb-8b8e-7ed961d9cda3",
                        "glosses": [
                            "Schrei, ausgelöst durch Erschrecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4ef2a3f-9c03-489b-aafe-65196279b689",
                                "sense_id": "d8f897df-7741-3eeb-a13b-34787576e3b0",
                                "text": "„Bei meinem plötzlichen Eintritt stieß er einen Schreckensschrei aus und verlor völlig die Fassung.“"
                            },
                            {
                                "example_id": "3564879a-76cb-412c-a2b0-15403d391562",
                                "sense_id": "d8f897df-7741-3eeb-a13b-34787576e3b0",
                                "text": "„Schreckensschreie wurden laut.“"
                            },
                            {
                                "example_id": "f893a330-2ce0-4902-9802-682a5c1eee2e",
                                "sense_id": "d8f897df-7741-3eeb-a13b-34787576e3b0",
                                "text": "„Nur mit Mühe konnte ich einen Schreckensschrei unterdrücken.“"
                            },
                            {
                                "example_id": "070e894e-2472-466b-a117-3649c01bf3b0",
                                "sense_id": "d8f897df-7741-3eeb-a13b-34787576e3b0",
                                "text": "„Ein Schreckensschrei riss John und Madge Grant gleichzeitig aus dem Schlaf.“"
                            },
                            {
                                "example_id": "5faeeaee-07d4-42b9-8b36-af3cced78dea",
                                "sense_id": "d8f897df-7741-3eeb-a13b-34787576e3b0",
                                "text": "„Der Wachposten an der Palisade antwortete mit einem Schreckensschrei auf den ersten - es war der Schrei eines Mädchens in Todesangst gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
