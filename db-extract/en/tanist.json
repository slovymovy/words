                "senses": [
                    {
                        "sense_id": "b9c683c6-1d00-3010-9c81-9211577f2783",
                        "entry_id": "6d3595e9-2baa-34cf-be92-eefd7cd82b53",
                        "glosses": [
                            "The heir presumptive to the chieftainship or kingship of a Celtic clan in ancient Ireland, Scotland or Mann."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e4163594-7930-4148-9349-20d952dfa53a",
                                "sense_id": "b9c683c6-1d00-3010-9c81-9211577f2783",
                                "text": "Lover, for her love he prowled with colonel Richard Burke, tanist of his sept, under the walls of Clerkenwell and, crouching, saw a flame of vengeance hurl them upward in the fog."
                            },
                            {
                                "example_id": "feba4b42-ec3c-4780-b7bf-4af0e3e4d75d",
                                "sense_id": "b9c683c6-1d00-3010-9c81-9211577f2783",
                                "text": "In 1570 Dermot died at 'his own house' of Castle Inch. His brother and tanist, Cormac Mac Teige (fourteenth Lord), succeeded him (Ó Murchadha, p. 16)."
                            },
                            {
                                "example_id": "cbde5e1c-8e2e-4fb1-ae6a-d5f9b7c4cc80",
                                "sense_id": "b9c683c6-1d00-3010-9c81-9211577f2783",
                                "text": "As a result of the universal introduction of the English common law, therefore, the original tanist acquired a common law title to the disputed land 'without grant or confirmation of the conqueror'."
                            }
                        ]
                    }
                ],
