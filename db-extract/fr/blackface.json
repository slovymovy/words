            {
                "entry_id": "20d7a550-773a-349d-886b-98af75135307",
                "word": "blackface",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1e7e8184-05a2-46b3-b2af-8410455a5874",
                        "entry_id": "20d7a550-773a-349d-886b-98af75135307",
                        "tags": [
                            "plural"
                        ],
                        "form": "blackfaces"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3e4471f-9e76-34d7-a2f6-0114f5cc77a3",
                        "entry_id": "20d7a550-773a-349d-886b-98af75135307",
                        "glosses": [
                            "Race de mouton ayant la particularité d’avoir une tête noire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ed441df-cea8-4489-bda3-8ac03931cbc3",
                                "sense_id": "e3e4471f-9e76-34d7-a2f6-0114f5cc77a3",
                                "text": "Le Blackface est parfait pour ce genre de travail car il est habitué à grimper sur des collines en Ecosse et à se balader dans les Landes."
                            },
                            {
                                "example_id": "3c0e8ad1-bec2-4232-a3ff-406fcac6092a",
                                "sense_id": "e3e4471f-9e76-34d7-a2f6-0114f5cc77a3",
                                "text": "Pour cela, John est resté fidèle à la race locale, la blackface."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9c81d62-c4dc-3b44-ae7f-b6af6ef57e44",
                        "entry_id": "20d7a550-773a-349d-886b-98af75135307",
                        "glosses": [
                            "Fait de se maquiller en noir pour ressembler à une personne noire, pour le théâtre ou le cinéma, ou pour des moqueries racistes."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "e0cad9ea-d930-45e0-8b02-06ba5161e9bf",
                                "sense_id": "c9c81d62-c4dc-3b44-ae7f-b6af6ef57e44",
                                "text": "Le “blackface” – se grimer en noir pour se moquer des Noirs – est une pratique que nous condamnons avec la plus grande fermeté."
                            },
                            {
                                "example_id": "457cf7e5-341d-4560-98f7-d709baecbb2d",
                                "sense_id": "c9c81d62-c4dc-3b44-ae7f-b6af6ef57e44",
                                "text": "Cette « blackface », mise en ligne sur Instagram, a fait sortir l’interprète de Djadja de ses gonds."
                            },
                            {
                                "example_id": "6934e19c-2977-4a80-8d1e-9e6980a6e736",
                                "sense_id": "c9c81d62-c4dc-3b44-ae7f-b6af6ef57e44",
                                "text": "Que se passera-t-il quand des zélés découvriront les épisodes autour de Lucie Baptiste et le fait que les joueurs du National de Québec décident de faire ce qu’on appelle aujourd’hui un blackface pour montrer leur acceptation des Noirs et leur condamnation du racisme ?"
                            },
                            {
                                "example_id": "32975419-3e87-4466-843d-5b8a235261b8",
                                "sense_id": "c9c81d62-c4dc-3b44-ae7f-b6af6ef57e44",
                                "text": "Les autres gosses du film sont plus inexistants les uns que les autres. Parmi eux, on distinguera juste un petit Iranien maquillé en Noir via un blackface très Birth of a Nation-approved."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caf50e54-19b7-49aa-a7f6-51f191db4d34",
                        "source_entry_id": "20d7a550-773a-349d-886b-98af75135307",
                        "source_sense_id": "e3e4471f-9e76-34d7-a2f6-0114f5cc77a3",
                        "source_sense_description": "Race de mouton",
                        "target_lang_word": "blackface",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blackface",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c58550a-db74-3370-986f-22971a8115fe",
                                        "entry_id": "149ad736-fcb6-33e5-92b5-61443c56d1a3",
                                        "glosses": [
                                            "The practice in which a nonblack person blackens their face using theatrical makeup in order to portray a caricature of a black person."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98b3b9b4-527e-4f5a-998a-bb1216f18963",
                                                "sense_id": "0c58550a-db74-3370-986f-22971a8115fe",
                                                "text": "Soberano hit back at Instagram comments, writing, \"This is not any form of blackface.\" But has since backtracked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f427e95d-aa39-34e6-b071-3c6c9fb0d868",
