        "fr-extract.jsonl": [
            {
                "entry_id": "145b4f48-eaa5-3fca-97e0-83b06fba7030",
                "word": "doryphore",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6e746a89-4450-4437-bbde-9ccc366c4958",
                        "entry_id": "145b4f48-eaa5-3fca-97e0-83b06fba7030",
                        "tags": [
                            "plural"
                        ],
                        "form": "doryphores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf971269-aca9-3139-824d-e916efdf901e",
                        "entry_id": "145b4f48-eaa5-3fca-97e0-83b06fba7030",
                        "glosses": [
                            "Lancier, soldat porteur de lance dans certaines armées grecques."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "8cc2140b-44c3-4060-941d-11e23d14181a",
                                "sense_id": "cf971269-aca9-3139-824d-e916efdf901e",
                                "text": "L’armée du roi se compose de soixante mille combattans, cent trirèmes et une quantité innombrable de vaisseaux de transport. Il a en outre mille doryphores couverts d’armures en or, et quatre-vingts chars de guerre."
                            },
                            {
                                "example_id": "e82d77c3-3b01-4501-9db8-739ea0641aa3",
                                "sense_id": "cf971269-aca9-3139-824d-e916efdf901e",
                                "text": "À la mi-décembre, les Byzantins marchent vers la seconde armée vandale. Les doryphores et les hypapistes de la garde à cheval chargent et dispersent les hommes de Tzazo, qui tombe dans la mêlée."
                            }
                        ]
                    },
                    {
                        "sense_id": "0aa2744a-3cda-3a0c-824d-9a09a7802d6b",
                        "entry_id": "145b4f48-eaa5-3fca-97e0-83b06fba7030",
                        "glosses": [
                            "Statue qui représente ce soldat."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8b59db53-398a-40c2-bb65-77a5dc6a222d",
                                "sense_id": "0aa2744a-3cda-3a0c-824d-9a09a7802d6b",
                                "text": "Cette statue du Doryphore ou Porte-Lance était étudiée par tous les artistes grecs; et Lysippe lui-même, orfèvre dans sa jeunesse, disait qu'elle l'avait fait sculpteur : non parce t’elle créait un type qui devait sans cesse être reproduit, mais, au contraire, parce que cette statue avait la vérité pour base, et qu'elle démontrait comment on devait saisir la nature par ses plans, ses grandes divisions, en un mot, par ses grands aspects."
                            },
                            {
                                "example_id": "b517c99a-1521-42c7-8a27-4748c0d4ed43",
                                "sense_id": "0aa2744a-3cda-3a0c-824d-9a09a7802d6b",
                                "text": "Le plus célèbre des canons grecs est celui de Polyclète (quatre siècles et demi avant J. C.), qui avait composé un Traité des proportions, avec un modèle de marbre très-connu sous le nom de Doryphore, ou porte-lance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cecbea2-00bf-4a28-b08a-d9b8d55e3b50",
                        "source_entry_id": "145b4f48-eaa5-3fca-97e0-83b06fba7030",
                        "target_lang_word": "Doryphoros",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "22a20241-ffaa-44ed-9849-144597961bef",
                        "source_entry_id": "145b4f48-eaa5-3fca-97e0-83b06fba7030",
