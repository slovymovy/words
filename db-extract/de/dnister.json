                "senses": [
                    {
                        "sense_id": "68d4e6a7-a7d5-3c83-bc68-2b880c4d154d",
                        "entry_id": "b92bcf0e-adad-34a5-bfa9-cac51c36ebaf",
                        "glosses": [
                            "ukrainisch-moldawischer Zufluss zum Schwarzen Meer"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "475f4fa8-ec04-43dc-9658-458295509565",
                                "sense_id": "68d4e6a7-a7d5-3c83-bc68-2b880c4d154d",
                                "text": "„Der Dnister ist nicht einfach nur ein Fluss. Er ist die Landesgrenze eines Staates, den es eigentlich nicht gibt.“"
                            },
                            {
                                "example_id": "f680932f-7230-4e2b-878d-527244c3da58",
                                "sense_id": "68d4e6a7-a7d5-3c83-bc68-2b880c4d154d",
                                "text": "„Westlich des Dnister ist Rumänisch die offizielle Amtssprache.“"
                            },
                            {
                                "example_id": "483a9ee8-b276-4d07-8c66-1acf8c48c16c",
                                "sense_id": "68d4e6a7-a7d5-3c83-bc68-2b880c4d154d",
                                "text": "„Heute hat die Regierung in Chişinău die Kontrolle über das Territorium östlich des Dnister verloren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
