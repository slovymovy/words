                        "glosses": [
                            "A term or turn of phrase, such as a euphemism, that puts a positive or negative slant on something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c66f8a1-8899-4e59-b0bb-a5454b2c2c8e",
                                "sense_id": "e3fa2f9a-86df-3216-9807-f57214de1383",
                                "text": "Slanters turn off those you want to convince — it's like preaching to the converted. Worse, though they may work for the moment, they don't stick. Without reinforcement, the other person will remember only the joke or jibe."
                            },
                            {
                                "example_id": "d49ad0df-41c8-4ebf-9cb8-06306ac7618e",
                                "sense_id": "e3fa2f9a-86df-3216-9807-f57214de1383",
                                "text": "Downplayers, like weaselers, innuendo, loaded questions, and other slanters, can be used intentionally to make something less significant or worthy than it is. In other situations their use adds spark and perhaps a bit of humor […]"
                            }
                        ]
                    }
