                ],
                "senses": [
                    {
                        "sense_id": "b65dc75c-19b0-3987-a045-06cd3e55bfdc",
                        "entry_id": "6a36ff5a-1d98-393f-996e-6b57354de269",
                        "glosses": [
                            "Substance facilitant ou augmentant les phénomènes d'anabolisme c’est-à-dire de production tissulaire notamment de la masse musculaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85af8036-1473-47cc-b76a-643977360dc9",
                                "sense_id": "b65dc75c-19b0-3987-a045-06cd3e55bfdc",
                                "text": "Certains stéroïdes, considérés comme des anabolisants, sont utilisés comme dopants."
                            },
                            {
                                "example_id": "868c4835-b8c1-4acf-b8a8-e590fd947633",
                                "sense_id": "b65dc75c-19b0-3987-a045-06cd3e55bfdc",
                                "text": "Ses propriétés antiasthéniques de type anabolisant “naturel” ont conduit des body-builders à l’utiliser avec succès (comme le Tribulus terrestris) comme alternative naturelle aux anabolisants stéroïdiens et autres hormones."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6c73f7b-cdb5-493c-85f5-ea22fa07f289",
                        "source_entry_id": "6a36ff5a-1d98-393f-996e-6b57354de269",
                        "source_sense_id": "b65dc75c-19b0-3987-a045-06cd3e55bfdc",
                        "target_lang_word": "Anabolikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anabolikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2f05dec-a94a-33e6-9da8-be5660042380",
                                        "entry_id": "0c6b2124-3d35-36d4-b459-6f4132e1605c",
                                        "glosses": [
                                            "Substanz, die den Aufbaustoffwechsel (Anabolismus) anregt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a7c3fb-78da-4cf5-a236-09082c3f6235",
                                                "sense_id": "d2f05dec-a94a-33e6-9da8-be5660042380",
                                                "text": "„Anabolika werden nur selten therapeutisch eingesetzt, z. B. bei ausgeprägten Schwächezuständen.“"
                                            },
                                            {
                                                "example_id": "7b67c483-97ef-4d17-b608-e6f7bdffa003",
                                                "sense_id": "d2f05dec-a94a-33e6-9da8-be5660042380",
                                                "text": "„In der Humanmedizin verwendet man Anabolika vor allem im Rahmen der Therapie des hormonell bedingten Minderwuchses.“"
                                            },
                                            {
                                                "example_id": "ebf0f3bd-99a8-4efe-919f-ad365545b956",
                                                "sense_id": "d2f05dec-a94a-33e6-9da8-be5660042380",
                                                "text": "„Eine vielfache, illegale Anwendung finden Anabolika in einigen Sportarten.“"
                                            },
                                            {
                                                "example_id": "bc81741b-3e0a-43e5-a6db-d071d1d5bd5f",
                                                "sense_id": "d2f05dec-a94a-33e6-9da8-be5660042380",
                                                "text": "„In der Viehzucht werden in einigen Ländern Anabolika verarbeitet, um die Fleischmenge zu steigern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efda5aef-4ec9-4925-9c7b-45175d786ce5",
                        "source_entry_id": "6a36ff5a-1d98-393f-996e-6b57354de269",
                        "source_sense_id": "b65dc75c-19b0-3987-a045-06cd3e55bfdc",
