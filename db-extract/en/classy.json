                        ]
                    },
                    {
                        "sense_id": "ea707234-1636-3727-b6b3-2ceb981b241d",
                        "entry_id": "633cccee-ca76-3bdf-8e93-f669ebed6b66",
                        "glosses": [
                            "Of a superior type; especially, exhibiting admirable personal qualities."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8b2e366-a5d3-411a-8515-fa8169f74d60",
                                "sense_id": "ea707234-1636-3727-b6b3-2ceb981b241d",
                                "text": "Ignoring his coarse insults was a classy response."
                            },
                            {
                                "example_id": "bb319b90-d785-46f1-a98e-12dd5b93cc47",
                                "sense_id": "ea707234-1636-3727-b6b3-2ceb981b241d",
                                "text": "Manchester City put the Carlos Tevez saga behind them with a classy victory at Blackburn that keeps them level on points with leaders Manchester United."
                            }
                        ]
