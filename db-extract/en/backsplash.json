                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crédence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2b29def-042d-3eab-bc34-a4cac120369e",
                                        "entry_id": "73ff3909-c28e-31f9-80da-5caa2bd4a508",
                                        "glosses": [
                                            "Buffet, console qui sert à déposer les plats, les verres, dans une salle à manger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e18f2797-752b-4890-a4e6-b0f3b79ad45b",
                                                "sense_id": "d2b29def-042d-3eab-bc34-a4cac120369e",
                                                "text": "Sur les crédences en style de la Renaissance se dressaient des figures de sirènes, et les chaises en bois sculpté avaient des dossiers surmontés de têtes de femmes dans le goût Henri II."
                                            },
                                            {
                                                "example_id": "28ce7b9d-4c48-458a-8f4e-373a41eb4c13",
                                                "sense_id": "d2b29def-042d-3eab-bc34-a4cac120369e",
                                                "text": "L’objet de la présente monographie est un meuble appartenant à un type bien connu : la crédence provençale, également appelée buffet à glissants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28ed0084-2b4b-307f-ae67-289dd2cbc147",
                                        "entry_id": "73ff3909-c28e-31f9-80da-5caa2bd4a508",
                                        "glosses": [
                                            "Sorte de petite table ou de console qui est au côté de l’autel et où l’on met les burettes, le bassin et les autres choses qui servent à la messe ou à quelque cérémonie ecclésiastique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce8e5fe-5378-4ceb-acaf-343762c828b1",
                                                "sense_id": "28ed0084-2b4b-307f-ae67-289dd2cbc147",
                                                "text": "Il y a ordinairement deux crédences aux côtés de l’autel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f301683c-0fc2-3fa8-ad23-a998e7e4e468",
                                        "entry_id": "73ff3909-c28e-31f9-80da-5caa2bd4a508",
                                        "glosses": [
                                            "Partie du mur d’une cuisine située entre le plan de travail et les meubles hauts."
                                        ],
                                        "tags": [
                                            "Aménagement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14450e8b-315b-4888-b88e-c97cbf6bbaad",
                                                "sense_id": "f301683c-0fc2-3fa8-ad23-a998e7e4e468",
                                                "text": "Complétez votre espace cuisine avec nos crédences (standard, sur mesure, aimantées, modulables etc.) harmonisées avec votre plan de travail, pour protéger vos murs des projections et suspendre des accessoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f9d3117-1812-3958-80df-625467eca583",
                                        "entry_id": "73ff3909-c28e-31f9-80da-5caa2bd4a508",
                                        "glosses": [
                                            "Petite armoire à étagères dans laquelle sont rangés des objets, notamment religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ed1c11-dcda-4242-8bc2-1d165714c2d1",
                                                "sense_id": "7f9d3117-1812-3958-80df-625467eca583",
                                                "text": "Rangés dans une crédence, quelques tomes montraient leurs dos de vélin ou de basane estampée d’or fin ; c’étaient des ouvrages de dévotion que n’ouvrait personne ; il y avait longtemps que Martha avait sacrifié L'Institution chrétienne de Calvin, ce livre hérétique étant, comme le lui avait poliment fait remarquer Philibert, par trop compromettant."
                                            },
                                            {
                                                "example_id": "3470be60-615c-4882-9e12-2c90a04e4ff9",
                                                "sense_id": "7f9d3117-1812-3958-80df-625467eca583",
                                                "text": "Cette crédence renaissance? Et bien, quel embarras..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
