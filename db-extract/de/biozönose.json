                "senses": [
                    {
                        "sense_id": "c3902057-2462-3bb1-bb02-9addfb870447",
                        "entry_id": "35066260-a080-379e-b87f-2fcab70485d3",
                        "glosses": [
                            "Lebensgemeinschaft verschiedener Arten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf23466-104a-4c21-8414-fb3faf53e607",
                                "sense_id": "c3902057-2462-3bb1-bb02-9addfb870447",
                                "text": "Den von einer Biozönose bevölkerten Raum nennt man Biotop."
                            },
                            {
                                "example_id": "42f7f659-3562-4214-b8ae-ea0a1ede390a",
                                "sense_id": "c3902057-2462-3bb1-bb02-9addfb870447",
                                "text": "„Eine Biozönose ist die Gesamtheit der Organismen verschiedener Arten in einer lokalen Einheit, insbesondere insofern sie miteinander interagieren oder sogar ein System von wechselseitig voneinander abhängigen Populationen, d.h., oberhalb der Ebene der Organismen, ein organisiertes System zweiter Ordnung bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "616da002-6509-4ca5-99e2-46fc7d5c436e",
                        "source_entry_id": "35066260-a080-379e-b87f-2fcab70485d3",
                        "source_sense_id": "c3902057-2462-3bb1-bb02-9addfb870447",
                        "source_sense_description": "Biologie: Lebensgemeinschaft verschiedener Arten",
