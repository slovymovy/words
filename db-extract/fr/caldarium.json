                        "glosses": [
                            "Partie la plus chaude des thermes romains ; équivalent antique du hammam ou du sauna."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80b9c0d-b210-433a-b84a-f30c7bafa072",
                                "sense_id": "fccf3899-e22a-3437-aa69-0e68055cb647",
                                "text": "Dans les bains les plus anciens, de simples braseros placés dans le caldarium procuraient la chaleur."
                            },
                            {
                                "example_id": "a60f12df-1abb-404f-94e5-84849759ce7d",
                                "sense_id": "fccf3899-e22a-3437-aa69-0e68055cb647",
                                "text": "Un important caldarium de 20 m sur 13 m était chauffé par un foyer au nord et se terminait au sud par une abside large de cinq mètres, qui abritait un labrum en marbre blanc."
                            }
                        ]
                    }
