                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab26c87c-5faa-373b-829b-49211fb83775",
                                        "entry_id": "75c9d658-5125-33be-af58-48f519d411dd",
                                        "glosses": [
                                            "The plate used to hold the host during the Eucharist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbf41736-058b-4cd2-953f-7c31d7aafbbc",
                                                "sense_id": "ab26c87c-5faa-373b-829b-49211fb83775",
                                                "text": "An enameled miniature of Christ is set in the center of a jeweled alabaster paten, the plate that holds the bread during Communion services."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5df08d30-f925-34e3-b594-0b861b7bd53a",
                                        "entry_id": "75c9d658-5125-33be-af58-48f519d411dd",
                                        "glosses": [
                                            "Any shallow dish found in an archaeological site."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9ff49be-6637-4c21-9f80-3b1b023360ac",
                        "source_entry_id": "3652c931-5c16-316e-8183-42060399bc13",
                        "source_sense_id": "6eb4ec02-d122-3bde-81f7-8b51a11a7cbe",
                        "target_lang_word": "patten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fd5f3f6-ba76-3745-901b-8214d6b26a08",
                                        "entry_id": "5d7ac34d-9f93-351b-94b4-8de435c7f424",
                                        "glosses": [
                                            "To go about wearing pattens."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "patten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ad74207-e784-3adf-971a-6af9936a26fa",
                                        "entry_id": "df0f40b1-84f1-389b-b72d-785dca701948",
                                        "glosses": [
                                            "Any of various types of footwear with thick soles, often used to elevate the foot, especially wooden clogs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad52e3f-b59c-45e2-8a85-3df153c2c1ac",
                                                "sense_id": "4ad74207-e784-3adf-971a-6af9936a26fa",
                                                "text": "I went and told part of the excise money till twelve o’clock, and then called on my wife and took her to Mr. Pierces, she in the way being exceedingly troubled with a pair of new pattens, and I vexed to go so slow, it being late."
                                            },
                                            {
                                                "example_id": "e1b0b9c3-79a4-4ce6-b83b-a0eed34342fd",
                                                "sense_id": "4ad74207-e784-3adf-971a-6af9936a26fa",
                                                "text": "Tom Freckle, the smith's son, was the next victim to her rage. He was an ingenious workman, and made excellent pattens; nay, the very patten with which he was knocked down was his own workmanship."
                                            },
                                            {
                                                "example_id": "ac519b8a-a6f0-4faa-be99-a214ae79a063",
                                                "sense_id": "4ad74207-e784-3adf-971a-6af9936a26fa",
                                                "text": "\"I fear there is a chase; I think I hear three or four galloping together; I am sure I hear more horses than one.\" / \"Pooh, pooh, it is the wench of the house that is clattering to the well in her pattens; [...].\""
                                            },
                                            {
                                                "example_id": "7d8b3356-e0a2-4ebf-b841-c15ac0082823",
                                                "sense_id": "4ad74207-e784-3adf-971a-6af9936a26fa",
                                                "text": "Nobody had appeared belonging to the house except a person in pattens, who had been poking at the child from below with a broom; I don't know with what object, and I don't think she did."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "081ad808-f8bf-3a80-b779-d187ba898b68",
                                        "entry_id": "df0f40b1-84f1-389b-b72d-785dca701948",
                                        "glosses": [
                                            "One of various wooden attachments used to lift a shoe above wet or muddy ground."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c034ed55-1d15-45f2-abda-4979eb312a09",
                                                "sense_id": "081ad808-f8bf-3a80-b779-d187ba898b68",
                                                "text": "They presented the most extraordinary and comic aspect imaginable, with their shaven heads and long beard; (the heads of all Mussulmen are shaved quite bare, with the exception of a tuft on the very top, which is left for the angel of the tomb on the day of judgment, say they, to grasp and carry them up to heaven by;) besides these, other objects are seen wrapped up in towels, with black grisled beards tickling their breasts, and tottering along on a high pair of pattens or rather stilts, at the imminent danger, as it appears, of breaking their necks."
                                            },
                                            {
                                                "example_id": "b2fc7f69-31b1-48ec-b697-6121e6e68379",
                                                "sense_id": "081ad808-f8bf-3a80-b779-d187ba898b68",
                                                "text": "Mrs. Peerybingle, going out into the raw twilight, and clicking over the wet stones in a pair of pattens that worked innumerable rough impressions of the first proposition in Euclid all about the yard—Mrs. Peerybingle filled the kettle at the water-butt."
                                            },
                                            {
                                                "example_id": "050a3235-a046-4e04-b2e8-b53b2e899666",
                                                "sense_id": "081ad808-f8bf-3a80-b779-d187ba898b68",
                                                "text": "The doors are many-belled: and crowds of dirty children form endless groups about the steps: or around the shell-fish dealers’ trays in these courts; whereof the damp pavements resound with pattens, and are drabbled with a never-failing mud."
                                            },
                                            {
                                                "example_id": "d8e68b22-b3be-421e-a379-02b779846ed6",
                                                "sense_id": "081ad808-f8bf-3a80-b779-d187ba898b68",
                                                "text": "I suppose that those who ramble beyond railways may yet come upon females underpinned with the useful and once indispensable pattens, but for a long time it has not been my lot to look upon a pair. Goloshes, clogs, cork-soles, and other inventions, have quite superseded the noisy old resource ; and I am not sure that the modern appliances could make out a perfect claim to superiority over the old, for the pattens not only kept the feet dry, they also, by raising the wearer from one to two inches, kept the garments out of the mire."
                                            },
                                            {
                                                "example_id": "b6d6bd5d-2471-48ff-a706-4615c2886fde",
                                                "sense_id": "081ad808-f8bf-3a80-b779-d187ba898b68",
                                                "text": "Pair of Woman's Pattens, c. 1700-80 A pair of woman's pattens, wooden soles riveted to wrought iron platforms with straps of brown leather lined with off-white wool."
                                            },
                                            {
                                                "example_id": "af70d895-4041-4da8-adae-c0563506b284",
                                                "sense_id": "081ad808-f8bf-3a80-b779-d187ba898b68",
                                                "text": "The servant, who wasn't able to reach the flying coach, picked the patten [translating chianiello] up from the ground and brought it to the king, telling him what had happened."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ac35bba-a2ad-30d4-9ef6-bf3ac98eda68",
                                        "entry_id": "df0f40b1-84f1-389b-b72d-785dca701948",
                                        "glosses": [
                                            "A circular wooden plank attached to a horse's foot to prevent it from sinking into a bog while plowing."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "736b007d-c784-4506-9b45-4d0b6801a08b",
                                                "sense_id": "4ac35bba-a2ad-30d4-9ef6-bf3ac98eda68",
                                                "text": "At and in the neighbourhood of North Meoks, near Ormskirk in Lancashire, there is a whole country of peat, and how deep this soil is God only knows, for the horses which plough thereon wear pattens to keep them from sinking to the bellies: here I was not long ago deluded, by my ignorance of the country and a team in pattens, to attempt riding over ploughed ground to inquire my way."
                                            },
                                            {
                                                "example_id": "c0d53b55-413e-495d-856f-60315dd54f1a",
                                                "sense_id": "4ac35bba-a2ad-30d4-9ef6-bf3ac98eda68",
                                                "text": "Some trials have been made in Ireland to put pattens on bullocks instead of horses, for ploughing on bog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc6262a3-e4e3-3c4b-a609-6c655b3d528c",
                                        "entry_id": "df0f40b1-84f1-389b-b72d-785dca701948",
                                        "glosses": [
                                            "An ice skate."
                                        ],
                                        "tags": [
                                            "British",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c7b9530-8ef4-3bbb-8498-0e5d93919cff",
                                        "entry_id": "df0f40b1-84f1-389b-b72d-785dca701948",
                                        "glosses": [
                                            "An iron hoop attached to a person's boot in cases of hip-joint disease."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2d15584-d1c8-3b33-9070-aa2eb431b51f",
                                        "entry_id": "df0f40b1-84f1-389b-b72d-785dca701948",
                                        "glosses": [
                                            "The base of a pillar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
