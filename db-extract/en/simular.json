                        "glosses": [
                            "One who pretends to be what he is not; one who, or that which, simulates or counterfeits something; a pretender."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6cb117c8-649c-4b85-b07f-9d463829f448",
                                "sense_id": "0933fb65-5f44-349a-9e82-fbdee90c0bb6",
                                "text": "Hide thee, thou bloody hand,\n Thou perjured, and thou simular of virtue\n That art incestuous."
                            },
                            {
                                "example_id": "46b1a97e-f2f7-45ae-9150-5fa1f605123e",
                                "sense_id": "0933fb65-5f44-349a-9e82-fbdee90c0bb6",
                                "text": "Christ calleth the Pharisees hypocrites, that is to say, simulars, and painted sepulchres."
                            }
                        ]
                    }
