{
    "word_family": [
        "enchanter",
        "enchantment",
        "enchanting",
        "enchantress",
        "disenchant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3fb26a01-a145-33cf-918a-3877f43ac7a6",
                    "sense_definition": "To attract and delight someone greatly; to charm or captivate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "charm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beautiful scenery of the mountains will <w>enchant</w> any visitor who loves nature.",
                            "target_lang_translations": {
                                "ru": "Прекрасные горные пейзажи <w>очаруют</w> любого посетителя, любящего природу."
                            }
                        },
                        {
                            "text": "She managed to <w>enchant</w> the audience with her incredible singing voice and stage presence.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>пленить</w> публику своим невероятным певческим голосом и умением держаться на сцене."
                            }
                        }
                    ],
                    "synonyms": [
                        "captivate"
                    ],
                    "antonyms": [
                        "repel",
                        "bore"
                    ],
                    "common_phrases": [
                        "enchant the audience",
                        "enchant the crowd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно привлекать и радовать кого-либо; очаровывать или пленять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаровывать",
                                "target_lang_sense_clarification": "вызывать восторг"
                            },
                            {
                                "target_lang_word": "восхищать",
                                "target_lang_sense_clarification": "приводить в восторг"
                            },
                            {
                                "target_lang_word": "пленять",
                                "target_lang_sense_clarification": "сильно привлекать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04b58638-53a0-39bc-b849-8ea88ff97e03",
                    "sense_definition": "To put someone or something under a magical spell.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the fairy tale, the wicked witch tried to <w>enchant</w> the prince to make him forget his home.",
                            "target_lang_translations": {
                                "ru": "В сказке злая ведьма пыталась <w>заколдовать</w> принца, чтобы тот забыл о своем доме."
                            }
                        },
                        {
                            "text": "The wizard used a powerful melody to <w>enchant</w> the guards and slip past them unnoticed.",
                            "target_lang_translations": {
                                "ru": "Волшебник использовал мощную мелодию, чтобы <w>околдовать</w> стражников и незаметно проскользнуть мимо них."
                            }
                        }
                    ],
                    "synonyms": [
                        "captivate"
                    ],
                    "common_phrases": [
                        "enchant with a spell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наложить на кого-либо или что-либо магическое заклинание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заколдовывать",
                                "target_lang_sense_clarification": "накладывать чары"
                            },
                            {
                                "target_lang_word": "зачаровывать",
                                "target_lang_sense_clarification": "подчинять чарам"
                            },
                            {
                                "target_lang_word": "околдовывать",
                                "target_lang_sense_clarification": "магическое воздействие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fce713f3-a8bc-3f19-af87-8ba8d4cda23e",
                    "sense_definition": "To magically improve or change the properties of an item, often in a gaming context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to gather rare materials if you want to <w>enchant</w> your sword with fire damage.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно собрать редкие материалы, если ты хочешь <w>зачаровать</w> свой меч на урон огнем."
                            }
                        },
                        {
                            "text": "The player decided to <w>enchant</w> an item to make it more durable for the upcoming battle.",
                            "target_lang_translations": {
                                "ru": "Игрок решил <w>зачаровать</w> предмет, чтобы сделать его более прочным для предстоящей битвы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enchant an item",
                        "enchant your sword"
                    ],
                    "target_lang_definitions": {
                        "ru": "Магическим образом улучшать или изменять свойства предмета, часто в игровом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зачаровывать",
                                "target_lang_sense_clarification": "улучшать предмет магией"
                            },
                            {
                                "target_lang_word": "энчантить",
                                "target_lang_sense_clarification": "игровой сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36307f56-e96e-31a9-bbfc-ac2b22fe1ed8",
                    "sense_definition": "A magical spell or an instance of an <w>enchantment</w> applied to an object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player spent all their experience points to get a powerful <w>enchant</w> for their armor.",
                            "target_lang_translations": {
                                "ru": "Игрок потратил все свои очки опыта, чтобы получить мощное <w>зачарование</w> для своей брони."
                            }
                        },
                        {
                            "text": "Each <w>enchant</w> requires a specific amount of lapis lazuli to be activated on the table.",
                            "target_lang_translations": {
                                "ru": "Для активации каждого <w>энчанта</w> на столе требуется определенное количество лазурита."
                            }
                        }
                    ],
                    "common_phrases": [
                        "powerful enchant",
                        "weapon enchant"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Commonly used in gaming contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Магическое заклинание или эффект, наложенный на предмет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зачарование",
                                "target_lang_sense_clarification": "магический эффект"
                            },
                            {
                                "target_lang_word": "энчант",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "чары",
                                "target_lang_sense_clarification": "магическое свойство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}