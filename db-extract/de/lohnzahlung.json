                "senses": [
                    {
                        "sense_id": "ac7eebc8-4565-3028-8d4e-2d3e863b7373",
                        "entry_id": "9d4d0b90-e937-3bdb-ad0a-352a7b778b6a",
                        "glosses": [
                            "Übergabe von Geld für geleistete Arbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3c15146-a7a6-4a97-9d42-66c095193bfb",
                                "sense_id": "ac7eebc8-4565-3028-8d4e-2d3e863b7373",
                                "text": "„Ein infolge irrtümlicher Buchung einer Lohnzahlung entstandener geringfügiger Kassenfehlbetrag (hier 154,-- ÖS) stellt nur einen geringfügigen Verstoß gegen die Ordnungsmäßigkeit der Buchführung dar.“"
                            },
                            {
                                "example_id": "aee9075b-63f5-41c0-af55-10b2b270ad69",
                                "sense_id": "ac7eebc8-4565-3028-8d4e-2d3e863b7373",
                                "text": "„Bisher konnten Arbeitnehmer bei verspäteter Lohnzahlung meist nur Verzugszinsen in Höhe von fünf Prozent geltend machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
