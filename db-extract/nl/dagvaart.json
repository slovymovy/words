                "forms": [
                    {
                        "form_id": "c365c011-408a-4140-b70a-5de24837a29c",
                        "entry_id": "af03ca74-d65c-3812-a376-4895f6fb861d",
                        "tags": [
                            "plural"
                        ],
                        "form": "[1], [2] dagvaarten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8dc8796b-f3aa-3d18-9aa8-d4f331385891",
                        "entry_id": "af03ca74-d65c-3812-a376-4895f6fb861d",
                        "glosses": [
                            "officiële samenkomst van functionarissen uit verschillende plaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88140581-4392-4446-9420-ccea37fd165c",
                                "sense_id": "8dc8796b-f3aa-3d18-9aa8-d4f331385891",
                                "text": "Een week na Willem Augustijns terugkeer was hij ter dagvaart vertrokken."
                            },
                            {
                                "example_id": "627ec260-bd76-48ba-af7a-11c167f8f3b9",
                                "sense_id": "8dc8796b-f3aa-3d18-9aa8-d4f331385891",
                                "text": "In afwachting dat de dagvaart op de Tommele zou gehouden worden, woelde de bonte menigte kwetterend, kakelend, tierend en twistend dooreen."
                            }
                        ]
                    },
                    {
                        "sense_id": "14ceb977-ec5b-3cba-8713-91d13a6572d5",
                        "entry_id": "af03ca74-d65c-3812-a376-4895f6fb861d",
                        "glosses": [
                            "reis die een dag duurt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a468a4b6-4292-4ed3-b97c-f1b68e3cd4d5",
                                "sense_id": "14ceb977-ec5b-3cba-8713-91d13a6572d5",
                                "text": "Zich bewust, dat de zon om niemands dood haar dagvaart zal vertragen, en dat ook aan de stralendste mens geen langer aanzijn dan ‘een spanne tijds’, - geen breder werkkring dan ‘een stip -op aard’ gegund is, spreekt hij schroomvallig zijn: ‘toch’. ‘Tòch groet ge zijn gedachtenis uws gelijke.’ De schroom wordt moed; de moed wordt geestdrift in dit woord. Het is tot de ‘schone en sterke’ zon gericht in dichterlijke durf, die lijkt op primitieve religiositeit."
                            }
                        ]
                    },
                    {
                        "sense_id": "59dd3970-d564-3b00-aad1-67a832d14c1d",
                        "entry_id": "af03ca74-d65c-3812-a376-4895f6fb861d",
                        "glosses": [
                            "exploitatievorm in de binnenvaart waarbij een schip ten hoogste 16 uur per dag vaart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5462f5d7-0d04-4d1d-85b4-badf58fb369b",
                                "sense_id": "59dd3970-d564-3b00-aad1-67a832d14c1d",
                                "text": "Kleinere schepen die opereren in de dagvaart zagen de kleinste daling in exploitatiekosten."
                            },
                            {
                                "example_id": "f6d9035d-bf5e-4c6a-b2c1-6d859df2aebe",
                                "sense_id": "59dd3970-d564-3b00-aad1-67a832d14c1d",
                                "text": "In de dagvaart onderbreekt een schip de vaart van 22.00 uur tot 6.00 uur, tenzij het schip is uitgerust met een goed functionerende tachograaf die inwerking is gesteld vanaf het einde van de voorgaande ten minste 8 aaneengesloten uren durende onderbreking van de vaart. In dat geval wordt de vaart onderbroken gedurende ten minste 8 aaneengesloten uren in elke periode van 24 uur, te rekenen vanaf het einde van iedere onderbreking van ten minste 8 uur."
                            }
                        ]
                    }
