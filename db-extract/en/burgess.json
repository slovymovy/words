                "translations": [
                    {
                        "translation_id": "9a2b2316-3557-4657-b17b-70f4ab549690",
                        "source_entry_id": "d1ac1bd2-f360-3bfb-9c94-c24d21162872",
                        "source_sense_description": "inhabitant of a borough with full rights",
                        "target_lang_word": "burger",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burger",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "609f4518-2eee-371b-a074-c42de24575ac",
                                        "entry_id": "3e4e0765-d285-33a9-91eb-9b6a1cb66b6b",
                                        "glosses": [
                                            "inwoner van een stad of staat die bepaalde wettelijke rechten en plichten heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1417b4-52d3-4417-b6b8-d59ee9187a20",
                                                "sense_id": "609f4518-2eee-371b-a074-c42de24575ac",
                                                "text": "Met de privilegebrief kende de landheer aan de burgers van een stad een zekere mate van autonomie toe. (feodaal rechtstelsel, middeleeuwen)"
                                            },
                                            {
                                                "example_id": "9ef2fe1f-ef47-41c2-a8c8-eb92eee57455",
                                                "sense_id": "609f4518-2eee-371b-a074-c42de24575ac",
                                                "text": "De burgers van de stad staken bij deze ramp zelf de handen uit de mouwen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e3d1f31-6524-3af3-9fc7-a2e2ca29e638",
                                        "entry_id": "3e4e0765-d285-33a9-91eb-9b6a1cb66b6b",
                                        "glosses": [
                                            "lid van de burgerbevolking, in tegenstelling tot een strijdende partij of ordedienst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f84310ef-a258-4dc3-9f88-5ff640b2bf10",
                                                "sense_id": "3e3d1f31-6524-3af3-9fc7-a2e2ca29e638",
                                                "text": "Door een aanval van de Afghaanse luchtmacht in de provincie Kunduz zijn mogelijk vijftig burgers om het leven gekomen."
                                            },
                                            {
                                                "example_id": "5045916f-a373-434c-a2a2-2d3233b21950",
                                                "sense_id": "3e3d1f31-6524-3af3-9fc7-a2e2ca29e638",
                                                "text": "Ze waren begonnen met het vermoorden van burgers door niet alleen Berlijn maar ook andere Duitse steden te bombarderen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f9cdd8-2b3b-358b-b14d-118953c611fb",
                                        "entry_id": "3e4e0765-d285-33a9-91eb-9b6a1cb66b6b",
                                        "glosses": [
                                            "inwoner van een land of stad die niet van adellijke afkomst is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d38cbea8-d866-4c5e-add8-2502c718ca9d",
                                                "sense_id": "f9f9cdd8-2b3b-358b-b14d-118953c611fb",
                                                "text": "Ikzelf hoop dat je net als je vader en opa jezelf in de eerste plaats zult zien als citoyen, burger, Letang."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "burger",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7c5d32ab-e080-32eb-8ba5-21e4f39f6ffc",
                                        "entry_id": "dfdaa68f-02b2-3390-9fa5-3465a59d5f0e",
                                        "glosses": [
                                            "als schijf gevormd en gebakken of gegrild kleingehakt, met kruiden vermengd vlees uit rund en/of varken, of iets vergelijkbaars"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f541c7e4-5f9d-43f7-aa3d-1bfc064cf1b5",
                                                "sense_id": "7c5d32ab-e080-32eb-8ba5-21e4f39f6ffc",
                                                "text": "Bij het bestellen van de burgers kregen we bijna nooit de vraag hoe we onze burger gebakken wilden hebben. Vreemd, want dat is wel standaard bij het bestellen van biefstuk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d1109e0-8302-3ccb-91ef-593fe2bc2c69",
                                        "entry_id": "dfdaa68f-02b2-3390-9fa5-3465a59d5f0e",
                                        "glosses": [
                                            "in twee helften gesneden broodje met daartussen een schijf gebakken of gegrild rundergehakt of iets vergelijkbaars, met saus en groenten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6eadd68-d771-42ff-808b-9da1050f3482",
                                                "sense_id": "5d1109e0-8302-3ccb-91ef-593fe2bc2c69",
                                                "text": "Na dagen lopen was het eindelijk zover, ik stond extra vroeg op en kon niet wachten totdat ik die befaamde burger in mijn handen had."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
