                ],
                "senses": [
                    {
                        "sense_id": "557a2622-90f2-302e-a4e6-27917f0164e1",
                        "entry_id": "a901d21b-0a60-3c38-8d08-7127aebbb032",
                        "glosses": [
                            "Donner un caractère vraisemblable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c02c746-3617-4342-9ae6-d3e064372b8e",
                                "sense_id": "557a2622-90f2-302e-a4e6-27917f0164e1",
                                "text": "Encore une fois, mêler du savoir – donc du « vrai » – à de la fiction revient bien à vraisemblabiliser l’invraisemblable en invraisemblabilisant le vraisemblable."
                            },
                            {
                                "example_id": "d4b6b70a-e251-42eb-8c3a-d8701ae4dbed",
                                "sense_id": "557a2622-90f2-302e-a4e6-27917f0164e1",
                                "text": "Vraisemblabiliser au niveau sémantique serait ramener l’artificiel, le statique, le gratuit (c’est-à-dire, le différent des signifiés du “principe naturel”) à la nature, la vie, l’évolution, le but (c’est-à-dire, aux sémantèmes constitutifs du principe naturel)."
                            }
                        ]
                    }
                ],
