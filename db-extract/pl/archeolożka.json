                    {
                        "translation_id": "c5764af5-f6a6-411f-8462-3375e4dabad0",
                        "source_entry_id": "7787e131-3d68-3386-b977-ca728949bdaa",
                        "source_sense_id": "8ffc96a5-4e60-3f7a-aed3-e31062d55081",
                        "target_lang_word": "arqueóloga",
                        "target_lang_code": "es",
