                ],
                "senses": [
                    {
                        "sense_id": "7bf7baff-1a7d-3d64-92bc-46c47b6b15eb",
                        "entry_id": "06799e0e-2d47-36c1-a7d6-07e28806181a",
                        "glosses": [
                            "französische Anrede für unverheiratete Frauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "425f44ed-5eca-48fd-a22f-22ee9701ce9b",
                                "sense_id": "7bf7baff-1a7d-3d64-92bc-46c47b6b15eb",
                                "text": "„Er verbeugte sich mit der vollen Galanterie des französischen Officiers vor ihr. ‚Mademoiselle, schenken Sie mir die Ehre dieses Tanzes! Sie hatten mir einst verziehen, zeigen Sie den Ernst Ihrer Verzeihung.‘ “"
                            },
                            {
                                "example_id": "25fb55a8-3e6b-4846-b2af-0190a020b75f",
                                "sense_id": "7bf7baff-1a7d-3d64-92bc-46c47b6b15eb",
                                "text": "„›Sagen Sie meine Liebe…‹ ›Ich bin nicht Ihre Liebe.‹ ›Sagen Sie Félicie…‹ ›Sie können mich ruhig Mademoiselle nennen!‹ Mein Gott, war die Person schwierig! Maigret spürte die Ungeduld, die von uns Besitz ergreift, wenn wir versuchen, ein kleines Tier zu packen, das uns ständig durch die Finger gleitet …“"
                            },
                            {
                                "example_id": "cad1d874-e8cb-4e31-9d22-ccdf097ca795",
                                "sense_id": "7bf7baff-1a7d-3d64-92bc-46c47b6b15eb",
                                "text": "„Im Konzert trägt Mademoiselle immer das Kreuz von ihrer Erstkommunion.“"
                            },
                            {
                                "example_id": "a4658c43-1f2e-45c7-8498-dfdf01e70670",
                                "sense_id": "7bf7baff-1a7d-3d64-92bc-46c47b6b15eb",
                                "text": "„Sie war eindeutig eine Mademoiselle; an ihr war keine Spur von Madame.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4902aeef-3837-4269-99d6-d5a3f99be3e4",
                        "source_entry_id": "06799e0e-2d47-36c1-a7d6-07e28806181a",
                        "source_sense_id": "7bf7baff-1a7d-3d64-92bc-46c47b6b15eb",
