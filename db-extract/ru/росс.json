                ],
                "senses": [
                    {
                        "sense_id": "9bd60003-4dab-3682-b3b1-b3b1d772f670",
                        "entry_id": "059cd8ba-0832-3eaf-9d15-beb3b7ec7cf9",
                        "glosses": [
                            "трад.-поэт. то же, что русский, россиянин (Цитата взята из Толкового словаря русского языка: В 4 т. / Под ред. Д. Н. Ушакова. — М.: Сов. энцикл.: ОГИЗ, 1935—1940.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51f26db8-79c8-4215-988b-b9d646f6afef",
                                "sense_id": "9bd60003-4dab-3682-b3b1-b3b1d772f670",
                                "text": "Гром победы раздавайся! Веселися, храбрый Росс!"
                            },
                            {
                                "example_id": "4b9e46ca-3811-4b5a-ad65-7e70eb8da72b",
                                "sense_id": "9bd60003-4dab-3682-b3b1-b3b1d772f670",
                                "text": "Кто устоит в неравном споре: кичливый лях иль верный росс?"
                            },
                            {
                                "example_id": "9ab5fef7-f718-4d5b-aae4-f76fd257da29",
                                "sense_id": "9bd60003-4dab-3682-b3b1-b3b1d772f670",
                                "text": "Ускользнут ли часы из кармана, // До костей ли прохватит мороз // Под воинственный гром барабана, // Не жалею: я истинный росс!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb362447-ddc9-48e5-8933-5736fe3e16d0",
                        "source_entry_id": "059cd8ba-0832-3eaf-9d15-beb3b7ec7cf9",
                        "source_sense_id": "9bd60003-4dab-3682-b3b1-b3b1d772f670",
                        "target_lang_word": "Reuße",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reuße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ef8f74-22f8-385a-b069-c11d65c9c18e",
                                        "entry_id": "3da9b206-e3b2-3342-aa61-2004f79d23e9",
                                        "glosses": [
                                            "Russe"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ec2d3df-ac90-4839-b1b0-e64ee03332b1",
                                                "sense_id": "c9ef8f74-22f8-385a-b069-c11d65c9c18e",
                                                "text": "Mein Opa hat viele schlimme Geschichten von den Reußen aus dem Krieg erzählt."
                                            },
                                            {
                                                "example_id": "c53476b1-24f7-45da-aae6-a81280d61f54",
                                                "sense_id": "c9ef8f74-22f8-385a-b069-c11d65c9c18e",
                                                "text": "„Nun so wißt: 's ist der Kaiser aller Reußen.“"
                                            },
                                            {
                                                "example_id": "10f30cd5-b732-4216-bd05-22faaba3cb51",
                                                "sense_id": "c9ef8f74-22f8-385a-b069-c11d65c9c18e",
                                                "text": "„Wir Katharina die Zweyte, Kayzerin und Selbstherrscherin aller Reußen, zu Moskau, Kiow, Wladimir […]“"
                                            },
                                            {
                                                "example_id": "8802a3f6-1e05-40d9-b81a-8e571f8996fc",
                                                "sense_id": "c9ef8f74-22f8-385a-b069-c11d65c9c18e",
                                                "text": "„Die Vorstellung, dem Zaren aller Reußen im Nachthemd zu begegnen, erheiterte die Soldaten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
