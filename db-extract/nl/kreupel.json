                        "translation_id": "54a6f75d-b6f5-4bc5-983e-ebcd56cd5398",
                        "source_entry_id": "c0001ab0-29d5-364d-a848-14d156d392e4",
                        "source_sense_id": "24e25127-732c-333b-9106-9ebf3c10ba0f",
