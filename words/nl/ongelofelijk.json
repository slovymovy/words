{
    "word_family": [
        "geloof",
        "geloven",
        "gelovig",
        "ongeloof"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fe526d7a-313b-3fdd-87e3-a06a3d2f28c7",
                    "sense_definition": "Niet in staat om geloof aan te schenken omdat het onwaarschijnlijk of onmogelijk lijkt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ongeloofwaardig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben die <w>ongelofelijke</w> verhalen over spoken meer dan zat.",
                            "target_lang_translations": {
                                "ru": "Я сыт по горло этими <w>невероятными</w> историями о привидениях."
                            }
                        },
                        {
                            "text": "Het is <w>ongelofelijk</w> dat hij dat zomaar durfde te beweren.",
                            "target_lang_translations": {
                                "ru": "Просто <w>невероятно</w>, что он осмелился такое заявить."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongelooflijk"
                    ],
                    "common_phrases": [
                        "ongelofelijk verhaal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невероятный, не вызывающий доверия, потому что кажется маловероятным или невозможным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невероятный",
                                "target_lang_sense_clarification": "не вызывающий доверия или труднодоказуемый"
                            },
                            {
                                "target_lang_word": "неправдоподобный",
                                "target_lang_sense_clarification": "вызывающий сомнения в своей истинности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d6c0ec8-6cf5-378b-8cd6-acc9ab036d15",
                    "sense_definition": "Bijzonder, uitzonderlijk of zeer groot in omvang of intensiteit.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de lange wandeling had ik een <w>ongelofelijke</w> honger.",
                            "target_lang_translations": {
                                "ru": "После долгой прогулки я испытывал <w>невероятный</w> голод."
                            }
                        },
                        {
                            "text": "Het is <w>ongelofelijk</w> hoe snel de tijd voorbij vliegt tijdens de vakantie.",
                            "target_lang_translations": {
                                "ru": "Просто <w>невероятно</w>, как быстро летит время во время отпуска."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ongelofelijke honger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особенный, исключительный или очень большой по размеру или интенсивности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невероятный",
                                "target_lang_sense_clarification": "очень сильный, исключительный"
                            },
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "вызывающий сильное впечатление"
                            },
                            {
                                "target_lang_word": "огромный",
                                "target_lang_sense_clarification": "очень большой по интенсивности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}