            {
                "entry_id": "2c3c7f51-3848-36a8-8e77-716355f2cbc3",
                "word": "smoulder",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9f64742c-d569-3ea0-99d4-00c3eee6ecc5",
                        "entry_id": "2c3c7f51-3848-36a8-8e77-716355f2cbc3",
                        "glosses": [
                            "〈不及〉（无明火地）阴燃，闷燃"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139c8bcf-8324-4979-95fd-3cee17e226b5",
                                "sense_id": "9f64742c-d569-3ea0-99d4-00c3eee6ecc5",
                                "text": "The bonfire was still smouldering the next day.　到了第二天，篝火还在闷燃。"
                            },
                            {
                                "example_id": "5ed2ac8d-b40c-443c-a93a-ba734e8c6f36",
                                "sense_id": "9f64742c-d569-3ea0-99d4-00c3eee6ecc5",
                                "text": "a smouldering cigarette　慢慢燃烧的香烟"
                            },
                            {
                                "example_id": "f2d3322d-0fb3-4fea-98f8-0084b6f87328",
                                "sense_id": "9f64742c-d569-3ea0-99d4-00c3eee6ecc5",
                                "text": "The feud smouldered on for years.　这场冤仇积结了多年。"
                            }
                        ]
                    },
                    {
                        "sense_id": "04096b90-d833-3c5f-ad47-c59eed25ffae",
                        "entry_id": "2c3c7f51-3848-36a8-8e77-716355f2cbc3",
                        "glosses": [
                            "〈不及〉〈引，书〉（感情）郁积，压在心头"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb0f5690-005f-4c44-93c3-063de86a981f",
                                "sense_id": "04096b90-d833-3c5f-ad47-c59eed25ffae",
                                "text": "His eyes smouldered with anger.　他眼里冒着强压的怒火。"
                            },
                            {
                                "example_id": "5bb97423-9546-428e-95a3-83ef9283da44",
                                "sense_id": "04096b90-d833-3c5f-ad47-c59eed25ffae",
                                "text": "Anger smouldered in his eyes.　强压的怒火在他眼里燃烧。"
                            }
                        ]
                    }
                ],
