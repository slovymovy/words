                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e42e89-e605-412e-9fd0-90709a6b72af",
                                                "sense_id": "518370cd-c851-32f4-8388-8c1a3fe8307d",
                                                "text": "Das Baugerüst stürzte wegen der Ermüdung eines wichtigen Bauteiles ein."
                                            }
                                        ],
