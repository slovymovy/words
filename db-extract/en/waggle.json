                                    },
                                    {
                                        "sense_id": "8af47c91-b360-35e0-ab56-55c2a631c483",
                                        "entry_id": "3e04b9f4-0fec-3d18-ab70-55534fea4c67",
                                        "glosses": [
                                            "kurz vor dem Versagen oder Sturz stehen"
                                        ],
                                        "tags": [
                                            "bildlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95a2721f-672a-40b3-b67b-4b76da4735cb",
                                                "sense_id": "8af47c91-b360-35e0-ab56-55c2a631c483",
                                                "text": "Der Präsident wackelt unter dem politischen Druck."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5f069a5a-3fde-32d4-a9f4-e3c651476aa0",
                                        "entry_id": "3e04b9f4-0fec-3d18-ab70-55534fea4c67",
                                        "glosses": [
                                            "lose sein (zum Beispiel ein Bolzen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc670466-da20-4969-95bb-f91be4b8f79b",
                                                "sense_id": "5f069a5a-3fde-32d4-a9f4-e3c651476aa0",
                                                "text": "Der Zahn wackelt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bdb62362-97cd-3896-98cd-d3b0d39f7284",
                                        "entry_id": "3e04b9f4-0fec-3d18-ab70-55534fea4c67",
                                        "glosses": [
                                            "hin und her bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb159510-e585-4650-9879-c643219ed2d6",
                                                "sense_id": "bdb62362-97cd-3896-98cd-d3b0d39f7284",
                                                "text": "Wenn Du zu stark am Zahn wackelst, bricht er ab."
                                            },
                                            {
                                                "example_id": "b30e7290-4493-4788-be5d-f59aebd49d1d",
                                                "sense_id": "bdb62362-97cd-3896-98cd-d3b0d39f7284",
                                                "text": "Er begann nervös mit dem Kopf zu wackeln."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf2354b4-495f-4756-bb6d-367d6bb3a6f7",
                        "source_entry_id": "6da56ff5-770c-36b2-9145-e2b56dcc18be",
                        "source_sense_description": "move with short, quick motions; wobble",
                        "target_lang_word": "wedeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wedeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da8e9f54-0eda-3c52-a79e-abaf28c61148",
                                        "entry_id": "db51d087-2228-33b5-94ea-f9b7fa6ecaeb",
                                        "glosses": [
                                            "mit einem Körperteil oder einem leichten Gegenstand hin und her schwingen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43b18ba9-af2c-491d-b010-16fc4d824e6d",
                                                "sense_id": "da8e9f54-0eda-3c52-a79e-abaf28c61148",
                                                "text": "Sie wedelten mit kleinen thailändischen Flaggen, skandierten Parolen zugunsten der Regierung von Premier Abhisit Vejjajiva und brüllten Beleidigungen auf die Seite der Rothemden."
                                            },
                                            {
                                                "example_id": "29bdb35a-54ca-4221-9cb0-cf0adbebf805",
                                                "sense_id": "da8e9f54-0eda-3c52-a79e-abaf28c61148",
                                                "text": "Mindestens 50 Mitstreiter in orangeroten Ponchos recken zu Bongo-Trommeln die Arme in die Höhe und wedeln mit den Händen."
                                            },
                                            {
                                                "example_id": "b9f8c03e-a5a2-4312-978c-55401e9e6ecf",
                                                "sense_id": "da8e9f54-0eda-3c52-a79e-abaf28c61148",
                                                "text": "Später tastet sie die Räume ab und erfasst Pflanzen, Schrank, Gesichter, Kleider, Vasen, Brustwarzen, Stuhl, den Blick nach draußen und nackte Männer, die mit Fächern wedeln."
                                            },
                                            {
                                                "example_id": "3dc862f4-52f1-49b0-b69f-676a9348bb34",
                                                "sense_id": "da8e9f54-0eda-3c52-a79e-abaf28c61148",
                                                "text": "Auch wedeln und heulen sie, wenn der Herr zurückkommt, und springen vor Herzensfreude ihm auf die Schultern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9bd5c79-0ba4-3106-9587-73066425dbe8",
                                        "entry_id": "db51d087-2228-33b5-94ea-f9b7fa6ecaeb",
                                        "glosses": [
                                            "etwas durch schwingende Bewegungen entfernen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9f8df16-1148-45f9-90f5-3e3514c41671",
                                                "sense_id": "f9bd5c79-0ba4-3106-9587-73066425dbe8",
                                                "text": "Bevor er sich im Gasthausgarten niedersetzte, wedelte er mit seiner Zeitung die Brösel vom Tisch."
                                            },
                                            {
                                                "example_id": "190121d5-1d3b-484c-97f0-3bd67b4cf964",
                                                "sense_id": "f9bd5c79-0ba4-3106-9587-73066425dbe8",
                                                "text": "Und ist nicht die „Clowns’ Army“, die in bunten Kostümen den Polizisten bei Demos den Staub von der Uniform wedeln, die entwaffnendste Form der Kritik?"
                                            },
                                            {
                                                "example_id": "3f17c6e4-c381-4ecb-9de0-03cbd7e0f184",
                                                "sense_id": "f9bd5c79-0ba4-3106-9587-73066425dbe8",
                                                "text": "Am frühen Abend setzen wir uns zuerst an einen der vielen Tacostände an der Kopfsteinpflasterstrasse neben der Kirche, wo wir zusammen mit den Einheimischen gegrilltes Fleisch in unsere Tacos füllen, vergebens gegen die Millionen von Fliegen wedeln und das Getränk vor hungrigen Bienen schützen müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "509c0c76-02d8-3b14-8677-7405f49b7016",
                                        "entry_id": "db51d087-2228-33b5-94ea-f9b7fa6ecaeb",
                                        "glosses": [
                                            "auf parallel geführten Skiern kurze Schwünge in rascher Folge fahren"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3cf2351-774a-4d9e-b16a-afb932b32952",
                                                "sense_id": "509c0c76-02d8-3b14-8677-7405f49b7016",
                                                "text": "Jede Zeit hat ihre Art, sich zu bewegen: In den Sechzigern wedelten die Deutschen selbstbewusst und zielstrebig auf Skiern ins Tal."
                                            },
                                            {
                                                "example_id": "afe93c6f-18e6-47f7-bd3e-a8fd06251d30",
                                                "sense_id": "509c0c76-02d8-3b14-8677-7405f49b7016",
                                                "text": "Vor gut zehn Jahren begannen die Zyprioten, Lifte zu bauen — Skifahren als Zeitvertreib für die auf der Insel stationierten Soldaten, als Spaß für die Einheimischen, als Hobby für die Kinder, die seitdem klassenweise wedeln lernen."
                                            },
                                            {
                                                "example_id": "d1a1b4d6-ae3f-4db4-8e7f-3e485c5432bc",
                                                "sense_id": "509c0c76-02d8-3b14-8677-7405f49b7016",
                                                "text": "Der 29-jährige Pitztaler, Führender nach dem ersten Durchgang, bewies im zweiten Lauf Nerven aus Stahl, Raich wedelte unbeirrbar seinem insgesamt bereits 30. Weltcup-Sieg entgegen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
