                "senses": [
                    {
                        "sense_id": "bdc0b1d7-21eb-3a5b-9d28-e13b39b48f14",
                        "entry_id": "8480c457-3476-3388-8d17-e096bd874496",
                        "glosses": [
                            "kilka lub dużo liści, ogół liści; listowie"
                        ],
                        "tags": [
                            "obsolete",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "eeb6d4b0-031a-40ce-9a2b-986a0690b7f3",
                                "sense_id": "bdc0b1d7-21eb-3a5b-9d28-e13b39b48f14",
                                "text": "Leci liście z drzewa, / Co wyrosło wolne"
                            },
                            {
                                "example_id": "ba8620c5-55a5-484a-99be-74645c3bd373",
                                "sense_id": "bdc0b1d7-21eb-3a5b-9d28-e13b39b48f14",
                                "text": "Szczęśliwy, kto marzy / Pod liściem rozłożystym tej szerokiej gruszy, / Gdy lawiną kamieni grobowiec się kruszy / I spada z wielkim hukiem"
                            },
                            {
                                "example_id": "d483aaee-54b8-4adf-b617-31f02f2260a1",
                                "sense_id": "bdc0b1d7-21eb-3a5b-9d28-e13b39b48f14",
                                "text": "Gościu, siądź pod mym liściem a odpocznij sobie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
