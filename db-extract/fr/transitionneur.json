                        "glosses": [
                            "Acteur de la transition écologique à l’échelle locale ou individuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "609d652f-cdf7-4ca7-87ec-8c81fea171dd",
                                "sense_id": "e63f3578-0de1-3473-9fae-74dc086be7c0",
                                "text": "À Fernelmont, près de Namur, une trentaine de transitionneurs impliqués dans le Pale (Plan d’action locale pour l’énergie) ont créé une coopérative d’énergie."
                            }
                        ]
                    },
