                ],
                "translations": [
                    {
                        "translation_id": "9fc5d70d-3922-4089-a91d-4a9073155b88",
                        "source_entry_id": "63fed8ad-813b-39d9-a8f1-f6656d68bcfc",
                        "target_lang_word": "massive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "massive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77f8a92d-c876-36e9-b4fa-dc2bc6c4a05b",
                                        "entry_id": "182161b5-ec69-30bb-bd72-463d585a1349",
                                        "glosses": [
                                            "Very large in size or extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ed12a4-9c6f-409b-a53e-cb0e8d44f12c",
                                                "sense_id": "77f8a92d-c876-36e9-b4fa-dc2bc6c4a05b",
                                                "text": "Compared to its counterparts from World War II, the Abrams main battle tank is truly massive."
                                            },
                                            {
                                                "example_id": "47fa4760-c5e3-4e02-92a3-cc5906bccbd3",
                                                "sense_id": "77f8a92d-c876-36e9-b4fa-dc2bc6c4a05b",
                                                "text": "Across Japan, technology companies and private investors are racing to install devices that until recently they had little interest in: solar panels. Massive solar parks are popping up as part of a rapid build-up that one developer likened to an \"explosion.\""
                                            },
                                            {
                                                "example_id": "48a725c3-24d0-46a2-a4ab-5865fe3868fa",
                                                "sense_id": "77f8a92d-c876-36e9-b4fa-dc2bc6c4a05b",
                                                "text": "The enlightenment comprises massive shifts in many areas of Western thought."
                                            },
                                            {
                                                "example_id": "f3bfc78d-f2cd-4510-862a-52ce0bcc56a0",
                                                "sense_id": "77f8a92d-c876-36e9-b4fa-dc2bc6c4a05b",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0efcf1cb-a554-3102-9609-26db56711e36",
                                        "entry_id": "182161b5-ec69-30bb-bd72-463d585a1349",
                                        "glosses": [
                                            "Very large or bulky and heavy and solid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b66115e9-9b38-4ce7-a597-6cb0ac064655",
                                                "sense_id": "0efcf1cb-a554-3102-9609-26db56711e36",
                                                "text": "A massive comet or asteroid appears to have ended the era of the dinosaurs."
                                            },
                                            {
                                                "example_id": "12323e44-2bd1-4605-a049-a1b197f7a886",
                                                "sense_id": "0efcf1cb-a554-3102-9609-26db56711e36",
                                                "text": "But Richmond[…]appeared to lose himself in his own reflections. Some pickled crab, which he had not touched, had been removed with a damson pie; and his sister saw, peeping around the massive silver epergne that almost obscured him from her view, that he had eaten no more than a spoonful of that either."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9261fa9-fa91-3066-9db1-54049a1fbf32",
                                        "entry_id": "182161b5-ec69-30bb-bd72-463d585a1349",
                                        "glosses": [
                                            "To a very great extent; total, utter."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d74c006-5b7a-46f6-8d63-fa9ea955c6d8",
                                                "sense_id": "a9261fa9-fa91-3066-9db1-54049a1fbf32",
                                                "text": "Notwithstanding Catherine's assurances, I was apprehensive about meeting Denys, worried that I would come off as a massive idiot […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ebb87df-affc-35a3-a445-7ee5fe3d7a95",
                                        "entry_id": "182161b5-ec69-30bb-bd72-463d585a1349",
                                        "glosses": [
                                            "Of particularly exceptional quality or value; awesome."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d1cb00-8268-4a01-86e5-1913a5496c53",
                                                "sense_id": "1ebb87df-affc-35a3-a445-7ee5fe3d7a95",
                                                "text": "Did you see Colbert last night? He was massive!"
                                            },
                                            {
                                                "example_id": "bffc5c36-d667-4d66-9cf3-ee37a645954f",
                                                "sense_id": "1ebb87df-affc-35a3-a445-7ee5fe3d7a95",
                                                "text": "Ok true believers here is the low down of massive coolness."
                                            },
                                            {
                                                "example_id": "dd43bee8-8c0b-4025-93a8-3d39e0db5bbf",
                                                "sense_id": "1ebb87df-affc-35a3-a445-7ee5fe3d7a95",
                                                "text": "Heaps excited about it - I'm planning for a massive day."
                                            },
                                            {
                                                "example_id": "4e938681-0efb-4a12-ad21-263e673da985",
                                                "sense_id": "1ebb87df-affc-35a3-a445-7ee5fe3d7a95",
                                                "text": "saw the beasties last week in GERMANY at a massive little party called the Hurricane Festival outside Hamburg and here's how it all shook down[…]"
                                            },
                                            {
                                                "example_id": "64d8e76c-05d4-4bc7-9900-9e169762734e",
                                                "sense_id": "1ebb87df-affc-35a3-a445-7ee5fe3d7a95",
                                                "text": "OPEN THROUGH THE SUMMER: We are on the 3rd Saturday of the month, remain at the same venue, at the same price, at the same times and always give you a massive night out to remember (unless you've drunk too much bargain University booze!)."
                                            },
                                            {
                                                "example_id": "86270888-7e51-4fb7-a3a3-6c4fcc8889e7",
                                                "sense_id": "1ebb87df-affc-35a3-a445-7ee5fe3d7a95",
                                                "text": "I own this one, bought it because I liked Slide. The album is quite dull. They were massive back in the day"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28a0ce60-a3f0-3776-947d-21ff66d1c645",
                                        "entry_id": "182161b5-ec69-30bb-bd72-463d585a1349",
                                        "glosses": [
                                            "Outstanding, beautiful."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "colloquial",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f7fd763-150d-4826-845b-22e82a89dca9",
                                                "sense_id": "28a0ce60-a3f0-3776-947d-21ff66d1c645",
                                                "text": "Your dress is massive, love. Where did you get it?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3284a75-0c31-3bbb-8991-48c8a95a33bd",
                                        "entry_id": "182161b5-ec69-30bb-bd72-463d585a1349",
                                        "glosses": [
                                            "Affecting a large portion of the body, or severe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9721366d-9c73-4e72-94a4-2de530848914",
                                                "sense_id": "d3284a75-0c31-3bbb-8991-48c8a95a33bd",
                                                "text": "a massive heart attack"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06228e3b-7c93-3785-b316-4ded17af2196",
                                        "entry_id": "182161b5-ec69-30bb-bd72-463d585a1349",
                                        "glosses": [
                                            "Having a large mass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1cabeeb-730a-46f4-9299-5b2de4ad57b8",
                                                "sense_id": "06228e3b-7c93-3785-b316-4ded17af2196",
                                                "text": "Young Jupiter was smacked head-on by massive newborn planet […] \"The only scenario that resulted in a core-density profile similar to what Juno measures today is a head-on impact with a planetary embryo about 10 times more massive than Earth,\" Liu said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f30d9971-cfff-3cfa-902b-a2663691bf47",
                                        "entry_id": "182161b5-ec69-30bb-bd72-463d585a1349",
                                        "glosses": [
                                            "Having any mass."
                                        ],
                                        "tags": [
                                            "of a particle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e5a3fcf-9970-4965-a9e9-4248aaa59312",
                                                "sense_id": "f30d9971-cfff-3cfa-902b-a2663691bf47",
                                                "text": "Some bosons are massive while others are massless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aaaf01d-5a85-3bd8-be6a-d2591cc9ca5c",
                                        "entry_id": "182161b5-ec69-30bb-bd72-463d585a1349",
                                        "glosses": [
                                            "Homogeneous, unstructured."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ee49a1b-1d00-3269-a57a-af1c7dc5b508",
                                        "entry_id": "182161b5-ec69-30bb-bd72-463d585a1349",
                                        "glosses": [
                                            "Homogeneous, unstructured.",
                                            "Not having an obvious crystalline structure."
                                        ],
