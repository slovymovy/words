                "senses": [
                    {
                        "sense_id": "8061696e-6267-38af-87a3-b89e0abb9531",
                        "entry_id": "b7f8006f-ffaf-32ae-a647-9ec276f1ede5",
                        "glosses": [
                            "Staatsbürgerin des Senegal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d1a5e1-2ee4-4455-8c2f-b36eada268b9",
                                "sense_id": "8061696e-6267-38af-87a3-b89e0abb9531",
                                "text": "„Nach dem Abendessen las die Senegalesin aus ihrer Erzählung vor.“"
                            },
                            {
                                "example_id": "6d985677-7531-4475-b0e6-0dc7da034cfd",
                                "sense_id": "8061696e-6267-38af-87a3-b89e0abb9531",
                                "text": "„In Anbetracht des oft reichen Goldschmuckes vieler Senegalesinnen sämtlicher Bevölkerungs- und Einkommenskreise muß die inländische Sparquote beträchtlich sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ce94675-0593-42dd-88a0-728bba0241b8",
                        "source_entry_id": "b7f8006f-ffaf-32ae-a647-9ec276f1ede5",
                        "source_sense_id": "8061696e-6267-38af-87a3-b89e0abb9531",
                        "source_sense_description": "Staatsbürgerin des Senegal",
                        "target_lang_word": "Senegalese",
