            {
                "entry_id": "d6702e36-3146-37bf-9013-d8434326a143",
                "word": "wind-up",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "374b168c-11fe-477d-a3fb-47d0b6c3a67d",
                        "entry_id": "d6702e36-3146-37bf-9013-d8434326a143",
                        "tags": [
                            "plural"
                        ],
                        "form": "wind-ups"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52ff66ce-4644-3073-a1f6-31b2fc5be6fb",
                        "entry_id": "d6702e36-3146-37bf-9013-d8434326a143",
                        "glosses": [
                            "The end or conclusion of something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73d5c2e1-d665-48d4-8f83-92f331f8d2ad",
                                "sense_id": "52ff66ce-4644-3073-a1f6-31b2fc5be6fb",
                                "text": "Everyone is invited to our end-of-term wind-up party."
                            },
                            {
                                "example_id": "8a825b0e-7d23-4fbe-be46-bcc0b8fe844b",
                                "sense_id": "52ff66ce-4644-3073-a1f6-31b2fc5be6fb",
                                "text": "The wind-up is, that the father becomes bankrupt; the wife and daughters town-traders; the sons Greeks, Fancy-swells, Conveyancers (pickpockets), or Cracksmen (house breakers), and the New Drop is the last drop they ever take."
                            },
                            {
                                "example_id": "2e78ffd7-22a6-4c0d-ac4f-1d6188a34277",
                                "sense_id": "52ff66ce-4644-3073-a1f6-31b2fc5be6fb",
                                "text": "After this long windup, Smith says, “Is there a question there, your honor?” He says it not in an evasive way, but with a smile."
                            }
                        ]
                    },
                    {
                        "sense_id": "e73b4512-6423-3237-9e9f-eceb05c51ceb",
                        "entry_id": "d6702e36-3146-37bf-9013-d8434326a143",
                        "glosses": [
                            "The punch line of a joke or comedy routine."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d488719c-85f4-335b-8995-5af7638a5cdb",
                        "entry_id": "d6702e36-3146-37bf-9013-d8434326a143",
                        "glosses": [
                            "A humorous attempt to fool somebody; a practical joke in which the victim is encouraged to believe something untrue."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "f07191c3-bb90-410a-80b4-dca6f2d249ad",
                                "sense_id": "d488719c-85f4-335b-8995-5af7638a5cdb",
                                "text": "\"Is this a wind-up, or what?\" \"No, no, it's true. He can really do it.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "b1c8e421-04c1-3473-9ce1-3f2c6241d240",
                        "entry_id": "d6702e36-3146-37bf-9013-d8434326a143",
                        "glosses": [
                            "The phase of making a pitch where the pitcher moves his or her arm backwards before throwing the ball."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60aa441f-f1af-4166-a820-96e0e30c111e",
                                "sense_id": "b1c8e421-04c1-3473-9ce1-3f2c6241d240",
                                "text": "He's into his wind-up. Here comes the pitch. Strike on the inside corner!"
                            }
                        ]
                    },
                    {
                        "sense_id": "7de67acf-bf93-355d-a042-c9dc9e56dccb",
                        "entry_id": "d6702e36-3146-37bf-9013-d8434326a143",
                        "glosses": [
                            "A circular hand gesture, supposed to represent the winding on of film, used to signal to a performer to finish quickly."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "588c7348-26b2-4c86-afde-aae71425de84",
                        "source_entry_id": "d6702e36-3146-37bf-9013-d8434326a143",
                        "source_sense_description": "end or conclusion of something",
                        "target_lang_word": "Zusammenfassung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenfassung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9918d922-354a-3d93-bfa5-1210bc8cf8bd",
                                        "entry_id": "0eb1ca70-e187-3e6c-9237-e25dc917e5a1",
                                        "glosses": [
                                            "kurzer Text, der den Inhalt eines längeren Textes knapp wiedergibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "527a2922-cca0-4594-af7f-a617afe270c1",
                                                "sense_id": "9918d922-354a-3d93-bfa5-1210bc8cf8bd",
                                                "text": "„Die Klimaaktivistin Greta Thunberg kommentierte die Gipfelergebnisse über den Nachrichtendienst Twitter: »Der COP26 ist vorbei. Hier eine kurze Zusammenfassung: Bla, Bla, Bla.«“"
                                            },
                                            {
                                                "example_id": "aa64d5cd-2ee4-4648-be47-95e76bdd60e2",
                                                "sense_id": "9918d922-354a-3d93-bfa5-1210bc8cf8bd",
                                                "text": "Bei wissenschaftlichen Artikeln ist es sehr nützlich, zuerst die Zusammenfassung zu lesen, um entscheiden zu können, ob sich ein Kauf lohnt."
                                            },
                                            {
                                                "example_id": "02aadc8a-fe2b-4601-b644-4cb02a516a6a",
                                                "sense_id": "9918d922-354a-3d93-bfa5-1210bc8cf8bd",
                                                "text": "„Die Zusammenfassung des mehrere Hunderte Seiten langen, detaillierten und vertraulichen Reports eines UN-Expertengremiums an den Sicherheitsrat hat die dpa nach eigen Angaben eingesehen.“"
                                            },
                                            {
                                                "example_id": "1f5e460c-d166-46ea-ab76-1e83ed3e1dff",
                                                "sense_id": "9918d922-354a-3d93-bfa5-1210bc8cf8bd",
                                                "text": "„In einem ersten Bericht waren die Geheimdienste bereits zu unterschiedlichen Einschätzungen gekommen. Das Dokument wurde diese Woche in einer geheimen Fassung dem Weißen Haus vorgelegt. Freigegeben wurde nun eine für die Öffentlichkeit bestimmte redigierte Zusammenfassung.“"
                                            },
                                            {
                                                "example_id": "888f3cc9-16a7-4f2b-98a8-65247750cee9",
                                                "sense_id": "9918d922-354a-3d93-bfa5-1210bc8cf8bd",
                                                "text": "[Entwaldung in Afrika:] „In ihrer Zusammenfassung bringen die Autoren die \"hohe Entwaldungsrate\" mit dem starken Wachstum der Bevölkerung in Verbindung und mit der \"Notwendigkeit, die Lebensgrundlagen mit kleinbäuerlicher Landwirtschaft zu erhalten\".“"
                                            },
                                            {
                                                "example_id": "bd1cf0ea-e051-4611-86b1-62ea9c84524b",
                                                "sense_id": "9918d922-354a-3d93-bfa5-1210bc8cf8bd",
                                                "text": "„Die eigentlichen Textinhalte müssen in der Zusammenfassung in die indirekte Rede gesetzt werden. Also bitte merken: Strukturwörter im Indikativ Präsens, Verben aus dem Text im Konjunktiv.“"
                                            },
                                            {
                                                "example_id": "8f12fb4a-d088-44ab-92d2-2a33056c9c49",
                                                "sense_id": "9918d922-354a-3d93-bfa5-1210bc8cf8bd",
                                                "text": "„Seit 2018 schreibt die HSG immer wieder negative Schlagzeilen. Eine kurze Zusammenfassung. […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa1e699e-b77d-4d07-9342-44f3d0286373",
                        "source_entry_id": "d6702e36-3146-37bf-9013-d8434326a143",
