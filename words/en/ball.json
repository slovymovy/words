    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9b167f6-4067-3498-bc6d-c5a46999ac2d",
                    "sense_definition": "An object used in various sports and games that is thrown, caught, kicked, or hit.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sports_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were playing with a colorful <w>ball</w> on the beach.",
                            "target_lang_translations": {
                                "ru": "Дети играли с разноцветным <w>мячом</w> на пляже."
                            }
                        },
                        {
                            "text": "He managed to kick the <w>ball</w> over the fence and into the neighbor's yard.",
                            "target_lang_translations": {
                                "ru": "Ему удалось перебросить <w>мяч</w> через забор во двор соседа."
                            }
                        }
                    ],
                    "synonyms": [
                        "sphere",
                        "globe"
                    ],
                    "common_phrases": [
                        "kick the ball",
                        "throw the ball",
                        "hit the ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет, используемый в различных видах спорта и играх, который бросают, ловят, пинают или по которому ударяют."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мяч",
                                "target_lang_sense_clarification": "спортивный инвентарь"
                            },
                            {
                                "target_lang_word": "мячик",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное, обычно для небольших мячей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "571ba9ff-df6f-3c8c-8495-0568cc8a2257",
                    "sense_definition": "A solid or hollow sphere, or a roughly spherical mass of something.",
