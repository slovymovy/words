                "senses": [
                    {
                        "sense_id": "9bbe26f3-a666-3b41-8a8e-4f355b3c428d",
                        "entry_id": "f04b93c6-e6f9-387e-95a2-38c962e79aab",
                        "glosses": [
                            "Stadt im französischen Département Bouches-du-Rhône"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adcd2c49-d938-4b27-af8e-4463dab33107",
                                "sense_id": "9bbe26f3-a666-3b41-8a8e-4f355b3c428d",
                                "text": "Ihre Mutter wurde in Aix-en-Provence geboren."
                            },
                            {
                                "example_id": "9547f253-8ebe-4b9c-8de3-fa284cae699d",
                                "sense_id": "9bbe26f3-a666-3b41-8a8e-4f355b3c428d",
                                "text": "„Am Tag nach dem Fronleichnamsfest verließ ich Aix, um nach Marseille zu fahren; aber zuvor muß ich ein Wort über die Prozession sagen, die man an diesem Feiertag in allen katholischen Städten abhält, jedoch in Aix-en-Provence mit so sonderbaren Gebräuchen, daß ein Fremder, der darüber nicht verblüfft ist, ganz stumpf sein muß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b102b75b-d198-4cd8-937a-763974d91805",
                        "source_entry_id": "f04b93c6-e6f9-387e-95a2-38c962e79aab",
                        "source_sense_id": "9bbe26f3-a666-3b41-8a8e-4f355b3c428d",
                        "source_sense_description": "Stadt im französischen Département Bouches-du-Rhône",
                        "target_lang_word": "Aix-en-Provence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aix-en-Provence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db68fb7a-ce7a-397d-b7b9-733e9234b7d3",
                                        "entry_id": "07705aa9-3b49-3d51-a1fc-fd509919941c",
                                        "glosses": [
                                            "Commune française, située dans le département des Bouches-du-Rhône, ancienne capitale de la Provence (En provençal : Ais de Prouvènço)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c921b1b0-769a-4dc4-99b2-fd0bdccdf10c",
                                                "sense_id": "db68fb7a-ce7a-397d-b7b9-733e9234b7d3",
                                                "text": "Dans le quartier étudié dans le centre d’Aix-en-Provence, la circulation est rendue compliquée par le sens obligatoire de la rocade et l'étroitesse des rues ; […]."
                                            },
                                            {
                                                "example_id": "b09c65ac-bbec-42a6-8def-4dececee1412",
                                                "sense_id": "db68fb7a-ce7a-397d-b7b9-733e9234b7d3",
                                                "text": "Le convoi approche maintenant d’Aix-en-Provence. La nuit est sombre et un froid mistral ratisse violemment la contrée, par rafales convulsives. Une météo sévère très dissuasive pour un émeutier."
                                            },
                                            {
                                                "example_id": "5b4881a7-b28e-4e7d-a054-ca14b67bc2ad",
                                                "sense_id": "db68fb7a-ce7a-397d-b7b9-733e9234b7d3",
                                                "text": "Il y a dix ans, en 2005, on a connu une grève très marquante de deux semaines. Déclenchée à Aix-en-Provence, elle s'est propagée comme une traînée de poudre à l'ensemble du département, avec des milliers de postiers chauds comme la braise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
