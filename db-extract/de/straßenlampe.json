                    {
                        "translation_id": "420abbdb-5d17-4374-9a44-233525f73a23",
                        "source_entry_id": "1a72f0ee-d399-3095-843d-4cb715c2c23b",
                        "source_sense_id": "4bb734b7-cd9b-360f-bb45-1728ba258fca",
                        "source_sense_description": "an einem Mast oder an einer Hauswand angebrachte Lampe zur Beleuchtung von Straßen oder Plätzen",
                        "target_lang_word": "street light",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
