                        "sense_id": "cfac98d2-fc57-3b9c-bffa-cbf85187058e",
                        "entry_id": "d97e57bc-c292-3b8e-b216-c2bc2bbd16ca",
                        "glosses": [
                            "Something that prefigures."
                        ],
                        "tags": [
