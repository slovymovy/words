                "senses": [
                    {
                        "sense_id": "f6083e5e-434a-398b-9200-158af9f0c72d",
                        "entry_id": "efeaa739-703e-3cc4-8f6a-e811079c62df",
                        "glosses": [
                            "kleine längliche Mappe, in der Schreibutensilien aufbewahrt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ad8a4e-a454-4a63-9a9c-dfb0c30e1674",
                                "sense_id": "f6083e5e-434a-398b-9200-158af9f0c72d",
                                "text": "In einer Federmappe befinden sich häufig Buntstifte, Bleistift und ein Füller."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b1a80e0-df5a-47c3-8677-b50c831cbe34",
                        "source_entry_id": "efeaa739-703e-3cc4-8f6a-e811079c62df",
                        "source_sense_id": "f6083e5e-434a-398b-9200-158af9f0c72d",
                        "source_sense_description": "kleine längliche Mappe, in der Schreibutensilien aufbewahrt werden können",
                        "target_lang_word": "pencil case",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pencil case",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "925e3550-db8c-3481-9f90-119fe47b75cf",
                                        "entry_id": "2e9e6ffc-4aba-3bf2-9e38-22acdaf985a8",
                                        "glosses": [
                                            "An object purposed to contain different stationery like pencil, rubber, correction fluid, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d831df45-1105-41a5-8b1a-8f38a6d1d534",
                                                "sense_id": "925e3550-db8c-3481-9f90-119fe47b75cf",
                                                "text": "I love you from the bottom of my pencil case / I love the way you never ask me why"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b21bc903-8b7b-4913-bd33-7afdb1a551c7",
                        "source_entry_id": "efeaa739-703e-3cc4-8f6a-e811079c62df",
                        "source_sense_id": "f6083e5e-434a-398b-9200-158af9f0c72d",
                        "source_sense_description": "kleine längliche Mappe, in der Schreibutensilien aufbewahrt werden können",
                        "target_lang_word": "пенал",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пенал",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "61f5f88e-cf07-3c66-bb5a-ba1ba7bf2625",
                                        "entry_id": "31bec53f-9844-3fd3-ada8-63bab2801e66",
                                        "glosses": [
                                            "школьн. коробочка или футляр для хранения письменных принадлежностей (карандашей, ручек и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "334004a0-dd4c-4205-917e-92acfbe08bfb",
                                                "sense_id": "61f5f88e-cf07-3c66-bb5a-ba1ba7bf2625",
                                                "text": "За спиною у меня был новенький ранец, а в нём новенькие учебники в блестящих переплётах и красивый пенал со свежеотточенным карандашом, новенькой ручкой и резинкой."
                                            },
                                            {
                                                "example_id": "e05645ef-369d-4291-bd0d-b0825bdc8c4f",
                                                "sense_id": "61f5f88e-cf07-3c66-bb5a-ba1ba7bf2625",
                                                "text": "Первоклассник, стоявший рядом с её кабинетом, вздрогнул и уронил на пол деревянный пенал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94526d9c-c684-3f53-b7dd-22167f109bbc",
                                        "entry_id": "31bec53f-9844-3fd3-ada8-63bab2801e66",
                                        "glosses": [
                                            "спец. специализированный контейнер для хранения строго определённого содержимого"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "019b21a7-0195-4a4f-8c7d-68495a1979b5",
                                                "sense_id": "94526d9c-c684-3f53-b7dd-22167f109bbc",
                                                "text": "По три контейнера с застывшим радиоактивным стеклом упаковываются в один пенал из нержавеющей стали."
                                            },
                                            {
                                                "example_id": "88e80bc3-a1f3-4226-8f8b-341e92472944",
                                                "sense_id": "94526d9c-c684-3f53-b7dd-22167f109bbc",
                                                "text": "Поцарапанный осколками автомат имел пенал с ЗИПом на штатном месте в гнезде приклада."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
