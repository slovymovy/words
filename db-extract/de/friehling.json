                ],
                "senses": [
                    {
                        "sense_id": "e13878ab-1e3c-3571-a14b-94e10af83eeb",
                        "entry_id": "e92ce89e-b2cc-3af4-8a0e-89b47576d485",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "470458d8-9096-4f9b-8a7d-94222719e63d",
                                "sense_id": "e13878ab-1e3c-3571-a14b-94e10af83eeb",
                                "text": "Frau Friehling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "32d639f0-19c2-47e1-87e0-ff06c3d5797b",
                                "sense_id": "e13878ab-1e3c-3571-a14b-94e10af83eeb",
                                "text": "Herr Friehling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "51979cae-49df-4e93-9514-ac02bb088431",
                                "sense_id": "e13878ab-1e3c-3571-a14b-94e10af83eeb",
                                "text": "Die Friehlings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "cd6b6e17-6e37-4347-8879-aa4dabe4ac59",
                                "sense_id": "e13878ab-1e3c-3571-a14b-94e10af83eeb",
                                "text": "Der Friehling trägt nie die Schals, die die Friehling ihm strickt."
                            },
                            {
                                "example_id": "e6d8a889-47f6-4edf-901c-cc9cb982165a",
                                "sense_id": "e13878ab-1e3c-3571-a14b-94e10af83eeb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Friehling kommt, geht der Herr Friehling.“"
                            },
                            {
                                "example_id": "9826f314-fd8a-4287-b307-3bb8216cc1f8",
                                "sense_id": "e13878ab-1e3c-3571-a14b-94e10af83eeb",
                                "text": "Friehling kommt und geht."
                            },
                            {
                                "example_id": "20d0d88f-5ff4-49c0-8e42-0123de22a150",
                                "sense_id": "e13878ab-1e3c-3571-a14b-94e10af83eeb",
                                "text": "Friehlings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
