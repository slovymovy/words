                    {
                        "sense_id": "f54a6c0a-7ea2-3c62-9940-4875ac1a3a19",
                        "entry_id": "83eacbad-f77c-3375-a6c4-2dddf149e452",
                        "glosses": [
                            "Café."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b258cb60-d3f6-4723-b8c4-f0ffb1a39af6",
                                "sense_id": "f54a6c0a-7ea2-3c62-9940-4875ac1a3a19",
                                "text": "On se prend un p’ti caoua avant de reprendre le boulot ?"
                            },
                            {
                                "example_id": "d557e91c-9bc5-40df-869b-f67ebfd98e2a",
                                "sense_id": "f54a6c0a-7ea2-3c62-9940-4875ac1a3a19",
                                "text": "En attendant le caoua, on roule la cigarette, on bourre la pipe."
                            },
                            {
                                "example_id": "d24a8a24-01ae-4e53-8611-bc24c40cbfc9",
                                "sense_id": "f54a6c0a-7ea2-3c62-9940-4875ac1a3a19",
                                "text": "Debout, Ninette ! il la houspille. Va nous préparer un bon caoua, ma poule, qu’autrement, mes idées font la colle."
                            },
                            {
                                "example_id": "53cf43c8-cb08-422b-858a-a9c988f1203a",
                                "sense_id": "f54a6c0a-7ea2-3c62-9940-4875ac1a3a19",
                                "text": "Hamid, la molécule de caoua ingérée, reprit le fil de son récit."
                            },
                            {
                                "example_id": "00f30712-a9d1-4bc9-8272-eda9a32a7ece",
                                "sense_id": "f54a6c0a-7ea2-3c62-9940-4875ac1a3a19",
                                "text": "Et avec les bouleversements climatiques et les tensions géopolitiques, le caoua deviendra un jour un produit de luxe, prédisent certains experts."
                            }
                        ]
                    }
