                    {
                        "translation_id": "b04491ce-ae74-449a-bd2c-9109a4d2b655",
                        "source_entry_id": "9cb5f673-eac4-397b-be86-7c033370e769",
                        "source_sense_id": "b94c0de5-624e-3524-bbde-2c2b33340941",
