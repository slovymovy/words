            "senses": [
                {
                    "sense_id": "b1f4f8f4-d89a-32ee-87b5-bb8a590f5f73",
                    "sense_definition": "Simple past and past participle of <w>lend</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>lent</w> me her favorite book last week.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе она <w>одолжила</w> мне свою любимую книгу."
                            }
                        },
                        {
                            "text": "He has <w>lent</w> money to his friends many times.",
                            "target_lang_translations": {
                                "ru": "Он много раз <w>одалживал</w> деньги своим друзьям."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb lend."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «одалживать» (lend)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одолжил",
