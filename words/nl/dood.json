        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "02080267-bc2b-34a1-b886-8a7715d891ec",
                    "sense_definition": "niet meer levend",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vogel lag <w>dood</w> op de grond in de tuin.",
                            "target_lang_translations": {
                                "en": "The bird lay <w>dead</w> on the ground in the garden.",
                                "ru": "Птица лежала <w>мертвой</w> на земле в саду."
                            }
                        },
                        {
                            "text": "Mijn grootouders zijn al heel lang <w>dood</w>.",
                            "target_lang_translations": {
                                "en": "My grandparents have been <w>dead</w> for a very long time.",
                                "ru": "Мои бабушка и дедушка уже очень давно <w>мертвы</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "levend"
                    ],
                    "common_phrases": [
                        "zo dood als een pier"
                    ],
                    "target_lang_definitions": {
                        "en": "no longer living",
                        "ru": "больше не живой"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dead",
                                "target_lang_sense_clarification": "no longer alive"
                            },
                            {
                                "target_lang_word": "deceased",
                                "target_lang_sense_clarification": "formal term for dead"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мертвый",
                                "target_lang_sense_clarification": "неживой"
                            },
                            {
                                "target_lang_word": "умерший",
                                "target_lang_sense_clarification": "более формально о человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e89b76aa-6cd0-3456-87ad-b10f08de5a6a",
                    "sense_definition": "niet langer werkend of niet meer functionerend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "functioneren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wilde haar bellen, maar de lijn was <w>dood</w>.",
                            "target_lang_translations": {
                                "en": "He wanted to call her, but the line was <w>dead</w>.",
                                "ru": "Он хотел позвонить ей, но линия <w>не работала</w>."
                            }
                        },
                        {
                            "text": "De batterij van mijn telefoon is helemaal <w>dood</w>.",
                            "target_lang_translations": {
                                "en": "My phone's battery is completely <w>dead</w>.",
                                "ru": "Аккумулятор моего телефона совсем <w>разрядился</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "no longer working or functioning",
                        "ru": "больше не работающий или не функционирующий"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dead",
                                "target_lang_sense_clarification": "not functioning or out of power"
                            },
                            {
                                "target_lang_word": "broken",
                                "target_lang_sense_clarification": "not working"
                            },
                            {
                                "target_lang_word": "flat",
                                "target_lang_sense_clarification": "referring to a battery"
