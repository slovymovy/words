                    {
                        "sense_id": "ef08e630-6e43-38c9-8ab9-bd226415e12e",
                        "entry_id": "2c219abc-54b0-3b79-b547-10ac4d8963d0",
                        "glosses": [
                            "enthaarte und gegerbte Haut von wild lebenden Tieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5938146f-cba7-4516-9a10-e45d7369630a",
                                "sense_id": "ef08e630-6e43-38c9-8ab9-bd226415e12e",
                                "text": "Er trägt eine Jacke aus Wildleder."
                            },
                            {
                                "example_id": "ff961c35-504e-4797-8f61-9c9061eda875",
                                "sense_id": "ef08e630-6e43-38c9-8ab9-bd226415e12e",
                                "text": "„Sie lernte mit der Ahle aus zugeschabter Hirschgeweihsprosse und Garn aus gepechter Hirschsehne Wildleder zu Wams und Schuh zu nähen und sogar zierlich farbig auszusteppen, den Mokassin mit Schoppenpelz auszufüttern, Linseytuch aus Flachs und Einschlag von Büffelwolle zu weben, Kerzen zu ziehen und Wildbret einzupökeln – Frauenkünste des Urwalds, die auch den andern Müttern von Worms gezeigt, doch bald versäumt und verschmäht worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ba024e64-0f39-3688-94ea-8cc97d745855",
                        "entry_id": "2c219abc-54b0-3b79-b547-10ac4d8963d0",
                        "glosses": [
                            "jedes Leder mit rauer Oberfläche"
                        ],
                        "tags": [
                            "fälschlich"
                        ],
                        "examples": [
                            {
                                "example_id": "192e88dc-8ac2-4b8a-8391-c35f32043aa7",
                                "sense_id": "ba024e64-0f39-3688-94ea-8cc97d745855",
                                "text": "Wildleder muss anders gepflegt werden als normales Leder."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
