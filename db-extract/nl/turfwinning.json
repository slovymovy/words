                ],
                "translations": [
                    {
                        "translation_id": "7f1dd5e0-4874-4555-a176-4422463ef0ed",
                        "source_entry_id": "aa862545-63d0-380d-8bbe-6c97e79eceb4",
                        "source_sense_id": "fbe32cb0-d791-39fa-91e8-8423d5769731",
                        "source_sense_description": "het delven en gebruiksklaar maken van turf",
                        "target_lang_word": "Torfabbau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Torfabbau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                        "entry_id": "59acec1f-b235-3cca-ab59-1a81c0f5dc3f",
                                        "glosses": [
                                            "oberirdische Gewinnung von Torf (= ein faseriges, trockenes Material aus Mooren) meist um ihn zu verbrennen oder für den Einsatz im Gartenbau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bef0298-3be0-4bac-aa1a-8426db752ac1",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "[Teufelsmoor:] „Bis heute wird aber eine unwiederbringliche Zerstörung des Moores (Torfabbau) betrieben.“"
                                            },
                                            {
                                                "example_id": "6c12c022-0d0d-41df-b363-d597b7ff016c",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "„Im 19. und 20. Jahrhundert lebte ein Großteil der Bewohner des Ammerlandes von der Landwirtschaft und vom Torfabbau.“"
                                            },
                                            {
                                                "example_id": "3bee7334-1331-4387-b3f5-69336424ff73",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "„1874 wurde die Staatliche Torfverwaltung gegründet, 1879 mit dem maschinellen Torfabbau begonnen, 1885 eine Torffabrik gebaut, und die Torfausbeutung wurde auf ein industrielles Niveau gebracht.“"
                                            },
                                            {
                                                "example_id": "6d286f24-0f3f-4edc-ad3e-7fe2fa037d0c",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "„Beim Torfabbau werden große Mengen CO2 frei und so entweicht auch aus unseren Pflanzkübeln zu Hause ein Großteil der Klimagase.“"
                                            },
                                            {
                                                "example_id": "d8864419-3592-4d97-983e-c13c454a5f04",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "„Torfabbau hat zwar nur einen sehr kleinen Anteil an diesen Emissionen. Aber: Beim Torfabbau entweichen die gebundenen Klimagase besonders schnell.“"
                                            },
                                            {
                                                "example_id": "644e4a3f-62a7-4026-82fb-731b8d0f4fe4",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "„Im Jahr 2018 sind in Deutschland etwa 2,19 Millionen Tonnen Klimagase durch Torfabbau entstanden, gibt der Industrieverband Garten e. V. an.“"
                                            },
                                            {
                                                "example_id": "a655beda-1743-438d-a323-bcf23e4afd93",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "„Moore haben eine grosse Bedeutung für Klima und Biodiversität. Verschwinden sie unter anderem durch den Torfabbau, hat dies weitreichende Folgen.“"
                                            },
                                            {
                                                "example_id": "62e90f79-04c5-436b-bb07-84c59af12b71",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "„Torfabbau gefährdet das empfindliche Ökosysteme intakter Moorlandschaften und damit auch die Pflanzen- und Tierarten, die sich an die Lebensbedingungen mit nährstoffarmem und saurem Boden perfekt angepasst haben. Verschwinden Moore, so sterben auch sie aus.“"
                                            },
                                            {
                                                "example_id": "6fea8432-05b9-4063-911a-04cde83ce875",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "„In Deutschland gibt es fast keine Moorflächen mehr. Nur noch etwa fünf Prozent sind bislang nicht für Land- oder Forstwirtschaft oder eben den Torfabbau trockengelegt worden. Alle anderen Moore, und damit auch sehr artenreiche Lebensräume, sind verschwunden.“"
                                            },
                                            {
                                                "example_id": "f0c3cb6c-f2dd-49ec-996f-c520b466ef53",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "In Estland sind beispielsweise mehr als 20 Prozent der Landesfläche Moore. Und wenn der Torfabbau weitgehend in diese Länder verlagert wird, fürchtet Christine Margraf vom BUND, dass \"dort jetzt diese artenreichen und für den Klimaschutz so wichtigen Moore zerstört werden.\""
                                            },
                                            {
                                                "example_id": "2216093a-790d-4f79-897d-dd37fe078a32",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "„Die Trockenlegung von Mooren und Sümpfen für den Torfabbau schadet dem Klima gleich doppelt.“"
                                            },
                                            {
                                                "example_id": "79034c72-1486-4631-9f6a-c04403649f3a",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "„Ähnlich wie im Tagebau betrieb der halbstaatliche Energiekonzern Bord na Móna Torfabbau im industriellen Maßstab - in diesem Januar gab er den endgültigen Ausstieg aus dem Abbau bekannt.“"
                                            },
                                            {
                                                "example_id": "fcd881e6-6821-4710-a8ec-26bfdc1bc947",
                                                "sense_id": "50fdf265-b602-3c7e-b665-cea85076497c",
                                                "text": "[Gartenerde:] „»Die meisten Substrate auf dem Markt enthalten Torf, und beim Torfabbau werden Moore zerstört«, sagt Müller. »Wir arbeiten mit alternativen Materialien und kommen vollkommen ohne Torf aus.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
