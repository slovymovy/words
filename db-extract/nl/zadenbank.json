                        "entry_id": "288d34ab-6743-3c7f-9c52-75f79a61368e",
                        "glosses": [
                            "bewaarplaats voor zaden van veel verschillende planten om een grote verscheidenheid aan erfelijke eigenschappen in de toekomst voor onderzoekers en kwekers beschikbaar te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4deb56f7-7b92-4aad-b592-701fedf8abac",
                                "sense_id": "975c7b04-9bfa-3f47-af3a-6cbde3b4d13c",
                                "text": "Op Spitsbergen is er een zadenbank in gebruik genomen om zaden van voedselgewassen te conserveren."
                            },
                            {
                                "example_id": "c587d65f-6ef2-4855-9a12-d3b24e94d4c4",
                                "sense_id": "975c7b04-9bfa-3f47-af3a-6cbde3b4d13c",
                                "text": "De zonnige akker ziet er met zijn honderden bedden vrolijk uit, maar Walrecht is niet vrolijk. Hij leeft van de bijstand, terwijl zijn zadenbank een goudmijn zou kunnen zijn. „Tot in Noorwegen vragen akkerbouwers ons zaden. In het koude klimaat daar leggen moderne, commerciële rassen het loodje.”"
                            }
                        ]
                    }
