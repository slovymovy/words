                        "entry_id": "8d81a276-5b1d-3386-899a-c1fa78e0f633",
                        "glosses": [
                            "Unité contenant 180 morues."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1ae87c83-e6fe-4c7d-8f2f-071d9f9e9691",
                                "sense_id": "a9bfb9d6-a5bc-31fe-bda7-a8e2c8a01fbe",
                                "text": "Un last d’harengs est aussi de 12 bariques contenant environ 80 harengs chaque. Un roll de morues est de 180."
