            "senses": [
                {
                    "sense_id": "41b788f8-b744-38d1-9b2b-4e66c7eff2a1",
                    "sense_definition": "Grand mammifère herbivore des forêts tempérées, dont le mâle porte des bois ramifiés qui tombent et repoussent chaque année.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le grand <w>cerf</w> sauta par-dessus la haie et disparut dans la forêt."
                        },
                        {
                            "text": "À l'automne, on peut entendre le brame du <w>cerf</w> résonner dans les sous-bois."
                        }
                    ],
                    "common_phrases": [
                        "bois de cerf",
                        "brame du cerf",
                        "cerf élaphe"
                    ]
                },
                {
                    "sense_id": "bc9d596c-0356-3883-abb5-0b63f84c640f",
                    "sense_definition": "Figure représentant cet animal dans les armoiries, généralement représenté passant avec sa ramure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "héraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason médiéval de cette commune est orné d'un <w>cerf</w> d'or sur champ d'azur."
                        },
                        {
                            "text": "Cette ancienne maison noble portait un <w>cerf</w> passant sur son écu."
                        }
                    ],
                    "common_phrases": [
                        "cerf passant"
                    ]
                }
            ]
        }
