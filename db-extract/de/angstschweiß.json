                ],
                "senses": [
                    {
                        "sense_id": "5b303583-ca60-333e-ae0f-6e6583668d6e",
                        "entry_id": "258d2c2e-a4a3-3cd1-a560-c28bf36b9a55",
                        "glosses": [
                            "Schweiß, der bei einer Person, die in Angst ist, plötzlich austritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e96123b-7c39-4f77-ad17-7f7e02ba05e3",
                                "sense_id": "5b303583-ca60-333e-ae0f-6e6583668d6e",
                                "text": "„Mir brach der Angstschweiß aus, der Blutdruck schnellte spürbar hoch.“"
                            },
                            {
                                "example_id": "69a89322-0627-4dbb-83c4-39594a286f74",
                                "sense_id": "5b303583-ca60-333e-ae0f-6e6583668d6e",
                                "text": "„Tourkys Lebensgeschichte und seine Beschreibung der Situation in diesem Land hatten ihm den Angstschweiß auf die Stirn getrieben.“"
                            },
                            {
                                "example_id": "131be9ef-2a57-4db6-a557-337ec316ebe8",
                                "sense_id": "5b303583-ca60-333e-ae0f-6e6583668d6e",
                                "text": "„Bei Goldlotos brach der Angstschweiß aus, ihre Hände krampften sich zusammen, kannte sie doch die Ursache nicht.“"
                            },
                            {
                                "example_id": "387c448d-49bd-405d-92b9-84f95076ef6a",
                                "sense_id": "5b303583-ca60-333e-ae0f-6e6583668d6e",
                                "text": "„Statt Lustschweiß quillt ihm Angstschweiß aus allen Poren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad902281-93fa-49ee-9dee-4276de95b868",
                        "source_entry_id": "258d2c2e-a4a3-3cd1-a560-c28bf36b9a55",
                        "source_sense_id": "5b303583-ca60-333e-ae0f-6e6583668d6e",
                        "source_sense_description": "Schweiß, der bei einer Person, die in Angst ist, plötzlich austritt",
                        "target_lang_word": "cold sweat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cold sweat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a9d9d24-15b6-3582-8f44-d90dcb512bf0",
                                        "entry_id": "3975f2f1-2aaf-3d89-accf-12b3be53be45",
                                        "glosses": [
                                            "Perspiration which feels chilly to the person perspiring, and which indicates debilitating illness, shock, or the experiencing of an intense emotion such as despair, anxiety, or, especially, fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7a3dc6c-7d7b-4875-abe8-b641e35e21ab",
                                                "sense_id": "1a9d9d24-15b6-3582-8f44-d90dcb512bf0",
                                                "text": ". . .\nAnd the dead were at my feet.\nThe cold sweat melted from their limbs,\nNe rot, ne reek did they;\nThe look with which they look'd on me,\nHad never pass'd away."
                                            },
                                            {
                                                "example_id": "8c8b6517-beb1-4822-80eb-f02f02bd331a",
                                                "sense_id": "1a9d9d24-15b6-3582-8f44-d90dcb512bf0",
                                                "text": "He clasped his hands together, and involuntarily uttered a subdued exclamation of horror. A mist came before his eyes; the cold sweat stood upon his ashy face."
                                            },
                                            {
                                                "example_id": "9cb09b8d-375f-4402-b9ff-9ea4c1c705cd",
                                                "sense_id": "1a9d9d24-15b6-3582-8f44-d90dcb512bf0",
                                                "text": "[T]he great fear grew on me till the cold sweat ran from my brow and my soul was faint within me."
                                            },
                                            {
                                                "example_id": "ff9ac456-442f-48ea-a53b-0808036bb17e",
                                                "sense_id": "1a9d9d24-15b6-3582-8f44-d90dcb512bf0",
                                                "text": "The leader of the hounds broke into cry again, a deep, full-toned, ringing bay, strange, ominous, terribly significant in its power. It caused a cold sweat to ooze out all over Duane's body."
                                            },
                                            {
                                                "example_id": "f5c767b8-43ae-4ba2-9199-6024ff83ac25",
                                                "sense_id": "1a9d9d24-15b6-3582-8f44-d90dcb512bf0",
                                                "text": "One could argue that the banking crisis is just the cold sweat, not the flu that follows it"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
