                "senses": [
                    {
                        "sense_id": "31824996-9482-3066-9c9e-938e9a974be0",
                        "entry_id": "485491b3-c558-33f2-bb18-b31d1cad2ce1",
                        "glosses": [
                            "Roman, in dem der Held ein oder mehrere Abenteuer oder Irrfahrten bestehen muss und der meist in einem volkstümlich-realistischen Stil verfasst ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21db532c-50d4-4f70-938f-02f65d91e5c5",
                                "sense_id": "31824996-9482-3066-9c9e-938e9a974be0",
                                "text": "Am liebsten liest sie Abenteuerromane."
                            },
                            {
                                "example_id": "2d8e92f4-14b1-46d4-8e70-25dca247fc85",
                                "sense_id": "31824996-9482-3066-9c9e-938e9a974be0",
                                "text": "„Neben einigen Gelegenheitsgedichten, die ungedruckt blieben, schrieb er zwei Abenteuerromane in der in Italien beliebten Versform Ottaverime (Oktave).“"
                            },
                            {
                                "example_id": "fa34766b-bd2a-4301-baa3-d0f6e8750a5f",
                                "sense_id": "31824996-9482-3066-9c9e-938e9a974be0",
                                "text": "„Das Genre, das er auf diese Weise gewissermaßen streift, ist der Reise- und Abenteuerroman.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
