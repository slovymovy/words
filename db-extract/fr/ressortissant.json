                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staatsburger",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "83095a75-f861-388a-9144-8a72fb787cdd",
                                        "entry_id": "b3709d0c-bbeb-34af-84ad-6fcb178b38a9",
                                        "glosses": [
                                            "iemand die burgerrechten in een staat heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ae0354-c892-4786-933e-8a23ac15c762",
                                                "sense_id": "83095a75-f861-388a-9144-8a72fb787cdd",
                                                "text": "De staatsburgers demonstreerden tegen de aanname van de nieuwe wet."
                                            },
                                            {
                                                "example_id": "ae446ffa-aaf3-4fc4-80b6-94e73370a5d8",
                                                "sense_id": "83095a75-f861-388a-9144-8a72fb787cdd",
                                                "text": "Je heet, je moet me de uitspraak niet kwalijk nemen, ging hij verder, nog steeds met diezelfde vreemde blik, je heet Eric Henri Oscar Lauritz Letang. En je bent Frans staatsburger."
                                            },
                                            {
                                                "example_id": "9907e672-f438-4518-91ed-3ee76e7aa29e",
                                                "sense_id": "83095a75-f861-388a-9144-8a72fb787cdd",
                                                "text": "Nieuwe socialistische wetten gaven deze instanties het recht om ook als de buitenlandreizigers onberispelijke staatsburgers waren naar smokkelgeld te zoeken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
