                ],
                "senses": [
                    {
                        "sense_id": "ec62f12f-8dba-360f-a27e-489975e61d8a",
                        "entry_id": "b15c3c09-bc75-3659-94a9-828a92634596",
                        "glosses": [
                            "Ne plus communiquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83de8f88-a90d-4633-a02e-ec488b9ea15a",
                                "sense_id": "ec62f12f-8dba-360f-a27e-489975e61d8a",
                                "text": "Il vient tout simplement du fait que, depuis notre enfance, nous avons surtout appris à “décommuniquer” en croyant apprendre à communiquer !"
                            },
                            {
                                "example_id": "0ca260e6-888c-4db4-a524-ee537adfb4cb",
                                "sense_id": "ec62f12f-8dba-360f-a27e-489975e61d8a",
                                "text": "Outre qu’un individu peut toujours se faire une niche à part dans une médiasphère (et même choisir de « décommuniquer »), le sens d’une technique de pointe n’est jamais donné à l’origine, ni son efficacité garantie."
                            },
                            {
                                "example_id": "3f437a00-62fb-4512-82bc-5638a3235659",
                                "sense_id": "ec62f12f-8dba-360f-a27e-489975e61d8a",
                                "text": "Phore et autre s’effacent devant cet Autre, si le sujet s’immobilise, contemplativement se décommunique, s’excommunie."
                            }
                        ]
                    }
                ],
