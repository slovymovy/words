                                "example_id": "811c6f6c-72da-4fb1-946d-30e8281db53a",
                                "sense_id": "09fa055e-d223-3c6d-9d65-fb495f60357e",
                                "text": "'Er is iets wat je moet weten,' zei ze, geïrriteerd om zijn ontwijkende antwoord."
                            }
                        ]
                    }
