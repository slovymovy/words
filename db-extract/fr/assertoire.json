                        "glosses": [
                            "Relatif à une assertion, au fait d'affirmer, d'assurer que."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f1fef2a-74aa-42a6-913f-86f98b14ab84",
                                "sense_id": "866d0bc8-e006-3d56-ae96-65e909fae78a",
                                "text": "Le serment se divisait en assertoire et en promissoire : le premier se faisait pour assurer une chose présente ou passée ; le second, pour garantir une promesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "39a5be71-1a82-3b26-bf83-dc329233d185",
                        "entry_id": "3b5b4bae-56ca-3cc4-8633-db962299cc75",
                        "glosses": [
                            "Chez Kant, qualifie un jugement qui peut être l’objet d’une simple assertion, à laquelle ne se joint aucune idée de nécessité."
                        ],
                        "tags": [],
                        "examples": []
                    }
