                ],
                "translations": [
                    {
                        "translation_id": "8a4291e5-5dff-4d6f-8d35-8231ca67e774",
                        "source_entry_id": "7dab8e37-f669-387a-8ead-5739e55fe0b4",
                        "target_lang_word": "grow up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grow up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ca865a4-684e-3fc3-b6f9-bb099b7a757d",
                                        "entry_id": "68cdc230-c2f5-3444-9289-3aa2e5d00dc6",
                                        "glosses": [
                                            "To mature and become an adult."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a599449-5536-47cf-87f5-845092aa07b7",
                                                "sense_id": "8ca865a4-684e-3fc3-b6f9-bb099b7a757d",
                                                "text": "What do you want to be when you grow up?"
                                            },
                                            {
                                                "example_id": "fd445ac6-e1aa-4b64-a101-53ca4cbe7328",
                                                "sense_id": "8ca865a4-684e-3fc3-b6f9-bb099b7a757d",
                                                "text": "Attila grew up a nomad on the plains of Hungary"
                                            },
                                            {
                                                "example_id": "e355be0c-20b8-4fe0-a65c-477236812e5f",
                                                "sense_id": "8ca865a4-684e-3fc3-b6f9-bb099b7a757d",
                                                "text": "I'm in the place where I grew up, where my alma mater is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73734170-60ed-3e14-b328-50a52b245566",
                                        "entry_id": "68cdc230-c2f5-3444-9289-3aa2e5d00dc6",
                                        "glosses": [
                                            "To start to develop; to flourish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d74ff69-5bd4-48c7-b090-89a7c222d35f",
                                                "sense_id": "73734170-60ed-3e14-b328-50a52b245566",
                                                "text": "Socialism grew up in the industrial cities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fb0627a-faec-336d-8a61-05cd09d70f29",
                                        "entry_id": "68cdc230-c2f5-3444-9289-3aa2e5d00dc6",
                                        "glosses": [
                                            "To stop acting as or like a child (often used as an imperative interjection)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a3ae54f-1316-4d46-ac0d-621ce6ed761e",
                                                "sense_id": "0fb0627a-faec-336d-8a61-05cd09d70f29",
                                                "text": "Will you grow up please, and stop making silly faces?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grow up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ca299e4-6dcf-3758-821e-ef17bfc4fbf8",
                                        "entry_id": "b604535f-efd1-369e-bf11-7937692e225d",
                                        "glosses": [
                                            "Used to criticize childish behavior, especially that considered unreasonable for one's age."
                                        ],
                                        "tags": [
                                            "imperative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e930a5cc-24a3-4ffd-bf2d-cd78e7f8c27e",
                                                "sense_id": "5ca299e4-6dcf-3758-821e-ef17bfc4fbf8",
                                                "text": "You're giggling because I said \"butt\"? Grow up, seriously."
                                            },
                                            {
                                                "example_id": "70457b83-bece-45ae-a8f3-b85f6393a1c9",
                                                "sense_id": "5ca299e4-6dcf-3758-821e-ef17bfc4fbf8",
                                                "text": "Grow up! The Bible is nothing more than a astrotheological allegory for things like the Sun!"
                                            }
                                        ]
                                    }
