                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f8b8dc6-5920-3fab-8219-52a9b5130db3",
                                        "entry_id": "3524a66d-9a87-339d-94d5-b74c4215d184",
                                        "glosses": [
                                            "To act like a stereotypical grandmother; to fuss."
                                        ],
                                        "tags": [
                                            "informal",
