                        "glosses": [
                            "разг. слишком упрямый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4712fd82-43c7-4524-b326-8d9adef98ce0",
                                "sense_id": "fa596fc8-fc25-344b-bc92-6e926daac421",
                                "text": "Князь Николай Семенович был добрый и честный человек, но по характеру самый несносный: преупрямый и пребешеный, и что в особенности для его жены было тяжело: рассердится и несколько дней молчит, ни слова не скажет."
                            },
