                {
                    "sense_id": "f0a4a2bc-fde2-350a-823d-3864e1829f87",
                    "sense_definition": "Signs, particularly those imparting commercial, directional, or road traffic information, taken collectively.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>signage</w> at the airport is designed to point the way clearly to important locations.",
                            "target_lang_translations": {
                                "ru": "<w>Система навигации</w> в аэропорту разработана так, чтобы четко указывать путь к важным объектам."
                            }
                        },
                        {
                            "text": "The city council decided to update the road <w>signage</w> to improve traffic flow and safety.",
                            "target_lang_translations": {
                                "ru": "Городской совет решил обновить дорожные <w>знаки</w>, чтобы улучшить транспортный поток и безопасность."
                            }
                        }
                    ],
                    "synonyms": [
                        "signs"
                    ],
                    "common_phrases": [
                        "road signage",
                        "digital signage",
                        "directional signage",
                        "station signage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знаки, особенно коммерческие, указательные или дорожные, рассматриваемые как совокупность."
                    },
                    "translations": {
                        "ru": [
                            {
