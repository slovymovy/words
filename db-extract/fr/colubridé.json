                "forms": [
                    {
                        "form_id": "86455e01-04e1-4cbe-879c-dc44f5430aad",
                        "entry_id": "75213780-dc1f-3906-a5b8-e6e7459515de",
                        "tags": [
                            "plural"
                        ],
                        "form": "colubridés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "84f05ffc-2c91-3fb6-9ff7-c80d031fdeaf",
                        "entry_id": "75213780-dc1f-3906-a5b8-e6e7459515de",
                        "glosses": [
                            "Serpent du type couleuvre, les Colubridés sont une famille de reptiles de l’ordre des squamates représentant environ la moitié des espèces de serpents existantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "792bec71-f1e1-4216-903c-d209ea26b3fe",
                                "sense_id": "84f05ffc-2c91-3fb6-9ff7-c80d031fdeaf",
                                "text": "Le nasique est un magnifique colubridé arboricole d’Indonésie."
                            },
                            {
                                "example_id": "2b3260f3-59ba-48bd-aa9a-01dab1e8495f",
                                "sense_id": "84f05ffc-2c91-3fb6-9ff7-c80d031fdeaf",
                                "text": "« Cet animal appartient évidemment à la famille des colubridés.\n– Sans aucun doute, dit mon père, car il n’a pas de crochets.\n– Bien observé, dit M. le curé. Mais, ajouta-t-il en levant l’index, il ne s’agit nullement de la colubra gigantea, comme vous pourriez le croire… »"
                            },
                            {
                                "example_id": "a24db139-1d98-449c-b99c-fc702183b609",
                                "sense_id": "84f05ffc-2c91-3fb6-9ff7-c80d031fdeaf",
                                "text": "Pour un colubridé non venimeux, la morsure peut porter jusqu’à 35 à 40 petites empreintes de crochets, réparties selon deux lignes à peu près parallèles, doublées à l’extérieur de 20 à 22 crochets (appartenant à la mâchoire supérieure)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8530177-dadb-4aad-ab6c-b7f36eef2e6c",
                        "source_entry_id": "75213780-dc1f-3906-a5b8-e6e7459515de",
                        "source_sense_id": "84f05ffc-2c91-3fb6-9ff7-c80d031fdeaf",
                        "target_lang_word": "Natter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Natter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f92aa04-6bfe-398f-8820-c8aa9205334b",
                                        "entry_id": "d892cf5b-986c-3bd4-aac2-1a053deef790",
                                        "glosses": [
                                            "Schlange aus der Familie der Colubridae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6397355-cb3e-4bdf-a41c-79eeb2ad539c",
                                                "sense_id": "7f92aa04-6bfe-398f-8820-c8aa9205334b",
                                                "text": "Nattern sind meist ungiftige Schlangen."
                                            },
                                            {
                                                "example_id": "ed4d3f47-fea3-457b-a292-321d7dcab11b",
                                                "sense_id": "7f92aa04-6bfe-398f-8820-c8aa9205334b",
                                                "text": "„Dann hatte die Natter plötzlich seinen Kopf in dem weitaufgerissenen Rachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                        "entry_id": "d892cf5b-986c-3bd4-aac2-1a053deef790",
                                        "glosses": [
                                            "hinterhältige Person"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfc0bdf8-91ea-4581-b370-78bcae33a283",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "Meine Banknachbarin ist eine richtige Natter. Sie ist immer freundlich zu mir, um dann in meiner Abwesenheit über mich zu lästern."
                                            },
                                            {
                                                "example_id": "091a3311-fce7-446d-9df9-c82044b0838e",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "„Entweder war Loretta dumm wie Brot oder eine hinterhältige Natter.“"
                                            },
                                            {
                                                "example_id": "23120bc1-3b0f-4293-94b5-6fcc5f2c8798",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "„»Halt den Mund, du miese Natter«, sagte Josua.“"
                                            },
                                            {
                                                "example_id": "11538219-1824-4ffc-9425-a91872e86bb4",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "„Die miese Natter hatte sich auf den Boden gelegt und stellte sich tot, dabei war sie nicht mal verwundet, ihre Gestalt leuchtete hell wie eh und je!“"
                                            },
                                            {
                                                "example_id": "1f9ae1b5-552d-4dab-9784-011876d46d82",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "„Oh, was war er doch für eine hinterlistige, grausame Natter!“"
                                            },
                                            {
                                                "example_id": "4bd857e2-acab-4e70-97d2-3059c24502ea",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "„»Schweig, du Natter! Unsere Zelte wolltet ihr überfallen, hinterlistig, ohne dass das Kriegsbeil ausgegraben war! Ist das die Art von Kriegern?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
