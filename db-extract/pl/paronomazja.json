                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d92e7c5-c4d5-4367-b4be-4755c29cd387",
                        "source_entry_id": "5eda2174-e015-30e2-8c28-269d363687c4",
                        "source_sense_id": "cb4e6d4e-5efe-3fa9-bf83-f1cc59334c95",
                        "target_lang_word": "paronomasia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paronomasia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76064f4a-0163-3ac8-8aaa-c78437388a49",
                                        "entry_id": "dbd12154-92d3-3316-8eaf-9234984f3b97",
                                        "glosses": [
                                            "A pun or play on words."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e837daf8-bc48-4b23-b041-ba1df61f794f",
                                                "sense_id": "76064f4a-0163-3ac8-8aaa-c78437388a49",
                                                "text": "Oh, by the way, any attempt to present me with any kind of testimonial will result in stern measures.\nAnd when I say stern measures, I am indulging in a paronomasia, or play on words! Good night."
                                            },
                                            {
                                                "example_id": "ee876709-07de-4757-9add-d51e0927acf5",
                                                "sense_id": "76064f4a-0163-3ac8-8aaa-c78437388a49",
                                                "text": "Ev’rywhere but at Norfolk, where talk of Passion far outweighs its Enactment,– indeed, the Sailors’ paronomasia for that wretched Place,\nis ‘No-Fuck’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c0049c5-f31e-33c3-ad42-f71e25710ee9",
                                        "entry_id": "dbd12154-92d3-3316-8eaf-9234984f3b97",
                                        "glosses": [
                                            "The use of puns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "343ce377-2454-47dd-926e-6e580253b2e6",
                                                "sense_id": "9c0049c5-f31e-33c3-ad42-f71e25710ee9",
                                                "text": "Paronomasia to the sense alludes,\nWhen words but little varied it includes."
                                            },
                                            {
                                                "example_id": "d6f256fc-5fe0-4383-9650-9f2ce99e5255",
                                                "sense_id": "9c0049c5-f31e-33c3-ad42-f71e25710ee9",
                                                "text": "[…] he gloomily regarded his new digital watch, faintly fascinated by the onward march of the square figures\nwhich turned one into the other with insolent ease, a kind of numerical paronomasia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b4042ac-2084-4749-b94c-beebeed832ba",
                        "source_entry_id": "5eda2174-e015-30e2-8c28-269d363687c4",
                        "source_sense_id": "cb4e6d4e-5efe-3fa9-bf83-f1cc59334c95",
                        "target_lang_word": "pun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2197e458-fec7-3b30-b2fe-625bf1e1bc2a",
                                        "entry_id": "4abe2dc9-3e73-382a-b22c-50fd74fe0ca8",
                                        "glosses": [
                                            "To beat; strike with force; to ram; to pound, as in a mortar; reduce to powder, to pulverize."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17af3a82-d102-4b03-b1da-50cd4586409f",
                                                "sense_id": "2197e458-fec7-3b30-b2fe-625bf1e1bc2a",
                                                "text": "He would pun thee into shivers with his fist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1071de2-4209-301d-a45e-f1511d2da281",
                                        "entry_id": "4abe2dc9-3e73-382a-b22c-50fd74fe0ca8",
                                        "glosses": [
                                            "To make or tell a pun; to make a play on words."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2ebd875-aa0a-4014-aa5d-5aac48e9f2cf",
                                                "sense_id": "c1071de2-4209-301d-a45e-f1511d2da281",
                                                "text": "We punned about the topic until all around us groaned."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4f8c7f-bd3c-3e86-9742-7c998bd074bb",
                                        "entry_id": "9fe95fa7-1c2e-3664-98e7-403031a36c4c",
                                        "glosses": [
                                            "A joke or type of wordplay in which similar definitions or sounds of two words or phrases, or different definitions of the same word, are deliberately confused."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7735152a-2137-48bf-8667-4228b6c3c451",
                                                "sense_id": "bc4f8c7f-bd3c-3e86-9742-7c998bd074bb",
                                                "text": "The pun is the lowest form of wit."
                                            },
                                            {
                                                "example_id": "555ce09b-890d-46f1-9172-42d131d3abdd",
                                                "sense_id": "bc4f8c7f-bd3c-3e86-9742-7c998bd074bb",
                                                "text": "\"Certainly, my home at my uncle's brought me acquainted with a circle of admirals. Of Rears, and Vices, I saw enough. Now do not be suspecting me of a pun, I entreat.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b4cfdbb-0f5a-3414-9025-3f7503ecd2cb",
                                        "entry_id": "cc8d4ecb-09de-36ea-b907-792c732a86c5",
                                        "glosses": [
                                            "Alternative form of bun (“Korean unit of measure”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a477e5b-e92d-3d14-a15c-df33a7c4521d",
                                        "entry_id": "39b41c9b-e2bd-3385-9874-b7ba85ffa2e6",
                                        "glosses": [
                                            "A certain number of cowries, generally 80."
                                        ],
                                        "tags": [
                                            "India",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4f1559e-a152-48fe-a0c4-58d950b24b7e",
                                                "sense_id": "5a477e5b-e92d-3d14-a15c-df33a7c4521d",
                                                "text": "Hackeries and carriages, loaded and empty, 8 annas. Sheep, goats, &c., 1 pun of cowries each."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dca34cd-eb48-46e9-82e9-9138b3698d87",
                        "source_entry_id": "5eda2174-e015-30e2-8c28-269d363687c4",
                        "source_sense_id": "cb4e6d4e-5efe-3fa9-bf83-f1cc59334c95",
                        "target_lang_word": "paronomasia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paronomasia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d0844b2d-918c-351f-a1f4-f56050f25d4c",
                                        "entry_id": "2bf8b9c5-815a-34f6-be53-80e6bc659512",
                                        "glosses": [
                                            "Tipo de similitud entre el sonido de un conjunto de palabras o vocablos, que solamente se diferencian por la vocal que tiene el acento prosódico."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bad0eb7-c072-43f6-96b3-8e7d0ac63baa",
                                                "sense_id": "d0844b2d-918c-351f-a1f4-f56050f25d4c",
                                                "text": "hay paronomasia entre \"caso\", \"queso\", \"quiso\", \"coso\" y \"cuso."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7b9f039-0a55-3ee2-a46f-554b3f9ddc58",
                                        "entry_id": "2bf8b9c5-815a-34f6-be53-80e6bc659512",
                                        "glosses": [
                                            "En general, similitud o semejanza en la forma entre dos o más palabras."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d7d589d-e2b6-48a7-8bea-25024f81001e",
                                                "sense_id": "f7b9f039-0a55-3ee2-a46f-554b3f9ddc58",
                                                "text": "hay paronomasia entre \"hombre\", \"hombro\" y \"hambre\", como también entre \"Marte\", \"martes\" y \"mártir\"."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "640122a5-1213-3e18-b288-6b3047a52c77",
                                        "entry_id": "2bf8b9c5-815a-34f6-be53-80e6bc659512",
                                        "glosses": [
                                            "Grupo de palabras o vocablos que tienen estos tipos de similitud_(1, 2)."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0eb83dfb-9c67-3187-8e06-6eea8dd3f68a",
                                        "entry_id": "2bf8b9c5-815a-34f6-be53-80e6bc659512",
                                        "glosses": [
                                            "Figura o juego de palabras que consiste en combinar dentro de una frase o un párrafo vocablos con sonido similar pero significado diferente."
                                        ],
                                        "tags": [
                                            "retórica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b9472bf-7ceb-42a4-af01-2f6f81d70afe",
                                                "sense_id": "0eb83dfb-9c67-3187-8e06-6eea8dd3f68a",
                                                "text": "El poeta Octavio Paz crea numerosas paronomasias en su libro Libertad bajo palabra (1949), por ejemplo: \"El erizo se irisa, se eriza, se riza de risa\"."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
