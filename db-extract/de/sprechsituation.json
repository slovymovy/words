                        "glosses": [
                            "die bestimmten Umstände, auf die sich ein Sprecher sprachlich einstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c40dd97e-b91d-4bc7-9d2f-7d9f7d575500",
                                "sense_id": "762b6c1e-3323-33ac-b14d-15dd5d510385",
                                "text": "Wesentliche Aspekte der Sprechsituation sind unter anderen: Zahl der Sprecher/Hörer, Privatheit/Öffentlichkeit und Art des Gesprächsthemas."
                            },
                            {
                                "example_id": "3df5a16b-693e-4612-a3d0-a67adc7384e2",
                                "sense_id": "762b6c1e-3323-33ac-b14d-15dd5d510385",
                                "text": "„Stärker als in vielen anderen germanischen Sprachen - Isländisch und Färöisch einmal ausgenommen - beeinflussen auch Sprechgeschwindigkeit, angestrebte Deutlichkeit, allgemeine Faktoren der Sprechsituation sowie stilistische Faktoren die Aussprache des Dänischen in erheblichem Maße.“"
                            }
                        ],
