                        "examples": [
                            {
                                "example_id": "0b348132-d729-4dc0-bba9-cf3881ce421c",
                                "sense_id": "6d306d0e-ae71-390b-859d-5ee377f2419e",
                                "text": "Jemand der ein Inserat aufgibt, ist ein Inserent."
                            },
                            {
                                "example_id": "f33d500b-5dcb-4704-af89-affa4453958a",
                                "sense_id": "6d306d0e-ae71-390b-859d-5ee377f2419e",
                                "text": "Ich werde in der lokalen Zeitung ein Inserat aufgeben, um meine alten Möbel loszuwerden."
