                                "target_senses": [
                                    {
                                        "sense_id": "0dd09813-ad4f-3c64-9fc5-11df33073d90",
                                        "entry_id": "e0104cb0-aab3-30b4-954f-33d172cd2534",
                                        "glosses": [
                                            "De Leipzig."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7a55181-2495-4334-9a87-ca25108aa9e2",
                                                "sense_id": "0dd09813-ad4f-3c64-9fc5-11df33073d90",
                                                "text": "Après la seconde guerre mondiale, les Américains occupent la région, avant de laisser la place aux Soviétiques. Ces derniers embarquent l'ensemble des moyens de production des brasseries lipsiennes, au titre des dommages de guerre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lipsien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa4d2df5-0e08-3506-891d-855928ff7136",
                                        "entry_id": "c785018a-d1bc-3ce7-9941-b9e5bc1f0d6b",
                                        "glosses": [
                                            "De Juste Lipse, ou du style de Juste Lipse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d8fa5ac-d2ab-45a6-921c-60aecb979a26",
                                                "sense_id": "fa4d2df5-0e08-3506-891d-855928ff7136",
                                                "text": "Dans cette édition de la correspondance lipsienne, les dates ont déjà été contrôlées, ce qui nous a permis d'évaluer la méthode suivie par Gerlo et Vervliet dans ce domaine."
                                            }
                                        ]
                                    }
                                ]
                            }
