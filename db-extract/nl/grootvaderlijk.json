                        "examples": [
                            {
                                "example_id": "6547298e-51cb-447f-b51f-9d4f8a27b80a",
                                "sense_id": "f42f745a-6079-306a-aaa9-56533f98b94f",
                                "text": "Als Dora terugdenkt aan wat zij als kind over zich heen kreeg als ze alleen maar per ongeluk een glas water had omgestoten, kijkt ze nogal op van de grootvaderlijke tolerantie."
                            },
                            {
                                "example_id": "634ab532-ca93-4360-9c00-9c98b33b3105",
                                "sense_id": "f42f745a-6079-306a-aaa9-56533f98b94f",
                                "text": "Tsering beschrijft het voorval als \"onschuldig\", \"grootvaderlijk\" en \"liefdevol\". Ook benadrukt hij dat de dalai lama door een celibaat en spiritueel leven \"voorbij zintuigelijke genoegens\" is."
                            }
                        ]
