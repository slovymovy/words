                ],
                "translations": [
                    {
                        "translation_id": "9ed1bfc0-c6bf-4884-8615-5de47334e4da",
                        "source_entry_id": "8cea430c-9ab0-3b9c-8486-d4433f409d38",
                        "source_sense_id": "ea86aac5-8f99-3606-b07d-3ec620796fef",
                        "target_lang_word": "accepter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accepter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ff3ba2f-f156-3dd4-a3fe-e4d4f5e4b785",
                                        "entry_id": "4282c8a9-9d2d-3a4d-a430-7de1c1164fe6",
                                        "glosses": [
                                            "A person who accepts; a taker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24d04ac0-18c3-4039-a835-a517c9381954",
                                                "sense_id": "5ff3ba2f-f156-3dd4-a3fe-e4d4f5e4b785",
                                                "text": "There is no benefyte so perfect, whiche enuy can not nip: nor no benefite so skant, whiche a good accepter may not inlarge."
                                            },
                                            {
                                                "example_id": "48490422-e8fc-4daa-aaa2-f97d0c5b71c8",
                                                "sense_id": "5ff3ba2f-f156-3dd4-a3fe-e4d4f5e4b785",
                                                "text": "Tracey came fraught with gifts rather suited to the spirit of the donor, than that of the accepter, yet, they opened the heart of the Laird of Dornock, who listened to the avowal of Tracey’s love without repugnance; and at length promised him his sister […]"
                                            },
                                            {
                                                "example_id": "af10bab0-b497-484b-bd42-ddcd13992d2e",
                                                "sense_id": "5ff3ba2f-f156-3dd4-a3fe-e4d4f5e4b785",
                                                "text": "It is the man of science who speaks, the unprejudiced observer, the accepter of facts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e21b3d-8952-3af2-9088-27854368c22e",
                                        "entry_id": "4282c8a9-9d2d-3a4d-a430-7de1c1164fe6",
                                        "glosses": [
                                            "A respecter; one who views others with partiality."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71260e5b-0965-4458-88da-7db92dcf2a3d",
                                                "sense_id": "14e21b3d-8952-3af2-9088-27854368c22e",
                                                "text": "1395, John Wycliffe (translator), Bible, Acts 10.34,\nAnd Petre openyde his mouth, and seide, In trewthe Y haue foundun, that God is no acceptor of persoones;"
                                            },
                                            {
                                                "example_id": "5c7c081b-915d-40f5-9462-d4a863722b89",
                                                "sense_id": "14e21b3d-8952-3af2-9088-27854368c22e",
                                                "text": "1549, Hugh Latimer, The Seconde Sermon of Maister Hughe Latimer whych he preached before the Kynges maiestie, London: John Day and William Seres, To the Reader,\nBut nowe the wycked Iudge, whiche corrupteth iustyce for Brybes heer he maye learne also the lesson that Moses taughte long before this tyme, ye magistrates & Iudges in the common wealth of Israell be no accepters of personnes neyther be desyreous of giftes, for they make wyse men blind, and chaunge the mynde of the ryghtuouse."
                                            },
                                            {
                                                "example_id": "1adee043-3157-4d1d-836c-c78035a183cc",
                                                "sense_id": "14e21b3d-8952-3af2-9088-27854368c22e",
                                                "text": "early 1700s, William Chillingworth, Sermon on Psalm 14.1 in The Works of William Chillingworth, London: Richard Priestley, 1820, Volume 3, p. 92,\n[…] God is no accepter of persons, neither riches nor poverty are a means to procure his favour […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d971fb9-00ba-3adb-b1cc-4085af0368d3",
                                        "entry_id": "4282c8a9-9d2d-3a4d-a430-7de1c1164fe6",
                                        "glosses": [
                                            "An acceptor; one who accepts an order or a bill of exchange."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
