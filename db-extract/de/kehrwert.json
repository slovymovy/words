                                "example_id": "49f56eeb-6d2d-4123-92f9-74e8ceb919e5",
                                "sense_id": "a33dd8fd-3472-3704-b5ab-6a2795627e77",
                                "text": "Der Kehrwert des Bruches tfrac 3 8 ist tfrac 8 3 ; der Kehrwert von 5 ist tfrac 1 5."
                            },
                            {
                                "example_id": "76640b83-4814-4e8c-bd19-2f3772fe9205",
                                "sense_id": "a33dd8fd-3472-3704-b5ab-6a2795627e77",
                                "text": "Multipliziert man einen Wert mit seinem Kehrwert, erhält man 1."
