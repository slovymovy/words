                                "target_senses": [
                                    {
                                        "sense_id": "d4ed9752-2aea-3e52-8beb-38ee45b91fd0",
                                        "entry_id": "bc7769a3-9890-3879-82b7-cbc89e54a3a6",
                                        "glosses": [
                                            "een zeer hoog drijvende wolk die eruitziet als katoenvlokken, pluimen of veren, in regelmatige strepen aan de hemel verdeeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64294c2a-00f4-4de7-a8bb-c6181f30fffc",
                                                "sense_id": "d4ed9752-2aea-3e52-8beb-38ee45b91fd0",
                                                "text": "De hemel was blauw met een beetje cirrus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3536876f-80d6-41b2-b0b9-795381005b83",
