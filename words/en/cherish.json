{
    "word_family": [
        "cherishment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "430ae01d-11fd-3ecc-abef-dd992be793c8",
                    "sense_definition": "To treat with affection, care, and tenderness; to nurture or protect with care.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parents <w>cherish</w> their children with deep love and constant care.",
                            "target_lang_translations": {
                                "tr": "Ebeveynler çocuklarına derin bir sevgi ve sürekli bir özenle <w>gözü gibi bakarlar</w>."
                            }
                        },
                        {
                            "text": "She <w>cherished</w> the old photograph as a reminder of her childhood.",
                            "target_lang_translations": {
                                "tr": "Çocukluğunun bir hatırası olarak eski fotoğrafa <w>büyük değer veriyordu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "treasure"
                    ],
                    "common_phrases": [
                        "cherish with care"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birine sevgi, şefkat ve özenle yaklaşmak; koruyup kollamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gözü gibi bakmak",
                                "target_lang_sense_clarification": "Bir şeye veya birine büyük bir özen ve sevgiyle bakmak."
                            },
                            {
                                "target_lang_word": "bağrına basmak",
                                "target_lang_sense_clarification": "Birini büyük bir şefkatle sevip korumak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dad8b503-3746-3fdb-aca6-202394efe88e",
                    "sense_definition": "To have a deep appreciation of; to hold dear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will always <w>cherish</w> the memories of our time spent together.",
                            "target_lang_translations": {
                                "tr": "Birlikte geçirdiğimiz zamanların anılarına her zaman <w>kıymet vereceğim</w>."
                            }
                        },
                        {
                            "text": "He <w>cherishes</w> his long-held dream of becoming a professional musician.",
                            "target_lang_translations": {
                                "tr": "Profesyonel bir müzisyen olma hayaline <w>büyük değer veriyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "prize",
                        "treasure"
                    ],
                    "antonyms": [
                        "despise"
                    ],
                    "common_phrases": [
                        "cherish memories",
                        "cherish dreams"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeye büyük değer vermek, kıymetini bilmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "değer vermek",
                                "target_lang_sense_clarification": "Bir şeyin kıymetini bilmek ve ona önem atfetmek."
                            },
                            {
                                "target_lang_word": "kıymetini bilmek",
                                "target_lang_sense_clarification": "Bir şeyin değerinin farkında olmak ve onu korumak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "992b1930-7bdf-38c4-a8f1-597984273909",
                    "sense_definition": "To cheer, to gladden.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warm sunlight served to <w>cherish</w> the weary travelers after their long journey.",
                            "target_lang_translations": {
                                "tr": "Ilık güneş ışığı, uzun yolculuklarından sonra yorgun gezginleri <w>neşelendirdi</w>."
                            }
                        },
                        {
                            "text": "Kind words can <w>cherish</w> the spirit during difficult times.",
                            "target_lang_translations": {
                                "tr": "Nazik sözler, zor zamanlarda ruhu <w>canlandırabilir</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Neşelendirmek, canlandırmak veya teselli etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "neşelendirmek",
                                "target_lang_sense_clarification": "Birine neşe vermek veya moralini yükseltmek."
                            },
                            {
                                "target_lang_word": "canlandırmak",
                                "target_lang_sense_clarification": "Birinin ruh halini iyileştirmek veya enerji vermek."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "51c5c34c-51f2-3db5-99b5-f650d86d065e",
                    "sense_definition": "A female given name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Cherish</w> is a unique name for a baby girl.",
                            "target_lang_translations": {
                                "tr": "<w>Cherish</w>, bir kız bebek için benzersiz bir isimdir."
                            }
                        },
                        {
                            "text": "I met a woman named <w>Cherish</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "tr": "Dün konferansta <w>Cherish</w> adında bir kadınla tanıştım."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kadın ismi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Cherish",
                                "target_lang_sense_clarification": "Özel isim olduğu için Türkçede de aynı şekilde kullanılır."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}