                                "target_senses": [
                                    {
                                        "sense_id": "9cfd8e32-3122-3cd6-a5d5-b86f9879ecfa",
                                        "entry_id": "adc41c37-b4b8-3572-a8fb-bf30101b4424",
                                        "glosses": [
                                            "Sprache, die in Usbekistan und angrenzenden Staaten Zentralasiens gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75cccc4b-e5bb-4f75-bb1b-dbe01f003110",
                                                "sense_id": "9cfd8e32-3122-3cd6-a5d5-b86f9879ecfa",
                                                "text": "Sprechen Sie Usbekisch?"
                                            },
                                            {
                                                "example_id": "3e1e235e-cf2b-4239-bedc-d0aa22b63c64",
                                                "sense_id": "9cfd8e32-3122-3cd6-a5d5-b86f9879ecfa",
                                                "text": "„Die am engsten mit dem Usbekischen verwandte Sprache ist das im chinesischen Xinjiang gesprochene Uigurische.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58637b70-ac24-4e78-8bc0-50d91b5e5d35",
                        "source_entry_id": "b1c881f7-5ce1-3295-ac15-6be0375ce47e",
                        "source_sense_id": "b1d54037-d50e-3150-b3be-85ff8f2130f2",
                        "source_sense_description": "een taal die verwant is aan het Turks en die door de Oezbeken gesproken wordt",
                        "target_lang_word": "Uzbek",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uzbek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "419b82b2-1f5a-3699-a6a1-0782fb6ed6fc",
                                        "entry_id": "e9935b42-2ebe-3dcc-9f90-159b78b77a6d",
                                        "glosses": [
                                            "A person from Uzbekistan or of Uzbek descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4e965db-6d84-4edb-b33e-aa08a600cfbf",
                                                "sense_id": "419b82b2-1f5a-3699-a6a1-0782fb6ed6fc",
                                                "text": "Fashionable Uzbeks wear clothing made from the fabric, and suzanis have become popular with interior designers from the UK to Singapore, who use them as wall décor, bedding, or as the fabric for throw pillows."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Uzbek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                        "entry_id": "cb3c07f1-f544-350b-8479-69b793f25f41",
                                        "glosses": [
                                            "Of, from, or pertaining to Uzbekistan, the Uzbek people or the Uzbek language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cfeab5b-3eb3-430f-b9eb-b73a8985dc75",
                                                "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                                "text": "Outside government, Uzbek and Islamic social mores – by no means always mutually compatible – have always exerted their own influences. One positive and very Uzbek influence are the Mahallas, mutual help communities of families, local businesses and committees which deal effectively with a wide range of local issues."
                                            },
                                            {
                                                "example_id": "aee83b9e-0e54-4d65-8cd2-4c3086068b1e",
                                                "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                                "text": "He is a gruff, white-bearded man, very Uzbek in his skull-cap and long grey coat."
                                            },
                                            {
                                                "example_id": "b0d8bdd9-185f-4324-8ff1-0e2bf25234dd",
                                                "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                                "text": "As for the unpredictable Uzbek commander Dostum, Rasheed said no one knew where he would stand."
                                            },
                                            {
                                                "example_id": "50d51b56-571b-40f9-a77f-66191b2fd815",
                                                "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                                "text": "Özgön has a university, a brewery and a distinctive bazaar that is very Uzbek in character."
                                            },
                                            {
                                                "example_id": "fcb15eb0-8a9d-43b3-ac9a-ac3813199659",
                                                "sense_id": "a70acfd5-105f-3351-ba05-e0c577453548",
                                                "text": "Uzbekistan came under Russian control in the 19th century, and traditional Uzbek craftsmanship almost didn’t survive the Soviet era."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Uzbek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "027a01a4-e88d-3470-8d6f-b02f81fac34a",
                                        "entry_id": "f86e6ccc-230d-31d6-a70f-302f7501581a",
                                        "glosses": [
                                            "The language of Uzbekistan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7de22e2c-a687-4f5c-8079-abf6ef6e7980",
                        "source_entry_id": "b1c881f7-5ce1-3295-ac15-6be0375ce47e",
                        "source_sense_id": "b1d54037-d50e-3150-b3be-85ff8f2130f2",
                        "source_sense_description": "een taal die verwant is aan het Turks en die door de Oezbeken gesproken wordt",
                        "target_lang_word": "ouzbek",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouzbek",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc8d8cdf-1367-340a-95a9-5e8e3c8c70e0",
                                        "entry_id": "a4adbedd-7fc1-397b-898a-55cf78707dd3",
                                        "glosses": [
                                            "Relatif aux Ouzbeks, leur culture, leur langue, leur pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f45bf59b-daca-4e2d-a417-b046a6c95c41",
                                                "sense_id": "fc8d8cdf-1367-340a-95a9-5e8e3c8c70e0",
                                                "text": "La langue ouzbek appartient à la famille ouralo-altaïque."
                                            },
                                            {
                                                "example_id": "088750ae-8646-4047-bcd1-16d0d7b77a16",
                                                "sense_id": "fc8d8cdf-1367-340a-95a9-5e8e3c8c70e0",
                                                "text": "Rahim ne détachait plus son regard de ces coiffures à odeur fauve qui soulignaient les méplats violents, les hautes pommettes, les orbites étroites des visages ouzbeks et turkmènes."
                                            },
                                            {
                                                "example_id": "7e2617ec-47d5-4834-8976-b7bf85662c54",
                                                "sense_id": "fc8d8cdf-1367-340a-95a9-5e8e3c8c70e0",
                                                "text": "Bien que leur conversation se tînt en idiome ouzbek, incompréhensible aux gens de Kaboul, Ouroz baissa la voix jusqu’au chuchotement pour continuer :\n— Tu seras dans le milieu de la nuit sous ma fenêtre avec Jehol et mes vêtements."
                                            },
                                            {
                                                "example_id": "639258ed-5886-48c9-beb8-11695b387a0c",
                                                "sense_id": "fc8d8cdf-1367-340a-95a9-5e8e3c8c70e0",
                                                "text": "Les violences entre Kirghiz et la minorité ouzbèke ont commencé dans la nuit de jeudi à vendredi à Och (sud) avant de s’étendre à la région voisine de Djalal-Abad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee83db31-a9bd-35c1-947a-584509e70071",
                                        "entry_id": "a4adbedd-7fc1-397b-898a-55cf78707dd3",
                                        "glosses": [
                                            "Relatif à l’Ouzbékistan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "417e42a1-9e59-46d9-8900-34f0dcd85564",
                                                "sense_id": "ee83db31-a9bd-35c1-947a-584509e70071",
                                                "text": "La capitale ouzbèke."
                                            }
                                        ]
                                    }
                                ]
