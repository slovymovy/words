                "senses": [
                    {
                        "sense_id": "f9134d82-8965-3270-ac6f-aa87b52e9016",
                        "entry_id": "1a84e0ec-114a-3f5c-bcfc-f59ee7bab99e",
                        "glosses": [
                            "Chariot formé par un châssis muni de deux ou trois essieux, situé sous la caisse d’un véhicule ferroviaire et relié à cette dernière par un pivot. À l’inverse du truck, il est mobile par rapport à la caisse du véhicule et pivote."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b6a833c-0242-4ce3-8231-08f53c439a3d",
                        "source_entry_id": "1a84e0ec-114a-3f5c-bcfc-f59ee7bab99e",
                        "source_sense_id": "f9134d82-8965-3270-ac6f-aa87b52e9016",
                        "target_lang_word": "bogie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bogie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6217c0dc-6a25-38ea-bad5-191a4410c99d",
                                        "entry_id": "e0701e45-3aa7-3bc0-89d1-c641fa08710c",
                                        "glosses": [
                                            "A low, hand-operated truck, generally with four wheels, used for transporting objects or for riding on as a toy; a trolley."
                                        ],
                                        "tags": [
                                            "Northern-England"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "024393c7-768f-32d0-92e7-98918942ac84",
                                        "entry_id": "e0701e45-3aa7-3bc0-89d1-c641fa08710c",
                                        "glosses": [
                                            "One of two sets of wheels under a locomotive or railcar; also, a structure with axles and wheels under a locomotive, railcar, or semi which provides support and reduces vibration for the vehicle."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c995dce-3e14-4771-92ad-9ca205c55289",
                                                "sense_id": "024393c7-768f-32d0-92e7-98918942ac84",
                                                "text": "1878. Bogie Trucks for Railway Locomotives, &c.: [...] Fig. 1 is a cross section and Fig. 2 a section plan of a bogie. A curved casting a is fixed to the engine and a wrought-iron beam or beams b are connected to the bogie frames by links c fitted with or without springs d."
                                            },
                                            {
                                                "example_id": "d50a9dd9-0222-4c2e-9d18-2675d4955e3e",
                                                "sense_id": "024393c7-768f-32d0-92e7-98918942ac84",
                                                "text": "The soil all along this portion of the route is so elastic and the line so straight and level that the train goes humming along without jar or vibration, and the sensation in these cars, with their six-wheeled bogies and well arranged springs, is more like what one imagines flying to be than a mere matter-of-fact railway journey."
                                            },
                                            {
                                                "example_id": "ff36ca5c-8f19-483f-a775-0b7e23ff5f29",
                                                "sense_id": "024393c7-768f-32d0-92e7-98918942ac84",
                                                "text": "An empty train was by mistake sent into the rear of an ordinary train standing at the station Rathausbrücke. The two colliding car-ends were damaged and the bogie of the standing train was lifted off the supporting rail so that its wheels settled by the side of the rail. Neither train fell, however, and nobody was seriously hurt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c058fcb-914c-3ab5-b250-a77cca8d86e4",
                                        "entry_id": "e0701e45-3aa7-3bc0-89d1-c641fa08710c",
                                        "glosses": [
                                            "A set of wheels attached to one of an aircraft's landing gear, or the structure connecting the wheels in one such set."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e73e3a5f-c548-4e00-b003-63815137555f",
                                                "sense_id": "8c058fcb-914c-3ab5-b250-a77cca8d86e4",
                                                "text": "Although most A320s have two wheels on each of their main gear, a few built for the Indian market have four-wheel bogies, halving the amount of weight on each wheel and allowing the aircraft to use runways that couldn't withstand the ground pressure from a standard A320."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02cace96-5665-3788-80eb-7ecbd8c8da2d",
                                        "entry_id": "e0701e45-3aa7-3bc0-89d1-c641fa08710c",
                                        "glosses": [
                                            "A railway carriage."
                                        ],
                                        "tags": [
                                            "British",
                                            "India"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bea8bd27-0028-4969-bb52-5f160c32f830",
                                                "sense_id": "02cace96-5665-3788-80eb-7ecbd8c8da2d",
                                                "text": "The bogie coaches which he spoke of last year had been brought or were being brought into active service, but they had no further wagon stock available."
                                            },
                                            {
                                                "example_id": "4986c3f7-d8e7-455a-bc11-49f3f97a27f6",
                                                "sense_id": "02cace96-5665-3788-80eb-7ecbd8c8da2d",
                                                "text": "Although we took our eight bogies along to Whitstable at 60 m.p.h., and made a clean start from there, after Herne Bay the engine primed badly on Blacksole Bank and nearly stopped before we got over the top. Then we ran like the wind across the marshes with half-regulator, 30 per cent cut-off, and the engine blowing off."
                                            },
                                            {
                                                "example_id": "042326e2-4427-441e-834f-5dbc008c5279",
                                                "sense_id": "02cace96-5665-3788-80eb-7ecbd8c8da2d",
                                                "text": "Hard work is required from men and machines as I was to experience later when footplating Lambton No 5 on five bogies battling its way up Newtondale."
                                            },
                                            {
                                                "example_id": "e8b6ce77-9665-4951-817f-0a5deae97a41",
                                                "sense_id": "02cace96-5665-3788-80eb-7ecbd8c8da2d",
                                                "text": "[...] Ashoke was still reading at two-thirty in the morning, one of the few passengers on the train who was awake, when the locomotive engine and seven bogies derailed from the broad-gauge line. The first four bogies capsized into a depression alongside the track."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cb2a954-cde0-3694-9799-b15f7234e043",
                                        "entry_id": "e0701e45-3aa7-3bc0-89d1-c641fa08710c",
                                        "glosses": [
                                            "A soapbox racing vehicle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bogie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c72d88-a4d0-3663-8654-62e6de36091e",
                                        "entry_id": "3b417530-88e7-33ad-b9eb-8e35a7d95800",
                                        "glosses": [
                                            "A marijuana cigarette; a joint."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a485e90a-894d-478b-9435-7d373effdbb7",
                                                "sense_id": "e9c72d88-a4d0-3663-8654-62e6de36091e",
                                                "text": "bogies: marijuana cigarettes."
                                            },
                                            {
                                                "example_id": "93bd5393-9faa-4888-845e-aa6237a81718",
                                                "sense_id": "e9c72d88-a4d0-3663-8654-62e6de36091e",
                                                "text": "We normally dropped off at Shooters Billiards where we'd play pool and arcades, but sometimes left to do other shit. Shooters was a good lie to our parents when we came home smelling like smoke, because people smoked in the place, so we'd get away with smoking bogies or weed."
                                            },
                                            {
                                                "example_id": "ab93e559-e53a-40e5-91da-2848b34add3f",
                                                "sense_id": "e9c72d88-a4d0-3663-8654-62e6de36091e",
                                                "text": "If i was the hulk i would smash you bite you like a cashew, then i smoke a bogie if i have to"
                                            },
                                            {
                                                "example_id": "da8532fd-9872-4bc8-9e1e-a4e8af29978e",
                                                "sense_id": "e9c72d88-a4d0-3663-8654-62e6de36091e",
                                                "text": "I ain't got no trees for sale but I got some personal shit for me. Ima fuck with you 'cause you seem like an a'ight nigga. You smoke bogies?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bogie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b155d8c-cdcb-37ac-9873-0eae20c7fd40",
                                        "entry_id": "e0b707bc-fec5-3081-a7b8-0e9f954dcb1b",
                                        "glosses": [
                                            "Alternative spelling of bogey.",
                                            "A ghost, goblin, or other hostile supernatural creature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "100c6fb5-c64e-46fc-9045-150682e201f5",
                                                "sense_id": "1b155d8c-cdcb-37ac-9873-0eae20c7fd40",
                                                "text": "All of a sudden he heard a terrible scream ahead, and he thought it must be the bogie singing his dirge."
                                            },
                                            {
                                                "example_id": "3f44701d-6f12-4840-9123-206b0c54ba00",
                                                "sense_id": "1b155d8c-cdcb-37ac-9873-0eae20c7fd40",
                                                "text": "They could not, it was said, keep Scandinavian bogies and the Scriptures separate in their puzzled brains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed6e5e14-5737-3b96-84c9-b5d95b194700",
                                        "entry_id": "e0b707bc-fec5-3081-a7b8-0e9f954dcb1b",
                                        "glosses": [
                                            "Alternative spelling of bogey.",
                                            "A standard of performance set up as a mark to be aimed at in competition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "377c2387-2828-3474-87a3-67ca09e009a4",
                                        "entry_id": "e0b707bc-fec5-3081-a7b8-0e9f954dcb1b",
                                        "glosses": [
                                            "Alternative spelling of bogey.",
                                            "An unidentified aircraft, especially as observed as a spot on a radar screen and suspected to be hostile."
                                        ],
