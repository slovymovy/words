                "senses": [
                    {
                        "sense_id": "7b77dae6-0d30-36b4-83bb-89e5a500945a",
                        "entry_id": "aaf775a2-7dff-3be2-96a9-98268ad57881",
                        "glosses": [
                            "уменьш.-ласк. к туча; небольшая туча"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1423ab4-6838-486d-bae7-0cd60627bba6",
                                "sense_id": "7b77dae6-0d30-36b4-83bb-89e5a500945a",
                                "text": "Тучки небесные, вечные странники!"
                            },
                            {
                                "example_id": "25035604-d681-413d-ba11-2e5d19709033",
                                "sense_id": "7b77dae6-0d30-36b4-83bb-89e5a500945a",
                                "text": "Ночевала тучка золотая // На груди утёса-великана."
                            },
                            {
                                "example_id": "d553b882-24ca-400a-85e0-7bf5e1966ac5",
                                "sense_id": "7b77dae6-0d30-36b4-83bb-89e5a500945a",
                                "text": "По высокому ясному небу пробежала синя тучка, зацепила солнышко, одним боком, бросила легкую тень."
                            },
                            {
                                "example_id": "52f6c94b-cbbf-482b-94c3-1d40ba1b24b2",
                                "sense_id": "7b77dae6-0d30-36b4-83bb-89e5a500945a",
                                "text": "Вдруг набежала тучка, брызнул дождь и застучал по лопухам."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3763cbff-86b3-4e43-ae55-257557654912",
                        "source_entry_id": "aaf775a2-7dff-3be2-96a9-98268ad57881",
                        "source_sense_id": "7b77dae6-0d30-36b4-83bb-89e5a500945a",
