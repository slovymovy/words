    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b80be5c-a6a2-310a-b95e-9a71fba66480",
                    "sense_definition": "Словесная или письменная реакция на вопрос или обращение.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я жду твой <w>ответ</w> на мое письмо.",
                            "target_lang_translations": {
                                "en": "I am waiting for your <w>answer</w> to my letter.",
                                "zh": "我正在等你的信件<w>回复</w>。"
                            }
                        },
                        {
                            "text": "Правильный <w>ответ</w> на этот вопрос очень прост.",
                            "target_lang_translations": {
                                "en": "The correct <w>answer</w> to this question is very simple.",
                                "zh": "这个问题正确的<w>答案</w>很简单。"
                            }
                        }
                    ],
                    "synonyms": [
                        "отклик",
                        "отзыв"
                    ],
                    "antonyms": [
                        "вопрос"
                    ],
                    "common_phrases": [
                        "дать ответ",
                        "правильный ответ"
                    ],
                    "target_lang_definitions": {
                        "en": "A spoken or written reaction to a question or communication.",
                        "zh": "对问题或交流的口头或书面反应。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "A general response to a question or statement."
                            },
                            {
                                "target_lang_word": "reply",
                                "target_lang_sense_clarification": "A formal or direct response to a message or inquiry."
                            },
                            {
                                "target_lang_word": "response",
                                "target_lang_sense_clarification": "A reaction or reply, often used in more formal contexts."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "回答",
                                "target_lang_sense_clarification": "对问题或询问的直接回应。"
                            },
                            {
                                "target_lang_word": "回复",
                                "target_lang_sense_clarification": "针对信件、消息或正式询问的答复。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e39059c1-e72e-38d4-b1e1-79b75e89633c",
                    "sense_definition": "Результат решения математической задачи или разгадывания загадки.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "solution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ученик записал <w>ответ</w> в конце тетради.",
                            "target_lang_translations": {
                                "en": "The student wrote the <w>answer</w> at the end of the notebook.",
                                "zh": "学生把<w>答案</w>写在了练习本的最后。"
                            }
                        },
                        {
                            "text": "Ученые ищут <w>ответ</w> на сложную научную загадку.",
                            "target_lang_translations": {
                                "en": "Scientists are looking for an <w>answer</w> to a complex scientific riddle.",
                                "zh": "科学家们正在寻找这个复杂科学谜题的<w>答案</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "решение",
                        "отгадка"
                    ],
                    "common_phrases": [
                        "верный ответ",
                        "найти ответ"
                    ],
                    "target_lang_definitions": {
                        "en": "The result of solving a mathematical problem or a riddle.",
                        "zh": "数学问题或谜题的求解结果。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "The correct solution to a problem or puzzle."
                            },
                            {
                                "target_lang_word": "solution",
                                "target_lang_sense_clarification": "The process or result of finding the answer to a complex problem."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "答案",
                                "target_lang_sense_clarification": "问题或谜题的正确结果。"
                            },
                            {
                                "target_lang_word": "解",
                                "target_lang_sense_clarification": "数学问题的求解结果。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "053c65b7-1654-3d41-8480-ec7d1ff26afb",
                    "sense_definition": "Действие, предпринятое в качестве реакции на чужое действие или ситуацию.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нашим <w>ответ</w>ом на кризис стало сокращение расходов.",
                            "target_lang_translations": {
                                "en": "Our <w>response</w> to the crisis was to cut expenses.",
                                "zh": "我们对危机的<w>应对</w>措施是削减开支。"
                            }
                        },
                        {
                            "text": "В <w>ответ</w> на агрессию они усилили охрану границ.",
                            "target_lang_translations": {
                                "en": "In <w>response</w> to the aggression, they strengthened border security.",
                                "zh": "作为对侵略的<w>反应</w>，他们加强了边境防卫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "реакция"
                    ],
                    "common_phrases": [
                        "в ответ"
                    ],
                    "target_lang_definitions": {
                        "en": "An action taken as a reaction to someone else's action or a situation.",
                        "zh": "针对他人的行为或某种情况所采取的反应行动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "response",
                                "target_lang_sense_clarification": "A reaction to a stimulus or external event."
                            },
                            {
                                "target_lang_word": "counteraction",
                                "target_lang_sense_clarification": "An action taken in opposition to another action."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反应",
                                "target_lang_sense_clarification": "对外部刺激或事件的行动表现。"
                            },
                            {
                                "target_lang_word": "应对",
                                "target_lang_sense_clarification": "针对特定情况或挑战所采取的对策。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eff6974e-8a73-3eac-b0b9-9eda3fb99b12",
                    "sense_definition": "Обязанность отвечать за свои поступки или результаты работы.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он должен держать <w>ответ</w> за свои ошибки перед начальством.",
                            "target_lang_translations": {
                                "en": "He must be held <w>accountable</w> for his mistakes before his superiors.",
                                "zh": "他必须向上级为自己的错误<w>负责</w>。"
                            }
                        },
                        {
                            "text": "Каждый человек несет <w>ответ</w> за свои действия.",
                            "target_lang_translations": {
                                "en": "Every person bears <w>responsibility</w> for their actions.",
                                "zh": "每个人都要为自己的行为<w>负责</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "держать ответ"
                    ],
                    "target_lang_definitions": {
                        "en": "The duty to be accountable for one's actions or work results.",
                        "zh": "对自己的行为或工作结果承担责任的义务。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accountability",
                                "target_lang_sense_clarification": "The state of being responsible for one's actions."
                            },
                            {
                                "target_lang_word": "responsibility",
                                "target_lang_sense_clarification": "The obligation to answer for one's conduct."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "负责",
                                "target_lang_sense_clarification": "承担责任或义务。"
                            },
                            {
                                "target_lang_word": "交代",
                                "target_lang_sense_clarification": "对某事的结果进行说明或承担后果。"
                            }
                        ]
                    }
                },
                {
