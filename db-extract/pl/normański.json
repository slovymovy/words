                                        "entry_id": "be8ba538-1e94-3d6b-8322-797342f09c70",
                                        "glosses": [
                                            "A surname transferred from the nickname [in turn originating as an ethnonym], for someone from Normandy, or for a Viking (Northman)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e943c4f1-26a2-3eab-8a52-7feb2f87b5f6",
                                        "entry_id": "be8ba538-1e94-3d6b-8322-797342f09c70",
                                        "glosses": [
                                            "A male given name from Old English used in the Middle Ages and revived in the 19th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4ae22ba-9182-46ee-8844-8bc900db3686",
                                                "sense_id": "e943c4f1-26a2-3eab-8a52-7feb2f87b5f6",
                                                "text": "\"Let him be named Norman\", said the lady; \"it was the name of him who last - it was the name of the youngest son of Macalbin.\""
                                            },
                                            {
