                                "target_senses": [
                                    {
                                        "sense_id": "bc3a5bae-e68f-3070-a966-90aa7686294c",
                                        "entry_id": "e511a153-4e12-3593-8b44-ffadf355b8b3",
                                        "glosses": [
                                            "Part of, or relating to the body of an organism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb4176e-edd3-4bf7-a9d6-58fb09df16eb",
                                                "sense_id": "bc3a5bae-e68f-3070-a966-90aa7686294c",
                                                "text": "The somatic and botanical metaphors in this passage were commonplace in the 1700s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ca09c1d-f201-32f9-a9f1-0255af34b8e2",
                                        "entry_id": "e511a153-4e12-3593-8b44-ffadf355b8b3",
                                        "glosses": [
                                            "Pertaining, and restricted, to an individual; not inheritable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eb77ced-6711-4d95-a78e-9f0532f2700e",
                                                "sense_id": "0ca09c1d-f201-32f9-a9f1-0255af34b8e2",
                                                "text": "a somatic epitype"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ec771c3-33e8-36b0-be63-7f6f6ee58e10",
                                        "entry_id": "e511a153-4e12-3593-8b44-ffadf355b8b3",
                                        "glosses": [
                                            "Of or relating to the wall of the body; somatopleuric; parietal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a316d06-1a07-4748-a2cb-3aa25df267bf",
                                                "sense_id": "3ec771c3-33e8-36b0-be63-7f6f6ee58e10",
                                                "text": "the somatic stalk of the yolk sac of an embryo"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
