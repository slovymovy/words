                "senses": [
                    {
                        "sense_id": "7c4d7afa-22bf-32a1-8377-3fc8b3d9730d",
                        "entry_id": "d380f747-8ced-3441-bf2f-0d3b2eb75626",
                        "glosses": [
                            "to feel empathy for another person"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b4868b91-bdde-4731-9480-bb04647fb1b0",
                                "sense_id": "7c4d7afa-22bf-32a1-8377-3fc8b3d9730d",
                                "text": "empathize with someone"
                            },
                            {
                                "example_id": "d9e2312b-9a6c-4f26-9685-da75cb9fd9f5",
                                "sense_id": "7c4d7afa-22bf-32a1-8377-3fc8b3d9730d",
                                "text": "Must have been […] devastating when Kenny was killed. But I want you to know that you can trust me. I understand you. I empathize."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aecc5fce-4199-454d-8e43-1a3ad6c91aef",
                        "source_entry_id": "d380f747-8ced-3441-bf2f-0d3b2eb75626",
                        "source_sense_id": "7c4d7afa-22bf-32a1-8377-3fc8b3d9730d",
                        "source_sense_description": "to feel empathy for another person",
                        "target_lang_word": "compatir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compatir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43f25c8b-3f35-33d6-b39b-c30cdec648af",
                                        "entry_id": "25358f22-e84d-3581-8896-615585f09769",
                                        "glosses": [
                                            "Être touché de compassion pour les maux d’autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf120a65-033d-41ed-aee2-d753fe611506",
                                                "sense_id": "43f25c8b-3f35-33d6-b39b-c30cdec648af",
                                                "text": "On semble plutôt compatir au chagrin que dissimule son visage fermé, admettre sa réserve et la dignité qu'il met dans ces formalités pénibles."
                                            },
                                            {
                                                "example_id": "985e4c8a-c4f7-4af8-b120-5ed5e48fac1b",
                                                "sense_id": "43f25c8b-3f35-33d6-b39b-c30cdec648af",
                                                "text": "Comment ne pas compatir avec la terreur des contemporains quand on sait que les troupes mongoles purent alors, à quelques mois d’intervalle, dévaster Baghdad, Damas, Cracovie en Pologne et la province chinoise de Szetchuan !"
                                            },
                                            {
                                                "example_id": "d671c7f9-da30-4d43-8f02-d191380eae2e",
                                                "sense_id": "43f25c8b-3f35-33d6-b39b-c30cdec648af",
                                                "text": "Compatir, c'est communier avec cette personne qui souffre. C'est prêter attention à ce que te disent, bien souvent sans aucun mot, son corps et son esprit. C'est lui offrir ta pure présence, parfois par la simple lumière de ton regard, parfois par l'entremise de ta main doucement caressante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4935d3e-9317-3d99-b0f9-ead23862b781",
                                        "entry_id": "25358f22-e84d-3581-8896-615585f09769",
                                        "glosses": [
                                            "Souffrir les fautes, les faiblesses de son prochain avec indulgence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f43ead-2cca-4599-a252-1a515820ab5a",
                                                "sense_id": "b4935d3e-9317-3d99-b0f9-ead23862b781",
                                                "text": "La multitude elle-même, qui est la critique la plus sévère de la conduite des classes supérieures, compatissait aux folies du prieur Aymer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bddf8cc7-7904-47c9-80e1-17be70bc99d0",
                        "source_entry_id": "d380f747-8ced-3441-bf2f-0d3b2eb75626",
                        "source_sense_id": "7c4d7afa-22bf-32a1-8377-3fc8b3d9730d",
