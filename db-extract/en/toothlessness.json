                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd67db92-db4b-48a3-9b88-8eaa91bd7be5",
                                                "sense_id": "5fc6a3e0-55d4-38d6-bf78-83342196ce54",
                                                "text": "La dentisterie restauratrice en rapport avec le parodonte comprend la prothèse fixée pour le traitement de l’édentement et la prothèse unitaire ou l’odontologie restauratrice, collée ou scellée."
                                            },
                                            {
                                                "example_id": "4ef99da1-76df-4113-9974-aef1bce101ed",
                                                "sense_id": "5fc6a3e0-55d4-38d6-bf78-83342196ce54",
                                                "text": "Cependant, ces dernières décennies, la prévalence de l’édentement à âge constant diminue, mais, en raison de l’augmentation de l’espérance de vie, le nombre de personnes édentées reste constant."
                                            },
                                            {
                                                "example_id": "a7fe532a-6b22-4f92-bbd3-0510612562ea",
                                                "sense_id": "5fc6a3e0-55d4-38d6-bf78-83342196ce54",
                                                "text": "Le traitement des édentements partiels par prothèse amovible sur châssis métallique fait appel à des notions purement mécaniques et à des connaissances biologiques."
                                            }
                                        ]
                                    }
                                ]
