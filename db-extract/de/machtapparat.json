                "senses": [
                    {
                        "sense_id": "ce433ec9-46f3-3663-8f9d-4c14039bb6cb",
                        "entry_id": "39bb0c90-5e3a-38d5-9cb4-00a7cb217ef7",
                        "glosses": [
                            "Gesamtheit der staatlichen Einrichtungen und Personen, die dem Machterhalt der Staatsführung, des Staatsoberhauptes dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12c6f2a4-29f3-4706-a00a-da7dda8888aa",
                                "sense_id": "ce433ec9-46f3-3663-8f9d-4c14039bb6cb",
                                "text": "„Wladimir Putins Machtapparat hat längst von Scheindemokratie auf offene Repression umgeschaltet. Auf Tricks und Täuschungsmanöver wird mittlerweile ganz verzichtet.“"
                            },
                            {
                                "example_id": "d5167e7d-49f6-463c-aa1b-90d17e71358b",
                                "sense_id": "ce433ec9-46f3-3663-8f9d-4c14039bb6cb",
                                "text": "„Auch dort bauten kleine Cliquen, meist gemeinsamer regionaler und ethnischer Herkunft, Machtapparate auf, die erstaunlich stabil waren, weil viele an Glanz, Macht und Reichtum der neuen Eliten teilhaben konnten und davon profitierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
