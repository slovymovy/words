                        "target_lang_word": "famille de langues",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "famille de langues",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c82695d5-d9c0-33c3-8d5e-74e5f7662d62",
                                        "entry_id": "87ff9128-c2fb-33b1-8515-cdf3e5c2957d",
                                        "glosses": [
                                            "Classement des langues dans des catégories ayant des points communs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f292ced-03f1-48ae-9b6e-8a9ce59e239b",
                                                "sense_id": "c82695d5-d9c0-33c3-8d5e-74e5f7662d62",
                                                "text": "Toutes les langues indo-européennes (sauf l’arménien) font partie de cette famille de langues. Cela vient de leur héritage commun, latin ou germanique. C’est pourquoi il est plus facile d’apprendre une langue romane si l’on en connaît déjà une, comme le portugais, l’espagnol, le français, l’italien et le roumain… et plus on en apprend, plus on maîtrise le système, plus on peut en apprendre !"
                                            },
                                            {
                                                "example_id": "aef67f06-4bb1-4196-acda-1bc119d2af36",
                                                "sense_id": "c82695d5-d9c0-33c3-8d5e-74e5f7662d62",
                                                "text": "Le français fait partie de la famille des langues indo-européennes. C’est la plus grande famille de langues dans le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
