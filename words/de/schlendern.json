            "senses": [
                {
                    "sense_id": "ab38e991-ec96-3142-9370-bf0d14bb98c1",
                    "sense_definition": "ohne bestimmtes Ziel langsam und entspannt gehen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir <w>schlenderten</w> an einem sonnigen Nachmittag gemütlich durch den Park.",
                            "target_lang_translations": {
                                "en": "On a sunny afternoon, we leisurely <w>strolled</w> through the park.",
                                "ru": "Солнечным днём мы не спеша <w>прогуливались</w> по парку."
                            }
                        },
                        {
                            "text": "Viele Touristen <w>schlendern</w> am liebsten ohne festes Ziel durch die historische Altstadt.",
                            "target_lang_translations": {
                                "en": "Many tourists prefer to <w>stroll</w> through the historic old town without a set destination.",
                                "ru": "Многие туристы предпочитают <w>бродить</w> по историческому центру города без какой-либо конкретной цели."
                            }
                        }
                    ],
                    "synonyms": [
                        "bummeln"
                    ],
                    "antonyms": [
                        "eilen",
                        "rennen"
                    ],
                    "common_phrases": [
                        "durch die Stadt schlendern",
                        "durch den Park schlendern",
                        "gemütlich schlendern"
                    ],
                    "target_lang_definitions": {
                        "en": "to walk slowly and leisurely without a specific destination",
                        "ru": "медленно и расслабленно идти без определённой цели, прогуливаться"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stroll",
                                "target_lang_sense_clarification": "walk leisurely"
                            },
