                                        "entry_id": "4ce1b96f-3e87-33df-a054-630ac2376938",
                                        "glosses": [
                                            "Planter, insérer une chose dans une autre."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "648f6858-8ecf-4b6b-a362-26725891e7c8",
                                                "sense_id": "c2bb4ec6-4247-3258-b221-47c0571d31dc",
                                                "text": "Implanter une idée."
                                            },
                                            {
                                                "example_id": "0baa502e-3250-45a5-86e2-bb1488b7e3f4",
                                                "sense_id": "c2bb4ec6-4247-3258-b221-47c0571d31dc",
                                                "text": "Une idée profondément implantée."
                                            },
                                            {
                                                "example_id": "32266e82-7d43-40ff-a9fd-918db8850287",
                                                "sense_id": "c2bb4ec6-4247-3258-b221-47c0571d31dc",
                                                "text": "Sur le boulevard, la fraîcheur du matin rasséréna le baron, mais une idée fixe et presque douloureuse lui resta implantée au cerveau comme une pointe de couteau au milieu du front : […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fe3df53-5461-362d-8042-2bb399a35261",
                                        "entry_id": "4ce1b96f-3e87-33df-a054-630ac2376938",
                                        "glosses": [
                                            "déterminer l’emplacement d'une construction, insérer une construction, un projet dans l'espace."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d5322ed-a788-4713-a631-539c223d3f76",
                                                "sense_id": "6fe3df53-5461-362d-8042-2bb399a35261",
                                                "text": "Implanter la maison sur le terrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecc9ea7a-890d-3ed3-a3eb-76c8aa7ad583",
                                        "entry_id": "4ce1b96f-3e87-33df-a054-630ac2376938",
                                        "glosses": [
                                            "Installer un logiciel ou un sous-système donné en réalisant les adaptations nécessaires à leur fonctionnement dans un environnement défini."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24d9ae34-fd31-4ec7-81c3-a48b0371804e",
                                                "sense_id": "ecc9ea7a-890d-3ed3-a3eb-76c8aa7ad583",
                                                "text": "De nouvelles fonctionnalités seront développées puis implantées au sein de la plateforme pour améliorer son utilisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10871792-88db-318f-bfc5-f3c4c8ed6f09",
                                        "entry_id": "4ce1b96f-3e87-33df-a054-630ac2376938",
                                        "glosses": [
                                            "Se dit des corps qui adhèrent spontanément à un autre corps sans en faire essentiellement partie, comme des excroissances et des boutures naturelles, des cheveux de l’homme, du poil des animaux."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "890b2de4-b007-4bac-8446-8f4ff75f40ee",
                                                "sense_id": "10871792-88db-318f-bfc5-f3c4c8ed6f09",
                                                "text": "Les poils sont implantés dans la peau."
                                            },
                                            {
                                                "example_id": "943c8bef-2f2f-4e01-9a1b-6aad4454efff",
                                                "sense_id": "10871792-88db-318f-bfc5-f3c4c8ed6f09",
                                                "text": "Les longues branches de quelques arbres retombent et s’implantent dans la terre par leur extrémité."
                                            },
                                            {
                                                "example_id": "ef3f893a-93b0-42b9-8149-7b7988500f49",
                                                "sense_id": "10871792-88db-318f-bfc5-f3c4c8ed6f09",
                                                "text": "Le gui s’implante sur le chêne."
                                            },
                                            {
                                                "example_id": "626da546-d102-4503-9489-4a58c66e58aa",
                                                "sense_id": "10871792-88db-318f-bfc5-f3c4c8ed6f09",
                                                "text": "Le lichen s’implante jusque dans les pores du rocher."
                                            }
