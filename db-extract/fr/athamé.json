                        "entry_id": "493bb608-9a69-3deb-9cac-dc6618ae7b62",
                        "glosses": [
                            "Dague, poignard ou bâton consacré utilisé lors des cérémonies et rites de la wicca."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "8ef747bb-c26a-4b85-9bac-580001585b58",
                                "sense_id": "a018f7b4-d909-377c-a0cd-41810e25326a",
                                "text": "J’ai fini par cacher le livre et l’athamé sous mon matelas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc1ece78-0f55-4419-8a19-967e870c7359",
                        "source_entry_id": "493bb608-9a69-3deb-9cac-dc6618ae7b62",
