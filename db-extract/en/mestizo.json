                                    {
                                        "sense_id": "d26facd4-a065-3dcc-90a3-bc60d096f83e",
                                        "entry_id": "2ddcd1a5-af64-3001-88c7-fa1d602ab647",
                                        "glosses": [
                                            "Femme née de parents d’origine différentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99ea818c-9f33-4060-bb84-849d91c7fde9",
                                                "sense_id": "d26facd4-a065-3dcc-90a3-bc60d096f83e",
                                                "text": "Parmi les plus jolies esclaves de cette habitation, on remarquait une métisse de quinze ans, nommée Cecily."
                                            },
                                            {
                                                "example_id": "24bd0b33-3141-471e-8195-9f310f4be119",
                                                "sense_id": "d26facd4-a065-3dcc-90a3-bc60d096f83e",
                                                "text": "Oh ! Matez ma métisse !\nOh ! Ma métisse est nue !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "métisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0d8b39b-f136-3a38-abba-094deec170de",
                                        "entry_id": "c40c458a-b2dd-3c2e-a017-22ca9b83974e",
                                        "glosses": [
                                            "Féminin singulier de métis."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79956381-30bd-4ba4-8497-a01f674aaf80",
                                                "sense_id": "c0d8b39b-f136-3a38-abba-094deec170de",
                                                "text": "Mince, brune, dure de tout le corps, elle représentait le type parfait de la race métisse, la chola, avec ses cheveux noirs lisses, sa peau fine et douce."
                                            }
                                        ]
                                    }
                                ]
                            },
