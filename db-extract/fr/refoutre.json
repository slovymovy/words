                "senses": [
                    {
                        "sense_id": "4d0ee562-b5fc-3254-a8ab-7b0d9e1d7826",
                        "entry_id": "7016abc7-3fcd-3138-b1a4-405bdfb8d517",
                        "glosses": [
                            "Foutre de nouveau, remettre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "80bb6076-03fc-4580-9fa2-454e0add1b25",
                                "sense_id": "4d0ee562-b5fc-3254-a8ab-7b0d9e1d7826",
                                "text": "Une espèce d’additif qui refoutrait tout en question."
                            },
                            {
                                "example_id": "329cbfaf-d168-4c8c-b4a8-a8a19fa1a8c4",
                                "sense_id": "4d0ee562-b5fc-3254-a8ab-7b0d9e1d7826",
                                "text": "« Puisque tu insultes ton père et que tu as le culot de lui faire la morale, je te défends de refoutre les pieds à la maison. Tu n’es plus mon fils. Je te renie."
                            },
                            {
                                "example_id": "a2eb33ad-7412-41f5-9aa8-8e68f6c7740e",
                                "sense_id": "4d0ee562-b5fc-3254-a8ab-7b0d9e1d7826",
                                "text": "Parce que mon père a décidé que si elle refoutait les pieds à la maison il la balancerait par la fenêtre… — et il ajouta, songeur : — Nous habitons au cinquième…"
                            }
                        ]
                    }
