                                        "examples": [
                                            {
                                                "example_id": "842b08c8-ffac-4d2d-a492-bb377bce5519",
                                                "sense_id": "cd181fe8-783c-39e2-8891-8dcb926d1458",
                                                "text": "Je retrouve devant l’entrée de mon immeuble la petite agitation nocturne habituelle : bicraves et camés graves qui se fixent dans la tasse Decaux dont ils ont bricolé le mécanisme ouvrant la porte coulissante."
                                            },
                                            {
                                                "example_id": "8804b979-2188-4fa3-97dc-ec5c6519ea36",
                                                "sense_id": "cd181fe8-783c-39e2-8891-8dcb926d1458",
                                                "text": "Dans la région de Zaporijia, l’unité du commandant « Gall » a appris à bricoler des lance-roquettes, faute de matériel suffisant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fe47c82-51a3-3e3e-ad49-6139e88935f5",
                                        "entry_id": "fd88ed34-26f7-32f9-a3f3-92b5cc0caf7b",
                                        "glosses": [
