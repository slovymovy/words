                        "glosses": [
                            "elk van de grote delen waarin een hersenhelft verdeeld wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942e3fbe-e554-42bc-953e-9d1552c5f9d1",
                                "sense_id": "f0b6b5f5-5f6d-3f0f-8bc5-ce51526964c5",
                                "text": "Herstel van die frontale hersenkwab is mogelijk, maar het vergt jaren. Bovendien wordt het nooit meer als vroeger, zegt Matthys."
                            },
                            {
                                "example_id": "e0720fad-446c-44e3-a86a-4c366e7a562b",
                                "sense_id": "f0b6b5f5-5f6d-3f0f-8bc5-ce51526964c5",
                                "text": "Ook Duitse wetenschappers zochten naar een verklaring. Ze lieten mensen onder een MRI-scanner naar een foto van de jurk kijken. Mensen die de jurk in wit-goud zagen, vertoonden extra hersenactiviteit, voornamelijk in de voorste en pariëtale hersenkwab. Deze delen van de hersenen zijn vaak actief bij selectieve aandacht, besluitvorming en het verwerken van visuele informatie."
                            }
                        ]
                    }
