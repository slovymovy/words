{
    "word_family": [
        "disintegration",
        "disintegrator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2398262c-4cda-3081-95df-3c54528917a4",
                    "sense_definition": "To break something into smaller pieces or parts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "break_apart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old stone wall began to <w>disintegrate</w> after years of heavy rain and wind.",
                            "target_lang_translations": {
                                "zh": "那堵老石墙在经受多年风雨侵蚀后开始<w>碎裂</w>。"
                            }
                        },
                        {
                            "text": "The dry leaves <w>disintegrate</w> easily when you crush them in your hands.",
                            "target_lang_translations": {
                                "zh": "干枯的叶子用手一捏就容易<w>碎裂</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dismember"
                    ],
                    "antonyms": [
                        "integrate"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体因受损或风化而碎裂成小块或微粒。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "碎裂",
                                "target_lang_sense_clarification": "强调物体破裂成碎片的过程。"
                            },
                            {
                                "target_lang_word": "分解",
                                "target_lang_sense_clarification": "指物体由整体变为部分。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b7d6fb4-7a02-367a-8167-fc0bb93bf7ce",
                    "sense_definition": "To fall apart or lose cohesion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "break_apart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political party started to <w>disintegrate</w> following the leader's sudden resignation.",
                            "target_lang_translations": {
                                "zh": "在领导人突然辞职后，该政党开始<w>瓦解</w>。"
                            }
                        },
                        {
                            "text": "The airplane began to <w>disintegrate</w> mid-air after the engine failure occurred.",
                            "target_lang_translations": {
                                "zh": "飞机引擎故障后，在半空中开始<w>解体</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decay",
                        "dissolve"
                    ],
                    "antonyms": [
                        "integrate"
                    ],
                    "target_lang_definitions": {
                        "zh": "指组织、系统或结构失去凝聚力而瓦解或崩溃。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "瓦解",
                                "target_lang_sense_clarification": "常用于组织、政党或系统崩溃。"
                            },
                            {
                                "target_lang_word": "崩溃",
                                "target_lang_sense_clarification": "指结构或系统彻底垮掉。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}