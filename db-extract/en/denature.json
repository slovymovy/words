                ],
                "senses": [
                    {
                        "sense_id": "b06f5e43-e5cf-37c0-9e70-e893e10bebf4",
                        "entry_id": "90adc8cc-6bf8-3b61-906b-c68889776b9c",
                        "glosses": [
                            "To take away a natural characteristic or inherent property of (a thing or a person)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "de7aac8e-01d2-3b7e-8d94-4ab6188a8f5b",
                        "entry_id": "90adc8cc-6bf8-3b61-906b-c68889776b9c",
                        "glosses": [
                            "To add something to (alcohol) that makes it unsuitable for consumption but leaves it suitable for most other purposes."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f0566835-cf79-4586-bc1d-eb7fc8c9bbcc",
                                "sense_id": "de7aac8e-01d2-3b7e-8d94-4ab6188a8f5b",
                                "text": "While you cannot drink denatured alcohol, you can still use it to remove sticker glue from most surfaces."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce5cc22a-0ec7-36d1-aba4-d1bb10c79f73",
                        "entry_id": "90adc8cc-6bf8-3b61-906b-c68889776b9c",
                        "glosses": [
                            "To alter its original form or state, especially of a protein, by heat, acidity etc."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "07802832-b826-441e-8b15-8e774b32b72d",
                                "sense_id": "ce5cc22a-0ec7-36d1-aba4-d1bb10c79f73",
                                "text": "Sugars are wonderfully robust materials! Unlike proteins that easily denature and coagulate, unlike fats that are damaged by air and heat and go rancid, unlike starch chains that break apart into smaller chains of glucose molecules, sugars themselves are small and stable molecules."
                            },
                            {
                                "example_id": "8eb33389-bb9d-401e-9501-676c30122854",
                                "sense_id": "ce5cc22a-0ec7-36d1-aba4-d1bb10c79f73",
                                "text": "Because the activity of an enzyme depends on its structure, any change in that structure will destroy its effectiveness. So cooking foods sufficiently will denature and inactivate any enzymes they may contain."
                            }
                        ]
                    },
                    {
                        "sense_id": "a93372f1-bb99-3a93-8575-8a21a5ad68aa",
                        "entry_id": "90adc8cc-6bf8-3b61-906b-c68889776b9c",
                        "glosses": [
                            "Of double-stranded DNA, specifically to split into two single strands."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "404e5eee-5913-3451-9aff-f26b27d1ebc8",
                        "entry_id": "90adc8cc-6bf8-3b61-906b-c68889776b9c",
                        "glosses": [
                            "To combine fissile material with nonfissile material in order to prevent its use in an atomic weapon."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
