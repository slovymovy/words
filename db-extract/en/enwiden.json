                "senses": [
                    {
                        "sense_id": "35598044-70d3-334b-aa97-0cf546e4b1c3",
                        "entry_id": "57920fc8-b73c-3381-ae5e-a7bf87112081",
                        "glosses": [
                            "Broaden; diversify."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73b5e8a0-29f6-4ee4-9512-fb581038ff36",
                                "sense_id": "35598044-70d3-334b-aa97-0cf546e4b1c3",
                                "text": "[…] seeking not so much to extend its dominion as to enwiden its markets and civilizing influence."
                            },
                            {
                                "example_id": "3566d15f-14c4-43e5-9dd6-706ca8faa8d8",
                                "sense_id": "35598044-70d3-334b-aa97-0cf546e4b1c3",
                                "text": "During the very decade, when the League of Nations went bankrupt as a political agency for international peace and security, i.e. the ‛thirties, the organization through its secretariat, various specialized commissions, and expert committees, kept on doing much useful technical work in the economic, social, and humanitarian fields and also rendered it more feasible for the League to enwiden its collaboration in those fields with the nations outside the League."
                            },
                            {
                                "example_id": "6802dc4b-8f8c-4971-a501-4e2e121c367f",
                                "sense_id": "35598044-70d3-334b-aa97-0cf546e4b1c3",
                                "text": "2. To enwiden, increase and enlarge the knowledge, the intelligence and the consciousness of the people…"
                            }
                        ]
                    }
