                        "entry_id": "7a987287-f53d-319a-b0f7-ea8733a4d323",
                        "glosses": [
                            "Administration, or administrative work."
                        ],
                        "tags": [
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0d0ddb79-a2ff-4050-9d3b-b08e17b0520c",
                                "sense_id": "eecfcaae-285c-3ba8-a20f-6997b6f17ed8",
                                "text": "There's a lot of admin involved in the birth of a child."
                            }
                        ]
                    },
                    {
                        "sense_id": "93bc3462-2ea6-3546-9d59-30e6d5c18ecc",
                        "entry_id": "7a987287-f53d-319a-b0f7-ea8733a4d323",
                        "glosses": [
                            "An administration (a body that administers; the executive part of government)."
                        ],
                        "tags": [
                            "countable",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "24a874ac-e5dd-43da-a68d-f04de80c45ab",
                                "sense_id": "93bc3462-2ea6-3546-9d59-30e6d5c18ecc",
                                "text": "Senate Minority Leader Charles E. Schumer (D-N.Y.) tweeted after the announcement, “I will not stop fighting to protect the Arctic National Wildlife Refuge and stop the Trump admin’s plan for drilling.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "6d81ec31-41ee-3760-ab5b-25360bd270fb",
                        "entry_id": "7a987287-f53d-319a-b0f7-ea8733a4d323",
                        "glosses": [
                            "The administrative or managerial body of a company or other organization."
                        ],
                        "tags": [
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7cadbf69-5584-4b7c-9d3f-bf3a164fb7b2",
                                "sense_id": "6d81ec31-41ee-3760-ab5b-25360bd270fb",
                                "text": "Barren dirt plots behind knee-high metal fences indicated admin must have cut the flower budget."
                            }
                        ]
                    },
                    {
                        "sense_id": "11583c00-0795-3bcc-bc29-37a0f546a1fc",
                        "entry_id": "7a987287-f53d-319a-b0f7-ea8733a4d323",
                        "glosses": [
                            "An administrator (one who administers affairs)."
                        ],
                        "tags": [
                            "countable",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ff5802cd-831b-4c99-833a-1c4ee56da530",
                                "sense_id": "11583c00-0795-3bcc-bc29-37a0f546a1fc",
                                "text": "Georgia’s election administrators are fighting bizarre conspiracy theories, ballooning costs and coronavirus-related staffing problems as they prepare for the state’s contentious, nationally watched Senate runoffs next week."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2105da6-1072-3759-be77-04843f2058d3",
                        "entry_id": "7a987287-f53d-319a-b0f7-ea8733a4d323",
                        "glosses": [
                            "A systems administrator (one who maintains a computer system or network)."
                        ],
                        "tags": [
                            "countable",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "58b0f2dd-f2e3-4a2f-96ef-7cf4aa2e06f1",
                                "sense_id": "d2105da6-1072-3759-be77-04843f2058d3",
                                "text": "Our admin has upgraded the server in our office, so we can exchange files faster."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e55f95e-3bfe-36ce-a814-b12735290502",
                        "entry_id": "7a987287-f53d-319a-b0f7-ea8733a4d323",
                        "glosses": [
                            "A user of a discussion forum, website, etc. with privileges allowing them to control or restrict the activity of other users."
                        ],
                        "tags": [
                            "Internet",
                            "countable",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "587d0d41-0b67-4fd0-9266-1c57e45e2d46",
                                "sense_id": "9e55f95e-3bfe-36ce-a814-b12735290502",
                                "text": "The admin changed the forum settings to enable the use of emoticons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f04d05ff-9652-4a17-9bf6-98f4429dfed3",
                        "source_entry_id": "7a987287-f53d-319a-b0f7-ea8733a4d323",
