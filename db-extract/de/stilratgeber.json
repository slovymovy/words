                "senses": [
                    {
                        "sense_id": "4f5f8e73-b38c-37c1-8267-f4e237d5c5f8",
                        "entry_id": "6e9879c1-708d-3ccd-b79a-2cb4f1149a0b",
                        "glosses": [
                            "Buch mit Hinweisen für die Verbesserung der Ausdrucksweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa2e3c1-9a38-4c2b-9cf6-710f614bd45d",
                                "sense_id": "4f5f8e73-b38c-37c1-8267-f4e237d5c5f8",
                                "text": "„Vorbilder für gutes Deutsch und die angestrebte Hochsprache werden demgegenüber in populären Sprach- und Stilratgebern oftmals in der klassischen Literatur und bei namhaften Schriftstellern gesucht.“"
                            },
                            {
                                "example_id": "cf91d79a-a459-4d43-9274-cec0f3481c63",
                                "sense_id": "4f5f8e73-b38c-37c1-8267-f4e237d5c5f8",
                                "text": "„Außerhalb der Kunstgeschichte und damit als Methode zur Analyse von Stilepochen wird der Begriff der Stilkunde auch im Sinne einer Lehre vom guten Stil in ganz verschiedenen Zusammenhängen gebraucht, so etwa im Bereich von Stilratgebern für „gutes Schreiben“ oder als „Stilkunde für Schreiner“.“"
                            },
                            {
                                "example_id": "15e0e3cf-0403-4350-a214-c6b011543126",
                                "sense_id": "4f5f8e73-b38c-37c1-8267-f4e237d5c5f8",
                                "text": "„Im Folgenden wird die Vielfalt der Stilratgeber anhand von Beispielen aus Spanien erläutert.“"
                            },
                            {
                                "example_id": "a67a3206-e82c-4c4d-ae65-35cef24252a5",
                                "sense_id": "4f5f8e73-b38c-37c1-8267-f4e237d5c5f8",
                                "text": "„Gehört hat er vom Genitiv selbst nur in Stilratgebern anderer, und die haben es wiederum aus anderen Stilratgebern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "42e981ff-3602-318d-a7a8-568e31ffe5c2",
                        "entry_id": "6e9879c1-708d-3ccd-b79a-2cb4f1149a0b",
                        "glosses": [
                            "Mode und andere Anwendungsgebiete: Hinweise zum passenden Stil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc61937-b48a-4ec8-af49-e08aeb0dbea3",
                                "sense_id": "42e981ff-3602-318d-a7a8-568e31ffe5c2",
                                "text": "„Das klingt schon zeitgemäßer, führt aber auch die Krux mit den Stilratgebern vor Augen.“"
                            },
                            {
                                "example_id": "7b0ba4ec-74af-4eb8-b952-0292b44e955f",
                                "sense_id": "42e981ff-3602-318d-a7a8-568e31ffe5c2",
                                "text": "„Ein amerikanischer Stilratgeber beschäftigt sich seit langen mit Mode für Männer im Berufsleben, vor allen in hochrangigen Positionen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
