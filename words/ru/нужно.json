                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне срочно <w>нужно</w> позвонить домой.",
                            "target_lang_translations": {
                                "en": "I urgently <w>need</w> to call home.",
                                "nl": "Ik <w>moet</w> dringend naar huis bellen.",
                                "pl": "Pilnie <w>trzeba</w> mi zadzwonić do domu.",
