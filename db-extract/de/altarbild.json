                    }
                ],
                "senses": [
                    {
                        "sense_id": "83b707c0-af53-3bba-a0a9-687f84d2abdb",
                        "entry_id": "50bdd9e3-6c03-3643-aac6-9857e5614693",
                        "glosses": [
                            "Bild, das an oder über einem Altar angebracht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39bd0573-1984-4635-89dc-de4bf6135479",
                                "sense_id": "83b707c0-af53-3bba-a0a9-687f84d2abdb",
                                "text": "„Das Altarbild malte der Däne Christoffer Wilhelm Eckersberg.“"
                            },
                            {
                                "example_id": "7aabc94a-4efe-42a1-8d0e-8a6575f479c1",
                                "sense_id": "83b707c0-af53-3bba-a0a9-687f84d2abdb",
                                "text": "„Das Altarbild auf der Etagere zittert, als er den Tisch mit den Fäusten bearbeitet.“"
                            },
                            {
                                "example_id": "a3be8695-7c22-431e-ba39-0f76fd8e98ad",
                                "sense_id": "83b707c0-af53-3bba-a0a9-687f84d2abdb",
                                "text": "„Zu Luthers Zeit war sie nicht ganz so kahl wie heute, sondern mit einem Altarbild Cranachs und mit weiteren Gemälden geschmückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9824853f-0d60-4e4d-ace3-d400af0bf6fe",
                        "source_entry_id": "50bdd9e3-6c03-3643-aac6-9857e5614693",
                        "source_sense_id": "83b707c0-af53-3bba-a0a9-687f84d2abdb",
                        "source_sense_description": "Bild, das an oder über einem Altar angebracht ist",
                        "target_lang_word": "altarpiece",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altarpiece",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3f7b0e1-619a-3c78-9492-36b79ed4a019",
                                        "entry_id": "c961baa3-edaa-36a5-bff6-7430b12ff68a",
                                        "glosses": [
                                            "a work of art suspended above and behind an altar in a church"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b50dd0b-3f6c-45c4-b8e1-9e0ba3ff2a14",
                                                "sense_id": "e3f7b0e1-619a-3c78-9492-36b79ed4a019",
                                                "text": "I walked across the concrete to examine the altarpiece of the atomic age. A large crack ran through it."
                                            },
                                            {
                                                "example_id": "967dd6f1-a635-46eb-aec2-fa7269c605e7",
                                                "sense_id": "e3f7b0e1-619a-3c78-9492-36b79ed4a019",
                                                "text": "“It’s this snaggletoothed, little bird-footed homunculus caricature,” Bourneuf said. “Many artists at this time were trying to make new altarpieces. Klee tended to take a very skeptical distance from the sort of grandiose projects of many of his expressionist peers, so I think it’s actually kind of mocking those hopes.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
