                ],
                "senses": [
                    {
                        "sense_id": "a3976d70-515d-3acd-af64-04955a093358",
                        "entry_id": "820b2904-b231-39c5-b980-1e44016ef7ae",
                        "glosses": [
                            "Leblosigkeit, Fehlen oder Aufhören von Lebensvorgängen; abiotischer, d. h. prä- oder postbiotischer Zustand eines natürlichen Systems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d1bae98-7885-44ca-88d4-d53bc269fe32",
                                "sense_id": "a3976d70-515d-3acd-af64-04955a093358",
                                "text": "„Die Vorstellung, dass eine Kompartimentierung eine Voraussetzung für die chemische Evolution hin zum Leben ist, geht im Wesentlichen auf A. I. Oparin zurück. […] Favoriten in dieser Beziehung sind dabei kleine Poren in Mineralaggregationen, wie sie bekanntlich die Schwarzen und Weißen Raucher im Bereich hydrothermaler Quellen ausbilden […] Sie könnten durchaus im Sinne der Wächterhäuser-Theorie die ersten wesentlichen Reaktionsräume gewesen sein, die auch die RNA-Welt in ihren Anfängen beherbergte. Nach diesem Ansatz könnte die Abiose in kleinen, präbiotischen Kompartimenten ihren Anfang genommen haben, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "081da419-52e9-3e24-aa48-3623b8a089bf",
                        "entry_id": "820b2904-b231-39c5-b980-1e44016ef7ae",
                        "glosses": [
                            "Hemmung des Wachstums oder Absterben von einzelnem Gewebe oder einzelnen Organen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9f09b11-5770-4357-9453-0067223bedb3",
                                "sense_id": "081da419-52e9-3e24-aa48-3623b8a089bf",
                                "text": "Mit dem Verlust eines lebenswichtigen Ernährungsfaktors kann eine schwere Form von Abiose entstehen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7bf2b13-da83-4f28-b9af-00b7be035501",
                        "source_entry_id": "820b2904-b231-39c5-b980-1e44016ef7ae",
                        "source_sense_id": "a3976d70-515d-3acd-af64-04955a093358",
                        "source_sense_description": "Leblosigkeit, Fehlen oder Aufhören von Lebensvorgängen",
                        "target_lang_word": "abiosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abiosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd716402-a6a7-3bb1-be07-4640a70a4059",
                                        "entry_id": "efd6c3a2-ea4c-3ec2-8236-f85d9af9d5c3",
                                        "glosses": [
                                            "The absence of life."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a843a7-9687-4008-a6a3-00f286fccc68",
                                                "sense_id": "dd716402-a6a7-3bb1-be07-4640a70a4059",
                                                "text": "In fact, more than just the total elimination of bacteria by filtration, the aim should also be stabilization by abiosis (page 119), with the implication of reducing the contaminating cell load as much as possible."
                                            },
                                            {
                                                "example_id": "2d037bb3-97ec-4f66-bf1e-288b09fcb785",
                                                "sense_id": "dd716402-a6a7-3bb1-be07-4640a70a4059",
                                                "text": "At times, every professor believes that his classroom represents the abnegation of intelligence, if not absolute abiosis."
                                            },
                                            {
                                                "example_id": "d6b16678-5726-4e69-b504-72e131ad1c4e",
                                                "sense_id": "dd716402-a6a7-3bb1-be07-4640a70a4059",
                                                "text": "PRIMARY SUCCESSION: In the present work, the long-term changes accompanying the gradual development of ecosystems in some geographical region, starting from a condition of abiosis."
                                            },
                                            {
                                                "example_id": "7b611060-7a6d-456b-a2c1-8eab39459900",
                                                "sense_id": "dd716402-a6a7-3bb1-be07-4640a70a4059",
                                                "text": "The rapid onset of Japanese industrialization in the absence of environmental safeguards led to eutrophication, anoxia and frequent abiosis of urban and peri-urban waters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a371cbf-773b-3822-89af-763571d91354",
                                        "entry_id": "efd6c3a2-ea4c-3ec2-8236-f85d9af9d5c3",
                                        "glosses": [
                                            "The temporary cessation of biological processes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb8b4a3b-4e47-47e1-b80f-53e83b680497",
                                                "sense_id": "9a371cbf-773b-3822-89af-763571d91354",
                                                "text": "The symptoms of intoxication may differ in both cases considerably, e.g. they may be attended by deep unconsciousness and abiosis, and also by violent convulsions."
                                            },
                                            {
                                                "example_id": "46f11f14-ab25-41c7-b148-460b3ab0c3ab",
                                                "sense_id": "9a371cbf-773b-3822-89af-763571d91354",
                                                "text": "Briefly draws attention to deviations from reciprocity and to the partial reversibility of many radiation induced phenomena, to the possible use of organisms in a state of abiosis as integral dose-indicators, to certain specially radiosensitive organisms and responses, and to questions of threshold."
                                            },
                                            {
                                                "example_id": "1ea3a75b-e63a-43a3-a748-991f99275160",
                                                "sense_id": "9a371cbf-773b-3822-89af-763571d91354",
                                                "text": "The animals of the first group were left in a state of an abiosis at a temperature of + 4 ° after irradiation."
                                            },
                                            {
                                                "example_id": "40fd9dec-5186-4bf5-b777-345503ecd34e",
                                                "sense_id": "9a371cbf-773b-3822-89af-763571d91354",
                                                "text": "Besides α-taxonomy, which started, albeit with a certain delay, soon after the first discovery of tardigrades and which continues unabatedly, tardigrade research was dominated almost from the beginning by two topics, i.e. (1) anabiosis or abiosis or, the more modern term, cryptobiosis and here especially anhydrobiosis (the ability many tardigrades share with other organisms such as the metazoan taxa rotifers and nematodes, in which this phenomenon was detected earlier than in tardigrades) and (2) possible relationships to other organims;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75fc9e34-7d98-3ae0-9fb2-4bc65621dccd",
                                        "entry_id": "efd6c3a2-ea4c-3ec2-8236-f85d9af9d5c3",
                                        "glosses": [
                                            "Necrosis, especially that which occurs at the single cell level."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee1bb6c5-95f1-467a-951b-8e83bf2d353a",
                                                "sense_id": "75fc9e34-7d98-3ae0-9fb2-4bc65621dccd",
                                                "text": "Finally, here is an example of hereditary defect at the outset in some tissue or group of tissues, which may be compared in its ultimate nature with the human jerry-buildings or so-called abioses such as Friedreich's syndrome, achondroplasia, or the muscular dystrophies."
                                            },
                                            {
                                                "example_id": "5be2e333-72f5-49db-8bde-fabcd254217e",
                                                "sense_id": "75fc9e34-7d98-3ae0-9fb2-4bc65621dccd",
                                                "text": "Abiosis is prominent in the 210 - 296 mμ range, though. It seems impossible that ultraviolet light could kill bacteria living in other tissues , but this effect is probably very limited for the eye ."
                                            },
                                            {
                                                "example_id": "be085751-68ce-4ede-9046-5dbc3718cbbf",
                                                "sense_id": "75fc9e34-7d98-3ae0-9fb2-4bc65621dccd",
                                                "text": "If disturbed, deleterious changes to the code, and accordingly to the gene products (proteins), may occur resulting in mutations or even abiosis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5b44247-e457-444d-ba61-8b13db0ba3ea",
                        "source_entry_id": "820b2904-b231-39c5-b980-1e44016ef7ae",
                        "source_sense_id": "a3976d70-515d-3acd-af64-04955a093358",
                        "source_sense_description": "Leblosigkeit, Fehlen oder Aufhören von Lebensvorgängen",
                        "target_lang_word": "abiose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abiose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30d9323a-5263-3ea9-829c-251eba904ea8",
                                        "entry_id": "aeb2c891-1162-384a-9d4d-9704e520f2a0",
                                        "glosses": [
                                            "Cessation de la vie, mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b595cad-34b9-47a9-970d-98fcaaef70e9",
                                                "sense_id": "30d9323a-5263-3ea9-829c-251eba904ea8",
                                                "text": "Ainsi, par exemple, l’on constate que chez des animaux de laboratoire mis en abiose, les maladies infectieuses ne se développent pas, même si elles ont été artificiellement inoculées pour l’expérience."
                                            }
                                        ]
