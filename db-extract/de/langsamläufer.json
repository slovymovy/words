                ],
                "senses": [
                    {
                        "sense_id": "ea477cc1-cc79-36dc-a1ac-fa14581aaf53",
                        "entry_id": "26cc455e-7b44-319a-9f71-efa7d46015d5",
                        "glosses": [
                            "Person, die (im Vergleich zu anderen Läufern) langsamer läuft oder ein langsames Tempo beim Laufen bevorzugt"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "20fb09b1-6156-47c8-86ea-26d22e3ab2e8",
                                "sense_id": "ea477cc1-cc79-36dc-a1ac-fa14581aaf53",
                                "text": "„Die Idee finde ich toll, denn ich kann mich noch immer nicht aufraffen alleine laufen zu gehen und ich bin sogar schon in eine schnelle Gruppe der Langsamläufer aufgestiegen, die mir super symphathisch ist!“"
                            },
                            {
                                "example_id": "afbb4360-30c6-4f0d-9ef7-ac8f02874c25",
                                "sense_id": "ea477cc1-cc79-36dc-a1ac-fa14581aaf53",
                                "text": "„Dann wird es für Langsamläufer wie mich schon sehr unangenehm, die Burschen rennen weg wie bei einem 400 m Bahnrennen – so ziemlich alle – der Sieger läuft die 15,6 km in 51 min.“"
                            },
                            {
                                "example_id": "3a885eb3-7e08-4202-b172-05d0f41e9b3b",
                                "sense_id": "ea477cc1-cc79-36dc-a1ac-fa14581aaf53",
                                "text": "„Natürlich nicht von heute auf morgen und auf Knopfdruck, schliesslich ist er ja ein Langsamläufer und Steinbock ist eher für seine Beharrlichkeit als für sein Tempo bekannt.“"
                            },
                            {
                                "example_id": "f9980d23-ba7f-4093-af92-586b09309347",
                                "sense_id": "ea477cc1-cc79-36dc-a1ac-fa14581aaf53",
                                "text": "„Ich startete mit so wenig Motivation wie selten, der Rücken rumorte so sehr, dass ich mich entschloss, mit einem ‚ABC-Pflaster‚ auf dem Rücken zu starten, da hinten in der Masse der Langsamläufer war es schwer, wegen des permanenten Platzmangels in Tritt zu kommen und bei Kilometer 8 bekam ich das erste Mal in meinem Läuferleben ein wenig Angst.“"
                            },
                            {
                                "example_id": "be8bac62-6dee-4038-9402-eacd709f0b3e",
                                "sense_id": "ea477cc1-cc79-36dc-a1ac-fa14581aaf53",
                                "text": "„Die Wanderer, Nordic Walker und Langsamläufer konnten sich zwischen einer elf und einer zwanzig Kilometer langen Strecke entscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8cf0bc83-f8f7-3cef-a923-9f9391406107",
                        "entry_id": "26cc455e-7b44-319a-9f71-efa7d46015d5",
                        "glosses": [
                            "Motor oder Maschine, die mit niedriger Drehzahl arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "285d69bd-2c29-4c88-a42c-56c328a470d6",
                                "sense_id": "8cf0bc83-f8f7-3cef-a923-9f9391406107",
                                "text": "„Der VDL-20-I ist ein Langsamläufer mit 1500 U/min und einem 4-Zylinder- ISUZU Motor.“"
                            },
                            {
                                "example_id": "ab2f591d-a117-45bc-a869-3c487e26f82c",
                                "sense_id": "8cf0bc83-f8f7-3cef-a923-9f9391406107",
                                "text": "„Schön ist ein Motor mit 6 Zylindern, noch schöner ist ein Langsamläufer der Marschfahrt bei um die 1.200 Umdrehungen macht (gibt es aber nur selten, meisten liegen dann um die 2.000 Umdrehungen an).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dc41c848-076f-38aa-b80e-192b0ca8f6f4",
                        "entry_id": "26cc455e-7b44-319a-9f71-efa7d46015d5",
                        "glosses": [
                            "Himmelskörper, der sich relativ langsam über den Himmel bewegt, insbesondere im Vergleich zu den schnelleren Planeten wie Merkur oder Venus"
                        ],
                        "tags": [
                            "Astrologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3ec58eff-847e-4162-8002-bd141bd5023b",
                                "sense_id": "dc41c848-076f-38aa-b80e-192b0ca8f6f4",
                                "text": "„Im Jahr 2023 gibt es mehrere Zeichenwechsel von Langsamläufern, Pluto wechselt erstmals in den Wassermann […]“"
                            },
                            {
                                "example_id": "040960e6-4c81-4abb-8863-984ae0b8ca8e",
                                "sense_id": "dc41c848-076f-38aa-b80e-192b0ca8f6f4",
                                "text": "„Zum Schluss ändert ein weiterer Langsamläufer, Neptun, seine Laufrichtung.“"
                            },
                            {
                                "example_id": "95f6e892-7855-4817-94e5-ebac74b4e55f",
                                "sense_id": "dc41c848-076f-38aa-b80e-192b0ca8f6f4",
                                "text": "„Links zu aktuellen und älteren Blogs zu Jupiter/Saturn (gesellschaftliche Planeten), Uranus/Neptun/Pluto (den sogenannten ‚Langsamläufern‘), Chiron/Lilith/Mondknoten oder Rückläufigkeit:“"
                            },
                            {
                                "example_id": "056df02c-a34d-4e09-998b-b077313a8e3e",
                                "sense_id": "dc41c848-076f-38aa-b80e-192b0ca8f6f4",
                                "text": "„Mit dabei der Langsamläufer Pluto und auch Saturn, die jeweils einige Jahre in einem Zeichen verweilen.“"
                            },
                            {
                                "example_id": "ef9cc503-ee5e-4fed-b866-14c8e5b9dca0",
                                "sense_id": "dc41c848-076f-38aa-b80e-192b0ca8f6f4",
                                "text": "„Richtig spannend wird es ab 2025, wenn Pluto mit den beiden anderen Langsamläufern und Schicksalsplaneten Uranus und Neptun eine grad genaue Verbindung eingeht - ein wohlwollende, ein Talentdreieck.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
