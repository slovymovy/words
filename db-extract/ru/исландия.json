                                "target_senses": [
                                    {
                                        "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                        "entry_id": "ac1136f9-4ef8-3154-a26b-f8e3f9d10c74",
                                        "glosses": [
                                            "Inselstaat im Nordatlantik"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae1441a1-4de8-4af1-8e76-98837dd619fe",
                                                "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                                "text": "Ich habe im Urlaub auf Island über 1000 Fotos geschossen."
                                            },
                                            {
                                                "example_id": "3baebdf9-5a37-4c5c-95dd-ea673fd25ecc",
                                                "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                                "text": "„Sie haben ganz richtig gelesen: In Island gibt es ein Phallusmuseum.“"
                                            },
                                            {
                                                "example_id": "a2c52e61-89b9-424a-80ce-b7995d9f53a8",
                                                "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                                "text": "„Island und Grönland haben eines gemeinsam: Beide waren Kolonien Dänemarks.“"
                                            },
                                            {
                                                "example_id": "4aab29af-2c2c-4f36-99a0-fce0ee2ed49b",
                                                "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                                "text": "„Roland hatte mir zugeflüstert, auf den Färöern wohnten jene, die die Wikingerschiffe wegen Seekrankheit verlassen mussten, als sie auf dem Weg nach Island waren.“"
                                            },
                                            {
                                                "example_id": "83f2226b-f5b3-4cc8-9acb-143d5c478402",
                                                "sense_id": "515f20ce-398e-3dc4-b3ab-807aa9e42344",
                                                "text": "„Bald kennen die Steuermänner die Strömungen und Gefahren auf der Fahrt zwischen Nordeuropa und Island besser, ist die Route weniger risikoreich als zuvor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
