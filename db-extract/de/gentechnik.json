                "senses": [
                    {
                        "sense_id": "df2f2dda-b886-3f56-813f-d1f12946213e",
                        "entry_id": "e7a27409-d39b-312a-b1a1-2a5e6f0956fb",
                        "glosses": [
                            "Technologie zur Veränderung/Manipulation des Erbguts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fc6daab-dee7-49e8-99a0-a7471ff19a31",
                                "sense_id": "df2f2dda-b886-3f56-813f-d1f12946213e",
                                "text": "„Mithilfe der Gentechnik wurden verschiedene Ansätze zur Stechmückenbekämpfung entwickelt.“"
                            },
                            {
                                "example_id": "c28a7326-ed14-4be9-a0a3-84288c96ab97",
                                "sense_id": "df2f2dda-b886-3f56-813f-d1f12946213e",
                                "text": "„Man kann beispielsweise Pflanzen mittels Gentechnik so manipulieren, dass sie gegen bestimmte Krankheiten immun oder unempfindlich gegen sonst giftige chemische Pflanzenschutzmittel werden.“"
                            }
                        ],
