                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "συμπεριφορά",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "2cdecd55-5819-387f-8504-367e799879b9",
                                        "entry_id": "6b2e1c94-e7c1-3f3c-af64-fb48c66ae3f2",
                                        "glosses": [
                                            "ο τρόπος με τον οποίο κάποιος αντιμετωπίζει τους άλλους"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa15f6f7-09dd-4c05-b9c4-b09f45125da2",
                                                "sense_id": "2cdecd55-5819-387f-8504-367e799879b9",
                                                "text": "Η συμπεριφορά της είναι σοβαρή και μετρημένη."
                                            },
                                            {
                                                "example_id": "f0ad7767-7d7e-429e-935a-cdfba266dbb7",
                                                "sense_id": "2cdecd55-5819-387f-8504-367e799879b9",
                                                "text": "※ Ζουν βασιζόμενοι στην διαφθορά και την ρεμούλα των δημοσίων λειτουργών και γενικά αποτελούν με την συμπεριφορά τους κακό παράδειγμα για τους πολίτες και τα παιδιά. (Αντώνιος Περιπατητής, Χοές, 2019, σελ. 80)"
                                            },
                                            {
                                                "example_id": "d54202b0-7466-4140-95dc-fa7f654ebf87",
                                                "sense_id": "2cdecd55-5819-387f-8504-367e799879b9",
                                                "text": "※ Επομένως, για την στοιχειοθέτηση της ελαφρυντικής περίστασης του προτέρου εντίμου βίου πρέπει να εκτίθενται συγκεκριμένα, (θετικά), περιστατικά έντιμης ζωής με αξιοσημείωτη και επιβραβεύσιμη συμπεριφορά μέχρι την τέλεση της πράξης και απόδειξη θετικής και επωφελούς για την κοινωνία δράσης σε όλους τους τομείς της ζωής του (Απόφαση 1328 / 2018, Άρειος Πάγος https://www.areiospagos.gr/nomologia/apofaseis_DISPLAY.asp?cd=3MMPGP1TCLXMS0SXEUIG0HGCFA2MJF&apof=1328_2018&info=%D0%CF%C9%CD%C9%CA%C5%D3%20-%20%20%C5)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f058adc1-2a99-344b-9d91-fcab2bdee46a",
                                        "entry_id": "6b2e1c94-e7c1-3f3c-af64-fb48c66ae3f2",
                                        "glosses": [
                                            "ο επιβεβλημένος ή κατάλληλος τρόπος αντίδρασης σε συγκεκριμένες περιστάσεις"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94391b07-f7f2-476c-9013-3af7bb3da522",
                                                "sense_id": "f058adc1-2a99-344b-9d91-fcab2bdee46a",
                                                "text": "Δεν είναι συμπεριφορά αυτή, να μην εκτιμάς αυτά που σου δίνω!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ba9567d-1661-3272-88aa-c904225e5fd1",
                                        "entry_id": "6b2e1c94-e7c1-3f3c-af64-fb48c66ae3f2",
                                        "glosses": [
                                            "οι χαρακτηριστικές ενέργειες ενός ατόμου, ο τρόπος αντίδρασής του σε συγκεκριμένα εξωτερικά ή εσωτερικά ερεθίσματα"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bf8a7dd-8c19-415d-86b9-e86e1219d583",
                                                "sense_id": "8ba9567d-1661-3272-88aa-c904225e5fd1",
                                                "text": "προγαμιαία συμπεριφορά"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29b0be65-93d6-3115-9003-7dda7cc6a08a",
                                        "entry_id": "6b2e1c94-e7c1-3f3c-af64-fb48c66ae3f2",
                                        "glosses": [
                                            "ο τρόπος που υφίσταται ή αντιδρά ένα υλικό με συγκεκριμένη χρήση ή σε ορισμένες συνθήκες"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a928bf08-62b6-48a0-9790-a55d2ca58127",
                                                "sense_id": "29b0be65-93d6-3115-9003-7dda7cc6a08a",
                                                "text": "Η θερμότητα μπορεί να μεταβάλλει τη συμπεριφορά των ελαστικών στο δρόμο."
                                            }
                                        ]
                                    }
