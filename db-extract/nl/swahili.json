                                "example_id": "d20c942d-641f-4a68-a378-ee5ed80dcd9a",
                                "sense_id": "39743c68-02be-30f3-b388-05ab2128a35f",
                                "text": "Het Swahili is best een bekende taal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f677c1f4-3e75-4448-858e-7bf6a4d54710",
                        "source_entry_id": "089185c2-a3f6-305b-bf97-4694a3254ed0",
                        "source_sense_id": "39743c68-02be-30f3-b388-05ab2128a35f",
