                                        "entry_id": "154784b7-6bb7-3309-b923-657837fb5a6e",
                                        "glosses": [
                                            "so gut, dass es zu preisen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea631485-af70-40a4-8246-459f2d1bc99f",
                                                "sense_id": "13aa0765-3370-361b-93c7-48f350ac49e3",
                                                "text": "Das ist eine lobenswerte Leistung."
                                            },
                                            {
                                                "example_id": "4d3bdc12-8e2e-44ae-885a-3cf1733caa46",
                                                "sense_id": "13aa0765-3370-361b-93c7-48f350ac49e3",
                                                "text": "Der Preis wird von der amerikanischen National Aeronautic Association (NAA) verwaltet und wird einmal im Jahr von der United States Air Force für den \"lobenswertesten Flug des Jahres\" (\"most meritorious flight of the year\") vergeben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
