                },
                {
                    "sense_id": "f2b8c0b5-0e28-3d94-83f3-be8d32f9c407",
                    "sense_definition": "Inclined to cause frustration or annoyance to others out of spite over minor grievances; small-minded and vindictive.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was very <w>petty</w> of him to eat the last cookie just so his sister could not have it.",
                            "target_lang_translations": {
                                "ru": "С его стороны было очень <w>мелочно</w> съесть последнее печенье только ради того, чтобы оно не досталось сестре.",
                                "cs": "Bylo od něj velmi <w>malicherné</w>, že snědl poslední sušenku jen proto, aby ji sestra neměla."
                            }
                        },
                        {
                            "text": "She decided to be the bigger person and ignore her colleague's <w>petty</w> comments.",
                            "target_lang_translations": {
                                "ru": "Она решила быть выше этого и игнорировать <w>мелочные</w> замечания коллеги.",
                                "cs": "Rozhodla se být nad věcí a ignorovat <w>malicherné</w> poznámky svého kolegy."
                            }
                        }
                    ],
                    "synonyms": [
                        "vindictive",
                        "mean",
                        "revengeful",
                        "grudging"
                    ],
                    "antonyms": [
                        "broad-minded"
                    ],
                    "common_phrases": [
