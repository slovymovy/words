    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "75db5749-42f5-3843-94f4-9463a0958afc",
                    "sense_definition": "A direct result, natural consequence, or secondary outcome of something else.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Increased stress is often an unfortunate <w>corollary</w> of rapid career advancement."
                        },
                        {
                            "text": "Finally getting that cracked window fixed was a pleasant <w>corollary</w> of redoing the whole storefront."
                        }
                    ],
                    "synonyms": [
                        "consequence",
                        "byproduct",
                        "result"
                    ],
                    "antonyms": [
                        "cause",
                        "precursor"
                    ],
                    "common_phrases": [
                        "natural corollary",
                        "inevitable corollary"
                    ]
                },
                {
                    "sense_id": "e0eaef49-16f0-3027-bc6c-9523ff0f5852",
                    "sense_definition": "A proposition or truth that follows with little or no proof from one already established.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "logic_math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an immediate <w>corollary</w> to the primary theorem, the angles must be equal."
                        },
                        {
                            "text": "We proved the initial lemma, and the subsequent <w>corollary</w> resolved the entire problem."
                        }
                    ],
                    "synonyms": [
                        "deduction",
                        "inference"
                    ],
                    "antonyms": [
                        "axiom",
                        "postulate"
                    ],
                    "common_phrases": [
                        "direct corollary"
                    ]
                },
                {
                    "sense_id": "80ca4c3a-7834-3a30-9b6c-cf6bdad240a8",
                    "sense_definition": "Something given beyond what is strictly due; an addition or surplus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small bonus served as a gracious <w>corollary</w> to their contractual fee."
                        },
                        {
                            "text": "He offered the extra vintage wine as an unexpected <w>corollary</w> to the meal."
                        }
                    ],
                    "synonyms": [
                        "gratuity",
                        "surplus"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage denoting an extra gift or surplus."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0dae3932-e84f-31a8-a04e-33db114cb22c",
                    "sense_definition": "Occurring as a natural consequence, accompaniment, or result; attendant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid expansion of the city brought many <w>corollary</w> problems in public transit."
                        },
                        {
                            "text": "Researchers had to navigate multiple administrative hurdles and <w>corollary</w> review processes."
                        }
                    ],
                    "synonyms": [
                        "consequential",
                        "attendant",
                        "accompanying"
                    ],
                    "antonyms": [
                        "antecedent"
                    ],
                    "common_phrases": [
                        "corollary effect",
                        "corollary result"
                    ]
                },
                {
                    "sense_id": "dceffec7-3a44-3617-b000-0dea5399bbdd",
                    "sense_definition": "Forming or relating to a proposition that follows logically from one already proved.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic_math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor presented a <w>corollary</w> argument derived directly from the fundamental theorem."
                        },
                        {
                            "text": "Each major mathematical proof is followed by several <w>corollary</w> statements."
                        }
                    ],
                    "synonyms": [
                        "deducible",
                        "inferential"
                    ],
                    "antonyms": [
                        "axiomatic"
                    ],
                    "common_phrases": [
                        "corollary proposition"
                    ]
                }
            ]
        }
    ]
