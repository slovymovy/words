                    "frequency": "High",
                    "semantic_group_id": "dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette piscine a deux mètres de <w>profondeur</w> dans sa partie la plus accessible."
                        },
                        {
                            "text": "Le plongeur a exploré le lac jusqu'à une <w>profondeur</w> impressionnante de quarante mètres."
                        }
