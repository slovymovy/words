                    "sense_id": "46a3ff55-1aed-304c-9a7d-357841b3167f",
                    "sense_definition": "Крупный и наиболее значимый православный мужской монастырь, подчиняющийся непосредственно патриарху.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы посетили старинную <w>лавру</w> во время нашего путешествия.",
                            "target_lang_translations": {
                                "en": "We visited an ancient <w>lavra</w> during our trip.",
                                "es": "Visitamos una antigua <w>lavra</w> durante nuestro viaje.",
                                "fr": "Nous avons visité une ancienne <w>lavra</w> pendant notre voyage."
                            }
                        },
                        {
                            "text": "Троице-Сергиева <w>лавра</w> является крупнейшим мужским монастырём.",
                            "target_lang_translations": {
                                "en": "The Trinity Lavra of St. Sergius is the largest male monastery.",
                                "es": "La <w>Lavra</w> de la Santísima Trinidad y San Sergio es el monasterio masculino más grande.",
                                "fr": "La <w>laure</w> de la Trinité-Saint-Serge est le plus grand monastère d'hommes."
                            }
                        }
                    ],
                    "synonyms": [
                        "монастырь"
                    ],
                    "common_phrases": [
                        "Троице-Сергиева лавра"
                    ],
                    "target_lang_definitions": {
                        "en": "A large and prestigious Orthodox male monastery directly under the authority of the Patriarch.",
                        "es": "Monasterio ortodoxo masculino de gran tamaño e importancia, subordinado directamente al patriarca.",
                        "fr": "Grand et très important monastère orthodoxe d'hommes, dépendant directement du patriarche."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lavra",
