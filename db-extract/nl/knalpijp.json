                    {
                        "sense_id": "ace7d746-e5e9-3204-888b-d22930a17caf",
                        "entry_id": "362804de-2722-3236-b12d-d4831dc5249b",
                        "glosses": [
                            "pijp die het geluid van een verbrandingsmotor dempt en de uitlaatgassen naar buiten geleid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e755a3b6-a830-4adc-99cc-fa56c88bd3fe",
                                "sense_id": "ace7d746-e5e9-3204-888b-d22930a17caf",
                                "text": "Maar een Nissan Micra die luidruchtiger is dan een Ferrari, alleen maar door een andere knalpijp? Kinderachtige onzin. Die sturen we ook bij Cars and Coffee, morgen hier op het Telegraaf-terrein, graag terug naar het schoolplein. Alle andere autoliefhebbers zijn van harte welkom"
                            },
                            {
                                "example_id": "a5140c85-4942-4848-a134-edbf38b9860b",
                                "sense_id": "ace7d746-e5e9-3204-888b-d22930a17caf",
                                "text": "Pruttelende knalpijpen, ratelende motortjes en piepende banden. Een tocht met een Solex geeft gegarandeerd veel bekijks."
                            }
                        ]
                    }
