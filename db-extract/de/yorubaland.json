                                "sense_id": "75248359-44d4-331a-86dd-e5c9c34097d3",
                                "text": "„Von Usen, nordwestlich von Benin-City, verliefen Handelsrouten ins Yorubaland, über Owo nach Nupe und über Akure nach Ottun, an der Grenze zu Oyo.“"
                            },
                            {
                                "example_id": "345ced0b-32c5-4e1e-8b2e-d489ba6be3d8",
                                "sense_id": "75248359-44d4-331a-86dd-e5c9c34097d3",
                                "text": "„›Aus welchem Teil von Yorubaland stammen Sie?‹, fragt mich der Chief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
