                    {
                        "sense_id": "622f46a6-a166-3e4c-89ba-5aaef319a890",
                        "entry_id": "f5ac6ab3-52c7-3d07-9203-f8f8295dd79c",
                        "glosses": [
                            "Féminin singulier de libérateur."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "ccc0ae4d-fad4-4ba0-b2da-dff8259bb93b",
                                "sense_id": "622f46a6-a166-3e4c-89ba-5aaef319a890",
                                "text": "Déconnaître, c’est déconner pour naître, se sortir du grand Con économique par une forte poussée hilarante, se désalambiquer d’un seul pet, à la faveur d’une décharge naïve et libératrice…"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5c630752-569e-3656-a0d6-3cd80924f0e2",
                "word": "libératrice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "add1add5-0e94-495f-b9ed-c3995c97e09e",
                        "entry_id": "5c630752-569e-3656-a0d6-3cd80924f0e2",
                        "tags": [
                            "plural"
                        ],
                        "form": "libératrices"
                    },
                    {
                        "form_id": "955faba7-7641-4c08-853d-66edfef05ebd",
                        "entry_id": "5c630752-569e-3656-a0d6-3cd80924f0e2",
                        "tags": [
                            "masculine"
                        ],
                        "form": "libérateur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "898a577c-65bc-3b2e-b737-beab3f73365c",
                        "entry_id": "5c630752-569e-3656-a0d6-3cd80924f0e2",
                        "glosses": [
                            "Celle qui libère une personne, une ville, un peuple, de la captivité, de la servitude ou de quelque grand péril."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18376b1a-09b0-49c7-bb20-f54f28fffa19",
                                "sense_id": "898a577c-65bc-3b2e-b737-beab3f73365c",
                                "text": "Plusieurs femmes ont inventé des arts très-utiles, d'autres ont été les libératrices de leur patrie, d'autres se sont distinguées par mille belles actions dont les hommes n'eussent pas été capables : on trouve par-tout des traits frappans de la sagesse et de la magnanimité des femmes."
                            },
                            {
                                "example_id": "63968f15-9206-4593-85bc-edecb4c44181",
                                "sense_id": "898a577c-65bc-3b2e-b737-beab3f73365c",
                                "text": "Tandis qu'elles, les libératrices du monde futur, portant l’étendard de l’affranchissement de la femme arabe de l’avenir, gravissaient avec majesté les marches."
                            },
                            {
                                "example_id": "fb17a8ca-3bb8-4fc1-a312-b6d9fbb09766",
                                "sense_id": "898a577c-65bc-3b2e-b737-beab3f73365c",
                                "text": "L'Europe entière a admiré l’'héroïsme du roi Sigismond et du prince Vladislas et leur vertu digne d’être célébrée éternellement par toutes les nations ; la république chrétienne regarde les armées polonaises comme les libératrices de l’univers et la verge des ennemis barbares."
                            },
                            {
                                "example_id": "0fda51e1-73d4-405f-bed0-64d6d2ff687b",
                                "sense_id": "898a577c-65bc-3b2e-b737-beab3f73365c",
                                "text": "Elle est rapidement devenue une favorite des sondages pour être surnommée la «libertadora» («libératrice»), en hommage au «libertador» Simon Bolivar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c2a7b4c-1865-45c8-a669-c28021b3dc56",
                        "source_entry_id": "5c630752-569e-3656-a0d6-3cd80924f0e2",
                        "source_sense_id": "898a577c-65bc-3b2e-b737-beab3f73365c",
                        "target_lang_word": "Befreierin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befreierin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1727161-9ece-341d-8b3b-7e8f65535394",
                                        "entry_id": "94798193-3d6e-3e1c-89c6-29c2bb26a17d",
                                        "glosses": [
                                            "weibliche Person oder grammatikalisch weibliche Organisation, die andere Personen in irgendeiner Weise befreit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1140b41d-84ed-4fd8-85fe-56a014179953",
                                                "sense_id": "f1727161-9ece-341d-8b3b-7e8f65535394",
                                                "text": "„Ekajati ist eine der mächtigsten und furchtbarsten Göttinnen in der tibetischen Mythologie. Sie erscheint häufig als Befreierin im Mandala der grünen Tara.“"
                                            },
                                            {
                                                "example_id": "60a27485-9306-4ffe-9b2c-00a28b4a340a",
                                                "sense_id": "f1727161-9ece-341d-8b3b-7e8f65535394",
                                                "text": "„Die Tat wird entdeckt, und die dadurch ermutigten Bethulier stürmen das Lager und preisen Judith als ihre Befreierin.“"
                                            },
                                            {
                                                "example_id": "dc341238-632d-4afc-a1b0-343f69a6a4bb",
                                                "sense_id": "f1727161-9ece-341d-8b3b-7e8f65535394",
                                                "text": "„Die SPÖ hatte das ihre stets durch den Verweis auf ihre historische Mission und Dimension als Befreierin der Arbeiterklasse zusammengehalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
