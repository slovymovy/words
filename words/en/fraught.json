{
    "word_family": [
        "freight"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "80d533b5-2182-33ed-9285-0cf1493aea9f",
                    "sense_definition": "Filled with or likely to result in something undesirable, such as danger, difficulties, or risks.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "filled_with",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journey through the mountains was <w>fraught</w> with danger.",
                            "target_lang_translations": {
                                "ru": "Путешествие через горы было <w>полно</w> опасностей.",
                                "pl": "Podróż przez góry była <w>pełna</w> niebezpieczeństw."
                            }
                        },
                        {
                            "text": "Implementing the new policy proved to be <w>fraught</w> with difficulties.",
                            "target_lang_translations": {
                                "ru": "Внедрение новой политики оказалось <w>чревато</w> трудностями.",
                                "pl": "Wdrożenie nowej polityki okazało się <w>obfitować w</w> trudności."
                            }
                        }
                    ],
                    "synonyms": [
                        "rife",
                        "freighted"
                    ],
                    "antonyms": [
                        "unfraught"
                    ],
                    "common_phrases": [
                        "fraught with danger",
                        "fraught with difficulty",
                        "fraught with risk",
                        "fraught with problems"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполненный чем-то нежелательным (опасностями, трудностями) или влекущий за собой риски.",
                        "pl": "Wypełniony czymś niepożądanym lub niosący ze sobą ryzyko wystąpienia trudności, niebezpieczeństw lub problemów."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чреватый",
                                "target_lang_sense_clarification": "влекущий за собой дурные последствия; используется с творительным падежом"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "содержащий что-либо в большом количестве (например, опасности)"
                            },
                            {
                                "target_lang_word": "преисполненный",
                                "target_lang_sense_clarification": "книжный стиль; наполненный чем-либо (обычно абстрактным)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pełen",
                                "target_lang_sense_clarification": "ogólne określenie na bycie wypełnionym czymś (np. niebezpieczeństwem)"
                            },
                            {
                                "target_lang_word": "narażony na",
                                "target_lang_sense_clarification": "w kontekście sytuacji, które mogą przynieść negatywne skutki"
                            },
                            {
                                "target_lang_word": "obfitujący w",
                                "target_lang_sense_clarification": "często używane w kontekście trudności lub problemów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e59fa114-c1d1-374d-a13a-07166ebd8a2e",
                    "sense_definition": "Causing or characterized by extreme tension, anxiety, or stress.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>fraught</w> silence in the room after the argument.",
                            "target_lang_translations": {
                                "ru": "После ссоры в комнате повисла <w>тягостная</w> тишина.",
                                "pl": "Po kłótni w pokoju zapanowała <w>napięta</w> cisza."
                            }
                        },
                        {
                            "text": "She had a <w>fraught</w> relationship with her family for many years.",
                            "target_lang_translations": {
                                "ru": "У неё много лет были <w>напряжённые</w> отношения с семьёй.",
                                "pl": "Przez wiele lat miała <w>napięte</w> relacje z rodziną."
                            }
                        }
                    ],
                    "synonyms": [
                        "wrought-up"
                    ],
                    "common_phrases": [
                        "fraught silence",
                        "fraught atmosphere",
                        "fraught relationship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий или характеризующийся сильным напряжением, тревогой или стрессом.",
                        "pl": "Powodujący lub charakteryzujący się silnym napięciem, niepokojem lub stresem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напряжённый",
                                "target_lang_sense_clarification": "о ситуации, атмосфере или отношениях"
                            },
                            {
                                "target_lang_word": "тягостный",
                                "target_lang_sense_clarification": "мучительный, вызывающий чувство тяжести (например, о тишине)"
                            },
                            {
                                "target_lang_word": "тревожный",
                                "target_lang_sense_clarification": "выражающий волнение или беспокойство"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "napięty",
                                "target_lang_sense_clarification": "o relacjach, atmosferze lub sytuacji pełnej stresu"
                            },
                            {
                                "target_lang_word": "pełen napięcia",
                                "target_lang_sense_clarification": "opisujący stan emocjonalny lub atmosferę"
                            },
                            {
                                "target_lang_word": "nerwowy",
                                "target_lang_sense_clarification": "o sytuacji lub zachowaniu wywołującym niepokój"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3c7d286-4c04-3148-98f0-3ff2db153a6f",
                    "sense_definition": "Physically laden or loaded with cargo, typically referring to a ship or vessel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "filled_with",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant ship arrived <w>fraught</w> with spices and silks.",
                            "target_lang_translations": {
                                "ru": "Торговое судно прибыло, <w>нагруженное</w> специями и шелками.",
                                "pl": "Statek handlowy przybył <w>załadowany</w> przyprawami i jedwabiami."
                            }
                        },
                        {
                            "text": "A vessel <w>fraught</w> with gold was lost at sea.",
                            "target_lang_translations": {
                                "ru": "Корабль, <w>гружёный</w> золотом, пропал в море.",
                                "pl": "Statek <w>obciążony</w> złotem zatonął na morzu."
                            }
                        }
                    ],
                    "synonyms": [
                        "freighted"
                    ],
                    "antonyms": [
                        "unfreighted"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически нагруженный или заполненный грузом (обычно о судне); устаревшее значение.",
                        "pl": "Fizycznie załadowany lub wypełniony towarem, zazwyczaj w odniesieniu do statku; znaczenie przestarzałe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагруженный",
                                "target_lang_sense_clarification": "заполненный грузом"
                            },
                            {
                                "target_lang_word": "гружёный",
                                "target_lang_sense_clarification": "несущий на себе груз"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "załadowany",
                                "target_lang_sense_clarification": "o statku lub pojeździe wypełnionym towarem"
                            },
                            {
                                "target_lang_word": "obciążony",
                                "target_lang_sense_clarification": "o statku, który przewozi ciężki ładunek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}