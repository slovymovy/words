                "senses": [
                    {
                        "sense_id": "5c6bc520-4256-3ddc-aa45-584c6a9512a6",
                        "entry_id": "458620e2-9c51-36fa-8ca2-96e38bc72935",
                        "glosses": [
                            "Vorgabe, nach der (bestimmte) Hunde in der Öffentlichkeit einen Beißkorb (Maulkorb) tragen müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf29d618-0453-4d6f-80cc-2cafed6759e2",
                                "sense_id": "5c6bc520-4256-3ddc-aa45-584c6a9512a6",
                                "text": "„Die generelle Beißkorbpflicht sowie die Leinenpflicht für Listenhunde kommt.“"
                            },
                            {
                                "example_id": "be1bbd1c-fc51-46ab-b691-de95f8ef7810",
                                "sense_id": "5c6bc520-4256-3ddc-aa45-584c6a9512a6",
                                "text": "„Die Vier Pfoten plädieren daher für einen verpflichtenden Hundeführschein für alle Hundehalter, nicht nur für die Halter von Listenhunden. In Einzelfällen könne ja immer eine Beißkorbpflicht verordnet werden.“"
                            },
                            {
                                "example_id": "bb89d1f4-82d3-4f24-b097-6959e6b655ff",
                                "sense_id": "5c6bc520-4256-3ddc-aa45-584c6a9512a6",
                                "text": "„Nach dem tödlichen Biss eines Rottweilers in Wien sprach sich Landesrat Gottfried Waldhäusl (FPÖ) am Dienstag für eine generelle Beißkorbpflicht in Niederösterreich aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
