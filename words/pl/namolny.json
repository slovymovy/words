    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d123d790-6750-389e-9a4b-1daf717d7406",
                    "sense_definition": "narzucający się komuś swoją obecnością lub żądaniami w sposób uciążliwy i trudny do zbycia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "natręctwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten <w>namolny</w> sprzedawca dzwonił do mnie już trzy razy w tym tygodniu.",
                            "target_lang_translations": {
                                "ru": "Этот <w>навязчивый</w> продавец звонил мне уже три раза на этой неделе."
                            }
                        },
                        {
                            "text": "Musieliśmy szybko zmienić lokal, bo podszedł do nas wyjątkowo <w>namolny</w> klient.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось быстро сменить заведение, потому что к нам подошел исключительно <w>приставучий</w> клиент."
                            }
                        }
                    ],
                    "synonyms": [
                        "nachalny",
                        "natarczywy",
                        "natrętny",
                        "upierdliwy"
                    ],
                    "common_phrases": [
                        "namolny sprzedawca",
                        "namolne prośby"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie osoby narzucającej się"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "навязчивый, надоедливый, пристающий к кому-либо со своим присутствием или просьбами так, что от него трудно отделаться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навязчивый",
                                "target_lang_sense_clarification": "о человеке, навязывающем свое общение"
                            },
                            {
                                "target_lang_word": "надоедливый",
                                "target_lang_sense_clarification": "пристающий, докучливый"
                            },
                            {
                                "target_lang_word": "приставучий",
                                "target_lang_sense_clarification": "разговорное; о человеке"
                            },
                            {
