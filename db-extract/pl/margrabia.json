                "senses": [
                    {
                        "sense_id": "99720014-672c-3af2-a6ad-07e1881ff8ea",
                        "entry_id": "9264aa4c-8e41-3f9a-940d-e88975597143",
                        "glosses": [
                            "w średniowieczu: zwierzchnik marchii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b70cac9-e9cc-4f26-891f-3339b19d291a",
                                "sense_id": "99720014-672c-3af2-a6ad-07e1881ff8ea",
                                "text": "Margrabiowie brandenburscy dla poskromienia buty polskiej zamordowali w niem skrytobójczo króla polskiego Przemysława, który od nich odzyskał Pomorze dla Polski."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68808063-ee5a-465e-93c5-545b589a4724",
                        "source_entry_id": "9264aa4c-8e41-3f9a-940d-e88975597143",
                        "source_sense_id": "99720014-672c-3af2-a6ad-07e1881ff8ea",
                        "target_lang_word": "margrave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "margrave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02322788-544d-30cb-a3bb-c088070d4b2b",
                                        "entry_id": "7e812112-f551-353b-88f8-485efacc7381",
                                        "glosses": [
                                            "A feudal era military-administrative officer of comital rank in the Carolingian empire and some successor states, originally in charge of a border area."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3732f520-ddab-453c-bede-218b00e1bb34",
                                                "sense_id": "02322788-544d-30cb-a3bb-c088070d4b2b",
                                                "text": "1973: Among pulverised heads of stone margraves and electors, reconnoitering a likely-looking cabbage patch, all of a sudden Slothrop picks up the scent of an unmistakable no it can’t be yes it is it’s a REEFER! — Thomas Pynchon, Gravity’s Rainbow"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fc9a936-0470-3d55-852b-0ab29e79a713",
                                        "entry_id": "7e812112-f551-353b-88f8-485efacc7381",
                                        "glosses": [
                                            "A hereditary ruling prince in certain feudal states of the Holy Roman Empire and elsewhere; the titular equivalent became known as marquis or marquess."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c6c578f-192e-4e23-8ff7-f87604e3b569",
                                                "sense_id": "2fc9a936-0470-3d55-852b-0ab29e79a713",
                                                "text": "The Margrave of Bruges was their head."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3812ed9-11b1-4660-a617-3e35a3ce4d13",
                        "source_entry_id": "9264aa4c-8e41-3f9a-940d-e88975597143",
                        "source_sense_id": "99720014-672c-3af2-a6ad-07e1881ff8ea",
                        "target_lang_word": "margrave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "margrave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc97d13-3eb7-311c-8944-049ea0229c66",
                                        "entry_id": "6791be03-f3e8-3392-953b-131f4431e7f3",
                                        "glosses": [
                                            "Titre donné autrefois à quelques princes souverains, en Allemagne et en Autriche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d072805f-7d93-44e6-8877-b8aeeeebc8b3",
                                                "sense_id": "8cc97d13-3eb7-311c-8944-049ea0229c66",
                                                "text": "…, le jeune comte Ludwig de Godesberg, âgé de dix-huit ans alors, fut fiancé à la petite Emma de Ronsdorf, qui n’en avait encore que dix : seulement il fut convenu entre le vieux margrave et la douairière que les fiancés attendraient cinq ans encore avant d’être époux."
                                            },
                                            {
                                                "example_id": "57516e21-ec42-45a3-943c-7bc24f413250",
                                                "sense_id": "8cc97d13-3eb7-311c-8944-049ea0229c66",
                                                "text": "Or, en juin, la Lusace, en août, les Moraves, Font la fête du trône et sacrent leurs margraves; C'est aujourd'hui le jour du burg mystérieux; Mahaud viendra ce soir souper chez ses aïeux."
                                            },
                                            {
                                                "example_id": "53ecf76c-cb02-46a0-bdc1-3fbc4dd038de",
                                                "sense_id": "8cc97d13-3eb7-311c-8944-049ea0229c66",
                                                "text": "Être la clef de voûte, et voir sous soi rangés / Les rois, et sur leur tête essuyer ses sandales ; / Voir au-dessous des rois les maisons féodales, / Margraves, cardinaux, doges, ducs à fleurons ; / Puis, évêques, abbés, chefs de clans, hauts barons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45514c98-5dbd-4def-ba37-b187ea4d39f9",
                        "source_entry_id": "9264aa4c-8e41-3f9a-940d-e88975597143",
                        "source_sense_id": "99720014-672c-3af2-a6ad-07e1881ff8ea",
                        "target_lang_word": "margrave",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5b1a746a-6ed3-4b85-af43-f821bbd2ebaf",
                        "source_entry_id": "9264aa4c-8e41-3f9a-940d-e88975597143",
                        "source_sense_id": "99720014-672c-3af2-a6ad-07e1881ff8ea",
                        "target_lang_word": "Markgraf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Markgraf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baaf7b71-26d7-3600-8195-043128f45df7",
                                        "entry_id": "5f11e89a-8bee-36d2-8a48-38b09aaba86b",
                                        "glosses": [
                                            "Befehlshaber eines Grenzgebiets, einer sogenannten Mark, mit bestimmten Rechten"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78fa0f3b-04fa-4c65-8f9a-1ed322696119",
                                                "sense_id": "baaf7b71-26d7-3600-8195-043128f45df7",
                                                "text": "„Die askanischen Markgrafen befanden sich, wie erst in Zeugnissen des 13. Jahrhunderts in Erscheinung tritt, im Besitz des Reichsamtes des Erzkämmerers.“"
                                            },
                                            {
                                                "example_id": "9dbd5d47-cc94-4c10-bb96-ee21fc86cb35",
                                                "sense_id": "baaf7b71-26d7-3600-8195-043128f45df7",
                                                "text": "„Die Nürnberger wiederum gewannen im Landshuter Krieg erhebliches Gebiet, was die Auseinandersetzungen mit den Markgrafen, mit denen die Reichsstadt seit Generationen im Streit lag, weiter verschärfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
