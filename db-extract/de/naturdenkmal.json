                                        "entry_id": "8ff7833b-bdfc-3cc2-b0e9-2b2c143eab07",
                                        "glosses": [
                                            "zoals een monument een gebouw is dat de moeite waard is om beschermd te worden zo is een natuurmonument een natuurgebied dat zo bijzonder is dat het de moeite waard is beschermd te worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07feabfe-8f61-4fb6-960e-b290de6e059f",
                                                "sense_id": "f50e15e9-eafa-318a-bd34-7b17521167b5",
                                                "text": "In Nederland is een natuurmonument een natuurgebied dat als zodanig is aangewezen door de Natuurbeschermingswet."
                                            },
                                            {
                                                "example_id": "212ee51d-30ef-4e6a-baa7-c42c244e5c77",
                                                "sense_id": "f50e15e9-eafa-318a-bd34-7b17521167b5",
                                                "text": "De Vereniging ter behoud van Natuurmonumenten in Nederand is actief in de bescherming van natuurgebieden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
