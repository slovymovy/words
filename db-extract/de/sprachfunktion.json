                ],
                "senses": [
                    {
                        "sense_id": "daec8afd-be3d-330d-b948-6ac65fa0e21c",
                        "entry_id": "5d9f37b0-0e07-31a0-8e19-0712808a2079",
                        "glosses": [
                            "Linguistik: Gesamtheit der verschiedenen Leistungen, die die Sprache dem Menschen erbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ed9107b-7488-4e41-b3c0-133baf063153",
                                "sense_id": "daec8afd-be3d-330d-b948-6ac65fa0e21c",
                                "text": "In Bühlers Organon-Modell werden drei Sprachfunktionen unterschieden: Ausdruck (Selbstpreisgabe), Appell (Hinwendung zum Hörer), Darstellung (Information über einen Gesprächsgegenstand)."
                            },
                            {
                                "example_id": "0250bb1f-99ab-4be2-9dfb-9bc33264543c",
                                "sense_id": "daec8afd-be3d-330d-b948-6ac65fa0e21c",
                                "text": "Wer spricht, vollzieht diese Sprachfunktionen, ob er will oder nicht."
                            },
                            {
                                "example_id": "b5db7f93-2103-49e6-a155-ceb781d9b440",
                                "sense_id": "daec8afd-be3d-330d-b948-6ac65fa0e21c",
                                "text": "Modelle für Sprachfunktionen haben etliche Linguisten entwickelt."
                            },
                            {
                                "example_id": "ffa8dd1f-15ea-4bbd-b494-e99dc0cd77f7",
                                "sense_id": "daec8afd-be3d-330d-b948-6ac65fa0e21c",
                                "text": "„Gliedernde Gesichtspunkte sucht man durch die Darlegung der Sprachfunktion…zu gewinnen…“"
                            },
                            {
                                "example_id": "98f4c8a3-2615-4025-8df2-13d62c552e22",
                                "sense_id": "daec8afd-be3d-330d-b948-6ac65fa0e21c",
                                "text": "„Jede sprachliche Äußerung ist nun dadurch gekennzeichnet, daß eine der Sprachfunktionen in den Vordergrund tritt, ohne jedoch die anderen gänzlich zu verdrängen.“"
                            },
                            {
                                "example_id": "595770a8-6372-469a-87b7-c84defcf853e",
                                "sense_id": "daec8afd-be3d-330d-b948-6ac65fa0e21c",
                                "text": "„Kainz unterscheidet zwischen primären oder elementaren Sprachfunktionen – diese werden in dialogische und monologische unterteilt –, und sekundären Sprachfunktionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
