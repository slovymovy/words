                        "examples": [
                            {
                                "example_id": "40a5947e-aaee-4407-a0e9-a9cc22cf7925",
                                "sense_id": "4778e49a-2564-3a13-bbc3-305c66702081",
                                "text": "Ze volgde blindelings de aanwijzingen van dat idiote lievelingsboek van haar op, dat Frederik nooit had gelezen omdat alleen de titels van de hoofdstukken hem al deden kokhalzen: 'Moraal is voor de zwakken', 'De kosten-batenbalans van gevoelens'."
                            },
                            {
                                "example_id": "c0a67194-31d7-4193-ae27-f758f53886d7",
                                "sense_id": "4778e49a-2564-3a13-bbc3-305c66702081",
                                "text": "De nederlaag van de sterken door de hand van de zwakken maakte Rey Diaz tot een held van de eenentwintigste eeuw."
                            }
                        ]
                    }
