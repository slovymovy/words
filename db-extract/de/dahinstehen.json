                        "examples": [
                            {
                                "example_id": "ae4a76ba-be7f-4fc8-9515-4bac9a2f571d",
                                "sense_id": "b63c1025-96f0-3517-aeae-d1d565b4f92f",
                                "text": "Wer von beiden angefangen hat, mag dahinstehen."
                            },
                            {
                                "example_id": "912760a0-9335-4c25-8178-8d148b8ba836",
                                "sense_id": "b63c1025-96f0-3517-aeae-d1d565b4f92f",
                                "text": "Ob das jetzt eher von Vorteil oder von Nachteil ist, steht dahin."
                            },
                            {
                                "example_id": "296bb211-8d67-4c32-a7a1-0f48ca9bbd77",
                                "sense_id": "b63c1025-96f0-3517-aeae-d1d565b4f92f",
                                "text": "Ob man hätte anders beschließen können, blieb dahingestanden."
                            },
                            {
                                "example_id": "efb21a21-bec2-451e-9fde-5af1bd94f685",
                                "sense_id": "b63c1025-96f0-3517-aeae-d1d565b4f92f",
                                "text": "Man hatte sich wieder vertragen, für wie lange stand dahin."
                            },
                            {
                                "example_id": "9d740649-b303-4966-8437-5e4fcb1ee95b",
                                "sense_id": "b63c1025-96f0-3517-aeae-d1d565b4f92f",
                                "text": "Sollte aber, was noch dahinsteht, die Familie nachkommen, sieht es anders aus."
                            },
                            {
                                "example_id": "c9effb06-b2fa-41d2-ade9-4cf6eef1c3a6",
                                "sense_id": "b63c1025-96f0-3517-aeae-d1d565b4f92f",
                                "text": "Wobei dahinstehen kann, ob das auch relevant ist."
                            }
                        ],
