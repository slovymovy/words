    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0448b62d-30d9-322c-aab9-a67f2edbba89",
                    "sense_definition": "iemand fysieke of mentale pijn, verdriet of grote ergernis bezorgen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pijn_bezorgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gedachte aan zijn fout <w>kwelde</w> hem al vele jaren.",
                            "target_lang_translations": {
                                "en": "The thought of his mistake <w>tormented</w> him for many years."
                            }
                        },
                        {
                            "text": "Zij wilde haar broertje niet langer <w>kwellen</w> met die nare opmerkingen.",
                            "target_lang_translations": {
                                "en": "She didn't want to <w>pester</w> her little brother with those nasty remarks any longer."
                            }
                        }
                    ],
                    "synonyms": [
                        "pijnigen",
                        "teisteren",
                        "martelen",
                        "plagen"
                    ],
                    "antonyms": [
                        "troosten",
                        "verlichten"
                    ],
                    "common_phrases": [
                        "iemand kwellen",
                        "zichzelf kwellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause someone physical or mental pain, sorrow, or great annoyance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "torment",
                                "target_lang_sense_clarification": "to cause severe mental or physical suffering"
                            },
                            {
                                "target_lang_word": "plague",
                                "target_lang_sense_clarification": "to cause continual trouble or distress"
                            },
                            {
                                "target_lang_word": "torture",
                                "target_lang_sense_clarification": "to cause great mental or physical pain"
                            },
                            {
                                "target_lang_word": "vex",
                                "target_lang_sense_clarification": "to cause mental suffering or distress"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "babf0f55-bfdf-3c43-b71d-8f3c1ead93bc",
                    "sense_definition": "op een irritante manier lastigvallen of treiteren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pijn_bezorgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De muggen <w>kwellen</w> de kampeerders de hele nacht door.",
                            "target_lang_translations": {
                                "en": "The mosquitoes <w>plagued</w> the campers all night long."
                            }
                        },
                        {
                            "text": "Het is niet aardig om die oude man zo te <w>kwellen</w>.",
                            "target_lang_translations": {
                                "en": "It is not kind to <w>harass</w> that old man like that."
                            }
                        }
                    ],
                    "synonyms": [
                        "pesten",
                        "treiteren",
                        "lastigvallen"
                    ],
                    "antonyms": [
                        "helpen"
                    ],
                    "common_phrases": [
                        "iemand mateloos kwellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To bother, harass, or tease someone in an irritating way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pester",
                                "target_lang_sense_clarification": "to trouble or annoy with frequent interruptions"
                            },
                            {
                                "target_lang_word": "harass",
                                "target_lang_sense_clarification": "to subject to aggressive pressure or intimidation"
                            },
                            {
                                "target_lang_word": "tease",
                                "target_lang_sense_clarification": "to provoke or make fun of someone"
                            },
                            {
                                "target_lang_word": "vex",
                                "target_lang_sense_clarification": "to annoy or irritate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2504d233-0d53-3a7a-9c17-c317df0b0796",
                    "sense_definition": "het langzaam naar boven komen of doorsijpelen van water uit de bodem",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "water_stroming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er begon langzaam wat grondwater door de tegels te <w>kwellen</w>.",
                            "target_lang_translations": {
                                "en": "Some groundwater slowly began to <w>seep</w> through the tiles."
                            }
                        },
                        {
                            "text": "Het water <w>kwelde</w> onder de dijk door naar het lagere land.",
                            "target_lang_translations": {
                                "en": "The water <w>welled up</w> from under the dike to the lower land."
                            }
                        }
                    ],
                    "synonyms": [
                        "opwellen",
                        "doorsijpelen"
                    ],
                    "common_phrases": [
                        "water kwellen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in de context van waterbeheer"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The slow upward movement or seepage of water from the ground."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seep",
                                "target_lang_sense_clarification": "to flow or leak slowly through porous material"
                            },
                            {
                                "target_lang_word": "well up",
                                "target_lang_sense_clarification": "to rise to the surface"
                            },
                            {
                                "target_lang_word": "ooze",
                                "target_lang_sense_clarification": "to slowly trickle or discharge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b673d40b-29af-3947-aeb0-bd7aa0a22808",
                    "sense_definition": "door opname van vocht in omvang toenemen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "water_stroming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de aanhoudende regen begon het hout van de deur te <w>kwellen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the persistent rain, the wood of the door began to <w>swell</w>."
                            }
                        },
                        {
                            "text": "De bonen moeten eerst een nacht in water <w>kwellen</w> voordat je ze kookt.",
                            "target_lang_translations": {
                                "en": "The beans must first <w>soak</w> in water for a night before you cook them."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwellen",
                        "uitzetten"
                    ],
                    "antonyms": [
                        "krimpen"
                    ],
                    "common_phrases": [
                        "laten kwellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To increase in size or volume by absorbing moisture."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swell",
                                "target_lang_sense_clarification": "to become larger or rounder in size"
                            },
                            {
                                "target_lang_word": "soak",
                                "target_lang_sense_clarification": "to leave something in liquid to absorb it"
                            },
                            {
                                "target_lang_word": "expand",
                                "target_lang_sense_clarification": "to become larger in range or volume"
                            }
                        ]
                    }
                }
            ]
        }
    ]
