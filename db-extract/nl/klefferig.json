                "senses": [
                    {
                        "sense_id": "3681cadc-ffd2-3966-a79c-bc32f2a31432",
                        "entry_id": "c4df5002-53b3-3823-8886-25430b36dbd1",
                        "glosses": [
                            "plakkerig, zacht en vochtig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3470ad3-9a4f-4bdd-a8d3-c33f0af3e5df",
                                "sense_id": "3681cadc-ffd2-3966-a79c-bc32f2a31432",
                                "text": "Oei, wat een moeilijke vraag zo zonder uw recept te kennen. Ik kan alleen een paar dingen in het algemeen zeggen. Melk en boter maken het deeg zachter en kleffer, dus minder droog. Misschien moet u meer een soort brioche-deeg maken als u zachter brood wilt. Van sommige ervaren bakkers hoor ik: een theelepeltje smakeloze honing (zodat die niet overheerst) houdt het brood ook zachter."
                            }
                        ]
                    },
                    {
                        "sense_id": "69d17ee8-69fb-37b1-b124-9663de091fa4",
                        "entry_id": "c4df5002-53b3-3823-8886-25430b36dbd1",
                        "glosses": [
                            "op een onprettige manier te intiem of emotioneel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "616f3f7e-8cf5-4654-8d04-c477900eeb18",
                                "sense_id": "69d17ee8-69fb-37b1-b124-9663de091fa4",
                                "text": "Het wordt kleffer en kinderachtiger. De oorlogjes worden nu per brief uitgevochten. Cruijff spreekt van een boek. En aan lezen heeft hij een hekel."
                            },
                            {
                                "example_id": "5612e898-6e60-4f16-b698-3dc04ee917d3",
                                "sense_id": "69d17ee8-69fb-37b1-b124-9663de091fa4",
                                "text": "Van der Kooy liet het instrument van Sauer fluisteren. Uiterst behendig ging het van Dunkel zum Licht, zonder klefferig gedoe."
                            }
                        ]
                    }
