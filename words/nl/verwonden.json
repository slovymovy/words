    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a66d567-9ab2-31e9-900c-333bb4801b54",
                    "sense_definition": "lichamelijk letsel of een wond toebrengen aan iemand of iets",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "letsel toebrengen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De scherpe glasscherven op de vloer kunnen je voeten ernstig <w>verwonden</w>.",
                            "target_lang_translations": {
                                "en": "The sharp shards of glass on the floor can seriously <w>injure</w> your feet."
                            }
                        },
                        {
                            "text": "Een losgeraakte tak viel naar beneden en <w>verwondde</w> de wandelaar aan zijn schouder.",
                            "target_lang_translations": {
                                "en": "A loose branch fell down and <w>injured</w> the hiker's shoulder."
                            }
                        }
                    ],
                    "synonyms": [
                        "blesseren",
                        "kwetsen"
                    ],
                    "antonyms": [
                        "genezen",
                        "helen"
                    ],
                    "common_phrases": [
                        "ernstig verwonden",
                        "dodelijk verwonden"
                    ],
                    "target_lang_definitions": {
                        "en": "to inflict physical harm, injury, or a wound on someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "injure",
                                "target_lang_sense_clarification": "to cause physical harm or damage"
                            },
                            {
                                "target_lang_word": "wound",
                                "target_lang_sense_clarification": "to inflict a physical wound, cut, or laceration"
                            },
                            {
                                "target_lang_word": "hurt",
                                "target_lang_sense_clarification": "to cause physical pain or injury"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc9818f2-40ff-3d4f-bee3-4de2aeb5ffac",
                    "sense_definition": "lichamelijk letsel of een wond bij zichzelf veroorzaken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "letsel toebrengen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pas op met dat scherpe mes, anders <w>verwond</w> je je nog.",
                            "target_lang_translations": {
                                "en": "Be careful with that sharp knife, or you'll <w>cut yourself</w>."
                            }
                        },
                        {
                            "text": "Tijdens de val van de trap <w>verwondde</w> het kind zich aan de knie.",
                            "target_lang_translations": {
                                "en": "During the fall down the stairs, the child <w>injured</w> their knee."
                            }
                        }
                    ],
                    "synonyms": [
                        "zich bezeren",
                        "zich blesseren"
                    ],
                    "common_phrases": [
                        "zich ernstig verwonden"
                    ],
                    "target_lang_definitions": {
                        "en": "to inflict bodily injury or a wound upon oneself"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "injure oneself",
                                "target_lang_sense_clarification": "to accidentally cause oneself bodily harm"
                            },
                            {
                                "target_lang_word": "hurt oneself",
                                "target_lang_sense_clarification": "to cause oneself pain or injury"
                            },
                            {
                                "target_lang_word": "cut oneself",
                                "target_lang_sense_clarification": "to accidentally wound oneself with a sharp object"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4b9e67d-676d-319b-a676-8bfaf1ae8a97",
                    "sense_definition": "meervoud verleden tijd van <w>verwinden</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verwinden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het zware verlies <w>verwonden</w> zij hun verdriet slechts met grote moeite.",
                            "target_lang_translations": {
                                "en": "After the heavy loss, they <w>overcame</w> their grief only with great difficulty."
                            }
                        },
                        {
                            "text": "De dorpelingen <w>verwonden</w> de tegenslagen van de strenge winter wonderwel snel.",
                            "target_lang_translations": {
                                "en": "The villagers <w>got over</w> the hardships of the harsh winter surprisingly quickly."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verleden tijd meervoud"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "verouderde vorm van een weinig frequent werkwoord"
                        }
                    ],
                    "target_lang_definitions": {
