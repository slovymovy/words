                        "glosses": [
                            "Of, pertaining to, or exhibiting hypergamy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3402dd9-2334-4455-a307-be6a3c5030a4",
                                "sense_id": "0471a6ec-f16f-3740-a9bb-460ee9a35b34",
                                "text": "This is, in fact, an issue on which modern anthropologists have been divided, particularly among those north Indians who are held to practise hypergamous 'upward' marriage."
                            },
                            {
                                "example_id": "8e630827-7ebe-436e-b096-f8736b8d0d1a",
                                "sense_id": "0471a6ec-f16f-3740-a9bb-460ee9a35b34",
                                "text": "Readers can't help siding with Jane's heroines, so sympathetically portrayed in their efforts to get the right man, whereas Becky Sharp may well represent male distrust of scheming hypergamous females."
                            },
                            {
                                "example_id": "25e150d8-c7b2-4f81-8209-eaa70ba9a163",
                                "sense_id": "0471a6ec-f16f-3740-a9bb-460ee9a35b34",
                                "text": "Some Chinese citizens even praised male Chinese citizens they knew for having enough status, wealth, charm, and good looks to attract non-Chinese women, who were presumed to desire the same hypergamous relationships that Chinese women were presumed to desire."
                            }
                        ]
                    }
