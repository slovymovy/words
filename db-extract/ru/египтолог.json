                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ägyptologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                                        "entry_id": "c8109e84-3f1c-39ce-87dd-1bee07783ff3",
                                        "glosses": [
                                            "Fachmann beziehungsweise Wissenschaftler auf dem Gebiet der Ägyptologie, der Erforschung des Alten Ägyptens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9550fe48-6dc3-48cd-a70c-df4e39ad358d",
                                                "sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                                                "text": "„Ich war auch bei der Ankunft in bester Stimmung, durch ein Gespräch, das ich in letzter Minute mit einem Ägyptologen gehabt hatte, der bei uns als Nachtbote arbeiten wollte.“"
                                            },
                                            {
                                                "example_id": "992e1172-bfcf-4834-ac8c-96dead051be1",
                                                "sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                                                "text": "„Auch an der Universität Wien blickt die Afrikanistik auf eine große Tradition zurück, die 1873 mit dem Ägyptologen Leo Reinisch einsetzte.“"
                                            },
                                            {
                                                "example_id": "4eefdf51-be49-4c1a-be99-33e7ec374728",
                                                "sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                                                "text": "„Als erster ließ er mit Hilfe von Ägyptologen Stempel für Hieroglyphen schneiden, ca. 1500 Zeichen - ein deutlicher Impuls für die Ägyptologie.“"
                                            },
                                            {
                                                "example_id": "acfeb149-1bc1-44de-8aee-8491c4720d68",
                                                "sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                                                "text": "„Diesmal hat der Schreiber kein Mitleid mit ungeübten Ägyptologen und stellt uns ein Bein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
