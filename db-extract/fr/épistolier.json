                "senses": [
                    {
                        "sense_id": "c3d6eb92-89f7-3c7f-8e07-4cf6585b4a04",
                        "entry_id": "24a86899-b2e6-30f8-9f14-cb1a47cc2882",
                        "glosses": [
                            "Qui concerne la correspondance par lettres, relatif à l’écriture des lettres, à la manière de les écrire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3377fea7-b32f-4c05-acc7-00ac5f491c8d",
                                "sense_id": "c3d6eb92-89f7-3c7f-8e07-4cf6585b4a04",
                                "text": "Mais les séparations étaient aussi l’occasion de bombardements épistoliers, avec, certains jours, rafales de lettres incroyablement détaillées, semées de noms inconnus que je déchiffrais à grand-peine."
                            }
                        ]
                    }
                ],
