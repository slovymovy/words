                                    },
                                    {
                                        "sense_id": "7edcafeb-c116-3e86-8d8e-49d8dcdef81b",
                                        "entry_id": "46882e63-4bf4-37d4-a33b-da8fc3967799",
                                        "glosses": [
                                            "Zunahme an Umfang, Größe, Menge, Intensität von etwas"
                                        ],
