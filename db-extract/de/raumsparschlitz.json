                "senses": [
                    {
                        "sense_id": "61e7fb8d-842e-3c00-8e2d-1e0a6fa5a608",
                        "entry_id": "6c98ab71-bba0-347e-8748-9e40e4336d96",
                        "glosses": [
                            "Aussparung bei Aktenordnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c3795c-cee4-4c66-9538-8ebf8f29cce5",
                                "sense_id": "61e7fb8d-842e-3c00-8e2d-1e0a6fa5a608",
                                "text": "„Zum Ordner gehören aber auch zwingend ein Rückenschild, ein Griffloch, ein Klemmbügel, zwei »Raumsparschlitze« und ein Ringsystem, das je nach Land von Zweiloch- bis Vierloch variiert.“"
                            },
                            {
                                "example_id": "d9e9b418-e224-45c4-b131-f89b7072f58f",
                                "sense_id": "61e7fb8d-842e-3c00-8e2d-1e0a6fa5a608",
                                "text": "„Tasche nach einem der Ansprüche 1 bis 14, dadurch gekennzeichnet, dass der erste Aktenordnerdeckel (2) zwei Raumsparschlitze (2e) aufweist, wobei ein Band (8) aus einem flexiblen Material von einem zu dem anderen Raumsparschlitz (2e) geführt ist.“"
                            },
                            {
                                "example_id": "d4a6cc4c-f295-41bf-82c3-0cbed26e25bd",
                                "sense_id": "61e7fb8d-842e-3c00-8e2d-1e0a6fa5a608",
                                "text": "„Das Griffloch am Rücken wurde 1911 eingeführt; später kamen für die Bügel im Innern die Raumsparschlitze in der Deckelvorderseite hinzu, die traditionell mit Wolkenmarmorpapier bezogen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
