                        "glosses": [
                            "The state of being disorganized"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "da27c7dd-1081-482b-8977-f1466f611a84",
