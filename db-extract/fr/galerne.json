                "entry_id": "6c4dc6d2-eec6-3bb9-b711-46550ddf958e",
                "word": "galerne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "645fbab5-73a3-480c-9a81-fbe4a074c119",
                        "entry_id": "6c4dc6d2-eec6-3bb9-b711-46550ddf958e",
                        "tags": [
