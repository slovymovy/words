                        "entry_id": "5cca179e-dd87-3db0-8311-1476b4b1e761",
                        "glosses": [
                            "Sonate courte et légère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b65ce18-8551-4164-bfbb-7adbdfec9b45",
                                "sense_id": "1d8f5c08-cdab-32c2-bf18-9dff77b94c1b",
                                "text": "Le genre musical japonais par excellence : la sonatine. Clementi l’Orphée des familles (d’autant plus que les japonais trouvent une sorte d’ivresse dans la correction)."
                            },
                            {
                                "example_id": "4136d94a-e089-42cb-be77-8c113dd50e47",
                                "sense_id": "1d8f5c08-cdab-32c2-bf18-9dff77b94c1b",
                                "text": "L’enfant recommença à jouer la sonatine de Diabelli."
                            }
                        ]
                    }
