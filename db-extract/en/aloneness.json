                                        "sense_id": "f5ccd35e-9db7-3990-985a-df5cc8cd5101",
                                        "entry_id": "7af6214c-318f-3f52-bb0e-9b5cdbd33aa4",
                                        "glosses": [
                                            "momentaneo isolamento, anche pacifico tra sé e sé"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be449450-0880-4ddc-ba65-9125507ac53d",
                                                "sense_id": "f5ccd35e-9db7-3990-985a-df5cc8cd5101",
                                                "text": "beh, un po' di solitudine qualche volta..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eef2e54-19aa-3795-88a3-084f1218353d",
                                        "entry_id": "7af6214c-318f-3f52-bb0e-9b5cdbd33aa4",
                                        "glosses": [
                                            "spesso transitoria, anche condizione di malinconia che può portare al pianto e, talvolta, a riflessioni sulla propria esistenza"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5dea49f-ce92-435f-a97a-488eb24af5a6",
                                                "sense_id": "5eef2e54-19aa-3795-88a3-084f1218353d",
                                                "text": "per un breve istante percepì la solitudine come proprio sentimento ed attorno a lui"
                                            }
