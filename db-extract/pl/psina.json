                "senses": [
                    {
                        "sense_id": "a6e30fbb-1eaf-3dc9-9301-5171aceabc21",
                        "entry_id": "0ff4f79f-d742-3309-aad0-ee7b12dc659f",
                        "glosses": [
                            "od: pies"
                        ],
                        "tags": [
                            "diminutive",
                            "endearing"
                        ],
                        "examples": [
                            {
                                "example_id": "9864c496-91f0-4714-bf90-42d26e30d5eb",
                                "sense_id": "a6e30fbb-1eaf-3dc9-9301-5171aceabc21",
                                "text": "Siwa, wierna psina tak mnie pilnuje, żebym nigdzie bez niej nie poszedł"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b3813912-c267-30a4-9491-18d5c93a19f2",
                        "entry_id": "0ff4f79f-d742-3309-aad0-ee7b12dc659f",
                        "glosses": [
                            "mięso z psa"
                        ],
                        "tags": [
                            "colloquial",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "bacab335-cfbc-40b0-a1a1-6012401f291b",
                                "sense_id": "b3813912-c267-30a4-9491-18d5c93a19f2",
                                "text": "W takim jednak wypadku nie jest zrozumiałe, dlaczego wyraz psina (por. ros. псина) utworzony od nazwy zwierzęcia niejadalnego może obok znaczenia ekspresywnego oznaczać również mięso odpowiedniego zwierzęcia"
                            },
                            {
                                "example_id": "22b633c4-8274-408f-a106-37426955e2af",
                                "sense_id": "b3813912-c267-30a4-9491-18d5c93a19f2",
                                "text": "(…) jako więzień w tiurmie krasnojarskiej, gdzie ku mojemu zdziwieniu dawano czasem zupę z mięsem (rzekomo baranim), nieraz jadłem psinę"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "564967d1-2260-4483-a56d-69d7ba358cbb",
                        "source_entry_id": "0ff4f79f-d742-3309-aad0-ee7b12dc659f",
                        "source_sense_id": "b3813912-c267-30a4-9491-18d5c93a19f2",
                        "target_lang_word": "dog meat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dog meat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1699de03-5322-3195-84fc-7c17998d4d73",
                                        "entry_id": "c74f2ec6-1248-37fd-b5b7-e1f5d2d9badf",
                                        "glosses": [
                                            "Meat from a dog eaten as food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad5e04a8-62c3-4631-909c-5cd73c5de24e",
                                                "sense_id": "1699de03-5322-3195-84fc-7c17998d4d73",
                                                "text": "We visited South Korea this time around, where we ate dog meat for the first time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d329903d-c7d4-3359-938e-b21318ba173b",
                                        "entry_id": "c74f2ec6-1248-37fd-b5b7-e1f5d2d9badf",
                                        "glosses": [
                                            "Meat prepared to be given to a dog as food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a38c76e1-74e4-4fc7-8eab-71627667734f",
                                                "sense_id": "d329903d-c7d4-3359-938e-b21318ba173b",
                                                "text": "That's a tin of dog meat, as well, really, er, served in the traditional manner, chopped up into a big bowl that says \"DOG\" on the side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "861c0d5e-c569-3ddc-b4b2-df4407cc4602",
                                        "entry_id": "c74f2ec6-1248-37fd-b5b7-e1f5d2d9badf",
                                        "glosses": [
                                            "Synonym of dead meat (“someone in danger of being killed or severely punished”)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66e1011f-a9cb-47e9-abd1-7b41d6abb5fb",
                                                "sense_id": "861c0d5e-c569-3ddc-b4b2-df4407cc4602",
                                                "text": "Did you just step on my blue suede shoes? You're dog meat now!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b55963a-e746-4729-8b44-e782628bd58b",
                        "source_entry_id": "0ff4f79f-d742-3309-aad0-ee7b12dc659f",
                        "source_sense_id": "b3813912-c267-30a4-9491-18d5c93a19f2",
                        "target_lang_word": "Hundefleisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hundefleisch",
