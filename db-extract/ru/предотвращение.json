                                    {
                                        "sense_id": "b2c07c7f-db76-33ee-b99b-854bb65ba6fc",
                                        "entry_id": "9b6bef5f-fcb8-3831-83b0-9bf73b075ef3",
                                        "glosses": [
                                            "The act of avoiding or shunning; keeping clear of."
                                        ],
                                        "tags": [
