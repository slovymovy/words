                        "glosses": [
                            "afzonderlijke belastingheffing over het inkomen van elk partner bij huwelijk of samenwonen, in plaats van het bij elkaar optellen van de inkomens om ze als geheel te belasten"
                        ],
                        "tags": [],
                        "examples": [
                            {
