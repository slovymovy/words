                {
                    "sense_id": "58162740-f630-3152-86b4-8d20f349e9f0",
                    "sense_definition": "Qui a une valeur, une qualité ou un rang moindre en comparaison avec un autre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "valeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce produit bon marché est fabriqué avec des matériaux de qualité <w>inférieure</w>.",
                            "target_lang_translations": {
                                "en": "This cheap product is made from materials of <w>inferior</w> quality.",
                                "ru": "Этот дешёвый продукт изготовлен из материалов <w>низкого</w> качества.",
                                "de": "Dieses günstige Produkt wird aus <w>minderwertigen</w> Materialien hergestellt.",
                                "es": "Este producto barato está fabricado con materiales de calidad <w>inferior</w>.",
                                "zh": "这种廉价产品是用质量<w>低劣</w>的材料制成的。"
                            }
                        },
                        {
                            "text": "Son salaire mensuel est nettement <w>inférieur</w> à la moyenne nationale.",
                            "target_lang_translations": {
                                "en": "His monthly salary is considerably <w>lower</w> than the national average.",
                                "ru": "Его ежемесячная зарплата заметно <w>ниже</w> средней по стране.",
                                "de": "Sein monatliches Gehalt ist deutlich <w>niedriger</w> als der nationale Durchschnitt.",
                                "es": "Su salario mensual es notablemente <w>inferior</w> a la media nacional.",
                                "zh": "他的月薪<w>较低</w>，明显不及全国平均水平。"
                            }
                        }
                    ],
