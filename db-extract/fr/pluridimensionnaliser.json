                        "sense_id": "a83ea543-ce98-3dd4-b4da-efba538cfda5",
                        "entry_id": "669388df-e9b8-327a-9c1b-71d4435e715e",
                        "glosses": [
                            "Donner un caractère pluridimensionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24081692-1749-4796-b19c-d9fcd3c57cb1",
                                "sense_id": "a83ea543-ce98-3dd4-b4da-efba538cfda5",
                                "text": "Mais l’éducation a tendance à pluridimensionnaliser l’étudiant!"
                            },
                            {
                                "example_id": "dc39b44f-9890-4270-ab19-a2272004fb2f",
                                "sense_id": "a83ea543-ce98-3dd4-b4da-efba538cfda5",
                                "text": "Mais sous cette dernière se cherche un nouvel universel symbolique capable de pluridimensionnaliser et d’enrichir l’expérience de ce que signifie « être humain sur la Terre »."
                            },
                            {
                                "example_id": "461b9930-c309-42fc-a853-b7efe6c20ede",
                                "sense_id": "a83ea543-ce98-3dd4-b4da-efba538cfda5",
                                "text": "la courbe devient volume, elle vient à se pluridimensionnaliser et vire à l’indécidable - comme ces turbulences ou ces transitoires que mathématiciens et acousticiens ne parviennent plus à contrôler."
                            }
                        ]
                    }
