                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "400423a9-c04e-34c2-8adb-2ff429751280",
                                        "entry_id": "d4e1299b-e682-3d7c-a639-7a0ae5c33a6c",
                                        "glosses": [
                                            "Given to using language in a showy way by using an excessive number of difficult words to impress others; bombastic; turgid."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a764eb62-4b34-4845-9d09-b221ddfa41a0",
                                                "sense_id": "400423a9-c04e-34c2-8adb-2ff429751280",
                                                "text": "The American people believe that they have a free country, and we are treated to grandiloquent speeches about our flag and our reputation for freedom and enlightenment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dee39d1-883b-447b-b7f6-bbb7421616cb",
                        "source_entry_id": "6b179ab9-80e9-3f64-95bd-b35fe9043e02",
                        "source_sense_id": "80ba8b77-0fc1-3a50-8513-aba40ecf1d0c",
                        "target_lang_word": "boastful",
                        "target_lang_code": "en",
