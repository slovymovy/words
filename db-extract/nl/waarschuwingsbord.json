                        "examples": [
                            {
                                "example_id": "26e9adb6-8032-4adc-a322-37f97758f536",
                                "sense_id": "4877d315-0e82-3a02-befc-065315bd1157",
                                "text": "Bestuurders van motorvoertuigen die voor de F35 staan te wachten, worden zo gewaarschuwd de overweg vrij te houden. En bestuurders die voor de overweg staan te wachten, worden via een waarschuwingsbord gemaand de F35 vrij te houden."
                            },
                            {
                                "example_id": "e2431b60-ced5-45d2-8230-8c204220355b",
                                "sense_id": "4877d315-0e82-3a02-befc-065315bd1157",
                                "text": "Bewoners van de Dokter Schräderlaan in het Brabantse Oisterwijk keken toch wat vreemd op, toen de werkzaamheden voor een nieuwe riolering waren voltooid. De lantaarnpaal die voorheen op het trottoir stond, staat nu plotseling op de rijbaan. Dat dat niet helemaal de bedoeling is, blijkt wel uit het feit dat de paal wordt afgeschermd door een rood-wit waarschuwingsbord. De gemeente Oisterwijk laat in een reactie weten dat het om een tijdelijke situatie gaat."
                            },
                            {
                                "example_id": "138a5ca5-a704-45fa-8ad1-6091c88ac73b",
                                "sense_id": "4877d315-0e82-3a02-befc-065315bd1157",
                                "text": "De PVV vindt het groene waarschuwingsbord bij Kinderboerderij Het Weusthag dat deels in het Turks is geschreven ‘een doorn in het oog’. Fractievoorzitter Jeanet Nijhof van de PVV in de gemeenteraad heeft er vragen over gesteld aan het college van b en w."
                            }
                        ]
