                "senses": [
                    {
                        "sense_id": "d1f7f2e9-2656-3dee-aac7-5a03b087c85f",
                        "entry_id": "3acb9ba7-1d2b-36ae-a86e-010e3674530f",
                        "glosses": [
                            "het concentreren van een oplossing door het oplosmiddel te laten verdampen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "08187356-1c15-4875-ade0-68eb3567ca03",
                                "sense_id": "d1f7f2e9-2656-3dee-aac7-5a03b087c85f",
                                "text": "Smelt de boter in de koekenpan en doe er als hij lichtbruin is de oesterzwammen bij. Bestrooi ze met zout en peper en bak ze op hoog vuur, geregeld omscheppen. Doe de knoflook erbij, laat een minuutje bakken en voeg de garnalen toe. Als die roze beginnen te kleuren de sherry erbij die even moet indampen. Roer de peterselie erdoor en haal de pan van het vuur."
                            },
                            {
                                "example_id": "0208043c-19ac-4b06-a066-4b4239f8357f",
                                "sense_id": "d1f7f2e9-2656-3dee-aac7-5a03b087c85f",
                                "text": "Maar zodra deze intermediairs zelf de mest gaan bewerken, is het systeem zo lek als een mandje. Het is niet moeilijk de monsters te manipuleren zodat het net lijkt alsof een mestpartij heel veel fosfaat bevat. 'Zet het potje een tijdje in de magnetron en laat het indampen. Dan stijgt het gehalte aan fosfaat. Dus lijkt het of je heel veel fosfaat hebt afgevoerd, terwijl dat in werkelijkheid niet het geval is.' Nog makkelijker is het om gewoon wat fosfaat toe te voegen voordat je het monster naar het lab brengt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5374729-1dc7-46cf-8697-be14eefb2518",
                        "source_entry_id": "3acb9ba7-1d2b-36ae-a86e-010e3674530f",
                        "source_sense_id": "d1f7f2e9-2656-3dee-aac7-5a03b087c85f",
                        "source_sense_description": "het concentreren van een oplossing door het oplosmiddel te laten verdampen",
                        "target_lang_word": "evaporate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evaporate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae3c0fba-4a47-3019-8874-bf68799c7870",
                                        "entry_id": "877e8fcc-c867-3d1b-b664-dc531367aa1b",
                                        "glosses": [
                                            "To transition from a liquid state into a gaseous state."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f83cc5ae-6676-4b15-b822-290dc1ef5ec8",
                                                "sense_id": "ae3c0fba-4a47-3019-8874-bf68799c7870",
                                                "text": "When an ultrasonic beam is fired at the microcannons, the emulsion evaporates, expanding rapidly into gas. This creates enough force to push the nanobullets out at velocities reaching several metres per second."
                                            },
                                            {
                                                "example_id": "ff97bdc3-d137-41dc-a1c1-dfa54baa5b9a",
                                                "sense_id": "ae3c0fba-4a47-3019-8874-bf68799c7870",
                                                "text": "McCoy’s team, including 66 researchers across four continents, found the salt and minerals left behind as water on Bennu, or its larger parent asteroid, evaporated. The minerals include sodium phosphates, carbonates, sulfates, chlorides and fluorides, some of which are necessary to the formation of life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a461775-3777-376f-b070-4ddebdff3e2d",
                                        "entry_id": "877e8fcc-c867-3d1b-b664-dc531367aa1b",
                                        "glosses": [
                                            "To expel moisture from (usually by means of artificial heat), leaving the solid portion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9b88831-748f-479a-8d9c-afa3d2f17b41",
                                                "sense_id": "4a461775-3777-376f-b070-4ddebdff3e2d",
                                                "text": "to evaporate apples"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1892b3fc-d9b6-33ca-9cf7-68ff2ded6072",
                                        "entry_id": "877e8fcc-c867-3d1b-b664-dc531367aa1b",
                                        "glosses": [
                                            "To give vent to; to dissipate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aad1d14c-48bb-42fe-a35a-133e664612d9",
                                                "sense_id": "1892b3fc-d9b6-33ca-9cf7-68ff2ded6072",
                                                "text": "[M]y lord of Eſſex choſe to evaporate his thoughts in a Sonnet (being his common vvay) to be ſung before the Queen, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c7a44d6-74cd-3d2e-b502-83656b71e9f6",
                                        "entry_id": "877e8fcc-c867-3d1b-b664-dc531367aa1b",
                                        "glosses": [
                                            "To disappear; to escape or pass off without effect."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecb7c273-5f73-4977-a49b-70a931180075",
                                                "sense_id": "7c7a44d6-74cd-3d2e-b502-83656b71e9f6",
                                                "text": "Near-synonym: go up in smoke"
                                            },
                                            {
                                                "example_id": "a64d832d-934f-451d-b1e9-2df268fd9a31",
                                                "sense_id": "7c7a44d6-74cd-3d2e-b502-83656b71e9f6",
                                                "text": "To give moderate liberty for griefs to evaporate […] is a safe way."
                                            },
                                            {
                                                "example_id": "34ebfc8f-8aba-43c6-abe1-7b6b7c4d726e",
                                                "sense_id": "7c7a44d6-74cd-3d2e-b502-83656b71e9f6",
                                                "text": "The hosts initially looked like they lacked a spring in their step, but fears of further agony evaporated in the seventh minute with a goal of typical Arsenal quality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "402daa2f-41e9-32de-8027-29ac1df92eb5",
                                        "entry_id": "877e8fcc-c867-3d1b-b664-dc531367aa1b",
                                        "glosses": [
                                            "To cause to disappear or to escape or pass off without effect."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f4e8f93-4aef-4d5f-a3ad-73535ac9cd08",
                                                "sense_id": "402daa2f-41e9-32de-8027-29ac1df92eb5",
                                                "text": "Gay people have belabored on this issue far too long and far too hard to allow the efforts of years to be evaporated through this obscene ruling. Our fights will continue, if not in the courts, then in the legislatures."
                                            }
                                        ]
                                    }
                                ]
