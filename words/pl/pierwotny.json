                },
                {
                    "sense_id": "8e5f50b8-ee6d-3608-ad74-d704953bed33",
                    "sense_definition": "pochodzący z najdawniejszych okresów dziejów Ziemi lub ludzkości; prehistoryczny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prehistoria",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archeolodzy odkryli w jaskini ślady, które pozostawił <w>pierwotny</w> człowiek tysiące lat temu.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили в пещере следы, которые оставил <w>первобытный</w> человек тысячи лет назад."
                            }
                        },
                        {
                            "text": "W filmie dokumentalnym przedstawiono zwyczaje i codzienne życie <w>pierwotnych</w> plemion z odległych wysp.",
                            "target_lang_translations": {
                                "ru": "В документальном фильме были представлены обычаи и повседневная жизнь <w>первобытных</w> племён с далёких островов."
                            }
                        }
                    ],
                    "synonyms": [
