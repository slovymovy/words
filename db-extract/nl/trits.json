                "senses": [
                    {
                        "sense_id": "c64f709f-458d-396c-8f24-7dace9dd855d",
                        "entry_id": "b809e4ce-fbcf-3c5b-a19b-4ac82c2e81db",
                        "glosses": [
                            "drie zaken die bij elkaar horen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "19df9d79-0498-3952-af69-5fa9effcf95c",
                        "entry_id": "b809e4ce-fbcf-3c5b-a19b-4ac82c2e81db",
                        "glosses": [
                            "een groter aantal zaken die bij elkaar horen, een serie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b58b2c1d-64df-4077-a93a-acb7e486186f",
                                "sense_id": "19df9d79-0498-3952-af69-5fa9effcf95c",
                                "text": "En de vermoorde Laura Palmer sprak Cooper in een van de eindeloze droomsequenties van de laatste aflevering als volgt toe: we zien elkaar terug over 25 jaar.’ Ze heeft nog woord gehouden ook, en actrice Sheryl Lee, die Laura speelt, is wel degelijk 25 jaar ouder geworden. Net als Kyle Maclachlan (Cooper) en een trits andere acteurs die weer meedoen."
                            },
                            {
                                "example_id": "d138b00d-456e-4dcd-b832-72b248bbdd3d",
                                "sense_id": "19df9d79-0498-3952-af69-5fa9effcf95c",
                                "text": "\"Ik wens dat de tijd even stil staat. Voor een heel lang moment\", aldus Madonna bij een trits emoticons van hartjes en klokjes. De 59-jarige Amerikaanse zangeres komt met een uitgebreid compilatiefilmpje, dat begint met een foto van een lachende Lourdes die haar mobiele telefoon vasthoudt."
                            },
                            {
                                "example_id": "80ea9f38-35a8-4056-ac58-1346cd390213",
                                "sense_id": "19df9d79-0498-3952-af69-5fa9effcf95c",
                                "text": "Is minister Schouten de vrouw die iets gaat doen aan de intensieve (pluim)veehouderij? Het lijkt er niet op. Dit kabinet wil vooral een enorme trits aan onderzoeken doen naar de risico's van de hoge concentratie dieren in Nederlandse bedrijven. Die onderzoeken gaan enkele jaren (een kabinetstermijn) kosten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ede8cae4-c117-4fd0-8fd8-a033f3e4b5b1",
                        "source_entry_id": "b809e4ce-fbcf-3c5b-a19b-4ac82c2e81db",
                        "source_sense_id": "c64f709f-458d-396c-8f24-7dace9dd855d",
                        "target_lang_word": "trio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbbbf9db-df39-39e6-ac01-d2f042cdeba0",
                                        "entry_id": "923ed040-e738-38b6-bd52-b83b12adce6f",
                                        "glosses": [
                                            "A group of three people or things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c66086b-8d93-4a70-8381-acb45531f194",
                                                "sense_id": "dbbbf9db-df39-39e6-ac01-d2f042cdeba0",
                                                "text": "I'm cooking crab cakes with arugula and mayonnaise, griddled lamb with rosemary potatoes and buttered spinach, then a trio of desserts."
                                            },
                                            {
                                                "example_id": "c8c5bef7-6b10-4e30-a2aa-6a8e7b4784dc",
                                                "sense_id": "dbbbf9db-df39-39e6-ac01-d2f042cdeba0",
                                                "text": "These are exciting times for England and particularly for this group. Six of this side won the Under-17s European Championship in 2014 and the attacking trio from Everton and Liverpool – Ademola Lookman, Dominic Solanke and Calvert-Lewin – had an excellent tournament."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "254ce3b6-0a5f-3eaf-b215-32a5ed99aebf",
                                        "entry_id": "923ed040-e738-38b6-bd52-b83b12adce6f",
                                        "glosses": [
                                            "A group of three musicians."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d0a3549-2377-3477-b1ad-3a6454ee70bc",
                                        "entry_id": "923ed040-e738-38b6-bd52-b83b12adce6f",
                                        "glosses": [
                                            "A piece of music written for three musicians."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f253b85-cf4c-4941-8819-9d6d017b672a",
                                                "sense_id": "3d0a3549-2377-3477-b1ad-3a6454ee70bc",
                                                "text": "I love his music, but it is a bit disconcerting to realize that you could die in extreme old age and still only be familiar with a mere handful of the baryton trios."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a09a3e-8780-3c34-8208-437cf3bbc725",
                                        "entry_id": "923ed040-e738-38b6-bd52-b83b12adce6f",
                                        "glosses": [
                                            "A passage in the middle of a minuet, frequently in a different key."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f2b0781-bf4f-3ab5-99ad-e8467abbb1cc",
                                        "entry_id": "923ed040-e738-38b6-bd52-b83b12adce6f",
                                        "glosses": [
                                            "Any cocktail made with a spirit, a liqueur, and a creamy ingredient."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b904b154-c0d4-35c2-990b-180fa857c356",
                                        "entry_id": "923ed040-e738-38b6-bd52-b83b12adce6f",
                                        "glosses": [
                                            "Synonym of three-in-one (“type of fast food”)."
                                        ],
