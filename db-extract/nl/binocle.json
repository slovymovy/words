                        "entry_id": "b75556f3-47c6-35eb-9863-173481401657",
                        "glosses": [
                            "een knijpbril of binoculaire verrekijker, onder meer gebruikt om toneelvoorstellingen beter te zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4130e13-a86f-43d1-be67-e0f426c79b76",
                                "sense_id": "7bf37222-23fc-3375-a6ba-8dfac3f7f3f1",
                                "text": "Hij droeg nog z'n ouderwetse binocle."
                            },
                            {
                                "example_id": "53b7f3d0-347e-49e1-b869-4d3f1770ebb8",
                                "sense_id": "7bf37222-23fc-3375-a6ba-8dfac3f7f3f1",
                                "text": "En vluchtte hij als de trappen af, bang, dat iemand hem na zou roepen, dat hij zijn binocle vergat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35570ed8-aa36-4bf0-8fa9-c61e5b38a736",
                        "source_entry_id": "b75556f3-47c6-35eb-9863-173481401657",
                        "source_sense_id": "7bf37222-23fc-3375-a6ba-8dfac3f7f3f1",
                        "source_sense_description": "een knijpbril of binoculaire verrekijker, onder meer gebruikt om toneelvoorstellingen beter te zien",
                        "target_lang_word": "Binokel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Binokel",
