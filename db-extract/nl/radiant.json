                    {
                        "sense_id": "3980ff41-093c-3d95-91ec-52f44cefac9f",
                        "entry_id": "c1e94ba8-ec85-37ca-9f6b-dd30fae854fd",
                        "glosses": [
                            "punt aan de hemel van waar meteoren uit een meteorietenzwerm lijken te komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4ed87b3-9d0a-491c-a81a-af8f17291135",
                                "sense_id": "3980ff41-093c-3d95-91ec-52f44cefac9f",
                                "text": "Het radiant – het punt van waar de meteoren lijken te komen – zal in de vroege avond boven de noordoostelijke horizon verschijnen en zich later hoog aan de hemel bevinden, in het sterrenbeeld Lier."
                            },
                            {
                                "example_id": "2c677853-848b-4937-ad97-48b5467a95cb",
                                "sense_id": "3980ff41-093c-3d95-91ec-52f44cefac9f",
                                "text": "Het eenvoudigst is gewoon naar boven kijken tot je een vallende ster ziet. Hou vervolgens het punt waaruit de meteoor leek te komen in de gaten. Dit is het radiant. Het radiant bevindt zich in het sterrenbeeld Perseus, vandaar de naam ‘Perseïden’. Je kunt ook dit kaartje gebruiken om het radiant snel te spotten. HP de Tijd 09/08"
                            }
                        ]
                    }
