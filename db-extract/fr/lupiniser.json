                "senses": [
                    {
                        "sense_id": "2b041ee7-6215-3139-b928-1f1ea22cdbb7",
                        "entry_id": "7795a5ae-418a-36dc-8fed-9ddcbbbc5016",
                        "glosses": [
                            "Prendre un caractère lupin (de loup)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5cecc7a-80b6-4efe-bc44-37ccc04dcdb5",
                                "sense_id": "2b041ee7-6215-3139-b928-1f1ea22cdbb7",
                                "text": "Peu à peu, le loup servier s’est « lupinisé »."
                            },
                            {
                                "example_id": "80f48ca0-f412-42db-955f-4868dcab59d5",
                                "sense_id": "2b041ee7-6215-3139-b928-1f1ea22cdbb7",
                                "text": "Si, au bout de neuf ans, l’homme transformé en « loup sauvage / sacré », l’homme « lupinisé », le loup-garou, n’avait pas touché à de la chair humaine, il redevenait humain et réintégrait la communauté des hommes."
                            },
                            {
                                "example_id": "59d6a2bd-a656-45a6-9a62-ded7a33c64da",
                                "sense_id": "2b041ee7-6215-3139-b928-1f1ea22cdbb7",
                                "text": "Amala, toute lupinisée fut-elle, s’éduqua assez rapidement."
                            }
                        ]
                    }
                ],
