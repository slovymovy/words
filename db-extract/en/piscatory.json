                        "glosses": [
                            "Of or pertaining to fishermen or fishing."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "869c6dd2-1fc8-4910-ac50-c6ca86a03977",
                                "sense_id": "20ef7160-9030-3ed3-aacd-e67f25092110",
                                "text": "The Ribble and the Aire roll down, as yet unpolluted by dyers' chemistry; tenanted by merry trouts and piscatory otters."
                            }
                        ]
                    },
                    {
                        "sense_id": "409ce864-b554-3847-99f6-7b29ac001579",
                        "entry_id": "e5559eca-627f-3ab2-bb8f-93e5fbf8b797",
                        "glosses": [
                            "Of or pertaining to fish; piscine."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9bfcfd1b-7771-43b6-919b-0204a446c651",
                                "sense_id": "409ce864-b554-3847-99f6-7b29ac001579",
                                "text": "The air among the houses was of so strong a piscatory flavour that one might have supposed sick fish went up to be dipped in it."
                            }
                        ]
                    }
                ],
