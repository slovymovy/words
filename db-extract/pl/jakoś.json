                ],
                "translations": [
                    {
                        "translation_id": "113c2523-95cb-4bb1-ace8-8df1d0f0bf4c",
                        "source_entry_id": "ce8b6a92-49db-3937-b367-7607a995c6a5",
                        "source_sense_id": "2ee8469b-9f6e-3d4b-842d-3fff80f7398c",
                        "target_lang_word": "somehow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somehow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70030fe2-0143-3b3c-84a5-b811c0d303d1",
                                        "entry_id": "448fe6cd-6495-3885-b703-2a6cb503bdb1",
                                        "glosses": [
                                            "In one way or another; in a way not yet known or explained; by some means"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0d352b-fc72-42c6-90e6-e8f3501ecdc5",
                                                "sense_id": "70030fe2-0143-3b3c-84a5-b811c0d303d1",
                                                "text": "This problem has to be tackled somehow."
                                            },
                                            {
                                                "example_id": "e8fc5827-9888-44ef-83f9-b1340df02b9d",
                                                "sense_id": "70030fe2-0143-3b3c-84a5-b811c0d303d1",
                                                "text": "We don't know how he's still alive after the accident, but somehow he is."
                                            },
                                            {
                                                "example_id": "992fb67a-8ef6-4beb-a78a-6be18e16561c",
                                                "sense_id": "70030fe2-0143-3b3c-84a5-b811c0d303d1",
                                                "text": "December 1, 2016, Tom Donaghy writing in The New York Times, Tender Side of Edward Albee\nIt’s not by accident Edward wrote “The Goat,” “The Zoo Story” or “Seascape,” with its two lizards, Sarah and Leslie. In fact, in all of his plays the animal is pretty prominent, somehow or other."
                                            },
                                            {
                                                "example_id": "e6b4a762-3f1a-414c-95d3-c517067adcde",
                                                "sense_id": "70030fe2-0143-3b3c-84a5-b811c0d303d1",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers, of errand not wholly obvious to their fellows, yet of such sort as to call into query alike the nature of their errand and their own relations."
                                            },
                                            {
                                                "example_id": "24029f4c-0e28-435d-8548-359cabb7776b",
                                                "sense_id": "70030fe2-0143-3b3c-84a5-b811c0d303d1",
                                                "text": "Have I not loathed to live again and said\nIt would have been far better to be dead,\n And yet somehow, I know not why,\nRemained afraid to die!"
                                            },
                                            {
                                                "example_id": "f4254fed-dfb7-46a8-adb2-034937886b68",
                                                "sense_id": "70030fe2-0143-3b3c-84a5-b811c0d303d1",
                                                "text": "Although youngest of the family, he has somehow or other got the entire management of all the others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c430f60-6059-4849-84d3-70f4aa93342b",
                        "source_entry_id": "ce8b6a92-49db-3937-b367-7607a995c6a5",
