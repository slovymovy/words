                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мизантро́пия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a4a72434-88dc-31ab-bb0c-77fbcfa0fd49",
                                        "entry_id": "4f655918-6542-308c-8cbe-23827ba4d2ab",
                                        "glosses": [
                                            "книжн. человеконенавистничество, ненависть по отношению к людям"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d555b2dc-0ea8-48a6-895e-ee1e363176b3",
                                                "sense_id": "a4a72434-88dc-31ab-bb0c-77fbcfa0fd49",
                                                "text": "Моя относительная нелюдимость, которая есть просто признак здорового ума, предпочитающего проводить время наедине с самим собою и книгами, чем тратить его на праздную и пустую болтовню, могла сойти за болезненную мизантропию."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
