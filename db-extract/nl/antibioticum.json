                    {
                        "sense_id": "96966fa1-5c4c-34fb-8c59-cac87ae0c144",
                        "entry_id": "a0c8040f-3033-3c62-9c4c-a043ffa50fd1",
                        "glosses": [
                            "geneesmiddel tegen infectieziekten"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0306e806-a77a-3251-863a-c43ab3e08f95",
                        "entry_id": "a0c8040f-3033-3c62-9c4c-a043ffa50fd1",
                        "glosses": [
                            "bacteriedodende stof van natuurlijke (= niet-kunstmatige) oorsprong"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c05c6733-021c-4719-b1e4-7bfe00953ce9",
                                "sense_id": "0306e806-a77a-3251-863a-c43ab3e08f95",
                                "text": "Penicilline is een belangrijk antibioticum."
                            },
                            {
                                "example_id": "7ee2b86b-91db-4090-a859-fe2e589426c6",
                                "sense_id": "0306e806-a77a-3251-863a-c43ab3e08f95",
                                "text": "' 'Heb je onlangs antibiotica geslikt?' 'Nee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9311e810-8889-426b-964f-8ba3bc782cd1",
                        "source_entry_id": "a0c8040f-3033-3c62-9c4c-a043ffa50fd1",
                        "target_lang_word": "Antibiotikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antibiotikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f1bbcd8-3d35-36aa-92ac-84ae3ba50b7b",
                                        "entry_id": "70ae5518-f670-3ae6-a1e0-c98f66d758d2",
                                        "glosses": [
                                            "Medikament, das einen so starken, hemmenden Einfluss auf den Stoffwechsel von Mikroorganismen hat, dass es deren Vermehrung oder deren Weiterleben unterbindet, wodurch mittels einer lokalen oder systemischen Therapie bakterielle Infektionskrankheiten behandelt werden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21692801-160f-4831-a629-c2175d59ee2b",
                                                "sense_id": "1f1bbcd8-3d35-36aa-92ac-84ae3ba50b7b",
                                                "text": "Das bekannteste Antibiotikum ist Penicillin."
                                            },
                                            {
                                                "example_id": "f53a3878-9a56-4117-a37e-64902f2319a9",
                                                "sense_id": "1f1bbcd8-3d35-36aa-92ac-84ae3ba50b7b",
                                                "text": "„Allerdings war das Wissen über die korrekte Anwendung von Antibiotika äußerst lückenhaft: So glauben 65 Prozent, dass Antibiotika gegen Erkältungen und Schnupfen helfen - dabei richten solche Medikamente gegen Viruserkrankungen nichts aus und helfen nur gegen bakterielle Infektionen.“"
                                            },
                                            {
                                                "example_id": "910ee9c9-8b32-4f15-b160-d45734344fb7",
                                                "sense_id": "1f1bbcd8-3d35-36aa-92ac-84ae3ba50b7b",
                                                "text": "„Auf einer Busfahrt durch Marokko hatte ich meine Notapotheke mit einer Dose Antibiotika dabei.“"
                                            },
                                            {
                                                "example_id": "020adccf-bc62-4fb1-bf40-5b92edd75536",
                                                "sense_id": "1f1bbcd8-3d35-36aa-92ac-84ae3ba50b7b",
                                                "text": "„Und dann hatte Bonnie auch noch eine Erkältung und brauchte Antibiotika, damit daraus keine Lungenentzündung wurde, und meine Schwester hatte sich geweigert, die Tiere in meiner Abwesenheit zu versorgen – wieder einmal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ed6519a-7a59-4694-a6df-e5fec605ee21",
                        "source_entry_id": "a0c8040f-3033-3c62-9c4c-a043ffa50fd1",
                        "target_lang_word": "antibiotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antibiotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c7705de-fe1b-3f93-aff5-693b8e8bf2c7",
                                        "entry_id": "4a10a062-16f7-3400-bfe2-c782bcf577e7",
                                        "glosses": [
                                            "Any substance that can destroy or inhibit the growth of bacteria and similar microorganisms, generally transported by the lymphatic system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17fa8136-aedb-463d-8f44-1e167258d31e",
                                                "sense_id": "7c7705de-fe1b-3f93-aff5-693b8e8bf2c7",
                                                "text": "On a summer visit back to the farm here where I grew up, I think I figured out the central problem with modern industrial agriculture. It’s not just that it produces unhealthy food, mishandles waste and overuses antibiotics in ways that harm us all."
                                            },
                                            {
                                                "example_id": "eceb9d3c-8171-4393-b76e-2b5edf4a8feb",
                                                "sense_id": "7c7705de-fe1b-3f93-aff5-693b8e8bf2c7",
                                                "text": "We selected colistimethate sodium (CMS) as our antibiotic of choice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antibiotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "532164fe-4fd9-30e2-85ba-63d7f3611845",
                                        "entry_id": "0b2323fd-6aa4-3d56-a24a-3b2386fc3cd2",
                                        "glosses": [
                                            "Of or relating to antibiotics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6d81fc5-d82e-3edb-8a55-0f74d5f0ff4f",
                                        "entry_id": "0b2323fd-6aa4-3d56-a24a-3b2386fc3cd2",
                                        "glosses": [
                                            "Of or relating to the theory that extraterrestrial life does not exist."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f351c4ed-43b0-4cc1-9df6-5fbb72cd43f7",
                        "source_entry_id": "a0c8040f-3033-3c62-9c4c-a043ffa50fd1",
                        "target_lang_word": "antibiotique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antibiotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d35ecab1-2c7d-3fe3-8bd7-05728876c92b",
                                        "entry_id": "3dea490c-a2f5-37f6-84e3-171b5b4a6c09",
                                        "glosses": [
                                            "Pourvu d’une action destructrice à l’égard des micro-organismes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "758c6811-8dad-47c7-b174-0a4432f3fd7e",
                                                "sense_id": "d35ecab1-2c7d-3fe3-8bd7-05728876c92b",
                                                "text": "De nombreuses moisissures ont des effets antibiotiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antibiotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a62fcb93-7a9f-3e08-9791-11b64216650f",
                                        "entry_id": "4b05c407-c47b-3b1f-b7a4-e92bee03f282",
                                        "glosses": [
                                            "Médicament qui peut être d’origine naturelle (champignons, moisissures ou bactéries) ou de synthèse et dont l’action consiste à inhiber (bactériostatique) ou à tuer (bactéricide) les germes étrangers à un corps vivant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17b1d021-7417-4489-bc7c-8e3d7f1c0f72",
                                                "sense_id": "a62fcb93-7a9f-3e08-9791-11b64216650f",
                                                "text": "En prescrivant des antibiotiques sophistiqués ou à large spectre, il cherche à « écraser une mouche avec un marteau », enrichit les laboratoires et contribue au pillage de la Sécurité sociale."
                                            },
                                            {
                                                "example_id": "15abc66b-5492-42d5-978f-af1e33dec866",
                                                "sense_id": "a62fcb93-7a9f-3e08-9791-11b64216650f",
                                                "text": "Les médicaments plus forts comme les antibiotiques doivent être dosés avec précision."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
