                "senses": [
                    {
                        "sense_id": "47b79d14-f5f0-308c-8760-a33def8553e5",
                        "entry_id": "1bf13336-6e12-3cd5-b399-8929b027431f",
                        "glosses": [
                            "schönes Erlebnis, an dem man sich erfreut"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "71abc2d4-2ab2-41b4-9e22-c8123f265190",
                                "sense_id": "47b79d14-f5f0-308c-8760-a33def8553e5",
                                "text": "„Wo dieser [der Padischah] ein angenehmes Leben führen kann und sich mit schönen Frauen umgeben, zur Erholung fechten, zur Erfreunis jagen kann und als schlimmstes nur das Lebensende durch gewaltsamen Tod zu gewärtigen hat, muß der Großwesir sich mit dem Volk herumärgern, muß Verordnungen erlassen, hat die Mühe, jene Gehälter in seine eigene Tasche fließen zu lassen, die für zahlreiche Beamte bestimmt sind.“"
                            },
                            {
                                "example_id": "cf65f322-cf15-4ff0-9d93-8df67b76286a",
                                "sense_id": "47b79d14-f5f0-308c-8760-a33def8553e5",
                                "text": "„Er [der Liebhaber] möchte sich wieder den anderen Erfreunissen des Lebens zuwenden: aber er findet sie nichtig.“"
                            },
                            {
                                "example_id": "7402dd4b-4d8f-44a6-9e54-b39174bb7cfe",
                                "sense_id": "47b79d14-f5f0-308c-8760-a33def8553e5",
                                "text": "Ein weiteres Erfreunis sei, so der Superintendent, dass es sich nicht nur auf Baltrum, sondern auch in den anderen Gemeinden gezeigt habe, dass andere Gelder für weitere Maßnahmen für die Kirchen in keinster Weise zu kurz kämen."
                            },
                            {
                                "example_id": "83e1a33a-c3d1-432c-8df4-6ae923471743",
                                "sense_id": "47b79d14-f5f0-308c-8760-a33def8553e5",
                                "text": "Ein weiteres Erfreunis: seit das ehemalige ‚Inselgaswerk' an die grosse Welt der Erdgaspipelines angeschlossen ist, geht es mit dem Betrieb wieder bergwärts."
                            },
                            {
                                "example_id": "7c71a504-b526-42a8-8d68-871e9f5a8cdb",
                                "sense_id": "47b79d14-f5f0-308c-8760-a33def8553e5",
                                "text": "Ebenso ein Erfreunis für die Mitarbeiter, die zehn Prozent des Gewinns als Bonuszahlungen erhalten sollen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d5f5817-8070-482f-8934-104a21e5a8ea",
                        "source_entry_id": "1bf13336-6e12-3cd5-b399-8929b027431f",
                        "source_sense_id": "47b79d14-f5f0-308c-8760-a33def8553e5",
                        "source_sense_description": "selten: schönes Erlebnis, an dem man sich erfreut",
                        "target_lang_word": "gratification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gratification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a408e854-7987-312c-8df6-a67f15437460",
                                        "entry_id": "dfd24814-b0db-3ca0-92fc-f3c5ae983de1",
                                        "glosses": [
                                            "The act of gratifying or pleasing, either the mind, or the appetite or taste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd541293-6697-4e51-b539-b5965ac47863",
                                                "sense_id": "a408e854-7987-312c-8df6-a67f15437460",
                                                "text": "gratification of the heart    gratification of the palate"
                                            },
                                            {
                                                "example_id": "76981d35-03ea-4729-abd0-e57b8202d35f",
                                                "sense_id": "a408e854-7987-312c-8df6-a67f15437460",
                                                "text": "I know nothing of Mr. Courtenaye; but I can perceive enough of this affair to see that he is one of those who, for a moment's selfish gratification, or for the yet meaner love of gratified vanity, will excite the deepest feelings, and trifle with the dearest hopes of all who trust them!"
                                            },
                                            {
                                                "example_id": "fff6b91f-39a1-4a45-a42e-782aae67bc80",
                                                "sense_id": "a408e854-7987-312c-8df6-a67f15437460",
                                                "text": "Many of the so-called rites of these secret societies were so patently ridiculous, that it is quite obvious that they were merely an excuse for men and women to indulge in sex-play and lustful gratification, frequently of an abnormal kind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e421cef3-343b-3a3e-b4b7-e7d6f113f27a",
                                        "entry_id": "dfd24814-b0db-3ca0-92fc-f3c5ae983de1",
                                        "glosses": [
                                            "A gratuity; a reward."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5dd31f28-2cd8-3d06-a65d-8f59b81fac14",
                                        "entry_id": "dfd24814-b0db-3ca0-92fc-f3c5ae983de1",
                                        "glosses": [
                                            "A feeling of pleasure; satisfaction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41044801-3081-418f-9c2c-569c158728f2",
                                                "sense_id": "5dd31f28-2cd8-3d06-a65d-8f59b81fac14",
                                                "text": "I will tell you all my faults frankly beforehand. I am very vain, for I cultivate my vanity on a principle, and cannot understand why we should neglect such a source of gratification."
                                            },
                                            {
                                                "example_id": "178e7ad9-5ea7-48e7-a8b0-855f3c8f720a",
                                                "sense_id": "5dd31f28-2cd8-3d06-a65d-8f59b81fac14",
                                                "text": "To my gratification he told me I could reënter the institution, and that he would trust me to pay the debt when I could."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
