                        "glosses": [
                            "A deep hole used for drainage, where rainwater and other wastewater drains directly into the ground, without connection to any mains drainage or sewerage pipes."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
