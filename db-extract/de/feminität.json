                "senses": [
                    {
                        "sense_id": "722d3415-126a-3c01-a74a-005f6d86e0b0",
                        "entry_id": "3f746f34-339b-3bad-abfa-2f9b3742dab1",
                        "glosses": [
                            "Gesamtheit typisch weiblicher Eigenschaften; Ausstrahlung der Weiblichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62fac343-4f36-4e96-b201-efc6b711c4cd",
                                "sense_id": "722d3415-126a-3c01-a74a-005f6d86e0b0",
                                "text": "„Die Annahme ist gestärkt, dass nur Maskulinität bei Jungen und Feminität bei Mädchen ein erstrebenswertes Entwicklungsziel darstellt.“"
                            },
                            {
                                "example_id": "55748fee-500d-4c53-a7ca-e42707cd7c1d",
                                "sense_id": "722d3415-126a-3c01-a74a-005f6d86e0b0",
                                "text": "„Solch deutende Konstruktionsprozesse von Geschlecht können erst erschlossen werden, wenn Frauen und Männer, Maskulinitäten und Feminitäten in den Blick genommen werden und von einem analytischen Geschlechterbegriff ausgegangen wird.“"
                            },
                            {
                                "example_id": "8cda2ab3-2935-4d92-b194-92a43e02869c",
                                "sense_id": "722d3415-126a-3c01-a74a-005f6d86e0b0",
                                "text": "„Wiederholungen hegemonialer geschlechtlicher Attribute, wie sie mit Maskulinitäten und Feminitäten spielende Lesben verkörpern, bergen folglich immer auch die Möglichkeit ihrer Unterwanderung und Resignifizierung in sich.“"
                            },
                            {
                                "example_id": "904bfa91-9ab9-4ffe-9726-26b9a3aa9cd5",
                                "sense_id": "722d3415-126a-3c01-a74a-005f6d86e0b0",
                                "text": "„Er könnte jenseits herkömmlicher Geschlechtermythen und hegemonialer Maskulinitäten und Feminitäten dazu beitragen, eine Perspektive auf die Gewalt, der Frauen und Männer ausgesetzt sind, zu ermöglichen.“"
                            },
                            {
                                "example_id": "7c6ee429-39ba-4676-9e8b-f6330aa8474a",
                                "sense_id": "722d3415-126a-3c01-a74a-005f6d86e0b0",
                                "text": "„Es handelt sich um Orte, an denen insbesondere Feminitäten angerufen und performt werden, die über den Referenzrahmen von Körper(pflege)arbeit und daran gekoppelter Körperideale hinausgehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
