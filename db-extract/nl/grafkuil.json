                "senses": [
                    {
                        "sense_id": "bdf3ee5d-ec91-32c5-917c-9dbe499ee751",
                        "entry_id": "57472fbd-eb50-38e6-8639-42993ee3927b",
                        "glosses": [
                            "ruimte waar de stoffelijke overschotten van een overledene kunnen rusten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c34be50-a661-4922-b792-a120b9aacadc",
                                "sense_id": "bdf3ee5d-ec91-32c5-917c-9dbe499ee751",
                                "text": "Ze werden vorig jaar gevonden in een grafkuil in een suikerrietplantage, vermoedelijk na een afrekening in het drugscircuit. Een Venezolaanse man werd ook al opgepakt voor de moord."
                            },
                            {
                                "example_id": "e1fb940e-1c86-4c13-bf8b-30b23bccd886",
                                "sense_id": "bdf3ee5d-ec91-32c5-917c-9dbe499ee751",
                                "text": "Op de bewuste dag had Temme met W. afgesproken. W. zou Temme hebben voorgehouden dat er een grafkuil voor iemand anders moest worden gegraven. Gewapend met scheppen, joints en drank dolven de twee vrienden de kuil, waarin T. ten slotte zelf in bewusteloze toestand belandde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afba137f-5dc1-405c-8565-82cac727e91c",
                        "source_entry_id": "57472fbd-eb50-38e6-8639-42993ee3927b",
                        "source_sense_id": "bdf3ee5d-ec91-32c5-917c-9dbe499ee751",
                        "target_lang_word": "grave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "271f4c90-53a6-3b77-8046-1af27356bd2d",
                                        "entry_id": "34b52378-9557-3558-b31c-ef341528cfc7",
                                        "glosses": [
                                            "An excavation in the earth as a place of burial."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6960e38-8582-4eb9-bd0d-d8b1e521cae8",
                                                "sense_id": "271f4c90-53a6-3b77-8046-1af27356bd2d",
                                                "text": "He had lain in the grave four days."
                                            },
                                            {
                                                "example_id": "919e3358-db91-44d9-8fda-6771d369715b",
                                                "sense_id": "271f4c90-53a6-3b77-8046-1af27356bd2d",
                                                "text": "Let mee not be ashamed, O Lord, for I haue called vpon thee: let the wicked be ashamed, and let them be silent in the graue."
                                            },
                                            {
                                                "example_id": "7e7ee969-a142-48a4-a553-9ab9d7bf9c8c",
                                                "sense_id": "271f4c90-53a6-3b77-8046-1af27356bd2d",
                                                "text": "They reached the cemetery. The men went right down to a place in the grass where a grave was dug. They ranged themselves all round; and while the priest spoke, the red soil thrown up at the sides kept noiselessly slipping down at the corners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4658d3f-a94c-36f2-97d4-8f1a8ec7ed4c",
                                        "entry_id": "34b52378-9557-3558-b31c-ef341528cfc7",
                                        "glosses": [
                                            "Any place of interment."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6b9c00b-1eca-31f4-9eb8-8f794b52dd6a",
                                        "entry_id": "34b52378-9557-3558-b31c-ef341528cfc7",
                                        "glosses": [
                                            "Any place containing one or more corpses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "181f8537-19f3-3a80-ae9c-032167757b46",
                                        "entry_id": "34b52378-9557-3558-b31c-ef341528cfc7",
                                        "glosses": [
                                            "Death, destruction."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d17c202-a78d-447a-87d1-8ffa500fa4f0",
                                                "sense_id": "181f8537-19f3-3a80-ae9c-032167757b46",
                                                "text": "[…]Meeting is pleasure, parting is a grief; / An inconstant lover is worse than a thief; / A thief can but rob you, and take all you have, / An inconstant lover will bring you to the grave![…]"
                                            },
                                            {
                                                "example_id": "73108976-a233-483d-b9ec-44c736e75d8d",
                                                "sense_id": "181f8537-19f3-3a80-ae9c-032167757b46",
                                                "text": "[…]balanced on the biggest wave you race towards an early grave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe560984-a676-3b52-980a-8c814fed3eb9",
                                        "entry_id": "34b52378-9557-3558-b31c-ef341528cfc7",
                                        "glosses": [
                                            "Deceased people; the dead."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58b0c5bf-5f16-40ce-a12f-568287ee360c",
                                                "sense_id": "fe560984-a676-3b52-980a-8c814fed3eb9",
                                                "text": "\"Hold your jaw, woman! I've had enough to vex me to-day without you startin' your tantrums. You're jealous of the grave. That's wot's the matter with you.\" \"And her brats can insult me as they like - me that 'as cared for you these five years.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
