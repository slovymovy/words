                                                "sense_id": "8e3b519f-7147-3909-8092-7c36f7f504d9",
                                                "text": "To pivečko to věru je nebeský dar…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48dc7fdc-7f16-4be3-bedd-617ee12b2f3c",
                        "source_entry_id": "12e9da13-b588-3250-a054-51605caa9de7",
                        "source_sense_id": "e613a5e0-b251-371a-8f2c-54aeaf09e320",
                        "target_lang_word": "Bierchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bierchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00114339-ea0c-38c3-815b-29d405ed9118",
                                        "entry_id": "29d9375c-fc5a-3723-b3af-3ba393e6cc51",
                                        "glosses": [
                                            "Bier"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bc8eea1-1f35-4478-898e-4b5ec7b15159",
                                                "sense_id": "00114339-ea0c-38c3-815b-29d405ed9118",
                                                "text": "Lass uns mal heute Abend zum Fußballspiel ein Bierchen trinken."
                                            },
                                            {
                                                "example_id": "756371d4-9aa1-459f-ba0e-cce6ed833a70",
                                                "sense_id": "00114339-ea0c-38c3-815b-29d405ed9118",
                                                "text": "„Also habe ich zu Minister Zimmermann gesagt, er solle seinen Bulldozer mal stehen lassen. Und dann haben wir uns in seinen Garten gesetzt, ein paar Bierchen getrunken, Skat gespielt und dabei die Dinge nach und nach geklärt.“"
                                            },
                                            {
                                                "example_id": "725546c8-80dd-44e0-b354-0f2eb6617ba9",
                                                "sense_id": "00114339-ea0c-38c3-815b-29d405ed9118",
                                                "text": "„Die eine oder andere Lage Korn, gemischt mit einigen Bierchen, versetzt die Stehenden hinter der Theke in immer bessere Stimmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55708c2f-a13e-41f7-97d3-a92138ad6e1a",
                        "source_entry_id": "12e9da13-b588-3250-a054-51605caa9de7",
                        "source_sense_id": "e613a5e0-b251-371a-8f2c-54aeaf09e320",
