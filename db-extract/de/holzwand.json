                                "sense_id": "4db5c04c-c2f7-3fca-a74c-1ca36695b400",
                                "text": "„Ihre geteerten äußeren Holzwände sind mittels einer Steinmauer vor Sturm und Regen geschützt.“"
                            },
                            {
                                "example_id": "376eaff4-6dc2-493d-ac02-37104a1be1b2",
                                "sense_id": "4db5c04c-c2f7-3fca-a74c-1ca36695b400",
                                "text": "„Er stößt pfeifende den Atem aus und sieht sich das Chaos aus Notizen und Karten an den Holzwänden seines Kabuffs an.“"
                            }
                        ],
