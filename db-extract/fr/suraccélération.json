                                                "example_id": "7b11d9fa-d5ce-446e-9cde-babde14cfd69",
                                                "sense_id": "55ffa4a1-10a6-3c8a-87f0-fbf19fc561e3",
                                                "text": "Jerk chicken is a local favorite."
                                            }
                                        ]
                                    }
                                ]
                            },
