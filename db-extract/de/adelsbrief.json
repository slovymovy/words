                "senses": [
                    {
                        "sense_id": "67ddbf0e-60b3-36ae-995a-d4431b2b8004",
                        "entry_id": "d0acc68a-0d35-38a4-8b7c-a87211a2eee4",
                        "glosses": [
                            "„Urkunde, die einem Neugeadelten zum Beweis seiner Standeserhöhung (Nobilitierung) übergeben wurde“"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6aab46e6-b389-43c6-a107-1ea960aba34f",
                                "sense_id": "67ddbf0e-60b3-36ae-995a-d4431b2b8004",
                                "text": "„Als ich vor sieben Jahren in Laxenburg bei ihm [dem Kaiser Josef dem Zweiten] war, sprach er mit berechtigtem Spott von einem Menschen, der mittels riesiger Summen und durch alle möglichen Kriechereien einen elenden Adelsbrief erworben hatte. Bei dieser Gelegenheit sagte er zu mir: »Ich verachte alle, die den Adel kaufen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
