                        "form": "die Zustandsänderungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8af7968c-d29d-3479-b37f-07207917691d",
                        "entry_id": "a79e2c82-a4da-3038-a0df-43065c532ae0",
                        "glosses": [
                            "Veränderung, Wechsel eines bestimmten Zustandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc552f41-fcf4-4db6-a0a7-0b70c94d8616",
                                "sense_id": "8af7968c-d29d-3479-b37f-07207917691d",
                                "text": "„Diese Zustandsänderung durch Beobachtung ist ein Grundprinzip der Quantenmechanik.“"
                            },
                            {
                                "example_id": "08eab628-1184-44cd-b377-39c6701f3e04",
                                "sense_id": "8af7968c-d29d-3479-b37f-07207917691d",
                                "text": "„Und Sie können die Veränderung Ihrer Körperhaltung als Intervention zur schnellen Zustandsänderung nutzen, wenn Sie sich mal wieder unsicher fühlen sollten.“"
                            },
                            {
                                "example_id": "a7d92af9-f94d-45f1-a03c-40e1a8a85121",
                                "sense_id": "8af7968c-d29d-3479-b37f-07207917691d",
                                "text": "„Dabei sind Photonen so miteinander verkoppelt, dass jede Zustandsänderung des einen auch eine beim Partner bewirkt - instantan und unabhängig von der Entfernung.“"
                            },
                            {
                                "example_id": "e331055e-19a4-4a19-8cc2-6324c10c55d6",
                                "sense_id": "8af7968c-d29d-3479-b37f-07207917691d",
                                "text": "„Bei dieser Zustandsänderung bildeten sich aus der Urmaterie die verschiedenen Teilchen, wobei Partner und Superpartner unterschiedliche Eigenschaften annahmen.“"
                            },
                            {
                                "example_id": "aec52952-ff90-4525-bb57-f46a55f31a3c",
                                "sense_id": "8af7968c-d29d-3479-b37f-07207917691d",
                                "text": "„Denn der grösste Teil der Wärmekapazität dieses Speichers entfällt auf die Latentwärme, die bei der Zustandsänderung zwischen Eis und Wasser ohne Temperaturveränderung anfällt.“"
                            },
                            {
                                "example_id": "30ce620a-203e-4c2c-ae62-7f41c7efa993",
                                "sense_id": "8af7968c-d29d-3479-b37f-07207917691d",
                                "text": "„Dabei handelt es sich um eine Zustandsänderung eines nichtlinearen Systems, die auftritt, wenn ein entscheidender Systemparameter einen kritischen Wert annimmt.“"
                            },
                            {
                                "example_id": "d86e8011-82c1-4b78-86bd-977505549121",
                                "sense_id": "8af7968c-d29d-3479-b37f-07207917691d",
                                "text": "„Der Sensor meldet sich nur dann, wenn eine Zustandsänderung eintritt, denn aus dieser bezieht er ja seine Energie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
