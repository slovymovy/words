                                "target_senses": [
                                    {
                                        "sense_id": "f300f660-e9fa-3726-a8f4-85a20e003c49",
                                        "entry_id": "2d7ae946-9067-3027-8c08-f5451160e6a5",
                                        "glosses": [
                                            "Arme incendiaire artisanale dont le composant principal est une bouteille en verre en partie remplie de liquide inflammable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "715f4eb7-2c30-40ef-a43a-c8cb8cc63c56",
                                                "sense_id": "f300f660-e9fa-3726-a8f4-85a20e003c49",
                                                "text": "Pour pallier le manque d’armes antichars, ils inventent également une bombe de fortune, le « cocktail Molotov », baptisée du nom de l’homme qu’ils détestaient le plus : le Premier ministre soviétique."
                                            },
                                            {
                                                "example_id": "df82a103-33da-4c90-8526-89ea46be3664",
                                                "sense_id": "f300f660-e9fa-3726-a8f4-85a20e003c49",
                                                "text": "Le juge à qui est confiée l’affaire est également chargé d’instruire une information contre X pour « provocation publique, non suivie d’effet, à incendie volontaire » ; il s’agit du bulletin donnant la recette du cocktail Molotov."
                                            },
                                            {
                                                "example_id": "f6f00d00-a379-428d-bdf8-0a5a31b111db",
                                                "sense_id": "f300f660-e9fa-3726-a8f4-85a20e003c49",
                                                "text": "Car la chanson a été importante dans le dispositif d’une subversion politique qui, tout compte fait, a peut-être plus avancé par le 45 tours que par le tract, par le mange-disques que par le cocktail Molotov."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
