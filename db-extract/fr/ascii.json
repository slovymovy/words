                                        "glosses": [
                                            "Acronym of American Standard Code for Information Interchange."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "acronym",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "def0ef40-2ba5-44c4-8900-3b0b67ad8795",
                                                "sense_id": "cd1c1b15-b2a3-370b-8d87-4eb75e18636a",
                                                "text": "Thus, to translate an EBCDIC message into an ASCII one we need a table with 256 one-byte entries. In each position we put the ASCII code that corresponds to that EBCDIC entry."
                                            },
                                            {
                                                "example_id": "b87c6941-a2b0-4ccb-a898-a458f9863467",
                                                "sense_id": "cd1c1b15-b2a3-370b-8d87-4eb75e18636a",
                                                "text": "In 1960 American Standard Code for Information Exchange (ASCII) was developed from telegraphic codes."
                                            }
                                        ]
