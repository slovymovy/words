                "senses": [
                    {
                        "sense_id": "c144207a-a7c7-3bb6-b3e6-e092204f809f",
                        "entry_id": "14069177-2f21-3f21-b81b-9bce584bb04b",
                        "glosses": [
                            "Orner de vignette."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "12aa6979-4bf2-3f32-9f7d-24b7e5c84b0c",
                        "entry_id": "14069177-2f21-3f21-b81b-9bce584bb04b",
                        "glosses": [
                            "Créer sur la photo une périphérie sombre en photographiant quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47946eb6-96ac-4247-bf04-9731cbf28dad",
                                "sense_id": "12aa6979-4bf2-3f32-9f7d-24b7e5c84b0c",
                                "text": "Attention alors à la prise de vue en alonge minimum ( + de 1,20 m environ), vous risquez de vignetter en photographiant la couronne frontale du hublot."
                            },
                            {
                                "example_id": "71fa8288-9d4c-4b89-8d77-57a1023b9f28",
                                "sense_id": "12aa6979-4bf2-3f32-9f7d-24b7e5c84b0c",
                                "text": "L'exposition par contact se fera à la lumière artificielle, à une distance d'au moins un demi-mètre, mais quand on désire vignetter l'image, cette distance doit ètre augmentée à un ou mème deux mètres, pour empècher des ombres dures autour de la vignette."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d1e0bb1-10cd-3ee0-9d66-880ef73d6a71",
                        "entry_id": "14069177-2f21-3f21-b81b-9bce584bb04b",
                        "glosses": [
                            "Coller une vignette sur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "247e95a5-26b7-49d8-bf84-482a16913ad9",
                                "sense_id": "8d1e0bb1-10cd-3ee0-9d66-880ef73d6a71",
                                "text": "La Régie des Contributions indirectes a donc maintenant un arrêt interprétant la loi de 1916 et elle va pouvoir réclamer aux fabricants de spécialités vétérinaires qui n'ont pas vignetté leurs produits."
                            }
                        ]
                    }
