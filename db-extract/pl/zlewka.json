                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "стакан",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3934ab71-8469-32d9-84b9-de40ed06d021",
                                        "entry_id": "65b6083e-5321-36d3-a429-940cea4e7b50",
                                        "glosses": [
                                            "сосуд для питья, обычно стеклянный, цилиндрической или конической формы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84641506-8fd2-4281-b1bd-5a30198f5249",
                                                "sense_id": "3934ab71-8469-32d9-84b9-de40ed06d021",
                                                "text": "Один раз мать вышла со двора, а старший мальчик Миша полез за хлебом на полку, уронил стакан и разбил его."
                                            },
                                            {
                                                "example_id": "39d552ce-1e20-40bf-9e98-4e015ec67635",
                                                "sense_id": "3934ab71-8469-32d9-84b9-de40ed06d021",
                                                "text": "Пётр принял заскорузлыми пальцами стакан, медленно выпил водку, вытер губы ладонью и стал грызть огурец."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e8b8960-f3a7-351f-b08c-03500c90aa40",
                                        "entry_id": "65b6083e-5321-36d3-a429-940cea4e7b50",
                                        "glosses": [
                                            "перен. количество жидкого или сыпучего вещества, вмещающееся в такой сосуд"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45e03fb1-e64a-4b45-a6f1-fdc950625f0c",
                                                "sense_id": "9e8b8960-f3a7-351f-b08c-03500c90aa40",
                                                "text": "Хозяин и его приближённые сидели в углу, выпивая стакан за стаканом и любуясь весёлостию молодёжи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b15418f4-e88b-33b7-a7b3-7e5d06ca7661",
                                        "entry_id": "65b6083e-5321-36d3-a429-940cea4e7b50",
                                        "glosses": [
                                            "воен. гильза артиллерийского снаряда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc63b4db-28cc-4857-8262-c6facccb2f15",
                                                "sense_id": "b15418f4-e88b-33b7-a7b3-7e5d06ca7661",
                                                "text": "С начала войны стал этот завод изготовлять стаканы артиллерийских снарядов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88a6830e-2879-3f20-a27b-464782551114",
                                        "entry_id": "65b6083e-5321-36d3-a429-940cea4e7b50",
                                        "glosses": [
                                            "техн. полая деталь цилиндрической формы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "442c68cb-f1de-4f5e-a1fd-2bc801501474",
                                                "sense_id": "88a6830e-2879-3f20-a27b-464782551114",
                                                "text": "Внутри цилиндра двигается поршень, то есть металлический стакан несколько меньших размеров, обточенный с своей наружной стороны и пригнанный к цилиндру вплотную таким образом, что воздух не может проходить между стенками цилиндра и поршня."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b10737ab-ab10-374f-b454-d771718f2235",
                                        "entry_id": "65b6083e-5321-36d3-a429-940cea4e7b50",
                                        "glosses": [
                                            "перен., жарг. одиночная камера в автозаке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25d8bd73-5d36-4d0b-b633-4a450962c56d",
                                                "sense_id": "b10737ab-ab10-374f-b454-d771718f2235",
                                                "text": "Меня сажают в стакан, лишь иногда в общую (длинная лавка за дверью решёткой — предмет зависти попавших в стакан зэков. Все хотят сидеть в общей, никто не хочет сидеть в стакане)… В стакан так в стакан. Однажды в конце июля я ехал один в стакане из облсуда,.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37a2fbec-3eea-33aa-bb8e-4da430c0cf54",
                                        "entry_id": "65b6083e-5321-36d3-a429-940cea4e7b50",
                                        "glosses": [
