                ],
                "senses": [
                    {
                        "sense_id": "a77d3281-bc06-3153-bf6b-fb1355db39d2",
                        "entry_id": "3ba0d114-74db-347c-b87d-bd7af5d02358",
                        "glosses": [
                            "Faire cesser le fait d’être absorbé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b9d375-d381-448f-bdb8-9a155423e7a0",
                                "sense_id": "a77d3281-bc06-3153-bf6b-fb1355db39d2",
                                "text": "Elle peut toujours se faire « désabsorber », que je sache."
                            },
                            {
                                "example_id": "9c6a9f86-b67a-451c-b152-0e0ce2096a04",
                                "sense_id": "a77d3281-bc06-3153-bf6b-fb1355db39d2",
                                "text": "Différentiel au sein de l’universel, c’est de là qu’on commence la torsion et la contorsion d’un discours qui puisse nous désabsorber de nous-mêmes."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a978f44-a66c-3fcd-8d62-5e1f63f942cb",
                        "entry_id": "3ba0d114-74db-347c-b87d-bd7af5d02358",
                        "glosses": [
                            "Cesser d’être absorbé."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "709759c1-e90e-4ddf-9fdb-c535714201a8",
                                "sense_id": "6a978f44-a66c-3fcd-8d62-5e1f63f942cb",
                                "text": "Julien se désabsorbe à regret de sa contemplation alphabétique et plafonnière, récite béat : je lis tu lis nous lisons, buvez du lait de bison."
                            }
                        ]
                    }
                ],
