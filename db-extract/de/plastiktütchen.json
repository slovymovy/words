                        "examples": [
                            {
                                "example_id": "af468fc1-9d99-4731-be13-244946fbebae",
                                "sense_id": "320fad28-82fa-396e-8f85-58de005f1c52",
                                "text": "„Nach außen hin sahen sie wie zwei Plastiktütchen Ketchup aus einem Fast-Food-Restaurant aus.“"
                            },
                            {
                                "example_id": "99a7842d-0670-446d-9584-c867509402bc",
                                "sense_id": "320fad28-82fa-396e-8f85-58de005f1c52",
                                "text": "„Genau in dem Moment kam der Bankdrücker herein und gab dem Verkäufer einen Fünfer, der überreichte ihm dafür ein Plastiktütchen mit Jetons.“"
                            },
                            {
                                "example_id": "1ce310d3-0c0c-459c-87e6-4f85f6969322",
                                "sense_id": "320fad28-82fa-396e-8f85-58de005f1c52",
                                "text": "„Sie sehen weitere Kleindealer, die sich beeilen, ihre Plastiktütchen fortzuwerfen oder in die Eingänge zu huschen.“"
                            },
                            {
                                "example_id": "26412a70-a696-492a-aae0-9e4cfec47736",
                                "sense_id": "320fad28-82fa-396e-8f85-58de005f1c52",
                                "text": "„Jimmy holte ein Plastiktütchen aus seinem Koffer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
