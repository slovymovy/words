                        "entry_id": "55fafb7b-5dc6-36b6-984f-deb5498e09dc",
                        "glosses": [
                            "Épouse d’un orfèvre."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
