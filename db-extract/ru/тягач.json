                                    },
                                    {
                                        "sense_id": "658fe845-a479-3d02-8b25-1f6eac004c58",
                                        "entry_id": "ad7c309f-ae41-3250-953f-b3544e00efdc",
                                        "glosses": [
                                            "A truck (or lorry) for pulling a semi-trailer or trailer."
                                        ],
