                        "glosses": [
                            "A fat person or thing."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "dc7a9179-d45b-4214-b4cf-3f1022f46c02",
                                "sense_id": "37bca553-6557-3ba3-a38a-7c4e1d7e5010",
                                "text": "The most famous of all the animals of Mauritius is a large, gentle dove. A remarkably large dove, in fact: its weight is closest to that of a well-fed turkey. Its wings long ago gave up the idea of lifting such a plumpy off the ground, and withered away into decorative little stumps."
                            },
                            {
                                "example_id": "db5e8c51-9fc7-4b49-ac3e-fe706fcc7dbe",
                                "sense_id": "37bca553-6557-3ba3-a38a-7c4e1d7e5010",
                                "text": "It was ladies' league night at the bowling alley, and when he stood in the bar looking out at the lanes he picked out her trim figure on lane 7 in a gaggle of plumpies."
                            }
                        ]
                    }
