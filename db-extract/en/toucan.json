                ],
                "senses": [
                    {
                        "sense_id": "56326dd8-92d0-3fd5-b4a2-1200b4bf50ce",
                        "entry_id": "2d72b1df-2574-3636-af7d-376cab276d26",
                        "glosses": [
                            "Any of various neotropical frugivorous birds from the family Ramphastidae, with a large colorful beak."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc851724-8cce-462c-bcc2-5d4fd4c39cc3",
                                "sense_id": "56326dd8-92d0-3fd5-b4a2-1200b4bf50ce",
                                "text": "The ear, small and shapely, the arch of the foot, the curve in mouth and nostril, even the indurated hand dyed to the orange-tawny of the toucan's bill, a hand telling alike of the halyards and tar-bucket;"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dc29642-3950-4511-a91a-41858416d04e",
                        "source_entry_id": "2d72b1df-2574-3636-af7d-376cab276d26",
                        "source_sense_id": "56326dd8-92d0-3fd5-b4a2-1200b4bf50ce",
                        "source_sense_description": "Ramphastid",
                        "target_lang_word": "tukan",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tukan",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c2745e31-2f99-36fe-8bfb-79c552a0c571",
                                        "entry_id": "5cd03f37-6ed4-3e48-a627-b92d6ae99005",
                                        "glosses": [
                                            "rod ptáků s dlouhým, mohutným a barevným zobákem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c774854-0fcb-4c8b-b884-174741ce4a38",
                                                "sense_id": "c2745e31-2f99-36fe-8bfb-79c552a0c571",
                                                "text": "Drží-li se peří takové proti světlu, vypadá jinak nežli ve světle odraženém. Příčina leží v jemné tkani mikroskopicky malých buněk, jejichž stěny jsou nesmírně jemně ryhovány (arara, trupial, tukan a j.)."
                                            },
                                            {
                                                "example_id": "2f4760b1-274d-4929-9b83-b84b1fafa55f",
                                                "sense_id": "c2745e31-2f99-36fe-8bfb-79c552a0c571",
                                                "text": "Ještě den před narozeninami Karin jsem běhal po Mnichově a žebral o osvícení. Až jsem se ocitl v jednom vetešnictví nedaleko Marienplatzu. Nemáte něco neobyčejného, co bych mohl darovat ženě z Dolního Bavorska k narozeninám? zeptal jsem se majitele. Beze slov přede mne postavil tukana z porcelánu. Toho ptáka se žlutým zobákem, který je větší než sám pták. Mám čtyři, řekl. Zvedl významně obočí a nechal vypochodovat tři další porcelánové tukany. Každý tukan házel jinou pózu, ale jinak byli stejně velcí a zbarvení. Koupil jsem všechny. Mohl jsem Karin přepadnout se čtyřmi tukany..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a816a1c9-08a2-4bac-8505-a061b94859a5",
                        "source_entry_id": "2d72b1df-2574-3636-af7d-376cab276d26",
                        "source_sense_id": "56326dd8-92d0-3fd5-b4a2-1200b4bf50ce",
