                        "examples": [
                            {
                                "example_id": "375c77fa-3dae-4fc8-8c6f-182c633f0f41",
                                "sense_id": "90cbcf80-f862-383a-bbf0-3446fa844417",
                                "text": "\"C’est un film gore pour toute la famille\", déclarait Peter Jackson en 1992. Ne le prenez pas au mot : si le film baigne bien dans un flot d’hémoglobine avec moult étripages, mutilations et écrabouillements, son côté \"familial\" est à prendre au quatrième degré. Il s’agit surtout d’une rencontre hallucinante et réjouissante entre Freud et le film de zombies."
                            }
                        ]
                    }
