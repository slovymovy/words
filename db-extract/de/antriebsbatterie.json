                "senses": [
                    {
                        "sense_id": "5b16ff0c-0aeb-3ed3-a244-99be4437074a",
                        "entry_id": "3d05fd70-940c-305e-ab29-ef0e478e9719",
                        "glosses": [
                            "„mobiler elektrischer Energiespeicher, der vorzugsweise zum Antrieb von Elektrofahrzeugen dient“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b9ea125-ab56-44fb-ac5b-026b1b3ddf11",
                                "sense_id": "5b16ff0c-0aeb-3ed3-a244-99be4437074a",
                                "text": "„In der Richtlinie werden die sicherheitstechnischen Anforderungen an die Antriebsbatterie des Gesamtfahrzeugs definiert.“"
                            },
                            {
                                "example_id": "ad50a365-7e16-443b-90ab-bed83c78bb73",
                                "sense_id": "5b16ff0c-0aeb-3ed3-a244-99be4437074a",
                                "text": "„Die fest mit den Autos verwachsenen Antriebsbatterien sind niemals solche speichernden ‚Verbraucher-Kapazitäten‘, weil sie nicht geduldig sind.“"
                            },
                            {
                                "example_id": "f276630a-1e44-40c2-bad1-562a1f08d05a",
                                "sense_id": "5b16ff0c-0aeb-3ed3-a244-99be4437074a",
                                "text": "„Huynh ermittelte die Innenwiderstände der Antriebsbatterie für zahlreiche BEV, die in Abhängigkeit der Batterietemperatur.“"
                            },
                            {
                                "example_id": "a4f6a5e4-5fc6-42c9-9dde-916c0f344d35",
                                "sense_id": "5b16ff0c-0aeb-3ed3-a244-99be4437074a",
                                "text": "„Antriebsbatterien und Schlüsselkomponenten insgesamt gesehen das fortschrittliche internationale Niveau erreichen.“"
                            },
                            {
                                "example_id": "2e3dc18b-164c-48aa-a6fc-9339de973b6e",
                                "sense_id": "5b16ff0c-0aeb-3ed3-a244-99be4437074a",
                                "text": "„Da die Antriebsbatterien für Elektrofahrzeuge im Unterboden verbaut werden, ergibt sich diesbezüglich eine besondere Herausforderung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
