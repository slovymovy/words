                "senses": [
                    {
                        "sense_id": "2c910370-588a-3231-8a53-73bf018093c9",
                        "entry_id": "49f95477-cbf3-3f39-9ac0-19fdaeb9f02e",
                        "glosses": [
                            "juristische Laiin, die ehrenamtlich an der Urteilsfindung im Rahmen von Strafverfahren beteiligt ist"
                        ],
                        "tags": [
                            "in Deutschland"
                        ],
                        "examples": [
                            {
                                "example_id": "dacfc264-2ea4-4234-86de-c6c79feaf52b",
                                "sense_id": "2c910370-588a-3231-8a53-73bf018093c9",
                                "text": "Claudia giert danach, ihrem Gerechtigkeitssinn in ihrer Eigenschaft als Schöffin endlich adäquat Ausdruck zu verleihen."
                            },
                            {
                                "example_id": "84eebf53-ab8a-4803-af55-1f4cbc33778a",
                                "sense_id": "2c910370-588a-3231-8a53-73bf018093c9",
                                "text": "Ihre Berufung zur Schöffin stellte für Claudia den bisher freudigsten Moment ihres Lebens dar."
                            },
                            {
                                "example_id": "89d1dd68-d132-4349-b927-406ec5a5bd12",
                                "sense_id": "2c910370-588a-3231-8a53-73bf018093c9",
                                "text": "Claudia reißt sich darum, Schöffin zu werden."
                            },
                            {
                                "example_id": "fb4067af-8cd0-43ac-b332-ff2da497fc86",
                                "sense_id": "2c910370-588a-3231-8a53-73bf018093c9",
                                "text": "Das Dasein als Schöffin ist für Claudia das hehrste aller Ziele."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
