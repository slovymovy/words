                                        "sense_id": "09907620-b689-3f69-9f1e-6e359bbf3af3",
                                        "entry_id": "ce44bbb8-d90c-30b5-955b-6270f70fe031",
                                        "glosses": [
                                            "A topical medical preparation intended to be rubbed into the skin with friction, as for example to relieve symptoms of arthritis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f076a241-94df-4267-aeb3-bd2358c2eb7c",
                                                "sense_id": "09907620-b689-3f69-9f1e-6e359bbf3af3",
                                                "text": "Denton (Dan Duryea): You're a peddler, aren't you? / Henry J. Fate (Malcolm Atterbury): Oh yes, dealer in everything. Utensils, herbs, medicine, liniments and tonics, farm implements, clothing, and potions."
                                            }
                                        ]
                                    }
                                ]
                            },
