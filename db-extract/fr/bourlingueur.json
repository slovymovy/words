        "fr-extract.jsonl": [
            {
                "entry_id": "bec3bc83-494b-3bd4-8b08-a8412230d0d0",
                "word": "bourlingueur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dbea220a-4a92-4dc8-a743-85bba9f46e7e",
                        "entry_id": "bec3bc83-494b-3bd4-8b08-a8412230d0d0",
                        "tags": [
                            "plural"
                        ],
                        "form": "bourlingueurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "002e230a-c072-36ab-b598-6a17e394c792",
                        "entry_id": "bec3bc83-494b-3bd4-8b08-a8412230d0d0",
                        "glosses": [
                            "(Terme historiquement marin) Marin qui prend la mer par gros temps et dont le navire chahuté est soumis à des manœuvres complexes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "da1d348b-34fd-35b6-9fcc-2da34a8d189e",
                        "entry_id": "bec3bc83-494b-3bd4-8b08-a8412230d0d0",
                        "glosses": [
                            "Aventurier ou quelqu’un qui voyage beaucoup."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a4a1b33e-f845-4f2c-b90d-c3320a09ecf0",
                                "sense_id": "da1d348b-34fd-35b6-9fcc-2da34a8d189e",
                                "text": "Je l’interrogeai en pidgin, la langue internationale des bourlingueurs de l’immense Pacifique et du non moins vaste Océan Indien : […]."
                            },
                            {
                                "example_id": "bcf7089b-d6c1-49de-85cc-1a62719139bd",
                                "sense_id": "da1d348b-34fd-35b6-9fcc-2da34a8d189e",
                                "text": "Un bourlingueur sait emporter tout ce qui lui est nécessaire dans un volume réduit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a980b51-4e63-4288-8887-0c86896fa8d1",
                        "source_entry_id": "bec3bc83-494b-3bd4-8b08-a8412230d0d0",
                        "target_lang_word": "globetrotter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "globetrotter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "108e1a7d-e5f9-3337-a2aa-af59659dfaa1",
                                        "entry_id": "e130b4e3-f510-3e3c-9438-b18bfb78ee2e",
                                        "glosses": [
                                            "A person who travels often to faraway places."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81fc0171-8e20-49f8-a36e-2e22665b7d25",
                                                "sense_id": "108e1a7d-e5f9-3337-a2aa-af59659dfaa1",
                                                "text": "Word-painting has become a science, and almost every corner of the globe has been described and traversed by that genus homo, the inevitable \"globe-trotter\"."
                                            },
                                            {
                                                "example_id": "f491e55b-811d-4cb9-977d-779c8d5c86e3",
                                                "sense_id": "108e1a7d-e5f9-3337-a2aa-af59659dfaa1",
                                                "text": "Globe-trotters who expect entertainment as a right, have, even within my memory, blunted this open-heartedness, but, none the less, to-day if you belong to the Inner Circle and are neither a bear nor a black sheep all houses are open to you and our small world is very kind and helpful."
                                            },
                                            {
                                                "example_id": "af88b7d2-20b1-4041-b60c-1683e1da740c",
                                                "sense_id": "108e1a7d-e5f9-3337-a2aa-af59659dfaa1",
                                                "text": "“Any ship is that—for a reasonable man,” generalised Marlow in a conciliatory tone. “A sailor isn’t a globetrotter.”"
                                            },
                                            {
                                                "example_id": "f3fa731c-e2e2-4eec-8803-e56ff53d5925",
                                                "sense_id": "108e1a7d-e5f9-3337-a2aa-af59659dfaa1",
                                                "text": "Possibly perceiving an expression of dubiosity on their faces the globetrotter went on, adhering to his adventures. —And I seen a man killed in Trieste by an Italian chap. Knife in his back. Knife like that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71338ce2-79e2-41dc-b3e3-59f54b922a9a",
                        "source_entry_id": "bec3bc83-494b-3bd4-8b08-a8412230d0d0",
                        "target_lang_word": "traveller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traveller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9873dae3-4387-3ece-8946-e02bd0988c89",
                                        "entry_id": "139ca37c-f54e-3191-8eba-e56c58e7e86e",
                                        "glosses": [
                                            "One who travels, especially to distant lands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e215b910-7170-43c7-8049-1ab1c6114d32",
                                                "sense_id": "9873dae3-4387-3ece-8946-e02bd0988c89",
                                                "text": "They were faire Ladies, till they fondly ſtriu’d / With th’Heliconian maides for mayſtery; / Of whom they ouer-comen, were depriu’d / Of their proud beautie, and th’one moyity / Transform’d to fiſh, for their bold ſurquedry, / But th’vpper halfe their hew retayned ſtill, / And their ſweet skill in wonted melody; / Which euer after they abuſd to ill, / T’allure weake traueillers, whom gotten they did kill."
                                            },
                                            {
                                                "example_id": "a452c681-41ad-45a8-9178-c7ec2ebdd127",
                                                "sense_id": "9873dae3-4387-3ece-8946-e02bd0988c89",
                                                "text": "This Book will make a Travailer of thee, / If by its Counſel thou wilt ruled be; / It will direct thee to the Holy Land, / If thou wilt its Directions understand: / Yea, it will make the ſloathful, active be; / The Blind alſo, delightful things to ſee."
                                            },
                                            {
                                                "example_id": "14048ee6-5a2c-4f99-ac00-bb22b829551a",
                                                "sense_id": "9873dae3-4387-3ece-8946-e02bd0988c89",
                                                "text": "The desert storm was riding in its strength; the travellers lay beneath the mastery of the fell simoom. Whirling wreaths and columns of burning wind, rushed around and over them."
                                            },
                                            {
                                                "example_id": "f7dabe55-957c-4bd7-9193-844e322a48fa",
                                                "sense_id": "9873dae3-4387-3ece-8946-e02bd0988c89",
                                                "text": "Surrounding the Taklamakan on three sides are some of the highest mountain ranges in the world, with the Gobi desert blocking the fourth. Thus even the approaches to it are dangerous. Many travellers have perished on the icy passes which lead down to it from Tibet, Kashmir, Afghanistan and Russia, either by freezing to death or by missing their foothold and hurtling into a ravine below. In one disaster, in the winter of 1839, an entire caravan of forty men was wiped out by an avalanche, and even now men and beasts are lost each year.\nNo traveller has a good word to say for the Taklamakan. Sven Hedin, one of the few Europeans to have crossed it, called it ‘the worst and most dangerous desert in the world’. Stein, who came to know it even better, considered the deserts of Arabia 'tame' by comparison. Sir Percy Sykes, the geographer, and one-time British Consul-General at Kashgar, called it 'a Land of Death', while his sister Ella, herself a veteran desert traveller, described it as 'a very abomination of desolation'.\nApart from the more obvious perils, such as losing one’s way and dying of thirst, the Taklamakan has special horrors to inflict on those who trespass there. In his book Buried Treasures of Chinese Turkestan, von Le Coq describes the nightmare of being caught in that terror of all caravans, the kara-buran, or black hurricane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ec16e20-8a76-3765-9f61-9bb2d5367e1f",
                                        "entry_id": "139ca37c-f54e-3191-8eba-e56c58e7e86e",
                                        "glosses": [
                                            "A salesman who travels from place to place on behalf of a company."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4470892a-2970-3378-9efb-092741168abd",
                                        "entry_id": "139ca37c-f54e-3191-8eba-e56c58e7e86e",
                                        "glosses": [
                                            "Someone who lives (particularly in the UK) in a caravan, bus or other vehicle rather than a fixed abode."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0450440f-9c15-3f72-be23-c66b63563f61",
                                        "entry_id": "139ca37c-f54e-3191-8eba-e56c58e7e86e",
                                        "glosses": [
                                            "Alternative letter-case form of Traveller."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "885908e0-391f-4e0a-9ccf-4de711070af8",
                                                "sense_id": "0450440f-9c15-3f72-be23-c66b63563f61",
                                                "text": "It provoked criticism for its portrayal of a woman who leaves her marriage for life with a solitary traveler. Irish women did not do those sorts of things, the audiences felt (although the plot came from a story told to Synge on Inis Meain)."
                                            },
                                            {
                                                "example_id": "78b59335-cb89-4bbb-b275-5bf71fd8e178",
                                                "sense_id": "0450440f-9c15-3f72-be23-c66b63563f61",
                                                "text": "Kevin chases after him through a forest and finds the horse with Joseph Maguire (Ian Holm), a poetry-reciting traveler (Irish gypsy)."
                                            },
                                            {
                                                "example_id": "1d971497-523b-4922-9569-2bc4fe446ef3",
                                                "sense_id": "0450440f-9c15-3f72-be23-c66b63563f61",
                                                "text": "...settled Irish people of Southern Ireland treat the traveler boys with racist hostility (2001 180–81)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978e5cfc-d677-34d7-86c2-1125d702058d",
                                        "entry_id": "139ca37c-f54e-3191-8eba-e56c58e7e86e",
                                        "glosses": [
                                            "A list and record of instructions that follows a part in a manufacturing process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0da8d3f3-b4a0-395a-bb2f-570c274dff54",
                                        "entry_id": "139ca37c-f54e-3191-8eba-e56c58e7e86e",
                                        "glosses": [
                                            "One of the wires connecting the two members of a pair of three-way switches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7333b4d6-6695-3b5e-8109-fe1347da6c53",
                                        "entry_id": "139ca37c-f54e-3191-8eba-e56c58e7e86e",
                                        "glosses": [
                                            "A metal ring that moves freely on part of a ship’s rigging."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dab6765-8c9a-3fc7-a95f-cea419a8fb30",
                                        "entry_id": "139ca37c-f54e-3191-8eba-e56c58e7e86e",
                                        "glosses": [
                                            "A rail or track for a sliding curtain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "569dda92-dfa1-4fea-bd16-513d3891820f",
                                                "sense_id": "2dab6765-8c9a-3fc7-a95f-cea419a8fb30",
                                                "text": "That would detract from the austerity of Rudkin's study, and a curtain on a traveler is always slid across the stage […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf442e1c-e119-3f44-ba4a-555219b1a289",
                                        "entry_id": "139ca37c-f54e-3191-8eba-e56c58e7e86e",
                                        "glosses": [
                                            "A sheet of paper that is circulated with the board of cards, on which players record their scores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20b1e295-395d-4391-97d2-f324902d4d5e",
                                                "sense_id": "bf442e1c-e119-3f44-ba4a-555219b1a289",
                                                "text": "At the conclusion of play, the scores from all the travelers get entered into a computer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "366b306f-b154-3e77-9af3-4f3e1098d993",
                                        "entry_id": "139ca37c-f54e-3191-8eba-e56c58e7e86e",
                                        "glosses": [
                                            "A styrofoam cup filled with liquor and usually ice, to be taken away from a place."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4436e20-0857-4864-b481-218e016e6241",
                                                "sense_id": "366b306f-b154-3e77-9af3-4f3e1098d993",
                                                "text": "Nowhere else in the world had I seen such gigantic measures of liquor poured, such widespread enthusiasm for Bloodies and Mimosas on weekend mornings, or such firm insistence on giving sixteen-ounce Styrofoam cups loaded with iced liquor to guests leaving a party, so they might have a \"traveler\" for the drive home.\nAt a bar in Yazoo City, the bartender asked me if I wanted to \"go tall\" with my bourbon on the rocks. I didn't know what he meant, but it sounded encouraging. \"Sure,\" I said, \"Let's go tall.\" He filled up a pint glass with ice. Then he filled it to the brim with bourbon. When I got up to leave with about half the drink gone, he poured the rest of it into a Styrofoam cup, assuming I would want a traveler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b050b399-b22a-4866-b1d7-5d3a12de4160",
