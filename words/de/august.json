                    "sense_definition": "der achte Monat des Kalenderjahres mit 31 Tagen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im <w>August</w> haben die meisten Schulkinder Sommerferien.",
                            "target_lang_translations": {
                                "en": "In <w>August</w>, most school children have summer vacation.",
                                "ru": "В <w>августе</w> у большинства школьников летние каникулы.",
                                "nl": "In <w>augustus</w> hebben de meeste schoolkinderen zomervakantie.",
                                "pl": "W <w>sierpniu</w> większość uczniów ma wakacje letnie.",
                                "fr": "En <w>août</w>, la plupart des écoliers ont leurs vacances d'été.",
                                "it": "Ad <w>agosto</w> la maggior parte degli scolari ha le vacanze estive.",
                                "cs": "V <w>srpnu</w> má většina školáků letní prázdniny.",
                                "tr": "<w>Ağustosta</w> çoğu öğrencinin yaz tatili vardır.",
                                "es": "En <w>agosto</w>, la mayoría de los escolares tienen vacaciones de verano.",
                                "zh": "在<w>八月</w>，大多数学生都放暑假。"
                            }
                        },
                        {
                            "text": "Wir fahren Mitte <w>August</w> für zwei Wochen ans Meer.",
                            "target_lang_translations": {
                                "en": "We are going to the sea for two weeks in mid-<w>August</w>.",
                                "ru": "В середине <w>августа</w> мы едем на две недели к морю.",
                                "nl": "We gaan half <w>augustus</w> voor twee weken naar zee.",
                                "pl": "W połowie <w>sierpnia</w> jedziemy na dwa tygodnie nad morze.",
                                "fr": "Nous partons deux semaines à la mer à la mi-<w>août</w>.",
                                "it": "Andiamo al mare per due settimane a metà <w>agosto</w>.",
                                "cs": "V polovině <w>srpna</w> jedeme na dva týdny k moři.",
                                "tr": "<w>Ağustos</w> ortasında iki haftalığına denize gidiyoruz.",
                                "es": "Vamos al mar durante dos semanas a mediados de <w>agosto</w>.",
                                "zh": "我们<w>八月</w>中旬去海边待两周。"
                            }
                        }
                    ],
