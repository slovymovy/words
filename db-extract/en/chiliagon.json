                ],
                "senses": [
                    {
                        "sense_id": "f217674e-cf81-3d4a-9e0e-f7a5a68f5990",
                        "entry_id": "092dc8b7-3cff-3552-ac3d-35a98dd61efd",
                        "glosses": [
                            "A polygon with a thousand vertices and a thousand edges."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9b16fc2d-eea6-4ad9-bb33-54d6a73ae693",
                                "sense_id": "f217674e-cf81-3d4a-9e0e-f7a5a68f5990",
                                "text": "If Kant's claim is just that it is impossible to have a sensory experience of the absence of space, then by contrast it is not impossible to have a sensory experience of a chiliagon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5821e4f3-849e-4cc3-af88-29d148bfcf66",
                        "source_entry_id": "092dc8b7-3cff-3552-ac3d-35a98dd61efd",
                        "source_sense_id": "f217674e-cf81-3d4a-9e0e-f7a5a68f5990",
                        "source_sense_description": "1000-sided polygon",
                        "target_lang_word": "tisíciúhelník",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ecdf4192-b56f-49b0-9fdc-9e4f950e5fac",
                        "source_entry_id": "092dc8b7-3cff-3552-ac3d-35a98dd61efd",
                        "source_sense_id": "f217674e-cf81-3d4a-9e0e-f7a5a68f5990",
                        "source_sense_description": "1000-sided polygon",
                        "target_lang_word": "duizendhoek",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duizendhoek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "90aaa949-6ce2-3ab4-81dd-af2683f9d085",
                                        "entry_id": "a7dfac68-f9db-33e5-98ed-04ff818e5597",
                                        "glosses": [
                                            "meetkundige figuur met duizend hoeken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89213ab3-7b36-44de-bad8-7ee5f11ba6dd",
                                                "sense_id": "90aaa949-6ce2-3ab4-81dd-af2683f9d085",
                                                "text": "Als ik je vraag om je een cirkel binnen een duizendhoek binnen een cirkel binnen een duizendhoek binnen een cirkel voor te stellen, zodat je een soort schietschijf maakt, zie je dan in je mentale beeld wat de cirkels zijn en wat de duizendhoeken?"
                                            },
                                            {
                                                "example_id": "9a33b9c9-5087-406d-b108-a290702ecb85",
                                                "sense_id": "90aaa949-6ce2-3ab4-81dd-af2683f9d085",
                                                "text": "Men kan zich een gelijkzijdigen vierhoek, zeshoek, agthoek, en misschien een twaalfhoek verbeelden: maar, wiens verbeelding bevat een duizendhoek? zou men, volgens de oude gewoonte, niet zeggen, een duizendhoek begrijp ik niet, het is een herssenschim."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49f90f7a-1d5e-4825-8cb6-bc5c063ebe0f",
                        "source_entry_id": "092dc8b7-3cff-3552-ac3d-35a98dd61efd",
                        "source_sense_id": "f217674e-cf81-3d4a-9e0e-f7a5a68f5990",
                        "source_sense_description": "1000-sided polygon",
                        "target_lang_word": "chiliogone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiliogone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf01089a-df22-39b1-9e17-0480086d8244",
                                        "entry_id": "f849ce88-9e75-3a1e-9754-0216c7b755a2",
                                        "glosses": [
                                            "Figure plane et régulière à mille angles et mille côtés."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b14c90cd-0b5d-48df-99c9-5a65dca9ab6e",
                                                "sense_id": "bf01089a-df22-39b1-9e17-0480086d8244",
                                                "text": "Que si je veux penser à un chiliogone, je conçois bien à la vérité que c’est une figure composée de mille côtés, aussi facilement que je conçois qu’un triangle est une figure composée de trois côtés seulement ; mais je ne puis pas imaginer les mille côtés d'un chiliogone comme je fais les trois d’un triangle, ni pour ainsi dire les regarder comme présents « avec les yeux de mon esprit. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "523e2c87-ae84-4e03-aaca-a9f22361887a",
                        "source_entry_id": "092dc8b7-3cff-3552-ac3d-35a98dd61efd",
                        "source_sense_id": "f217674e-cf81-3d4a-9e0e-f7a5a68f5990",
                        "source_sense_description": "1000-sided polygon",
                        "target_lang_word": "Tausendeck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tausendeck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f67faa6-0a1e-356b-9418-26b2c5d65104",
                                        "entry_id": "92f5baee-c6a2-3782-97b7-80ca6055f6a4",
                                        "glosses": [
                                            "geometrische Figur mit tausend Ecken"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6532e1b3-b509-40fe-81fe-3ccd5e91c0e2",
                                                "sense_id": "9f67faa6-0a1e-356b-9418-26b2c5d65104",
                                                "text": "„Schon Descartes hatte auf den Unterschied zwischen imaginatio und intellectio hingewiesen. Wir vermögen uns mit unserem piktoralen Vorstellungsvermögen zwar noch ein Achteck vorzustellen, aber sicher kein Tausendeck mehr.“"
                                            }
                                        ],
