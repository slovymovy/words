                "senses": [
                    {
                        "sense_id": "ca38cd86-3913-348c-b6f0-b0839b9b2f24",
                        "entry_id": "edb90da9-b8c2-3f6b-867e-84e6a7b594ef",
                        "glosses": [
                            "goldene Folie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72088ed9-2f22-4b81-8d70-3d5ad2ee4fda",
                                "sense_id": "ca38cd86-3913-348c-b6f0-b0839b9b2f24",
                                "text": "„Übertrage die Vorlage für die Krone (Teil 1) auf Goldfolie oder Tonpapier und schneide sie aus. Stich die eingezeichneten Löcher durch und befestige ein Gummiband (Abbildung 1).“"
                            },
                            {
                                "example_id": "fbc044ce-950a-4c69-8aba-9698d26e1f91",
                                "sense_id": "ca38cd86-3913-348c-b6f0-b0839b9b2f24",
                                "text": "„Der britische Physiker beschoss eine Goldfolie mit Helium-Atomkernen (so genannten Alphateilchen), um das Innere der Atome zu erkunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
