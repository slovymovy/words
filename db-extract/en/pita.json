                    {
                        "translation_id": "caa088b6-9114-459b-877b-47b2c3ad822e",
                        "source_entry_id": "05a2c468-8942-3811-bde9-2f58ff2cc46f",
                        "source_sense_id": "ec2d7cf8-4d8d-35e7-b4d0-db4e28b9d1f3",
