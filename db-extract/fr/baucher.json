                ],
                "senses": [
                    {
                        "sense_id": "04a97c14-fc27-306b-bbdf-795eb444f21f",
                        "entry_id": "52f9f7c4-51e8-364b-a10e-e9f21a527638",
                        "glosses": [
                            "Ôter, chasser avec sa boule celle de son adversaire."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8cda7273-c7d8-47c6-bc07-720b8ce2ee65",
                                "sense_id": "04a97c14-fc27-306b-bbdf-795eb444f21f",
                                "text": "Baucher une boule. La déplacer par une autre. Je ne connais que le mot tirer ou débuter qui puisse remplacer cette expression : c’est un bon tireur."
                            },
                            {
                                "example_id": "8337804c-f075-468e-bc80-86dda1f49724",
                                "sense_id": "04a97c14-fc27-306b-bbdf-795eb444f21f",
                                "text": "Baucher une boule, c’est la tirer. Mais, au fait, tirer une boule, est-ce que, par hasard, ce ne serait pas encore du lyonnais ? — Peut-être. — La poquer, donc ? Encore plus. Sincèrement, je ne sais comment m’y prendre pour me faire comprendre en français."
                            }
                        ]
                    }
                ],
