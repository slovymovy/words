                "senses": [
                    {
                        "sense_id": "b32892b1-f70b-3aa4-934b-dda34333f53a",
                        "entry_id": "135bfa79-0aa3-3947-857c-2fb83f0e16e5",
                        "glosses": [
                            "то же, что дожидаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe4f7a6f-62e0-44e7-9bd4-a1ce1fe18f2c",
                                "sense_id": "b32892b1-f70b-3aa4-934b-dda34333f53a",
                                "text": "― Катря, скажи Петру Елисеичу, что его дожидает Егор из Самосадки!"
                            },
                            {
                                "example_id": "e2b395be-b9e0-4ff2-bae4-e1ab427c5d29",
                                "sense_id": "b32892b1-f70b-3aa4-934b-dda34333f53a",
                                "text": "Говорят, что вообще лучше идти навстречу беде, чем дожидать её сложа руки."
                            },
                            {
                                "example_id": "07dab791-3862-40f8-a989-34ce2e1f91fc",
                                "sense_id": "b32892b1-f70b-3aa4-934b-dda34333f53a",
                                "text": "― Выпустят или нет? ― Дожидай! Чать, в тюрьму сведут…"
                            }
                        ]
                    }
                ],
