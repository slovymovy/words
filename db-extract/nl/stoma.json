                "senses": [
                    {
                        "sense_id": "6dee8aa2-e50b-3fc6-ad89-dd2441413016",
                        "entry_id": "1c2a8e4f-98a6-3b5e-8487-0d68f85acf0a",
                        "glosses": [
                            "huidmondje, een opening in een blad waar gassen doorheen kunnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee9f1cc-96cc-42a1-abc4-671a09a7fd54",
                                "sense_id": "6dee8aa2-e50b-3fc6-ad89-dd2441413016",
                                "text": "Als het te heet wordt kunnen planten hun stomata sluiten om uitdroging te voorkomen."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb84ebfe-5c5e-3031-b7ed-f3448a7a0ebb",
                        "entry_id": "1c2a8e4f-98a6-3b5e-8487-0d68f85acf0a",
                        "glosses": [
                            "kunstmatige uitgang in het (menselijk) lichaam.\\nDeze uitgang kan zijn voor ontlasting (colostoma of ileostoma), urine (urinestoma of urostoma, of een nefrostoma), gal (galstoma of leverstoma) en ademhaling (tracheostoma)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "621f632c-5e1b-466b-a6ca-8035c3f304ad",
                                "sense_id": "eb84ebfe-5c5e-3031-b7ed-f3448a7a0ebb",
                                "text": "Een stoma van de darmen of urinewegen wordt aangelegd als de ontlasting of urine het lichaam niet meer via de natuurlijke weg kan of mag verlaten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
