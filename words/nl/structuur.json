                },
                {
                    "sense_id": "9c535ebc-79f4-369f-9c83-d0865aa55df9",
                    "sense_definition": "de interne opmaak of textuur van een specifiek materiaal of object",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat is de <w>structuur</w> van dat blad als je het onder een microscoop bekijkt?",
                            "target_lang_translations": {
                                "en": "What is the <w>structure</w> of that leaf when you look at it under a microscope?"
                            }
                        },
                        {
                            "text": "De korrelige <w>structuur</w> van de verf geeft de muur een heel bijzondere uitstraling.",
                            "target_lang_translations": {
