                "senses": [
                    {
                        "sense_id": "18283247-d38a-38b5-9520-abecd30c785d",
                        "entry_id": "fd3e5954-7e93-34a3-90fc-be126aaa21f6",
                        "glosses": [
                            "орнитол. лесная птица семейства бекасовых с рыжевато-бурым оперением и длинным клювом, гнездящаяся в умеренном и субарктическом поясе Евразии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2a0fccc-b59e-4725-917e-5779785415ae",
                                "sense_id": "18283247-d38a-38b5-9520-abecd30c785d",
                                "text": "Плавно размахивая крыльями, над полянкой летит вальдшнеп: это ― тяга, любовная встреча, ухаживание, быть может, объяснение в любви в воздушной синеве."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a18990c9-e16d-48d4-8562-7a83e68101d4",
                        "source_entry_id": "fd3e5954-7e93-34a3-90fc-be126aaa21f6",
                        "source_sense_id": "18283247-d38a-38b5-9520-abecd30c785d",
                        "target_lang_word": "woodcock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "woodcock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f400b654-e02b-3663-9481-1a5c561f5a92",
                                        "entry_id": "0165f9f2-f91c-3506-8e58-0e253c8139b2",
                                        "glosses": [
                                            "Any of several wading birds in the genus Scolopax, characterised by a long slender bill and cryptic brown and blackish plumage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "581394b2-5248-4e67-87d9-832339582a32",
                                                "sense_id": "f400b654-e02b-3663-9481-1a5c561f5a92",
                                                "text": "\"[A]h, that was the woodcock and the goatsucker - yes, yes! it sounds strange to him, that hasn't heard him[.]\""
                                            },
                                            {
                                                "example_id": "fb140a5a-9fd9-4f98-9ddf-2577c492936f",
                                                "sense_id": "f400b654-e02b-3663-9481-1a5c561f5a92",
                                                "text": "The woodcook is not only a culinary delight but it is reputed to increase seminal fluid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec1e3ac0-e984-342c-a1f5-a34adf9d9af0",
                                        "entry_id": "0165f9f2-f91c-3506-8e58-0e253c8139b2",
                                        "glosses": [
                                            "A simpleton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1aabea-09a7-4c7c-bdc3-510ab6757b85",
                                                "sense_id": "ec1e3ac0-e984-342c-a1f5-a34adf9d9af0",
                                                "text": "If I loved you not, I would laugh at you, and see you / Run your neck into the noose, and cry, \"A woodcock!\""
                                            },
                                            {
                                                "example_id": "eed9e579-d74e-4b34-83c6-c9e27bd6d9b3",
                                                "sense_id": "ec1e3ac0-e984-342c-a1f5-a34adf9d9af0",
                                                "text": "\"Now will that silly woodcock make such a report of what I have said to his chosen friend,\" observed Sir Robert to his companion when my Lord Cobham was out of hearing[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
