                "senses": [
                    {
                        "sense_id": "8587802f-2722-3517-8143-e3ae259bf409",
                        "entry_id": "085200af-adbc-365e-842c-e8d8380a6efa",
                        "glosses": [
                            "Verbrennungsmotor, der mit Holzgas betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2235574d-d418-4724-a656-4b72db93e0b7",
                                "sense_id": "8587802f-2722-3517-8143-e3ae259bf409",
                                "text": "„Benzin war rationiert, in dem Schutt fuhren Autos mit Holzgasmotor.“"
                            },
                            {
                                "example_id": "5fa8dc5d-0421-4009-bbac-3201d43341d1",
                                "sense_id": "8587802f-2722-3517-8143-e3ae259bf409",
                                "text": "„Ein Bus mit Holzgasmotor und Eier als Fahrergeld standen am Beginn der Firma Bottenschein.“"
                            },
                            {
                                "example_id": "a61599c0-a8ae-4884-bf03-f6d4f274a6ed",
                                "sense_id": "8587802f-2722-3517-8143-e3ae259bf409",
                                "text": "„Anlagen zur Stromerzeugung aus thermodynamischen Prozessen sind in der erforderlichen Leistungsgröße am Markt nicht verfügbar (ORC), technisch nicht ausgereift (Holzgasmotor, Stirlingmotor mit Holzfeuerung), oder in Kombination mit der zentralen Holzfeuerung nicht wirtschaftlich (motorische BHKW betrieben mit Biomethan oder Pflanzenöl).“"
                            },
                            {
                                "example_id": "90da1d91-3e20-44d7-957e-2973f7ac11d4",
                                "sense_id": "8587802f-2722-3517-8143-e3ae259bf409",
                                "text": "„Mit den in den folgenden Jahren aufgekommenen billigeren und effektiveren Erdöl-Treibstoffen waren Holzgasmotoren – die es auch in Traktoren gab – aus verschiedenen Gründen Geschichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
