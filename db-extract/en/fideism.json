                                        "entry_id": "aedc07fe-8be3-3781-a936-6a44bf4b7005",
                                        "glosses": [
                                            "(evangelisch-reformierte) Lehre, nach der einzig der Glaube, nicht jedoch dessen Inhalt von Bedeutung ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b364e0a8-f881-4ae4-82c7-ecd29b51607f",
                                                "sense_id": "ce576c86-2140-324d-9ade-7a2c4781401c",
                                                "text": "Fideismus und Traditionalismus lehnen eine Vernunfterkenntnis Gottes ab."
                                            }
