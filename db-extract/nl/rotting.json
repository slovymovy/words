                                        ],
                                        "examples": [
                                            {
                                                "example_id": "059c1b93-fdb9-4e37-a4d4-f8e39ab5d81c",
                                                "sense_id": "1548bda9-2a2f-3f97-8d2b-c85664add187",
                                                "text": "The bed was the most extravagant piece. Its graceful cane halftester rose high towards the cornice and was so festooned in carved white wood that the effect was positively insecure, as if the great couch were trimmed with icing sugar."
                                            }
                                        ]
                                    },
