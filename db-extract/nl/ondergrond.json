                    },
                    {
                        "form_id": "77c7a387-3805-4482-bd09-5c05b08deabd",
                        "entry_id": "b2efe916-a9a7-3975-990a-e119b8076a19",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "ondergrondje"
                    },
                    {
                        "form_id": "006bb52c-6ca5-40ab-8ecb-7c171029100d",
                        "entry_id": "b2efe916-a9a7-3975-990a-e119b8076a19",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "ondergrondjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e523b0e-38f5-3471-bb55-e6023cc85fe2",
                        "entry_id": "b2efe916-a9a7-3975-990a-e119b8076a19",
                        "glosses": [
                            "de grond onder de oppervlaktelaag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f8c971e-483b-4bf1-9af3-22a951cc2a21",
                                "sense_id": "1e523b0e-38f5-3471-bb55-e6023cc85fe2",
                                "text": "Zowel provincie als gemeenten willen een alternatief zónder injectie in de ondergrond. Het gaat in dat geval om volledige zuivering van het afvalwater bij de oliewinning in Schoonebeek zelf. Het volledig gezuiverde water kan dan op het oppervlaktewater worden geloosd. Ook zou het alleen ontdaan kunnen worden van de mijnbouwhulpstoffen waarna het via een pijplijn naar zee kan worden gepompt."
                            },
                            {
                                "example_id": "87836920-64b4-4046-8f78-15d9a7c4dd09",
                                "sense_id": "1e523b0e-38f5-3471-bb55-e6023cc85fe2",
                                "text": "Toen ik eindelijk de andere kant bereikte greep ik zijn arm en hij trok mij naar de veiligheid van de stenen ondergrond."
                            },
                            {
                                "example_id": "19d94d65-92c0-4467-a72f-647ae469e115",
                                "sense_id": "1e523b0e-38f5-3471-bb55-e6023cc85fe2",
                                "text": "\"Aardwetenschappers zijn hard nodig voor de energietransitie, aangezien veel oplossingen in de ondergrond liggen\", zegt Van den Hurk. \"En ook als het gaat om klimaatmitigatie en -adaptatie zijn aardwetenschappers cruciaal. Van het duurzaam beheren en beschermen van onze grondwatervoorraden tot het zoeken van voldoende zand voor kustbescherming.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c215924f-2bfc-4b4f-873c-837ee24fe7fd",
                        "source_entry_id": "b2efe916-a9a7-3975-990a-e119b8076a19",
                        "source_sense_id": "1e523b0e-38f5-3471-bb55-e6023cc85fe2",
                        "source_sense_description": "de grond onder de oppervlaktelaag",
                        "target_lang_word": "Untergrund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untergrund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30e01c6b-5a5c-3d73-9845-1a85a0fdaaa5",
                                        "entry_id": "c156246e-039c-383c-931e-dbfe830b0330",
                                        "glosses": [
                                            "tieferliegende Erdschicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea99a350-448c-49e8-a4a0-98209e316f79",
                                                "sense_id": "30e01c6b-5a5c-3d73-9845-1a85a0fdaaa5",
                                                "text": "Der Bauer pflügt selten bis in den Untergrund."
                                            },
                                            {
                                                "example_id": "2c3b9516-e86b-4fb3-b729-98c11ceffc4b",
                                                "sense_id": "30e01c6b-5a5c-3d73-9845-1a85a0fdaaa5",
                                                "text": "„Auf dem trügerischen Untergrund glitt ich aus und landete der Länge nach auf dem Boden.“"
                                            },
                                            {
                                                "example_id": "e7a3ffbe-1e9e-406e-b6aa-170b9496c027",
                                                "sense_id": "30e01c6b-5a5c-3d73-9845-1a85a0fdaaa5",
                                                "text": "„Über Nacht hatte sich eine Tauschicht, eine dünne Kruste auf dem Sand gebildet, die einen festen Untergrund bildete.“"
                                            },
                                            {
                                                "example_id": "9902efa5-596c-489d-b31d-437dced1f3d0",
                                                "sense_id": "30e01c6b-5a5c-3d73-9845-1a85a0fdaaa5",
                                                "text": "„Nach einer Strecke mit sumpfigem Untergrund wurde der Boden trocken und sandig und stieg allmählich an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8accc34a-7f55-38fa-b133-8cc93d5bc9c2",
                                        "entry_id": "c156246e-039c-383c-931e-dbfe830b0330",
                                        "glosses": [
                                            "Basis für einen Bau, Erde in ein paar Metern Tiefe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57408bd0-1c37-4fa0-b991-25e78190e304",
                                                "sense_id": "8accc34a-7f55-38fa-b133-8cc93d5bc9c2",
                                                "text": "Der Untergrund war für ein Bauvorhaben dieser Größe nicht geeignet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8e22e94b-8720-32a5-bf6c-f80644c8f350",
                                        "entry_id": "c156246e-039c-383c-931e-dbfe830b0330",
                                        "glosses": [
                                            "untere Schicht (zum Beispiel zum Auftrag von Farbe oder Putzmörtel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0919a691-f6ac-44e2-b98e-0b079ed5d42a",
                                                "sense_id": "8e22e94b-8720-32a5-bf6c-f80644c8f350",
                                                "text": "Helle Farben heben sich erst auf einem dunklen Untergrund gut ab."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fa3a9d1a-aa60-395e-8a14-5eec26f395ee",
                                        "entry_id": "c156246e-039c-383c-931e-dbfe830b0330",
                                        "glosses": [
                                            "Bereich außerhalb der Legalität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98c82c31-9d11-4a60-a946-c087fd9609b2",
                                                "sense_id": "fa3a9d1a-aa60-395e-8a14-5eec26f395ee",
                                                "text": "Nach den Misserfolgen tauchte er in den Untergrund ab."
                                            },
                                            {
                                                "example_id": "a1471fee-e9d2-4d57-9ca7-1e9485e0a4b1",
                                                "sense_id": "fa3a9d1a-aa60-395e-8a14-5eec26f395ee",
                                                "text": "„Einzelne unabhängige Partisanen blieben bis in die Siebzigerjahre im Untergrund und entgingen so ihrer Gefangennahme.“"
                                            },
                                            {
                                                "example_id": "0a42d40e-3b97-4b1a-83ce-fd6d478e0da2",
                                                "sense_id": "fa3a9d1a-aa60-395e-8a14-5eec26f395ee",
                                                "text": "„Nach jahrelanger Arbeit für die Bekennende Kirche im Untergrund wurde Bonhoeffer am 9. April 1945 im Konzentrationslager Flossenbürg hingerichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "626d1e8d-705e-45a4-b163-e6b41ea78356",
                        "source_entry_id": "b2efe916-a9a7-3975-990a-e119b8076a19",
                        "source_sense_id": "1e523b0e-38f5-3471-bb55-e6023cc85fe2",
