                        "glosses": [
                            "Spécialiste de l'ergonomie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2546bf34-8885-4c2f-bc26-59a6d9c134fa",
                                "sense_id": "e1801d2e-dd4b-324a-bb04-d15226f41779",
                                "text": "Un diplôme d'ergonomiste."
                            },
                            {
                                "example_id": "360199dd-e1ce-450d-b479-0e9f9608fa83",
                                "sense_id": "e1801d2e-dd4b-324a-bb04-d15226f41779",
                                "text": "Parmi les métiers de demain qui ne sont pas encore inventés, je pense que l’ergonomiste aura une place de choix pour nous aider à lutter contre toutes les formes de nuisances, esthétiques et sonores maintenant, magnétiques plus tard."
                            }
                        ]
                    }
                ],
