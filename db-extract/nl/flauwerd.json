                "senses": [
                    {
                        "sense_id": "74be240a-2baf-3a21-89a0-2ddf45d4b451",
                        "entry_id": "1b47237e-eed6-3b45-9336-3a3c02914bad",
                        "glosses": [
                            "iemand die bang is voor alles en niets durft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac18ec4e-7c73-40b0-9e36-d8f52d351bd5",
                                "sense_id": "74be240a-2baf-3a21-89a0-2ddf45d4b451",
                                "text": "Kozená zingt fraai, maar mankeert de vranke lichaamstaal die de titelrol vereist. Ook Kaufmann krijgt niet echt greep op zijn partij: zijn Don José blijft een angsthazige flauwerd. De Escamillo van dienst is meer Roemeense maffiabaas dan Spaanse seksbom. Een typisch studioproduct: smetvrij maar bloedeloos."
                            }
                        ]
                    },
                    {
                        "sense_id": "825028c5-f6ec-332b-a4b8-14e85f5ed04d",
                        "entry_id": "1b47237e-eed6-3b45-9336-3a3c02914bad",
                        "glosses": [
                            "een vervelend persoon die minder geslaagde grapjes maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "767257ca-021b-43b5-991d-cbb6efd36682",
                                "sense_id": "825028c5-f6ec-332b-a4b8-14e85f5ed04d",
                                "text": "De vader stond op en gaf me een hand. „Hendrik Tielemans. Henk voor vrienden, maar noem jij mij nog maar even meneer Tielemans.” „Wat kan jij toch vervelend zijn, Henk,” zei Jolanda’s moeder en stond op. „Let maar niet op hem, Driss. Het is toch zo’n flauwerd.”Daarna gaf ze me een hand en zoende me op de wangen. „Noem mij maar gewoon Ria. Maar kom, laten we aan tafel gaan, het eten wordt koud.”"
                            }
                        ]
                    }
