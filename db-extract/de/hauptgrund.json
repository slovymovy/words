                ],
                "senses": [
                    {
                        "sense_id": "8c1d5541-9af4-3517-8cf0-0096a981c199",
                        "entry_id": "32cdc2f3-9100-3ad0-9260-6464acb2a8b4",
                        "glosses": [
                            "ausschlaggebende Ursache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25bae8a7-4c35-4e21-b42a-b848060a6ef6",
                                "sense_id": "8c1d5541-9af4-3517-8cf0-0096a981c199",
                                "text": "Der Hauptgrund für den Klimawandel ist die erhöhte Konzentration von Treibhausgasen in der Atmosphäre."
                            },
                            {
                                "example_id": "345a7821-1085-4fd2-8237-8c1c22a3f404",
                                "sense_id": "8c1d5541-9af4-3517-8cf0-0096a981c199",
                                "text": "„Wahrscheinlich war der Hauptgrund, warum er von der Macht verdrängt wurde, die einseitige Unabhängigkeitserklärung, die Smith bereits plante.“"
                            },
                            {
                                "example_id": "a2e10468-544f-4fcb-abc9-d9ce6ae96b18",
                                "sense_id": "8c1d5541-9af4-3517-8cf0-0096a981c199",
                                "text": "„Einer der Hauptgründe für Agnes Miegels Reise zur Akademiesitzung in Berlin dürfte der Wunsch gewesen sein, Ina Seidel wiederzusehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
