{
    "word_family": [
        "хотя",
        "хотеть",
        "охота"
    ],
    "entries": [
        {
            "pos": "article",
            "senses": [
                {
                    "sense_id": "0ceff431-6ffa-3942-9e77-eabf75ff9753",
                    "sense_definition": "Частица, выражающая ограничение, уступку или минимальное требование; по крайней мере.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сделай <w>хоть</w> что-нибудь полезное сегодня.",
                            "target_lang_translations": {
                                "en": "Do <w>at least</w> something useful today.",
                                "zh": "今天<w>至少</w>做点有用的事吧。"
                            }
                        },
                        {
                            "text": "Нам нужно подождать <w>хоть</w> немного, чтобы дождь закончился.",
                            "target_lang_translations": {
                                "en": "We need to wait <w>at least</w> a little for the rain to stop.",
                                "zh": "我们需要<w>至少</w>等一会儿，等雨停了再说。"
                            }
                        }
                    ],
                    "synonyms": [
                        "хотя бы",
                        "по крайней мере"
                    ],
                    "common_phrases": [
                        "хоть бы",
                        "хоть раз",
                        "хоть немного",
                        "хоть глаз выколи"
                    ],
                    "target_lang_definitions": {
                        "en": "Particle expressing a limitation, concession, or minimal requirement; indicates the smallest amount or degree acceptable.",
                        "zh": "表示限制、让步或最低限度的要求；至少。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at least",
                                "target_lang_sense_clarification": "indicating a minimum amount or requirement"
                            },
                            {
                                "target_lang_word": "if only",
                                "target_lang_sense_clarification": "used to express a minimal wish or request"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "至少",
                                "target_lang_sense_clarification": "表示最低限度或要求"
                            },
                            {
                                "target_lang_word": "哪怕",
                                "target_lang_sense_clarification": "用于表示最低限度的愿望或假设"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83ea31fb-6a70-3a61-8333-bd0418ef9805",
                    "sense_definition": "Частица, используемая для выделения слова, которое приводится в качестве примера.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Взять <w>хоть</w> нашего соседа, он всегда всем помогает.",
                            "target_lang_translations": {
                                "en": "Take our neighbor <w>for example</w>, he always helps everyone.",
                                "zh": "<w>比如</w>我们的邻居，他总是乐于助人。"
                            }
                        },
                        {
                            "text": "Мы можем поехать куда угодно, <w>хоть</w> на море, если у нас будет время.",
                            "target_lang_translations": {
                                "en": "We can go anywhere, <w>even</w> to the sea, if we have time.",
                                "zh": "只要有时间，我们去哪儿都行，<w>甚至</w>去海边也可以。"
                            }
                        }
                    ],
                    "synonyms": [
                        "к примеру",
                        "например"
                    ],
                    "common_phrases": [
                        "взять хоть"
                    ],
                    "target_lang_definitions": {
                        "en": "Particle used to highlight a specific word provided as an example or instance.",
                        "zh": "用于强调所举出的例子。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "even",
                                "target_lang_sense_clarification": "used to emphasize a specific example"
                            },
                            {
                                "target_lang_word": "for example",
                                "target_lang_sense_clarification": "used to introduce an instance"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "imperative used to introduce an example (e.g., 'take...')"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甚至",
                                "target_lang_sense_clarification": "用于强调某个极端例子"
                            },
                            {
                                "target_lang_word": "比如",
                                "target_lang_sense_clarification": "用于引出例子"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "43d4866b-259a-3ffc-b456-83cb580e2aee",
                    "sense_definition": "Союз, вводящий уступительное придаточное предложение; несмотря на то что, даже если.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Хоть</w> он был очень уставшим, он всё равно пошёл на работу.",
                            "target_lang_translations": {
                                "en": "<w>Although</w> he was very tired, he still went to work.",
                                "zh": "<w>虽然</w>他很累，但他还是去上班了。"
                            }
                        },
                        {
                            "text": "Мы решили гулять в парке, <w>хоть</w> погода была пасмурной.",
                            "target_lang_translations": {
                                "en": "We decided to walk in the park, <w>though</w> the weather was overcast.",
                                "zh": "<w>尽管</w>天气阴沉，我们还是决定去公园散步。"
                            }
                        }
                    ],
                    "synonyms": [
                        "пусть"
                    ],
                    "common_phrases": [
                        "хоть и"
                    ],
                    "target_lang_definitions": {
                        "en": "Conjunction introducing a concessive clause; indicates that something happens despite a certain condition.",
                        "zh": "引导让步从句；表示尽管有某种情况，某事依然发生。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "though",
                                "target_lang_sense_clarification": "conjunction introducing a contrast or concession"
                            },
                            {
                                "target_lang_word": "although",
                                "target_lang_sense_clarification": "formal conjunction for concession"
                            },
                            {
                                "target_lang_word": "even though",
                                "target_lang_sense_clarification": "emphatic form of though"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虽然",
                                "target_lang_sense_clarification": "引导让步从句"
                            },
                            {
                                "target_lang_word": "尽管",
                                "target_lang_sense_clarification": "表示让步的连词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "396dfbeb-9033-3570-8c34-5b9dc67f3826",
                    "sense_definition": "Повторяющийся союз, выражающий равную возможность вариантов или безразличие к выбору.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне всё равно, <w>хоть</w> сегодня, <w>хоть</w> завтра, главное сделать это.",
                            "target_lang_translations": {
                                "en": "I don't care, <w>be it</w> today or tomorrow, the main thing is to get it done.",
                                "zh": "我无所谓，<w>不管是</w>今天还是明天，只要做完就行。"
                            }
                        },
                        {
                            "text": "В этом магазине есть всё: <w>хоть</w> одежда, <w>хоть</w> продукты.",
                            "target_lang_translations": {
                                "en": "This store has everything: <w>whether</w> clothes or groceries.",
                                "zh": "这家店什么都有，<w>无论是</w>衣服还是食品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "что"
                    ],
                    "common_phrases": [
                        "хоть плачь",
                        "хоть куда"
                    ],
                    "target_lang_definitions": {
                        "en": "Repeating conjunction expressing equal possibility of options or indifference regarding the choice.",
                        "zh": "重复使用的连词，表示选项均可或对选择无所谓。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be it",
                                "target_lang_sense_clarification": "subjunctive phrase listing alternatives"
                            },
                            {
                                "target_lang_word": "whether",
                                "target_lang_sense_clarification": "conjunction introducing alternatives"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无论",
                                "target_lang_sense_clarification": "用于列举多种可能性"
                            },
                            {
                                "target_lang_word": "不管是……还是……",
                                "target_lang_sense_clarification": "表示对选择无所谓"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}