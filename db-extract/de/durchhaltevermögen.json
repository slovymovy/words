                                        "entry_id": "21130245-4993-3f2b-a82d-04fd6449bd5d",
                                        "glosses": [
                                            "Faculté, force d’endurer la fatigue physique, les privations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a1ee84a-9c15-4aa7-a822-5bda22cf6280",
                                                "sense_id": "8842d15b-74fc-3888-8482-73629642595b",
                                                "text": "Les troupes ont fait preuve pendant cette campagne d’une endurance remarquable."
                                            },
                                            {
                                                "example_id": "6b8c7b5b-3afe-4b38-9f0a-742497ae0ad3",
