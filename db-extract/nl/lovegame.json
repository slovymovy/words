                        "examples": [
                            {
                                "example_id": "88b461a4-531c-4f5c-9b0f-0ad972ee4712",
                                "sense_id": "5bd6b69f-14b9-3630-b1b5-b21a9e7bc8a7",
                                "text": "Bij een 4-3 voorsprong kreeg Bertens een breakpoint, dat voelde als een virtueel matchpoint, maar dat benutte ze niet. Dat deed Barty op haar beurt bij 5-5 wel, na een mindere servicebeurt van Bertens. De thuisspeelster maakte het karwei vervolgens koeltjes af met een lovegame."
                            },
                            {
                                "example_id": "7bbad7cc-9eff-4302-8b22-4fae10d61ab5",
                                "sense_id": "5bd6b69f-14b9-3630-b1b5-b21a9e7bc8a7",
                                "text": "In de derde set wisselde het momentum een paar keer. Bertens werd in de openingsgame direct gebroken, maar repareerde dat direct en leek na een goede lovegame het initiatief weer in handen te hebben genomen. Bij 2-2 ging ze echter opnieuw te voorzichtig te werk bij het zoeken van de aanval en werd daarvoor afgestraft door de Russin."
                            }
                        ]
                    }
