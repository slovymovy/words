                                "sense_id": "a3b58089-2f01-3585-8d12-c4257ff19b97",
                                "text": "опя́ть э́тот поли́тик разоря́ется!",
                                "translation": "that politician is drivelling on again!",
                                "english": "that politician is drivelling on again!"
                            },
                            {
                                "example_id": "7bea63a2-09ae-41b0-b0db-e5125df5bed4",
                                "sense_id": "a3b58089-2f01-3585-8d12-c4257ff19b97",
                                "text": "хва́тит на меня́ разоря́ться!",
                                "translation": "stop nagging/shouting at me!",
                                "english": "stop nagging/shouting at me!"
