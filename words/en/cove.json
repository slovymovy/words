{
    "word_family": [
        "coving"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1900225-0572-3f20-a3f2-af1a4b68cdc7",
                    "sense_definition": "A small coastal inlet, especially one having high cliffs protecting vessels from prevailing winds.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat dropped anchor in a quiet <w>cove</w> to escape the rough sea.",
                            "target_lang_translations": {
                                "ru": "Лодка бросила якорь в тихой <w>бухте</w>, чтобы спастись от бушующего моря."
                            }
                        },
                        {
                            "text": "There are several excellent snorkelling spots in the shallow <w>coves</w> around the island.",
                            "target_lang_translations": {
                                "ru": "В мелководных <w>бухточках</w> вокруг острова есть несколько отличных мест для снорклинга."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shallow cove",
                        "secret cove",
                        "coastal cove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой прибрежный залив, часто защищенный высокими скалами от ветров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бухта",
                                "target_lang_sense_clarification": "небольшой залив"
                            },
                            {
                                "target_lang_word": "бухточка",
                                "target_lang_sense_clarification": "маленькая уютная бухта"
                            },
                            {
                                "target_lang_word": "заводь",
                                "target_lang_sense_clarification": "тихое место у берега"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3cfcfb1-8706-3c7f-8161-c773aaf33212",
                    "sense_definition": "A fellow or a man.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At one point, a friendly-looking sort of <w>cove</w> with silver hair beamed at him.",
                            "target_lang_translations": {
                                "ru": "В какой-то момент ему улыбнулся дружелюбного вида <w>малый</w> с седыми волосами."
                            }
                        },
                        {
                            "text": "He was known as a bit of a strange <w>cove</w> by the locals in the village.",
                            "target_lang_translations": {
                                "ru": "Местные жители в деревне считали его немного странным <w>типом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "man"
                    ],
                    "antonyms": [
                        "woman"
                    ],
                    "common_phrases": [
                        "strange cove",
                        "old cove"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, парень или мужчина (устаревшее британское обращение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малый",
                                "target_lang_sense_clarification": "парень, субъект"
                            },
                            {
                                "target_lang_word": "тип",
                                "target_lang_sense_clarification": "человек с определенными чертами"
                            },
                            {
                                "target_lang_word": "субъект",
                                "target_lang_sense_clarification": "незнакомый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71e7a5ed-6d8b-3c20-a089-f667fa45ca04",
                    "sense_definition": "A friend or a mate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went down to the pub to meet an old <w>cove</w> from his school days.",
                            "target_lang_translations": {
                                "ru": "Он отправился в паб, чтобы встретиться со старым <w>приятелем</w> со школьных времен."
                            }
                        },
                        {
                            "text": "The two <w>coves</w> shared a drink and talked about the old times.",
                            "target_lang_translations": {
                                "ru": "Двое <w>друзей</w> выпили по стаканчику и поговорили о былых временах."
                            }
                        }
                    ],
                    "synonyms": [
                        "friend"
                    ],
                    "antonyms": [
                        "enemy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "archaic slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Друг, приятель или товарищ (архаичный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приятель",
                                "target_lang_sense_clarification": "знакомый"
                            },
                            {
                                "target_lang_word": "дружище",
                                "target_lang_sense_clarification": "дружеское обращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a51a525-892d-3f83-8cdb-9b612e0f9308",
                    "sense_definition": "A valley between two ridges, especially one protected from winter storms.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their farm occupied a wide piece of <w>cove</w> bottom with rich black soil.",
                            "target_lang_translations": {
                                "ru": "Их ферма занимала обширную часть дна <w>лощины</w> с богатым черноземом."
                            }
                        },
                        {
                            "text": "The hikers found shelter in a mountain <w>cove</w> as the wind picked up.",
                            "target_lang_translations": {
                                "ru": "Когда поднялся ветер, туристы нашли убежище в горной <w>долине</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mountain cove",
                        "cove bottom"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Southern Appalachia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Долина между двумя горными хребтами, защищенная от зимних штормов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лощина",
                                "target_lang_sense_clarification": "долина между холмами"
                            },
                            {
                                "target_lang_word": "горная долина",
                                "target_lang_sense_clarification": "защищенное место в горах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8d1118a-ed7e-3772-b480-5aeec967f114",
                    "sense_definition": "A concave vault or archway, especially the arch of a ceiling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect designed a beautiful <w>cove</w> ceiling for the grand ballroom.",
                            "target_lang_translations": {
                                "ru": "Архитектор спроектировал красивый <w>сводчатый</w> потолок для большого бального зала."
                            }
                        },
                        {
                            "text": "Soft lighting was hidden within the <w>cove</w> to create a warm glow.",
                            "target_lang_translations": {
                                "ru": "Мягкое освещение было спрятано в <w>падуге</w>, чтобы создать теплое сияние."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cove ceiling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вогнутый свод или арочный переход, особенно свод потолка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свод",
                                "target_lang_sense_clarification": "архитектурный элемент"
                            },
                            {
                                "target_lang_word": "выкружка",
                                "target_lang_sense_clarification": "вогнутый профиль"
                            },
                            {
                                "target_lang_word": "падуга",
                                "target_lang_sense_clarification": "плавный переход от стены к потолку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb525e8a-ef9a-3889-af99-e0bf84239475",
                    "sense_definition": "To arch over or build in a hollow concave form.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builder decided to <w>cove</w> the ceiling to give the room more height.",
                            "target_lang_translations": {
                                "ru": "Строитель решил <w>сделать сводчатым</w> потолок, чтобы придать комнате больше высоты."
                            }
                        },
                        {
                            "text": "The mosques of the Arabians are often rounded into domes and <w>coved</w> roofs.",
                            "target_lang_translations": {
                                "ru": "Арабские мечети часто венчаются куполами и <w>сводчатыми</w> крышами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coved roof",
                        "coved ceiling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать сводчатым или строить в форме вогнутой впадины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сводить",
                                "target_lang_sense_clarification": "делать в форме свода"
                            },
                            {
                                "target_lang_word": "закруглять",
                                "target_lang_sense_clarification": "придавать вогнутую форму"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cd55403-eede-31e7-8a33-ec797cff9077",
                    "sense_definition": "Of a bird or other animal: to brood, cover, or sit over eggs to incubate them.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tortoise was not able to <w>cove</w> upon her eggs for a long time.",
                            "target_lang_translations": {
                                "ru": "Черепаха долгое время не могла <w>высиживать</w> свои яйца."
                            }
                        },
                        {
                            "text": "The bird will <w>cove</w> the nest until the chicks are ready to hatch.",
                            "target_lang_translations": {
                                "ru": "Птица будет <w>сидеть</w> на гнезде, пока птенцы не будут готовы вылупиться."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О птице или животном: высиживать яйца или сидеть на них для инкубации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высиживать",
                                "target_lang_sense_clarification": "инкубировать яйца"
                            }
                        ]
                    }
                }
            ]
        },
