                                                "sense_id": "1d19a7b3-7fd6-3573-bab3-3b46a39b658c",
                                                "text": "Frau Sauer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "3fde8db6-f6aa-4772-ac4f-7896df370094",
                                                "sense_id": "1d19a7b3-7fd6-3573-bab3-3b46a39b658c",
                                                "text": "Herr Sauer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "b80cb970-3aef-4dc3-8ce8-7e0d2a4a0708",
                                                "sense_id": "1d19a7b3-7fd6-3573-bab3-3b46a39b658c",
                                                "text": "Die Sauers fahren heute ins Sauerland."
                                            },
                                            {
                                                "example_id": "743f7eaf-9956-405b-857a-538559db22e6",
                                                "sense_id": "1d19a7b3-7fd6-3573-bab3-3b46a39b658c",
                                                "text": "Der Sauer trägt nie die Schals, die die Sauer ihm strickt."
                                            },
                                            {
                                                "example_id": "82d17cb4-9e2a-4c2d-a65d-c389406ee8cb",
                                                "sense_id": "1d19a7b3-7fd6-3573-bab3-3b46a39b658c",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sauer kommt, geht der Herr Sauer.“"
                                            },
                                            {
                                                "example_id": "5ee3dc80-9b3f-4e73-a86a-456bb43bddb8",
                                                "sense_id": "1d19a7b3-7fd6-3573-bab3-3b46a39b658c",
                                                "text": "Sauer kommt und geht."
                                            },
                                            {
                                                "example_id": "01a793a1-e3bd-4d44-8e13-267dcecf42c3",
                                                "sense_id": "1d19a7b3-7fd6-3573-bab3-3b46a39b658c",
                                                "text": "Sauers kamen, sahen und siegten."
                                            }
                                        ],
