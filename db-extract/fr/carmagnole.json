                "senses": [
                    {
                        "sense_id": "bce52654-6dcb-31f0-ba41-927a9e8efd70",
                        "entry_id": "7d486a02-7c99-34ac-9fd8-34abd47b48ac",
                        "glosses": [
                            "Surnom donné aux gardes nationaux de Luçon, Fontenay et des Charentes durant la guerre de Vendée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b1b5a1e-ece2-405c-93f9-0e9a16d46856",
                                "sense_id": "bce52654-6dcb-31f0-ba41-927a9e8efd70",
                                "text": "Les Carmagnoles, gardes nationaux de Luçon, Fontenay et des Charentes, appelé ainsi en raison de la forme de leurs vestes, le disputaient en bravoure à leurs féroces collègues, les hussards de la mort, contre les vieillards, les femmes et les enfants."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
