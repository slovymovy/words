                "senses": [
                    {
                        "sense_id": "5cf7ee4c-56a9-3465-8c67-20363d84a6d8",
                        "entry_id": "e5b667db-593d-3799-8747-0178c3420800",
                        "glosses": [
                            "sehr dünne Metallplatte, hergestellt aus Kupfer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65151c7d-53d0-401a-a7d8-70abffad33c1",
                                "sense_id": "5cf7ee4c-56a9-3465-8c67-20363d84a6d8",
                                "text": "Kupferblech wird auch für die Herstellung von Dachrinnen verwendet."
                            },
                            {
                                "example_id": "83f0ec8c-4eb7-488a-b7f5-3242625d441b",
                                "sense_id": "5cf7ee4c-56a9-3465-8c67-20363d84a6d8",
                                "text": "„Sie demontierten 140 Laufmeter 50 Zentimeter breites Kupferblech von der Mauerumrandung des Flachdachs.“"
                            },
                            {
                                "example_id": "5a25b86f-2f25-43da-be8d-bf8b9bf0fa63",
                                "sense_id": "5cf7ee4c-56a9-3465-8c67-20363d84a6d8",
                                "text": "„Das Kupferblech war im Baustellenbereich gelagert gewesen.“"
                            },
                            {
                                "example_id": "a6dfae19-709f-43f4-977a-2f14e1031883",
                                "sense_id": "5cf7ee4c-56a9-3465-8c67-20363d84a6d8",
                                "text": "„Auf einer besandeten Dachpappe montieren die Spengler nun in ihrer Dießener Werkstatt vorprofiliertes Kupferblech mit seitlichen Kanten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
