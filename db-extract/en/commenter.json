    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dac92020-6e96-339a-b966-3b74cb100df1",
                "word": "commenter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dbf0037e-0fde-4a2d-bbb2-a1e7f634aace",
                        "entry_id": "dac92020-6e96-339a-b966-3b74cb100df1",
                        "tags": [
                            "plural"
                        ],
                        "form": "commenters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6c1adca-f7ca-3fc0-8455-2b9c3c01953c",
                        "entry_id": "dac92020-6e96-339a-b966-3b74cb100df1",
                        "glosses": [
                            "One who comments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb5a4c77-85ba-41b3-802c-9a2f62ee8335",
                                "sense_id": "c6c1adca-f7ca-3fc0-8455-2b9c3c01953c",
                                "text": "There are faculty advisers on El’s theater crew who balk at using “they” for one person; classmates at El’s public school on the outskirts of Boston who insist El can’t be “multiple people”; and commenters on El’s social media feeds who dismiss nonbinary gender identities like androgyne (a combination of masculine and feminine), agender (the absence of gender) and gender-fluid (moving between genders) as lacking a basis in biology."
                            },
                            {
                                "example_id": "b3c2f073-2745-4e74-b58a-55d36e154670",
                                "sense_id": "c6c1adca-f7ca-3fc0-8455-2b9c3c01953c",
                                "text": "The country singer took on an Instagram commenter who had words to say regarding Owen’s latest song."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb5bf647-9950-4b14-ba37-2e6f4a2f77ac",
                        "source_entry_id": "dac92020-6e96-339a-b966-3b74cb100df1",
                        "source_sense_id": "c6c1adca-f7ca-3fc0-8455-2b9c3c01953c",
                        "source_sense_description": "one who comments",
                        "target_lang_word": "commentateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commentateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
                                        "entry_id": "8ef955c4-15fb-3f58-853d-157a7df91183",
                                        "glosses": [
                                            "Auteur de commentaires littéraires, historiques, juridiques, sportifs, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7829a2d-dce5-407f-943b-a8e38c01814d",
                                                "sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
                                                "text": "Mon livre, le voilà tel que je l'ai fait et tel qu'on doit le lire, avant que les commentateurs ne l'obscurcissent de leurs éclaircissements."
                                            },
                                            {
                                                "example_id": "05ad6707-f832-4101-9a56-ae1ba2b45d7f",
                                                "sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
                                                "text": "Raschi, en se cantonnant dans son rôle de commentateur, s'est attiré, lui, la reconnaissance de tous."
                                            },
                                            {
                                                "example_id": "c5172410-8b07-41d8-afe0-2766e7aa83b2",
                                                "sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
                                                "text": "Suivant les positions qu'ils adoptent à l'égard de l'évolution politique de Thèbes et des cités béotiennes, les commentateurs de Ps-Xénophon interprètent son allusion à l'intervention athénienne en Béotie de façons très différentes."
                                            },
                                            {
                                                "example_id": "4c4ab3d0-45b1-40ff-941c-b65ba894c3b2",
                                                "sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
                                                "text": "On écrit toujours de la même façon sur le plaisir du Prophète et la virginité d'Aïsha. Aucun commentateur n'a remis en cause ses prédécesseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bc28da4-802e-3b5d-8d2e-6cf4e2378f75",
                                        "entry_id": "8ef955c4-15fb-3f58-853d-157a7df91183",
                                        "glosses": [
                                            "Celui qui fait divers commentaires sur ce qu’il ignore."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48767fe4-3eb2-41dc-9273-9efc3e4fcf59",
                                                "sense_id": "2bc28da4-802e-3b5d-8d2e-6cf4e2378f75",
                                                "text": "Au quotidien The Globe and Mail, à Toronto, les commentateurs grimpaient aux rideaux, montaient aux barricades, prédisaient l'érosion, la balkanisation imminente du Canada. Ici ? Presque rien, si peu, bof. Étonnant, non ?"
                                            },
                                            {
                                                "example_id": "2c4991f7-ca5e-49e4-9ac5-a37bf0af2348",
                                                "sense_id": "2bc28da4-802e-3b5d-8d2e-6cf4e2378f75",
                                                "text": "Le silence du docteur laissait le champ libre aux commentateurs; l'abbé Moulle s'élança dans l'arène."
                                            },
                                            {
                                                "example_id": "72248a77-ea5c-45ed-9fb1-25c57b384eea",
                                                "sense_id": "2bc28da4-802e-3b5d-8d2e-6cf4e2378f75",
                                                "text": "Pourquoi ? Parce que les journalistes politiques et autres commentateurs qui donnent le la sont rabougris du cervelet ? Infirmes de la comprenette à force de s'enfermer eux-mêmes dans la boite à chaussure des schémas normalisateurs ?"
                                            },
                                            {
                                                "example_id": "bee66e26-e83d-44ce-bbd1-38518818ef61",
                                                "sense_id": "2bc28da4-802e-3b5d-8d2e-6cf4e2378f75",
                                                "text": "son look a étonné, y compris ses collègues : un bandana aux motifs bleus sur le front lui donnant, selon les commentateurs, des airs de hippie, de biker ou d’Indien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9baa89d-cc3d-47a5-8547-8bc97dcb1a22",
                        "source_entry_id": "dac92020-6e96-339a-b966-3b74cb100df1",
                        "source_sense_id": "c6c1adca-f7ca-3fc0-8455-2b9c3c01953c",
                        "source_sense_description": "one who comments",
                        "target_lang_word": "komentator",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "komentator",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "b1afb751-bf29-30a4-a208-54a59308daa9",
                                        "entry_id": "dbc1223d-dbfd-3211-b6d0-44d1e6583f4f",
                                        "glosses": [
                                            "osoba, która komentuje coś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec20dbd7-404c-4d59-ac04-79b3ecde54f9",
                                                "sense_id": "b1afb751-bf29-30a4-a208-54a59308daa9",
                                                "text": "Część komentatorów zwraca uwagę, że poczucie moralności w Chile podlega głębokim zmianom."
                                            },
                                            {
                                                "example_id": "37060c7d-9b3b-461f-8753-a31b425b3063",
                                                "sense_id": "b1afb751-bf29-30a4-a208-54a59308daa9",
                                                "text": "Komentatorzy są zgodni, że większość decyzji tego rządu była błędna."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "6922343f-fe97-3064-b7da-07e754deb913",
                                        "entry_id": "dbc1223d-dbfd-3211-b6d0-44d1e6583f4f",
                                        "glosses": [
                                            "sprawozdawca sportowy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40cdca7c-2c89-4e6f-891f-b501c80c43d2",
                                                "sense_id": "6922343f-fe97-3064-b7da-07e754deb913",
                                                "text": "Pijany komentator przegapił bramkę dla Polski i do końca pierwszej połowy meczu podawał zły wynik."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
