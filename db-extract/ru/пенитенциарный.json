                    {
                        "translation_id": "be1b9926-18c6-44b6-8413-5fc3472afefc",
                        "source_entry_id": "05aae001-982b-3bfa-b932-08c28fb43061",
                        "source_sense_id": "f59910ac-8fca-3d24-8476-5c7f53a3dec7",
                        "target_lang_word": "pénitencier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pénitencier",
