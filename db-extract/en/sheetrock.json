            {
                "entry_id": "8d3e1d1e-5451-3da5-be11-474c591b0986",
                "word": "sheetrock",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "85c224d1-59fe-3022-b069-24ed3ef9c603",
                        "entry_id": "8d3e1d1e-5451-3da5-be11-474c591b0986",
                        "glosses": [
                            "aus Gips und Karton gefertigte Platte zur Verwendung beim Trockenbau: Gipskartonplatte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e236daf-eaef-40f3-b7e5-75876422cde4",
                                "sense_id": "85c224d1-59fe-3022-b069-24ed3ef9c603",
                                "text": "“Since New Year's day, 29-year-old artist Emily Katrencik has been eating the wall of her gallery in Brooklyn, New York, tearing off small chunks of plaster with her teeth as though it were a gingerbread house. \"The more saliva that I allow to get on to the sheetrock, the softer it becomes, the easier it is to bite and to swallow,\" she says.”",
                                "translation": "Seit dem Neujahrstag isst die 29-jährige Künstlerin Emily Katrencik die Wand ihrer Galerie in Brooklyn, New York, reißt mit den Zähnen kleine Gipsstücke ab, wie bei einem Lebkuchenhaus. \"Je mehr Speichel ich auf die Gipskartonplatte bringe, desto weicher wird sie, desto leichter ist sie zu beißen und zu schlucken\", sagt sie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b43a5c4-082b-41e6-8687-6764af7ebd0c",
                        "source_entry_id": "8d3e1d1e-5451-3da5-be11-474c591b0986",
                        "source_sense_id": "85c224d1-59fe-3022-b069-24ed3ef9c603",
                        "source_sense_description": "Platte für Trockenbau",
                        "target_lang_word": "Gipskartonplatte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gipskartonplatte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "167e9734-f53d-38fb-8545-11d8c95f2a16",
                                        "entry_id": "173c2db9-05b7-3e0d-81d2-7dc108a854cd",
                                        "glosses": [
                                            "Tafel, die im Innenausbau als Verkleidung verwendet wird (häufig 2 m hoch und circa 1 cm stark)"
                                        ],
                                        "tags": [
                                            "Baumaterial"
                                        ],
                                        "examples": [
