    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a07e8412-15ed-372d-b7ae-c952ada97389",
                    "sense_definition": "Preserved by rapidly freezing and then dehydrating in a high vacuum; freeze-dried.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "freeze_dried",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory stored the <w>lyophilized</w> bacteria in sealed glass vials.",
                            "target_lang_translations": {
                                "zh": "实验室将<w>冻干的</w>细菌存放在密封玻璃小瓶中。"
                            }
                        },
                        {
                            "text": "Reconstituting the <w>lyophilized</w> powder requires sterile water.",
                            "target_lang_translations": {
                                "zh": "复溶这种<w>冻干的</w>粉末需要无菌水。"
                            }
                        }
                    ],
                    "synonyms": [
                        "freeze-dried"
                    ],
                    "common_phrases": [
                        "lyophilized powder",
                        "lyophilized vaccine",
                        "lyophilized samples"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过快速冷冻后在高度真空中脱水干燥保存的；冻干的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冻干的",
                                "target_lang_sense_clarification": "经冷冻干燥处理的"
                            }
                        ]
                    }
                }
            ]
        },
