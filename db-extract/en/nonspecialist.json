                "senses": [
                    {
                        "sense_id": "5c42a3ee-4c94-32d7-8f05-265cdcd979a2",
                        "entry_id": "83c02774-9182-3eba-945e-c067b5b837ad",
                        "glosses": [
                            "A person who is not a specialist in a given field"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b01af9ad-bb69-441f-b599-c4b3576d89e2",
                                "sense_id": "5c42a3ee-4c94-32d7-8f05-265cdcd979a2",
                                "text": "This engineering task is too difficult for nonspecialists."
                            },
                            {
                                "example_id": "3eee8926-cdf8-4be3-b942-4ab357cd971f",
                                "sense_id": "5c42a3ee-4c94-32d7-8f05-265cdcd979a2",
                                "text": "\"Books,\" to us, should have 150 to 1500 published pages, almost never need color, be typesettable in house, not require fold-out maps, be predominately in English, and be titleable such that a nonspecialist could recommend it to a specialist."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62edcdd9-8118-4271-a671-c47dc1ed779d",
                        "source_entry_id": "83c02774-9182-3eba-945e-c067b5b837ad",
                        "source_sense_id": "5c42a3ee-4c94-32d7-8f05-265cdcd979a2",
                        "source_sense_description": "a person who is not a specialist in a given field",
                        "target_lang_word": "неспециалист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неспециалист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e70dc761-f539-3da9-9c68-6f6697b02cb4",
                                        "entry_id": "5db1f669-f301-375e-bf40-c1abbcbaea47",
                                        "glosses": [
                                            "тот, кто не является специалистом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "723e97ab-6692-4bc8-ad57-9bb1f291e607",
                                                "sense_id": "e70dc761-f539-3da9-9c68-6f6697b02cb4",
                                                "text": "Мне слишком часто приходилось видеть и слышать, как наилучшие машины и даже простые орудия, употребляемые всем светом, отказывались действовать, будучи пущены в дело неспециалистами."
                                            },
                                            {
                                                "example_id": "281321eb-0fb8-4386-864a-eb19eec380a8",
                                                "sense_id": "e70dc761-f539-3da9-9c68-6f6697b02cb4",
                                                "text": "А поскольку именно они в глазах неспециалистов и являются грибами, то о некоторых из них стоит рассказать."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "070086ea-23c1-4440-a906-c0ee64ae0c3f",
                        "source_entry_id": "83c02774-9182-3eba-945e-c067b5b837ad",
                        "source_sense_id": "5c42a3ee-4c94-32d7-8f05-265cdcd979a2",
                        "source_sense_description": "a person who is not a specialist in a given field",
                        "target_lang_word": "дилета́нт",
                        "target_lang_code": "ru",
                        "note": "somewhat",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дилета́нт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d1e471b3-33d3-3064-bb1a-5c55f2c5c3bf",
                                        "entry_id": "dd8832c8-bdf4-382c-b135-43fa87a3dd8e",
                                        "glosses": [
                                            "тот, кто занимается наукой или искусством и т. п. без специальной профессиональной подготовки, достаточных знаний; неспециалист, любитель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1828830-268c-41a6-94b3-5557821b9bf9",
                                                "sense_id": "d1e471b3-33d3-3064-bb1a-5c55f2c5c3bf",
                                                "text": "[Шеллинг] говорил со мною о 〈…〉 содержании издаваемой им ныне книги, в которой изложил он всю систему свою, 〈…〉, понятным образом и для дилетантов."
                                            },
                                            {
                                                "example_id": "912435f1-79d5-4ef0-96ea-f8967378749e",
                                                "sense_id": "d1e471b3-33d3-3064-bb1a-5c55f2c5c3bf",
                                                "text": "В Пензе его обыграл начистую пехотный капитан; он за это досадует на случай и несчастие, но не на капитана, к которому он благоговеет, как дилетант к художнику."
                                            },
                                            {
                                                "example_id": "8b8b7d4b-150e-4d6b-bd42-b88dac16a7bd",
                                                "sense_id": "d1e471b3-33d3-3064-bb1a-5c55f2c5c3bf",
                                                "text": "Я не понимаю, зачем все эти певцы и музыканты так любят тратить свои силы на риторические фигуры, все достоинство которых в трудности? Дилетанты восхищаются, но на меня это действует обратно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
