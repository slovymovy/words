                "senses": [
                    {
                        "sense_id": "227fe28b-c769-337e-923e-a881dd33bb6a",
                        "entry_id": "75d15001-8474-38de-9bb9-fa923da6a86f",
                        "glosses": [
                            "спец. аппарат, ёмкость для кипячения одежды и белья при дезинфекции, дезинсекции или стирке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81b6ef27-5765-472b-a762-a20dcc2d1bb2",
                                "sense_id": "227fe28b-c769-337e-923e-a881dd33bb6a",
                                "text": "Дезинфекционные бучильники применяют в больничных прачечных, где необходима обработка белья заразных отделений."
                            },
                            {
                                "example_id": "da050dbc-656f-4887-9e6d-4554c61ca7e5",
                                "sense_id": "227fe28b-c769-337e-923e-a881dd33bb6a",
                                "text": "Бучильники, в которых вываривалось бельё до того, как мы начинали его стирать, стояли в нашем сарае."
                            }
                        ]
                    }
