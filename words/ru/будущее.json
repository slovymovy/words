{
    "word_family": [
        "будущий",
        "будущность",
        "быть"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95b98b22-c231-313c-aeb6-29a97eca4e85",
                    "sense_definition": "Период времени, который последует за настоящим; предстоящие события.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы должны заботиться о том, каким будет наше <w>будущее</w>.",
                            "target_lang_translations": {
                                "en": "We must care about what our <w>future</w> will be like.",
                                "zh": "我们必须关心我们的<w>未来</w>会是什么样子。"
                            }
                        },
                        {
                            "text": "Никто не может с точностью предсказать далёкое <w>будущее</w>.",
                            "target_lang_translations": {
                                "en": "No one can accurately predict the distant <w>future</w>.",
                                "zh": "没有人能准确地预测遥远的<w>未来</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "грядущее",
                        "предстоящее"
                    ],
                    "antonyms": [
                        "прошлое",
                        "настоящее",
                        "былое"
                    ],
                    "common_phrases": [
                        "светлое будущее",
                        "в ближайшем будущем",
                        "смотреть в будущее",
                        "планы на будущее"
                    ],
                    "target_lang_definitions": {
                        "en": "The period of time that follows the present; upcoming events.",
                        "zh": "指现在之后的时间段；即将发生的事件。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "future",
                                "target_lang_sense_clarification": "time period"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未来",
                                "target_lang_sense_clarification": "指时间上的将来"
                            },
                            {
                                "target_lang_word": "将来",
                                "target_lang_sense_clarification": "指从现在往后的时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5736d299-9d8b-3df8-8891-b35afb6a81d2",
                    "sense_definition": "Дальнейшая судьба, перспективы развития или участь кого-либо или чего-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "destiny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У этого талантливого музыканта великое <w>будущее</w>.",
                            "target_lang_translations": {
                                "en": "This talented musician has a great <w>future</w>.",
                                "zh": "这位天才音乐家有着广阔的<w>前途</w>。"
                            }
                        },
                        {
                            "text": "Родители беспокоятся за <w>будущее</w> своих детей.",
                            "target_lang_translations": {
                                "en": "Parents worry about the <w>future</w> of their children.",
                                "zh": "父母们为他们孩子的<w>未来</w>感到担忧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "будущность",
                        "перспектива"
                    ],
                    "common_phrases": [
                        "большое будущее",
                        "без будущего"
                    ],
                    "target_lang_definitions": {
                        "en": "Further fate, development prospects, or the destiny of someone or something.",
                        "zh": "指某人或某事物的后续命运、发展前景或归宿。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "future",
                                "target_lang_sense_clarification": "destiny or prospects"
                            },
                            {
                                "target_lang_word": "prospects",
                                "target_lang_sense_clarification": "potential"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前途",
                                "target_lang_sense_clarification": "指个人发展的未来"
                            },
                            {
                                "target_lang_word": "前景",
                                "target_lang_sense_clarification": "指事物发展的可能性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63d7f43a-c5ac-3e7b-8d60-65b33074065d",
                    "sense_definition": "Грамматическая категория глагола, обозначающая действие, которое произойдёт после момента речи.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В русском языке <w>будущее</w> время может быть простым или сложным.",
                            "target_lang_translations": {
                                "en": "In the Russian language, the <w>future</w> tense can be simple or compound.",
                                "zh": "在俄语中，<w>将来时</w>可以是简单形式或复合形式。"
                            }
                        },
                        {
                            "text": "Ученики изучали, как образуется <w>будущее</w> время глаголов.",
                            "target_lang_translations": {
                                "en": "The students studied how the <w>future</w> tense of verbs is formed.",
                                "zh": "学生们学习了动词<w>将来时</w>是如何构成的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "футурум"
                    ],
                    "antonyms": [
                        "прошедшее",
                        "настоящее"
                    ],
                    "common_phrases": [
                        "будущее время"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A grammatical category of verbs indicating an action that will happen after the moment of speech.",
                        "zh": "动词的一种语法范畴，表示说话时刻之后发生的动作。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "future tense",
                                "target_lang_sense_clarification": "grammar"
                            },
                            {
                                "target_lang_word": "future",
                                "target_lang_sense_clarification": "grammar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "将来时",
                                "target_lang_sense_clarification": "语法术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9e278f51-3460-34cd-afab-b142a62c65ff",
                    "sense_definition": "Форма именительного или винительного падежа среднего рода единственного числа прилагательного <w>будущий</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нас ждёт <w>будущее</w> лето, полное приключений.",
                            "target_lang_translations": {
                                "en": "<w>Next</w> summer awaits us, full of adventures.",
                                "zh": "<w>下</w>一个充满冒险的夏天在等着我们。"
                            }
                        },
                        {
                            "text": "Это решение повлияет на <w>будущее</w> поколение.",
                            "target_lang_translations": {
                                "en": "This decision will affect the <w>future</w> generation.",
                                "zh": "这个决定将影响<w>未来</w>的一代。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "будущее время",
                        "будущее поколение"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The neuter singular form of the adjective meaning 'future' or 'next'.",
                        "zh": "形容词“未来的”或“下一个的”的中性单数形式。"
                    },
