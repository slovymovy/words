                "senses": [
                    {
                        "sense_id": "6246aee5-841e-3b9f-8ed6-f70e0f886124",
                        "entry_id": "a00c7d1b-a5aa-3dd4-89cb-869870855c44",
                        "glosses": [
                            "наличие в голосе сиплого, нечистого звука, издаваемого горлом при затруднённом дыхании"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd028040-b436-4a12-a512-c047d4d99126",
                                "sense_id": "6246aee5-841e-3b9f-8ed6-f70e0f886124",
                                "text": "«Ты бунтовщик! — с хрипотою сказал старик.»"
                            },
                            {
                                "example_id": "2f8711c0-c7bc-4187-9de5-0020e1f97efa",
                                "sense_id": "6246aee5-841e-3b9f-8ed6-f70e0f886124",
                                "text": "Лёгкая хрипота в её голосе не пропадала, но тон был милый, задушевный и простой, слишком даже простой, на оценку Тёркина."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b445351-43e2-4fb8-a5dc-f11d25b99bcb",
                        "source_entry_id": "a00c7d1b-a5aa-3dd4-89cb-869870855c44",
                        "source_sense_id": "6246aee5-841e-3b9f-8ed6-f70e0f886124",
                        "target_lang_word": "enrouement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enrouement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7f89982-6319-3a46-9535-7dd4e98420e2",
                                        "entry_id": "a6bb6e08-9a8f-3254-9414-fcbd33ec1ca3",
                                        "glosses": [
                                            "État de celui qui est enroué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b070c25c-cd65-423f-a743-ef4902e75cd0",
                                                "sense_id": "a7f89982-6319-3a46-9535-7dd4e98420e2",
                                                "text": "Un soir, à l'insu du brigadier, sa fille est entrée chez l'instituteur, le sourire aux yeux, les lèvres plus rouges que ces tablettes de sucre écarlate — des coquelicots — qu'on suce contre les enrouements."
                                            },
                                            {
                                                "example_id": "d296d6b3-adbb-4f65-b10e-fcf7e1eb447d",
                                                "sense_id": "a7f89982-6319-3a46-9535-7dd4e98420e2",
                                                "text": "L’opéra a été mauvais, grâce à M. Solas et aux chœurs qui faisaient à qui chanterait le plus faux ; la partie aurait été équilibrée sans un enrouement qui a permis a notre ténor blackboulé d’avoir le dessus ; mais trêve de compliments, M. Solas nous faisait ses adieux."
                                            },
                                            {
                                                "example_id": "21fd04c3-544e-4966-8151-83ec82df0392",
                                                "sense_id": "a7f89982-6319-3a46-9535-7dd4e98420e2",
                                                "text": "—C'est mon mari, monsieur… Oh! ce n'est pas grave… Un petit enrouement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
