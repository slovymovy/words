                {
                    "sense_id": "95f70e60-e5fc-363f-9bef-95bee6365684",
                    "sense_definition": "In a way that happens by chance or unexpectedly, rather than being planned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist discovered the new medicine <w>accidentally</w> while studying something else.",
                            "target_lang_translations": {
                                "ru": "Учёный открыл новое лекарство <w>случайно</w>, изучая что-то другое.",
                                "tr": "Bilim insanı, başka bir şey üzerinde çalışırken yeni ilacı <w>tesadüfen</w> keşfetti.",
                                "zh": "科学家在研究其他课题时<w>偶然</w>发现了这种新药。",
                                "nl": "De wetenschapper ontdekte het nieuwe medicijn <w>toevallig</w> terwijl hij iets anders bestudeerde.",
                                "pl": "Naukowiec odkrył nowy lek <w>przypadkowo</w>, badając coś innego.",
                                "de": "Der Wissenschaftler entdeckte das neue Medikament <w>zufällig</w>, während er etwas anderes untersuchte.",
                                "fr": "Le scientifique a découvert le nouveau médicament <w>par hasard</w> en étudiant autre chose.",
                                "it": "Lo scienziato ha scoperto il nuovo farmaco <w>casualmente</w> mentre studiava qualcos'altro.",
                                "cs": "Vědec objevil nový lék <w>náhodou</w>, když studoval něco jiného.",
                                "es": "El científico descubrió la nueva medicina <w>por casualidad</w> mientras estudiaba otra cosa."
                            }
                        },
                        {
                            "text": "We met <w>accidentally</w> at the train station this morning.",
                            "target_lang_translations": {
                                "ru": "Мы <w>случайно</w> встретились на вокзале сегодня утром.",
                                "tr": "Bu sabah tren istasyonunda <w>tesadüfen</w> karşılaştık.",
                                "zh": "今天早上我们在火车站<w>碰巧</w>遇见了。",
                                "nl": "We kwamen elkaar vanmorgen <w>toevallig</w> tegen op het treinstation.",
                                "pl": "Spotkaliśmy się <w>przypadkowo</w> na dworcu kolejowym dziś rano.",
                                "de": "Wir haben uns heute Morgen <w>zufällig</w> am Bahnhof getroffen.",
                                "fr": "Nous nous sommes rencontrés <w>par hasard</w> à la gare ce matin.",
                                "it": "Ci siamo incontrati <w>per caso</w> alla stazione ferroviaria stamattina.",
                                "cs": "Dnes ráno jsme se <w>náhodou</w> potkali na nádraží.",
                                "es": "Nos encontramos <w>accidentalmente</w> en la estación de tren esta mañana."
                            }
                        }
                    ],
                    "synonyms": [
                        "by chance",
                        "unexpectedly",
                        "unintentionally",
                        "by mistake"
                    ],
                    "antonyms": [
                        "intentionally",
                        "deliberately",
                        "by design"
                    ],
                    "common_phrases": [
                        "discovered accidentally",
                        "met accidentally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неожиданно, по воле случая, а не по плану.",
                        "tr": "Planlanmış olmaktan ziyade tesadüfen veya beklenmedik bir şekilde.",
                        "zh": "并非计划之内，而是偶然或出乎意料地发生。",
                        "nl": "Op een manier die door toeval of onverwacht gebeurt, in plaats van gepland.",
                        "pl": "W sposób, który wydarzył się przez przypadek lub nieoczekiwanie, a nie zgodnie z planem.",
                        "de": "Auf eine Weise, die durch Zufall oder unerwartet geschieht, anstatt geplant zu sein.",
                        "fr": "De manière fortuite ou inattendue, plutôt que prévue.",
                        "it": "In modo che accada per caso o inaspettatamente, piuttosto che essere pianificato.",
                        "cs": "Způsobem, který se stane náhodou nebo nečekaně, nikoliv plánovaně.",
                        "es": "De una manera que sucede por casualidad o inesperadamente, en lugar de ser planeado."
                    },
