                "senses": [
                    {
                        "sense_id": "59a762da-7c7c-3f68-819b-a751115f4c58",
                        "entry_id": "dd5e7fe0-c63c-3225-96c4-b686e445d68a",
                        "glosses": [
                            "Autrefois, monopole de la royauté espagnole ou monopole seigneurial ou communal, selon les lieux ou les époques, sur la vente du sel ou du vin puis sur la vente du tabac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9727118-b73c-40c4-99ae-669306e27032",
                                "sense_id": "59a762da-7c7c-3f68-819b-a751115f4c58",
                                "text": "Il arriva, par conséquent que le nouvel estanco en vint à restaurer les situations antérieures d’intervention et de monopole instituées par l’ordonnance de 1338."
                            },
                            {
                                "example_id": "9b9865f2-446a-441e-aca0-16ad5063c703",
                                "sense_id": "59a762da-7c7c-3f68-819b-a751115f4c58",
                                "text": "L’estanco et la tyrannie de ses agents a manqué plus d’une fois soulever les populations montagnardes du Guatemala."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb2e1e89-d189-369f-be63-d61c4e24b657",
                        "entry_id": "dd5e7fe0-c63c-3225-96c4-b686e445d68a",
                        "glosses": [
                            "Gargote, débit de boissons, bistrot."
                        ],
                        "tags": [
                            "familiar",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c03e9fe8-147b-4525-bd73-100e52c34848",
                                "sense_id": "fb2e1e89-d189-369f-be63-d61c4e24b657",
                                "text": "L’estanco des Popoff avait été, avant que les beatniks l’assiègent, un rade dont je me demande encore pourquoi et comment il peut drainer une telle légende… si ce n’est parce qu’on laisse la clientèle fumer ses joints en toute tranquillité. C’était avant cela, un \"Vins et charbons\" ordinaire, comme il y en a encore beaucoup à Paris."
                            },
                            {
                                "example_id": "c83d0708-6ab5-4fbd-b70e-527db13230c5",
                                "sense_id": "fb2e1e89-d189-369f-be63-d61c4e24b657",
                                "text": "- Un verre de bière s’il vous plaît. Puis-je téléphoner ? Il me désigne l’appareil fixe, au mur. Ça la fout mal qu’il n’y ait pas de cabine, je vais être obligé de débiter ma salade devant le brave homme de l’estanco."
                            },
                            {
                                "example_id": "286413fa-75af-4b6f-a233-72338567531f",
                                "sense_id": "fb2e1e89-d189-369f-be63-d61c4e24b657",
                                "text": "Direction sud-ouest de Paris en plein bois de Meudon, chef-lieu de canton des Hauts-de-Seine, […], pour amerrir dans La Mare aux Canards, coin-coin, pas de mare et aucun palmipède, sinon dans la cheminée de l’estanco, […].,"
                            }
                        ]
                    },
                    {
                        "sense_id": "4d9e780d-bf1e-3a08-921d-482c4a61a29c",
                        "entry_id": "dd5e7fe0-c63c-3225-96c4-b686e445d68a",
                        "glosses": [
                            "Boutique."
                        ],
                        "tags": [
                            "familiar",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d1abef51-db0e-45ce-9774-48af1bf1ef0d",
                                "sense_id": "4d9e780d-bf1e-3a08-921d-482c4a61a29c",
                                "text": "Je donnerais votre bras droit pour aller renifler un peu l'intérieur de cet estanco."
                            },
                            {
                                "example_id": "324de2bc-0b6d-4c68-93a7-a7a7666f467a",
                                "sense_id": "4d9e780d-bf1e-3a08-921d-482c4a61a29c",
                                "text": "Ensemble on est allé chez Moltegomme, l’estanco de la rue d’Angleterre. Un vieux con, ce mec-là ; toujours à mater si vous lui fauchez pas un calendo ou un sauciflard."
                            }
                        ]
                    },
                    {
                        "sense_id": "17422194-4019-3721-9855-315cedcff351",
                        "entry_id": "dd5e7fe0-c63c-3225-96c4-b686e445d68a",
                        "glosses": [
                            "Cabanon."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "842e71cf-cbd9-4a30-aa84-9d3657c8e7a4",
                                "sense_id": "17422194-4019-3721-9855-315cedcff351",
                                "text": "En rangeant l’estanco du jardin où grimpe des roses au parfum subtil, elle trouve même des sachets de graines de plantes vivaces : corbeilles d’or, giroflées, œillets, primevères, violettes."
                            }
                        ]
                    }
