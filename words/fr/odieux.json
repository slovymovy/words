            "senses": [
                {
                    "sense_id": "7393047b-0bab-39c4-8b2e-7d3403aa7eda",
                    "sense_definition": "Qui a un comportement très désagréable, blessant ou pénible envers autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est souvent <w>odieux</w> avec ses collègues dès le matin sans aucune raison valable."
                        },
                        {
                            "text": "Tu as été <w>odieuse</w> avec les invités pendant tout le dîner hier soir."
                        }
                    ],
                    "synonyms": [
                        "insupportable"
                    ],
                    "antonyms": [
                        "aimable",
                        "charmant"
                    ],
                    "common_phrases": [
