                "senses": [
                    {
                        "sense_id": "704f42bd-e4b4-36a9-b592-e86508112487",
                        "entry_id": "391b72ba-11e9-3b67-ab4c-4ee3280f4d50",
                        "glosses": [
                            "S’ouvrir de soi-même, sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25ff6b2c-e6ef-46c2-aae6-dad344835e29",
                                "sense_id": "704f42bd-e4b4-36a9-b592-e86508112487",
                                "text": "Le peps du psy se renferme dans une canette de Pepsi Max qui est libre de s'auto-ouvrir."
                            },
                            {
                                "example_id": "86f98631-8b6a-47be-b031-79a14d4dcdf6",
                                "sense_id": "704f42bd-e4b4-36a9-b592-e86508112487",
                                "text": "Oui, ils travaillent pour des décideurs, pour des cadres tapis dans l'administration pour s'auto-ouvrir les vannes de l'enrichissement illicite."
                            },
                            {
                                "example_id": "2a98c4c5-6ec0-4d02-a7a5-ff6e18c3a7fd",
                                "sense_id": "704f42bd-e4b4-36a9-b592-e86508112487",
                                "text": "On va devoir s'auto-ouvrir les cervelles pour tirer ces sources, en ce qui me concerne j'ai encore tellement à vivre que je n'imagine pas un tel sacrifice."
                            }
                        ]
                    }
