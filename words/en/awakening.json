{
    "word_family": [
        "awake",
        "awaken",
        "wake",
        "waken"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70e497a2-ee15-3b29-bcdf-4b8f451f82d3",
                    "sense_definition": "The act of waking up from sleep.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <awakening> was caused by a loud crash outside.",
                            "target_lang_translations": {
                                "ru": "Его внезапное <w>пробуждение</w> было вызвано громким грохотом снаружи.",
                                "zh": "他突然<w>苏醒</w>是因为外面传来的一声巨响。"
                            }
                        },
                        {
                            "text": "She stretched her arms after a long and restful <awakening>.",
                            "target_lang_translations": {
                                "ru": "Она потянулась после долгого и спокойного <w>пробуждения</w>.",
                                "zh": "经过长时间安稳的<w>苏醒</w>后，她伸了个懒腰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "waking",
                        "waking up"
                    ],
                    "antonyms": [
                        "sleeping"
                    ],
                    "common_phrases": [
                        "slow awakening",
                        "morning awakening"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт пробуждения ото сна.",
                        "zh": "从睡眠中醒来的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробуждение",
                                "target_lang_sense_clarification": "ото сна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苏醒",
                                "target_lang_sense_clarification": "从睡眠或昏迷中醒来"
                            },
                            {
                                "target_lang_word": "醒来",
                                "target_lang_sense_clarification": "从睡眠状态恢复清醒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "faf0c5cd-2957-32c0-925f-1cb60956b58e",
                    "sense_definition": "The moment of becoming aware of something or realizing a truth.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The financial report was a rude <awakening> for the company directors.",
                            "target_lang_translations": {
                                "ru": "Финансовый отчет стал для директоров компании горьким <w>прозрением</w>.",
                                "zh": "这份财务报告让公司董事们经历了一次残酷的<w>觉醒</w>。"
                            }
                        },
                        {
                            "text": "He experienced a spiritual <awakening> that completely changed his perspective on life.",
                            "target_lang_translations": {
                                "ru": "Он пережил духовное <w>пробуждение</w>, которое полностью изменило его взгляд на жизнь.",
                                "zh": "他经历了一次精神上的<w>觉醒</w>，这彻底改变了他的人生观。"
                            }
                        }
                    ],
                    "synonyms": [
                        "realization",
                        "epiphany",
                        "discovery"
                    ],
                    "common_phrases": [
                        "rude awakening",
                        "spiritual awakening"
                    ],
                    "target_lang_definitions": {
                        "ru": "Момент осознания чего-либо или понимания истины.",
                        "zh": "意识到某事或领悟到真理的时刻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осознание",
                                "target_lang_sense_clarification": "понимание"
                            },
                            {
                                "target_lang_word": "прозрение",
                                "target_lang_sense_clarification": "внезапное открытие"
                            },
                            {
                                "target_lang_word": "пробуждение",
                                "target_lang_sense_clarification": "духовное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "觉醒",
                                "target_lang_sense_clarification": "思想或意识上的觉悟"
                            },
                            {
                                "target_lang_word": "领悟",
                                "target_lang_sense_clarification": "对真理或事实的突然理解"
                            },
                            {
                                "target_lang_word": "认识",
                                "target_lang_sense_clarification": "对现实情况的清醒认知"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d414eb5-f4eb-3f2f-876e-932c5e42f828",
                    "sense_definition": "The beginning or rousing of a feeling, interest, or activity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel describes the emotional <awakening> of a young artist.",
                            "target_lang_translations": {
                                "ru": "В романе описывается эмоциональное <w>пробуждение</w> молодого художника.",
                                "zh": "这部小说描述了一位年轻艺术家的情感<w>觉醒</w>。"
                            }
                        },
                        {
                            "text": "Spring marks the <awakening> of nature after a cold winter.",
                            "target_lang_translations": {
                                "ru": "Весна знаменует собой <w>пробуждение</w> природы после холодной зимы.",
                                "zh": "春天标志着寒冬过后大自然的<w>复苏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "activation",
                        "birth",
                        "rousing"
                    ],
                    "antonyms": [
                        "suppression"
                    ],
                    "common_phrases": [
                        "sexual awakening",
                        "cultural awakening"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начало или возникновение чувства, интереса или деятельности.",
                        "zh": "某种情感、兴趣或活动的开始或激发。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробуждение",
                                "target_lang_sense_clarification": "чувств или природы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唤醒",
                                "target_lang_sense_clarification": "激发某种情感或兴趣"
                            },
                            {
                                "target_lang_word": "复苏",
                                "target_lang_sense_clarification": "自然界或活动的重新活跃"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4643ef2b-c6ef-3f83-8627-eb0b0068c014",
                    "sense_definition": "A period of renewed interest in religion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historians often discuss the impact of the Great <Awakening> on society.",
                            "target_lang_translations": {
                                "ru": "Историки часто обсуждают влияние Великого <w>пробуждения</w> на общество.",
                                "zh": "历史学家经常讨论“大<w>觉醒</w>”运动对社会的影响。"
                            }
                        },
                        {
                            "text": "The community experienced a religious <awakening> during the last century.",
                            "target_lang_translations": {
                                "ru": "В прошлом веке община пережила религиозное <w>пробуждение</w>.",
                                "zh": "上个世纪，该社区经历了一次宗教<w>觉醒</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "revival"
                    ],
                    "common_phrases": [
                        "Great Awakening"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период возрождения интереса к религии.",
                        "zh": "宗教信仰兴趣复兴的时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробуждение",
                                "target_lang_sense_clarification": "религиозное возрождение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "觉醒",
                                "target_lang_sense_clarification": "宗教运动或信仰的复兴"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2939489-f356-36b3-9809-f39dd08c2024",
                    "sense_definition": "Present participle and gerund of <w>awaken</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud noise is <awakening> the baby in the next room.",
                            "target_lang_translations": {
                                "ru": "Громкий шум <w>будит</w> ребенка в соседней комнате.",
                                "zh": "巨大的噪音正在<w>唤醒</w>隔壁房间的婴儿。"
                            }
                        },
                        {
                            "text": "She is slowly <awakening> to the reality of her situation.",
                            "target_lang_translations": {
                                "ru": "Она медленно <w>осознает</w> реальность своей ситуации.",
                                "zh": "她正在慢慢<w>觉醒</w>，意识到自己所处的现实状况。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола awaken.",
                        "zh": "动词 awaken 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "будящий",
                                "target_lang_sense_clarification": "нарушающий сон"
                            },
                            {
                                "target_lang_word": "осознающий",
                                "target_lang_sense_clarification": "начинающий понимать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唤醒",
                                "target_lang_sense_clarification": "使某人从睡眠中醒来"
                            },
                            {
                                "target_lang_word": "觉醒",
                                "target_lang_sense_clarification": "开始意识到现实"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a07cfff4-897f-3a0a-ba10-9d9e088cce18",
                    "sense_definition": "Causing someone to become awake, active, or aware.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched the <awakening> city come to life as the sun rose.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как оживает <w>просыпающийся</w> город, когда вставало солнце.",
                                "zh": "随着太阳升起，我们看着这座<w>苏醒的</w>城市变得生机勃勃。"
                            }
                        },
                        {
                            "text": "It was an <awakening> experience that taught me a lot about myself.",
                            "target_lang_translations": {
                                "ru": "Это был <w>просветляющий</w> опыт, который многому научил меня о самом себе.",
                                "zh": "那是一次<w>启发性的</w>经历，让我对自己有了很多了解。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rousing",
                        "stimulating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий пробуждение, активность или осознание.",
                        "zh": "使人变得清醒、活跃或有意识的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просыпающийся",
                                "target_lang_sense_clarification": "становящийся активным"
                            },
                            {
                                "target_lang_word": "пробуждающий",
                                "target_lang_sense_clarification": "вызывающий осознание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苏醒的",
                                "target_lang_sense_clarification": "正在变得活跃的"
                            },
                            {
                                "target_lang_word": "启发的",
                                "target_lang_sense_clarification": "使人产生深刻认识的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}