{
    "word_family": [
        "tell",
        "telling",
        "untold"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42695eea-863d-3a6a-9002-af08e764baae",
                    "sense_definition": "A bank employee who handles deposits and withdrawals.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "banking_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>teller</w> counted the cash carefully before handing it to the customer.",
                            "target_lang_translations": {
                                "zh": "<w>银行柜员</w>在把现金交给顾客之前仔细地清点了一遍。"
                            }
                        },
                        {
                            "text": "I went to the bank to speak with a <w>teller</w> about my savings account.",
                            "target_lang_translations": {
                                "zh": "我去了银行，找<w>银行柜员</w>咨询我的储蓄账户事宜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cashier"
                    ],
                    "common_phrases": [
                        "bank teller"
                    ],
                    "target_lang_definitions": {
                        "zh": "银行中负责办理存款和取款业务的工作人员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "银行柜员",
                                "target_lang_sense_clarification": "指在银行柜台工作的专业人员。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                    "sense_definition": "A person who processes payments at a business.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "banking_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>teller</w> at the grocery store scanned all the items quickly.",
                            "target_lang_translations": {
                                "zh": "杂货店的<w>收银员</w>迅速扫描了所有商品。"
                            }
                        },
                        {
                            "text": "She worked as a <w>teller</w> at the local cinema for many years.",
                            "target_lang_translations": {
                                "zh": "她在当地电影院当了多年的<w>收银员</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cashier"
                    ],
                    "target_lang_definitions": {
                        "zh": "在商店或企业中负责收款的工作人员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "收银员",
                                "target_lang_sense_clarification": "指在零售场所负责结算款项的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "293b9f78-122a-3438-a2fe-515ef605ca64",
                    "sense_definition": "A person who narrates stories or tales.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "narrator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>teller</w> captivated the children with his magical stories.",
                            "target_lang_translations": {
                                "zh": "那位老<w>讲述者</w>用他神奇的故事深深吸引了孩子们。"
                            }
                        },
                        {
                            "text": "She is a gifted <w>teller</w> of ancient folk legends.",
                            "target_lang_translations": {
                                "zh": "她是一位天赋异禀的民间传说<w>讲述者</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "story teller"
                    ],
                    "target_lang_definitions": {
                        "zh": "讲述故事或传说的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "讲述者",
                                "target_lang_sense_clarification": "指叙述故事的人。"
                            },
                            {
                                "target_lang_word": "讲故事的人",
                                "target_lang_sense_clarification": "指专门从事讲故事活动的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "506c981a-fb5d-3b68-b5ac-69c49c31ba26",
                    "sense_definition": "A person responsible for counting votes during an election.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "election_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>teller</w> announced the final results after the ballots were counted.",
                            "target_lang_translations": {
                                "zh": "选票清点完毕后，<w>计票员</w>宣布了最终结果。"
                            }
                        },
                        {
                            "text": "Each <w>teller</w> verified the count to ensure the election was fair.",
                            "target_lang_translations": {
                                "zh": "每位<w>计票员</w>都核对了票数，以确保选举公正。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "选举中负责清点选票的人员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "计票员",
                                "target_lang_sense_clarification": "指选举中专门负责统计票数的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "272fb4cd-e9f7-314a-8a17-1489f4017870",
                    "sense_definition": "A machine that allows customers to perform banking transactions automatically.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "banking_machine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used the <w>teller</w> outside the shop to withdraw some cash.",
                            "target_lang_translations": {
                                "zh": "我用了店外的那台<w>自动取款机</w>取了一些现金。"
                            }
                        },
                        {
                            "text": "The <w>teller</w> was out of order so I had to go inside.",
                            "target_lang_translations": {
                                "zh": "<w>自动取款机</w>坏了，所以我只好进到店里去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cash machine",
                        "ATM",
                        "automated teller machine"
                    ],
                    "target_lang_definitions": {
                        "zh": "自动办理银行交易的机器。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "自动取款机",
                                "target_lang_sense_clarification": "即ATM，用于自助存取款的设备。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "537b313b-b18a-32f8-b0dd-60d716191260",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The famous physicist Edward <w>Teller</w> was born in Hungary.",
                            "target_lang_translations": {
                                "zh": "著名物理学家爱德华·<w>泰勒</w>出生于匈牙利。"
                            }
                        },
                        {
                            "text": "Many people named <w>Teller</w> live in the United States.",
                            "target_lang_translations": {
                                "zh": "许多姓<w>泰勒</w>的人居住在美国。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "泰勒",
                                "target_lang_sense_clarification": "常见的西方姓氏音译。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06b6138c-3fb0-34d2-ab5c-b457751a6928",
                    "sense_definition": "A small city in Alaska.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The remote town of <w>Teller</w> is located in the Nome Census Area.",
                            "target_lang_translations": {
                                "zh": "偏远的<w>泰勒</w>镇位于诺姆普查区。"
                            }
                        },
                        {
                            "text": "Travelers often visit <w>Teller</w> to experience the Alaskan wilderness.",
                            "target_lang_translations": {
                                "zh": "游客经常造访<w>泰勒</w>，以体验阿拉斯加的荒野风光。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "位于美国阿拉斯加州的一个小城市。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "泰勒",
                                "target_lang_sense_clarification": "地名音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}