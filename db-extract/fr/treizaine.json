                            {
                                "example_id": "0261942b-0200-48bf-9b37-b4149521d500",
                                "sense_id": "27eb284d-e038-3a84-8023-82230fc15982",
                                "text": "Au sujet de la dix-neuvième treizaine, il indiquera que l’animal face à Xochiquetzal est « lié sur un siège un peu bas », alors qu’il s’agit en fait de son maxtlatl."
                            }
                        ]
                    },
