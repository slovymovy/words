                                    },
                                    {
                                        "sense_id": "1af97d20-e5e1-39a5-a012-f40936cbf57a",
                                        "entry_id": "f6b4f7e3-1b7c-3f42-954c-c022c0e6b9c7",
                                        "glosses": [
                                            "Used for emotional emphasis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a1515ba-cb2e-4131-9ddc-d387c254d079",
                                                "sense_id": "1af97d20-e5e1-39a5-a012-f40936cbf57a",
                                                "text": "Now don't you wait or hesitate / Let's move before they raise the parking rate, ow!"
                                            },
                                            {
                                                "example_id": "c50f96f4-ec0e-440e-b762-e62bcd0e1c53",
                                                "sense_id": "1af97d20-e5e1-39a5-a012-f40936cbf57a",
                                                "text": "Then you ran into the bedroom / You were struck down / It was your doom, Annie / Ow!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "424f0851-7c9b-35cd-93d6-195192e70d74",
                                        "entry_id": "61573347-4358-30b7-8def-0e138d780ad9",
                                        "glosses": [
                                            "An uttering of an 'ow'."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9b993fe-cbab-4561-aadf-cc5dee2be101",
                                                "sense_id": "424f0851-7c9b-35cd-93d6-195192e70d74",
                                                "text": "Improvising a stretcher from a cupboard door, they levered Mrs Dibble on to it and got her upstairs to \"Hoos!\" and \"Ows!\" of anguish, and laid her on the bed, where Rita administered another stiff dose of gin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13033d02-9813-4896-b3f7-85a17f0d6bff",
                        "source_entry_id": "aaa4dabc-aa90-384e-89d9-608d213b81a6",
                        "source_sense_id": "e39e2392-00a1-334a-915b-4ffbc01b0aa1",
                        "source_sense_description": "Ausruf, um Schmerz zu signalisieren",
                        "target_lang_word": "aïe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aïe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc9e0f86-bc31-3a70-8703-78fe8da9974a",
                                        "entry_id": "c722ff1d-1630-369a-a086-5838e091795c",
                                        "glosses": [
                                            "Cri exprimant la douleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21926689-64a5-4331-973e-cd240ebec4f2",
                                                "sense_id": "cc9e0f86-bc31-3a70-8703-78fe8da9974a",
                                                "text": "Aïe ! je me suis fait mal !"
                                            },
                                            {
                                                "example_id": "903c8091-a075-44d5-9f85-2299f9f148c2",
                                                "sense_id": "cc9e0f86-bc31-3a70-8703-78fe8da9974a",
                                                "text": "Aïe ! Que je souffre !"
                                            },
                                            {
                                                "example_id": "10197ce8-13cf-41d5-abbc-a2a2a09cfc5d",
                                                "sense_id": "cc9e0f86-bc31-3a70-8703-78fe8da9974a",
                                                "text": "Un heurt de la roue contre une pierre assez grosse que le charreton n’avait pas vue fit pousser au galant un Aïe ! d’angoisse et de douleur, sur quoi Scapin entama la conversation en feignant de le plaindre."
                                            },
                                            {
                                                "example_id": "2d7d2128-672a-48cf-9722-8b4059ad9e2a",
                                                "sense_id": "cc9e0f86-bc31-3a70-8703-78fe8da9974a",
                                                "text": "– Aïe ! Ouille ! Pfff ! Oulala !\n Crise de rire. Invariablement nous nous brûlons les doigts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e27eecb0-39eb-3146-96b6-4ab1ed39ce50",
                                        "entry_id": "c722ff1d-1630-369a-a086-5838e091795c",
                                        "glosses": [
                                            "Cri lancé lorsqu’un événement met quelqu’un dans un état d’inquiétude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "735b9567-f67f-43ca-9542-10ad1e6d8c7e",
                                                "sense_id": "e27eecb0-39eb-3146-96b6-4ab1ed39ce50",
                                                "text": "Aïe ! J’ai laissé les clés sur la voiture."
                                            },
                                            {
                                                "example_id": "638b6f20-5140-4aca-9bd1-a8fb40b0d627",
                                                "sense_id": "e27eecb0-39eb-3146-96b6-4ab1ed39ce50",
                                                "text": "Je me baisse d’une masse, avec une grâce de coltineur pour mon service des cabinets. J’ignore les hésitations de mains blanches, je tripote à même, aïe donc !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72ba24db-17f3-30a4-af11-37bdb1c51a80",
                                        "entry_id": "c722ff1d-1630-369a-a086-5838e091795c",
                                        "glosses": [
                                            "Cri pour faire avancer un cheval."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
