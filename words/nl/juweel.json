                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jewel",
                                "target_lang_sense_clarification": "a piece of jewelry"
                            },
                            {
                                "target_lang_word": "piece of jewelry",
                                "target_lang_sense_clarification": "general term for an ornament"
                            }
                        ]
                    }
                },
                {
