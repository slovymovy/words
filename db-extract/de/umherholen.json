                        ],
                        "examples": [
                            {
                                "example_id": "f024ce20-a718-41d7-b567-f2c82152c8b7",
                                "sense_id": "279d3da7-9254-3247-8dda-9b18a904ea40",
                                "text": "„Weil wenn’s recht hoaß is und er is ned dahoam, dann geh i mit da Giaßkanna in sein Gartn ume, do hod er nämlich a Wasserleitung, und dann hol i mein Schnee als Wasser wieder uma.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e805df57-0c00-4ff8-900d-e7cdbc06a809",
                        "source_entry_id": "66f4a852-4448-3728-a92d-93ecb623f81f",
                        "source_sense_id": "279d3da7-9254-3247-8dda-9b18a904ea40",
                        "source_sense_description": "bairisch: zum Sprecher herüberholen",
                        "target_lang_word": "herüberholen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herüberholen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84f73b6e-7353-3ab3-8f5b-0220c7abaabb",
                                        "entry_id": "0023fbd2-2c63-3509-babc-a75b263e1598",
                                        "glosses": [
                                            "von dort drüben, aus einem anderen Raum hierher holen"
                                        ],
                                        "tags": [
                                            "transitiv, von Personen oder Sachen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d19a5ab9-b6ec-44e4-9b2a-8d59e6f3503b",
                                                "sense_id": "84f73b6e-7353-3ab3-8f5b-0220c7abaabb",
                                                "text": "Michael hat Schwierigkeiten, Steine aus dem weit entfernten Kasten herauszunehmen, will sich den Kasten herüberholen und zerstört dabei das Bauwerk."
                                            },
                                            {
                                                "example_id": "fba16cbf-2836-4c98-baf6-101f9801c232",
                                                "sense_id": "84f73b6e-7353-3ab3-8f5b-0220c7abaabb",
                                                "text": "Sie ermöglichen es bis zu einem gewissen Grade, ungewohnte Raumzeit-Phänomene in die vertrautere Umgebung des Alltagsraumes herüberzuholen und so anschaulicher zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "834d2fb3-1136-3577-a424-9d39f84dc952",
                                        "entry_id": "0023fbd2-2c63-3509-babc-a75b263e1598",
                                        "glosses": [
                                            "aus einer anderen Region hierher in die eigene Region holen"
                                        ],
                                        "tags": [
                                            "transitiv, von Personen oder Sachen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87efefdf-6b4c-4555-b294-8b64c3eea205",
                                                "sense_id": "834d2fb3-1136-3577-a424-9d39f84dc952",
                                                "text": "»Das Volk«, schrie man, »gerät dadurch in Schande und üble Nachrede, da es die öffentlichen Gelder der Griechen aus Delos zu sich herübergeholt hat …«"
                                            },
                                            {
                                                "example_id": "dc240201-102d-402e-88ba-d5f11fd7fa66",
                                                "sense_id": "834d2fb3-1136-3577-a424-9d39f84dc952",
                                                "text": "Man ist mittendrin in diesem Nachkriegsjugoslawien, aus dem der Verlag Voland & Quist schon so viele beeindruckende Bücher herübergeholt hat in unsere Leselandschaft."
                                            },
                                            {
                                                "example_id": "45cbf564-9b83-4a72-ae0d-377565297003",
                                                "sense_id": "834d2fb3-1136-3577-a424-9d39f84dc952",
                                                "text": "Er verheimlicht nicht, dass sie mit zahlreichen Herausforderungen konfrontiert sind, vom Mangel an Arbeitskräften, aufgrund dessen, wie er sagt, Bauunternehmen Arbeiter aus Vietnam, Algerien und Nepal herüberholen, bis hin zum Verbot, Geschäfte mit russischen und chinesischen Unternehmen zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
