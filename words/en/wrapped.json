                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wrapped</w> package arrived by mail this morning.",
                            "target_lang_translations": {
                                "ru": "<w>Упакованная</w> посылка пришла по почте сегодня утром.",
                                "zh": "那个<w>包装好的</w>包裹今天早上寄到了。"
                            }
                        },
                        {
                            "text": "He placed the <w>wrapped</w> sandwich in his lunchbox.",
