                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "condigne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d65f2711-d843-3a58-a85d-7c204c95b774",
                                        "entry_id": "0ec4cd49-37c5-3ab0-a92e-bd89d54ca7b2",
                                        "glosses": [
                                            "Égal en dignité à la faute ou à la récompense."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "959f0dea-c5d0-41bb-a789-0c5d316b339d",
                                                "sense_id": "d65f2711-d843-3a58-a85d-7c204c95b774",
                                                "text": "Satisfaction condigne, satisfaction parfaitement égale à la faute."
                                            },
                                            {
                                                "example_id": "c92d8f2c-e09c-4d19-8be4-519abfd40047",
                                                "sense_id": "d65f2711-d843-3a58-a85d-7c204c95b774",
                                                "text": "Mérite condigne, mérite égal à la récompense."
                                            },
                                            {
                                                "example_id": "6ca1a1e7-527d-47b8-adfb-6ea2fb384209",
                                                "sense_id": "d65f2711-d843-3a58-a85d-7c204c95b774",
                                                "text": "Leur procès faict il y eust si grand ouverture des larrecins qu’ilz faisoient que dix-huict en furent par une mesme sentence desdictz seigneurs du Capitolle confirmée par arrest de la court condamnez à estre penduz et depuis executez à ung gibet portatif edifié à quatre roues en certains lieux et places publiques des principalles de ladicte ville et les autres condamnez à servir le roy aux galleres, que fut punition condigne aux condamnez et exemplaire aux autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e2f36b4-da4a-4cdc-91bd-05977c59a10a",
                        "source_entry_id": "86b65d74-7f98-36c7-88a4-d3e90dd21722",
                        "source_sense_id": "fb61cf76-bc0e-3008-8048-8d9f922526bd",
                        "source_sense_description": "fitting",
                        "target_lang_word": "angemessen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angemessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                        "entry_id": "da0ab13e-61be-3b81-b8ad-9c0cfb1bb7ae",
                                        "glosses": [
                                            "den Verhältnissen entsprechend, passend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8caf65fa-6c23-4acb-babb-c7d8b2cd6611",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "Der Preis ist angemessen."
                                            },
                                            {
                                                "example_id": "155ddf90-ecd5-4849-bbc6-85a7d70d47f2",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "„Linguistinnen und Linguisten verfügen idealerweise über vielfältige sprachliche Register und Stile, die es ihnen ermöglichen, fachliche Inhalte adressatengerecht zu kommunizieren, und sie wissen, welche Form welchem Adressatenkreis gegenüber angemessen ist.“"
                                            },
                                            {
                                                "example_id": "da14ded4-cf0e-49a9-a412-3c1218c0ebc6",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "Was stellen Sie sich denn genau unter einer angemessenen Vergütung vor?"
                                            },
                                            {
                                                "example_id": "c741f45c-6ea3-4b5d-88db-4cdac471f6ee",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "In manchen Geschäften wird Kleidung verkauft, die sehr billig ist. Sie wird von Menschen im Ausland hergestellt, die nicht angemessen dafür bezahlt werden."
                                            },
                                            {
                                                "example_id": "ff159eaf-0a44-49db-8aaa-4f928e405f3b",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "Der Staat muss für eine angemessene Unterbringung von Asylbewerbern sorgen, so hat es jetzt der Europäische Gerichtshof entschieden."
                                            },
                                            {
                                                "example_id": "ba4cec2d-7e30-407d-b8c5-23bb7fae065d",
                                                "sense_id": "01d3114c-11fd-3097-8e8f-53c91ab31a09",
                                                "text": "Bis heute wird in Deutschland äußerst kontrovers über einen angemessenen Umgang mit [Hitlers Buch] \"Mein Kampf\" diskutiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
