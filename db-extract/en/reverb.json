                "senses": [
                    {
                        "sense_id": "2064d90d-224d-3f23-9141-337ad4081a6b",
                        "entry_id": "f6f242c8-31d0-3a1c-a8b9-1160934f203e",
                        "glosses": [
                            "An electronic effect which simulates echoes or reverberations in the sound signal being processed."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "29381523-fe7d-479d-b458-8a314fea93cb",
                                "sense_id": "2064d90d-224d-3f23-9141-337ad4081a6b",
                                "text": "The band is starting, something lonesome, off-key, and drowning in reverb."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "604a883e-e23a-45a1-bc16-7cc7fbc48696",
