{
    "word_family": [
        "ripe",
        "ripen",
        "ripeness",
        "unripeness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1d0c2070-fbd4-3fdb-8f08-83f38b0f7fe5",
                    "sense_definition": "Not yet fully grown, mature, or ready to be eaten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "maturity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bananas were still green and <w>unripe</w>, so we left them on the counter.",
                            "target_lang_translations": {
                                "ru": "Бананы были ещё зелёными и <w>неспелыми</w>, поэтому мы оставили их на столе."
                            }
                        },
                        {
                            "text": "Eating <w>unripe</w> fruit can sometimes cause a stomach ache.",
                            "target_lang_translations": {
                                "ru": "Употребление <w>незрелых</w> фруктов иногда может вызвать боль в животе."
                            }
                        }
                    ],
                    "synonyms": [
                        "green",
                        "immature"
                    ],
                    "antonyms": [
                        "ripe"
                    ],
                    "common_phrases": [
                        "unripe fruit",
                        "unripe bananas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Еще не достигший полной зрелости, не созревший или не готовый к употреблению в пищу (о плодах, растениях)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неспелый",
                                "target_lang_sense_clarification": "о плодах и ягодах"
                            },
                            {
                                "target_lang_word": "незрелый",
                                "target_lang_sense_clarification": "не достигший спелости"
                            },
                            {
                                "target_lang_word": "недозрелый",
                                "target_lang_sense_clarification": "не до конца созревший"
                            },
                            {
                                "target_lang_word": "зелёный",
                                "target_lang_sense_clarification": "о плодах, в значении неспелый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20599a5c-5c3f-3d3c-a951-bcb9a6a6c0df",
                    "sense_definition": "Developing too early; occurring before the appropriate or expected time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "maturity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company suffered from an <w>unripe</w> launch before the software was properly tested.",
                            "target_lang_translations": {
                                "ru": "Компания пострадала из-за <w>преждевременного</w> запуска, проведённого до того, как программное обеспечение было должным образом протестировано."
                            }
                        },
                        {
                            "text": "His <w>unripe</w> theories were dismissed by senior academics as hurried and unconvincing.",
                            "target_lang_translations": {
                                "ru": "Его <w>незрелые</w> теории были отвергнуты опытными учёными как поспешные и неубедительные."
                            }
                        }
                    ],
                    "synonyms": [
                        "premature",
                        "untimely"
                    ],
                    "antonyms": [
                        "ripe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Появившийся или произошедший слишком рано, преждевременно; недостаточно продуманный или сформированный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преждевременный",
                                "target_lang_sense_clarification": "наступивший раньше времени"
                            },
                            {
                                "target_lang_word": "незрелый",
                                "target_lang_sense_clarification": "недостаточно развитый, непродуманный"
                            },
                            {
                                "target_lang_word": "сырой",
                                "target_lang_sense_clarification": "недоработанный, требующий завершения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}