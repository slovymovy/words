                            "comment": "verleden aanvoegende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the past subjunctive form of the verb 'opgeven' (to give up/surrender)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gave up",
                                "target_lang_sense_clarification": "subjunctive/hypothetical past of 'to give up'"
                            },
                            {
                                "target_lang_word": "surrendered",
                                "target_lang_sense_clarification": "subjunctive/hypothetical past of 'to surrender'"
