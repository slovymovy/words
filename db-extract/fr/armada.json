        "fr-extract.jsonl": [
            {
                "entry_id": "f1162f3d-d4cb-37f4-8ef5-37d3934b8926",
                "word": "armada",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "770c28f7-2d08-47da-b723-cd4c4f07b310",
                        "entry_id": "f1162f3d-d4cb-37f4-8ef5-37d3934b8926",
                        "tags": [
                            "plural"
                        ],
                        "form": "armadas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b8ce5f2-030b-3d9e-99c5-3725840a4729",
                        "entry_id": "f1162f3d-d4cb-37f4-8ef5-37d3934b8926",
                        "glosses": [
                            "Grande flotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0fbf4ad-6da2-4a25-b0af-38050514739a",
                                "sense_id": "6b8ce5f2-030b-3d9e-99c5-3725840a4729",
                                "text": "Sur les deux murs se faisant vis-à-vis se déployait, en tableaux successifs, une vaste tapisserie donnée aux lords par Élisabeth et représentant toute l’aventure de l'armada depuis son départ d’Espagne jusqu’à son naufrage devant l’Angleterre."
                            },
                            {
                                "example_id": "1231811d-8b98-431f-ae77-04528a01d810",
                                "sense_id": "6b8ce5f2-030b-3d9e-99c5-3725840a4729",
                                "text": "L’Espagne ne s’était jamais remise du désastre naval de l’Armada."
                            },
                            {
                                "example_id": "ebba6958-a09e-47c2-b52a-afff6145c94a",
                                "sense_id": "6b8ce5f2-030b-3d9e-99c5-3725840a4729",
                                "text": "Cette armada, emmenée par les cinquante canons de la Némésis, fit route vers le sud, fendant les eaux verdâtres de la mer de Chine toutes voiles dehors. Le continent pour point de mire."
                            }
                        ]
                    },
                    {
                        "sense_id": "88fea610-d3a4-3b6c-9431-3b132c37337d",
                        "entry_id": "f1162f3d-d4cb-37f4-8ef5-37d3934b8926",
                        "glosses": [
                            "Grande escadre aérienne."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "00a4fdf8-02e7-47f6-aab8-9dd7ab43ba5b",
                                "sense_id": "88fea610-d3a4-3b6c-9431-3b132c37337d",
                                "text": "Rassemblés autour d’un trou noir, des armadas extra-terrestres luttent pour le contrôle de la galaxie."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b538a76-0b3c-3f7f-88a7-bd47562d2f70",
                        "entry_id": "f1162f3d-d4cb-37f4-8ef5-37d3934b8926",
                        "glosses": [
                            "Grand ensemble."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "feaf9e1f-d263-4363-b2b7-6f8a5584b621",
                                "sense_id": "2b538a76-0b3c-3f7f-88a7-bd47562d2f70",
                                "text": "Pas simple en effet, face à l’invasion, ces dernières années, d'une armada de jeunes pousses à la lippe humide, de survivre télévisuellement quand, soi-même, on a fondé une grosse partie de son talent sur son capital érotique."
                            },
                            {
                                "example_id": "ebbbecb4-ab4c-4ced-b0ec-dd9a9c3907d2",
                                "sense_id": "2b538a76-0b3c-3f7f-88a7-bd47562d2f70",
                                "text": "Pendant leur traitement, les patients doivent renoncer à l’alcool, au tabac, au thé, au café, au vol et à la sexualité —  sans que quiconque ait vraiment compris ce que vient faire le vol dans cette armada de mesures prophylactiques, même s’il n’est pas exclus que d’autres délits perturbent le bon fonctionnement du traitement. — (Mikal Hem, Et si je devenais dictateur, traduit du norvégien par Jean-Baptiste Coursaud, Gaïa, 2017, page 81)"
                            },
                            {
                                "example_id": "40df746b-d31c-4503-ac51-4a49f90813c2",
                                "sense_id": "2b538a76-0b3c-3f7f-88a7-bd47562d2f70",
                                "text": "L’enquête la plus approfondie sur la santé de Poutine a été publiée en avril par le site russophone Proekt, sur la base de sources ouvertes, pour conclure que les voyages ces dernières années du président dans sa datcha de Sotchi, sur les bords de la Mer Noire, coïncidaient avec le déplacement d’une armada de médecins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88c6120b-bfd0-422b-99dd-ed5026fe4f12",
                        "source_entry_id": "f1162f3d-d4cb-37f4-8ef5-37d3934b8926",
                        "target_lang_word": "Armada",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armada",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66a56e98-3cdb-3982-a695-15be180b08e1",
                                        "entry_id": "df4e3a26-5b78-352c-84a6-7b8907c1f49b",
                                        "glosses": [
                                            "eine Kriegsflotte, die sich aus sehr vielen Schiffen zusammensetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f0f6478-fc49-4599-8958-ed06b5b99709",
                                                "sense_id": "66a56e98-3cdb-3982-a695-15be180b08e1",
                                                "text": "„Die französische Armada hat aus dem Hafen von Barcelona ungehindert sechs Schiffe und eine Galeere entführt.“"
                                            },
                                            {
                                                "example_id": "9a1818e0-74da-4a6c-880e-1e5c00f8764b",
                                                "sense_id": "66a56e98-3cdb-3982-a695-15be180b08e1",
                                                "text": "„Auch der Kapitän unserer kleinen Armada befand sich drüben auf der Lagerfeuer-Galeere.“"
                                            },
                                            {
                                                "example_id": "194b7b3f-05c4-4656-afaa-fe5910574d74",
                                                "sense_id": "66a56e98-3cdb-3982-a695-15be180b08e1",
                                                "text": "„Jahrhundertelang beherrschen die Osmanen und ihre Vasallen die nordafrikanische Küste – bis 1830 eine französische Armada Algier ansteuert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b424090-f5d7-3f23-8f84-debb5e02d00d",
                                        "entry_id": "df4e3a26-5b78-352c-84a6-7b8907c1f49b",
                                        "glosses": [
                                            "große Anzahl von Lebewesen oder Dingen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ef27931-efbf-46f8-9ecf-ef47048587fa",
                                                "sense_id": "0b424090-f5d7-3f23-8f84-debb5e02d00d",
                                                "text": "„Die Blaubeeren musste man sofort vom Strauch in den Mund stecken, bevor die Armada an Amseln und anderen Vögeln sie entdecken konnte und sie morgens vor unserem Aufstehen bereits vertilgt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
