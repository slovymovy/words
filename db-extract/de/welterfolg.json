                        "examples": [
                            {
                                "example_id": "7dca773f-22d5-4889-a0f7-0ef288a96e39",
                                "sense_id": "fa3a2109-4275-3608-b819-0c24bb2459fa",
                                "text": "Das Musical Cats wurde zu einem Welterfolg."
                            },
                            {
                                "example_id": "cb1740f5-adbb-498c-99cf-27af4591cdb0",
                                "sense_id": "fa3a2109-4275-3608-b819-0c24bb2459fa",
                                "text": "„Die nämlich hüllten sich überwiegend immer noch in Schweigen, als der Roman nicht mehr Gegenstand der aktuellen Debatte war und sein Welterfolg längst feststand.“"
                            },
                            {
                                "example_id": "854ff1d9-fea6-4e62-bffa-1b94cc10fdc4",
                                "sense_id": "fa3a2109-4275-3608-b819-0c24bb2459fa",
                                "text": "„Ich hatte davon gehört, dass dieser Roman Jahrzehnte nach seinem Erscheinen plötzlich zum Welterfolg geworden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
