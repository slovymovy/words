                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d30d757b-4627-4aed-ae4f-ac90ddb57639",
                                "sense_id": "7239cbe2-25aa-3712-984e-691db601a15b",
                                "text": "„Den Rest eines zunehmend verregnenden Sommers in Berlin verbrachte ich hauptsächlich in der Modellwerkstatt eines Freundes, dem ich bei der Vorbereitung von Exponaten für eine Ausstellung half.“"
                            }
