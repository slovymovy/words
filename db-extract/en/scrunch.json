                "translations": [
                    {
                        "translation_id": "edef15c1-afac-44c9-9fd5-8345ba5525d1",
                        "source_entry_id": "9fd44e64-e4ab-38a3-a72f-1125436afccf",
                        "source_sense_description": "crumple",
                        "target_lang_word": "knüllen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knüllen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "436bc3b6-6f3f-3b65-9c55-335ebf81d0a3",
                                        "entry_id": "70238837-15d6-3a61-b881-3c4ff632f364",
                                        "glosses": [
                                            "etwas zusammendrücken, zusammenknautschen (meist für Papier, Stoff oder Ähnliches)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338b1274-3520-410b-bbf5-d3842c5c0722",
                                                "sense_id": "436bc3b6-6f3f-3b65-9c55-335ebf81d0a3",
                                                "text": "Wetten, Lara-Heidemarie traut sich nicht den Liebesbrief zu knüllen!"
                                            },
                                            {
                                                "example_id": "95af135e-81e9-4bd2-9d5f-bca14237819e",
                                                "sense_id": "436bc3b6-6f3f-3b65-9c55-335ebf81d0a3",
                                                "text": "Knüll bitte den Stoff nicht so sehr!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0486900d-2526-3126-a5f6-e29865382f56",
                                        "entry_id": "70238837-15d6-3a61-b881-3c4ff632f364",
                                        "glosses": [
                                            "sich knautschen, sich knittern"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01095198-796b-4536-a606-5477adc94e71",
                                                "sense_id": "0486900d-2526-3126-a5f6-e29865382f56",
                                                "text": "Fotopapier knüllt sich schlecht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c29dfac-0d1e-4670-9334-cc8a35f83843",
                        "source_entry_id": "9fd44e64-e4ab-38a3-a72f-1125436afccf",
                        "source_sense_description": "crumple",
                        "target_lang_word": "zerknüllen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zerknüllen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d590320-39ac-3433-a8b7-3b45d2037ee1",
                                        "entry_id": "d3713415-c863-318d-a922-bca0089c38d4",
                                        "glosses": [
                                            "etwas in der Hand oder durch falsche Lagerung zerdrücken, zerknittern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63e8fba0-1e17-4f0d-b748-820aa9c3d858",
                                                "sense_id": "1d590320-39ac-3433-a8b7-3b45d2037ee1",
                                                "text": "Sie hat es [das Foto] schon ein paar mal zerknüllt, aber nie weggeworfen."
                                            },
                                            {
                                                "example_id": "8a1faf8b-f6a7-4461-ad5c-ec3612110438",
                                                "sense_id": "1d590320-39ac-3433-a8b7-3b45d2037ee1",
                                                "text": "Als sie ihrem neuen Chef vorgestellt wurde, überlegte sie es sich aber plötzlich doch noch anders, zerknüllte den Vertrag wieder, schmiß ihn dem verdutzten Abteilungsleiter vor die Füße und verließ ohne weitere Erklärung das Haus."
                                            },
                                            {
                                                "example_id": "6916773a-8f34-4c06-bce9-6840f3d9abfe",
                                                "sense_id": "1d590320-39ac-3433-a8b7-3b45d2037ee1",
                                                "text": "Dabei kann ein Stimmzettel auch zerknüllt oder andersweitig beschädigt sein – so lange das Kreuzchen lesbar bleibt."
                                            },
                                            {
                                                "example_id": "00d4c4ca-9026-4b52-8236-38610b6a9423",
                                                "sense_id": "1d590320-39ac-3433-a8b7-3b45d2037ee1",
                                                "text": "Das Telefonnetz läuft - wie auch Wasser und Strom - über die westfälische Seite; die Beamten aus NRW waren prompt zur Stelle, nahmen eifrig den Polizeibericht auf - und zerknüllten ihn umgehend, als sie einen Blick auf den Ausweis der Eltern warfen."
                                            },
                                            {
                                                "example_id": "a2a3d1b6-19c9-4ec7-84a4-950beb97ce27",
                                                "sense_id": "1d590320-39ac-3433-a8b7-3b45d2037ee1",
                                                "text": "Im August noch Sieger beim Ochsenrennen in Münsing, wirkte er diesmal im Vorlauf nicht ganz bei der Sache, fasste nach etwa 50 Metern den Entschluss, das Rennen frühzeitig zu beenden, und schied aus, während einige hundert Besucher ihren Wettschein zerknüllten."
                                            },
                                            {
                                                "example_id": "b81eac83-819d-4d68-a5c6-b046f83c005a",
                                                "sense_id": "1d590320-39ac-3433-a8b7-3b45d2037ee1",
                                                "text": "In der Hand zerknüllte er noch den Brief, den er soeben erhalten und nur flüchtig gelesen hatte, als die Schwester ihn mit besorgter Miene in das Krankenzimmer gerufen hatte: »Heinz, komm doch, Mutter sieht plötzlich so verändert aus!«"
                                            },
                                            {
                                                "example_id": "dfc7d891-38c6-44ea-bbea-0a4a8a8ae318",
                                                "sense_id": "1d590320-39ac-3433-a8b7-3b45d2037ee1",
                                                "text": "Graphenschichten können gekrümmt und so zerknüllt gepackt werden, dass zwischen den Schichten Mesoporen gebildet werden und sie nicht, ähnlich wie Graphit, flächig übereinanderliegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76962700-77f7-4893-a279-dd7ec45c9c27",
                        "source_entry_id": "9fd44e64-e4ab-38a3-a72f-1125436afccf",
                        "source_sense_description": "crumple",
                        "target_lang_word": "zusammenknüllen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
