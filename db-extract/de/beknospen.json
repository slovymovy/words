                "senses": [
                    {
                        "sense_id": "08503c44-fe94-3f9f-86ba-584c4baad38e",
                        "entry_id": "7816d1a8-21af-3441-90fb-88c4df8daf1a",
                        "glosses": [
                            "Knoten, aus denen sich später Blätter oder Blüten entwickeln (Knospen), treiben/ansetzen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "30778b47-9323-4266-b572-543b9fba410b",
                                "sense_id": "08503c44-fe94-3f9f-86ba-584c4baad38e",
                                "text": "„beknospt, gemmatus; mit Knospen besetzt, mehrere Arten Salix, entwickeln ihre Knospen des nächsten Jahres im Herbste schon sehr weit, und heissen dann vorzugsweise: beknospt.“ (1823)"
                            },
                            {
                                "example_id": "2539f99b-b7ee-49ba-ad80-7a8cdcc3cc07",
                                "sense_id": "08503c44-fe94-3f9f-86ba-584c4baad38e",
                                "text": "Die Birken beknospen sich."
                            }
                        ],
                        "sense_index_json": "\"1\""
