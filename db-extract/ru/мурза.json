                "senses": [
                    {
                        "sense_id": "aa33a916-0760-3b5a-9d36-ce7d13027291",
                        "entry_id": "d6fe77e2-e973-385d-b082-b1dc7ece600f",
                        "glosses": [
                            "истор. титул феодальной знати в татарских государствах в XV веке, а также лицо, носившее этот титул"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cf3c543-b05b-4678-9260-08c650bee6e9",
                                "sense_id": "aa33a916-0760-3b5a-9d36-ce7d13027291",
                                "text": "Пройдя два отделения, в которых толпились турецкие аги и татарские мурзы, они вошли в третье; в нём, на низком диване, или, верней сказать, широком тюфяке, сидел каймакан, то есть наместник великого визиря."
                            },
                            {
                                "example_id": "eb042db7-f757-4dc6-9827-9466fcdb32f7",
                                "sense_id": "aa33a916-0760-3b5a-9d36-ce7d13027291",
                                "text": "А Иван Мирославич был тот самый татарский мурза Салахмир, потомок ордынских владетелей, который в 1371 г. прибыл из Золотой Орды к Олегу Ивановичу с татарской дружиной и оказал ему помощь в борьбе с Дмитрием Московским и Владимиром Пронским."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c25b40f2-1d84-4787-98a5-8ac6b2d5a330",
                        "source_entry_id": "d6fe77e2-e973-385d-b082-b1dc7ece600f",
                        "source_sense_id": "aa33a916-0760-3b5a-9d36-ce7d13027291",
                        "target_lang_word": "mirza",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mirza",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5efb4913-20f2-3b70-9f29-acb44d3a026b",
                                        "entry_id": "cb794b20-c5f9-334f-8ac3-47ea8b2d8cfc",
                                        "glosses": [
                                            "An educated man in India or Iran (Persia); an official, a clerk."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "581be9cb-d069-4cf6-ad02-c43598a372e4",
                                                "sense_id": "5efb4913-20f2-3b70-9f29-acb44d3a026b",
                                                "text": "The same success attended the other mirzas and emirs in their excursions."
                                            },
                                            {
                                                "example_id": "f42363c2-594f-41fb-9167-9dc4a01dab70",
                                                "sense_id": "5efb4913-20f2-3b70-9f29-acb44d3a026b",
                                                "text": "This he presented to the Khan of Puhra, who called upon his mirza, or clerk, to read it aloud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
