                    },
                    {
                        "form_id": "21fca7ee-47e1-4545-8c37-3ef7b006c77f",
                        "entry_id": "d2d9846b-4fc2-3b88-b570-ad41a824de06",
                        "tags": [
                            "accusative",
                            "plural"
