                "senses": [
                    {
                        "sense_id": "31921697-b222-336a-b5b5-aa77b1db72dd",
                        "entry_id": "62bdebac-cc91-3176-b6e7-2dd2b3e40516",
                        "glosses": [
                            "Art, wie etwas äußerlich gestaltet, geformt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc79a8b-4294-411e-a6f8-311ecd9e4066",
                                "sense_id": "31921697-b222-336a-b5b5-aa77b1db72dd",
                                "text": "„Das frühe Mönchtum fand seinen Ursprung und seine Formung in der Spätantike.“"
                            },
                            {
                                "example_id": "989c0ba7-2987-4730-883a-19105d27fae5",
                                "sense_id": "31921697-b222-336a-b5b5-aa77b1db72dd",
                                "text": "„Bildtapeten im Interieur um 1800 sind an der Herausbildung und Formung einer spezifischen, an bürgerlichen Werten orientierten Wohnkultur maßgeblich beteiligt.“"
                            },
                            {
                                "example_id": "5c9b429d-a0ca-4024-a258-431cab6d485a",
                                "sense_id": "31921697-b222-336a-b5b5-aa77b1db72dd",
                                "text": "„Ständige Lebensmittelskandale haben die deutsche Verbraucherpolitik aus ihrem Tiefschlaf gerissen und zur Formung eines neuen Leitbildes geführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "46b35c00-3c27-3221-90e3-b48d95f96dfa",
                        "entry_id": "62bdebac-cc91-3176-b6e7-2dd2b3e40516",
