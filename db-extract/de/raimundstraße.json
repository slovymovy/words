                "senses": [
                    {
                        "sense_id": "caaaa80a-5d26-37f1-a11d-9baeeb2f2ce6",
                        "entry_id": "1df3568f-97a8-3ae9-b078-081ba9e941aa",
                        "glosses": [
                            "in der Regel nach dem Schriftsteller Ferdinand Raimund benannte Straße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4540bcb2-8fd5-41f5-b6ab-193d33b45e38",
                                "sense_id": "caaaa80a-5d26-37f1-a11d-9baeeb2f2ce6",
                                "text": "Das Wohnhaus Raimundstraße 11 wurde 2011 erbaut und besteht aus insgesamt 10 Wohnungen mit Lift."
                            },
                            {
                                "example_id": "7fb855e1-7e6d-4b27-aaf5-ba306f16ffa2",
                                "sense_id": "caaaa80a-5d26-37f1-a11d-9baeeb2f2ce6",
                                "text": "Das Auto war am Gehsteigrand vor einem Wohnhaus in der Raimundstraße in Ried/I. abgestellt, die Autotüren standen offen und der Zündschlüssel steckte."
                            },
                            {
                                "example_id": "3df4e477-b771-4db3-8e0c-a03fd9f8910a",
                                "sense_id": "caaaa80a-5d26-37f1-a11d-9baeeb2f2ce6",
                                "text": "Noch in diesem Jahr erfolgt daher ein Neubau an der Kreuzung Friedrich-Ebert-Anlage/Hohenstaufenstraße, modernisiert werden die Anlagen Hügelstraße/Raimundstraße, Adickesallee/Eckenheimer Landstraße und Darmstädter Landstraße/Geleitstraße."
                            },
                            {
                                "example_id": "cbc3a5f8-203c-4787-9a7f-191bcdfd040f",
                                "sense_id": "caaaa80a-5d26-37f1-a11d-9baeeb2f2ce6",
                                "text": "Bald würden die Bewohner der Schönbornstraße ihren Gram über die Buddelei vergessen haben und sich - gegen eine tüchtige Gebühr - an die Antenne der Kopfstation in der nahegelegenen Raimundstraße anschließen lassen."
                            },
                            {
                                "example_id": "0acf8d40-c65e-4ab7-a3ad-abb40a08adeb",
                                "sense_id": "caaaa80a-5d26-37f1-a11d-9baeeb2f2ce6",
                                "text": "In der Globusfabrik im Hinterhof der Raimundstraße 12/14 in Leipzig-Lindenau findet am 3. Oktober 2014 um 18:00 Uhr die Vernissage zur Ausstellung „Abreaktion“ statt."
                            }
                        ],
