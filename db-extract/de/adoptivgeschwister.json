                ],
                "senses": [
                    {
                        "sense_id": "868b6bda-ab92-3d36-85d7-c61bb6638848",
                        "entry_id": "b7c0cf64-58da-3d37-98ab-6a01be15eecf",
                        "glosses": [
                            "Person, die durch Adoption in einer Familie quasi Geschwister (mindestens) einer anderen Person wurde"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "31d2fba4-3cf5-4594-96aa-801c312988bb",
                                "sense_id": "868b6bda-ab92-3d36-85d7-c61bb6638848",
                                "text": "„Sie dürfen also auch ihre Adoptivgeschwister nicht heiraten. Eine solche Heirat ist aber möglich, wenn das Adoptionsverhältnis beendet wird.“"
                            },
                            {
                                "example_id": "045c7b6b-1078-46b0-95d8-d5c71e0d37a1",
                                "sense_id": "868b6bda-ab92-3d36-85d7-c61bb6638848",
                                "text": "„Während eineiige Zwillinge sich alle additiven und interaktiven Varianten teilen, teilen sich zweiige Zwillinge die additiven Varianten zu 50%. Die interaktiven Varianten teilen sie sich jedoch deutlich weniger als 50%. Adoptivgeschwister teilen sich wiederum weder additive noch interaktive Varianten.“"
                            },
                            {
                                "example_id": "a82cdcc6-09f5-451d-9152-032bae1febb9",
                                "sense_id": "868b6bda-ab92-3d36-85d7-c61bb6638848",
                                "text": "„Adoptivgeschwister können einander nur mit Genehmigung des Familiengerichts heiraten (§ 1308 BGB).“"
                            },
                            {
                                "example_id": "699dfa0d-dfe2-4e5d-af9e-affd1ffccd7a",
                                "sense_id": "868b6bda-ab92-3d36-85d7-c61bb6638848",
                                "text": "„Die Erben der dritten Ordnung bestehen aus den Geschwistern (auch Halb- und Adoptivgeschwister)“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cc70df0-2a29-4554-bb5c-b568d695c67d",
                        "source_entry_id": "b7c0cf64-58da-3d37-98ab-6a01be15eecf",
                        "source_sense_id": "868b6bda-ab92-3d36-85d7-c61bb6638848",
                        "source_sense_description": "Person, die durch Adoption Geschwister einer anderen Person wurde",
                        "target_lang_word": "sibling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sibling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a801116-1fb5-3d24-9c1c-34c34206575b",
                                        "entry_id": "a2bfb1f1-2ce7-3ea4-ba7b-16bafe8c0eb0",
                                        "glosses": [
                                            "A person who shares a parent; one's brother or sister who one shares a parent with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2843238-f403-4d5b-9379-dd8cadb1ea42",
                                                "sense_id": "6a801116-1fb5-3d24-9c1c-34c34206575b",
                                                "text": "None of my siblings are married yet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f438d2e9-0642-3371-a0fe-5d763bca623f",
                                        "entry_id": "a2bfb1f1-2ce7-3ea4-ba7b-16bafe8c0eb0",
                                        "glosses": [
                                            "A node in a data structure that shares its parent with another node."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a744c67-180d-371e-8e39-9b7e970d6864",
                                        "entry_id": "a2bfb1f1-2ce7-3ea4-ba7b-16bafe8c0eb0",
                                        "glosses": [
                                            "The most closely related species, or one of several most closely related species when none can be determined to be more closely related."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6618a304-2244-4da4-92ec-51cb5ee2992d",
                                                "sense_id": "4a744c67-180d-371e-8e39-9b7e970d6864",
                                                "text": "D. simulans, D. mauritiana and D. sechellia (which we will call “the siblings” when we do not need to distinguish among them) have homosequential polytene chromosome banding patterns differing from those of D. melanogaster by one long inversion on chromosome arm 3R and a few much smaller inversions."
                                            },
                                            {
                                                "example_id": "c7b9ede7-7d60-4080-b911-1703a1ac7849",
                                                "sense_id": "4a744c67-180d-371e-8e39-9b7e970d6864",
                                                "text": "Bush suggested that this difference might represent a case of chromosomal polymorphism or, more likely, sibling species."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
