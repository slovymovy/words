                        "cross_references": [
                            {
                                "target_word": "lipodystrophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3b466f6-2449-3f05-b36f-f200d634c071",
                                        "entry_id": "05d08e47-c96a-35e3-baf4-a2820affd202",
                                        "glosses": [
                                            "A disorder characterized by abnormal or degenerative conditions of the body's adipose tissue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4272c153-ffd2-4601-b91b-f6a329601e73",
                                                "sense_id": "b3b466f6-2449-3f05-b36f-f200d634c071",
                                                "text": "2007, Vinaya Simha, Anil K. Agarwal, 18: Inherited and Acquired Lipodystrophies: Disorders of Adipose Tissue Development, Differentiation, and Death, Giamila Fantuzzi, Theodore Mazzone (editors), Adipose Tissue and Adipokines in Health and Disease, Springer (Humana Press), page 237,\nAmong genetic lipodystrophies, the fat loss is observed either since birth as in congenital generalized lipodystrophy, or it occurs later in life as in familial partial lipodystrophy."
                                            },
                                            {
                                                "example_id": "4de0c9eb-3844-4b49-b6a0-512a08b8edf7",
                                                "sense_id": "b3b466f6-2449-3f05-b36f-f200d634c071",
                                                "text": "HIV-associated lipodystrophy is a syndrome of fat redistribution associated with antiretroviral therapy. Although many of the complications occur most commonly with protease inhibitors, lipodystrophy is associated with all antiretroviral classes."
                                            },
                                            {
                                                "example_id": "07779dc9-1948-4c5b-86f1-6d28d0c5c83c",
                                                "sense_id": "b3b466f6-2449-3f05-b36f-f200d634c071",
                                                "text": "2012, Ashton Acton (editor), Lipodystrophy: New Insights for the Healthcare Professional, ScholarlyEditions, 2012 Edition, page 2,\nThe autosomal recessive congenital generalized lipodystrophy and autosomal dominant familial partial lipodystrophy (FPL) are the two most common types of genetic lipodystrophies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "227ab15f-d012-4a03-8979-e8e3e05430f4",
                        "source_entry_id": "a6ca24c2-f64e-3df6-b6dc-0d17352671cd",
                        "source_sense_id": "4590cd76-f1ed-37c8-a064-4b4ba02242d8",
