        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43201636-79f6-33fa-8969-3b14cefff3be",
                    "sense_definition": "present participle and gerund of <w>wane</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her interest in the project was <w>waning</w> after months of delays.",
                            "target_lang_translations": {
                                "ru": "Её интерес к проекту <w>угасал</w> после месяцев задержек."
                            }
                        },
                        {
                            "text": "The daylight was gradually <w>waning</w> as they walked through the forest.",
                            "target_lang_translations": {
                                "ru": "Дневной свет постепенно <w>мерк</w>, пока они шли по лесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "decreasing",
                        "declining",
                        "diminishing",
                        "fading"
                    ],
                    "antonyms": [
                        "waxing",
                        "increasing",
                        "growing"
                    ],
                    "traits": [
