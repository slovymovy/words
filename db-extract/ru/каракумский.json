                "senses": [
                    {
                        "sense_id": "306038e5-de1a-30e7-933c-b358a9728a42",
                        "entry_id": "c69ac95d-5d1b-38c0-b4e7-993560b6e52f",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными Каракум, Каракумы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f67b9d9-8481-4a50-9d86-3ebeea45b16d",
                                "sense_id": "306038e5-de1a-30e7-933c-b358a9728a42",
                                "text": "Дыни бухарские привез и шкуры каракумских варанов, сначала высушенные, а потом замоченные в соке гюрзы."
                            },
                            {
                                "example_id": "abaddd27-a6d4-431e-87ef-72e2b3514de2",
                                "sense_id": "306038e5-de1a-30e7-933c-b358a9728a42",
                                "text": "В каракумской истории есть один классический пример пренебрежения законами пустынной географии."
                            }
                        ]
                    }
