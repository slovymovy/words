{
    "word_family": [
        "hurtling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ed43737-bb30-34ca-a506-942b146aa440",
                    "sense_definition": "To move rapidly, violently, or without control, especially in a noisy manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car <w>hurtled</w> down the hill at 90 miles per hour.",
                            "target_lang_translations": {
                                "it": "L'auto <w>sfrecciava</w> giù per la collina a 90 miglia orarie."
                            }
                        },
                        {
                            "text": "Pieces of broken glass <w>hurtled</w> through the air after the explosion.",
                            "target_lang_translations": {
                                "it": "Pezzi di vetro rotto <w>sfrecciavano</w> nell'aria dopo l'esplosione."
                            }
                        }
                    ],
                    "synonyms": [
                        "dash"
                    ],
                    "common_phrases": [
                        "hurtle down",
                        "hurtle through"
                    ],
                    "target_lang_definitions": {
                        "it": "Muoversi rapidamente, violentemente o senza controllo, specialmente in modo rumoroso."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sfrecciare",
                                "target_lang_sense_clarification": "muoversi a grande velocità"
                            },
                            {
                                "target_lang_word": "precipitarsi",
                                "target_lang_sense_clarification": "muoversi con impeto e rapidità"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6d766cd-c5c8-3cfa-bef2-790b96a9ac0a",
                    "sense_definition": "To propel or throw something hard or violently.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "throwing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>hurtled</w> the heavy stone into the deep water.",
                            "target_lang_translations": {
                                "it": "Ha <w>scagliato</w> la pesante pietra nell'acqua profonda."
                            }
                        },
                        {
                            "text": "The angry protester <w>hurtled</w> a bottle at the police line.",
                            "target_lang_translations": {
                                "it": "Il manifestante arrabbiato ha <w>scagliato</w> una bottiglia contro lo schieramento di polizia."
                            }
                        }
                    ],
                    "synonyms": [
                        "hurl",
                        "fling",
                        "throw"
                    ],
                    "target_lang_definitions": {
                        "it": "Propellere o lanciare qualcosa con forza o violenza."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scagliare",
                                "target_lang_sense_clarification": "lanciare con forza"
                            },
                            {
                                "target_lang_word": "lanciare",
                                "target_lang_sense_clarification": "gettare con violenza"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c65d2cc9-0b11-32ab-99b1-db8c6d61451c",
                    "sense_definition": "A rapid or uncontrolled movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train ride was a terrifying <w>hurtle</w> through the dark tunnel.",
                            "target_lang_translations": {
                                "it": "Il viaggio in treno è stato una terrificante <w>corsa sfrenata</w> attraverso il tunnel buio."
                            }
                        },
                        {
                            "text": "Recent events have turned his life into a constant <w>hurtle</w> toward an uncertain future.",
                            "target_lang_translations": {
                                "it": "Gli eventi recenti hanno trasformato la sua vita in una costante <w>corsa sfrenata</w> verso un futuro incerto."
                            }
                        }
                    ],
                    "synonyms": [
                        "dash",
                        "rush"
                    ],
                    "target_lang_definitions": {
                        "it": "Un movimento rapido o incontrollato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "corsa sfrenata",
                                "target_lang_sense_clarification": "movimento rapido e incontrollato"
                            },
                            {
                                "target_lang_word": "precipitazione",
                                "target_lang_sense_clarification": "movimento impetuoso"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}