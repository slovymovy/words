                    {
                        "translation_id": "af86b8b5-dc7a-4342-b04f-fc0fc0255a02",
                        "source_entry_id": "fc93c416-74d2-3301-8c66-c34eea246079",
                        "source_sense_id": "b5f9fe40-dc5d-303e-a441-eeac69b63171",
                        "target_lang_word": "Germanistik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Germanistik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "329da368-85a9-3796-b061-37ba431d6e81",
                                        "entry_id": "6c84e88a-2383-342a-a1c6-b0779a673404",
                                        "glosses": [
                                            "die Wissenschaft von der deutschen Sprache und Literatur"
                                        ],
                                        "tags": [
                                            "im engen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478ab66c-be7e-4dc5-912e-f86633e95bd6",
                                                "sense_id": "329da368-85a9-3796-b061-37ba431d6e81",
                                                "text": "Die Germanistik untersucht u.a. die Geschichte der deutschen Sprache."
                                            },
                                            {
                                                "example_id": "1fc6ff18-57e2-47a0-b29f-445a99e8c18d",
                                                "sense_id": "329da368-85a9-3796-b061-37ba431d6e81",
                                                "text": "Die Germanistik umfasst die Fächer Mediävistik, Neuere deutsche Literatur, Sprachwissenschaft (Linguistik), Niederdeutsche Sprache und Literatur"
                                            },
                                            {
                                                "example_id": "ecc6eb54-e5ce-447a-971d-e8d850d5dfc1",
                                                "sense_id": "329da368-85a9-3796-b061-37ba431d6e81",
                                                "text": "„So habe das universitäre Fach Germanistik im Jahre 1949 nur noch in Budapest existiert, während die entsprechenden Lehrstühle in Szeged, Debrecen und Pécs aufgelöst worden seien.“"
                                            },
                                            {
                                                "example_id": "e47d21b5-7563-4962-b478-3b0fccb0c811",
                                                "sense_id": "329da368-85a9-3796-b061-37ba431d6e81",
                                                "text": "„Lange, bevor es in Deutschland eine Germanistik gab, gab es schon die Äthiopistik.“"
                                            },
                                            {
                                                "example_id": "4be31080-885a-4c5f-938b-46349b9db845",
                                                "sense_id": "329da368-85a9-3796-b061-37ba431d6e81",
                                                "text": "„Dieser Mann hatte Germanistik studiert, aber kein Abschlussexamen für den Staatsdienst gemacht.“"
                                            },
                                            {
                                                "example_id": "f961463e-2413-46fa-aff1-e1233d33dada",
                                                "sense_id": "329da368-85a9-3796-b061-37ba431d6e81",
                                                "text": "„Marga würde die Stelle bei Griebel in der Germanistik erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "75633ed9-fce7-3268-ae58-cfa0b73ece3c",
                                        "entry_id": "6c84e88a-2383-342a-a1c6-b0779a673404",
                                        "glosses": [
                                            "die Wissenschaft von den germanischen Sprachen, ihrer Kultur (Brauchtum, Recht, Religion) und Literatur"
                                        ],
                                        "tags": [
                                            "im weiten Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "810e7035-b463-4d8d-bb3f-36cf6aa4df70",
                                                "sense_id": "75633ed9-fce7-3268-ae58-cfa0b73ece3c",
                                                "text": "Die Germanistik im weiten Sinne umfasst außer der Germanistik im engen Sinne die Fächer Afrikaans, Anglistik, Friesistik, Gotisch, Jiddistik, Niederlandistik, Runenkunde, Skandinavistik."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
