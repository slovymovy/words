                "translations": [
                    {
                        "translation_id": "fe7ca712-0f80-4a9e-b3ae-607ef8a36dc2",
                        "source_entry_id": "87ffaf13-99be-3037-9f80-9ebd406d7495",
                        "source_sense_id": "a738af86-6fff-37ef-ae49-52bde3519a0c",
                        "source_sense_description": "overslaande golf, golvende hoeveelheid water.",
                        "target_lang_word": "Schwall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cda76f65-6cf2-3254-a3a0-25f0232a2fc2",
                                        "entry_id": "e37637f4-1d5a-3353-95d4-a227cd70dda0",
                                        "glosses": [
                                            "eine große Menge, die über jemanden oder etwas hereinbricht (insbesondere Wasser oder andere Flüssigkeiten, aber auch Worte, Düfte und anderes)"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "710bdf8e-edd4-403d-812e-71c7fa4bd0fc",
                                                "sense_id": "cda76f65-6cf2-3254-a3a0-25f0232a2fc2",
                                                "text": "Aus dem gebrochenen Rohr kam ein Schwall Wasser."
                                            },
                                            {
                                                "example_id": "d932a2af-b631-4d54-a972-04e26caaeb7e",
                                                "sense_id": "cda76f65-6cf2-3254-a3a0-25f0232a2fc2",
                                                "text": "„Walle! walle / Manche Strecke, / Daß, zum Zwecke, / Wasser fließe, / Und mit reichem vollem Schwalle / Zu dem Bade sich ergieße.“"
                                            },
                                            {
                                                "example_id": "0bb33590-d426-41f9-9848-39779a396aa6",
                                                "sense_id": "cda76f65-6cf2-3254-a3a0-25f0232a2fc2",
                                                "text": "„Sie hatten die Kühnheit, bis ins Tor hineinzureiten. Ein verworrener Schwall von Musik und Lichtern quoll ihnen da entgegen.“"
                                            },
                                            {
                                                "example_id": "a05aad44-1f0c-4a39-882c-60d57bf17482",
                                                "sense_id": "cda76f65-6cf2-3254-a3a0-25f0232a2fc2",
                                                "text": "Bruckstücke des Vorgängerbaus liegen flussabwärts der Brücke, wo wilderes Wasser, Schwälle und an einer Stelle etwas rechts der Flussmitte sogar ein Kehrwasser auftritt."
                                            },
                                            {
                                                "example_id": "894331b9-db64-4b00-adda-565f03486cd9",
                                                "sense_id": "cda76f65-6cf2-3254-a3a0-25f0232a2fc2",
                                                "text": "Sie hat eine gute Fließgeschwindigkeit und weist einige kleine Schwälle auf."
                                            },
                                            {
                                                "example_id": "52eae9fc-1d15-41ec-aa01-791c656514ed",
                                                "sense_id": "cda76f65-6cf2-3254-a3a0-25f0232a2fc2",
                                                "text": "„Der Mann kam, sah den Rauch oben heraus in dicken Schwällen und seitwärts aus allen Fugen und Ritzen des Schlotts dringen und sagte: ›Das ist nicht der Rauch der Esse; und horch, wie es im Schachte knistert! es tobet und toset als wie in einer Hölle.‹“"
                                            },
                                            {
                                                "example_id": "9bb9c823-ae91-446a-9e0e-5ccec43dd9e5",
                                                "sense_id": "cda76f65-6cf2-3254-a3a0-25f0232a2fc2",
                                                "text": "Leichte Schwälle, Baumverhaue und Geschiebe verleihen ihr über die gesamte Strecke den Charakter leichten Wildwassers (WW I)."
                                            },
                                            {
                                                "example_id": "5be41802-1eb2-442e-bdf4-732227ae5e22",
                                                "sense_id": "cda76f65-6cf2-3254-a3a0-25f0232a2fc2",
                                                "text": "Unten sind dann doch einige nette Schwälle, Steingärten und Schwälle, die zum Spielen einladen (Paddeln am Lech 2020)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
