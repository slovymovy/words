                        "examples": [
                            {
                                "example_id": "f3f89e38-460b-4b3b-b295-fc8a3ed51edc",
                                "sense_id": "27f50cb1-bc0f-3391-8bd1-33be20a07d3e",
                                "text": "Nick Gordon (25) groeide op bij de in overleden zangeres Whitney Houston. Zijn biologische moeder maakt zich momenteel veel zorgen om haar zoon. Ze zegt dat hij veel drinkt, emotioneel onstabiel is en de drugs Xanax gebruikt sinds het badkuipdrama met zijn partner en pleegzus Bobbi Kristina, de dochter van Whitney. De politie onderzoekt of hij er iets mee te maken heeft."
                            },
                            {
                                "example_id": "378b20e6-1e5e-4217-8869-efcd93f98556",
                                "sense_id": "27f50cb1-bc0f-3391-8bd1-33be20a07d3e",
                                "text": "De vrouw wilde alsnog geadopteerd worden om de hechte band te bevestigen die bestaat tussen haar en haar pleegouders. Bovendien is haar pleegzus wel geadopteerd. De vrouw vond het juridische verschil dat tussen haar en haar zus zou blijven bestaan, onacceptabel.Omdat haar natuurlijke moeder dwars lag, dienden de vrouw en haar pleegouders niet eerder een verzoek in om adoptie."
                            }
                        ]
