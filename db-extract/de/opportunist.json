                ],
                "senses": [
                    {
                        "sense_id": "3c636c2f-5ddf-38bb-8b9c-759e91fa8dcd",
                        "entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
                        "glosses": [
                            "jemand, der dem Opportunismus folgt, sich also der jeweiligen Lage anpasst, auch in ideologischer Hinsicht (dort negativ gewertet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f6d6b43-27ca-421f-8d13-a923b88d2a19",
                                "sense_id": "3c636c2f-5ddf-38bb-8b9c-759e91fa8dcd",
                                "text": "Es ist schwierig, mit Opportunisten zusammenzuarbeiten. Man weiß nie, woran man mit ihnen ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8468b273-c0f5-3f3c-884d-ceccf27d4a59",
                        "entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
                        "glosses": [
                            "ein Erreger, der nur aufgrund besonderer Umstände zu einer Krankheit führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f55f9a9c-71fd-496a-a4f7-01448c2ff28e",
                                "sense_id": "8468b273-c0f5-3f3c-884d-ceccf27d4a59",
                                "text": "Legionella pneumophila zählt zu den Opportunisten, den fakultativ pathogenen Erregern."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f83f5724-bb94-3ac5-8330-ac72d797965b",
                        "entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
                        "glosses": [
                            "Anlegertyp, der Trends für seine Kapitalanlageentscheidungen nutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d39c7a2-ae6c-48f8-a344-b7a45e2e5e6e",
                                "sense_id": "f83f5724-bb94-3ac5-8330-ac72d797965b",
                                "text": "Jetzt, wo die Märkte sehr sprunghaft sind, ist das Klima günstig für Opportunisten, die sich an technischen Indikatoren orientieren."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "fbf73d7e-17ef-3235-8cd9-eddfe214f13b",
                        "entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
                        "glosses": [
                            "Anhänger einer Strömung in der Arbeiterbewegung, dessen Haltung aus ideologischer Sicht bürgerliche/kapitalistische Einflüsse widerspiegelt, Anhänger des Opportunismus"
                        ],
                        "tags": [
                            "Marxismus"
                        ],
                        "examples": [
                            {
                                "example_id": "9a252e91-6b91-4e01-b19c-21f81257d6e1",
                                "sense_id": "fbf73d7e-17ef-3235-8cd9-eddfe214f13b",
                                "text": "„In der Diskussion über das Agrarprogramm forderten die Opportunisten Eduard David und Max Quarck die Unterstützung der Kleinbetriebe durch den kapitalistischen Staat in Form von Reformen, die sie als sozialistisch ausgaben.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f97bf31-46ae-4f62-8561-f7398de69491",
                        "source_entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
                        "source_sense_id": "3c636c2f-5ddf-38bb-8b9c-759e91fa8dcd",
                        "source_sense_description": "jemand, der sich der jeweiligen Lage anpasst",
                        "target_lang_word": "opportunist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opportunist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96e1dd5e-af4a-31e9-aa7c-57d2656c97a2",
                                        "entry_id": "51e78fa8-54cf-34f2-a4a1-343aa7cf3314",
                                        "glosses": [
                                            "Someone who takes advantage of any opportunity to advance their own situation, placing expediency above principle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3baa210-2d32-4973-90c3-c34b47b39aca",
                                                "sense_id": "96e1dd5e-af4a-31e9-aa7c-57d2656c97a2",
                                                "text": "James Milner's angled free-kick was headed on to the post by the tireless Bent and Lampard the opportunist was perfectly placed to stoop and head in from virtually on the goal-line."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88017444-7bc4-4bfb-9026-f377cb083051",
                        "source_entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
                        "source_sense_id": "3c636c2f-5ddf-38bb-8b9c-759e91fa8dcd",
                        "source_sense_description": "jemand, der sich der jeweiligen Lage anpasst",
                        "target_lang_word": "temporizer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "temporizer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f4369f7-170f-3fc2-903a-b6d714362346",
                                        "entry_id": "3fbdf728-d60f-3f1f-a843-901c8aa25dcb",
                                        "glosses": [
                                            "A person who temporizes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8083ad4-cd3f-4a0e-8013-7765ae95813f",
                                                "sense_id": "5f4369f7-170f-3fc2-903a-b6d714362346",
                                                "text": "I pronounce thee a hovering temporizer, that Canst with thine eyes at once see good and evil, Inclining to them both."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2561e40e-79f6-4ee2-a265-16db89cb393c",
                        "source_entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
                        "source_sense_id": "3c636c2f-5ddf-38bb-8b9c-759e91fa8dcd",
                        "source_sense_description": "jemand, der sich der jeweiligen Lage anpasst",
                        "target_lang_word": "timeserver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timeserver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13bba992-2ebd-391f-81d8-c35889308250",
                                        "entry_id": "a11d6dc4-832b-33fa-94c0-460f32a459db",
                                        "glosses": [
                                            "A person who conforms to current opinions, especially for reasons of personal advantage; an opportunist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ba0075-0a8c-40a6-b642-74e7fc237b7f",
                                                "sense_id": "13bba992-2ebd-391f-81d8-c35889308250",
                                                "text": "Another of Lilly's confidants was the time-server, John Gauden, who was distinctly anti-Laudian in outlook, but who nevertheless became Bishop of Worcester at the Restoration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bc40f5-ca9d-3967-ab1c-372dbfa2cab7",
                                        "entry_id": "a11d6dc4-832b-33fa-94c0-460f32a459db",
                                        "glosses": [
                                            "Someone who performs a job for the required time only, making a minimum of effort."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "313d408d-000c-3076-9fe7-02a8038501f5",
                                        "entry_id": "a11d6dc4-832b-33fa-94c0-460f32a459db",
                                        "glosses": [
                                            "A device, node or program that transmits the correct time to clients in a network."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f0907e1-d010-3458-b95f-0e3902c3a0b7",
                                        "entry_id": "a11d6dc4-832b-33fa-94c0-460f32a459db",
                                        "glosses": [
                                            "Someone who honors their commitments only when it is personally easy to do so."
                                        ],
