                        "source_sense_id": "4b68349c-76ea-37e0-ba1d-84fa18a60562",
                        "source_sense_description": "riem die het vooruitglijden van het zadel voorkomt; riem waar de staart van het paard doorgaat",
                        "target_lang_word": "crupper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crupper",
