                    "frequency": "High",
                    "semantic_group_id": "state_of_fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне <w>страшно</w> оставаться дома одному в темноте.",
                            "target_lang_translations": {
                                "en": "I am <w>scared</w> to stay home alone in the dark.",
                                "nl": "Ik vind het <w>eng</w> om alleen thuis te blijven in het donker.",
                                "pl": "<w>Strasznie</w> mi zostać samemu w domu w ciemności.",
                                "de": "Ich <w>habe Angst</w>, alleine im Dunkeln zu Hause zu bleiben.",
                                "fr": "J'<w>ai peur</w> de rester seul à la maison dans le noir.",
                                "it": "Ho <w>paura</w> di restare a casa da solo al buio.",
                                "cs": "Je mi <w>strašně</w> zůstat doma sám ve tmě.",
                                "tr": "Karanlıkta evde yalnız kalmaktan <w>korkuyorum</w>.",
                                "es": "Me <w>da miedo</w> quedarme solo en casa en la oscuridad.",
                                "zh": "我一个人在黑暗中待在家里感到很<w>害怕</w>。"
                            }
                        },
                        {
                            "text": "В лесу ночью было тихо и очень <w>страшно</w>.",
                            "target_lang_translations": {
                                "en": "In the forest at night it was quiet and very <w>scary</w>.",
                                "nl": "In het bos was het 's nachts stil en erg <w>eng</w>.",
                                "pl": "W lesie w nocy było cicho i <w>strasznie</w>.",
                                "de": "Im Wald war es nachts still und sehr <w>gruselig</w>.",
                                "fr": "Dans la forêt, la nuit, c'était calme et très <w>effrayant</w>.",
                                "it": "Nel bosco di notte c'era silenzio ed era molto <w>spaventoso</w>.",
                                "cs": "V lese bylo v noci ticho a velmi <w>strašidelně</w>.",
                                "tr": "Gece ormanda sessizlik vardı ve ortam çok <w>korkutucuydu</w>.",
                                "es": "En el bosque por la noche estaba tranquilo y <w>daba mucho miedo</w>.",
                                "zh": "夜晚的森林里静悄悄的，非常<w>可怕</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "боязно",
                        "жутко"
