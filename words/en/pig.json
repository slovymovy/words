                                "zh": "定期维护包括使用<w>清管器</w>来检查管壁。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical/industry specific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство для очистки или диагностики внутренней полости трубопровода.",
                        "zh": "用于清洁或检查石油或天然气管道内部的装置。"
                    },
                    "translations": {
