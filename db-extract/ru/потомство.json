                "senses": [
                    {
                        "sense_id": "19b9e0be-04db-39d7-8c8e-aa561700e7f2",
                        "entry_id": "1b5f6cb3-0e2b-3a74-a317-3a9858bfb582",
                        "glosses": [
                            "собир. потомки, люди последующих поколений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d9cd6cf-753c-4099-a983-0a702d60b1c1",
                                "sense_id": "19b9e0be-04db-39d7-8c8e-aa561700e7f2",
                                "text": "Как бы узнать их имена и выгравировать ― в назиданье потомству ― на особой доске позора!"
                            }
                        ]
                    },
                    {
                        "sense_id": "7bcbf760-7dc9-313d-98b3-7ed7c8af4eb8",
                        "entry_id": "1b5f6cb3-0e2b-3a74-a317-3a9858bfb582",
                        "glosses": [
                            "дети, молодое поколение по отношению к старшему, к родителям"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3091d2cb-752b-36e3-abc9-a6cd04d2f470",
                        "entry_id": "1b5f6cb3-0e2b-3a74-a317-3a9858bfb582",
                        "glosses": [
                            "биол. особь (потомок) или группа особей, появившихся в результате воспроизводства (размножения) других особей"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
