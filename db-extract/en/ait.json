                "senses": [
                    {
                        "sense_id": "7586e6dc-1dc1-342f-8a62-d1f90a878015",
                        "entry_id": "aa7e7cb0-807f-3f87-a6ec-f5ae20c5c212",
                        "glosses": [
                            "An island in a river, especially the River Thames in England."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6b99d0-4bc8-4f8c-b9db-06994f26f0e5",
                                "sense_id": "7586e6dc-1dc1-342f-8a62-d1f90a878015",
                                "text": "The ait where the osiers grew."
                            },
                            {
                                "example_id": "91874138-adcf-4e68-b023-b0d6787ecf43",
                                "sense_id": "7586e6dc-1dc1-342f-8a62-d1f90a878015",
                                "text": "‘[H]e the said seigneur, in quality of Lord Paramount, is to all intents and purposes invested with the sole right and property of the river running through his fief, together with […] all the islands and aits within it.’"
                            },
                            {
                                "example_id": "c7d34f1f-7dc4-4b17-9cb8-450847fb0172",
                                "sense_id": "7586e6dc-1dc1-342f-8a62-d1f90a878015",
                                "text": "1833, Johann Wolfgang von Goethe, Autobiography: Truth and Fiction Relating to My Life trans. John Oxenford, book 9,\nStriking richness of vegetation which follows in the windings of the Rhine, marks its banks, islands, and aits."
                            },
                            {
                                "example_id": "87feb760-eaf5-435b-b683-e815c448a1c8",
                                "sense_id": "7586e6dc-1dc1-342f-8a62-d1f90a878015",
                                "text": "Fog everywhere. Fog up the river, where it flows among green aits and meadows."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
