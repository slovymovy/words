                    {
                        "sense_id": "0fa6d09b-68ac-316f-8fcd-d1eebeb5eabe",
                        "entry_id": "34ca9988-8464-3714-b7d0-241003db742f",
                        "glosses": [
                            "Courbe de la bombe descendant, à partir du plus haut point de son ascension."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0b3343c3-1eef-3bf7-a62b-a2b16a7b5797",
                        "entry_id": "34ca9988-8464-3714-b7d0-241003db742f",
                        "glosses": [
                            "Distance entre le point équinoxial et le point de l'équateur qui descend sous l'horizon en même temps qu'un astre. La descension est dite droite ou oblique suivant qu'on la rapporte à la sphère droite ou à la sphère oblique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2c123496-a621-37f7-9e8b-2a849fe40bda",
                        "entry_id": "34ca9988-8464-3714-b7d0-241003db742f",
                        "glosses": [
                            "Action de descendre."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d05ee56c-6e77-405f-a67d-bbb184456adf",
                                "sense_id": "2c123496-a621-37f7-9e8b-2a849fe40bda",
                                "text": "Quel serait son effet [d'une lame] sur la surface de ces talus dans son mouvement d'ascension et de descension, si je puis me servir de ce terme ?"
                            },
                            {
                                "example_id": "7bf561d6-80e2-4b65-baa4-712dc38efcb2",
                                "sense_id": "2c123496-a621-37f7-9e8b-2a849fe40bda",
                                "text": "Il va falloir redescendre. Je trouve ça plus dur que de monter. Il paraît que le record de descension est de cinquante-cinq minutes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84a2397c-3cef-4525-b8e6-fe155ce83127",
                        "source_entry_id": "34ca9988-8464-3714-b7d0-241003db742f",
                        "target_lang_word": "descension",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "descension",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89abd065-c04c-3202-9e50-edb95d5f8f03",
                                        "entry_id": "9cbb7128-32e4-3f14-8d2b-be0dcbb44f80",
                                        "glosses": [
                                            "Descent; the act of descending."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd2cf877-48e7-46dc-8839-7a030f04ca6d",
                                                "sense_id": "89abd065-c04c-3202-9e50-edb95d5f8f03",
                                                "text": "Death is followed by either ascension into a higher plane or descension into a lower plane."
                                            },
                                            {
                                                "example_id": "a8ad7b3f-af97-4925-9d02-774ae757300c",
                                                "sense_id": "89abd065-c04c-3202-9e50-edb95d5f8f03",
                                                "text": "From a God to a Bull? a heavy descension. It was Jove's case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e81376ca-d4e5-3ebd-af84-dfb299d43cc9",
                                        "entry_id": "9cbb7128-32e4-3f14-8d2b-be0dcbb44f80",
                                        "glosses": [
                                            "The descent below the horizon of a celestial body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8a0f287-745b-4d4a-975b-b633e62cefdc",
                                                "sense_id": "e81376ca-d4e5-3ebd-af84-dfb299d43cc9",
                                                "text": "For in regard of time (as we elsewhere declare) the stars do vary their longitudes, and consequently the times of their ascension and descension."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
