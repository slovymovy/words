        "fr-extract.jsonl": [
            {
                "entry_id": "ee41d266-cc5d-31a6-a2c6-ed3f1dcb4047",
                "word": "condiment",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f522e8ac-b4bb-4399-9a56-38d4d91a6e01",
                        "entry_id": "ee41d266-cc5d-31a6-a2c6-ed3f1dcb4047",
                        "tags": [
                            "plural"
                        ],
                        "form": "condiments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d4c3991-0947-305d-898d-d396bc9f9e66",
                        "entry_id": "ee41d266-cc5d-31a6-a2c6-ed3f1dcb4047",
                        "glosses": [
                            "Élaboration produite à partir d’épices, de plantes aromatiques ou d’autres ingrédients que l’on mêle aux aliments pour en rehausser le goût."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21c3d4b5-aaa4-451d-b27d-1421677f08ce",
                                "sense_id": "8d4c3991-0947-305d-898d-d396bc9f9e66",
                                "text": "Le plomb dans le gibier servi sur table est un condiment qui peut être ajouté après la cuisson."
                            },
                            {
                                "example_id": "76c8f46b-f135-4b34-b012-c404e279bbf7",
                                "sense_id": "8d4c3991-0947-305d-898d-d396bc9f9e66",
                                "text": "C'est eux également qui importèrent le poivre, condiment devenu si rare, qu'on l'utilisa comme monnaie."
                            },
                            {
                                "example_id": "386964c1-b934-4fc7-89fc-b9aaecfe16fc",
                                "sense_id": "8d4c3991-0947-305d-898d-d396bc9f9e66",
                                "text": "Il existe une multitude de condiments, de la mayonnaise au ketchup en passant par la sauce soja et le Tabasco. Ponzu, chimichurri, vinaigrette… la liste est infinie."
                            }
                        ]
                    },
                    {
                        "sense_id": "eab23cb6-f671-3e55-aa71-fd97150340fc",
                        "entry_id": "ee41d266-cc5d-31a6-a2c6-ed3f1dcb4047",
                        "glosses": [
                            "Ce qui ajoute de l'intérêt à quelque chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3f42ffe7-dc65-4432-9d76-19e3ff4424dd",
                                "sense_id": "eab23cb6-f671-3e55-aa71-fd97150340fc",
                                "text": "La flatterie fait partie de cette Éloquence tant célébrée, et davantage encore de la Médecine, et au plus haut point de la Poésie. Elle est le miel et le condiment de toutes les relations entre les hommes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae8865dd-a1b7-4baa-9ae0-f7cb39c874a6",
                        "source_entry_id": "ee41d266-cc5d-31a6-a2c6-ed3f1dcb4047",
                        "source_sense_id": "8d4c3991-0947-305d-898d-d396bc9f9e66",
                        "source_sense_description": "Substance",
                        "target_lang_word": "Gewürz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewürz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de503305-2ded-3701-9ccf-98a59b4c151a",
                                        "entry_id": "dd49642b-ae93-3cc2-b609-3d48f95ea37a",
                                        "glosses": [
                                            "Pflanzenteile (besonders von Kräutern), die gemahlen oder ganz einer Speise beigemengt werden, um ihren Geschmack zu verbessern"
                                        ],
                                        "tags": [
                                            "Nahrungsmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7269ad71-c3f8-4128-aff6-58a8c7f283f9",
                                                "sense_id": "de503305-2ded-3701-9ccf-98a59b4c151a",
                                                "text": "Mit den passenden Gewürzen wird dieser Auflauf sehr gut schmecken."
                                            },
                                            {
                                                "example_id": "3c8a7c1b-5b06-448d-975e-9bdbe7b09e69",
                                                "sense_id": "de503305-2ded-3701-9ccf-98a59b4c151a",
                                                "text": "„Wir hatten neben anderen Waren vor allem zweiundvierzig Ballen indische Stoffe der verschiedensten Art, wie Seiden, Musseline und feine Chintze, bei uns, dazu fünfzehn Ballen sehr kostbare chinesische Seiden und siebzig Bündel oder Ballen Gewürze, insbesondere Nelken und Muskatnüsse.“"
                                            },
                                            {
                                                "example_id": "8f57f37f-6b0c-47d5-84e9-d8a90bcc1521",
                                                "sense_id": "de503305-2ded-3701-9ccf-98a59b4c151a",
                                                "text": "„Auf dem weitläufigen, farbenfreudigen Markt gab es alles: von Gemüse und Gewürzen, die auf dem Boden aufgehäuft waren, bis zu Handys und Imitationen von Designer-Sonnenbrillen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45c0665d-bc9c-48b5-9b96-01f5ac3d5840",
                        "source_entry_id": "ee41d266-cc5d-31a6-a2c6-ed3f1dcb4047",
