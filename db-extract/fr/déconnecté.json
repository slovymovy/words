                                "target_senses": [
                                    {
                                        "sense_id": "8191ff7a-c403-3a1a-85b9-d7c7ee54d5c5",
                                        "entry_id": "6de3c9e3-b256-3fd0-b64d-e2537e219fd5",
                                        "glosses": [
                                            "abgewandt von der Wirklichkeit, wenig Kenntnis von den wirklichen Gegebenheiten habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "453b4e54-d436-4a72-9510-809e5d3b5d02",
                                                "sense_id": "8191ff7a-c403-3a1a-85b9-d7c7ee54d5c5",
                                                "text": "Wie gelähmt schaute die weltfremde Maurine in die Trommel der Waschmaschine."
                                            },
                                            {
                                                "example_id": "8f82e44e-b1f7-4638-b7ed-b4c53516b7f3",
                                                "sense_id": "8191ff7a-c403-3a1a-85b9-d7c7ee54d5c5",
                                                "text": "Als ich sagte: „Hol mal bitte den Laptop.“, schleppte der weltfremde Egon tatsächlich einen Topf aus der Küche herbei - er hatte „schlepp Topp“ verstanden."
                                            },
                                            {
                                                "example_id": "34a6cff7-f2d6-4a83-a4e9-a714800a283c",
                                                "sense_id": "8191ff7a-c403-3a1a-85b9-d7c7ee54d5c5",
                                                "text": "„Das war sicherlich eine Geste des Respekts für einen ihrer führenden Politiker, möglicherweise hegten sie Zweifel, ob der weltfremde Gelehrte sich überhaupt auf den Häuserbau verstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1287f70d-dc8a-39b1-847b-daa75d050ec2",
                                        "entry_id": "6de3c9e3-b256-3fd0-b64d-e2537e219fd5",
                                        "glosses": [
                                            "völlig andersartig, völlig fremd"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
