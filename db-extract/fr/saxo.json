        "fr-extract.jsonl": [
            {
                "entry_id": "a9d0f747-280b-3ab1-83ca-ef4ee2f4521b",
                "word": "Saxo",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6d766d68-9021-3355-8c90-46a1231627c6",
                        "entry_id": "a9d0f747-280b-3ab1-83ca-ef4ee2f4521b",
                        "glosses": [
                            "Nom donné par la marque automobile Citroën à un modèle de petite berline, produit de 1996 à 2003."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "06683b0e-9749-4568-8048-a58564d27497",
                                "sense_id": "6d766d68-9021-3355-8c90-46a1231627c6",
                                "text": "Puis la célèbre marque aux chevrons lance, au milieu de la décennie de la « rassurance », son nouveau petit modèle, la Saxo."
                            },
                            {
                                "example_id": "f3693f65-a3bc-4a2c-b7a8-50ba5326da11",
                                "sense_id": "6d766d68-9021-3355-8c90-46a1231627c6",
                                "text": "Toujours est-il que la décision définitive du lancement d’une nouvelle petite Citroën n’est prise que très tardivement et avec des contraintes budgétaires drastiques : la Saxo doit donner au réseau de distribution un petit modèle moderne et, grâce à la faiblesse des investissements consentis, contribuer au désendettement de la marque."
                            },
                            {
                                "example_id": "7f76dc44-2572-483d-a639-9bacf8cdf363",
                                "sense_id": "6d766d68-9021-3355-8c90-46a1231627c6",
                                "text": "Jean-Yves, un riverain, ouvre sa fenêtre et découvre que sa Citroën Saxo a été poussée en travers de la rue et brûle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4144b513-6736-3867-b0c8-a19c63d14fda",
                "word": "saxo",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a0eba851-aa1c-345a-92dc-504bd0086967",
                        "entry_id": "4144b513-6736-3867-b0c8-a19c63d14fda",
                        "glosses": [
                            "Saxophone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81fb6540-09cc-4261-a5cb-31abe925e134",
                                "sense_id": "a0eba851-aa1c-345a-92dc-504bd0086967",
                                "text": "Le fracas de l’orchestre leur arrivait, assourdissant. Par instants, les violons dominaient le vacarme qu’ils semblaient apaiser, caresser, contenir, mais le saxo, le piston, la clarinette et surtout la trompette […] se mettaient ensemble à mugir et à pétarader de telle sorte que personne ne parlait plus."
                            },
                            {
                                "example_id": "bd8e6309-9131-4956-95e8-9f417945054c",
                                "sense_id": "a0eba851-aa1c-345a-92dc-504bd0086967",
                                "text": "Il jouait du saxo au Petit Journal et faisait une fulgurante carrière de demi d’ouverture dans l’équipe de rugby du P.U.C…"
                            }
                        ]
                    }
