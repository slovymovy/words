                ],
                "senses": [
                    {
                        "sense_id": "3e568648-4e60-38e5-90af-48e525be2170",
                        "entry_id": "69327722-86a3-30bc-89f0-0beb3310e855",
                        "glosses": [
                            "lagemäßige Erfassung unterirdischer historischer Bauten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "585d0f57-8746-437f-b038-50e205293553",
                                "sense_id": "3e568648-4e60-38e5-90af-48e525be2170",
                                "text": "„Ein Kellerkataster beinhaltet die georeferenzierte Erfassung sämtlicher Keller im Stadtgebiet vom Mittelalter bis in die Moderne.“"
                            },
                            {
                                "example_id": "81e3a838-3e3a-4077-868e-299011a13ba5",
                                "sense_id": "3e568648-4e60-38e5-90af-48e525be2170",
                                "text": "„Mit dem Kellerkataster Oberstadt liegt nun eine flächendeckende, digitale Dokumentation der zugänglichen historischen Keller des ältesten Stadtgebiets Aschaffenburgs vor.“"
                            },
                            {
                                "example_id": "53cc54f7-a319-4f4c-8c84-8962a27b626c",
                                "sense_id": "3e568648-4e60-38e5-90af-48e525be2170",
                                "text": "„Die Stadt Lohr ist seit einiger Zeit dabei […] ein Kellerkataster für die Altstadt Lohr erstellen zu lassen.“"
                            },
                            {
                                "example_id": "fb9b41f6-655c-450a-9e89-45815aa5003f",
                                "sense_id": "3e568648-4e60-38e5-90af-48e525be2170",
                                "text": "„Mit Hilfe eines Kellerkatasters können in Teilbereichen der Altstadtquartiere Rückschlüsse auf die ehemalige Bebauungssituation der hochmittelalterlichen Bürgerstadt, die sich westlich des Kirchensporns erstreckt, gezogen werden.“"
                            },
                            {
                                "example_id": "456fb391-0b25-4567-8400-24972be2c097",
                                "sense_id": "3e568648-4e60-38e5-90af-48e525be2170",
                                "text": "„Die vorhandenen Keller sind zu erfassen und in das Kellerkataster der Denkmalpflege Landesdenkmalamtes zu übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
