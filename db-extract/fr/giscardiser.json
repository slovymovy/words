                "senses": [
                    {
                        "sense_id": "7106e38d-c1dd-302f-b72a-b990a2c337ec",
                        "entry_id": "21ddfa5a-6afc-3104-9859-c8ab8d3da2f9",
                        "glosses": [
                            "Rendre giscardien."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "84622bd8-0585-47a0-8d40-dbe45316fe39",
                                "sense_id": "7106e38d-c1dd-302f-b72a-b990a2c337ec",
                                "text": "Dans le même temps, il reprend à son compte la phraséologie gaulliste utilisée par ses challengers qui, de leur côté, épargnent le maire de Paris pour concentrer leurs critiques sur les mauvais génies - Balladur et Juppé - qui « giscardisent » le RPR."
                            }
                        ]
                    },
                    {
                        "sense_id": "67f2ed1e-08b9-3c4e-8963-dd0923f4b708",
                        "entry_id": "21ddfa5a-6afc-3104-9859-c8ab8d3da2f9",
                        "glosses": [
                            "Devenir giscardien."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "ca145a4f-49e7-400c-958b-f533c6ca5c93",
                                "sense_id": "67f2ed1e-08b9-3c4e-8963-dd0923f4b708",
                                "text": "Cette pauvre UDR se giscardise, c'est-à-dire qu'elle va à la mort. « Quant à Jobert, dit encore Debré, si l'UDR se redresse, il sombrera dans le ridicule."
                            }
                        ]
                    }
