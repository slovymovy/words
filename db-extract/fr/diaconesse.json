            {
                "entry_id": "09206c63-d521-3304-8800-3a20651e2a03",
                "word": "diaconesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2510d043-31cc-44ed-917d-83d4391eacb3",
                        "entry_id": "09206c63-d521-3304-8800-3a20651e2a03",
                        "tags": [
