                "senses": [
                    {
                        "sense_id": "d8336094-3be9-35f3-bbef-b62aadb30fa3",
                        "entry_id": "eed80149-8ef5-3f3a-abd4-1e95dfa7e6fc",
                        "glosses": [
                            "uiterste deel, daar waar iets ophoudt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6c3998-a4cf-43ad-a809-7398ac4c1eaf",
                                "sense_id": "d8336094-3be9-35f3-bbef-b62aadb30fa3",
                                "text": "Uw betoog van zojuist was gericht tegen de versnippering van de zorg en de grote hoeveelheid aanbieders die inderdaad van het ene end van de stad naar het andere end van de stad rijden, om vervolgens met hun autootje naast de concurrent te gaan staan."
                            }
                        ]
                    },
                    {
                        "sense_id": "61a6d805-6c43-330d-97b1-e5f775816bbb",
                        "entry_id": "eed80149-8ef5-3f3a-abd4-1e95dfa7e6fc",
                        "glosses": [
                            "ogenblik dat iets stopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cf9c475-7495-486f-bd43-8c6cc89c5a82",
                                "sense_id": "61a6d805-6c43-330d-97b1-e5f775816bbb",
                                "text": "Tante kan niet eeuwig leven\nOok aan tante komt 'n end"
                            }
                        ]
                    },
                    {
                        "sense_id": "b1fcfcc6-aab3-3e1a-879d-b30bb12bfcea",
                        "entry_id": "eed80149-8ef5-3f3a-abd4-1e95dfa7e6fc",
                        "glosses": [
                            "flinke afstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0e9b9b-c5b8-4bf6-b036-e5a1b0894546",
                                "sense_id": "b1fcfcc6-aab3-3e1a-879d-b30bb12bfcea",
                                "text": "Ook wie weinig nodig heeft, zal graag een winkelwagentje nemen, al is het maar om op de stang te kunnen leunen. Voor een stukje zeep in pakweg rij 11-B moet immers een end gelopen worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7320365-1500-3cdf-9d76-9496ad08842e",
                        "entry_id": "eed80149-8ef5-3f3a-abd4-1e95dfa7e6fc",
                        "glosses": [
                            "kort stuk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3537c29-b622-472b-8c3a-8326007bd4b2",
                                "sense_id": "a7320365-1500-3cdf-9d76-9496ad08842e",
                                "text": "Een advocaat in Amsterdam, Frank Bakker, heeft de minister gedagvaard, aangezien er niet goed opgetreden wordt tegen losgeslagen fietsers. \"Vandaag of morgen sla ik er een met een end hout.\" Je merkt dat de emoties hoog oplopen bij deze meneer en dat is ook wel logisch."
                            }
                        ]
                    }
