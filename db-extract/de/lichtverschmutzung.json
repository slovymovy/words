                ],
                "senses": [
                    {
                        "sense_id": "8209888b-b9aa-30f4-9390-c9089fe216ea",
                        "entry_id": "9ac924fa-2e41-3d3e-b127-08da67cef417",
                        "glosses": [
                            "Störung der natürlichen nächtlichen Dunkelheit durch künstliche Lichtquellen mit negativen Auswirkungen auf Flora, Fauna und Astronomie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8417dde3-2d3a-4656-9fd1-834f6529bdf0",
                                "sense_id": "8209888b-b9aa-30f4-9390-c9089fe216ea",
                                "text": "Interessierte können Daten zu sogenannter Lichtverschmutzung auf einer neuen Online-Karte abrufen."
                            },
                            {
                                "example_id": "e18e50bb-9e64-4a3f-8157-bee85d7dd912",
                                "sense_id": "8209888b-b9aa-30f4-9390-c9089fe216ea",
                                "text": "Werbung ist dabei nur eine von mehreren Ursachen für „Lichtverschmutzungen“."
                            },
                            {
                                "example_id": "f3db1957-2174-4736-a1cb-2f4484c98359",
                                "sense_id": "8209888b-b9aa-30f4-9390-c9089fe216ea",
                                "text": "Ein neues Forschernetzwerk und raffinierte Technologie sollen die Lichtverschmutzung nun bekämpfen."
                            },
                            {
                                "example_id": "e086d9b8-4712-443f-946f-3e03269172f8",
                                "sense_id": "8209888b-b9aa-30f4-9390-c9089fe216ea",
                                "text": "Lichtverschmutzung wirkt sich auch auf die Gesundheit des Menschen negativ aus, vornehmlich wegen der Beeinträchtigung des Tag-Nacht-Zyklus und der nächtlichen Regenerationsphasen."
                            },
                            {
                                "example_id": "c4a26462-5aa4-4a8c-b38f-5a1d3f08320c",
                                "sense_id": "8209888b-b9aa-30f4-9390-c9089fe216ea",
                                "text": "„Lichtverschmutzung“ nennt man alles, was Mond und Sterne in einen milchigen Schleier hüllt und die Wolken in riesige, orange-lilafarbene Reflektoren verwandelt."
                            },
                            {
                                "example_id": "7dbe16fc-e4b4-4340-965c-2f668b3025c6",
                                "sense_id": "8209888b-b9aa-30f4-9390-c9089fe216ea",
                                "text": "Ökologische Lichtverschmutzung entsteht durch permanent und periodisch veränderte Lichtverhältnisse, plötzliche Änderungen der Beleuchtung und direkte Blendung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
