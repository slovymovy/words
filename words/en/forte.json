{
    "word_family": [
        "fortissimo"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a988db5-730f-3a1b-8dfd-835a7e263ec3",
                    "sense_definition": "A strength or talent; a strong point.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "talent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He writes respectably, but poetry is not his <w>forte</w>.",
                            "target_lang_translations": {
                                "ru": "Он пишет недурно, но поэзия — не его <w>сильная сторона</w>."
                            }
                        },
                        {
                            "text": "Public speaking has never been my <w>forte</w>, so I always get nervous before presentations.",
                            "target_lang_translations": {
                                "ru": "Публичные выступления никогда не были моим <w>коньком</w>, поэтому я всегда нервничаю перед презентациями."
                            }
                        }
                    ],
                    "synonyms": [
                        "bent",
                        "gift",
                        "knack",
                        "long suit",
                        "métier",
                        "speciality",
                        "strength",
                        "strong suit",
                        "talent"
                    ],
                    "antonyms": [
                        "weak spot"
                    ],
                    "common_phrases": [
                        "not my forte"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная сторона человека, его талант или преимущество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильная сторона",
                                "target_lang_sense_clarification": "качество или умение, в котором кто-то преуспевает"
                            },
                            {
                                "target_lang_word": "конек",
                                "target_lang_sense_clarification": "любимое занятие или тема, в которой человек хорошо разбирается"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c604ca7d-cce6-3b1c-8ee4-6e0d1ac2a634",
                    "sense_definition": "A passage in music to be played loudly; a loud section of music.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_loudness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>forte</w> marks the climax of the second movement.",
                            "target_lang_translations": {
                                "ru": "Это <w>форте</w> отмечает кульминацию второй части."
                            }
                        },
                        {
                            "text": "The conductor emphasized the sudden transition into a dramatic <w>forte</w>.",
                            "target_lang_translations": {
                                "ru": "Дирижер подчеркнул внезапный переход к драматическому <w>форте</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "musical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий фрагмент или раздел в музыкальном произведении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "форте",
                                "target_lang_sense_clarification": "громкий фрагмент музыкального произведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04e5e0f3-ef7d-38ff-8f5d-d413290f230d",
                    "sense_definition": "The strong part of a sword blade, close to the hilt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sword_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He parried the blow using the <w>forte</w> of his blade to maximize leverage.",
                            "target_lang_translations": {
                                "ru": "Он парировал удар, используя <w>сильную часть</w> своего клинка для максимального рычага."
                            }
                        },
                        {
                            "text": "The fencer knew that defending with the <w>forte</w> was much more effective than using the tip.",
                            "target_lang_translations": {
                                "ru": "Фехтовальщик знал, что защищаться <w>основанием клинка</w> гораздо эффективнее, чем кончиком."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "fencing term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная часть клинка (меча или шпаги), расположенная ближе к эфесу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильная часть клинка",
                                "target_lang_sense_clarification": "часть лезвия у рукояти"
                            },
                            {
                                "target_lang_word": "форте",
                                "target_lang_sense_clarification": "основание клинка в фехтовании"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "311a496b-ef8d-3a78-98a3-bb11641f9cff",
                    "sense_definition": "Loud.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_loudness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This passage is <w>forte</w>, then there's a diminuendo to mezzo piano.",
                            "target_lang_translations": {
                                "ru": "Этот пассаж играется <w>громко</w>, затем идет диминуэндо до меццо-пиано."
                            }
                        },
                        {
                            "text": "The sheet music indicates that the opening chords should be <w>forte</w>.",
                            "target_lang_translations": {
                                "ru": "В нотах указано, что начальные аккорды должны быть <w>форте</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "musical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий (о звуке или музыкальном пассаже)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громкий",
                                "target_lang_sense_clarification": "о звучании музыки"
                            },
                            {
                                "target_lang_word": "форте",
                                "target_lang_sense_clarification": "исполняемый громко"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "17ca15cf-dad0-354f-9cd1-6bb0098ad0a7",
                    "sense_definition": "Loudly, as a dynamic in a piece of music.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_loudness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musicians played the passage <w>forte</w>.",
                            "target_lang_translations": {
                                "ru": "Музыканты сыграли этот отрывок <w>громко</w>."
                            }
                        },
                        {
                            "text": "You need to sing this section <w>forte</w> to be heard over the brass instruments.",
                            "target_lang_translations": {
                                "ru": "Вам нужно петь эту часть <w>форте</w>, чтобы вас было слышно за духовыми инструментами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "musical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко (как динамическое указание в музыке)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громко",
                                "target_lang_sense_clarification": "в полную силу звука"
                            },
                            {
                                "target_lang_word": "форте",
                                "target_lang_sense_clarification": "музыкальный термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f8574f76-ebe7-344f-b852-8e8442f45daa",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Forte</w> to speak at the annual conference.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили господина <w>Форте</w> выступить на ежегодной конференции."
                            }
                        },
                        {
                            "text": "The local gallery is hosting an exhibition of paintings by the artist Sarah <w>Forte</w>.",
                            "target_lang_translations": {
                                "ru": "В местной галерее проходит выставка картин художницы Сары <w>Форте</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия Форте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Форте",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}