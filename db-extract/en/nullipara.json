                                        "entry_id": "f3bd0bf6-20bb-3ec7-8916-2f25f37a4f71",
                                        "glosses": [
                                            "Femme qui n'a jamais mis bas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9522df8-1868-4540-8de9-7fd700814eab",
                                                "sense_id": "0ae49e70-a18b-3694-ac50-c55630757fe4",
                                                "text": "Le stérilet n’est pas contre-indiqué chez une nullipare."
                                            },
                                            {
                                                "example_id": "dfa41e6a-abca-4af5-91f3-733fba4b7fc5",
                                                "sense_id": "0ae49e70-a18b-3694-ac50-c55630757fe4",
                                                "text": "Longtemps réservé aux femmes ayant déjà eu des enfants, le DIU peut aujourd’hui être proposé aux nullipares."
                                            }
                                        ]
                                    }
                                ]
