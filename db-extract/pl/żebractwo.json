                        "sense_id": "61a771ac-fd40-395e-bd8f-1c831d168d88",
                        "entry_id": "4f309cea-27d9-3b6b-a4cc-5b2a99bd1f34",
                        "glosses": [
                            "proszenie w miejscu publicznym o wsparcie materialne w sytuacji biedy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b05b7fd7-52a7-4c6d-b170-831f1bbf62a6",
                                "sense_id": "61a771ac-fd40-395e-bd8f-1c831d168d88",
                                "text": "Władze miasta chcą zrobić porządek z żebractwem dworcowym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "29cc009b-3a60-30bb-bacb-5802ad92459b",
                        "entry_id": "4f309cea-27d9-3b6b-a4cc-5b2a99bd1f34",
                        "glosses": [
