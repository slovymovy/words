                "senses": [
                    {
                        "sense_id": "accd421a-6351-324e-8436-9333b0968436",
                        "entry_id": "a91ed0fd-7a3d-394e-aaac-49ec64ffe3e0",
                        "glosses": [
                            "Parenté par les hommes uniquement. L’agnation, dite aussi parenté civile est la seule reconnue par le droit romain, par opposition à la parenté naturelle ou cognation."
                        ],
                        "tags": [
                            "Généalogie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f9c8d11a-90e0-399f-b844-6d319bdfe7c5",
                        "entry_id": "a91ed0fd-7a3d-394e-aaac-49ec64ffe3e0",
                        "glosses": [
                            "Lien de consanguinité entre eux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8557f589-7e97-48de-9200-64dfb2b99b96",
                                "sense_id": "f9c8d11a-90e0-399f-b844-6d319bdfe7c5",
                                "text": "Comprise comme principe identitaire, l’agnation postule que de par leur origine commune les descendants agnats d’un ancêtre commun partagent la même identité jusqu’au point de constituer « un seul corps », « une seule chair » ou encore, comme l’exprime parfaitement l’expression vezo « d’olo raiky roze », « une seule personne »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a978569d-7651-40e5-b55a-019409875b48",
                        "source_entry_id": "a91ed0fd-7a3d-394e-aaac-49ec64ffe3e0",
