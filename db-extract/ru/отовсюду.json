                    },
                    {
                        "translation_id": "68b9d66e-f843-46e4-a00c-de10764c4564",
                        "source_entry_id": "721d878e-a218-327a-857d-d47151aae11e",
                        "source_sense_id": "b9b9aad5-ea1a-3230-81f9-8459877eacf5",
                        "target_lang_word": "por todos los lados",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ed0693f2-809a-445c-9455-184a77e9ebc0",
                        "source_entry_id": "721d878e-a218-327a-857d-d47151aae11e",
                        "source_sense_id": "b9b9aad5-ea1a-3230-81f9-8459877eacf5",
                        "target_lang_word": "de tous côtés",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de tous côtés",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf31f814-8e35-31cc-9d09-67b5e2edb67f",
                                        "entry_id": "c01f094a-e641-3e0d-9a9d-205d3993ccfd",
                                        "glosses": [
                                            "Dans toutes les directions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a7d3f4-d0e8-4072-973b-a30f49c98272",
                                                "sense_id": "cf31f814-8e35-31cc-9d09-67b5e2edb67f",
                                                "text": "Sa tête ressemblait à une tête de loup : ses cheveux, coupés en brosse, se dressaient de tous côtés ; partout des mèches tombantes, des bouts de nattes."
                                            },
                                            {
                                                "example_id": "f8de55de-44f5-4ba2-b40e-34176fb3b49b",
                                                "sense_id": "cf31f814-8e35-31cc-9d09-67b5e2edb67f",
                                                "text": "Donc la lumière, qui est la première forme créée dans la matière première, s’auto-multiplie de tous côtés une infinité de fois, et s'étend uniformément en toutes directions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd8a8495-6b5d-3052-93f0-e08be0d008cb",
                                        "entry_id": "c01f094a-e641-3e0d-9a9d-205d3993ccfd",
                                        "glosses": [
                                            "De toutes parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25dc5252-9702-4c75-9132-1582f14621b8",
                                                "sense_id": "fd8a8495-6b5d-3052-93f0-e08be0d008cb",
                                                "text": "Non pas, non pas, cria-t-on de tous côtés ; il y a encore Venise. - Venise la reine des mers !"
                                            },
                                            {
                                                "example_id": "ee95b5b7-6c92-47fc-a0fd-5bb9f8e7a0ae",
                                                "sense_id": "fd8a8495-6b5d-3052-93f0-e08be0d008cb",
                                                "text": "[…] ; des centaines d'embarcations affluent de tous côtés, forment un immense demi-cercle autour des cétacés et les chassent vers quelque crique, où ils sont promptement massacrés."
                                            },
                                            {
                                                "example_id": "ecc4e4bf-3fdd-495c-b763-359a9858516c",
                                                "sense_id": "fd8a8495-6b5d-3052-93f0-e08be0d008cb",
                                                "text": "Le fait, d’ailleurs, est patent, incontesté, affirmé de tous côtés : l’aisance s’est énormément développée parmi les ruraux des Côtes-du-Nord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00adefbc-b034-3620-aca8-7d2b7a067c9d",
                                        "entry_id": "c01f094a-e641-3e0d-9a9d-205d3993ccfd",
                                        "glosses": [
                                            "Tout autour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d9caf39-0fb8-4bdf-ac90-cf55adb23310",
                                                "sense_id": "00adefbc-b034-3620-aca8-7d2b7a067c9d",
                                                "text": "[…], ils voulurent se rendre maîtres des deux Océans, cernant de tous côtés les tribus aborigènes […]."
                                            },
                                            {
                                                "example_id": "42152549-e9f2-463b-ba75-ba07e5cd8c34",
                                                "sense_id": "00adefbc-b034-3620-aca8-7d2b7a067c9d",
                                                "text": "L’anse où nous mouillons est évidemment un ancien cratère dans l’intérieur duquel la mer a fait irruption ; de tous côtés surgissent des cônes de cendres qui dénotent une récente activité volcanique."
                                            },
                                            {
                                                "example_id": "2dc23700-c117-4bdd-9337-dce351cf3e35",
                                                "sense_id": "00adefbc-b034-3620-aca8-7d2b7a067c9d",
                                                "text": "Les pâturages, enclavés dans les bois de tous côtés, sauf au levant, où des haies vives érigeaient leurs épaisses barrières épineuses, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afa8b83e-7de3-4be4-b2f1-1dd3306d1250",
                        "source_entry_id": "721d878e-a218-327a-857d-d47151aae11e",
                        "source_sense_id": "b9b9aad5-ea1a-3230-81f9-8459877eacf5",
                        "target_lang_word": "de toutes parts",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de toutes parts",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17dc391d-ff2e-3895-b5ea-6a68b77a9516",
                                        "entry_id": "14341e8d-7c4d-3997-8b9a-d75bc727a024",
                                        "glosses": [
                                            "De tous les côtés à la fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e79924f-067f-490f-9cd0-d02a8d7cfbf6",
                                                "sense_id": "17dc391d-ff2e-3895-b5ea-6a68b77a9516",
                                                "text": "La glorieuse défense de Mazagran a excité, dans toute la France, des transports unanimes d'admiration. De toutes parts des souscriptions ont été spontanément ouvertes pour élever en Algérie un monument destiné à perpétuer le souvenir de ce brillant fait d'armes."
                                            },
                                            {
                                                "example_id": "75d72256-85c7-440b-86c9-843a730b4ff3",
                                                "sense_id": "17dc391d-ff2e-3895-b5ea-6a68b77a9516",
                                                "text": "Alors commence de toutes parts le grand assaut des comestibles; on se précipite par centaines, par milliers sur ces restaurants improvisés, c'est un pèle-mêle indescriptible; les rosbeefs, les saucissons, les rognons de veau, les pâtés se vendent à l’encan, […]. — (Revue de Paris, 1853, volume 18, partie 2, page 982)"
                                            },
                                            {
                                                "example_id": "3e2e8959-5c08-4209-9261-8db18c55c90c",
                                                "sense_id": "17dc391d-ff2e-3895-b5ea-6a68b77a9516",
                                                "text": "De toutes parts, on m'offre de la main-d'œuvre, brodeuses déjà habiles ou simples apprentières. Je découvre ainsi que ce métier, jadis excellent, a beaucoup perdu, la machine fait une concurrence acharnée, les salaires sont bien réduits."
                                            },
                                            {
                                                "example_id": "cdbaad97-01a5-468e-905d-fa2aaa5e6b0f",
                                                "sense_id": "17dc391d-ff2e-3895-b5ea-6a68b77a9516",
                                                "text": "Et, par malheur, elle se croyait sûre du succès, elle ne savait pas Rabourdin miné de toutes parts par le travail sourd des tarets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e819647-5086-3840-9771-f74f80a0567a",
                                        "entry_id": "14341e8d-7c4d-3997-8b9a-d75bc727a024",
                                        "glosses": [
                                            "Par tout le monde."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5961e9d-8aaf-4ba4-843f-2884d0a740cf",
                                                "sense_id": "4e819647-5086-3840-9771-f74f80a0567a",
                                                "text": "Mark Knight, connu pour ses caricatures controversées, a été attaqué de toutes parts après la publication de son dessin, y compris par un membre du Congrès américain et une partie non négligeable des 22 000 personnes ayant commenté son dessin sur Twitter…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6720b39-e74e-49ec-9c05-1e8b1f196ca6",
                        "source_entry_id": "721d878e-a218-327a-857d-d47151aae11e",
