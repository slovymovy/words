                                "sense_id": "cfa34307-d17a-334c-9c40-e1b84a043351",
                                "text": "There are no talkable people within ten miles, except a coast-guard officer, and a pleasant parson, three miles off."
                            },
                            {
                                "example_id": "92be834f-81f3-45e8-a2e4-0941f7ea06a6",
                                "sense_id": "cfa34307-d17a-334c-9c40-e1b84a043351",
                                "text": "But he always came back in good spirits, talkable and charming."
                            }
