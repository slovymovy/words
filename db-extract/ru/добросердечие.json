                                        "entry_id": "904aee88-cc33-3b22-9142-066b2908c472",
                                        "glosses": [
                                            "Alternative form of kindheartedness."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e6d5f30-49bd-4374-a7ed-099108cb7056",
                                                "sense_id": "986deb96-cd97-37c8-a476-7177f5165f5f",
                                                "text": "With such people, one is not secure in regard to owed duties; they hate owed duty, and prefer to do everything on their own” out of kind-heartedness and benevolence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
