                        "cross_references": [
                            {
                                "target_word": "шахада",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "918f70aa-6fc8-348c-bb28-f0b6fa66ec59",
                                        "entry_id": "326c71c0-2f36-3799-98d3-1923254527f2",
                                        "glosses": [
                                            "формула исповедания единобожия в исламе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa1413bb-ca4a-45fa-a5f1-c3d4806102e3",
                                                "sense_id": "918f70aa-6fc8-348c-bb28-f0b6fa66ec59",
                                                "text": "Султан, подаривший курбаши свой талисман с шахадой: «Нет божества, кроме аллаха», первым нашёлся, что надо делать."
                                            },
                                            {
                                                "example_id": "0f3c522d-5bc2-483f-a9b4-c45cb2e9f55f",
                                                "sense_id": "918f70aa-6fc8-348c-bb28-f0b6fa66ec59",
                                                "text": "Прежде всего мусульмане — это люди, покорные Единому Богу, о чём свидетельствует главная формула признания Единобожия — шахада: \"Ашхаду алля иляхэ илля ллах, ва ашхаду анна мухаммадар-расулюл-лах \" (\"Свидетельствую, что нет бога, кроме Единого Бога, и свидетельствую, что Мухаммад — Посланник Его \")."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
