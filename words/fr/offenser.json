    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a6bc9d0-9421-3d13-94e1-f0625720236f",
                    "sense_definition": "Blesser moralement quelqu'un par des paroles, des actes ou une attitude déplacée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "atteinte_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'avait aucune mauvaise intention et ne voulait pas vous <w>offenser</w> avec cette remarque."
                        },
                        {
                            "text": "Ses propos méprisants ont profondément <w>offensé</w> l'ensemble des invités pendant le dîner."
                        }
                    ],
                    "synonyms": [
                        "blesser",
                        "froisser",
                        "insulter",
                        "outrager",
                        "vexer"
                    ],
                    "antonyms": [
                        "complimenter",
                        "flatter",
                        "honorer"
                    ],
                    "common_phrases": [
                        "sans vouloir vous offenser"
                    ]
                },
                {
                    "sense_id": "0e3ad34a-38db-3d8c-86fd-1afa140b269c",
                    "sense_definition": "Heurter ou transgresser des principes, la morale, la bienséance ou le bon goût.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transgression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce comportement grossier en public <w>offense</w> la bienséance et choque les plus âgés."
                        },
                        {
                            "text": "Une telle tenue dans ce lieu sacré risque d'<w>offenser</w> la pudeur des fidèles."
                        }
                    ],
                    "synonyms": [
                        "choquer",
                        "heurter",
                        "scandaliser"
                    ],
                    "antonyms": [
                        "respecter"
                    ],
                    "common_phrases": [
                        "offenser la bienséance",
                        "offenser la pudeur"
                    ]
                },
                {
                    "sense_id": "81694cbb-4ed2-30ff-b6bd-7e952ab86062",
                    "sense_definition": "Heurter ou affecter péniblement un organe des sens comme la vue ou l'ouïe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "atteinte_sensorielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette lumière crue et aveuglante <w>offense</w> la vue dès qu'on entre dans la pièce."
                        },
                        {
                            "text": "Le grincement strident de la machine <w>offense</w> l'oreille des ouvriers tout au long de la journée."
                        }
                    ],
                    "synonyms": [
                        "agresser",
                        "incommoder",
                        "irriter"
                    ],
                    "antonyms": [
                        "caresser",
                        "charmer",
                        "flatter"
                    ],
                    "common_phrases": [
                        "offenser la vue",
                        "offenser l'oreille"
                    ]
                }
            ]
        }
    ]
}