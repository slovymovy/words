            "senses": [
                {
                    "sense_id": "eb6c9701-d178-33c0-b3ac-5d87b34b89a6",
                    "sense_definition": "verbonden met een flink risico of gevaar; blijk gevend van moed",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "risico",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>gewaagde</w> onderneming om zonder kaart het bos in te gaan.",
                            "target_lang_translations": {
                                "en": "It was a <w>risky</w> undertaking to go into the forest without a map."
                            }
                        },
                        {
                            "text": "Zij maakte een <w>gewaagde</w> sprong over de diepe kloof.",
                            "target_lang_translations": {
                                "en": "She made a <w>daring</w> jump over the deep gorge."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedenkelijk",
                        "waaghalzerig"
                    ],
                    "antonyms": [
                        "veilig",
                        "voorzichtig"
