                                                "sense_id": "7143926f-d8b0-3490-ac1d-e72095f4e0b7",
                                                "text": "Wat is Donald Duck toch een pechvogel!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe06d038-740d-4604-82fc-10c9c761c3a4",
                        "source_entry_id": "5e0ea315-14bd-3221-82b8-36fa0213d643",
                        "source_sense_id": "2b95e52e-77ae-3968-bdad-3fae4f744025",
                        "source_sense_description": "a chronically unlucky person",
                        "target_lang_word": "schlemiel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlemiel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "aee23217-9fa8-352a-8860-35e8ec5cebf1",
                                        "entry_id": "771d4cd2-d6e6-3451-b4e6-b33357380f50",
                                        "glosses": [
                                            "sukkel, domkop, slappeling"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af7abebf-8692-4808-90b7-d793f8222505",
                                                "sense_id": "aee23217-9fa8-352a-8860-35e8ec5cebf1",
                                                "text": "In deze klucht is koopman Jean een beetje een schlemiel die weliswaar meent dat hij alles onder controle heeft, maar in werkelijkheid de speelbal is van het bedrog door anderen."
                                            },
                                            {
                                                "example_id": "d2e0d916-70b1-4e73-a8e8-4efd738c29b3",
                                                "sense_id": "aee23217-9fa8-352a-8860-35e8ec5cebf1",
                                                "text": "⧖ Kon hij dan nooit iets goed doen? Zou ie dan altijd een schlemiel blijven? Hij zag z'n vader al met 'n van drift rooden kop. En ze waren tehuis toch al zoo arm. Z'n moeder zou 'm een lijst presenteeren van al hun zorgen en al hun sores en hem vertellen, hoe dat gemiste kippengeld hen in den afgrond wipte.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb45903-d5c6-3452-a0d9-f645c90dae7a",
                                        "entry_id": "771d4cd2-d6e6-3451-b4e6-b33357380f50",
                                        "glosses": [
                                            "stakker, stumper, pechvogel"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "943ea441-b0fc-43a9-8fc7-b158a83e1fd1",
                                                "sense_id": "5eb45903-d5c6-3452-a0d9-f645c90dae7a",
                                                "text": "(...) is het prototype van de schlemiel, de stakker die eerder spotlust opwekt dan mededogen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b53970de-696a-4834-a737-7ff9f093042b",
                        "source_entry_id": "5e0ea315-14bd-3221-82b8-36fa0213d643",
                        "source_sense_id": "2b95e52e-77ae-3968-bdad-3fae4f744025",
                        "source_sense_description": "a chronically unlucky person",
                        "target_lang_word": "Pechvogel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pechvogel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9262007c-fc0e-3c91-9599-0ad223bbfa2c",
                                        "entry_id": "0fa7c723-f0ed-391c-bb74-b779e19c4972",
                                        "glosses": [
                                            "eine Person, die wenig Glück, stattdessen viel Pech hat"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba09e0a0-04c5-44a1-bc45-edbadb412804",
                                                "sense_id": "9262007c-fc0e-3c91-9599-0ad223bbfa2c",
                                                "text": "Dieter ist ein echter Pechvogel, er hatte diese Woche schon drei Autounfälle."
                                            },
                                            {
                                                "example_id": "be510b8a-8fde-48f4-9f61-41d23bb8c812",
                                                "sense_id": "9262007c-fc0e-3c91-9599-0ad223bbfa2c",
                                                "text": "„Denn in seiner Einsiedelei sollte der Pechvogel, der bisher kein Glück im Privatleben hatte, endlich eine Gefährtin für die guten und die schlechten Tage finden.“"
                                            },
                                            {
                                                "example_id": "a05017e6-d6dc-42a8-b2bd-70b4313de51f",
                                                "sense_id": "9262007c-fc0e-3c91-9599-0ad223bbfa2c",
                                                "text": "„Andere Witzfiguren, wie den Pechvogel und Unglücksraben, den Schüchternen, Groben oder auch den Faulen, den Naschhaften, Gefräßigen oder den Trunkenbold müssen wir hier übergehen, um uns einer größeren Gruppe noch etwas eingehender zuwenden zu können: Dem Dummenwitz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
