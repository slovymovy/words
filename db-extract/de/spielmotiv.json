                "senses": [
                    {
                        "sense_id": "da6b2b79-cebf-3d96-8b45-6249fa1cd9da",
                        "entry_id": "9d96e616-28f4-3a83-adee-0b7988d6f669",
                        "glosses": [
                            "Anreiz, Antrieb, Beweggrund zum Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "640a31d7-5fa0-4d83-ad76-d7c82b841afe",
                                "sense_id": "da6b2b79-cebf-3d96-8b45-6249fa1cd9da",
                                "text": "„Während der Kenntniserwerb vorher von Spielmotiven abhing, orientiert sich das Kind später bewusst auf die Inhalte, die im didaktischen Spiel vertieft werden.“"
                            },
                            {
                                "example_id": "9fc7a50d-3dee-4b1a-a0cb-32d510028d58",
                                "sense_id": "da6b2b79-cebf-3d96-8b45-6249fa1cd9da",
                                "text": "„Dennoch ist nicht zu verkennen, dass die einzelnen Spielmotive eine recht unterschiedliche Stellung im Spielganzen haben, mitunter auch ein einzelnes Motiv dem Gesamtablauf seine charakteristische Färbung gibt.“"
                            },
                            {
                                "example_id": "975454be-248a-4882-975c-2232a8466696",
                                "sense_id": "da6b2b79-cebf-3d96-8b45-6249fa1cd9da",
                                "text": "„Jeweils über die Hälfte der Jugendlichen gaben als Spielmotive spektakuläre Crashs, Nervenkitzel und aufregende Überholvorgänge an.“"
                            },
                            {
                                "example_id": "6642075a-f6ab-46a6-8238-f8c69f1ddefd",
                                "sense_id": "da6b2b79-cebf-3d96-8b45-6249fa1cd9da",
                                "text": "„Oder wäre das eine Erwartung von Hochhuthscher Wucht und Banalität, der ein Botho Strauß eben leichtfüßig entgeht, wenn er seinen seit zwei Jahrzehnten eingespielten Spielmotiven und -figuren nur eine aktuell patriotische Duftnote zumischt?“"
                            },
                            {
                                "example_id": "fd9ddf0d-0a61-448e-95e9-fa8182465b71",
                                "sense_id": "da6b2b79-cebf-3d96-8b45-6249fa1cd9da",
                                "text": "„Mochte der Zauberer auf seine Manier an das so oft und auf allen Lebensgebieten von uns gespielte Spiel von des Kaisers neuen Kleidern erinnern wollen: etwas – des Kaisers neue Kleider – ist nicht vorhanden, alle tun aber so, als sei es unstreitig da, er zeigte uns jedenfalls eine recht aparte Variante oder Umkehrung des Spielmotivs: etwas ist zwar da, ist aber nicht wirklich da.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
