        "pl-extract.jsonl": [
            {
                "entry_id": "5bd7dbd8-11d0-357c-bd96-acdfaa43a7c4",
                "word": "zapomoga",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6be06ddb-219a-3362-b689-425243c81960",
                        "entry_id": "5bd7dbd8-11d0-357c-bd96-acdfaa43a7c4",
                        "glosses": [
                            "pomoc finansowa udzielana bezzwrotnie osobom znajdującym się w trudnej sytuacji materialnej, losowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83d9dcc5-eeb2-4072-bf42-7544c22912bf",
                                "sense_id": "6be06ddb-219a-3362-b689-425243c81960",
                                "text": "Wojna zostawiła ich bez dachu nad głową i bez żywności; teraz wegetują dzięki zapomogom."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d98afe6a-a984-4ed5-8cf2-055cf6237471",
                        "source_entry_id": "5bd7dbd8-11d0-357c-bd96-acdfaa43a7c4",
                        "source_sense_id": "6be06ddb-219a-3362-b689-425243c81960",
                        "target_lang_word": "benefit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benefit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "858008d0-ca0a-39bb-af71-0840101c8517",
                                        "entry_id": "7f5d137d-6638-3719-a9d0-06ff8890afdd",
                                        "glosses": [
                                            "An advantage; help or aid from something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e91a193f-0baa-416b-a6f0-a50246d8a5b3",
                                                "sense_id": "858008d0-ca0a-39bb-af71-0840101c8517",
                                                "text": "For the trip over the grass-covered sleepers and between the cow-parsley and briars, an open wagon was added to the usual combination of locomotive and coach, for the benefit of those who wanted to take photographs."
                                            },
                                            {
                                                "example_id": "09ec4b97-5943-4cdc-81a9-5650247f8387",
                                                "sense_id": "858008d0-ca0a-39bb-af71-0840101c8517",
                                                "text": "She can't read, so the voice recording was made for her benefit."
                                            },
                                            {
                                                "example_id": "2ad04023-f38b-424d-9190-56061dab347c",
                                                "sense_id": "858008d0-ca0a-39bb-af71-0840101c8517",
                                                "text": "Exposure to cutting-edge technologies is one of the benefits of the job."
                                            },
                                            {
                                                "example_id": "5194d7aa-0b5f-4388-9e2b-14c08c3020fd",
                                                "sense_id": "858008d0-ca0a-39bb-af71-0840101c8517",
                                                "text": "When this conversation was repeated in detail within the hearing of the young woman in question, and undoubtedly for his benefit, Mr. Trevor threw shame to the winds and scandalized the Misses Brewster then and there by proclaiming his father to have been a country storekeeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f10882f-09b1-33aa-9103-73d0e9ec4762",
                                        "entry_id": "7f5d137d-6638-3719-a9d0-06ff8890afdd",
                                        "glosses": [
                                            "A payment made in accordance with an insurance policy or a public assistance scheme."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccd8618e-19b3-39c1-9e12-8643c7755d89",
                                        "entry_id": "7f5d137d-6638-3719-a9d0-06ff8890afdd",
                                        "glosses": [
                                            "An event, such as a theatrical performance, given to raise funds for some cause."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baa122c9-7f73-48bf-9b96-3daae8f89c12",
                                                "sense_id": "ccd8618e-19b3-39c1-9e12-8643c7755d89",
                                                "text": "Gore Vidal […] will be sharing his wit and wisdom at the Arlington Street Church on Wednesday, April 5th at 7:00. The appearance is a benefit for the Boston/Boise Committee and the tickets are priced at $5."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcc184fc-224b-3c8e-8307-b68f3216a827",
                                        "entry_id": "7f5d137d-6638-3719-a9d0-06ff8890afdd",
                                        "glosses": [
                                            "beneficence; liberality"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0650f1e5-c287-463a-a03c-b110d4745b57",
                                                "sense_id": "fcc184fc-224b-3c8e-8307-b68f3216a827",
                                                "text": "The Birds, that liue i'th field / On the vvilde Benefit of nature, liue / Happier then vve; for they may chooſe their Mates, / And carroll their ſvveet pleaſures to the Spring: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0946c7e5-c340-34a8-8941-54195d38d74b",
                                        "entry_id": "7f5d137d-6638-3719-a9d0-06ff8890afdd",
                                        "glosses": [
                                            "Intended audience (as for the benefit of)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754b1e02-1ffe-40a3-8660-c50506af9a4d",
                                                "sense_id": "0946c7e5-c340-34a8-8941-54195d38d74b",
                                                "text": "The whole scene was staged for his benefit, and it completely fooled him."
                                            },
                                            {
                                                "example_id": "b465affb-3c01-4fc0-b6d0-9fe3c587ef73",
                                                "sense_id": "0946c7e5-c340-34a8-8941-54195d38d74b",
                                                "text": "Since my wife is Canadian, whenever we have dinner with my family, they keep bringing up anything they've heard about Canada lately for her benefit."
                                            },
                                            {
                                                "example_id": "672ca6ca-9c22-41c1-95bc-e873936778c9",
                                                "sense_id": "0946c7e5-c340-34a8-8941-54195d38d74b",
                                                "text": "So, if Obodzinski is correct in saying that Mrs. Piela actually signed a document in the coffee shop, in front of witnesses, she staged a scene, pretending that it was the alleged Mandate. The other explanation is that none of this ever took place, and the staging was only a fictitious creation for the benefit of the Court."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "benefit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a571d714-c29d-32b8-87a4-cdb48e2a20db",
                                        "entry_id": "c2637482-66f1-328a-b2de-ea7c3b15a2fa",
                                        "glosses": [
                                            "To be or to provide a benefit to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cac4c75-3618-4cd4-b6e1-a2f6475badb7",
                                                "sense_id": "a571d714-c29d-32b8-87a4-cdb48e2a20db",
                                                "text": "[…] I will repent of the good; wherewith I saide I would benefite them."
                                            },
                                            {
                                                "example_id": "f534a2a2-f742-40bf-8746-2039ab913da0",
                                                "sense_id": "a571d714-c29d-32b8-87a4-cdb48e2a20db",
                                                "text": "The spending in and around local stations is creating micro-economies that are benefiting Great Britain's high streets, independent businesses and economic growth, both locally and on a national level."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63662f0d-828a-3241-a2a3-ec364fecdd6d",
                                        "entry_id": "c2637482-66f1-328a-b2de-ea7c3b15a2fa",
                                        "glosses": [
                                            "To receive a benefit (from); to be a beneficiary."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33f08014-2ca4-4f79-8746-f958dcd717b2",
                                                "sense_id": "63662f0d-828a-3241-a2a3-ec364fecdd6d",
                                                "text": "Diesel maintenance schedules are benefiting from work done on the magnificent Hilger & Watts electronic spectrograph for oil analysis, which detects minute quantities of metals in samples of used lubricating oil; [...]."
                                            },
                                            {
                                                "example_id": "d97a7b64-c383-42ee-b7b8-31e4d332d5eb",
                                                "sense_id": "63662f0d-828a-3241-a2a3-ec364fecdd6d",
                                                "text": "Although some apeirophobics have benefitted from treatments like medication and cognitive behavioral therapy, others have found no way to mitigate the existential terror."
                                            },
                                            {
                                                "example_id": "d397c8f9-2255-482c-a246-fa9d5087f257",
                                                "sense_id": "63662f0d-828a-3241-a2a3-ec364fecdd6d",
                                                "text": "Instead, the grime of the steam years which still discoloured many of the best architectural features Betjeman loved has been cleared away, and several of the stations have benefited from major refurbishments which have greatly improved them."
                                            },
                                            {
                                                "example_id": "b59e23cf-a4e4-4453-ba3f-80e700c2b4f3",
                                                "sense_id": "63662f0d-828a-3241-a2a3-ec364fecdd6d",
                                                "text": "Although Katy has admitted to being bi-curious in the past, the reason a lot of fans wanted clarity on her sexuality was to ensure she wasn't queer-baiting and benefiting from a culture she isn't actually part of."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
