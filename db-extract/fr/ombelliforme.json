                        "glosses": [
                            "En forme d’ombelle."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "a08cf58b-6c02-44e9-a55b-44a4d5c977d4",
                                "sense_id": "71803b86-ad08-3d34-bd8e-465886fc38f6",
                                "text": "OMBELLIFORME, adj., umbelliformis (umbella, ombelle, forma, forme) ; qui a la forme d’une ombelle (ex. Artemisia umbelliformis) ou d’un parapluie (ex. Helotium umbelliforme). On dit quelquefois que les fleurs sont en bouquets ombelliformes, comme celles de l’Erica ampullacea."
                            },
                            {
                                "example_id": "6e41c392-b06b-49a8-8516-a498f1d81902",
                                "sense_id": "71803b86-ad08-3d34-bd8e-465886fc38f6",
                                "text": "Fleurs en fascicule ombelliforme de couleur rose."
                            }
                        ]
                    }
                ],
