        "fr-extract.jsonl": [
            {
                "entry_id": "f3118d3d-04ea-331a-8d0e-c9cbb67c4124",
                "word": "incubation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4529d0e1-4a1a-4ca4-a444-19cb925a93b4",
                        "entry_id": "f3118d3d-04ea-331a-8d0e-c9cbb67c4124",
                        "tags": [
                            "plural"
                        ],
                        "form": "incubations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e79fe50-114d-33fc-9972-0588291a7c5f",
                        "entry_id": "f3118d3d-04ea-331a-8d0e-c9cbb67c4124",
                        "glosses": [
                            "Action des volatiles qui couvent leurs œufs, de manière à les maintenir au chaud et à permettre le développement de l'embryon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c47d402-66ab-4f68-9715-08f44ccd1bba",
                                "sense_id": "5e79fe50-114d-33fc-9972-0588291a7c5f",
                                "text": "Selon Gilles Gauthier, je pourrais y trouver quelques nids d'oies dont les œufs seraient encore en incubation, bien que la période des éclosions soit à peu près terminée."
                            },
                            {
                                "example_id": "6cd95084-c1b4-4061-905e-a98f3f1feb49",
                                "sense_id": "5e79fe50-114d-33fc-9972-0588291a7c5f",
                                "text": "L’époque de l’incubation est un temps de persécution pour une foule d’Oiseaux échassiers et nageurs."
                            },
                            {
                                "example_id": "8135a5a1-d14a-47db-8317-bd1977907975",
                                "sense_id": "5e79fe50-114d-33fc-9972-0588291a7c5f",
                                "text": "Là, en dehors du bruit et du remue-ménage de la basse-cour, dans l’isolement, l’ombre et le silence, les glousses demeuraient sagement sur leurs œufs pendant les vingt-et-un jours de l’incubation."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7aaf787-a33a-3900-870d-6742046c0cca",
                        "entry_id": "f3118d3d-04ea-331a-8d0e-c9cbb67c4124",
                        "glosses": [
                            "Action humaine qui consiste à faire incuber des œufs par des moyens artificiels."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "3d80a5bb-8665-4cb0-9a3f-988508a9aab9",
                                "sense_id": "f7aaf787-a33a-3900-870d-6742046c0cca",
                                "text": "À l'époque où commencent à pousser les feuilles du mûrier, […], on procède à l'incubation des œufs en les exposant à une température artificielle […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1f28069-2c0e-37c3-888f-983820fe556a",
                        "entry_id": "f3118d3d-04ea-331a-8d0e-c9cbb67c4124",
                        "glosses": [
                            "Passage d'une culture dans une étuve bactériologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "848e73a9-de9e-4cc7-bec2-aeeaae733545",
                                "sense_id": "d1f28069-2c0e-37c3-888f-983820fe556a",
                                "text": "Pour l’instant, nous avons quinze boîtes de Pétri en incubation."
                            },
                            {
                                "example_id": "0621339c-5bdc-4d32-8b0c-566cc9fdbd5c",
                                "sense_id": "d1f28069-2c0e-37c3-888f-983820fe556a",
                                "text": "— Les résultats de ces recherches ont démontré l'importance primordiale que revêtent, pour la consistance du yoghourt brassé, le choix de la culture et la température d’incubation."
                            }
                        ]
                    },
                    {
                        "sense_id": "68eee6d5-ff1f-38f3-818b-00a2d32d35c8",
                        "entry_id": "f3118d3d-04ea-331a-8d0e-c9cbb67c4124",
                        "glosses": [
                            "Temps qui s’écoule entre le moment où l’organisme est affecté par une cause quelconque de maladie et l’éclosion de la maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e454b2ef-d91b-4d14-8b25-b2d7067a7ae4",
                                "sense_id": "68eee6d5-ff1f-38f3-818b-00a2d32d35c8",
                                "text": "Période d’incubation."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4d0e95c-f9f9-3738-abb7-d2d303ffa175",
                        "entry_id": "f3118d3d-04ea-331a-8d0e-c9cbb67c4124",
                        "glosses": [
                            "Période de maturation entre une idée et sa concrétisation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "41ec0037-a35d-4b89-ac82-5ef99ecc4049",
                                "sense_id": "b4d0e95c-f9f9-3738-abb7-d2d303ffa175",
                                "text": "Il y a la méditation perdue qui est rêverie, et la méditation féconde qui est incubation. Le vrai penseur couve."
                            }
                        ]
                    },
                    {
                        "sense_id": "f08e3f45-ec6d-3a46-a991-c84d98ecab1a",
                        "entry_id": "f3118d3d-04ea-331a-8d0e-c9cbb67c4124",
                        "glosses": [
                            "Rituel de relation avec un dieu pour obtenir une guérison."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "4dd76c4a-3d5d-4bb1-a40c-65269d22fe72",
                                "sense_id": "f08e3f45-ec6d-3a46-a991-c84d98ecab1a",
                                "text": "Gazonal effrayé des regards d’Astaroth se précipita dans l’antichambre, après avoir salué la terrible madame Fontaine. Il était en moiteur, et comme sous l’incubation infernale du mauvais esprit."
                            },
                            {
                                "example_id": "e2cd30d2-28cf-47db-8396-afc7b09eeda3",
                                "sense_id": "f08e3f45-ec6d-3a46-a991-c84d98ecab1a",
                                "text": "Pour guérir le dernier-né de la Reine, qui souffrait d'un abcès à la gorge et qu’Hadès semblait encore une fois attirer dans ses ténèbres, le médecin Olympos avait jugé qu'il fallait prendre les grands moyens : une incubation, et à Canope."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d90122a-f8ca-4657-8375-1e404bb1c986",
                        "source_entry_id": "f3118d3d-04ea-331a-8d0e-c9cbb67c4124",
