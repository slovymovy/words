                "translations": [
                    {
                        "translation_id": "1e419e25-82f2-42cd-8638-f09a11613e7b",
                        "source_entry_id": "604e4329-8a54-3966-8505-5518645086b9",
                        "source_sense_id": "3a635164-93f8-3385-b40a-746d156b2fc3",
                        "target_lang_word": "instrumentell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instrumentell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                        "entry_id": "769d74cd-1db6-3f2b-81ca-288d75ec3717",
                                        "glosses": [
                                            "als Werkzeug oder Mittel dienend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1e4047f-8f14-4283-924b-1edd4d7ca204",
                                                "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                                "text": "„Dies bedeutet schließlich, daß die Rechtsstruktur einer jeden Gesellschaft nur so instrumentell ist, wie dies seine normativsten Elemente zulassen und, allerdings zu einem geringeren Grad, nur so normativ, wie seine instrumentellsten Strukturelemente zulassen.“"
                                            },
                                            {
                                                "example_id": "be4875f7-873e-42fa-a243-cd7e2553f5ed",
                                                "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                                "text": "„Es ist verständlich, dass diese Romane heute zu neuen Lesern finden – aber die Literatur ist keine Wahrsagerin, und sie hilft auch nicht auf die simple, instrumentelle Weise, die man sich dieser Tage vielleicht erhofft.“"
                                            },
                                            {
                                                "example_id": "d1807b7b-87eb-4849-9bd5-7a760cba8013",
                                                "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                                "text": "„Eine kluge instrumentelle Praxis hat gewiß auch Argumente für sich.“"
                                            },
                                            {
                                                "example_id": "459a829b-4141-436e-9e64-8ddd4532dfbc",
                                                "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                                "text": "„Logisch lassen sich dabei zwei Typen von Themen unterscheiden: - instrumentelle Praxis und - reflexive Praxis.“"
                                            },
                                            {
                                                "example_id": "c94fef22-8d5c-4204-93d0-cdf9a88e025b",
                                                "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                                "text": "„In der betrieblichen Praxis sind sowohl die instrumentelle als auch die institutionelle Sichtweise gleichermaßen von Bedeutung.“"
                                            },
                                            {
                                                "example_id": "9fe3b938-9960-417c-9cca-c17615512543",
                                                "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                                "text": "„Da die instrumentelle Sichtweise bisher tendenziell eher vernachlässigt wurde […], liegt der Forschungsfokus auf deren Darstellung und Verbindung mit der institutionellen Sichtweise.“"
                                            },
                                            {
                                                "example_id": "e10f819c-cd87-4de3-88c9-574149cfe969",
                                                "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                                "text": "„In der Analyse und Diskussion der Nutzungsarten des Controllings nach SIMONS dominiert bisher die instrumentelle Sichtweise.“"
                                            },
                                            {
                                                "example_id": "3bbfca8a-a518-4fca-bdd1-81b1f0eafb85",
                                                "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                                "text": "„Nach Weber ist der Tausch auf Märkten deswegen außergewöhnlich, weil es die instrumentellste und kalkulierendste Art des sozialen Handelns zwischen zwei Individuen ist.“"
                                            },
                                            {
                                                "example_id": "68a2c305-23e0-442b-a92f-eab4de03601e",
                                                "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                                "text": "„Technisch vermittelte Tätigkeiten im industriellen Produktionsprozeß werden dem Funktionskreis instrumentellen Handelns zugeordnet.“"
                                            },
                                            {
                                                "example_id": "dc3075c6-671f-458c-ba1c-bfdc16af028c",
                                                "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                                "text": "„Instrumentelles Handeln ist der Paradefall des modernen, in die Welt eingreifenden, planvollen und subjektiven Verständnisses der Handlung.“"
                                            },
                                            {
                                                "example_id": "b9f5b4a8-0342-41e9-8c11-aa6c97de5bd9",
                                                "sense_id": "5465efca-8d0d-34c7-b1e0-5a07718cf389",
                                                "text": "„Aber auch die Haltung gegenüber der Gewerkschaft habe viel instrumentellere Züge angenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "835ecff7-daed-30e6-8e2f-8d8c0fd9bbfc",
                                        "entry_id": "769d74cd-1db6-3f2b-81ca-288d75ec3717",
                                        "glosses": [
                                            "Musik abseits der menschlichen Stimme betreffend"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35f3589f-38ab-4a91-9cfe-0a6d9a910ffb",
                                                "sense_id": "835ecff7-daed-30e6-8e2f-8d8c0fd9bbfc",
                                                "text": "„Aber auch die instrumentelle Vielfalt hat ihren Reiz, wenn Violinist Sebastian Schlecht mit der Loop-Station zu ‚Look Inside‘ sein eigenes Streichorchester baut oder Ian Hoopers rauchige Stimme sich durchdringend über verspielte Gitarren-Melodien und Mandolinen-Klänge erhebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe7a367b-b18d-4d63-9da7-182383807b9c",
                        "source_entry_id": "604e4329-8a54-3966-8505-5518645086b9",
