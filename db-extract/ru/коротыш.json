                                "target_senses": [
                                    {
                                        "sense_id": "f03f7e2d-0567-31f1-bb9f-74ae7849973a",
                                        "entry_id": "ab952c9c-bcdb-3187-b847-ddb822f90526",
                                        "glosses": [
                                            "Fat; thick; plump; bulky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9312839-68b8-4e13-b233-3b5b82a34fd2",
                                                "sense_id": "f03f7e2d-0567-31f1-bb9f-74ae7849973a",
                                                "text": "Nor the squab daughter nor the wife were nice."
                                            },
                                            {
                                                "example_id": "37b946be-0e06-465f-8d89-c78e441e80b6",
                                                "sense_id": "f03f7e2d-0567-31f1-bb9f-74ae7849973a",
                                                "text": "So on his Nightmare through the evening fog / Flits the squab fiend o'er fen, and lake, and bog […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62a3fcb5-97c5-3008-9c27-451e7cd4134e",
                                        "entry_id": "ab952c9c-bcdb-3187-b847-ddb822f90526",
                                        "glosses": [
                                            "Unfledged; unfeathered."
                                        ],
                                        "tags": [],
                                        "examples": [
