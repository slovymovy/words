                        "examples": [
                            {
                                "example_id": "1be9763d-77ee-458e-8ed0-f054ce007d82",
                                "sense_id": "31189c0e-d1a6-35e5-b828-648185f74d03",
                                "text": "Недавно в Газе побывала министр экономики Голландии Ивонн ван Рой."
                            },
                            {
                                "example_id": "eb2218ad-8859-4b33-8fd5-a990ce3b287d",
                                "sense_id": "31189c0e-d1a6-35e5-b828-648185f74d03",
                                "text": "Нажми её и, когда войдет мадемуазель Ивонн, закажи себе завтрак."
                            }
                        ]
                    }
                ],
