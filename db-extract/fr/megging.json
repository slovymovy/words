                "senses": [
                    {
                        "sense_id": "dead0a44-155b-306b-b524-4978bf648e17",
                        "entry_id": "7c6c1619-dd9d-3bd9-80fa-57c806e95315",
                        "glosses": [
                            "Caleçon masculin long et moulant fabriqué à partir de coton élasthanne ou mélangé, viscose ou polyester. Le megging est porté comme un pantalon classique ou avec un short ou bermuda, souvent assortis d'un top oversize, une chemise longue ou un tee-shirt long."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc8e51b-6cf0-4c1f-94fd-c695b75fbded",
                                "sense_id": "dead0a44-155b-306b-b524-4978bf648e17",
                                "text": "A enfiler sous un costume pour affiner la silhouette, ou simplement pour vous tenir chaud, le collant [megging] peut également devenir un véritable accessoire de mode si vous choisissez le motif adéquat."
                            },
                            {
                                "example_id": "20a68ff6-0ee1-452f-b2ba-4ff72d026dea",
                                "sense_id": "dead0a44-155b-306b-b524-4978bf648e17",
                                "text": "...de plus en plus de mecs portent des jeans moulants, du fait qu'on en trouve plus facilement (Zara, Topman, Asos, Pull and Bear), on trouve aussi pas mal de meggings ou leggings pour homme, ça commence à prendre."
                            }
                        ]
                    }
                ],
