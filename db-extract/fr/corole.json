                                "sense_id": "f3980ef8-b6f3-3eaf-8a1c-1db3d70dfde4",
                                "text": "Les pétales d’une corole."
                            },
                            {
                                "example_id": "bdad23fb-b91e-4ae0-b866-86383419a79f",
                                "sense_id": "f3980ef8-b6f3-3eaf-8a1c-1db3d70dfde4",
                                "text": "Corole monopétale, polypétale."
                            },
