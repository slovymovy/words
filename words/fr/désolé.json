                    "sense_id": "fbe3a47a-d762-349e-8196-c7c4c8c9725d",
                    "sense_definition": "Participe passé masculin singulier de <w>désoler</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette situation difficile a beaucoup <w>désolé</w> tous les membres de l'équipe."
