                                                "sense_id": "f9a1f631-29bf-348e-9bb6-55283a4f8b2d",
                                                "text": "Pour the tea into the cup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2959d9e-6f66-3d50-9050-49b0800a3805",
