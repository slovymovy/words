                                        "sense_id": "63e907af-47c7-39c7-92b3-912c1b19b258",
                                        "entry_id": "3fc5c728-aaf3-3634-b920-a21b4d0d7d53",
                                        "glosses": [
                                            "In accordance with what is right or just."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e34e387a-a691-4326-8865-558c95bf6a60",
                                                "sense_id": "63e907af-47c7-39c7-92b3-912c1b19b258",
                                                "text": "Near-synonym: fairly"
                                            },
                                            {
                                                "example_id": "1f7cc6ec-297e-4647-a46d-b2ec542b688d",
                                                "sense_id": "63e907af-47c7-39c7-92b3-912c1b19b258",
                                                "text": "[T]he only purpose for which power can be rightfully exercised over any member of a civilized community, against his will, is to prevent harm to others. His own good, either physical or moral, is not a sufficient warrant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4fdc9a5-1479-3442-9db6-de7ea208dff6",
                                        "entry_id": "3fc5c728-aaf3-3634-b920-a21b4d0d7d53",
                                        "glosses": [
                                            "Rightly, correctly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f425ce6b-7826-447a-b11e-a0dee84ada9e",
                                                "sense_id": "a4fdc9a5-1479-3442-9db6-de7ea208dff6",
                                                "text": "Ne euer will it [King Arthur's sword] breake, ne euer bend. / Wherefore Morddure it rightfully is hight."
                                            }
                                        ]
                                    }
                                ]
