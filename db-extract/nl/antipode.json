                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antipode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed78eb35-d742-3ddf-9596-2077614feb07",
                                        "entry_id": "8efa0e8e-6313-37bf-bc6d-8e670168f8eb",
                                        "glosses": [
                                            "Something directly opposite or diametrically opposed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38f0c5d9-fc47-4c96-a4c3-2b475c7eaa2e",
                                                "sense_id": "ed78eb35-d742-3ddf-9596-2077614feb07",
                                                "text": "The very Reverse of a Wit. The Antipode of Sense."
                                            },
                                            {
                                                "example_id": "d19a241e-6635-47ab-9621-ba9daa02ea66",
                                                "sense_id": "ed78eb35-d742-3ddf-9596-2077614feb07",
                                                "text": "In many ways, Memphis was the antipode of Boston."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
