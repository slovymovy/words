                    }
                ],
                "translations": [
                    {
                        "translation_id": "0186d5a7-9eff-482f-a1ee-5ce9d27391a1",
                        "source_entry_id": "0dfe2eb8-77a5-324b-88eb-cf3ddf9b778e",
                        "source_sense_id": "93cd87e3-b8aa-3572-8be7-4eb701edaab3",
                        "target_lang_word": "dynamite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynamite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "492f7859-746e-3ba9-a5d5-30b359fbd24f",
                                        "entry_id": "d01eb9ed-2807-37d0-a2dc-5d4cdad0d7ba",
                                        "glosses": [
                                            "A class of explosives made from nitroglycerine in an absorbent medium such as kieselguhr, used in mining and blasting."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f235744f-7359-3b3c-9120-0b2a822808a4",
                                        "entry_id": "d01eb9ed-2807-37d0-a2dc-5d4cdad0d7ba",
                                        "glosses": [
                                            "A stick of trinitrotoluene (TNT)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "proscribed",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73a8b4a6-7ce3-3c53-b203-72cb4dcc4ea8",
                                        "entry_id": "d01eb9ed-2807-37d0-a2dc-5d4cdad0d7ba",
                                        "glosses": [
                                            "Anything exceptionally dangerous, exciting or wonderful."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b8f3368-d221-4b90-af41-edb56ad98b72",
                                                "sense_id": "73a8b4a6-7ce3-3c53-b203-72cb4dcc4ea8",
                                                "text": "Even though sometimes I take differing views from some articles and letters in GCN, I think it's a dynamite piece of work. Good luck and thanks again."
                                            },
                                            {
                                                "example_id": "87ca0461-31f8-44a0-bb24-dd7c15fc893b",
                                                "sense_id": "73a8b4a6-7ce3-3c53-b203-72cb4dcc4ea8",
                                                "text": "And your shoulders are frozen (Cold as the night) / Oh, but you're an explosion (You're dynamite)"
                                            },
                                            {
                                                "example_id": "37f14ee2-15c0-48d0-af5e-8bee0d14f994",
                                                "sense_id": "73a8b4a6-7ce3-3c53-b203-72cb4dcc4ea8",
                                                "text": "That girl was dynamite. Dark hair with killer blue eyes, bronze skin, and an exquisite full-figured body.\nHe warned us: \"That issue about what's been happening at that factory, is political dynamite. Keep the lid on it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1227136-bc09-33a3-a548-6305720f1408",
                                        "entry_id": "d01eb9ed-2807-37d0-a2dc-5d4cdad0d7ba",
                                        "glosses": [
                                            "A strong drug, in particular heroin, cocaine or potent marijuana."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dynamite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63c32cec-8d4c-3339-8b57-f294e4175536",
                                        "entry_id": "bf61774f-db56-38dd-b6ef-efbd550abb46",
                                        "glosses": [
                                            "To blow up with dynamite or other high explosive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d17c2442-19b4-48ac-a389-dee320ec9256",
                                                "sense_id": "63c32cec-8d4c-3339-8b57-f294e4175536",
                                                "text": "Gradually the construction gangs cut and dynamited their way through some of the most difficult country in the world."
                                            },
                                            {
                                                "example_id": "c76a6821-ab16-4764-9440-3ff9ddfab195",
                                                "sense_id": "63c32cec-8d4c-3339-8b57-f294e4175536",
                                                "text": "[...] on Sunday, August 23, the L.N.W.R. tunnel was closed to enable the old brickwork to be dynamited away, traffic being diverted meanwhile through the M.R. tunnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c1ea605-e355-33df-9b67-6b46191805e5",
                                        "entry_id": "bf61774f-db56-38dd-b6ef-efbd550abb46",
                                        "glosses": [
                                            "To dismantle or destroy."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57a8577c-7b98-4651-acfa-2d780d75dde5",
                                                "sense_id": "9c1ea605-e355-33df-9b67-6b46191805e5",
                                                "text": "Even the successful battle in the last century to overturn the court’s infamous Plessy vs. Ferguson “separate but equal” doctrine wasn’t a frontal assault that dynamited precedent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e6eee23-ac5b-3bcc-b149-e8196374d1db",
                                        "entry_id": "bf61774f-db56-38dd-b6ef-efbd550abb46",
                                        "glosses": [
                                            "To apply maximum pressure to very quickly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "585d8bc4-88e5-43bb-a9a2-65d3c2a5dd7d",
                                                "sense_id": "2e6eee23-ac5b-3bcc-b149-e8196374d1db",
                                                "text": "Juan dynamited the brakes and the car skidded to a halt."
                                            },
                                            {
                                                "example_id": "8de69beb-5342-4d7f-a2a4-f3d7bc91e372",
                                                "sense_id": "2e6eee23-ac5b-3bcc-b149-e8196374d1db",
                                                "text": "dynamite the brakes"
                                            },
                                            {
                                                "example_id": "82d2d743-ddbf-400f-bf7c-367eb3ec35b1",
                                                "sense_id": "2e6eee23-ac5b-3bcc-b149-e8196374d1db",
                                                "text": "The 1977 Pontiacs had a tendency of dying if you were at high speed and dynamited the brakes."
                                            },
                                            {
                                                "example_id": "05dae6d3-1be3-4bda-8138-53cd00ace7e5",
                                                "sense_id": "2e6eee23-ac5b-3bcc-b149-e8196374d1db",
                                                "text": "At the critical moment I'd learned from countless action flicks I dynamited the brakes and felt the impact of the sedan against my rear bumper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d5ab3b-28a2-3d7a-afa5-22b0f77e1c6a",
                                        "entry_id": "bf61774f-db56-38dd-b6ef-efbd550abb46",
                                        "glosses": [
                                            "To lock up from being invoked too suddenly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaa93e45-24b1-4671-82f8-4d7c5c2e4f77",
                                                "sense_id": "93d5ab3b-28a2-3d7a-afa5-22b0f77e1c6a",
                                                "text": "the brakes will dynamite"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "962368f5-709a-486c-a508-66a3f18ae240",
                        "source_entry_id": "0dfe2eb8-77a5-324b-88eb-cf3ddf9b778e",
