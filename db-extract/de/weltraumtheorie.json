                "senses": [
                    {
                        "sense_id": "a7f3fb7b-b58d-3fd2-b19f-ed557d6109b1",
                        "entry_id": "e2888615-5647-35bf-a7b6-dc30eba6be6d",
                        "glosses": [
                            "Konzept, nach dem nationale Gesetze nur in nationalem Hoheitsgebiet gelten, nicht aber beispielsweise im Weltraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e9b83c-3fc3-4fad-9ac1-00aae2381c43",
                                "sense_id": "a7f3fb7b-b58d-3fd2-b19f-ed557d6109b1",
                                "text": "„Regierung will Weltraumtheorie in Gesetz übertragen.“"
                            },
                            {
                                "example_id": "8b42a0a4-7d8c-478c-ac55-1c0698b943eb",
                                "sense_id": "a7f3fb7b-b58d-3fd2-b19f-ed557d6109b1",
                                "text": "„Er soll den Ausschussmitgliedern in diesem Zusammenhang einige heikle Fragen beantworten. Eine lautet, was es mit der Weltraumtheorie auf sich hat.“"
                            },
                            {
                                "example_id": "610861e4-5a24-4a8b-ac29-de06eda5b155",
                                "sense_id": "a7f3fb7b-b58d-3fd2-b19f-ed557d6109b1",
                                "text": "„Diese BND-intern als ‚Weltraumtheorie‘ bezeichnete Rechtfertigung wurde im NSA-Untersuchungsausschuss bei der Befragung der Datenschutzbeauftragten des Geheimdienstes bekannt und von Opposition, Datenschützern und Verfassungsrechtlern wiederholt kritisiert.“"
                            },
                            {
                                "example_id": "8f9f1fe8-2d8a-4b76-89b9-1aae5fddea40",
                                "sense_id": "a7f3fb7b-b58d-3fd2-b19f-ed557d6109b1",
                                "text": "„Die vollständige und uneingeschränkte Erfassung von Daten durch den BND, die sich hinter dem Namen Weltraumtheorie verberge, werde auch durch ein neues Gesetz nicht verfassungskonform.“"
                            },
                            {
                                "example_id": "0a0cd61b-de9e-4bab-a0f4-05fafdb87578",
                                "sense_id": "a7f3fb7b-b58d-3fd2-b19f-ed557d6109b1",
                                "text": "„Der BND vertritt die Ansicht, dass die deutschen Gesetze nicht im Ausland gelten und Satelliten im rechtsfreien Raum abgeschöpft werden dürfen. Sie nennen es ‚Weltraumtheorie‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
