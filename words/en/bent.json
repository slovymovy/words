                {
                    "sense_id": "86b4897c-43c4-3f03-b9df-8447363528d3",
                    "sense_definition": "The past tense and past participle of <w>bend</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>bent</w> down to tie his shoelaces.",
                            "target_lang_translations": {
                                "ru": "Он <w>наклонился</w>, чтобы завязать шнурки.",
                                "pl": "On <w>schylił się</w>, aby zawiązać sznurowadła.",
                                "zh": "他<w>弯下腰</w>系鞋带。"
                            }
                        },
                        {
                            "text": "The trees <w>bent</w> under the weight of the heavy snow.",
                            "target_lang_translations": {
                                "ru": "Деревья <w>согнулись</w> под тяжестью снега.",
                                "pl": "Drzewa <w>ugięły się</w> pod ciężarem ciężkiego śniegu.",
                                "zh": "树木被大雪压得<w>弯曲</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
