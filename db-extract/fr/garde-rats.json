                    {
                        "sense_id": "ca3a032e-c08f-35dc-9378-6ff6c47509ff",
                        "entry_id": "d30868be-7b65-38ed-84f7-f537c1367b0f",
                        "glosses": [
                            "Dispositif (disque, cône...) en tôle ou en bois enfilé sur les amarres d’un navire servant à empêcher les rats et autres rongeurs de s’infiltrer à bord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3860e358-fc06-4d93-8804-4e22289a8895",
                                "sense_id": "ca3a032e-c08f-35dc-9378-6ff6c47509ff",
                                "text": "Malgré leurs certificats en règle, les garde-rats bien en place sur les amarres, des inspecteurs montent à bord, fouinent dans les cales, à la machine, dans les magasins, à la recherche de la moindre crotte, tandis que sur les quais grouillent des bêtes, grosses comme des lièvres."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cb15917-ad08-3673-a0ef-e0056cec3c36",
                        "entry_id": "d30868be-7b65-38ed-84f7-f537c1367b0f",
                        "glosses": [
                            "Dispositif semblable pour un même but dans d’autres usages."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "d3f40a9d-97d9-4fd4-82ed-fc0b9004ebd0",
                                "sense_id": "4cb15917-ad08-3673-a0ef-e0056cec3c36",
                                "text": "Garde-rats : Il faut les placer le plus haut possible sur chaque montant, afin d'empêcher les rongeurs de pénétrer dans le crib en grimpant sur les montants. Les garde-rats peuvent être fabriqués avec de vieilles boîtes à huile ou de simples tôles galvanisées de 30."
                            },
                            {
                                "example_id": "2e9bbe32-4b86-4a31-835c-7dd7135e9dc9",
                                "sense_id": "4cb15917-ad08-3673-a0ef-e0056cec3c36",
                                "text": "Même l’utilisation de silos de fabrication locale améliorée, munis de garde-rats faits de grillage de basse-cour recouvert de boue, ou mieux de ciment, pourrait apporter une amélioration considérable à la conservation des récoltes."
                            }
                        ]
                    }
