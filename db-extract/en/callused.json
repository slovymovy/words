                    {
                        "translation_id": "d719df48-1823-42d1-84cb-4d0428b560e4",
                        "source_entry_id": "4c933b91-f26f-3036-834e-eb654c2afba7",
                        "source_sense_id": "08558f69-ed0e-34b4-abf0-9ed3f2ac588b",
                        "source_sense_description": "having calluses",
                        "target_lang_word": "calleux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calleux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9e327e2-b58f-3cba-9fa8-1092defb4eed",
                                        "entry_id": "a096aa28-e82c-3294-a092-01c1eb146081",
                                        "glosses": [
                                            "Qui présente des cals, des callosités sur la peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cde04c16-789e-4e66-b74d-3859ef33335e",
                                                "sense_id": "f9e327e2-b58f-3cba-9fa8-1092defb4eed",
                                                "text": "Merci à mon tour pour ce que vous dites de mon fils, Belhumeur, répondit la vieille dame en serrant la main calleuse du chasseur."
                                            },
                                            {
                                                "example_id": "88ae0c3b-02e5-4c2e-a8e9-78382bcc47b9",
                                                "sense_id": "f9e327e2-b58f-3cba-9fa8-1092defb4eed",
                                                "text": "Le vieux garde rapprochait sa chaise de la cheminée où croulaient des tisons ardents, il se rôtissait les jambes, et passant dans la flamme ses mains calleuses, il les frottait d’un air de satisfaction."
                                            },
                                            {
                                                "example_id": "3894a370-ca7c-4af3-a1f8-a31effc6fc57",
                                                "sense_id": "f9e327e2-b58f-3cba-9fa8-1092defb4eed",
                                                "text": "De tous les pays circonvoisins, des campagnes et des villes, malades et infirmes, paralytiques, culs-de-jatte et pieds-bots accouraient dans des carrioles, dans des calèches, sur des ânes, sur leurs moignons calleux."
                                            },
                                            {
                                                "example_id": "0cee2553-519d-4871-a009-55a95c8aafc0",
                                                "sense_id": "f9e327e2-b58f-3cba-9fa8-1092defb4eed",
                                                "text": "Les boucles épaisses et brunes de ses cheveux étaient raides et incultes, ses moustaches faisaient un crochet sauvage sur ses joues, et ses mains étaient calleuses et noires comme celles d’un valet de ferme ordinaire ; et pourtant son attitude était libre, presque hautaine, et il ne montrait rien de l’assiduité d’un domestique auprès de la dame de la maison."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
