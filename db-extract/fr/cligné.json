                "senses": [
                    {
                        "sense_id": "a348f4d0-4462-3174-941a-29a7b37e253c",
                        "entry_id": "f8654c80-2ed8-395a-91ce-d12829ce14d3",
                        "glosses": [
                            "Dont les yeux sont mi-clos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2b7abf9-02a3-42df-89cf-63e8280a4111",
                                "sense_id": "a348f4d0-4462-3174-941a-29a7b37e253c",
                                "text": "La mère tournait autour du coupable à petits pas, les yeux clignés, comme s’il se fût agi d’un essayage."
                            },
                            {
                                "example_id": "7408d9ba-a0ad-4f7a-a4e8-211f57bd7f88",
                                "sense_id": "a348f4d0-4462-3174-941a-29a7b37e253c",
                                "text": "Un œil cligné par l’habitude de la cigarette, elle jouait du piano sur le bord de la table."
                            },
                            {
                                "example_id": "fef04ed9-f7cf-4132-a1b2-1d8377abe69d",
                                "sense_id": "a348f4d0-4462-3174-941a-29a7b37e253c",
                                "text": "Fabrizio me posa la main sur l’épaule et fixa la forteresse en la jaugeant de ses yeux clignés, d’un air possessif et compétent."
                            },
                            {
                                "example_id": "13b77c0a-4b1c-47b5-bbef-a7cd75abc7e2",
                                "sense_id": "a348f4d0-4462-3174-941a-29a7b37e253c",
                                "text": "Les paupières clignées à cause de la réverbération brutale de la mer, Philippe regardait ce corps avec l’espoir d’une émotion, si petite fût-elle."
                            }
                        ]
                    }
                ],
