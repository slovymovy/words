{
    "word_family": [
        "infection",
        "infectious",
        "infective",
        "disinfect",
        "disinfectant",
        "reinfect",
        "uninfected"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33c234f4-8334-34e2-ad32-2e97b12a5180",
                    "sense_definition": "To pass a disease-causing organism to a person or animal, causing them to become ill.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "biological_infection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The virus can <w>infect</w> humans through direct contact with contaminated surfaces.",
                            "target_lang_translations": {
                                "ru": "Вирус может <w>заражать</w> людей через прямой контакт с загрязненными поверхностями."
                            }
                        },
                        {
                            "text": "Doctors are worried that the new flu strain might <w>infect</w> many people this winter.",
                            "target_lang_translations": {
                                "ru": "Врачи обеспокоены тем, что новый штамм гриппа может <w>заразить</w> много людей этой зимой."
                            }
                        }
                    ],
                    "antonyms": [
                        "disinfect"
                    ],
                    "common_phrases": [
                        "infect many people",
                        "infect the host"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать болезнетворные организмы человеку или животному, вызывая заболевание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заражать",
                                "target_lang_sense_clarification": "передавать инфекцию"
                            },
                            {
                                "target_lang_word": "заразить",
                                "target_lang_sense_clarification": "передать инфекцию (совершенный вид)"
                            },
                            {
                                "target_lang_word": "инфицировать",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0ed495f-fb8c-30d3-b13c-900a7a4c38ed",
                    "sense_definition": "To spread a feeling, emotion, or attitude to other people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_spread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her cheerful laughter began to <w>infect</w> everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Ее веселый смех начал <w>заражать</w> всех в комнате."
                            }
                        },
                        {
                            "text": "His enthusiasm for the project started to <w>infect</w> the whole team.",
                            "target_lang_translations": {
                                "ru": "Его энтузиазм по поводу проекта начал <w>заражать</w> всю команду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "infect with enthusiasm",
                        "infect with laughter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространять чувство, эмоцию или отношение на других людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заражать",
                                "target_lang_sense_clarification": "передавать эмоции"
                            },
                            {
                                "target_lang_word": "заразить",
                                "target_lang_sense_clarification": "передать эмоции (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fd1f2bf-e817-363a-ab1f-7163f5edc1b3",
                    "sense_definition": "To contaminate an object, area, or substance with harmful bacteria or a virus.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_infection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bacteria from the raw meat can <w>infect</w> the entire kitchen counter if not cleaned.",
                            "target_lang_translations": {
                                "ru": "Бактерии из сырого мяса могут <w>заразить</w> всю кухонную столешницу, если ее не помыть."
                            }
                        },
                        {
                            "text": "The waste from the factory could <w>infect</w> the local water supply.",
                            "target_lang_translations": {
                                "ru": "Отходы завода могут <w>заразить</w> местный водопровод."
                            }
                        }
                    ],
                    "antonyms": [
                        "disinfect"
                    ],
                    "common_phrases": [
                        "infect the wound",
                        "infect the water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Загрязнять предмет, территорию или вещество вредными бактериями или вирусом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заражать",
                                "target_lang_sense_clarification": "о среде или ране"
                            },
                            {
                                "target_lang_word": "инфицировать",
                                "target_lang_sense_clarification": "вносить инфекцию"
                            },
                            {
                                "target_lang_word": "загрязнять",
                                "target_lang_sense_clarification": "делать нечистым"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "39db211c-cdb3-39ec-8c1b-444d0199b3d3",
                    "sense_definition": "An archaic or poetic form meaning <w>infected</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old play, the author writes that many souls are <w>infect</w> by the same greed.",
                            "target_lang_translations": {
                                "ru": "В старой пьесе автор пишет, что многие души <w>заражены</w> той же жадностью."
                            }
                        },
                        {
                            "text": "The ancient text describes a city where the air itself was <w>infect</w>.",
                            "target_lang_translations": {
                                "ru": "Древний текст описывает город, где сам воздух был <w>заражен</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичная или поэтическая форма, означающая «зараженный»."
                    },
                    "translations": {
                        "ru": [
