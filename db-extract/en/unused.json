                                            {
                                                "example_id": "ff2c4b3e-6f59-413a-a5b6-52b619eec132",
                                                "sense_id": "f4473116-817b-3082-9581-674f0266b9d9",
                                                "text": "Su último eslogan tuvo un éxito inusitado en las redes sociales."
                                            },
                                            {
                                                "example_id": "240f6114-c261-4122-ab7f-4fa9277c97c6",
                                                "sense_id": "f4473116-817b-3082-9581-674f0266b9d9",
                                                "text": "Era curioso, pero la sensación de que mi mente había trabajado con un rigor férreo me daba una energía inusitada: me sentía fuerte, estaba poseído por una decisión viril y dispuse de todo."
                                            }
                                        ],
