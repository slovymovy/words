                                "target_senses": [
                                    {
                                        "sense_id": "5c0ca7e8-c680-3fa1-8e02-eaf687138cdf",
                                        "entry_id": "677c76f1-7e3a-3a99-b7af-b831acb62a19",
                                        "glosses": [
                                            "Séparation entre deux régions, deux zones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387bbdf5-7664-4820-9ed1-05a7abe517d7",
                                                "sense_id": "5c0ca7e8-c680-3fa1-8e02-eaf687138cdf",
                                                "text": "Les lignes de démarcation durant la guerre comme la lame d'un couteau sur la meule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5eb3373-392c-3b84-b2ab-ac038c3be15f",
                                        "entry_id": "677c76f1-7e3a-3a99-b7af-b831acb62a19",
                                        "glosses": [
                                            "Délimitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c434f03f-457b-4604-ade3-13fc69e2fba7",
                                                "sense_id": "a5eb3373-392c-3b84-b2ab-ac038c3be15f",
                                                "text": "Enfin, j'ai trouvé des laitiers de hauts fourneaux, en partie vitreux et en partie clivables, mais offrant toujours une démarcation tranchée entre la partie cristalline et la partie translucide."
                                            },
                                            {
                                                "example_id": "7a781037-fd59-41c0-933c-ad0d1f365bb8",
                                                "sense_id": "a5eb3373-392c-3b84-b2ab-ac038c3be15f",
                                                "text": "Etant donné qu’elle a été promulguée le 24 mars 2000, la démarcation des terres aurait dû être réalisée au plus tard le 23 mars 2002."
                                            }
                                        ]
                                    }
                                ]
