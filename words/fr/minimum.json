            "senses": [
                {
                    "sense_id": "57cc130e-5508-3503-b64f-27eaf1aa4748",
                    "sense_definition": "Qui correspond à la limite inférieure, à la valeur la plus basse possible ou exigée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "valeur_limite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'âge <w>minimum</w> requis pour passer le permis de conduire est fixé par la loi."
                        },
                        {
                            "text": "En période de grève, les transports publics doivent assurer un service <w>minimum</w> pour les usagers."
