                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ab7e6f-5abc-49d5-929a-226ab8bd0a4d",
                                                "sense_id": "8c036418-b401-34d6-a108-17bf111f80aa",
                                                "text": "„Auf jeden Fall hätte das Fluchen die Großmutter in meinem Ansehen steigen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c8142ce-1601-399d-b788-6dfd09f24df9",
                                        "entry_id": "f10f2d56-2ebd-3c6d-bed1-6a1e21a4a7b9",
                                        "glosses": [
                                            "Handlung, seinen Ärger/Zorn heftig zu äußern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f891c5a7-cc4a-468e-b3f6-529e38d40044",
                                                "sense_id": "9c8142ce-1601-399d-b788-6dfd09f24df9",
                                                "text": "Sein Fluchen über dieses Missgeschick erregte bei den anderen Anstoß."
