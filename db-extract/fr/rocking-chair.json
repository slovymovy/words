        "fr-extract.jsonl": [
            {
                "entry_id": "c962dc60-3833-3c5c-b511-ea3518d0a089",
                "word": "rocking-chair",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d61f9745-32f4-4aeb-9175-1be8e03a2313",
                        "entry_id": "c962dc60-3833-3c5c-b511-ea3518d0a089",
                        "tags": [
                            "plural"
                        ],
                        "form": "rocking-chairs"
                    },
                    {
                        "form_id": "e425ccd3-8e1e-49ea-afdc-5740e6337385",
                        "entry_id": "c962dc60-3833-3c5c-b511-ea3518d0a089",
                        "tags": [],
                        "form": "rocking chair"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9261bb42-04a2-345c-9a16-b38db23fdfa2",
                        "entry_id": "c962dc60-3833-3c5c-b511-ea3518d0a089",
                        "glosses": [
                            "Chaise ou fauteuil qui comporte sous les pieds des pièces de bois courbes, qui permettent le balancement d’avant en arrière."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "3d0674df-f122-46c4-a1e1-27b2c239eb55",
                                "sense_id": "9261bb42-04a2-345c-9a16-b38db23fdfa2",
                                "text": "Et elle regardait aussi Velmont qui se balançait paisiblement dans un confortable rocking-chair."
                            },
                            {
                                "example_id": "05bdb394-cd67-4163-8e52-353c4ab65cbe",
                                "sense_id": "9261bb42-04a2-345c-9a16-b38db23fdfa2",
                                "text": "En bas, une vaste pièce, qu’on meublerait de fauteuils en cuir semblables à celui que j’occupais, d’un fauteuil à bascule – je me rappelais son goût pour les rocking-chairs, – d’une table…"
                            },
                            {
                                "example_id": "7bdb265e-bcd5-48ee-8ce3-28a30803a340",
                                "sense_id": "9261bb42-04a2-345c-9a16-b38db23fdfa2",
                                "text": "Je me retrouvai enfin dans un bureau un peu mieux aménagé, où il y avait quand même un ventilateur, des rocking-chairs en rotin et, sur une table basse, quelques fioles carrées de whisky et de brandy."
                            },
                            {
                                "example_id": "6372f507-7e96-48aa-b571-bbea2cf55c48",
                                "sense_id": "9261bb42-04a2-345c-9a16-b38db23fdfa2",
                                "text": "Et comme Isabelle prend enfin sur elle de lever la tête et de regarder autour d’elle, il fait pivoter son rocking-chair."
                            }
                        ]
                    },
                    {
                        "sense_id": "203874e3-3d81-34f1-b18d-e96cc7138ed9",
                        "entry_id": "c962dc60-3833-3c5c-b511-ea3518d0a089",
                        "glosses": [
                            "Emploi au féminin."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c03f6eac-d970-41c2-adcd-b87f0b5c5067",
                                "sense_id": "203874e3-3d81-34f1-b18d-e96cc7138ed9",
                                "text": "Ma table est un guéridon de jeu, ma chaise une fumeuse, et mon fauteuil une rocking-chair en osier quelque peu détraquée ; si l’on ne s’assied pas juste au milieu, elle se déforme, gémit et fuit tout d’un côté ; on peut jouir à la fois du roulis et du tangage sur ce fauteuil ; pour se remettre, on peut faire du cheval sur la chaise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7ed8900-cb74-440a-abd2-bca49f6e5164",
                        "source_entry_id": "c962dc60-3833-3c5c-b511-ea3518d0a089",
                        "target_lang_word": "Schaukelstuhl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schaukelstuhl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96041e14-e4c1-3846-8d4f-d6018ec5bdbb",
                                        "entry_id": "a3ed5ef5-ecc9-30fb-a55c-cb32302ede5c",
                                        "glosses": [
                                            "Stuhl, der auf gebogenen Kufen steht und dadurch zum Schaukeln gebracht werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e76e072-f9bb-468e-bed7-bdbbd1aefcf4",
                                                "sense_id": "96041e14-e4c1-3846-8d4f-d6018ec5bdbb",
                                                "text": "Mein Opa sitzt gerne im Schaukelstuhl."
                                            },
                                            {
                                                "example_id": "3bcb6f74-adb3-4c8d-a9ba-3ae2e6b22e82",
                                                "sense_id": "96041e14-e4c1-3846-8d4f-d6018ec5bdbb",
                                                "text": "„Sie saßen in dem kleinen holzgetäfelten Raum, einige in Schaukelstühlen und drei der Damen auf einer Couch.“"
                                            },
                                            {
                                                "example_id": "bbc35d3e-b258-4d62-8a5d-8c08116e1ff6",
                                                "sense_id": "96041e14-e4c1-3846-8d4f-d6018ec5bdbb",
                                                "text": "„Das traurigste Leben führte der Schaukelstuhl, als sich Großmutter Dorothea und ihr zweiter Mann zu Gastwirtsleuten, wie sie meinten: emporgearbeitet hatten.“"
                                            },
                                            {
                                                "example_id": "243b2ebd-7cf3-48fb-8961-8a676e2315f0",
                                                "sense_id": "96041e14-e4c1-3846-8d4f-d6018ec5bdbb",
                                                "text": "„Helena setzte sich auf den hölzernen Schaukelstuhl in meinem Zimmer.“"
                                            },
                                            {
                                                "example_id": "da7ec4ea-0f20-4d77-b618-418c8a8a6762",
                                                "sense_id": "96041e14-e4c1-3846-8d4f-d6018ec5bdbb",
                                                "text": "„Das ist nicht der Zustand, den einst Schaukelstuhl und Pfeife symbolisierten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07411369-0425-48e2-bc34-93785b6c12e7",
                        "source_entry_id": "c962dc60-3833-3c5c-b511-ea3518d0a089",
