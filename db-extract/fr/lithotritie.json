                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8e188c7-283b-4d39-8fb0-ad26a2c16120",
                        "entry_id": "f620ed2e-5453-3714-a456-18246340317f",
                        "tags": [
                            "plural"
                        ],
