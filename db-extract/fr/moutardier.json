                        "tags": [],
                        "examples": [
                            {
                                "example_id": "557d45e5-6b16-4032-a2d6-2447fbb696ef",
                                "sense_id": "5f716af5-3587-3493-81d4-dfff2d8b1563",
                                "text": "Moutardier d’étain, d’argent, de porcelaine, de cristal."
                            },
                            {
                                "example_id": "22ebacf3-e540-442a-bfe7-5de2e0033623",
                                "sense_id": "5f716af5-3587-3493-81d4-dfff2d8b1563",
                                "text": "Il ouvrit le moutardier et se composa une tartine à déboucher un nez d’Eskimo."
                            }
                        ]
                    }
                ],
