                                                "sense_id": "7c4d8f23-4222-345a-875d-e0f931a4f687",
                                                "text": "Er ist ein besonders cleveres Kerlchen."
                                            },
                                            {
                                                "example_id": "89696235-8e36-40ef-adfa-2b047df5da39",
                                                "sense_id": "7c4d8f23-4222-345a-875d-e0f931a4f687",
                                                "text": "Du glaubst wohl, du bist besonders clever, oder was?"
                                            },
                                            {
                                                "example_id": "f62f17d9-1d75-41a3-b635-b8aa6ef43d65",
                                                "sense_id": "7c4d8f23-4222-345a-875d-e0f931a4f687",
                                                "text": "Sie haben für den Geldtransfer eine wirklich clevere Methode gefunden."
                                            },
                                            {
                                                "example_id": "02efd452-eaae-475f-b5b6-a1bca30c2e34",
                                                "sense_id": "7c4d8f23-4222-345a-875d-e0f931a4f687",
                                                "text": "Deinen Vater zu fragen war aber nicht besonders clever."
                                            },
                                            {
                                                "example_id": "c767a82f-104d-4468-87d8-bf3395dc62e3",
                                                "sense_id": "7c4d8f23-4222-345a-875d-e0f931a4f687",
                                                "text": "Das war aber eine wirklich clevere Idee!"
                                            },
                                            {
                                                "example_id": "95af448b-5c8c-4ced-84b0-6fc1898d6916",
                                                "sense_id": "7c4d8f23-4222-345a-875d-e0f931a4f687",
                                                "text": "Man muss schon verdammt clever sein, wenn man aus der Nummer wieder raus kommen will."
                                            },
                                            {
                                                "example_id": "874c8bd4-b508-416d-93d3-c678d31819f4",
                                                "sense_id": "7c4d8f23-4222-345a-875d-e0f931a4f687",
                                                "text": "Glückwunsch, cleverer kann man das wohl kaum lösen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
