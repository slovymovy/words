                                                "sense_id": "2a74aa6a-1b7f-3a87-98d3-7998be4f8f03",
                                                "text": "a self-help book"
                                            },
                                            {
                                                "example_id": "3b36aa45-ccf2-4855-bce0-4e20d4d5d9ce",
                                                "sense_id": "2a74aa6a-1b7f-3a87-98d3-7998be4f8f03",
                                                "text": "Look at the self-help titles in the bookstore, and you'll get a few clues about our culture. They're all about aggression and acquisition. It wouldn't be at all surprising to see a book called How to Force your Will on Other People by Giving Them the Shaft and Fucking Them out of Their Money."
                                            },
                                            {
                                                "example_id": "bf947026-d492-4ba8-83f1-e0cba78060c2",
                                                "sense_id": "2a74aa6a-1b7f-3a87-98d3-7998be4f8f03",
                                                "text": "Amanda Straw estimates that she has read nearly 200 self-help books."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8e2a5a6-dffb-3320-8a24-899afea991b2",
