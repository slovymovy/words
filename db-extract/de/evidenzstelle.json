                ],
                "senses": [
                    {
                        "sense_id": "d535ac59-df98-3600-8977-a3d2d6bef5f1",
                        "entry_id": "96e7b53a-8d31-3e7d-867c-f8ad2f4854b6",
                        "glosses": [
                            "Zentrale Studienabteilung an österreichischen Universitäten"
                        ],
                        "tags": [
                            "früher"
                        ],
                        "examples": [
                            {
                                "example_id": "cf786cbc-7ffe-4731-b2d0-22ce4b58f7fb",
                                "sense_id": "d535ac59-df98-3600-8977-a3d2d6bef5f1",
                                "text": "„Das Referat Studienzulassung (früher Studienabteilung oder Evidenzstelle) ist zuständig für Belange der Zulassung von Studierenden.“"
                            },
                            {
                                "example_id": "bfea459f-55dd-4572-95ff-76cf683d187e",
                                "sense_id": "d535ac59-df98-3600-8977-a3d2d6bef5f1",
                                "text": "„… die Evidenthaltung der Studierenden gemäß § 4 Abs.4 des Allgemeinen Hochschul- Studiengesetz (Evidenzstelle); …“"
                            },
                            {
                                "example_id": "02f01f25-5b56-415d-b811-d637703ef04f",
                                "sense_id": "d535ac59-df98-3600-8977-a3d2d6bef5f1",
                                "text": "„Hinter den Eisentüren der Evidenzstelle die nächste Überraschung: Wo sich einst die Massen brav in Zweierreihen vor beigen Schaltern Typ ‚Gruß aus den Siebzigern‘ anstellten, befindet sich heute ein Servicezentrum mit offenen Pulten.“"
                            },
                            {
                                "example_id": "1c53c253-28d3-4f63-a2db-05bc9fa59bf8",
                                "sense_id": "d535ac59-df98-3600-8977-a3d2d6bef5f1",
                                "text": "„§ 5 Abs. 3 bis 6 hat zu lauten: „‚(3) Die Evidenzstelle hat über jeden Studierenden einen Akt anzulegen. …‘“"
                            },
                            {
                                "example_id": "63cbb5a0-5f1b-45e2-84a2-dadbab15a4f0",
                                "sense_id": "d535ac59-df98-3600-8977-a3d2d6bef5f1",
                                "text": "„ Er und andere Studenten seien zur Evidenzstelle der Universität gegangen, da sie im letzten Studienjahr an der Universität in Lagos gewesen wären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "464f4a42-1137-399b-98d9-07e9320fe4c7",
                        "entry_id": "96e7b53a-8d31-3e7d-867c-f8ad2f4854b6",
                        "glosses": [
                            "den Datenbestand verwaltende Abteilung"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "951226a5-c3b0-4a7c-a551-d39c7f1f7588",
                                "sense_id": "464f4a42-1137-399b-98d9-07e9320fe4c7",
                                "text": "„Zur Unterstützung der ordnungsgemäßen Geschäftsführung des Bundesverwaltungsgerichtes sind vom Präsidenten ein Präsidialbüro, eine Evidenzstelle, eine Controllingstelle und eine Geschäftsstelle einzurichten.“"
                            },
                            {
                                "example_id": "47d81129-b79e-4b77-901a-7c6ff57af3af",
                                "sense_id": "464f4a42-1137-399b-98d9-07e9320fe4c7",
                                "text": "„Die Evidenzstelle hat unbeschadet der Bestimmungen der §§16 und 17 in der Staatsbürgerschaftsevidenz festzuhalten, auf Grund welcher Gesetzesstelle die verzeichnete Person die Staatsbürgerschaft erworben hat.“"
                            },
                            {
                                "example_id": "f322d6a3-3d20-4b3c-ad62-be73a33d1530",
                                "sense_id": "464f4a42-1137-399b-98d9-07e9320fe4c7",
                                "text": "„Hierzu ist eine gemeinsame Evidenzstelle einzurichten, die die Entscheidungen und Empfehlungen in einer übersichtlichen Art und Weise zu dokumentieren und evident zu halten hat.“"
                            },
                            {
                                "example_id": "1c5e9c1d-012d-4fd1-bc69-eebe007ad33b",
                                "sense_id": "464f4a42-1137-399b-98d9-07e9320fe4c7",
                                "text": "„Das Recht auf Datenschutz ende dort, wo die Beweissicherung beginnt, sagt die Leiterin der Evidenzstelle, Sabrina Burda.“"
                            },
                            {
                                "example_id": "f5f5dd4e-bc62-4150-a096-f55a7b870040",
                                "sense_id": "464f4a42-1137-399b-98d9-07e9320fe4c7",
                                "text": "„Er schlug vor, eine Evidenzstelle einzurichten, die alle ausländischen Investitionen genau registriert.“"
                            },
                            {
                                "example_id": "80962437-00de-40a5-b101-25e69cc6f2bf",
                                "sense_id": "464f4a42-1137-399b-98d9-07e9320fe4c7",
                                "text": "„Das Personal (Personalverrechnung und der Evidenzstelle) und die Aufgaben wurden in die Referate l/2/a ‚Personalmanagement‘ und l/2/b ‚Organisationsmanagement‘ transferiert.“"
                            },
                            {
                                "example_id": "127c02e1-fa35-4395-94a1-8e166e128692",
                                "sense_id": "464f4a42-1137-399b-98d9-07e9320fe4c7",
                                "text": "„Der Ostausschuss betrachtete die praktische Hilfestellung für Unternehmen mehr und mehr als seine vornehmliche Aufgabe – so richtete er im Sommer 1992 in seinem Berliner Büro eine Evidenzstelle für ungedeckte deutsche Forderungen ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
