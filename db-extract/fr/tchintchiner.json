                ],
                "senses": [
                    {
                        "sense_id": "b05db4eb-570c-3a8f-b400-0ccb27e09349",
                        "entry_id": "dec8c29e-a457-3d82-936b-962ce9934f1b",
                        "glosses": [
                            "Trinquer, cogner les verres en signe de joie, pour marquer son amitié ou pour faire un vœu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebbd8d49-d609-4023-be12-7ceb14cacafb",
                                "sense_id": "b05db4eb-570c-3a8f-b400-0ccb27e09349",
                                "text": "Dans la propriété des Ellioth, entre les tables dressées pour l’occasion les gens tchintchinèrent, virevoltèrent pour retrouver le lyrisme qui accompagnait les fêtes d’antan, mais c’était difficile."
                            },
                            {
                                "example_id": "48398028-dc19-462c-94f9-24de68c008d0",
                                "sense_id": "b05db4eb-570c-3a8f-b400-0ccb27e09349",
                                "text": "Je vais \"tchintchiner\" avec vous ce soir !!"
                            },
                            {
                                "example_id": "1f338aec-abdb-4ef8-8b2d-f31f09764715",
                                "sense_id": "b05db4eb-570c-3a8f-b400-0ccb27e09349",
                                "text": "Louis tente de lever son verre pour tchintchiner avec moi."
                            },
                            {
                                "example_id": "b4bc148b-f85b-4e14-953f-f6e6698dce7f",
                                "sense_id": "b05db4eb-570c-3a8f-b400-0ccb27e09349",
                                "text": "Ah! leur tenir la dragée haute à ces Chinois, tout en les tchintchinant dans la forêt des compliments!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e01aeaed-a801-3548-9ba3-8e84e43c4138",
                        "entry_id": "dec8c29e-a457-3d82-936b-962ce9934f1b",
                        "glosses": [
                            "Faire un bruit de tchin-tchin."
                        ],
                        "tags": [],
                        "examples": []
                    }
