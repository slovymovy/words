                                    {
                                        "sense_id": "ada68029-a595-31b5-a8ea-c0ce6f5c4a55",
                                        "entry_id": "c7679660-209c-3a67-b869-a9c9537ae663",
                                        "glosses": [
                                            "The former currency unit in the Netherlands, divided into 100 cents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b920492-5d10-42f0-811f-0552b1dd4d5e",
                                                "sense_id": "ada68029-a595-31b5-a8ea-c0ce6f5c4a55",
                                                "text": "[N]one ſhall be choſen to be a Commiſſioner in the Court at Amſterdam, vnleſſe he put ſix thouſand gilders ſtocke of his owne in the ſaid Companie; [...]"
                                            },
                                            {
                                                "example_id": "9a43b20a-2ba6-40c0-8dd0-0b07a3a1f56f",
                                                "sense_id": "ada68029-a595-31b5-a8ea-c0ce6f5c4a55",
                                                "text": "On the Spuy is a good Dutch Inn, called the Hoff van Utrecht. The Price is a Gilder a Day, or a Shilling for the Dinner only."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8e0abd3-e42f-300b-aba8-6cd762a298cd",
                                        "entry_id": "c7679660-209c-3a67-b869-a9c9537ae663",
                                        "glosses": [
                                            "The former currency unit in Suriname, divided into 100 cents."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cb96b6a-d615-3f8e-9007-6c69e6664675",
                                        "entry_id": "c7679660-209c-3a67-b869-a9c9537ae663",
                                        "glosses": [
                                            "The current currency unit in the islands of the Caribbean Netherlands, divided into 100 cents."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "guilder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a38a8776-8820-332c-907e-c12e0e202238",
                                        "entry_id": "b2b2e374-1a9e-31fa-9b18-4aa05cfa584c",
                                        "glosses": [
                                            "Obsolete spelling of gilder (“one who gilds”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97933176-6d5b-4bd5-80e5-c46d5862a145",
                                                "sense_id": "a38a8776-8820-332c-907e-c12e0e202238",
                                                "text": "A lady ſhould, indeed, ſtudie her face, when wee thinke ſhee ſleepes: nor, when the dores are ſhut, ſhould men bee inquiring, all is ſacred within, then. [...] you ſee guilders will not worke, but inclos'd. They muſt not diſcouer, how little ſerues, with the helpe of art, to adorne a great deale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b954e845-01a3-4806-879d-c4bdd77f7fee",
