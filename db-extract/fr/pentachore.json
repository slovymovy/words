                        "glosses": [
                            "Objet à quatre dimensions analogue à un tétraèdre, construit à partir de cinq tétraèdres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8b62b72-a759-4e92-9b99-efaac1bef62e",
                                "sense_id": "3047ac2d-7e8a-320d-87b2-82ceba978316",
                                "text": "Par exemple, le cube se transforme en 4 dimensions en un hyper-cube tandis que le tétraèdre devient un « pentachore »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1353bca2-c5e4-4aa5-901f-c5d41d223e6d",
                        "source_entry_id": "04de3d97-358e-36ad-a47d-aafc09dc33f6",
