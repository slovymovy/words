                "senses": [
                    {
                        "sense_id": "7cc04027-5cba-3e93-9088-35be1078ffb6",
                        "entry_id": "0cd1b761-7d9e-39be-815a-c22cd6cb7d29",
                        "glosses": [
                            "Teilgebiet der Wirtschaftswissenschaften, das die Ökonomie von Nationen untersucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76805882-8a8b-4258-b09e-2c0be709e185",
                                "sense_id": "7cc04027-5cba-3e93-9088-35be1078ffb6",
                                "text": "Der Philosoph Adam Smith, dessen Ideen sich in Deutschland durch Korrespondenz mit einem Kantschüler ausbreiteten, ist der Vater der Nationalökonomie."
                            },
                            {
                                "example_id": "a8088da5-7938-44a6-beaf-8ba6c8e16792",
                                "sense_id": "7cc04027-5cba-3e93-9088-35be1078ffb6",
                                "text": "Nationalökonomie ist, wenn die Leute sich wundern, warum sie kein Geld haben. (Kurt Tucholsky, Kurzer Abriß der Nationalökonomie, zitiert nach Projekt Gutenberg)"
                            },
                            {
                                "example_id": "bb95ae30-3843-4f99-9d0b-865d25b36904",
                                "sense_id": "7cc04027-5cba-3e93-9088-35be1078ffb6",
                                "text": "„Deutliche Spuren von akademischen Ressentiments verrät auch der intelligente Dialog zwischen einem Privatdozenten der Nationalökonomie und einem Industriellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
