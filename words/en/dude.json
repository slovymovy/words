{
    "word_family": [
        "dudish",
        "dudeism",
        "dudine",
        "dudess"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24a150e7-5a52-35e4-a730-bdb50ca349c3",
                    "sense_definition": "A man, generally a younger one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I saw a cool <w>dude</w> wearing sunglasses at the park.",
                            "target_lang_translations": {
                                "ru": "Я видел в парке крутого <w>чувака</w> в солнечных очках.",
                                "zh": "我在公园里看见一个戴墨镜的酷<w>哥们儿</w>。"
                            }
                        },
                        {
                            "text": "Those <w>dudes</w> play basketball here every Saturday.",
                            "target_lang_translations": {
                                "ru": "Те <w>чуваки</w> играют здесь в баскетбол каждую субботу.",
                                "zh": "那些<w>家伙</w>每周六都在这儿打篮球。"
                            }
                        }
                    ],
                    "synonyms": [
                        "guy",
                        "fellow",
                        "chap",
                        "bloke"
                    ],
                    "common_phrases": [
                        "cool dude"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, обычно молодой (разговорное).",
                        "zh": "指男性，通常指年轻人（口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувак",
                                "target_lang_sense_clarification": "сленг, очень распространенное"
                            },
                            {
                                "target_lang_word": "парень",
                                "target_lang_sense_clarification": "разговорное, нейтральное"
                            },
                            {
                                "target_lang_word": "чел",
                                "target_lang_sense_clarification": "молодежный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哥们儿",
                                "target_lang_sense_clarification": "口语，指男性朋友或年轻人"
                            },
                            {
                                "target_lang_word": "家伙",
                                "target_lang_sense_clarification": "口语，指人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c29d9a1c-2902-3ce0-927d-092fa40f8ac0",
                    "sense_definition": "A casual term of address for a person, typically a man.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>dude</w>, do you know what time it is?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>чувак</w>, ты не знаешь, сколько времени?",
                                "zh": "嘿<w>哥们儿</w>，你知道现在几点了吗？"
                            }
                        },
                        {
                            "text": "I am sorry, <w>dude</w>, but I cannot help you with that.",
                            "target_lang_translations": {
                                "ru": "Извини, <w>чувак</w>, но я ничем не могу тебе помочь.",
                                "zh": "抱歉<w>兄弟</w>，这件事我帮不了你。"
                            }
                        }
                    ],
                    "synonyms": [
                        "man",
                        "bro",
                        "mate",
                        "buddy"
                    ],
                    "common_phrases": [
                        "hey dude"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное обращение к человеку, обычно к мужчине.",
                        "zh": "对人的非正式称呼，通常用于男性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувак",
                                "target_lang_sense_clarification": "дружеское обращение"
                            },
                            {
                                "target_lang_word": "братан",
                                "target_lang_sense_clarification": "панибратское"
                            },
                            {
                                "target_lang_word": "старик",
                                "target_lang_sense_clarification": "дружеское, идиоматическое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哥们儿",
                                "target_lang_sense_clarification": "非正式称呼"
                            },
                            {
                                "target_lang_word": "兄弟",
                                "target_lang_sense_clarification": "非正式称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65343f55-2c32-3bcb-9259-f05046dea077",
                    "sense_definition": "A tourist from the city who vacations on a ranch in the western United States.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cowboys taught the <w>dudes</w> how to ride horses properly.",
                            "target_lang_translations": {
                                "ru": "Ковбои учили <w>городских пижонов</w> правильно ездить верхом.",
                                "zh": "牛仔们教那些<w>城市游客</w>如何正确地骑马。"
                            }
                        },
                        {
                            "text": "Many <w>dudes</w> come to this ranch every summer to experience the wild west.",
                            "target_lang_translations": {
                                "ru": "Многие <w>туристы</w> приезжают на это ранчо каждое лето, чтобы почувствовать атмосферу Дикого Запада.",
                                "zh": "每年夏天都有许多<w>游客</w>来到这个牧场体验西部风情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "city slicker"
                    ],
                    "common_phrases": [
                        "dude ranch"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US West"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "mostly associated with historical dude ranches"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Городской житель, отдыхающий на ранчо (обычно на западе США).",
                        "zh": "指到美国西部牧场度假的城市游客。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "городской пижон",
                                "target_lang_sense_clarification": "пренебрежительное"
                            },
                            {
                                "target_lang_word": "турист",
                                "target_lang_sense_clarification": "нейтральное, по контексту"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "城市游客",
                                "target_lang_sense_clarification": "指缺乏牧场经验的游客"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "695a9baf-553f-3de2-9521-d1ce5323375e",
                    "sense_definition": "A man who is excessively concerned with his clothes, appearance, and manners.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dressed like a 19th-century <w>dude</w> with a silk hat and cane.",
                            "target_lang_translations": {
                                "ru": "Он оделся как <w>франт</w> XIX века, в цилиндре и с тростью.",
                                "zh": "他打扮得像个19世纪的<w>花花公子</w>，戴着丝绸礼帽，拄着手杖。"
                            }
                        },
                        {
                            "text": "The old article mocked the <w>dude</w> for his obsession with fashion.",
                            "target_lang_translations": {
                                "ru": "Старая статья высмеивала этого <w>пижона</w> за его одержимость модой.",
                                "zh": "那篇旧文章嘲笑那个<w>纨绔子弟</w>对时尚的痴迷。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dandy",
                        "fop"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "original meaning of the word"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, чрезмерно заботящийся о своей одежде и внешности (устаревшее).",
                        "zh": "指过度讲究衣着、外表和举止的男性（过时用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пижон",
                                "target_lang_sense_clarification": "стиляга"
                            },
                            {
                                "target_lang_word": "франт",
                                "target_lang_sense_clarification": "щеголь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "花花公子",
                                "target_lang_sense_clarification": "指讲究打扮的男性"
                            },
                            {
                                "target_lang_word": "纨绔子弟",
                                "target_lang_sense_clarification": "指讲究排场和打扮的男性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f4e67e60-5dc6-3e46-8dee-27ca440d0cd1",
                    "sense_definition": "An exclamation used to express strong emotion such as awe, excitement, surprise, or annoyance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dude</w>! You almost knocked over my coffee cup.",
                            "target_lang_translations": {
                                "ru": "<w>Чувак</w>! Ты чуть не опрокинул мою чашку с кофе.",
                                "zh": "<w>天哪</w>！你差点撞翻我的咖啡杯。"
                            }
                        },
                        {
                            "text": "<w>Dude</w>! That was the best movie I have ever seen.",
                            "target_lang_translations": {
                                "ru": "<w>Офигеть</w>! Это был лучший фильм, который я когда-либо видел.",
                                "zh": "<w>伙计</w>！那是我看过最棒的电影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wow",
                        "man"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возглас, выражающий сильные эмоции: удивление, восхищение или раздражение.",
                        "zh": "用于表达强烈情绪（如惊叹、兴奋、惊讶或恼怒）的感叹词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувак",
                                "target_lang_sense_clarification": "как восклицание"
                            },
                            {
                                "target_lang_word": "офигеть",
                                "target_lang_sense_clarification": "выражение крайнего удивления"
                            },
                            {
                                "target_lang_word": "блин",
                                "target_lang_sense_clarification": "выражение досады"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天哪",
                                "target_lang_sense_clarification": "表达惊讶或感叹"
                            },
                            {
                                "target_lang_word": "伙计",
                                "target_lang_sense_clarification": "作为感叹词开头"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a750fbe5-3f09-3aef-9140-143895e92aa2",
                    "sense_definition": "To address someone using the word \"dude\".",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She told him to stop <w>duding</w> her and use her real name.",
                            "target_lang_translations": {
                                "ru": "Она сказала ему перестать <w>называть её чуваком</w> и использовать её настоящее имя.",
                                "zh": "她让他别再<w>称呼</w>她为“哥们儿”，叫她的真名。"
                            }
                        },
                        {
                            "text": "They spent the whole night <w>duding</w> each other while playing video games.",
                            "target_lang_translations": {
                                "ru": "Они весь вечер <w>называли друг друга чуваками</w>, играя в видеоигры.",
                                "zh": "他们玩电子游戏时，整晚都在互相<w>称呼</w>“哥们儿”。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращаться к кому-либо, используя слово \"чувак\".",
                        "zh": "用“dude”这个词称呼某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "называть чуваком",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "称呼……为哥们儿",
                                "target_lang_sense_clarification": "描述性翻译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02d53712-1c22-3eb1-bb0d-752ebcefc68e",
                    "sense_definition": "To dress up in stylish or flashy clothes, usually followed by 'up'.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got all <w>duded</w> up for the wedding ceremony.",
                            "target_lang_translations": {
                                "ru": "Он <w>вырядился</w> для свадебной церемонии.",
                                "zh": "为了参加婚礼，他特意<w>盛装</w>打扮了一番。"
                            }
                        },
                        {
                            "text": "You look nice when you are <w>duded</w> up in a suit.",
                            "target_lang_translations": {
                                "ru": "Ты хорошо выглядишь, когда <w>принарядился</w> в костюм.",
                                "zh": "你穿上西装<w>打扮</w>起来的样子真帅。"
                            }
                        }
