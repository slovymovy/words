                            "awaria, usterka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b9065af-397b-4370-9802-f50d439ce838",
                                "sense_id": "f4e218ec-2b77-3d08-a78c-ce2bc0c8bba1",
                                "text": "Nigdy nie próbuj przyspieszyć procesu rozmrażania przez odłupywanie lodu, ponieważ może to doprowadzić do uszkodzenia obudowy zamrażarki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d37536b8-f262-391b-965f-c3a2cde2ee11",
                        "entry_id": "6f5c9d8e-19e4-3289-a7a6-ad3cd1c4d9a4",
                        "glosses": [
                            "naruszenie tkanki organizmu lub jej nieprawidłowa zmiana pod wpływem choroby bądź czynników zewnętrznych np. promieniowania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92fdf58c-4cce-43ce-98b4-db55fcf6b0cc",
                                "sense_id": "d37536b8-f262-391b-965f-c3a2cde2ee11",
                                "text": "Spożycie kadmu powoduje natychmiastowe zatrucie oraz uszkodzenie wątroby i nerek."
                            },
                            {
                                "example_id": "9059b5b0-576a-4889-936a-a7ff1c52ea7a",
                                "sense_id": "d37536b8-f262-391b-965f-c3a2cde2ee11",
                                "text": "Uszkodzenie jednego z głównych naczyń krwionośnych może być bardzo groźne w skutkach."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
