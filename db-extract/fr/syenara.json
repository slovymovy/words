                        "glosses": [
                            "Variante du continuum linguistique sénoufo, parlée dans les cercles de Sikasso et de Kadiolo au Mali, en Côte d'Ivoire et au Burkina Faso."
                        ],
                        "tags": [],
                        "examples": [
                            {
