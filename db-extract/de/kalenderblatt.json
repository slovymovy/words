                ],
                "senses": [
                    {
                        "sense_id": "e9b9d3ca-2cd4-3fd6-999c-cd96c6ec0c67",
                        "entry_id": "8b305ce6-0d20-3684-b0e0-30403d14aa82",
                        "glosses": [
                            "einzelne Seite eines Kalenders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2a31de8-15a8-4d01-90e6-2b1e914809ee",
                                "sense_id": "e9b9d3ca-2cd4-3fd6-999c-cd96c6ec0c67",
                                "text": "Bei einem Tageskalender wird täglich ein Kalenderblatt abgerissen."
                            },
                            {
                                "example_id": "bb8053cb-a205-49af-8141-f85749db24a3",
                                "sense_id": "e9b9d3ca-2cd4-3fd6-999c-cd96c6ec0c67",
                                "text": "Das Kalenderblatt für den November zeigt die Aufnahme eines argentinischen Gletschers."
                            },
                            {
                                "example_id": "6e4d5f4d-5d08-41f2-8775-0c259d094fc3",
                                "sense_id": "e9b9d3ca-2cd4-3fd6-999c-cd96c6ec0c67",
                                "text": "„Für meine Termine und Reisen habe und führe ich seit Mitte der neunziger Jahre einen Filofax-Kalender, dessen Kalenderblätter man Jahr für Jahr austauschen kann.“"
                            },
                            {
                                "example_id": "453810ef-5c4c-4eab-905f-33d2601ae564",
                                "sense_id": "e9b9d3ca-2cd4-3fd6-999c-cd96c6ec0c67",
                                "text": "„Der Satz ist mit Rotstift durchgestrichen, ebenso das Kalenderblatt des Monats Mai.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
