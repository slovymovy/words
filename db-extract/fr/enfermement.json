                                "example_id": "d4f84169-b18e-4f99-9c86-a0ae7f85b7a3",
                                "sense_id": "4397f55f-8303-3a9f-87da-0d727d6b770d",
                                "text": "tes pensées enfouies composent des énigmes tu repars en arrière zone de voie à découdre au tumulte de l’enfermement bien serré dans ton carcan"
                            },
                            {
                                "example_id": "93f37908-0b2e-4887-a559-2f555089f24c",
                                "sense_id": "4397f55f-8303-3a9f-87da-0d727d6b770d",
                                "text": "L’enfermement volontaire."
                            }
                        ]
