                                "target_senses": [
                                    {
                                        "sense_id": "113bc3bb-ae4d-3f72-8389-1ebe7698275f",
                                        "entry_id": "24c93151-43a0-3173-848c-9d341e49365b",
                                        "glosses": [
                                            "To exasperate; to irritate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83d3ad17-f50d-4293-b026-61bbe9225338",
                                                "sense_id": "113bc3bb-ae4d-3f72-8389-1ebe7698275f",
                                                "text": "Lady Laura had triumphed; but she had no desire to acerbate her husband by any unpalatable allusion to her victory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a157b67c-680b-341c-81ed-14fe94941f71",
                                        "entry_id": "24c93151-43a0-3173-848c-9d341e49365b",
                                        "glosses": [
                                            "To make bitter or sour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e16e0eed-0f40-40b3-8d6b-7ef2d00bb94b",
                        "source_entry_id": "1a5ff164-d9e7-3229-a94a-bead3cc3ce18",
                        "source_sense_id": "dbdc2bf5-3166-3e41-8b9d-ee4a78c6e326",
                        "target_lang_word": "exacerbate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exacerbate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                        "entry_id": "3f03592f-17f9-30eb-8557-76bda1aecd40",
                                        "glosses": [
                                            "To make worse (a problem, bad situation, negative feeling, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "266a8f59-7973-44da-9a85-e5ea845940b4",
                                                "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                                "text": "Near-synonym: worsen"
                                            },
                                            {
                                                "example_id": "b37955f1-8cba-45f6-bec7-6c0274d0c05c",
                                                "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                                "text": "The proposed shutdown would exacerbate unemployment problems."
                                            },
                                            {
                                                "example_id": "0b5f0a97-1778-4119-9d81-5e2fe2cc85c4",
                                                "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                                "text": "Sino-Soviet relations were exacerbated by a border incident on May 9. Beijing charged that thirty Soviet troops, supported by a helicopter and navy boats, crossed the Ussuri River into the Hulin area of Heilongjiang province."
                                            },
                                            {
                                                "example_id": "8d68bf77-81a7-4369-bbde-cf7dccc103ca",
                                                "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                                "text": "Liz: It's just with Ed here, it's no wonder I always bring my flat-mates out and then that only exacerbates things.\nShaun: What do you mean?\nLiz: Well you guys hardly get on, do you?\nShaun: No, what does \"exacerbate\" mean?"
                                            },
                                            {
                                                "example_id": "e99f7340-d99f-4394-a4cb-11cfaaa95dc8",
                                                "sense_id": "6eae4765-205a-3790-a46d-f2e0a5a554c9",
                                                "text": "The reasons for this growing disconnect are myriad and complex but the situation is exacerbated by the reality that those English players who do smash through our game's \"glass ceiling\" command radically inflated transfer fees."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
