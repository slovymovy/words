                            {
                                "example_id": "3a421b3f-3b84-4c25-835f-6fa926bad66c",
                                "sense_id": "9a62ea41-4c46-3e7e-97df-5b2490e331c7",
                                "text": "De jonge valsemunter uit Almelo die twee weken geleden in Westerhaar werd aangehouden, wordt ervan verdacht dat hij op meer plekken in de regio met nepgeld heeft betaald. Hij wordt daarover binnenkort door de politie verhoord."
                            },
                            {
                                "example_id": "ca4fb477-aaca-4b25-8632-434ad40e1724",
                                "sense_id": "9a62ea41-4c46-3e7e-97df-5b2490e331c7",
                                "text": "Biljetten van 5 en 10 zijn al opgefrist. Na het biljet van 20 volgt in 2016 het vijftigje. Deze laatste twee zijn het meest populair bij valsemunters."
                            }
                        ]
                    }
