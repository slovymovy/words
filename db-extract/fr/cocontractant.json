                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "852a7683-e524-4177-a25f-c18e61a0eb8a",
                                "sense_id": "b11189f4-9285-3b29-86ce-b2d4764c4d7e",
                                "text": "Dans la vente, le cocontractant de l'acheteur est le vendeur et réciproquement."
                            },
                            {
                                "example_id": "bba2e940-f4da-4bea-b3b5-27cff0c3f80a",
                                "sense_id": "b11189f4-9285-3b29-86ce-b2d4764c4d7e",
                                "text": "Il appartient donc au cocontractant d’une municipalité de s’assurer que cette dernière agit bien dans le cadre de ses pouvoirs."
                            },
                            {
                                "example_id": "65709e97-1a30-49dd-9d66-9477efe3d46b",
                                "sense_id": "b11189f4-9285-3b29-86ce-b2d4764c4d7e",
                                "text": "Le cocontractant d’un marché public ou d’une concession peut-il justifier l’inexécution de sa prestation en s'appuyant sur les effets du deuxième confinement en France ?"
                            }
                        ]
                    }
