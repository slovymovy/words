                "senses": [
                    {
                        "sense_id": "4a6fac12-f090-32af-a906-763fe78d6128",
                        "entry_id": "35a2243a-fc5c-3b6f-b480-ccf96791be70",
                        "glosses": [
                            "spezielle Staatsform mit einer Regentschaft über zwei Herrschaftsgebiete"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "07177413-f377-3b18-a0c1-310096e19661",
                        "entry_id": "35a2243a-fc5c-3b6f-b480-ccf96791be70",
                        "glosses": [
                            "die Österreichisch-Ungarische Monarchie, die von 1867 bis 1914 bestand, auf Grund der staatsrechtlichen Konstruktion (Kaisertum in Österreich und Königtum in Ungarn)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "416c80df-4546-41b2-bd85-1e594b36f76f",
                                "sense_id": "07177413-f377-3b18-a0c1-310096e19661",
                                "text": "Die Doppelmonarchie strebte einen Zugang zu den Häfen der Ägäis (Saloniki) an."
                            },
                            {
                                "example_id": "bdf3131c-6e9c-44f1-8f4c-f5612f9e958e",
                                "sense_id": "07177413-f377-3b18-a0c1-310096e19661",
                                "text": "„Die letzte Inkarnation des Imperiums, die österreichisch-ungarische Doppelmonarchie, zerfiel in dramatischer Weise im Tumult des Ersten Weltkriegs.“"
                            },
                            {
                                "example_id": "0d4aa0f3-9d75-4603-bb65-36997c024629",
                                "sense_id": "07177413-f377-3b18-a0c1-310096e19661",
                                "text": "„Man nannte das den österreichisch-ungarischen Ausgleich; von da an sprach man von der Doppelmonarchie.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
