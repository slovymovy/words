                {
                    "sense_id": "a35869b5-3eff-39f7-96d3-0b36900a042f",
                    "sense_definition": "Relating to students who require special schooling due to intellectual giftedness or disabilities.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school district provides specific resources for <w>exceptional</w> learners.",
                            "target_lang_translations": {
                                "ru": "Школьный округ предоставляет специальные ресурсы для <w>особых</w> учащихся.",
                                "tr": "Okul bölgesi, <w>özel gereksinimli</w> öğrenciler için özel kaynaklar sağlamaktadır."
                            }
                        },
                        {
                            "text": "Teachers are trained to support <w>exceptional</w> students in the classroom.",
                            "target_lang_translations": {
                                "ru": "Учителя обучены поддерживать <w>особых</w> учеников в классе.",
                                "tr": "Öğretmenler sınıftaki <w>özel</w> öğrencileri desteklemek üzere eğitilmiştir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "exceptional children",
                        "exceptional learners"
                    ],
