                                        "sense_id": "f4a77a72-ae64-3d31-b524-07919a600197",
                                        "entry_id": "ebdea2ec-0e5a-3f4b-ba5a-2a0381323a87",
                                        "glosses": [
                                            "Wasser, das durch Kondensation an einer kühlen Fläche entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b70b2728-226e-433c-80ec-199b27401cde",
                                                "sense_id": "f4a77a72-ae64-3d31-b524-07919a600197",
                                                "text": "„Besonders in der kalten Jahreszeit bildet sich an den Fenstern leicht Kondenswasser.“"
                                            },
                                            {
                                                "example_id": "3af5ecb5-e363-446b-bf1c-95c4908aea20",
                                                "sense_id": "f4a77a72-ae64-3d31-b524-07919a600197",
                                                "text": "„Wer zu wenig oder falsch lüftet, riskiert Kondenswasser an den Fensterscheiben.“"
                                            },
                                            {
                                                "example_id": "53749d8d-03dd-4c28-866c-3962bec15d5c",
                                                "sense_id": "f4a77a72-ae64-3d31-b524-07919a600197",
                                                "text": "„Die Ansaugluftvorwärmung ist eine technische Einrichtung, die vornehmlich bei Vergasermotoren eine Rolle spielt und die Entstehung von Kondenswasser oder Eis im Motor verhindern soll.“"
                                            },
                                            {
                                                "example_id": "636593b1-8b40-4a38-8ec8-cccfd728538e",
                                                "sense_id": "f4a77a72-ae64-3d31-b524-07919a600197",
                                                "text": "„Ich sprach den Satz aus – und hätte ihn am liebsten gleich wieder weggewischt, so wie das Kondenswasser, das die Windschutzscheibe von innen beschlug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
