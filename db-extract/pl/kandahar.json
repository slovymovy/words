                    {
                        "translation_id": "76fdd355-c941-4968-9c30-df76eab98908",
                        "source_entry_id": "61c757ef-06ee-3cd2-bfd6-6eb801d6192e",
                        "source_sense_id": "bf06387f-d79e-3836-b85a-fecfcacc0cd8",
                        "target_lang_word": "Kandahar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kandahar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47ca2250-584c-3211-9618-f28090d5cc4e",
                                        "entry_id": "50651ab7-db84-304d-bb32-0f37faa458a1",
                                        "glosses": [
                                            "Ville du sud de l’Afghanistan, capitale du pays sous le régime des talibans (1996-2001)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d816d7f-9029-4675-b3e5-1cbba7a92229",
                                                "sense_id": "47ca2250-584c-3211-9618-f28090d5cc4e",
                                                "text": "[La ville de] Kandahar est arrosée par deux canaux dérivés de l’Ourgandab, et traversée par plusieurs petits ponts."
                                            },
                                            {
                                                "example_id": "5ee1ed4e-8c38-4d60-8621-496d4e2618d5",
                                                "sense_id": "47ca2250-584c-3211-9618-f28090d5cc4e",
                                                "text": "Le marchand de Kandahar toutefois ne se pressait point. Il avait à satisfaire les rites de la courtoisie et par surcroît à exalter l’intérêt de son auditoire. Il savoura donc le thé, les gâteaux au miel, la confiture à la graisse de mouton et en loua son hôte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "675391b6-33fb-3801-bec1-a261d5772861",
                                        "entry_id": "50651ab7-db84-304d-bb32-0f37faa458a1",
                                        "glosses": [
                                            "Province autour de cette ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d109c015-0580-4b12-bb97-30113fe203b2",
                                                "sense_id": "675391b6-33fb-3801-bec1-a261d5772861",
                                                "text": "Le Kandahar a longtemps fait partie de la Perse, et a passé tour à tour de celle-ci aux souverains de Delhi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5b64064-6ad9-3e61-be2e-72b1ac6a2960",
                                        "entry_id": "50651ab7-db84-304d-bb32-0f37faa458a1",
                                        "glosses": [
                                            "Compétition de ski alpin organisée par le Kandahar Ski Club, ainsi nommé en raison du patronage du baron Roberts of Kandahar."
                                        ],
                                        "tags": [
                                            "Ski alpin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96d8d48b-f3d8-462f-b6b6-aa14a854085b",
                                                "sense_id": "a5b64064-6ad9-3e61-be2e-72b1ac6a2960",
                                                "text": "La FIS a indiqué sa volonté de réintégrer le Kandahar dans le calendrier international."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0db0efc6-2bed-498a-960d-1a20a2a4f10a",
                        "source_entry_id": "61c757ef-06ee-3cd2-bfd6-6eb801d6192e",
                        "source_sense_id": "bf06387f-d79e-3836-b85a-fecfcacc0cd8",
                        "target_lang_word": "Qandahar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ff04cf1a-48e9-47a8-a92f-159d887e70a3",
                        "source_entry_id": "61c757ef-06ee-3cd2-bfd6-6eb801d6192e",
                        "source_sense_id": "bf06387f-d79e-3836-b85a-fecfcacc0cd8",
                        "target_lang_word": "Kandahar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kandahar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                        "entry_id": "64775dcb-7b12-33c5-b90a-17d280dbdce3",
                                        "glosses": [
                                            "mit 460.000 Einwohnern drittgrößte Stadt Afghanistans, Hauptstadt der gleichnamigen Provinz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf3ffa67-e6ff-4e39-b604-c8a554251dd5",
                                                "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                                "text": "„Dabei war es ihm sogar möglich, Persien Kandahar zu entreißen und damit die Grenze des Mogulreiches an den Helmand-Fluss zu verlegen.“"
                                            },
                                            {
                                                "example_id": "4f2fb0ad-5af6-4d75-83c0-ae9076a938c6",
                                                "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                                "text": "„Der Paschtune Ahmad Shah Durrani, der sich nach dem Tod Nadir Schahs in Kandahar zum Herrscher aufschwang, fiel zwischen 1747 und 1773 mehrfach in Indien ein, plünderte 1757 erneut Delhi und schlug 1761 ein vereintes Heer der Marathen.“"
                                            },
                                            {
                                                "example_id": "74508d62-f85f-4fd4-acee-c89daf983b55",
                                                "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                                "text": "„So bildete Kandahar, auf halbem Weg zwischen Indien und Persien, eine Oase zwischen den schroffen südlichen Ausläufern des Hindukusch und Khorassan.“"
                                            },
                                            {
                                                "example_id": "d5d3927a-5e2a-4b5d-b949-81ab3c913951",
                                                "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                                "text": "„Vor bald fündundzwanzig Jahren habe ich ein Buch über die Taliban geschrieben, als sie gerade in der zweitgrößten Stadt Afghanistans, Kandahar, aufgetaucht waren.“"
                                            },
                                            {
                                                "example_id": "101c8257-58e4-415b-a1d2-5d7a2e6fadfb",
                                                "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                                "text": "„General Nott kommt aus Kandahar, wo er den Befehl führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9390e90-480a-38c0-9b1d-1b31ac16ccc8",
                                        "entry_id": "64775dcb-7b12-33c5-b90a-17d280dbdce3",
                                        "glosses": [
                                            "Provinz in Afghanistan mit mehr als 1.000.000 Einwohnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b49712ee-7fe1-4c3a-96fc-b948584b2d03",
                                                "sense_id": "b9390e90-480a-38c0-9b1d-1b31ac16ccc8",
                                                "text": "„Seit ihrem dramatischen und unerwarteten Erscheinen Ende 1994 hatten die Taliban relativen Frieden und Sicherheit nach Kandahar und in die benachbarten Provinzen gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
