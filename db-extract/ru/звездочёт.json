                ],
                "senses": [
                    {
                        "sense_id": "f3b592a9-1a4a-3ca7-8247-765bcb96cb8b",
                        "entry_id": "72a22970-c7fb-3e62-b985-b14ca347b6bd",
                        "glosses": [
                            "устар. предсказатель и гадатель по звёздам; астролог"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0415f085-8bb6-4d0d-9a31-96dce2c8fe55",
                                "sense_id": "f3b592a9-1a4a-3ca7-8247-765bcb96cb8b",
                                "text": "В келье звездочёта аптекарские весы, пробирная посуда, химические снадобья и деньги из купеческих кошельков: заморские, из платы за лес, за пеньку, за кожи, ворвань, красную рыбу и прочие княжеские товары."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f79b258-7234-3617-84b6-54e46bf0d60d",
                        "entry_id": "72a22970-c7fb-3e62-b985-b14ca347b6bd",
                        "glosses": [
                            "зоол. небольшая хищная морская рыба с глазами, расположенными на верхней стороне головы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "448aa0df-b442-4f2e-abf3-b2fb112ca4ce",
                                "sense_id": "8f79b258-7234-3617-84b6-54e46bf0d60d",
                                "text": "Европейский звездочёт встречается в прибрежной зоне многих океанов."
                            }
                        ]
                    },
                    {
                        "sense_id": "efba78ed-0caf-3cd8-aae8-5f896492262e",
                        "entry_id": "72a22970-c7fb-3e62-b985-b14ca347b6bd",
                        "glosses": [
                            "перен. астроном"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05a796f0-9502-4813-b8b5-5a878d51e662",
                        "source_entry_id": "72a22970-c7fb-3e62-b985-b14ca347b6bd",
                        "source_sense_description": "предсказатель и гадатель по звёздам; астролог",
                        "target_lang_word": "stargazer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stargazer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cb26633-c9f4-3ab3-892b-5bc7e5988aad",
                                        "entry_id": "5540c828-740d-3549-9608-a23615c01a41",
                                        "glosses": [
                                            "Someone who gazes at the stars; an astronomer or astrologer (now especially an amateur one)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244d0ebe-ceed-4885-8f0f-b75b54510fa7",
                                                "sense_id": "9cb26633-c9f4-3ab3-892b-5bc7e5988aad",
                                                "text": "Thou art wearied in the multitude of thy counsels: let now the astrologers, the starre-gazers, the monethly prognosticators stand vp, and saue thee from these things that shall come vpon thee."
                                            },
                                            {
                                                "example_id": "ff66f21c-0362-4d2d-adaf-8a26fb77b405",
                                                "sense_id": "9cb26633-c9f4-3ab3-892b-5bc7e5988aad",
                                                "text": "[…] the four satellites of Jupiter, which, it is thought, were probably visible to certain of the more sharp-sighted stargazers of ancient Babylonia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd75f12-d1ee-307d-be24-b43c4bda5d3b",
                                        "entry_id": "5540c828-740d-3549-9608-a23615c01a41",
                                        "glosses": [
                                            "Any of family Uranoscopidae of bottom-dwelling fish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "423838ca-df71-46d5-878c-cab45d92a3d9",
                                                "sense_id": "1dd75f12-d1ee-307d-be24-b43c4bda5d3b",
                                                "text": "A stargazer is a frightening fish by any sretch of the imagination, but not until the day I first saw one in its own world did I understand its true nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
