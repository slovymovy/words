                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4abc404-0da5-35b9-aef4-9d7ab03dcc4f",
                        "entry_id": "1902f445-2a8b-3294-b934-9037fb4ade0c",
                        "glosses": [
                            "разг. превысить меру в чём-либо, зайти слишком далеко в чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d2e3f3b-2b4d-41b2-b12f-fe1aef944f81",
                                "sense_id": "a4abc404-0da5-35b9-aef4-9d7ab03dcc4f",
                                "text": "— Вы мою просьбу переборщили, Карло Осипович. Я просил вас рекомендовать для детей наших учителя только не бойкого, а вы привезли какого-то дида."
                            },
                            {
                                "example_id": "33d2263b-a62e-4612-8a6d-c7c76f28ac30",
                                "sense_id": "a4abc404-0da5-35b9-aef4-9d7ab03dcc4f",
                                "text": "Газета «Русская Речь», надо отдать ей справедливость, оказала в бурное время, как и «союз русского народа», несомненную пользу к обузданию и отрезвлению взбаламученной рсволюционной накипи, дав ей твердый отпор; но, к сожалению, она, как и названный «союз», что называется, переборщила и вовремя не сумела обуздать самое себя в своём патриотическом рвении."
                            },
                            {
                                "example_id": "0c3fe2c0-861f-4de1-b741-6053634617bb",
                                "sense_id": "a4abc404-0da5-35b9-aef4-9d7ab03dcc4f",
                                "text": "Однако, я не рекомендовал бы это начинающим, так как здесь легко впасть в крайность, переборщить и не получить желаемую позицию в связи с недостаточной квалификацией."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "965b5495-506b-412f-ad7b-fd247c36219a",
                        "source_entry_id": "1902f445-2a8b-3294-b934-9037fb4ade0c",
                        "source_sense_id": "a4abc404-0da5-35b9-aef4-9d7ab03dcc4f",
                        "target_lang_word": "go too far",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "go too far",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3267617d-72ee-3e85-98b3-aad5feb9b396",
                                        "entry_id": "d1e07a4f-9c03-3855-9330-7ade5df7919b",
                                        "glosses": [
                                            "To exceed an unstated limit, especially of acceptable behaviour."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa7fdafd-e605-459d-8fb5-1f57c94a2cc1",
                                                "sense_id": "3267617d-72ee-3e85-98b3-aad5feb9b396",
                                                "text": "I don't mind if you make soup too, but asking for the family recipe is going too far."
                                            },
                                            {
                                                "example_id": "dbd77f49-20ec-4937-a038-c890ec9e0f25",
                                                "sense_id": "3267617d-72ee-3e85-98b3-aad5feb9b396",
                                                "text": "I take it all, I let it slide\nBut hey, you went too far this time"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
