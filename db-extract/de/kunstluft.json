                        ]
                    },
                    {
                        "translation_id": "6be3f5fb-cb42-46b3-945e-e38311decb57",
                        "source_entry_id": "279bd59f-8bea-3563-bcbb-b495d1029ee8",
                        "source_sense_id": "899d57ea-b69b-3f2e-ad64-3b5a28d30499",
                        "source_sense_description": "bildlich: das von Kunst geprägte Ambiente eines Ortes",
                        "target_lang_word": "artsy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artsy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9603a56-80ba-3655-9d43-300163bea9c9",
                                        "entry_id": "b0d4cf27-d8cd-369c-b7f2-7c77f1c0133d",
                                        "glosses": [
                                            "Alternative form of artsie."
                                        ],
                                        "tags": [
