                        "examples": [
                            {
                                "example_id": "0156e95f-3059-413c-99b7-f4dd1e26f821",
                                "sense_id": "4f85a6b2-4cf5-37d7-a2b0-1238f236915c",
                                "text": "Les yeux se ferment, le monde se manifeste en nous, car lorsque la maîtrise de cette mudrâ est atteinte, nous sommes la divinité, il n’y a plus désormais intérieur et extérieur, mais totalité baignée par la conscience omniprésente"
                            },
                            {
                                "example_id": "c7efd0d2-a6d2-47ef-81ea-3b01635e8585",
                                "sense_id": "4f85a6b2-4cf5-37d7-a2b0-1238f236915c",
                                "text": "La plupart des mudrâs sont des gestes de compassion ou d’apaisement mais il existe également des mudrâs des formes terribles émanant, le plus souvent, de divinités."
                            },
                            {
                                "example_id": "42c5130b-49b3-4cd6-abac-c9c8b7f8643a",
                                "sense_id": "4f85a6b2-4cf5-37d7-a2b0-1238f236915c",
                                "text": "Un mudrâ est une posture en relation avec l'infiniment petit, et en lien avec les postures du corps dans l'infiniment grand."
                            }
                        ]
                    }
