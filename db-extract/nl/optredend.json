        "nl-extract.jsonl": [
            {
                "entry_id": "08104a04-4731-3fac-818c-1509f6033c52",
                "word": "optredend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea8b3b1d-d1f8-35d2-8c4b-a3c43db884d4",
                        "entry_id": "08104a04-4731-3fac-818c-1509f6033c52",
                        "glosses": [
                            "wat plaatsvindt; wat zich voordoet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5d46e6-69ce-40f9-a540-46422b51785f",
                                "sense_id": "ea8b3b1d-d1f8-35d2-8c4b-a3c43db884d4",
                                "text": "Een goede vierseizoenenband vind ik een verstandige keuze. Het Nederlandse klimaat is grillig en door de grote en zeer frequent optredende verschillen in het weer en de temperatuur loop je in de winter te vaak het risico dat winterbanden slechter presteren dan zomerbanden."
                            },
                            {
                                "example_id": "12004dcc-ab78-4d38-bd5f-e2812f4d5402",
                                "sense_id": "ea8b3b1d-d1f8-35d2-8c4b-a3c43db884d4",
                                "text": "Uit een studie in 2013 van Royal Haskoning DHV blijkt dat 22 daarvan een hoger risico hebben, bijvoorbeeld vanwege activiteiten aan het oppervlak. Ook de diepte en omtrek van de mogelijk optredende bodemdaling telt mee in het bepalen van het risico."
                            }
                        ]
                    },
                    {
                        "sense_id": "60242c37-547a-308d-bfc8-bbebdc7cb7c6",
                        "entry_id": "08104a04-4731-3fac-818c-1509f6033c52",
                        "glosses": [
                            "van artiesten dat ze een voorstelling geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19416b9d-883f-4d8b-b8b4-7fc7d2a85754",
                                "sense_id": "60242c37-547a-308d-bfc8-bbebdc7cb7c6",
                                "text": "Topdrukte op het eiland, wederom. Was het zaterdag om de optredende artiesten, nu stroomt het Waalstrand vol voor het vuurwerk."
                            }
                        ]
                    }
