                            {
                                "example_id": "88809265-9e30-407e-8317-86ca4c143320",
                                "sense_id": "82540a45-7d44-3109-9f6e-43301dc2d87c",
                                "text": "Слезть с дерева. Слезть с крыши. Слезть с лошади."
                            }
