                        "examples": [
                            {
                                "example_id": "47cf067f-a2e4-410b-985b-dec808aed628",
                                "sense_id": "15bfe4d3-3edf-32b9-bcaf-e9da1e30bfc1",
                                "text": "Damit ist eigentlich schon die sogenannte Weihnachtspyramide, die in Sachsen, im Erzgebirge, in Hessen und in Berlin an Stelle des Weihnachtsbaumes gebräuchlich ist, beschrieben.",
                                "translation": "This actually describes the so-called Christmas pyramid, which is used in place of the Christmas tree in Saxony, the Ore Mountains, Hesse and Berlin.",
                                "english": "This actually describes the so-called Christmas pyramid, which is used in place of the Christmas tree in Saxony, the Ore Mountains, Hesse and Berlin."
                            },
                            {
                                "example_id": "b00de491-3ee8-4cb5-8351-e1bd089457ee",
                                "sense_id": "15bfe4d3-3edf-32b9-bcaf-e9da1e30bfc1",
                                "text": "Der Bamberger Weihnachtsmarkt hat 2023 eine neue, fast elf Meter hohe Attraktion: eine Weihnachtspyramide.",
                                "translation": "The Bamberg Christmas market has a new, almost eleven meter high attraction in 2023: a Christmas pyramid.",
                                "english": "The Bamberg Christmas market has a new, almost eleven meter high attraction in 2023: a Christmas pyramid."
                            }
                        ]
                    }
