                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec512b8b-b410-467f-be03-8223d2da7026",
                                "sense_id": "1d0c85f7-e1e9-310c-b017-44f9ceffb0b7",
                                "text": "„Roms Einwohnerschaft hatte sich halbiert; die Städte Oberitaliens waren zu primitiven Wohnformen zurückgekehrt.“"
                            },
                            {
                                "example_id": "8c107b54-b8c9-4d12-b211-4fcad82ac108",
                                "sense_id": "1d0c85f7-e1e9-310c-b017-44f9ceffb0b7",
                                "text": "„In den Städten traf der Nahrungsmangel Einwohnerschaft wie einquartierte Soldaten häufig in gleicher Weise.“"
                            },
                            {
                                "example_id": "bea9c1d2-387c-427f-95f8-dbf0d923624e",
                                "sense_id": "1d0c85f7-e1e9-310c-b017-44f9ceffb0b7",
                                "text": "„Außerdem meinte er, durch die Berührung mit Menschen verschiedener Art Willen und Charakter der Einwohnerschaft besser kennenzulernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
