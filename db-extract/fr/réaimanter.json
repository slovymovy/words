                        "glosses": [
                            "Aimanter une seconde fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e5cc6bd-ed7a-4b02-866c-cda29f019de0",
                                "sense_id": "99385653-71ae-35fa-948a-d71e076d02de",
                                "text": "Ayant aimanté l’aiguille avec soin, je tiens note de son angle d’inclinaison sur le cercle de la boussole ; je renverse ensuite à l’ordinaire l’aiguille sans la réaimanter, et j’observe de nouveau son inclinaison, qui n’est le plus souvent la même que parce que l’ouvrier, avant de livrer la boussole, les a fait concourir ; ce qui ne prouve pas par conséquent que la direction trouvée soit la véritable."
                            }
                        ]
                    }
