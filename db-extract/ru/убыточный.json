                                        "glosses": [
                                            "Qui se solde par un déficit comptable : non rentable."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e7528e3-093e-4659-95c1-f5a1ce1ffcb8",
                                                "sense_id": "88d08cdf-8472-3fac-bd28-1d13b6e10f78",
                                                "text": "Le ministre a présenté un budget déficitaire."
                                            },
                                            {
                                                "example_id": "68426bfe-1523-4912-9060-f808f4e2f983",
                                                "sense_id": "88d08cdf-8472-3fac-bd28-1d13b6e10f78",
                                                "text": "L’érosion du marché a rendu l’entreprise déficitaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53058b2d-2b24-3541-b543-cf91d528c22f",
                                        "entry_id": "47acdf24-504d-382e-bade-865dded368bc",
                                        "glosses": [
                                            "Qui est insuffisant ; qui se solde par un manque, une pénurie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afbf87d1-bc78-474d-854c-21b25b16c9e4",
                                                "sense_id": "53058b2d-2b24-3541-b543-cf91d528c22f",
                                                "text": "Récolte déficitaire, qui est inférieure en rendement aux besoins de la consommation."
                                            },
                                            {
                                                "example_id": "88c323f2-162a-4eed-a1b0-8bb8c624870b",
                                                "sense_id": "53058b2d-2b24-3541-b543-cf91d528c22f",
                                                "text": "Certaines personnes ont une attention déficitaire : il ne peuvent se concentrer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
