                        "examples": [
                            {
                                "example_id": "5409e294-d2ad-498c-8fa0-a92210a06cd7",
                                "sense_id": "d6740c86-be3c-36f9-aabd-21562655ece6",
                                "text": "De uitgeputte goudmijn was al jaren gesloten, maar door nieuwe technologie werd het mogelijk het afval opnieuw te gaan bewerken."
