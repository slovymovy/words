    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a851dfa-e1fd-3350-9eba-97a8e247d651",
                    "sense_definition": "Manquer à la fidélité ou à la parole donnée envers quelqu'un ; tromper délibérément sa confiance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il pensait pouvoir compter sur lui, mais son associé a fini par le <w>trahir</w>."
                        },
                        {
                            "text": "Un véritable ami ne te <w>trahira</w> jamais, quoi qu'il arrive dans la vie."
                        }
                    ],
                    "common_phrases": [
                        "trahir un ami",
                        "trahir quelqu'un"
                    ]
                },
                {
                    "sense_id": "a53e6d38-d671-347e-b4bf-3ad2dd1e6ed9",
                    "sense_definition": "Ne pas respecter un engagement moral, un serment, un principe ou une promesse.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En votant cette loi, le député a <w>trahi</w> tous les principes qu'il défendait jusque-là."
                        },
                        {
                            "text": "Le président a été accusé de <w>trahir</w> ses promesses électorales peu après son élection."
                        }
                    ],
                    "common_phrases": [
                        "trahir la confiance",
                        "trahir une promesse",
                        "trahir un secret"
                    ]
                },
                {
                    "sense_id": "3de1fee5-e1a2-37b7-b39e-cd8265f12f53",
                    "sense_definition": "Livrer son pays ou son camp à des ennemis par félonie ou déloyauté.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "haute_trahison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant le conflit, cet officier a choisi de <w>trahir</w> sa patrie en vendant des documents secrets."
                        },
                        {
                            "text": "Les soldats qui refusent de combattre ne cherchent pas pour autant à <w>trahir</w> leur pays."
                        }
                    ],
                    "synonyms": [
                        "retourner sa veste"
                    ],
                    "common_phrases": [
                        "trahir sa patrie",
                        "trahir son pays"
                    ]
                },
                {
                    "sense_id": "0e4a19f9-0bd6-3587-8481-48fc8a623cf4",
                    "sense_definition": "Laisser paraître ou révéler involontairement ce qu'on souhaitait dissimuler.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "revelation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bien qu'il garde un visage impassible, le tremblement de ses mains <w>trahit</w> sa peur."
                        },
                        {
                            "text": "Son regard hésitant a fini par <w>trahir</w> le mensonge qu'elle tentait de dissimuler."
                        }
                    ],
                    "common_phrases": [
                        "trahir ses émotions",
                        "regard qui trahit"
                    ]
                },
                {
                    "sense_id": "cfc7a48d-6638-3e53-ae48-f78215ee201c",
                    "sense_definition": "Faire défaut au moment décisif, en parlant des forces physiques, des sens ou des facultés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defaillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au bout de plusieurs heures de marche intense dans la neige, ses jambes ont commencé à le <w>trahir</w>."
                        },
                        {
                            "text": "Lors de son discours officiel, la voix de l'orateur l'a soudainement <w>trahi</w> sous le coup de l'émotion."
                        }
                    ],
                    "common_phrases": [
                        "mémoire qui trahit",
                        "forces qui trahissent"
                    ]
                },
                {
                    "sense_id": "9d1523cc-d72f-3dc0-bbfe-cd59a296bdfc",
                    "sense_definition": "Dévoiler involontairement sa propre culpabilité, son identité secrète ou ses intentions cachées.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "revelation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En donnant trop de détails inutiles aux enquêteurs, le suspect s'est <w>trahi</w> sans s'en rendre compte."
                        },
                        {
                            "text": "Elle essayait de paraître calme, mais un lapsus révélateur l'a poussée à se <w>trahir</w>."
                        }
                    ],
                    "common_phrases": [
                        "se trahir soi-même"
                    ]
                },
                {
                    "sense_id": "cbaaedf9-8c53-30c9-bc21-f787734ab068",
                    "sense_definition": "Surprendre à l'improviste un animal ou une personne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chasseur avançait en silence dans la forêt, espérant <w>trahir</w> un lièvre au détour du chemin."
                        },
                        {
                            "text": "Il a réussi à <w>trahir</w> l'animal tapi sous les broussailles avant qu'il ne s'enfuie."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sens vieilli et rare"
                        }
                    ]
                }
            ]
        }
