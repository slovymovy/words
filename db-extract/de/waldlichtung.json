                ],
                "senses": [
                    {
                        "sense_id": "d6f9e847-330c-3f0e-b650-d9d4396c9500",
                        "entry_id": "1e26b8e5-2d58-3722-a96c-1d3965c134b8",
                        "glosses": [
                            "eine nicht mit Bäumen bewachsene Fläche in einem Wald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e12d9c4-3c52-45c3-b842-abe540463329",
                                "sense_id": "d6f9e847-330c-3f0e-b650-d9d4396c9500",
                                "text": "„Wir saßen auf der Waldlichtung.“"
                            },
                            {
                                "example_id": "aed83b7a-db16-4ad2-97ab-a0958a8a3d6a",
                                "sense_id": "d6f9e847-330c-3f0e-b650-d9d4396c9500",
                                "text": "„Dann nehme ich mir etwas zu essen mit und mache irgendwo auf einer lauschigen Waldlichtung ein Picknick.“"
                            },
                            {
                                "example_id": "c9b7fd8c-67ee-4938-897c-764eb3f67d2d",
                                "sense_id": "d6f9e847-330c-3f0e-b650-d9d4396c9500",
                                "text": "„Darum tappe ich eines Tages geradewegs unter drei Russen, die auf einer Waldlichtung im Grase liegen und die Flaschen kreisen lassen.“"
                            },
                            {
                                "example_id": "a12ee1a6-eb0d-459b-9633-2012c2bc2e58",
                                "sense_id": "d6f9e847-330c-3f0e-b650-d9d4396c9500",
                                "text": "„Pat und ich saßen am Rande einer Waldlichtung und frühstückten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
