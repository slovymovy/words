{
    "word_family": [
        "particulate",
        "particular",
        "part"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b998424d-ea75-3805-8264-9843ebfcf9dc",
                    "sense_definition": "A very small piece of matter or a fragment of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "small_piece",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air was filled with a tiny <w>particle</w> of dust that shimmered in the sunlight.",
                            "target_lang_translations": {
                                "ru": "Воздух был наполнен крошечными <w>частицами</w> пыли, которые мерцали в солнечном свете."
                            }
                        },
                        {
                            "text": "He found a <w>particle</w> of food stuck between his teeth after lunch.",
                            "target_lang_translations": {
                                "ru": "После обеда он обнаружил <w>частицу</w> еды, застрявшую между зубами."
                            }
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "fragment",
                        "piece",
                        "speck",
                        "grain"
                    ],
                    "antonyms": [
                        "chunk",
                        "hunk",
                        "mass"
                    ],
                    "common_phrases": [
                        "dust particle",
                        "particle of food",
                        "tiny particle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленькая часть материи или фрагмент чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "частица",
                                "target_lang_sense_clarification": "маленький кусочек материи"
                            },
                            {
                                "target_lang_word": "крупица",
                                "target_lang_sense_clarification": "крошечный фрагмент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c51544fd-2407-3f51-bb83-20d72e9e516d",
                    "sense_definition": "A very small amount or a tiny bit of a quality or feeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is not a <w>particle</w> of truth in the rumors being spread about him.",
                            "target_lang_translations": {
                                "ru": "В слухах, которые о нем распространяют, нет ни <w>доли</w> правды."
                            }
                        },
                        {
                            "text": "The new evidence did not make a <w>particle</w> of difference to the final verdict.",
                            "target_lang_translations": {
                                "ru": "Новые улики не внесли ни <w>капли</w> изменений в окончательный вердикт."
                            }
                        }
                    ],
                    "synonyms": [
                        "iota",
                        "jot",
                        "whit",
                        "shred",
                        "trace"
                    ],
                    "antonyms": [
                        "abundance",
                        "deal",
                        "lot"
                    ],
                    "common_phrases": [
                        "particle of truth",
                        "particle of evidence",
                        "not a particle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень малое количество или крошечная доля качества или чувства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "малое количество чувства или качества"
                            },
                            {
                                "target_lang_word": "крупица",
                                "target_lang_sense_clarification": "минимальное количество, например, правды"
                            },
                            {
                                "target_lang_word": "капля",
                                "target_lang_sense_clarification": "переносное значение малого количества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f074d4a5-fa32-3fc6-a764-ef8c909993e2",
                    "sense_definition": "A subatomic object that is a constituent part of an atom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists use a large accelerator to study the behavior of a subatomic <w>particle</w>.",
                            "target_lang_translations": {
                                "ru": "Ученые используют большой ускоритель для изучения поведения субатомных <w>частиц</w>."
                            }
                        },
                        {
                            "text": "An elementary <w>particle</w> like an electron carries a negative electric charge.",
                            "target_lang_translations": {
                                "ru": "Элементарная <w>частица</w>, такая как электрон, несет отрицательный электрический заряд."
                            }
                        }
                    ],
                    "synonyms": [
                        "atom",
                        "molecule"
                    ],
                    "common_phrases": [
                        "subatomic particle",
                        "elementary particle",
                        "alpha particle"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Субатомный объект, являющийся составной частью атома."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "частица",
                                "target_lang_sense_clarification": "физический термин, например, элементарная частица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb7d8588-ecb9-30da-8df3-a83dc5ca81c0",
                    "sense_definition": "A word that does not change its form and has little lexical meaning, used to indicate grammatical relationships.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the phrasal verb look up, the word up functions as a grammatical <w>particle</w>.",
                            "target_lang_translations": {
                                "ru": "В фразовом глаголе look up слово up функционирует как грамматическая <w>частица</w>."
                            }
                        },
                        {
                            "text": "The teacher explained how a negative <w>particle</w> is used to change the meaning of the sentence.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил, как отрицательная <w>частица</w> используется для изменения смысла предложения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grammatical particle",
                        "negative particle",
                        "infinitive particle"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, которое не меняет свою форму и имеет мало лексического значения, используемое для указания грамматических отношений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "частица",
                                "target_lang_sense_clarification": "лингвистический термин, служебная часть речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ba81ec5-b1f2-35b6-a944-c3b457f4749d",
                    "sense_definition": "A small piece of consecrated bread used in religious services.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest carefully gathered every <w>particle</w> of the host after the communion service.",
                            "target_lang_translations": {
                                "ru": "Священник тщательно собрал каждую <w>частицу</w> Агнца после службы причастия."
                            }
                        },
                        {
                            "text": "In some traditions, a small <w>particle</w> is dropped into the chalice during the liturgy.",
                            "target_lang_translations": {
                                "ru": "В некоторых традициях во время литургии в чашу опускается небольшая <w>частица</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "crumb"
                    ],
                    "common_phrases": [
                        "consecrated particle"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "ecclesiastical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький кусочек освященного хлеба, используемый в религиозных службах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "частица",
                                "target_lang_sense_clarification": "церковный термин, часть Святых Даров"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}