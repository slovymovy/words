                        "glosses": [
                            "Instrument inventé par François Cointeraux en 1802 et employé dans la construction des fourneaux et des pierres factices."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a85c062a-7d3b-4146-a52b-6c07d0f728d8",
                                "sense_id": "5b7590f8-94f8-3468-b2a9-4f234aab07b3",
                                "text": "La crécise est une presse en bois destinée à fabriquer des briques de pisé, des pierres artificielles, ou tout autre matériau devant être pressé."
                            },
                            {
                                "example_id": "ca746ca6-b07c-4771-bbd3-7e5aa736e5a0",
                                "sense_id": "5b7590f8-94f8-3468-b2a9-4f234aab07b3",
                                "text": "A l’instant le maître ôte le mandrin, tourne la crécise, le moëllon tombe, la crécise est remise en place, tout cela n’est l’affaire que d’un moment, et on recommence."
                            }
                        ]
                    }
