                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abenteurertum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f1dd89b-d106-3e27-a287-be571618a767",
                                        "entry_id": "c9b08332-e0f5-3e3f-84db-059d370cb68a",
                                        "glosses": [
                                            "Lebensweise eines Abenteurers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddd50903-f6e0-4ff2-bb62-14a6ac85c7bb",
                                                "sense_id": "1f1dd89b-d106-3e27-a287-be571618a767",
                                                "text": "„Denn das Erhabenheitserlebnis verlangt, dass es erhabene Ideen sind, die der Anblick der unendlich überlegenen Natur in uns heraufruft; solche Ideen aber sind mit Abenteurertum nicht verbunden.“"
                                            },
                                            {
                                                "example_id": "e646b503-14d4-4b6a-a523-a9239715a339",
                                                "sense_id": "1f1dd89b-d106-3e27-a287-be571618a767",
                                                "text": "„Russlands Staatspräsident Wladimir Putin kritisiert auf der Münchner Sicherheitskonferenz heftig die Politik der USA und wirft Washington wegen des geplanten US-Raketenabwehrsystems militärisches Abenteurertum vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a7dc208-a385-4a9d-8995-9e1bb562c5a1",
                        "source_entry_id": "9a956a3e-4e1e-3d66-8b90-945287d6ca18",
                        "source_sense_id": "88d012f4-4acd-37d4-a66a-e9b5610e0456",
                        "source_sense_description": "tendance à une conduite aventureuse des affaires",
