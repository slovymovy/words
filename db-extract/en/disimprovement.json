                "senses": [
                    {
                        "sense_id": "cd27e7ed-fa04-3c4a-b3a2-816a89472229",
                        "entry_id": "9ac78c06-1c64-316f-8e0d-ef5d59373c37",
                        "glosses": [
                            "Reduction from a better to a worse state."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0b0746a3-8ba1-420c-b1f7-18dbb63641b4",
                                "sense_id": "cd27e7ed-fa04-3c4a-b3a2-816a89472229",
                                "text": "[...] '[T]is very reaſonable, that all ſhould be obliged to the Law of Justice. [...] And as to the Public, 'twould be all one as if there were no Property; and then for want of Encouragement and Security, the final iſſue of the matter would be, an utter neglect and diſimprovement of the Earth, and a continual diſturbance of the Public Peace."
                            },
                            {
                                "example_id": "03610d26-1da2-4385-97f8-216ade3ef8b9",
                                "sense_id": "cd27e7ed-fa04-3c4a-b3a2-816a89472229",
                                "text": "From day to day the intelligent student can watch the course of the affection before him, notice the finest shades of improvement or disimprovement, test the results of treatment, and verify for himself the truth of both diagnosis and prognosis."
                            },
                            {
                                "example_id": "1636b38a-09a5-4af0-b3db-80e7985d2ee0",
                                "sense_id": "cd27e7ed-fa04-3c4a-b3a2-816a89472229",
                                "text": "There is an appeal to methods like simulated annealing and threshold acceptance that make no recourse to memory, but that operate simply by imposing a monotonically declining ceiling on objective function levels or degrees of disimprovement (treated probabilistically or deterministically)."
                            },
                            {
                                "example_id": "ec099359-6da9-43f1-ab65-7f9a7a2883dc",
                                "sense_id": "cd27e7ed-fa04-3c4a-b3a2-816a89472229",
                                "text": "[Marina] Carr's transposition of Aeschylus into the twenty first century, somewhat removed from the tragedic forms of ancient Greek writing, reflects some of the disimprovements of contemporary Irish life brought about by power and greed."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3f9fd3e-6ad2-374f-b635-e88f644a46ce",
                        "entry_id": "9ac78c06-1c64-316f-8e0d-ef5d59373c37",
                        "glosses": [
                            "attempt to make something better while ending up worse than before."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "rare",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f07ee93-0832-4d23-83fe-b29bec7d87d5",
                        "source_entry_id": "9ac78c06-1c64-316f-8e0d-ef5d59373c37",
                        "source_sense_description": "reduction from a better to a worse state — see also deterioration",
                        "target_lang_word": "Verschlimmbesserung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschlimmbesserung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0ffa26e-b20e-3a68-abfb-faa9561d3163",
                                        "entry_id": "325c8c05-b64b-3735-8365-cd70548e4abe",
                                        "glosses": [
                                            "beabsichtigte Verbesserung, die real aber eine Verschlimmerung, Verschlechterung einer Sache, eines Zustandes, Prozesses oder Ähnlichem bewirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "401b50a0-88b5-4960-a86a-9242a7aa8169",
                                                "sense_id": "c0ffa26e-b20e-3a68-abfb-faa9561d3163",
                                                "text": "Der Artikel war nach mehreren Verschlimmbesserungen verschiedener Autoren unbrauchbar geworden."
                                            },
                                            {
                                                "example_id": "875b9fe0-d2a5-4ffb-9536-37bf723249af",
                                                "sense_id": "c0ffa26e-b20e-3a68-abfb-faa9561d3163",
                                                "text": "„Führen solche Arbeiten zu einer \"Verschlimmbesserung\" der Wohnung, kann der Vermieter sogar Schadensersatz fordern.“"
                                            },
                                            {
                                                "example_id": "67adaca9-39af-4ec3-904b-6bb16d809c63",
                                                "sense_id": "c0ffa26e-b20e-3a68-abfb-faa9561d3163",
                                                "text": "„Diese Formulierung ist eher eine Verschlimmbesserung: Wenn die Ganztagsbetreuung an Berufstätigkeit geknüpft wird, dann hat man das Gegenteil von dem erreicht, was man wollte:…“"
                                            },
                                            {
                                                "example_id": "9b76a1f2-6a6a-498b-a2b1-afe0525c235a",
                                                "sense_id": "c0ffa26e-b20e-3a68-abfb-faa9561d3163",
                                                "text": "„Das ist ein Witz nach dem Muster der Verschlimmbesserung, wo sich Familienmitglieder, um den Fehler des vorher Sprechenden gutzumachen, sozusagen um Kopf und Kragen reden.“"
                                            },
                                            {
                                                "example_id": "a27216c7-b8ea-4509-9864-cc1113f86ad5",
                                                "sense_id": "c0ffa26e-b20e-3a68-abfb-faa9561d3163",
                                                "text": "„Ich halte viele der besprochenen Schreib-»Verbesserungen« für Verschlimmbesserungen, für philologische Besserwisserei, die unter den allermeisten Sprach- und das heißt: Schriftteilhaberinnen und -teilhabern Frustration auslösen muss und tatsächlich auslöst, Unverständnis, Ablehnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
