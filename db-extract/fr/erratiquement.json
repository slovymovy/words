                                        "glosses": [
                                            "Without an aim, purpose or direction; in an aimless manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a59e5923-6913-44a3-9762-ca85f01f5a00",
                                                "sense_id": "4af25744-3e29-3467-9b02-cb419c9a039b",
                                                "text": "He wandered aimlessly through the crowd."
                                            },
                                            {
                                                "example_id": "9130ca90-c533-44c5-9f92-1b490bfa04a2",
                                                "sense_id": "4af25744-3e29-3467-9b02-cb419c9a039b",
                                                "text": "Half a dozen deserted boats pitched aimlessly upon the confusion of the waves."
                                            },
                                            {
                                                "example_id": "236098e2-003c-497d-8986-49c838d654ad",
                                                "sense_id": "4af25744-3e29-3467-9b02-cb419c9a039b",
                                                "text": "But now, as I strolled out on the lawn, still nursing a grudge against my friend’s high-handedness, I saw Lawrence on the croquet lawn, aimlessly knocking a couple of very ancient balls about, with a still more ancient mallet."
                                            },
                                            {
                                                "example_id": "d9858216-7ddd-4977-a37e-1d6bf2d8e412",
                                                "sense_id": "4af25744-3e29-3467-9b02-cb419c9a039b",
                                                "text": "The player is free to create their own narrative within a much larger set of possible designed narrative options, or, given the geographic and dialogical openness of Morrowind, to refuse the creation of any narrative but their own and wander aimlessly through the game."
                                            }
                                        ]
                                    }
