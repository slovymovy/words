                        "glosses": [
                            "Donner les caractéristiques de la classe moyenne à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e9320d0-47c6-4b20-8c67-0629c5d83b53",
                                "sense_id": "1c9a2052-d679-34ed-baa9-f9142856065c",
                                "text": "Cela rend compte du processus sociodémographique récent qui « moyennise » la population marseillaise (AGAM, 2009)."
                            }
                        ]
                    },
                    {
                        "sense_id": "75ee75f4-968b-33fb-a8c6-0b51bc56aba1",
                        "entry_id": "8c49c4af-5e55-3427-a720-57116d575635",
                        "glosses": [
                            "Pour une société, se confondre peu à peu avec la classe moyenne, qui y est surreprésentée."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "774561b5-a34b-41fa-b721-57df7475892a",
                                "sense_id": "75ee75f4-968b-33fb-a8c6-0b51bc56aba1",
                                "text": "Le revenu mondial se moyennise-t-il?"
                            },
                            {
                                "example_id": "f708855b-6edc-4d4e-98bd-c63523ff4fa1",
                                "sense_id": "75ee75f4-968b-33fb-a8c6-0b51bc56aba1",
                                "text": "Si la plus grande partie de la société se moyennise, on ne peut plus parler de classe sociale."
                            }
                        ]
                    }
