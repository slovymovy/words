{
    "word_family": [
        "unification",
        "unifier",
        "unity",
        "unit",
        "reunify",
        "disunify"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76c3b87c-96b6-3163-8d5d-d817613999bf",
                    "sense_definition": "To bring separate parts together to form a single unit or whole.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "combine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new leader hopes to <w>unify</w> the country after years of internal conflict and division.",
                            "target_lang_translations": {
                                "ru": "Новый лидер надеется <w>объединить</w> страну после многих лет внутренних конфликтов и разделения."
                            }
                        },
                        {
                            "text": "The manager worked hard to <w>unify</w> the team under a single vision for the project.",
                            "target_lang_translations": {
                                "ru": "Менеджер усердно работал над тем, чтобы <w>сплотить</w> команду вокруг единого видения проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "unite",
                        "merge",
                        "combine",
                        "consolidate",
                        "join"
                    ],
                    "antonyms": [
                        "divide"
                    ],
                    "common_phrases": [
                        "unify the country",
                        "unify the team",
                        "unify under one"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять отдельные части для создания единого целого или подразделения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединять",
                                "target_lang_sense_clarification": "собирать части в одно целое"
                            },
                            {
                                "target_lang_word": "объединить",
                                "target_lang_sense_clarification": "сделать единым, сплотить"
                            },
                            {
                                "target_lang_word": "сплачивать",
                                "target_lang_sense_clarification": "делать единодушным, тесно связывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdeaba71-45da-3cb7-ad88-2df85d056e3e",
                    "sense_definition": "To become one or merge into a single entity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "combine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this scientific model, all different forces <w>unify</w> into one single fundamental interaction at high energy.",
                            "target_lang_translations": {
                                "ru": "В этой научной модели все различные силы <w>объединяются</w> в одно фундаментальное взаимодействие при высоких энергиях."
                            }
                        },
                        {
                            "text": "The various streams eventually <w>unify</w> into a large river that flows toward the sea.",
                            "target_lang_translations": {
                                "ru": "Различные ручьи в конечном итоге <w>сливаются</w> в большую реку, текущую к морю."
                            }
                        }
                    ],
                    "synonyms": [
                        "coalesce",
                        "fuse",
                        "blend"
                    ],
                    "antonyms": [
                        "divide"
                    ],
                    "common_phrases": [
                        "unify into one",
                        "unify into silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться единым целым или сливаться в одну сущность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединяться",
                                "target_lang_sense_clarification": "становиться единым целым"
                            },
                            {
                                "target_lang_word": "объединиться",
                                "target_lang_sense_clarification": "слиться в одну структуру"
                            },
                            {
                                "target_lang_word": "сливаться",
                                "target_lang_sense_clarification": "соединяться в один поток или массу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}