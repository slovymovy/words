                                    },
                                    {
                                        "sense_id": "320d865f-46ad-3cfa-a246-ceefcca24d17",
                                        "entry_id": "13ecbac4-ab93-3472-adbb-392c48b75c06",
                                        "glosses": [
                                            "speziell der echte Beinwell"
                                        ],
                                        "tags": [
                                            "Symphytum officinale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a67837-bec8-4c9a-8cf1-0e0f33ab40b0",
                                                "sense_id": "320d865f-46ad-3cfa-a246-ceefcca24d17",
                                                "text": "Der Beinwell wird als Heilpflanze gegen Prellungen, Verzerrungen und Verstauchungen geschätzt."
                                            }
