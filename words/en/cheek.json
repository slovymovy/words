{
    "word_family": [
        "cheeky",
        "cheekily",
        "cheekiness",
        "cheekbone"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "656f46c2-6da8-37c6-9b4d-8834e6767fde",
                    "sense_definition": "The soft skin on each side of the face, below the eyes; the outer surface of the sides of the oral cavity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tears rolled down her <w>cheeks</w> as she watched the sad movie.",
                            "target_lang_translations": {
                                "ru": "Слёзы катились по её <w>щекам</w>, когда она смотрела грустный фильм.",
                                "zh": "她看那部悲伤的电影时，泪水顺着她的<w>脸颊</w>流了下来。"
                            }
                        },
                        {
                            "text": "He gave his grandmother a gentle kiss on the <w>cheek</w>.",
                            "target_lang_translations": {
                                "ru": "Он нежно поцеловал бабушку в <w>щёку</w>.",
                                "zh": "他轻轻地亲了亲祖母的<w>脸颊</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "turn the other cheek",
                        "tongue-in-cheek",
                        "cheek to cheek",
                        "rosy cheeks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая часть лица с каждой стороны, ниже глаз; внешняя поверхность боковых стенок ротовой полости.",
                        "zh": "脸上眼睛下方两侧柔软的部分；也可指口腔两侧内壁的相应部位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щека",
                                "target_lang_sense_clarification": "часть лица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脸颊",
                                "target_lang_sense_clarification": "脸两侧柔软的部分"
                            },
                            {
                                "target_lang_word": "面颊",
                                "target_lang_sense_clarification": "较书面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29f14f4f-b6f1-3747-a15c-4a7997bce5aa",
                    "sense_definition": "Impudence; disrespectful or rude behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You have got some <w>cheek</w> asking for a favor after what you did!",
                            "target_lang_translations": {
                                "ru": "Какая <w>наглость</w> просить об одолжении после того, что ты сделал!",
                                "zh": "你做了那样的事之后，竟然还有<w>厚脸皮</w>求人帮忙！"
                            }
                        },
                        {
                            "text": "I was shocked by the <w>cheek</w> of the salesman who refused to leave.",
                            "target_lang_translations": {
                                "ru": "Я был шокирован <w>нахальством</w> продавца, который отказывался уходить.",
                                "zh": "那个拒绝离开的推销员的<w>放肆</w>让我很震惊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "impudence",
                        "impertinence",
                        "nerve",
                        "brass neck",
                        "sass",
                        "chutzpah"
                    ],
                    "common_phrases": [
                        "have the cheek",
                        "what a cheek"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наглость; неуважительное или грубое поведение.",
                        "zh": "厚脸皮；无礼或冒犯人的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наглость",
                                "target_lang_sense_clarification": "поведение"
                            },
                            {
                                "target_lang_word": "нахальство",
                                "target_lang_sense_clarification": "поведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厚脸皮",
                                "target_lang_sense_clarification": "口语，指厚着脸皮、无礼的样子"
                            },
                            {
                                "target_lang_word": "放肆",
                                "target_lang_sense_clarification": "指无礼、冒犯的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdf9c014-b417-3db9-ad8c-eddbb3ca0947",
                    "sense_definition": "The fleshy part of the buttocks.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injection was administered in the upper part of the right <w>cheek</w>.",
                            "target_lang_translations": {
                                "ru": "Укол сделали в верхнюю часть правой <w>ягодицы</w>.",
                                "zh": "这一针打在右侧<w>臀部</w>的上方。"
                            }
                        },
                        {
                            "text": "He slipped on the ice and landed hard on one <w>cheek</w>.",
                            "target_lang_translations": {
                                "ru": "Он поскользнулся на льду и сильно упал на одну <w>ягодицу</w>.",
                                "zh": "他在冰上滑倒了，重重地摔在一侧<w>臀部</w>上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "butt cheek",
                        "asscheek",
                        "arsecheek",
                        "nether cheek"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мясистая часть ягодиц.",
                        "zh": "臀部中一侧肉乎乎的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ягодица",
                                "target_lang_sense_clarification": "часть тела"
                            },
                            {
                                "target_lang_word": "полупопие",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "臀部",
                                "target_lang_sense_clarification": "较常用，可指半边屁股"
                            },
                            {
                                "target_lang_word": "臀瓣",
                                "target_lang_sense_clarification": "更强调一侧臀部的肉感部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ff90cf3-9ca1-39a3-9912-a3b331ac9ea2",
                    "sense_definition": "One of the pieces of a machine, timber, or stonework that form corresponding sides or a similar pair.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter adjusted the <w>cheeks</w> of the vice to hold the wood firmly.",
                            "target_lang_translations": {
                                "ru": "Плотник отрегулировал <w>щёки</w> тисков, чтобы крепко зажать дерево.",
                                "zh": "木匠调整了虎钳的<w>钳口</w>，以便把木头牢牢夹住。"
                            }
                        },
                        {
                            "text": "Inspect the <w>cheeks</w> of the block for any signs of wear or cracking.",
                            "target_lang_translations": {
                                "ru": "Осмотрите <w>щёки</w> блока на предмет износа или трещин.",
                                "zh": "检查滑轮组的<w>侧板</w>是否有磨损或裂纹。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из частей механизма, деревянной или каменной конструкции, образующая боковые стороны.",
                        "zh": "机器、木构件或石构件中，构成成对两侧之一的部件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щека",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侧板",
                                "target_lang_sense_clarification": "机械、滑轮等的侧边部件"
                            },
                            {
                                "target_lang_word": "钳口",
                                "target_lang_sense_clarification": "虎钳等夹具两侧夹持部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec8b1510-e809-38ca-8be3-c0744efbc586",
                    "sense_definition": "To speak or behave towards someone in an impudent or disrespectful way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student was sent to the principal's office because he <w>cheeked</w> the teacher.",
                            "target_lang_translations": {
                                "ru": "Ученика отправили к директору, потому что он <w>надерзил</w> учителю.",
                                "zh": "那个学生因为<w>顶撞</w>老师，被送到了校长办公室。"
                            }
                        },
                        {
                            "text": "Don't you dare <w>cheek</w> me when I am trying to help you.",
                            "target_lang_translations": {
                                "ru": "Не смей мне <w>грубить</w>, когда я пытаюсь тебе помочь.",
                                "zh": "我在设法帮你的时候，你可别<w>顶嘴</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или вести себя с кем-то нагло или неуважительно.",
                        "zh": "对某人无礼或不尊重地说话、行事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дерзить",
                                "target_lang_sense_clarification": "грубить"
                            },
                            {
                                "target_lang_word": "грубить",
                                "target_lang_sense_clarification": "проявлять неуважение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顶撞",
                                "target_lang_sense_clarification": "对长辈、老师等无礼地回嘴"
                            },
                            {
                                "target_lang_word": "顶嘴",
                                "target_lang_sense_clarification": "口语，回嘴、冒犯地说话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16dfbaa8-6c88-3ac7-9ac7-afceb5d6dd1c",
                    "sense_definition": "To pull a horse's head back toward the saddle using the cheek strap of the bridle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equestrian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider <w>cheeked</w> the horse to keep it under control before mounting.",
                            "target_lang_translations": {
                                "ru": "Всадник <w>натянул повод</w> лошади, чтобы удержать её под контролем перед посадкой.",
                                "zh": "上马前，骑手先<w>勒住马头</w>，以便控制住它。"
                            }
                        },
                        {
                            "text": "He <w>cheeked</w> the animal firmly and stepped into the stirrup.",
                            "target_lang_translations": {
                                "ru": "Он крепко <w>прихватил</w> животное за щёчный ремень и ступил в стремя.",
                                "zh": "他猛地<w>收缰</w>，然后踩上马镫。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тянуть голову лошади назад к седлу, используя щечный ремень уздечки.",
                        "zh": "用马笼头的颊带把马头朝鞍部方向拉回。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осаживать",
                                "target_lang_sense_clarification": "тянуть голову лошади назад щёчным ремнём уздечки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勒住马头",
                                "target_lang_sense_clarification": "骑术用语，把马头往后带"
                            },
                            {
                                "target_lang_word": "收缰",
                                "target_lang_sense_clarification": "骑术中通过缰绳把马收住"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "53aa2284-0627-34b7-aa5c-507d22cee16e",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Cheek</w> has been working at the firm for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Чик</w> работает в фирме уже более двадцати лет.",
                                "zh": "<w>奇克</w>先生在这家公司工作了二十多年。"
                            }
                        },
                        {
                            "text": "We invited the <w>Cheek</w> family to the neighborhood gathering.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Чик</w> на соседскую вечеринку.",
                                "zh": "我们邀请了<w>奇克</w>一家参加社区聚会。"
                            }
                        }
