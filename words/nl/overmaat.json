                                "target_lang_sense_clarification": "a very large quantity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e0e630f-f4f6-3b6c-9090-707382758315",
                    "sense_definition": "een afmeting die groter is dan de standaard of normale maat",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "afmeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De cilinder werd uitgeboord naar een <w>overmaat</w> om de slijtage te herstellen.",
                            "target_lang_translations": {
