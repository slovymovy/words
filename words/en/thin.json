                            },
                            {
                                "target_lang_word": "водянистый",
                                "target_lang_sense_clarification": "о супе или соусе"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dun",
                                "target_lang_sense_clarification": "van vloeistoffen of soep"
                            },
                            {
                                "target_lang_word": "waterig",
                                "target_lang_sense_clarification": "te dun, zoals water"
                            }
                        ]
