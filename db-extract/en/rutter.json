                    {
                        "sense_id": "8ef8d1dd-aaee-3afb-a1b8-25e16a4204dc",
                        "entry_id": "2affe929-1a4e-38ff-ba77-1dff067ad581",
                        "glosses": [
                            "A set of instructions for navigating a course at sea; a pilot's book or seaman's guide."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2334bdf5-4f06-40ce-afc0-3d0193a49682",
                                "sense_id": "8ef8d1dd-aaee-3afb-a1b8-25e16a4204dc",
                                "text": "But a rutter was only as good as the pilot who wrote it, the scribe who hand-copied it, the very rare printer who printed it, or the scholar who translated it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09696b94-9a98-4db5-b876-4f4db047c7d4",
                        "source_entry_id": "2affe929-1a4e-38ff-ba77-1dff067ad581",
                        "source_sense_id": "8ef8d1dd-aaee-3afb-a1b8-25e16a4204dc",
