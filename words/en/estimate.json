{
    "word_family": [
        "estimation",
        "estimator",
        "overestimate",
        "underestimate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5cdc7b58-7e40-331a-afd3-3b89049b86a8",
                    "sense_definition": "To calculate a number or quantity roughly, often based on incomplete information.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "calc_judge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>estimate</w> that the trip will take about four hours if the traffic is light.",
                            "target_lang_translations": {
                                "ru": "Мы <w>оцениваем</w> время в пути примерно в четыре часа, если не будет пробок.",
                                "tr": "Trafik hafif olursa yolculuğun yaklaşık dört saat süreceğini <w>tahmin ediyoruz</w>."
                            }
                        },
                        {
                            "text": "Scientists <w>estimate</w> the island's population to be around one thousand people.",
                            "target_lang_translations": {
                                "ru": "Ученые <w>оценивают</w> население острова примерно в тысячу человек.",
                                "tr": "Bilim insanları adanın nüfusunu yaklaşık bin kişi olarak <w>tahmin ediyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "approximate",
                        "guess",
                        "judge"
                    ],
                    "common_phrases": [
                        "estimate the cost",
                        "estimate the number",
                        "hard to estimate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приблизительно подсчитывать число или количество, часто основываясь на неполной информации.",
                        "tr": "Genellikle eksik bilgilere dayanarak bir sayıyı veya miktarı yaklaşık olarak hesaplamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценивать",
                                "target_lang_sense_clarification": "производить примерный расчёт"
                            },
                            {
                                "target_lang_word": "прикидывать",
                                "target_lang_sense_clarification": "разг. приблизительно считать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tahmin etmek",
                                "target_lang_sense_clarification": "yaklaşık olarak hesaplamak"
                            },
                            {
                                "target_lang_word": "öngörmek",
                                "target_lang_sense_clarification": "yaklaşık miktar belirlemek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5d0ad8c-c6c8-3caf-9dcd-5a1104f82916",
                    "sense_definition": "To judge or form an opinion about the value, quality, or significance of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calc_judge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often difficult to <w>estimate</w> the true impact of such a major decision.",
                            "target_lang_translations": {
                                "ru": "Часто трудно <w>оценить</w> истинное влияние такого важного решения.",
                                "tr": "Böyle önemli bir kararın gerçek etkisini <w>değerlendirmek</w> genellikle zordur."
                            }
                        },
                        {
                            "text": "She tried to <w>estimate</w> his reaction before telling him the bad news.",
                            "target_lang_translations": {
                                "ru": "Она пыталась <w>оценить</w> его реакцию, прежде чем сообщить плохие новости.",
                                "tr": "Kötü haberi vermeden önce onun tepkisini <w>tahmin etmeye</w> çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "assess",
                        "appraise"
                    ],
                    "common_phrases": [
                        "estimate the value",
                        "estimate the importance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Судить или составлять мнение о ценности, качестве или значимости чего-либо.",
                        "tr": "Bir şeyin değeri, kalitesi veya önemi hakkında bir yargıya varmak veya görüş oluşturmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценивать",
                                "target_lang_sense_clarification": "судить о качестве или значении"
                            },
                            {
                                "target_lang_word": "расценивать",
                                "target_lang_sense_clarification": "воспринимать определенным образом"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değerlendirmek",
                                "target_lang_sense_clarification": "önemini veya değerini tartmak"
                            },
                            {
                                "target_lang_word": "tahmin etmek",
                                "target_lang_sense_clarification": "görüş bildirmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "400b7621-1e75-394c-9a05-b88d2a807394",
                    "sense_definition": "A rough calculation or judgment of the value, size, or cost of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "calc_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you give me a rough <w>estimate</w> of how much the repairs will cost?",
                            "target_lang_translations": {
                                "ru": "Можете дать мне грубую <w>оценку</w> того, во сколько обойдется ремонт?",
                                "tr": "Tamiratın ne kadara mal olacağına dair bana kaba bir <w>tahmin</w> verebilir misiniz?"
                            }
                        },
                        {
                            "text": "According to recent <w>estimates</w>, the company has doubled its revenue this year.",
                            "target_lang_translations": {
                                "ru": "Согласно последним <w>оценкам</w>, в этом году компания удвоила свою выручку.",
                                "tr": "Son <w>tahminlere</w> göre şirket bu yıl gelirini ikiye katladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "estimation",
                        "approximation",
                        "guess"
                    ],
                    "common_phrases": [
                        "rough estimate",
                        "conservative estimate",
                        "make an estimate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приблизительный подсчёт или суждение о ценности, размере или стоимости чего-либо.",
                        "tr": "Bir şeyin değeri, boyutu veya maliyeti hakkında yapılan kabataslak bir hesaplama veya yargı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценка",
                                "target_lang_sense_clarification": "приблизительное суждение"
                            },
                            {
                                "target_lang_word": "подсчёт",
                                "target_lang_sense_clarification": "вычисление"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tahmin",
                                "target_lang_sense_clarification": "yaklaşık hesaplama"
                            },
                            {
                                "target_lang_word": "değerlendirme",
                                "target_lang_sense_clarification": "genel yargı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "938d62a3-703b-3d52-8849-6d8d80ba8b97",
                    "sense_definition": "A document or statement specifying how much a specific job is likely to cost.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calc_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contractor provided a written <w>estimate</w> for the kitchen renovation project.",
                            "target_lang_translations": {
                                "ru": "Подрядчик предоставил письменную <w>смету</w> на проект ремонта кухни.",
                                "tr": "Müteahhit, mutfak yenileme projesi için yazılı bir <w>fiyat teklifi</w> sundu."
                            }
                        },
                        {
                            "text": "We need to get at least three <w>estimates</w> from different builders before we decide.",
                            "target_lang_translations": {
                                "ru": "Нам нужно получить как минимум три <w>сметы</w> от разных строителей, прежде чем мы решим.",
                                "tr": "Karar vermeden önce farklı inşaatçılardan en az üç <w>fiyat teklifi</w> almamız gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "appraisal"
                    ],
                    "common_phrases": [
                        "written estimate",
                        "get an estimate",
                        "provide an estimate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Документ или заявление, указывающее вероятную стоимость определенной работы.",
                        "tr": "Belirli bir işin ne kadara mal olabileceğini belirten belge veya açıklama."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смета",
                                "target_lang_sense_clarification": "документ о предстоящих расходах"
                            },
                            {
                                "target_lang_word": "расчёт",
                                "target_lang_sense_clarification": "калькуляция стоимости"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fiyat teklifi",
                                "target_lang_sense_clarification": "iş maliyeti belgesi"
                            },
                            {
                                "target_lang_word": "keşif özeti",
                                "target_lang_sense_clarification": "maliyet hesabı belgesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e0b7af1-fc00-3440-b010-68530d3c84eb",
                    "sense_definition": "An upper limitation on some positive quantity, used in mathematics and statistics.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The error <w>estimate</w> was derived using a complex formula to ensure accuracy.",
                            "target_lang_translations": {
                                "ru": "<w>Оценка</w> погрешности была получена с использованием сложной формулы для обеспечения точности.",
                                "tr": "Doğruluğu sağlamak için karmaşık bir formül kullanılarak hata <w>kestirimi</w> elde edildi."
                            }
                        },
                        {
                            "text": "Students were asked to calculate the norm <w>estimate</w> for the given data set.",
                            "target_lang_translations": {
                                "ru": "Студентов попросили рассчитать <w>оценку</w> нормы для данного набора данных.",
                                "tr": "Öğrencilerden verilen veri kümesi için norm <w>tahminini</w> hesaplamaları istendi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхнее ограничение положительной величины, используемое в математике и статистике.",
                        "tr": "Matematik ve istatistikte kullanılan, pozitif bir büyüklük üzerindeki üst sınır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценка",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kestirim",
                                "target_lang_sense_clarification": "matematik/istatistik terimi"
                            },
                            {
                                "target_lang_word": "tahmin",
                                "target_lang_sense_clarification": "istatistiksel değer"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6fb7079f-2509-3760-a851-26c34a490e84",
                    "sense_definition": "Calculated roughly; estimated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>estimate</w> wealth of the family was much lower than the rumors suggested.",
                            "target_lang_translations": {
                                "ru": "<w>Оценочное</w> состояние семьи было намного ниже, чем утверждали слухи.",
                                "tr": "Ailenin <w>tahmini</w> serveti, söylentilerin öne sürdüğünden çok daha düşüktü."
                            }
                        },
                        {
                            "text": "He provided an <w>estimate</w> figure rather than an exact count of the supplies.",
                            "target_lang_translations": {
                                "ru": "Он предоставил <w>приблизительную</w> цифру, а не точный подсчет запасов.",
                                "tr": "Malzemelerin kesin sayısından ziyade <w>yaklaşık</w> bir rakam verdi."
                            }
