                    },
                    {
                        "form_id": "6b002f44-7f98-4732-941c-727edd252e7c",
                        "entry_id": "1f9c101b-8dd3-34ee-bab6-85e28ddb033d",
                        "tags": [
                            "past"
                        ],
                        "form": "shadowboxed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db015900-5b00-30ba-bdbc-a9322f7134f8",
                        "entry_id": "1f9c101b-8dd3-34ee-bab6-85e28ddb033d",
                        "glosses": [
                            "To display in a shadowbox."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c700cf7-48cd-403a-9b62-5a44049e89fe",
                                "sense_id": "db015900-5b00-30ba-bdbc-a9322f7134f8",
                                "text": "This is also the time to decide which photos will be shadowboxed, which ones will be popped up, and which will lie flat on the paper."
                            },
                            {
                                "example_id": "82ff1965-a346-45d3-9ab2-b4d73ea08cb4",
                                "sense_id": "db015900-5b00-30ba-bdbc-a9322f7134f8",
                                "text": "The trailer walls were covered with collectable plates, framed fan art, and shadowboxed phasers and tricorders."
                            },
                            {
                                "example_id": "963e2f2b-187e-4306-a145-bc33edee248a",
                                "sense_id": "db015900-5b00-30ba-bdbc-a9322f7134f8",
                                "text": "Awesome is shadowboxed images that float above the site and make your image pop off the screen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4926c577-5fe7-30c3-8f39-cfb750083603",
