                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f16304ea-bd16-4e73-b367-c15d19eee4d9",
                                "sense_id": "bfb5e666-cbbc-3aa4-8f96-1392afedf661",
                                "text": "— Ежели к Егорину идти, — неудобно ночью весь дом булгачить."
                            },
                            {
                                "example_id": "ab5bbffe-05a3-491e-a122-022bb969f9ee",
                                "sense_id": "bfb5e666-cbbc-3aa4-8f96-1392afedf661",
                                "text": "Я тебя по летошнему году помню, как народ у меня булгачил."
                            }
                        ]
                    }
