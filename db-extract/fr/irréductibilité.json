                ],
                "senses": [
                    {
                        "sense_id": "66462951-26d4-3428-a9d1-26ee90697684",
                        "entry_id": "19781f3f-64c7-3d6a-9358-644d85c0c5fb",
                        "glosses": [
                            "Qualité de ce qui est irréductible."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "227d14b0-7070-4122-bf70-b103e43603f4",
                                "sense_id": "66462951-26d4-3428-a9d1-26ee90697684",
                                "text": "L’irréductibilité d’une équation. — L’irréductibilité d’une rente."
                            },
                            {
                                "example_id": "8210e6c6-7fd4-4b7a-a0dc-6e52a23cd503",
                                "sense_id": "66462951-26d4-3428-a9d1-26ee90697684",
                                "text": "Ce type de comportement manifeste ce qu’on appelle une irréductibilité computationnelle."
                            },
                            {
                                "example_id": "24c931e7-068a-4e20-a4ac-b56a46332a1c",
                                "sense_id": "66462951-26d4-3428-a9d1-26ee90697684",
                                "text": "Une doctrine claire c’est d’abord le rejet de ce qui créé la confusion, parce que « le plus difficile c’est de voir ce que l’on voit ». C’est le rejet des « bonnes planques », ces lieux de pensée dont les résidents triés sur le volet accèderaient à un niveau logique supérieur, dont l’attirance est irrésistible : la nuance, la complexité, le doute, l’ambivalence des sentiments, la réduction au cas (concernant les victimes), l’irréductibilité à l’acte (concernant les agresseurs), la possibilité de changer, les principes."
                            },
                            {
                                "example_id": "dc587a7d-eba4-420c-bd3d-b8b5ddfcc6a5",
                                "sense_id": "66462951-26d4-3428-a9d1-26ee90697684",
                                "text": "L’irréductibilité d’un caractère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b0c94d6-f18c-44ba-af52-06b0a979fd00",
                        "source_entry_id": "19781f3f-64c7-3d6a-9358-644d85c0c5fb",
                        "source_sense_id": "66462951-26d4-3428-a9d1-26ee90697684",
                        "target_lang_word": "irreducibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreducibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19be527b-7af0-3034-b45b-07a5078edd56",
                                        "entry_id": "deb55863-117d-3ad0-9627-9fdbab8adc34",
                                        "glosses": [
                                            "The quality or degree of being irreducible."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb047458-f163-4249-ac5a-5f0d94a1a502",
                                                "sense_id": "19be527b-7af0-3034-b45b-07a5078edd56",
                                                "text": "I gave them account of what I had seen of the case, of my opinion concerning the irreducibility of the rupture, and that it had no share in the present complaint; at the same time desiring my colleague to examine for himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8f353d2-e8db-3fe0-96e6-8f159ddc8ee2",
                                        "entry_id": "deb55863-117d-3ad0-9627-9fdbab8adc34",
                                        "glosses": [
                                            "Something that is irreducible."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee99b463-133e-4431-a7a4-29956486a551",
                                                "sense_id": "d8f353d2-e8db-3fe0-96e6-8f159ddc8ee2",
                                                "text": "There is plebs in bodies, in souls, in individuals, in the proletariat, in the bourgeoisie, but everywhere in a diversity of forms and extensions, of energies and irreducibilities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
