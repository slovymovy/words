                    }
                ],
                "senses": [
                    {
                        "sense_id": "62097c91-4148-3fb7-a672-ee212323ac4f",
                        "entry_id": "64479bc3-5fa4-3136-80b9-b19121500876",
                        "glosses": [
                            "Le premier encens qui découle de l’arbre, en grosses larmes, de couleur jaunâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51a06d41-eb02-408d-b028-bb555428d5fb",
                                "sense_id": "62097c91-4148-3fb7-a672-ee212323ac4f",
                                "text": "L’oliban, c’est l’encens avec un grand E, celui que les Rois mages ont apporté avec la myrrhe à l’Enfant Jésus."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ad9ffee-0bbd-37c0-aad1-6a512419b70b",
                        "entry_id": "64479bc3-5fa4-3136-80b9-b19121500876",
                        "glosses": [
                            "Arbre qui donne cet encens, Boswellia sacra Flueck."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7a09783-f5d4-42bc-ac0a-8e3133c222ac",
                        "source_entry_id": "64479bc3-5fa4-3136-80b9-b19121500876",
                        "source_sense_description": "encens",
                        "target_lang_word": "olibanum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olibanum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80404cab-9c2d-31ef-a590-52e1dcd4a14b",
                                        "entry_id": "ac27405a-89f7-33d0-9304-900573eb1cff",
                                        "glosses": [
                                            "A gum resin from trees of the genus Boswellia, formerly used as a medicine and now mainly as incense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d8c17b-0299-4737-8621-d11808d54d07",
                                                "sense_id": "80404cab-9c2d-31ef-a590-52e1dcd4a14b",
                                                "text": "Aromatics were used, too, especially in necromancy, and an old recipe of that sort comprises Musk, Myrrh, Frankincense, Red Storax, Mastick, Olibanum, Saffron, Benzoin and Labdanum."
                                            },
                                            {
                                                "example_id": "3a37a11d-e8c4-41a5-80db-ae206327b1c3",
                                                "sense_id": "80404cab-9c2d-31ef-a590-52e1dcd4a14b",
                                                "text": "Among the Turks, an exciting compound consists of olibanum, myrrh, camphor, musk, in pulverized form. The resultant perfume is said to affect the genitals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "089d03c6-d160-4d49-8cc9-4fb1a6f43be7",
                        "source_entry_id": "64479bc3-5fa4-3136-80b9-b19121500876",
                        "source_sense_description": "encens",
                        "target_lang_word": "frankincense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frankincense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80dc5423-8959-3ada-9253-e1f1e9456d1b",
                                        "entry_id": "7b5565b5-ab3d-35ad-840f-45fc50366ca0",
                                        "glosses": [
                                            "A type of incense obtained from the Boswellia thurifera tree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73091913-75c6-4e98-97bf-9bcf55f99dc4",
                                                "sense_id": "80dc5423-8959-3ada-9253-e1f1e9456d1b",
                                                "text": "The glories of Mary held his soul captive : spikenard and myrrh and frankincense, symbolising the preciousness of God's gifts to her soul, rich garments, symbolising her royal lineage, her emblems, the lateflowering plant and lateblossoming tree, symbolising the agelong gradual growth of her cultus among men."
                                            },
                                            {
                                                "example_id": "92cefbd8-a871-4b7c-ad65-bb7abd924b1b",
                                                "sense_id": "80dc5423-8959-3ada-9253-e1f1e9456d1b",
                                                "text": "Frankincense, Frankenstein, Francophile, Philistine / Frankly, we are killing time"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15ba8f6e-b2c0-4c7f-943c-9f5663599e79",
                        "source_entry_id": "64479bc3-5fa4-3136-80b9-b19121500876",
