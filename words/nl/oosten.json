                    "sense_id": "a6fe6f55-60a0-3a36-91e2-5d3bcc43abca",
                    "sense_definition": "Een van de vier windstreken, de richting waar de zon opkomt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zon komt elke ochtend op in het <w>oosten</w>.",
                            "target_lang_translations": {
                                "en": "The sun rises every morning in the <w>east</w>.",
                                "ru": "Солнце каждое утро восходит на <w>востоке</w>.",
                                "pl": "Słońce wschodzi każdego ranka na <w>wschodzie</w>.",
                                "de": "Die Sonne geht jeden Morgen im <w>Osten</w> auf.",
                                "fr": "Le soleil se lève chaque matin à l'<w>est</w>.",
                                "it": "Il sole sorge ogni mattina a <w>est</w>.",
                                "cs": "Slunce vychází každé ráno na <w>východě</w>.",
                                "tr": "Güneş her sabah <w>doğudan</w> doğar.",
                                "es": "El sol sale cada mañana por el <w>este</w>."
                            }
                        },
                        {
                            "text": "Duitsland ligt ten <w>oosten</w> van Nederland.",
                            "target_lang_translations": {
                                "en": "Germany lies to the <w>east</w> of the Netherlands.",
                                "ru": "Германия находится к <w>востоку</w> от Нидерландов.",
                                "pl": "Niemcy leżą na <w>wschód</w> od Holandii.",
                                "de": "Deutschland liegt östlich von den Niederlanden / im <w>Osten</w> der Niederlande.",
                                "fr": "L'Allemagne se situe à l'<w>est</w> des Pays-Bas.",
                                "it": "La Germania si trova a <w>est</w> dei Paesi Bassi.",
                                "cs": "Německo leží na <w>východ</w> od Nizozemska.",
                                "tr": "Almanya, Hollanda'nın <w>doğusunda</w> yer alır.",
                                "es": "Alemania está al <w>este</w> de los Países Bajos."
                            }
                        }
                    ],
                    "synonyms": [
                        "oost"
                    ],
                    "antonyms": [
                        "westen"
                    ],
                    "common_phrases": [
                        "in het oosten",
                        "ten oosten van",
                        "naar het oosten"
                    ],
                    "target_lang_definitions": {
                        "en": "One of the four cardinal directions, the direction where the sun rises.",
                        "ru": "Одна из четырех сторон света, направление, где восходит солнце.",
                        "pl": "Jeden z czterech głównych kierunków świata, strona, po której wschodzi słońce.",
                        "de": "Eine der vier Haupthimmelsrichtungen, die Richtung, in der die Sonne aufgeht.",
                        "fr": "L'un des quatre points cardinaux, la direction où le soleil se lève.",
                        "it": "Uno dei quattro punti cardinali, la direzione in cui sorge il sole.",
                        "cs": "Jedna ze čtyř světových stran, směr, kde vychází slunce.",
                        "tr": "Dört ana yönden biri, güneşin doğduğu yön.",
                        "es": "Uno de los cuatro puntos cardinales, la dirección por donde sale el sol."
                    },
