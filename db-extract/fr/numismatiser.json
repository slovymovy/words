                "senses": [
                    {
                        "sense_id": "2d1c2426-2d4f-365a-b9e3-d610427bff73",
                        "entry_id": "dd84b10c-d7ed-334e-9df0-f36d0ecfd3c6",
                        "glosses": [
                            "Donner un caractère numismatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2ac183-a613-4547-a873-43ed52fb06c5",
                                "sense_id": "2d1c2426-2d4f-365a-b9e3-d610427bff73",
                                "text": "Ainsi me fut révélé l'envers de la médaille que j'avais numismatisée amoureusement en d'autres circonstances."
                            },
                            {
                                "example_id": "8a47471c-a6c6-4e37-82cf-13bb290c7234",
                                "sense_id": "2d1c2426-2d4f-365a-b9e3-d610427bff73",
                                "text": "Les objets de collection SW vont ils se numismatiser ?"
                            },
                            {
                                "example_id": "e19f719e-00d8-4271-9216-f24d5cfbe701",
                                "sense_id": "2d1c2426-2d4f-365a-b9e3-d610427bff73",
                                "text": "Pourquoi ne pas se traduire en camées, en intailles, ne pas se modeler en torse et en pied, ne pas se numismatiser, ne pas se monumentaliser?"
                            }
                        ]
                    }
