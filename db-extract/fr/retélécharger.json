                        "examples": [
                            {
                                "example_id": "1a64dc74-ef5d-4f4f-8924-023c940a68b0",
                                "sense_id": "a169485c-2624-3d3e-b86e-b06540cd42ea",
                                "text": "Un peu fainéant de nature ça me saoule de retélécharger les paquets à chaque install et la sauvegarde du cache m'agace un peu aussi."
                            },
                            {
                                "example_id": "5c6f20c5-e576-4b49-9552-b12fb9958815",
                                "sense_id": "a169485c-2624-3d3e-b86e-b06540cd42ea",
                                "text": "Aujourd'hui, on peut tout à fait effacer une application que l'on a achetée, puis la retélécharger gratuitement, autant de fois que nécessaire."
                            },
                            {
                                "example_id": "492c15fe-6786-42f6-a381-70eb83e07610",
                                "sense_id": "a169485c-2624-3d3e-b86e-b06540cd42ea",
                                "text": "AVAST, comment retélécharger ?"
                            }
                        ]
                    }
