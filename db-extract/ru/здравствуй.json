                                        "sense_id": "45d8b08b-85a5-39b8-8e5d-b15da2764874",
                                        "entry_id": "b40d8bbd-7160-3954-8a5b-bb69aec1e80a",
                                        "glosses": [
                                            "Alternative form of good-morning (“to say good morning (to someone)”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e481e7fc-1507-46f1-9970-6eb0ad1cb60b",
                                                "sense_id": "45d8b08b-85a5-39b8-8e5d-b15da2764874",
                                                "text": "He stopped at Maggie’s spot. They “good morninged” each other."
                                            },
                                            {
                                                "example_id": "fdd3f93b-6569-4f29-a82b-0177bd60f624",
                                                "sense_id": "45d8b08b-85a5-39b8-8e5d-b15da2764874",
                                                "text": "It could not otherwise befall / (Sir Thomas, and his Wife, this course persuing,) / But that the Lady, affable to all, / Should greet the Friars, on her way / To matins, as she met them, every day, / Good morninging, and how d’ye doing: […]"
                                            },
                                            {
                                                "example_id": "a2b12312-6d57-4019-a285-061863535322",
                                                "sense_id": "45d8b08b-85a5-39b8-8e5d-b15da2764874",
                                                "text": "So Puffington sauntered along good morninging “Sir Harrys,” and “Sir Jameses,” and “Lord Johns,” and “Lord Toms,” […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
