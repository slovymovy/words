                    "sense_id": "39c402ac-ffca-3769-b17c-3de89801cb0e",
                    "sense_definition": "Een voertuig of weggebruiker die uit de tegenovergestelde richting nadert.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verkeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op deze smalle weg moet je goed opletten voor een <w>tegenligger</w>.",
                            "target_lang_translations": {
                                "en": "On this narrow road, you need to watch out carefully for an <w>oncoming vehicle</w>."
                            }
                        },
                        {
                            "text": "De automobilist werd verblind door de felle koplampen van een <w>tegenligger</w>.",
                            "target_lang_translations": {
                                "en": "The driver was blinded by the bright headlights of an <w>oncoming car</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een naderende tegenligger",
                        "koplampen van een tegenligger"
                    ],
                    "target_lang_definitions": {
                        "en": "A vehicle or road user approaching from the opposite direction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oncoming vehicle",
                                "target_lang_sense_clarification": "a specific car or vehicle traveling towards you"
                            },
                            {
                                "target_lang_word": "oncoming traffic",
                                "target_lang_sense_clarification": "vehicles traveling in the opposite direction"
                            },
                            {
                                "target_lang_word": "oncoming driver",
                                "target_lang_sense_clarification": "a driver traveling towards you"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e71cf8b-caee-3467-98a4-40a8634df706",
                    "sense_definition": "Een vaartuig dat uit de tegenovergestelde richting vaart op hetzelfde vaarwater.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verkeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het smalle kanaal passeerde het schip voorzichtig een <w>tegenligger</w>.",
                            "target_lang_translations": {
                                "en": "In the narrow canal, the ship carefully passed an <w>oncoming vessel</w>."
                            }
                        },
                        {
                            "text": "De schipper hield stuurboord aan om ruimte te maken voor de <w>tegenligger</w>.",
                            "target_lang_translations": {
