                        "glosses": [
                            "übertragbar"
                        ],
                        "tags": [
                            "Gesundheit"
                        ],
                        "examples": [
                            {
                                "example_id": "f47504b6-566b-49ca-89a4-6ebdcb7db07d",
                                "sense_id": "4247cf5c-95f2-3fd5-bdfd-13cdee66cf59",
                                "text": "\"The Ebola virus, seen here through a scanning electron microscope, is mutating as cases increase, raising the odds that the virus could become more transmissible.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90024fef-0a27-4c91-919c-27453cec66df",
                        "source_entry_id": "c85c47b2-572d-3d10-b8b0-063e9078d65d",
                        "source_sense_id": "4247cf5c-95f2-3fd5-bdfd-13cdee66cf59",
                        "source_sense_description": "Gesundheit: übertragbar",
                        "target_lang_word": "übertragbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "übertragbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "046c95fe-c1cd-3eff-9899-d33a1caebec9",
                                        "entry_id": "65467828-58a8-3ba5-8fda-a1cab27d99a0",
                                        "glosses": [
                                            "auf andere Sachen anwendbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f7bd74f-8dc0-4738-ab6b-37426b75fd4e",
                                                "sense_id": "046c95fe-c1cd-3eff-9899-d33a1caebec9",
                                                "text": "„Bei der Zulassung neuer Medikamente spielen Menschenversuche in klinischen Studien eine wichtige Rolle. Dort stehen Tests an freiwilligen Menschen mit an letzter Stelle des Zulassungsprozesses, da Erkenntnisse von Tierversuchen nur begrenzt auf Menschen übertragbar sind.“"
                                            },
                                            {
                                                "example_id": "7623406c-3668-4ae5-a7f9-9208619c6066",
                                                "sense_id": "046c95fe-c1cd-3eff-9899-d33a1caebec9",
                                                "text": "„Fraglich ist, ob das Studienergebnis [zum Darmkrebsrisiko mit dem in den USA häufig verwendeten Maiszucker] auch auf den in Europa üblichen Zucker aus Zuckerrohr und Zuckerrüben übertragbar ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc1d75b5-b69b-3a7a-a6d3-626ea22cfff7",
                                        "entry_id": "65467828-58a8-3ba5-8fda-a1cab27d99a0",
                                        "glosses": [
                                            "von anderen Personen nutzbar ohne die Gültigkeit zu verlieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a1723e5-77a8-4af0-94c1-75cb6f34ef30",
                                                "sense_id": "fc1d75b5-b69b-3a7a-a6d3-626ea22cfff7",
                                                "text": "Die Flugtickets waren nicht auf andere Personen übertragbar."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "43494fd5-4adb-3e2a-a566-78c4f1948e4c",
                                        "entry_id": "65467828-58a8-3ba5-8fda-a1cab27d99a0",
                                        "glosses": [
                                            "Medizin sich übertragen lassend, ansteckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c578803-6483-46f3-9cc3-a21c1d5b6561",
                                                "sense_id": "43494fd5-4adb-3e2a-a566-78c4f1948e4c",
                                                "text": "„Das Teilgebiet der Medizin, welches sich mit den klassischen sexuell übertragbaren Krankheiten beschäftigt, ist die Venerologie.“"
