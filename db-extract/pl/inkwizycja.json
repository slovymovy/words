                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37fddd1f-6e4c-49d6-b2e7-69973d6b5f79",
                        "source_entry_id": "18edb4ef-7a0d-39b7-bb46-66e697e9dc15",
                        "source_sense_id": "b8c0d62f-8476-3b34-913e-161f6bc3e87a",
                        "target_lang_word": "Inquisition",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inquisition",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                        "entry_id": "efc6103c-ee54-39da-ad1e-dfb6fc7bbe06",
                                        "glosses": [
                                            "Gericht der Kirche gegen Abtrünnige und solche, die Glaubenslehren ablehnten"
                                        ],
                                        "tags": [
                                            "zwischen dem 12. und dem 18. Jahrhundert"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21cc4acc-b459-4602-a22d-426ba73b8a9b",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "Anna Schwegelin wurde nicht durch die Inquisition, sondern durch ein weltliches Gericht zum Tode verurteilt."
                                            },
                                            {
                                                "example_id": "035b0f31-15e2-4cac-98ad-de2aff91c338",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "Giordano Bruno entging der Inquisition nicht."
                                            },
                                            {
                                                "example_id": "98329778-2ae6-4218-87db-b59d33847f08",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„In manchen Kreisen hält sich hartnäckig das Gerücht, dies sei die moderne Variante der Inquisition.“"
                                            },
                                            {
                                                "example_id": "69a2836c-29f4-4773-9e22-412dd3034ea5",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Aber die Inquisition hatte zumindest keinen Hehl aus ihrem Tun gemacht.“"
                                            },
                                            {
                                                "example_id": "4a53ef48-b7e1-4ebf-956e-7973210e5fd3",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Ich wurde ein gewisses Angstgefühl der Inquisition gegenüber nicht los, und mir schien, als seien mir bereits einige Spitzel auf den Fersen.“"
                                            },
                                            {
                                                "example_id": "cb3474b3-0fd6-4336-ad67-3f1c57b72514",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Durch nichts hat das Christentum sich selbst, seiner eigenen Substanz nach so verraten und geschädigt wie mit den von der Inquisition entfesselten Verfolgungen, Folterungen und grausamen Hinrichtungen von Tausenden christlicher Menschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12b3ab2a-488e-41fd-8826-6bf3b2f69074",
                        "source_entry_id": "18edb4ef-7a0d-39b7-bb46-66e697e9dc15",
                        "source_sense_id": "b8c0d62f-8476-3b34-913e-161f6bc3e87a",
                        "target_lang_word": "инквизиция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "инквизиция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "51e738f0-625b-3ca9-a5f0-7ff2c742ea72",
                                        "entry_id": "1ce7419b-b2a6-3489-b4c0-7ffd77b2ebe3",
                                        "glosses": [
                                            "истор. созданный в начале XIII века следственный и карательный орган католической церкви для жестокой борьбы с ересью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "388c4fd3-6b75-4ea8-b100-c0f41223c8f4",
                                                "sense_id": "51e738f0-625b-3ca9-a5f0-7ff2c742ea72",
                                                "text": "Но первые удары инквизиции пали действительно на противников христианской религии, на евреев. Надо было подумать, что инквизиция в этом случае оказалась верна своему началу: но и это гонение на евреев имело в основе политические побуждения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9449e734-5680-32b8-8805-e824c37b4c9c",
                                        "entry_id": "1ce7419b-b2a6-3489-b4c0-7ffd77b2ebe3",
                                        "glosses": [
                                            "перен. изощрённое до жестокости издевательство; пытка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d2fd428-0a03-4ede-8ae1-5a89498d975f",
                                                "sense_id": "9449e734-5680-32b8-8805-e824c37b4c9c",
                                                "text": "— И знаете ли, я вам скажу, надо иметь слишком твёрдый характер, слишком большой запасец силы воли, чтобы не пасть духом и не сделаться подлецом при такой инквизиции…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
