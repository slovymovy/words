                    },
                    {
                        "translation_id": "f59529da-d415-4013-b5a8-e57c1fba2585",
                        "source_entry_id": "af435655-8907-32d8-83ac-709e6cde0311",
                        "source_sense_description": "отношение к чему-либо с точки зрения практической полезности, ценности",
                        "target_lang_word": "Pragmatik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pragmatik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3f0f158-8440-349a-aec0-66e5e6f00827",
                                        "entry_id": "55fb0dbe-2424-3b0a-b437-e89e6ba61044",
                                        "glosses": [
                                            "Orientierung an Nützlichkeit, Sachbezogenheit"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f6f357-215d-40f4-97ec-cacf3c15e6f7",
                                                "sense_id": "b3f0f158-8440-349a-aec0-66e5e6f00827",
                                                "text": "„2001 kritisierte der UN-Menschenrechtsrat, dass internationale Finanzinstitutionen dazu tendieren, wirtschaftliche Pragmatik über Menschenrechte zu stellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a60362ab-a04c-3e02-ae44-105361b30dc5",
                                        "entry_id": "55fb0dbe-2424-3b0a-b437-e89e6ba61044",
                                        "glosses": [
                                            "Disziplin, deren Gegenstand die Sprachverwendung ist. Sie betrachtet Sprechen/Schreiben als Handlung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88a3c3de-9fe4-4e66-bf6d-c708b6a78e4d",
                                                "sense_id": "a60362ab-a04c-3e02-ae44-105361b30dc5",
                                                "text": "Die Pragmatik befasst sich z. B. mit der Frage, welcher Sprechakt vollzogen wird, wenn man zu jemandem sagt: „Es zieht“."
                                            },
                                            {
                                                "example_id": "5dc65633-5004-416d-9b32-01416b01d88b",
                                                "sense_id": "a60362ab-a04c-3e02-ae44-105361b30dc5",
                                                "text": "„Die Pragmatik der menschlichen Kommunikation ist eine Wissenschaft in Kinderschuhen, die noch weit davon entfernt ist, ihre brauchbare Sprache entwickelt zu haben.“"
                                            },
                                            {
                                                "example_id": "0faa6fc5-1856-4259-bf8e-7e8660e383fa",
                                                "sense_id": "a60362ab-a04c-3e02-ae44-105361b30dc5",
                                                "text": "„Die Pragmatik als eine Theorie sprachlichen Handelns ist besonders dafür prädestiniert, zu beschreiben, welchen Gebrauch die Sprecher von verschiedenen verfügbaren Sysremen für ihre Sprecherstrategie machen.“"
                                            },
                                            {
                                                "example_id": "4887d47f-e211-4efc-9b01-5b6fdc6055d4",
                                                "sense_id": "a60362ab-a04c-3e02-ae44-105361b30dc5",
                                                "text": "„Witze können aber auch entstehen, weil eine Situations- und Handlungserwartung nicht erfüllt wird, was die Pragmatik, die Sprechaktheorie erforscht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b48fe292-dee2-3110-b9d6-5769e608682b",
                                        "entry_id": "55fb0dbe-2424-3b0a-b437-e89e6ba61044",
                                        "glosses": [
                                            "Disziplin, die sich mit der Beziehung zwischen Zeichen und Zeichenverwender befasst"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa1dae2f-8861-413f-808b-6ca1d52c1e03",
                                                "sense_id": "b48fe292-dee2-3110-b9d6-5769e608682b",
                                                "text": "Die Pragmatik befasst sich mit der Beziehung zwischen den Sprechern/Schreibern und den Zeichen, die sie benutzen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1d7ffb4-dbe1-4e77-b5d2-ae0879d49efb",
                        "source_entry_id": "af435655-8907-32d8-83ac-709e6cde0311",
                        "source_sense_description": "отношение к чему-либо с точки зрения практической полезности, ценности",
                        "target_lang_word": "pragmatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pragmatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3c49b8b-e8d4-333e-9811-444c09ecff64",
                                        "entry_id": "82672b95-0f4b-3614-b50e-f14dcf1ff67e",
                                        "glosses": [
                                            "Qualifie le choix d'une décision, d'une action, ou directement la décision ou l'action, adaptée au but recherché, qui s’impose immédiatement, qui s’avère plus pratique plus efficace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08437568-ae23-4025-afe6-695eee59d407",
                                                "sense_id": "e3c49b8b-e8d4-333e-9811-444c09ecff64",
                                                "text": "De fil en aiguille, cette langue progresse, et ce pour des raisons essentiellement pragmatiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82170d02-a7bf-3f0f-91cb-ef41dc0ff9a4",
                                        "entry_id": "82672b95-0f4b-3614-b50e-f14dcf1ff67e",
                                        "glosses": [
                                            "Qui concerne les affaires, la pratique. Il est surtout utilisé en termes d’Histoire dans cette locution :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c392678c-ac88-41c6-af34-cf0d3c5cd569",
                                                "sense_id": "82170d02-a7bf-3f0f-91cb-ef41dc0ff9a4",
                                                "text": "Pragmatique sanction, qui se dit particulièrement d’un Règlement fait en matière ecclésiastique."
                                            },
                                            {
                                                "example_id": "78ef0a35-d937-4e9c-90d2-ba95aecd230e",
                                                "sense_id": "82170d02-a7bf-3f0f-91cb-ef41dc0ff9a4",
                                                "text": "La pragmatique sanction de Charles VII."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6492df98-8574-3d90-bf55-dcfe0d9b12de",
                                        "entry_id": "82672b95-0f4b-3614-b50e-f14dcf1ff67e",
                                        "glosses": [
                                            "Qui concerne l’action, qui est fondé surtout sur la pratique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbd9ed30-e134-4054-8d6a-6225c38d346d",
                                                "sense_id": "6492df98-8574-3d90-bf55-dcfe0d9b12de",
                                                "text": "Cette philosophie est surtout pragmatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f16b246-1866-3707-a189-182f74a2319d",
                                        "entry_id": "82672b95-0f4b-3614-b50e-f14dcf1ff67e",
                                        "glosses": [
                                            "Qui concerne la pragmatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4f373d6-d4a2-4ab3-a317-70012910dbd5",
                                                "sense_id": "7f16b246-1866-3707-a189-182f74a2319d",
                                                "text": "Tous ces protocoles offrent de travailler l’acquisition des habiletés pragmatiques par les jeux de rôle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pragmatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40ad6ea8-4882-3730-8669-7e7e543b6191",
                                        "entry_id": "7f6c1dfb-58be-326b-b9d3-0b4f803d09c7",
                                        "glosses": [
                                            "Étude de l’utilisation (littérale, figurée ou autre) des énoncés dans les actes d’énonciation dans la mesure où leur signification ne peut être comprise qu'en connaissant le contexte où ils sont employés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12074287-6e68-309c-9741-98dbef82ec19",
                                        "entry_id": "7f6c1dfb-58be-326b-b9d3-0b4f803d09c7",
                                        "glosses": [
                                            "Partie de la communication qui concerne les raisons pour lesquelles on communique, l’utilisation du discours, les intentions — puisque le but du langage n’est pas d’échanger des paroles mais des pensées. Cela comprend la communication non verbale (gestuelle, mimiques), l’implicite (les sous-entendus, le second degré, l’humour, le figuré), l’adaptation au contexte et à l’interlocuteur ou interlocutrice, le suivi des règles conversationnelles (répartition de la parole…) et la théorie de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4547527-2c8e-4bd0-853f-d548e8547d4f",
                                                "sense_id": "12074287-6e68-309c-9741-98dbef82ec19",
                                                "text": "La rééducation de la pragmatique et de la communication sociale doit être cadrée, bienveillante et adaptée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aecac26-4d32-3b12-9a22-9c7c5f68e6e9",
                                        "entry_id": "7f6c1dfb-58be-326b-b9d3-0b4f803d09c7",
                                        "glosses": [
                                            "Le fait de communiquer efficacement, de manière adaptée au contexte et aux interlocuteurs et interlocutrices, notamment en respectant les codes sociaux. La capacité à adapter sa communication selon le contexte."
                                        ],
                                        "tags": [
                                            "Communication"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pragmatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b7ebd0a-3473-3f40-9740-fe2c55dc99a9",
                                        "entry_id": "e06423f0-0e9c-3297-a862-24d574f13241",
                                        "glosses": [
                                            "Adepte du pragmatisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cbc6ed2-6ae9-495a-a98f-710909370d41",
                                                "sense_id": "4b7ebd0a-3473-3f40-9740-fe2c55dc99a9",
                                                "text": "C’est un pragmatique qui s’intéresse peu à la théorie."
                                            }
