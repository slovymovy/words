                                "target_senses": [
                                    {
                                        "sense_id": "732ec420-c350-3f71-9549-22f79ee2b611",
                                        "entry_id": "f466f0b0-72e4-391f-b4ab-fa50f7b8e593",
                                        "glosses": [
                                            "A male given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "845f080c-6f43-4208-b1a7-690b8123cac9",
                                                "sense_id": "732ec420-c350-3f71-9549-22f79ee2b611",
                                                "text": "Since it seems to me that this fad of child-rearing has turned into an actual trend, that babies are an increasingly popular accessory for people-on-the-go, I first want to say to stop naming your boys Max. Max is a perfectly nice name, ensuring its owner a certain precocious sensibility, but there are enough Maxes now. Any more Maxes and the breed will go to the dogs."
                                            },
                                            {
                                                "example_id": "a0e436bc-7d7c-4923-b609-44933589756f",
                                                "sense_id": "732ec420-c350-3f71-9549-22f79ee2b611",
                                                "text": "Kyle: Okay, Max. Search."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ac83dd4-b7e1-3f41-badd-b1d330b1826e",
                                        "entry_id": "f466f0b0-72e4-391f-b4ab-fa50f7b8e593",
                                        "glosses": [
                                            "A diminutive of the male given names Maximilian or Maxwell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7631fa89-bc7f-4cb0-9b92-dec294fed30b",
                                                "sense_id": "6ac83dd4-b7e1-3f41-badd-b1d330b1826e",
                                                "text": "Hamtramck is described in the resolution as “one of the most diverse cities in the United States.” The city has a large immigrant presence and all the city council members are of the Muslim faith, city manager Max Garbarino told CNN Thursday. Hamtramck was also the first known city in the US to inaugurate an all-Muslim government, CNN previously reported."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be01683d-1f30-32a3-860d-2d180bd47714",
                                        "entry_id": "f466f0b0-72e4-391f-b4ab-fa50f7b8e593",
                                        "glosses": [
