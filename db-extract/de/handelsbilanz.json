                ],
                "senses": [
                    {
                        "sense_id": "34ff2046-0689-3074-9916-f14c0408ca6a",
                        "entry_id": "5f5fe9dd-1723-3bcd-b936-206b889c6d66",
                        "glosses": [
                            "handelsrechtliche Bilanz eines Unternehmens, unter anderem zur Ermittlung des (möglichen) Ausschüttungsbetrags an Unternehmenseigner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9636947-81bd-46c1-8c71-07fc92fc98bb",
                                "sense_id": "34ff2046-0689-3074-9916-f14c0408ca6a",
                                "text": "Steuerbilanz und Handelsbilanz eines Unternehmens können voneinander abweichen, da für beide unterschiedliche gesetzliche Vorschriften gelten."
                            },
                            {
                                "example_id": "5646f895-9950-4d37-b6de-256ba6be9609",
                                "sense_id": "34ff2046-0689-3074-9916-f14c0408ca6a",
                                "text": "Laut seiner Handelsbilanz ist der Gewerbebetrieb überschuldet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f6a79350-10f8-35c0-8f5a-0dfd3944b66a",
                        "entry_id": "5f5fe9dd-1723-3bcd-b936-206b889c6d66",
                        "glosses": [
                            "rechnerische Gegenüberstellung der Einfuhr und Ausfuhr aller Waren einer Volkswirtschaft innerhalb eines Zeitraumes"
                        ],
                        "tags": [
                            "Volkswirtschaftslehre"
                        ],
                        "examples": [
                            {
                                "example_id": "e612c144-04a8-42b2-9f2c-a3fe6c613682",
                                "sense_id": "f6a79350-10f8-35c0-8f5a-0dfd3944b66a",
                                "text": "Übersteigt die Summe der Ausfuhren die Summe der Einfuhren, so spricht man von einer aktiven (bzw. positiven) Handelsbilanz, im umgekehrten Fall, also wenn die Importe die Exporte übersteigen, von einer passiven (bzw. negativen) Handelsbilanz."
                            },
                            {
                                "example_id": "b59f4b36-5090-4194-ae5f-1e847602c41d",
                                "sense_id": "f6a79350-10f8-35c0-8f5a-0dfd3944b66a",
                                "text": "„Der antike Geschichtsschreiber legt hier eine negative Handelsbilanz offen, die mehrere Zeitalter lang die wirtschaftlichen Beziehungen zwischen Europa und Asien bestimmt hat: Das Abendland begehrt fernöstliche Produkte, hat aber selbst wenig Interessantes anzubieten - und muss deshalb teuer mit Silber und Gold bezahlen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
