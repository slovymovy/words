                "senses": [
                    {
                        "sense_id": "f0e5c139-13e7-347a-b957-193273628819",
                        "entry_id": "bc83b979-6507-3182-a10b-fd6aaace74c0",
                        "glosses": [
                            "Ajouter des coordonnées géographiques à des cartes qui n’en ont pas."
                        ],
                        "tags": [
                            "Géomatique"
                        ],
                        "examples": [
                            {
                                "example_id": "7e4dc7c9-6972-45c2-8db6-a2ae4a885401",
                                "sense_id": "f0e5c139-13e7-347a-b957-193273628819",
                                "text": "Après photographie et assemblage numérique, les cartes et photographies aériennes ont été géo-rectifiées sur le fond IGN 2000."
                            },
                            {
                                "example_id": "ae4457b9-5b04-47db-9f7d-c911701fad85",
                                "sense_id": "f0e5c139-13e7-347a-b957-193273628819",
                                "text": "Plus précisément, le LOSIS contient des informations concernant les unités cartographiques clés des sols, provenant des observations recueillies sur le terrain, tandis que l’IGIS est basé essentiellement sur les images géo-rectifiées acquises par télédétection, complétées par des classifications supervisées et des données de type cartographique et de vérité terrain."
                            },
                            {
                                "example_id": "5502cb0e-d714-42d2-a69a-62906c2891b9",
                                "sense_id": "f0e5c139-13e7-347a-b957-193273628819",
                                "text": "Vue zénithale du plan géo-rectifiée sur le fond Ign 2000, coordonnées UTM WGS 84."
                            }
                        ]
                    }
