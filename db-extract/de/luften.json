                "senses": [
                    {
                        "sense_id": "d26b0941-36f2-3db1-9e23-979d201f8002",
                        "entry_id": "4db86fdd-a5da-3f00-a361-9568c46af64a",
                        "glosses": [
                            "mehr oder weniger heftig wehen"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "2cb55023-4eb0-4f98-ab81-185797b1b014",
                                "sense_id": "d26b0941-36f2-3db1-9e23-979d201f8002",
                                "text": "„Es luftete so fest, dass ich zitterte, obwohl es eigentlich gar nicht kalt war.“"
                            },
                            {
                                "example_id": "ed8eb375-74dd-44f3-a973-f566f98118bb",
                                "sense_id": "d26b0941-36f2-3db1-9e23-979d201f8002",
                                "text": "„Es luftet und friert mich. Ich frage, wie das Wetter wird.“"
                            },
                            {
                                "example_id": "def960bc-a62c-4556-9907-9d0a88c9e865",
                                "sense_id": "d26b0941-36f2-3db1-9e23-979d201f8002",
                                "text": "„Es luftete. Die niedrigen Bäume bogen sich im Wind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "33c21ae0-1588-31ca-aa47-67e505f65644",
                        "entry_id": "4db86fdd-a5da-3f00-a361-9568c46af64a",
                        "glosses": [
                            "(einer Person, einem Zimmer, Wäsche) Luft zuführen"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
