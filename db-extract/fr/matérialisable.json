                "senses": [
                    {
                        "sense_id": "4f02278f-2fff-3300-84dc-a5247e4831e8",
                        "entry_id": "6120c33e-8072-3169-b865-cd51a3bb6160",
                        "glosses": [
                            "Qui peut se matérialiser, être physiquement présent dans la réalité."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "f5fbe6eb-6db8-4924-b673-7294951cb008",
                                "sense_id": "4f02278f-2fff-3300-84dc-a5247e4831e8",
                                "text": "Le bulletin blanc n'étant pas matérialisé, le vide n'étant pas matérialisable, l'information selon laquelle une enveloppe vide équivaut à un bulletin blanc est indispensable au moment du choix."
                            },
                            {
                                "example_id": "eba23e10-fc81-47cf-a3b2-cfcc6d64a20b",
                                "sense_id": "4f02278f-2fff-3300-84dc-a5247e4831e8",
                                "text": "Depuis 1999, les organisateurs d'INTERSCULPT proposent un concours international de sculpture numérique qui se déroule sur le Web et dont la seule contrainte, pour les candidats, est de produire des objets d'art 3D matérialisables."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e9c4879-87f5-3f2b-b35c-fc0f51035494",
                        "entry_id": "6120c33e-8072-3169-b865-cd51a3bb6160",
                        "glosses": [
                            "Qui peut se matérialiser, se réaliser, exister."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b133331-6199-4961-b4e8-3eaaa0d9f495",
                                "sense_id": "1e9c4879-87f5-3f2b-b35c-fc0f51035494",
                                "text": "Pour être efficaces, des marchés nécessitent en particulier une organisation, une planification, des droits de propriété bien définis, des règles en matière d'échange, ainsi qu'une distinction claire et matérialisable entre secteur public et secteur privé."
                            }
                        ]
                    }
