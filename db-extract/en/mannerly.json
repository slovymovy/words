                    },
                    {
                        "translation_id": "d097f7b9-94cd-464d-863c-42153a87d427",
                        "source_entry_id": "71d24eba-0d20-3f8f-96ac-eea79fd5b9cd",
                        "source_sense_id": "a3874add-749e-3d80-bfd3-38fca01287a7",
