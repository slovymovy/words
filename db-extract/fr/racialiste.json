                        "form": "racialistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11ffadd9-e4c6-30f5-b552-ee2799bf9e6c",
                        "entry_id": "e88789be-d8f4-3546-b635-67e525b5f363",
                        "glosses": [
                            "Partisan du racialisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c628b8de-6ed1-476f-9f70-fa407a35a43c",
                                "sense_id": "11ffadd9-e4c6-30f5-b552-ee2799bf9e6c",
                                "text": "Tandis que le raciste distingue des races supérieures et des races inférieures, le racialiste considère que les races sont toutes « égales »."
                            },
                            {
                                "example_id": "bc2abe4b-d50e-41a9-8ebd-acc8e2021972",
                                "sense_id": "11ffadd9-e4c6-30f5-b552-ee2799bf9e6c",
                                "text": "Une position qui ne satisfait ni les militants du MNR ni ceux du FN, qui rassemblent des gens de « sensibilités différentes » et mélangent des catholiques traditionalistes, des anciens de l’OAS, des royalistes, des racialistes, des paganistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "7661da43-2d35-3b20-88d9-d6bec2bb76a7",
                        "entry_id": "e88789be-d8f4-3546-b635-67e525b5f363",
                        "glosses": [
                            "Terme accusatoire désignant péjorativement un antiraciste perçu comme obsédé par la question raciale et accusé de diviser la société en réintroduisant des catégories raciales."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "900378b8-e6ac-4b96-912e-b22fbef18b59",
                                "sense_id": "7661da43-2d35-3b20-88d9-d6bec2bb76a7",
                                "text": "« Jusqu’où iront les racialistes ? » (avril 2021), dont l’idéologie supposée est là encore décrite comme « un nouveau totalitarisme » conduisant au « dérapage » de « l’école des élites » que serait Sciences Po (avril 2021)."
                            }
                        ]
                    }
