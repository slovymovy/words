                "senses": [
                    {
                        "sense_id": "8e97b340-67d8-38d9-8f9b-c081af21ea9c",
                        "entry_id": "cab6a836-ab53-3ac0-8dcc-c1b8ee5f7a9f",
                        "glosses": [
                            "aus Wellblech errichtete Baracke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14e14d9e-193f-4b96-81fa-6965ad3b6d3a",
                                "sense_id": "8e97b340-67d8-38d9-8f9b-c081af21ea9c",
                                "text": "„Nachdem sie das Gepäck ausgeladen hatten, führte er Ferris zu einem wartenden Humvee, der sie zu einer etwa einen Kilometer entfernten Wellblechbaracke kutschierte.“"
                            },
                            {
                                "example_id": "2c8dffe5-706b-4e2f-9af1-e40d16bf32fc",
                                "sense_id": "8e97b340-67d8-38d9-8f9b-c081af21ea9c",
                                "text": "„Die jungen Männer schlossen sich zu kleinen Gruppen zusammen und schliefen in Wellblechbaracken, in winzigen Zimmern, die sie von Arabern in Haifa mieteten, auf Dächern, in Gärten, in Höhlen und sogar auf Matten am Strand.“"
                            },
                            {
                                "example_id": "525706e4-79cc-4118-adf9-e5ef568c01e7",
                                "sense_id": "8e97b340-67d8-38d9-8f9b-c081af21ea9c",
                                "text": "„Neal betrachtete das verrückte Durcheinander aus Häuserfassaden des neunzehnten Jahrhunderts, Wellblechbaracken und riesigen Filmplakaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
