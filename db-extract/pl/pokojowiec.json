                                    },
                                    {
                                        "sense_id": "ac53f1d4-641c-3fd8-bf06-4ad172fb5da8",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A female performer in professional wrestling, acting as either a manager or personal chaperone; often used to attract and titillate male members of the audience."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87402fda-8542-39fd-acf2-d07effc5995f",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A female chaperone who accompanies a man, and is usually not married to him."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46ec957b-3875-306a-bcb3-69479499853e",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A person employed to clean or park cars."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc56a3a0-f938-3538-898b-8ab338142cf0",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A person employed to assist the jockey and trainer at a racecourse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9a79a38-492c-3c57-a064-1d6a5e4ef6cf",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A wooden stand on which to hold clothes and accessories in preparation for dressing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d54e1f7c-277b-3c1f-88e5-8816d859ca20",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A kind of goad or stick with an iron point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "valet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78e460cf-8d69-372d-ad21-7479dc940cc7",
                                        "entry_id": "bdbf86bc-0e92-3d6a-a0ca-e7fef4bba586",
                                        "glosses": [
                                            "To serve (someone) as a valet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8fb99bd-5a21-4dbe-954d-608d8de974b4",
                                                "sense_id": "78e460cf-8d69-372d-ad21-7479dc940cc7",
                                                "text": "You can valet me, can you? Bother valeting me! I like to put on my own clothes, and brush them, too, when they are on; and if I only knew how to black my own boots, by George I should like to do it!"
                                            },
                                            {
                                                "example_id": "281fd6cf-2814-4367-977d-748bbe8ea87c",
                                                "sense_id": "78e460cf-8d69-372d-ad21-7479dc940cc7",
                                                "text": "[…] the red-haired boy who had valeted me in the morning appeared in a plain suit of black."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50d787c8-b1f1-3c2f-925a-fe80f7cc9db6",
                                        "entry_id": "bdbf86bc-0e92-3d6a-a0ca-e7fef4bba586",
                                        "glosses": [
                                            "To clean and service (a car), as a valet does."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f9e46b5-cddc-4b3a-be0b-ba2aeecff783",
                                                "sense_id": "50d787c8-b1f1-3c2f-925a-fe80f7cc9db6",
                                                "text": "He revealed: “We had been through a lot and I decided the car needed to be cleaned out after Georgina had to deliver the baby in the car.\n“You can imagine the scene when I left the car in for valeting. I got some funny looks and I had to explain to the guy that I wasn’t up to anything illegal because it did look a bit like a crime scene.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53a009fe-129b-3c05-9e7a-222dae6aeb71",
                                        "entry_id": "bdbf86bc-0e92-3d6a-a0ca-e7fef4bba586",
                                        "glosses": [
                                            "To leave (a car) with a valet to park it."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e44016c-0ada-4437-b50d-cd1369adcb56",
                                                "sense_id": "53a009fe-129b-3c05-9e7a-222dae6aeb71",
                                                "text": "I asked Giacomo if he ever valeted his car, and he twisted his face into a grimace as he replied, “Rarely, but I have done it. Nervous time.”"
                                            },
                                            {
                                                "example_id": "5a3c4100-df67-4678-8381-aa5ef015cc63",
                                                "sense_id": "53a009fe-129b-3c05-9e7a-222dae6aeb71",
                                                "text": "“‘Is this a date?’” Ms. Ludbrook recalled thinking during dinner. “I had valeted my car, and he hadn’t. He said, ‘Bye,’ and went to his car. Clearly this was not a date.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70077655-568d-4be8-882f-a3449bce34f2",
                        "source_entry_id": "f37e4816-7d0f-309d-a65c-05e8ea16c0e9",
                        "source_sense_id": "865c5e03-0580-3d9f-af43-fd805efa4bc4",
                        "target_lang_word": "servant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "servant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "One who is hired to perform regular household or other duties, and receives compensation. As opposed to a slave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa167449-f294-4b8f-85c0-49b7f4e9ab53",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "There are three servants in the household, the butler and two maids."
                                            },
                                            {
                                                "example_id": "02fcd083-c8b4-4ab2-8e64-44bb20c92184",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "In the great houses, servants out of livery help to the different plats, servants in livery holding the dishes, sauces, etc., and changing the plates."
                                            },
                                            {
                                                "example_id": "b5fca4fb-e3e2-45c4-9973-42512bba6b44",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "As a political system democracy seems to me extraordinarily foolish, but I would not go out of my way to protest against it. My servant is, so far as I am concerned, welcome to as many votes as he can get. I would very gladly make mine over to him if I could."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "619c002d-a6ba-3ec0-b950-4fd9636ce4ff",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "One who serves another, providing help in some manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13abde63-d56e-4485-8524-42183901b6eb",
                                                "sense_id": "619c002d-a6ba-3ec0-b950-4fd9636ce4ff",
                                                "text": "She is quite the humble servant, the poor in this city owe much to her but she expects nothing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44bde33a-0c90-3c7a-957e-4119b5234ad1",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "A person who dedicates themselves to God."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
