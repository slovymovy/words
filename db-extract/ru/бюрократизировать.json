                                        "entry_id": "6d9f84f1-e3dd-3d5c-b3f9-45a6fd2d57b6",
                                        "glosses": [
                                            "perfekt und gleich/gerecht durch eine staatliche Organisation (Bürokratie) verwalten"
                                        ],
                                        "tags": [
                                            "positiv",
                                            "neutral"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f46a81e0-1a05-424a-8250-6bccdb26acd5",
                                                "sense_id": "6c344553-56a8-3dc1-89aa-7a05e7fd0e2d",
                                                "text": "„Es war nur folgerichtig, daß Hardenberg genau zu dem Zeitpunkt, als er die Einberufung der Repräsentanten plante, daran ging, ein Staatskanzleramt zu schaffen und das Verwaltungssystem bis in die Kreise hinunter zu bürokratisieren.“"
                                            }
                                        ],
