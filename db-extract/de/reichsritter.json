                        "entry_id": "cbc58fc4-8b81-3355-b150-4bc1f45b9eab",
                        "glosses": [
                            "reichsunmittelbarer niederer Adliger im Heiligen Römischen Reich"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a9cb5a02-063c-40b3-80eb-295d008721a2",
                                "sense_id": "9543f797-8c60-34c3-a83a-352022d0cac1",
                                "text": "„Dass der dichtende Reichsritter und Lutherparteigänger Ulrich von Hutten vehement zum bewaffneten Kampf gegen Rom aufrief, wurde insbesondere in der Zeit der Befreiungskriege als notwendiger Kampf gegen den katholischen Usurpator Frankreich umgedeutet.“"
                            },
                            {
                                "example_id": "78ca0d22-cca8-44f0-a75c-33f07e1154b1",
                                "sense_id": "9543f797-8c60-34c3-a83a-352022d0cac1",
                                "text": "„Jedenfalls lebten und wuchsen die Fürsten in und mit der Stadt, während die Reichsritter auf den Burgen von der Stadt lebten und gegen sie kämpften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
