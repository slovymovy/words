{
    "word_family": [
        "evident",
        "evidential",
        "evidently",
        "self-evident"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f41ad4d-bead-31dc-b06b-98bbf0a45a2a",
                    "sense_definition": "Facts or observations presented in support of an assertion or belief.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "proof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no <w>evidence</w> that anyone was here earlier.",
                            "target_lang_translations": {
                                "ru": "Нет никаких <w>доказательств</w> того, что здесь кто-то был раньше."
                            }
                        },
                        {
                            "text": "The scientist presented <w>clear</w> <w>evidence</w> to support her new theory during the conference.",
                            "target_lang_translations": {
                                "ru": "На конференции ученый представила четкие <w>доказательства</w> в поддержку своей новой теории."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clear evidence",
                        "scientific evidence",
                        "lack of evidence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Факты или наблюдения, представленные в поддержку утверждения или убеждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доказательство",
                                "target_lang_sense_clarification": "факт, подтверждающий истинность чего-либо"
                            },
                            {
                                "target_lang_word": "свидетельство",
                                "target_lang_sense_clarification": "то, что служит подтверждением факта"
                            },
                            {
                                "target_lang_word": "подтверждение",
                                "target_lang_sense_clarification": "данные, подкрепляющие теорию или слова"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d14fdee0-f77d-351b-894a-a67867b8b864",
                    "sense_definition": "Information or objects admitted by a court to prove or disprove alleged facts in a trial.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police collected <w>physical</w> <w>evidence</w> from the crime scene to identify the suspect.",
                            "target_lang_translations": {
                                "ru": "Полиция собрала вещественные <w>доказательства</w> на месте преступления, чтобы установить личность подозреваемого."
                            }
                        },
                        {
                            "text": "The judge ruled that the recorded conversation was <w>admissible</w> <w>evidence</w> in the trial.",
                            "target_lang_translations": {
                                "ru": "Судья постановил, что записанный разговор является допустимым <w>доказательством</w> в суде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "admissible evidence",
                        "physical evidence",
                        "circumstantial evidence",
                        "give evidence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Информация или объекты, допущенные судом для доказывания или опровержения фактов в ходе судебного разбирательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улика",
                                "target_lang_sense_clarification": "предмет или обстоятельство, свидетельствующее о виновности"
                            },
                            {
                                "target_lang_word": "доказательство",
                                "target_lang_sense_clarification": "судебное доказательство"
                            },
                            {
                                "target_lang_word": "показания",
                                "target_lang_sense_clarification": "сведения, предоставляемые свидетелем в суде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e53f5da-cae3-3ca1-9917-db52b7951e6b",
                    "sense_definition": "A person who bears witness or provides testimony.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "witness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was huffed at being nailed as an <w>evidence</w> upon a few words dropped at the table.",
                            "target_lang_translations": {
                                "ru": "Он был раздосадован тем, что его привлекли в качестве <w>свидетеля</w> из-за нескольких слов, оброненных за столом."
                            }
                        },
                        {
                            "text": "The lawyer spent hours cross-examining the <w>evidence</w> to find contradictions in the story.",
                            "target_lang_translations": {
                                "ru": "Адвокат часами проводил перекрестный допрос <w>свидетеля</w>, чтобы найти противоречия в истории."
                            }
                        }
                    ],
                    "synonyms": [
                        "witness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used to refer to a witness"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, которое выступает в качестве свидетеля или дает показания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетель",
                                "target_lang_sense_clarification": "человек, дающий показания (устаревшее значение)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3075a6a-8396-3af3-8789-d718e9ac5686",
                    "sense_definition": "To provide proof for or to suggest the truth of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "demonstrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was furious, as <w>evidenced</w> by her slamming the door.",
                            "target_lang_translations": {
                                "ru": "Она была в ярости, о чем <w>свидетельствовало</w> то, как она захлопнула дверь."
                            }
                        },
                        {
                            "text": "The success of the project is <w>evidenced</w> by the significant increase in annual sales.",
                            "target_lang_translations": {
                                "ru": "Успех проекта <w>подтверждается</w> значительным ростом годовых продаж."
                            }
                        }
                    ],
                    "synonyms": [
                        "attest",
                        "testify",
                        "witness"
                    ],
                    "common_phrases": [
                        "as evidenced by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять доказательства или указывать на истинность чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доказывать",
                                "target_lang_sense_clarification": "подтверждать фактами или доводами"
                            },
                            {
                                "target_lang_word": "свидетельствовать",
                                "target_lang_sense_clarification": "служить признаком или подтверждением чего-либо"
                            },
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "делать очевидным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}