                "senses": [
                    {
                        "sense_id": "87003c94-90bb-3057-87f4-a31ed593ca46",
                        "entry_id": "72d4e60b-24cf-3207-8311-871fd1c4fdd0",
                        "glosses": [
                            "Person, die den Laufsport nicht beruflich, sondern nur als Hobby ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f641797-8d22-4a3c-9741-fe4f9dbb216e",
                                "sense_id": "87003c94-90bb-3057-87f4-a31ed593ca46",
                                "text": "„Auch reine Hobbyläufer müssen diese Distanz deshalb sehr ernsthaft und nach Plan trainieren.“"
                            },
                            {
                                "example_id": "ef9017fa-3420-4a4c-8d63-6cc59b11929d",
                                "sense_id": "87003c94-90bb-3057-87f4-a31ed593ca46",
                                "text": "„Aber als ich die blaue Tartanbahn erreichte, sah ich darauf nur zwei Hobbyläufer.“"
                            },
                            {
                                "example_id": "1ca6e684-560f-48a8-b021-b5a401673823",
                                "sense_id": "87003c94-90bb-3057-87f4-a31ed593ca46",
                                "text": "„Wir leben in einer Welt, in der Freizeitgolfer und Hobbyläufer in einem Maß Zugang zu Leistungsdaten haben, von dem Profisportler vor zehn Jahren nicht einmal träumen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
