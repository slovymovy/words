                        "examples": [
                            {
                                "example_id": "f9ae8ee0-99e3-45d4-a51a-6bf6dc6717c6",
                                "sense_id": "6e9a085f-b68a-3f92-b978-869ec39326f2",
                                "text": "„Wo war das frische Meer, wie er es an Septembermorgen an den Stränden Frankreichs kannte?“"
                            },
                            {
                                "example_id": "f578ecfd-eeb4-4335-aa4b-d496c92d24b9",
                                "sense_id": "6e9a085f-b68a-3f92-b978-869ec39326f2",
                                "text": "An einem Septembermorgen klingelte anstatt des Weckers das Mobiltelefon."
                            },
                            {
                                "example_id": "12cf4c07-9d63-440e-9186-5169ba5209cd",
                                "sense_id": "6e9a085f-b68a-3f92-b978-869ec39326f2",
                                "text": "„An einem wunderschönen Septembermorgen des Jahres 1945 tippelte ich an der Seite meiner Mutter über die Grenze bei Waldsassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
