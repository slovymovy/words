                "senses": [
                    {
                        "sense_id": "70b84545-a527-30b5-b68b-96a7894c0145",
                        "entry_id": "637f6514-b6d8-3bb2-958e-0c4d51b6bb3d",
                        "glosses": [
                            "Culture de plantes réalisée sans le support d’un sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "183166b1-19df-496c-9c8e-91e4cec42a05",
                                "sense_id": "70b84545-a527-30b5-b68b-96a7894c0145",
                                "text": "Et si on ne demande pas à tous les cultivateurs de s’intéresser à l’insémination artificielle, à l’hydroponie ou à la vernalisation des semences, il faut demander à tout le monde de se préparer à suivre la marche accélérée du progrès."
                            },
                            {
                                "example_id": "82c2fb71-1b9a-49b7-a0b9-4d396cba0700",
                                "sense_id": "70b84545-a527-30b5-b68b-96a7894c0145",
                                "text": "Ne cherchez pas de terre, « on est en hydroponie, explique Gilles Dreyfus. L’eau, mélangée à des sels minéraux et des nutriments, apporte aux racines ce qu’elles trouvent habituellement dans la terre. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
