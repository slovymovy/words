    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "def4b8d1-4c91-3e6c-8e6a-65e979d1b2db",
                    "sense_definition": "Attribuer la responsabilité d'une faute ou d'un échec à quelqu'un ; reprocher une action jugée mauvaise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reproche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On ne peut pas le <w>blâmer</w> d'avoir voulu protéger sa famille dans une telle situation."
                        },
                        {
                            "text": "Elle a toujours tendance à <w>blâmer</w> les autres pour ses propres erreurs professionnelles."
                        }
                    ],
                    "synonyms": [
                        "accuser",
                        "incriminer",
                        "reprocher"
                    ],
                    "antonyms": [
                        "approuver",
                        "féliciter",
                        "louer"
                    ],
                    "common_phrases": [
                        "ne pas pouvoir blâmer",
                        "blâmer quelqu'un de"
                    ]
                },
                {
                    "sense_id": "adc21989-4170-3d1a-b0fa-f11bd722d2fb",
                    "sense_definition": "Infliger une sanction morale ou disciplinaire formelle à quelqu'un ; réprimander officiellement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sanction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La commission de discipline a décidé de <w>blâmer</w> cet employé après sa négligence grave."
                        },
                        {
                            "text": "Le directeur a publiquement <w>blâmé</w> les membres du comité pour leur comportement inacceptable."
                        }
                    ],
                    "synonyms": [
                        "réprimander",
                        "sanctionner"
                    ],
                    "antonyms": [
                        "récompenser"
                    ],
                    "common_phrases": [
                        "blâmer publiquement",
                        "blâmer sévèrement"
                    ]
                }
            ]
        }
    ]
}