                        "target_lang_word": "έννομη συνέπεια",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "έννομη συνέπεια",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "0d4ada85-c11f-339f-bb93-cb9434f713a3",
                                        "entry_id": "ebbf70c8-69ec-38c5-a61a-cedb98e58699",
                                        "glosses": [
                                            "χαρακτηρίζεται το επερχόμενο αποτέλεσμα πράξης, που προβλέπει η υφιστάμενη νομοθεσία, ή οι όροι συνθήκης, ή νόμιμης σύμβασης, ή που ορίζει τελεσίδικα δικαστική Αρχή"
                                        ],
                                        "tags": [
                                            "νομικός όρος"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96da0d84-5677-4152-9d1e-b59d8c99922f",
                                                "sense_id": "0d4ada85-c11f-339f-bb93-cb9434f713a3",
                                                "text": "έννομη συνέπεια παράνομης πράξης είναι ο κολασμός αυτής"
                                            },
                                            {
                                                "example_id": "8444d201-1d72-4a10-9b07-4aa107d07fdd",
                                                "sense_id": "0d4ada85-c11f-339f-bb93-cb9434f713a3",
                                                "text": "έννομη συνέπεια της αγοραπωλησίας είναι η μεταβίβαση κυριότητας"
                                            },
                                            {
                                                "example_id": "f69f797c-2ff1-48ab-9a83-3cfada2a8f70",
                                                "sense_id": "0d4ada85-c11f-339f-bb93-cb9434f713a3",
                                                "text": "έννομη συνέπεια εκ της φορολογίας είναι η καταβολή, ή απαλλαγή φόρου, δασμού, ή τελών"
                                            },
                                            {
                                                "example_id": "cbf668df-df1d-4d48-a7e5-71a3e46ee728",
                                                "sense_id": "0d4ada85-c11f-339f-bb93-cb9434f713a3",
                                                "text": "έννομη συνέπεια της κατάπαυσης πυρός, όταν συνομολογείται, είναι η διακοπή των εχθροπραξιών"
                                            },
                                            {
                                                "example_id": "b1435ad7-3f9e-41cd-83bc-4dd3731ac103",
                                                "sense_id": "0d4ada85-c11f-339f-bb93-cb9434f713a3",
                                                "text": "έννομη συνέπεια της κατανάλωσης ηλεκτρικού ρεύματος είναι η εξόφληση του ιδίου λογαριασμού"
                                            },
                                            {
                                                "example_id": "b7ade7b6-23b2-4d75-94ae-448778663ce8",
                                                "sense_id": "0d4ada85-c11f-339f-bb93-cb9434f713a3",
                                                "text": "έννομη συνέπεια της ανθρωποκτονίας σε κάποιες πολιτείες της Αμερικής είναι η θανατική ποινή"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
