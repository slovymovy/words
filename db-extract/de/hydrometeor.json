                                    {
                                        "sense_id": "27b2619c-ed55-3ae3-9bc6-638a0c776bc2",
                                        "entry_id": "d913cfcd-053b-370b-8696-c9c48b63b5b5",
                                        "glosses": [
                                            "Forme sous laquelle se présente l’eau atmosphérique condensée, à l’exception des nuages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb8a9391-31ce-4fb8-8176-30d601db3ca1",
                                                "sense_id": "27b2619c-ed55-3ae3-9bc6-638a0c776bc2",
                                                "text": "La pluie, la bruine, la neige, la grêle, le brouillard, le givre, etc. sont des hydrométéores."
                                            },
                                            {
                                                "example_id": "262bcd7c-1831-4141-a5f1-b902eca90004",
                                                "sense_id": "27b2619c-ed55-3ae3-9bc6-638a0c776bc2",
                                                "text": "Les commentaire médiévaux n’échappent pas à cette tendance: la rosée ne désigne pas seulement l’hydrométéore mais, en fait, toute forme de dépôt sur les végétaux."
                                            },
                                            {
                                                "example_id": "83476d31-5fae-4b83-af86-07f6677d11a1",
                                                "sense_id": "27b2619c-ed55-3ae3-9bc6-638a0c776bc2",
                                                "text": "Lors de leur passage \"à travers\" l’isotherme 0°C, la fonte des hydrométéores glacés augmente la quantité de pluie."
                                            }
                                        ]
                                    }
                                ]
