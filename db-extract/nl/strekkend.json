                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f09a9bd5-b281-4482-91d2-85de3c932b80",
                                "sense_id": "4bef32b1-00f2-3b0c-8cdc-bbea3bab50e7",
                                "text": "Een wereldwijde primeur. Het totale kostenplaatje: 87 miljoen euro, oftewel bijna één miljoen euro per strekkende meter."
                            },
                            {
                                "example_id": "243d9c23-f577-4a98-a23c-61802eb84c8e",
                                "sense_id": "4bef32b1-00f2-3b0c-8cdc-bbea3bab50e7",
                                "text": "Van Jiuzhaigou maak je een haag van 2 tot 3 meter hoog. Met 15,95 euro per plant loopt dat nogal in de papieren, maar Fargesia’s breiden zich snel uit en je hoeft er dan ook maar één per strekkende meter te planten. Tenzij je erg ongeduldig bent; dan plant je er twee."
                            },
                            {
                                "example_id": "9a591b70-4025-4e27-9956-33f449d108db",
                                "sense_id": "4bef32b1-00f2-3b0c-8cdc-bbea3bab50e7",
                                "text": "Het gaat om bijna 100 strekkende meter houten bekleding met tientallen plantenbakken die eraan hangen."
                            }
                        ]
                    }
