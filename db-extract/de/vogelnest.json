                        "entry_id": "c8c2d807-7e0b-353a-bc94-6fc9b914faf9",
                        "glosses": [
                            "der meist in Bäumen oder Sträuchern befindliche Bau von Vögeln, in dem sie ihre Eier ablegen und ausbrüten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac97e016-1474-4c97-8db1-f7711093cc57",
                                "sense_id": "f01565ea-d970-35b2-97d5-ec7215786f41",
                                "text": "Während der Gartenarbeit fanden wir ein Vogelnest im Baum."
                            },
                            {
                                "example_id": "4d001277-a017-42ce-b572-e5e3b2a92288",
                                "sense_id": "f01565ea-d970-35b2-97d5-ec7215786f41",
                                "text": "„Er sah aus wie ein Knabe, der Vogelnester gefunden hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
