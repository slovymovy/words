                ],
                "senses": [
                    {
                        "sense_id": "fdbc58d4-6d2b-33e8-87d1-7f121ef99d48",
                        "entry_id": "9744f779-ab3a-3ecf-b94b-befa46c05413",
                        "glosses": [
                            "verbliebene Erinnerung oder Vorstellung, die bei der Wahrnehmung von Geruch in der Luft, an sich selbst oder von einer Substanz stammt; individuelle Zuordnung eines Geruchsstoffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a87116d2-35bd-45e9-beb3-f81437561986",
                                "sense_id": "fdbc58d4-6d2b-33e8-87d1-7f121ef99d48",
                                "text": "„Beim Einatmen eines Duftes wird der Geruchseindruck in den Riechzellen in einen Nervenimpuls umgewandelt, welcher via den Riechkolben an das limbische System des Gehirns weitergeleitet wird.“"
                            },
                            {
                                "example_id": "3b34f2aa-56f9-4980-80f3-08e11755dc8d",
                                "sense_id": "fdbc58d4-6d2b-33e8-87d1-7f121ef99d48",
                                "text": "„Rund 10 000 verschiedene Düfte kann unsere Nase unterscheiden. Diese verschiedenen Geruchseindrücke aus dem Gewirr einzelner Duftstoffe in der Luft herauszufiltern und zu identifizieren, ist für unseren Geruchssinn eine höchst anspruchsvolle Aufgabe.“"
                            },
                            {
                                "example_id": "1a3a3b50-2022-4e40-92f9-735da03147b0",
                                "sense_id": "fdbc58d4-6d2b-33e8-87d1-7f121ef99d48",
                                "text": "„Dazu wurden Schweinefleischproben mit bekannten Gehalten an diesen beiden Substanzen geprüft, wobei die Bewertung so erfolgte, dass nicht deren Intersitäten zu beschreiben waren, sondern die tatsächlich entstehenden Geruchseindrücke, also etwa „Schweineurin“, „Stallmist“ etc.“"
                            },
                            {
                                "example_id": "2f5650a8-2867-4205-b170-ba05978cd738",
                                "sense_id": "fdbc58d4-6d2b-33e8-87d1-7f121ef99d48",
                                "text": "„Heute verbindet man damit eher Geruchseindrücke, die aus dem Bereich der Geschmacksstoffe kommen.“"
                            },
                            {
                                "example_id": "392c2f8a-aa61-4adf-af6e-c4dadede86bf",
                                "sense_id": "fdbc58d4-6d2b-33e8-87d1-7f121ef99d48",
                                "text": "„Sowohl die Beladung mit schweren Atomen als auch die Substitution mit osmophoren Gruppen änderte nur die Nuance des Geruchseindruckes, nicht jedoch den \"Primärgeruch\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
