                                "target_lang_word": "обратный",
                                "target_lang_sense_clarification": "противоположный по отношению"
                            },
                            {
                                "target_lang_word": "противоположный",
                                "target_lang_sense_clarification": "обратный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karşıt",
                                "target_lang_sense_clarification": "zıt olan"
                            },
                            {
                                "target_lang_word": "ters",
                                "target_lang_sense_clarification": "yön veya ilişki bakımından"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "37cdc866-21db-3f74-92ec-15970e494b1f",
