                    },
                    {
                        "translation_id": "8dc29637-0c87-4801-917f-737847950bd7",
                        "source_entry_id": "b83c96d6-2d28-38e6-a03f-10835c7e1ec9",
                        "source_sense_description": "of or relating to vapour; having the characteristics or consistency of vapour",
                        "target_lang_word": "dampvormig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0a0ffe6e-4cfd-42cd-8f31-af7a8234efe5",
                        "source_entry_id": "b83c96d6-2d28-38e6-a03f-10835c7e1ec9",
                        "source_sense_description": "of or relating to vapour; having the characteristics or consistency of vapour",
                        "target_lang_word": "dunstig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dunstig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaab9a3e-c94c-39a1-8f08-05d9ebf8a377",
                                        "entry_id": "3576d9e7-856d-35a8-91a2-83252d5dfa8e",
                                        "glosses": [
                                            "voll feuchter Luft; leicht neblig, trüb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9631f5a-5067-4cef-b097-f99141896b51",
                                                "sense_id": "aaab9a3e-c94c-39a1-8f08-05d9ebf8a377",
                                                "text": "Der Regen ist einem dunstigen Sonnenschein gewichen, und endlos ziehen sich die Grenzzäune an der »Straße der Einheit« entlang."
                                            },
                                            {
                                                "example_id": "92b7c986-d4e0-47ae-a231-8bcac0fd07ee",
                                                "sense_id": "aaab9a3e-c94c-39a1-8f08-05d9ebf8a377",
                                                "text": "Die Sonne legt einen dermaßen rosafarbenen Streif über die dunstige Parklandschaft aus Bäumen, Hügeln und Auen, dass man den hässlichen Scheinfrieden am Eingang liebsten vergessen möchte."
                                            },
                                            {
                                                "example_id": "4f258e0f-ee62-4542-b3b9-8b38dbc0bd07",
                                                "sense_id": "aaab9a3e-c94c-39a1-8f08-05d9ebf8a377",
                                                "text": "Er hat das Dach seines Cabrios aufgemacht, der Himmel über Teneriffa ist milchig, dunstig, Südwind bringt Sand von Afrika."
                                            },
                                            {
                                                "example_id": "e40ac394-50b2-48f3-afd4-813608bb6a92",
                                                "sense_id": "aaab9a3e-c94c-39a1-8f08-05d9ebf8a377",
                                                "text": "\"Unter dunstigen Bedingungen bei starker Luftverschmutzung gedeihen Pflanzen oft besonders gut\", sagte Steven Sitch, der an dieser Studie ebenfalls mitgewirkt hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59f47f45-5b2f-3541-8d1b-c2838eba2e4f",
                                        "entry_id": "3576d9e7-856d-35a8-91a2-83252d5dfa8e",
                                        "glosses": [
                                            "mit sauerstoffarmer, meist verrauchter Luft erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5636dd5a-dcc8-4620-9869-1896c7997f52",
                                                "sense_id": "59f47f45-5b2f-3541-8d1b-c2838eba2e4f",
                                                "text": "Dabei könnten dunstige Kabinen durchaus bald zu Relikten aus der Nichtraucherschutz-Frühzeit werden."
                                            },
                                            {
                                                "example_id": "58f380e4-1dbc-4003-b901-147946fd7d70",
                                                "sense_id": "59f47f45-5b2f-3541-8d1b-c2838eba2e4f",
                                                "text": "Selten ist der Aufbruchswille so deutlich wie in Zigarettenwerbungen der Siebziger, als es noch schick war, sich in dunstigen Kneipen „Roth Händle“ oder Selbstgedrehte anzustecken."
                                            },
                                            {
                                                "example_id": "0deb5467-6c38-4be3-817e-61b09b4adb0a",
                                                "sense_id": "59f47f45-5b2f-3541-8d1b-c2838eba2e4f",
                                                "text": "In der Tür des Schulhauses aber stand der Lehrer und zog mit voller Brust, nach drei Stunden dunstiger, erdrückender Schulstubenatmosphäre, die kalte, frische Luft ein, die von dem See herüberstrich."
                                            },
                                            {
                                                "example_id": "afbb550f-63fe-45e8-b685-7f71d6c1a1fb",
                                                "sense_id": "59f47f45-5b2f-3541-8d1b-c2838eba2e4f",
