                "senses": [
                    {
                        "sense_id": "650ec05e-cb9c-35ee-8b30-7f5f53e5572c",
                        "entry_id": "8c40f0a3-a45e-38c6-9884-9fae5897aea9",
                        "glosses": [
                            "Enlever ses bottines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22b93f96-116a-468f-9dff-769e60790176",
                                "sense_id": "650ec05e-cb9c-35ee-8b30-7f5f53e5572c",
                                "text": "La troupe a campé, sans débottiner, sur la scène même, théâtre futur de ses exploits; chacun s’est étendu de son mieux sur l’élasticité douteuse d’un portant ou d’une planche à quinquets."
                            },
                            {
                                "example_id": "ba14de3e-ab15-4145-be95-969ee1941c78",
                                "sense_id": "650ec05e-cb9c-35ee-8b30-7f5f53e5572c",
                                "text": "Le moment de la journée que je préfère, c’est quand je peux m’asseoir et me débottiner le pied."
                            }
                        ]
                    }
