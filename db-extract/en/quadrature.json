                    {
                        "translation_id": "72a9b0c4-068b-478a-900b-a345611180aa",
                        "source_entry_id": "39834f9c-1db4-3b29-a555-7890e19a7cba",
                        "source_sense_description": "mathematics",
                        "target_lang_word": "quadrature",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
