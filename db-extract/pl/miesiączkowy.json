                    {
                        "translation_id": "65b76780-aead-4c1d-a8ae-ea0108a9e8ae",
                        "source_entry_id": "9f8cfe05-665a-3223-a776-adf2ca3dadb2",
                        "source_sense_id": "fd2fe9b3-eb62-3295-88b4-de8a00b5bec3",
