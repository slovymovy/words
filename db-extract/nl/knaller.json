                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e77675-0914-4731-b6bb-b37de2d37c4a",
                                "sense_id": "591f899c-e747-35cc-a8d3-180d3ce0454e",
                                "text": "Tijdens oud en nieuw hoorden we de hele dag enorme knallers"
                            },
                            {
                                "example_id": "06f892f1-7e32-4bc6-bc39-7fbbf3d52676",
                                "sense_id": "591f899c-e747-35cc-a8d3-180d3ce0454e",
                                "text": "Knalvuurwerk leverde rond de afgelopen jaarwisseling relatief veel slachtoffers op. 64 procent van de verwondingen werd veroorzaakt door knallers."
                            }
                        ]
                    },
                    {
                        "sense_id": "03503b6a-4f45-3985-a8a3-911ce0dacd40",
                        "entry_id": "50d92fd1-5c9e-3b0c-969b-a5d195b5e221",
                        "glosses": [
                            "een voetballer die veel doelpunten maakt, succesvolle speler"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d34f6536-1839-47cc-84e0-effddb99556a",
                                "sense_id": "03503b6a-4f45-3985-a8a3-911ce0dacd40",
                                "text": "Voetjeballer, schoten knaller, Speler uit de eerste klas, Wien ’t publiek nooit kon vervelen,"
                            }
                        ]
                    },
                    {
                        "sense_id": "12107449-0621-34d9-9a7e-881e7931d4e6",
