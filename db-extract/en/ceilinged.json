                        ],
                        "examples": [
                            {
                                "example_id": "f2fc39ab-3490-4c8f-9ddc-2ef7b53ac724",
                                "sense_id": "e13770e7-9746-35b9-a3b2-31a2f122c117",
                                "text": "Cow Farm was a rambling building, with dark, uneven stairs, low-ceilinged rooms, queer, odd corners, and sudden unexpected doors."
                            },
                            {
                                "example_id": "f27f4be9-f2a3-4d34-9e23-d973fe338fa0",
                                "sense_id": "e13770e7-9746-35b9-a3b2-31a2f122c117",
                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century,[…]."
                            },
                            {
                                "example_id": "7453e9b6-1130-4231-aae9-6c8887ae7cb2",
                                "sense_id": "e13770e7-9746-35b9-a3b2-31a2f122c117",
                                "text": "My room was high ceilinged, lonely and full of echoes."
                            },
                            {
                                "example_id": "33ce2779-4a1f-4829-9b3f-bd416485104e",
                                "sense_id": "e13770e7-9746-35b9-a3b2-31a2f122c117",
                                "text": "The vault was low-ceilinged, dimly lit and gigantic."
                            }
                        ]
                    }
