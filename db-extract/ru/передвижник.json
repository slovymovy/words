                                    {
                                        "sense_id": "1db17f96-02c1-3549-8676-fb1134381b70",
                                        "entry_id": "1ed3bcc0-1064-32bf-983f-f912b6c8dd7e",
                                        "glosses": [
                                            "Personne itinérante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953263fd-fe8a-485f-bffe-241a16760590",
                                                "sense_id": "1db17f96-02c1-3549-8676-fb1134381b70",
                                                "text": "Dans le comté d’Okanagan, État de Washington, les itinérants affluent pour édifier un barrage sur le fleuve Columbia et dépenser, comme au temps du Far West, leur paie dans les bars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72cec0e8-210b-3ba2-83dd-b41e9d668710",
                                        "entry_id": "1ed3bcc0-1064-32bf-983f-f912b6c8dd7e",
                                        "glosses": [
                                            "Sans-abri, qui n’a pas de domicile fixe."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "769d13dd-92cd-4230-85f4-8823ded64358",
                                                "sense_id": "72cec0e8-210b-3ba2-83dd-b41e9d668710",
                                                "text": "Je croise un itinérant d’environ l’âge de mon père qui picole sur un banc de parc tout près du mont Royal."
                                            },
                                            {
                                                "example_id": "944ad792-ceb4-4e73-aa0e-0bb7e021fffd",
                                                "sense_id": "72cec0e8-210b-3ba2-83dd-b41e9d668710",
                                                "text": "L’arrondissement se défend d’avoir adopté un règlement taillé sur mesure pour tenir à l’écart des parcs les nombreux itinérants du secteur, dont plusieurs possèdent des chiens."
                                            },
                                            {
                                                "example_id": "6277702b-07a8-4571-a602-376d31ba5815",
                                                "sense_id": "72cec0e8-210b-3ba2-83dd-b41e9d668710",
                                                "text": "Les itinérants chroniques composent à peine 10 % de la population des sans-abri aux États-Unis."
                                            },
                                            {
                                                "example_id": "927d10f5-3b81-4543-bd0f-e668482adc5a",
                                                "sense_id": "72cec0e8-210b-3ba2-83dd-b41e9d668710",
                                                "text": "Elle déplore que l'administration municipale et la Croix-Rouge ne s'impliquent pas plus pour aider les itinérants."
                                            }
                                        ]
                                    }
                                ]
                            },
