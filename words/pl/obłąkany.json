                    "semantic_group_id": "choroba_psychiczna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarze w szpitalu próbowali uspokoić agresywnego <w>obłąkanego</w>, który krzyczał bez przerwy.",
                            "target_lang_translations": {
                                "ru": "Врачи в больнице пытались успокоить буйного <w>умалишённого</w>, который непрерывно кричал."
                            }
