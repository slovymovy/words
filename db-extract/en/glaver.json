                "senses": [
                    {
                        "sense_id": "8c9d98c8-f174-36ea-9a4f-baae4ab49755",
                        "entry_id": "30d0bced-c254-3896-97c5-534361b86a2e",
                        "glosses": [
                            "To flatter; to wheedle."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "53e566a3-ca83-4cb0-8650-c4ddd0d955a7",
                                "sense_id": "8c9d98c8-f174-36ea-9a4f-baae4ab49755",
                                "text": "Some slavish, glavering, flattering parasite."
                            },
                            {
                                "example_id": "efe2cf88-e62d-4d8f-9d32-28f101dc42c1",
                                "sense_id": "8c9d98c8-f174-36ea-9a4f-baae4ab49755",
                                "text": "Luke. Item, that the Honourable Ms. Gloriana Strut is ſo fantaſtical in her Dreſs, and trifles away ſo many Hours in admiring herſelf, and being glavered by her Maid, that ſhe always comes into Church, when the reſt of the Congregation are intent upon their Devotions;"
                            },
                            {
                                "example_id": "45adc18f-549b-4203-85e4-1997019a169f",
                                "sense_id": "8c9d98c8-f174-36ea-9a4f-baae4ab49755",
                                "text": "No doubt the users of hackney-coaches “glavered” on the users of glass-coaches. To glaver, need we say, was to fawn — with words of glozing courtesy, to flatter deceitfully."
                            }
                        ]
                    }
