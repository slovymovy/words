                "senses": [
                    {
                        "sense_id": "c4d80681-498e-310a-8db8-47a5ef8edc2e",
                        "entry_id": "2894e912-baef-3312-bd8c-075441818cde",
                        "glosses": [
                            "Person, die bahnbrechende Leistungen für die Entwicklung der Computertechnik erbracht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94f79dbe-57b2-4a27-8276-f85120a594dd",
                                "sense_id": "c4d80681-498e-310a-8db8-47a5ef8edc2e",
                                "text": "„In seinen letzten Lebensjahren wandte Zuse sich der Kunst, insbesondere der Malerei, zu. Am 18. Dezember 1995 starb der Computerpionier, der in seinem Leben niemals einen PC besessen hatte, im Alter von 85 Jahren.“"
                            },
                            {
                                "example_id": "11932994-3f54-4c80-a8af-417b676bd18e",
                                "sense_id": "c4d80681-498e-310a-8db8-47a5ef8edc2e",
                                "text": "„Das Gespräch endet höflich aber bestimmt. Konrad Zuse, der Computerpionier, fliegt zutiefst gekränkt zurück.“"
                            },
                            {
                                "example_id": "cbf0e9ca-3902-4106-9f6e-90a0befc5923",
                                "sense_id": "c4d80681-498e-310a-8db8-47a5ef8edc2e",
                                "text": "„Die Arbeit der Computerpioniere John Atanasov in den USA oder von Konrad Zuse in Deutschland wurde durch den Zweiten Weltkrieg stark behindert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
