                "senses": [
                    {
                        "sense_id": "a8ef83cf-2034-3560-8976-9499d437c14c",
                        "entry_id": "920bf7d1-964c-33b8-9c20-09a19971acbc",
                        "glosses": [
                            "Ganter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f55fa537-10bf-4212-a10f-fa9c2025844c",
                                "sense_id": "a8ef83cf-2034-3560-8976-9499d437c14c",
                                "text": "Vers onze heures, ils entrèrent au Club, avec l’intention d’y distribuer deux ou trois poignées de main, de s’y déganter, de s’y reganter et de partir."
                            },
                            {
                                "example_id": "09ca4c90-8ddd-4c95-a5f4-ecf23b9a0e7f",
                                "sense_id": "a8ef83cf-2034-3560-8976-9499d437c14c",
                                "text": "Elle ne bougea pas. Alors il lui prit le poignet qu’il serra avec une réelle affection ; mais, en sortant de la salle d’escrime, il vit le long de ses doigts qu’il regantait une légère trace sanglante."
                            }
                        ]
                    }
                ],
