                ],
                "senses": [
                    {
                        "sense_id": "1400f84e-fb08-37f8-9019-b8627019992c",
                        "entry_id": "a7dd0eaf-7ba8-33cb-b05e-39b621a5dd43",
                        "glosses": [
                            "ungeformtes flüssiges, weiches oder zähes Polymer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a2cf9ad-caf0-4d7a-b4fe-3321474f7471",
                                "sense_id": "1400f84e-fb08-37f8-9019-b8627019992c",
                                "text": "„Die vom VN hergestellte Kunststoffmasse ist nicht homogen eingefärbt. Die vom Abnehmer daraus gepressten Kunststoffgeschirre weisen Schlieren auf und sind daher minderwertig.“"
                            },
                            {
                                "example_id": "3ca064b8-a59d-46b6-8af9-7cb7254afdf3",
                                "sense_id": "1400f84e-fb08-37f8-9019-b8627019992c",
                                "text": "„Das Färben der Kunststoffmasse - ist die am meisten verbreitete und ökonomisch die sinnvollste Methode der Dekorierung von Kunststofferzeugnissen. Das Färben der Kunststoffmasse umfasst folgende Stadien: die Vermischung des Polymers mit dem Farbstoff oder dem Pigment, das Schmelzen der gefärbten Mischung und die Formung des Erzeugnisses.“"
                            },
                            {
                                "example_id": "aa9b72f6-1ef3-49e2-810d-b625bac22a5b",
                                "sense_id": "1400f84e-fb08-37f8-9019-b8627019992c",
                                "text": "„(eine Krone aus Metall)mit einer der Farbe der Zähne angepassten Kunststoffmasse überziehen.“"
                            },
                            {
                                "example_id": "621fddc9-c511-4474-9bd5-5b1e24e0575e",
                                "sense_id": "1400f84e-fb08-37f8-9019-b8627019992c",
                                "text": "„Es entsteht durch die von uns eingebrachte Kunststoffmasse im Rohrinneren eine durchgehende Kunststoffbeschichtung, also auch über vorhandene Muffen - Zwischenräume, da diese ebenfalls mit der Kunststoffmasse überzogen werden.“"
                            },
                            {
                                "example_id": "7124dbb5-d658-4c43-bbda-2b095bbe58bf",
                                "sense_id": "1400f84e-fb08-37f8-9019-b8627019992c",
                                "text": "„Die Erfindung betrifft eine elektrisch isolierende, gut wärmeleitende Kunststoffmasse mit als Füllstoff enthaltenen Aluminiumpulverpartikeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
