{
    "word_family": [
        "obligation",
        "obligatory",
        "obligee",
        "obligor",
        "disoblige"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a00d0fd-6c36-3861-a8db-33475d8003a8",
                    "sense_definition": "To do a service or favor for someone in order to help them or please them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "favor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shopkeeper was happy to <w>oblige</w> the customer by gift-wrapping the item for free.",
                            "target_lang_translations": {
                                "ru": "Продавец был рад <w>сделать одолжение</w> покупателю, бесплатно упаковав товар в подарочную бумагу."
                            }
                        },
                        {
                            "text": "If you need a ride to the airport, I would be happy to <w>oblige</w>.",
                            "target_lang_translations": {
                                "ru": "Если вам нужно подбросить вас до аэропорта, я буду рад <w>помочь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "accommodate",
                        "favor",
                        "help",
                        "gratify"
                    ],
                    "antonyms": [
                        "refuse",
                        "deny"
                    ],
                    "common_phrases": [
                        "happy to oblige",
                        "willing to oblige"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказать услугу или любезность кому-либо, чтобы помочь или угодить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделать одолжение",
                                "target_lang_sense_clarification": "оказать услугу"
                            },
                            {
                                "target_lang_word": "пойти навстречу",
                                "target_lang_sense_clarification": "согласиться помочь"
                            },
                            {
                                "target_lang_word": "любезно согласиться",
                                "target_lang_sense_clarification": "выполнить просьбу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffab9e46-dc87-3484-9949-6df8454f59a5",
                    "sense_definition": "To force or require someone to do something because of a law, rule, or moral duty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "requirement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law will <w>oblige</w> companies to disclose their annual carbon emissions to the public.",
                            "target_lang_translations": {
                                "ru": "Закон <w>обяжет</w> компании раскрывать общественности данные о ежегодных выбросах углекислого газа."
                            }
                        },
                        {
                            "text": "Circumstances <w>oblige</w> me to resign from my position effective immediately.",
                            "target_lang_translations": {
                                "ru": "Обстоятельства <w>вынуждают</w> меня уйти в отставку с этой должности немедленно."
                            }
                        }
                    ],
                    "synonyms": [
                        "compel",
                        "force",
                        "require",
                        "constrain"
                    ],
                    "antonyms": [
                        "exempt",
                        "release",
                        "permit"
                    ],
                    "common_phrases": [
                        "legally oblige",
                        "morally oblige"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять или требовать от кого-либо выполнения чего-либо в силу закона, правила или морального долга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обязывать",
                                "target_lang_sense_clarification": "налагать обязательство"
                            },
                            {
                                "target_lang_word": "принуждать",
                                "target_lang_sense_clarification": "заставлять под давлением обстоятельств"
                            },
                            {
                                "target_lang_word": "вынуждать",
                                "target_lang_sense_clarification": "ставить в условия необходимости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba94f0fb-1884-3ad6-b4ca-ac9f298a8510",
                    "sense_definition": "To make someone feel indebted or grateful for a favor or service.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gratitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am much <w>obliged</w> to you for your hospitality during my stay in London.",
                            "target_lang_translations": {
                                "ru": "Я очень <w>обязан</w> вам за ваше гостеприимство во время моего пребывания в Лондоне."
                            }
                        },
                        {
                            "text": "We are deeply <w>obliged</w> for the support you have shown our family.",
                            "target_lang_translations": {
                                "ru": "Мы глубоко <w>признательны</w> за поддержку, которую вы оказали нашей семье."
                            }
                        }
                    ],
                    "synonyms": [
                        "indebt"
                    ],
                    "common_phrases": [
                        "much obliged"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо чувствовать себя обязанным или благодарным за услугу или помощь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть обязанным",
                                "target_lang_sense_clarification": "чувствовать благодарность"
                            },
                            {
                                "target_lang_word": "признателен",
                                "target_lang_sense_clarification": "выражение благодарности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}