            "senses": [
                {
                    "sense_id": "e4afcc08-aef1-3c9a-8ce6-d4af3b60ba65",
                    "sense_definition": "Récipient large et peu profond utilisé pour la toilette ou diverses tâches ménagères.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a rempli la <w>cuvette</w> d'eau tiède pour laver le linge délicat à la main."
                        },
                        {
                            "text": "Il pose une grande <w>cuvette</w> en plastique sur la table pour préparer la pâte."
                        }
                    ],
                    "synonyms": [
                        "bassine"
                    ]
                },
                {
                    "sense_id": "c926e364-1d7c-3a8c-a148-67b20444920b",
                    "sense_definition": "Partie creuse d'un appareil sanitaire recevant les eaux et les déjections.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sanitaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à bien nettoyer la <w>cuvette</w> des toilettes avec ce produit désinfectant."
                        },
                        {
                            "text": "L'eau coule sans arrêt au fond de la <w>cuvette</w> à cause d'une fuite."
                        }
                    ],
                    "common_phrases": [
                        "cuvette des toilettes",
                        "cuvette des WC"
                    ]
                },
                {
                    "sense_id": "3b25d7a5-63fe-3f04-ae51-e892beed4a48",
                    "sense_definition": "Dépression ou creux naturel de terrain entouré de reliefs plus élevés.",
