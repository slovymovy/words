    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8d361d15-910e-3ecd-9c6f-f00a3c167799",
                    "sense_definition": "Featuring a lot of sunshine.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a warm and <w>sunny</w> day at the beach.",
                            "target_lang_translations": {
                                "ru": "Это был тёплый и <w>со́лнечный</w> день на пляже.",
                                "zh": "海滩上度过了温暖而<w>晴朗</w>的一天。"
                            }
                        },
                        {
                            "text": "Although it is <w>sunny</w> right now, the forecast predicts rain later.",
                            "target_lang_translations": {
                                "ru": "Хотя сейчас <w>со́лнечно</w>, прогноз обещает дождь позже.",
                                "zh": "虽然现在<w>阳光明媚</w>，但预报说晚些时候会有雨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bright",
                        "sunshiny",
                        "cloudless",
                        "clear"
                    ],
                    "antonyms": [
                        "sunless"
                    ],
                    "common_phrases": [
                        "sunny day",
                        "sunny weather",
                        "sunny afternoon",
                        "warm and sunny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся большим количеством солнечного света (о погоде или дне).",
                        "zh": "指天气或日子阳光充足。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со́лнечный",
                                "target_lang_sense_clarification": "о погоде или дне"
                            },
                            {
                                "target_lang_word": "я́сный",
                                "target_lang_sense_clarification": "безоблачный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晴朗的",
                                "target_lang_sense_clarification": "形容天气"
                            },
                            {
                                "target_lang_word": "阳光明媚的",
                                "target_lang_sense_clarification": "形容天气或日子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b945e73-326c-3f57-bf39-527d673d72f2",
                    "sense_definition": "Receiving a lot of sunshine.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat in a <w>sunny</w> spot in the garden to keep warm.",
                            "target_lang_translations": {
                                "ru": "Мы сели в <w>со́лнечном</w> месте в саду, чтобы согреться.",
                                "zh": "我们坐在花园里一个<w>向阳</w>的地方取暖。"
                            }
                        },
                        {
                            "text": "She requested a <w>sunny</w> room with a view of the park.",
                            "target_lang_translations": {
                                "ru": "Она попросила <w>со́лнечную</w> комнату с видом на парк.",
                                "zh": "她要求住一间能看到公园、<w>阳光充足</w>的房间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sunlit",
                        "bright"
                    ],
                    "common_phrases": [
                        "sunny side",
                        "sunny room",
                        "sunny spot",
                        "sunny garden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Освещённый солнцем.",
                        "zh": "指被阳光照耀的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со́лнечный",
                                "target_lang_sense_clarification": "освещённый солнцем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "向阳的",
                                "target_lang_sense_clarification": "指位置或房间"
                            },
                            {
                                "target_lang_word": "阳光充足的",
                                "target_lang_sense_clarification": "指空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "594eefe2-6d89-3363-b14b-4ad2f2e03648",
                    "sense_definition": "Cheerful and happy in manner or appearance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has such a <w>sunny</w> disposition that everyone loves being around her.",
                            "target_lang_translations": {
                                "ru": "У неё такой <w>жизнера́достный</w> характер, что все любят находиться рядом с ней.",
                                "zh": "她性格非常<w>开朗</w>，大家都喜欢和她在一起。"
                            }
                        },
                        {
                            "text": "Despite the bad news, he tried to maintain a <w>sunny</w> attitude.",
                            "target_lang_translations": {
                                "ru": "Несмотря на плохие новости, он старался сохранять <w>позити́вный</w> настрой.",
                                "zh": "尽管有坏消息，他还是尽量保持<w>阳光</w>的心态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cheerful",
                        "bright"
                    ],
                    "common_phrases": [
                        "sunny disposition",
                        "sunny smile",
                        "sunny personality",
                        "sunny mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жизнерадостный и весёлый по характеру или внешнему виду.",
                        "zh": "指性格或外表开朗、快乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жизнера́достный",
                                "target_lang_sense_clarification": "о характере"
                            },
                            {
                                "target_lang_word": "лучеза́рный",
                                "target_lang_sense_clarification": "о человеке или улыбке"
                            },
                            {
                                "target_lang_word": "весёлый",
                                "target_lang_sense_clarification": "радостный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开朗的",
                                "target_lang_sense_clarification": "形容性格"
                            },
                            {
                                "target_lang_word": "阳光的",
                                "target_lang_sense_clarification": "形容性格或气质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8a70724-5ff0-3a67-bb83-8d6e578de12b",
                    "sense_definition": "Of or relating to the sun; radiant or shiny.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter used <w>sunny</w> yellows to capture the warmth of the field.",
                            "target_lang_translations": {
                                "ru": "Художник использовал <w>со́лнечные</w> жёлтые тона, чтобы передать тепло поля.",
                                "zh": "画家用了<w>金色</w>来捕捉田野的温暖。"
                            }
                        },
                        {
                            "text": "Her <w>sunny</w> locks flowed down her shoulders like gold.",
                            "target_lang_translations": {
                                "ru": "Её <w>золоти́стые</w> локоны спадали на плечи, как золото.",
                                "zh": "她那<w>金色</w>的秀发像金子一样垂在肩上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often poetic or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к солнцу; сияющий или яркий.",
                        "zh": "与太阳有关的；光辉灿烂的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со́лнечный",
                                "target_lang_sense_clarification": "о цвете или свете"
                            },
                            {
                                "target_lang_word": "золоти́стый",
                                "target_lang_sense_clarification": "о цвете волос"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金色的",
                                "target_lang_sense_clarification": "形容颜色"
                            },
                            {
                                "target_lang_word": "明亮的",
                                "target_lang_sense_clarification": "形容光泽"
                            }
                        ]
                    }
                }
            ]
        },
        {
