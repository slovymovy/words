                    {
                        "translation_id": "1561929b-e593-4b4d-ad8f-c4cfd31366ec",
                        "source_entry_id": "7abcd0f8-e4f2-3837-aab5-0be6891b6757",
                        "source_sense_description": "historical gold coin",
                        "target_lang_word": "ducat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
