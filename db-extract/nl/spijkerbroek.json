                        "source_sense_id": "5d5189b8-18ba-3b3d-b17a-3372f8ce6c49",
                        "source_sense_description": "een broek van spijkerstof",
                        "target_lang_word": "Jeans",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jeans",
