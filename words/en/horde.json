                            },
                            {
                                "target_lang_word": "foule",
                                "target_lang_sense_clarification": "Un grand nombre de personnes rassemblées."
                            },
                            {
                                "target_lang_word": "nuée",
                                "target_lang_sense_clarification": "Un grand nombre de personnes ou d'animaux se déplaçant ensemble."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一大群",
