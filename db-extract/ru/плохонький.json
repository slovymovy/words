                "senses": [
                    {
                        "sense_id": "c374d8f7-96d0-3875-8bc1-d32889379e0f",
                        "entry_id": "e4d37df6-f75c-3434-b4e9-d624d35de19d",
                        "glosses": [
                            "разг., прост., уменьш.-уничиж. к плохой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a7d735f-729d-48ed-b8c6-4c5bd2db3655",
                                "sense_id": "c374d8f7-96d0-3875-8bc1-d32889379e0f",
                                "text": "Будь плохонький, да если наберется душ тысячи две родовых, тот и жених."
                            },
                            {
                                "example_id": "ca2d5a2a-7385-47b6-96da-6d1f4dbcc906",
                                "sense_id": "c374d8f7-96d0-3875-8bc1-d32889379e0f",
                                "text": "И ведь хоть бы какого плохонького осетренка прислал тебе, матушка."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b91f9af-f6b0-3615-ab6b-a6f998f5a23b",
                        "entry_id": "e4d37df6-f75c-3434-b4e9-d624d35de19d",
                        "glosses": [
                            "тоже, что и слабый"
                        ],
