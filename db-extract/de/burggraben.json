                    {
                        "form_id": "c80586e3-ae67-4744-9160-86ab07ed63b5",
                        "entry_id": "ab3b1f70-e242-33bf-bf28-93c5172881de",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Burggräben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc50d6cc-6d3e-39c9-8c0e-7e42a07151b3",
                        "entry_id": "ab3b1f70-e242-33bf-bf28-93c5172881de",
                        "glosses": [
                            "defensiver, um eine Burg herum ausgehobener Graben, der oft mit Wasser gefüllt ist/war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed5d270c-17d3-4fbe-ac4f-090b703c8767",
                                "sense_id": "dc50d6cc-6d3e-39c9-8c0e-7e42a07151b3",
                                "text": "Ein Burggraben schützt die Burg vor Eindringlingen."
                            },
                            {
                                "example_id": "e9ff5404-aedd-44bb-aea9-a94178e4ba87",
                                "sense_id": "dc50d6cc-6d3e-39c9-8c0e-7e42a07151b3",
                                "text": "„Im Tal floss der Dnjepr-Strom und umgab Smolensk wie ein Burggraben.“"
                            },
                            {
                                "example_id": "882c5472-32f6-45aa-a1d0-4c53f1e204ec",
                                "sense_id": "dc50d6cc-6d3e-39c9-8c0e-7e42a07151b3",
                                "text": "„Wer nachts einmal ›rausmusste‹, der musste wirklich hinaus, entweder auf einen abgelegenen Ort im Hof oder in einen Steinerker, von dem das, wovon man sich ›erleichterte‹, die Mauer hinabrann oder in den Burggraben plumpste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "474e92eb-8834-3df2-81d6-97c8a14589c9",
                        "entry_id": "ab3b1f70-e242-33bf-bf28-93c5172881de",
                        "glosses": [
                            "Summe der Faktoren, die für einen längeren Zeitraum eine unüberwindliche ökonomische Hürde für das Entstehen möglicher Konkurrenten bildet"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "1dda325a-29b4-4b07-a410-c2edc91c45ac",
                                "sense_id": "474e92eb-8834-3df2-81d6-97c8a14589c9",
                                "text": "„Burggräben sind strukturelle Barrieren zum Schutz der eigenen Wettbewerbsposition“"
                            },
                            {
                                "example_id": "b0708534-679e-40d9-b747-4b0369dddf6c",
                                "sense_id": "474e92eb-8834-3df2-81d6-97c8a14589c9",
                                "text": "„Übertragen auf Firmen ist der Burggraben eines Unternehmens eine starke Marke, ein starker Bekanntheitsgrad verbunden mit hoher Kundenbindung, ein Monopol oder eine monopolartige Stellung, hohe Wechselkosten für den Kunden, Netzwerkeffekte, (technisches) Know-How, eine starke Marktstellung oder ein sonstiger Wettbewerbsvorteil.“"
                            },
                            {
                                "example_id": "d6c316e0-0cc0-4c09-a9ff-92621dd3a767",
                                "sense_id": "474e92eb-8834-3df2-81d6-97c8a14589c9",
                                "text": "„Beim Softwarekonzern Oracle ist der Burggraben die gute Kundenbindung […]“"
                            },
                            {
                                "example_id": "001db046-df6a-4d4c-81ad-defd1c98a762",
                                "sense_id": "474e92eb-8834-3df2-81d6-97c8a14589c9",
                                "text": "„Denn für einen breiten Burggraben ist es wichtig, dass […] Ihr gesamtes Unternehmen eine strategische Kompetenz erwirbt.“"
                            },
                            {
                                "example_id": "85bd2b1a-d572-48bc-9faf-7c3a9fea43a9",
                                "sense_id": "474e92eb-8834-3df2-81d6-97c8a14589c9",
                                "text": "„Musk bezeichnete den Burggraben (engl. Moat) mit den Adjektiven ‚lahm‘ und ‚urig‘ als lächerlich und überholt. Er […] meint, dass stattdessen die Innovationsgeschwindigkeit das Maß aller Dinge sei.“"
                            },
                            {
                                "example_id": "e0258bfb-d30e-4585-b51c-1c537ac1df70",
                                "sense_id": "474e92eb-8834-3df2-81d6-97c8a14589c9",
                                "text": "„New-England-Stoffe hatten keinen langfristigen Wettbewerbsvorteil, keinen Burggraben, der ihre Aussichten geschützt hätte, und die Produktion war letztlich nicht zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cba76a7-9508-4215-80d7-088c8be4c6fb",
                        "source_entry_id": "ab3b1f70-e242-33bf-bf28-93c5172881de",
                        "source_sense_id": "dc50d6cc-6d3e-39c9-8c0e-7e42a07151b3",
                        "source_sense_description": "um eine Burg herum ausgehobener Graben",
                        "target_lang_word": "castle moat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c67bb3a1-a197-4443-8d23-98170fc3d6ce",
                        "source_entry_id": "ab3b1f70-e242-33bf-bf28-93c5172881de",
                        "source_sense_id": "dc50d6cc-6d3e-39c9-8c0e-7e42a07151b3",
                        "source_sense_description": "um eine Burg herum ausgehobener Graben",
                        "target_lang_word": "moat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb707f09-71a7-3f73-b707-38f2ed0eb197",
                                        "entry_id": "0e2cc307-8101-3d05-be97-eccdeca718d4",
                                        "glosses": [
                                            "A deep, wide defensive ditch, normally filled with water, surrounding a fortified habitation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd468ec3-285c-344d-b2a0-569b4260a507",
                                        "entry_id": "0e2cc307-8101-3d05-be97-eccdeca718d4",
                                        "glosses": [
                                            "An aspect of a business which makes it more \\\"defensible\\\" from competitors, because of the nature of its products, services or franchise or for some other reason."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32046d55-9f3d-48fc-a150-e813a6253488",
                                                "sense_id": "cd468ec3-285c-344d-b2a0-569b4260a507",
                                                "text": "No matter how good your company's product is or how quickly the industry is growing, if there is no moat, competitors will invade your castle and burn it down."
                                            },
                                            {
                                                "example_id": "9dc5a90e-3584-45b4-b125-312652a253a0",
                                                "sense_id": "cd468ec3-285c-344d-b2a0-569b4260a507",
                                                "text": "“I think ‘moats’ are lame,” Mr. Musk had said during a Tesla earnings call. It was a criticism of an economic principle that Mr. Buffett had coined in 1999 and that has become something of a mantra for his faithful: Invest in businesses “that have wide, sustainable moats around them.”"
                                            },
                                            {
                                                "example_id": "d54d136a-9e44-4430-86e5-24f24090c5f8",
                                                "sense_id": "cd468ec3-285c-344d-b2a0-569b4260a507",
                                                "text": "Moreover, where older firms might have to stave off competitors and engage in practices like predatory pricing to keep the competition at bay, platform monopolies have a built-in moat. Since a platform’s value comes from its number of users—a phenomenon known as the network effect—competing against large platforms is nigh impossible since its monopoly position makes it inherently more useful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9215374-f03a-3a70-95f4-851663427c1d",
                                        "entry_id": "0e2cc307-8101-3d05-be97-eccdeca718d4",
                                        "glosses": [
                                            "A circular lowland between a resurgent dome and the walls of the caldera surrounding it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b859cdf-463c-3706-bda6-ca522bd7dd6b",
                                        "entry_id": "0e2cc307-8101-3d05-be97-eccdeca718d4",
                                        "glosses": [
                                            "A clear ring outside the eyewall of a tropical cyclone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4d1be18-90dd-34cd-8ebc-ebfe06975bff",
                                        "entry_id": "0e2cc307-8101-3d05-be97-eccdeca718d4",
                                        "glosses": [
                                            "A hill or mound."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "moat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "deb0fb03-e205-34ef-871d-b085a3479c82",
