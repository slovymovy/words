                ],
                "senses": [
                    {
                        "sense_id": "f52a1af6-984b-3968-8287-99496a68adf3",
                        "entry_id": "ff5a3cc2-dd41-3978-bcbb-dd9d5b25bf55",
                        "glosses": [
                            "grens van een taalgebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "501fe7f8-15c5-45d9-9a5e-f58a36784fe5",
                                "sense_id": "f52a1af6-984b-3968-8287-99496a68adf3",
                                "text": "Tijdens een haastig opgezette strafrechtzaak concludeerde de jury kort na de oorlog dat mijn grootvader als burgemeester van een klein dorp op de taalgrens met de vijand had geheuld. Maar men zag gemakshalve over het hoofd dat hij op die manier honderden Joden naar Spanje en later naar de Verenigde Staten had helpen vluchten."
                            },
                            {
                                "example_id": "0c7c90bc-d9be-432d-8e76-a308f8647ffa",
                                "sense_id": "f52a1af6-984b-3968-8287-99496a68adf3",
                                "text": "Maar hoe zit het in Wallonië? Bezuiden de in 1963 vastgelegde taalgrens is men fier op zijn bossen, rivieren en la cuisine du terroir, de streekkeuken. Ernstig wordt er gesproken over het Marshallplan voor Wallonië, dat het gewest moet helpen aan la relance, de economische heropleving."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e69c8410-adaa-4207-8be4-1500f1c6f9a7",
                        "source_entry_id": "ff5a3cc2-dd41-3978-bcbb-dd9d5b25bf55",
                        "source_sense_id": "f52a1af6-984b-3968-8287-99496a68adf3",
                        "source_sense_description": "grens van een taalgebied",
                        "target_lang_word": "Sprachgrenze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachgrenze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7f18d79-ffb3-3353-9ac3-e9339d1a2a67",
                                        "entry_id": "6708085d-609a-362b-95d5-5938432d4e90",
                                        "glosses": [
                                            "Trennlinie zwischen den Verbreitungsgebieten zweier Sprachen/Dialekte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed1e3864-3dc1-495c-b1fc-2efdf91fc786",
                                                "sense_id": "b7f18d79-ffb3-3353-9ac3-e9339d1a2a67",
                                                "text": "Südlich von Göttingen verläuft die Sprachgrenze zwischen dem niederdeutschen Ostfälischen und dem mitteldeutschen Hessischen."
                                            },
                                            {
                                                "example_id": "5ca8f2fc-1782-4b3d-8d5c-1b0fa5efbebb",
                                                "sense_id": "b7f18d79-ffb3-3353-9ac3-e9339d1a2a67",
                                                "text": "Der Rheinische Fächer beinhaltet eine Reihe von Sprachgrenzen."
                                            },
                                            {
                                                "example_id": "e3d6d093-b675-42ad-898a-9f36faf7b24a",
                                                "sense_id": "b7f18d79-ffb3-3353-9ac3-e9339d1a2a67",
                                                "text": "„Aus all dem wird ersichtlich, daß die Determinierung von Sprachgrenzen bis zu einem bestimmten Punkt von ganz willkürlichen Entscheidungen abhängt.“"
                                            },
                                            {
                                                "example_id": "b18e6353-3525-48ef-bdff-4549f7b0ddea",
                                                "sense_id": "b7f18d79-ffb3-3353-9ac3-e9339d1a2a67",
                                                "text": "Die Expansion des Althochdeutschen „reicht in ihrem geistigen Bezugsbereich weit über die werdenden Sprachgrenzen zu den unmittelbaren Nachbarn hinaus…“"
                                            },
                                            {
                                                "example_id": "a7035c93-8555-42fb-9db2-cca20929bbd6",
                                                "sense_id": "b7f18d79-ffb3-3353-9ac3-e9339d1a2a67",
                                                "text": "„Hingegen war die Sprachgrenze östlich des Harzes im ‚Elbostfälischen‘ schon seit dem Mittelalter einem massiven ostmitteldeutschen Druck ausgesetzt…“"
                                            },
                                            {
                                                "example_id": "7d9d48e4-2d7c-48d6-bd7a-57d776a565d6",
                                                "sense_id": "b7f18d79-ffb3-3353-9ac3-e9339d1a2a67",
                                                "text": "„Die Viehhändlersprache ist mit ihrem Verdunkelungsvokabular übrigens weit über die deutschen Sprachgrenzen verbreitet und insofern ein europäisches Phänomen.“"
                                            },
                                            {
                                                "example_id": "1518ba78-5cfa-4a47-9fbd-3469a0e89595",
                                                "sense_id": "b7f18d79-ffb3-3353-9ac3-e9339d1a2a67",
                                                "text": "„Das tschechisch besiedelte Gebiet war nahe, die Sprachgrenze verlief unweit von Gablonz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
