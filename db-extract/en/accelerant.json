            {
                "entry_id": "36466d7a-e755-3baa-9956-4223299e1c6b",
                "word": "accelerant",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "132e9bee-9588-493f-a266-a60d0ab8d961",
                        "entry_id": "36466d7a-e755-3baa-9956-4223299e1c6b",
                        "tags": [
                            "plural"
                        ],
                        "form": "accelerants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c389c3fa-379c-30d1-970e-62f512118ee3",
                        "entry_id": "36466d7a-e755-3baa-9956-4223299e1c6b",
                        "glosses": [
                            "Any substance that can bond or mix with, or disturb, another substance and cause an increase in the speed of a natural or artificial chemical process.",
                            "In the context of fire protection, a substance that accelerates the development of a fire, especially some hydrocarbon-based fuel used to spread a fire caused by arson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97edfd7b-d187-40d0-aa15-8995d1db5395",
                                "sense_id": "c389c3fa-379c-30d1-970e-62f512118ee3",
                                "text": "Accelerant was poured across the beds where the two daughters of a family in Cheshire, Conn., had been tied before a fire during a home invasion in 2007, a fire investigator told jurors on Friday."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7537b77-1b41-3497-9e46-0c9bd3a4a0e3",
                        "entry_id": "36466d7a-e755-3baa-9956-4223299e1c6b",
                        "glosses": [
                            "Any substance that can bond or mix with, or disturb, another substance and cause an increase in the speed of a natural or artificial chemical process.",
                            "A substance used to catalyze the vulcanization of rubber."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "90c4557b-57b4-3177-82d7-259070d199dc",
                        "entry_id": "36466d7a-e755-3baa-9956-4223299e1c6b",
                        "glosses": [
                            "Something that speeds up a process or the uptake of something else."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "95c5dca9-88ad-460b-bcd9-2f6ff7ed8809",
                                "sense_id": "90c4557b-57b4-3177-82d7-259070d199dc",
                                "text": "Hello Neighbor’s experience reflects the rise of video sites like YouTube as an accelerant for the video game business."
                            },
                            {
                                "example_id": "a928439c-2dbc-420e-8328-05912bd058be",
                                "sense_id": "90c4557b-57b4-3177-82d7-259070d199dc",
                                "text": "[Mike] Skinner can be credited with pouring lots of accelerant on pop in his time. In his absence, Caribbean-derived UK bass music became the de facto sound of British youth."
                            },
                            {
                                "example_id": "d122e5b7-b21f-4e57-833d-b6e7b0df59f4",
                                "sense_id": "90c4557b-57b4-3177-82d7-259070d199dc",
                                "text": "But the brutal killing did not capture widespread attention until the security footage was released on Friday, at which point it became an accelerant for conservative arguments about crime, race and the perceived failings of big-city justice systems and mainstream news outlets in the Trump era."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e8156e9-0590-4e56-913e-b7879d49ffc1",
                        "source_entry_id": "36466d7a-e755-3baa-9956-4223299e1c6b",
                        "source_sense_description": "substance that can bond or mix with, or disturb, another substance and cause an increase in the speed of a chemical process",
                        "target_lang_word": "Beschleuniger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beschleuniger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16a9304f-5906-33e0-8259-ba60996e4b55",
                                        "entry_id": "bc924175-bf48-3ade-8707-2bf01be7e8e2",
                                        "glosses": [
                                            "eine Substanz, die eine chemische Reaktion beschleunigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2946ae52-fa59-4300-9601-2ca66e4d3efd",
                                                "sense_id": "16a9304f-5906-33e0-8259-ba60996e4b55",
                                                "text": "„Abhängig von der genauen chemischen Beschaffenheit können oder müssen Katalysatoren als Beschleuniger zugesetzt werden, um die Vernetzungsreaktion schneller ablaufen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a15cd8f5-9bcf-3880-a49d-f67d8b7699fc",
                                        "entry_id": "bc924175-bf48-3ade-8707-2bf01be7e8e2",
                                        "glosses": [
                                            "Teilchenbeschleuniger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2849b1c-f1fd-482e-8925-d91755ef87e3",
                                                "sense_id": "a15cd8f5-9bcf-3880-a49d-f67d8b7699fc",
                                                "text": "„Im Vergleich zu früheren Beschleunigern verfügt der LHC über einen höheren Energiebereich sowie über eine höhere Datenrate.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
