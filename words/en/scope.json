{
    "word_family": [
        "scopeless",
        "scoper",
        "telescope",
        "microscope",
        "periscope",
        "endoscopy",
        "colonoscopy",
        "bronchoscopy",
        "oscilloscope"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5d97874-fe5f-30e0-85b4-93c5e79e7c1d",
                    "sense_definition": "The breadth, depth, or reach of a subject; the extent of applicability or relevance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "extent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Environmental impacts lie outside the <w>scope</w> of this report.",
                            "target_lang_translations": {
                                "ru": "Экологические последствия выходят за <w>рамки</w> данного отчета."
                            }
                        },
                        {
                            "text": "The project manager needs to define the <w>scope</w> of work before we begin.",
                            "target_lang_translations": {
                                "ru": "Менеджеру проекта необходимо определить <w>объём</w> работ до того, как мы начнем."
                            }
                        }
                    ],
                    "synonyms": [
                        "compass",
                        "telescopic sight"
                    ],
                    "common_phrases": [
                        "scope of work",
                        "within the scope",
                        "outside the scope",
                        "beyond the scope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широта, глубина или охват предмета; степень применимости или актуальности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рамки",
                                "target_lang_sense_clarification": "пределы применимости"
                            },
                            {
                                "target_lang_word": "масштаб",
                                "target_lang_sense_clarification": "размах или охват"
                            },
                            {
                                "target_lang_word": "сфера",
                                "target_lang_sense_clarification": "область распространения"
                            },
                            {
                                "target_lang_word": "объём",
                                "target_lang_sense_clarification": "содержание работ или задач"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "582cb4a8-590b-30af-9e86-72f45ea5710d",
                    "sense_definition": "Potential range of action; degree of freedom or opportunity for something to happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opportunity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My job doesn't give me much <w>scope</w> for personal development.",
                            "target_lang_translations": {
                                "ru": "Моя работа не дает мне большого <w>простора</w> для личного развития."
                            }
                        },
                        {
                            "text": "There is little <w>scope</w> for improvement in this already excellent design.",
                            "target_lang_translations": {
                                "ru": "В этом и без того превосходном дизайне мало <w>возможностей</w> для улучшения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scope for improvement",
                        "scope for development",
                        "limited scope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потенциальный диапазон действий; степень свободы или возможность для чего-либо произойти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простор",
                                "target_lang_sense_clarification": "свобода для деятельности"
                            },
                            {
                                "target_lang_word": "возможности",
                                "target_lang_sense_clarification": "шанс для развития или улучшения"
                            },
                            {
                                "target_lang_word": "поле",
                                "target_lang_sense_clarification": "пространство для маневра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "946d955c-8143-358a-9a45-f87de2689ea1",
                    "sense_definition": "A device used in aiming a projectile, through which the person looks at the target.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "optical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter looked through the rifle <w>scope</w> to find the deer.",
                            "target_lang_translations": {
                                "ru": "Охотник посмотрел в оптический <w>прицел</w> винтовки, чтобы найти оленя."
                            }
                        },
                        {
                            "text": "She adjusted the night <w>scope</w> to see more clearly in the dark.",
                            "target_lang_translations": {
                                "ru": "Она настроила прибор ночного <w>видения</w>, чтобы лучше видеть в темноте."
                            }
                        }
                    ],
                    "synonyms": [
                        "telescopic sight"
                    ],
                    "common_phrases": [
                        "rifle scope",
                        "night scope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, используемое при прицеливании, через которое человек смотрит на цель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прицел",
                                "target_lang_sense_clarification": "оптический прибор на оружии"
                            },
                            {
                                "target_lang_word": "оптика",
                                "target_lang_sense_clarification": "разговорное обозначение прицела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d91badc-e468-3f33-9247-f938357f6157",
                    "sense_definition": "The region of program source code in which a given identifier is meaningful or accessible.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A variable's <w>scope</w> is the region of a program within which it can be referred to.",
                            "target_lang_translations": {
                                "ru": "<w>Область видимости</w> переменной — это участок программы, внутри которого на неё можно ссылаться."
                            }
                        },
                        {
                            "text": "The global <w>scope</w> makes the variable accessible from any part of the code.",
                            "target_lang_translations": {
                                "ru": "Глобальная <w>область видимости</w> делает переменную доступной из любой части кода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "global scope",
                        "local scope",
                        "variable scope"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Область исходного кода программы, в которой данный идентификатор имеет значение или доступен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "область видимости",
                                "target_lang_sense_clarification": "программный контекст переменной"
                            },
                            {
                                "target_lang_word": "контекст",
                                "target_lang_sense_clarification": "среда выполнения кода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3385487-7f12-3895-a8a5-6c422fa06dc8",
                    "sense_definition": "A shortened form of words like <w>periscope</w>, <w>telescope</w>, <w>microscope</w>, or <w>oscilloscope</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "optical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician checked the signal on the <w>scope</w> to find the error.",
                            "target_lang_translations": {
                                "ru": "Техник проверил сигнал на <w>осциллографе</w>, чтобы найти ошибку."
                            }
                        },
                        {
                            "text": "He spent all afternoon looking through the <w>scope</w> at the stars.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, глядя в <w>телескоп</w> на звезды."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortened form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма слов, таких как перископ, телескоп, микроскоп или осциллограф."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прибор",
                                "target_lang_sense_clarification": "общее название для оптических устройств"
                            },
                            {
                                "target_lang_word": "труба",
                                "target_lang_sense_clarification": "разговорное для телескопа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7bd4b4d-ae7d-38ee-8010-f04801fd30e7",
                    "sense_definition": "Any medical procedure that ends in the suffix -scopy, such as an endoscopy or colonoscopy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended a <w>scope</w> to investigate the patient's stomach pain.",
                            "target_lang_translations": {
                                "ru": "Врач рекомендовал <w>эндоскопию</w>, чтобы выяснить причину болей в животе у пациента."
                            }
                        },
                        {
                            "text": "He was nervous about getting a <w>scope</w> done at the hospital.",
                            "target_lang_translations": {
                                "ru": "Он нервничал из-за предстоящего <w>обследования</w> в больнице."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "medical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая медицинская процедура, заканчивающаяся суффиксом -скопия, например, эндоскопия или колоноскопия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обследование",
                                "target_lang_sense_clarification": "с использованием эндоскопа"
                            },
                            {
                                "target_lang_word": "скопия",
                                "target_lang_sense_clarification": "медицинский жаргон для процедур"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb7f3a5b-3f1c-3679-a702-9b4fb5f28936",
                    "sense_definition": "To perform a cursory investigation of; to look around or survey an area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "investigate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's <w>scope</w> the scene before we decide where to park.",
                            "target_lang_translations": {
                                "ru": "Давай <w>осмотримся</w> на месте, прежде чем решать, где припарковаться."
                            }
                        },
                        {
                            "text": "The team went ahead to <w>scope</w> out the area for the event.",
                            "target_lang_translations": {
                                "ru": "Команда отправилась вперед, чтобы <w>разведать</w> территорию для мероприятия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scope out",
                        "scope the scene",
                        "scope the area"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'out'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Провести беглый осмотр; осмотреться или изучить местность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмотреться",
                                "target_lang_sense_clarification": "изучить обстановку"
                            },
                            {
                                "target_lang_word": "разведать",
                                "target_lang_sense_clarification": "изучить местность заранее"
                            },
                            {
                                "target_lang_word": "оценить",
                                "target_lang_sense_clarification": "бегло изучить ситуацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86ebdbb4-2de7-31cc-9bfc-2f7017c1e288",
                    "sense_definition": "To define the boundaries or extent of a project or investigation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "extent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>scope</w> the investigation before developing a work plan.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>определить рамки</w> расследования перед разработкой плана работы."
                            }
                        },
                        {
                            "text": "The committee will <w>scope</w> the project to ensure it stays on budget.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>очертит</w> границы проекта, чтобы гарантировать соблюдение бюджета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scope a project",
                        "scope the investigation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business/professional"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определить границы или масштаб проекта или расследования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определять рамки",
                                "target_lang_sense_clarification": "устанавливать границы проекта"
                            },
                            {
                                "target_lang_word": "очерчивать",
                                "target_lang_sense_clarification": "обозначать масштаб работ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05bd9158-8957-363e-b004-1e6fd6ac8dde",
                    "sense_definition": "To perform a medical procedure involving a camera or tube, such as an endoscopy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon will <w>scope</w> the player's knee to repair the ligament.",
                            "target_lang_translations": {
                                "ru": "Хирург <w>проведет осмотр</w> колена игрока, чтобы восстановить связку."
                            }
                        },
                        {
                            "text": "They decided to <w>scope</w> his throat to check for any blockage.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>обследовать</w> его горло, чтобы проверить наличие закупорки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "medical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнить медицинскую процедуру с использованием камеры или трубки, например, эндоскопию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить осмотр",
                                "target_lang_sense_clarification": "с помощью эндоскопа"
                            },
                            {
                                "target_lang_word": "делать скопию",
                                "target_lang_sense_clarification": "выполнять процедуру"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}