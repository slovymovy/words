                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "705125d2-a7f1-44c9-873c-8c6ac348c402",
                        "entry_id": "147595f5-e74e-35d3-86ff-09c62287a463",
                        "tags": [
                            "plural"
                        ],
                        "form": "burgs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19d417c3-dc97-31b1-b2e7-5f71af7e78e3",
                        "entry_id": "147595f5-e74e-35d3-86ff-09c62287a463",
                        "glosses": [
                            "A city or town."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "cfcf1a33-db04-43f6-acf0-aabf9cc09523",
                                "sense_id": "19d417c3-dc97-31b1-b2e7-5f71af7e78e3",
                                "text": "Tell mother that I will write her in a day or two, probably from Chicago, as I have always had an idea that that was one burg where I could make good."
                            },
                            {
                                "example_id": "db0e7806-7d6f-4eb6-884e-dbc604d82f51",
                                "sense_id": "19d417c3-dc97-31b1-b2e7-5f71af7e78e3",
                                "text": "Imagine my surprise when I learned that he was not only a Canadian but lived in Ottawa, that icy burg I had left so many kilometers -- sorry, miles -- behind me."
                            },
                            {
                                "example_id": "c3384bbd-2371-4713-9c75-ee422c2ea612",
                                "sense_id": "19d417c3-dc97-31b1-b2e7-5f71af7e78e3",
                                "text": "It's been said that Wilder modeled that fictional setting on Peterborough, a quaint burg tucked away in New Hampshire's verdant southwestern hills."
                            }
                        ]
                    },
                    {
                        "sense_id": "8da8a4c7-8d54-3add-9367-338d3938c3fc",
                        "entry_id": "147595f5-e74e-35d3-86ff-09c62287a463",
                        "glosses": [
                            "A fortified town in medieval Europe."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9543a80a-60e6-48bc-94ac-14b6e0cb0f96",
                        "source_entry_id": "147595f5-e74e-35d3-86ff-09c62287a463",
                        "source_sense_description": "fortified town in medieval Europe",
                        "target_lang_word": "bourg",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bourg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf3944a-f799-3422-b794-1d050630beff",
                                        "entry_id": "b29d87d9-4bed-3852-89a2-9cf880581245",
                                        "glosses": [
                                            "Petite ville ou grand village ; lieu de rendez-vous lors des marchés hebdomadaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91e03422-869a-4856-b540-dc7e4fc793db",
                                                "sense_id": "7bf3944a-f799-3422-b794-1d050630beff",
                                                "text": "En effet, en exécution de ces lettres patentes, l’emplacement pour bâtir le nouveau bourg fut tracé au delà de l’Aude, […]."
                                            },
                                            {
                                                "example_id": "95cfa295-d7ba-4f32-ad50-6a5f33e48992",
                                                "sense_id": "7bf3944a-f799-3422-b794-1d050630beff",
                                                "text": "Pas de fermes isolées, rien que des bourgs formés de maisons les plus dissemblables, qu’une lézarde de géraniums essaye en vain d’appareiller […]"
                                            },
                                            {
                                                "example_id": "c2ac5f0f-48fa-4291-afb5-3c42bc762da4",
                                                "sense_id": "7bf3944a-f799-3422-b794-1d050630beff",
                                                "text": "[…] Saint-Cirq-la-Popie était, au moyen-âge, une riche cité fortifiée ; il n’est plus qu’un bourg croulant où s’attardent 150 habitants."
                                            },
                                            {
                                                "example_id": "61fc7d53-7463-4425-bd72-4ffc3431d554",
                                                "sense_id": "7bf3944a-f799-3422-b794-1d050630beff",
                                                "text": "Voilà une existence qui n'a rien à voir avec celle que j'ai connue dans un bourg morvandiau, au milieu des toucheurs de bœufs et des mineurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "996280a2-7345-33d8-9219-5198e32ade12",
                                        "entry_id": "b29d87d9-4bed-3852-89a2-9cf880581245",
                                        "glosses": [
                                            "Municipalité autonome (dans un contexte historique: municipalité autonome, sans aucun devoir envers un seigneur féodal)"
