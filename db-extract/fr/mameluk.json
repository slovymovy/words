                    {
                        "sense_id": "b446e708-ea75-3f4e-b3e8-3f1ef5278a83",
                        "entry_id": "6990ad85-e68f-36e3-9136-1d2ea2d82836",
                        "glosses": [
                            "Variante de mamelouk, soldat égyptien."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "803bb0d3-d3b9-4ff9-ab46-522d5f3773d2",
                                "sense_id": "b446e708-ea75-3f4e-b3e8-3f1ef5278a83",
                                "text": "A cette époque les mamelucks circassiens usurpèrent l’autorité en Égypte, et donnèrent une nouvelle forme de gouvernement à la Palestine."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d4ccfa5-29c6-3c85-9a62-51770afd2958",
                        "entry_id": "6990ad85-e68f-36e3-9136-1d2ea2d82836",
                        "glosses": [
                            "Variante de mamelouk, cavalier égyptien de Bonaparte."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "82a6beb1-e066-4406-8b6c-f23af93a2838",
                                "sense_id": "7d4ccfa5-29c6-3c85-9a62-51770afd2958",
                                "text": "Les mameluks de la Garde."
                            },
                            {
                                "example_id": "cd50f3b4-1af9-4148-8b52-93add7a127dc",
                                "sense_id": "7d4ccfa5-29c6-3c85-9a62-51770afd2958",
                                "text": "Les picadores, costumés en Turcs de carnaval, avec des pantalons de percale à la mameluk, des vestes soleillées dans le dos, des turbans en gâteau de Savoie, rappelaient à s’y méprendre les figures de Mores extravagants que Goya ébauche en trois ou quatre traits de pointe dans les planches de la Toromaquia."
                            }
                        ]
                    }
