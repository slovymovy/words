                                    {
                                        "sense_id": "4974c06d-7d54-3410-a967-6243e4583019",
                                        "entry_id": "852fd81b-3b8e-3d2e-8cee-c6059de56145",
                                        "glosses": [
                                            "Alternative form of derailleur."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8cbad0e-7e2d-4845-953c-0b66a7170cf1",
                                                "sense_id": "4974c06d-7d54-3410-a967-6243e4583019",
                                                "text": "Very few bicycles are of a different color or employ more gears with derailer sprockets and hand brakes."
                                            },
                                            {
                                                "example_id": "8281f677-9e69-4635-9c05-dc011b31552b",
                                                "sense_id": "4974c06d-7d54-3410-a967-6243e4583019",
                                                "text": "Through sheer ingenuity and resourcefulness, these men handproduced parts such as derailers, stands, seat posts, cranks, fenders, and all manner of elements used in the production of a functional bicycle."
                                            },
                                            {
                                                "example_id": "145d845e-1855-44df-835c-41c255126cb3",
                                                "sense_id": "4974c06d-7d54-3410-a967-6243e4583019",
                                                "text": "Inside, two bearded men are working on a busted fuel pump, and another is repairing a bicycle derailer."
                                            },
                                            {
                                                "example_id": "cc42a635-bf79-4c6a-865c-6dfc27eb86c8",
                                                "sense_id": "4974c06d-7d54-3410-a967-6243e4583019",
                                                "text": "Recent American attempts to further Anglicize the word to “derailer” have met with little success. In any case, no rails are involved."
                                            }
                                        ]
                                    }
                                ]
                            }
