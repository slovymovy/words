{
    "word_family": [
        "refoulement",
        "refouloir",
        "fouler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32bf4018-4b26-3ba1-b435-d05a0f44e4b8",
                    "sense_definition": "Repousser un groupe de personnes pour l'empêcher d'avancer ou lui interdire l'accès à un lieu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les policiers ont réussi à <w>refouler</w> la foule en colère loin de la mairie."
                        },
                        {
                            "text": "Les douaniers ont décidé de <w>refouler</w> à la frontière ce voyageur dépourvu de passeport."
                        }
                    ],
                    "synonyms": [
                        "repousser",
                        "écarter"
                    ],
                    "antonyms": [
                        "accueillir"
                    ],
                    "common_phrases": [
                        "refouler à la frontière",
                        "refouler la foule"
                    ]
                },
                {
                    "sense_id": "8a8a1eab-f510-341f-9e0f-9c11d4b4b34f",
                    "sense_definition": "Contenir ou rejeter hors de sa conscience des pensées, des émotions ou des désirs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a longtemps tenté de <w>refouler</w> ses émotions au lieu de les accepter calmement."
                        },
                        {
                            "text": "Elle essayait de <w>refouler</w> ses larmes devant ses collègues malgré la triste annonce."
                        }
                    ],
                    "synonyms": [
                        "réprimer",
                        "étouffer",
                        "enfouir"
                    ],
                    "antonyms": [
                        "exprimer",
                        "extérioriser"
                    ],
                    "common_phrases": [
                        "refouler ses émotions",
                        "refouler ses larmes"
                    ]
                },
                {
                    "sense_id": "ac3b6cbc-1429-3981-89f5-0636c466b63a",
                    "sense_definition": "Dégager une odeur particulièrement mauvaise et désagréable ; puer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ouvre vite la fenêtre, tes vieilles baskets <w>refoulent</w> dans toute la chambre !"
                        },
                        {
                            "text": "Après avoir mangé ce plat très épicé, son haleine <w>refoulait</w> de manière désagréable."
                        }
                    ],
                    "synonyms": [
                        "puer",
                        "empester"
                    ],
                    "antonyms": [
                        "embaumer"
                    ],
                    "common_phrases": [
                        "refouler du goulot",
                        "refouler de la gueule"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "e9e8acaa-a5f2-3f62-97bf-4f33a18af040",
                    "sense_definition": "Marcher ou poser de nouveau le pied sur un lieu, en particulier une terre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des décennies passées à l'étranger, il a enfin pu <w>refouler</w> le sol natal."
                        },
                        {
                            "text": "Le vieux soldat rêvait de <w>refouler</w> un jour les plages où il avait combattu."
                        }
                    ],
                    "common_phrases": [
                        "refouler le sol",
                        "refouler une terre"
                    ]
                }
            ]
        }
    ]
}