                "senses": [
                    {
                        "sense_id": "b61ee95d-68e5-35ab-800b-2aed7fc348b9",
                        "entry_id": "90927da7-5411-377d-88c3-ab1e299e2f12",
                        "glosses": [
                            "hügeliges, unebenes Gelände"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "cec61faf-7132-4993-85f3-ca3b82debddc",
                                "sense_id": "b61ee95d-68e5-35ab-800b-2aed7fc348b9",
                                "text": "„Die Straße von Shelby über das Hügelland nach Port Vigor wird nur wenig benutzt, da die meisten Häuser drunten im Tal liegen.“"
                            },
                            {
                                "example_id": "786d8b6a-42bc-4338-ac70-581bcac2f3ba",
                                "sense_id": "b61ee95d-68e5-35ab-800b-2aed7fc348b9",
                                "text": "„Im nahen südlichen Hügelland gab es Eisenerz, das von geschickten Handwerkern zu Werkzeugen und Waffen verarbeitet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
