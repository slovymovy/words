                        ],
                        "examples": [
                            {
                                "example_id": "0b2d006b-f63d-444c-8a66-aa800cbf4fa0",
                                "sense_id": "a916a3dc-ad93-3ad8-b394-f8a598dae718",
                                "text": "To the Bishops of Arles had the Holy See deputed a vicariate power there."
                            }
                        ]
                    }
