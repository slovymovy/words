                "senses": [
                    {
                        "sense_id": "56fcfb37-0de6-346e-b631-4d33784a6b99",
                        "entry_id": "da733cbc-0698-3399-9a9e-53c56a87d826",
                        "glosses": [
                            "aplikacja, najczęściej na tablet, smartfon czy inne urządzenie mobilne"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8ba4dfea-3ed7-4c20-8475-c5c9f52f5973",
                                "sense_id": "56fcfb37-0de6-346e-b631-4d33784a6b99",
                                "text": "Ściągnąłem bardzo przydatną apkę do edycji fotek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0306af0d-8b2a-49a1-9b9a-0c9ec98edd03",
                        "source_entry_id": "da733cbc-0698-3399-9a9e-53c56a87d826",
                        "source_sense_id": "56fcfb37-0de6-346e-b631-4d33784a6b99",
                        "target_lang_word": "App",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "App",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea4284cb-2a06-3cc7-b951-333be1e8dfcf",
                                        "entry_id": "f75c31e7-1dc3-341f-a474-c767a4c82103",
                                        "glosses": [
                                            "Zusatzprogramm für Mobiltelefone, Abspielgeräte und Kleincomputer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b2b0d8b-0c5b-4a54-9506-ec0e50b86e74",
                                                "sense_id": "ea4284cb-2a06-3cc7-b951-333be1e8dfcf",
                                                "text": "Dafür gibt es eine App."
                                            },
                                            {
                                                "example_id": "041d1756-0d09-490e-817e-911db0f12b09",
                                                "sense_id": "ea4284cb-2a06-3cc7-b951-333be1e8dfcf",
                                                "text": "„Und es ist selbst in Indien keine Seltenheit mehr, Einkäufe per App zu erledigen.“"
                                            },
                                            {
                                                "example_id": "94fa96fe-34b6-4e08-a5af-3383a20eaeb8",
                                                "sense_id": "ea4284cb-2a06-3cc7-b951-333be1e8dfcf",
                                                "text": "„Sie brauchen gar nicht erst zu versuchen, Ihre Reise mit einer App zu planen.“"
                                            },
                                            {
                                                "example_id": "7b1a169b-0cc6-4333-a919-3878c3c6bf67",
                                                "sense_id": "ea4284cb-2a06-3cc7-b951-333be1e8dfcf",
                                                "text": "„Dann führte es 300 Tage lang die Hitliste der Apps an.“"
                                            },
                                            {
                                                "example_id": "a4a56079-18ac-4bf7-8430-b094f592559b",
                                                "sense_id": "ea4284cb-2a06-3cc7-b951-333be1e8dfcf",
                                                "text": "„Der Google-Übersetzer ist in diesem Jahr zur wichtigsten App Deutschlands geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
