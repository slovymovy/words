                        "glosses": [
                            "een soort rugslag waarbij de benen op- en neer worden bewogen en de armen langs het hoofd met een draaiende beweging naar achteren worden gebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efe733e2-7fa0-4e1c-b169-84d078e5c1f9",
                                "sense_id": "2dbecdd2-e12c-34ae-a59d-316ac6c5b1fe",
                                "text": "Schoolslag, borstcrawl, rugcrawl, watertrappelen en onder water zwemmen. Veertien kinderen van asielzoekers in Winterswijk kunnen het."
                            },
                            {
                                "example_id": "36eefe5f-564b-4cc3-bc2a-a62330f2f772",
                                "sense_id": "2dbecdd2-e12c-34ae-a59d-316ac6c5b1fe",
                                "text": "„Meestal zwem ik schoolslag, maar af en toe doe ik ook de rugcrawl en de borstcrawl. Het maakt niet uit welke slag je zwemt”, legt hij uit. De Rijssenaar verwacht wel dat er voor zijn 25e deelname iets speciaals gaat gebeuren, maar wat weet hij nog niet. „Ik laat dat gewoon over me heen komen.” Vorige jaar deden Geert Bos en Gerben Bennink, beiden eveneens van de Gehandicaptensportvereniging Rijssen, al voor de 25e keer mee met de zwemvierdaagse in Rijssen."
                            }
                        ]
                    }
