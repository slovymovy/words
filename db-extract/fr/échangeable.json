                ],
                "senses": [
                    {
                        "sense_id": "8699f1c2-bb3d-3c71-8d57-489d48d2d562",
                        "entry_id": "0a699341-cf3d-37c2-bf83-6a5d3beb5676",
                        "glosses": [
                            "Qui peut être échangé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c90dd45-1eba-41d1-a00f-b585b655b5e4",
                                "sense_id": "8699f1c2-bb3d-3c71-8d57-489d48d2d562",
                                "text": "Dans les ouvrages des Économistes et même dans celui de Smith, il ne s’agit proprement que des degrés de la valeur échangeable, c’est-à-dire des prix."
                            },
                            {
                                "example_id": "cdf5f532-6fca-4265-a467-69f778dbe2a9",
                                "sense_id": "8699f1c2-bb3d-3c71-8d57-489d48d2d562",
                                "text": "Pour rendre l’homme substituable, échangeable, remplaçable à merci, la première exigence est de le déculturer, de faire en sorte que rien ne le distingue de ses compagnons d’espèce et de planète, de le dédiscriminer, d’interdire la discrimination (horizontale et verticale)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f9cc90c-3d86-4f76-a272-ca679c8cee74",
                        "source_entry_id": "0a699341-cf3d-37c2-bf83-6a5d3beb5676",
                        "source_sense_id": "8699f1c2-bb3d-3c71-8d57-489d48d2d562",
                        "target_lang_word": "austauschbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "austauschbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d44816-4cda-3758-b5ea-dcec63b1cf43",
                                        "entry_id": "2731c48a-e0ec-327b-80f5-504575069c4d",
                                        "glosses": [
                                            "bei Bedarf aus einem Gerät entfernbar und durch ein neues Teil ersetzbar"
                                        ],
                                        "tags": [
                                            "technisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6657d776-912f-4adb-9666-dc7b85f19395",
                                                "sense_id": "b7d44816-4cda-3758-b5ea-dcec63b1cf43",
                                                "text": "„Wichtige Teile wie Akkus in Handys sollen austauschbar sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e823dcad-05d5-336b-8d9d-3dc1ea0530fc",
                                        "entry_id": "2731c48a-e0ec-327b-80f5-504575069c4d",
                                        "glosses": [
                                            "miteinander kombinierbar, zusammenpassend"
                                        ],
                                        "tags": [
                                            "technisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db66a523-47da-4a95-a416-930cd381b26d",
                                                "sense_id": "e823dcad-05d5-336b-8d9d-3dc1ea0530fc",
                                                "text": "„Das Leibniz‑Rechenzentrum der Bayerischen Akademie der Wissenschaften LRZ fungiert als eine Art Schaltzentrale, in der die Eingaben in die Computer tausender Wissenschaftler koordiniert und untereinander austauschbar gemacht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cfa174d8-3fdd-3e61-ae9f-d13ef1aa7d92",
                                        "entry_id": "2731c48a-e0ec-327b-80f5-504575069c4d",
                                        "glosses": [
                                            "beliebig durch jemand anderen ersetzbar"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "283c184d-d281-4ffb-a4d2-109db04073ba",
                                                "sense_id": "cfa174d8-3fdd-3e61-ae9f-d13ef1aa7d92",
                                                "text": "„Ich wollte nicht bloß hübsches, austauschbares Dekor in einem Film sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
