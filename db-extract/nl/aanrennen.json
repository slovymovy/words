        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "4f513982-f2d0-38c7-9318-fd5539bb01a2",
                "word": "aanrennen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1248a3d2-9550-382c-9c3c-7159c5adcb2f",
                        "entry_id": "4f513982-f2d0-38c7-9318-fd5539bb01a2",
                        "glosses": [
                            "snel lopend of rennend naderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95ece493-00f9-49e5-b36c-7a42477b6c42",
                                "sense_id": "1248a3d2-9550-382c-9c3c-7159c5adcb2f",
                                "text": "Vanuit het station kwamen hierop meer jongens aanrennen, die besloten ook op de man in te slaan. Hierbij werd hij onder meer met een metalen voorwerp op zijn hoofd geslagen."
                            },
                            {
                                "example_id": "d1abd51e-b1ca-4866-bd9e-ca5564067d6a",
                                "sense_id": "1248a3d2-9550-382c-9c3c-7159c5adcb2f",
                                "text": "Kort na het begin van het gesprek kwamen de spelers aanrennen en besprongen hun coach en de verslaggevers. De feestvierende Scandinaviërs duwden van blijdschap de desk om, waar verdediger Mikael Lustig zelfs nog een aantal keer uitbundig tegenaan trapte."
                            },
                            {
                                "example_id": "ee169fe4-5bf2-45d0-b288-4b34d97fe1f2",
                                "sense_id": "1248a3d2-9550-382c-9c3c-7159c5adcb2f",
                                "text": "Na een felle discussie reed de automobilist verder, keerde om en reed tot twee keer toe in de richting van de vader en de kinderen op de stoep. Daarbij reed hij een voorband lek. De Rotterdammer schreeuwde naar zijn zus en de kinderen dat zij een veilige plek moesten zoeken. Omstanders kwamen aanrennen en riepen de bestuurder tot de orde."
                            },
                            {
                                "example_id": "65323e50-d734-4239-bb27-c7a28630b921",
                                "sense_id": "1248a3d2-9550-382c-9c3c-7159c5adcb2f",
                                "text": "Volgens de bonden hebben chauffeurs door de werkdruk vaak geen tijd meer om te wachten op reizigers, die nog op het laatste moment komen aanrennen."
                            },
                            {
                                "example_id": "796142da-418c-435b-a4a7-2f3959250c93",
                                "sense_id": "1248a3d2-9550-382c-9c3c-7159c5adcb2f",
                                "text": "Toen Teresa in de grijze ochtendschemering kwam aanrennen en op de voordeur bonkte, begreep Olive meteen dat er iets ergs was gebeurd."
                            }
                        ]
                    }
                ],
