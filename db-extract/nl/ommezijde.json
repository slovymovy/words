                        "target_lang_word": "reverse side",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "60109e3f-26a0-41f7-95ae-ff2b90af458b",
                        "source_entry_id": "a4d9e276-76b0-377c-9c43-e20a6ffd554c",
                        "source_sense_id": "1d6fedd7-2cf7-3914-a5f9-bb3bc327340e",
                        "source_sense_description": "de achterkant van een blad papier",
                        "target_lang_word": "other side",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "other side",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1b24966-ad73-3151-bbe2-ab6ade1474ff",
                                        "entry_id": "9b56c1e6-6d7c-3bd8-8118-5f879c30748f",
                                        "glosses": [
                                            "The afterlife, as a supernatural realm inhabited by spirits of deceased people."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74555e2b-789d-43bf-96fa-9760dac3e1e7",
                                                "sense_id": "f1b24966-ad73-3151-bbe2-ab6ade1474ff",
                                                "text": "[I]t has seemed to me wise to take such measures as may be feasible, to acquire, by courtesy of the press, access to my standing obituaries, with the privilege—if this is not asking too much—of editing, not their Facts, but their Verdicts. This, not for the present profit, further than as concerns my family, but as a favorable influence usable on the Other Side, where there are some who are not friendly to me."
                                            },
                                            {
                                                "example_id": "6ac7d840-591f-4773-9248-a82647bb6633",
                                                "sense_id": "f1b24966-ad73-3151-bbe2-ab6ade1474ff",
                                                "text": "They tell us that something is waiting for us on the other side, that death may be a pilgrimage and not a destination, that the afterlife is a warm awakening after the fretful dream of life."
                                            },
                                            {
                                                "example_id": "ccef4e79-8b98-4a6b-93bc-3ccfcd8acc11",
                                                "sense_id": "f1b24966-ad73-3151-bbe2-ab6ade1474ff",
                                                "text": "\"Well, when people from the other side communicate with me, they're using thought energy, just like you can't see radio waves coming into the radio.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5f343c4-b286-366c-8083-4ed661da5f5d",
                                        "entry_id": "9b56c1e6-6d7c-3bd8-8118-5f879c30748f",
                                        "glosses": [
                                            "The time after the solution or completion of a problem, adversity, or challenge."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8740840b-4638-4cd2-a955-96039cde26ef",
                                                "sense_id": "f5f343c4-b286-366c-8083-4ed661da5f5d",
                                                "text": "That clarity comes through on another highlight, Love Is Blind. “I found this part of myself that I think is left out of a lot of love songs: the growth on the other side.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdd8b6f5-6652-352c-9a93-9dfe6d24201a",
                                        "entry_id": "9b56c1e6-6d7c-3bd8-8118-5f879c30748f",
                                        "glosses": [
                                            "The other side of the Atlantic Ocean (usually between the United States and the United Kingdom)."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9be40510-80c0-49f7-b972-61b106bfa016",
                                                "sense_id": "fdd8b6f5-6652-352c-9a93-9dfe6d24201a",
                                                "text": "O, how the Britisher longs to vote for Cleveland! But he cannot, and must content himself with merely sending over funds and doing what he may from the other side for the cause he loves so well."
                                            },
                                            {
                                                "example_id": "6a526e72-96b5-4c10-b11f-ea49846a8ec6",
                                                "sense_id": "fdd8b6f5-6652-352c-9a93-9dfe6d24201a",
                                                "text": "The latest of these Yankee “invasions” is popcorn—which is called “maizypop” in the British Isles in deference to English diction and for the reason that on the other side “corn” means any kind of grain."
                                            },
                                            {
                                                "example_id": "151c3d26-2a38-4906-8680-49f218af22df",
                                                "sense_id": "fdd8b6f5-6652-352c-9a93-9dfe6d24201a",
                                                "text": "Brumagum, as they call it on the other side, is quite an industrial town, and Owen’s parents were poor but honest proletariats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b723242-7355-307d-aae4-6da91a1db3f5",
                                        "entry_id": "9b56c1e6-6d7c-3bd8-8118-5f879c30748f",
                                        "glosses": [
                                            "The other television channel (when only two were available)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "577e1deb-1c20-4399-b634-97e481bd5edd",
                                                "sense_id": "0b723242-7355-307d-aae4-6da91a1db3f5",
                                                "text": "This is boring. What's on the other side?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68ce668b-5ea7-3cb8-9319-874d1fb22a6e",
                                        "entry_id": "9b56c1e6-6d7c-3bd8-8118-5f879c30748f",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see other, side."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ed4480a-bd72-4cf9-a85f-39ae97c5ff15",
                                                "sense_id": "68ce668b-5ea7-3cb8-9319-874d1fb22a6e",
                                                "text": "We crossed to the other side of the road."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
