                ],
                "senses": [
                    {
                        "sense_id": "c86418d9-b887-3238-91ff-b190ca6e3189",
                        "entry_id": "6f920fd9-fc2c-324c-a7ed-154b092a03fd",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "108d8a76-fd69-41f8-90bb-62fb4e91dbb8",
                                "sense_id": "c86418d9-b887-3238-91ff-b190ca6e3189",
                                "text": "Frau Koehle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2624c732-13b1-4980-8256-019ddcbe000f",
                                "sense_id": "c86418d9-b887-3238-91ff-b190ca6e3189",
                                "text": "Herr Koehle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "abad53f3-a42d-4684-8dde-f3fd2389532c",
                                "sense_id": "c86418d9-b887-3238-91ff-b190ca6e3189",
                                "text": "Die Koehles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e127df0e-0a0c-48db-9bf5-febfbd160ac5",
                                "sense_id": "c86418d9-b887-3238-91ff-b190ca6e3189",
                                "text": "Der Koehle trägt nie die Schals, die die Koehle ihm strickt."
                            },
                            {
                                "example_id": "d27e9938-99e0-4565-a9c7-e9a89ce3c82c",
                                "sense_id": "c86418d9-b887-3238-91ff-b190ca6e3189",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Koehle kommt, geht der Herr Koehle.“"
                            },
                            {
                                "example_id": "578c7b1a-9647-4bb2-b0c1-ec770e1b6a95",
                                "sense_id": "c86418d9-b887-3238-91ff-b190ca6e3189",
                                "text": "Koehle kommt und geht."
                            },
                            {
                                "example_id": "d25bdadb-0d86-411c-a4a4-1d88ff7a85c7",
                                "sense_id": "c86418d9-b887-3238-91ff-b190ca6e3189",
                                "text": "Koehles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
