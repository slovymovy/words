                                "target_word": "defenestreren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c668369f-1038-3274-a079-7ee0a366981d",
                                        "entry_id": "9ec7acd8-9589-39a3-83fe-d0d8cdf5b914",
                                        "glosses": [
                                            "uit het raam gooien (vooral als middel om politieke tegenstanders uit de weg te ruimen)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f15a7f9e-b10f-4c70-8e09-995161afb6a1",
                                                "sense_id": "c668369f-1038-3274-a079-7ee0a366981d",
                                                "text": "Tijdens de middeleeuwen werd defenestreren een populaire tactiek om korte metten te maken met een minder geliefde politieke figuur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a16e6c3a-291a-33a5-be42-9cddc47b5ba1",
                                        "entry_id": "9ec7acd8-9589-39a3-83fe-d0d8cdf5b914",
                                        "glosses": [
                                            "uit de partij zetten, politiek buitenspel zetten"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6170f68-4cfe-4f67-822d-7d1ce82bdc36",
                                                "sense_id": "a16e6c3a-291a-33a5-be42-9cddc47b5ba1",
                                                "text": "Dat Nollet in maart aankondigde Khattabi een derde keer voor te dragen, deed bij velen de wenkbrauwen fronsen. Het is net dat argument dat Bouchez nu aangrijpt om Khattabi te defenestreren. “Telkens opnieuw laten stemmen tot je krijgt wat je wil, is ondemocratisch”, stelde de MR-voorzitter vrijdag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e37ec088-9b82-4523-b701-11e41fc0c315",
                        "source_entry_id": "aed058fb-7192-36c7-aebe-d427dd2d14ba",
                        "source_sense_description": "eject from a window",
                        "target_lang_word": "défenestrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
