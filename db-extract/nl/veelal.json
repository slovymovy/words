                                "target_senses": [
                                    {
                                        "sense_id": "6faafb22-736d-30bc-b9da-e21dd2ee8c9b",
                                        "entry_id": "cfd4ff69-9d1b-305c-bd36-b42be9232c58",
                                        "glosses": [
                                            "viele Male (zu verschiedenen Zeiten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e5a5b01-9973-403a-9277-07baf3483412",
                                                "sense_id": "6faafb22-736d-30bc-b9da-e21dd2ee8c9b",
                                                "text": "Kommst du oft hierher?"
                                            },
                                            {
                                                "example_id": "2e800985-af68-4e8a-93b2-25337e769b3d",
                                                "sense_id": "6faafb22-736d-30bc-b9da-e21dd2ee8c9b",
                                                "text": "„Offene Brandwunden sind ein idealer Nährboden für Bakterien und infizieren sich oft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb57ca4e-f751-35e2-afd5-2cd6febaf752",
                                        "entry_id": "cfd4ff69-9d1b-305c-bd36-b42be9232c58",
                                        "glosses": [
                                            "in vielen Fällen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dbd8639-0f59-4020-94ef-7adecca56e32",
                                                "sense_id": "fb57ca4e-f751-35e2-afd5-2cd6febaf752",
                                                "text": "Doch oft kommt es anders als man denkt"
                                            },
                                            {
                                                "example_id": "f2feb5cd-b23e-4559-8b6f-983c3755bd63",
                                                "sense_id": "fb57ca4e-f751-35e2-afd5-2cd6febaf752",
                                                "text": "Das ist oft problematisch, denn meist herrscht ein Gruppenzwang."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "990881b2-1928-3003-83a8-a329424bc573",
                                        "entry_id": "cfd4ff69-9d1b-305c-bd36-b42be9232c58",
                                        "glosses": [
                                            "in hoher Frequenz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e3172bb-5d20-4220-b5aa-4abf4cf3e7f8",
                                                "sense_id": "990881b2-1928-3003-83a8-a329424bc573",
                                                "text": "Ich glaube, am Wochenende fährt der Bus nicht so oft."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7924950e-d39f-430e-a8aa-ee22a5d9384d",
                        "source_entry_id": "9096e1d9-77dc-347b-b90b-6f9d6112d85d",
                        "source_sense_id": "d04c9214-1896-3222-a462-ab2752293fb2",
                        "source_sense_description": "in de meeste gevallen, vaak",
                        "target_lang_word": "mostly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mostly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0cebb0f-dbc8-3638-a21e-c968c28a65de",
                                        "entry_id": "180889e0-8b8e-3c59-bad3-08cb8576e1d4",
                                        "glosses": [
                                            "Mainly or chiefly; for the most part; usually, generally, on the whole."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a0cf8b2-7763-4b3a-b2c2-0eec418282ec",
                                                "sense_id": "d0cebb0f-dbc8-3638-a21e-c968c28a65de",
                                                "text": "They're mostly good people, although they have made a few mistakes."
                                            },
                                            {
                                                "example_id": "66b235a1-9d25-4066-aeea-c21830c9f561",
                                                "sense_id": "d0cebb0f-dbc8-3638-a21e-c968c28a65de",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0873a558-85fc-3955-b66d-8975920204cc",
                                        "entry_id": "180889e0-8b8e-3c59-bad3-08cb8576e1d4",
                                        "glosses": [
                                            "To the greatest extent; most."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "592497f3-755c-4c8b-9c68-6a86e275c4d8",
                                                "sense_id": "0873a558-85fc-3955-b66d-8975920204cc",
                                                "text": "She was to be their chosen visitor, she was to be for weeks under the same roof with the person whose society she mostly prized [...]!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51637afa-d6d3-44a5-a140-4062f5cb6204",
                        "source_entry_id": "9096e1d9-77dc-347b-b90b-6f9d6112d85d",
                        "source_sense_id": "d04c9214-1896-3222-a462-ab2752293fb2",
                        "source_sense_description": "in de meeste gevallen, vaak",
                        "target_lang_word": "more often than not",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "more often than not",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7fb9256-e372-32cb-b75c-2a3503e668a9",
                                        "entry_id": "16cc9ea4-6001-34eb-8558-b944b3006c11",
                                        "glosses": [
                                            "Usually; more than half the time; more likely to be the case than not to be the case."
                                        ],
                                        "tags": [
                                            "comparative-only",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e111d0-308f-471b-9e6c-d45868d31763",
                                                "sense_id": "b7fb9256-e372-32cb-b75c-2a3503e668a9",
                                                "text": "Near-synonyms: commonly, frequently; usually; see also Thesaurus:usually"
                                            },
                                            {
                                                "example_id": "194ec353-457d-4406-b9cb-1aa1ee5097fd",
                                                "sense_id": "b7fb9256-e372-32cb-b75c-2a3503e668a9",
                                                "text": "More often than not, tomato seeds will sprout even if they are a couple of years old."
                                            },
                                            {
                                                "example_id": "89bd943a-2f32-47e6-be76-3f088c2838f4",
                                                "sense_id": "b7fb9256-e372-32cb-b75c-2a3503e668a9",
                                                "text": "Regular passengers become familiar with their train and attempts to change its make-up or any other aspect of its working are more often than not frowned upon, even though the change is probably for the better."
                                            },
                                            {
                                                "example_id": "d410c09d-8a63-43fe-b3cc-4aedd1710706",
                                                "sense_id": "b7fb9256-e372-32cb-b75c-2a3503e668a9",
                                                "text": "he would gather his courage and set out between the columned arches to ask one of the unaccompanied women to partner him. More often than not, their answer was no."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e36424c9-415a-4ddb-9383-11ea70ea839d",
                        "source_entry_id": "9096e1d9-77dc-347b-b90b-6f9d6112d85d",
                        "source_sense_id": "d04c9214-1896-3222-a462-ab2752293fb2",
                        "source_sense_description": "in de meeste gevallen, vaak",
                        "target_lang_word": "frequently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frequently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf31fa05-c760-3fe3-af2f-9b4406ba52ea",
                                        "entry_id": "147c8883-60da-3ebc-86f5-3bccbb2b31a1",
                                        "glosses": [
                                            "At frequent intervals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377fb6f5-64d9-48ea-bfda-815c714cee99",
                                                "sense_id": "bf31fa05-c760-3fe3-af2f-9b4406ba52ea",
                                                "text": "This question arises frequently."
                                            },
                                            {
                                                "example_id": "eca12a86-8d82-47ff-8213-8949223fa997",
                                                "sense_id": "bf31fa05-c760-3fe3-af2f-9b4406ba52ea",
                                                "text": "He was enrolled but frequently didn't attend class."
                                            },
                                            {
                                                "example_id": "4b6e8b40-a8f8-495c-9533-7f5fcf4d9871",
                                                "sense_id": "bf31fa05-c760-3fe3-af2f-9b4406ba52ea",
                                                "text": "As we age, the major arteries of our bodies frequently become thickened with plaque, a fatty material with an oatmeal-like consistency that builds up along the inner lining of blood vessels. The reason plaque forms isn’t entirely known, but it seems to be related to high levels of cholesterol inducing an inflammatory response, which can also attract and trap more cellular debris over time."
                                            },
                                            {
                                                "example_id": "b23e3bae-3174-42b2-a5c5-7ca5dcc2b7af",
                                                "sense_id": "bf31fa05-c760-3fe3-af2f-9b4406ba52ea",
                                                "text": "The NFA has been a flashpoint for advocates, who say that silencers are not frequently used in crime and believe that the silencers and other weapons regulated under the law, including machine guns and short-barreled rifles and shotguns, are protected by the Second Amendment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7463657e-0f19-332a-8bca-d3652364ac66",
                                        "entry_id": "147c8883-60da-3ebc-86f5-3bccbb2b31a1",
                                        "glosses": [
                                            "For infinitely many terms of the sequence."
                                        ],
                                        "tags": [
                                            "of a sequence"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c6e46cc-5bab-4d2b-b502-4a1fe69394eb",
                        "source_entry_id": "9096e1d9-77dc-347b-b90b-6f9d6112d85d",
                        "source_sense_id": "d04c9214-1896-3222-a462-ab2752293fb2",
                        "source_sense_description": "in de meeste gevallen, vaak",
                        "target_lang_word": "often",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "often",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                        "entry_id": "6a9a5486-8764-343c-8fea-b30379c39b83",
                                        "glosses": [
                                            "Frequently; many times on different occasions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75b74c3-9bba-4e2a-9ff4-dcfee6482334",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "I often walk to work when the weather is nice."
                                            },
                                            {
                                                "example_id": "891f7bb6-1220-42c3-8e4f-9bc6a14868de",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "I’ve been going to the movies more often since a new theatre opened near me."
                                            },
                                            {
                                                "example_id": "d1e86e34-7e48-4d22-a4b7-03befeceb5b7",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "It can't be said too often / often enough."
                                            },
                                            {
                                                "example_id": "ae708599-8fde-47cc-b31a-17b4146181bf",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "☞ This word [wrap] is often pronounced wrop, rhyming with top, even by ſpeakers much above the vulgar."
                                            },
                                            {
                                                "example_id": "f1a10b1b-f1de-4946-b27a-220b454787b2",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "How often is the comfort of a whole family abridged by some trifling circumstance, that ought not to have made a visible impression!"
                                            },
                                            {
                                                "example_id": "1062f540-1f8c-415c-9dec-ebe52002dfb7",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "Although frogs are able to swim well and often are found in water, they are really land animals."
                                            },
                                            {
                                                "example_id": "4e188a08-06d1-4385-96a5-54b71d296ded",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "According to this saga of intellectual-property misanthropy, these creatures [patent trolls] roam the business world, buying up patents and then using them to demand extravagant payouts from companies they accuse of infringing them. Often, their victims pay up rather than face the costs of a legal battle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "often",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5992fbc-0280-348f-8d3b-bc7fa5101526",
                                        "entry_id": "f9ea9e1e-cb80-355c-832e-26593d623329",
                                        "glosses": [
                                            "Frequent."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f195f0e-41e5-41cc-9ba6-7426de86b370",
                                                "sense_id": "e5992fbc-0280-348f-8d3b-bc7fa5101526",
                                                "text": "[…] it is a melancholy of mine own, compounded of many simples, extracted from many objects, and, indeed, the sundry contemplation of my travels; in which my often rumination wraps me in a most humorous sadness."
                                            },
                                            {
                                                "example_id": "5640b4e7-2f1b-4345-b2ef-15dc6324bd85",
                                                "sense_id": "e5992fbc-0280-348f-8d3b-bc7fa5101526",
                                                "text": "1618, Anthony Munday (translator), The Third Booke of Amadis de Gaule by Nicolas de Herberay des Essarts (1542), London, Chapter 2, p. 18,\nThen came the Ladies to visite him, and the Queene gaue him most gracious welcome, desiring him to be of good cheere: For heere is my Daughter (quoth she) right skilfull in the Art of Chirurgerie, that meanes to bee your often visitant."
                                            },
                                            {
                                                "example_id": "00347800-76f7-4c50-a4d0-86f3365b71e7",
                                                "sense_id": "e5992fbc-0280-348f-8d3b-bc7fa5101526",
                                                "text": "The Shew-bread by an often remove, and renewing, was continually to stand before the Lord in his House […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
