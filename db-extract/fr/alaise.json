                        "entry_id": "7da2d191-caa9-3b51-b972-4b15dd59bfa0",
                        "glosses": [
                            "Osier ou jonc qui fixe une jeune branche d’arbre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aae833a3-75b1-3323-a0af-6734f4478e6a",
                        "entry_id": "7da2d191-caa9-3b51-b972-4b15dd59bfa0",
                        "glosses": [
                            "Planche emboîtée dans une autre pour l’élargir. Rive ou cadre en bois dur servant à protéger un panneau de bois tendre ou de particules."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7da44d1b-0de9-390c-be75-25d053f416bc",
                        "entry_id": "7da2d191-caa9-3b51-b972-4b15dd59bfa0",
                        "glosses": [
                            "Protection normalement en tissu imperméable que l’on place entre le matelas et les draps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b77bbed-5ef1-4b1b-8a78-6f0256461674",
                                "sense_id": "7da44d1b-0de9-390c-be75-25d053f416bc",
                                "text": "Un drap plié servait d’alaise sous le malade."
                            },
                            {
                                "example_id": "115132c8-ac28-40aa-a54c-cc4b71955870",
                                "sense_id": "7da44d1b-0de9-390c-be75-25d053f416bc",
                                "text": "Le lieu de l’accouchement : c’est toujours la chambre à coucher, qui est en général celle de toute la famille, c’est presque toujours sur le lit conjugal, mais un autre peut aussi servir, sur lequel on aura étendu une alaise."
                            }
                        ]
                    }
