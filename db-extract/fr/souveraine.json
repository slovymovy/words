                                "target_senses": [
                                    {
                                        "sense_id": "68e5066c-0b18-3d67-975d-ddbc8b813c91",
                                        "entry_id": "9e6f0b8b-923d-3e8c-8afa-710ccc2ae224",
                                        "glosses": [
                                            "Exercising power of rule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e59b7b98-d01b-4c8d-bb0d-be8dd60239f8",
                                                "sense_id": "68e5066c-0b18-3d67-975d-ddbc8b813c91",
                                                "text": "sovereign nation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "716debab-8d54-3aa1-8db4-016e1ec9391a",
                                        "entry_id": "9e6f0b8b-923d-3e8c-8afa-710ccc2ae224",
                                        "glosses": [
                                            "Exceptional in quality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "923e6913-1820-40ee-bb22-78daa96669e1",
                                                "sense_id": "716debab-8d54-3aa1-8db4-016e1ec9391a",
                                                "text": "Her voice was her sovereign talent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eea4dd0f-b465-3b50-abc9-cb9216d934be",
                                        "entry_id": "9e6f0b8b-923d-3e8c-8afa-710ccc2ae224",
                                        "glosses": [
                                            "Extremely potent or effective (of a medicine, remedy etc.)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0042e29c-1de4-4df8-9509-862178701da5",
                                                "sense_id": "eea4dd0f-b465-3b50-abc9-cb9216d934be",
                                                "text": "In Spain people still bathe in the sea or roll naked in the dew of the meadows on St. John’s Eve, believing that this is a sovereign preservative against diseases of the skin."
                                            },
                                            {
                                                "example_id": "49e7a09a-f52b-4f23-902e-0242a7d762bd",
                                                "sense_id": "eea4dd0f-b465-3b50-abc9-cb9216d934be",
                                                "text": "The ſoueraigne weede betwixt two marbles plaine\n She pownded ſmall, and did in peeces bruze,\n And then atweene her lilly handes twaine,\n Into his wound the iuyce thereof did ſcruze […]"
                                            },
                                            {
                                                "example_id": "87d63e20-7eae-4d67-b895-83f4ec6f798e",
                                                "sense_id": "eea4dd0f-b465-3b50-abc9-cb9216d934be",
                                                "text": "[…] God save the mark!—\nAnd telling me the sovereign’st thing on earth\nWas parmaceti for an inward bruise;"
                                            },
                                            {
                                                "example_id": "193b8d56-7b85-4cc8-9fd0-6eabfe2a7e01",
                                                "sense_id": "eea4dd0f-b465-3b50-abc9-cb9216d934be",
                                                "text": "Homer of Moly and Nepenthe singes:\n Moly, the gods most soveraigne hearbe divine.\n Nepenth Hellen's drink, which gladnes brings,—\n Hart's greife repells, and doth yᵉ witts refine."
                                            },
                                            {
                                                "example_id": "9ffa47e5-b4fc-4215-bf5e-72962de92ad1",
                                                "sense_id": "eea4dd0f-b465-3b50-abc9-cb9216d934be",
                                                "text": "a sovereign remedy"
                                            },
                                            {
                                                "example_id": "dd778483-fa46-48ef-b7b6-008b1359cf23",
                                                "sense_id": "eea4dd0f-b465-3b50-abc9-cb9216d934be",
                                                "text": "Such a sovereign influence has this passion upon the regulation of the lives and actions of men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0c0b16f-d695-33a7-a6f5-1ca2c389f678",
                                        "entry_id": "9e6f0b8b-923d-3e8c-8afa-710ccc2ae224",
                                        "glosses": [
                                            "Having supreme, ultimate power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "699bb548-83f9-4de7-8524-7c39164b28ca",
                                                "sense_id": "b0c0b16f-d695-33a7-a6f5-1ca2c389f678",
                                                "text": "Gentlemen, may I introduce Her Royal Highness, the Sovereign and Most Imperial Majesty, Empress Elizabeth of Vicron."
                                            },
                                            {
                                                "example_id": "3333be5a-4030-4b7c-9b4b-f08b453237d7",
                                                "sense_id": "b0c0b16f-d695-33a7-a6f5-1ca2c389f678",
                                                "text": "You're the keeper of the castle\n So be a father to your children\n The provider of all their daily needs\n Like a sovereign Lord protector\n Be their destiny's director\n And they'll do well to follow where you lead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80de4ac5-bc3c-389b-b15f-a7e1413716d6",
                                        "entry_id": "9e6f0b8b-923d-3e8c-8afa-710ccc2ae224",
                                        "glosses": [
                                            "Princely; royal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "014cfe07-661e-4c3f-a921-8a65a544b377",
                                                "sense_id": "80de4ac5-bc3c-389b-b15f-a7e1413716d6",
                                                "text": "You pity not the state, nor the remembrance of his most sovereign name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df7962d4-03c7-3ebb-8147-cb7e7bfd88ac",
                                        "entry_id": "9e6f0b8b-923d-3e8c-8afa-710ccc2ae224",
                                        "glosses": [
                                            "Predominant; greatest; utmost; paramount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18c3d99a-de82-438a-b401-d40da7dd84a1",
                                                "sense_id": "df7962d4-03c7-3ebb-8147-cb7e7bfd88ac",
                                                "text": "We acknowledge him [God] our sovereign good."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sovereign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "315c29b9-6d52-3883-913e-9ecacbbd1cbd",
                                        "entry_id": "ccb3fcc4-e0da-3dce-8788-863142704f50",
                                        "glosses": [
                                            "A monarch; the ruler of a country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58ec761b-331a-4462-8a6a-603e3ba4438c",
                                                "sense_id": "315c29b9-6d52-3883-913e-9ecacbbd1cbd",
                                                "text": "The petty ſtreames that paie a dailie det\n To their ſalt ſoveraigne with their freſh fals haſt,\n Adde to his flowe, but alter not his taſt."
                                            },
                                            {
                                                "example_id": "7447cbd0-4e68-41f8-b435-45f07c554e16",
                                                "sense_id": "315c29b9-6d52-3883-913e-9ecacbbd1cbd",
                                                "text": "Is this the Region, this the Soil, the Clime,\n Said then the lost Archangel, this the seat\n That we must change for Heaven?, this mournful gloom\n For that celestial light? Be it so, since hee\n Who now is Sovran can dispose and bid\n What shall be right : fardest from him is best\n Whom reason hath equald, force hath made supream\n Above his equals. […]"
                                            },
                                            {
                                                "example_id": "6d45b6ac-e271-497d-b012-609432b027ae",
                                                "sense_id": "315c29b9-6d52-3883-913e-9ecacbbd1cbd",
                                                "text": "No question is to be made but that the bed of the Missisippi^([sic]) belongs to the sovereign, that is, to the nation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40313596-373c-3a1a-9490-046ddcea4a47",
                                        "entry_id": "ccb3fcc4-e0da-3dce-8788-863142704f50",
                                        "glosses": [
                                            "One who is not a subject to a ruler or nation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c3d378d-ef15-3318-affa-a4f847b9a930",
                                        "entry_id": "ccb3fcc4-e0da-3dce-8788-863142704f50",
                                        "glosses": [
