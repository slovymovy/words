                    {
                        "sense_id": "74b9fe22-6e1d-3de2-b7fc-e9e0382f2e47",
                        "entry_id": "4c95c654-4a16-3718-8868-d4be411df3cc",
                        "glosses": [
                            "État de vieillissement de l’œil qui rend difficile la focalisation de la vision pour lire ou effectuer un travail de près."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1513eb76-ceb8-4abd-bed6-12460cdaaac2",
                                "sense_id": "74b9fe22-6e1d-3de2-b7fc-e9e0382f2e47",
                                "text": "La myiodopsie que le malade éprouve depuis quelques années a probablement été causée par l'action de trop rapprocher les objets pendant le travail, lorsque déjà la presbytie commençait à se développer, tandis que notre confrère se croyait encore myope."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2220c06-831c-4404-bceb-0b8584a127eb",
                        "source_entry_id": "4c95c654-4a16-3718-8868-d4be411df3cc",
                        "source_sense_id": "74b9fe22-6e1d-3de2-b7fc-e9e0382f2e47",
                        "target_lang_word": "Weitsichtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weitsichtigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38adfb55-7b5b-3630-809a-f596627fd7eb",
                                        "entry_id": "26964a9e-3cc5-31b4-a2ec-784558ba537f",
                                        "glosses": [
                                            "Sehschwäche, bei der nahe Objekte nur unscharf, weiter entfernte aber klarer gesehen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "928ef15d-e6d8-4ed6-aa07-cd9c41693d36",
                                                "sense_id": "38adfb55-7b5b-3630-809a-f596627fd7eb",
                                                "text": "„Eine leichte Weitsichtigkeit gilt bei Kleinkindern als normal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08cdc944-9081-3b98-b87f-dbdae761d4a8",
                                        "entry_id": "26964a9e-3cc5-31b4-a2ec-784558ba537f",
                                        "glosses": [
                                            "Fähigkeit, zukünftige Entwicklungen (Chancen und Risiken) zu überblicken, frühzeitig zu erkennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e2e3543-9ede-4bbf-8b4a-981dc183d4e8",
                                                "sense_id": "08cdc944-9081-3b98-b87f-dbdae761d4a8",
                                                "text": "„Bei so viel ökonomischer Weitsichtigkeit ziehen wir den Hut vor dem HSV-Vorstandsvorsitzenden Bernd Hoffmann, der unlängst erklärte, dass unter seiner Ägide keine ‚Preistreiberei‘ von Spielern akzeptiert werde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
