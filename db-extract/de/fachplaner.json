                "senses": [
                    {
                        "sense_id": "563f9c15-d936-3a06-b42a-4efb0e92cf85",
                        "entry_id": "4a973d68-82d9-3296-869f-08c54f70a137",
                        "glosses": [
                            "jemand, der eine spezialisierte Planung für einen Teilbereich eines größeren Projektes entwirft"
                        ],
                        "tags": [
                            "Baugewerbe",
                            "Stadtplanung",
                            "Städtebau"
                        ],
                        "examples": [
                            {
                                "example_id": "fc3e302f-9676-4d5b-8686-c0253bf8fb39",
                                "sense_id": "563f9c15-d936-3a06-b42a-4efb0e92cf85",
                                "text": "Fachplaner sind beispielsweise Tragwerksplaner, Bauphysiker oder Planer der Haustechnik (technische Gebäudeausrüstung, Klima, Sanitär, Energie), nicht jedoch Landschaftsarchitekten."
                            },
                            {
                                "example_id": "bbc120ea-9390-45ed-a4c7-2f8f0f90664f",
                                "sense_id": "563f9c15-d936-3a06-b42a-4efb0e92cf85",
                                "text": "Im Gegensatz zu internen Fachplanern müssen sich externe Fachplaner zunachst Ortskenntnis ̈uber die Betriebsstatte sowie die Betriebsablaufe verschaffen."
                            },
                            {
                                "example_id": "9682a7f9-8625-49e1-ae54-3c3818240c9f",
                                "sense_id": "563f9c15-d936-3a06-b42a-4efb0e92cf85",
                                "text": "Das Team setzt sich zusammen aus Architekten, Fachplanern, Brunnen- oder Tiefbauunternehmern sowie den Heizungs- und Elektrofachhandwerkern und letztendlich auch den späteren Bauherren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
