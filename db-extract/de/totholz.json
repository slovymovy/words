                ],
                "senses": [
                    {
                        "sense_id": "11592b9e-4fa4-3977-ac99-dd653876171a",
                        "entry_id": "2117f6e7-0ba8-3246-a681-104e6f56a613",
                        "glosses": [
                            "Gesamtheit nicht mehr lebender Teile von Bäumen im Wald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d900960f-f734-49db-ba62-8115c82546dd",
                                "sense_id": "11592b9e-4fa4-3977-ac99-dd653876171a",
                                "text": "„Denn Totholz ist im Wald der Anfang von allem.“"
                            },
                            {
                                "example_id": "132ebd9f-3163-4ba1-abcc-50d8426ee46d",
                                "sense_id": "11592b9e-4fa4-3977-ac99-dd653876171a",
                                "text": "„Velda bekam von der Besatzungsverwaltung die Genehmigung, das Totholz aus dem zwei Kilometer entfernten Wald zu holen, damit sie den Winter über heizen konnten.“"
                            },
                            {
                                "example_id": "fd979ffb-63f4-423a-af63-464a13aacd6b",
                                "sense_id": "11592b9e-4fa4-3977-ac99-dd653876171a",
                                "text": "„Ein weiterer Kollateralnutzen des massenhaften Baumsterbens ist die gestiegene Menge an Totholz im Wald. Zahlreiche Pilze, Insekten und Pflanzen sind auf Totholz angewiesen, zudem trägt der Zersetzungsprozess zur Humusbildung des Waldbodens bei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6945d7a5-3bb0-3256-ab80-be6cecbe00c0",
                        "entry_id": "2117f6e7-0ba8-3246-a681-104e6f56a613",
                        "glosses": [
                            "nicht nutzbarer Teil eines Wasserfahrzeugs unter der Wasseroberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22aea732-988e-4393-9c9e-90ec67364bbe",
                                "sense_id": "6945d7a5-3bb0-3256-ab80-be6cecbe00c0",
                                "text": "„Bei Schrauben, die gleich hinter dem Totholz sitzen, wird der Wasserstrom zur Schraube durch eben dies Totholz unterbrochen; es tritt bei höherer Geschwindigkeit, besonders, wenn das Totholz nach hinten zu nicht genügend ausgeschärft ist […], Luftraumbildung hinter dem Totholz ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "223c9741-5850-405b-aec2-dc50aa84516e",
                        "source_entry_id": "2117f6e7-0ba8-3246-a681-104e6f56a613",
                        "source_sense_id": "11592b9e-4fa4-3977-ac99-dd653876171a",
                        "source_sense_description": "Gesamtheit nicht mehr lebender Teile von Bäumen im Wald",
                        "target_lang_word": "bois mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bois mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d9ecf00-29ae-3587-bd98-e7bdc6ca3651",
                                        "entry_id": "612d756e-88b4-3460-ab19-9a7ce8a96581",
                                        "glosses": [
                                            "Branches qui ne reçoivent plus de sève, et en général tout arbre séché sur le pied."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e00906-4a3c-49ac-b31f-d8f67aa2073b",
                                                "sense_id": "0d9ecf00-29ae-3587-bd98-e7bdc6ca3651",
                                                "text": "Dans ce document, il n'est même pas fait mention de bois mort et de mort-bois, tellement ces épaves appartenaient de droit aux pauvres gens, comme espèce de part à Dieu."
                                            },
                                            {
                                                "example_id": "b050c829-44c2-4dae-8031-d93f9b994f04",
                                                "sense_id": "0d9ecf00-29ae-3587-bd98-e7bdc6ca3651",
                                                "text": "J’eus deux jours de vie sauvage et libre. J’allais chercher du bois mort pour les cuisines, et je commençai avec Gontier deux ou trois cabanes couvertes de roseaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "128f24b0-2a4a-32c7-8bd6-1bef9fee201e",
                                        "entry_id": "612d756e-88b4-3460-ab19-9a7ce8a96581",
                                        "glosses": [
                                            "Débris, relents de ce qui a définitivement cessé d’être actif, vivant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faf6742b-eb46-44b6-a61e-7bba806100f8",
                                                "sense_id": "128f24b0-2a4a-32c7-8bd6-1bef9fee201e",
                                                "text": "Tel est le génie de la révélation diversitaire: elle traite les peuples comme le bois mort de l’humanité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5978932c-b994-48ae-878c-219c49b359cb",
                        "source_entry_id": "2117f6e7-0ba8-3246-a681-104e6f56a613",
