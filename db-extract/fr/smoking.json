                                        "examples": [
                                            {
                                                "example_id": "bb40d174-9673-4de9-9df0-b7addbec0da1",
                                                "sense_id": "a112c3eb-b99a-357d-b751-5c6277a92fba",
                                                "text": "Constant was fully dressed in blue-green evening shorts and a dinner jacket of gold brocade."
                                            },
                                            {
                                                "example_id": "96cc5e4e-91f6-42ef-b571-72d78388470f",
                                                "sense_id": "a112c3eb-b99a-357d-b751-5c6277a92fba",
                                                "text": "He was dressed in a gray dinner jacket and matching trousers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "762befd2-5a5a-3291-9057-300ac114a6cf",
                                        "entry_id": "4de6a7b4-c54d-32c3-8313-27761a4216d4",
                                        "glosses": [
                                            "The formal suit, typically black, that includes this type of jacket."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9b42f8e-f732-46d0-a2fc-039e37b31b7e",
                                                "sense_id": "762befd2-5a5a-3291-9057-300ac114a6cf",
                                                "text": "[They] sat in a pen in the corner, smoking cigarettes and reading magazines; four or five girls in black silk dresses and the same number of slight effeminate young men in dinner-jackets."
                                            },
                                            {
                                                "example_id": "e66fda71-d43d-4b59-b73a-417d4cfcbd42",
                                                "sense_id": "762befd2-5a5a-3291-9057-300ac114a6cf",
                                                "text": "Mr Lackersteen was even wearing a dinner-jacket—white, because of the season—and was completely sober. The boiled shirt and piqué waistcoat seemed to hold him upright and stiffen his moral fibre like a breastplate."
                                            },
                                            {
                                                "example_id": "8338a265-5e7d-4d35-b5a7-8c47a1f5f744",
                                                "sense_id": "762befd2-5a5a-3291-9057-300ac114a6cf",
                                                "text": "It was a dinner-jacket evening—not tails, because they would only be three—and though he had respected such niceties for years he found them suddenly ridiculous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
