                                    {
                                        "sense_id": "5baca654-29c6-3091-8a28-b6ae4bdab242",
                                        "entry_id": "4d56511d-0149-3595-a721-187a4416d9ae",
                                        "glosses": [
                                            "Opposition philosophique au racisme et à ses diverses manifestations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54010f28-b3bd-4e3a-b388-dcecb45db0d6",
                                                "sense_id": "5baca654-29c6-3091-8a28-b6ae4bdab242",
                                                "text": "Je mentirais si je dissimulais cette perpétuelle défensive, le sentiment de percevoir, avant même qu’il ne soit né, l’hostilité ou la condescendance de ceux avec qui vous êtes apparemment au mieux ou qui vont clamer par exemple leur antiracisme pur et dur."
                                            },
                                            {
                                                "example_id": "614409a6-a1e7-4503-9cef-4dbf6c727be7",
                                                "sense_id": "5baca654-29c6-3091-8a28-b6ae4bdab242",
                                                "text": "Prenez certains militants de l’anti­racisme. Leur attitude a aussi, très souvent, tous les traits d’une foi."
                                            }
                                        ]
                                    }
                                ]
                            }
