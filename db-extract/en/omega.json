                "senses": [
                    {
                        "sense_id": "14c6a6e5-cb4b-3c89-a605-5503eef26c11",
                        "entry_id": "27b7bc41-e442-3100-a5e6-2cf52e454974",
                        "glosses": [
                            "Ultimately, most, supremely."
                        ],
                        "tags": [
                            "not-comparable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c687935b-4f61-4b0e-9c3b-0533ef1e6656",
                                "sense_id": "14c6a6e5-cb4b-3c89-a605-5503eef26c11",
