                "senses": [
                    {
                        "sense_id": "bfdc52e6-407c-386c-b27a-68f1d9cdbe09",
                        "entry_id": "512faa3a-8700-30e0-9f66-7f0f22745d8b",
                        "glosses": [
                            "Of or pertaining to fratricide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af764115-4903-4100-8dd5-ea4a6c3e82fa",
                                "sense_id": "bfdc52e6-407c-386c-b27a-68f1d9cdbe09",
                                "text": "Taizong's failure fooled no one. Indeed, one of Taizong's own sons may well have been unhinged by his father's obvious fratricidal and nepoticidal actions. These personal considerations directly affected Taizong's policy decisions, and thus warrant some discussion."
                            },
                            {
                                "example_id": "8ed46c43-e633-40a6-9f04-e1c97a5b8c5f",
                                "sense_id": "bfdc52e6-407c-386c-b27a-68f1d9cdbe09",
                                "text": "At the Lincoln Memorial in Washington, which commemorates the president who urged a fratricidal nation to go forward “with malice toward none, with charity toward all,” the Olipa family debated what’s happened to leadership in America."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "602ce3ec-301c-46df-b1af-91dfa0d4db04",
                        "source_entry_id": "512faa3a-8700-30e0-9f66-7f0f22745d8b",
                        "source_sense_id": "bfdc52e6-407c-386c-b27a-68f1d9cdbe09",
                        "source_sense_description": "of or pertaining to fratricide",
                        "target_lang_word": "fratricide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
