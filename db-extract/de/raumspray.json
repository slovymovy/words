                ],
                "senses": [
                    {
                        "sense_id": "5488e6e6-04ce-3cca-85b0-840f8d22b5e9",
                        "entry_id": "0cdb984c-3db6-30f0-a09b-f52b58173d07",
                        "glosses": [
                            "Flüssigkeit, die mit einem Gerät in feinsten Teilchen versprüht, zerstäubt wird, um die Luft in einem Raum gut riechen zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af19fdb8-327f-41c6-bb30-74d754d0452d",
                                "sense_id": "5488e6e6-04ce-3cca-85b0-840f8d22b5e9",
                                "text": "„Raumsprays sind so vielfältig, hier sind der Phantasie wirklich keine Grenzen gesetzt.“"
                            },
                            {
                                "example_id": "47c8834f-e1b9-43db-9cba-4ea42196360d",
                                "sense_id": "5488e6e6-04ce-3cca-85b0-840f8d22b5e9",
                                "text": "„Direkt neben Mutters Gebiss stand eine Flasche Raumspray, das nur sie selbst benutzte.“"
                            },
                            {
                                "example_id": "f2da8bf5-9fc4-4615-b576-12ed04a80cef",
                                "sense_id": "5488e6e6-04ce-3cca-85b0-840f8d22b5e9",
                                "text": "„Dieses Rezept für ein exklusives, 100 % natürliches Raumspray können Sie ohne Vorkenntnisse in fünf Minuten zuhause nachmachen.“"
                            },
                            {
                                "example_id": "b130cc0b-60ad-4bde-8ab0-48e82146c71d",
                                "sense_id": "5488e6e6-04ce-3cca-85b0-840f8d22b5e9",
                                "text": "„Raumsprays bieten nicht nur die Möglichkeit, den Praxisalltag zu harmonisieren, sondern auch, die Patienten auf eine sehr angenehme Weise zu unterstützen.“"
                            },
                            {
                                "example_id": "9a6c9a9b-74e2-444e-9752-0406f0266dcf",
                                "sense_id": "5488e6e6-04ce-3cca-85b0-840f8d22b5e9",
                                "text": "„Für ein harmonisches Raumklima können Sie Duftlämpchen aufstellen oder ein Raumspray herstellen.“"
                            },
                            {
                                "example_id": "48e2c2fc-12e5-4ea0-a88b-4044acbf6a16",
                                "sense_id": "5488e6e6-04ce-3cca-85b0-840f8d22b5e9",
                                "text": "„Zur Herstellung eines Raumsprays benötigen Sie 100 ml Wodka oder anderen hochprozentigen Alkohol ohne Eigengeruch sowie 15 Tropfen eines der oben genannten ätherischen Öle in einem Sprühvernebler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
