                ],
                "senses": [
                    {
                        "sense_id": "1dafef8b-1e4f-326c-8135-3e3923356af9",
                        "entry_id": "5bbee428-a1c7-3703-8628-0c43def77645",
                        "glosses": [
                            "Verlängerung einer Befristung einer staatlichen Erlaubnis, beispielsweise für das Betreiben einer bestehenden technisch Anlage (oft eines Atomkraftwerkes)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c465e35d-f16a-4d58-a893-d2c69a7c84e1",
                                "sense_id": "1dafef8b-1e4f-326c-8135-3e3923356af9",
                                "text": "„Atomkraftgegner warnen vor einer möglichen Laufzeitverlängerung der deutschen AKW.“"
                            },
                            {
                                "example_id": "a86a1f9f-accd-42e8-8c9e-320e57293dda",
                                "sense_id": "1dafef8b-1e4f-326c-8135-3e3923356af9",
                                "text": "„Die Laufzeitverlängerung für das Kraftwerk Emsland wird aufgrund der schon weit abgebrannten Brennelemente im besten Fall etwa eine Milliarde Kilowattstunden zusätzlich bringen.“"
                            },
                            {
                                "example_id": "3a516750-9388-4e53-be57-ac400e4a299b",
                                "sense_id": "1dafef8b-1e4f-326c-8135-3e3923356af9",
                                "text": "„Belgien verschiebt seinen Atomausstieg um zehn Jahre“ – […] „Durch die Laufzeitverlängerung soll die Energiesicherheit im Land gewährleistet werden.“"
                            },
                            {
                                "example_id": "89c679d4-5282-444a-8084-e9f38c7443d0",
                                "sense_id": "1dafef8b-1e4f-326c-8135-3e3923356af9",
                                "text": "„Die geplante Laufzeitverlängerung muss nun noch mit dem Betreiber Engie verhandelt werden.“"
                            },
                            {
                                "example_id": "43a5b9a5-e9c8-4985-8061-67c47b7d8a8a",
                                "sense_id": "1dafef8b-1e4f-326c-8135-3e3923356af9",
                                "text": "„»Bei der Frage der Laufzeitverlängerung von Atomkraftwerken ist entscheidend, dass für die gegenwärtig drei noch am Netz befindlichen AKWs seit 13 Jahren die periodische Sicherheitsüberprüfung nicht mehr stattgefunden hat.«“"
                            },
                            {
                                "example_id": "5e905f1e-1e71-46f2-994d-82cbdaffc62e",
                                "sense_id": "1dafef8b-1e4f-326c-8135-3e3923356af9",
                                "text": "[2011:] „Die Koalition verhängte ein Moratorium der von ihr zuvor beschlossenen Laufzeitverlängerung deutscher Kernkraftwerke und besiegelte schließlich mit dem Atomkonsens den Atomausstieg bis zum Jahr 2022.“"
                            },
                            {
                                "example_id": "f1c09ab6-7de2-4437-ba45-4371b73459c5",
                                "sense_id": "1dafef8b-1e4f-326c-8135-3e3923356af9",
                                "text": "[Atomkraftwerk Krsko:] „Umweltaktivisten fordern wegen der Erdbebengefahr seit langem eine Abschaltung des Meilers. Ursprünglich hätte es 2023 dazu kommen sollen - 2015 einigten sich beide Länder auf eine Laufzeitverlängerung um zwei Jahrzehnte.“"
                            },
                            {
                                "example_id": "4a69351d-8dc7-472f-a297-12f92439b2fa",
                                "sense_id": "1dafef8b-1e4f-326c-8135-3e3923356af9",
                                "text": "„Bei Glyphosat streitet das Agrobusiness jetzt für eine Laufzeitverlängerung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f44393ae-51c8-3b38-bce6-31320bbbf9d7",
                        "entry_id": "5bbee428-a1c7-3703-8628-0c43def77645",
                        "glosses": [
                            "Verlängerung der Gültigkeitsdauer eines bestehenden Vertrages"
                        ],
                        "tags": [
                            "für Kredite, Anleihen"
                        ],
                        "examples": [
                            {
                                "example_id": "cdc20647-ac43-4e1f-aafa-3b9e4e19e342",
                                "sense_id": "f44393ae-51c8-3b38-bce6-31320bbbf9d7",
                                "text": "„Nach langwierigen Verhandlungen hat sich Kiew mit ausländischen Geldgebern auf einen Schuldenerlass verständigt. Auch Laufzeitverlängerungen von Krediten und Zinserleichterungen sind vorgesehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
