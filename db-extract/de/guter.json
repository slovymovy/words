                ],
                "senses": [
                    {
                        "sense_id": "c9482d0b-e68d-3f3b-85bb-fd77ece8a05c",
                        "entry_id": "de2c2ebc-5ea1-3913-9186-e81bcdadc2fa",
                        "glosses": [
                            "(Inbegriff für) eine gute Person [Singular] beziehungsweise Gruppe [Plural]"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bfa98ab2-f003-4fec-a2ee-239d2a315327",
                                "sense_id": "c9482d0b-e68d-3f3b-85bb-fd77ece8a05c",
                                "text": "Das Happy-End bestand aus einem gewaltlosen Sieg der Guten über die Bösen."
                            },
                            {
                                "example_id": "765db466-2915-42d7-ac97-2249c9459ff9",
                                "sense_id": "c9482d0b-e68d-3f3b-85bb-fd77ece8a05c",
                                "text": "Bist du ein Guter?"
                            },
                            {
                                "example_id": "bbaa4e25-403c-45e2-972a-3b7827bdee27",
                                "sense_id": "c9482d0b-e68d-3f3b-85bb-fd77ece8a05c",
                                "text": "Die Guten werden stets übersehen oder verfolgt."
                            },
                            {
                                "example_id": "65ef5be2-64dc-4cb6-8e63-78662aa33d07",
                                "sense_id": "c9482d0b-e68d-3f3b-85bb-fd77ece8a05c",
                                "text": "„Der Vogl, der ist ein ganz Guter.“"
                            },
                            {
                                "example_id": "62865551-b859-468f-afb2-c6bc28f0092f",
                                "sense_id": "c9482d0b-e68d-3f3b-85bb-fd77ece8a05c",
                                "text": "„Die Israelis sind die Bösen, die PalästinenserInnen [sic] die Guten – und wir sind ja auch die Guten. Was machte ich also bei den Bösen?“"
                            },
                            {
                                "example_id": "2e09d7ab-a490-40cf-ac92-7149fe7cd9f1",
                                "sense_id": "c9482d0b-e68d-3f3b-85bb-fd77ece8a05c",
                                "text": "„Gottes Wort schneidet wie ein Schwert, wenn es durch die sündigen Herzen fährt, Gottes Zorn brennt wie ein Feuer, Lust und Freude wird dem Sünder theuer; aber die Milden und die Guten wird Gott stillen und ermuthen: sie sollen mit Freuden vor ihn kommen denn alles Leid wird ihnen benommen. […] Ihr meine lieben Engel sollt die Menschen scheiden, die Guten von den Leiden, die Frommen zu der rechten Hand, die ich in allem Guten treu erfand; die Bösen stellen zur linken Seiten die am Bösen sich erfreuten […] Alsdann sind die Guten von den Bösen geschieden und spricht der Herr Christus zu den Guten also […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
