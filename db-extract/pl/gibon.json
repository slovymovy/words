                                    {
                                        "sense_id": "29086e00-18f8-34e8-a6a8-8b72e82efc67",
                                        "entry_id": "daf9ceba-6e03-3d89-ab84-400df6b4820f",
                                        "glosses": [
                                            "piccola scimmia aplorrina (cioè dal naso asciutto) catarrina (cioè del vecchio cotinente) antropomorfa del sudest asiatico appartenente alla superfamiglia Hominoidea ed alla famiglia degli Ilobati (Hylobatidae), dalle braccia tanto lunghe che l'animale stando ritto si può toccare i malleoli; vive sugli alberi; la sua classificazione scientifica è Hylobatidae ( tassonomia)"
                                        ],
                                        "tags": [
                                            "primatologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8550ef3b-5d90-49d5-bf6c-37542c1829bb",
                                                "sense_id": "29086e00-18f8-34e8-a6a8-8b72e82efc67",
                                                "text": "un gibbone è un primate appartenente al sottordine delle aplorrine e al parvordine delle catarrine"
                                            }
                                        ]
                                    }
                                ]
                            }
