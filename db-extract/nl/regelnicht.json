                        "examples": [
                            {
                                "example_id": "2288a64c-a52d-4e4e-b1a7-0da04fe89805",
                                "sense_id": "6dd1293c-e300-3a9d-a3c4-1e511371a31a",
                                "text": "Ze staat bekend als een echte regelnicht, altijd bezig om alles onder controle te houden en de regels nauwgezet te volgen.",
                                "translation": "She is known as a true petty, rules-obsessed woman, always busy trying to keep everything under control and follow the rules meticulously.",
                                "english": "She is known as a true petty, rules-obsessed woman, always busy trying to keep everything under control and follow the rules meticulously."
                            },
                            {
                                "example_id": "e0c6dec2-6611-48a2-a1a6-17333ffe2e13",
                                "sense_id": "6dd1293c-e300-3a9d-a3c4-1e511371a31a",
                                "text": "Als de enige vrouwelijke manager in het team wordt ze soms een regelnichtje genoemd, maar ze is gewoon heel gedreven in haar werk.",
                                "translation": "As the only female manager in the team, she is sometimes called a petty, rules-obsessed woman, but she is just very driven in her work.",
                                "english": "As the only female manager in the team, she is sometimes called a petty, rules-obsessed woman, but she is just very driven in her work."
