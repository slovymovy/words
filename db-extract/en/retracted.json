                "senses": [
                    {
                        "sense_id": "81c8b520-fd3a-3359-a665-3a8119121f92",
                        "entry_id": "6e519758-9790-3e53-8537-256df903e21d",
                        "glosses": [
                            "Withdrawn back and in, as the claws of a cat."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b2038223-89d6-3fef-bfed-241795d59a86",
                        "entry_id": "6e519758-9790-3e53-8537-256df903e21d",
                        "glosses": [
                            "Pronounced further back in the vocal tract."
                        ],
                        "tags": [
                            "of a sound"
                        ],
                        "examples": [
                            {
                                "example_id": "2d2441f7-327c-41a6-b5e1-694cf36eef66",
                                "sense_id": "b2038223-89d6-3fef-bfed-241795d59a86",
                                "text": "My guess is that he substitutes a schwa sound for the retracted r in final position."
                            }
                        ]
                    },
                    {
                        "sense_id": "83ae87df-ce0e-3065-a516-f1e81588ba2a",
                        "entry_id": "6e519758-9790-3e53-8537-256df903e21d",
                        "glosses": [
                            "Couped bendwise: cut off by a line diagonal to the main direction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93b7be87-f74e-43fc-ad70-a6bc243c79f6",
                                "sense_id": "83ae87df-ce0e-3065-a516-f1e81588ba2a",
                                "text": "Pale, retracted, that is, shortened. It is a French term, used when pales are borne cut off, either pendent from the chief, or issuant from the base, which should be particularly noticed in the blazon."
                            },
                            {
                                "example_id": "96b7acb3-c820-4507-82bf-136fbeb16b06",
                                "sense_id": "83ae87df-ce0e-3065-a516-f1e81588ba2a",
                                "text": "RETRACTED, said of charges when borne one shorter than another; as, three pales or palets issuant from the chief, retracted, that is, cut off bend ways, and hanging of different lengths."
                            }
                        ]
                    }
                ],
