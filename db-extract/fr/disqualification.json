                "senses": [
                    {
                        "sense_id": "77dae63a-6a4a-315a-b8fa-baeebaf25609",
                        "entry_id": "2f5da6b3-59e1-3844-a8a0-4cbff791460c",
                        "glosses": [
                            "Élimination d'un cheval qui ne remplit pas les conditions requises pour concourir."
                        ],
                        "tags": [
                            "Sports hippiques"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a9343fe6-1298-3e59-91ed-c1db34d866bd",
                        "entry_id": "2f5da6b3-59e1-3844-a8a0-4cbff791460c",
                        "glosses": [
                            "Élimination d’un concurrent ou d'une équipe qui a contrevenu au règlement."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0b033acb-44a2-4d55-a15d-bbbcae9fada1",
                                "sense_id": "a9343fe6-1298-3e59-91ed-c1db34d866bd",
                                "text": "Il perd par disqualification et retourne à ses études dans les légers."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6d449df-c144-3100-a7c3-891b343f8214",
                        "entry_id": "2f5da6b3-59e1-3844-a8a0-4cbff791460c",
                        "glosses": [
                            "Empêchement à concourir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5828a31f-f915-4ada-847b-534194addad2",
                                "sense_id": "d6d449df-c144-3100-a7c3-891b343f8214",
                                "text": "« Je ne pense pas qu’une majorité d’Américains accepterait une disqualification basée sur un amendement écrit avec la guerre de Sécession à l’esprit », répond Timothy Naftali, professeur d’histoire spécialiste de la présidence à l’université de New York."
                            }
                        ]
                    },
                    {
                        "sense_id": "699e9e00-e544-3e21-97c8-f2596015b857",
                        "entry_id": "2f5da6b3-59e1-3844-a8a0-4cbff791460c",
                        "glosses": [
                            "Discrédit qui affecte une notion intellectuelle, une réalité sociale, une valeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49290cb6-9a6c-44c0-a1b3-9f1ef14acc9e",
                                "sense_id": "699e9e00-e544-3e21-97c8-f2596015b857",
                                "text": "La disqualification de certains diplômes."
                            },
                            {
                                "example_id": "d68e3b2e-e70b-4596-afee-effa1752142b",
                                "sense_id": "699e9e00-e544-3e21-97c8-f2596015b857",
                                "text": "La disqualification sociale : essai sur la nouvelle pauvreté."
                            },
                            {
                                "example_id": "380ee098-3a79-4879-b7b0-bcc55180aa5f",
                                "sense_id": "699e9e00-e544-3e21-97c8-f2596015b857",
                                "text": "L’opposition entre un soutien a priori affiché à la cause et une dénonciation de l’extrémisme supposé de ses manifestations concrètes, qui viendrait la desservir et même la dénaturer, est un double discours récurrent des stratégies de disqualification des revendications féministes. Idem pour les accusations d’« inquisition », de « lynchage », de « vengeance » et de « dictature », qu’on retrouve aussi bien dans les discours antiféministes mainstream que dans les discours masculinistes explicitement misogynes et violents de la droite extrême et des incels."
                            }
                        ]
                    }
                ],
