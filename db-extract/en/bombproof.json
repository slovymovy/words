                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2ef0109-6ef3-4328-8361-8be817231416",
                                "sense_id": "afe31475-3215-393c-97d7-1b3aa7ae6856",
                                "text": "As I waded through the mud to go down into the bombproof, it struck me uneasily that our officers glanced at each other."
                            },
                            {
                                "example_id": "d04763ae-6372-4da7-8e6e-3545a794030c",
                                "sense_id": "afe31475-3215-393c-97d7-1b3aa7ae6856",
                                "text": "At night, when the Federal guns slowed their fire, the men created new traverses and bombproofs."
                            },
                            {
                                "example_id": "47b81a90-6fc6-4b1c-98f6-3df8e606c887",
                                "sense_id": "afe31475-3215-393c-97d7-1b3aa7ae6856",
                                "text": "It mounted a 10-inch Columbiad and two 32-pounders on the sea face, with field guns and other 32-pounders elsewhere. In addition to this armament, it contained two bombproofs."
                            }
                        ]
                    }
