                        ],
                        "form": "die Stadträte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f122b053-8811-35f5-b38a-c0a2174f2ef1",
                        "entry_id": "3619998e-76ab-383b-a329-8ea92ffe9756",
                        "glosses": [
                            "Parlament einer Stadt; zur Gemeindevertretung in Städten berufenes Organ"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb493984-5a36-4e98-bc57-8a56b753bea9",
                                "sense_id": "f122b053-8811-35f5-b38a-c0a2174f2ef1",
                                "text": "Unser Stadtrat hat einige Projekte beschlossen, um Gebäude der Gemeinde zu renovieren."
                            },
                            {
                                "example_id": "5fcbbc93-4d92-469e-be7e-b17939998ff9",
                                "sense_id": "f122b053-8811-35f5-b38a-c0a2174f2ef1",
                                "text": "„Die neun Glückszahlen aber werden künftig montags im Stadtrat gezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8c6c8fbe-8e7a-3aa8-9a7d-0fd52c26f89f",
                        "entry_id": "3619998e-76ab-383b-a329-8ea92ffe9756",
                        "glosses": [
                            "Mitglied des Stadtrats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "496f30a0-0ac4-476d-b528-a132fcc23a90",
                                "sense_id": "8c6c8fbe-8e7a-3aa8-9a7d-0fd52c26f89f",
                                "text": "Korwisi ist weniger schick gekleidet als viele, die durch die Innenstadt flanieren. Früher war er Landesgeschäftsführer der Grünen und Joschka Fischers Referent, später Stadtrat in Bad Homburg."
                            },
                            {
                                "example_id": "a0e68e60-dd1f-44bc-838e-d9949fd529a3",
                                "sense_id": "8c6c8fbe-8e7a-3aa8-9a7d-0fd52c26f89f",
                                "text": "„Sie mochten sich noch so viel an den Beigeordneten, dann an den ersten Stadtrat wenden, eine Antwort aus Villers erhielten sie nie.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
