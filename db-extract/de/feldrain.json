                "senses": [
                    {
                        "sense_id": "0f6e99dd-11db-3ef8-b0b9-61424adabf33",
                        "entry_id": "f52954df-aed0-3ed5-a126-01352072b0d2",
                        "glosses": [
                            "unbebauter Randstreifen eines Feldes/zwischen Feldern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52446e55-53fd-4ff2-91d2-97ab8f33602f",
                                "sense_id": "0f6e99dd-11db-3ef8-b0b9-61424adabf33",
                                "text": "„Neben einem abgewrackten Bauernhof geht ein Bauer am Feldrain entlang.“"
                            },
                            {
                                "example_id": "2a233aef-d7ab-44dd-8839-a2413b73f960",
                                "sense_id": "0f6e99dd-11db-3ef8-b0b9-61424adabf33",
                                "text": "„Am Ende der Siedlung, am Feldrain beim Wald, lag Großvaters Garten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b2ae54a-851c-4c38-af94-4e54739b27f0",
                        "source_entry_id": "f52954df-aed0-3ed5-a126-01352072b0d2",
                        "source_sense_id": "0f6e99dd-11db-3ef8-b0b9-61424adabf33",
                        "source_sense_description": "unbebauter Randstreifen eines Feldes/zwischen Feldern",
                        "target_lang_word": "remízek",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remízek",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "626b914d-6df8-31d0-8ab4-c7c4fbc91c34",
                                        "entry_id": "84d8e024-9beb-38c6-b291-90ed5f5803c1",
                                        "glosses": [
                                            "zalesněná část pole; malý lesík nebo shluk stromů na velkých polích, sloužící jako úkryt pro zvěř"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e181d623-7fa2-4c9c-a648-29c299301e44",
                                                "sense_id": "626b914d-6df8-31d0-8ab4-c7c4fbc91c34",
                                                "text": "Spatřil jsem kometu, oblohou letěla, chtěl jsem jí zazpívat, ona mi zmizela, zmizela jako laň u lesa v remízku, v očích mi zbylo jen pár žlutých penízků."
                                            },
                                            {
                                                "example_id": "3c0f0488-1311-454d-aee4-58970a5e327b",
                                                "sense_id": "626b914d-6df8-31d0-8ab4-c7c4fbc91c34",
                                                "text": "Uprostřed řetězu lidí se rýsovalo husté křoví nebo lesík (byl to zaječí remízek), ale bylo tam tak ticho, tak docela ticho"
                                            },
                                            {
                                                "example_id": "9bcc115a-b29d-4b45-bcd0-8edd3b95aa7f",
                                                "sense_id": "626b914d-6df8-31d0-8ab4-c7c4fbc91c34",
                                                "text": "Tlusté, sukovité bandasky, na které jsme si odpůldne schválně zašli do remízku, ležely vedle nás na mezi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
