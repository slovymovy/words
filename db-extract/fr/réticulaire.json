                "forms": [
                    {
                        "form_id": "fa5f898d-9922-450d-9c53-b397a6a95e1b",
                        "entry_id": "9960a24d-a0b0-3990-9fee-ccc8620679e2",
                        "tags": [
                            "plural",
                            "masculine",
