                "senses": [
                    {
                        "sense_id": "826b783e-aab4-337c-b6a4-cced8c23b103",
                        "entry_id": "701d3861-7f8c-3696-9d28-745201d31b0f",
                        "glosses": [
                            "Mangel an Aktivität/Tätigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77ea9aef-6cc3-4db6-8aeb-8f60e6810082",
                                "sense_id": "826b783e-aab4-337c-b6a4-cced8c23b103",
                                "text": "„Dabei zeigte sich in ihrem Gehirn – unabhängig von der angezeigten Mimik – eine Unteraktivität des linken dorsolateralen präfrontalen Cortex (dlPFC), während der rechte überaktiv war.“"
                            },
                            {
                                "example_id": "0d84b9b4-d00e-4932-a887-bdfff9bb7ded",
                                "sense_id": "826b783e-aab4-337c-b6a4-cced8c23b103",
                                "text": "„Der Schulterschrittmacher wird bei funktioneller Schulterinstabilität eingesetzt und soll einer Unteraktivität der Rotatorenmanschette und der umliegenden Muskulatur entgegenwirken.“"
                            },
                            {
                                "example_id": "a5bb34b8-68ed-4558-b349-959e72e31396",
                                "sense_id": "826b783e-aab4-337c-b6a4-cced8c23b103",
                                "text": "„Eine Unteraktivität war viel einfacher in den Griff zu bekommen, als dies bei einer Überaktivität der Fall war.“"
                            },
                            {
                                "example_id": "65e7f3e1-f5d0-49f8-a74c-adc10374c2a8",
                                "sense_id": "826b783e-aab4-337c-b6a4-cced8c23b103",
                                "text": "„Wenn ein Tier eine Unteraktivität im Solarplexus hat, dann hat es einen geringen Selbstwert, fühlt sich ohnmächtig und ausgeliefert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
