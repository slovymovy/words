                                        "glosses": [
                                            "de persoon die de artistieke verantwoordelijkheid heeft voor het gehele productieproces van een film"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef11fbb7-94b8-4a7e-8d03-99b8fcffa86d",
                                                "sense_id": "fd4a62cb-4379-3506-8e9c-05e833420c70",
                                                "text": "Mike van Diem is de filmmaker van De surprise"
