                "senses": [
                    {
                        "sense_id": "53904e5b-e898-3cb4-a56c-a74d4a426e0e",
                        "entry_id": "eb9ff150-b0dc-3212-ad6e-a7a8e3414a0f",
                        "glosses": [
                            "persoon die zijn of haar bankrekening (meestal voor een vergoeding) ter beschikking stelt om geld wit te wassen"
                        ],
                        "tags": [
                            "misdaad"
                        ],
                        "examples": [
                            {
                                "example_id": "05e41496-5e8b-4240-804c-40e72221987b",
                                "sense_id": "53904e5b-e898-3cb4-a56c-a74d4a426e0e",
                                "text": "Een geldezel is iemand die zijn bankrekening beschikbaar stelt aan oplichters. Criminelen benaderen mensen op straat of via sociale media om soms voor slechts 10 euro een bankrekening te openen en de inloggegevens daarvan aan hen door te geven. Slachtoffers van internetoplichting storten vervolgens geld op die nieuwe rekening. Hiermee blijft de identiteit van de oplichter onzichtbaar en maakt de geldezel zich schuldig aan witwassen."
                            },
                            {
                                "example_id": "06f98748-8df5-48d2-a6ae-26c64dcb5687",
                                "sense_id": "53904e5b-e898-3cb4-a56c-a74d4a426e0e",
                                "text": "De zogenaamde ‘moneymule’ (geldezel) is eerder wel gezien in andere talen."
                            }
                        ]
                    },
                    {
                        "sense_id": "3040fe6e-0b2a-3c07-884e-dfd0ae310fd0",
                        "entry_id": "eb9ff150-b0dc-3212-ad6e-a7a8e3414a0f",
                        "glosses": [
                            "onuitputtelijke inkomstenbron die geen echte inspanning vraagt"
                        ],
                        "tags": [
                            "figuratively",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0f809376-86f4-47de-9a1e-f69386051372",
                                "sense_id": "3040fe6e-0b2a-3c07-884e-dfd0ae310fd0",
                                "text": "⧖ De naam is… brood! Platte klank, zult ge zeggen, maar die toch aantoont de zaak, wier afwezigheid uit zoo menig werkmansleven alle poëzie deed verdwijnen, de zaak, wier ontbering zoo menig genie deed bukken voor een geldezel, de zaak… maar ik zal niet treden in een beschrijving van de gevolgen der voor de menschheid zoo vreeselijke kwaal… broodsgebrek; de schrik van den mensch, die hem maakt tot slaaf, de vreeselijkste aller bestemmingen."
                            }
                        ]
                    }
