                "senses": [
                    {
                        "sense_id": "36e335ad-837f-3310-bfa2-b4227c359a4d",
                        "entry_id": "0716547f-fa14-3ff0-86c6-ca391e8f5fff",
                        "glosses": [
                            "Corps qui, sous l'action de la lumière, va créer une sensibilisation anormale au niveau de la peau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "580f2eff-1f85-4389-ad54-70e68daa4bc7",
                                "sense_id": "36e335ad-837f-3310-bfa2-b4227c359a4d",
                                "text": "De plus, les nanoparticules capables de cibler les tumeurs peuvent être fonctionnalisées avec un photosensibilisant pour réagir chimiquement sous l’action de la lumière, en générant des espèces réactives de l’oxygène, dommageables pour les cellules environnantes."
                            },
                            {
                                "example_id": "5be4d7dd-bc5c-45f1-bac4-463374b8e1e9",
                                "sense_id": "36e335ad-837f-3310-bfa2-b4227c359a4d",
                                "text": "Ce traitement médical vise, entre autres, à détruire des cellules cancéreuses à l’aide de photosensibilisants qui, déclenchés par la lumière, produisent une forme hautement réactive d'oxygène capable de tuer ces cellules cancéreuses."
                            }
                        ]
                    }
