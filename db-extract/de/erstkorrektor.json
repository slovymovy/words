                "senses": [
                    {
                        "sense_id": "b4634aa5-78f1-31b6-bcf8-91dd2a5e0aa4",
                        "entry_id": "86e1c26b-5940-3aa6-94cc-76da1ee300cb",
                        "glosses": [
                            "Person, die — neben dem Zweitkorrektor — für die Korrektur und Bewertung einer Prüfungsarbeit zuständig ist und in den meisten Fällen den Prüfling betreut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b36fda-eb68-4252-8c5d-7f0f054100ad",
                                "sense_id": "b4634aa5-78f1-31b6-bcf8-91dd2a5e0aa4",
                                "text": "„Weder die Namen von Prüfling und Erstkorrektor noch das Ergebnis des Erstkorrektors müssen vor dem Zweitkorrektor geheim gehalten werden.“"
                            },
                            {
                                "example_id": "9ba1b3b6-6a39-4623-98f7-144f695dc032",
                                "sense_id": "b4634aa5-78f1-31b6-bcf8-91dd2a5e0aa4",
                                "text": "„Die Diplomarbeit wird dann zunächst von einem Erstkorrektor korrigiert und benotet; das ist derjenige Lehrstuhl, der die Arbeit vergeben hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
