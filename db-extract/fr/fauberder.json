                ],
                "senses": [
                    {
                        "sense_id": "06ce2823-24a9-38c6-b0a6-1f01ca68c674",
                        "entry_id": "55025ec5-b9e2-3b09-bb6e-4713c905fa69",
                        "glosses": [
                            "Variante de fauberter."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "27b0c68a-062d-4621-aa0f-8f8e9ce1095a",
                                "sense_id": "06ce2823-24a9-38c6-b0a6-1f01ca68c674",
                                "text": "Pour remplir les ordres du capitaine, les novices se mirent à fauberder le pont encore tout marbré de sang."
                            },
                            {
                                "example_id": "2b951c69-f32e-4422-a479-55f2046deb14",
                                "sense_id": "06ce2823-24a9-38c6-b0a6-1f01ca68c674",
                                "text": "Chaque matin, l’on procède à la toilette du vaisseau, et, pleuvrait-il à verse, le pont n’en est pas moins lavé, inondé, épongé, fauberdé avec le même scrupule et la même minutie."
                            }
                        ]
                    },
                    {
                        "sense_id": "870d1315-39b5-31c3-9619-7c2b30655778",
                        "entry_id": "55025ec5-b9e2-3b09-bb6e-4713c905fa69",
                        "glosses": [
                            "Variante de fauberter.",
                            "Posséder sexuellement."
                        ],
                        "tags": [
                            "alt-of",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d64e865a-0b61-405d-bc92-a0068284244c",
                                "sense_id": "870d1315-39b5-31c3-9619-7c2b30655778",
                                "text": "Ce ruffian demandait s'il y avait dans la maison une fille de bonne volonté qui voulût se faire fauberder le gin-gin moyennant finances."
                            }
                        ]
                    }
