                "senses": [
                    {
                        "sense_id": "f69d02f0-7c79-35a6-9057-a0e0d3692d06",
                        "entry_id": "c96325bc-d579-3995-bcd5-4e21cc8527f1",
                        "glosses": [
                            "dasjenige Geschehnis, das jemandem während eines Krieges begegnet/widerfahren ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4876f81-e1d1-48e3-a799-65c929f4e595",
                                "sense_id": "f69d02f0-7c79-35a6-9057-a0e0d3692d06",
                                "text": "„In der Regel waren sie sich ihrer Kriegserlebnisse bewusst, und sie konnten gut einschätzen, ob sie und ihre Familie schwer oder leicht betroffen waren.“"
                            },
                            {
                                "example_id": "e4d3de42-361b-4eea-a96a-5b224e22a6f5",
                                "sense_id": "f69d02f0-7c79-35a6-9057-a0e0d3692d06",
                                "text": "„In Agnes' Familie wurde über die schrecklichen Kriegserlebnisse nur selten gesprochen.“"
                            },
                            {
                                "example_id": "33e32831-6d5d-41ec-a027-f13799b78600",
                                "sense_id": "f69d02f0-7c79-35a6-9057-a0e0d3692d06",
                                "text": "„Ebenso fehlen Berichte oder gar eine Veranschaulichung von traumatischen Kriegserlebnissen, von eigener Verstrickung in Kriegsgräuel oder Schuld.“"
                            },
                            {
                                "example_id": "519f17cb-92db-4023-a434-56f8719dcdd5",
                                "sense_id": "f69d02f0-7c79-35a6-9057-a0e0d3692d06",
                                "text": "„Mein Vater wusste, wie er aus seinen Kriegserlebnissen Kapital schlagen konnte: Er machte sofort ein Buch daraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
