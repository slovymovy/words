                                        "entry_id": "a9b01b88-4049-350c-909d-b606abaa4685",
                                        "glosses": [
                                            "A sovereign state which is a member of an international organisation or some kind of confederation of other such states."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "302ef3e4-5fc0-4046-a01a-786443ea1931",
                                                "sense_id": "dcac4687-0ef2-3d5f-b164-d4f66a0a7c80",
                                                "text": "Coordinate term: observer state"
                                            },
                                            {
                                                "example_id": "0eb6ff1e-6a15-4930-b2ea-b92adc6411a9",
                                                "sense_id": "dcac4687-0ef2-3d5f-b164-d4f66a0a7c80",
                                                "text": "As of 1st January 2007 the European Union will have 27 member states."
                                            }
