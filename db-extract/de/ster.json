                        "entry_id": "8b835cf4-3c0c-3d65-9163-a3618525261f",
                        "glosses": [
                            "ein Kubikmeter Holz inklusive der beim Stapeln entstehenden Zwischenräume"
                        ],
                        "tags": [
                            "Forstwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "13438df8-b4ae-4bb9-9f1a-cd9763f4f8a0",
                                "sense_id": "4f138b6f-03f5-3e9f-b04c-9eda385ff903",
                                "text": "Wir verheizen in einem Winter ungefähr drei Ster Holz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1da9f682-f710-4e9d-8a95-64a57b51439f",
                        "source_entry_id": "8b835cf4-3c0c-3d65-9163-a3618525261f",
                        "source_sense_id": "4f138b6f-03f5-3e9f-b04c-9eda385ff903",
                        "source_sense_description": "ein Kubikmeter Holz inklusive der beim Stapeln entstehenden Zwischenräume",
                        "target_lang_word": "stere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35be531c-a03a-319b-917f-db0996368415",
                                        "entry_id": "99ccbbd9-ac2c-3320-a1c9-49a0812ffa1e",
                                        "glosses": [
                                            "A measure of volume used e.g. for cut wood, equal to one cubic metre."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cc8bb14-a76a-49d1-b310-dc42d680032c",
                                                "sense_id": "35be531c-a03a-319b-917f-db0996368415",
                                                "text": "It will be observed, that in this system it is only necessary to remember the metre, are, litre, and stere, all the others having certain relations to these, being equal to them taken 10, 100, 1000, &c. times, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84921b24-9b53-4e03-835d-0bc06b95cdf5",
                        "source_entry_id": "8b835cf4-3c0c-3d65-9163-a3618525261f",
                        "source_sense_id": "4f138b6f-03f5-3e9f-b04c-9eda385ff903",
                        "source_sense_description": "ein Kubikmeter Holz inklusive der beim Stapeln entstehenden Zwischenräume",
                        "target_lang_word": "stère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22072767-0fd3-3b23-a2b5-d0ee48e10032",
                                        "entry_id": "0682787a-783e-30dc-9945-a03df9b61d68",
                                        "glosses": [
                                            "Unité de mesure égale au mètre cube et destinée particulièrement à mesurer le bois de feu ou la filière bois énergie et certains bois destinés à l’industrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1839077b-7a7d-4edb-baf6-21b3445e2922",
                                                "sense_id": "22072767-0fd3-3b23-a2b5-d0ee48e10032",
                                                "text": "Ici, le bois se compte par cordes, dont l'unité de mesure peut varier d'un canton à l'autre, une corde, aux Crozets, vaut quatre stères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d958e9c-d0b8-36d4-97de-a428e8ae493b",
                                        "entry_id": "0682787a-783e-30dc-9945-a03df9b61d68",
                                        "glosses": [
                                            "Le bois compris dans ce volume."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bd1b319-989f-4f09-9ee2-58196f22664d",
                                                "sense_id": "0d958e9c-d0b8-36d4-97de-a428e8ae493b",
                                                "text": "Et pour faire ce vaisseau, combien faut-il de bois ? Trois mille stères. C’est une forêt qui flotte."
                                            },
                                            {
                                                "example_id": "807e9c72-0fe1-43a5-bda6-755c029155f7",
                                                "sense_id": "0d958e9c-d0b8-36d4-97de-a428e8ae493b",
                                                "text": "La carbonisation se fait toujours sur place. Il existe différents procédés ; celui qui est suivi dans les Ardennes consiste à former, avec les charbonnettes, des meules qui contiennent environ 50 stères."
                                            },
                                            {
                                                "example_id": "f6b04151-2683-45ae-87ab-5263788ccf5c",
                                                "sense_id": "0d958e9c-d0b8-36d4-97de-a428e8ae493b",
                                                "text": "Des stères à brûler, des fagots de rondins, des bourrées de coupilles, des tas d'ételles et des « carottes » d'épicéas s'y empilent."
                                            },
                                            {
                                                "example_id": "4c9e4c3f-156b-4f1a-9aa6-d90410b60340",
                                                "sense_id": "0d958e9c-d0b8-36d4-97de-a428e8ae493b",
                                                "text": "— Ma pauvre dame, le bois, c’est comme le reste, on fait ce qu’on peut. Je vous ai mis six stères, et c’est bien parce que vous êtes des amis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
