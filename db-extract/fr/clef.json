        "fr-extract.jsonl": [
            {
                "entry_id": "7d40b955-06f2-3674-b9ec-2832108d7296",
                "word": "clef",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "92c3024a-302a-406a-b442-a0fb4d67046f",
                        "entry_id": "7d40b955-06f2-3674-b9ec-2832108d7296",
                        "tags": [
