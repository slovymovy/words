                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ancien français",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7871f4a2-8f32-3b15-8474-c3f41be2c410",
                                        "entry_id": "cabf64ca-4240-3e89-b403-8089f63d9894",
                                        "glosses": [
                                            "Ensemble des langues romanes parlées approximativement dans la moitié nord du territoire français actuel, entre le xᵉ et le xivᵉ siècle. Le code ISO 639-3 : fro."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16b6e854-a91e-4d2f-ba72-605f3e39c4b9",
                                                "sense_id": "7871f4a2-8f32-3b15-8474-c3f41be2c410",
                                                "text": "La période de l'ancien français est généralement située entre le XIᵉ siècle et la fin du XIIIᵉ siècle …. Vient ensuite la période du moyen français, qui est située généralement entre le début du XIVᵉ et la fin du XVᵉ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b44eb7d-b2be-44d2-8b90-2dec9118fbd3",
                        "source_entry_id": "e2293e56-fb8d-32d5-886b-45ccec3aa7fb",
                        "source_sense_id": "afd85a6f-605c-3ea9-9980-130eba994332",
