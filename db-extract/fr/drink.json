                "senses": [
                    {
                        "sense_id": "863156e8-8cf2-3bce-a372-9b648e2106e5",
                        "entry_id": "8cb7b3fc-a4fb-3e4a-b679-cacb1da3313c",
                        "glosses": [
                            "Cérémonie où l’on sert des boissons et souvent accompagné de zakouski."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "716878f4-ef2f-40c4-b4e3-2b0daa7c73f4",
                                "sense_id": "863156e8-8cf2-3bce-a372-9b648e2106e5",
                                "text": "Après la réunion, il y avait un drink."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cfce133-91af-3a65-abfa-2dedeb8a8844",
                        "entry_id": "8cb7b3fc-a4fb-3e4a-b679-cacb1da3313c",
                        "glosses": [
                            "Verre d’alcool ; boisson festive."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "a1c30ddb-e3d8-4a77-b144-00abc1046e41",
                                "sense_id": "5cfce133-91af-3a65-abfa-2dedeb8a8844",
                                "text": "Entrez, entrez, mes amis, fit-il avec rondeur. Un drink ?…"
                            },
                            {
                                "example_id": "2a72c4e9-b455-4d64-8ed4-215ca951e1f4",
                                "sense_id": "5cfce133-91af-3a65-abfa-2dedeb8a8844",
                                "text": "Le drink par excellence de la femme moderne qui se prend en main, fière de ce qu’elle a accompli, c’est le champagne."
                            },
                            {
                                "example_id": "3cc3313a-9870-4a99-a5e1-2705200ca157",
                                "sense_id": "5cfce133-91af-3a65-abfa-2dedeb8a8844",
                                "text": "Longtemps sans grand intérêt gustatif, les cocktails sans alcool se sont taillé une place de choix auprès des consommateurs. Car ces drinks, désormais élaborés à partir de distillats très aromatiques, n’ont plus rien à envier à leurs homologues alcoolisés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f320c706-d3bf-48f5-9daf-d82d37cd56cd",
                        "source_entry_id": "8cb7b3fc-a4fb-3e4a-b679-cacb1da3313c",
                        "source_sense_id": "5cfce133-91af-3a65-abfa-2dedeb8a8844",
                        "source_sense_description": "Verre d’alcool ; boisson festive.",
                        "target_lang_word": "Drink",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drink",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8db3fab1-7f8f-318e-afcf-4d651debe5f0",
                                        "entry_id": "68fee964-12c1-337f-9bda-975afc901d21",
                                        "glosses": [
                                            "meist alkoholhaltiges Getränk oder entsprechendes Mischgetränk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9967ca69-20dd-41e3-b4b5-5fa259d9241f",
                                                "sense_id": "8db3fab1-7f8f-318e-afcf-4d651debe5f0",
                                                "text": "„Angelini lud alle auf einen Drink in den Salon ein.“"
                                            },
                                            {
                                                "example_id": "6bacb261-ee18-4bea-a037-86714481835c",
                                                "sense_id": "8db3fab1-7f8f-318e-afcf-4d651debe5f0",
                                                "text": "„Aber mit ein paar Drinks wird es schon laufen.“"
                                            },
                                            {
                                                "example_id": "d564957b-f0cd-4da2-9be6-2a4b425fd052",
                                                "sense_id": "8db3fab1-7f8f-318e-afcf-4d651debe5f0",
                                                "text": "„Nach einem Drink am Lagerfeuer versammelten wir uns zum Abendessen auf der Veranda und setzten uns, ungefähr zehn an der Zahl, an einen langen Esstisch.“"
                                            },
                                            {
                                                "example_id": "282cde3c-5881-450d-931d-78f0e1f2929b",
                                                "sense_id": "8db3fab1-7f8f-318e-afcf-4d651debe5f0",
                                                "text": "„Sie hat schon ein paar Drinks gehabt, schlecht für ihre Leber natürlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
