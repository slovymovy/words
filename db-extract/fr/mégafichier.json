                "senses": [
                    {
                        "sense_id": "b6a19d8d-9d72-3c7c-936d-dc8d13fc188e",
                        "entry_id": "0ef6650d-749a-3d36-a142-38f488f4287a",
                        "glosses": [
                            "Fichier de très grande taille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "406f03ed-4dfc-48ee-8016-bb6a0146c808",
                                "sense_id": "b6a19d8d-9d72-3c7c-936d-dc8d13fc188e",
                                "text": "Le Parlement a adopté définitivement mardi, par un vote de l’Assemblée, une loi visant à lutter contre les usurpations d’identité en instaurant un mégafichier des données biométriques de tous les Français."
                            },
                            {
                                "example_id": "0eb1f6bd-cc66-4794-963d-b108b1045ca6",
                                "sense_id": "b6a19d8d-9d72-3c7c-936d-dc8d13fc188e",
                                "text": "Parmi les mesures qui portent le plus atteinte aux libertés, citons la Loi antiterroriste, le mégafichier sur les voyageurs, l’utilisation accrue de certificats de sécurité, l’introduction de documents biométriques, la collecte et le partage d’informations sur les individus, la surveillance des communications électroniques, la liste noire des voyageurs aériens."
                            },
                            {
                                "example_id": "8d28afd6-10a3-4bf2-be74-1ae93f969c8c",
                                "sense_id": "b6a19d8d-9d72-3c7c-936d-dc8d13fc188e",
                                "text": "Les informations provenant des déclarations de revenus et qui étaient versées au mégafichier ont été renvoyées à l’Agence des douanes et du revenu du Canada."
                            }
                        ]
                    }
