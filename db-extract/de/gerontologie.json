                "senses": [
                    {
                        "sense_id": "e16461ba-85b7-336d-a5e5-cf0a2dc97481",
                        "entry_id": "97556c51-0686-3b12-9c39-b365b5475d33",
                        "glosses": [
                            "interdisziplinäre Wissenschaft, Lehre von den Alterungsvorgängen des Menschen, von verschiedenen Phänomenen, die mit dem Altsein/Älterwerden zusammenhängen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35fb0783-4fee-4b48-9a7b-b3fa7fe37888",
                                "sense_id": "e16461ba-85b7-336d-a5e5-cf0a2dc97481",
                                "text": "„Als einzige Einrichtung in Deutschland bietet die Hochschule in Vechta (Niedersachsen) Gerontologie im Vollstudium an. 30 bis 60 Studenten pro Jahrgang studieren das Fach an der mit knapp 2800 Studenten ohnehin familiär anmutenden Hochschule.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "daa22222-68f2-497d-9a7b-b9b61810ffa9",
                        "source_entry_id": "97556c51-0686-3b12-9c39-b365b5475d33",
                        "source_sense_id": "e16461ba-85b7-336d-a5e5-cf0a2dc97481",
