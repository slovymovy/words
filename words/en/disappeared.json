{
    "word_family": [
        "disappear",
        "disappearance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "83e571b6-2e39-3a02-af35-e3c9dbe09aa3",
                    "sense_definition": "simple past and past participle of <w>disappear</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun <w>disappeared</w> behind the heavy clouds just before the storm started.",
                            "target_lang_translations": {
                                "ru": "Солнце <w>скрылось</w> за тяжелыми тучами как раз перед началом грозы.",
                                "de": "Die Sonne <w>verschwand</w> kurz vor Beginn des Sturms hinter den schweren Wolken."
                            }
                        },
                        {
                            "text": "My keys have <w>disappeared</w> from the table where I left them.",
                            "target_lang_translations": {
                                "ru": "Мои ключи <w>пропали</w> со стола, где я их оставил.",
                                "de": "Meine Schlüssel sind von dem Tisch <w>verschwunden</w>, auf dem ich sie liegen gelassen hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "vanished"
                    ],
                    "antonyms": [
                        "appeared"
                    ],
                    "common_phrases": [
                        "disappeared from view",
                        "suddenly disappeared",
                        "disappeared completely"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "прошедшее время и причастие прошедшего времени от глагола disappear (исчезать)",
                        "de": "Vergangenheitsform (Präteritum und Partizip Perfekt) von „disappear“ (verschwinden)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчез",
                                "target_lang_sense_clarification": "перестал быть видимым или существовать"
                            },
                            {
                                "target_lang_word": "пропал",
                                "target_lang_sense_clarification": "потерялся, отсутствует"
                            },
                            {
                                "target_lang_word": "скрылся",
                                "target_lang_sense_clarification": "спрятался из виду (например, за облаками)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verschwand",
                                "target_lang_sense_clarification": "Präteritum von verschwinden"
                            },
                            {
                                "target_lang_word": "verschwunden",
                                "target_lang_sense_clarification": "Partizip Perfekt von verschwinden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6e4c01c-bbf6-3039-8268-c0299c69af43",
                    "sense_definition": "Caused to go missing by someone, often for political reasons.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist wrote a report on the <w>disappeared</w> activists in the region.",
                            "target_lang_translations": {
                                "ru": "Журналист написал репортаж об <w>исчезнувших</w> активистах в этом регионе.",
                                "de": "Der Journalist schrieb einen Bericht über die <w>verschwundenen</w> Aktivisten in der Region."
                            }
                        },
                        {
                            "text": "Families of the <w>disappeared</w> victims gathered to demand justice.",
                            "target_lang_translations": {
                                "ru": "Семьи <w>пропавших без вести</w> жертв собрались, чтобы потребовать справедливости.",
                                "de": "Familien der <w>verschwundenen</w> Opfer versammelten sich, um Gerechtigkeit zu fordern."
                            }
                        }
                    ],
                    "synonyms": [
                        "missing"
                    ],
                    "common_phrases": [
                        "disappeared persons",
                        "disappeared children"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропавший, часто в результате насильственных действий или по политическим причинам.",
                        "de": "gewaltsam oder aus politischen Gründen zum Verschwinden gebracht"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчезнувший",
                                "target_lang_sense_clarification": "о людях или группах людей"
                            },
                            {
                                "target_lang_word": "пропавший без вести",
                                "target_lang_sense_clarification": "официальный статус"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verschwunden",
                                "target_lang_sense_clarification": "oft durch staatliche oder gewaltsame Einwirkung"
                            },
                            {
                                "target_lang_word": "verschleppt",
                                "target_lang_sense_clarification": "gewaltsam entführt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "160d5dcb-6cba-34b9-9015-e8ec00aa95c9",
                    "sense_definition": "A person who has been secretly imprisoned or killed, typically by a government or political regime.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monument was built to honor the memory of the <w>disappeared</w>.",
                            "target_lang_translations": {
                                "ru": "Памятник был построен, чтобы почтить память <w>пропавших без вести</w>.",
                                "de": "Das Denkmal wurde errichtet, um das Andenken an die <w>Verschwundenen</w> zu ehren."
                            }
                        },
                        {
                            "text": "She spent years searching for her brother, who became one of the <w>disappeared</w> during the war.",
                            "target_lang_translations": {
                                "ru": "Она потратила годы на поиски брата, который стал одним из <w>пропавших без вести</w> во время войны.",
                                "de": "Sie verbrachte Jahre mit der Suche nach ihrem Bruder, der während des Krieges zu einem der <w>Verschwundenen</w> wurde."
                            }
                        }
                    ],
                    "synonyms": [
                        "desaparecido"
                    ],
                    "common_phrases": [
                        "families of the disappeared"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который был тайно заключен в тюрьму или убит, обычно правительством или политическим режимом.",
                        "de": "eine Person, die heimlich inhaftiert oder getötet wurde (oft durch staatliche Gewalt)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропавший без вести",
                                "target_lang_sense_clarification": "как существительное, жертва режима"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "der/die Verschwundene",
                                "target_lang_sense_clarification": "Opfer von erzwungenem Verschwindenlassen (Desaparecido)"
                            },
                            {
                                "target_lang_word": "der/die Verschleppte",
                                "target_lang_sense_clarification": "gewaltsam entführte Person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}