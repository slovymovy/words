                "senses": [
                    {
                        "sense_id": "3e875c21-f8f3-3b4a-8547-1d1f07776541",
                        "entry_id": "910356ad-b47e-3069-90e1-10dfbff6b54a",
                        "glosses": [
                            "Instrument der direkten Demokratie zur Einbringung eines Gesetzesvorschlags in das Parlament"
                        ],
                        "tags": [
                            "in Deutschland und Österreich"
                        ],
                        "examples": [
                            {
                                "example_id": "2aa0a0a5-1256-420d-a665-8f527ff5562d",
                                "sense_id": "3e875c21-f8f3-3b4a-8547-1d1f07776541",
                                "text": "Rechtsgültige Volksbegehren sind von der Volksvertretung binnen drei Monaten nach Unterbreitung zu behandeln und binnen weiterer drei Monate dem Volk zur Entscheidung vorzulegen."
                            },
                            {
                                "example_id": "8b41fc55-bc64-4519-84ba-961565ca93ff",
                                "sense_id": "3e875c21-f8f3-3b4a-8547-1d1f07776541",
                                "text": "Deutschland würde reformfähiger, wenn Teile der Bevölkerung ihre Fragen durch Volksbegehren besser an die gesamte Gesellschaft herantragen könnten."
                            },
                            {
                                "example_id": "c2676e28-dd6d-4357-9fc6-280ac68f28fd",
                                "sense_id": "3e875c21-f8f3-3b4a-8547-1d1f07776541",
                                "text": "[Berlin:] „Ziel des Volksbegehrens ist es, gewinnorientierte Immobilienkonzerne zu enteignen, die mehr als 3000 Wohnungen in ihrem Bestand haben.“"
                            },
                            {
                                "example_id": "a375bbb1-60cd-47ae-b23e-d95d04bc3776",
                                "sense_id": "3e875c21-f8f3-3b4a-8547-1d1f07776541",
                                "text": "„Das von der KPD erwirkte Volksbegehren hatte dieses Thema popularisiert und das politische Klima vergiftet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
