{
    "word_family": [
        "missing",
        "missable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3adc4ed-f91c-364c-a6a8-7498413422b6",
                    "sense_definition": "To fail to hit, catch, or reach something aimed at.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker kicked the ball but <w>missed</w> the goal.",
                            "target_lang_translations": {
                                "ru": "Нападающий ударил по мячу, но <w>промахнулся</w> мимо ворот.",
                                "pl": "Napastnik kopnął piłkę, ale <w>nie trafił</w> w bramkę."
                            }
                        },
                        {
                            "text": "I threw the keys to him, but he <w>missed</w> them and they fell on the floor.",
                            "target_lang_translations": {
                                "ru": "Я бросил ему ключи, но он <w>не поймал</w> их, и они упали на пол.",
                                "pl": "Rzuciłem mu klucze, ale ich <w>nie złapał</w> i upadły na podłogę."
                            }
                        }
                    ],
                    "antonyms": [
                        "hit",
                        "catch",
                        "strike"
                    ],
                    "common_phrases": [
                        "miss the target",
                        "swing and miss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не попасть в цель или не поймать что-либо.",
                        "pl": "Nie trafić w coś, nie złapać lub nie dosięgnąć celu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промахнуться",
                                "target_lang_sense_clarification": "не попасть в цель"
                            },
                            {
                                "target_lang_word": "не попасть",
                                "target_lang_sense_clarification": "не достичь цели"
                            },
                            {
                                "target_lang_word": "промазать",
                                "target_lang_sense_clarification": "разговорное: промахнуться"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "chybić",
                                "target_lang_sense_clarification": "nie trafić w cel"
                            },
                            {
                                "target_lang_word": "spudłować",
                                "target_lang_sense_clarification": "nie trafić rzucając lub strzelając"
                            },
                            {
                                "target_lang_word": "nie złapać",
                                "target_lang_sense_clarification": "nie pochwycić czegoś w locie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd09a54a-a610-3252-b4cd-86199f6d617d",
                    "sense_definition": "To feel sad or regretful because a person, place, or thing is not present.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>miss</w> my parents when I am away at university.",
                            "target_lang_translations": {
                                "ru": "Я <w>скучаю</w> по родителям, когда я в университете.",
                                "pl": "<w>Tęsknię</w> za rodzicami, kiedy jestem na uniwersytecie."
                            }
                        },
                        {
                            "text": "She says she will <w>miss</w> living in this house when they move.",
                            "target_lang_translations": {
                                "ru": "Она говорит, что будет <w>скучать</w> по жизни в этом доме, когда они переедут.",
                                "pl": "Mówi, że będzie jej <w>brakować</w> mieszkania w tym domu, kiedy się przeprowadzą."
                            }
                        }
                    ],
                    "common_phrases": [
                        "miss you",
                        "miss home"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать грусть из-за отсутствия кого-либо или чего-либо.",
                        "pl": "Odczuwać smutek lub żal z powodu nieobecności osoby, miejsca lub rzeczy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скучать",
                                "target_lang_sense_clarification": "испытывать тоску по кому-либо"
                            },
                            {
                                "target_lang_word": "тосковать",
                                "target_lang_sense_clarification": "сильно скучать, горевать"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "tęsknić",
                                "target_lang_sense_clarification": "odczuwać brak kogoś lub czegoś"
                            },
                            {
                                "target_lang_word": "brakować",
                                "target_lang_sense_clarification": "odczuwać brak kogoś (np. brakuje mi ciebie)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3eb132b-39bd-323e-87eb-c1dacd503bf6",
                    "sense_definition": "To arrive too late to catch a vehicle or attend an event.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "timing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If we do not leave now, we will <w>miss</w> the train.",
                            "target_lang_translations": {
                                "ru": "Если мы не выйдем сейчас, мы <w>опоздаем</w> на поезд.",
                                "pl": "Jeśli teraz nie wyjdziemy, <w>spóźnimy się</w> na pociąg."
                            }
                        },
                        {
                            "text": "He woke up late and <w>missed</w> his flight to London.",
                            "target_lang_translations": {
                                "ru": "Он проснулся поздно и <w>опоздал</w> на свой рейс в Лондон.",
                                "pl": "Obudził się późno i <w>nie zdążył</w> na lot do Londynu."
                            }
                        }
                    ],
                    "antonyms": [
                        "catch"
                    ],
                    "common_phrases": [
                        "miss the bus",
                        "miss the train",
                        "miss the deadline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опоздать на транспортное средство или мероприятие.",
                        "pl": "Przybyć zbyt późno, aby zdążyć na środek transportu lub wydarzenie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опоздать",
                                "target_lang_sense_clarification": "прийти слишком поздно"
                            },
                            {
                                "target_lang_word": "пропустить",
                                "target_lang_sense_clarification": "не успеть на транспорт"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "spóźnić się",
                                "target_lang_sense_clarification": "nie zdążyć na pociąg, autobus itp."
                            },
                            {
                                "target_lang_word": "uciec",
                                "target_lang_sense_clarification": "o transporcie: odjechać przed naszym przybyciem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d9fc5e2-785f-39bd-ae6e-d9c8319eb04f",
                    "sense_definition": "To fail to be present at an event or fail to experience something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attendance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>missed</w> the meeting this morning because I was stuck in traffic.",
                            "target_lang_translations": {
                                "ru": "Я <w>пропустил</w> утреннее собрание, потому что застрял в пробке.",
                                "pl": "<w>Opuściłem</w> poranne spotkanie, bo utknąłem w korku."
                            }
                        },
                        {
                            "text": "You should not <w>miss</w> the chance to visit the museum while you are here.",
                            "target_lang_translations": {
                                "ru": "Тебе не следует <w>упускать</w> возможность посетить музей, пока ты здесь.",
                                "pl": "Nie powinieneś <w>przegapić</w> okazji do odwiedzenia muzeum, póki tu jesteś."
                            }
                        }
                    ],
                    "synonyms": [
                        "skip"
                    ],
                    "common_phrases": [
                        "miss a meeting",
                        "miss school",
                        "miss out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не присутствовать на мероприятии или упустить возможность испытать что-либо.",
                        "pl": "Nie być obecnym na wydarzeniu lub nie skorzystać z okazji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропустить",
                                "target_lang_sense_clarification": "не посетить мероприятие"
                            },
                            {
                                "target_lang_word": "упустить",
                                "target_lang_sense_clarification": "потерять возможность"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przegapić",
                                "target_lang_sense_clarification": "nie skorzystać z okazji"
                            },
                            {
                                "target_lang_word": "opuścić",
                                "target_lang_sense_clarification": "nie pojawić się na zajęciach lub spotkaniu"
                            },
                            {
                                "target_lang_word": "stracić",
                                "target_lang_sense_clarification": "nie doświadczyć czegoś ciekawego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d215ce5-d8a7-37db-a51d-486fb0e7fa1b",
                    "sense_definition": "To fail to notice, hear, or understand something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I think you <w>missed</w> the joke completely.",
                            "target_lang_translations": {
                                "ru": "Думаю, ты совершенно <w>не понял</w> шутку.",
                                "pl": "Myślę, że zupełnie <w>nie zrozumiałeś</w> tego żartu."
                            }
                        },
                        {
                            "text": "He read the report but <w>missed</w> the most important detail.",
                            "target_lang_translations": {
                                "ru": "Он прочитал отчет, но <w>упустил</w> самую важную деталь.",
                                "pl": "Przeczytał raport, ale <w>przeoczył</w> najważniejszy szczegół."
                            }
                        }
                    ],
                    "synonyms": [
                        "overlook"
                    ],
                    "common_phrases": [
                        "miss the point",
                        "miss a spot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не заметить, не услышать или не понять что-либо.",
                        "pl": "Nie zauważyć, nie usłyszeć lub nie zrozumieć czegoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропустить",
                                "target_lang_sense_clarification": "не заметить или не услышать"
                            },
                            {
                                "target_lang_word": "не понять",
                                "target_lang_sense_clarification": "не уловить смысл"
                            },
                            {
                                "target_lang_word": "упустить",
                                "target_lang_sense_clarification": "не обратить внимания на деталь"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przeoczyć",
                                "target_lang_sense_clarification": "nie zauważyć czegoś"
                            },
                            {
                                "target_lang_word": "nie zrozumieć",
                                "target_lang_sense_clarification": "nie pojąć sensu, np. żartu"
                            },
                            {
                                "target_lang_word": "umknąć",
                                "target_lang_sense_clarification": "o szczególe: zostać niezauważonym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "107157c0-5caf-3e88-be18-acffec82659e",
                    "sense_definition": "To manage to avoid hitting or colliding with something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The falling rock just <w>missed</w> his head.",
                            "target_lang_translations": {
                                "ru": "Падающий камень едва <w>не задел</w> его голову.",
                                "pl": "Spadający kamień o włos <w>ominął</w> jego głowę."
                            }
                        },
                        {
                            "text": "The car skidded on the ice and narrowly <w>missed</w> the fence.",
                            "target_lang_translations": {
                                "ru": "Машина заскользила по льду и едва <w>не задела</w> забор.",
                                "pl": "Samochód wpadł w poślizg na lodzie i ledwo <w>ominął</w> płot."
                            }
                        }
                    ],
                    "synonyms": [
                        "avoid"
                    ],
                    "antonyms": [
                        "hit",
                        "collide with"
                    ],
                    "common_phrases": [
                        "just miss",
                        "barely miss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Избежать столкновения или удара.",
                        "pl": "Zdołać uniknąć uderzenia lub zderzenia z czymś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не задеть",
                                "target_lang_sense_clarification": "пройти мимо, не коснувшись"
                            },
                            {
                                "target_lang_word": "избежать",
                                "target_lang_sense_clarification": "уклониться от удара"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ominąć",
                                "target_lang_sense_clarification": "przejść obok bez uderzenia"
                            },
                            {
                                "target_lang_word": "nie trafić",
                                "target_lang_sense_clarification": "o przedmiocie: nie uderzyć w kogoś"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a470a6ff-ad4f-3bf1-b68b-27e0486d4b2f",
                    "sense_definition": "A title of respect used before the surname of an unmarried woman or girl.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "title",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "Please sit down, <w>Miss</w> Johnson.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, садитесь, <w>мисс</w> Джонсон.",
                                "pl": "Proszę usiąść, <w>panno</w> Johnson."
                            }
                        },
                        {
                            "text": "<w>Miss</w> Taylor is our new geography teacher.",
                            "target_lang_translations": {
                                "ru": "<w>Мисс</w> Тейлор — наша новая учительница географии.",
                                "pl": "<w>Pani</w> Taylor jest naszą nową nauczycielką geografii."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "title"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливое обращение к незамужней женщине (обычно перед фамилией).",
                        "pl": "Tytuł grzecznościowy używany przed nazwiskiem niezamężnej kobiety lub dziewczyny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мисс",
                                "target_lang_sense_clarification": "обращение к девушке в англоязычных странах"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "panna",
                                "target_lang_sense_clarification": "tytuł dla niezamężnej kobiety (dziś rzadszy)"
                            },
                            {
                                "target_lang_word": "pani",
                                "target_lang_sense_clarification": "współczesny uniwersalny tytuł grzecznościowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4138a1f6-ee20-34b2-96d3-19a6e2770821",
                    "sense_definition": "A polite term of address for a female teacher, shop assistant, or waitress.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "address",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "Excuse me, <w>Miss</w>, I have a question about the homework.",
                            "target_lang_translations": {
                                "ru": "Извините, <w>мисс</w>, у меня вопрос по домашнему заданию.",
                                "pl": "Przepraszam <w>panią</w>, mam pytanie dotyczące pracy domowej."
                            }
                        },
                        {
                            "text": "The students all like <w>Miss</w> because she is very kind.",
                            "target_lang_translations": {
                                "ru": "Все ученики любят <w>мисс</w>, потому что она очень добрая.",
                                "pl": "Wszyscy uczniowie lubią <w>panią</w>, ponieważ jest bardzo miła."
                            }
                        }
                    ],
                    "common_phrases": [
                        "excuse me Miss"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used by students or customers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливое обращение к учительнице, продавщице или официантке.",
                        "pl": "Grzecznościowy zwrot do nauczycielki, ekspedientki lub kelnerki."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мисс",
                                "target_lang_sense_clarification": "вежливое обращение"
                            },
                            {
                                "target_lang_word": "девушка",
                                "target_lang_sense_clarification": "распространенное обращение в России"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "proszę pani",
                                "target_lang_sense_clarification": "standardowy zwrot grzecznościowy"
                            },
                            {
                                "target_lang_word": "pani",
                                "target_lang_sense_clarification": "używane przez uczniów do nauczycielki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63b68c84-f8f4-30e8-893f-d30e9d4381aa",
                    "sense_definition": "A failure to hit a target or achieve a goal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After five <w>misses</w>, he finally scored a point.",
                            "target_lang_translations": {
                                "ru": "После пяти <w>промахов</w> он наконец заработал очко.",
                                "pl": "Po pięciu <w>pudłach</w> w końcu zdobył punkt."
                            }
                        },
                        {
                            "text": "The new product was a <w>miss</w> and did not sell well.",
                            "target_lang_translations": {
                                "ru": "Новый продукт оказался <w>неудачей</w> и плохо продавался.",
                                "pl": "Nowy produkt okazał się <w>klapą</w> i nie sprzedawał się dobrze."
                            }
                        }
                    ],
                    "synonyms": [
                        "failure"
                    ],
                    "antonyms": [
                        "hit"
                    ],
                    "common_phrases": [
                        "near miss",
                        "hit or miss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непопадание в цель или неудача.",
                        "pl": "Niepowodzenie w trafieniu do celu lub osiągnięciu zamierzenia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промах",
                                "target_lang_sense_clarification": "непопадание"
                            },
                            {
                                "target_lang_word": "неудача",
                                "target_lang_sense_clarification": "отсутствие успеха"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pudło",
                                "target_lang_sense_clarification": "chybiony strzał lub rzut"
                            },
                            {
                                "target_lang_word": "niepowodzenie",
                                "target_lang_sense_clarification": "brak sukcesu"
                            },
                            {
                                "target_lang_word": "chybienie",
                                "target_lang_sense_clarification": "akt nietrafienia w cel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "675b86db-b8bd-3d65-bdf4-297856dd5878",
                    "sense_definition": "A title given to the winner of a beauty contest.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "title",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "She dreams of becoming <w>Miss</w> France one day.",
                            "target_lang_translations": {
                                "ru": "Она мечтает однажды стать <w>Мисс</w> Франция.",
                                "pl": "Marzy, by pewnego dnia zostać <w>Miss</w> Francji."
                            }
                        },
                        {
                            "text": "The new <w>Miss</w> World was crowned yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера короновали новую <w>Мисс</w> Мира.",
                                "pl": "Wczoraj ukoronowano nową <w>Miss</w> Świata."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Miss Universe",
                        "Miss World"
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул победительницы конкурса красоты.",
                        "pl": "Tytuł nadawany zwyciężczyni konkursu piękności."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мисс",
                                "target_lang_sense_clarification": "титул королевы красоты"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "miss",
                                "target_lang_sense_clarification": "tytuł najpiękniejszej kobiety"
                            }
                        ]
                    }
                },
