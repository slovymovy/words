                                "example_id": "995fa6e5-4355-4c0e-b804-77941a0c080b",
                                "sense_id": "5ca650f1-8fb1-3c87-9738-8fd73690b346",
                                "text": "Ceux qui poursuivaient les voleurs les poussèrent dans un accul où on les prit."
                            }
                        ]
