                        "examples": [
                            {
                                "example_id": "d5e0df46-f0d5-499b-b9a5-dc6fd0b2ad2e",
                                "sense_id": "784e93a5-f701-3ba5-be6c-4756fdaba16d",
                                "text": "„Man musste daher annehmen, dass, wenn man sich, auch den Weg in den Sund hinein bis an die Rosamel-Insel erzwingen konnte, das Eis von dort an, golfeinwärts, unbewegbar dicht lag.“"
