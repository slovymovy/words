                "senses": [
                    {
                        "sense_id": "117eb123-95e6-327e-af28-6a8bdbcc672e",
                        "entry_id": "995207fe-86f0-389e-9b7d-38ea65309705",
                        "glosses": [
                            "Alternative form of Socratize."
                        ],
                        "tags": [
