                    {
                        "sense_id": "6fa23c7c-7095-3cf5-b39c-933bc223f6d8",
                        "entry_id": "e6e80531-8731-364b-9604-24021b888652",
                        "glosses": [
                            "Unternehmen, das Erdöl fördert, mit Erdöl handelt"
