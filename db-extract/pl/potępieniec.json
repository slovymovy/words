                                "example_id": "00641327-0235-4224-badf-6ce08051b6d9",
                                "sense_id": "25900d3e-82dd-3308-8636-e07de8a3fce1",
                                "text": "Zauważyła na moim palcu złotą obrączkę, unikalną wśród nas potępieńców"
                            },
                            {
                                "example_id": "6fd63fd9-50ec-4de8-91d2-dc385054cfa7",
                                "sense_id": "25900d3e-82dd-3308-8636-e07de8a3fce1",
                                "text": "Cierpiałem jak potępieniec w siódmym kręgu piekła. Cierpiałem i nie rozumiałem, dlaczego tak bardzo cierpię"
                            }
                        ],
