                    {
                        "translation_id": "74f2633d-b494-4fd5-a378-6aba420192c4",
                        "source_entry_id": "6e263fbd-a85f-377d-a8c0-37e7aace2368",
                        "source_sense_id": "2d31f71c-6d48-3169-a030-91418533bb1a",
