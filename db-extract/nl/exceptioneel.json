                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "107d23c7-6f5a-4a82-bc76-215d3ce26fa7",
                                "sense_id": "e6645467-a034-3d01-90bf-d7a7b0d66038",
                                "text": "In het begin van het jaar werd een zangeres in de tienerleeftijd die Carola heette van de ene dag op de andere een superster toen ze het Nationale Songfestival won. Het was een doorbraak die exceptioneel veel aandacht trok. Vanzelfsprekend werd ze daarmee ook een van de vaste gespreksonderwerpen van het land. Dat was ook zo onder de strafpleiters, deze jonge Carola was werkelijk onweerstaanbaar."
                            }
                        ]
                    }
                ],
