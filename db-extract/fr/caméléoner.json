                "senses": [
                    {
                        "sense_id": "2104b9bd-5eae-3592-94e4-4d4cea57819e",
                        "entry_id": "55f33597-aa18-3acb-bd50-c4821eb57899",
                        "glosses": [
                            "Se comporter comme un caméléon, par mimétisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4056f12-5615-4486-a1b3-dc9d9468fb99",
                                "sense_id": "2104b9bd-5eae-3592-94e4-4d4cea57819e",
                                "text": "Ce serait peut-être plus difficile de « caméléoner » dans un village du nord du Pakistan ou dans des territoires aborigènes du Queensland en Australie."
                            },
                            {
                                "example_id": "e0bc0ecd-18e9-4371-aa8d-b98a7d5f6fe0",
                                "sense_id": "2104b9bd-5eae-3592-94e4-4d4cea57819e",
                                "text": "Je me caméléonerai à loisir, pour répondre au mieux aux exigences de la situation."
                            }
                        ]
                    },
                    {
                        "sense_id": "a27c5947-189e-3db5-b0ce-31ca30c779db",
                        "entry_id": "55f33597-aa18-3acb-bd50-c4821eb57899",
                        "glosses": [
                            "Imiter comme un caméléon."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "e866f852-b6e1-4377-92a8-23aaac1a6db6",
                                "sense_id": "a27c5947-189e-3db5-b0ce-31ca30c779db",
                                "text": "Mon but n’est pas d'apprendre à caméléoner l'Européen."
                            }
                        ]
                    }
