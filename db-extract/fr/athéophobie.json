                                        "glosses": [
                                            "Fear or hatred of atheism or atheists."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec988214-742c-4788-bc58-a95fb1910a5b",
                                                "sense_id": "dd42b7ab-14d4-3c98-bad6-2f647a87df06",
                                                "text": "At many institutions, I have found atheophobia to be rampant among students; and religiophobia to be common among faculty."
                                            },
                                            {
                                                "example_id": "34e282bf-21ae-494a-b5eb-f03a19fcf9db",
                                                "sense_id": "dd42b7ab-14d4-3c98-bad6-2f647a87df06",
                                                "text": "Atheophobia leads to invisibility for many atheists, who find it is best to keep their nonbelief hidden for their own good."
                                            },
                                            {
                                                "example_id": "3d0f5336-3c86-4d7a-91df-69c0fe24bfbc",
                                                "sense_id": "dd42b7ab-14d4-3c98-bad6-2f647a87df06",
                                                "text": "Atheophobia should be just as unacceptable as homophobia, anti-Semitism, or racism."
                                            }
                                        ]
