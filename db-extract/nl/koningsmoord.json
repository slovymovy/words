                                        "sense_id": "c79c6ad8-3684-3955-9e96-15e91d34cb4c",
                                        "entry_id": "cf70b3db-2835-3d48-a49a-d041ad804033",
                                        "glosses": [
                                            "Juge qui condamne un roi à mort."
                                        ],
