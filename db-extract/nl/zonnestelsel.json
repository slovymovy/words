                        ],
                        "form": "zonnestelseltjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d49ad1bf-5b49-35f0-8d25-649f09ff1c84",
                        "entry_id": "67d88ef7-6ded-3031-84a8-c902148863a9",
                        "glosses": [
                            "het stelsel dat bestaat uit onze zon en alle planeten die eromheen draaien; bij uitbreiding ook dergelijke stelsels om andere sterren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a88d9106-d5f2-4b2c-bb93-9f05564c603b",
                                "sense_id": "d49ad1bf-5b49-35f0-8d25-649f09ff1c84",
                                "text": "De planeet Jupiter is de grootste planeet van het zonnestelsel."
                            },
                            {
                                "example_id": "322a3aa0-0351-4245-8e1f-01568cd1a04b",
                                "sense_id": "d49ad1bf-5b49-35f0-8d25-649f09ff1c84",
                                "text": "Ze legde de vruchten een voor een met een sierlijk gebaar op het gehavende hout, waar ze als planeten lagen te gloeien, een zonnestelsel waarin zij tijdelijk de zon werd."
                            },
                            {
                                "example_id": "846d3941-9eaa-44bd-ae9e-7f122d987bfc",
                                "sense_id": "d49ad1bf-5b49-35f0-8d25-649f09ff1c84",
                                "text": "Overigens is er in het zonnestelsel wel een ander merkwaardig object gevonden dat de aanduiding 1983TB heeft gekregen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c36e332-b7f8-4eaf-a0df-e2dd48f29a30",
                        "source_entry_id": "67d88ef7-6ded-3031-84a8-c902148863a9",
                        "source_sense_id": "d49ad1bf-5b49-35f0-8d25-649f09ff1c84",
                        "target_lang_word": "Sonnensystem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnensystem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36c19d94-161e-3796-bbf7-f553d2c096e9",
                                        "entry_id": "d1e43830-d17c-37a8-a40f-dcb9f6905647",
                                        "glosses": [
                                            "ein Stern mit umlaufenden Himmelskörpern"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b592e0c6-7915-4438-bc95-704913329fe6",
                                                "sense_id": "36c19d94-161e-3796-bbf7-f553d2c096e9",
                                                "text": "Wie viele Sonnensysteme gibt es im Universum?"
                                            },
                                            {
                                                "example_id": "42f9cd43-9b81-4f90-a517-46f2edc8af66",
                                                "sense_id": "36c19d94-161e-3796-bbf7-f553d2c096e9",
                                                "text": "„Früher hatte man jedes Atom für ein Sonnensystem im kleinen gehalten, das aus einem Kern bestand, der von kreisenden Elektronen umgeben war und die Sphärenharmonie in mikroskopischem Maßstab widerspiegelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "92f3185a-5e76-3895-8933-0611124b1ab0",
                                        "entry_id": "d1e43830-d17c-37a8-a40f-dcb9f6905647",
                                        "glosses": [
                                            "das Sonnensystem^([1]), in dem sich die Erde befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "187a3645-9ca8-4847-a037-f7fef33d1e3e",
                                                "sense_id": "92f3185a-5e76-3895-8933-0611124b1ab0",
                                                "text": "Das Sonnensystem umfasst acht Planeten."
                                            },
                                            {
                                                "example_id": "4521ca4b-1a78-441c-a2af-810778012ca7",
                                                "sense_id": "92f3185a-5e76-3895-8933-0611124b1ab0",
                                                "text": "„Mochte sie im neuen Weltbild ihren Platz im Zentrum des Sonnensystems verloren haben, ihren alten Stellenwert in der Mitte der Schöpfung behielt sie auch für Kepler.“"
                                            },
                                            {
                                                "example_id": "c76236b9-8cf4-462c-95ac-4a49618999a3",
                                                "sense_id": "92f3185a-5e76-3895-8933-0611124b1ab0",
                                                "text": "„Sie treibt das Sonnensystem an und die Galaxien, sie umspannt wahrscheinlich den ganzen Kosmos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c8f3567-995a-4ee4-84fc-52edb30e81a8",
                        "source_entry_id": "67d88ef7-6ded-3031-84a8-c902148863a9",
                        "source_sense_id": "d49ad1bf-5b49-35f0-8d25-649f09ff1c84",
                        "target_lang_word": "solar system",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solar system",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0006d21-b0ec-319c-a84f-337ccb4037a6",
                                        "entry_id": "51231a28-ce6a-3b1a-9893-a061a7120be5",
                                        "glosses": [
                                            "Alternative letter-case form of Solar System; the Sun and all the objects in orbit around it."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "solar system",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "082bd690-5a71-36b0-b27a-30a0ef1c4cbe",
                                        "entry_id": "1cf3647b-67dc-32d8-8315-03e38719c439",
                                        "glosses": [
                                            "Any orbital system of at least one fusor and other heavenly bodies, like planets and other objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b118f026-f738-48cf-913b-defd4c06bdfc",
                                                "sense_id": "082bd690-5a71-36b0-b27a-30a0ef1c4cbe",
                                                "text": "The history of our study of our solar system shows us clearly that accepted and conventional ideas are often wrong, and that fundamental insights can arise from the most unexpected sources."
                                            },
                                            {
                                                "example_id": "ac89d335-546b-4cc4-8613-408fd5c28370",
                                                "sense_id": "082bd690-5a71-36b0-b27a-30a0ef1c4cbe",
                                                "text": "1992, J. Laskar, page 31 in, Sylvio Ferraz-Mello (editor), \"Chaos, resonance, and collective dynamical phenomena in the solar system\", International Astronomical Union Symposium,\nI would like to stress out that the meaning of unstable for our solar system is very different than for another solar system."
                                            },
                                            {
                                                "example_id": "97d469f8-85cc-4a49-881f-6104e32aa902",
                                                "sense_id": "082bd690-5a71-36b0-b27a-30a0ef1c4cbe",
                                                "text": "Every satellite has turned out to differ in some significant feature from its neighbor: \"[…]the sense of novelty would probably not have been greater if we had explored a different solar system\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "360f210d-a2bb-3f63-a1e4-270d11d5c115",
                                        "entry_id": "1cf3647b-67dc-32d8-8315-03e38719c439",
                                        "glosses": [
                                            "Ellipsis of solar power system (“electric power system that supplies usable solar power by means of photovoltaics”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63d6bdb6-ea8d-4b20-9ba6-d8a913b1d4bd",
                                                "sense_id": "360f210d-a2bb-3f63-a1e4-270d11d5c115",
                                                "text": "Almost half of all U.S. households are unable to host a rooftop solar system because they rent or have inadequate roof space."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd395eb0-632a-49e6-a5ba-bf5d72f35493",
                        "source_entry_id": "67d88ef7-6ded-3031-84a8-c902148863a9",
                        "source_sense_id": "d49ad1bf-5b49-35f0-8d25-649f09ff1c84",
                        "target_lang_word": "système solaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "système solaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b65beeb-882a-35b1-8e40-8f8e6e604f44",
                                        "entry_id": "a4bec915-b458-3942-9a4d-e8b707ffca37",
                                        "glosses": [
                                            "Variante orthographique de Système solaire."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "786976a2-9e81-411f-96cb-f1c416dd6fc9",
                                                "sense_id": "1b65beeb-882a-35b1-8e40-8f8e6e604f44",
                                                "text": "L’Union astronomique internationale (UAI) a, le 24 août dernier, modifié le statut de Pluton. Jusqu’alors considérée comme la neuvième planète du système solaire, Pluton est désormais définie comme une « planète naine »."
                                            },
                                            {
                                                "example_id": "7cc96a49-0a5b-4e0d-b6f8-42af89844e15",
                                                "sense_id": "1b65beeb-882a-35b1-8e40-8f8e6e604f44",
                                                "text": "Voyager 1 est le premier objet réalisé par l’homme à avoir quitté le Système solaire [magnétique]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "188b18c7-6ba3-3b9a-87fa-38f0ddef835b",
                                        "entry_id": "a4bec915-b458-3942-9a4d-e8b707ffca37",
                                        "glosses": [
                                            "Ensemble de corps célestes et de planètes gravitant dans la sphère d’influence d’une ou plusieurs étoiles."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "976b413a-5d8c-4eb0-b827-739be039a7b0",
                                                "sense_id": "188b18c7-6ba3-3b9a-87fa-38f0ddef835b",
                                                "text": "La Nasa ^([sic : NASA]) observe la destruction d’un système solaire par une «étoile de la mort»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
