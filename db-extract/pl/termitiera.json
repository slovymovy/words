                                    {
                                        "sense_id": "f50488c4-a2d5-3326-adce-998d211174dc",
                                        "entry_id": "8fe7e2d1-875a-3c26-bc53-f5978bce19c7",
                                        "glosses": [
                                            "A white-bodied, wood-consuming insect of the infraorder Isoptera, in the order Blattodea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3556ccf7-4a28-4a2b-8baf-555562a93ef8",
                                                "sense_id": "f50488c4-a2d5-3326-adce-998d211174dc",
                                                "text": "Linnæus describes this insect under the Latin name of Termes; and citizen Cuvier speaks of it under that of Termites. The vulgar call it by that of white ant, or fourmi vaguevague. The termites divide themselves into societies: each society builds itself a next, and each nest belongs to an innumerable quantity of these insects, who acknowledge for their chiefs a king and a queen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba128a90-bac2-3106-9242-38e6c76b5007",
                                        "entry_id": "8fe7e2d1-875a-3c26-bc53-f5978bce19c7",
                                        "glosses": [
                                            "A contemptible person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5763b380-f0d0-4cff-93c6-ccabc2fa569d",
                                                "sense_id": "ba128a90-bac2-3106-9242-38e6c76b5007",
                                                "text": "This two faced termite has the nerve to talk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "termite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca90e939-6527-3bcb-a768-1c8da9b9db4f",
                                        "entry_id": "859ec334-31ff-39b6-9003-3bd10a7e21af",
                                        "glosses": [
                                            "Of a chimpanzee: to catch termites by inserting a stick or vine into their nest and waiting for them to climb up it."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
