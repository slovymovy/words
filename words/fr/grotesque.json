                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les restaurateurs ont mis au jour de magnifiques <w>grotesques</w> sous le plâtre de la galerie."
                        },
                        {
                            "text": "Raphaël s'inspira des <w>grotesques</w> de la Maison dorée pour décorer les loges du Vatican."
                        }
