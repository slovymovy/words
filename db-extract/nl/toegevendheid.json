                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d7dec18-9446-3796-a572-a837b3f5bd28",
                        "entry_id": "31556920-8733-3c72-bb5c-66c89131f7fa",
                        "glosses": [
                            "de mate waarin men meegaand is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbfb03fb-0fda-45ca-820a-b19d0554d8d3",
                                "sense_id": "5d7dec18-9446-3796-a572-a837b3f5bd28",
                                "text": "Toen de koningin vernam dat ze haar echtgenoot had verlaten en met Mountjoy was gaan samenwonen, was ze er wel toe bereid Mountjoys afwijking van het conventionele gedrag te aanvaarden, want hij was een knappe jongeman, maar paste ze dezelfde toegevendheid niet toe op Penelope, hoewel ze haar uit genegenheid voor Mountjoy niet verbood aan het hof te komen."
                            },
                            {
                                "example_id": "7150b7f2-4929-4f31-ac51-712c6ba63c1f",
                                "sense_id": "5d7dec18-9446-3796-a572-a837b3f5bd28",
                                "text": "Volgens Egyptische bronnen is een oplossing nabij, al wordt van Israël meer toegevendheid verwacht."
                            }
                        ]
                    }
                ],
