                    },
                    {
                        "form_id": "7a0d3e10-450e-462d-b19a-baadf34ca323",
                        "entry_id": "4c18ec79-ae39-3afe-b770-9d1eccb81a42",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Kurier"
                    },
                    {
                        "form_id": "d32840a6-9c46-46ac-86b2-67c53ec6084a",
                        "entry_id": "4c18ec79-ae39-3afe-b770-9d1eccb81a42",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kuriere"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "799e4c72-bd06-3e51-a412-e13835ccbd55",
                        "entry_id": "4c18ec79-ae39-3afe-b770-9d1eccb81a42",
                        "glosses": [
                            "jemand, der im dienstlichen Auftrag vertrauliche Nachrichten überbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8db2f20d-15e0-42bc-9668-4c60aa7aff31",
                                "sense_id": "799e4c72-bd06-3e51-a412-e13835ccbd55",
                                "text": "„Anders als der Bote ist der Kurier per Definition kein bezahlter Nachrichtenüberbringer, sondern im staatlichen beziehungsweise behördlichen Eilauftrag unterwegs.“"
                            },
                            {
                                "example_id": "e855fc6d-d092-4ee1-8e39-79afa906fba4",
                                "sense_id": "799e4c72-bd06-3e51-a412-e13835ccbd55",
                                "text": "„Vor dem Tor standen, etwa zehn Schritt vom Fürsten Andrej entfernt, zwei Offiziersburschen, ein Kurier und ein Haushofmeister, welche die Abwesenheit des Fürsten und das schöne Wetter genossen.“"
                            },
                            {
                                "example_id": "633aca62-d78b-43d1-8aa7-c2b34b78d10e",
                                "sense_id": "799e4c72-bd06-3e51-a412-e13835ccbd55",
                                "text": "„In Brüssel angekommen, stieg der amerikanische Kurier, der in Wirklichkeit Deutscher war und Thomas Lieven hieß, im »Hôtel Royal« ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fc898546-30e7-3b32-afa0-f5bb86e82597",
                        "entry_id": "4c18ec79-ae39-3afe-b770-9d1eccb81a42",
                        "glosses": [
                            "jemand, der gegen Bezahlung Post/Waren direkt/schnell befördert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee700c71-aefa-488c-b4c9-1b04e06011b3",
                                "sense_id": "fc898546-30e7-3b32-afa0-f5bb86e82597",
                                "text": "Wir können Ihnen die Druckfahnen auch per Kurier schicken, dann haben Sie sie in einer Stunde auf dem Tisch."
                            },
                            {
                                "example_id": "6244c57a-676b-4cef-9538-cb7c920855a2",
                                "sense_id": "fc898546-30e7-3b32-afa0-f5bb86e82597",
                                "text": "„Auch auf Bildern von russischen Kurieren sieht man die Pferde in einer fabelhaften Jagd und die Peitsche des Kutschers trotzdem noch bis in die Wolken geschwungen.“"
                            },
                            {
                                "example_id": "eb505f08-6785-4505-b0b4-a303ce2b05df",
                                "sense_id": "fc898546-30e7-3b32-afa0-f5bb86e82597",
                                "text": "„Ich habe Dietrich per Kurier einen Colour-Gameboy ins Krankenhaus geschickt.“"
                            },
                            {
                                "example_id": "fcbe272f-5ca3-464c-8bcf-f62bda07f37a",
                                "sense_id": "fc898546-30e7-3b32-afa0-f5bb86e82597",
                                "text": "„Leonhard war zu diesem Zeitpunkt nur wenig älter als der Kaiser bei seiner Wahl 1519, den damals die Nachricht vom Wahlsieg in Brüssel erreicht hatte, überbracht von einem Kurier der Familie Taxis.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "366cdf13-ab5c-4851-b5ce-f3200a024e89",
                        "source_entry_id": "4c18ec79-ae39-3afe-b770-9d1eccb81a42",
