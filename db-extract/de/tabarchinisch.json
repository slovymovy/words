                "senses": [
                    {
                        "sense_id": "135d3500-ac6b-3c77-bb6e-12fcfdf52acf",
                        "entry_id": "96869a87-6d51-3abd-a5e2-a95076b6a43c",
                        "glosses": [
                            "ligurischer Dialekt auf den im Süden Sardiniens gelegenen Inseln San Pietro und Sant’Antioco"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89c37816-ed42-480d-90fa-8cae32a2d578",
                                "sense_id": "135d3500-ac6b-3c77-bb6e-12fcfdf52acf",
                                "text": "„Zum anderen ist Tabarchinisch, ein ligurischer Dialekt, auf den im Süden gelegenen Inseln San Pietro und Sant'Antioco zu finden, dessen Verbreitung auf piemontesische Ansiedlungen im 18. Jahrhundert zurückgeht (vgl. Rindler Schjerve 2003:795f.).“"
                            },
                            {
                                "example_id": "06badcc5-f410-4567-a988-b375e7a8df7b",
                                "sense_id": "135d3500-ac6b-3c77-bb6e-12fcfdf52acf",
                                "text": "„Nach Rindler Schjerve (1987) bezeichnet der Begriff „Sardisch“ die Gesamtheit der auf der Insel gesprochenen Dialekte mit Ausnahme des Katalanischen in Alghero und des Tabarchinischen auf S. Antioco und S. Pietro.“"
                            },
                            {
                                "example_id": "55abc525-d8a9-4656-86c3-95fbf88fba33",
                                "sense_id": "135d3500-ac6b-3c77-bb6e-12fcfdf52acf",
                                "text": "„Dabei spielt nicht nur das Monegassische selbst eine Rolle, sondern auch weitere eng verwandte Sprachen und Varietäten (Ligurisch, Tabarchinisch, Okzitanisch etc.).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
