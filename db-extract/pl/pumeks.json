                    {
                        "translation_id": "cf31c4e8-16a2-457c-8dae-9951543d66bc",
                        "source_entry_id": "90e9ce72-95c8-349f-80ca-a5d2c80def4b",
                        "source_sense_id": "7040caa1-2440-39eb-9606-cace2cffbd21",
                        "target_lang_word": "Bimsstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bimsstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81fe9943-46e8-3121-bc43-cd11bd74797e",
                                        "entry_id": "5dedbfe2-bc93-3115-8471-0c3da1641f0c",
                                        "glosses": [
                                            "hellgraues vulkanisches Gestein von einer schaumig-porösen, glasartigen Konsistenz"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b41caa-6738-4ed6-8ff8-6d9edbb1ff8b",
                                                "sense_id": "81fe9943-46e8-3121-bc43-cd11bd74797e",
                                                "text": "Bimsstein ist vulkanischen Ursprungs."
                                            },
                                            {
                                                "example_id": "92d0585a-dfff-45da-b36a-e5905c9e3f58",
                                                "sense_id": "81fe9943-46e8-3121-bc43-cd11bd74797e",
                                                "text": "„Die Kobolde boten ihnen Nahrung von ihrem Schiff an: harte, trockene Scheiben, die aussahen wie Bimssteine, und fettiges Fleisch, das so salzig war, dass selbst die Krieger das Gesicht verzogen.“"
                                            },
                                            {
                                                "example_id": "86c20ae2-bc7f-4eda-aa86-58d881ce45da",
                                                "sense_id": "81fe9943-46e8-3121-bc43-cd11bd74797e",
                                                "text": "„Der Boden war von plutonischen Kräften geformt, auf Schritt und Tritt traf man auf Basaltbrocken, Bimsstein, erratische Blöcke und Obsidiane.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "817cfd54-599f-3649-b00c-c6e734153351",
                                        "entry_id": "5dedbfe2-bc93-3115-8471-0c3da1641f0c",
                                        "glosses": [
                                            "ein aus dem unter [1] beschriebenen Gestein hergestellter Stein beziehungsweise Baustein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b0351d1-723b-4961-a8c2-9617d8d46e95",
                                                "sense_id": "817cfd54-599f-3649-b00c-c6e734153351",
                                                "text": "„Bimssteine sind ein Baustoff mit sehr guter Dämmung.“"
                                            },
                                            {
                                                "example_id": "b04dfca2-e8bb-4e1b-8179-9c8523a10fc5",
                                                "sense_id": "817cfd54-599f-3649-b00c-c6e734153351",
                                                "text": "Bimssteine weisen gute Wärmeisolierungseigenschaften auf."
                                            },
                                            {
                                                "example_id": "04e168dc-d4d1-4ec8-8d69-218124a756c5",
                                                "sense_id": "817cfd54-599f-3649-b00c-c6e734153351",
                                                "text": "„Der daraus gefertigte Bimsstein ist wegen seiner wärmedämmenden Fähigkeit und seines geringen Gewichts ein gefragter Baustoff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "ff1e3ac1-7ba1-399c-acfe-ce984761afdc",
                                        "entry_id": "5dedbfe2-bc93-3115-8471-0c3da1641f0c",
                                        "glosses": [
                                            "ein Stück des unter [1] beschriebenen Gesteins, das zur Reinigung besonders der Hände aber auch zum Schleifen und Polieren benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce0fa0f5-a254-4055-b1b3-5643edfe8ad2",
                                                "sense_id": "ff1e3ac1-7ba1-399c-acfe-ce984761afdc",
                                                "text": "Auf dem Waschbeckenrand lagen neben der Seife Nagelbürste und Bimsstein."
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    }
                                ]
                            }
                        ]
