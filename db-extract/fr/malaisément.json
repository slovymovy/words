        "fr-extract.jsonl": [
            {
                "entry_id": "8096735f-b351-34fd-96e9-e6f9b0d216fb",
                "word": "malaisément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "52769e1d-2259-380f-a8e6-4def3dd90217",
                        "entry_id": "8096735f-b351-34fd-96e9-e6f9b0d216fb",
                        "glosses": [
                            "D’une manière malaisée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c5afaca-5ce0-4763-922d-5ff51a3dc9bd",
                                "sense_id": "52769e1d-2259-380f-a8e6-4def3dd90217",
                                "text": "Le temps s’était gâté tout à fait, et les dirigeables, gênés par la nécessité de tenir tête au vent, manœuvraient malaisément."
                            },
                            {
                                "example_id": "c9d15247-e49a-4205-9f03-64d4d9fcd2a6",
                                "sense_id": "52769e1d-2259-380f-a8e6-4def3dd90217",
                                "text": "Il y entre [dans la tragédie] des batailles, des prises de villes, de grands périls, des révolutions d’États, et tout cela va malaisément avec la promptitude que la règle nous oblige de donner à ce qui se passe sur la scène."
                            },
                            {
                                "example_id": "bcc35717-4b26-4210-b8b6-eb74849b66f4",
                                "sense_id": "52769e1d-2259-380f-a8e6-4def3dd90217",
                                "text": "Assez malaisément on sort de mon empire."
                            },
                            {
                                "example_id": "2fef6df5-9097-47f9-ba66-79e0515ad095",
                                "sense_id": "52769e1d-2259-380f-a8e6-4def3dd90217",
                                "text": "Ah ! qu’un front et qu’une âme à la tristesse en proie Feignent malaisément et le rire et la joie !"
                            },
                            {
                                "example_id": "c873b6b5-8682-46db-9b58-dde7d95dc662",
                                "sense_id": "52769e1d-2259-380f-a8e6-4def3dd90217",
                                "text": "Les rois malaisément souffrent qu’on leur résiste."
                            },
                            {
                                "example_id": "156b4b6b-8a7c-4d88-be89-423455023c82",
                                "sense_id": "52769e1d-2259-380f-a8e6-4def3dd90217",
                                "text": "La lumière viendrait d’une vieille lampe de bureau, malaisément orientable, garnie d’un abat-jour d’opaline verte en forme de visière."
                            },
                            {
                                "example_id": "429cd03c-0419-4f8c-920b-abed4258e7ae",
                                "sense_id": "52769e1d-2259-380f-a8e6-4def3dd90217",
                                "text": "On imagine malaisément comment un ensemble aussi grand et aussi finement structuré de facteurs aurait pu se trouver identiquement réalisé en plusieurs biotopes dispersés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da0509b1-7d9e-465e-b3e1-5587f488319f",
                        "source_entry_id": "8096735f-b351-34fd-96e9-e6f9b0d216fb",
                        "source_sense_id": "52769e1d-2259-380f-a8e6-4def3dd90217",
                        "target_lang_word": "uneasily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uneasily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "111151ae-8f1f-33a7-be95-013f37d9dc56",
                                        "entry_id": "97c0112a-7546-35b8-a6c6-b53d84422f62",
                                        "glosses": [
                                            "In an uneasy manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d02cfd9a-0d93-459a-8f0a-5f91207982ab",
                                                "sense_id": "111151ae-8f1f-33a7-be95-013f37d9dc56",
                                                "text": "On once more we swung, bumping uneasily along in the antique narrow-gauge coach, with gloomy woods and gathering night outside, shouts and songs (and quacks) inside—this was not at all the sort of train ordained by the logical strategists in Paris—then grinding to a stop at a mysterious halt which was no more than a nameboard in the pinewoods, without even a footpath leading to it, but nevertheless with a solitary passenger stolidly waiting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
