                                    {
                                        "sense_id": "82b817a6-5bfd-3614-8504-fab116605f21",
                                        "entry_id": "54a14b06-8875-3c0b-aa49-7806d02608de",
                                        "glosses": [
                                            "vom Besonderen oder Gegenständlichen losgelöst; verallgemeinert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b01f0f7f-c771-4f16-afba-af5bafda8b96",
                                                "sense_id": "82b817a6-5bfd-3614-8504-fab116605f21",
                                                "text": "Es gibt abstrakte und konkrete Begriffe."
                                            },
                                            {
                                                "example_id": "5c348457-42b3-4e25-9666-60297250a14e",
                                                "sense_id": "82b817a6-5bfd-3614-8504-fab116605f21",
                                                "text": "Das ist zu abstrakt gedacht! Da hast du doch alle Gefühle außer Acht gelassen, in der Ehe der beiden herrschen nur noch Neid und Eifersucht!"
                                            },
                                            {
                                                "example_id": "3eaf3b80-8fe0-4490-88b4-f5e496361304",
                                                "sense_id": "82b817a6-5bfd-3614-8504-fab116605f21",
                                                "text": "Diese Formulierung ist zu abstrakt! Das kann sich keiner bildhaft vorstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7729d367-43a7-36de-9c0d-7a7b81ac9b20",
                                        "entry_id": "54a14b06-8875-3c0b-aa49-7806d02608de",
                                        "glosses": [
                                            "seinen Rechtsgrund nicht in sich tragend (mit der Folge, dass die Wirksamkeit durch einen fehlenden Rechtsgrund nicht beeinflusst wird)"
                                        ],
                                        "tags": [
                                            "Rechtssprache",
                                            "besonders in Bezug auf Rechtsgeschäfte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a843d5c-b09f-4177-af31-d8b6036f5722",
                                                "sense_id": "7729d367-43a7-36de-9c0d-7a7b81ac9b20",
                                                "text": "Schuldrechtliche Rechtsgeschäfte sind nur selten abstrakt ausgestaltet."
                                            },
                                            {
                                                "example_id": "679f2a3a-1427-4956-8423-3c820f83030d",
                                                "sense_id": "7729d367-43a7-36de-9c0d-7a7b81ac9b20",
                                                "text": "Die Übereignung ist ein abstraktes Rechtsgeschäft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9dc8c513-87ab-3b3a-bf83-7f23c97fb0b2",
                                        "entry_id": "54a14b06-8875-3c0b-aa49-7806d02608de",
                                        "glosses": [
                                            "nicht-objektiv, nicht figurativ, nicht gegenständlich, keine erkennbaren Objekte oder Szenen darstellend"
                                        ],
