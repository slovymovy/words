                "senses": [
                    {
                        "sense_id": "efcac988-dcc4-3b1e-8de9-aba02fca81c6",
                        "entry_id": "b656ae0a-632d-3309-937c-03f86ec04c9b",
                        "glosses": [
                            "lustige Bemerkung, die nur Eingeweihte als solche verstehen können; Witz, der ein bestimmtes Grundwissen voraussetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0658b285-17c0-4d06-84fa-3e056cb7951a",
                                "sense_id": "efcac988-dcc4-3b1e-8de9-aba02fca81c6",
                                "text": "Da alle außer mir anfingen zu lachen, bin ich davon ausgegangen, dass es sich wohl um einen Insiderwitz handelte und habe einfach mitgelacht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d56445b8-39bb-4360-bb76-53571e9aac8e",
                        "source_entry_id": "b656ae0a-632d-3309-937c-03f86ec04c9b",
                        "source_sense_id": "efcac988-dcc4-3b1e-8de9-aba02fca81c6",
                        "target_lang_word": "inside joke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inside joke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39a9fdb2-f136-360a-b60a-148e2cc9c6fd",
                                        "entry_id": "e94bc2ff-0129-3d97-888d-5d9e9abb933a",
                                        "glosses": [
                                            "A joke that is understood or meant to be understood only by certain people who are aware of the details (an ingroup)."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ab1c0a4-20a1-4673-a493-a20d02ce5197",
                                                "sense_id": "39a9fdb2-f136-360a-b60a-148e2cc9c6fd",
                                                "text": "After the incident with the potato peeler, references to potatoes became an inside joke among the witnesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "151465cb-8ef7-4a2b-964b-f04c07d45711",
                        "source_entry_id": "b656ae0a-632d-3309-937c-03f86ec04c9b",
                        "source_sense_id": "efcac988-dcc4-3b1e-8de9-aba02fca81c6",
                        "target_lang_word": "in-joke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in-joke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8652d30e-93b3-3b37-a9b8-dde572c9dc39",
                                        "entry_id": "846a9e0d-d41a-3d9d-b370-6f4acae7a8a7",
                                        "glosses": [
                                            "Synonym of inside joke (“a joke that is understood or meant to be understood only by certain people who are aware of the details”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe0c16f-3921-4b94-bee7-69e4e8bfd839",
                                                "sense_id": "8652d30e-93b3-3b37-a9b8-dde572c9dc39",
                                                "text": "Well, it’s a bit of an in-joke, but Fred has been going to start that diet “tomorrow” for the last few months."
                                            },
                                            {
                                                "example_id": "c2ee663f-6cfa-4095-901d-37b3d249b1f6",
                                                "sense_id": "8652d30e-93b3-3b37-a9b8-dde572c9dc39",
                                                "text": "We have an in-joke; whenever someone sings a wrong note, they wipe the mistake off their music with an obvious gesture."
                                            },
                                            {
                                                "example_id": "a0b82af2-ac64-43d5-9d92-36a295e4d612",
                                                "sense_id": "8652d30e-93b3-3b37-a9b8-dde572c9dc39",
                                                "text": "Perhaps these quotations arose from some in-joke of Yule’s, but whatever the case the lexicographical worth of these citations is dubious."
                                            },
                                            {
                                                "example_id": "f260a124-f33a-4ccd-bc44-e711ffbca04c",
                                                "sense_id": "8652d30e-93b3-3b37-a9b8-dde572c9dc39",
                                                "text": "Intentionally or not, the movie [Ralph Breaks the Internet] makes Disney feel as enormous as the internet itself, containing a series of micro-targeted idiosyncrasies and in-jokes that are nonetheless controlled by a cultural monolith (whether that's Disney or whatever massive corporation owns your local ISP)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "148c3119-6c04-49cb-9c6e-169ff58ba8ed",
                        "source_entry_id": "b656ae0a-632d-3309-937c-03f86ec04c9b",
