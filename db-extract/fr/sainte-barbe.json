                        "entry_id": "0172a0d8-316f-36d7-bef3-b8de29cfae18",
                        "glosses": [
                            "Partie du vaisseau où l’on serrait les ustensiles d’artillerie et la poudre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f74925ee-63b4-44c0-9fd2-b6ef72082d7b",
                                "sense_id": "6f34c190-5a02-3301-97b3-fe81f5079e49",
                                "text": "Le feu prit à la sainte-barbe."
                            },
                            {
                                "example_id": "ef22f3dc-65db-49cb-9aaa-63dd694419b2",
                                "sense_id": "6f34c190-5a02-3301-97b3-fe81f5079e49",
                                "text": "Je n’appartiens plus à mon père ; je me cache dans la sainte-barbe, je me fourre dans la gueule d’un canon, et quand on s’aperçoit de ma disparition, je suis en pleine mer."
                            },
                            {
                                "example_id": "d8d54493-3041-4ea6-9e7a-b8f161ee387a",
                                "sense_id": "6f34c190-5a02-3301-97b3-fe81f5079e49",
                                "text": "Peu de munitions et une sainte-barbe trempée par les pluies."
                            }
                        ]
                    }
