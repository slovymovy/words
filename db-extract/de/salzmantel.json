                "senses": [
                    {
                        "sense_id": "09aaf6c5-f41e-3b4e-ab6b-91c86861ba99",
                        "entry_id": "45c6e6b9-a8bd-3494-bc5f-870fe008b946",
                        "glosses": [
                            "aus grobem Salz, Wasser und Eiweiß hergestellte Masse, mit der Nahrungsmittel (vor allem ganze Fische und Geflügel) umhüllt werden, bevor sie im Backofen gegart werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5e88de4-aa61-42a1-923a-4438da2c172f",
                                "sense_id": "09aaf6c5-f41e-3b4e-ab6b-91c86861ba99",
                                "text": "„Was auf den Tisch kommt, ist von einer Frische, die den Duft der frischen Pfifferlinge auf hausgemachter Pasta oder den von Wolfsbarsch im Salzmantel allein zum Erlebnis werden lässt.“"
                            },
                            {
                                "example_id": "7c959748-ffa4-40d3-9da2-1e63b1b2f57a",
                                "sense_id": "09aaf6c5-f41e-3b4e-ab6b-91c86861ba99",
                                "text": "„Neben seinem raffinierten Fischfondue und anderen Fischspezialitäten brät er neuerdings eine Ente im Salzmantel. Sie ist ein Wunder an Zartheit und saftig wie ein reifer Pfirsich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
