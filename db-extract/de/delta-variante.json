                "senses": [
                    {
                        "sense_id": "ebbfd59f-9c47-3c7c-9f2e-acc3a5489f9c",
                        "entry_id": "d20da8ba-7c6d-3489-9c0c-ce80268311bc",
                        "glosses": [
                            "Art/Form (Variante), die das/der Coronavirus SARS-CoV-2 angenommen hat; ›neue, neutrale‹ Bezeichnung der indischen Variante"
                        ],
                        "tags": [
                            "Virologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ea1037e3-c36a-447c-9523-14488d16bde0",
                                "sense_id": "ebbfd59f-9c47-3c7c-9f2e-acc3a5489f9c",
                                "text": "„Das geplante Ende aller Maßnahmen in England am 21. Juni sei \"ein bisschen früh\". Das sagte der britische Mikrobiologe Ravi Gupta dem Sender \"Sky News\" mit Blick auf die Ausbreitung der zunächst in Indien entdeckten Delta-Variante des Coronavirus.“"
                            },
                            {
                                "example_id": "cfe13a38-19cc-4246-84f1-8c5b598cb265",
                                "sense_id": "ebbfd59f-9c47-3c7c-9f2e-acc3a5489f9c",
                                "text": "„Das Problem: Sie ist ansteckender als das \"normale\" Virus, sie verbreitet sich schneller und ist unempfindlicher gegenüber Antikörpern. Bedeutet: Möglicherweise schützen die vorhandenen Impfstoffe nicht so gut gegen die Delta-Variante.“"
                            },
                            {
                                "example_id": "4d5411a4-c01f-4f08-8010-460ab8c48ce1",
                                "sense_id": "ebbfd59f-9c47-3c7c-9f2e-acc3a5489f9c",
                                "text": "[Frank Ulrich Montgomery, Vorsitzende des Weltärztebundes:] „»Wer sich nicht impfen lässt, wird sich früher oder später mit dem Coronavirus infizieren«, ergänzte er mit Blick auf die deutlich ansteckendere Delta-Variante.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
