                                        "sense_id": "5150cbb1-2ba5-3d52-81d6-3c52b243c964",
                                        "entry_id": "e64305d1-3393-328f-8128-577fce92d56a",
                                        "glosses": [
                                            "linguagem falada e/ou escrita de uma população qualquer, com estrutura e regras próprias que lhe dão um caráter peculiar e diferenciado das outras"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef9b13cb-b93d-4db5-af4f-76c1467c5160",
                                                "sense_id": "5150cbb1-2ba5-3d52-81d6-3c52b243c964",
                                                "text": "Falar outro idioma, que não o português, dificulta um pouco a viagem."
                                            }
