                                                "sense_id": "8868a702-874d-3f67-8fdf-b8abbaa0f2b1",
                                                "text": "After just one night in the jungle I was covered with mosquito bites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49cf1991-7900-3c8c-af62-8286c274b515",
                                        "entry_id": "8129178a-5527-3ec0-823a-c8cf68548a6e",
