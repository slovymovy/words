                "senses": [
                    {
                        "sense_id": "c9354482-57af-301c-96bb-aabc87a8348c",
                        "entry_id": "132621a0-eac5-31ae-863b-284770c62b97",
                        "glosses": [
                            "Faire perdre son caractère brahmanique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae45f93-e5b9-4d14-80d3-a975f37ced8f",
                                "sense_id": "c9354482-57af-301c-96bb-aabc87a8348c",
                                "text": "Leur travail, qui a consisté à «débrahmaniser» les codes hindous, était donc relativement aisé."
                            },
                            {
                                "example_id": "20ff340f-ce34-480f-8c2f-c8ea5b96eb23",
                                "sense_id": "c9354482-57af-301c-96bb-aabc87a8348c",
                                "text": "Celui de l’hindouisme est débrahmanisé ; car que signifie brahmanisme, au propre, sinon ce qui agrée à la caste des brahmanes ? or le yoga hindou est affaire de secte, non de caste."
                            }
                        ]
                    }
