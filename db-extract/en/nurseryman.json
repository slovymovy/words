                        "sense_id": "71504c7d-35d6-3445-8999-be27e4b2ddf7",
                        "entry_id": "3b45c402-efd7-3bf2-8239-4cbd852b5ad4",
                        "glosses": [
                            "A person who rears and sells plants in a nursery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc9fdde-c3c2-4040-82dc-80e27c0e717d",
                                "sense_id": "71504c7d-35d6-3445-8999-be27e4b2ddf7",
                                "text": "More and more I am coming to the conviction that in the north the orchard-grower will do better to be his own nurseryman—that is, to grow his own trees from the ground up."
                            },
                            {
                                "example_id": "507f4502-5bbb-4d47-9070-1b3b39032213",
                                "sense_id": "71504c7d-35d6-3445-8999-be27e4b2ddf7",
                                "text": "[H]e said he was a nurseryman and gave his address as \"Leawood Nursery, Glen Osmond\"."
                            },
                            {
                                "example_id": "c73094cd-290d-4b8a-bcfb-cc9ce02f9ecc",
                                "sense_id": "71504c7d-35d6-3445-8999-be27e4b2ddf7",
                                "text": "Jim is a nurseryman, specialising in clematis, and he has built up a business exporting 150 varieties to countries all over the world."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9a74868-e196-4654-afc2-117761afddb9",
