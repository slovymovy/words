                                                "sense_id": "391de1e5-457e-3a5c-9660-c5f248e40921",
                                                "text": "Un maniaque dangereux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9514655a-5758-3a15-adc3-824e4ccfbd66",
                                        "entry_id": "f111bc97-f8f6-3c41-b919-92e0f787b40c",
                                        "glosses": [
                                            "Qui a des habitudes bizarres."
