            "senses": [
                {
                    "sense_id": "32bb8f29-4cb7-3150-b73d-24c664ddc2ff",
                    "sense_definition": "łączyć końce czegoś w węzeł, kokardę lub pętlę",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wiązanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz <w>zawiązać</w> sznurowadła, żeby się nie przewrócić.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>завязать</w> шнурки, чтобы не упасть."
                            }
                        },
                        {
                            "text": "Dziecko uczy się samodzielnie <w>zawiązywać</w> szalik pod szyją.",
                            "target_lang_translations": {
                                "ru": "Ребенок учится самостоятельно <w>завязывать</w> шарф на шее."
                            }
                        }
                    ],
                    "synonyms": [
                        "wiązać"
                    ],
                    "common_phrases": [
                        "zawiązywać sznurowadła",
                        "zawiązywać szalik"
                    ],
                    "target_lang_definitions": {
                        "ru": "соединять концы чего-либо в узел, бант или петлю"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завязывать",
                                "target_lang_sense_clarification": "основной глагол для создания узла или банта"
                            },
                            {
                                "target_lang_word": "зашнуровывать",
                                "target_lang_sense_clarification": "специфично для шнурков"
                            }
                        ]
                    },
                    "antonyms": [
