                    "sense_id": "b0057381-9eb5-3d01-8e57-53c927f63bd4",
                    "sense_definition": "Verkleinwoord van <w>brief</w>; een klein stuk papier met een korte, vaak informele tekst.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een <w>briefje</w> op de keukentafel achtergelaten.",
                            "target_lang_translations": {
                                "ru": "Я оставил <w>записку</w> на кухонном столе.",
                                "en": "I left a <w>note</w> on the kitchen table.",
                                "pl": "Zostawiłem <w>karteczkę</w> na stole kuchennym.",
                                "de": "Ich habe einen <w>Zettel</w> auf dem Küchentisch hinterlassen.",
                                "fr": "J'ai laissé un <w>petit mot</w> sur la table de la cuisine.",
                                "it": "Ho lasciato un <w>biglietto</w> sul tavolo della cucina.",
                                "cs": "Nechal jsem na kuchyňském stole <w>vzkaz</w>.",
                                "tr": "Mutfak masasının üzerine bir <w>not</w> bıraktım.",
                                "es": "He dejado una <w>nota</w> en la mesa de la cocina.",
                                "zh": "我在厨房桌子上留了一张<w>字条</w>。"
                            }
                        },
                        {
                            "text": "Op het <w>briefje</w> stond dat ze wat later thuis zou komen.",
                            "target_lang_translations": {
                                "ru": "В <w>записке</w> было написано, что она придет домой немного позже.",
                                "en": "The <w>note</w> said that she would come home a bit later.",
                                "pl": "Na <w>karteczce</w> było napisane, że wróci do domu trochę później.",
                                "de": "Auf dem <w>Zettel</w> stand, dass sie etwas später nach Hause kommen würde.",
                                "fr": "Sur le <w>petit mot</w>, il était écrit qu'elle rentrerait un peu plus tard.",
                                "it": "Sul <w>biglietto</w> c'era scritto che sarebbe tornata a casa un po' più tardi.",
                                "cs": "Na <w>lístku</w> stálo, že přijde domů o něco později.",
                                "tr": "<w>Notta</w> biraz daha geç geleceği yazıyordu.",
                                "es": "En la <w>nota</w> decía que llegaría a casa un poco más tarde.",
                                "zh": "<w>字条</w>上写着她会晚点回家。"
                            }
