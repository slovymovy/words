                "senses": [
                    {
                        "sense_id": "3dad99b9-3cc1-3953-8031-ab2b07fa0bec",
                        "entry_id": "41135422-87f4-31d8-b71b-6cdce6029e77",
                        "glosses": [
                            "ogół liści roślin, zwłaszcza drzew i krzewów"
                        ],
                        "tags": [],
