                "senses": [
                    {
                        "sense_id": "68e3724c-05c6-3959-bbbf-119ddb1e7b24",
                        "entry_id": "f018ceb2-9f81-336d-8eb3-b79349efc4b3",
                        "glosses": [
                            "obracająca się część maszyny wirującej"
                        ],
                        "tags": [],
