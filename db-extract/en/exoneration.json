                    {
                        "translation_id": "4093a610-77b0-4ecc-a41e-586401364b76",
                        "source_entry_id": "8f818281-ea9e-3f73-ae2f-0330aee6c142",
                        "source_sense_description": "the act of freeing a person of blame",
                        "target_lang_word": "Entlastung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entlastung",
