{
    "word": "encrypted",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "58ca153e-42da-344d-bbc1-99dced1b2bf3",
                "word": "encrypted",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b1623949-42bc-3fe3-8333-593e8bfc8645",
                        "entry_id": "58ca153e-42da-344d-bbc1-99dced1b2bf3",
                        "glosses": [
                            "Being in code; having been encrypted."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fe579126-984d-41cd-95ed-802d1dd96030",
                                "sense_id": "b1623949-42bc-3fe3-8333-593e8bfc8645",
                                "text": "The encrypted text was unreadable."
                            },
                            {
                                "example_id": "472c29a7-6a46-4a39-9052-68e632f0534a",
                                "sense_id": "b1623949-42bc-3fe3-8333-593e8bfc8645",
                                "text": "If a folder is encrypted, the files are automatically encrypted. This guarantees that the files remain encrypted, even after you make changes to those files."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4f244aa-70c6-44d6-a95f-a92f8f39668c",
                        "source_entry_id": "58ca153e-42da-344d-bbc1-99dced1b2bf3",
                        "source_sense_id": "b1623949-42bc-3fe3-8333-593e8bfc8645",
                        "source_sense_description": "that is in code",
                        "target_lang_word": "chiffré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiffré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79756dee-5335-3b8e-86e2-718cc15b1cfd",
                                        "entry_id": "a0f47fa7-67b7-3886-8cff-e64ecf381710",
                                        "glosses": [
                                            "Numéroté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f4d370c-8a34-466b-91ee-e5975c954533",
                                                "sense_id": "79756dee-5335-3b8e-86e2-718cc15b1cfd",
                                                "text": "Des pages chiffrées."
                                            },
                                            {
                                                "example_id": "6088a4bf-6641-443e-a1cc-7d982885c3b5",
                                                "sense_id": "79756dee-5335-3b8e-86e2-718cc15b1cfd",
                                                "text": "Et pendant qu’on le croira à Barcelone en train de négocier des contrats avec un soi-disant client, il déposera ce bel argent sur un compte chiffré en Suisse, converti en bons dollars, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e65c91c5-f9c4-3d17-8126-de8ccfd17286",
                                        "entry_id": "a0f47fa7-67b7-3886-8cff-e64ecf381710",
                                        "glosses": [
                                            "Écrit en chiffre, dans un codage secret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72362b6e-4b42-4759-8f5b-fe9271c7c130",
                                                "sense_id": "e65c91c5-f9c4-3d17-8126-de8ccfd17286",
                                                "text": "Il frappe sur le clavier le message chiffré tel qu'il l’a reçu du poste radio récepteur."
                                            },
                                            {
                                                "example_id": "33cedd3f-61fe-46db-b358-b9a626a7bffb",
                                                "sense_id": "e65c91c5-f9c4-3d17-8126-de8ccfd17286",
                                                "text": "Pourtant, il arrive (heureusement pour le cryptanalyste) que l’on ait en main davantage d’éléments qu’un court fragment de texte chiffré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2d7973-43ea-361e-bffe-661132805b29",
                                        "entry_id": "a0f47fa7-67b7-3886-8cff-e64ecf381710",
                                        "glosses": [
                                            "Évalué sous la forme d’un nombre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e526c078-da7f-4fe6-9c83-b617cedaced1",
                                                "sense_id": "ab2d7973-43ea-361e-bffe-661132805b29",
                                                "text": "L'avantage d’un objectif chiffré est qu’il simplifie fortement la question de savoir s’il est atteint ou non."
                                            },
                                            {
                                                "example_id": "b7f437f4-de8f-4041-a9f2-462581808738",
                                                "sense_id": "ab2d7973-43ea-361e-bffe-661132805b29",
                                                "text": "À peine quelques travaux déjà effectués dans les vignes et les résultats dépassent déjà les espérances de la municipalité de Montgueux. Des résultats humains et non des résultats chiffrés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "834aa708-1cb3-326b-9c57-1d67f8185833",
                                        "entry_id": "a0f47fa7-67b7-3886-8cff-e64ecf381710",
                                        "glosses": [
                                            "Orné d'un emblème formant le chiffre d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14a2ecae-0d4c-4e91-81ff-4b9107f23e6d",
                                                "sense_id": "834aa708-1cb3-326b-9c57-1d67f8185833",
                                                "text": "Elle arriva avec trente-trois grosses malles, et des nécessaires chiffrés, et des bijoux de valise, et des cartons, et de tout…"
                                            },
                                            {
                                                "example_id": "c7bbdf98-3f31-4907-a6db-a0cfa1422e6b",
                                                "sense_id": "834aa708-1cb3-326b-9c57-1d67f8185833",
                                                "text": "Rien ne manque, ni le linge chiffré, ni la cuisine au fond, avec sa cuisinière noire à boutons et barres dorés, ni les moules à pâtisserie en cuivre, ni la chambre et ses lits faits."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chiffré",
                                "target_lang_code": "fr",
                                "target_senses": [
