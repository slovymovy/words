        "ru-extract.jsonl": [
            {
                "entry_id": "5d300a9c-9b96-358d-828e-5cc5e79c85c6",
                "word": "gorszy",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4cc090ce-52ab-3c97-b07c-dd38853a53cb",
                        "entry_id": "5d300a9c-9b96-358d-828e-5cc5e79c85c6",
                        "glosses": [
                            "хуже\\nЗвук примера:"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a9934b-a536-44b0-8ebf-5fffd6f262b8",
                                "sense_id": "4cc090ce-52ab-3c97-b07c-dd38853a53cb",
                                "text": "... jedni krytykowali postępowanie prezydenta Mac-Mahona, inni twierdzili, że Wokulski jest zdecydowanym waryatem, jeżeli nie czemś gorszem..",
                                "translation": "одни критиковали деятельность президента Мак-Магона, другие утверждали, что Вокульский - явный безумец, если не хуже..."
                            }
                        ]
                    },
                    {
                        "sense_id": "52e1207e-856b-3e44-84a1-0e6e910656b8",
                        "entry_id": "5d300a9c-9b96-358d-828e-5cc5e79c85c6",
                        "glosses": [
                            "худший"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5707a02-126b-4978-b11d-1ad11a29b5bf",
                                "sense_id": "52e1207e-856b-3e44-84a1-0e6e910656b8",
                                "text": "Ale Mścisław, do rąk jego przypadłszy, całować je począł i błagać, aby dla nich to uczynił i przybyć raczył, bez czego, jak powiadał, gorszy nieład i zaburzenie przypaść mogło.",
                                "translation": "Но Мстислав, припав к рукам епископа, стал покрывать их поцелуями и умолять снизойти к просьбе недовольных, выражая опасение, как бы отказ не привел к худшей смуте и разрухе. [. ()]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e786317b-dd95-31c8-aaf6-70794a8c25c0",
                        "entry_id": "5d300a9c-9b96-358d-828e-5cc5e79c85c6",
                        "glosses": [
                            "больней"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa44a83c-fb4c-4242-822a-b0aa206e1585",
                                "sense_id": "e786317b-dd95-31c8-aaf6-70794a8c25c0",
                                "text": "I tego nie wiesz, że dla mnie to gorszy cios niż dla innego, bom ja już jedno kochanie stracił.",
                                "translation": "Ты и знать не хочешь, что для меня этот удар больней, чем для другого, ведь я однажды уже лишился любимой."
                            }
                        ]
                    }
                ],
