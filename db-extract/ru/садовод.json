                "translations": [
                    {
                        "translation_id": "e157f7df-1068-4035-9ade-f412e65db503",
                        "source_entry_id": "33d6206d-0fbb-37c1-a726-94dcd082ccce",
                        "source_sense_id": "0f4a6856-f4bc-3e60-a373-91e9c69ca4e8",
                        "target_lang_word": "gardener",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06c8e2f9-1e73-3f9c-b8c4-0eb163484f8d",
                                        "entry_id": "0590057a-29ca-3851-92bc-cb45e0e80888",
                                        "glosses": [
                                            "One who gardens; one who grows plants or cultivates a garden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea51546d-1a90-453e-bb87-104a0829f7b7",
                                                "sense_id": "06c8e2f9-1e73-3f9c-b8c4-0eb163484f8d",
                                                "text": "\"Ponder the fact that God has made you a gardener, to root out vice and to plant virtue.\" — St. Catherine of Siena"
                                            },
                                            {
                                                "example_id": "1a11fcac-39fe-4ca7-b766-5c80db1de1ce",
                                                "sense_id": "06c8e2f9-1e73-3f9c-b8c4-0eb163484f8d",
                                                "text": "At the far end of the houses the head gardener stood waiting for his mistress, and he gave her strips of bass to tie up her nosegay. This she did slowly and laboriously, with knuckly old fingers that shook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55a3dd65-07e0-3d52-aa9c-1d19aee08d49",
                                        "entry_id": "0590057a-29ca-3851-92bc-cb45e0e80888",
                                        "glosses": [
                                            "A coachman who drives badly."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "470f51ee-4472-4846-8f15-3ad7283d26f6",
                                                "sense_id": "55a3dd65-07e0-3d52-aa9c-1d19aee08d49",
                                                "text": "Get on, gardener! Get on, you slow and clumsy coachman. The allusion is to a man who is both gardener and coachman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e41f998b-a0b3-425c-a98c-4d5e7994ae21",
                        "source_entry_id": "33d6206d-0fbb-37c1-a726-94dcd082ccce",
                        "source_sense_id": "0f4a6856-f4bc-3e60-a373-91e9c69ca4e8",
                        "target_lang_word": "horticulturist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horticulturist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa7de875-239b-3559-b732-1de4a6becd78",
                                        "entry_id": "2c76e766-6746-380f-8588-7cd8eb938d0f",
                                        "glosses": [
                                            "A gardener; a person interested in or practicing horticulture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b8ea011-38ee-4cfc-b702-ccb20506c922",
                                                "sense_id": "aa7de875-239b-3559-b732-1de4a6becd78",
                                                "text": "[…] [I]nfected tulips are weakened by the viruses that cause the very patterns and swirls that fascinated horticulturists and investors in the first place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ac6c8d2-8e60-4f27-8ad0-1427c75ccd14",
                        "source_entry_id": "33d6206d-0fbb-37c1-a726-94dcd082ccce",
                        "source_sense_id": "0f4a6856-f4bc-3e60-a373-91e9c69ca4e8",
                        "target_lang_word": "horticultor",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "faa6d108-9834-45b8-ac81-26a69bc04b72",
                        "source_entry_id": "33d6206d-0fbb-37c1-a726-94dcd082ccce",
                        "source_sense_id": "0f4a6856-f4bc-3e60-a373-91e9c69ca4e8",
                        "target_lang_word": "Gärtner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gärtner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                        "entry_id": "466811f2-e496-329e-b181-46d5b9161a23",
                                        "glosses": [
                                            "Person, die beruflich im Gartenbau tätig ist"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9261b79d-2e8c-4969-8f92-71d72caaf50e",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "Ein Gärtner ist bei Wind und Wetter draußen und arbeitet in den Beeten."
                                            },
                                            {
                                                "example_id": "0c1c6692-895d-4076-b5d0-959b621f4803",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "Sie führte ein Telefonat mit dem Gärtner über das Anlegen neuer Rhododendronhecken."
                                            },
                                            {
                                                "example_id": "63ad1bf9-10c4-41fe-9f8c-7d6f3343031e",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Der französische Präsident dagegen sieht von seinem Arbeitszimmer nur die Gärtner, die in seinem Privatpark unter den uralten Bäumen den Rhododendron stutzen.“"
                                            },
                                            {
                                                "example_id": "577482b9-3d15-487a-9715-ad0662140884",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Ihre wundervollen Kinder würden eine gute Schule besuchen, und sie hätte drei Dienstmädchen, einen Gärtner, einen Chauffeur und eine Köchin.“"
                                            },
                                            {
                                                "example_id": "980a5c37-69f2-4912-93dd-f0d62d23eae3",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Anna ist Friedas Schwester und die Frau des Gärtners von Rumbske, den – wie fast alle Männer – der Krieg fortriß.“"
                                            },
                                            {
                                                "example_id": "8ce48aec-8237-4bd4-bc1f-2caa227f117c",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Fried kam in die Lehrlingsgruppe der Schreiner, und ihn steckte man zu den Gärtnern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad4b7744-2c02-4ccc-aadb-b46d3a7cca6a",
                        "source_entry_id": "33d6206d-0fbb-37c1-a726-94dcd082ccce",
                        "source_sense_id": "0f4a6856-f4bc-3e60-a373-91e9c69ca4e8",
                        "target_lang_word": "horticulteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horticulteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "955d9190-ae31-30fb-98fa-4c4754a86ea0",
                                        "entry_id": "bafdf01f-6346-3377-a66d-0281fa90254c",
                                        "glosses": [
                                            "Celui qui s’occupe de perfectionner la culture des jardins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e521737-be1c-42af-bb15-c1a1b76a833e",
                                                "sense_id": "955d9190-ae31-30fb-98fa-4c4754a86ea0",
                                                "text": "Dès le lendemain matin nous nous présentons chez l'horticulteur Lemoine, qui […] se fait un plaisir de nous faire visiter ses serres, ses jardins. Que de merveilles! grands dieux!"
                                            },
                                            {
                                                "example_id": "d71b2a6a-2db0-4b5f-85c5-abc0ef974f8d",
                                                "sense_id": "955d9190-ae31-30fb-98fa-4c4754a86ea0",
                                                "text": "Mais je n’aime pas les fleurs bêtes, car si blasphématoire que cela paraisse, il y a des fleurs bêtes, ou plutôt des fleurs, des pauvres fleurs à qui les horticulteurs ont communiqué leur bêtise contagieuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
