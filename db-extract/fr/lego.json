                            {
                                "example_id": "0988a63e-d316-4255-8b12-044c77273d3a",
                                "sense_id": "5b43176f-fc0c-36b4-a731-4b8d2a2678eb",
                                "text": "J'ai trouvé un Lego sous ton lit.",
                                "translation": "I've found a Lego (brick) under your bed.",
                                "english": "I've found a Lego (brick) under your bed."
                            },
                            {
                                "example_id": "c9ecad3e-439d-431b-b5cf-9e722e1e0718",
                                "sense_id": "5b43176f-fc0c-36b4-a731-4b8d2a2678eb",
                                "text": "Je collectionne les Lego (ou Legos).",
                                "translation": "I collect Lego/Legos.",
                                "english": "I collect Lego/Legos."
                            },
                            {
                                "example_id": "e8914424-4265-4008-9f7a-acfc8bee4525",
                                "sense_id": "5b43176f-fc0c-36b4-a731-4b8d2a2678eb",
                                "text": "J'ai acheté une voiture Lego.",
                                "translation": "I've bought a Lego car.",
                                "english": "I've bought a Lego car."
                            },
                            {
                                "example_id": "eac78bc2-b855-48e4-aca0-ec867c521a8c",
                                "sense_id": "5b43176f-fc0c-36b4-a731-4b8d2a2678eb",
                                "text": "Un avion en Lego/Legos",
                                "translation": "A plane made of Lego/Legos",
                                "english": "A plane made of Lego/Legos"
                            }
                        ]
                    }
