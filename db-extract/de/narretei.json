                "senses": [
                    {
                        "sense_id": "49fa66c6-723d-3fe7-a84e-62e407a89ab2",
                        "entry_id": "36c666ff-f87f-3e9f-82fb-2274a08c0a63",
                        "glosses": [
                            "närrisches Verhalten und Ergebnis eines solchen Verhaltens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21997c7b-f595-4607-9b13-132e88e46f0f",
                                "sense_id": "49fa66c6-723d-3fe7-a84e-62e407a89ab2",
                                "text": "„Walpurgisnacht hat etwas mit Karneval zu tun, mit Fasching, wo die Sitten zugunsten der Narretei aufgehoben werden.“"
                            },
                            {
                                "example_id": "ec376b1f-0e92-4941-a971-a86a970bf109",
                                "sense_id": "49fa66c6-723d-3fe7-a84e-62e407a89ab2",
                                "text": "„Aber je wahrheitsgetreuer ihr Bericht war, um so mehr fühlte sich die gute Dame in ihrer Ansicht bestärkt, daß sie verrückt sei, und sie lachte mit mir nur über die vermeintlichen Narreteien meiner Verräterin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
