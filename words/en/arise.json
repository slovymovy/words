{
    "word_family": [
        "rise",
        "rising",
        "uprising"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8eee9785-a3d0-3733-b66b-d880a3da4d78",
                    "sense_definition": "To begin to exist, happen, or become apparent.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Problems can <w>arise</w> unexpectedly, but we need to be prepared for them.",
                            "target_lang_translations": {
                                "ru": "Проблемы могут <w>возникнуть</w> неожиданно, но мы должны быть к ним готовы.",
                                "tr": "Sorunlar beklenmedik şekilde <w>ortaya çıkabilir</w>, ancak onlara karşı hazırlıklı olmalıyız."
                            }
                        },
                        {
                            "text": "A new challenge will <w>arise</w> every time you think you've solved the last one.",
                            "target_lang_translations": {
                                "ru": "Новая проблема будет <w>возникать</w> каждый раз, когда вы будете думать, что решили предыдущую.",
                                "tr": "Sonuncusunu çözdüğünüzü her düşündüğünüzde yeni bir zorluk <w>ortaya çıkacaktır</w>."
                            }
                        },
                        {
                            "text": "Serious questions may <w>arise</w> regarding the safety of the new procedure.",
                            "target_lang_translations": {
                                "ru": "Могут <w>возникнуть</w> серьёзные вопросы касательно безопасности новой процедуры.",
                                "tr": "Yeni prosedürün güvenliği ile ilgili ciddi sorular <w>ortaya çıkabilir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "occur",
                        "happen",
                        "emerge",
                        "appear",
                        "come about",
                        "spring",
                        "come into being",
                        "come to pass",
                        "pop up",
                        "surface"
                    ],
                    "common_phrases": [
                        "problems arise",
                        "questions arise",
                        "if the need arises",
                        "situation arises",
                        "conflict arises"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать существовать, случаться или становиться очевидным.",
                        "tr": "Bir durumun, sorunun veya olayın ortaya çıkması, başlaması veya belirgin hale gelmesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возникать",
                                "target_lang_sense_clarification": "появляться, начинаться (о проблемах, вопросах)"
                            },
                            {
                                "target_lang_word": "появляться",
                                "target_lang_sense_clarification": "становиться видимым или известным"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ortaya çıkmak",
                                "target_lang_sense_clarification": "bir sorunun veya durumun belirmesi"
                            },
                            {
                                "target_lang_word": "doğmak",
                                "target_lang_sense_clarification": "bir ihtiyaç veya soru gibi soyut kavramların oluşması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e221207-248a-37ee-ad1e-1b96b8762754",
                    "sense_definition": "To get out of bed; to stand up after sleeping or resting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>arose</w> early in the morning to prepare for the long journey.",
                            "target_lang_translations": {
                                "ru": "Он <w>встал</w> рано утром, чтобы подготовиться к долгому путешествию.",
                                "tr": "Uzun yolculuğa hazırlanmak için sabah erkenden <w>kalktı</w>."
                            }
                        },
                        {
                            "text": "The villagers <w>arose</w> at dawn to begin their daily work in the fields.",
                            "target_lang_translations": {
                                "ru": "Жители деревни <w>встали</w> на рассвете, чтобы начать свою повседневную работу в полях.",
                                "tr": "Köylüler tarlalardaki günlük işlerine başlamak için şafak vakti <w>kalktılar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "awaken",
                        "rise"
                    ],
                    "common_phrases": [
                        "arise early",
                        "arise at dawn"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вставать с постели; подниматься на ноги после сна или отдыха.",
                        "tr": "Uykudan uyanıp yataktan çıkmak veya dinlenme halinden ayağa kalkmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вставать",
                                "target_lang_sense_clarification": "подниматься с постели"
                            },
                            {
                                "target_lang_word": "просыпаться",
                                "target_lang_sense_clarification": "пробуждаться ото сна"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kalkmak",
                                "target_lang_sense_clarification": "yataktan veya oturur durumdan ayağa kalkmak"
                            },
                            {
                                "target_lang_word": "uyanmak",
                                "target_lang_sense_clarification": "uykudan uyanıp güne başlamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db1d2877-3e16-3216-b16e-249624506502",
                    "sense_definition": "To stand up or move upward from a lower position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight slowly <w>arose</w> from his kneeling posture to address the king.",
                            "target_lang_translations": {
                                "ru": "Рыцарь медленно <w>поднялся</w> с колен, чтобы обратиться к королю.",
                                "tr": "Şövalye, krala hitap etmek için diz çökmüş pozisyonundan yavaşça <w>doğruldu</w>."
                            }
                        },
                        {
                            "text": "Thick smoke began to <w>arise</w> from the chimney as the fire grew.",
                            "target_lang_translations": {
                                "ru": "Густой дым начал <w>подниматься</w> из трубы, когда огонь разгорелся.",
                                "tr": "Ateş büyüdükçe bacadan yoğun duman <w>yükselmeye</w> başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "rise",
                        "stand up"
                    ],
                    "common_phrases": [
                        "arise from"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вставать или двигаться вверх с более низкой позиции.",
                        "tr": "Daha alçak bir konumdan yukarı doğru hareket etmek veya ayağa kalkmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "перемещаться вверх"
                            },
                            {
                                "target_lang_word": "вставать",
                                "target_lang_sense_clarification": "принимать вертикальное положение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yükselmek",
                                "target_lang_sense_clarification": "duman veya benzeri şeylerin yukarı doğru hareketi"
                            },
                            {
                                "target_lang_word": "doğrulmak",
                                "target_lang_sense_clarification": "eğik veya oturur pozisyondan dik konuma geçmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ce925dc6-10ed-3115-b0b1-fdf2613a9187",
                    "sense_definition": "An act of rising or appearing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We mean to take his morning's next <w>arise</w>.",
                            "target_lang_translations": {
                                "ru": "Мы намерены застать его следующий утренний <w>подъём</w>.",
                                "tr": "Onun sabahki bir sonraki <w>kalkışına</w> yetişmek istiyoruz."
                            }
                        },
                        {
                            "text": "The sudden <w>arise</w> of the wind startled the sailors on the deck.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>появление</w> ветра испугало моряков на палубе.",
                                "tr": "Rüzgarın ani <w>ortaya çıkışı</w> güvertedeki denizcileri ürküttü."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт подъёма или появления.",
                        "tr": "Yükselme veya ortaya çıkma eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "появление",
                                "target_lang_sense_clarification": "возникновение"
                            },
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "действие по значению глагола"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ortaya çıkış",
                                "target_lang_sense_clarification": "bir şeyin belirmesi durumu"
                            },
                            {
                                "target_lang_word": "yükseliş",
                                "target_lang_sense_clarification": "yukarı doğru hareket etme eylemi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}