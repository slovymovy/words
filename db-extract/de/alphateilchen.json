                "senses": [
                    {
                        "sense_id": "ba9dd512-199e-31db-bcea-9ea34c6e4f31",
                        "entry_id": "f5e7e30d-7232-3010-a12d-1f2721f56e8a",
                        "glosses": [
                            "beim Alphazerfall, einer Art des radioaktiven Zerfalls von Atomkernen, auftretendes Teilchen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "70c96b5b-70d9-41cb-8c4b-7531b6aa9b88",
                                "sense_id": "ba9dd512-199e-31db-bcea-9ea34c6e4f31",
                                "text": "„Sein bekanntester Beitrag zur Atomphysik ist das Rutherfordsche Atommodell, das er 1911 aus seinen Streuversuchen von Alphateilchen an Goldfolie ableitete.“"
                            },
                            {
                                "example_id": "10185b89-c2f1-4815-9ed4-04d856501a6d",
                                "sense_id": "ba9dd512-199e-31db-bcea-9ea34c6e4f31",
                                "text": "„Auf der Erde wird ⁴He in Form von Alphateilchen bei dem Alphazerfall verschiedener radioaktiver Elemente wie zum Beispiel Uran oder Radium gebildet. Helium entsteht daraus, wenn das Alphateilchen anderen Atomen zwei Elektronen entreißt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
