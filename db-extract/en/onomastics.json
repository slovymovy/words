                                            {
                                                "example_id": "3e793ec0-0c3d-4d31-9569-a40059be0bec",
                                                "sense_id": "0ab4f9f9-9f04-3a59-a3c7-76980e18e719",
                                                "text": "Die Namenkunde erforscht die Entwicklung, Etymologie und Verbreitung von Eigennamen."
                                            },
                                            {
                                                "example_id": "14f29664-7a59-4046-b954-b1c40562b0f1",
                                                "sense_id": "0ab4f9f9-9f04-3a59-a3c7-76980e18e719",
                                                "text": "„Aber auch und vor allem Leipzig gilt als traditionelles Zentrum der Onomastik, wie Fachwissenschaftler die Namenkunde nennen.“"
                                            },
                                            {
                                                "example_id": "0650286b-be63-4b4f-92c4-2a2b4c15a58e",
                                                "sense_id": "0ab4f9f9-9f04-3a59-a3c7-76980e18e719",
                                                "text": "„In den Lehrplänen ist Namenkunde recht unterschiedlich vertreten.“"
                                            }
