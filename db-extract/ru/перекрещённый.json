                                        "sense_id": "d02f541e-1cd0-37c1-a172-50105b848aea",
                                        "entry_id": "16d04396-b79a-3f0a-b108-b2b40fea3d99",
                                        "glosses": [
                                            "Marked by lines crossing in two or more directions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f27b863f-1495-4ec9-a7f8-24fdd5f8a52c",
                                                "sense_id": "d02f541e-1cd0-37c1-a172-50105b848aea",
                                                "text": "Don't tell me I lost a step / Criss-crossed in the wrong direction / Found myself in a conversation / From a missed connection"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crisscrossed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b47aa0db-6738-371d-b881-491e9be51355",
                                        "entry_id": "dc2ed468-9a12-3ba4-bc70-366d2b5f19e7",
                                        "glosses": [
                                            "simple past and past participle of crisscross"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afa03a6d-99f3-48b1-833a-d9bec16a091a",
                                                "sense_id": "b47aa0db-6738-371d-b881-491e9be51355",
                                                "text": "As I crisscrossed managerial circles in different corporations, becoming known in some segments of the corporate world and running into managers that I had met in the course of my search, often in odd places, my personal contacts increased as managers referred me to each other."
                                            }
                                        ]
                                    }
                                ]
                            }
