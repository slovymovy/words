        "nl-extract.jsonl": [
            {
                "entry_id": "4005cf9b-21df-301b-9a08-e15ff7bf9db7",
                "word": "platwalsen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a30ca8d-fc6c-34db-a811-6fa60217a511",
                        "entry_id": "4005cf9b-21df-301b-9a08-e15ff7bf9db7",
                        "glosses": [
                            "gladmaken met een wals"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f12441f6-8d66-4386-9cbc-cf5090952c13",
                                "sense_id": "4a30ca8d-fc6c-34db-a811-6fa60217a511",
                                "text": "Een wegmarkeerder is bezig met metingen voor lijnen en vlakken. Ondertussen is een wals het nieuwe asfalt aan het platwalsen."
                            }
                        ]
                    },
                    {
                        "sense_id": "104e2643-d93c-304c-9616-54b46a51810b",
                        "entry_id": "4005cf9b-21df-301b-9a08-e15ff7bf9db7",
                        "glosses": [
                            "platmaken met een wals"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bfaa3c6f-eb0e-464e-8931-f7d42759a633",
                                "sense_id": "104e2643-d93c-304c-9616-54b46a51810b",
                                "text": "Gisterochtend begonnen overheidstroepen met het leeghalen en platwalsen van de tentenkampen in Caïro. Bij gevechten die daarna in heel Egypte ontstonden, vonden zeker 235 burgers en 43 politieagenten de dood volgens officiële bronnen. Volgens de Moslim Broederschap zijn er meer dan 2000 doden gevallen."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea5d827c-2ce2-38b2-9f93-f5334e98fd75",
                        "entry_id": "4005cf9b-21df-301b-9a08-e15ff7bf9db7",
                        "glosses": [
                            "met enorme overmacht overwinnen"
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f35064ed-6dc8-4a65-96ed-b8b8f47d04bb",
                                "sense_id": "ea5d827c-2ce2-38b2-9f93-f5334e98fd75",
                                "text": "De overname van Whole Foods door Amazon doet terugdenken aan 1999. Toen nam de Amerikaanse supermarktreus WalMart met ­ASDA de op twee na grootste supermarktketen van het VK over. Beleggers dachten dat WalMart de Britse markt zou platwalsen, maar dat gebeurde niet. Nadat beleggers het aandeel van de Britse nummer 1 Tesco massaal hadden gedumpt, sloeg Tesco terug. De volgende vijf jaar verdrievoudigde het zijn koers."
                            },
                            {
                                "example_id": "9ebb0ff6-d302-4233-9730-1f49f1ed0b2e",
                                "sense_id": "ea5d827c-2ce2-38b2-9f93-f5334e98fd75",
                                "text": "Als hoofdprijs is binnen te halen de transformatie tot een zeven meter lange witte ridder, een reusachtige vechtmachine die alles in zijn omgeving kan platwalsen."
                            }
                        ]
                    },
                    {
                        "sense_id": "555598a1-dce2-3b7e-844a-69721d41c872",
                        "entry_id": "4005cf9b-21df-301b-9a08-e15ff7bf9db7",
                        "glosses": [
                            "alle tegenstand negeren of op een onredelijke wijze overwinnen"
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6d311a52-bcf1-4b12-a494-d0c85635ead1",
                                "sense_id": "555598a1-dce2-3b7e-844a-69721d41c872",
                                "text": "Uitrollen is het nieuwe doorpakken, zei een van mijn dierbare twitteraars. Maar ik zeg: we stoppen HIER met die rol. Want hoe spannend en dynamisch het ook klinkt om SAMEN iets uit te rollen – uiteindelijk gaat uitrollen over in platwalsen en geloof me, daar wil niemand bij zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14c5bd90-a81c-4210-92e5-3ddb21662bd6",
                        "source_entry_id": "4005cf9b-21df-301b-9a08-e15ff7bf9db7",
