                        "examples": [
                            {
                                "example_id": "4d8ffeee-4b9a-4f78-ba8b-3a30264d17ae",
                                "sense_id": "e3a9cccf-b0e0-300e-bda9-50088588d354",
                                "text": "a stop-work meeting"
                            },
                            {
                                "example_id": "283b5f8e-12a7-413e-b3b8-7f08c689dcdb",
                                "sense_id": "e3a9cccf-b0e0-300e-bda9-50088588d354",
                                "text": "41. No stop-work meeting shall be held at the mine without the permission of the manager."
                            },
                            {
                                "example_id": "731f63b1-b537-4008-9248-4730baca1595",
                                "sense_id": "e3a9cccf-b0e0-300e-bda9-50088588d354",
                                "text": "MORE than 4000 NZ Post workers will begin a series of nationwide stop-work meetings today to discuss what their union has said is privatisation by the back door."
                            },
                            {
                                "example_id": "c6134ff1-6467-478f-97a1-3944e18a68e5",
                                "sense_id": "e3a9cccf-b0e0-300e-bda9-50088588d354",
                                "text": "Train drivers across Adelaide will walk off the job today to attend a stop-work meeting about their enterprise bargaining negotiations."
                            },
                            {
                                "example_id": "35237933-d4af-4e1b-91e3-e38ed0b97b56",
                                "sense_id": "e3a9cccf-b0e0-300e-bda9-50088588d354",
                                "text": "Workers at Cleanaway do not make the decision to take stop work action lightly and are aware of the unfortunate impact this will have on the community."
                            },
                            {
                                "example_id": "a823879b-eaa0-4718-8ffe-9cb656593822",
                                "sense_id": "e3a9cccf-b0e0-300e-bda9-50088588d354",
                                "text": "State schools will be closed until 10.30am on Wednesday due to a decision by the Australian Education Union to call a two-hour stop-work meeting involving both teachers and teacher assistants."
                            }
                        ]
                    },
                    {
                        "sense_id": "94d53518-1b79-33cf-b9a2-ab67d3f5694a",
                        "entry_id": "e12c53f3-9630-3338-b6f2-80a9ed402ee7",
                        "glosses": [
                            "A temporary cessation of work.",
                            "Causing work to cease temporarily for administrative reasons such as safety concerns or legal action."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "attributive",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "68a2713a-b6fd-4228-956f-5387a2a3bb05",
                                "sense_id": "94d53518-1b79-33cf-b9a2-ab67d3f5694a",
                                "text": "a stop-work order."
                            },
                            {
                                "example_id": "af26f7db-8267-488c-9e97-f593c716e83b",
                                "sense_id": "94d53518-1b79-33cf-b9a2-ab67d3f5694a",
                                "text": "The Bureau of Reclamation of the Department of Interior has appealed to the War Production Board for reconsideration of the stop-work order of December 12, 1942, on the Newton project, Cache County, Utah"
                            },
                            {
                                "example_id": "aa2163fc-8662-4b7c-a125-dbf20a47a965",
                                "sense_id": "94d53518-1b79-33cf-b9a2-ab67d3f5694a",
                                "text": "[Mayor Mark] Morial issued a stop-work order to suspend the razing of the building"
                            },
                            {
                                "example_id": "6a12e1b0-d03a-48dc-a70a-66500d2087ab",
                                "sense_id": "94d53518-1b79-33cf-b9a2-ab67d3f5694a",
                                "text": "The stop-work order, Saxon said, was an attempt to \"pretty much get this resolved, to get it done.\" Decatur officials have said the main issue in the dispute is safety, primarily making the county comply with its stricter fire safety codes."
                            },
                            {
                                "example_id": "df64ba96-68d2-4824-8c66-b1552eb1a1f2",
                                "sense_id": "94d53518-1b79-33cf-b9a2-ab67d3f5694a",
                                "text": "The inquest into the death of Michael Welsh at the Mount Lyell mine in 2014 heard the mine manager, Jared DeRoss, had made the stop work order during the management meeting held daily at 7:15am."
                            }
                        ]
                    }
