                "senses": [
                    {
                        "sense_id": "47db4086-c117-356b-8b93-706578298c04",
                        "entry_id": "a6f3f630-120e-33c7-8f80-3b7052949b4e",
                        "glosses": [
                            "aus Metall hergestellter Rahmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d195a736-70ea-45f8-b1d0-72f0fc87664a",
                                "sense_id": "47db4086-c117-356b-8b93-706578298c04",
                                "text": "„Die Wachen setzten ihn auf den freien Stuhl und fesselten ihn mit Händen und Füßen an den Metallrahmen.“"
                            },
                            {
                                "example_id": "0024b052-b2f8-4078-a899-4fb34770c6ab",
                                "sense_id": "47db4086-c117-356b-8b93-706578298c04",
                                "text": "„Der Metallrahmen zur Befestigung der Aufsätze, die Haken und Ösen, an denen Seilwinden angebracht werden können, das alles lässt sich mit wenigen Handgriffen unter Holzabdeckungen verbergen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
