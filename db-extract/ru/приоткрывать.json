                "translations": [
                    {
                        "translation_id": "1dea61dd-d0ef-4386-96c7-16f8a5dbd881",
                        "source_entry_id": "55a53808-bcd7-3392-b4c5-c5327236954a",
                        "source_sense_id": "33caab05-6809-3f08-b055-76b463bdf032",
                        "target_lang_word": "entrouvrir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrouvrir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db7fdf54-2b5d-3e86-bb39-a79b9288f2c6",
                                        "entry_id": "6d14f60c-d3b7-3278-a5c9-b076529d0cf7",
                                        "glosses": [
                                            "Ouvrir en partie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc19523-6c88-4c64-8280-111821d3290c",
                                                "sense_id": "db7fdf54-2b5d-3e86-bb39-a79b9288f2c6",
                                                "text": "Je n’en perdais pas une broquille de toute cette bidoche exposée, de ces mamelles volumineuses, de ces cuisses grasses, vergeturées, s’entrouvrant sur des paysages insoupçonnés."
                                            },
                                            {
                                                "example_id": "abcd9937-0d7c-45b5-bce0-f52b57326b82",
                                                "sense_id": "db7fdf54-2b5d-3e86-bb39-a79b9288f2c6",
                                                "text": "Pour prévenir toute intervention intempestive du service d'ordre, Kimdall utilisa le langage universel pour se débarrasser des chieurs : elle entrouvrit son manteau et montra son colt. Les plantons la laissèrent passer sans moufter."
                                            },
                                            {
                                                "example_id": "006a3c0a-4538-41e4-a404-b7b563c3e5b6",
                                                "sense_id": "db7fdf54-2b5d-3e86-bb39-a79b9288f2c6",
                                                "text": "Le vin délie la langue, il entrouvre le cœur\nIl donnera ce soir le ton et la couleur\nRouge ardent de la braise et cristal du désir\nÀ notre nuit d’amour, buvons pour le plaisir !"
                                            },
                                            {
                                                "example_id": "c58e6f9b-0108-4497-8073-9e4380382f45",
                                                "sense_id": "db7fdf54-2b5d-3e86-bb39-a79b9288f2c6",
                                                "text": "Le Comité consultatif national d’éthique (CCNE) venait d’entrouvrir la porte à un accès à l’aide active à mourir, sous conditions strictes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc12f4c-4520-31de-af1d-a2b371677721",
                                        "entry_id": "6d14f60c-d3b7-3278-a5c9-b076529d0cf7",
                                        "glosses": [
                                            "Écarter les jambes dans un mouvement violent qui provoque l’entrouverture."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
