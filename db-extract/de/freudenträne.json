                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a91a56d-bb12-3c96-bdf5-a3a24e0b62cb",
                        "entry_id": "18beab03-106d-3e24-9bc0-bf71cc2b61f8",
                        "glosses": [
                            "eine Träne aus dem Gefühl tiefer Freude oder Dankbarkeit heraus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f379133a-3e4b-487c-a29b-9d56d0b0cf98",
                                "sense_id": "5a91a56d-bb12-3c96-bdf5-a3a24e0b62cb",
                                "text": "Über den Gewinn weinten wir Freudentränen."
                            },
                            {
                                "example_id": "32c5ef2f-e12d-47c2-a76d-0c9378d27b87",
                                "sense_id": "5a91a56d-bb12-3c96-bdf5-a3a24e0b62cb",
                                "text": "„Freudentränen schießen ihr in die Augen.“"
                            },
                            {
                                "example_id": "acada864-d39d-486b-bc11-7af811ae07ee",
                                "sense_id": "5a91a56d-bb12-3c96-bdf5-a3a24e0b62cb",
                                "text": "„In dem matten Halbdunkel hinter dem Vorhang glänzten ihre leuchtenden Augen noch heller als sonst: sie standen voller Freudentränen.“"
                            },
                            {
                                "example_id": "9fc287c4-f380-4bc7-b0fa-0d3d66fc5f88",
                                "sense_id": "5a91a56d-bb12-3c96-bdf5-a3a24e0b62cb",
                                "text": "„Sie war wirklich grenzenlos; doch im nächsten Moment fiel er mir um den Hals, küßte mich unter Freudentränen wohl zehnmal und sagte schließlich, er hätte die Hoffnung, mich wiederzusehen, bereits aufgegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
