                                "target_lang_sense_clarification": "деепричастие: с рычанием"
                            },
                            {
                                "target_lang_word": "огрызаясь",
                                "target_lang_sense_clarification": "деепричастие: злобно отвечая"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3e7f47df-8ac6-31bd-9953-df1d4fe300ff",
                    "sense_definition": "Growling viciously or displaying an aggressive, threatening expression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>snarling</w> dog scared me away without ever opening its mouth.",
                            "target_lang_translations": {
                                "ru": "<w>Рычащая</w> собака напугала меня, даже не раскрывая пасти."
                            }
                        },
                        {
                            "text": "We were suddenly confronted by a <w>snarling</w> beast blocking the path.",
                            "target_lang_translations": {
                                "ru": "Внезапно перед нами возник <w>скалящийся</w> зверь, преграждавший путь."
                            }
                        }
                    ],
                    "synonyms": [
                        "latrant"
                    ],
                    "common_phrases": [
                        "snarling dog",
                        "snarling beast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Злобно рычащий или имеющий агрессивное, угрожающее выражение (морды или лица)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычащий",
                                "target_lang_sense_clarification": "издающий агрессивный рык"
                            },
                            {
                                "target_lang_word": "скалящийся",
                                "target_lang_sense_clarification": "злобно скалящий зубы"
                            },
                            {
                                "target_lang_word": "оскаленный",
                                "target_lang_sense_clarification": "с угрожающим оскалом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29df77bb-f3eb-3193-8033-cf29a29936ea",
                    "sense_definition": "The act of making a vicious growl or angry sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>snarling</w> in the darkness made us freeze in our tracks.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>рычание</w> в темноте заставило нас застыть на месте."
                            }
                        },
                        {
                            "text": "We listened nervously to the distant <w>snarling</w> of wolves outside the cabin.",
                            "target_lang_translations": {
                                "ru": "Мы с тревогой прислушивались к доносившемуся снаружи хижины далекому <w>рычанию</w> волков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vicious snarling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Злобное рычание, оскал или сердитые звуки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычание",
                                "target_lang_sense_clarification": "звук злобного рыка"
                            },
                            {
                                "target_lang_word": "рык",
                                "target_lang_sense_clarification": "грозный крик или звук зверя"
                            },
                            {
                                "target_lang_word": "огрызание",
                                "target_lang_sense_clarification": "злобные звуки или реплики"
                            }
                        ]
                    }
                }
            ]
        }
    ]
