                "senses": [
                    {
                        "sense_id": "47cde461-21a9-3e34-8696-05687e893414",
                        "entry_id": "2cbd39f9-0331-397c-a707-52cbb059ba0b",
                        "glosses": [
                            "körnige oder pulverige Substanz aus zerkleinertem Glas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "030e1f14-125b-4d4f-bbf0-eef881e483f6",
                                "sense_id": "47cde461-21a9-3e34-8696-05687e893414",
                                "text": "„Man mischt der zu schmelzenden Substanz eine Spur Glaspulver von einem bekannen Brechungsindex zu und bestimmt normalerweise den Schmelzpunkt.“"
                            },
                            {
                                "example_id": "5afa205f-ed1d-4aa0-bd96-57358248da9c",
                                "sense_id": "47cde461-21a9-3e34-8696-05687e893414",
                                "text": "„Das im Mörser zerstossene Glaspulver befreit man durch ein etwas gröberes Sieb von zu grossen Körnchen, durch Waschen in Wasser und Decantiren von zu kleinen.“"
                            },
                            {
                                "example_id": "139a01a0-a7cb-4b37-a0d5-ad268373d627",
                                "sense_id": "47cde461-21a9-3e34-8696-05687e893414",
                                "text": "„Glaspulver und Braunstein müssen außerordentlich fein geschlämmt werden, ebenso der Schwefelkies.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
