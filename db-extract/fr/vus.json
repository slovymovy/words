                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f962e04-6d76-3bb6-b9af-54faa38eceb4",
                        "entry_id": "3ab948db-9d11-39a3-b099-86a6cb633607",
                        "glosses": [
                            "Véhicule de grand gabarit, haut sur roues, conçu en principe pour la circulation hors piste mais couramment utilisé pour des déplacements urbains usuels."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "01c844f7-0104-447f-9047-a964de12e888",
                                "sense_id": "6f962e04-6d76-3bb6-b9af-54faa38eceb4",
                                "text": "Le conducteur du taxi a été hospitalisé, mais on ignore ce qui est advenu du conducteur du VUS, qui avait déjà quitté les lieux 20 minutes après la collision."
                            },
                            {
                                "example_id": "c9399204-8328-47d2-8232-86582b72aa07",
                                "sense_id": "6f962e04-6d76-3bb6-b9af-54faa38eceb4",
                                "text": "Le suspect a toutefois fini par lâcher prise et a finalement jeté son dévolu sur un VUS qui roulait au ralenti à côté de lui. Sur les images, on peut l’apercevoir frapper de toutes ses forces sur le capot du véhicule avant de réussir à monter sur le toit."
                            },
                            {
                                "example_id": "c9d9502f-6074-47f5-864b-ed509b34212c",
                                "sense_id": "6f962e04-6d76-3bb6-b9af-54faa38eceb4",
                                "text": "Les Américains conduisent plus que nos homologues mondiaux, mais nous sommes également plus nombreux à conduire des camions et des VUS, qui sont deux à trois fois plus susceptibles que les petits véhicules personnels de tuer des piétons."
                            }
                        ]
                    }
