                        "cross_references": [
                            {
                                "target_word": "статуэ́тка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                                        "entry_id": "924aba42-20ee-3eaa-8c20-12d7a7941e95",
                                        "glosses": [
                                            "небольшая скульптурная фигурка, обычно служащая комнатным украшением"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5bd2893-c640-45db-b205-98af2c3a6f8c",
                                                "sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                                                "text": "Я вам вышью феску, а вы мне… позвольте, вы мне подарите ту статуэтку из терракоты, помните, — ребёнка, который снимает с ноги чулок и падает."
                                            },
                                            {
                                                "example_id": "98e9b2c0-98d3-4845-a45a-16cec6a8b12f",
                                                "sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                                                "text": "Я просто хочу любоваться тобой, как статуэткой."
                                            },
                                            {
                                                "example_id": "9807f302-a15e-44d3-adcd-ae98fcfa1de5",
                                                "sense_id": "e7b8d784-433b-3b83-8343-3eb88b60a5eb",
                                                "text": "Храм был заставлен жертвенниками, многорукими статуями, этажерками с грудами статуэток бодисатв."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
