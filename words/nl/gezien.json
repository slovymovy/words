                    "frequency": "High",
                    "semantic_group_id": "overweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Gezien</w> de omstandigheden hebben we besloten om het feestje binnen te vieren.",
                            "target_lang_translations": {
                                "en": "<w>Given</w> the circumstances, we decided to celebrate the party indoors.",
                                "ru": "<w>Учитывая</w> обстоятельства, мы решили отпраздновать вечеринку в помещении.",
                                "it": "<w>Date</w> le circostanze, abbiamo deciso di festeggiare la festa al chiuso."
                            }
                        },
                        {
                            "text": "<w>Gezien</w> zijn ouderdom is deze zware medische behandeling geen goed idee.",
                            "target_lang_translations": {
                                "en": "<w>Considering</w> his age, this heavy medical treatment is not a good idea.",
                                "ru": "<w>Ввиду</w> его возраста это тяжелое медицинское лечение — не лучшая идея.",
                                "it": "<w>Considerata</w> la sua età, questo pesante trattamento medico non è una buona idea."
                            }
