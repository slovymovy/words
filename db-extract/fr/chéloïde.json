                                    {
                                        "sense_id": "c2c2ec11-20d1-3704-ba6a-fa2d0a738eab",
                                        "entry_id": "70969905-7797-3cc8-9493-af2636842a0c",
                                        "glosses": [
                                            "A hard raised growth of scar tissue at the site of an injury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "319fb756-7785-4fc7-86cc-9964e2ffa86e",
                                                "sense_id": "c2c2ec11-20d1-3704-ba6a-fa2d0a738eab",
                                                "text": "It gave her otherwise plain face a broken excitement and blue-blade threat like the keloid scar of the razored man who sometimes played checkers with her grandmother."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "keloid",
                                "target_lang_code": "en",
