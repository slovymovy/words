                                        "examples": [
                                            {
                                                "example_id": "aab100c7-24ae-4134-b67e-fbdb5f021713",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
                                                "text": "l'epopea dei Templari, incominciata il 13 ottobre 1307, fini con Filippo il Bello che li fece arrestare"
                                            },
                                            {
                                                "example_id": "9b5465a0-9a7d-4f2e-b484-c7479d049bf9",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
                                                "text": "Gilgamesh è espressione dell'epopea mesopotamica"
                                            },
                                            {
                                                "example_id": "5b7c0480-f1de-4365-a996-d698e24d8af3",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
                                                "text": "l'Iliade e l'Odissea sono espressione dell'epopea greca"
                                            },
                                            {
                                                "example_id": "ff31067a-d8b2-4000-abe0-9f9079ca66b7",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
                                                "text": "l'Eneide è espressione dell'epopea romana"
                                            },
                                            {
                                                "example_id": "9dc5bf4b-3396-45c9-bdc0-19a71d48b536",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
                                                "text": "la Canzone di Orlando è espressione dell'epopea francese"
                                            },
                                            {
                                                "example_id": "cbb0731e-894b-43ae-a73b-7c1316529cb3",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
