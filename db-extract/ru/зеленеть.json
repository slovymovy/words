                ],
                "senses": [
                    {
                        "sense_id": "1a6acbfa-b7d0-36c6-bb5e-d90f432f004a",
                        "entry_id": "9af122f2-9cd2-3bb7-925c-5400e07d59cb",
                        "glosses": [
                            "иметь отчётливый зелёный цвет, выделяться зелёным цветом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "836a1abb-79a4-4d84-b7fb-935fa2f4556a",
                                "sense_id": "1a6acbfa-b7d0-36c6-bb5e-d90f432f004a",
                                "text": "Похоже, это была деревня — новая изгородь из еловых жердей, за которой зеленело картофлянище, высился прикрытый рядюжкой стожок свежего сена возле сарая."
                            },
                            {
                                "example_id": "d80e276d-5fbc-4d69-9b79-a829ba90fc62",
                                "sense_id": "1a6acbfa-b7d0-36c6-bb5e-d90f432f004a",
                                "text": "Там, где сквозь неглубокую воду просвечивали мели, море угрюмо зеленело."
                            }
                        ]
                    },
                    {
                        "sense_id": "771f8a80-5aab-35e5-a1d0-07ff93635419",
                        "entry_id": "9af122f2-9cd2-3bb7-925c-5400e07d59cb",
                        "glosses": [
                            "приобретать зелёный цвет, становиться зелёным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be53829e-9918-4e8d-ac55-24a1c263efd1",
                                "sense_id": "771f8a80-5aab-35e5-a1d0-07ff93635419",
                                "text": "Только одна Маришка представляла резавшее глаз исключение: всё лицо у нее вздулось под один багровый пузырь, начинавший зеленеть по краям."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d50e526-a7fc-3839-be75-1df443095e3c",
                        "entry_id": "9af122f2-9cd2-3bb7-925c-5400e07d59cb",
                        "glosses": [
                            "покрываться зеленью, травою, листвою; становиться зелёным от растительности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe846546-299d-4e3b-83c5-dee5ef387e81",
                                "sense_id": "2d50e526-a7fc-3839-be75-1df443095e3c",
                                "text": "Когда эта дверь открывается, видна часть двора с только начинающими зеленеть деревьями, яркой травой, надворными постройками."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f935f37-6d40-4c8b-b119-e5a9fab786c7",
                        "source_entry_id": "9af122f2-9cd2-3bb7-925c-5400e07d59cb",
                        "source_sense_description": "становиться зелёным",
                        "target_lang_word": "verdir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c193bc2-b922-3539-912c-742c96779864",
                                        "entry_id": "6e412f8f-5ded-3d34-870c-dded1ddc0bbf",
                                        "glosses": [
                                            "Rendre vert, colorer en vert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ffb748-6957-4116-a706-bd92cd2b63c9",
                                                "sense_id": "7c193bc2-b922-3539-912c-742c96779864",
                                                "text": "Cette pierre est verdie par l’humidité."
                                            },
                                            {
                                                "example_id": "05e3be96-d1c4-47cc-a183-2994fc7b3425",
                                                "sense_id": "7c193bc2-b922-3539-912c-742c96779864",
                                                "text": "En face se verdit à la pluie un de ces bons vieux calvaires bretons, ciselés, sculptés, portant fleurons et personnages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03360a32-b777-3ac9-93b2-5ab4d30c9ee3",
                                        "entry_id": "6e412f8f-5ded-3d34-870c-dded1ddc0bbf",
                                        "glosses": [
                                            "Devenir vert."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6890700-0e07-405c-83f5-1d9278088dd2",
                                                "sense_id": "03360a32-b777-3ac9-93b2-5ab4d30c9ee3",
                                                "text": "Les arbres commencent à verdir."
                                            },
                                            {
                                                "example_id": "306b827c-dee5-4cc5-81d5-b7ef80e3d3bf",
                                                "sense_id": "03360a32-b777-3ac9-93b2-5ab4d30c9ee3",
                                                "text": "Si on n’a pas soin de nettoyer souvent le cuivre, il verdit."
                                            },
                                            {
                                                "example_id": "0dd560ae-d63d-4055-b5ce-1c7b1152e566",
                                                "sense_id": "03360a32-b777-3ac9-93b2-5ab4d30c9ee3",
                                                "text": "Le pont offrait le spectacle le plus lamentable ; les femmes, si charmantes tout à l’heure, verdissaient comme des noyés de huit jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb50de88-cbce-33f3-a48f-312c138b8fcf",
                                        "entry_id": "6e412f8f-5ded-3d34-870c-dded1ddc0bbf",
                                        "glosses": [
                                            "Rendre écologique."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23df92fa-ac7c-4f77-ac92-4b4e1584913f",
                                                "sense_id": "cb50de88-cbce-33f3-a48f-312c138b8fcf",
                                                "text": "L’examen du texte s’inscrit aussi dans un moment politique particulier, marqué par la montée du vote écologique et la mobilisation grandissante des citoyens pour le climat. Ce contexte va probablement inciter la majorité à « verdir » le texte lors de la discussion en séance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0900496f-4b84-3f07-b98c-8585876d948a",
                                        "entry_id": "6e412f8f-5ded-3d34-870c-dded1ddc0bbf",
                                        "glosses": [
                                            "Devenir écologique."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e23af82c-a509-45f2-a269-1db72a57a0d6",
                                                "sense_id": "0900496f-4b84-3f07-b98c-8585876d948a",
                                                "text": "« Il n’y aura que très peu de nouveaux métiers, mais une nécessaire adaptation des pratiques professionnelles pour les métiers très nombreux appelés à “se verdir” », selon le COE, qui insiste par ailleurs sur la nécessité, en amont, d’un « plan Marshall de la formation »."
                                            },
                                            {
                                                "example_id": "3cdc6638-6433-4840-abc4-ef4fc1f26c42",
                                                "sense_id": "0900496f-4b84-3f07-b98c-8585876d948a",
                                                "text": "En France, l’écologie est à présent la première cause de mobilisation chez les jeunes. Partout en Europe, elle progresse, autorisant des actions concrètes, notamment au Parlement européen, qui s’est considérablement verdi lors du dernier scrutin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
