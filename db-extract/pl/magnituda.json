                    },
                    {
                        "translation_id": "752a050e-2e85-40db-a4f7-5326a75351ec",
                        "source_entry_id": "309e194c-7eaa-3654-8a59-7ec8a805aff6",
                        "source_sense_id": "f9d90907-0e60-31e3-8c82-0638955ae40c",
                        "target_lang_word": "Magnitude",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magnitude",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f72ac88-b4ab-3138-9f30-d21877d0bdb8",
                                        "entry_id": "e15d9a3d-80f6-33d4-925c-716a96113942",
                                        "glosses": [
                                            "Maß für die Stärke von Erdbeben"
                                        ],
                                        "tags": [
                                            "Geophysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebc7835a-8fdd-410a-b38c-066a3bc70920",
                                                "sense_id": "9f72ac88-b4ab-3138-9f30-d21877d0bdb8",
                                                "text": "„Das Erdbeben von Valdivia am 22. Mai 1960, auch Großes Chile-Erdbeben genannt, war das Erdbeben mit der weltweit größten jemals aufgezeichneten Magnitude und das schwerste Erdbeben des 20. Jahrhunderts.“"
                                            },
                                            {
                                                "example_id": "44b23d0f-f3bf-44ff-91f2-612acbb18a1e",
                                                "sense_id": "9f72ac88-b4ab-3138-9f30-d21877d0bdb8",
                                                "text": "„Die Magnitude des stärksten Nachbebens liegt normalerweise eine Größenordnung unter der des Hauptbebens. Nach dieser Faustregel treten bei einem Beben der Magnitude 7 Nachbeben auf, die maximal Magnitude 6 erreichen.“"
                                            },
                                            {
                                                "example_id": "de590b7d-5433-413c-90b5-ab5e12077884",
                                                "sense_id": "9f72ac88-b4ab-3138-9f30-d21877d0bdb8",
                                                "text": "„Die Magnitude des Bebens wurde zunächst mit 8,8 angegeben, um kurz darauf auf 9,0 korrigiert zu werden. Erdbeben dieser Magnitude richten großflächige Zerstörungen über Hunderte von Kilometern an. Sie sind äußerst selten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18faf691-8cf8-3a87-8ed2-fad113d2a98a",
                                        "entry_id": "e15d9a3d-80f6-33d4-925c-716a96113942",
                                        "glosses": [
                                            "Maß für die scheinbare Helligkeit eines Sterns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e00169d5-2c5c-4852-bd6d-02be2b276e09",
                                                "sense_id": "18faf691-8cf8-3a87-8ed2-fad113d2a98a",
                                                "text": "„Die absolute Magnitude misst die dem Stern innewohnende Leuchtkraft bei einer Entfernung von 10pc, sie ist somit der Helligkeit des Sterns vergleichbar. Eine Gruppe von ‚Einheitssternen‘ mit festgelegter Magnitude dient als Messgröße.“"
                                            },
                                            {
                                                "example_id": "c918ea27-4e1f-483a-9776-9ca6127eba71",
                                                "sense_id": "18faf691-8cf8-3a87-8ed2-fad113d2a98a",
                                                "text": "„Die Magnitude stellt eine logarithmische Kennzahl für die Leuchtkraft eines Sternes dar.“"
                                            },
                                            {
                                                "example_id": "4c2624b6-a595-4d08-b3e2-4349137d9bdf",
                                                "sense_id": "18faf691-8cf8-3a87-8ed2-fad113d2a98a",
                                                "text": "„Damit stellt sich die Frage, wie groß ist die Magnitude der hellsten Sterne? “"
                                            },
                                            {
                                                "example_id": "ecc135ec-b279-4952-80d8-57096da6dd23",
                                                "sense_id": "18faf691-8cf8-3a87-8ed2-fad113d2a98a",
                                                "text": "„Das hat zur Folge, dass Sterne umso heller sind, je kleiner ihre Magnitude ist. Ein Stern der Magnitude 1,5 ist also um eine Magnitude heller als ein Stern mit 2,5 Magnituden, und um 0,5 Magnituden schwächer als ein Stern von einer Magnitude.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "56543758-3c8c-32d0-9af6-99669b55aaea",
                                        "entry_id": "e15d9a3d-80f6-33d4-925c-716a96113942",
                                        "glosses": [
                                            "Maß für die Stärke/Intensität von etwas"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c432d6c2-780d-4cf3-b316-ff29f1dd1860",
                                                "sense_id": "56543758-3c8c-32d0-9af6-99669b55aaea",
                                                "text": "„Es bedurfte einer historischen Zeitenwende von der Magnitude des Zweiten Weltkriegs, damit das menschliche Sprachvermögen wieder ihre Aufmerksamkeit erregte.“"
                                            },
                                            {
                                                "example_id": "e6fe53a4-e434-429c-96c9-564c667c6607",
                                                "sense_id": "56543758-3c8c-32d0-9af6-99669b55aaea",
                                                "text": "„Die Schwere der Markenkrise bestimmt sich vor allem über die Magnitude des Markenkrisenevents.“"
                                            },
                                            {
                                                "example_id": "6158aebe-4022-4767-8a3a-1fe53b6de821",
                                                "sense_id": "56543758-3c8c-32d0-9af6-99669b55aaea",
                                                "text": "„Die Magnitude des Meeresspiegelabfalles ist bedeutend, es kommt zur Emersion der Altamira-Plattform, dem Einschneiden von Paläotälern […] und einer kurzfristigen Rejuvenation deltaischer Sedimentation […].“"
                                            },
                                            {
                                                "example_id": "78366b7c-340a-4995-972a-5309a45f88eb",
                                                "sense_id": "56543758-3c8c-32d0-9af6-99669b55aaea",
                                                "text": "„Der Zeitraum, für den die Daten statistisch analysiert werden, bestimmt die Magnitude der Trends und ihre Signifikanz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
