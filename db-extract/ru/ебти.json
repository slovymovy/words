                    },
                    {
                        "sense_id": "9366427b-2a28-3357-aa3f-f9c5f2b98b67",
                        "entry_id": "59d103b7-9f03-3ab4-95f4-d7fb9426061a",
                        "glosses": [
                            "обсц., перен. эксплуатировать; заставлять работать, принуждать к выполнению обязанностей; наказывать, выносить взыскание"
                        ],
                        "tags": [
                            "кого."
                        ],
                        "examples": [
                            {
                                "example_id": "d8ac29cb-e971-4709-b508-1ddb91653069",
                                "sense_id": "9366427b-2a28-3357-aa3f-f9c5f2b98b67",
                                "text": "Кто видел в море корабли, — // Не на конфетном фантике, // Кого ебли, как нас ебли, — // Тому не до романтики!"
                            }
                        ]
                    }
