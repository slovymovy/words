                        "form": "fountainheads"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26525891-9266-3672-9061-1be457d0690b",
                        "entry_id": "94d6deb3-47f5-39aa-beb7-9c80b17d7833",
                        "glosses": [
                            "A spring that is the source of a river."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a48576e0-74fc-3552-95ac-9ff0c7e7ffa9",
                        "entry_id": "94d6deb3-47f5-39aa-beb7-9c80b17d7833",
                        "glosses": [
                            "An abundant source of knowledge, etc."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6063c37d-d589-491a-900a-7c9a14cbcea5",
                        "source_entry_id": "94d6deb3-47f5-39aa-beb7-9c80b17d7833",
                        "source_sense_description": "a spring that is the source of a river",
                        "target_lang_word": "Quelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8673b194-d52a-332f-9890-db8280a43f34",
                                        "entry_id": "31e76ce5-acdd-3203-8b2b-6a1c63f48ddb",
                                        "glosses": [
                                            "Ursprung eines Flusses, fließenden Gewässers; Ort des augenscheinlichen oberirdischen Austritts von Gewässern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d89e4c2c-47d4-456b-9675-587bdf641387",
                                                "sense_id": "8673b194-d52a-332f-9890-db8280a43f34",
                                                "text": "Die Quelle der Elbe liegt in Tschechien."
                                            },
                                            {
                                                "example_id": "5d34f3e6-6ce0-4a9d-acf0-a1bc4d32cec3",
                                                "sense_id": "8673b194-d52a-332f-9890-db8280a43f34",
                                                "text": "„Später hielten wir bei einer Quelle am Straßenrand, um Peg zu tränken, und ich schlug vor, dort zu essen.“"
                                            },
                                            {
                                                "example_id": "16fa9d31-7d1c-4833-a55c-0ee26de9e780",
                                                "sense_id": "8673b194-d52a-332f-9890-db8280a43f34",
                                                "text": "„Als der Franzose die Quelle im Januar 1909 besucht hatte, also mitten in der Trockenzeit, war das oberste Becken leer.“"
                                            },
                                            {
                                                "example_id": "b4e8c5c3-dcad-40d7-80ad-9999d40c0c9b",
                                                "sense_id": "8673b194-d52a-332f-9890-db8280a43f34",
                                                "text": "„Zusätzliche Mauern gliederten eine Quelle in die Stadt ein und garantierten damit ihre Wasserversorgung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63acfce8-fa0e-3952-a0dc-e7235b44a128",
                                        "entry_id": "31e76ce5-acdd-3203-8b2b-6a1c63f48ddb",
                                        "glosses": [
                                            "Ursprung von etwas Bestimmten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37761689-f1a8-4311-9eac-ba70065c7b32",
                                                "sense_id": "63acfce8-fa0e-3952-a0dc-e7235b44a128",
                                                "text": "Ich brauche einen Arzt, der wirklich die Quelle meines Leidens sucht."
                                            },
                                            {
                                                "example_id": "64f9be4f-fccd-4032-af86-e685b6541744",
                                                "sense_id": "63acfce8-fa0e-3952-a0dc-e7235b44a128",
                                                "text": "„Unbestreitbar ist: Nach der Stromerzeugung ist der Bereich Transport mit 20 Prozent die zweitgrößte Quelle von Treibhausgasen weltweit“ […]."
                                            },
                                            {
                                                "example_id": "7c0e4e22-1382-4f90-b69c-a30413035031",
                                                "sense_id": "63acfce8-fa0e-3952-a0dc-e7235b44a128",
                                                "text": "„Ben hatte die Forschung zum Thema, Amalia den mysteriösen Zugang zur Quelle, und vom einen ließ sich nicht auf das andere schließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c2e30049-f41b-3f0a-8262-94ddef224cf6",
                                        "entry_id": "31e76ce5-acdd-3203-8b2b-6a1c63f48ddb",
                                        "glosses": [
                                            "wissenschaftlich auswertbares Primärmaterial"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "892d4522-7c41-4f69-bf24-fdee9ee8de49",
                                                "sense_id": "c2e30049-f41b-3f0a-8262-94ddef224cf6",
                                                "text": "Die Herkunft des Wortes ist durch Angabe einer Quelle zu belegen."
                                            },
                                            {
                                                "example_id": "2e1280c9-7461-4b6e-8e13-9b57ac848a7c",
                                                "sense_id": "c2e30049-f41b-3f0a-8262-94ddef224cf6",
                                                "text": "„Manche Quellen behaupten deshalb, der hölzerne Rumpf des Schiffes sei schon rott gewesen.“"
                                            },
                                            {
                                                "example_id": "092d98f6-2023-41d9-9260-cf3e7f39f3b9",
                                                "sense_id": "c2e30049-f41b-3f0a-8262-94ddef224cf6",
                                                "text": "„Wie wir nachgewiesen haben, extrahierte er aus mindestens siebzehn Quellen etwa hundert konkrete Einzelheiten.“"
                                            },
                                            {
                                                "example_id": "ec4b09f1-e972-47ae-a169-7f3c854f74f4",
                                                "sense_id": "c2e30049-f41b-3f0a-8262-94ddef224cf6",
                                                "text": "„Die frühesten Quellen erwähnen meist nur einzelne Kaufleute, die im Fernhandel tätig waren, einige von ihnen mit Familie.“"
                                            },
                                            {
                                                "example_id": "0fffe5e8-dc78-4bcd-9486-f524de3be4fe",
                                                "sense_id": "c2e30049-f41b-3f0a-8262-94ddef224cf6",
                                                "text": "„Diese Konvention fördert den Überblick über die Quellen und Standpunkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b28defbb-b3ca-3741-8d4d-eddefb3946cd",
                                        "entry_id": "31e76ce5-acdd-3203-8b2b-6a1c63f48ddb",
                                        "glosses": [
                                            "Person, die über direkte Informationen verfügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e97142c-87eb-4cd2-82b4-e4e61f53e35e",
                                                "sense_id": "b28defbb-b3ca-3741-8d4d-eddefb3946cd",
                                                "text": "Der Zeuge war eine wichtige Quelle für die Aufklärung des Falles."
                                            },
                                            {
                                                "example_id": "7eac1960-9956-4958-af8a-f932652e907b",
                                                "sense_id": "b28defbb-b3ca-3741-8d4d-eddefb3946cd",
                                                "text": "„Wie jeder Agent kann ich natürlich meine Quellen nicht preisgeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0ce55be1-778e-37d2-a742-6df5b89bc8af",
                                        "entry_id": "31e76ce5-acdd-3203-8b2b-6a1c63f48ddb",
                                        "glosses": [
                                            "Ausgangspunkt einer Strömung bei Vektorfeldern mit positiver Divergenz (das Gegenteil einer )"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "849aa26f-f9ed-4c51-85d2-9e7046ff3e44",
                                                "sense_id": "0ce55be1-778e-37d2-a742-6df5b89bc8af",
                                                "text": "„Ist die Divergenz positiv, so handelt es sich bei dem betrachteten Punkt um eine Quelle.“"
                                            },
                                            {
                                                "example_id": "1be1a77a-c04a-42bf-b798-a8900219205e",
                                                "sense_id": "0ce55be1-778e-37d2-a742-6df5b89bc8af",
                                                "text": "„Die Divergenz eines Vektorfeldes ist also ein Maß für die Existenz von Quellen oder Senken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c903fcc4-a742-4106-bc95-9361e453b888",
                        "source_entry_id": "94d6deb3-47f5-39aa-beb7-9c80b17d7833",
                        "source_sense_description": "an abundant source of knowledge, etc.",
                        "target_lang_word": "Ursprung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ursprung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "646e0cdc-b1fd-32b6-9394-fe502e64d5d0",
                                        "entry_id": "67e73dbc-7bc1-373d-aec2-6c80433332d1",
                                        "glosses": [
                                            "Zeitpunkt, Ort oder Material, aus dem etwas hervorgegangen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fdefe33-769b-4a04-b773-946111282f84",
                                                "sense_id": "646e0cdc-b1fd-32b6-9394-fe502e64d5d0",
                                                "text": "Der Ursprung der Sprachen liegt im Dunkeln."
                                            },
                                            {
                                                "example_id": "3ff01b20-40d1-41a7-803f-4e30a76c4288",
                                                "sense_id": "646e0cdc-b1fd-32b6-9394-fe502e64d5d0",
                                                "text": "„Sie ist eine geborene Grönländerin, was bedeutet, dass sich einige friesische und dänische Einflüsse mit den asiatischen Ursprüngen mischen.“"
                                            },
                                            {
                                                "example_id": "985a9c53-397a-481a-a3e0-49bd1062c05b",
                                                "sense_id": "646e0cdc-b1fd-32b6-9394-fe502e64d5d0",
                                                "text": "„Als hingebungsvoller Naturforscher hatte er ein noch weit größeres Problem, nämlich die riesigen Beweislücken, die zwischen seinen Ideen vom Ursprung der Sprache klafften, wiewohl sie es doch war, die das menschliche Verhalten so grundlegend von jedem tierischen unterschied.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "969f97a7-07f4-3c7b-ad82-71be01ea35c6",
                                        "entry_id": "67e73dbc-7bc1-373d-aec2-6c80433332d1",
                                        "glosses": [
                                            "Schnittpunkt der Koordinatenachsen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
