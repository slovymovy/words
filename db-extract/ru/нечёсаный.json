                                "target_senses": [
                                    {
                                        "sense_id": "486f937e-1fde-35d5-8365-1ee832329f2e",
                                        "entry_id": "0003adb4-34fe-3124-9000-03411101e789",
                                        "glosses": [
                                            "Uncombed; dishevelled."
                                        ],
                                        "tags": [
                                            "of hair"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22434783-1dea-4b01-97a9-933a49a434b5",
                                                "sense_id": "486f937e-1fde-35d5-8365-1ee832329f2e",
                                                "text": "Men on cycles, lean-faced, unkempt, scorched along every country lane, shouting of unhoped deliverance, shouting to gaunt, staring figures of despair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e773fd79-c847-3e23-a6fc-fa7100e36339",
                                        "entry_id": "0003adb4-34fe-3124-9000-03411101e789",
                                        "glosses": [
                                            "Disorderly; untidy; messy; not kept up."
                                        ],
