                                    {
                                        "sense_id": "25188f8b-68ab-3e08-bb5e-dbc5dd858344",
                                        "entry_id": "5ec91990-6936-393a-82bd-3ab86d35907d",
                                        "glosses": [
                                            "Glocke, die zum Trauergottesdienst, zur Beisetzung und/oder zum Schiedzeichen geläutet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0da28a43-600e-4dd6-af4f-3db585a0383d",
                                                "sense_id": "25188f8b-68ab-3e08-bb5e-dbc5dd858344",
                                                "text": "Man hörte auf dem Friedhof die Totenglocke läuten."
                                            }
