                        "glosses": [
                            "Qui possède des gènes identiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff0baddc-5c24-4be5-8b58-a42596f146e8",
                                "sense_id": "9bb1986f-3eb1-3196-ab1b-efe9be41c801",
                                "text": "Même si les individus étudiés sont détruits au cours de l’expérience, on dispose toujours des frères et sœurs isogéniques de la lignée."
                            },
                            {
                                "example_id": "7e53f70e-6574-4703-bd2c-95c843fd7090",
                                "sense_id": "9bb1986f-3eb1-3196-ab1b-efe9be41c801",
                                "text": "La conversion directe d’une cellule différenciée en une autre – un processus appelé transdifférenciation – serait bénéfique pour la production de cellules isogéniques (les propres cellules du patient) afin de remplacer les tissus ou les cellules malades ou endommagées."
                            }
                        ]
                    }
