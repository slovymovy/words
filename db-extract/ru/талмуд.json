                "senses": [
                    {
                        "sense_id": "898bdd89-988d-30ac-a5e0-e6cb01a4c931",
                        "entry_id": "a2e95606-54e8-3759-85e5-c1f7758f8c91",
                        "glosses": [
                            "религ. свод правовых и религиозно-этических положений иудаизма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb58d556-2826-487c-bc86-4a7a7b528e6e",
                                "sense_id": "898bdd89-988d-30ac-a5e0-e6cb01a4c931",
                                "text": "Речь идет о традиционном еврейском религиозном образовании, основой которого является изучение Писания с комментариями (на древнееврейском) и Талмуда (на арамейском языке)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a4b2e90-1ea0-42ae-a058-9a2e3c97b20d",
                        "source_entry_id": "a2e95606-54e8-3759-85e5-c1f7758f8c91",
                        "source_sense_id": "898bdd89-988d-30ac-a5e0-e6cb01a4c931",
                        "target_lang_word": "Talmud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Talmud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "065a5350-5a91-32fa-a5a5-bd8a2b8444ad",
                                        "entry_id": "a29f3199-b7ec-315c-b68c-f114bcc64093",
                                        "glosses": [
                                            "A collection of Jewish writings related to the practical application of Judaic law and tradition (may refer to either the Babylonian Talmud or the shorter Jerusalem Talmud)."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "885ab332-d682-4b75-a95d-811f84197c3f",
                                                "sense_id": "065a5350-5a91-32fa-a5a5-bd8a2b8444ad",
                                                "text": "On any given Friday night at the Claremont Colleges, between 15 and 20 Jewish students gather to sing wordless melodies, dive into textual study of Talmud or James Baldwin, or hold workshops on antisemitism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
