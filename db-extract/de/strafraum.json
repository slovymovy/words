                "senses": [
                    {
                        "sense_id": "af6296cf-39cc-3985-baa9-b7e6c1b7f6ca",
                        "entry_id": "1b33371c-5675-3c0e-96e5-908cb46e3a78",
                        "glosses": [
                            "durch Linien markierter Bereich um das Tor, in dem andere Regeln gelten, als für den Rest des Spielfeldes, zum Beispiel darf hier der Torwart den Ball mit den Händen berühren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c81df595-98ba-4c17-999f-410aa8daf9bc",
                                "sense_id": "af6296cf-39cc-3985-baa9-b7e6c1b7f6ca",
                                "text": "Das Foul im Strafraum führte zu einem Elfmeter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7aa03527-095d-4dbf-b807-713bb2943d0a",
                        "source_entry_id": "1b33371c-5675-3c0e-96e5-908cb46e3a78",
                        "source_sense_id": "af6296cf-39cc-3985-baa9-b7e6c1b7f6ca",
                        "target_lang_word": "penalty area",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penalty area",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6279d96d-931f-3413-9b73-9cd2e001277b",
                                        "entry_id": "715ef07d-5b84-3384-bf6c-2e9caddb569b",
                                        "glosses": [
                                            "An area of a pitch or field, inside which a penalty is given to the offensive team if a foul is made by the defensive team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8819f4ed-c012-4992-b088-f850beae4864",
                                                "sense_id": "6279d96d-931f-3413-9b73-9cd2e001277b",
                                                "text": "Racing out of his penalty area after a poor clearance, Haimov was beaten to the ball by Jerome, who rolled it to the waiting Shotton to fire a low shot past the goalkeeper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e42c0b4-e0b8-4391-af32-88867e64fe6f",
                        "source_entry_id": "1b33371c-5675-3c0e-96e5-908cb46e3a78",
                        "source_sense_id": "af6296cf-39cc-3985-baa9-b7e6c1b7f6ca",
                        "target_lang_word": "surface de réparation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surface de réparation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c2d8465-26e6-381c-b061-d10e29519548",
                                        "entry_id": "8f733b9d-adff-3037-9a6a-be09fd052890",
                                        "glosses": [
                                            "Zone située autour du but dans laquelle une faute commise par un défenseur sur un attaquant adverse entraine un penalty, et dans laquelle le gardien de but est autorisé à jouer le ballon de la main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5663a38c-9484-43a4-ad75-dfb82c243a5b",
                                                "sense_id": "2c2d8465-26e6-381c-b061-d10e29519548",
                                                "text": "Quelques minutes avant la fin de la première mi-temps, un joueur de Bordeaux crochète un Marseillais dans la surface de réparation. Je siffle le penalty indiscutable."
                                            },
                                            {
                                                "example_id": "f69fc9b5-5420-4047-bae2-9351fe20e6d9",
                                                "sense_id": "2c2d8465-26e6-381c-b061-d10e29519548",
                                                "text": "Deux minutes plus tard, un coup-franc à la limite de la surface de réparation, tiré par Vidot, échoue sur la transversale (13’)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38b70605-ee19-3e19-a329-bfa051f36381",
                                        "entry_id": "8f733b9d-adff-3037-9a6a-be09fd052890",
                                        "glosses": [
                                            "(En jouant sur les mots…) Lieu où il est possible de cicatriser une blessure physique ou morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4815d4cc-ce3e-4e4f-b2c9-0ff1d684d80d",
                                                "sense_id": "38b70605-ee19-3e19-a329-bfa051f36381",
                                                "text": "Je rêvais pour elle d’un temps apaisé, d’une surface de réparation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1d79c48-39e6-4cf7-9210-78844e19c379",
