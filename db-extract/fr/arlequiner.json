                "senses": [
                    {
                        "sense_id": "193ecfc8-85e7-3974-8c3d-cb0965e7d97c",
                        "entry_id": "af08e292-6d34-303c-97a0-719c0365cdf0",
                        "glosses": [
                            "Donner des couleurs variées, comme dans un habit d'Arlequin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f2baed5-1017-472f-801d-c931e4f4ad94",
                                "sense_id": "193ecfc8-85e7-3974-8c3d-cb0965e7d97c",
                                "text": "Ce procédé présente encore l'avantage inappréciable de pouvoir arlequiner ou teindre les palmes en 3, 4 et 5 nuances différentes, sans être obligé de rien couper ;"
                            },
                            {
                                "example_id": "796b1114-130b-450f-aa0e-90942a8332fb",
                                "sense_id": "193ecfc8-85e7-3974-8c3d-cb0965e7d97c",
                                "text": "Quels bleus et quels rouges, quels incarnats et quels ors intellectuels pourront jamais remplacer ma coloration noire et arlequiner ma personne morale si uniformément ténébreuse !"
                            }
                        ]
                    }
