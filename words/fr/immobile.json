                    "sense_id": "08ad70a3-bcaf-31b4-baf4-204f18ec12e7",
                    "sense_definition": "Qui ne bouge pas, qui demeure sans faire de mouvement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat reste <w>immobile</w> devant le buisson en attendant sa proie.",
                            "target_lang_translations": {
                                "en": "The cat stays <w>motionless</w> in front of the bush, waiting for its prey.",
                                "ru": "Кот остаётся <w>неподвижным</w> перед кустом, ожидая добычу.",
                                "nl": "De kat blijft <w>roerloos</w> voor de struik en wacht op zijn prooi.",
                                "de": "Die Katze bleibt <w>regungslos</w> vor dem Busch und wartet auf ihre Beute.",
                                "pl": "Kot pozostaje <w>nieruchomy</w> przed krzakiem, czekając na swoją zdobycz.",
                                "it": "Il gatto resta <w>immobile</w> davanti al cespuglio, in attesa della sua preda.",
                                "cs": "Kocour zůstává <w>nehybný</w> před keřem a čeká na svou kořist.",
                                "tr": "Kedi, avını beklemek için çalının önünde <w>hareketsiz</w> duruyor.",
                                "es": "El gato permanece <w>inmóvil</w> delante del arbusto, esperando a su presa.",
                                "zh": "猫在灌木丛前<w>一动不动</w>地等待着它的猎物。"
                            }
                        },
                        {
                            "text": "Les spectateurs sont demeurés <w>immobiles</w> pendant toute la durée du concert.",
                            "target_lang_translations": {
                                "en": "The spectators remained <w>motionless</w> for the entire length of the concert.",
                                "ru": "Зрители оставались <w>неподвижными</w> на протяжении всего концерта.",
                                "nl": "De toeschouwers bleven de hele duur van het concert <w>roerloos</w>.",
                                "de": "Die Zuschauer blieben während der gesamten Dauer des Konzerts <w>regungslos</w>.",
                                "pl": "Widzowie pozostawali <w>nieruchomi</w> przez cały czas trwania koncertu.",
                                "it": "Gli spettatori sono rimasti <w>immobili</w> per tutta la durata del concerto.",
                                "cs": "Diváci zůstali <w>nehybní</w> po celou dobu koncertu.",
                                "tr": "Seyirciler konserin tüm süresi boyunca <w>hareketsiz</w> kaldılar.",
                                "es": "Los espectadores permanecieron <w>inmóviles</w> durante toda la duración del concierto.",
                                "zh": "观众在整场音乐会期间都<w>一动不动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
