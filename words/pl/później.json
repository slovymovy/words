                    "sense_id": "07be4325-f81c-3a52-99f6-582930177590",
                    "sense_definition": "W czasie, który nastąpi po obecnej chwili lub po innym zdarzeniu.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Najpierw zjedz obiad, a <w>później</w> możesz iść się bawić.",
                            "target_lang_translations": {
                                "ru": "Сначала пообедай, а <w>потом</w> можешь идти играть.",
                                "en": "First eat your dinner, and <w>later</w> you can go play.",
                                "nl": "Eerst je avondeten opeten, en <w>later</w> mag je gaan spelen.",
                                "de": "Iss erst zu Mittag, und <w>später</w> kannst du spielen gehen.",
                                "fr": "D'abord mange ton déjeuner, et <w>plus tard</w> tu pourras aller jouer.",
                                "it": "Prima mangia, e <w>dopo</w> puoi andare a giocare.",
                                "cs": "Nejdřív se naobědvej a <w>potom</w> si můžeš jít hrát.",
                                "tr": "Önce yemeğini ye, <w>sonra</w> oynamaya gidebilirsin.",
                                "es": "Primero come, y <w>después</w> puedes ir a jugar.",
                                "zh": "先吃午饭，<w>然后</w>你就可以去玩了。"
                            }
                        },
                        {
                            "text": "Musimy to zrobić teraz, bo <w>później</w> nie będzie na to czasu.",
                            "target_lang_translations": {
                                "ru": "Мы должны сделать это сейчас, так как <w>позже</w> на это не будет времени.",
                                "en": "We must do this now, because <w>later</w> there won't be time for it.",
                                "nl": "We moeten dit nu doen, want <w>later</w> is er geen tijd meer voor.",
                                "de": "Wir müssen das jetzt erledigen, denn <w>später</w> wird keine Zeit dafür sein.",
                                "fr": "Nous devons le faire maintenant, car <w>plus tard</w> nous n'aurons pas le temps.",
                                "it": "Dobbiamo farlo ora, perché <w>dopo</w> non avremo tempo.",
                                "cs": "Musíme to udělat teď, protože <w>později</w> na to nebude čas.",
                                "tr": "Bunu şimdi yapmalıyız çünkü <w>daha sonra</w> buna vaktimiz olmayacak.",
                                "es": "Tenemos que hacerlo ahora, porque <w>más tarde</w> no habrá tiempo para ello.",
                                "zh": "我们现在必须做这件事，因为<w>以后</w>就没时间了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "potem",
                        "następnie"
                    ],
