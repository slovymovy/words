    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6608cf20-453d-34c0-9e73-6c564df2b87a",
                    "sense_definition": "To choose not to do something or to avoid an action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>forbore</w> to mention the mistake because I did not want to embarrass my colleague."
                        },
                        {
                            "text": "The committee decided to <w>forbear</w> from making any final decisions until the investigation was complete."
                        }
                    ],
                    "synonyms": [
                        "abstain",
                        "refrain",
                        "avoid"
                    ],
                    "antonyms": [
                        "indulge"
                    ],
                    "common_phrases": [
                        "forbear from"
                    ]
                },
                {
                    "sense_id": "e0ffd80d-6ad8-3c2a-8ffc-e1cff54df43d",
                    "sense_definition": "To remain patient and calm when someone has annoyed or provoked you.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abstain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even when the customer was rude, the clerk managed to <w>forbear</w> and remained professional."
                        },
                        {
                            "text": "It takes great strength of character to <w>forbear</w> when you are being treated unfairly."
                        }
                    ],
                    "synonyms": [
                        "endure",
                        "tolerate"
                    ]
                },
                {
                    "sense_id": "deac2cae-2e4b-3524-8d96-5066dc6f2857",
                    "sense_definition": "To pause or wait before taking action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge asked the lawyers to <w>forbear</w> for a moment while he reviewed the evidence."
                        },
                        {
                            "text": "We must <w>forbear</w> until we have all the necessary information to proceed safely."
                        }
                    ],
                    "synonyms": [
                        "pause",
                        "hesitate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or archaic."
                        }
                    ]
                },
                {
                    "sense_id": "b5159085-47f1-3786-a792-163dfc9c7afb",
                    "sense_definition": "To refuse or decline to listen or comply.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "refuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stubborn child would <w>forbear</w> to follow the instructions given by his teacher."
                        },
                        {
                            "text": "They chose to <w>forbear</w> the offer, preferring to find their own way forward."
                        }
                    ],
                    "synonyms": [
                        "decline",
                        "refuse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is archaic."
                        }
                    ]
                }
            ]
        },
        {
