                        "examples": [
                            {
                                "example_id": "d5ba3b78-b988-4423-8e0e-2b702aeb1f63",
                                "sense_id": "7e973280-187d-3e5d-b40b-067472d20220",
                                "text": "Hij hield zijn hand omhoog, waarin de paarse bollen van rode kroten aan hun lange, rode uitlopers bungelden, vers van de grond."
                            }
                        ]
                    },
                    {
                        "sense_id": "93611c29-a68e-3374-aa8e-feae3debf9cf",
                        "entry_id": "7800d96c-88a7-3afe-8c3c-edc40b803794",
                        "glosses": [
                            "beet",
                            "beetroot, red beet"
                        ],
                        "tags": [
                            "Netherlands",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "f77a0a33-3710-4b46-b1d1-76a913ba5668",
                                "sense_id": "93611c29-a68e-3374-aa8e-feae3debf9cf",
                                "text": "Scholtmeijer stelt zich voor hoe een huisvrouw bij de groenteboer vroeg om wortels en rode bieten, terwijl de groenteboer alleen weet had van peentjes en kroten."
                            }
                        ]
                    }
