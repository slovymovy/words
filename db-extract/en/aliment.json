                    },
                    {
                        "sense_id": "7630157f-5da2-3d3d-9d8c-6eae2b3021c0",
                        "entry_id": "cebda78d-a420-3b05-a896-adf9535f10d3",
                        "glosses": [
                            "Schottland Justiz: der Unterhalt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10d03f14-7216-4f88-9815-93e7b0d852c2",
                        "source_entry_id": "cebda78d-a420-3b05-a896-adf9535f10d3",
                        "source_sense_id": "4e48a4d5-d28a-3b1d-9082-9c68ab511776",
                        "source_sense_description": "veraltet: die Nahrung, die Speise",
                        "target_lang_word": "Nahrung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nahrung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c0d9242-f8d1-3eb9-850d-5263aa836018",
                                        "entry_id": "6ed32845-ba6f-3355-b71b-b6f611601242",
                                        "glosses": [
                                            "ess- und trinkbare Stoffe, die Lebewesen zu sich nehmen, um den Organismus aufzubauen und gesund zu halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3358c929-1b4a-4066-9664-0661642f0edf",
                                                "sense_id": "4c0d9242-f8d1-3eb9-850d-5263aa836018",
                                                "text": "Die Nahrung ist, neben der Luft und dem Wasser, eines der drei grundlegenden Lebensmittel aller Lebewesen dieser Erde."
                                            },
                                            {
                                                "example_id": "86eb974a-ff95-4ab5-adc2-d5a627fc6b86",
                                                "sense_id": "4c0d9242-f8d1-3eb9-850d-5263aa836018",
                                                "text": "Man sollte auf ausreichend Vitamine und Mineralstoffe in der Nahrung achten."
                                            },
                                            {
                                                "example_id": "ff252aac-ba22-4842-82bb-2116c04f9ed0",
                                                "sense_id": "4c0d9242-f8d1-3eb9-850d-5263aa836018",
                                                "text": "„Sogar in den Vorstädten gab es keine Nahrung mehr zu kaufen.“"
                                            },
                                            {
                                                "example_id": "15026b3e-3b35-4393-8372-045364699ddc",
                                                "sense_id": "4c0d9242-f8d1-3eb9-850d-5263aa836018",
                                                "text": "„Die meisten der in Flüssen lebenden Tiere rupfen ihre pflanzliche Nahrung in kleinen Stücken ab, nur einige verspeisen ganze lebende Pflanzen.“"
                                            },
                                            {
                                                "example_id": "81b4760c-77c8-4154-b00b-d51bd235f013",
                                                "sense_id": "4c0d9242-f8d1-3eb9-850d-5263aa836018",
                                                "text": "„Wer Bienen und anderen Insekten etwas Gutes zu tun möchte, pflanzt Lavendel. Denn die Tiere finden immer weniger Nahrung.“"
                                            },
                                            {
                                                "example_id": "1f3c5100-9fb1-438c-9ee8-af47035c5d01",
                                                "sense_id": "4c0d9242-f8d1-3eb9-850d-5263aa836018",
                                                "text": "„Allerdings hatten wir diesmal keine Indianer, die für Behaglichkeit und Nahrung sorgten.“"
                                            },
                                            {
                                                "example_id": "0cc90f67-a2bb-45e0-9a7a-220b89dc6412",
                                                "sense_id": "4c0d9242-f8d1-3eb9-850d-5263aa836018",
                                                "text": "„Die erschöpften Leute beider Armeen, die den ganzen Tag über weder Nahrung noch Erholung gehabt hatte, begannen gleichermassen zu zweifeln, ob sie wirklich in ihrem gegenseitigen Vernichtungswerk fortfahren sollten, auf allen Gesichtern prägte sich dieses Schwanken aus, und in jeder einzelnen Seele erhob sich die gleiche Frage: …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72eda6fb-0e98-41a8-96d8-92d0e47c8b24",
                        "source_entry_id": "cebda78d-a420-3b05-a896-adf9535f10d3",
                        "source_sense_id": "4e48a4d5-d28a-3b1d-9082-9c68ab511776",
                        "source_sense_description": "veraltet: die Nahrung, die Speise",
                        "target_lang_word": "Speise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7138502f-209d-3a4e-97a3-d82874b0dda4",
                                        "entry_id": "484d1349-9de9-3055-84de-768f2b28e5e9",
                                        "glosses": [
                                            "Mahlzeit, zubereitetes Gericht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e980c4-5685-41b2-ab9a-ea33e9a86945",
                                                "sense_id": "7138502f-209d-3a4e-97a3-d82874b0dda4",
                                                "text": "Der Tisch des Gastgebers bog sich unter erlesenen Speisen."
                                            },
                                            {
                                                "example_id": "ff40c6fb-44e7-4924-81a4-894a607423a9",
                                                "sense_id": "7138502f-209d-3a4e-97a3-d82874b0dda4",
                                                "text": "„Nach kurzer Zeit waren die Speisen aufgetragen und für jeden drei silberne Becher hingestellt, die sonnenblumenartig auf hohem Fusse standen.“"
                                            },
                                            {
                                                "example_id": "1df600d9-a491-4378-bc69-32f684527b4b",
                                                "sense_id": "7138502f-209d-3a4e-97a3-d82874b0dda4",
                                                "text": "„Oft fertigten die Beschwörer Figürchen der Dämonen an und stellten ihnen Gaben und Speisen hin, damit sie davon äßen und sich – nachdem ihr Hunger gestillt war – nicht mehr an dem Menschen vergriffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "74f0897a-38ee-3f39-833c-fb9911c72161",
                                        "entry_id": "484d1349-9de9-3055-84de-768f2b28e5e9",
                                        "glosses": [
                                            "Kurzform für Glockenspeise, das Gussmaterial für eine Glocke"
                                        ],
                                        "tags": [
                                            "Glockengießerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7226a006-5900-453b-b03b-7f4db7ac9364",
                                                "sense_id": "74f0897a-38ee-3f39-833c-fb9911c72161",
                                                "text": "„In Schmelzöfen schmelzen sie Bronze oder ähnliche Legierungen und lassen schließlich die heißflüssige Masse, die sogenannte Speise, durch selbstgemauerte Kanäle in die Form einlaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c419a606-af4c-4c38-9d78-9ca3d8c030bf",
                        "source_entry_id": "cebda78d-a420-3b05-a896-adf9535f10d3",
                        "source_sense_id": "7630157f-5da2-3d3d-9d8c-6eae2b3021c0",
                        "source_sense_description": "Schottland Justiz: der Unterhalt",
                        "target_lang_word": "Unterhalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterhalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f443f990-3171-34b7-a6cd-6c72b4d71463",
                                        "entry_id": "09451905-531a-388e-aa53-96e951982e07",
                                        "glosses": [
                                            "materielle Absicherung für Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "782b6eba-0095-45dc-9b10-661fdd96e53a",
                                                "sense_id": "f443f990-3171-34b7-a6cd-6c72b4d71463",
                                                "text": "Meine Schwester bekommt Unterhalt für ihr Kind."
                                            },
                                            {
                                                "example_id": "29f10a7e-813a-4482-a053-d6aaa83a975a",
                                                "sense_id": "f443f990-3171-34b7-a6cd-6c72b4d71463",
                                                "text": "„Es sei wünschenswert, dass in den Familien mehr als seit Kriegsbeginn weibliche Hilfskräfte zum Nähen, Waschen, Kochen, Bedienen und so weiter angestellt würden, damit die beschäftigungslosen Frauen und Mädchen Ihren Unterhalt selbst verdienen könnten.“"
                                            },
                                            {
                                                "example_id": "cbab33a7-7d05-48fe-b503-31d3fb975dbb",
                                                "sense_id": "f443f990-3171-34b7-a6cd-6c72b4d71463",
                                                "text": "„Die Gemeindemitglieder haben nicht nur zu gehorchen, sondern auch für den Unterhalt derjenigen zu sorgen, denen sie Gehorsam schulden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae237ded-aacc-3455-9cd4-28a6ef18963a",
                                        "entry_id": "09451905-531a-388e-aa53-96e951982e07",
                                        "glosses": [
                                            "Instandhaltung eines Objekts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11fc588e-4c37-4c88-ac69-5309284d14cc",
                                                "sense_id": "ae237ded-aacc-3455-9cd4-28a6ef18963a",
                                                "text": "Der Unterhalt des Schlosses überforderte die Familie mehr und mehr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
