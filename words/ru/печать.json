                {
                    "sense_id": "459ec1f6-582b-3532-9630-ae2ae6ef14d1",
                    "sense_definition": "Оттиск (след) на бумаге, оставленный специальным инструментом.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stamp_tool_and_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На этой справке отсутствует синяя <печать>.",
                            "target_lang_translations": {
                                "en": "This certificate is missing the blue <w>stamp</w>.",
                                "es": "A este certificado le falta el <w>sello</w> azul.",
                                "fr": "Il manque le <w>tampon</w> bleu sur ce certificat."
                            }
                        },
                        {
                            "text": "Без <печати> этот договор будет недействителен.",
                            "target_lang_translations": {
