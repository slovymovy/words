{
    "word_family": [
        "walging",
        "walglijk",
        "verwalgen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf468361-2a27-3120-81e1-8220294188f4",
                    "sense_definition": "een sterke afkeer of haat voelen voor iets of iemand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "afkeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>walg</w> van de manier waarop hij dieren behandelt.",
                            "target_lang_translations": {
                                "en": "I <w>am disgusted</w> by the way he treats animals."
                            }
                        },
                        {
                            "text": "Zij <w>walgde</w> van het idee om dat vieze eten te moeten proeven.",
                            "target_lang_translations": {
                                "en": "She <w>loathed</w> the idea of having to taste that dirty food."
                            }
                        }
                    ],
                    "synonyms": [
                        "afschuwen",
                        "verafschuwen",
                        "haten"
                    ],
                    "antonyms": [
                        "waarderen",
                        "bewonderen",
                        "liefhebben"
                    ],
                    "common_phrases": [
                        "walgen van"
                    ],
                    "target_lang_definitions": {
                        "en": "to feel a strong aversion, disgust, or hatred for something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be disgusted",
                                "target_lang_sense_clarification": "to feel intense physical or moral revulsion"
                            },
                            {
                                "target_lang_word": "to loathe",
                                "target_lang_sense_clarification": "to feel intense dislike or disgust"
                            },
                            {
                                "target_lang_word": "to detest",
                                "target_lang_sense_clarification": "to dislike intensely; to abhor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8602177e-a9bf-30cc-9fd8-751a4ffa644b",
                    "sense_definition": "iemand misselijk maken of een gevoel van fysieke afkeer bezorgen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "afkeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De geur van rotte vis <w>walgt</w> mij enorm.",
                            "target_lang_translations": {
                                "en": "The smell of rotten fish <w>sickens</w> me immensely."
                            }
                        },
                        {
                            "text": "Het <w>walgt</w> hem dat er zoveel onrecht in de wereld is.",
                            "target_lang_translations": {
                                "en": "It <w>revolts</w> him that there is so much injustice in the world."
                            }
                        }
                    ],
                    "synonyms": [
                        "tegenstaan",
                        "doen kokhalzen"
                    ],
                    "common_phrases": [
                        "het walgt mij"
                    ],
                    "target_lang_definitions": {
                        "en": "to make someone feel nauseous or to cause a feeling of physical revulsion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sicken",
                                "target_lang_sense_clarification": "to cause a feeling of nausea or disgust"
                            },
                            {
                                "target_lang_word": "to revolt",
                                "target_lang_sense_clarification": "to cause someone to feel intense disgust"
                            },
                            {
                                "target_lang_word": "to nauseate",
                                "target_lang_sense_clarification": "to make someone feel like vomiting"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}