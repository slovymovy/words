                                "target_senses": [
                                    {
                                        "sense_id": "4e600315-2595-3b21-9fc0-f4410fab30d1",
                                        "entry_id": "d0ef3bb3-536b-397d-9c04-79ac7a7d57a9",
                                        "glosses": [
                                            "A steep-sided ravine leading from the top of a cliff down to the sea."
                                        ],
                                        "tags": [
                                            "Southern-England",
                                            "Vancouver"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9799c23b-b622-415b-8375-c9c8bf4e6d12",
                                                "sense_id": "4e600315-2595-3b21-9fc0-f4410fab30d1",
                                                "text": "The cottage in a chine, we were not to behold it."
                                            },
                                            {
                                                "example_id": "95f4723c-0b5e-487e-934c-1d7f4f74e64a",
                                                "sense_id": "4e600315-2595-3b21-9fc0-f4410fab30d1",
                                                "text": "In the odorous stillness of the day I thought of the tracks that threaded Egdon Heath, and of benign, elderly Sandbourne, with its chines and sheltered beach-huts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eba1a584-a260-361b-b4ab-374c908d2561",
                                        "entry_id": "8413a870-2041-3165-a0dd-2697a1df1ea3",
                                        "glosses": [
                                            "To crack, split, fissure, break."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "961093c9-4d76-47dd-9db1-11d0db610bdd",
                                                "sense_id": "eba1a584-a260-361b-b4ab-374c908d2561",
                                                "text": "The wayward son did chine his father's heart."
                                            },
                                            {
                                                "example_id": "4fd55cd4-f2f7-4341-883b-6bf15007e5e1",
                                                "sense_id": "eba1a584-a260-361b-b4ab-374c908d2561",
                                                "text": "A drought had caused the earth to chine and cranny."
                                            },
                                            {
                                                "example_id": "7d619af9-66ea-4ea1-ad1c-5d7862d847be",
                                                "sense_id": "eba1a584-a260-361b-b4ab-374c908d2561",
                                                "text": "After the erth be brent, chyned & chypped by the hete of the sonne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
