                "senses": [
                    {
                        "sense_id": "525f8672-7a2a-3d62-be5b-7a22d69e2ab7",
                        "entry_id": "dcd87cfe-cfa2-3ffc-a8a3-a102df76cc29",
                        "glosses": [
                            "Faire perdre des calories à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a83a6981-8d64-465d-82a6-0018f4ccddc5",
                                "sense_id": "525f8672-7a2a-3d62-be5b-7a22d69e2ab7",
                                "text": "Sachez que tous les désordres qui ont lieu dans nos fonctions tiennent au défaut ou à l’excès d'oxygène, de calorique, d’hydrogène, d’azote ou de phosphore ; que par conséquent on ne peut guérir qu’avec des moyens propres à suroxygéner ou désoxygéner, à surcaloriser ou décaloriser, à surhydrogéner ou déshydrogéner, à surazoter ou désazoter, à surphosphorer ou déphosphorer."
                            },
                            {
                                "example_id": "4ca9fcbf-ceaf-4819-b47e-8aac5a8700c7",
                                "sense_id": "525f8672-7a2a-3d62-be5b-7a22d69e2ab7",
                                "text": "Si tu veux te décaloriser, rejoins moi demain à 14h. au parking habituel du rond point de Moujan."
                            },
                            {
                                "example_id": "9f5d3e59-655c-474c-a8b0-a5fbd8286e4a",
                                "sense_id": "525f8672-7a2a-3d62-be5b-7a22d69e2ab7",
                                "text": "La solution pour vous \"décaloriser\" après les fêtes…"
                            }
                        ]
                    }
                ],
