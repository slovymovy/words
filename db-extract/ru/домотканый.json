                ],
                "senses": [
                    {
                        "sense_id": "9fe19b3a-cc66-3846-b0f1-2238800aecfe",
                        "entry_id": "a488dcd5-896b-31c3-915b-11b819056c74",
                        "glosses": [
                            "вытканный домашним, кустарным способом; также сшитый из ткани, вытканной таким образом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93342207-df4d-48de-bb0b-4a229a311871",
                                "sense_id": "9fe19b3a-cc66-3846-b0f1-2238800aecfe",
                                "text": "Домотканые коврики, покрывала придали бы дому еще большую теплоту и неповторимость."
                            }
                        ]
                    },
                    {
                        "sense_id": "acb66382-aa8d-3d5a-8449-f5c8e2d6ee10",
                        "entry_id": "a488dcd5-896b-31c3-915b-11b819056c74",
                        "glosses": [
                            "перен., ирон. доморощенный, кустарный, примитивный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7275abfe-e950-4d26-905d-1ed28714937d",
                                "sense_id": "acb66382-aa8d-3d5a-8449-f5c8e2d6ee10",
                                "text": "Вместе с тем это создание наивное, однако не лишенное домашней, домотканой, житейской, дамской хитрости; если надо — даже безжалостное, однако полное благородства."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8865c8bb-0983-40ee-827f-47cd5527d4d3",
                        "source_entry_id": "a488dcd5-896b-31c3-915b-11b819056c74",
                        "source_sense_description": "вытканный домашним, кустарным способом",
                        "target_lang_word": "homespun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homespun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59548274-c03d-34a2-b645-a0a7c01a51ed",
                                        "entry_id": "7ca160a3-b318-396c-95b6-e71d8b14837c",
                                        "glosses": [
                                            "Spun in the home."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9be27acd-01df-35c2-b0cb-94cc061bb98c",
                                        "entry_id": "7ca160a3-b318-396c-95b6-e71d8b14837c",
                                        "glosses": [
                                            "Woven in the home."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa055f8d-d867-3d49-ad4c-a4e21ca739db",
                                        "entry_id": "7ca160a3-b318-396c-95b6-e71d8b14837c",
                                        "glosses": [
                                            "Made from homespun fabric."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9d7ef1c-7d2f-4c78-8f85-623337ed0f64",
                                                "sense_id": "aa055f8d-d867-3d49-ad4c-a4e21ca739db",
                                                "text": "homespun country garbs"
                                            },
                                            {
                                                "example_id": "d66b8365-cd52-4c31-8387-a1e84760506f",
                                                "sense_id": "aa055f8d-d867-3d49-ad4c-a4e21ca739db",
                                                "text": "He became more and more excited; he rose from the sofa, walked up and down the floor with hurried steps and fought with his hands in the air, till the light flickered hither and thither, while the sweeping tail of his long grey home-spun coat described long circles every time he swung himself round and raised himself on his longer leg, for, like Tyrtaeus and Peter Solvold of our parish, he was afflicted with a limp."
                                            },
                                            {
                                                "example_id": "12c538d7-a567-4306-b869-bc9c68b843c4",
                                                "sense_id": "aa055f8d-d867-3d49-ad4c-a4e21ca739db",
                                                "text": "The woman was dressed in a long broad kaftanlike homespun shirt decorated with thin strips of reindeer fur, leather braiding, small gleaming plates of metal, and lots of little bells which made a rather pleasant melodic sound at every jolt of the train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6093c35f-9f5d-328a-83fa-d67b02bf47c7",
                                        "entry_id": "7ca160a3-b318-396c-95b6-e71d8b14837c",
                                        "glosses": [
                                            "Plain and homely; unsophisticated and unpretentious."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c40da755-89a5-4c54-884d-d859463f68a0",
                                                "sense_id": "6093c35f-9f5d-328a-83fa-d67b02bf47c7",
                                                "text": "homespun wisdom"
                                            },
                                            {
                                                "example_id": "25a74753-c19c-40bd-9217-43b453cd0bfd",
                                                "sense_id": "6093c35f-9f5d-328a-83fa-d67b02bf47c7",
                                                "text": "our homespun English proverb"
                                            },
                                            {
                                                "example_id": "a9727e9b-3702-4c69-af76-2f169f997fb0",
                                                "sense_id": "6093c35f-9f5d-328a-83fa-d67b02bf47c7",
                                                "text": "our homespun authors must forsake the field"
                                            },
                                            {
                                                "example_id": "d8f9dc83-66d9-4c1f-86a0-862242d16b51",
                                                "sense_id": "6093c35f-9f5d-328a-83fa-d67b02bf47c7",
                                                "text": "The McCains, by contrast, dole out such homespun wisdom as \"in Arizona, the only way to get around the state is by small private plane\" and understand that in this crazy modern world where the typical family owns eleven homes and spends hundreds of thousands of dollars per year on household staff, you can't possibly expect transportation alternatives to gain popularity."
                                            },
                                            {
                                                "example_id": "cead1aff-353f-447a-a674-3fedf7f7829d",
                                                "sense_id": "6093c35f-9f5d-328a-83fa-d67b02bf47c7",
                                                "text": "The new cardinal was no theologian – his approach was more homespun – but his commitment to poor people was every bit as strong as that of the liberation theologians. He would simply say he did what the Jesus of the gospels told him to do."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homespun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f24d84a-fd09-31c8-93f0-fb50236140bf",
                                        "entry_id": "726f09c4-7cb4-3ac7-9923-15208a2b7654",
                                        "glosses": [
                                            "Fabric made from homespun yarn. Also, machine made fabrics (usually cottons) similar to homespun fabrics in that solids, plaids, or stripes are created by weaving dyed threads (rather than printing), so that both sides of the fabric look the same."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd8866bf-993e-453e-a81f-9fa4a29f6292",
                                                "sense_id": "1f24d84a-fd09-31c8-93f0-fb50236140bf",
                                                "text": "There are four men, heavily bearded and more than a little dirty, and two young women, all of them busy with shovels in or around an opened grave and all dressed identically in shirts and trousers of tattered homespun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50900db8-ae19-3d3e-a288-61d29a0282c1",
                                        "entry_id": "726f09c4-7cb4-3ac7-9923-15208a2b7654",
                                        "glosses": [
                                            "An unpolished, rustic person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46bafb28-05d0-4063-9929-7636e74eeea4",
                                                "sense_id": "50900db8-ae19-3d3e-a288-61d29a0282c1",
                                                "text": "What hempen home-ſpuns haue we ſwaggering here, / So neere the Cradle of the Faierie Queene?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d59d3945-bca4-4e85-9e89-fda325408e0f",
