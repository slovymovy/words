                    {
                        "translation_id": "c1320954-e481-4588-9e78-9bf8a5313660",
                        "source_entry_id": "6d284616-f6a6-3030-8307-f206e35545aa",
                        "source_sense_id": "9b0a2f64-e12b-36d8-999e-e09fed0b293c",
                        "target_lang_word": "pine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "327d5e5a-492a-3629-90c5-f815efc3b4f4",
                                        "entry_id": "539ec838-6b88-3195-b41f-16fe8d1d2ed1",
                                        "glosses": [
                                            "Any coniferous tree of the genus Pinus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9267772a-f6d7-4fbb-a92e-e35a1ba0bd4d",
                                                "sense_id": "327d5e5a-492a-3629-90c5-f815efc3b4f4",
                                                "text": "The northern slopes were covered mainly in pine."
                                            },
                                            {
                                                "example_id": "34fc2c08-ee9a-4fe1-8438-b49f795037b9",
                                                "sense_id": "327d5e5a-492a-3629-90c5-f815efc3b4f4",
                                                "text": "I stumbled along through the young pines and huckleberry bushes. Pretty soon I struck into a sort of path that, I cal'lated, might lead to the road I was hunting for. It twisted and turned, and, the first thing I knew, made a sudden bend around a bunch of bayberry scrub and opened out into a big clear space like a lawn."
                                            },
                                            {
                                                "example_id": "3d7e51ac-737e-40e7-813d-2ccac5e44b49",
                                                "sense_id": "327d5e5a-492a-3629-90c5-f815efc3b4f4",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f862ada-c9f4-371a-acbf-61c3a29cc47a",
                                        "entry_id": "539ec838-6b88-3195-b41f-16fe8d1d2ed1",
                                        "glosses": [
                                            "Any tree (usually coniferous) which resembles a member of this genus in some respect."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cac603b1-a2c7-3e16-bca5-7ed150b1fce8",
                                        "entry_id": "539ec838-6b88-3195-b41f-16fe8d1d2ed1",
                                        "glosses": [
                                            "The wood of this tree."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0fe5d5c-9750-3f0d-9c2c-b5c7805f82dc",
                                        "entry_id": "539ec838-6b88-3195-b41f-16fe8d1d2ed1",
                                        "glosses": [
                                            "A pineapple."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Guyana",
                                            "South-Africa",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "526f501e-7b38-460b-9b88-84d1991f40ef",
                                                "sense_id": "c0fe5d5c-9750-3f0d-9c2c-b5c7805f82dc",
                                                "text": "\"[…] I bought a pine-apple at the same time, which I gave to Sambo. Let's have it for tiffin; very cool and nice this hot weather.\" Rebecca said she had never tasted a pine, and longed beyond everything to taste one."
                                            },
                                            {
                                                "example_id": "d81cfc61-e5c9-414a-a228-85530e291799",
                                                "sense_id": "c0fe5d5c-9750-3f0d-9c2c-b5c7805f82dc",
                                                "text": "Linda carried the oysters in one hand and the pineapple in the other. […] [S]he put the bottle of oysters and the pine on a little carved chair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3fd4cb3-36d7-3861-a24c-ebb07da6a7b1",
                                        "entry_id": "539ec838-6b88-3195-b41f-16fe8d1d2ed1",
                                        "glosses": [
                                            "The bench, where players sit when not playing."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fba06265-a603-449a-a235-c5907b02d044",
                                                "sense_id": "c3fd4cb3-36d7-3861-a24c-ebb07da6a7b1",
                                                "text": "[…] rather than languish on the pine in Miami."
                                            },
                                            {
                                                "example_id": "6fc6a393-bbfc-46b0-a2fd-13b4bc6b581a",
                                                "sense_id": "c3fd4cb3-36d7-3861-a24c-ebb07da6a7b1",
                                                "text": "Take off your gear and hit the pine. And don't take your time. You understand me, boy?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f03c95d-b49a-31c9-8d41-92c08c96eee8",
                                        "entry_id": "539ec838-6b88-3195-b41f-16fe8d1d2ed1",
                                        "glosses": [
                                            "A counter or bartop."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "998446a8-6ca0-405e-8865-685764dadb2d",
                                                "sense_id": "1f03c95d-b49a-31c9-8d41-92c08c96eee8",
                                                "text": "I'll be behind the pine slinging your favorite cold ones, so come and see me!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0543c561-f38a-374a-bac0-16e41264f88a",
                                        "entry_id": "52ec2428-d386-316e-92a5-1a52c8c45ad8",
                                        "glosses": [
                                            "A painful longing."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3398fa03-a34c-381a-afe5-0969739bc177",
                                        "entry_id": "b3dbb0d9-1737-37fa-8b5e-2ac19c7917e7",
                                        "glosses": [
                                            "To languish; to lose flesh or wear away through distress."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81a35fd3-3924-4094-ae04-92eb08be2e92",
                                                "sense_id": "3398fa03-a34c-381a-afe5-0969739bc177",
                                                "text": "Why pine not I, and die in this distress?"
                                            },
                                            {
                                                "example_id": "66b03ea6-9cb6-4d74-a896-6b9097d4e341",
                                                "sense_id": "3398fa03-a34c-381a-afe5-0969739bc177",
                                                "text": "[T]hou mayſt know / What miſerie th' inabſtinence of Eve / Shall bring on men. Immediately a place / Before his eyes appeard, ſad, noyſom, dark, / A Lazar-houſe it ſeemd, wherein were laid / Numbers all diſeas'd, […] / […] / Dæmoniac Phrenzie, moaping Melancholie / And Moon-ſtruck madneſs, pining Atrophie, / Maraſmus and wide-waſting Peſtilence."
                                            },
                                            {
                                                "example_id": "f0a3f6e6-a1d0-4072-8b92-1abc56e688ea",
                                                "sense_id": "3398fa03-a34c-381a-afe5-0969739bc177",
                                                "text": "This night shall see the gaudy wreath decline, The roses wither and the lilies pine."
                                            },
                                            {
                                                "example_id": "f5a0748f-ddc6-48b9-8c8d-4ac31f097b35",
                                                "sense_id": "3398fa03-a34c-381a-afe5-0969739bc177",
                                                "text": "Long lay the world in sin and error pining / Till He appear’d and the soul felt its worth"
                                            },
                                            {
                                                "example_id": "2110254e-fa56-4927-a11d-748919a756f7",
                                                "sense_id": "3398fa03-a34c-381a-afe5-0969739bc177",
                                                "text": "The way the story went was that the man's foot healed up all right but that he just pined away."
                                            },
                                            {
                                                "example_id": "5a385417-f878-45fe-ab7b-a55831a01d48",
                                                "sense_id": "3398fa03-a34c-381a-afe5-0969739bc177",
                                                "text": "Before I pine away (Pine away)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edad779d-1320-3bad-a78a-90cf5004a2e4",
                                        "entry_id": "b3dbb0d9-1737-37fa-8b5e-2ac19c7917e7",
                                        "glosses": [
                                            "To long, to yearn so much that it causes suffering."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f81f1cd4-1edb-4109-9fe1-0a3949bb7c88",
                                                "sense_id": "edad779d-1320-3bad-a78a-90cf5004a2e4",
                                                "text": "Laura was pining for Bill all the time he was gone."
                                            },
                                            {
                                                "example_id": "f6369e7f-67b9-4d36-8dd3-eb97e7ca6c98",
                                                "sense_id": "edad779d-1320-3bad-a78a-90cf5004a2e4",
                                                "text": "Praline: \"That parrot is definitely deceased. And when I bought it not half an hour ago you assured me that its lack of movement was due to it being tired and shagged out after a long squawk.\"\nShopkeeper: \"It's probably pining for the fiords.\"\nPraline: \"Pining for the fiords, what kind of talk is that?\""
                                            },
                                            {
                                                "example_id": "286c031b-e934-4386-a0af-fb02c574473a",
                                                "sense_id": "edad779d-1320-3bad-a78a-90cf5004a2e4",
                                                "text": "Ten years ago, liberals pined for a post-religious right, a different culture war. Be careful what you wish for."
                                            },
                                            {
                                                "example_id": "8f90aac0-8f53-4f57-8dbd-1fde77b0d4be",
                                                "sense_id": "edad779d-1320-3bad-a78a-90cf5004a2e4",
                                                "text": "Of the group, Max (Room’s Jacob Tremblay) is the most nominally mature, at least biologically speaking; unlike his childhood companions, he’s entered the early throes of puberty, and spends a lot of his waking hours pining, rather chastely, for a classmate (Millie Davis)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3dda8e9-6b4e-3a2f-8794-4f35eeb452db",
                                        "entry_id": "b3dbb0d9-1737-37fa-8b5e-2ac19c7917e7",
                                        "glosses": [
                                            "To grieve or mourn for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e83107aa-9618-3f11-b263-32afe75a20dd",
                                        "entry_id": "b3dbb0d9-1737-37fa-8b5e-2ac19c7917e7",
                                        "glosses": [
                                            "To inflict pain upon; to torment."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95058df0-7b82-42e7-8587-94f967fc6adf",
                                                "sense_id": "e83107aa-9618-3f11-b263-32afe75a20dd",
                                                "text": "Which way, O Lord, which way can I look, and not see some sad examples of misery? […] [O]ne is pined in prison; another, tortured on the rack; a third, languisheth under the loss of a dear son, or wife, or husband."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
