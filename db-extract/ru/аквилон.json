                                        "entry_id": "9b8ba956-10bb-3b38-93ce-7768d11759cc",
                                        "glosses": [
                                            "bóg wiatru północnego, utożsamiany z greckim Boreaszem"
                                        ],
                                        "tags": [
                                            "Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa9ff100-aacc-48e4-a098-959bcaee0cf3",
                                                "sense_id": "d617d3f6-c2cc-3a75-a8c8-90deedc2799e",
                                                "text": "Wnet Akwilona zamyka w eolskich / Pieczarach, inne też z nim wiatry, które / Mogłyby chmurną nawałę rozpędzić"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
