                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71839523-ce2b-465d-9e2b-e4b6a18a014a",
                                "sense_id": "90e73013-0b4b-35e7-ba18-a23e2fb84751",
                                "text": "The siblings lived in a house in Guizhou Province, one of the poorest areas in China; their village, Cizhu, is under the administration of the city of Bijie."
                            },
                            {
                                "example_id": "395c1a44-b239-4efc-a4f1-94a48f0f61c3",
                                "sense_id": "90e73013-0b4b-35e7-ba18-a23e2fb84751",
                                "text": "Over the weekend, engineers in China's mountainous southwestern Guizhou province linked the two ends of a bridge spanning a rocky gorge. The completion of the Beipanjiang bridge marks yet another infrastructure record in China — the world's \"highest\" bridge, sitting 1,854 feet above the river below."
                            },
                            {
                                "example_id": "dd88912d-5e38-4124-ac1f-ed7d89a7a580",
                                "sense_id": "90e73013-0b4b-35e7-ba18-a23e2fb84751",
                                "text": "A mudslide in the south-western province of Guizhou has resulted in 15 deaths. Thirty people are still missing as the search continues."
                            }
                        ]
                    }
