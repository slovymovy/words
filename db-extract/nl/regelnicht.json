                    },
                    {
                        "sense_id": "e54f6fec-f4b9-33a1-ad2c-668284124897",
                        "entry_id": "5eeae3c9-9b29-31c4-8350-6d00ebb34c7a",
                        "glosses": [
                            "licht voor wat bedillerig persoon bij een gebeurtenis",
                            "iemand die beijvert dat alles volgens gestelde regels verloopt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "cf38586a-2676-49d2-ac47-1eeb162c200b",
                                "sense_id": "e54f6fec-f4b9-33a1-ad2c-668284124897",
                                "text": "Max, de „regelnicht\" die in het kamp een joden-embleem versierde, omdat joden in de hiërarchie nog net iets hoger stonden dan homo's, staat met zijn kort tevoren door een SS'er vermoorde vriend Horst in zijn armen."
                            },
                            {
                                "example_id": "c3c8ba33-93c3-4ff8-8b39-2d6b60a38215",
                                "sense_id": "e54f6fec-f4b9-33a1-ad2c-668284124897",
                                "text": "Daar wachtte goede fee Alma Sarajlic, een laatstejaarsstudente medicijnen die ons als begeleidster was aangewezen en daar zat student Renko grijnzend achter het stuur van een ons ter beschikking gesteld Renaultbusje. De reportage kon beginnen. (…) Trouwens, zo stelde „regelnicht\" Alma zeer beslist, de zeven dienden zich eerst en vooral in het Olympische hoofdkwartier te accrediteren. De dokteres in spe had nu eenmaal haar instructies..."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c82c5b4-9961-3b06-a174-ccbe11c9cf3a",
                        "entry_id": "5eeae3c9-9b29-31c4-8350-6d00ebb34c7a",
                        "glosses": [
                            "licht voor wat bedillerig persoon bij een gebeurtenis",
                            "iemand die zich ervoor inspant dat alles naar wens verloopt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "4403db46-5bc7-4952-a5c3-71d417c1aebc",
                                "sense_id": "0c82c5b4-9961-3b06-a174-ccbe11c9cf3a",
                                "text": "Als je iets aan hem vraagt zal hij er zijn, bijvoorbeeld voor de Orionloop of de rommelmarkt. Hij doet zijn dingetje voor de vereniging, maar is geen regelnicht. Ron loopt zeg maar precies hard genoeg."
                            },
                            {
                                "example_id": "444e9f4e-19c7-4842-ada2-9c28e8423798",
                                "sense_id": "0c82c5b4-9961-3b06-a174-ccbe11c9cf3a",
                                "text": "Zo ontstaat bij veel boerinnen het gevoel van enerzijds onmisbaar zijn op het bedrijf als een soort \"regelnicht in algemene dienst\" — maar anderzijds een financiële sluitpost die geen volwaardig inkomen uit het bedrijf kan krijgen."
                            }
                        ]
                    }
