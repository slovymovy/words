                                            {
                                                "example_id": "9a0eef73-b794-4d7e-a158-ea75057a20ac",
                                                "sense_id": "ccc46b12-36cf-34d9-b621-2b5bac0bee2a",
                                                "text": "„Und immer, wenn die Rede auf Pierre kam, begann sie Anekdoten von seiner Zerstreutheit zu erzählen, die zum Teil von irgendwelchen Lästermäulern erfunden waren.“"
                                            }
