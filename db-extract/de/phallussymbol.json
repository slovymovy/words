                "senses": [
                    {
                        "sense_id": "e976fdac-6561-39e1-b7c2-0809b0a08e55",
                        "entry_id": "135aa7d3-e9bc-370a-89fe-fcf1951c2455",
                        "glosses": [
                            "Gegenstand oder Symbol, das an ein erigiertes männliches Glied erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cae6db2-c4c2-47f4-b484-9b4d56baa399",
                                "sense_id": "e976fdac-6561-39e1-b7c2-0809b0a08e55",
                                "text": "„Neal setzte sich auf einen Liegestuhl neben einer riesigen, aus den Überresten eines Plymouth Valiant Baujahr 1962 gefertigten Skulptur, das Auspuffrohr diente offensichtlich als beeindruckendes Phallussymbol.“"
                            },
                            {
                                "example_id": "2208612f-4033-4c62-bd32-be967322e07b",
                                "sense_id": "e976fdac-6561-39e1-b7c2-0809b0a08e55",
                                "text": "„Ein Knochen ist keine Metapher. Ebenso wenig ist ein Strommast ein Phallussymbol, er ist eine öffentliche Bedürfnisanstalt und, wie ich schmerzhaft am eigenen Leibe erfahren musste, ein Gesundheitsrisiko fürs Gehirn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
