                        "glosses": [
                            "Kraft, die von einer Maschine ausgeht; Leistung, die eine mechanische Vorrichtung (= eine Maschine) hervorbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d1ebca1-4641-413e-ae3d-26b652aa5c64",
                                "sense_id": "c34a278c-0d2e-3ae9-a1a0-d0838f07f0ea",
                                "text": "„Ein stark in die Augen springendes Merkmal der modernen Schiffsbaukunst beruht auf der möglichst weitgehenden Ausnutzung der Maschinenkraft als Ersatzmittel der Menschenkraft.“"
                            },
                            {
                                "example_id": "b8ac37fa-1092-4702-9598-9c812af5d4c1",
                                "sense_id": "c34a278c-0d2e-3ae9-a1a0-d0838f07f0ea",
                                "text": "„Der Ersatz der mühsamen Handarbeit durch Maschinenkraft bei der Nagelfabrikation geschah zuerst in Nordamerika.“"
                            }
