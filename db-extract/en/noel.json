                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ee8294e2-2b57-32f0-b53f-b8609097d674",
                        "entry_id": "78eab7e2-46bb-3285-a450-92f1edebcc8e",
                        "glosses": [
                            "A male given name from French."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "466f8f66-d321-4d01-8fa0-f720b1f3468e",
                                "sense_id": "ee8294e2-2b57-32f0-b53f-b8609097d674",
                                "text": "When Noel came, noisily bursting through the back door with buckets of cleansers and sponges, I introduced myself. \"Just call me Noelle,\" he said of himself. \"When I was little they used to call me Noel, Noel, the toilet bowl. Although now I have thought of painting that on the side of my van. It might be good for business? I don't know.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "ac50c301-719b-3304-8789-37081178b4e6",
                        "entry_id": "78eab7e2-46bb-3285-a450-92f1edebcc8e",
                        "glosses": [
                            "A female given name from French."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3ea62c06-4f53-3037-8fdb-65ad4ea2240b",
                        "entry_id": "78eab7e2-46bb-3285-a450-92f1edebcc8e",
                        "glosses": [
                            "A surname originating as a patronymic."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "20047ffb-4eb1-3977-84f7-af9cc7df7516",
                        "entry_id": "78eab7e2-46bb-3285-a450-92f1edebcc8e",
