                                "sense_id": "6f392902-c97e-3915-9e34-7a1002d8c90b",
                                "text": "an abiding belief"
                            },
                            {
                                "example_id": "7048dd5b-97e0-4c91-b02e-be70cf7fe46f",
                                "sense_id": "6f392902-c97e-3915-9e34-7a1002d8c90b",
                                "text": "a deep and abiding hatred of wealth"
                            },
                            {
                                "example_id": "b31a0a04-2b46-4d2e-9a76-8bdad34713ba",
                                "sense_id": "6f392902-c97e-3915-9e34-7a1002d8c90b",
                                "text": "However, one abiding weakness with such data collection is that people’s beliefs about their speech habits may not necessarily tally with reality."
                            }
                        ]
