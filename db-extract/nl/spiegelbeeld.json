                "senses": [
                    {
                        "sense_id": "4cbc7488-4498-3d7d-8779-cd9676debf75",
                        "entry_id": "870fcc75-2993-3080-8722-82ed0f6eda40",
                        "glosses": [
                            "door een spiegel of spiegelend vlak teruggekaatst beeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08b9b093-f416-4c0c-846c-5c3b4cdacd2a",
                                "sense_id": "4cbc7488-4498-3d7d-8779-cd9676debf75",
                                "text": "'Meneer, het zou kunnen dat ik inderdaad iets heb vernomen van de geruchten waar u op zinspeelt. Maar als die verhalen kloppen, zou er mijns inziens sprake zijn van een plaag van blindheid. Prins Henry zou toch blind hebben moeten zijn om zijn aanbedene niet te herkennen, of om een lelijk meisje aan te zien voor een ongeëvenaarde schoonheid? En mijn dochters zouden wel blind hebben moeten zijn voor hun spiegelbeeld en voor de blik in de ogen van degenen die hen aankijken...'"
                            }
                        ]
                    },
                    {
                        "sense_id": "2fbfd72c-9c28-3f43-a8b7-4eaeff299bbd",
                        "entry_id": "870fcc75-2993-3080-8722-82ed0f6eda40",
                        "glosses": [
                            "afbeelding die omgekeerd is aan het origineel"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "86ce0761-d662-3f23-b242-a8fea5552a9b",
                        "entry_id": "870fcc75-2993-3080-8722-82ed0f6eda40",
                        "glosses": [
                            "iets dat het tegengestelde is van het orrigineel"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ebe4b128-dce5-41e9-a07a-9f9dc764a276",
                                "sense_id": "86ce0761-d662-3f23-b242-a8fea5552a9b",
                                "text": "Recordbrekende antimaterie: Antimaterie is de tegenhanger van ‘gewone’ materie. Van elk elementair materiedeeltjestype bestaat een antimaterieversie die in veel opzichten erop lijkt, maar het spiegelbeeld is. Zo is het anti-elektron (of positron) net zo zwaar als het elektron maar heeft het een positieve lading in plaats van een negatieve."
                            }
                        ]
                    }
