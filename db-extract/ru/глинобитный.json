                                        "entry_id": "ea4c4ecd-ec7b-347b-bd79-62c9db5992b6",
                                        "glosses": [
                                            "Participe passé masculin singulier de piser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
