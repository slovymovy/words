                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The holiday season is traditionally associated with charitable <w>giving</w>.",
                            "target_lang_translations": {
                                "ru": "Сезон праздников традиционно ассоциируется с благотворительными <w>пожертвованиями</w>."
                            }
                        },
                        {
                            "text": "Generous <w>giving</w> by local donors helped build the new hospital wing.",
                            "target_lang_translations": {
                                "ru": "Щедрые <w>пожертвования</w> местных благотворителей помогли построить новое крыло больницы."
                            }
                        }
                    ],
                    "synonyms": [
                        "donation",
                        "bestowal"
                    ],
                    "antonyms": [
