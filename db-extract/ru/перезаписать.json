                "senses": [
                    {
                        "sense_id": "ae988689-e88b-34e5-a444-f38773afa574",
                        "entry_id": "1539ca84-4ea8-3e83-b9f3-6cd410224693",
                        "glosses": [
                            "записать (звуковой или видеоматериал, цифровую информацию и т. п.) заново или по-другому"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa3f69c3-8574-424d-a007-9d5761698bda",
                                "sense_id": "ae988689-e88b-34e5-a444-f38773afa574",
                                "text": "Пленка, на которую перезаписали обрывок разговора, была на экспертизе, но результатов еще не получили."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94f2252f-2576-478f-a785-9c58b81d8f83",
                        "source_entry_id": "1539ca84-4ea8-3e83-b9f3-6cd410224693",
                        "source_sense_id": "ae988689-e88b-34e5-a444-f38773afa574",
                        "target_lang_word": "rewrite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rewrite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cae8e49b-e543-34ed-b8d6-b0ffb0ba4ce4",
                                        "entry_id": "26efe2f0-6767-389e-9da7-8f7be925e8fe",
                                        "glosses": [
                                            "The act of writing again or anew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e112e2e2-6cca-4e92-97bc-3f9b5b2f314a",
                                                "sense_id": "cae8e49b-e543-34ed-b8d6-b0ffb0ba4ce4",
                                                "text": "The film script underwent a rewrite for the European market."
                                            },
                                            {
                                                "example_id": "66e8bde8-1ff3-4aff-9559-759c5971b662",
                                                "sense_id": "cae8e49b-e543-34ed-b8d6-b0ffb0ba4ce4",
                                                "text": "After a month of writing and another month for rehearsals and re-writes, the three planned a one-night-only performance billed as a work in progress at Josie's Cabaret and Juice Joint in San Francisco."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63ac383b-fcb8-3e9b-8cb2-3b3ff2097285",
                                        "entry_id": "26efe2f0-6767-389e-9da7-8f7be925e8fe",
                                        "glosses": [
                                            "Something that has been written again."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f7e314e-32cd-331b-923f-df4a84c8b21a",
                                        "entry_id": "26efe2f0-6767-389e-9da7-8f7be925e8fe",
                                        "glosses": [
                                            "The replacement of subterms of a formula with other terms, according to certain rules, by way of transformation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rewrite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d79d2e3-e6d3-3f25-aa01-ad5a49017738",
                                        "entry_id": "c557369d-f563-3684-9ab6-0b326542bd82",
                                        "glosses": [
                                            "To write again, differently; to modify; to revise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f053e1c-3795-403f-898c-164d64431bbf",
                                                "sense_id": "5d79d2e3-e6d3-3f25-aa01-ad5a49017738",
                                                "text": "The editor asked me to rewrite my article for a non-technical audience."
                                            },
                                            {
                                                "example_id": "9843148c-14e1-419c-9fb0-1bd61ebb3145",
                                                "sense_id": "5d79d2e3-e6d3-3f25-aa01-ad5a49017738",
                                                "text": "If we are going to rewrite all of those diagrams and change the duties of all of those staff, it will take a few weeks."
                                            },
                                            {
                                                "example_id": "150b3e06-0b19-4a73-8b95-3ebe19e20111",
                                                "sense_id": "5d79d2e3-e6d3-3f25-aa01-ad5a49017738",
                                                "text": "The conservative establishment will have to ask themselves, what else they can do? […] And even though they rewrite the electoral rules in their favour, their parties still lose the election."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e181c634-c8fd-3182-b60e-ff4b59c44fa6",
                                        "entry_id": "c557369d-f563-3684-9ab6-0b326542bd82",
                                        "glosses": [
                                            "To write again (without changes)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc226159-9833-3af5-9acf-6c041745d8b3",
                                        "entry_id": "c557369d-f563-3684-9ab6-0b326542bd82",
                                        "glosses": [
                                            "To replace subterms of a formula with other terms, according to certain rules, by way of transformation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
