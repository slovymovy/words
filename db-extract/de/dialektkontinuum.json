                ],
                "senses": [
                    {
                        "sense_id": "703607c7-819d-32cb-9967-2227275c16c4",
                        "entry_id": "9003baf7-a573-3ad7-9001-0173ebb3b065",
                        "glosses": [
                            "eine Gruppe verschiedener Dialekte, die fließend ineinander übergehen; (Vergleiche auch Großdialekt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7185830c-56a7-49ef-b407-17c8d5278aad",
                                "sense_id": "703607c7-819d-32cb-9967-2227275c16c4",
                                "text": "„Neben geographischen Dialektkontinua gibt es auch soziale Dialektkontinua zwischen basilektalen und akrolektalen Sprachvarietäten, die in demselben geographischen Raum gesprochen werden.“"
                            },
                            {
                                "example_id": "2fc40387-8458-45a6-ba58-b35c29e1cee0",
                                "sense_id": "703607c7-819d-32cb-9967-2227275c16c4",
                                "text": "„Afrikanisten unterteilen die heutigen südafrikanischen Bantusprachen in zwei große Dialektkontinua, die Nguni-Gruppe und die Sotho-Gruppe.“"
                            },
                            {
                                "example_id": "412b7c60-d363-4211-bdbb-525a43ac169c",
                                "sense_id": "703607c7-819d-32cb-9967-2227275c16c4",
                                "text": "„In Übersicht 1 lassen sich anhand der Aussprache des Satzes »Wie geht’s dir jetzt?« durchaus Hinweise für ein Dialektkontinuum entdecken, das geographisch gesehen von der Nordsee bzw. Ostsee bis ins südliche Tirol reicht.“"
                            },
                            {
                                "example_id": "2a52ec84-8c98-4ba2-8067-2f9acfb206cb",
                                "sense_id": "703607c7-819d-32cb-9967-2227275c16c4",
                                "text": "„Vom ökologischen Standpunkt aus ist die Erhaltung der Dialektkontinua mit ihren kleinen, in der Entfernung größer werdenden Unterschieden wünschenswert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
