                "senses": [
                    {
                        "sense_id": "2edc09af-bdb4-3670-8ed3-8c96b735f189",
                        "entry_id": "92e5b575-ae7d-340a-8426-39f21f4349f0",
                        "glosses": [
                            "zienswijze of omvang die ruimte biedt voor veel verschillende invalshoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ec866b2-2051-4493-8bdc-43a65635fa04",
                                "sense_id": "2edc09af-bdb4-3670-8ed3-8c96b735f189",
                                "text": "Volgens Bert Vuijsje kenmerkten de jazzrecensies van Pé zich door eruditie, Bourgondische charme, spiritualiteit, breedheid en openheid van visie."
                            },
                            {
                                "example_id": "8508d657-3c34-4bf1-ab74-5b6c6be46dbf",
                                "sense_id": "2edc09af-bdb4-3670-8ed3-8c96b735f189",
                                "text": "Het is alles behalve oubollig. Ik maak de overstap, omdat ik zo ongelooflijk van die breedheid in de muziek houd. Er zijn 5 prachtige decennia popmuziek en daar kun je uit putten. Een goudmijn. Als je Radio 2 aanzet, hoor je eigenlijk het 3FM van een paar jaar geleden."
                            }
                        ]
                    },
                    {
                        "sense_id": "6844272c-dd54-31d9-aca4-66ef617ec99f",
                        "entry_id": "92e5b575-ae7d-340a-8426-39f21f4349f0",
                        "glosses": [
                            "veel woorden gebruiken om iets te zeggen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "45d106d6-20f2-4161-9ec8-56945e2cb437",
                                "sense_id": "6844272c-dd54-31d9-aca4-66ef617ec99f",
                                "text": "\"Ik was er zelf al eens mee begonnen, maar pas bij mijn tweede levensjaar was ik al op pagina tachtig. Ik heb de neiging tot enige uitbundige breedheid\", vertelde Westbroek in het programma 't Wordt nu laat op NPO Radio 2."
                            }
                        ]
                    }
                ],
