                ],
                "senses": [
                    {
                        "sense_id": "9d8ebb72-9a07-3392-997c-b6b98b8f217e",
                        "entry_id": "c06a6235-3b73-3eaa-8748-efbe34e4f6d2",
                        "glosses": [
                            "Qu’on ne peut pas attaquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ddf965b-3e4c-4dee-bab8-185608c931af",
                                "sense_id": "9d8ebb72-9a07-3392-997c-b6b98b8f217e",
                                "text": "Ce second discours fut un triomphe pour M. Leuwen ; il se livra à toute sa méchanceté et trouva contre M. de Vaize des traits d’autant plus cruels qu’ils étaient inattaquables dans la forme."
                            },
                            {
                                "example_id": "427de63b-601d-4a4a-9801-fa9b4506a735",
                                "sense_id": "9d8ebb72-9a07-3392-997c-b6b98b8f217e",
                                "text": "il est puissant contre moi, il le serait contre vous, il le serait contre le roi lui-même, protégé qu’il est par un irréprochable passé et par une position presque inattaquable."
                            },
                            {
                                "example_id": "27ab216d-cebd-4a6f-918a-92d59f720439",
                                "sense_id": "9d8ebb72-9a07-3392-997c-b6b98b8f217e",
                                "text": "Par où l’attaquer ? Il est inattaquable. Où le blesser ? Il est invulnérable. Où l’atteindre ? Il est inaccessible."
                            },
                            {
                                "example_id": "29efa712-2bb5-431e-98da-e352a45b4bde",
                                "sense_id": "9d8ebb72-9a07-3392-997c-b6b98b8f217e",
                                "text": "Allant à l’encontre de préconisations publiques visant davantage à la réhabilitation, les annonces de démolitions ou de transformations d’architectures remarquables du XXe siècle sont légion, au nom, toujours, de l’inattaquable développement durable."
                            },
                            {
                                "example_id": "ed4b0d73-fa6f-485a-9b11-387555df09c2",
                                "sense_id": "9d8ebb72-9a07-3392-997c-b6b98b8f217e",
                                "text": "Un droit, un titre inattaquable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a526be19-734e-4646-9a10-c919e4467a5c",
                        "source_entry_id": "c06a6235-3b73-3eaa-8748-efbe34e4f6d2",
                        "source_sense_id": "9d8ebb72-9a07-3392-997c-b6b98b8f217e",
                        "target_lang_word": "unangreifbar",
