                                                "sense_id": "fc550c6c-0dbc-38cd-a327-92fb9d88d9f3",
                                                "text": "Израненным до такой степени, что не вдруг и смекнёшь, как к нему прикоснуться."
                                            },
                                            {
                                                "example_id": "05988197-3386-450c-8436-32ebd363df51",
                                                "sense_id": "fc550c6c-0dbc-38cd-a327-92fb9d88d9f3",
                                                "text": "Ратники, наученные своими старшинами, стреляли по команде, все вдруг."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fba34a4-c065-4754-9a11-33709fb5e572",
                        "source_entry_id": "82c0c783-c8f1-33f2-936c-a1fc6db995fc",
                        "source_sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                        "target_lang_word": "порывисто",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "порывисто",
