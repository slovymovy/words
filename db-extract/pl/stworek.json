                        "entry_id": "70fa7ae7-007c-3f8f-b76c-0d96c012e2b1",
                        "glosses": [
                            "Krátura ― domácí skřítek ve světě Harryho Pottera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d591a96-6be2-41dc-8edf-a1274378d433",
                                "sense_id": "0c9f9538-b96b-3cbc-a7a6-ad8445e0e3c1",
                                "text": "Stworek nie będzie obrazał Harry'ego Pottera na oczach Zgredka, nie, nie będzie, albo Zgredek zamknie Stworkowi jadaczkę! ― krzyknął Zgredek piskliwym głosem.",
                                "translation": "Krátura nebude urážet Harryho Pottra před Dobbym, ne, nebude, nebo Dobby zavře Kráturovi klapačku! ― vykřikl Dobby pisklavým hlasem."
                            }
                        ]
                    }
