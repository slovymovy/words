                ],
                "senses": [
                    {
                        "sense_id": "97562db7-d812-3525-81f5-65ec2d1a4537",
                        "entry_id": "8ff99aa2-5984-3b9a-b0b6-d43739ee03f4",
                        "glosses": [
                            "technische Anlage, in der Abläufe unter realitätsnahen Bedingungen geübt oder veranschaulicht werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b1c636f-8505-48e8-b255-beeefc2f24a1",
                                "sense_id": "97562db7-d812-3525-81f5-65ec2d1a4537",
                                "text": "Im Simulator lernen Jugendliche die geänderten Sehverhältnisse und das eingeschränkte Reaktionsverhalten unter Alkohol- oder Drogeneinfluss kennen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "783caa16-750f-4a84-9ff2-7f6eb834c063",
                        "source_entry_id": "8ff99aa2-5984-3b9a-b0b6-d43739ee03f4",
                        "source_sense_id": "97562db7-d812-3525-81f5-65ec2d1a4537",
                        "target_lang_word": "simulator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simulator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91a06e4f-2be8-39bb-8259-48d2b8b11a54",
                                        "entry_id": "5983c5bc-97eb-3934-b11e-3f3f976af729",
                                        "glosses": [
                                            "One who simulates or feigns."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "193fecee-e117-4bac-a158-705a58dcb036",
                                                "sense_id": "91a06e4f-2be8-39bb-8259-48d2b8b11a54",
                                                "text": "Even confessing to a crime, the man may be mad, or a knavish simulator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "112a661e-99d7-303c-9342-28fff5441934",
                                        "entry_id": "5983c5bc-97eb-3934-b11e-3f3f976af729",
                                        "glosses": [
                                            "A machine or system that simulates an environment (such as an aircraft cockpit), often for training purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af725404-b168-41d9-a20d-c3d18730ec5d",
                                                "sense_id": "112a661e-99d7-303c-9342-28fff5441934",
                                                "text": "The dummy rocket is being developed to permit the ground testing of missile controls. By the use of this “flight simulator” the control devices of missiles can be subjected to operational tests on the ground, thus reducing the need for expensive flight tests."
                                            },
                                            {
                                                "example_id": "aa5285f7-d58c-47af-a6c3-7c833a8deb4e",
                                                "sense_id": "112a661e-99d7-303c-9342-28fff5441934",
                                                "text": "Classroom sessions for drivers are under way, with each driver requiring a full day on the simulator before they then test a tram on the £350 million new line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bbd4293-56b4-3f4a-a3aa-b3addef27a27",
                                        "entry_id": "5983c5bc-97eb-3934-b11e-3f3f976af729",
                                        "glosses": [
                                            "A game that attempts to reproduce an experience realistically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dc7c09a-6625-4545-ac5b-fc99f268379b",
                                                "sense_id": "6bbd4293-56b4-3f4a-a3aa-b3addef27a27",
                                                "text": "a pinball simulator"
                                            },
                                            {
                                                "example_id": "fcc21584-52ab-4a7d-a5b5-53f1b8d5f944",
                                                "sense_id": "6bbd4293-56b4-3f4a-a3aa-b3addef27a27",
                                                "text": "While writing for Mastertronic, David had seen that sales figures were much better for 'simulators' compared to less realistic games […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a3dbae0-a463-4e6a-8ae9-284faae39be4",
                        "source_entry_id": "8ff99aa2-5984-3b9a-b0b6-d43739ee03f4",
                        "source_sense_id": "97562db7-d812-3525-81f5-65ec2d1a4537",
                        "target_lang_word": "simulateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simulateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb94e0a9-dee3-3c49-b054-413522bfe8d0",
                                        "entry_id": "d3315f30-1b4c-33d4-a74b-f7aea05301fb",
                                        "glosses": [
                                            "Celui qui simule, qui feint un sentiment, une attitude, une action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "906b952d-9909-3880-b6fa-1507491429aa",
                                        "entry_id": "d3315f30-1b4c-33d4-a74b-f7aea05301fb",
                                        "glosses": [
                                            "Celui qui simule la folie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b71d63fe-1d77-4a96-b1f2-9947c4dd335d",
                                                "sense_id": "906b952d-9909-3880-b6fa-1507491429aa",
                                                "text": "Il se dit atteint d’amnésie : c’est un simulateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "simulateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                        "entry_id": "f17d883f-db1e-3f82-8f85-cfcd0b76cdb5",
                                        "glosses": [
                                            "Appareil qui permet de simuler un système quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce745f6-6b58-4af4-bb63-3f8bb4297390",
                                                "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                                "text": "Des études sur simulateur (Rudin-Brown, 2004 ; Rudin-Brown et McCurdie, 2004 ; Lee, 1995), ainsi que des études expérimentales, laissent penser que les conducteurs de véhicules tout-terrain, de pick-up et de camionnettes évaluent leur vitesse avec moins de précision, parce qu'ils sont assis plus haut, au-dessus de la chaussée, que les conducteurs de voitures particulières."
                                            },
                                            {
                                                "example_id": "7c2324e0-0a43-406e-bc5d-0b27d6d7e807",
                                                "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                                "text": "Les pilotes de chasse professionnels, dont le numéro 2 de la Patrouille de France, venus tester le simulateur alsacien, sont tous unanimes sur le réalisme de l'expérience."
                                            },
                                            {
                                                "example_id": "097ffc5a-5fc0-478b-942d-a522fce7618d",
                                                "sense_id": "a038a0f3-7ad5-3c4f-8b84-eaedfb2117d4",
                                                "text": "Monsieur, vous avez deux options : soit vous payez une amende et vous allez peut-être au tribunal, soit vous suivez un stage sur la thématique des téléphones au volant, avec des passages dans un simulateur de conduite par exemple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b2d6840-169c-3eb2-99ce-f3dbe02208cf",
                                        "entry_id": "f17d883f-db1e-3f82-8f85-cfcd0b76cdb5",
                                        "glosses": [
                                            "Simulateur-ergomètre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
