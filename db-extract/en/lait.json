                        "examples": [
                            {
                                "example_id": "0cec9a6b-a813-4a22-8f7c-436a1a961bc1",
                                "sense_id": "c9b92b6d-abd3-3fd0-a16c-0c38c29fdd96",
                                "text": "By neeght, o' my bed, I laited him, at my sowl luvs : I laited him, but I dudn't find um."
                            },
                            {
                                "example_id": "ceb7605c-0a21-42eb-a017-228d5a6191a4",
                                "sense_id": "c9b92b6d-abd3-3fd0-a16c-0c38c29fdd96",
                                "text": "The other day I heard a girl hailing from the moorlands of Yorkshire remark that she had \"laited a long time for the children, but could not find them,\" evidently meaning she had sought for them. Is this word common to Yorkshire?"
                            }
                        ]
                    }
