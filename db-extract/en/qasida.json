                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f215602-a7c2-46dd-954d-9d0788977830",
                                "sense_id": "ae19f81f-0fcd-3dc2-825e-10e50a3622c9",
                                "text": "He was delighted to hear some music and listened with emotion to the wild qasidas that the old man sang – songs of the Arab canon full of the wild heart-sickness of the desert."
                            },
                            {
                                "example_id": "7d57be4c-00eb-4b88-835a-12b7c03a05b8",
                                "sense_id": "ae19f81f-0fcd-3dc2-825e-10e50a3622c9",
                                "text": "The qasida is a formal multithematic ode addressed to a member of the elite in praise."
                            }
                        ]
