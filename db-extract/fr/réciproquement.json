                                        "examples": [
                                            {
                                                "example_id": "adca3c48-01d0-4403-b9a0-a544bdf3d457",
                                                "sense_id": "f9dd80ac-6771-389c-a03c-c324ba58d642",
                                                "text": "At dinner Marigold had the Rector on her right and the Colonel on her left, Francis had their wives the other way round to avoid any signs of preference, […]"
