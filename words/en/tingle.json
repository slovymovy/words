{
    "word_family": [
        "tingly",
        "tingling",
        "tingler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a2a5e07-bef3-3f85-9157-1dd2209cf53e",
                    "sense_definition": "to feel a prickling or mildly stinging sensation",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My fingers began to <w>tingle</w> after being out in the freezing snow for an hour.",
                            "target_lang_translations": {
                                "ru": "Мои пальцы начало <w>покалывать</w> после того, как я провел час на морозе.",
                                "zh": "在冰天雪地里待了一个小时后，我的手指开始<w>发麻</w>。"
                            }
                        },
                        {
                            "text": "She felt her skin <w>tingle</w> with excitement as the concert was about to begin.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала, как по коже пробежало <w>покалывание</w> от волнения, когда концерт вот-вот должен был начаться.",
                                "zh": "音乐会即将开始，她感到皮肤因兴奋而产生一阵<w>刺痛感</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prickle",
                        "sting"
                    ],
                    "common_phrases": [
                        "tingle with excitement",
                        "tingle with cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "испытывать ощущение покалывания или легкого жжения",
                        "zh": "感到刺痛或轻微的灼烧感"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покалывать",
                                "target_lang_sense_clarification": "о физическом ощущении"
                            },
                            {
                                "target_lang_word": "щипать",
                                "target_lang_sense_clarification": "о коже или глазах"
                            },
                            {
                                "target_lang_word": "зудеть",
                                "target_lang_sense_clarification": "вызывать легкий зуд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺痛",
                                "target_lang_sense_clarification": "指皮肤或身体部位的物理感觉"
                            },
                            {
                                "target_lang_word": "发麻",
                                "target_lang_sense_clarification": "指因寒冷或血液循环不畅引起的感觉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8830fa20-1959-3f30-93f0-532806c7343d",
                    "sense_definition": "to cause someone to feel a prickling or mildly stinging sensation",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spicy peppers will <w>tingle</w> your tastebuds and leave a warm heat in your mouth.",
                            "target_lang_translations": {
                                "ru": "Острый перец будет <w>пощипывать</w> ваши вкусовые рецепторы и оставит приятное тепло во рту.",
                                "zh": "辛辣的辣椒会<w>刺激</w>你的味蕾，并在口中留下一阵暖意。"
                            }
                        },
                        {
                            "text": "The cold minty lotion started to <w>tingle</w> his skin immediately after application.",
                            "target_lang_translations": {
                                "ru": "Холодный мятный лосьон начал <w>покалывать</w> кожу сразу после нанесения.",
                                "zh": "涂抹后，清凉的薄荷乳液立刻让他的皮肤感到一阵<w>刺痛</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tingle your tastebuds"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать у кого-либо ощущение покалывания или легкого жжения",
                        "zh": "使某人感到刺痛或轻微的灼烧感"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покалывать",
                                "target_lang_sense_clarification": "вызывать покалывание"
                            },
                            {
                                "target_lang_word": "пощипывать",
                                "target_lang_sense_clarification": "о специях или лосьонах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……刺痛",
                                "target_lang_sense_clarification": "引起刺痛感"
                            },
                            {
                                "target_lang_word": "使……发麻",
                                "target_lang_sense_clarification": "引起麻木或刺痛感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21952df0-8844-3d8d-b52d-cb95557fd2e0",
                    "sense_definition": "to ring with a light, metallic sound",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small silver bells <w>tingle</w> softly whenever the door is opened by a customer.",
                            "target_lang_translations": {
                                "ru": "Маленькие серебряные колокольчики тихо <w>звенят</w> каждый раз, когда покупатель открывает дверь.",
                                "zh": "每当有顾客开门时，小银铃就会发出轻柔的<w>叮当声</w>。"
                            }
                        },
                        {
                            "text": "I could hear the wind chimes <w>tingle</w> in the distance during the quiet night.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как вдалеке в тихую ночь <w>звенят</w> ветряные колокольчики.",
                                "zh": "在寂静的夜晚，我能听到远处风铃发出的<w>叮当声</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tinkle"
                    ],
                    "target_lang_definitions": {
                        "ru": "издавать легкий металлический звон",
                        "zh": "发出轻微的金属碰撞声"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звенеть",
                                "target_lang_sense_clarification": "издавать звон"
                            },
                            {
                                "target_lang_word": "дребезжать",
                                "target_lang_sense_clarification": "о тонком металлическом звуке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "叮当响",
                                "target_lang_sense_clarification": "形容轻微的金属声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "440fbb62-a71b-3650-9005-7e167dc2ef3d",
                    "sense_definition": "to patch a hole with a small piece of metal or material to make it watertight",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "repair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor had to <w>tingle</w> the hull of the boat to stop the small leak.",
                            "target_lang_translations": {
                                "ru": "Моряку пришлось <w>залатать</w> корпус лодки, чтобы остановить небольшую течь.",
                                "zh": "水手必须<w>修补</w>船体以止住小漏水。"
                            }
                        },
                        {
                            "text": "If the damage is small, you can <w>tingle</w> it over with a piece of lead.",
                            "target_lang_translations": {
                                "ru": "Если повреждение небольшое, его можно <w>заделать</w> куском свинца.",
                                "zh": "如果损坏较小，你可以用一块铅将其<w>补好</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tingle it over"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in nautical or roofing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "заделывать отверстие небольшим куском металла или материала для обеспечения водонепроницаемости",
                        "zh": "用金属片或材料修补孔洞以达到防水效果"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "латать",
                                "target_lang_sense_clarification": "ставить заплату"
                            },
                            {
                                "target_lang_word": "заделывать",
                                "target_lang_sense_clarification": "устранять течь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "修补",
                                "target_lang_sense_clarification": "指对船体或屋顶的修补"
                            },
                            {
                                "target_lang_word": "补漏",
                                "target_lang_sense_clarification": "专门针对防水的修补"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a4aeb1d2-114e-33c9-9a0b-12cb92bc7c57",
                    "sense_definition": "a prickling or mildly stinging sensation on the skin",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a slight <w>tingle</w> in his arm after sitting in the same position for too long.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал легкое <w>покалывание</w> в руке после того, как слишком долго сидел в одной позе.",
                                "zh": "保持同一个姿势坐得太久后，他感到手臂有一阵轻微的<w>发麻</w>。"
                            }
                        },
                        {
                            "text": "The sudden <w>tingle</w> of anticipation ran down her spine as she waited for the news.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>трепет</w> предвкушения пробежал по ее спине, пока она ждала новостей.",
                                "zh": "当她等待消息时，心中突然涌起一阵期待的<w>战栗</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tingle of anticipation",
                        "slight tingle"
                    ],
                    "target_lang_definitions": {
                        "ru": "ощущение покалывания или легкого жжения на коже",
                        "zh": "皮肤上的一种刺痛或轻微灼烧的感觉"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покалывание",
                                "target_lang_sense_clarification": "физическое чувство"
                            },
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "эмоциональное возбуждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺痛感",
                                "target_lang_sense_clarification": "物理上的刺痛"
                            },
                            {
                                "target_lang_word": "战栗",
                                "target_lang_sense_clarification": "指因激动或期待而产生的心理生理反应"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88346f16-8754-30b4-afe0-65e0fb00a389",
                    "sense_definition": "a light, ringing or chiming sound",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentle <w>tingle</w> of a wind chime drifted to her on the ocean breeze.",
                            "target_lang_translations": {
                                "ru": "Нежный <w>звон</w> ветряных колокольчиков донесся до нее с океанским бризом.",
                                "zh": "海风吹来，风铃发出轻柔的<w>叮当声</w>。"
                            }
                        },
                        {
                            "text": "The crisp <w>tingle</w> of bells could be heard throughout the quiet mountain village.",
                            "target_lang_translations": {
                                "ru": "Чистый <w>звон</w> колоколов был слышен по всей тихой горной деревне.",
                                "zh": "清脆的<w>铃声</w>在宁静的山村里回荡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tinkle"
                    ],
                    "common_phrases": [
                        "tingle of bells"
                    ],
                    "target_lang_definitions": {
                        "ru": "легкий, звенящий или мелодичный звук",
                        "zh": "轻微的叮当声或铃声"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звон",
                                "target_lang_sense_clarification": "легкий металлический звук"
                            },
                            {
                                "target_lang_word": "дребезжание",
                                "target_lang_sense_clarification": "тонкий звук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "叮当声",
                                "target_lang_sense_clarification": "轻微的金属碰撞声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac6f0031-2ba8-3394-9e62-4d4ec61da426",
                    "sense_definition": "a patch used to cover a hole in a roof or boat to keep it watertight",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "repair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a copper <w>tingle</w> to repair the leak in the old wooden roof.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал медную <w>заплату</w>, чтобы устранить течь в старой деревянной крыше.",
                                "zh": "木匠用一块铜制<w>补片</w>修补了旧木屋顶的漏水处。"
                            }
                        },
                        {
                            "text": "A thin metal <w>tingle</w> was fitted to the outboard face of the board to seal the gap.",
                            "target_lang_translations": {
                                "ru": "Тонкая металлическая <w>планка</w> была установлена на внешнюю сторону доски, чтобы закрыть щель.",
                                "zh": "一块薄金属<w>补片</w>被安装在木板外侧以密封缝隙。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "copper tingle",
                        "metal tingle"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Technical term in roofing and boat building"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "заплата, используемая для закрытия отверстия в крыше или лодке",
                        "zh": "用于覆盖屋顶或船体孔洞以防水的补片"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заплата",
                                "target_lang_sense_clarification": "металлическая или кровельная"
                            },
                            {
                                "target_lang_word": "планка",
                                "target_lang_sense_clarification": "для герметизации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "补片",
                                "target_lang_sense_clarification": "用于修补的金属片"
                            },
                            {
                                "target_lang_word": "补丁",
                                "target_lang_sense_clarification": "通用的修补材料"
                            }
                        ]
                    }
                }
            ]
        },
        {
