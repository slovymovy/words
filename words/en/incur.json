{
    "word_family": [
        "incursion",
        "incurrence",
        "incurrable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb701cf7-962e-3821-83d2-12c112681405",
                    "sense_definition": "To bring something unpleasant or unwelcome upon oneself, such as a debt, penalty, or negative consequence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consequences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you do not pay your credit card bill on time, you will <w>incur</w> a late fee.",
                            "target_lang_translations": {
                                "ru": "Если вы не оплатите счет по кредитной карте вовремя, вам придется <w>понести</w> расходы в виде штрафа за просрочку."
                            }
                        },
                        {
                            "text": "The company had to <w>incur</w> costs for the repairs after the storm damaged the warehouse.",
                            "target_lang_translations": {
                                "ru": "Компании пришлось <w>понести</w> расходы на ремонт после того, как шторм повредил склад."
                            }
                        }
                    ],
                    "common_phrases": [
                        "incur costs",
                        "incur a penalty",
                        "incur debt",
                        "incur expenses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Навлечь на себя что-либо неприятное или нежелательное, например, долг, штраф или негативные последствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понести",
                                "target_lang_sense_clarification": "расходы, убытки или наказание"
                            },
                            {
                                "target_lang_word": "навлечь на себя",
                                "target_lang_sense_clarification": "неприятности или долги"
                            },
                            {
                                "target_lang_word": "обзавестись",
                                "target_lang_sense_clarification": "долгами или обязательствами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ec47511-740a-3c60-b350-a16e9a883bb5",
                    "sense_definition": "To make oneself or someone else liable or subject to a particular treatment or reaction, often negative.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "consequences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His controversial remarks were likely to <w>incur</w> the wrath of the local community.",
                            "target_lang_translations": {
                                "ru": "Его противоречивые высказывания, скорее всего, должны были <w>вызвать</w> гнев местной общины."
                            }
                        },
                        {
                            "text": "The politician's decision to raise taxes <w>incurred</w> displeasure among his supporters.",
                            "target_lang_translations": {
                                "ru": "Решение политика повысить налоги <w>вызвало</w> недовольство среди его сторонников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "incur the wrath",
                        "incur displeasure",
                        "incur suspicion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать себя или кого-либо другого объектом определенного отношения или реакции, часто негативной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызвать",
                                "target_lang_sense_clarification": "гнев, недовольство или подозрение"
                            },
                            {
                                "target_lang_word": "навлечь",
                                "target_lang_sense_clarification": "на себя гнев или немилость"
                            },
                            {
                                "target_lang_word": "подвергаться",
                                "target_lang_sense_clarification": "воздействию или отношению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25bf2aa4-1c40-3b91-a3d8-4f7c4e6cfabd",
                    "sense_definition": "To happen or occur within a specific period or scope.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal experts debated whether the incident <w>incurred</w> within the timeframe of the contract.",
                            "target_lang_translations": {
                                "ru": "Юристы спорили о том, <w>произошел</w> ли инцидент в сроки, предусмотренные контрактом."
                            }
                        },
                        {
                            "text": "Such rare events only <w>incur</w> under very specific environmental conditions.",
                            "target_lang_translations": {
                                "ru": "Такие редкие события <w>случаются</w> только при очень специфических условиях окружающей среды."
                            }
                        }
                    ],
                    "synonyms": [
                        "occasion"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить или случаться в рамках определенного периода или сферы (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "случаться в определенный период"
                            },
                            {
                                "target_lang_word": "иметь место",
                                "target_lang_sense_clarification": "случаться при определенных условиях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}