                        "entry_id": "1663e4db-fb3b-30dd-b8fe-60cdf9a97b34",
                        "glosses": [
                            "cecha tego, co jest seksowne; cecha tego, kto jest seksowny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae6e17d-f05e-4316-94ba-4f9b4eb5b759",
                                "sense_id": "6937538d-d11a-3bd9-9009-3f6bd77b64af",
                                "text": "Ważnym elementem obrazu współczesnej reklamy jest „seksowność”. Reklama piwa marki EB długo kojarzyć się będzie polskim telewidzom z ładnymi nogami młodej kobiety w czerwonej mini w białe groszki"
                            },
                            {
                                "example_id": "33a293b1-115e-4186-a7f0-5004a93a4385",
                                "sense_id": "6937538d-d11a-3bd9-9009-3f6bd77b64af",
                                "text": "Mocny, wyzywający makijaż dopełniał obrazu tej wyuzdanej, nieco prymitywnej, ale niepodważalnej seksowności imprezowej dziuni. – I jak? – zapytała, wypychając biodro i kładąc na nim rękę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
