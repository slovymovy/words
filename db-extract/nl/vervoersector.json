                        "glosses": [
                            "alle bedrijven en organisaties die zich bezighouden met het transport van mensen en zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9026336f-4301-4c7d-9a68-0385d6b7d850",
                                "sense_id": "9e74250a-b78f-3370-a6bb-3bfc7181204c",
                                "text": "In twee jaar tijd groeide de omzet in de elektrisch-vervoersector met 44 procent, naar 1,3 miljard euro. Het aantal banen in de sector steeg in die periode met 28 procent tot 4290, blijkt uit een rapport van de Rijksdienst voor Ondernemend Nederland (RVO)."
                            },
                            {
                                "example_id": "08c9baa1-fead-4d8b-b4f6-0613b83dede8",
                                "sense_id": "9e74250a-b78f-3370-a6bb-3bfc7181204c",
                                "text": "Vooral in de zakelijke dienstverlening en in de handel en de vervoersector kromp het aantal banen sterker dan eerder geraamd."
                            }
                        ]
                    }
