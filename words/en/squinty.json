{
    "word_family": [
        "squint",
        "squinter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f6625ea3-25c6-3072-a59c-d80349a11038",
                    "sense_definition": "Characterized by or having a squint, or appearing narrowed and partly closed.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stepped into the bright sunlight with <w>squinty</w> eyes.",
                            "target_lang_translations": {
                                "es": "Salió a la brillante luz del sol con los ojos <w>entrecerrados</w>."
                            }
                        },
                        {
                            "text": "The bright glare on the water made everyone look tired and <w>squinty</w>.",
                            "target_lang_translations": {
                                "es": "El intenso reflejo en el agua hacía que todos parecieran cansados y con los ojos <w>achinados</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cross-eyed",
                        "squinting"
                    ],
                    "common_phrases": [
                        "squinty eyes"
                    ],
                    "target_lang_definitions": {
                        "es": "Que tiene los ojos entrecerrados o achinados, o que padece de estrabismo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "entrecerrado",
                                "target_lang_sense_clarification": "dicho de los ojos o la mirada, parcialmente cerrados"
                            },
                            {
                                "target_lang_word": "achinado",
                                "target_lang_sense_clarification": "dicho de ojos estrechos o entrecerrados"
                            },
                            {
                                "target_lang_word": "bizco",
                                "target_lang_sense_clarification": "que padece de estrabismo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47c6a047-7b88-3abb-8064-c83727620cf9",
                    "sense_definition": "Directed to one side; sidelong or oblique.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him a quick, <w>squinty</w> look before answering the question.",
                            "target_lang_translations": {
                                "es": "Ella le lanzó una mirada rápida y <w>de reojo</w> antes de responder a la pregunta."
                            }
                        },
                        {
                            "text": "He cast a <w>squinty</w> glance toward the door when the bell rang.",
                            "target_lang_translations": {
                                "es": "Echó una mirada <w>de soslayo</w> hacia la puerta cuando sonó el timbre."
                            }
                        }
                    ],
                    "synonyms": [
                        "sidelong",
                        "sideways",
                        "oblique"
                    ],
                    "common_phrases": [
                        "squinty glance",
                        "squinty look"
                    ],
                    "target_lang_definitions": {
                        "es": "Dirigido hacia un lado; de reojo, oblicuo o esquivo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "de reojo",
                                "target_lang_sense_clarification": "mirada dirigida lateralmente y con sospecha o cautela"
                            },
                            {
                                "target_lang_word": "oblicuo",
                                "target_lang_sense_clarification": "no directo, de soslayo"
                            },
                            {
                                "target_lang_word": "de soslayo",
                                "target_lang_sense_clarification": "mirada de lado"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}