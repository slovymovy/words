                        "examples": [
                            {
                                "example_id": "54ab300e-bde5-4ee1-91f8-b22dfcda38a2",
                                "sense_id": "4095dc17-6ff7-3947-8e49-9a5472f164ae",
                                "text": "Les muscles extrinsèques sont au nombre de deux : le muscle du pilier antérieur ou glosso-staphylin, extrêmement peu volumineux, et le muscle du pilier postérieur ou pharyngo-staphylin, beaucoup plus large et plus important (fig. 381 )."
                            }
                        ]
                    }
                ],
