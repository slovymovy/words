                ],
                "senses": [
                    {
                        "sense_id": "bb282690-5f80-381d-ad61-b2c809a74b4e",
                        "entry_id": "677a99fd-b635-3a63-9a22-a5e516f743b1",
                        "glosses": [
                            "Sportbekleidung, die speziell zum Laufen entwickelt wurde oder beim Laufen getragen wird"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "d849b383-3249-4cec-9b65-3b76582c40ca",
                                "sense_id": "bb282690-5f80-381d-ad61-b2c809a74b4e",
                                "text": "„Als Experten für Laufkleidung achten wir darauf, dass keine störenden Nähte verarbeitet werden, dass nichts rutscht, piekst oder zwickt und einfach alles an Ort und Stelle sitzt.“"
                            },
                            {
                                "example_id": "4e8a9012-ad05-4e53-b247-9c96807fe4c9",
                                "sense_id": "bb282690-5f80-381d-ad61-b2c809a74b4e",
                                "text": "„Laufkleidung für den Winter ist atmungsaktiv, schnelltrocknend und wärmend.“"
                            },
                            {
                                "example_id": "6f3920fc-e223-43b5-8426-76f279ccbf3a",
                                "sense_id": "bb282690-5f80-381d-ad61-b2c809a74b4e",
                                "text": "„Ich fahre da sehr gut mit der relativ günstigen Laufkleidung eines bekannten Kaffeerösters.“"
                            },
                            {
                                "example_id": "f0d4fabc-9d6a-4ab0-9f9d-ac3fd9ec87eb",
                                "sense_id": "bb282690-5f80-381d-ad61-b2c809a74b4e",
                                "text": "„Ich hab noch nie so viele Menschen in bunter Laufkleidung (nein, ich habe nichts gegen bunte Lauf/ Sportkleidung, ich trage sie selbst) durch den Wald rennen sehen.“"
                            },
                            {
                                "example_id": "eb5d7330-72c7-4d26-8a75-4f054494004a",
                                "sense_id": "bb282690-5f80-381d-ad61-b2c809a74b4e",
                                "text": "„Ich bin bei Laufkleidung und Zubehör nicht festgelegt und habe von geschätzten zehn Markenherstellern diverse Tops, T-Shirts, Hosen, Laufweste, Trailrunning-Stöcke, Socken, Schuhe und Co. (… und da sag mal einer, Laufen wäre eine so minimalistische Sportart!).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
