                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uncertainty_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legality of the transaction falls into a <w>gray</w> area.",
                            "target_lang_translations": {
                                "ru": "Законность этой сделки попадает в <w>серую</w> зону.",
                                "zh": "这笔交易的合法性属于<w>灰色</w>地带。"
                            }
                        },
                        {
                            "text": "There is a <w>gray</w> market for imported electronics that avoids official taxes.",
                            "target_lang_translations": {
                                "ru": "Существует <w>серый</w> рынок импортной электроники, позволяющий избегать официальных налогов.",
                                "zh": "存在一个规避官方税收的进口电子产品<w>灰色</w>市场。"
                            }
                        }
                    ],
