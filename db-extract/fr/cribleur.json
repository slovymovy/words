                "senses": [
                    {
                        "sense_id": "0e189b4f-87f3-312c-8d62-646dbc5e0031",
                        "entry_id": "3f2e209f-47b3-30a4-bd6a-247cc1d06521",
                        "glosses": [
                            "Celui qui crible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947f58da-f360-4761-8141-22989a6a9e83",
                                "sense_id": "0e189b4f-87f3-312c-8d62-646dbc5e0031",
                                "text": "Pour séparer ainsi ces grains, le cribleur, à l’aide d’une corde au bout de laquelle est un crochet, suspend le crible en l’air & l’agite par une espèce de mouvement circulaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f3b854d-90be-3ed7-b522-0344c69b86b4",
                        "entry_id": "3f2e209f-47b3-30a4-bd6a-247cc1d06521",
                        "glosses": [
                            "Machine servant à cribler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd581da-febb-4ee9-b5ca-3d0cd238118f",
                                "sense_id": "5f3b854d-90be-3ed7-b522-0344c69b86b4",
                                "text": "Les cribleurs sont surtout employés pour calibrer les grains de même nature et pour isoler les grains ou les corps étrangers plus gros ou plus petits que le grain à trier."
                            },
                            {
                                "example_id": "e559b153-9d53-4030-bc46-0481def4e82c",
                                "sense_id": "5f3b854d-90be-3ed7-b522-0344c69b86b4",
                                "text": "Un cribleur mobile est un engin autonome sur roues ou chenilles permettant de traiter de grandes quantités de matériaux, de manière performante et rapide."
                            }
                        ]
                    }
                ],
