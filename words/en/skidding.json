                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трелёвка",
                                "target_lang_sense_clarification": "транспортировка поваленных деревьев волоком"
                            },
                            {
                                "target_lang_word": "трелевание",
