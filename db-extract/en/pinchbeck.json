                    }
                ],
                "senses": [
                    {
                        "sense_id": "69fd754e-6c3a-3fae-b622-f21ce76b2976",
                        "entry_id": "438cbb6b-a1e2-315a-9146-c0d57197648b",
                        "glosses": [
                            "An alloy of copper and zinc once used as imitation gold for cheap jewelry."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1d4999c-31aa-4b22-b51c-9d646c12dd5e",
                        "source_entry_id": "438cbb6b-a1e2-315a-9146-c0d57197648b",
                        "source_sense_id": "69fd754e-6c3a-3fae-b622-f21ce76b2976",
                        "source_sense_description": "an alloy of copper and zinc",
                        "target_lang_word": "Talmi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Talmi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a591b26-0d4e-393c-841a-1707a05f9c9a",
                                        "entry_id": "e3d55390-97ec-3f8b-93ed-08db3c2cdbf7",
                                        "glosses": [
                                            "Legierung aus Kupfer und Zink (Tombak), die mit Blattgold überzogen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2628f1d5-26ed-47b2-a5df-ab02a9680945",
                                                "sense_id": "9a591b26-0d4e-393c-841a-1707a05f9c9a",
                                                "text": "Talmi (von französisch Tallois-demi-or) ist ein Falschgold, das von Tallois, einem Pariser Fabrikanten, zuerst hergestellt wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "def09836-89d9-3c42-960f-889c5114473d",
                                        "entry_id": "e3d55390-97ec-3f8b-93ed-08db3c2cdbf7",
                                        "glosses": [
                                            "etwas nicht Echtes, Wertloses"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15e59c4b-c1b9-44e3-a9c4-817b1a21c72d",
                                                "sense_id": "def09836-89d9-3c42-960f-889c5114473d",
                                                "text": "Auch wenn er kurzzeitig eine Ziege, ein Kuhgebiss, ein paar Kessel, eine Gans und eine auf Untermaß geschrumpfte Katze zum Tönen bringt, ist dies doch nur Intermezzo, Talmi der Ablenkung."
                                            },
                                            {
                                                "example_id": "3ae4f67f-6d7a-420b-a5b9-4ac5f1d873cd",
                                                "sense_id": "def09836-89d9-3c42-960f-889c5114473d",
                                                "text": "Inzwischen weiß man, dass Träger der Namen von Anhalt, Sayn-Wittgenstein oder Schaumburg-Lippe mitunter Talmi (Falschgold) sind."
                                            },
                                            {
                                                "example_id": "abd8c14e-51bf-48b7-a435-b5b523bd5bb5",
                                                "sense_id": "def09836-89d9-3c42-960f-889c5114473d",
                                                "text": "Doch: Vieles, was glänzt, ist oft nur Talmi, überhaupt wenn es um dauerhaften Erhalt von Arbeitsplätzen geht."
                                            },
                                            {
                                                "example_id": "7da9d557-a7d8-48f5-9fad-03a3c93187ff",
                                                "sense_id": "def09836-89d9-3c42-960f-889c5114473d",
                                                "text": "Heute, in einer verlotterten Demokratie, sei alles Talmi, falsch, durch Reklame groß gemachter Betrug."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ba986da-ca38-4f65-8d6d-d0256459a970",
                        "source_entry_id": "438cbb6b-a1e2-315a-9146-c0d57197648b",
