                ],
                "senses": [
                    {
                        "sense_id": "d7040d45-f101-3531-88ae-8c7f0db8a2b5",
                        "entry_id": "e4c83e27-ef28-38de-a12a-e7cebf001020",
                        "glosses": [
                            "de tijd dat een vrouw een ongeboren kind met zich draagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b28e57e8-4d97-4e7c-9228-9e7714c223dc",
                                "sense_id": "d7040d45-f101-3531-88ae-8c7f0db8a2b5",
                                "text": "Zij voelde zich niet lekker door haar zwangerschap."
                            },
                            {
                                "example_id": "4b2cb903-f3b7-4f45-9d53-20e6c8b4beef",
                                "sense_id": "d7040d45-f101-3531-88ae-8c7f0db8a2b5",
                                "text": "De aflossing had eigenlijk al uren geleden moeten plaatsvinden, maar de jonge echtgenote van Widmar Krause had 's ochtends weeën gekregen en het was haar eerste zwangerschap."
                            },
                            {
                                "example_id": "933e69e2-e5d7-40c4-abd2-c091b7b340a0",
                                "sense_id": "d7040d45-f101-3531-88ae-8c7f0db8a2b5",
                                "text": "Aanleiding voor mijn vrijwillige prostitutie was mijn zwangerschap, want al tijdens mijn derde week in Hohenschônhausen begon ik te vermoeden dat ik zwanger was van Werner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "991efa5e-1935-4c7a-8ca7-b018ffec3261",
                        "source_entry_id": "e4c83e27-ef28-38de-a12a-e7cebf001020",
                        "source_sense_id": "d7040d45-f101-3531-88ae-8c7f0db8a2b5",
                        "source_sense_description": "de tijd dat een vrouw een ongeboren kind met zich draagt",
                        "target_lang_word": "Schwangerschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwangerschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7564a4e-d93b-33ac-9d5e-e702a3d09809",
                                        "entry_id": "405b67dd-d47e-3404-a6a7-8b2f896eb2af",
                                        "glosses": [
                                            "bestimmte körperliche Verfassung einer Frau, die mit der Empfängnis beginnt und mit der Geburt des Kindes endet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734890c5-766d-4da3-936b-5bdf36c19ff4",
                                                "sense_id": "d7564a4e-d93b-33ac-9d5e-e702a3d09809",
                                                "text": "Während der Schwangerschaft sind Alkohol und Zigaretten verboten."
                                            },
                                            {
                                                "example_id": "1874be0c-3635-4a58-b7f4-437d9112eeeb",
                                                "sense_id": "d7564a4e-d93b-33ac-9d5e-e702a3d09809",
                                                "text": "Eine Schwangerschaft dauert beim Menschen ungefähr neun Monate."
                                            },
                                            {
                                                "example_id": "e6717f2c-e2bb-41f8-b3b6-01e9fe42096e",
                                                "sense_id": "d7564a4e-d93b-33ac-9d5e-e702a3d09809",
                                                "text": "„Übertroffen werden konnte dieser Supergau eigentlich nur durch eine voreheliche Schwangerschaft.“"
                                            },
                                            {
                                                "example_id": "e4762f44-d936-4ed4-b8fb-aa41c5fe8757",
                                                "sense_id": "d7564a4e-d93b-33ac-9d5e-e702a3d09809",
                                                "text": "Laut offiziellen Angaben nimmt in Sachsen auch die Zahl der Mütter zu, die während der Schwangerschaft Crystal Meth konsumieren."
                                            },
                                            {
                                                "example_id": "0fdbdfdd-d4f9-4866-9c2d-93c7825edea7",
                                                "sense_id": "d7564a4e-d93b-33ac-9d5e-e702a3d09809",
                                                "text": "„Besonders stark wächst die Bevölkerung in Entwicklungsländern - unter anderem aufgrund von ungewollten Schwangerschaften.“"
                                            },
                                            {
                                                "example_id": "9b8d3e31-51a4-4bc7-b37e-d4aaf0cba614",
                                                "sense_id": "d7564a4e-d93b-33ac-9d5e-e702a3d09809",
                                                "text": "„2020 wurden rund 100.000 Schwangerschaften in Deutschland abgebrochen.“"
                                            },
                                            {
                                                "example_id": "5d9f1022-20a2-42be-b83f-f531109555ca",
                                                "sense_id": "d7564a4e-d93b-33ac-9d5e-e702a3d09809",
                                                "text": "„Demnach ist ein Abbruch [in Deutschland] dann nicht strafbar, wenn sich die Frau mindestens drei Tage vorher von einer anerkannten Beratungsstelle zu dem Eingriff hat beraten lassen und dem Arzt anschließend eine Bescheinigung vorweisen kann und die Schwangerschaft nicht schon länger als 12 Wochen besteht.“"
                                            },
                                            {
                                                "example_id": "442a6c7a-91b8-42bf-85da-d93cd0279058",
                                                "sense_id": "d7564a4e-d93b-33ac-9d5e-e702a3d09809",
                                                "text": "Erkrankt eine schwangere Frau an Krebs, müssen Mediziner abwägen, ob sie während der Schwangerschaft mit einer Behandlung beginnen oder danach. Ob die Substanzen, die bei einer Chemotherapie verabreicht werden, tatsächlich negative Folgen für das Ungeborene haben, war bislang unklar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a4d1ecb-4197-486d-8ab9-c9277ccf0124",
                        "source_entry_id": "e4c83e27-ef28-38de-a12a-e7cebf001020",
