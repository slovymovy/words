                "senses": [
                    {
                        "sense_id": "ab83967c-8445-3c73-91b8-7518a7e51aa0",
                        "entry_id": "ba50d479-7c9c-33cb-9e11-14ea6bcade2a",
                        "glosses": [
                            "One who sends mail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c370719-05c4-4a83-b6a0-8acf5d3bf0f8",
                                "sense_id": "ab83967c-8445-3c73-91b8-7518a7e51aa0",
                                "text": "Large and frequent mailers may send material on a monthly basis to their house lists, test acquisitions several times a year to drum up new donors, and perhaps do a few special appeals on top of that."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b72258d-fd81-3e13-bc99-7c8e8955eca4",
                        "entry_id": "ba50d479-7c9c-33cb-9e11-14ea6bcade2a",
                        "glosses": [
                            "A computer program that sends electronic mail."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b12b2908-f136-3a20-a5e3-e0c9656015e8",
                        "entry_id": "ba50d479-7c9c-33cb-9e11-14ea6bcade2a",
                        "glosses": [
                            "A packet or container designed for postal use."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e5ef4fe-4b82-423c-a6a9-612743accc39",
                                "sense_id": "b12b2908-f136-3a20-a5e3-e0c9656015e8",
                                "text": "The cassette came in a brown paper mailer."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b16e9f5-93de-38ac-9b8d-f07af3deacec",
                        "entry_id": "ba50d479-7c9c-33cb-9e11-14ea6bcade2a",
                        "glosses": [
                            "A mailshot; advertising sent by mail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ab08aff-9d3e-4d06-aa39-aef5825f408f",
                                "sense_id": "9b16e9f5-93de-38ac-9b8d-f07af3deacec",
                                "text": "Lasky Co., Newark (N. J.) printer, has been using a direct-mail campaign slanted toward this problem. Latest mailer, an oversized post card, has on the address side a colorful drawing of a bird perched on top of a sign post."
                            },
                            {
                                "example_id": "d1327cca-1130-4269-9ec6-eb84d6938a88",
                                "sense_id": "9b16e9f5-93de-38ac-9b8d-f07af3deacec",
                                "text": "Do they recall your latest mailer? Did you ever sell an armoire through ads on hard-rock radio? Find out with low-cost \"intercept\" surveys of customers as they leave the store."
                            },
                            {
                                "example_id": "9b968f2b-83be-4afb-b2d4-45af90e4b9ed",
                                "sense_id": "9b16e9f5-93de-38ac-9b8d-f07af3deacec",
                                "text": "Do not delete this mailer as information given within may not be repeated in subsequent mailers."
                            }
                        ]
                    }
                ],
