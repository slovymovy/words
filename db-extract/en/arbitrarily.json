                "senses": [
                    {
                        "sense_id": "cb436b7b-45fd-3735-a58f-b002ac7e1552",
                        "entry_id": "e7a27d26-fd72-3441-97c3-054ed110ba12",
                        "glosses": [
                            "Arbitrairement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10fc574d-0147-4d64-aa4b-44dd7acc9b97",
                                "sense_id": "cb436b7b-45fd-3735-a58f-b002ac7e1552",
                                "text": "It’s not there arbitrarily or because it might be nice to shoot from there now. It’s never decorative and never just frivolous. It’s always with a point and a reason.",
                                "translation": "Ce n’est pas là arbitrairement ou parce qu’il serait peut-être agréable de tourner à partir de là maintenant. Ce n’est jamais décoratif et jamais simplement frivole. C’est toujours avec un but et une raison."
                            }
                        ]
