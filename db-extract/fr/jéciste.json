                ],
                "senses": [
                    {
                        "sense_id": "7832ab85-1152-3da9-b1a6-38ce9f81a456",
                        "entry_id": "6510f6d0-38d3-3736-abd2-7f9f5af32608",
                        "glosses": [
                            "Membre à la JEC."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73e8bf11-ef93-4603-9822-40e0a5545de7",
                                "sense_id": "7832ab85-1152-3da9-b1a6-38ce9f81a456",
                                "text": "Ma première pensée fut de me reposer, mais combien cela m'a semblé peu digne d'une jéciste convaincue. Il n'y a pas de vacances pour le Bon Dieu."
                            },
                            {
                                "example_id": "6b893062-6100-4088-8db5-0f9c5b861cb2",
                                "sense_id": "7832ab85-1152-3da9-b1a6-38ce9f81a456",
                                "text": "A cette action caritative, due aux malheurs de la guerre, tant à l'égard des réfugiés que des soldats, vient s'ajouter pour les jécistes demeurés à l'arrière une mission de suppléance."
                            },
                            {
                                "example_id": "f1ad53f4-23e1-4d5e-9d66-17e35f96a427",
                                "sense_id": "7832ab85-1152-3da9-b1a6-38ce9f81a456",
                                "text": "Comme on disputait de la divinité de Jésus, un étourdi – probablement un jéciste, une fois de plus, avait dû penser Patrice – avait déclaré hautement – et courtement ! – que pour lui, l'essentiel, c'était le Christ."
                            }
                        ]
                    }
                ],
