                        },
                        {
                            "text": "Mr. <w>Dill</w> will be joining our meeting later this afternoon.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Дилл</w> присоединится к нашему собранию сегодня во второй половине дня.",
                                "pl": "Pan <w>Dill</w> dołączy do naszego spotkania dziś po południu."
                            }
                        }
                    ],
                    "traits": [
                        {
