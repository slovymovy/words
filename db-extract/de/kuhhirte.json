                    }
                ],
                "translations": [
                    {
                        "translation_id": "55485027-3bef-4cc1-bd8f-c8c77a468869",
                        "source_entry_id": "bbc800b6-fd7e-3298-ad3f-937674ecf8a1",
                        "source_sense_id": "bcc635b7-a276-3eb6-805a-bf96ec5a04f5",
                        "source_sense_description": "jemand, der Kühe hütet",
                        "target_lang_word": "cowherd",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cowherd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1376703d-083c-3e04-872a-bd586052ce0a",
                                        "entry_id": "1c40bd02-1d69-33fa-ac19-3f864d127bbc",
                                        "glosses": [
                                            "One who herds cattle; a cowboy."
                                        ],
                                        "tags": [],
