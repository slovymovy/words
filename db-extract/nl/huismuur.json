                    {
                        "sense_id": "3477b4fd-cba9-3bc0-bd03-d8f42566a1fb",
                        "entry_id": "ded08b10-b021-342e-9a27-fb8986dab8d3",
                        "glosses": [
                            "de buitenmuren van een gebouw waarin mensen woont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01467cc1-9eb0-4366-9e13-1d1d73300fb0",
                                "sense_id": "3477b4fd-cba9-3bc0-bd03-d8f42566a1fb",
                                "text": "Maar is er sinds 2002 in hun stadsgrachten en tegen hun huismuren ook maar een halve liter minder wildgeplast dan vóór die tijd? Beloften! Geert komt met daden. Twee keer op straat je gulp opengeritst? Terug naar Marokko. Dat zal ze leren."
                            },
                            {
                                "example_id": "8304c242-4c96-460c-afc2-ccdaed4cd697",
                                "sense_id": "3477b4fd-cba9-3bc0-bd03-d8f42566a1fb",
                                "text": "De situationisten schreven vijftig jaar geleden op de Parijse huismuren: „Ne travaillez jamais!’’ Een tentoonstelling in Bremen haakt in op de discussies over werk en vrije tijd – aan de hand van kunst. Zo maakte Francis Alÿs in Mexico City een reportage van zichzelf terwijl hij zich tussen de werk zoekende elektriciens mengde."
                            },
                            {
                                "example_id": "feaeea88-be66-4562-8e9c-770ae9dce5d8",
                                "sense_id": "3477b4fd-cba9-3bc0-bd03-d8f42566a1fb",
                                "text": "Zo moeten Che’s mannen om twee scherpschutters in een kerktoren te neutraliseren eerst vijf huismuren slopen met een voorhamer. Dat komt allemaal in beeld."
                            }
                        ]
                    }
