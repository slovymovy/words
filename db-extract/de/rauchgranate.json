                        "glosses": [
                            "Granate, die eine starke Rauch- oder Nebelentwicklung erzeugt und als Rauch- oder Signalmittel eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ad8c35b-25af-498e-9a2e-a6fd980778ac",
                                "sense_id": "d2faa616-db68-3590-b3d2-0a7b2795e02f",
                                "text": "„Eine Reihe von Druckluftstößen hallte durch den Innenraum, als vorn und hinten in die Stoßstangen des Range Rovers eingelassene Vorrichtungen Rauchgranaten in die Luft schleuderten.“"
                            }
                        ],
