                ],
                "senses": [
                    {
                        "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                        "entry_id": "d6b05d03-ecc5-3ae1-a41b-77bc8f3a873d",
                        "glosses": [
                            "Blatt Papier, das zum Erstellen kurzer Notizen dient, beispielsweise für eine Einkaufsliste, das Merken einer Telefonnummer während eines Gesprächs, einen schnellen Entwurf oder eine handschriftliche Berechnung; gerne wird die Rückseite von bedrucktem Papier, eine Serviette oder ein benutzter Briefumschlag verwendet"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cc9e369e-4389-4d71-bb8a-62ae95d0a199",
                                "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                                "text": "Schmierzettel sind für Mind-Mapping optimal: Man strukturiert einfach schnell mal seine Gedanken."
                            },
                            {
                                "example_id": "6032de15-99eb-4f82-9585-7672e2b6c566",
                                "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                                "text": "„Du kannst doch deine Hausaufgaben nicht auf einem Schmierzettel machen. Wo hast du dein Heft?“"
                            },
                            {
                                "example_id": "2508db9d-fb47-4f8d-9368-24a99de46af7",
                                "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                                "text": "„Ich habe unsere Gedanken vom letzten Gespräch kurz auf einem Schmierzettel zusammengefasst. Können wir den nochmal durchgehen, dass ich nichts vergessen habe?“"
                            },
                            {
                                "example_id": "cc2ae2cd-5272-420f-a487-3719aff77571",
                                "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                                "text": "[Dem Fußballtrainer Julian] Nagelsmann kommen morgens im Bad nach eigenen Angaben die besten Spielideen, die er auf einem Schmierzettel notiert."
                            },
                            {
                                "example_id": "e448a9fb-506c-4663-bd8b-2b6d3c3a01ed",
                                "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                                "text": "Helga nutzte die Gelegenheit und reichte Yvonne blitzschnell ihren Schmierzettel hinüber."
                            },
                            {
                                "example_id": "4c044dec-e8f0-49c2-b851-72193a5cfd67",
                                "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                                "text": "[Bei einem Jobwechsel müssen] auch Schmierzettel […], auf denen jemand Notizen zu dienstlichen Besprechungen gemacht hat, und angekaute Bleistiftstummel im Büro bleiben."
                            },
                            {
                                "example_id": "1f445758-9f19-4f1c-a23c-92f4bddac141",
                                "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                                "text": "Altes Papier, Schmierzettel, Notizen - landen oft einfach im Müll, oder? Warum machen wir nicht einfach neues Papier draus?"
                            },
                            {
                                "example_id": "2f3fa5c6-76ba-498e-b46f-554ab6fcde90",
                                "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                                "text": "Wegen der Diagnose der Schulpsychologin [Dyskalkulie] erhielt ihre Tochter keinen Anspruch auf einen Nachteilsausgleich. Die Mathelehrerin durfte ihr also weder mehr Zeit für die Rechenaufgaben einräumen, noch sie mit einem Schmierzettel arbeiten lassen."
                            },
                            {
                                "example_id": "6e818168-b48b-488b-b05d-920032fdf3e0",
                                "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                                "text": "Vier von sieben Kundenberatern der LBS West schickten die Tester mit unübersichtlichen Schmierzetteln nach Hause, sodass diese nicht imstande waren, die Angebote zu prüfen."
                            },
                            {
                                "example_id": "8560eb9d-5680-4002-9b30-ed7c435c1001",
                                "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                                "text": "Falls Sie, liebe Hörer, gerade zufällig 50.000 Euro zu viel haben sollten, dann könnten Sie das Geld in einen Schmierzettel investieren. 50.000 Euro ist nämlich der geschätzte Wert für ein Blatt mit allerlei Gekritzel von Ludwig van Beethoven."
                            },
                            {
                                "example_id": "9dbcd322-e7de-4651-b7ac-abfd8e7f5a06",
                                "sense_id": "867692aa-048b-3bd5-a42b-648848e51d8b",
                                "text": "Mit den im Seminar gegebenen Informationen gingen alle Seminarteilnehmer in gleicher Weise um: Sie reduzierten sie auf Handlungsanweisungen, die auf einem Schmierzettel festgehalten wurden. Diese Schmierzettel waren der ständige Begleiter am Computer und wurden immer auf den neuesten Stand gebracht. […] Waren die Schmierzettel durch intensiven Gebrauch dem Zerfleddern nahe, wurden sie in eine Klarsichthülle gesteckt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
