                        "entry_id": "b7f9ca37-0124-3c34-a1ec-156239827966",
                        "glosses": [
                            "To release (an arrested person) from custody."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6bbec1c3-a413-40c8-b360-33a1966a508c",
                                "sense_id": "afee67ea-538c-3650-9bdd-d61ded3f7f61",
                                "text": "She was swearing at the police who were trying to deal with a domestic incident. I had to break up the situation, the harassment was interfering with them dealing with the original fight. It was decided to unarrest her when we realised her age."
                            },
                            {
                                "example_id": "0e4fc125-28f0-4b53-9bee-3d8e128a6fe0",
                                "sense_id": "afee67ea-538c-3650-9bdd-d61ded3f7f61",
                                "text": "They were subsequently unarrested and released into their parents’ custody on Friday evening."
                            }
                        ]
                    }
