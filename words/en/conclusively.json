                    "sense_id": "b7173529-57c7-34d4-8fbb-c729c22cea7e",
                    "sense_definition": "In a manner that settles an issue or argument finally and without doubt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Once the final experiment had been performed, the theory was <w>conclusively</w> proved.",
                            "target_lang_translations": {
                                "ru": "Как только был проведен последний эксперимент, теория была <w>окончательно</w> доказана."
                            }
                        },
                        {
                            "text": "The DNA evidence <w>conclusively</w> proved that the suspect was not at the scene of the crime.",
                            "target_lang_translations": {
                                "ru": "Анализ ДНК <w>неопровержимо</w> доказал, что подозреваемого не было на месте преступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "decisively",
                        "finally",
                        "definitively",
                        "irrefutably"
                    ],
                    "antonyms": [
                        "inconclusively",
                        "indecisively",
                        "uncertainly"
                    ],
                    "common_phrases": [
                        "conclusively proved",
                        "demonstrated conclusively",
                        "shown conclusively"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таким образом, что вопрос или спор решается окончательно и не оставляет сомнений."
                    },
