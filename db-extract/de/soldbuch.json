                "senses": [
                    {
                        "sense_id": "d5bc3dee-26a4-302a-a002-f6140a3003f6",
                        "entry_id": "282d9275-9435-36e5-974c-9d842f535d44",
                        "glosses": [
                            "veraltet: Ausweis eines Soldaten mit Nachweis seiner Versorgung und seines Soldes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e69d6319-03f7-439d-88d6-75874f90d505",
                                "sense_id": "d5bc3dee-26a4-302a-a002-f6140a3003f6",
                                "text": "„Aus seinem Soldbuch geht hervor, dass er in den kommenden zwei Jahren an drei Gefechten teilnimmt und in der rechten Brust durch einen Granatsplitter verwundet wird…“"
                            },
                            {
                                "example_id": "4f7d6da9-4e96-4857-afe5-99aef4879548",
                                "sense_id": "d5bc3dee-26a4-302a-a002-f6140a3003f6",
                                "text": "„Sie warf das Soldbuch und die Fotos zurück in die Schachtel.“"
                            },
                            {
                                "example_id": "aadaf095-8956-4ecb-9f03-472829d8d4e1",
                                "sense_id": "d5bc3dee-26a4-302a-a002-f6140a3003f6",
                                "text": "„Graeber schob sein Soldbuch und seinen Urlaubsschein unter das Gitter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
