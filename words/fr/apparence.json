                    "semantic_group_id": "aspect_visuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle soigne toujours son <w>apparence</w> avant d'aller au travail."
                        },
                        {
                            "text": "Il ne faut pas juger une personne uniquement sur son <w>apparence</w> physique."
                        }
                    ],
                    "synonyms": [
