                "senses": [
                    {
                        "sense_id": "51318c64-fd2a-3308-8381-ecf250340775",
                        "entry_id": "caf0a481-e7d9-30d3-beb8-c66573a264ff",
                        "glosses": [
                            "een plantenvariëteit Brassica oleracea convar. botrytis var. italica die verwant is aan bloemkool"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0dc1823c-80dd-3314-9d9f-9cbe36e02eb5",
                        "entry_id": "caf0a481-e7d9-30d3-beb8-c66573a264ff",
                        "glosses": [
                            "de nog gesloten bloemknoppen van deze plant die als groente worden gegeten. Van de groenten bevat broccoli de meeste glucosinolaten die mogelijk een werking tegen kanker zouden kunnen hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be645df1-ccb8-49c2-aed8-1faa7549f0eb",
                                "sense_id": "0dc1823c-80dd-3314-9d9f-9cbe36e02eb5",
                                "text": "In alle voortvarendheid vergeten ze één ding: broccoli is vies. Van alle groenten houd ik, behalve van deze."
                            },
                            {
                                "example_id": "4e38190c-c383-434b-9020-5820d042f85a",
                                "sense_id": "0dc1823c-80dd-3314-9d9f-9cbe36e02eb5",
                                "text": "„Je hebt zo’n acht broccolitelers in Nederland, maar toch zie ik in de winkel bijna alleen maar Spaanse broccoli. Ik kan vlees kopen in de supermarkt waarvan ik geen idee heb waar het vandaan komt en hoe het gemaakt wordt.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ef65686-744e-498d-a240-c5fb8e66ad57",
                        "source_entry_id": "caf0a481-e7d9-30d3-beb8-c66573a264ff",
                        "source_sense_id": "51318c64-fd2a-3308-8381-ecf250340775",
