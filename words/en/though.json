                {
                    "sense_id": "30ec0d02-c7ae-3e5c-96c0-2785df038d8d",
                    "sense_definition": "Despite the fact that; although.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Though</w> it was raining heavily, we decided to go for a walk.",
                            "target_lang_translations": {
                                "ru": "<w>Хотя</w> шел сильный дождь, мы решили пойти на прогулку.",
                                "nl": "<w>Hoewel</w> het hard regende, besloten we een wandeling te maken.",
                                "pl": "<w>Choć</w> mocno padało, zdecydowaliśmy się pójść na spacer.",
                                "de": "<w>Obwohl</w> es stark regnete, beschlossen wir, spazieren zu gehen.",
                                "fr": "<w>Bien qu'</w>il plût abondamment, nous avons décidé de faire une promenade.",
                                "it": "<w>Anche se</w> pioveva a dirotto, abbiamo deciso di fare una passeggiata.",
                                "cs": "<w>Ačkoli</w> silně pršelo, rozhodli jsme se jít na procházku.",
                                "tr": "Şiddetli yağmur yağmasına <w>rağmen</w> yürüyüşe çıkmaya karar verdik.",
                                "es": "<w>Aunque</w> llovía fuertemente, decidimos salir a caminar."
                            }
                        },
                        {
                            "text": "She finished the race, <w>though</w> she was injured and tired.",
                            "target_lang_translations": {
                                "ru": "Она закончила гонку, <w>хотя</w> была травмирована и устала.",
                                "nl": "Ze finishte de race, <w>hoewel</w> ze geblesseerd en moe was.",
                                "pl": "Ukończyła bieg, <w>chociaż</w> była kontuzjowana i zmęczona.",
                                "de": "Sie beendete das Rennen, <w>obwohl</w> sie verletzt und müde war.",
                                "fr": "Elle a terminé la course, <w>bien qu'</w>elle fût blessée et fatiguée.",
                                "it": "Ha terminato la gara, <w>sebbene</w> fosse ferita e stanca.",
                                "cs": "Dokončila závod, <w>přestože</w> byla zraněná a unavená.",
                                "tr": "Yaralı ve yorgun <w>olduğu halde</w> yarışı bitirdi.",
                                "es": "Ella terminó la carrera, <w>a pesar de que</w> estaba lesionada y cansada."
                            }
                        }
                    ],
                    "synonyms": [
                        "although",
                        "even though"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несмотря на то, что; хотя.",
