                                        "entry_id": "8630071c-e0fa-30b1-9d03-09449f741534",
                                        "glosses": [
                                            "A bar or nightclub that caters to Southern patrons and provides country music for entertainment."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
