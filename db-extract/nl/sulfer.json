                        "examples": [
                            {
                                "example_id": "805d5a29-4dbf-4956-a971-d621a5fde3e7",
                                "sense_id": "5542e26e-da4d-33c3-b98c-412f8a2cbd4f",
                                "text": "De aardkorst is hier erg dun en magma verhit de waterplassen aan de oppervlakte. Hierdoor is een gebied met geisers, warmwaterbronnen en felgekleurde mineraalafzettingen van sulfer en geoxideerd ijzer ontstaan."
                            },
                            {
                                "example_id": "e977f8c1-7b5b-41f2-8e06-0819754e76c9",
                                "sense_id": "5542e26e-da4d-33c3-b98c-412f8a2cbd4f",
                                "text": "Uit Openbaring 21 blijkt ook dat er naast de nieuwe hemel en de nieuwe aarde ook een poel zal zijn die brandt van vuur en sulfer. „Beide zijn dus definitief en onomkeerbaar.” Hoe deze nieuwe hemel en nieuwe aarde eruitzien, wordt volgens Heuvelman in Openbaring 22 duidelijk beschreven."
                            }
                        ]
                    }
