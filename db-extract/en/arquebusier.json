                        "translation_id": "0d806260-59c5-47ae-affe-ebbcd75b3631",
                        "source_entry_id": "2f1da8fd-183f-37c5-b84c-a108629d0259",
                        "source_sense_id": "59d05d5a-7f1b-3a77-9ae3-8406f9b41f04",
                        "source_sense_description": "soldier armed with an arquebus",
