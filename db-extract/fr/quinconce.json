                "senses": [
                    {
                        "sense_id": "c58b30bb-569c-3dbd-acc7-39412b88d882",
                        "entry_id": "0c2d63e2-4ec4-3b58-bdfd-eb8182a5e1da",
                        "glosses": [
                            "a quincunx, a group of five items arranged in a square with one in the middle"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "2b5be2ce-659a-44f4-846c-731154404665",
                                "sense_id": "c58b30bb-569c-3dbd-acc7-39412b88d882",
                                "text": "Jardin de curé, avec son quinconce de tilleuls, sa collection de dahlias et de rosiers, ses berceaux de vignes et ses espaliers de pêchers et d'abricotiers: […]",
                                "translation": "Garden of the vicar, with its quincunx of lime trees, its collection of dahlias and of roses, its beds of wine ranks and its stairs of peaches and apricots: […]",
                                "english": "Garden of the vicar, with its quincunx of lime trees, its collection of dahlias and of roses, its beds of wine ranks and its stairs of peaches and apricots: […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "0f550567-2767-3f30-a601-3ab0be984bab",
                        "entry_id": "0c2d63e2-4ec4-3b58-bdfd-eb8182a5e1da",
                        "glosses": [
                            "a plantation made at equal distances in a straight row, giving multiple alleys of trees in different directions"
                        ],
                        "tags": [
                            "broadly",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "d766e5f5-de67-4cd9-973b-89d5524de1f1",
                                "sense_id": "0f550567-2767-3f30-a601-3ab0be984bab",
                                "text": "Les trous sont souvent disposés en quinconce, parfois en carré ou simplement en ligne.",
                                "translation": "The holes are often arranged in straight lines, sometimes in a square, or simply aligned.",
                                "english": "The holes are often arranged in straight lines, sometimes in a square, or simply aligned."
                            }
                        ]
                    },
                    {
                        "sense_id": "55ea3f75-3343-3da5-8a7e-b3a62791e2ba",
                        "entry_id": "0c2d63e2-4ec4-3b58-bdfd-eb8182a5e1da",
