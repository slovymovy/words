        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97e1054a-316b-3704-a557-d695958cbdee",
                    "sense_definition": "Appearing to be difficult or challenging in a way that makes one feel less confident.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "challenging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Climbing the mountain seemed like a <w>daunting</w> task for the inexperienced hikers.",
                            "target_lang_translations": {
                                "ru": "Восхождение на гору казалось <w>пугающей</w> задачей для неопытных туристов."
                            }
                        },
                        {
                            "text": "The project was a <w>daunting</w> prospect at first, but it was accomplished with some forward planning.",
                            "target_lang_translations": {
                                "ru": "Поначалу проект казался <w>обескураживающей</w> перспективой, но его удалось реализовать благодаря предварительному планированию."
                            }
                        }
                    ],
                    "synonyms": [
                        "formidable",
                        "intimidating"
                    ],
                    "antonyms": [
                        "undaunting"
                    ],
                    "common_phrases": [
