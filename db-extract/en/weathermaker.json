                        "entry_id": "ef8a2adb-a1a8-3259-97be-308801ea140a",
                        "glosses": [
                            "One who attempts to influence the weather by magic; one who performs a weathermaking ritual."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55793804-fb6d-4f53-ab3e-23d4d3ce2708",
                                "sense_id": "19229553-5944-3993-af71-4fd3dc8dee77",
                                "text": "A death, a drought ascribable to the sorcery of a weathermaker, a cyclone and so forth could always excite the natives to acts of revenge, and consequently no man could leave his district unarmed […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "cedc98db-3089-3394-9dab-18fc49587cb8",
                        "entry_id": "ef8a2adb-a1a8-3259-97be-308801ea140a",
                        "glosses": [
                            "A storm; a meteorological event that creates unpleasant weather."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "05d37efa-44c0-4f44-b67c-df99926f11e6",
                                "sense_id": "cedc98db-3089-3394-9dab-18fc49587cb8",
                                "text": "At first glance, that looks like a severe weather maker to our south, with the potential to move into our part of the world. Worth watching."
                            }
                        ]
                    },
                    {
                        "sense_id": "1981bbd1-3342-3a38-ab35-7eba716e66e7",
                        "entry_id": "ef8a2adb-a1a8-3259-97be-308801ea140a",
                        "glosses": [
                            "A geographical feature that tends to cause weather to form."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "b34af14b-6181-4932-8f95-be0d017bda70",
                                "sense_id": "1981bbd1-3342-3a38-ab35-7eba716e66e7",
                                "text": "It's right on the shore of a body of water that is considered Central New York's principal weather-maker. That makes this place the perfect seasonal bellwether: When it opens for the season, spring is here. When it closes, winter's not far behind."
                            }
                        ]
                    }
