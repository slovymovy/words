                "senses": [
                    {
                        "sense_id": "0fc55321-9292-3d76-8798-1a88e3531c30",
                        "entry_id": "3ec3a9bc-c6b9-3e02-8eda-4f3b42f0246a",
                        "glosses": [
                            "braspartij, overdaad aan alcohol"
