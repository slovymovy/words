                                        "entry_id": "30f84692-f8e4-3d91-a886-a45b75068437",
                                        "glosses": [
                                            "einen Gegenstand oder eine Person schnell hin- und herbewegen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebf5a764-0322-473b-babe-65a9a82e5fea",
                                                "sense_id": "5e634d21-81d3-3b6d-ac43-a96669086d6b",
                                                "text": "Er schüttelt die Tasche, damit der Schmutz herausfällt."
                                            },
                                            {
                                                "example_id": "05a4beba-ad2a-41dd-84c3-55558a7670e9",
                                                "sense_id": "5e634d21-81d3-3b6d-ac43-a96669086d6b",
                                                "text": "„So brauchte ich ja jetzt bloß meinen Kopf zu schütteln, um ihm zu zeigen, daß ich es nicht wußte, aber ich konnte meinen Kopf in keine Bewegung bringen."
                                            },
                                            {
                                                "example_id": "26f51cf0-2531-4303-8192-e0a190e0100f",
                                                "sense_id": "5e634d21-81d3-3b6d-ac43-a96669086d6b",
                                                "text": "„Der thüringische AfD-Chef Björn Höcke schüttelte am Mittwoch dem neu gewählten Thüringer Ministerpräsidenten Thomas Kemmerich die Hand, um ihm zu gratulieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
