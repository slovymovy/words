                            {
                                "example_id": "155d44c0-5f13-45d8-a11d-ede4428a989a",
                                "sense_id": "a9f859dd-9336-3902-91e3-90ecff23b2d2",
                                "text": "Чита, место нашего заключения, находится на границе Нерчинского и Верхнеудинского уезда."
                            },
                            {
                                "example_id": "f48f4d7b-e880-45a6-8d59-3876c7f494d0",
                                "sense_id": "a9f859dd-9336-3902-91e3-90ecff23b2d2",
                                "text": "Чита, 12, IV. Буряты Забайкалья деятельно готовятся к областному бурятскому съезду, разрешённому на апрель в Чите."
                            }
                        ]
