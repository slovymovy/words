                        "entry_id": "42c3fa1d-a614-3101-b953-365ba34d4e61",
                        "glosses": [
                            "Celui qui pleure à tout propos et souvent sans motif."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "10747be1-0212-438c-a7cd-80b91f888b66",
                                "sense_id": "c5973479-f5c6-3b1b-ad7b-fe70ba1e6b06",
                                "text": "C’est un ennuyeux pleurard."
                            },
                            {
                                "example_id": "1074ce4f-e02a-4803-89c5-36064be28ce0",
                                "sense_id": "c5973479-f5c6-3b1b-ad7b-fe70ba1e6b06",
                                "text": "Il y a des grâces d’état pour les jolis garçons ; mais moi, un grand pleurard !"
                            }
                        ]
                    }
                ],
