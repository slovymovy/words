            "pos": "noun",
            "senses": [
                {
                    "sense_id": "307a5bb5-93a5-30f8-aeaa-a31263db62b1",
                    "sense_definition": "Évocation discrète ou sous-entendue d'une personne, d'un événement ou d'une chose sans le nommer expressément.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication_indirecte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En parlant du projet, il a fait <w>allusion</w> à nos difficultés financières."
                        },
                        {
                            "text": "Elle a rapidement compris l'<w>allusion</w> et a préféré changer de sujet."
                        }
                    ],
                    "synonyms": [
                        "sous-entendu",
                        "insinuation",
                        "évocation"
                    ],
                    "common_phrases": [
                        "faire allusion à",
                        "comprendre l'allusion"
                    ]
                },
                {
                    "sense_id": "6ae31382-200e-35cb-8342-b12295e52eb9",
                    "sense_definition": "Figure de style ou procédé rhétorique qui consiste à évoquer une personne, un fait ou une œuvre sans les citer directement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "communication_indirecte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce poème classique contient une <w>allusion</w> discrète à la mythologie grecque."
                        },
                        {
                            "text": "L'auteur fait souvent une <w>allusion</w> littéraire pour enrichir le texte de son roman."
                        }
                    ],
                    "common_phrases": [
