                                    {
                                        "sense_id": "f0a4747e-9b8f-34be-81b4-4e94438cdb5b",
                                        "entry_id": "cb5138ee-c617-3b75-88bf-8930b4dd2bbb",
                                        "glosses": [
                                            "sousloví nebo věta z filmu, ze školního vyučování apod., která zlidověla (často vtipná) nebo vtipný výrok, který zlidověl"
                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6a4fb30-272b-4e32-b32e-15d0273bda41",
                                                "sense_id": "f0a4747e-9b8f-34be-81b4-4e94438cdb5b",
                                                "text": "„Tak určitě!“ – Legendární hláška českých sportovců konečně v reklamě."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fb89020-a8f5-3119-8d2f-4afc2cecad09",
                                        "entry_id": "cb5138ee-c617-3b75-88bf-8930b4dd2bbb",
                                        "glosses": [
                                            "v mariáši dvojice dáma (svršek) a král stejné barvy, ohlášená v průběhu hry"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8c242bc-a93b-4a75-a89a-061d96898b34",
                        "source_entry_id": "95ea19ca-2484-3d14-a6a5-b15f68ebf8c4",
                        "source_sense_description": "a repeated expression",
                        "target_lang_word": "catchphrase",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catchphrase",
