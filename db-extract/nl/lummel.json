                        "entry_id": "d1fe6165-80af-3cd9-b8b7-84018d195be1",
                        "glosses": [
                            "vervelend, lomp of onbeholpen persoon, meestal een jongen of man"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "63ee8042-e01c-4440-bb17-c7190f798b44",
                                "sense_id": "c50cddb9-b014-3f6a-ae77-d9ddb9ce8578",
                                "text": "Wat ben jij een lummel!"
                            }
                        ]
                    },
                    {
                        "sense_id": "45ebc6a1-125c-356f-815f-3ee002a63284",
                        "entry_id": "d1fe6165-80af-3cd9-b8b7-84018d195be1",
                        "glosses": [
                            "draaibare verbinding van de giek of laadboom aan de mast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eef3b68c-7715-4c50-aa9e-3b24d0b49498",
                                "sense_id": "45ebc6a1-125c-356f-815f-3ee002a63284",
                                "text": "De boot heeft de lummel op de roestvrijstalen mastwangen in plaats van op de mast."
                            }
                        ]
                    },
                    {
                        "sense_id": "76b0b550-6741-303e-a875-533cb4f93962",
                        "entry_id": "d1fe6165-80af-3cd9-b8b7-84018d195be1",
                        "glosses": [
                            "gereedschap van beeldhouwers bij het gieten van brons"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df643e7a-23ae-4d29-90f4-f610b0307623",
                                "sense_id": "76b0b550-6741-303e-a875-533cb4f93962",
                                "text": "Op zijn bagagedrager was een tas gebonden, waarin zich een kleine grafietpot bevond, goed voor het smelten van brons, een tang om de kroes vast te pakken en een ‘lummel’, die gebruikt wordt bij het uitgieten van brons. Waarom een scheldwoord nodig is als betiteling van een uiterst dienstig instrument is mij niet bekend."
                            }
                        ]
                    }
