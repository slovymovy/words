    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0df84419-c312-3808-8b60-94599ae16eb7",
                "word": "afterthought",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "33df0bf4-e279-4d7c-b755-04a382d494dc",
                        "entry_id": "0df84419-c312-3808-8b60-94599ae16eb7",
                        "tags": [
                            "plural"
                        ],
                        "form": "afterthoughts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a674193-5578-3eb7-a248-3cc62c28ea0b",
                        "entry_id": "0df84419-c312-3808-8b60-94599ae16eb7",
                        "glosses": [
                            "A reflection after an act; a later or subsequent thought, action, or expedient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0d9c18a-ac39-44a2-bfb4-6045317b05f6",
                                "sense_id": "3a674193-5578-3eb7-a248-3cc62c28ea0b",
                                "text": "She packed her sandals only as an afterthought, but she was glad she did."
                            }
                        ]
                    },
                    {
                        "sense_id": "9dfb32cb-d283-31e5-b18f-8fb5a2454441",
                        "entry_id": "0df84419-c312-3808-8b60-94599ae16eb7",
                        "glosses": [
                            "Something additional to the original plan or concept."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc64b9a-9c18-47b4-824d-3d135a42a6d3",
                                "sense_id": "9dfb32cb-d283-31e5-b18f-8fb5a2454441",
                                "text": "This whole remodeling was an afterthought; we were only going to paint and call it good."
                            },
                            {
                                "example_id": "2b9ce5cd-fa00-4d3b-874c-160fae52290d",
                                "sense_id": "9dfb32cb-d283-31e5-b18f-8fb5a2454441",
                                "text": "The lighting in the corridor just dabbles of arcs, afterthoughts, smears. The light a grime that gives him a slight headache. The same type as when it has rained, remained humid, a fetid stale of ozone over everything."
                            },
                            {
                                "example_id": "0a36b544-4c28-49df-aff3-55fed808fc26",
                                "sense_id": "9dfb32cb-d283-31e5-b18f-8fb5a2454441",
                                "text": "For most of the past three decades, the natural world was treated almost as an afterthought by world leaders. If discussed at all, it was with platitudes about the need to save polar bears and tigers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4f66057-466d-483d-9f34-92335b2c2fd3",
                        "source_entry_id": "0df84419-c312-3808-8b60-94599ae16eb7",
                        "source_sense_description": "a subsequent thought",
                        "target_lang_word": "Nebengedanke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebengedanke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "988a819f-1310-3604-9b1a-adb43a14dba8",
                                        "entry_id": "3fa4c74f-aea0-33b6-9cde-acd73f14d1c4",
                                        "glosses": [
                                            "Überlegung, die man zusätzlich und womöglich nachrangig zu einer anderen anstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5586d2de-b45e-475d-8a41-d2c029a29425",
                                                "sense_id": "988a819f-1310-3604-9b1a-adb43a14dba8",
                                                "text": "„Es sind oft die lautlosesten Nebengedanken, die einen auf die Spur führen, auf das eigene, einspurige Wahrnehmen der Wirklichkeit.“"
                                            },
                                            {
                                                "example_id": "b47bdfe5-b985-4f8b-801e-22cbb9ed2d41",
                                                "sense_id": "988a819f-1310-3604-9b1a-adb43a14dba8",
                                                "text": "„Alles Hallodrihafte war fern und die Nebengedanken und Hintergedanken machten mal Pause.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
