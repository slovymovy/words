                ],
                "senses": [
                    {
                        "sense_id": "f9bc55c3-ec1c-33bd-aa14-a163092be917",
                        "entry_id": "09610851-b9f7-34b1-beec-a761839b1a6c",
                        "glosses": [
                            "Eigenschaft, in deutlichem Maße einen (optisch) wuchtigen (monumentalen) Eindruck zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fe678f8-dc41-4d35-9663-a5d9ecdf69c8",
                                "sense_id": "f9bc55c3-ec1c-33bd-aa14-a163092be917",
                                "text": "„Gleichzeitig sicherte die Monumentalität der Denkmäler den Stiftern Unvergesslichkeit über den Tod hinaus.“"
                            },
                            {
                                "example_id": "fe6e3a39-d7e7-49cb-8bfb-8367d192093d",
                                "sense_id": "f9bc55c3-ec1c-33bd-aa14-a163092be917",
                                "text": "„Die faschistischen Interpretationen hatten das Konzept der Monumentalität nachhaltig diskreditiert. Von vielen Protagonisten der Moderne wurde sie grundsätzlich abgelehnt. Monumentalität wurde mit totalitären Systemen verknüpft.“"
                            },
                            {
                                "example_id": "25d896d4-6904-4f49-85d0-b962c77f67e1",
                                "sense_id": "f9bc55c3-ec1c-33bd-aa14-a163092be917",
                                "text": "„Anhand der Leitbegriffe Funktionalität, Monumentalität und Repräsentation wird das Bauwerk aus unterschiedlichen Perspektiven kontextualisiert. Diese Begrifflichkeiten entsprechen den (stadt-)planerischen Überlegungen in Wien um 1870.“"
                            },
                            {
                                "example_id": "af278a23-cfc3-4839-a3a0-f3d52cd4cf9f",
                                "sense_id": "f9bc55c3-ec1c-33bd-aa14-a163092be917",
                                "text": "„Das Grabmal ist von unerwarteter Monumentalität und wirkt dabei fast zerbrechlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
