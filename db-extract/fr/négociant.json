        "fr-extract.jsonl": [
            {
                "entry_id": "ecf5d7fa-6b6d-38ae-9dcd-b3897b337215",
                "word": "négociant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b6eadfb6-0eee-469a-a03a-1dfde90ce8c3",
                        "entry_id": "ecf5d7fa-6b6d-38ae-9dcd-b3897b337215",
                        "tags": [
                            "plural"
                        ],
                        "form": "négociants"
                    },
                    {
                        "form_id": "4a169803-c754-4ed4-ae9a-056ca02d56fe",
                        "entry_id": "ecf5d7fa-6b6d-38ae-9dcd-b3897b337215",
                        "tags": [
                            "feminine"
                        ],
                        "form": "négociante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c095ba6-1eb8-3ce8-a110-ab8e871fca34",
                        "entry_id": "ecf5d7fa-6b6d-38ae-9dcd-b3897b337215",
                        "glosses": [
                            "Marchand en gros."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8285d0-0d97-4946-af63-60dd2601d1d4",
                                "sense_id": "0c095ba6-1eb8-3ce8-a110-ab8e871fca34",
                                "text": "Ainsi, par le système des docks, le négociant n’a point à s’occuper du matériel de la marchandise ; et par celui des warrants, il peut mettre sa marchandise en portefeuille, comme toute autre valeur circulable."
                            },
                            {
                                "example_id": "43e5e97f-e147-42e4-ba79-560c5eb04acd",
                                "sense_id": "0c095ba6-1eb8-3ce8-a110-ab8e871fca34",
                                "text": "Tous les matins, l’ancien négociant (tous les bourgeois retirés s’intitulent ancien négociant) passait deux heures rue des Saussayes pour y vaquer à ses affaires, et donnait le reste du temps à Zaïre, ce qui tourmentait beaucoup Zaïre."
                            },
                            {
                                "example_id": "a907f026-5f9c-4fd2-90dd-a144df8d7483",
                                "sense_id": "0c095ba6-1eb8-3ce8-a110-ab8e871fca34",
                                "text": "La voix du négociant — merrains, traverses de chemin de fer et bois de mine — a quelque chose d’insolitement grave."
                            },
                            {
                                "example_id": "7adc31df-2007-48b5-b84c-df441c861fab",
                                "sense_id": "0c095ba6-1eb8-3ce8-a110-ab8e871fca34",
                                "text": "Ainsi la production de grande qualité, celle des châteaux, se différenciait-elle de plus en plus de celle des Bordeaux anonymes, vins de marques commerciales entre autres, livrés en futailles par les négociants de la grande ville."
                            },
                            {
                                "example_id": "fdc5b8a8-3722-4b98-aff6-80b56c6897a5",
                                "sense_id": "0c095ba6-1eb8-3ce8-a110-ab8e871fca34",
                                "text": "Les négociants en ânes qui vivaient hors de chez eux à longueur de temps et étaient absents huit à neuf mois dans l'année ne pouvaient éviter d'avoir une maîtresse quelque part."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e7f2754-2822-32a4-adf8-5fc208abbabc",
                        "entry_id": "ecf5d7fa-6b6d-38ae-9dcd-b3897b337215",
                        "glosses": [
                            "Intervenant qui agit sur les marchés financiers (exclusivement ou non selon les statuts qui lui sont applicables et selon la stratégie qu’il a retenue) pour son compte propre en prenant généralement des positions de marché."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "676b0632-e4a4-4a0e-9a0d-c0a84e3340ae",
                        "source_entry_id": "ecf5d7fa-6b6d-38ae-9dcd-b3897b337215",
                        "target_lang_word": "Händler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Händler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e33f57f-3193-36e4-ba20-c1a2aa517224",
                                        "entry_id": "c9926c88-9fa4-338e-a0ae-070169e567c8",
                                        "glosses": [
                                            "Person oder Firma, die mit etwas handelt, einen Handel betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3c7bbd4-46af-4cc6-bc37-4b4031fd4f1e",
                                                "sense_id": "4e33f57f-3193-36e4-ba20-c1a2aa517224",
                                                "text": "Die Händler haben sich darauf geeinigt, ihre Geschäfte in der Mittagszeit offen zu halten."
                                            },
                                            {
                                                "example_id": "080af0fb-bdbe-4e51-b21d-34900b083740",
                                                "sense_id": "4e33f57f-3193-36e4-ba20-c1a2aa517224",
                                                "text": "„In Prüm hatte sie Händler beobachtet, die Läden abschlossen, in denen noch Waren lagerten.“"
                                            },
                                            {
                                                "example_id": "bbc132e6-be0f-442b-8152-62719b0f7f11",
                                                "sense_id": "4e33f57f-3193-36e4-ba20-c1a2aa517224",
                                                "text": "„Wir eilten zurück zu den anderen, nachdem wir bei einem anderen, freundlicheren Händler eine Sonnenbrille erstanden hatten.“"
                                            },
                                            {
                                                "example_id": "14a2d98b-7f9f-4ca3-b057-83f6fd12205c",
                                                "sense_id": "4e33f57f-3193-36e4-ba20-c1a2aa517224",
                                                "text": "„Jing Bo-dajau hatte, darauf konnte man nicht kommen, heimlich mit dem Händler gefeilscht, bis dieser mürbe geworden und mit nur vierhundertundzwanzig Unzen Silber zufrieden war.“"
                                            },
                                            {
                                                "example_id": "fef362a7-b88f-486a-b6e0-6e62f1b03471",
                                                "sense_id": "4e33f57f-3193-36e4-ba20-c1a2aa517224",
                                                "text": "„Um die Händler kreisten Frauen, feilschten, wanderten von Korb zu Korb; sie machten ihre Einkäufe und gingen Richtung Stadtzentrum davon.“"
                                            },
                                            {
                                                "example_id": "64daa063-aaef-4ec0-9285-11ddb8d94c2b",
                                                "sense_id": "4e33f57f-3193-36e4-ba20-c1a2aa517224",
                                                "text": "„Es gibt jedoch auch Marketanden, mitziehende Händler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3bafbc4-d68a-465d-85e1-1c8dec13620a",
                        "source_entry_id": "ecf5d7fa-6b6d-38ae-9dcd-b3897b337215",
