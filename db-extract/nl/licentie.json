                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a756a83a-9b9b-454a-95e8-87d71cc51f68",
                                                "sense_id": "12183672-ab3c-320e-ab4c-d3816c056274",
                                                "text": "In some areas they have attempted to decasualize certain types of employment and to control street-trading by a local licensing system requiring juveniles to obtain their licences through the committees."
                                            },
                                            {
                                                "example_id": "72a2dd98-5748-4e21-825a-e08e91bda8d0",
                                                "sense_id": "12183672-ab3c-320e-ab4c-d3816c056274",
                                                "text": "Serlio criticises the artistic licence taken by both ancient and contemporary architects, here specifically related to the confusion created by the rich decoration of the arch–in his illustrations, he stripped the monument of most of its beautifully […]"
                                            }
                                        ]
                                    }
                                ]
