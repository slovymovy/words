                                        "glosses": [
                                            "A country in Oceania. Official name: Independent State of Papua New Guinea. Capital and largest city: Port Moresby."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e96d08b3-532f-4a10-8e9b-0c77f77a3083",
                                                "sense_id": "a65d3030-0ede-3c1d-89f9-452cd8857638",
                                                "text": "The Prime Minister of Papua New Guinea has declared a nine-month state of emergency in the country’s rugged Southern Highlands province in response to several days of riots."
                                            }
