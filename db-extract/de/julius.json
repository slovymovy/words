                                                "sense_id": "cdf03264-b068-37a9-b6cc-2537285e53e7",
                                                "text": "W ikonografii św. Juliusz I jest ukazywany z kościołem lub rulonem pergaminu w dłoni."
                                            },
                                            {
                                                "example_id": "5637cce3-8c54-49f1-ba8c-e5dd7ab02750",
                                                "sense_id": "cdf03264-b068-37a9-b6cc-2537285e53e7",
