                        "sense_id": "d58edab4-76f9-3fb0-be01-a988245357f6",
                        "entry_id": "685015ea-6d50-364a-88b1-3617ebba009b",
                        "glosses": [
                            "Qui n’est pas réaliste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee9a896-bcf0-433f-8704-890c2a6b0254",
                                "sense_id": "d58edab4-76f9-3fb0-be01-a988245357f6",
                                "text": "Ce film est quelque peu irréaliste ; je n’avais encore jamais vu d’êtres humains résistants à de telles températures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da57f253-1a4e-4d06-a8a1-d96a82d74c86",
                        "source_entry_id": "685015ea-6d50-364a-88b1-3617ebba009b",
