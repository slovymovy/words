                ],
                "senses": [
                    {
                        "sense_id": "f46075ec-e999-3552-8bb5-c1dcb409b59d",
                        "entry_id": "c34767c6-6207-395e-b7d3-15b79a1c0abb",
                        "glosses": [
                            "Poisser."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "50b4a206-0cda-42ab-b931-14199208a35f",
                                "sense_id": "f46075ec-e999-3552-8bb5-c1dcb409b59d",
                                "text": "Après les blancs, les noirs, les gniafs empoissés, qui dansaient en faisant claquer leurs tire-pieds, autour de saint Crépin."
                            },
                            {
                                "example_id": "a4acf307-4fdd-4d02-aad6-fdc56f672510",
                                "sense_id": "f46075ec-e999-3552-8bb5-c1dcb409b59d",
                                "text": "Mais une brume toujours empoisse ses pensées, entrave son questionnement, l’affection et la répulsion à l’égard de cet homme luttant désormais continuellement en lui."
                            },
                            {
                                "example_id": "81cf74a2-0d8b-438a-bdf2-c31a8f6f0c0d",
                                "sense_id": "f46075ec-e999-3552-8bb5-c1dcb409b59d",
                                "text": "Elle se rêve en putain et elle admire aussi la blonde de la photo, d'autres filles de la classe au-dessus, qui la renvoient à son corps empoissé."
                            }
                        ]
                    }
                ],
