                "entry_id": "12bb19a0-9adb-3f37-8e3e-964135ebaff2",
                "word": "pilotine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2d0ae518-efb0-452d-992f-e9b51287e290",
                        "entry_id": "12bb19a0-9adb-3f37-8e3e-964135ebaff2",
                        "tags": [
                            "plural"
                        ],
                        "form": "pilotines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "60b937f7-3f04-3218-affd-6e61b5570e29",
                        "entry_id": "12bb19a0-9adb-3f37-8e3e-964135ebaff2",
                        "glosses": [
                            "Bateau pilote, vedette qui conduit le pilote à bord du navire qu’il va servir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d10d3df-04f4-48bd-803c-e2d9c011db81",
                                "sense_id": "60b937f7-3f04-3218-affd-6e61b5570e29",
                                "text": "En 1869, les pilotines à voiles et à rames ont été remplacées par des pilotines de sauvetage à vapeur, et, en raison des facilités résultant de l’emploi de ces pilotines, le nombre des pilotes a été réduit à quinze."
                            },
                            {
                                "example_id": "c2c9f6a2-91c2-4502-b5e0-91e94cfbebf5",
                                "sense_id": "60b937f7-3f04-3218-affd-6e61b5570e29",
                                "text": "Un énorme porte-conteneur passe la pointe du Soldat, au bout de l’île du Frioul, et adresse deux coups de corne à la rade endormie. Une pilotine de la capitainerie vient à sa rencontre, bordée d’écume."
                            },
                            {
                                "example_id": "4a935360-923a-420a-a41f-0f619351c608",
                                "sense_id": "60b937f7-3f04-3218-affd-6e61b5570e29",
                                "text": "La pilotine est un bateau fiable, agile et résistant, au service des navires plus imposants : la pilotine amène aux cargos, paquebots et autres navires, le pilote, spécialiste des manœuvres d’approche, d’entrées et sorties des ports."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc273c5e-2d43-35eb-81bd-fa4b62f94001",
                        "entry_id": "12bb19a0-9adb-3f37-8e3e-964135ebaff2",
                        "glosses": [
                            "Type de pantoufles permettant un usage à l’extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49987647-e582-4dd7-b3ce-f09fc10cc53a",
                                "sense_id": "cc273c5e-2d43-35eb-81bd-fa4b62f94001",
                                "text": "Pilotine ou pantoufle extérieur marron, doublure éponge noir, semelle élastomère"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b9e3754-3698-4d44-82e3-123472229b2b",
                        "source_entry_id": "12bb19a0-9adb-3f37-8e3e-964135ebaff2",
                        "source_sense_description": "bateau",
                        "target_lang_word": "Lotsenboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lotsenboot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5787e8b4-9e26-3447-9b13-04c783dae5b8",
                                        "entry_id": "c987d5a9-3ec9-33b0-ac40-f47728cae4f5",
                                        "glosses": [
                                            "Boot, das den Lotsen an Bord und von Bord des zu manövrierenden Schiffes bringt, beispielsweise in/aus einem Hafen oder vor einem Kanal"
                                        ],
                                        "tags": [
                                            "Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f745319e-9019-47a2-9c69-5dccaf434fee",
                                                "sense_id": "5787e8b4-9e26-3447-9b13-04c783dae5b8",
                                                "text": "Bei rauer See brachte das Lotsenboot die Lotsin sicher an Bord des Containerfrachters."
                                            },
                                            {
                                                "example_id": "9381cb69-87a8-45f1-a9f7-facb1ab4b219",
                                                "sense_id": "5787e8b4-9e26-3447-9b13-04c783dae5b8",
                                                "text": "Es war gar nicht einfach, bei dem Seegang von der Lotsenleiter auf das heftig schaukelnde und schwankende Lotsenboot zu springen."
                                            },
                                            {
                                                "example_id": "d0af52c7-8b05-4a11-9f48-7c1aebec1b38",
                                                "sense_id": "5787e8b4-9e26-3447-9b13-04c783dae5b8",
                                                "text": "[…] das Lotsenboot von [Kiel-]Holtenau [steuert] gerade auf ein Containerschiff zu […], das vor der Kanaleinfahrt wartet."
                                            },
                                            {
                                                "example_id": "a440adfd-a94e-463c-9c62-4844a8366394",
                                                "sense_id": "5787e8b4-9e26-3447-9b13-04c783dae5b8",
                                                "text": "„Wir nähern uns jetzt mit dem Lotsenboot diesem bulgarischen Öltanker dort. Es wird einer unserer Lotsen an Bord gehen, damit der Tanker sicher von Nord nach Süd durch den Bosporus kommt. […]“"
                                            },
                                            {
                                                "example_id": "14e5abec-f63b-4c1a-90b4-6df94bf33c67",
                                                "sense_id": "5787e8b4-9e26-3447-9b13-04c783dae5b8",
                                                "text": "200 Meter entfernt, in Flussmitte, nähert sich langsam ein kleines Lotsenboot einem 300-Meter-Containerfrachter."
                                            },
                                            {
                                                "example_id": "0a510f64-bc40-44a7-bb23-f7e9c4b4c371",
                                                "sense_id": "5787e8b4-9e26-3447-9b13-04c783dae5b8",
                                                "text": "Von einem Lotsenboot aus hat die Berliner Künstlerin Karen Koltermann den gewaltigen Frachter, der fabrikneue Autos über die Meere transportiert, gefilmt."
                                            },
                                            {
                                                "example_id": "b8b7c265-e14d-4256-ab39-65bbe0315dd7",
                                                "sense_id": "5787e8b4-9e26-3447-9b13-04c783dae5b8",
                                                "text": "Auch vom Geruch unterscheiden sich die alten und neuen Lotsenboote. Nach jahrzehntelangem Betrieb wurden 'Jürs' und 'Kircheis' mehrmals neulackiert. Durch viel Zigarettenrauch vergilbt, riechen die 'Jürs' und 'Kircheis' leicht moderig. Ganz anders das neue Boot: „Die 'Dithmarschen' riecht nach Neuwagen“, sagt Kanallotse Christian Wieden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
