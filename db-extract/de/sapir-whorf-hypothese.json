                ],
                "senses": [
                    {
                        "sense_id": "e71e5a05-e403-3192-af13-c02ecc3d4527",
                        "entry_id": "015312c4-0e71-3a38-bc63-8eb417878f8b",
                        "glosses": [
                            "eine Hypothese, die besagt, dass die Art und Weise, wie ein Mensch denkt und handelt, durch seine Muttersprache beeinflusst wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff939fbb-16db-4698-8954-44f9e1a30441",
                                "sense_id": "e71e5a05-e403-3192-af13-c02ecc3d4527",
                                "text": "Die Sapir-Whorf-Hypothese wird in ihrer extremen Form auch als „sprachlicher Determinismus“ verstanden; allgemein akzeptiert ist aber nur die Annahme, dass die Sprache das Denken beeinflusst; eine ähnliche Hypothese hat die Inhaltbezogene Grammatik entwickelt."
                            },
                            {
                                "example_id": "841bf8b6-45bc-4b95-befe-e8c20077c9a5",
                                "sense_id": "e71e5a05-e403-3192-af13-c02ecc3d4527",
                                "text": "Die Sapir-Whorf-Hypothese geht auf Benjamin Lee Whorf zurück."
                            },
                            {
                                "example_id": "629b0051-0665-45d1-b5b2-fe160f96d202",
                                "sense_id": "e71e5a05-e403-3192-af13-c02ecc3d4527",
                                "text": "„Wir werden dann auch die Standpunkte seiner Schule erörtern und anschließend auf die Sapir-Whorf-Hypothese zu sprechen kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
