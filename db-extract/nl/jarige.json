                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fbacbed-9b05-3f82-969c-9e0a3929baad",
                                        "entry_id": "a417f720-0955-3868-9300-55b2540f87ad",
                                        "glosses": [
                                            "A woman or girl whose birthday it is."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c1d7af-015b-4796-baee-e3af2279c94c",
                                                "sense_id": "2fbacbed-9b05-3f82-969c-9e0a3929baad",
                                                "text": "The climax of the celebration for the birthday girl is her first dance. A symbolic enactment of her departure from childhood takes place: […] Afterward, the birthday girl dances with all of the young chamberlanes, marking her entry into womanhood."
                                            },
                                            {
                                                "example_id": "e1bd812f-fc7b-49d7-b682-ef49be44cd31",
                                                "sense_id": "2fbacbed-9b05-3f82-969c-9e0a3929baad",
                                                "text": "When you're photographing the birthday girl, you use a large aperture that has an f/stop of f/3.5, which gives you a very shallow depth of field and draws the viewer's attention to the honored guest."
                                            },
                                            {
                                                "example_id": "f208e827-7233-4984-b6be-ed664b207345",
                                                "sense_id": "2fbacbed-9b05-3f82-969c-9e0a3929baad",
                                                "text": "A teenage girl's 16th birthday is supposed to include a big party, the perfect boyfriend and a shiny new car, all wrapped up with a bright red bow. But what happens when your family forget your big day because they are consumed with planning your older sister's wedding? Ask high school sophomore Samantha Baker (Molly Ringwald), the birthday girl in John Hughes's 1984 romantic teen comedy Sixteen Candles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
