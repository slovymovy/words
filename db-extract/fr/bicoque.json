        "fr-extract.jsonl": [
            {
                "entry_id": "a6e3271e-faf8-3991-a74b-5b6136251fb5",
                "word": "bicoque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c58011fd-3e81-4258-ba96-67a624714791",
                        "entry_id": "a6e3271e-faf8-3991-a74b-5b6136251fb5",
                        "tags": [
                            "plural"
                        ],
                        "form": "bicoques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37244526-c9bd-3f09-9f21-a870de4a343f",
                        "entry_id": "a6e3271e-faf8-3991-a74b-5b6136251fb5",
                        "glosses": [
                            "Très petite maison."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "41cca150-10ab-47d3-b867-b8bcb50d80c3",
                                "sense_id": "37244526-c9bd-3f09-9f21-a870de4a343f",
                                "text": "Cette chancelante bicoque bâtie en moellons était revêtue d'une couche de plâtre jauni, […]."
                            },
                            {
                                "example_id": "93069bab-6327-45b5-bb0b-9fd9973b519b",
                                "sense_id": "37244526-c9bd-3f09-9f21-a870de4a343f",
                                "text": "À une petite distance de la bicoque de Dieu le père, le Pape-Dieu rencontra une troupe folâtre de femmes et de jeunes filles, parées d’étoffes voyantes et bigarrées."
                            },
                            {
                                "example_id": "ffd96122-3600-4657-88cf-c82ab7dbfaa0",
                                "sense_id": "37244526-c9bd-3f09-9f21-a870de4a343f",
                                "text": "Pendant de longs siècles, la maison resta bien fragile. A peine différente d'une cabane de bois dans les forêts, bicoque de limon très souvent, elle brûlait ou elle fondait pour un rien."
                            },
                            {
                                "example_id": "c67127c4-ba05-4519-a656-169d28e233f0",
                                "sense_id": "37244526-c9bd-3f09-9f21-a870de4a343f",
                                "text": "Rares et maigres, pauvres et silencieuses étaient les localités traversées et, dans celles-ci, nombreuses étaient les demeures manifestement abandonnées, les bicoques délabrées où tout en fait des ruines."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b9bba5c-9ac6-389d-a9d1-e537a07427dc",
                        "entry_id": "a6e3271e-faf8-3991-a74b-5b6136251fb5",
                        "glosses": [
                            "Maison."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5e915366-847f-46e9-8077-8b284f7416de",
                                "sense_id": "7b9bba5c-9ac6-389d-a9d1-e537a07427dc",
                                "text": "Pourquoi mont-ils enfermée dans cette sale bicoque?"
                            },
                            {
                                "example_id": "ba8faeeb-26bb-4646-9a97-aa4040410ba6",
                                "sense_id": "7b9bba5c-9ac6-389d-a9d1-e537a07427dc",
                                "text": "T'as vu un peu c'te bicoque?"
                            }
                        ]
                    },
                    {
                        "sense_id": "5361376c-2ab1-3b6e-976b-a3844652e87b",
                        "entry_id": "a6e3271e-faf8-3991-a74b-5b6136251fb5",
                        "glosses": [
                            "Petite ville ou place de peu d’importance et de peu de défense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bf50836-180b-4465-b0e9-d4b4f1a9ea9a",
                                "sense_id": "5361376c-2ab1-3b6e-976b-a3844652e87b",
                                "text": "Le fort de Bard a tenu tout ce qu'on était eu droit d'exiger d'une bicoque; il a arrêté l'armée française pendant plusieurs jours, et a failli faire avorter misérablement la plus grande et la plus belle expédition des temps modernes."
                            },
                            {
                                "example_id": "2c63eab4-4a63-431a-96fc-b05adfc1d46e",
                                "sense_id": "5361376c-2ab1-3b6e-976b-a3844652e87b",
                                "text": "Celle qui tient le second rang après Quebec, se nomme Montreal, quoiqu'avant d'y arriver, il faille passer par une autre, que l'on appelle les Trois-Rivières : mais cette dernière n'est qu'une Bicoque, qui à peine mérite le nom de Ville.,"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
