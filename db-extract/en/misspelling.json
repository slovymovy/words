        "de-extract.jsonl": [
            {
                "entry_id": "9da36d32-456e-3a43-9548-92e42de26b01",
                "word": "misspelling",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d1b7ed0-ccff-3f10-9415-f76afddb5c60",
                        "entry_id": "9da36d32-456e-3a43-9548-92e42de26b01",
                        "glosses": [
                            "Rechtschreibfehler, orthografischer Fehler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc8523f5-4b44-4aa7-98a0-a1793409ed36",
                                "sense_id": "2d1b7ed0-ccff-3f10-9415-f76afddb5c60",
                                "text": "The boy had so many misspellings in his homework that it was red when the teacher returned it.",
                                "translation": "Der Bube hatte so viele Rechtschreibfehler in seiner Hausaufgabe, dass sie rot war, als der Lehrer sie zurückgab."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "118d0e23-78cd-48f4-9998-f54e1f09edf8",
                        "source_entry_id": "9da36d32-456e-3a43-9548-92e42de26b01",
                        "source_sense_id": "2d1b7ed0-ccff-3f10-9415-f76afddb5c60",
                        "source_sense_description": "Rechtschreibfehler, orthografischer Fehler",
                        "target_lang_word": "Rechtschreibfehler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechtschreibfehler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "898e627d-6709-3106-9deb-3cdc681ef8d3",
                                        "entry_id": "6f17cb3f-4bac-3e5c-925a-7c2056d03308",
                                        "glosses": [
                                            "Fehler in der Rechtschreibung, falsch geschriebenes Wort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcf96378-9856-46ac-8441-2c717ce50bd3",
                                                "sense_id": "898e627d-6709-3106-9deb-3cdc681ef8d3",
                                                "text": "Heinz schrieb „Libe“ anstatt „Liebe“ und handelte sich damit einen Rechtschreibfehler ein. Dieser Text strotzt nur so vor Rechtschreibfehlern."
                                            },
                                            {
                                                "example_id": "bc8a33d0-d991-42dd-98fd-84eefae1bc7d",
                                                "sense_id": "898e627d-6709-3106-9deb-3cdc681ef8d3",
                                                "text": "„Wer es versucht, macht Rechtschreibfehler und bekommt schlechte Zensuren.“"
                                            },
                                            {
                                                "example_id": "abff1d46-6929-48f2-b4a6-ccee100e27fc",
                                                "sense_id": "898e627d-6709-3106-9deb-3cdc681ef8d3",
                                                "text": "„Deshalb macht es Henning Scheich fassungslos, dass bei den meisten der auf Reichen beruhenden Methoden Rechtschreibfehler mindestens ein Jahr lang, oft auch noch deutlich länger, nicht oder nur unregelmäßig angestrichen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
