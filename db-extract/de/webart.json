                        "source_entry_id": "9bd1015f-96ed-34c5-a232-bfbb116af759",
                        "source_sense_id": "017eb7dd-1e85-30eb-876e-671cc885f526",
                        "source_sense_description": "Art zu weben",
                        "target_lang_word": "weave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b2bb3f2-39e0-3060-8ee5-5982c7e19263",
                                        "entry_id": "232a7bdb-75ef-38e1-8e46-0aed3ae6efc6",
                                        "glosses": [
                                            "To form something by passing lengths or strands of material over and under one another."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88f6eff0-938a-469f-92af-23f884775724",
                                                "sense_id": "1b2bb3f2-39e0-3060-8ee5-5982c7e19263",
                                                "text": "This loom weaves yarn into sweaters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5e4c3cf-c183-323e-a410-3bc057333578",
                                        "entry_id": "232a7bdb-75ef-38e1-8e46-0aed3ae6efc6",
                                        "glosses": [
                                            "To spin a cocoon or a web."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d2ddd98-7254-485f-8c04-55daf88abd7c",
                                                "sense_id": "c5e4c3cf-c183-323e-a410-3bc057333578",
                                                "text": "Spiders weave beautiful but deadly webs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "279e443a-45f5-347f-bf9d-ac28cf03caf7",
                                        "entry_id": "232a7bdb-75ef-38e1-8e46-0aed3ae6efc6",
                                        "glosses": [
                                            "To unite by close connection or intermixture."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9cfb5bf-be60-41bc-86f6-f666d8dc1bb8",
                                                "sense_id": "279e443a-45f5-347f-bf9d-ac28cf03caf7",
                                                "text": "This weaves itself, perforce, into my business."
                                            },
                                            {
                                                "example_id": "c9fe50ca-f679-47f9-9357-dc5937319ed7",
                                                "sense_id": "279e443a-45f5-347f-bf9d-ac28cf03caf7",
                                                "text": "these words, thus woven into song"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e61bf2f7-8937-3407-bc74-139096b65c90",
                                        "entry_id": "232a7bdb-75ef-38e1-8e46-0aed3ae6efc6",
                                        "glosses": [
                                            "To compose creatively and intricately; to fabricate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da8dbd06-660d-48d7-9860-e9a56a3c02c9",
                                                "sense_id": "e61bf2f7-8937-3407-bc74-139096b65c90",
                                                "text": "to weave the plot of a story"
                                            },
                                            {
                                                "example_id": "9688e3c2-81b5-44bd-ac15-aba06fa4bc42",
                                                "sense_id": "e61bf2f7-8937-3407-bc74-139096b65c90",
                                                "text": "According to the simple meaning, these verses warn against forgetting the Torah and against idol worship, but our Sages wove them into an Aggadic passage which deals with physical danger in order to say: Jews must protect their physical health."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "weave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa39a850-6137-3645-b36b-d254191791fe",
                                        "entry_id": "9a628e77-8193-36bd-8ed2-f84c4bca92ee",
                                        "glosses": [
                                            "A type or way of weaving."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aa526f7-476f-4e2c-a896-dc343c33ed7c",
                                                "sense_id": "fa39a850-6137-3645-b36b-d254191791fe",
                                                "text": "That rug has a very tight weave."
                                            },
                                            {
                                                "example_id": "7edb0b26-877a-452f-a0b3-5f0d367830f8",
                                                "sense_id": "fa39a850-6137-3645-b36b-d254191791fe",
                                                "text": "Although fabrics of complex weave can most surely be identified as being imports, others, including a vast array of simple fabrics—bedding, table linens, everyday clothing fabrics—could have been made on either side of the Atlantic, since the materials and equipment were the same."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e5b6e4-5abf-3a13-a08a-0aa6c0780b47",
                                        "entry_id": "9a628e77-8193-36bd-8ed2-f84c4bca92ee",
                                        "glosses": [
                                            "Human or artificial hair worn to alter one's appearance, either to supplement or to cover the natural hair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d0b622-f0df-4928-8855-049d2eb2d5d7",
                                                "sense_id": "10e5b6e4-5abf-3a13-a08a-0aa6c0780b47",
                                                "text": "The physician should evaluate for a history of tight ponytails, buns, chignons, braids, twists, weaves, cornrows, dreadlocks, sisterlocks, and hair wefts in addition to the usage of religious hair coverings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "weave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e1eeb7e-776e-391d-a0f9-732403cdab18",
                                        "entry_id": "5e60e39d-19cb-328a-9d32-d1c56af5186d",
                                        "glosses": [
                                            "To move by turning and twisting."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d001e115-2560-4883-bc60-39ea5d908aee",
                                                "sense_id": "4e1eeb7e-776e-391d-a0f9-732403cdab18",
                                                "text": "The drunk weaved into another bar."
                                            },
                                            {
                                                "example_id": "e79d55be-4536-4c1d-b523-6a688c0fba40",
                                                "sense_id": "4e1eeb7e-776e-391d-a0f9-732403cdab18",
                                                "text": "The victims’ feeling of incredulity at what they were seeing, swiftly turning to paralysing fear as the van bore down on them, swerving and weaving to hit as many people as possible, can barely be imagined."
                                            },
                                            {
                                                "example_id": "2fc0c343-a852-4ecb-ada6-e9b0f579b3be",
                                                "sense_id": "4e1eeb7e-776e-391d-a0f9-732403cdab18",
                                                "text": "Tevez picked up a throw-in from the right, tip-toed his way into the area and weaved past three Wolves challenges before slotting in to display why, of all City's multi-million pound buys, he remains their most important player."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e43a141e-a875-31d6-b0e3-581db21f5c7f",
                                        "entry_id": "5e60e39d-19cb-328a-9d32-d1c56af5186d",
                                        "glosses": [
                                            "To make (a path or way) by winding in and out or from side to side."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9669c2f-4d7c-4cf1-b70d-7b0722177bcd",
                                                "sense_id": "e43a141e-a875-31d6-b0e3-581db21f5c7f",
                                                "text": "The ambulance weaved its way through the heavy traffic."
                                            },
                                            {
                                                "example_id": "a19e7903-0505-46a7-acda-2dca5133012a",
                                                "sense_id": "e43a141e-a875-31d6-b0e3-581db21f5c7f",
                                                "text": "Weave a circle round him thrice,\n And close your eyes with holy dread:\n For he on honey-dew hath fed,\n And drank the milk of Paradise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80bfa3b3-97b8-3c6c-a4be-5b84fa0aa8f3",
                                        "entry_id": "5e60e39d-19cb-328a-9d32-d1c56af5186d",
                                        "glosses": [
                                            "To move the head back and forth in a stereotyped pattern, typically as a symptom of stress."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
