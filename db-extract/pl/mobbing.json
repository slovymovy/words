                                        "entry_id": "de96820b-dc49-3af8-95f6-923fd21970e8",
                                        "glosses": [
                                            "Psychoterror mit dem Ziel, den Betroffenen zur Aufgabe seines Arbeitsplatzes zu bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2245d541-28dd-4ee8-bb03-7ef35dba4f71",
                                                "sense_id": "8fdf5695-fa05-3c99-a458-d1699bd0b57e",
                                                "text": "„Der frühere Spitzenläufer sprach von Mobbing und persönlicher Abrechnung.“"
                                            },
                                            {
                                                "example_id": "b7c22452-f5b0-44fc-b8a2-efa037d07591",
                                                "sense_id": "8fdf5695-fa05-3c99-a458-d1699bd0b57e",
                                                "text": "„Ausgrenzung ist eine subtile Form von Mobbing am Arbeitsplatz, die oft übersehen und unterschätzt wird[, dabei] bezieht [es] sich auf den absichtlichen Ausschluss einer Person von sozialen oder beruflichen Aktivitäten, was zu Gefühlen der Isolation, Einsamkeit und Des-Engagement führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d0e073be-f07d-3137-b5a5-13ba23544345",
                                        "entry_id": "de96820b-dc49-3af8-95f6-923fd21970e8",
                                        "glosses": [
                                            "ständige Schikane, Quälerei und Verletzung eines Kollegen (Schule, Arbeitsplatz, Verein,…)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ac73f2f-7faa-4096-acb3-18e85f63642e",
                                                "sense_id": "d0e073be-f07d-3137-b5a5-13ba23544345",
                                                "text": "„Aggressives Verhalten und Mobbing gegenüber anderen Klassenkolleginnen seien keine Seltenheit mehr.“"
                                            },
                                            {
                                                "example_id": "e08cc4e7-f137-4e37-b7b4-c47ed07440e6",
                                                "sense_id": "d0e073be-f07d-3137-b5a5-13ba23544345",
                                                "text": "„Aufgrund des Mobbings, dem Laura Leonore von Schülern und Lehrern gleichermaßen ausgesetzt war, wurde sie immer verschlossener und eigenbrötlerischer.“"
                                            }
                                        ],
