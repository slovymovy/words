                    {
                        "sense_id": "67d9b1a4-cc95-3fad-a324-0700a1e2207b",
                        "entry_id": "1cd3da9d-21f5-3b0f-b90a-66eaffba20ec",
                        "glosses": [
                            "Heer, das eine Kolonialmacht in ihrer Kolonie unterhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58af5141-680e-4fa2-ac27-4054f64a977e",
                                "sense_id": "67d9b1a4-cc95-3fad-a324-0700a1e2207b",
                                "text": "„Der Belgier war zuvor Kommandeur des Kolonialheeres und führt nun die neue kongolesische Armee.“"
                            },
                            {
                                "example_id": "283858a5-337e-4b0d-8f36-7345a0d47811",
                                "sense_id": "67d9b1a4-cc95-3fad-a324-0700a1e2207b",
                                "text": "„Große Teile der männlichen Bevölkerung hatten im Kolonialheer gedient.“"
                            },
                            {
                                "example_id": "cd0f9ca7-ff5b-44ce-8949-424c9d0b6f16",
                                "sense_id": "67d9b1a4-cc95-3fad-a324-0700a1e2207b",
                                "text": "„Allein der Versuch, im Nordwesten auch noch das Königreich Kabul in Besitz zu nehmen, scheiterte, als afghanische Stämme den ca. 15000 Mann umfassenden Tross der britischen Indus-Armee 1842 aufrieben - die größte Niederlage, die ein britisches Kolonialheer jemals erlebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
