                ],
                "senses": [
                    {
                        "sense_id": "cfe160f2-1bc3-37c1-9ced-7303e230b045",
                        "entry_id": "61ffb21f-5057-3d68-b92e-8f4e1715e295",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d36acdd3-64db-4f94-b739-da3ed4dcb7f0",
                                "sense_id": "cfe160f2-1bc3-37c1-9ced-7303e230b045",
                                "text": "Frau Gaiger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c68d8eed-56a3-4e54-8a67-cd1d5326de8f",
                                "sense_id": "cfe160f2-1bc3-37c1-9ced-7303e230b045",
                                "text": "Herr Gaiger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2235895f-7bdf-45e7-ae1a-a7ef5edd54da",
                                "sense_id": "cfe160f2-1bc3-37c1-9ced-7303e230b045",
                                "text": "Die Gaigers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "10cf9aa5-a037-4bd3-947a-486aec912650",
                                "sense_id": "cfe160f2-1bc3-37c1-9ced-7303e230b045",
                                "text": "Der Gaiger trägt nie die Schals, die die Gaiger ihm strickt."
                            },
                            {
                                "example_id": "be3cab7a-4e41-42f8-be6c-7c046d59c6a5",
                                "sense_id": "cfe160f2-1bc3-37c1-9ced-7303e230b045",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gaiger kommt, geht der Herr Ullrich.“"
                            },
                            {
                                "example_id": "6d93be81-d8b1-4e8a-9e89-5170a7fe33be",
                                "sense_id": "cfe160f2-1bc3-37c1-9ced-7303e230b045",
                                "text": "Gaiger kommt und geht."
                            },
                            {
                                "example_id": "8105065b-7a8f-494e-9167-e5b53905b18b",
                                "sense_id": "cfe160f2-1bc3-37c1-9ced-7303e230b045",
                                "text": "Gaigers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
