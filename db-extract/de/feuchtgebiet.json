                    }
                ],
                "senses": [
                    {
                        "sense_id": "f252175a-9703-3a31-b944-d7495e3ed605",
                        "entry_id": "9dc8b394-edef-315f-ba77-b466c67d14b5",
                        "glosses": [
                            "Feuchtbiotop; ein überwiegend wasserreicher Lebensraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eabe0f94-1f4c-4008-94d8-cc4e230fc42a",
                                "sense_id": "f252175a-9703-3a31-b944-d7495e3ed605",
                                "text": "„Die Tropen sind ein Traum aus einer Zeit, da Feuchtgebiete noch hoch romantisch waren.“"
                            },
                            {
                                "example_id": "67dfcc0d-59a6-467b-9c49-7869c46d84fb",
                                "sense_id": "f252175a-9703-3a31-b944-d7495e3ed605",
                                "text": "„1989 wurde Oostvaardersplassen der Rang eines international wichtigen Feuchtgebiets zuerkannt.“"
                            },
                            {
                                "example_id": "ee618f35-430c-4684-8776-7038fd4e83c3",
                                "sense_id": "f252175a-9703-3a31-b944-d7495e3ed605",
                                "text": "„Ziel ist, viele der natürlichen Feuchtgebiete zu bewahren, da sie zu den wenigen Refugien für Vögel in dem sich schnell entwickelnden Land gehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "498d1293-f762-468e-be0d-e9e69c849ca2",
                        "source_entry_id": "9dc8b394-edef-315f-ba77-b466c67d14b5",
                        "source_sense_id": "f252175a-9703-3a31-b944-d7495e3ed605",
                        "source_sense_description": "Feuchtbiotop; ein überwiegend wasserreicher Lebensraum",
                        "target_lang_word": "wetland",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wetland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22dd58bb-6c41-3df2-b12a-2f01b85d1c89",
                                        "entry_id": "b39454db-687e-3b61-a4c9-a59d98bc59a1",
                                        "glosses": [
                                            "Land that is covered mostly with water, with occasional marshy and soggy areas."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf31906c-5053-4da5-84ad-07bd31208935",
                                                "sense_id": "22dd58bb-6c41-3df2-b12a-2f01b85d1c89",
                                                "text": "European adventurers found themselves within a watery world, a tapestry of streams, channels, wetlands, lakes and lush riparian meadows enriched by floodwaters from the Mississippi River."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e2c0ba8-9f16-4250-b505-62bc70d2d884",
                        "source_entry_id": "9dc8b394-edef-315f-ba77-b466c67d14b5",
                        "source_sense_id": "f252175a-9703-3a31-b944-d7495e3ed605",
                        "source_sense_description": "Feuchtbiotop; ein überwiegend wasserreicher Lebensraum",
                        "target_lang_word": "zone humide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zone humide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3da5e7d1-5aec-3107-a5b1-4df314ff10b9",
                                        "entry_id": "c7da5620-d04b-37bc-9d36-5dec2b175daa",
                                        "glosses": [
                                            "Région où le principal facteur d'influence du biotope et de sa biocénose est l'eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43d32e55-f19f-4f61-a949-97a357eb42db",
                                                "sense_id": "3da5e7d1-5aec-3107-a5b1-4df314ff10b9",
                                                "text": "La basse vallée de la Seine abrite de nombreuses zones humides (vasières, prairies humides, tourbières…) et représente un ensemble écologique de première importance pour la biodiversité au niveau international."
                                            },
                                            {
                                                "example_id": "b8fbc3a3-25fe-4bd7-8d2a-036ae9d5703c",
                                                "sense_id": "3da5e7d1-5aec-3107-a5b1-4df314ff10b9",
                                                "text": "Les zones humides ont la capacité de retenir l’eau, de la stocker et ainsi de limiter les crues et inondations."
                                            },
                                            {
                                                "example_id": "f387a726-ea0b-48f6-a54d-3921d7dede2b",
                                                "sense_id": "3da5e7d1-5aec-3107-a5b1-4df314ff10b9",
                                                "text": "De plus, des habitants de la région, à Gidy et alentours, expliquèrent que cette grande zone humide entretenait le cours d’une petite rivière souterraine, la Retrève, connue pour se manifester de temps en temps, c'est-à-dire surgir et inonder, la campagne en cas de fortes pluies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14ba957e-b3ad-302a-8160-5e33072dfac8",
                                        "entry_id": "c7da5620-d04b-37bc-9d36-5dec2b175daa",
                                        "glosses": [
                                            "Terres couvertes ou saturées d'eau en permanence ou pendant une partie importante de l'année, selon la Directive 2009/28/CE du Parlement européen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7e39672-5058-37b2-879d-4b961adc6b8e",
                                        "entry_id": "c7da5620-d04b-37bc-9d36-5dec2b175daa",
                                        "glosses": [
                                            "Zone littorale où l’eau est stagnante ou courante, douce, saumâtre ou salée, y compris des étendues d’eau marine dont la profondeur à marée basse n’excède pas six mètres, dans la Convention de Ramsar"
                                        ],
                                        "tags": [
                                            "Droit international",
                                            "Droit de l’environnement"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8208d591-7b2a-3ce9-8229-ef2f46c27f2f",
                                        "entry_id": "c7da5620-d04b-37bc-9d36-5dec2b175daa",
                                        "glosses": [
                                            "Surface chargée de substance ou vapeur aqueuse."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
