                ],
                "senses": [
                    {
                        "sense_id": "e0457f5a-44e8-36b5-890d-c1ebe0ce3c6e",
                        "entry_id": "ba938aea-c944-3a74-a1f6-6581bb25caaa",
                        "glosses": [
                            "Courbure, cambrure d’un ski qui fait que ce dernier, posé à plat et sans pression, ne touche le sol que par ses extrémités (spatule et talon), la partie centrale (patin) étant habituellement à quelques centimètres."
                        ],
                        "tags": [
                            "Ski"
                        ],
                        "examples": [
                            {
                                "example_id": "62f2d4ad-5fba-41ee-8ca9-0da9b94edd36",
                                "sense_id": "e0457f5a-44e8-36b5-890d-c1ebe0ce3c6e",
                                "text": "Certains skis ont un cambre inversé qui améliore le comportement de glisse en hors-piste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9706db90-b75f-4ab5-992c-48609ab0b576",
                        "source_entry_id": "ba938aea-c944-3a74-a1f6-6581bb25caaa",
                        "source_sense_id": "e0457f5a-44e8-36b5-890d-c1ebe0ce3c6e",
                        "target_lang_word": "Vorspannung",
