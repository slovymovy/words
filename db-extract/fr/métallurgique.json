                                        "entry_id": "a0551689-f607-37fb-8d6d-6a9894bda1fa",
                                        "glosses": [
                                            "die Metallurgie betreffend, zu ihr gehörend, mithilfe der Metallurgie"
                                        ],
                                        "tags": [],
