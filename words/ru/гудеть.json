{
    "word_family": [
        "гул",
        "гудок",
        "гудение"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b763be1-4de2-30e4-9f08-825c88ae70f4",
                    "sense_definition": "Издавать длительный монотонный звук",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В лесу начали <w>гудеть</w> проснувшиеся шмели.",
                            "target_lang_translations": {
                                "en": "The awakened bumblebees began to <w>buzz</w> in the forest."
                            }
                        },
                        {
                            "text": "Старый трансформатор в подвале стал <w>гудеть</w> громче обычного.",
                            "target_lang_translations": {
                                "en": "The old transformer in the basement started to <w>hum</w> louder than usual."
                            }
                        }
                    ],
                    "common_phrases": [
                        "провода гудят"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a long, monotonous, low-pitched sound, often like machinery or insects."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hum",
                                "target_lang_sense_clarification": "To make a low, continuous, steady sound."
                            },
                            {
                                "target_lang_word": "buzz",
                                "target_lang_sense_clarification": "To make a low, continuous humming or vibrating sound, typical of insects."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97950c36-e551-36c1-a0ee-8cc7c9afd4d5",
                    "sense_definition": "Издавать протяжный громкий сигнал",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Корабль начал <w>гудеть</w> перед выходом из порта.",
                            "target_lang_translations": {
                                "en": "The ship began to <w>blare</w> its horn before leaving the port."
                            }
                        },
                        {
                            "text": "Грузовики на дороге начали <w>гудеть</w> в пробке.",
                            "target_lang_translations": {
                                "en": "Trucks on the road started to <w>honk</w> in the traffic jam."
                            }
                        }
                    ],
                    "common_phrases": [
                        "сирена гудит"
                    ],
                    "target_lang_definitions": {
                        "en": "To emit a long, loud signal, typically using a horn or siren."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "honk",
                                "target_lang_sense_clarification": "To sound a vehicle horn."
                            },
                            {
                                "target_lang_word": "blare",
                                "target_lang_sense_clarification": "To make a loud, harsh, or strident sound."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d559daa-4778-3d7c-9db6-07cce5c267cb",
                    "sense_definition": "Говорить или петь низким монотонным голосом",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старик продолжал <w>гудеть</w> что-то себе под нос.",
                            "target_lang_translations": {
                                "en": "The old man continued to <w>drone</w> something under his breath."
                            }
                        },
                        {
                            "text": "Лектор монотонно <w>гудел</w> с кафедры, и студенты начали засыпать.",
                            "target_lang_translations": {
                                "en": "The lecturer <w>droned on</w> in a monotone from the lectern, and the students began to doze off."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To speak or sing in a low, monotonous, and often tedious voice."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drone",
                                "target_lang_sense_clarification": "To speak in a dull, monotonous tone."
                            },
                            {
                                "target_lang_word": "mumble",
                                "target_lang_sense_clarification": "To speak indistinctly or in a low voice."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4b2e8f0-16c8-33ec-9bec-a65c4a626ea2",
                    "sense_definition": "Непрерывно ныть, надоедливо жаловаться",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хватит <w>гудеть</w> по пустякам, лучше займись делом.",
                            "target_lang_translations": {
                                "en": "Stop <w>whining</w> about trifles; you'd better get to work."
                            }
                        },
                        {
                            "text": "Он весь вечер <w>гудел</w> о своей низкой зарплате.",
                            "target_lang_translations": {
                                "en": "He spent the whole evening <w>griping</w> about his low salary."
                            }
                        }
                    ],
                    "synonyms": [
                        "гундеть"
                    ],
                    "antonyms": [
                        "молчать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To complain persistently or whine in an annoying way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whine",
                                "target_lang_sense_clarification": "To complain in a feeble or petulant way."
                            },
                            {
                                "target_lang_word": "gripe",
                                "target_lang_sense_clarification": "To complain about something in a persistent, annoying manner."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f63d104-6f02-3250-b326-37dcfa2b0276",
                    "sense_definition": "Шумно праздновать, пировать",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "party",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты решили <w>гудеть</w> всю ночь после экзамена.",
                            "target_lang_translations": {
                                "en": "The students decided to <w>party</w> all night after the exam."
                            }
                        },
                        {
                            "text": "Вся компания начала <w>гудеть</w> в ресторане до самого утра.",
                            "target_lang_translations": {
                                "en": "The whole group started to <w>carouse</w> in the restaurant until the very morning."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To party or celebrate in a noisy, boisterous manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "party",
                                "target_lang_sense_clarification": "To enjoy oneself at a social gathering, often with drinking."
                            },
                            {
                                "target_lang_word": "carouse",
                                "target_lang_sense_clarification": "To drink plentiful amounts of alcohol and enjoy oneself with others in a noisy way."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}