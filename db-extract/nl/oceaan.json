                                "sense_id": "e8d45fe4-6272-3cd8-8ebf-93716d4ba264",
                                "text": "In eerdere geologische tijdperken bestonden er andere oceanen.",
                                "translation": "Different oceans existed in earlier geological periods.",
                                "english": "Different oceans existed in earlier geological periods."
                            }
                        ]
