                {
                    "sense_id": "172b8997-17dd-366f-955c-8195723a11df",
                    "sense_definition": "A common shorthand for the Dow Jones Industrial Average, a stock market index.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "Investors watched closely as the <w>Dow</w> climbed to a new record high today.",
                            "target_lang_translations": {
                                "ru": "Инвесторы внимательно наблюдали за тем, как <w>Доу</w> сегодня поднялся до нового рекордного максимума."
                            }
                        },
                        {
                            "text": "The <w>Dow</w> fell by several hundred points following the news of the interest rate hike.",
                            "target_lang_translations": {
                                "ru": "Индекс <w>Доу</w> упал на несколько сотен пунктов после новостей о повышении процентной ставки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Dow Jones",
                        "Dow Jones average"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общепринятое сокращение для промышленного индекса Доу-Джонса, фондового индекса."
