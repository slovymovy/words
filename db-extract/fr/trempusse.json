                        "examples": [
                            {
                                "example_id": "e8f40ad8-95d2-4fd9-8410-d54059c2dd85",
                                "sense_id": "085bf795-ab05-3527-84a1-5f6effcf2921",
                                "text": "Mais attention ! il y a trempusse et trempusse ! Il y a la trempusse pour « rebailler des forces »."
                            },
                            {
                                "example_id": "7724c20b-5d81-419a-b1fa-917781c9f885",
                                "sense_id": "085bf795-ab05-3527-84a1-5f6effcf2921",
                                "text": "Mes vieux et mes vieilles avaient tous moissonné à la grande faucille, et la plupart se soutenait encore chaque jour d’un bon bol de trempusse au ratafia, dont je me repentirais de ne pas donner ici la recette : verser un quart de litre de ratafia dans un bol, y tremper de grosses mouillettes de pain frais ou rassis selon les goûts et manger les mouillettes."
                            }
                        ]
                    }
