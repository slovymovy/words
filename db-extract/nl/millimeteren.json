                        "sense_id": "3e0653d9-9357-3132-aaca-2bb087266b6e",
                        "entry_id": "817f88a3-9181-3ae3-a7c0-47981f97e947",
                        "glosses": [
                            "zeer kort afknippen van het hoofdhaar met een tondeuse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c869d6e-7e4e-42a0-b99c-2d2e37ff6f89",
                                "sense_id": "3e0653d9-9357-3132-aaca-2bb087266b6e",
                                "text": "Buzzcut: Een stijl waarbij het haar eenzelfde lengte heeft. Wanneer je je haar wilt millimeteren zijn er verschillende lengtes die je kunt hanteren, variërend 0.5 tot 2 centimeter. Wanneer je dit te extreem vindt, probeer dan voor de achterkant en zijkanten een lengte van 0.5 centimeter en voor de bovenkant een lengte van 1 centimeter."
                            }
                        ]
                    }
                ],
