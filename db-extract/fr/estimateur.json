                    {
                        "sense_id": "607c04aa-560a-3d2e-b6de-3c5a034756de",
                        "entry_id": "041ba4a4-15a1-3aab-b9ec-1cd678cc2f52",
                        "glosses": [
                            "Celui qui fait l’estimation d’une chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e48f50f-22ec-4024-a19d-b26eb5570351",
                                "sense_id": "607c04aa-560a-3d2e-b6de-3c5a034756de",
                                "text": "Si nous ne pouvons convenir de prix, nous prendrons des estimateurs."
                            },
                            {
                                "example_id": "07494c0e-c473-41b9-a7ba-4d51f004957a",
                                "sense_id": "607c04aa-560a-3d2e-b6de-3c5a034756de",
                                "text": "Nous conviendrons d’un estimateur."
                            },
                            {
                                "example_id": "0531389f-1d38-429f-8472-2eeefb893069",
                                "sense_id": "607c04aa-560a-3d2e-b6de-3c5a034756de",
                                "text": "Dans ce cas , on s'adressera à un estimateur dont l’œil exercé saura discerner, d’une manière certaine, celle des classes précédentes, à laquelle appartient le taillis à estimer."
                            },
                            {
                                "example_id": "102a63d3-dd75-46c5-abcc-f5edd94729cf",
                                "sense_id": "607c04aa-560a-3d2e-b6de-3c5a034756de",
                                "text": "— Juste estimateur de la vertu, du mérite des ouvrages d’esprit, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "60f472ca-e354-39e1-a589-e310dbc430b7",
                        "entry_id": "041ba4a4-15a1-3aab-b9ec-1cd678cc2f52",
                        "glosses": [
