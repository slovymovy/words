        "fr-extract.jsonl": [
            {
                "entry_id": "2fe9d3f4-3495-3d7e-bf9a-f1fa3b5504e8",
                "word": "songe-creux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7c4ac308-b3e0-343c-b1b0-1aac15ab9b81",
                        "entry_id": "2fe9d3f4-3495-3d7e-bf9a-f1fa3b5504e8",
                        "glosses": [
                            "Personne qui rêve habituellement à des projets chimériques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d81e4ab4-c316-4370-a182-8e8d33be0320",
                                "sense_id": "7c4ac308-b3e0-343c-b1b0-1aac15ab9b81",
                                "text": "Ils le jugeaient nul, songe creux, incapable de mettre la main sur la France et surtout de se maintenir au pouvoir."
                            },
                            {
                                "example_id": "94622097-5ce3-4609-baa4-ace4942014e8",
                                "sense_id": "7c4ac308-b3e0-343c-b1b0-1aac15ab9b81",
                                "text": "Martial n’était qu’un rêveur, un de ces songe-creux qui semblent porter tout un monde entier dans le cerveau et qui n’y ont rien que des bulles d’air."
                            },
                            {
                                "example_id": "ee31ffe8-0292-4861-b983-097177827853",
                                "sense_id": "7c4ac308-b3e0-343c-b1b0-1aac15ab9b81",
                                "text": "Au milieu du siècle dernier, on traitait de songe-creux et de lunatiques ceux qui prétendaient aplanir les hiérarchies traditionnelles et renverser même la personne du Roi."
                            },
                            {
                                "example_id": "482b1960-3a42-40e7-8eec-1556878d6e6a",
                                "sense_id": "7c4ac308-b3e0-343c-b1b0-1aac15ab9b81",
                                "text": "Le plus beau, c’est que des régimes compliqués et cruels ont été institués pour parer à cette pathologie lunatique. Des messieurs et des dames du meilleur monde ont été sacrifiés, comme de simples cobayes, à l’impossible vérification des rêveries de l’illustre songe-creux. C’est ça qui donne une fière idée de la candeur humaine !"
                            },
                            {
                                "example_id": "ed2973eb-0acc-42d1-be58-9a0c59a2f9e7",
                                "sense_id": "7c4ac308-b3e0-343c-b1b0-1aac15ab9b81",
                                "text": "Vieillir est sot, ne nous laissons pas abuser par les belles maximes des songe-creux bibliques."
                            }
                        ]
                    },
                    {
                        "sense_id": "90ea4093-91d8-3f2c-aa07-a3f98742822f",
                        "entry_id": "2fe9d3f4-3495-3d7e-bf9a-f1fa3b5504e8",
                        "glosses": [
                            "Personne dont la pensée est limitée et irrationnelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10ea2e0b-abee-420c-9ce5-4066d38bb4f3",
                                "sense_id": "90ea4093-91d8-3f2c-aa07-a3f98742822f",
                                "text": "Comme tous les songe-creux, je confondis le désenchantement avec la vérité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7586c455-e48a-4126-9fcf-8478e77d0b7a",
                        "source_entry_id": "2fe9d3f4-3495-3d7e-bf9a-f1fa3b5504e8",
                        "target_lang_word": "visionary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75d06b68-c498-39b3-84c1-8b19bf64dd8b",
                                        "entry_id": "92155cc7-41f0-3e2e-a751-d72b6db00aae",
                                        "glosses": [
                                            "Having vision or foresight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c85987b2-ceba-4d59-a529-2856346069b7",
                                                "sense_id": "75d06b68-c498-39b3-84c1-8b19bf64dd8b",
                                                "text": "No more theſe ſeenes my meditation aid, / Or lull to reſt the viſionary mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256b10e6-3e8f-3e74-9eb6-eddd18518c2a",
                                        "entry_id": "92155cc7-41f0-3e2e-a751-d72b6db00aae",
                                        "glosses": [
                                            "Imaginary or illusory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "203cd31e-c7de-46c7-bafb-8a670d6c34b1",
                                                "sense_id": "256b10e6-3e8f-3e74-9eb6-eddd18518c2a",
                                                "text": "I wrapp’d myself in grandeur then,\nAnd donn’d a visionary crown—\nYet it was not that Fantasy\nHad thrown her mantle over me—\nBut that, among the rabble—men,\nLion ambition is chain’d down— […]"
                                            },
                                            {
                                                "example_id": "1b6aa4a2-314c-47d6-9f23-722048267c34",
                                                "sense_id": "256b10e6-3e8f-3e74-9eb6-eddd18518c2a",
                                                "text": "To many, the visionary hope which is born of the imagination may seem the very mockery of nothing. We cannot imagine what we have never experienced."
                                            },
                                            {
                                                "example_id": "2be31e2e-dafd-4273-82e0-37db3989b2ea",
                                                "sense_id": "256b10e6-3e8f-3e74-9eb6-eddd18518c2a",
                                                "text": "Here Mr. Jackson smiled once more upon the company; and, applying his left thumb to the tip of his nose, worked a visionary coffee-mill with his right hand, thereby performing a very graceful piece of pantomime (then much in vogue, but now, unhappily, almost obsolete) which was familiarly denominated taking a grinder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e63bd5-b428-3cd4-a2c3-41f9d5ef20f7",
                                        "entry_id": "92155cc7-41f0-3e2e-a751-d72b6db00aae",
                                        "glosses": [
                                            "Prophetic or revelatory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eae309f-f058-4073-a0c3-4b5169893f01",
                                                "sense_id": "27e63bd5-b428-3cd4-a2c3-41f9d5ef20f7",
                                                "text": "Here frequent, at the viſionary hour, / When muſing midnight reigns or ſilent noon, / Angelic harps are in full concert heard, / And voiced chaunting from the wood-crown’d hill, / The deepening dale, or inmoſt ſilvan glade[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb2bf9e-4683-37dc-ab41-ca0a110853bb",
                                        "entry_id": "92155cc7-41f0-3e2e-a751-d72b6db00aae",
                                        "glosses": [
                                            "Idealistic or utopian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e221fe9-1fe6-4e75-aa47-e850b587e0cf",
                                                "sense_id": "dfb2bf9e-4683-37dc-ab41-ca0a110853bb",
                                                "text": "a visionary scheme or project"
                                            },
                                            {
                                                "example_id": "27c540fa-1aa9-4501-901c-4568e7b49dcc",
                                                "sense_id": "dfb2bf9e-4683-37dc-ab41-ca0a110853bb",
                                                "text": "I confeſs, the Merit of this Candour and Condeſcenſion is very much leſſened ; becauſe your Lordſhip hardly leaves us Room to offer our good Wiſhes ; removing all our Difficulties, and ſupplying our Wants, faſter than the moſt viſionary Projector can adjuſt his Schemes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "visionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbe0e381-2d5d-3743-88ee-7056a0b76458",
                                        "entry_id": "ac8ec32e-d25a-3f15-b97a-0e2e7c7072d3",
                                        "glosses": [
                                            "Someone who has visions; a seer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "402206c2-c324-3f37-8059-6f6757d4d53b",
                                        "entry_id": "ac8ec32e-d25a-3f15-b97a-0e2e7c7072d3",
                                        "glosses": [
                                            "An impractical dreamer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df10621-89ef-4765-86d6-cfcdc2b51507",
                                                "sense_id": "402206c2-c324-3f37-8059-6f6757d4d53b",
                                                "text": "For seven years [Christopher Columbus] begged persistently for aid, but in vain. He was looked upon as a visionary, and the very boys in the street mocked him as a lunatic. At length he was permitted to lay his plans before a committee of learned men, but only to have them ridiculed, the council dismissing him as a foolish enthusiast."
                                            },
                                            {
                                                "example_id": "a3580258-cffa-4905-883c-d1f5c7e443b2",
                                                "sense_id": "402206c2-c324-3f37-8059-6f6757d4d53b",
                                                "text": "In a military sense Russia is defenceless, and we all supposed it a proof that they were mere visionaries when they started negotiations by insisting upon not surrendering any Russian territory to the Germans."
                                            },
                                            {
                                                "example_id": "32a5f40d-f158-4770-a3be-9ed3fab4f080",
                                                "sense_id": "402206c2-c324-3f37-8059-6f6757d4d53b",
                                                "text": "Along with the good planners there are lots of wild-eyed visionaries who don’t relate ideas to real-life practicalities."
                                            },
                                            {
                                                "example_id": "5c5a3969-9efc-46dd-91fb-fdd7975ca97f",
                                                "sense_id": "402206c2-c324-3f37-8059-6f6757d4d53b",
                                                "text": "Jefferson’s intellectual prowess led some political opponents to dismiss him as a visionary, but he was remarkably successful in politics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "985ee1ed-a0f6-3768-924e-d07755cfc468",
                                        "entry_id": "ac8ec32e-d25a-3f15-b97a-0e2e7c7072d3",
                                        "glosses": [
                                            "Someone who has creative and positive ideas about the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953a760f-483c-465c-91f3-cd9078202872",
                                                "sense_id": "985ee1ed-a0f6-3768-924e-d07755cfc468",
                                                "text": "Robertson was finally asked to step down at the end of 1961. His successor would be Dr Beeching, who was seen as both visionary and axeman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
