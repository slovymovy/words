                                        "sense_id": "49a710cc-2f96-346f-b2e9-a4e4872f3a50",
                                        "entry_id": "a1e3dfbd-47d0-304b-9ce5-30a2366409b7",
                                        "glosses": [
                                            "A special rear hub for a bicycle that functions as a brake when the user pedals backwards, and which allows the bicycle to roll without forcing the pedals to turn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c9392d5-7ac6-4a70-9456-c3e5217c0e37",
                                                "sense_id": "49a710cc-2f96-346f-b2e9-a4e4872f3a50",
                                                "text": "Billy slammed on his coaster brakes and said \"anybody wanna go on up to Greasy Lake?\""
                                            },
                                            {
                                                "example_id": "3e99274f-8f67-4303-ac73-790060d8b4d2",
                                                "sense_id": "49a710cc-2f96-346f-b2e9-a4e4872f3a50",
                                                "text": "The coaster brake is one of the three types of braking mechanism developed to slow down and stop a bike safely and efficiently. This mechanism quickly gained in popularity in the USA, Germany and the Netherlands in the 1890s and is still used for upright and children's bicycles."
                                            }
                                        ]
                                    }
                                ]
                            }
