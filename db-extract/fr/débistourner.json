                "senses": [
                    {
                        "sense_id": "efc404d8-cf3a-370c-be91-7b92a444982a",
                        "entry_id": "e26e583c-935b-30b8-91b4-0231dacfd6fb",
                        "glosses": [
                            "Annuler un bistournage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd1a0f10-e3f4-4203-b9d1-c24abee413e0",
                                "sense_id": "efc404d8-cf3a-370c-be91-7b92a444982a",
                                "text": "Un sieur Berline fait bistourner un cheval par M. Lamarche… Le lendemain, engorgement excessif des bourses, perte d’appétit, fièvre, etc. Le troisième jour, M. Lamarche, effrayé, essaye de débistourner."
                            },
                            {
                                "example_id": "eb5026d3-e5c3-49f8-aed2-2efd194b48de",
                                "sense_id": "efc404d8-cf3a-370c-be91-7b92a444982a",
                                "text": "Le troisième jour il était si manifeste pour tout le monde que ces accidents étaient la conséquence du bistournage, que Lamarche, dans le but de se justifier, essaya de débistourner le cheval."
                            }
                        ]
                    }
                ],
