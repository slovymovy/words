    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d33c8cb0-a4b2-3cdc-8e16-427f51ec29e1",
                    "sense_definition": "форма именительного падежа множественного числа существительного <w>ребёнок</w>: дети, малыши",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "children",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В парке гуляли маленькие <w>ребята</w> с родителями.",
                            "target_lang_translations": {
                                "en": "Little <w>kids</w> were walking in the park with their parents."
                            }
                        },
                        {
                            "text": "Все <w>ребята</w> очень любят играть в футбол на улице.",
                            "target_lang_translations": {
                                "en": "All the <w>children</w> love playing football outside very much."
                            }
                        }
                    ],
                    "synonyms": [
                        "дети"
                    ],
                    "common_phrases": [
                        "маленькие ребята"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "форма множественного числа"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "children, kids, youngsters (nominative plural form of 'child')"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kids",
                                "target_lang_sense_clarification": "informal, referring to children"
                            },
                            {
                                "target_lang_word": "children",
                                "target_lang_sense_clarification": "young people or boys and girls"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "447519a8-f883-38c2-b0ea-418237056afd",
                    "sense_definition": "молодые люди, парни, а также дружеское обращение к группе людей",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "young_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наши <w>ребята</w> отлично справились с этой сложной задачей.",
                            "target_lang_translations": {
                                "en": "Our <w>guys</w> did a great job with this difficult task."
                            }
                        },
                        {
                            "text": "Привет, <w>ребята</w>, как у вас дела сегодня?",
                            "target_lang_translations": {
                                "en": "Hey <w>guys</w>, how are you doing today?"
                            }
                        }
                    ],
                    "synonyms": [
                        "парни",
                        "мальчики"
                    ],
                    "antonyms": [
                        "девчата"
                    ],
                    "common_phrases": [
                        "наши ребята",
                        "привет ребята"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "young men, fellows, or a friendly informal form of address to a group of people regardless of gender"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guys",
                                "target_lang_sense_clarification": "used informally to refer to or address a group"
                            },
                            {
                                "target_lang_word": "boys",
                                "target_lang_sense_clarification": "young males or male friends"
                            },
                            {
                                "target_lang_word": "lads",
                                "target_lang_sense_clarification": "young men or a group of mates (informal/chiefly British)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
