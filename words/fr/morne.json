                    "frequency": "Middle",
                    "semantic_group_id": "tristesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis l'annonce de la mauvaise nouvelle, Paul reste assis dans un silence <w>morne</w>."
