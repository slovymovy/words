            {
                "entry_id": "49eca9bc-fa39-3135-80bd-04fe66c30786",
                "word": "décryptage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e3f11a89-64c5-41a8-a250-a140b0f9e66d",
                        "entry_id": "49eca9bc-fa39-3135-80bd-04fe66c30786",
                        "tags": [
