            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ffdaeb0-3bd1-3fd4-882d-c7de9a647c44",
                    "sense_definition": "The act of using something or the amount of something that is used.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "utilization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is trying to reduce its energy <w>usage</w> to save money and help the environment.",
                            "target_lang_translations": {
                                "ru": "Компания старается сократить <w>потребление</w> энергии, чтобы сэкономить деньги и помочь окружающей среде."
                            }
                        },
                        {
                            "text": "Heavy <w>usage</w> of the internet during the evening can sometimes slow down the connection speed.",
                            "target_lang_translations": {
                                "ru": "Активное <w>использование</w> интернета в вечернее время иногда может замедлять скорость соединения."
                            }
                        }
                    ],
                    "synonyms": [
                        "use",
                        "utilization",
                        "consumption",
                        "employment"
                    ],
                    "antonyms": [
                        "nonuse",
                        "disuse"
                    ],
                    "common_phrases": [
                        "heavy usage",
                        "energy usage",
                        "data usage",
                        "recorded usage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по использованию чего-либо или количество используемого ресурса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использование",
                                "target_lang_sense_clarification": "процесс применения чего-либо"
                            },
                            {
                                "target_lang_word": "потребление",
                                "target_lang_sense_clarification": "расход ресурса, например энергии или данных"
                            },
                            {
                                "target_lang_word": "применение",
                                "target_lang_sense_clarification": "использование на практике"
                            }
