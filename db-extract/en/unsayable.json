    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "763435d3-5995-3721-83aa-170e4636a98a",
                "word": "unsayable",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "89c02afd-686d-485a-9339-8d6df9e889ca",
                        "entry_id": "763435d3-5995-3721-83aa-170e4636a98a",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more unsayable"
                    },
                    {
                        "form_id": "c834b8b9-a528-4cef-8ae2-6f5d4e5b637a",
                        "entry_id": "763435d3-5995-3721-83aa-170e4636a98a",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most unsayable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e67bda1-f2b0-3797-bcb6-34bd95018a0f",
                        "entry_id": "763435d3-5995-3721-83aa-170e4636a98a",
                        "glosses": [
                            "Not capable of being said."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cfde924-a561-44e4-80a7-4b635d9759d0",
                                "sense_id": "0e67bda1-f2b0-3797-bcb6-34bd95018a0f",
                                "text": "Whatsoever has been said before me, even on any subject, surely it belongs thereto that it can be repeated by me in rehearsal, and hence it does not seem possible that in this sense it should be so fitly called unspeakable or unsayable."
                            },
                            {
                                "example_id": "5aea0f8b-e1cf-4427-8682-f2260ddc125a",
                                "sense_id": "0e67bda1-f2b0-3797-bcb6-34bd95018a0f",
                                "text": "Nonetheless, in some unsayable way, value sentences are about values and reflect the structure of values."
                            },
                            {
                                "example_id": "7ad1d2e1-2a70-4518-b35a-26b167e507e4",
                                "sense_id": "0e67bda1-f2b0-3797-bcb6-34bd95018a0f",
                                "text": "The unsaid drives us to “speak;” but, in some ways, there are limitations on what we can say, because some part always remains unsaid — we must always attempt to say the unsayable."
                            }
                        ]
                    },
                    {
                        "sense_id": "89329024-9f0e-361d-bbed-9f5f2f37df5d",
                        "entry_id": "763435d3-5995-3721-83aa-170e4636a98a",
                        "glosses": [
                            "Not allowed or not fit to be said."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ad41b663-3e8a-4196-8fe1-3ba7ba2b1c9f",
                                "sense_id": "89329024-9f0e-361d-bbed-9f5f2f37df5d",
                                "text": "His task: to say the unsayable. To say all the words we have normally suppressed and to say them and say them and say them."
                            },
                            {
                                "example_id": "12001077-77b3-4e2c-b339-4f5de75ff269",
                                "sense_id": "89329024-9f0e-361d-bbed-9f5f2f37df5d",
                                "text": "In Oakland, Rachel Blau's lawn is green because it rained recently. But if there's no rain, \"we let it go,\" she says, bravely adding the unsayable \"I don't care how it looks.\""
                            },
                            {
                                "example_id": "d072c1ea-9202-4238-98b6-5c18ae0b84ce",
                                "sense_id": "89329024-9f0e-361d-bbed-9f5f2f37df5d",
                                "text": "He was sacked, rather, for, saying the unsayable: for telling the truth."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c87a321-1a35-4a9b-86cb-44403402c531",
                        "source_entry_id": "763435d3-5995-3721-83aa-170e4636a98a",
                        "source_sense_description": "Translations",
                        "target_lang_word": "indicible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indicible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cacf3cbb-f669-37ec-94c0-93a7e2e1847d",
                                        "entry_id": "fe6c11e0-eee7-3075-b62e-26ff92b8228f",
                                        "glosses": [
                                            "Qu’on ne peut exprimer par des mots ; indescriptible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2c7f05a-abf9-4d64-8abd-f60705bf68f4",
                                                "sense_id": "cacf3cbb-f669-37ec-94c0-93a7e2e1847d",
                                                "text": "Maurice, […] se retourna de mon côté avec un regard si paresseux, si plein d’un indicible reproche, que je fus ému du combat qu’il était forcé de se livrer pour obéir, sans se laisser aller au désespoir."
                                            },
                                            {
                                                "example_id": "9ba14669-e6fb-444d-a981-b9b02cd80e83",
                                                "sense_id": "cacf3cbb-f669-37ec-94c0-93a7e2e1847d",
                                                "text": "Le paysage était d'une indicible grandeur. De tous côtés surgissaient des montagnes plongeant à pic dans la mer, tandis que leurs cimes neigeuses se perdaient dans les nuages; […]."
                                            },
                                            {
                                                "example_id": "d8280c5d-354f-42f4-988f-7abbc052d889",
                                                "sense_id": "cacf3cbb-f669-37ec-94c0-93a7e2e1847d",
                                                "text": "[…] le vagabond le trouvait là, inexprimable, au fond des prunelles changeantes de l’aimée, où il plongeait ses regards, longtemps, longtemps, jusqu'à ce que l'angoisse indicible de la volupté broyât leurs deux êtres?"
                                            },
                                            {
                                                "example_id": "e4797ff6-bed0-4b4a-ae1c-3b9821f8c97e",
                                                "sense_id": "cacf3cbb-f669-37ec-94c0-93a7e2e1847d",
                                                "text": "Un faire-part imprimé, collé sur une vitre, annonçait la mort d’un client. Aucun nom sous le sien. Nulle mention d’ami ni de famille. […]. Cet avis mortuaire, avec son laconisme, me parut d’une indicible tristesse […]."
                                            },
                                            {
                                                "example_id": "801df92d-eef2-45df-9e9a-8615df86f270",
                                                "sense_id": "cacf3cbb-f669-37ec-94c0-93a7e2e1847d",
                                                "text": "« Est-ce le catholicisme qui m’a laissé un tel goût de pureté que la moindre allusion aux choses de la chair met en moi une détresse indicible ? »"
                                            },
                                            {
                                                "example_id": "c81227bb-533f-43cd-84a4-12375f76e5ed",
                                                "sense_id": "cacf3cbb-f669-37ec-94c0-93a7e2e1847d",
                                                "text": "Dans le fond de l’urne, il y avait du dicible et du pas dicible. « Indicible », avait corrigé le lettré, le vieux qui tenait une sorte d’hôtel à côté de la boutique de Damas."
                                            },
                                            {
                                                "example_id": "a6a44936-69e1-4e99-b038-7b08e12856f2",
                                                "sense_id": "cacf3cbb-f669-37ec-94c0-93a7e2e1847d",
                                                "text": "Et je vous nomme à présent les choses indicibles. Cela va être dur, je vous l’ai dit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indicible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b3c7be6-aafe-3dd0-aae5-7cb5faf41ac8",
                                        "entry_id": "8146683b-edc4-3b0b-97d1-b1e12d70f0c6",
                                        "glosses": [
                                            "Ce qui ne peut pas s'exprimer, ce qui est innommable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c11a56b2-4fa9-4539-a110-803c0046b065",
                                                "sense_id": "9b3c7be6-aafe-3dd0-aae5-7cb5faf41ac8",
                                                "text": "Il sentait tout l'infini, tout l'imprécis de cet horizon entrer en lui, le pénétrer, alanguir son âme et comme l'embrumer, elle aussi, de vague et d'indicible."
                                            },
                                            {
                                                "example_id": "fea5212d-3532-42b0-a995-e9eb42977672",
                                                "sense_id": "9b3c7be6-aafe-3dd0-aae5-7cb5faf41ac8",
                                                "text": "Par votre attitude irresponsable, vous allez pousser les équipes soignantes déjà surmenées à se confronter à l’indicible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
