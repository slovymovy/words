        "de-extract.jsonl": [
            {
                "entry_id": "c18b1002-6bba-3f40-8fde-5e22f9cbd91d",
                "word": "fatuity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2aeb9c0f-3dfa-3d64-aabd-006753893a64",
                        "entry_id": "c18b1002-6bba-3f40-8fde-5e22f9cbd91d",
                        "glosses": [
                            "Albernheit, Dummheit"
                        ],
                        "tags": [
                            "förmlich"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cd32164-4ddf-41fe-9eb7-a8762dacc0e1",
                        "source_entry_id": "c18b1002-6bba-3f40-8fde-5e22f9cbd91d",
                        "source_sense_id": "2aeb9c0f-3dfa-3d64-aabd-006753893a64",
                        "source_sense_description": "förmlich: Albernheit, Dummheit",
                        "target_lang_word": "Albernheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Albernheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7daca785-e3b2-3e69-87a7-62e4709c6969",
                                        "entry_id": "68f8c89b-2241-3117-ab6c-94a06e10dec9",
                                        "glosses": [
                                            "Eigenschaft, spaßig/albern zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d261587-e92f-4b75-96bb-9baf5089aaa6",
                                                "sense_id": "7daca785-e3b2-3e69-87a7-62e4709c6969",
                                                "text": "In geselliger Runde kann Albernheit gut ankommen."
                                            },
                                            {
                                                "example_id": "60ac1fe0-5afe-47e1-9873-3779a27512d2",
                                                "sense_id": "7daca785-e3b2-3e69-87a7-62e4709c6969",
                                                "text": "„Die Ruchlosigkeit der Hausmeier empörte sie keineswegs – und sie legten Anquetil beiseite, von der Albernheit seiner Betrachtungen abgestoßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "72c5c84b-639f-379f-bcb4-0c6442bae3a1",
                                        "entry_id": "68f8c89b-2241-3117-ab6c-94a06e10dec9",
                                        "glosses": [
                                            "etwas, das die Eigenschaft [1] aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d83c470b-a18e-4ddd-b52f-ecf771c6a37b",
                                                "sense_id": "72c5c84b-639f-379f-bcb4-0c6442bae3a1",
                                                "text": "„Wenn ich Albernheiten schwatzte, hörte sie mir aufmerksam zu, und um nicht für dumm zu gelten, lachte sie jedesmal übermäßig.“"
                                            },
                                            {
                                                "example_id": "3f22afbe-0de9-423b-9541-19e6a17fd880",
                                                "sense_id": "72c5c84b-639f-379f-bcb4-0c6442bae3a1",
                                                "text": "„Solche Albernheiten haben meist mit dem Englischen zu tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8845d5ea-0a96-488d-8d4c-ee55628846ad",
                        "source_entry_id": "c18b1002-6bba-3f40-8fde-5e22f9cbd91d",
                        "source_sense_id": "2aeb9c0f-3dfa-3d64-aabd-006753893a64",
                        "source_sense_description": "förmlich: Albernheit, Dummheit",
                        "target_lang_word": "Dummheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dummheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "442b09d3-c764-3f2f-8508-e7ce237774c8",
                                        "entry_id": "671dab56-74b1-3546-9f8d-60cd937f7ffd",
                                        "glosses": [
                                            "mangelnde geistige Fähigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86177dfa-f70b-4f14-84f3-bc2865393a1f",
                                                "sense_id": "442b09d3-c764-3f2f-8508-e7ce237774c8",
                                                "text": "„Nichts gibt so sehr das Gefühl der Unendlichkeit als wie die Dummheit.“"
                                            },
                                            {
                                                "example_id": "3654cd0c-bf67-4cfe-bfa3-2f0d44a357e8",
                                                "sense_id": "442b09d3-c764-3f2f-8508-e7ce237774c8",
                                                "text": "„Erst werden die Menschen unters Joch gezwungen und dann als knechtisch verachtet, unterdrückt und dann von oben herab behandelt, verdummt und ihrer Dummheit wegen verhöhnt, versklavt und als Sklaven geschmäht.“"
                                            },
                                            {
                                                "example_id": "37905582-81e4-49a5-8d46-86276c85a236",
                                                "sense_id": "442b09d3-c764-3f2f-8508-e7ce237774c8",
                                                "text": "„Hinter der Dummheit des Sprechers scheinen Gefühle auf, die ihm unvorstellbar bleiben müssem, und bald darauf leitet er eine Intrige ein.“"
                                            },
                                            {
                                                "example_id": "82457246-b329-40c2-81b0-c778cc28860c",
                                                "sense_id": "442b09d3-c764-3f2f-8508-e7ce237774c8",
                                                "text": "„Die Dummheit einer Dienerin ist viel gefährlicher als ihre Bosheit und belastet den Herrn weit mehr, denn eine Bösartige kann man mit Recht bestrafen, eine Dumme aber nicht; man kann sie nur fortschicken und sich damit abfinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9dfbe3c0-4cb9-3bb7-b561-b492337bd7a4",
                                        "entry_id": "671dab56-74b1-3546-9f8d-60cd937f7ffd",
                                        "glosses": [
                                            "unüberlegte, dumme Tat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4be88419-3233-40a3-9f43-016dbba12588",
                                                "sense_id": "9dfbe3c0-4cb9-3bb7-b561-b492337bd7a4",
                                                "text": "„Plötzlich duckt er sich über den Tisch weg und keucht: Ich habe dich unterschätzt, Gatt. Was verlangst du? Daß du dich stellst. Wann? Sofort. Stille. Mach keine Dummheiten. Ich verständige die Volkspolizei.“"
                                            },
                                            {
                                                "example_id": "1f091ea7-960f-46cf-a714-5bb22733e5e1",
                                                "sense_id": "9dfbe3c0-4cb9-3bb7-b561-b492337bd7a4",
                                                "text": "Das, was du da getan hast, war eine Dummheit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
