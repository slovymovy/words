                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bde58d4-cdd3-4bc8-a867-2c75f912bfae",
                                                "sense_id": "c6020071-a3f3-34ce-9090-f25a4ba467ff",
                                                "text": "His countenance was bold and bashed not."
                                            }
                                        ]
