                "senses": [
                    {
                        "sense_id": "ecca938b-6057-3ebd-ae0e-ab5e7dbe3f0f",
                        "entry_id": "79f150d1-e8a3-3a14-9e96-b8951c7dc404",
                        "glosses": [
                            "bloem van een appelboom Malus domestica"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c30a9e6-7e9c-4251-b376-91dc8c9f7c13",
                                "sense_id": "ecca938b-6057-3ebd-ae0e-ab5e7dbe3f0f",
                                "text": "Bij kersenbloesem zijn de steeltjes langer dan bij pruimen. En bij pruimen en kersen is de bloesem helderwit, in plaats van crèmewit, zoals bij peren. Appelbloesem is roziger."
                            },
                            {
                                "example_id": "17b41f2c-fc20-41ec-97af-2a76a589cf63",
                                "sense_id": "ecca938b-6057-3ebd-ae0e-ab5e7dbe3f0f",
                                "text": "Mannetjes ruiken naar hout, leer en nootmuskaat, vrouwtjes naar perzik en appelbloesem."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5255009-488a-34b3-86f5-0ee450e80969",
                        "entry_id": "79f150d1-e8a3-3a14-9e96-b8951c7dc404",
                        "glosses": [
                            "bleekroze kleur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be8ab30-8578-4a64-99d0-1c02857ab99c",
                                "sense_id": "b5255009-488a-34b3-86f5-0ee450e80969",
                                "text": "Appelbloesem wordt gemaakt uit een kleine hoeveelheid Engels rood met veel wit. Het was een vrij algemeen voorkomende interieurkleur in de 17de eeuw."
                            }
                        ]
                    }
