                    },
                    {
                        "translation_id": "5e31461c-0007-4edc-b276-31b88a0065a3",
                        "source_entry_id": "87fdd2e9-7563-37e4-bb00-672cad44dd41",
                        "source_sense_id": "b559e94b-bb62-39d2-a5bb-7392ef9212b4",
                        "source_sense_description": "not mobile",
                        "target_lang_word": "unbeweglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbeweglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "659e3a82-2dea-3019-b5e4-abf25bf2e802",
                                        "entry_id": "81933679-e435-3cde-b094-c53b1ed80960",
                                        "glosses": [
                                            "nicht in der Lage, sich zu bewegen oder bewegt zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d3bd72-279b-4711-a2fc-4d1b14041980",
                                                "sense_id": "659e3a82-2dea-3019-b5e4-abf25bf2e802",
                                                "text": "Er saß unbeweglich am Fenster."
                                            },
                                            {
                                                "example_id": "5314724d-029c-4be4-b2b4-a28e4640003f",
                                                "sense_id": "659e3a82-2dea-3019-b5e4-abf25bf2e802",
                                                "text": "Der Scharfschütze lag unbeweglich auf dem Boden und zielte durch sein Fernrohr."
                                            },
                                            {
                                                "example_id": "bcb6aaa2-f145-47f6-ac0f-82fa65e8f7da",
                                                "sense_id": "659e3a82-2dea-3019-b5e4-abf25bf2e802",
                                                "text": "Sie verharrte unbeweglich in ihrem Versteck."
                                            },
                                            {
                                                "example_id": "712ed2c4-ee69-4d59-92f0-af65075488d1",
                                                "sense_id": "659e3a82-2dea-3019-b5e4-abf25bf2e802",
                                                "text": "Der moderne Mensch reist meist ziemlich unbeweglich. Stundenlanges Sitzen im Auto, Bus oder Flugzeug kann zu schweren Beinen führen, wenn sich das Blut in den Beinvenen staut."
                                            },
                                            {
                                                "example_id": "8d575901-7015-47b4-878d-1990099661fe",
                                                "sense_id": "659e3a82-2dea-3019-b5e4-abf25bf2e802",
                                                "text": "Als Méliès 1902 den Film [\"Die Reise zum Mond\"] realisierte, stand die Kamera im Filmatelier noch unbeweglich an einem Fleck. Auf die Idee, dass man sie bewegen könnte, kamen später erst andere."
                                            },
                                            {
                                                "example_id": "70bfc1fc-a973-4725-b377-fccebb0fa753",
                                                "sense_id": "659e3a82-2dea-3019-b5e4-abf25bf2e802",
                                                "text": "Beim Mann könne es [die Unfähigkeit, Kinder zu zeugen] daran liegen, dass die Spermien verformt oder unbeweglich sind und es gar nicht erst schaffen, bis zur Eizelle vorzudringen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9215e601-e8b5-3bed-8741-4e21513a9ce9",
                                        "entry_id": "81933679-e435-3cde-b094-c53b1ed80960",
                                        "glosses": [
                                            "ein sich nicht verändernder Gesichtsausdruck / eine sich nicht verändernde Körperhaltung"
                                        ],
                                        "tags": [
                                            "Mimik",
                                            "Körper"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72023b1e-5091-41db-aff6-d1bc07938c54",
                                                "sense_id": "9215e601-e8b5-3bed-8741-4e21513a9ce9",
                                                "text": "Mit unbeweglicher Miene sah der Schachspieler, wie sein Gegner seine Dame schlug."
                                            },
                                            {
                                                "example_id": "4513b497-3e07-4349-a6ce-2bb666f91818",
                                                "sense_id": "9215e601-e8b5-3bed-8741-4e21513a9ce9",
                                                "text": "„Mirko, unbeweglich vier Stunden vor dem Brett sitzend, besiegte, ohne ein Wort zu sprechen oder auch nur aufzuschauen, einen Spieler nach dem andern;“ […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7ea5237a-68d6-3d5a-ab20-3383a6341002",
                                        "entry_id": "81933679-e435-3cde-b094-c53b1ed80960",
                                        "glosses": [
                                            "schwerfällig, auch: geistig schwerfällig; sich nur sehr langsam verändernd oder an etwas anpassend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0141db5-b3f0-49c5-8b84-8cef2020affb",
                                                "sense_id": "7ea5237a-68d6-3d5a-ab20-3383a6341002",
                                                "text": "„Ich bin jetzt in einem Alter, wo man denkt, man habe privat und beruflich alles erreicht“, sagt Melinda nachdenklich. „Man wird unbeweglich.“[…]"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cb8fb2ec-0423-31b1-8c8d-62761abf7bc3",
                                        "entry_id": "81933679-e435-3cde-b094-c53b1ed80960",
                                        "glosses": [
                                            "in Bezug auf Kapital und Investitionen: langfristig gebunden, angelegt, festgelegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb9b7bef-6bea-44c4-8953-570d84f0bca4",
                                                "sense_id": "cb8fb2ec-0423-31b1-8c8d-62761abf7bc3",
                                                "text": "[Das unbewegliche Vermögen besteht aus] Grundstücken, Gebäuden, technische Anlagen (z.B. Umspannwerke, Hochöfen, fest eingebaute Transportanlagen) und andere Anlagen (also nicht unmittelbar der Produktion dienende Anlagen wie Fernsprech- und Rohrpostanlagen). [Das] unbewegliche Vermögen ist Teil des Anlagevermögens."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b3b60054-a94e-3757-a9d8-b88fb39fc0a7",
                                        "entry_id": "81933679-e435-3cde-b094-c53b1ed80960",
                                        "glosses": [
                                            "angewendet auf große Organisationseinheiten: nicht in der Lage, sich veränderten Bedingungen anzupassen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8118067c-7e71-4610-8979-d57b2a742c93",
                                                "sense_id": "b3b60054-a94e-3757-a9d8-b88fb39fc0a7",
                                                "text": "Bürgerinitiativen [finden] immer mehr Gehör. Parteien dagegen gelten als unbeweglich, ideologisch bestimmt und undurchschaubar in ihren verkrusteten Strukturen."
                                            }
                                        ],
