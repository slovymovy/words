{
    "word_family": [
        "glad"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2db7c0d8-a51c-3039-9e52-ae7d00cebf2d",
                    "sense_definition": "An open or cleared space in a forest.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "open_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deer grazed peacefully in the quiet <w>glade</w> hidden deep within the forest.",
                            "target_lang_translations": {
                                "pl": "Jeleń pasł się spokojnie na cichej <w>polanie</w> ukrytej głęboko w lesie."
                            }
                        },
                        {
                            "text": "Sunlight filtered through the trees, illuminating a small <w>glade</w> filled with wildflowers.",
                            "target_lang_translations": {
                                "pl": "Światło słoneczne przenikało przez drzewa, oświetlając małą <w>polanę</w> pełną polnych kwiatów."
                            }
                        }
                    ],
                    "synonyms": [
                        "clearing"
                    ],
                    "common_phrases": [
                        "forest glade"
                    ],
                    "target_lang_definitions": {
                        "pl": "Otwarta lub oczyszczona przestrzeń w lesie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "polana",
                                "target_lang_sense_clarification": "otwarta przestrzeń w lesie pozbawiona drzew"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3eeff5fd-be85-379e-a81e-5fae85318194",
                    "sense_definition": "A bright surface of ice or snow.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bright_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frozen lake reflected the sun, creating a blinding <w>glade</w> of ice.",
                            "target_lang_translations": {
                                "pl": "Zamarznięte jezioro odbijało słońce, tworząc oślepiającą <w>taflę</w> lodu."
                            }
                        },
                        {
                            "text": "We skated across the smooth <w>glade</w> that had formed after the winter storm.",
                            "target_lang_translations": {
                                "pl": "Jeździliśmy na łyżwach po gładkiej <w>tafli</w>, która utworzyła się po zimowej burzy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Jasna, błyszcząca powierzchnia lodu lub śniegu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "lodowisko",
                                "target_lang_sense_clarification": "gładka, błyszcząca powierzchnia lodu"
                            },
                            {
                                "target_lang_word": "tafla",
                                "target_lang_sense_clarification": "gładka, błyszcząca powierzchnia zamarzniętej wody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94e922d3-4c7c-3249-af4d-c2e8e2631bd3",
                    "sense_definition": "A bright patch of sky between clouds.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bright_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small <w>glade</w> of blue sky appeared briefly through the thick grey clouds.",
                            "target_lang_translations": {
                                "pl": "Mały <w>prześwit</w> błękitnego nieba pojawił się na chwilę między gęstymi, szarymi chmurami."
                            }
                        },
                        {
                            "text": "The storm began to break, revealing a bright <w>glade</w> above the horizon.",
                            "target_lang_translations": {
                                "pl": "Burza zaczęła ustępować, odsłaniając jasny <w>prześwit</w> nad horyzontem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Jasny fragment nieba widoczny między chmurami."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "prześwit",
                                "target_lang_sense_clarification": "fragment nieba widoczny między chmurami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0b83611-9028-38a0-89e8-c9acbefb37ea",
                    "sense_definition": "A swampy, grassy area, specifically an everglade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "open_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat moved slowly through the shallow <w>glade</w> of the marshland.",
                            "target_lang_translations": {
                                "pl": "Łódź poruszała się powoli przez płytkie <w>mokradło</w>."
                            }
                        },
                        {
                            "text": "Many unique birds nest in the tall grasses of the southern <w>glade</w>.",
                            "target_lang_translations": {
                                "pl": "Wiele unikalnych ptaków gniazduje w wysokich trawach południowego <w>mokradła</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Podmokły, trawiasty teren, często bagienny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "mokradło",
                                "target_lang_sense_clarification": "podmokły, bagnisty teren"
                            },
                            {
                                "target_lang_word": "bagno",
                                "target_lang_sense_clarification": "podmokły, grząski teren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "360485bd-5ebd-339d-8671-7824c37aeedc",
                    "sense_definition": "An open space in the ice on a river or lake.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "open_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman cast his line into the <w>glade</w> of open water amidst the ice.",
                            "target_lang_translations": {
                                "pl": "Rybak zarzucił wędkę w <w>przerębel</w> pośród lodu."
                            }
                        },
                        {
                            "text": "The river current kept a small <w>glade</w> open even during the coldest winter days.",
                            "target_lang_translations": {
                                "pl": "Nurt rzeki utrzymywał mały <w>przerębel</w> otwarty nawet podczas najmroźniejszych zimowych dni."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Otwarta przestrzeń wody pośród lodu na rzece lub jeziorze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przerębel",
                                "target_lang_sense_clarification": "otwór w lodzie na rzece lub jeziorze"
                            },
                            {
                                "target_lang_word": "prześwit",
                                "target_lang_sense_clarification": "otwarte miejsce w lodzie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ef35b16-607d-33a0-b860-4d839d16de59",
                    "sense_definition": "A gleam or flash of light.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bright_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>glade</w> of light broke through the dark, stormy clouds.",
                            "target_lang_translations": {
                                "pl": "Nagły <w>błysk</w> światła przebił się przez ciemne, burzowe chmury."
                            }
                        },
                        {
                            "text": "The diamond ring caught the sun, casting a sharp <w>glade</w> across the room.",
                            "target_lang_translations": {
                                "pl": "Diamentowy pierścionek złapał słońce, rzucając ostry <w>odblask</w> na cały pokój."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nagły błysk lub odblask światła."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "błysk",
                                "target_lang_sense_clarification": "nagłe pojawienie się światła"
                            },
                            {
                                "target_lang_word": "odblask",
                                "target_lang_sense_clarification": "światło odbite od powierzchni"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3583863f-4054-3652-a324-f54e482fe1e8",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the article is a researcher named Dr. <w>Glade</w>.",
                            "target_lang_translations": {
                                "pl": "Autorem artykułu jest badacz o nazwisku dr <w>Glade</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Glade</w> has been working at the company for over twenty years.",
                            "target_lang_translations": {
                                "pl": "Pan <w>Glade</w> pracuje w firmie od ponad dwudziestu lat."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nazwisko."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Glade",
                                "target_lang_sense_clarification": "nazwisko własne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}