                ],
                "senses": [
                    {
                        "sense_id": "63a11a8a-bfc6-3b5d-acf8-871933e2809b",
                        "entry_id": "492961cf-67e9-3991-9010-0d8981924043",
                        "glosses": [
                            "Naht, die zur Zierde beispielsweise auf einem Kleidungsstück angebracht wurde"
                        ],
                        "tags": [
                            "Schneidern"
                        ],
                        "examples": [
                            {
                                "example_id": "d9ac50b7-6ed7-4f5f-b9a6-a1061bb83e45",
                                "sense_id": "63a11a8a-bfc6-3b5d-acf8-871933e2809b",
                                "text": "Diese Ziernaht hier sieht sehr hübsch aus."
                            },
                            {
                                "example_id": "bb6ccafc-0471-4dc5-b266-4198a6d63b2c",
                                "sense_id": "63a11a8a-bfc6-3b5d-acf8-871933e2809b",
                                "text": "„Sie lag auf dem Bett, sah die Ziernaht in seinem Hemdkragen.“"
                            },
                            {
                                "example_id": "46786420-9543-4d05-ad52-1ea779dfd8d3",
                                "sense_id": "63a11a8a-bfc6-3b5d-acf8-871933e2809b",
                                "text": "[Fertigung eines Sattels:] „»Anschließend kommen die Näharbeiten«, erklärt Jana. »Mit der Hand oder der Nähmaschine füge ich einzelne Teile zusammen oder bringe Ziernähte auf.«“"
                            },
                            {
                                "example_id": "e73b57c0-ca72-4c3e-bf16-3b50c7a7771b",
                                "sense_id": "63a11a8a-bfc6-3b5d-acf8-871933e2809b",
                                "text": "„Für die weiteren Arbeitsschritte nutzt sie spezielle Maschinen. Sie glättet Kanten, näht Einzelteile zusammen und bringt Ziernähte an.“"
                            },
                            {
                                "example_id": "7d842c7c-6364-4f87-b83e-d0d3891c89e4",
                                "sense_id": "63a11a8a-bfc6-3b5d-acf8-871933e2809b",
                                "text": "„Mal muss der Faden im wesentlichen halten. Es gibt aber auch Ziernähte in Schuhen, da geht es um den Glanz und die Schönheit des Fadens.“"
                            },
                            {
                                "example_id": "593a3ed1-9f05-449a-b1bd-ff60d1f93430",
                                "sense_id": "63a11a8a-bfc6-3b5d-acf8-871933e2809b",
                                "text": "[Polster- und Dekorationsnäher/-in:] „Handwerklich geschickt sein sollen die Auszubildenden schon: Zunächst lernen sie, gerade Nähte zu nähen. […] Dann kommen Rundungen und Bögen dran, Raffnähte und Ziernähte.“"
                            },
                            {
                                "example_id": "1b243443-bd0e-4d5d-9b6a-cc6d91793c1c",
                                "sense_id": "63a11a8a-bfc6-3b5d-acf8-871933e2809b",
                                "text": "[Wenn sie die Linien nachsteppen, können sie] „dazu einen Gerad- oder Zickzackstich oder auch Ziernähte verwenden.“"
                            },
                            {
                                "example_id": "134004c6-c7fe-4765-a0ba-66584b6c87e9",
                                "sense_id": "63a11a8a-bfc6-3b5d-acf8-871933e2809b",
                                "text": "[Bezugsstoffe für Möbel, Gardinen, Untersetzer, Tagesdecken, Taschen, Lampenschirme:] „Einige sind durch Lochmuster gestanzt und farbig unterlegt. Andere mit auffälligen Ziernähten versehen oder zu Mustern z.B. in Waffelpiké gepresst.“"
                            },
                            {
                                "example_id": "23fe538f-9926-4457-b57c-dde695451d0d",
                                "sense_id": "63a11a8a-bfc6-3b5d-acf8-871933e2809b",
                                "text": "„Ein Kunde möchte an seiner neuen Tasche einen Griff haben. Anina sucht das passende Leder und die richtige Farbe heraus. Mit einem Riemenschneider schneidet sie das Stück zu, rundet dann die Enden mit dem Halbmondmesser ab. Schließlich fasst sie den Griff an der Nähmaschine mit Ziernähten ein.“"
                            },
                            {
                                "example_id": "654b239b-6a02-455f-b611-01fc2a427a4b",
                                "sense_id": "63a11a8a-bfc6-3b5d-acf8-871933e2809b",
                                "text": "„Archäologie – Was Stoffe von der Hallstatt-Kultur erzählen – […] Gefunden wurden farbenprächtige Stoffe, gemustert mit Karos und Streifen, versehen mit Ziernähten und Brettchenweberei. Teilweise handelte es sich um feinstes Tuch mit nur 0,1 Millimeter dicken Fäden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
