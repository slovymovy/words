                        "glosses": [
                            "Qui peut être rangé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "277a17a6-8a9b-46b6-9148-cb84716fb01e",
                                "sense_id": "e69d1859-aa5f-3028-a583-f039962777f2",
                                "text": "Mais il y a lieu de ne pas oublier que les mots, pour rangeables qu’ils soient toujours dans une essence donnée, n’en gardent pas moins des possibilités valentielles diverses, …."
                            },
                            {
                                "example_id": "acc6cea5-1825-4bb2-aef5-a34918409f16",
                                "sense_id": "e69d1859-aa5f-3028-a583-f039962777f2",
                                "text": "Même les inconnus à Lille étaient plus ou moins connus, ou du moins rangeables dans des catégories qu’il connaissait."
                            },
                            {
                                "example_id": "c4795197-c6b0-47b9-a616-11b75a0a6f76",
                                "sense_id": "e69d1859-aa5f-3028-a583-f039962777f2",
                                "text": "Dans un récent dialogue, la Langue, paru chez Verdier, il écrit que la nature de l’écrivain est « d’être un inclassable, un asocial, un “mal placé”, un dérangé, c’est-à-dire un pas rangé, pas rangeable du tout »."
                            },
                            {
                                "example_id": "de91a1a6-0c67-45c0-9fa3-2914dff46efc",
                                "sense_id": "e69d1859-aa5f-3028-a583-f039962777f2",
                                "text": "C’est un petit navet aux haricots pour grands enfants, rangeable entre Oz 2013 et autres Titans ou Avatar de bazar féerique."
                            }
                        ]
                    }
