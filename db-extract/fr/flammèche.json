                                                "example_id": "9819001e-2bf5-4c10-8aa8-5d784ed89470",
                                                "sense_id": "900c57d8-1984-3a3f-96e3-29250afb343d",
                                                "text": "Guns spark in the dark, it was all just a part of the eighties Bronx scene that created all."
                                            }
