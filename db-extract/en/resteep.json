                        "glosses": [
                            "The act or process of resteeping."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1716bd9-b9dc-4209-a504-e744aa991f03",
                                "sense_id": "e83f08a2-0323-3069-8584-be0162557ca3",
                                "text": "Trial maltings using between 0.05% and 0.4% formaldehyde in the resteep gave unsatisfactory results when applied before three days' germination."
                            },
                            {
                                "example_id": "54fdb935-fa25-48f8-b1cc-0a4ca0b13b9a",
                                "sense_id": "e83f08a2-0323-3069-8584-be0162557ca3",
                                "text": "Formaldehyde applied in a resteep gave the best extract yield, combined with the greatest reduction in anthocyanogens."
                            },
                            {
                                "example_id": "5e85466c-79a2-4692-86d7-e15bcaf1097f",
                                "sense_id": "e83f08a2-0323-3069-8584-be0162557ca3",
                                "text": "The process is more certain if warm water is used in the resteep."
                            }
                        ]
                    }
                ],
