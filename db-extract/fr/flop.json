                "senses": [
                    {
                        "sense_id": "721754eb-3702-38ae-a425-097b0733b34e",
                        "entry_id": "f8f50c40-01f3-339a-99e5-45f92a6edba2",
                        "glosses": [
                            "Échec, en particulier d’œuvre artistique ou d’entreprise commerciale."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a2873d8b-f518-4a98-8df4-3ebbba3fd98f",
                                "sense_id": "721754eb-3702-38ae-a425-097b0733b34e",
                                "text": "La perfection, je te dis. Un disque génial… qu’on ne peut malheureusement trouver que chez les collectionneurs un peu fêlés dans mon genre. Cette pure merveille a été un flop commercial."
                            },
                            {
                                "example_id": "984799d5-5621-4f77-a0f6-6d39eeee6dcd",
                                "sense_id": "721754eb-3702-38ae-a425-097b0733b34e",
                                "text": "Fort divertissant, ce livre recense les plus grands flops de marques connues."
                            },
                            {
                                "example_id": "70b31d7b-07eb-436e-b09d-804771bf4fd4",
                                "sense_id": "721754eb-3702-38ae-a425-097b0733b34e",
                                "text": "Il ne se vendra que 200 000 exemplaires de l’extension [32X], soit un énorme flop."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03505b69-54f5-4146-a847-d650d759540b",
                        "source_entry_id": "f8f50c40-01f3-339a-99e5-45f92a6edba2",
                        "source_sense_id": "721754eb-3702-38ae-a425-097b0733b34e",
