                        "sense_id": "9f114926-cc83-3ef1-b100-d45f5e0619b3",
                        "entry_id": "01c9883f-8235-37fa-9c9a-e85661b1e775",
                        "glosses": [
                            "Gegebenheit/Vorhandensein der Möglichkeit zur Verwirklichung eines Planes, Konzeptes oder Vorhabens"
