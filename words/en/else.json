{
    "word_family": [
        "elsewhere"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c5b53403-a10a-3d88-9162-dd0dc250117c",
                    "sense_definition": "Used after indefinite pronouns (like someone, anything) or interrogative words (like who, what) to mean other, different, or additional.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you need anything <w>else</w> from the store?",
                            "target_lang_translations": {
                                "ru": "Тебе нужно что-нибудь <w>ещё</w> из магазина?",
                                "zh": "你还需要从商店买<w>别的</w>东西吗？"
                            }
                        },
                        {
                            "text": "Ask someone <w>else</w> if they can help you.",
                            "target_lang_translations": {
                                "ru": "Спроси кого-нибудь <w>другого</w>, могут ли они помочь.",
                                "zh": "问问<w>别人</w>看能不能帮你。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "someone else",
                        "anything else",
                        "what else",
                        "anyone else",
                        "nothing else"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется после неопределенных местоимений или вопросительных слов в значении «другой» или «дополнительный».",
                        "zh": "用于不定代词或疑问词之后，表示“另外的”、“不同的”或“附加的”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ещё",
                                "target_lang_sense_clarification": "дополнительно, в добавок"
                            },
                            {
                                "target_lang_word": "другой",
                                "target_lang_sense_clarification": "иной, отличный от данного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "别的",
                                "target_lang_sense_clarification": "指代其他事物或人"
                            },
                            {
                                "target_lang_word": "其他",
                                "target_lang_sense_clarification": "指代不同于已提及的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c8a68525-2c50-399f-be93-4aaf0bf88b24",
                    "sense_definition": "In a different way, at a different time, or in a different place.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "How <w>else</w> can we solve this difficult problem?",
                            "target_lang_translations": {
                                "ru": "Как <w>ещё</w> мы можем решить эту сложную проблему?",
                                "zh": "我们还能用什么<w>别的</w>方法解决这个难题？"
                            }
                        },
                        {
                            "text": "I am busy on Friday, so when <w>else</w> works for you?",
                            "target_lang_translations": {
                                "ru": "Я занят в пятницу, так когда <w>ещё</w> тебе удобно?",
                                "zh": "我周五很忙，你<w>还有</w>什么时间方便？"
                            }
                        }
                    ],
                    "synonyms": [
                        "otherwise"
                    ],
                    "common_phrases": [
                        "how else",
                        "where else",
                        "when else"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иным образом, в другое время или в другом месте.",
                        "zh": "以不同的方式、在不同的时间或地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ещё",
                                "target_lang_sense_clarification": "в дополнение к упомянутому"
                            },
                            {
                                "target_lang_word": "иначе",
                                "target_lang_sense_clarification": "по-другому"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "另外",
                                "target_lang_sense_clarification": "表示除此之外的补充"
                            },
                            {
                                "target_lang_word": "还有",
                                "target_lang_sense_clarification": "表示还有其他选择或方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "83e336f1-fe86-3022-9b7e-c04111be70ad",
                    "sense_definition": "Used to introduce a statement that indicates what will happen if the previous statement is not true or followed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must be careful, or <w>else</w> you might fall.",
                            "target_lang_translations": {
                                "ru": "Ты должен быть осторожен, или <w>иначе</w> ты можешь упасть.",
                                "zh": "你必须小心，<w>否则</w>可能会摔倒。"
                            }
                        },
                        {
                            "text": "We need to leave now, <w>else</w> we will miss the bus.",
                            "target_lang_translations": {
                                "ru": "Нам нужно выходить сейчас, <w>иначе</w> мы опоздаем на автобус.",
                                "zh": "我们得现在出发，<w>不然</w>就赶不上公交车了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "otherwise",
                        "or"
                    ],
                    "common_phrases": [
                        "or else"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения утверждения, указывающего на последствия невыполнения предыдущего условия.",
                        "zh": "用于引出如果不满足前述条件将会发生的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иначе",
                                "target_lang_sense_clarification": "в противном случае"
                            },
                            {
                                "target_lang_word": "а то",
                                "target_lang_sense_clarification": "разговорное выражение следствия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "否则",
                                "target_lang_sense_clarification": "在不满足条件的情况下"
                            },
                            {
                                "target_lang_word": "不然",
                                "target_lang_sense_clarification": "口语中表示后果"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "006a15f7-6690-3e49-b1b4-da114e29b242",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Else</w> has lived in this town for many years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Элс</w> живет в этом городе много лет.",
                                "zh": "<w>埃尔斯</w>先生在这个镇上住了很多年了。"
                            }
                        },
                        {
                            "text": "I saw the name <w>Else</w> listed in the directory.",
                            "target_lang_translations": {
                                "ru": "Я видел фамилию <w>Элс</w> в справочнике.",
                                "zh": "我在名录里看到了<w>埃尔斯</w>这个名字。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "A family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Элс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "埃尔斯",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}