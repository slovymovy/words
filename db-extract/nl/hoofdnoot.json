                    {
                        "sense_id": "dfe39212-f193-30e7-89d7-333052cdd55d",
                        "entry_id": "f2801ceb-e804-3c63-aa09-046638d463f9",
                        "glosses": [
                            "belangrijkste, overheersende muzieknoten in een muziekstuk of akkoord"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79a4fe3d-f60f-45b9-a161-a76cb3af36f1",
                                "sense_id": "dfe39212-f193-30e7-89d7-333052cdd55d",
                                "text": "Met de elektro-mechanische pianola konden Honing en Desain een paar jaar geleden onomstotelijk vaststellen dat speelsnelheid van voorslagen (korte versieringsnootjes voor een 'hoofdnoot') in pianomuziek aan geheel eigen wetten gehoorzaamt."
                            },
                            {
                                "example_id": "55111158-9958-491f-9da9-4ca08f434e0d",
                                "sense_id": "dfe39212-f193-30e7-89d7-333052cdd55d",
                                "text": "Mintz leek die halve eeuw vooral aan zijn snelheid te hebben gewerkt. Zuiverheid en communicatie moesten het veelal ontgelden en vooral zijn toon: hele passages verwerden tot een supersonisch gekras in alleen nog metronomisch exacte zestienden. Muzikale hoofd- en bijzaken werden soms haast karikaturaal van elkaar gescheiden: de hoofdnoten met een volle klank, de rest ondergedompeld in de mist."
                            },
                            {
                                "example_id": "87e08e58-cc43-4a83-bcf2-ae119d02cc97",
                                "sense_id": "dfe39212-f193-30e7-89d7-333052cdd55d",
                                "text": "Mooi is de passage over de muzikale terminologie van de parfumeur (hoofdnoten, hartnoten en basisnoten), die aan zijn ‘geurorgel’ (een bureau met verdiepingen vol notenmateriaal) zijn reukwerken componeert."
                            }
                        ]
                    }
