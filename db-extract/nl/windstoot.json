                                "target_senses": [
                                    {
                                        "sense_id": "8c54bd2e-7b45-35ce-9947-0707cd1b01fd",
                                        "entry_id": "23449cc1-3d8e-3601-b5f8-7e135f78a72c",
                                        "glosses": [
                                            "A sudden, strong current of wind; flaw."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95d1cb62-1f53-41b7-a5e3-f54a1dcbb880",
                                                "sense_id": "8c54bd2e-7b45-35ce-9947-0707cd1b01fd",
                                                "text": "The front of the wind on the water was a solid, sharply defined strip of dark-coloured, wind-vexed water. In advance of this strip, like skirmishers, were flashes of windflaws."
                                            },
                                            {
                                                "example_id": "1f54d62c-8788-4a10-bc72-a8229050def4",
                                                "sense_id": "8c54bd2e-7b45-35ce-9947-0707cd1b01fd",
                                                "text": "The smoke seemed to cover them all halfway to the house, but then it twisted away on a windflaw and lifted like a stage curtain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
