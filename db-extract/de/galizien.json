                                        "sense_id": "0b613af1-af51-3e8d-9726-99acb73e3e6e",
                                        "entry_id": "ab6aa716-9be8-39dc-8686-9b60324038a7",
                                        "glosses": [
                                            "A former kingdom and autonomous community in northwestern Spain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63f2ec44-338e-4464-b1e7-1155b991101a",
                                                "sense_id": "0b613af1-af51-3e8d-9726-99acb73e3e6e",
                                                "text": "There is sometimes a further subdivision of the Old Portuguese period into a Galician-Portuguese period (origins to 1350), during which the linguistic and cultural unity of Galicia and Portugal remained strong, and the Old Portuguese period proper (1350–1540)."
                                            }
                                        ]
