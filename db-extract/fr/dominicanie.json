                        "examples": [
                            {
                                "example_id": "2d0dc878-1454-4213-8eb1-af8f7c6cf4f6",
                                "sense_id": "227e5681-f206-39e4-ada2-7669679ff713",
                                "text": "Erzulie, la madame de Saint-Julien, répète qu’ils vont passer la frontière du côté de Grand-Bois pour essayer de trouver du travail en Dominicanie."
                            },
                            {
                                "example_id": "36676cb4-b509-4471-aef7-e3f74ac4657c",
                                "sense_id": "227e5681-f206-39e4-ada2-7669679ff713",
                                "text": "La plus communément admise étant que le microfundisme haïtien et l’économie fermée qui en est le corollaire seraient une manifestation des origines africaines du peuple haïtien, tandis que le latifundisme et l’économie d’échange qui prévalent en Dominicanie seraient le reflet de l’héritage hispanique maintenu plus vivace de ce côte-ci de la frontière."
                            },
                            {
                                "example_id": "118a39e7-84ad-479c-bb96-700ae323d931",
                                "sense_id": "227e5681-f206-39e4-ada2-7669679ff713",
                                "text": "Le comité directeur binational Haiti/Dominicanie dans le cadre du projet du bassin versant du fleuve Artibonite a tenu sa première réunion ce jeudi 10 novembre, dans un hôtel en Haïti."
                            }
                        ]
                    }
