                        "examples": [
                            {
                                "example_id": "4d0321c7-b178-4ba1-92ec-69a6ee201f32",
                                "sense_id": "53e54030-3846-3d34-b9e5-11737d7113e0",
                                "text": "Het onderstel is voor alle Boxers gelijk. Omdat het voertuig in de toekomst niet alleen als ambulance, maar ook als rijdende commandopost kan worden gebruikt, bestaat het bovenstel uit een losse module die kan worden aangepast."
                            },
                            {
                                "example_id": "91572a1b-3c4f-4ec6-88c7-e7c20addb71d",
                                "sense_id": "53e54030-3846-3d34-b9e5-11737d7113e0",
                                "text": "Nu is de romp klaar en kon het schip te water worden gelaten. Alleen het bovenstel, met onder meer de masten en zeilen, ontbreekt nog. Naar verwachting is het schip in het voorjaar van 2020 klaar voor zijn eerste vaart."
                            }
                        ]
                    }
