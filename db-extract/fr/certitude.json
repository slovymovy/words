                                        "sense_id": "bf5226f8-d918-3621-b9ff-a2cb2cda7f00",
                                        "entry_id": "5200f87f-be25-3840-ac93-5596e4116187",
                                        "glosses": [
                                            "Seguridad plena de la verdad de una determinada proposición."
                                        ],
                                        "tags": [],
