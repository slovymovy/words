            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8e6ca56-b09d-3bcf-9934-ba1c88f65451",
                    "sense_definition": "Recevoir ou toucher une somme d'argent, un paiement ou un chèque.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commerçant va à la banque pour <w>encaisser</w> un chèque de son client."
                        },
                        {
                            "text": "Nous avons réussi à <w>encaisser</w> la totalité des loyers en retard ce matin."
                        }
                    ],
                    "synonyms": [
                        "toucher",
                        "percevoir",
                        "recouvrer"
                    ],
                    "antonyms": [
                        "décaisser"
                    ],
                    "common_phrases": [
                        "encaisser un chèque",
                        "encaisser de l'argent"
                    ]
                },
                {
                    "sense_id": "545d7932-f49b-353d-8363-c15bd7c2afde",
                    "sense_definition": "Recevoir et supporter un coup ou un choc physique sans tomber ni céder.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "choc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le boxeur a réussi à <w>encaisser</w> un coup puissant sans perdre l'équilibre."
                        },
                        {
                            "text": "Grâce à sa solide carrure, il <w>encaisse</w> les chocs répétés lors du match."
                        }
                    ],
                    "common_phrases": [
                        "encaisser un coup",
                        "encaisser le choc"
                    ]
                },
                {
                    "sense_id": "88b10274-1f81-3881-931c-d35d1857f775",
                    "sense_definition": "En sport, concéder ou recevoir un but ou des points face à l'adversaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre équipe de football vient d'<w>encaisser</w> un but dans les dernières minutes du match."
                        },
                        {
                            "text": "Le gardien n'a pas <w>encaissé</w> le moindre but durant tout le tournoi régional."
                        }
                    ],
                    "common_phrases": [
                        "encaisser un but"
                    ]
                },
                {
                    "sense_id": "e5fba05e-d979-326d-a4be-70b5e8cf00ed",
                    "sense_definition": "Supporter ou tolérer péniblement une situation difficile, des critiques ou une personne.",
