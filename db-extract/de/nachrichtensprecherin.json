                                    {
                                        "sense_id": "63f5edf9-9a95-3ac9-ae9e-e90b4134ab75",
                                        "entry_id": "b9c53f0b-175d-354e-9c98-0aed234d3b51",
                                        "glosses": [
                                            "One who delivers the news for broadcast on television, radio, etc; a newsreader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd97b28a-2bd3-4eb9-94cc-9fd790e1cd29",
                                                "sense_id": "63f5edf9-9a95-3ac9-ae9e-e90b4134ab75",
                                                "text": "Take Linda, a thirty-nine-year-old newscaster who relished her career but began to hear the alarm ringing on her biological clock."
                                            },
                                            {
                                                "example_id": "7dd59579-1837-40c7-97f8-9dd40a9bc2da",
                                                "sense_id": "63f5edf9-9a95-3ac9-ae9e-e90b4134ab75",
                                                "text": "Yet, a few US newscasters will go on the air at 6 pm or later and say, \"Moscow said tonight.[\"] ... A careful writer would make his script read, \"Moscow said today. ...\""
                                            },
                                            {
                                                "example_id": "162fb97d-9abf-4231-9681-9f5ed366045f",
                                                "sense_id": "63f5edf9-9a95-3ac9-ae9e-e90b4134ab75",
                                                "text": "It is still considered embarrassing if people in authority like teachers or newscasters “shrub.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
