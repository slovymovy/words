{
    "word_family": [
        "surely",
        "sureness",
        "assurance",
        "ensure",
        "insure",
        "reassure",
        "unsure"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f0762ddd-453a-3b6c-93f8-cbcc8c25ef97",
                    "sense_definition": "Having no doubt in one's own mind about something.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you <w>sure</w> that you turned off the oven before we left the house?",
                            "target_lang_translations": {
                                "ru": "Ты <w>уверен</w>, что выключил духовку перед тем, как мы вышли из дома?"
                            }
                        },
                        {
                            "text": "I am <w>pretty</w> <w>sure</w> that I left my keys on the kitchen table.",
                            "target_lang_translations": {
                                "ru": "Я почти <w>уверен</w>, что оставил ключи на кухонном столе."
                            }
                        }
                    ],
                    "synonyms": [
                        "certain",
                        "positive"
                    ],
                    "antonyms": [
                        "unsure",
                        "doubtful"
                    ],
                    "common_phrases": [
                        "pretty sure",
                        "make sure",
                        "not sure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие сомнений в чем-либо в собственном уме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уверенный",
                                "target_lang_sense_clarification": "убежденный в чем-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "869e0664-db06-3195-816a-3f11369759ce",
                    "sense_definition": "Used to tell someone to do something without fail.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>be</w> <w>sure</w> to lock the front door when you leave for work.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>обязательно</w> запри входную дверь, когда пойдешь на работу."
                            }
                        },
                        {
                            "text": "You must <w>be</w> <w>sure</w> to arrive at the station at least ten minutes early.",
                            "target_lang_translations": {
                                "ru": "Ты должен <w>непременно</w> прибыть на станцию как минимум на десять минут раньше."
                            }
                        }
                    ],
                    "synonyms": [
                        "certain"
                    ],
                    "common_phrases": [
                        "be sure to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы велеть кому-то сделать что-то в обязательном порядке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обязательно",
                                "target_lang_sense_clarification": "непременно сделать что-то"
                            },
                            {
                                "target_lang_word": "не забудь",
                                "target_lang_sense_clarification": "указание сделать что-то без сбоев"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b407ed3-fa87-33e2-b6da-1e73364c6252",
                    "sense_definition": "Reliable and certain to happen or succeed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reliability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investing in that company is a <w>sure</w> <w>thing</w> because they are growing so fast.",
                            "target_lang_translations": {
                                "ru": "Инвестиции в эту компанию — <w>верное</w> дело, потому что они так быстро растут."
                            }
                        },
                        {
                            "text": "The athlete had a <w>sure</w> grip on the trophy as he held it up.",
                            "target_lang_translations": {
                                "ru": "У атлета была <w>крепкая</w> хватка, когда он поднял трофей."
                            }
                        }
                    ],
                    "synonyms": [
                        "reliable",
                        "certain",
                        "failsafe"
                    ],
                    "antonyms": [
                        "unreliable",
                        "uncertain"
                    ],
                    "common_phrases": [
                        "sure thing",
                        "sure sign",
                        "sure way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надежный и гарантированно произошедший или успешный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верный",
                                "target_lang_sense_clarification": "гарантированный, надежный"
                            },
                            {
                                "target_lang_word": "надежный",
                                "target_lang_sense_clarification": "внушающий доверие, прочный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e587657-cc0a-3b11-a997-dbe1ea7e2681",
                    "sense_definition": "Free from danger or risk; safe and secure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reliability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Once we reach the castle walls, we will be <w>sure</w> from the enemy's arrows.",
                            "target_lang_translations": {
                                "ru": "Как только мы доберемся до стен замка, мы будем в <w>безопасности</w> от вражеских стрел."
                            }
                        },
                        {
                            "text": "The captain looked for a <w>sure</w> harbor to protect his ship from the storm.",
                            "target_lang_translations": {
                                "ru": "Капитан искал <w>надежную</w> гавань, чтобы защитить свой корабль от шторма."
                            }
                        }
                    ],
                    "synonyms": [
                        "certain"
                    ],
                    "antonyms": [
                        "unsafe"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is mostly found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободный от опасности или риска; безопасный и защищенный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безопасный",
                                "target_lang_sense_clarification": "защищенный от угроз"
                            },
                            {
                                "target_lang_word": "надежный",
                                "target_lang_sense_clarification": "обеспечивающий защиту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a6e66be-9b41-3fdb-a0e2-234cb66ea1e4",
                    "sense_definition": "Legally or formally promised in marriage to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old story, the knight was <w>sure</w> to the lady before he went to war.",
                            "target_lang_translations": {
                                "ru": "В старой сказке рыцарь был <w>обручен</w> с дамой перед тем, как отправиться на войну."
                            }
                        },
                        {
                            "text": "They were <w>sure</w> to each other by a solemn vow made in the church.",
                            "target_lang_translations": {
                                "ru": "Они были <w>обещаны</w> друг другу торжественной клятвой, данной в церкви."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical contexts for betrothal."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридически или формально обещанный в браке кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрученный",
                                "target_lang_sense_clarification": "связанный обещанием брака"
                            },
                            {
                                "target_lang_word": "помолвленный",
                                "target_lang_sense_clarification": "давший обет жениться/выйти замуж"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "ed0f5469-8514-3714-8dbd-03dd02eeff4c",
                    "sense_definition": "Used to express agreement or to say yes to a request.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you help me carry these bags? <w>Sure</w>, I would be happy to help.",
                            "target_lang_translations": {
                                "ru": "Поможешь мне донести эти сумки? <w>Конечно</w>, я буду рад помочь."
                            }
                        },
                        {
                            "text": "Do you want to go to the park later? <w>Sure</w>, that sounds like fun.",
                            "target_lang_translations": {
                                "ru": "Хочешь пойти в парк позже? <w>Конечно</w>, звучит заманчиво."
                            }
                        }
                    ],
                    "synonyms": [
                        "yes",
                        "of course"
                    ],
                    "antonyms": [
                        "no"
                    ],
                    "common_phrases": [
                        "sure thing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения согласия или ответа «да» на просьбу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конечно",
                                "target_lang_sense_clarification": "выражение согласия"
                            },
                            {
                                "target_lang_word": "само собой",
                                "target_lang_sense_clarification": "разумеется"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "255f7bb7-61c7-3c4c-9add-16704b99a8bc",
                    "sense_definition": "A polite way to respond when someone thanks you.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "politeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thank you for the ride home. <w>Sure</w>, it was no trouble at all.",
                            "target_lang_translations": {
                                "ru": "Спасибо, что подвезли до дома. <w>Не за что</w>, это было совсем не трудно."
                            }
                        },
                        {
                            "text": "Thanks for the advice. <w>Sure</w>, any time you need help just ask.",
                            "target_lang_translations": {
                                "ru": "Спасибо за совет. <w>Пустяки</w>, обращайся в любое время, когда понадобится помощь."
                            }
                        }
                    ],
                    "synonyms": [
                        "of course"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in casual conversation."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливый способ ответить на чью-то благодарность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не за что",
                                "target_lang_sense_clarification": "вежливый ответ на благодарность"
                            },
                            {
                                "target_lang_word": "пустяки",
                                "target_lang_sense_clarification": "ответ, что услуга была не в тягость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d75770f7-6efa-3fcb-a072-ef660ab24d8d",
                    "sense_definition": "A weak or noncommittal way of saying yes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you like the new wallpaper? <w>Sure</w>, it is okay I guess.",
                            "target_lang_translations": {
                                "ru": "Тебе нравятся новые обои? <w>Ну да</w>, вроде ничего."
                            }
                        },
                        {
                            "text": "Is this the right way to the museum? <w>Sure</w>, I think so.",
                            "target_lang_translations": {
                                "ru": "Это правильная дорога к музею? <w>Наверное</w>, я так думаю."
                            }
                        }
                    ],
                    "synonyms": [
                        "OK",
                        "yes"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used when the speaker is not very enthusiastic."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабый или ни к чему не обязывающий способ сказать «да»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ну да",
                                "target_lang_sense_clarification": "неуверенное согласие"
                            },
                            {
                                "target_lang_word": "наверное",
                                "target_lang_sense_clarification": "выражение сомнения при согласии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0d2f8e1d-28ea-3179-8bed-9c1e7af01e5d",
                    "sense_definition": "Used for emphasis to mean certainly or definitely.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>sure</w> <w>is</w> <w>cold</w> outside today so you should wear a coat.",
                            "target_lang_translations": {
                                "ru": "На улице сегодня <w>точно</w> холодно, так что тебе стоит надеть пальто."
                            }
                        },
                        {
                            "text": "I <w>sure</w> hope that we can visit the beach during our summer vacation.",
                            "target_lang_translations": {
                                "ru": "Я <w>очень</w> надеюсь, что мы сможем побывать на пляже во время летнего отпуска."
                            }
                        }
                    ],
                    "synonyms": [
                        "certain",
                        "certain"
                    ],
                    "common_phrases": [
                        "sure is cold",
                        "sure did"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Very common in North American English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления значения «конечно» или «определенно»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точно",
                                "target_lang_sense_clarification": "для усиления утверждения"
                            },
                            {
                                "target_lang_word": "определенно",
                                "target_lang_sense_clarification": "подчеркивание уверенности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5222e17c-bfce-33a0-8d56-faf6d10537c3",
                    "sense_definition": "In a way that is certain to happen; without fail.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrow flew straight and hit the target as <w>sure</w> as anything.",
                            "target_lang_translations": {
                                "ru": "Стрела полетела прямо и попала в цель так <w>верно</w>, как только возможно."
                            }
                        },
                        {
                            "text": "He knew that the consequences would follow as <w>sure</w> as the night follows day.",
                            "target_lang_translations": {
                                "ru": "Он знал, что последствия последуют так же <w>неизбежно</w>, как ночь следует за днем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "as sure as"
                    ],
                    "target_lang_definitions": {
                        "ru": "Так, что это обязательно произойдет; без сбоев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верно",
                                "target_lang_sense_clarification": "неизбежно, точно"
                            },
                            {
                                "target_lang_word": "неминуемо",
                                "target_lang_sense_clarification": "обязательно случится"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}