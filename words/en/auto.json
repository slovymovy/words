    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5ae0428-5994-3de2-93ea-dfc009df8545",
                    "sense_definition": "A short form of <w>automobile</w>; a passenger vehicle designed for operation on ordinary roads.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vehicle_generic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <auto> industry has seen significant technological changes in recent years.",
                            "target_lang_translations": {
                                "ru": "<w>Автомобильная</w> промышленность претерпела значительные технологические изменения в последние годы.",
                                "de": "Die <w>Automobil</w>industrie hat in den letzten Jahren erhebliche technologische Veränderungen erlebt."
                            }
                        },
                        {
                            "text": "He works as an <auto> mechanic at a local garage.",
                            "target_lang_translations": {
                                "ru": "Он работает <w>авто</w>механиком в местной мастерской.",
                                "de": "Er arbeitet als <w>Kfz-</w>Mechaniker in einer örtlichen Werkstatt."
                            }
                        }
                    ],
                    "synonyms": [
                        "car",
                        "automobile",
                        "motorcar",
                        "vehicle"
                    ],
                    "common_phrases": [
                        "auto industry",
                        "auto mechanic",
                        "auto parts",
                        "auto repair"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping of automobile"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"автомобиль\"; пассажирское транспортное средство.",
                        "de": "Kurzform für Automobil; ein Personenkraftwagen für normale Straßen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автомобиль",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "авто",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Auto",
                                "target_lang_sense_clarification": "Personenkraftwagen"
                            },
                            {
                                "target_lang_word": "Automobil",
                                "target_lang_sense_clarification": "formeller Begriff"
                            },
                            {
                                "target_lang_word": "Wagen",
                                "target_lang_sense_clarification": "umgangssprachlich / allgemein"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "778b0655-5a72-34a2-b5a7-26d75ca63d6f",
                    "sense_definition": "A function or setting that allows a device to operate without manual control.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanism_mode",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually keep the camera flash on <auto> so it decides when light is needed.",
                            "target_lang_translations": {
                                "ru": "Я обычно держу вспышку камеры на <w>авто</w>, чтобы она сама решала, когда нужен свет.",
                                "de": "Normalerweise lasse ich den Kamerablitz auf <w>Automatik</w>, damit er selbst entscheidet, wann Licht benötigt wird."
                            }
                        },
                        {
                            "text": "Switch the thermostat to <auto> to maintain a constant temperature.",
                            "target_lang_translations": {
                                "ru": "Переключите термостат на <w>авто</w>, чтобы поддерживать постоянную температуру.",
                                "de": "Schalten Sie das Thermostat auf <w>Automatik</w>, um eine konstante Temperatur zu halten."
                            }
                        }
                    ],
                    "synonyms": [
                        "automatic"
                    ],
                    "antonyms": [
                        "manual"
                    ],
                    "common_phrases": [
                        "on auto",
                        "auto mode",
                        "set to auto"
                    ],
                    "target_lang_definitions": {
                        "ru": "Режим или настройка, позволяющая устройству работать без ручного управления.",
                        "de": "Eine Funktion oder Einstellung, die ein Gerät ohne manuelle Steuerung arbeiten lässt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "авто",
                                "target_lang_sense_clarification": "режим работы"
                            },
                            {
                                "target_lang_word": "автоматический режим",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Automatik",
                                "target_lang_sense_clarification": "automatischer Betriebsmodus"
                            },
                            {
                                "target_lang_word": "Automatikmodus",
                                "target_lang_sense_clarification": "Einstellung an Geräten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c11ebed-9a90-378a-be24-ad6a039039a6",
                    "sense_definition": "A car equipped with an <w>automatic</w> gearbox or transmission.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle_specific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I find it much easier to drive an <auto> in heavy city traffic.",
                            "target_lang_translations": {
                                "ru": "Мне гораздо легче водить <w>автомат</w> в плотном городском потоке.",
                                "de": "Ich finde es viel einfacher, im dichten Stadtverkehr einen <w>Automatikwagen</w> zu fahren."
                            }
                        },
                        {
                            "text": "She decided to rent an <auto> for the road trip instead of a manual car.",
                            "target_lang_translations": {
                                "ru": "Она решила арендовать <w>автомат</w> для поездки вместо машины с механикой.",
                                "de": "Sie beschloss, für den Roadtrip ein <w>Automatikauto</w> statt eines Wagens mit Schaltgetriebe zu mieten."
                            }
                        }
                    ],
                    "synonyms": [
                        "automatic"
                    ],
                    "antonyms": [
                        "manual"
                    ],
                    "common_phrases": [
                        "drive an auto",
                        "rent an auto"
                    ],
                    "target_lang_definitions": {
                        "ru": "Автомобиль с автоматической коробкой передач.",
                        "de": "Ein Auto mit Automatikgetriebe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автомат",
                                "target_lang_sense_clarification": "разговорное, о машине с АКПП"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Automatikwagen",
                                "target_lang_sense_clarification": "Fahrzeug mit Automatikgetriebe"
                            },
                            {
                                "target_lang_word": "Automatikauto",
                                "target_lang_sense_clarification": "umgangssprachlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3de5422-b32c-39c2-8692-e2ea8342b9f9",
                    "sense_definition": "An autorickshaw; a small three-wheeled motorized vehicle used for public hire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle_specific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hailed an <auto> to get to the market quickly through the narrow streets.",
                            "target_lang_translations": {
                                "ru": "Мы поймали <w>моторикшу</w>, чтобы быстро добраться до рынка по узким улочкам.",
                                "de": "Wir winkten eine <w>Autorikscha</w> heran, um durch die engen Gassen schnell zum Markt zu gelangen."
                            }
                        },
                        {
                            "text": "The <auto> driver knew exactly where the hotel was located.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>моторикши</w> точно знал, где находится отель.",
                                "de": "Der <w>Autorikscha</w>-Fahrer wusste genau, wo sich das Hotel befand."
                            }
                        }
                    ],
                    "common_phrases": [
                        "take an auto",
                        "auto driver"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South Asia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Моторикша; небольшой трехколесный транспорт.",
                        "de": "Eine Autorikscha; ein kleines dreirädriges motorisiertes Beförderungsmittel (besonders in Südasien)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моторикша",
                                "target_lang_sense_clarification": "транспортное средство"
                            },
                            {
                                "target_lang_word": "тук-тук",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Autorikscha",
                                "target_lang_sense_clarification": "dreirädriges Kraftfahrzeug"
                            },
                            {
                                "target_lang_word": "Tuk-Tuk",
                                "target_lang_sense_clarification": "umgangssprachliche Bezeichnung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cc9bd0be-8db0-3a4e-9048-9fdf55c5b54c",
                    "sense_definition": "Short for <w>automatic</w>; relating to a transmission system that changes gears without driver intervention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanism_mode",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought an <auto> sedan because he dislikes shifting gears manually.",
                            "target_lang_translations": {
                                "ru": "Он купил седан с <w>автоматом</w>, так как не любит переключать передачи вручную.",
                                "de": "Er kaufte eine <w>Automatik</w>-Limousine, weil er ungern manuell schaltet."
                            }
                        },
                        {
                            "text": "The new model features an <auto> transmission for smoother driving.",
                            "target_lang_translations": {
                                "ru": "Новая модель оснащена <w>автоматической</w> трансмиссией для более плавной езды.",
                                "de": "Das neue Modell verfügt über ein <w>Automatik</w>getriebe für ein sanfteres Fahrgefühl."
                            }
                        }
                    ],
                    "synonyms": [
                        "automatic"
                    ],
                    "antonyms": [
                        "manual"
                    ],
                    "common_phrases": [
                        "auto transmission",
                        "auto shift"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping of automatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к автоматической трансмиссии.",
                        "de": "Kurzform für automatisch; bezogen auf ein Getriebe, das Gänge selbstständig wechselt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автоматический",
                                "target_lang_sense_clarification": "о коробке передач"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Automatik-",
                                "target_lang_sense_clarification": "in Zusammensetzungen"
                            },
                            {
                                "target_lang_word": "automatisch",
                                "target_lang_sense_clarification": "Adjektiv"
                            }
                        ]
                    }
                }
            ]
        },
        {
