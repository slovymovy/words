{
    "word_family": [
        "abbot",
        "abbess",
        "abbatial"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4891384e-c719-3bbb-be3b-d391d56b808e",
                    "sense_definition": "A monastery or society of people secluded from the world and devoted to religion, headed by an abbot or abbess; also, the buildings themselves.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "monastic_institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From 1199 to 1203 William Punchard was the abbot of the <w>abbey</w> of Rievaulx, which was part of the Cistercian order of monks.",
                            "target_lang_translations": {
                                "ru": "С 1199 по 1203 год Уильям Панчард был настоятелем <w>аббатства</w> Риво, которое принадлежало к цистерцианскому ордену монахов."
                            }
                        },
                        {
                            "text": "The ancient <w>abbey</w> ruins attract many tourists who are interested in medieval religious history.",
                            "target_lang_translations": {
                                "ru": "Руины древнего <w>аббатства</w> привлекают множество туристов, интересующихся средневековой религиозной историей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ancient abbey",
                        "abbey ruins",
                        "benedictine abbey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Монастырь или община людей, живущих в уединении от мира и посвятивших себя религии, возглавляемая аббатом или аббатисой; также сами здания монастыря."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аббатство",
                                "target_lang_sense_clarification": "католический монастырь"
                            },
                            {
                                "target_lang_word": "монастырь",
                                "target_lang_sense_clarification": "религиозная община и здания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d8c1456-83eb-3bba-ab52-847959270aa9",
                    "sense_definition": "The church belonging to a monastery.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "monastic_institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monks gathered in the <w>abbey</w> for their morning prayers and hymns.",
                            "target_lang_translations": {
                                "ru": "Монахи собрались в <w>монастырской церкви</w> для утренних молитв и гимнов."
                            }
                        },
                        {
                            "text": "The architecture of the <w>abbey</w> church is a masterpiece of Gothic design.",
                            "target_lang_translations": {
                                "ru": "Архитектура церкви <w>аббатства</w> является шедевром готического стиля."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Церковь, принадлежащая монастырю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "монастырская церковь",
                                "target_lang_sense_clarification": "храм при монастыре"
                            },
                            {
                                "target_lang_word": "собор аббатства",
                                "target_lang_sense_clarification": "главный храм монастыря"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e200e0b1-b9e5-3e6e-9c1d-9597c7f33a76",
                    "sense_definition": "A residence or large house that was previously a monastic building.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "monastic_institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family converted the old <w>abbey</w> into a luxury hotel while preserving its historic character.",
                            "target_lang_translations": {
                                "ru": "Семья превратила старое <w>аббатство</w> в роскошный отель, сохранив при этом его исторический облик."
                            }
                        },
                        {
                            "text": "They live in a beautiful <w>abbey</w> that has been in their family for generations.",
                            "target_lang_translations": {
                                "ru": "Они живут в прекрасном <w>аббатстве</w>, которое принадлежало их семье на протяжении нескольких поколений."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Резиденция или большой дом, который ранее был монастырским зданием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аббатство",
                                "target_lang_sense_clarification": "историческое здание, ставшее жилым домом"
                            },
                            {
                                "target_lang_word": "бывший монастырь",
                                "target_lang_sense_clarification": "здание с монашеским прошлым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "269ea492-c13a-3409-ba39-22a86281d6f8",
                    "sense_definition": "The office, jurisdiction, or dominion of an abbot or abbess.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "monastic_institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rights and privileges of the <w>abbey</w> were granted by the king himself.",
                            "target_lang_translations": {
                                "ru": "Права и привилегии <w>аббатства</w> были дарованы самим королем."
                            }
                        },
                        {
                            "text": "He was appointed to the <w>abbey</w> after years of service to the church.",
                            "target_lang_translations": {
                                "ru": "Он был назначен на должность в <w>аббатстве</w> после многих лет служения церкви."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Должность, юрисдикция или владения аббата или аббатисы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аббатство",
                                "target_lang_sense_clarification": "звание или юрисдикция аббата"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "148047ea-f946-33bb-ad4d-4016e7c1d762",
                    "sense_definition": "A diminutive of the female given name <w>Abigail</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "personal_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Everyone in the class calls her <w>Abbey</w> instead of her full name.",
                            "target_lang_translations": {
                                "ru": "Все в классе зовут её <w>Эбби</w> вместо полного имени."
                            }
                        },
                        {
                            "text": "My friend <w>Abbey</w> is coming over for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Эбби</w> придет сегодня к нам на ужин."
                            }
                        }
                    ],
                    "synonyms": [
                        "Abi",
                        "Abby"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма женского имени Абигейл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эбби",
                                "target_lang_sense_clarification": "уменьшительное имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7cc499e-5315-3f3f-9821-e0d72af65007",
                    "sense_definition": "A common short name for Westminster Abbey in London.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "specific_places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The royal wedding took place at the <w>Abbey</w> in front of hundreds of guests.",
                            "target_lang_translations": {
                                "ru": "Королевская свадьба состоялась в <w>Аббатстве</w> в присутствии сотен гостей."
                            }
                        },
                        {
                            "text": "Many famous poets and kings are buried within the walls of the <w>Abbey</w>.",
                            "target_lang_translations": {
                                "ru": "Многие знаменитые поэты и короли похоронены в стенах <w>Аббатства</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенное краткое название Вестминстерского аббатства в Лондоне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Аббатство",
                                "target_lang_sense_clarification": "Вестминстерское аббатство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16a7f229-ea8e-3625-a82c-f8b6bcb0c02a",
                    "sense_definition": "A British surname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personal_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author Edward <w>Abbey</w> is well known for his books about the American West.",
                            "target_lang_translations": {
                                "ru": "Писатель Эдвард <w>Эбби</w> хорошо известен своими книгами об американском Западе."
                            }
                        },
                        {
                            "text": "We need to contact Mr. <w>Abbey</w> regarding the legal documents.",
                            "target_lang_translations": {
                                "ru": "Нам нужно связаться с мистером <w>Эбби</w> по поводу юридических документов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "British origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Британская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эбби",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f43442c3-daec-355d-bcba-fc0614f7d5d5",
                    "sense_definition": "A diminutive of the male given name <w>Albert</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personal_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "In some old records, he is referred to by the nickname <w>Abbey</w>.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых записях он упоминается под прозвищем <w>Эбби</w>."
                            }
                        },
                        {
                            "text": "His grandfather was named Albert, but everyone called him <w>Abbey</w>.",
                            "target_lang_translations": {
                                "ru": "Его дедушку звали Альберт, но все называли его <w>Эбби</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used for Albert today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма мужского имени Альберт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эбби",
                                "target_lang_sense_clarification": "устаревшее уменьшительное от Альберт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f262a1d-f854-3927-81cc-f273b27481eb",
                    "sense_definition": "A hamlet in Devon, England, or other small settlements named after local abbeys.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "specific_places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small hamlet of <w>Abbey</w> is located within the parish of Dunkeswell.",
                            "target_lang_translations": {
                                "ru": "Маленькая деревушка <w>Эбби</w> расположена в приходе Данкесвелл."
                            }
                        },
                        {
                            "text": "They decided to hike through the countryside near <w>Abbey</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили отправиться в поход по сельской местности недалеко от <w>Эбби</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в Девоне, Англия, или другие небольшие поселения, названные в честь местных аббатств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эбби",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}