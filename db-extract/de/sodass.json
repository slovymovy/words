                        "source_sense_id": "1d61257d-4234-3bfa-ab6a-ddfa6bd00607",
                        "source_sense_description": "konsekutive Subjunktion, welche die Folge aus einer bekannten Tatsache einführt",
                        "target_lang_word": "так что",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "так что",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "30f2f7df-9364-36e9-8961-d8c2077c1a90",
                                        "entry_id": "6cff2714-1ba6-3e29-82a5-773bfed2d768",
                                        "glosses": [
                                            "так, таким образом, следовательно, поэтому"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c6b8b5-dd54-45bd-8863-a55799c91b5f",
                                                "sense_id": "30f2f7df-9364-36e9-8961-d8c2077c1a90",
                                                "text": "Он меня хватает поперёк зубов, так что рот не открыть."
                                            },
                                            {
                                                "example_id": "e8c44084-a4e6-4327-af2c-4147697e35fa",
                                                "sense_id": "30f2f7df-9364-36e9-8961-d8c2077c1a90",
                                                "text": "Так что давай отложим серьёзный разговор…"
                                            },
                                            {
                                                "example_id": "a3acd4fc-5921-41ac-a162-aef1f612e62f",
                                                "sense_id": "30f2f7df-9364-36e9-8961-d8c2077c1a90",
                                                "text": "Так что перед нами стоит задача защитить не просто вашу, Валя, теорию ревертазы, но судьбу всей нашей планетной биологии вообще…"
                                            },
                                            {
                                                "example_id": "328dece0-1b9c-493b-bacf-f1f68886c5da",
                                                "sense_id": "30f2f7df-9364-36e9-8961-d8c2077c1a90",
                                                "text": "Все его нутро наладилось на какое-то другое существование, похожее на смерть, так что он даже не думал об отрубленной стопе, культя которой, как ни странно, даже не болела."
                                            }
                                        ]
                                    }
                                ]
                            }
