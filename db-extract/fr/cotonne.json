                        "sense_id": "4bcf32ac-9190-3fe2-9db1-73299d62cedf",
                        "entry_id": "444e7813-9ede-3550-9ec9-7c396a7edc6e",
                        "glosses": [
                            "Tissus en coton actuellement nommé vichy."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "44c1a057-fe43-4ad2-bf44-70c127da2605",
                                "sense_id": "4bcf32ac-9190-3fe2-9db1-73299d62cedf",
                                "text": "Un tour-de -lit en cotonne, et son cadre , deux grands rideaux indienne et autres objets."
                            },
                            {
                                "example_id": "4c820729-cfe9-4c64-aa67-3d84102f95b4",
                                "sense_id": "4bcf32ac-9190-3fe2-9db1-73299d62cedf",
                                "text": "… les quatre rideaux, le ciel, la tapisserie et la portière étant aussi en cotonne."
                            },
                            {
                                "example_id": "ad3277a3-2981-4c90-9cf5-e07152d40fc0",
                                "sense_id": "4bcf32ac-9190-3fe2-9db1-73299d62cedf",
                                "text": "Roanne deviendra LE pôle national de production de cotonne après l’annexion de l’Alsace et de la Lorraine par l’Allemagne en 1870, jusqu’alors premier producteur de cette matière !"
                            },
                            {
                                "example_id": "da5f8e7e-95df-4eb3-a875-ec835396a7db",
                                "sense_id": "4bcf32ac-9190-3fe2-9db1-73299d62cedf",
                                "text": "Les fabriques se multiplient bientôt, en se spécialisant dans un article qui va faire la prospérité de la ville : le vichy , encore appelé \" cotonne \" par les tisseurs."
                            }
                        ]
                    }
