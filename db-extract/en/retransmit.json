                ],
                "senses": [
                    {
                        "sense_id": "dd62326f-58cf-365b-8ec4-25504e5a5a7f",
                        "entry_id": "336369c9-6637-3369-8b2f-f0e9b19e4518",
                        "glosses": [
                            "To transmit again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "981fc735-9564-4895-9b5c-349e66b8defb",
                                "sense_id": "dd62326f-58cf-365b-8ec4-25504e5a5a7f",
                                "text": "The repeater retransmits the messages it receives."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d968457a-0485-4829-8d9c-b1b54322c8ef",
                        "source_entry_id": "336369c9-6637-3369-8b2f-f0e9b19e4518",
                        "source_sense_id": "dd62326f-58cf-365b-8ec4-25504e5a5a7f",
                        "source_sense_description": "to transmit again",
                        "target_lang_word": "retransmettre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retransmettre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a73ec96a-7e2d-3d32-9296-fa59f4e4486d",
                                        "entry_id": "632622f0-8693-3df2-98d3-f513a510dd10",
                                        "glosses": [
                                            "Transmettre dans le cas d’une émission radiophonique ou télévisuelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72508e0b-2188-4b8e-bd32-80a611b7b6af",
                                                "sense_id": "a73ec96a-7e2d-3d32-9296-fa59f4e4486d",
                                                "text": "En fin d’après-midi, sortant de mon cinéma, j’ai entendu une radio retransmettre la conférence de Mitterrand, elle m’a paru dérisoire."
                                            },
                                            {
                                                "example_id": "2d2af0ca-454c-4f69-bc6e-75860e2494be",
                                                "sense_id": "a73ec96a-7e2d-3d32-9296-fa59f4e4486d",
                                                "text": "Sur les écrans plats, un match de foot est retransmis par la chaîne Eurosport. Estelle déteste le sport à la télé mais elle ne peut rien contre le phénomène des écrans plats qui grignotent chaque jour un peu plus les espaces publics."
                                            },
                                            {
                                                "example_id": "ca147785-b843-49be-abe0-f79e7f6fe0b2",
                                                "sense_id": "a73ec96a-7e2d-3d32-9296-fa59f4e4486d",
                                                "text": "À 23 h 35, depuis l’East Room de la Maison Blanche, le président fait une déclaration télévisée qui sera retransmise dans le monde entier. Son ton est grave, déterminé, et ne laisse poindre aucun signe de fierté ou de fanfaronnade:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72a52a70-62b9-3bed-8a2a-0252e0497f6f",
                                        "entry_id": "632622f0-8693-3df2-98d3-f513a510dd10",
                                        "glosses": [
                                            "Transmettre à nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3da064f5-c84f-4258-8f43-fb35cf6f2e6d",
                                                "sense_id": "72a52a70-62b9-3bed-8a2a-0252e0497f6f",
                                                "text": "L’apprentissage technique consiste donc à retransmettre de manière synthétique ou à travers principes et exemples toutes les techniques élaborées par les pratiquants précédents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad36ed65-622e-45a2-accf-f56eb550894a",
                        "source_entry_id": "336369c9-6637-3369-8b2f-f0e9b19e4518",
                        "source_sense_id": "dd62326f-58cf-365b-8ec4-25504e5a5a7f",
                        "source_sense_description": "to transmit again",
                        "target_lang_word": "renvoyer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renvoyer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8acf33e-3bc8-3eb2-8048-2a7e18fea2d2",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Envoyer à nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c2e110-157a-4920-a304-c7c1ca12c02e",
                                                "sense_id": "d8acf33e-3bc8-3eb2-8048-2a7e18fea2d2",
                                                "text": "De là, on le renvoya aider à l’emmagasinage des bombes dans les soutes du Zeppelin, — besogne qui exigeait un soin minutieux."
                                            },
                                            {
                                                "example_id": "76d58e7e-1cce-49c9-bf83-2915dc182d9f",
                                                "sense_id": "d8acf33e-3bc8-3eb2-8048-2a7e18fea2d2",
                                                "text": "Je lui avais envoyé une lettre à une mauvaise adresse elle m’est revenue, je la lui renvoie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33bee4fe-4aca-37d1-b3ac-c7fc1db39327",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Faire reporter à une personne une chose qu’elle avait envoyée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ebaa268-191d-41eb-be32-5d78f0466db9",
                                                "sense_id": "33bee4fe-4aca-37d1-b3ac-c7fc1db39327",
                                                "text": "Un va-et-vient fut envoyé aux deux hommes ; ils reçurent par son intermédiaire, marteaux, masses et ciseaux, ainsi que des sacs de toile qu'ils renvoyaient dès qu'il étaient remplis d'échantillons […]."
                                            },
                                            {
                                                "example_id": "eedc3edd-c205-4a6b-a66d-ae0c14ac9115",
                                                "sense_id": "33bee4fe-4aca-37d1-b3ac-c7fc1db39327",
                                                "text": "On lui avait envoyé un présent, il l’a renvoyé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663a4d17-9d3d-330f-8578-6c12ea2bb2d2",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Faire reporter à une personne une chose qui lui appartient et qu’elle avait prêtée ou laissée par mégarde en quelque endroit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f9bd167-0e38-4551-97b9-d27a025e0e2e",
                                                "sense_id": "663a4d17-9d3d-330f-8578-6c12ea2bb2d2",
                                                "text": "Vous m’avez prêté ce livre, mais je suis sûr de vous l’avoir renvoyé."
                                            },
                                            {
                                                "example_id": "a9180e46-9454-48e7-b2cd-664edf8b8af1",
                                                "sense_id": "663a4d17-9d3d-330f-8578-6c12ea2bb2d2",
                                                "text": "J’ai trouvé la bague qu’elle avait perdue et je la lui ai renvoyée."
                                            },
                                            {
                                                "example_id": "08a3c568-4076-474b-9abd-58711b3e5030",
                                                "sense_id": "663a4d17-9d3d-330f-8578-6c12ea2bb2d2",
                                                "text": "Je lui ai renvoyé sa canne qu’il avait oubliée chez moi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a444cf2-3cd7-32bc-9791-9bdd9b390d54",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Faire retourner quelqu’un ou quelque chose au lieu d’où il était envoyé, d’où il était parti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d5e1524-5565-4c12-9694-731411ef1865",
                                                "sense_id": "5a444cf2-3cd7-32bc-9791-9bdd9b390d54",
                                                "text": "Je vous renvoie votre secrétaire avec les papiers que vous m’avez demandés."
                                            },
                                            {
                                                "example_id": "99bb4b6c-d505-4453-8808-a419f8cd63c4",
                                                "sense_id": "5a444cf2-3cd7-32bc-9791-9bdd9b390d54",
                                                "text": "Aussitôt arrivé il renvoya les personnes qui avaient tenu à l’accompagner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "985313e3-b162-34a2-9a51-fb3435776bfe",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Congédier quelqu’un, lui donner son congé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05b4289f-6f33-4bc2-af54-e1e0ca62a390",
                                                "sense_id": "985313e3-b162-34a2-9a51-fb3435776bfe",
                                                "text": "On a renvoyé une partie des employés."
                                            },
                                            {
                                                "example_id": "44b57630-c8b7-4f97-8258-63d8e9b33772",
                                                "sense_id": "985313e3-b162-34a2-9a51-fb3435776bfe",
                                                "text": "Le roi vient de renvoyer tous ses ministres."
                                            },
                                            {
                                                "example_id": "a35cc475-c93d-4a6d-b3b0-30757b52387a",
                                                "sense_id": "985313e3-b162-34a2-9a51-fb3435776bfe",
                                                "text": "Renvoyer un domestique dont on est mécontent."
                                            },
                                            {
                                                "example_id": "2bc802dc-49b6-4d2c-a2a3-876756ea2a27",
                                                "sense_id": "985313e3-b162-34a2-9a51-fb3435776bfe",
                                                "text": "Échappé comme par miracle à un grand danger, il fit vœu de quitter le monde et se retira à la Trappe. L'abbé de Rancé, sur lequel Chateaubriand a écrit son dernier livre, le renvoya, comme peu croyant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aca714cd-fc35-3cc7-b2db-b0b7b81ac787",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Adresser une personne à quelqu’un ou en quelque lieu, pour l’éclaircissement de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af96a0b3-f154-4245-b0be-147630e38a6a",
                                                "sense_id": "aca714cd-fc35-3cc7-b2db-b0b7b81ac787",
                                                "text": "Je lui ai demandé les raisons qui le déterminaient à prendre ce parti ; pour toute réponse, il m’a renvoyé à son avocat, à son conseil."
                                            },
                                            {
                                                "example_id": "1a397534-887f-4a8f-afc9-a695289a689f",
                                                "sense_id": "aca714cd-fc35-3cc7-b2db-b0b7b81ac787",
                                                "text": "Un auteur est souvent obligé de renvoyer son lecteur à ce qu’il a dit plus haut, aux livres qui ont traité expressément les matières dont il s’agit."
                                            },
                                            {
                                                "example_id": "65fac09e-59f3-4ea1-bea2-64cd6edc93ba",
                                                "sense_id": "aca714cd-fc35-3cc7-b2db-b0b7b81ac787",
                                                "text": "Ces chiffres, ces lettres renvoient le lecteur aux notes qui sont placées à la fin du volume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efe98967-b211-3f34-9007-041b62a033b4",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Transmettre, communiquer à ceux qui doivent les examiner, en parlant des demandes, des propositions, etc. ; y faire droit ou en rendre compte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a876ac-12bb-423c-9d79-899e16ca9e75",
                                                "sense_id": "efe98967-b211-3f34-9007-041b62a033b4",
                                                "text": "Votre demande a été renvoyée à telle personne."
                                            },
                                            {
                                                "example_id": "772993b9-f6d9-45a6-b1e1-fdd763eca3c7",
                                                "sense_id": "efe98967-b211-3f34-9007-041b62a033b4",
                                                "text": "La Chambre a renvoyé leur pétition au ministre de la guerre, à la commission du budget."
                                            },
                                            {
                                                "example_id": "0bc3b142-65a0-47bf-bc29-8bf150bd385d",
                                                "sense_id": "efe98967-b211-3f34-9007-041b62a033b4",
                                                "text": "Renvoyer un projet de loi, une proposition à l’examen des bureaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d0676e7-eac9-391e-9b74-707ab3142eb1",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Répercuter ; donner en retour."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "699f0a39-1418-4d80-bf65-4bfcd6f127c4",
                                                "sense_id": "9d0676e7-eac9-391e-9b74-707ab3142eb1",
                                                "text": "Sa chair épanouie, luxuriante, lui renvoyait une image maternelle, et cela bien que sa propre mère n'eût que la peau sur les os."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fa77f45-2183-3123-a25a-d476c7c0fc26",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Ordonner qu’une partie se pourvoira ou qu’un accusé sera traduit devant tel ou tel juge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fea0c32-13ee-4b15-b69a-f8e06cd7c809",
                                                "sense_id": "7fa77f45-2183-3123-a25a-d476c7c0fc26",
                                                "text": "De son vrai nom Yasmi Medjeber, le trentenaire est renvoyé devant la cour d’assises du Val-de-Marne pour viol commis par conjoint et violences aggravées par deux circonstances (usage d’une arme et faits commis par conjoint ayant entrainé une incapacité totale de travail de dix jours)."
                                            },
                                            {
                                                "example_id": "8c3c1657-efa6-4f16-9c30-7a150cf3f4cf",
                                                "sense_id": "7fa77f45-2183-3123-a25a-d476c7c0fc26",
                                                "text": "La Cour d’Appel a renvoyé l’affaire au tribunal compétent."
                                            },
                                            {
                                                "example_id": "05ec4ada-8ff1-4692-a320-149f1fcd4df0",
                                                "sense_id": "7fa77f45-2183-3123-a25a-d476c7c0fc26",
                                                "text": "Renvoyer les parties à se pourvoir : Se déclarer incompétent."
                                            },
                                            {
                                                "example_id": "f274bb49-5303-4ccc-9234-d01096303e27",
                                                "sense_id": "7fa77f45-2183-3123-a25a-d476c7c0fc26",
                                                "text": "Renvoyer un plaideur de sa demande : La lui refuser par un jugement."
                                            },
                                            {
                                                "example_id": "e9874c49-6ee2-4b61-a76e-924b1f45bf27",
                                                "sense_id": "7fa77f45-2183-3123-a25a-d476c7c0fc26",
                                                "text": "Renvoyer un accusé, le renvoyer absous, quitte et absous, le renvoyer d’accusation : Le décharger de l’accusation intentée contre lui."
                                            },
                                            {
                                                "example_id": "b55df96c-c213-4ce4-9f41-abfec1a5c920",
                                                "sense_id": "7fa77f45-2183-3123-a25a-d476c7c0fc26",
                                                "text": "Il a été renvoyé de la plainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "729723e1-e019-3967-b4d0-37c207880fa0",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Remettre à un autre temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "050b2889-412b-47b9-89fa-6dc8b0c5db2e",
                                                "sense_id": "729723e1-e019-3967-b4d0-37c207880fa0",
                                                "text": "Il m’a renvoyé à Noël pour mon paiement."
                                            },
                                            {
                                                "example_id": "3225cd5b-cd57-4e2b-b649-3f57e239362f",
                                                "sense_id": "729723e1-e019-3967-b4d0-37c207880fa0",
                                                "text": "Il ne faut pas renvoyer au lendemain ce qu’on peut faire le jour même."
                                            },
                                            {
                                                "example_id": "e976252d-5973-4ea8-a7d6-2a1ab6a81c6b",
                                                "sense_id": "729723e1-e019-3967-b4d0-37c207880fa0",
                                                "text": "On a renvoyé l’affaire à huitaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "232f53b9-317a-3827-907b-6aeb2120e84a",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Envoyer en sens contraire, relancer, réfléchir, répercuter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b4d828-9d56-4f76-9d52-5ac36cd8d9b4",
                                                "sense_id": "232f53b9-317a-3827-907b-6aeb2120e84a",
                                                "text": "Un joueur, un mur qui renvoie la balle."
                                            },
                                            {
                                                "example_id": "3a35d4ba-d675-416c-a42c-15664c9de312",
                                                "sense_id": "232f53b9-317a-3827-907b-6aeb2120e84a",
                                                "text": "La plaque d’une cheminée renvoie de la chaleur dans la chambre."
                                            },
                                            {
                                                "example_id": "fc8e6a2a-47bb-40fd-9aa5-27d0bfabdf5f",
                                                "sense_id": "232f53b9-317a-3827-907b-6aeb2120e84a",
                                                "text": "La lune renvoie la lumière du soleil."
                                            },
                                            {
                                                "example_id": "7303cfef-6d69-4373-a42c-6340896f6c0f",
                                                "sense_id": "232f53b9-317a-3827-907b-6aeb2120e84a",
                                                "text": "L’écho renvoie les sons, les paroles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cd2f6b7-b8ba-3516-a4af-bb3ef103fe50",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Vomir."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d7e95ce-8e7b-4aaf-a593-3618cadcd1ce",
                                                "sense_id": "3cd2f6b7-b8ba-3516-a4af-bb3ef103fe50",
                                                "text": "Il renvoya la choucroute sur le sofa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19785dd1-952c-3fe2-a80b-f4f4cc9e0c42",
                                        "entry_id": "264c796b-8065-30db-96b3-43bca5f23101",
                                        "glosses": [
                                            "Transmettre la sortie d'une commande à l'utilisateur, retourner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6337a2f-c31c-49a1-8680-20de8e41c97f",
