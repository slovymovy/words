                                "target_senses": [
                                    {
                                        "sense_id": "34b138ab-7b5d-3f2a-8e0b-40672e72e985",
                                        "entry_id": "1cdde63e-5eb0-3134-bd3f-c45e771086d5",
                                        "glosses": [
                                            "Beruf, der sich erwerbsmäßig mit dem Halten und Züchten von Schafen beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33161b39-6a2a-419c-b05a-253d6793f940",
                                                "sense_id": "34b138ab-7b5d-3f2a-8e0b-40672e72e985",
                                                "text": "Der Schäfer hütet mit Hilfe seiner Hunde die Schafe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5cf3aeb7-fe4d-351f-9acd-9f58f2b34082",
                                        "entry_id": "1cdde63e-5eb0-3134-bd3f-c45e771086d5",
                                        "glosses": [
                                            "Person, die dieser Tätigkeit nachgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ba0303-bb9a-4299-b35f-3a70f96588eb",
                                                "sense_id": "5cf3aeb7-fe4d-351f-9acd-9f58f2b34082",
                                                "text": "Der Schäfer hütet mit Hilfe seiner Hunde die Schafe."
                                            },
                                            {
                                                "example_id": "93c6c7f2-2209-4e90-b306-6f93f3207ec2",
                                                "sense_id": "5cf3aeb7-fe4d-351f-9acd-9f58f2b34082",
                                                "text": "„Wäre er doch Schäfer geblieben wie seine Vorfahren, dann wäre das alles nicht geschehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schäfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc14b1d-e19e-3ae4-a399-24f3dab50796",
                                        "entry_id": "b8f618e3-4ffb-3de7-a723-3c8b3b9f271c",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "250b7258-33a4-4077-9c0a-0653c661411e",
                                                "sense_id": "7fc14b1d-e19e-3ae4-a399-24f3dab50796",
                                                "text": "Frau Schäfer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "5b91168f-e257-42c4-963f-8f602f02e076",
                                                "sense_id": "7fc14b1d-e19e-3ae4-a399-24f3dab50796",
                                                "text": "Herr Schäfer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "8908ef87-560f-4241-bae3-cc2fc57161d0",
                                                "sense_id": "7fc14b1d-e19e-3ae4-a399-24f3dab50796",
                                                "text": "Die Schäfers fliegen heute nach Madrid."
                                            },
                                            {
                                                "example_id": "995906c6-de3f-4546-981a-1adaf89224bd",
                                                "sense_id": "7fc14b1d-e19e-3ae4-a399-24f3dab50796",
                                                "text": "Der Schäfer trägt nie die Pullover, die die Schäfer ihm strickt."
                                            },
                                            {
                                                "example_id": "2c5407fb-0e83-4cc7-8bfa-dc82e359b78c",
                                                "sense_id": "7fc14b1d-e19e-3ae4-a399-24f3dab50796",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schäfer kommt, geht der Herr Schäfer.“"
                                            },
                                            {
                                                "example_id": "2ab017bd-e83f-41cd-9325-1868020fad8e",
                                                "sense_id": "7fc14b1d-e19e-3ae4-a399-24f3dab50796",
                                                "text": "Schäfer kommt und geht."
                                            },
                                            {
                                                "example_id": "8ec98f88-f84e-467a-8abd-20420fd24ea1",
                                                "sense_id": "7fc14b1d-e19e-3ae4-a399-24f3dab50796",
                                                "text": "Schäfers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
