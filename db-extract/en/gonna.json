                                "sense_id": "b17671a8-e3d5-33b9-b15f-87aecd2c3f17",
                                "text": "He was gonna see him yesterday but he got sick.",
                                "translation": "Επρόκειτο να τον δει χθες αλλά αρρώστησε."
                            },
                            {
                                "example_id": "19eb66c2-001b-40e9-9e2d-65af1ceff16d",
                                "sense_id": "b17671a8-e3d5-33b9-b15f-87aecd2c3f17",
                                "text": "When are you gonna come visit me?",
                                "translation": "Πότε θα έρθεις να με επισκεφτείς;"
                            },
                            {
                                "example_id": "53236241-a18c-44d5-bd77-2a99bd816780",
                                "sense_id": "b17671a8-e3d5-33b9-b15f-87aecd2c3f17",
                                "text": "By the time you come, I am gonna have left.",
                                "translation": "Μέχρι την ώρα που έρθεις, θα έχω φύγει."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
