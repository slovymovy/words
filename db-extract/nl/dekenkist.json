                        "sense_id": "507a3d18-2a96-3fc9-8060-7e8c342b85a0",
                        "entry_id": "5538576c-5d30-3504-96b6-6f8a7a3bec55",
                        "glosses": [
                            "een kist met een scharnierende deksel waarin men dekens kan bewaren als men ze in de zomer niet nodig heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f548f31-7628-420b-b12d-8c0acc10c464",
                                "sense_id": "507a3d18-2a96-3fc9-8060-7e8c342b85a0",
                                "text": "Bewaart u extra dekens, kussens en dekbedden in een dekenkist, prop er dan niet te veel bij elkaar en zorg dat ze schoon en droog zijn voordat ze de kist in gaan. Motten zijn namelijk gek op vet en vlekken."
                            },
                            {
                                "example_id": "51120ef5-647c-4b37-a2b1-8f965e486996",
                                "sense_id": "507a3d18-2a96-3fc9-8060-7e8c342b85a0",
                                "text": "Cynthia (een rol van Sidse Babett Knudsen, bekend van de politieke dramaserie Borgen) is een vlinderexpert die haar student (Chiara D'Anna) domineert met vernederende spelletjes, zoals plasseks en het opsluiten in een dekenkist."
                            },
                            {
                                "example_id": "8ba495e4-a254-4e1e-9a91-e4449ffbd883",
                                "sense_id": "507a3d18-2a96-3fc9-8060-7e8c342b85a0",
                                "text": "\"We hebben we tal van meubels, als de glazen kast, het kabinet, de hutkoffer, een dekenkist, een staand horloge, maar ook bijvoorbeeld het servies in bruikleen gekregen."
                            }
                        ]
                    }
                ],
