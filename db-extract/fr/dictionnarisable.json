                        ],
                        "examples": [
                            {
                                "example_id": "6bf544f1-d457-47e5-bd04-986f07191223",
                                "sense_id": "2dedb674-a08e-3c32-87e2-2ec3df6a8b46",
                                "text": "Ces constructions ont-elles ou non le statut de mot en langue ? Un oui en réponse à cette interrogation rend ce vocabulaire virtuellement dictionnarisable."
                            },
                            {
                                "example_id": "4f9006d4-23d5-4e01-9911-e8e3a95b7dfc",
                                "sense_id": "2dedb674-a08e-3c32-87e2-2ec3df6a8b46",
                                "text": "Comment, une fois « écrivain », entre-t-on dans le sanctuaire des « écrivains importants » ? A quel moment est-on déclaré « dictionnarisable » ?"
                            }
                        ]
                    }
