                    {
                        "translation_id": "673d6369-ecce-4304-8d83-2f23af630071",
                        "source_entry_id": "c928e206-1038-3e52-b25c-d9e0408134e3",
                        "source_sense_id": "886b2b72-39d4-3ab8-b261-680d75dec5e9",
                        "source_sense_description": "period of three days",
                        "target_lang_word": "Fastnacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fastnacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb9fc0b6-6aa6-3b74-9330-d66ae4683251",
                                        "entry_id": "74d848b4-fa95-3a89-8819-b7cf55663f91",
                                        "glosses": [
                                            "ursprünglich die letzte Nacht vor der 40-tägigen österlichen Fastenzeit, die in einem fröhlich ausgelassenen Fest begangen wurde"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7002d0c-4299-35e0-84e1-8cb105e656e7",
                                        "entry_id": "74d848b4-fa95-3a89-8819-b7cf55663f91",
                                        "glosses": [
                                            "eine längere Periode, die Fastnachtszeit"
                                        ],
                                        "tags": [
                                            "Volkstum",
                                            "aktuell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a543262b-e447-443f-b55f-06596db17451",
                                                "sense_id": "e7002d0c-4299-35e0-84e1-8cb105e656e7",
                                                "text": "In vielen Gegenden Deutschlands lebt vom 11.11. um 11 Uhr 11 an auf die Fastnacht hin."
                                            },
                                            {
                                                "example_id": "3a4e5f99-4a61-42fa-8f78-7587aa4978d0",
                                                "sense_id": "e7002d0c-4299-35e0-84e1-8cb105e656e7",
                                                "text": "„Ja, natürlich habe sie gewußt, daß es die wirblige Zeit des Karnevals mit all seiner Tag und Nacht nicht ruhenden Geselligkeit sei, und gerade das, der Wunsch, die berühmte Mainzer Fastnacht mitzumachen, habe sie sozusagen Hals über Kopf in den nächsten und schnellsten D-Zug getrieben.“"
                                            },
                                            {
                                                "example_id": "0affce8c-9452-4390-9e08-b2cac6d733d4",
                                                "sense_id": "e7002d0c-4299-35e0-84e1-8cb105e656e7",
                                                "text": "„Es ist Spätsommer, die Fastnacht noch weit, aber eines Tages kommen wir zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aad14ef-d953-4028-9688-eb2fd851939e",
                        "source_entry_id": "c928e206-1038-3e52-b25c-d9e0408134e3",
                        "source_sense_id": "886b2b72-39d4-3ab8-b261-680d75dec5e9",
                        "source_sense_description": "period of three days",
                        "target_lang_word": "Fasching",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fasching",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4a507c0-6dd7-36a5-809e-71d0e6b542b4",
                                        "entry_id": "7e590ddb-4f7d-3782-97d5-e509fcc3ad01",
                                        "glosses": [
                                            "Festzeit, die vor der kirchlichen Fastenzeit liegt und an Dreikönig (6.1.) oder am 11.11. beginnt und am Aschermittwoch zu Ende ist, und die dazugehörigen Bräuche"
                                        ],
                                        "tags": [
                                            "Volkstum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6d56754-d523-40cf-b6f1-132098dc84ec",
                                                "sense_id": "d4a507c0-6dd7-36a5-809e-71d0e6b542b4",
                                                "text": "Morgen ist Fasching."
                                            },
                                            {
                                                "example_id": "d9f12f89-b45f-44e8-953b-c9713417d7f1",
                                                "sense_id": "d4a507c0-6dd7-36a5-809e-71d0e6b542b4",
                                                "text": "Barberini wiederum besaß ein ausgesprochenes Faible für den Fasching – und Mazzocchi musste ihm die Musik dafür liefern."
                                            },
                                            {
                                                "example_id": "6009a9c2-b961-4a2d-8b30-78b64aa1f2a2",
                                                "sense_id": "d4a507c0-6dd7-36a5-809e-71d0e6b542b4",
                                                "text": "Nun ist der Fasching durchaus kein Höhepunkt im Jahresablauf des echten Bayern — man feiert ihn halt, weil ihn die anderen feiern, und außerdem überbrückt er auf angenehme Weise die Zeitspanne zwischen Oktoberfest und Starkbieranstich."
                                            },
                                            {
                                                "example_id": "c5bc42ae-94f2-4cab-9f51-d4605cf0e1cd",
                                                "sense_id": "d4a507c0-6dd7-36a5-809e-71d0e6b542b4",
                                                "text": "„Es war Fasching, 1983, ich war sechs Jahre alt und das einzige Kind in meiner Kindergartengruppe, das nicht wusste, was das war.“"
                                            },
                                            {
                                                "example_id": "9a397b30-bdb3-46e6-9016-fefdb5aa03b9",
                                                "sense_id": "d4a507c0-6dd7-36a5-809e-71d0e6b542b4",
                                                "text": "„Und einen Fasching gab es, während dessen man betrunken sein und wild tanzen durfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fasching",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8a7a579-f3e1-32f8-9ad6-681da1b3693b",
                                        "entry_id": "4d1e21b5-2f52-31ce-b471-4ba0e72afb0c",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7e96fb-a69e-45b5-b7d1-9bc58b9e0ef0",
                                                "sense_id": "e8a7a579-f3e1-32f8-9ad6-681da1b3693b",
                                                "text": "Herr Fasching ist bereits seit 20 Jahren Totengräber."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6676cd24-5e00-4cde-9e1b-e16e587a36cc",
                        "source_entry_id": "c928e206-1038-3e52-b25c-d9e0408134e3",
                        "source_sense_id": "886b2b72-39d4-3ab8-b261-680d75dec5e9",
                        "source_sense_description": "period of three days",
                        "target_lang_word": "Karneval",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karneval",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae494c69-c03d-3b1c-afa3-138e8c9c6c5b",
                                        "entry_id": "6362eb1e-0412-33ec-9c55-25cc04b46116",
                                        "glosses": [
                                            "Zeit ausgelassenen Feierns mit Kostüm- und Maskenfesten vor der 40-tägigen Fastenzeit"
                                        ],
                                        "tags": [
                                            "Volkstum/Brauchtum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b53e9ff-ab3d-4c54-a772-5173992c36f7",
                                                "sense_id": "ae494c69-c03d-3b1c-afa3-138e8c9c6c5b",
                                                "text": "Aus einem Rheinischen Karnevalslied: „Denn nur einmal im Jahr ist Karneval, ist Karneval am Rhein,“ sang das närrische Volk im Borchorster Hof."
                                            },
                                            {
                                                "example_id": "5de2f6e0-8213-4367-9aa3-be5d579e8eeb",
                                                "sense_id": "ae494c69-c03d-3b1c-afa3-138e8c9c6c5b",
                                                "text": "„Der Karneval zeigt, wie unbeholfen, einsam und steif viele Deutsche eigentlich sind.“"
                                            },
                                            {
                                                "example_id": "ac823336-b622-4687-952d-421dcb98579c",
                                                "sense_id": "ae494c69-c03d-3b1c-afa3-138e8c9c6c5b",
                                                "text": "„Karneval ist auch etwas wie Krieg.“"
                                            },
                                            {
                                                "example_id": "12c59d58-e6e7-4424-bcd9-35a5f767fd64",
                                                "sense_id": "ae494c69-c03d-3b1c-afa3-138e8c9c6c5b",
                                                "text": "Schon im vergangenen Jahr hatten viele Städte an Karneval verschärfte Sicherheitsmaßnahmen."
                                            },
                                            {
                                                "example_id": "cff6b86f-602e-458f-8cb7-1f5b7c371e63",
                                                "sense_id": "ae494c69-c03d-3b1c-afa3-138e8c9c6c5b",
                                                "text": "Mit reichlich südamerikanischem Flair wird der Karneval in Santa Cruz auf der Kanareninsel Teneriffa gefeiert. Und das schon seit mehr als 200 Jahren. Eine Woche lang herrscht hier ein fröhlicher Ausnahmezustand, der inzwischen auch immer mehr Touristen anzieht."
                                            },
                                            {
                                                "example_id": "8f6da3f8-bf31-42f7-a67f-98299f441ceb",
                                                "sense_id": "ae494c69-c03d-3b1c-afa3-138e8c9c6c5b",
                                                "text": "Die Begeisterung für Karneval kam für die Awasums schon in den ersten Jahren in Deutschland. „Wir waren beide zum Studium nach Deutschland gekommen. Als wir den Karneval zum ersten Mal miterlebten, feierten wir sofort mit. Wir finden es einfach toll“, sagt der frisch gekürte Prinz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
