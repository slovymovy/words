                ],
                "senses": [
                    {
                        "sense_id": "0c7af338-d06c-3ece-be62-bc30fe720bc1",
                        "entry_id": "61c02b88-db74-356c-9cf5-e6c278fb59ee",
                        "glosses": [
                            "Qui concerne les Massaïs, leur culture, leur langue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b2ac1bc-3d55-4593-92b3-637f0ec493a7",
                                "sense_id": "0c7af338-d06c-3ece-be62-bc30fe720bc1",
                                "text": "Je peux sentir la fumée des feux du village massaï voisin, sur lesquels les habitants préparent le dîner."
                            },
                            {
                                "example_id": "9b7fd883-ae82-4d2d-88e9-ef8109a056e1",
                                "sense_id": "0c7af338-d06c-3ece-be62-bc30fe720bc1",
                                "text": "Sans être exempt de clichés (l’action est le remède au deuil, la science est objective, la religion est une belle allégorie, mais l’intégrisme est nuisible), ce roman a des vertus pédagogiques (débat évolutionnisme/créationnisme, culture massaïe) et, surtout, propose une captivante intrigue africaine, pleine de rebondissements, que même les lecteurs adultes apprécieront."
                            },
                            {
                                "example_id": "f579515e-5a6a-4489-a79c-cab55e3d26b3",
                                "sense_id": "0c7af338-d06c-3ece-be62-bc30fe720bc1",
                                "text": "De génération en génération, les guerriers massaïs devaient prouver leur virilité en tuant un lion."
                            }
                        ]
                    }
                ],
