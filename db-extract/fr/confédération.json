        "fr-extract.jsonl": [
            {
                "entry_id": "6138254f-e3d8-3dc3-b94c-44993e7c0293",
                "word": "Confédération",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ebc90fe7-7d27-3475-a279-3fec3423b39b",
                        "entry_id": "6138254f-e3d8-3dc3-b94c-44993e7c0293",
                        "glosses": [
                            "Coalition d'États du sud des États-Unis ayant cherché à se séparer du reste du pays lors de la guerre de Sécession (1861-1865)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0bc943-8400-4e1c-8893-9503c4379ef4",
                                "sense_id": "ebc90fe7-7d27-3475-a279-3fec3423b39b",
                                "text": "Aux États-Unis, il faut attendre la défaite des forces de la Confédération au cours de la guerre de Sécession pour que les dispositions anti-esclavagistes de la constitution de 1791 ne s'étendent à l'ensemble du territoire désormais unifié."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ac8cb7a-619a-3c94-99cf-acbb867c6fa6",
                        "entry_id": "6138254f-e3d8-3dc3-b94c-44993e7c0293",
                        "glosses": [
                            "Suisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec3a090a-77eb-41f2-92c4-c77fb78b3f95",
                                "sense_id": "5ac8cb7a-619a-3c94-99cf-acbb867c6fa6",
                                "text": "L’emploi de la croix suisse est interdit lorsqu’il est propre à faire croire à de prétendus rapports avec la Confédération."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01ad9ddb-6569-465e-a458-38ed091c2402",
                        "source_entry_id": "6138254f-e3d8-3dc3-b94c-44993e7c0293",
                        "target_lang_word": "Confederacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Confederacy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a400a6d-09a7-363d-86d5-36c8b2463049",
                                        "entry_id": "e89441f9-65c8-3109-bb0d-b1af51610efc",
                                        "glosses": [
                                            "The Confederate States of America, the collection of American states that seceded from the United States in 1860–61, and fought against the Union in the American Civil War."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af768a76-a798-4213-ab73-5a86f8b18fda",
                                                "sense_id": "7a400a6d-09a7-363d-86d5-36c8b2463049",
                                                "text": "Christmas of 1862 had been a happy one for Atlanta, for the whole South. The Confederacy had scored a smashing victory at Fredericksburg and the Yankee dead and wounded were counted in the thousands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "1f70d548-bfdc-444e-959f-795a1feedbc3",
                        "source_entry_id": "6138254f-e3d8-3dc3-b94c-44993e7c0293",
                        "source_sense_ids": [
                            "ebc90fe7-7d27-3475-a279-3fec3423b39b"
                        ],
                        "linkage_type": "synonyms",
                        "word": "États confédérés d’Amérique"
                    },
                    {
                        "linkage_id": "918759b4-11d1-4d78-970a-c3c172eb2e8e",
