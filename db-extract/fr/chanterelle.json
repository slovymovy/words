                                        "glosses": [
                                            "ein Pilz mit goldgelbem, trichterförmigem Hut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b70311b-9d3d-4b47-9f49-62ee6d882895",
                                                "sense_id": "99cd4110-b602-3835-8d43-f80ed5198491",
                                                "text": "[Die Bauern] haben vor sich ihr bescheidenes Sortiment aufgetürmt: Honig, Tomaten, Paprika und Pfifferlinge bieten sie an."
                                            },
                                            {
                                                "example_id": "a87aa8cf-cc51-474c-8072-42b7ce361f08",
                                                "sense_id": "99cd4110-b602-3835-8d43-f80ed5198491",
                                                "text": "Ich mag gern Pfifferlinge."
                                            },
                                            {
                                                "example_id": "a6d3dd27-5a0e-448c-a1fa-331147ace50d",
                                                "sense_id": "99cd4110-b602-3835-8d43-f80ed5198491",
                                                "text": "Pfifferlinge waren in den 1940er und 1950er Jahren ein Arme-Leute-Essen, heute sind sie ziemlich teuer geworden."
                                            }
                                        ],
