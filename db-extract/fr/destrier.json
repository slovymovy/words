                "forms": [
                    {
                        "form_id": "bed54399-1d87-49c7-b35a-79f3a141add9",
                        "entry_id": "e953bcda-2f74-35fc-8f4e-37da3912b89a",
                        "tags": [
                            "plural"
                        ],
                        "form": "destriers"
                    },
                    {
                        "form_id": "5ab2358f-c2e8-4da9-a6d6-4de13edcb046",
                        "entry_id": "e953bcda-2f74-35fc-8f4e-37da3912b89a",
                        "tags": [],
                        "form": "dextrier"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b533da7-e5d4-36e0-8821-9ad48acb1039",
                        "entry_id": "e953bcda-2f74-35fc-8f4e-37da3912b89a",
                        "glosses": [
                            "Cheval de bataille au Moyen Âge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c74880a-fea8-4ea7-bc55-18f114a06bfc",
                                "sense_id": "1b533da7-e5d4-36e0-8821-9ad48acb1039",
                                "text": "Le cheval d’armes ou dextrier, […] enfermé entre un mors et des éperons qui sont de véritables instruments de torture, doit être ménagé, et ce n’est qu’au moment de la charge que le chevalier le monte."
                            },
                            {
                                "example_id": "325c6850-759c-469b-bdd6-a05b0b2ae902",
                                "sense_id": "1b533da7-e5d4-36e0-8821-9ad48acb1039",
                                "text": "Une fois même, on rencontra une charrette attelée d’un cheval et une autre fois un adolescent à califourchon sur un destrier noir, en butte aux lazzis des passants."
                            },
                            {
                                "example_id": "925cfc61-a27d-47f5-a61c-852c55b22e38",
                                "sense_id": "1b533da7-e5d4-36e0-8821-9ad48acb1039",
                                "text": "Le soir, nous franchîmes à pied, destriers tenus par la bride, le pont Saint-Bénézet qui reliait les deux rives du fleuve Rhône, sous des rafales de vent à décorner les cocus, pour rejoindre la terre royale au fort Saint-André, près Villeneuve-lès-Avignon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eba18350-a5e0-4a99-bda0-4607171adda7",
                        "source_entry_id": "e953bcda-2f74-35fc-8f4e-37da3912b89a",
                        "source_sense_id": "1b533da7-e5d4-36e0-8821-9ad48acb1039",
                        "target_lang_word": "destrier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destrier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e4bfd52-fa26-3fd5-9019-412f9ed050e2",
                                        "entry_id": "ef2be163-be6c-36dc-bafd-2dc7ddf35232",
                                        "glosses": [
                                            "A large warhorse, especially of a medieval knight."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1c6d484-5c21-4899-8eba-d353990e25e0",
                                                "sense_id": "5e4bfd52-fa26-3fd5-9019-412f9ed050e2",
                                                "text": "I am resolved to share or avert the danger; which, that I may the better do, I would crave of thee the use of some palfrey whose pace may be softer than that of my destrier."
                                            },
                                            {
                                                "example_id": "5367bf98-f843-4d1d-b7b0-cd54edc923a9",
                                                "sense_id": "5e4bfd52-fa26-3fd5-9019-412f9ed050e2",
                                                "text": "Dark and the Desert and Destriers me ken, And the Glaive and the Joust, and Paper and Pen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f16494e-75a2-30bb-9607-26a66cb79895",
                                        "entry_id": "ef2be163-be6c-36dc-bafd-2dc7ddf35232",
                                        "glosses": [
                                            "A steed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "858411b3-4039-44ba-9922-3a483f300120",
                        "source_entry_id": "e953bcda-2f74-35fc-8f4e-37da3912b89a",
                        "source_sense_id": "1b533da7-e5d4-36e0-8821-9ad48acb1039",
                        "target_lang_word": "warhorse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warhorse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "Any horse used in horse-cavalry, but especially one bearing an armoured knight."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab25a72f-ee42-477c-8962-e9cc3c3bfe15",
                                                "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                                "text": "Just within the inner edge of the circle stood a soldier, in the military attire of a strange nation; and without it was his warhorse, in the center of a collection of mounted domestics, seemingly in readiness to undertake some distant journey."
                                            },
                                            {
                                                "example_id": "a0f43e27-259d-48e8-8f0f-49d634f31943",
                                                "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                                "text": "As he spoke, the knight-errant, who had remounted his war-horse, galloped forward to the royal stand, with a silken kerchief bound round his wounded arm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "An experienced person who has been through many battles, situations or contests; someone who has given long service."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10c4133d-c4d1-412f-9d0d-8cc52c7afcc5",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Near-synonym: workhorse"
                                            },
                                            {
                                                "example_id": "b78bd018-c017-4464-b4b9-33a1d6830faf",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Among other accidents of that year was a Democratic president. Judge Atwood was a warhorse of Democracy."
                                            },
                                            {
                                                "example_id": "322c37eb-6621-42a3-9a65-40d0dfbf0425",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Certainly this was a bold proposal to an old warhorse like Ecuyer, and, like a true English bulldog, he voiced a reply which made the Indians wince."
                                            },
                                            {
                                                "example_id": "27692a21-7652-402c-84ab-658e479517e1",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "“I don't know. I never notice much. Oh, they do kid me about not being in the army—especially the old warhorses, the old men that aren't going themselves. And this Bogart boy. And Mr. Hicks's son—he's a horrible brat. But probably he's licensed to say what he thinks about his father's hired man!”"
                                            },
                                            {
                                                "example_id": "6b715c56-a55d-446b-a52f-773f1fd9de78",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Srinath: India's warhorse [title]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "A regularly revived theatrical or musical work, as with Hamlet or a Beethoven symphony, or as excerpts thereto. May imply that the work in question has become hackneyed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b560fc-0d4a-4c37-9782-5824ec1d0584",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "a Wagner warhorse"
                                            },
                                            {
                                                "example_id": "80b89e3b-e486-4335-bfa8-7d89ac73d809",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "I remember taking the old warhorse, “Una Voce Poco Fa,” from Il Barbiere (Rossini) to three of the greatest living singing masters in Italy."
                                            },
                                            {
                                                "example_id": "b962e7ee-1509-479b-aae3-7f4c0745ff47",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "Les Ballets Trockadero de Monte Carlo[…] presented a typical program of Russian warhorses of the 19th and early 20th centuries[…]"
                                            },
                                            {
                                                "example_id": "64e5ad9e-fc3f-49b7-b1ce-63a60810b634",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "A Mendelssohn Warhorse Gets the Perlman Treatment [title]"
                                            },
                                            {
                                                "example_id": "f463cba4-a769-4a32-917e-f9fc0b6866ea",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "[…] the ROH mounts a new production of an Italian repertory warhorse that is fully on the level of the one it replaces […"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76bdaf41-eb9e-4003-90cf-b482ff263c6b",
                        "source_entry_id": "e953bcda-2f74-35fc-8f4e-37da3912b89a",
                        "source_sense_id": "1b533da7-e5d4-36e0-8821-9ad48acb1039",
                        "target_lang_word": "steed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb00ffa2-9d4d-3174-91a9-fef12c2a7997",
                                        "entry_id": "a12d01fd-9ec5-3b1f-b5dd-e35582cffae7",
                                        "glosses": [
                                            "A stallion, especially one used for riding."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85e0487e-3cd2-4685-b56c-c0bfcef94f3e",
                                                "sense_id": "cb00ffa2-9d4d-3174-91a9-fef12c2a7997",
                                                "text": "The studded bridle on a ragged bough\nNimbly she fastens: -- O, how quick is love! --\nThe steed is stalled up, and even now\nTo tie the rider she begins to prove:\nBackward she push'd him, as she would be thrust,\nAnd govern'd him in strength, though not in lust."
                                            },
                                            {
                                                "example_id": "d9b3f74e-6608-409d-a343-80b7bce4d10f",
                                                "sense_id": "cb00ffa2-9d4d-3174-91a9-fef12c2a7997",
                                                "text": "The torch-eyed ſavage, with growl tremendous, riſing up, diſlocated at one blow the arched neck of Sadit's Arabian ſteed, and brought the unfortunate omrah to the duſt, expiring between his extended claws."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "517c2912-e661-3247-bb53-59d177d1424b",
                                        "entry_id": "a12d01fd-9ec5-3b1f-b5dd-e35582cffae7",
                                        "glosses": [
                                            "A bicycle."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fb2b412-4dab-4536-956a-24ac02fcaacf",
                                                "sense_id": "517c2912-e661-3247-bb53-59d177d1424b",
                                                "text": "silent steed"
                                            },
                                            {
                                                "example_id": "644c65d9-790f-42c4-8aa1-fef8e8e75a2e",
                                                "sense_id": "517c2912-e661-3247-bb53-59d177d1424b",
                                                "text": "In the green lanes of Merrie England the bicycle rider in his natty uniform, speeding along on his silent steed, is met with almost as often as vehicles drawn by horses, and it is safe to say that in the various countries of the world not less than half a million bicycles and tricycles are now in use."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d924619a-1fdd-43e8-9492-78f42d826dae",
                        "source_entry_id": "e953bcda-2f74-35fc-8f4e-37da3912b89a",
