                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf610a66-71c0-4c1f-b302-0d0127d41529",
                                "sense_id": "03fd8841-1222-32c9-84c5-f49b7e32ce1e",
                                "text": "Ik zou hem beschrijven als omvangrijk en uitbundig, met expansieve gebaren die een gevaar vormen voor het glaswerk, en een dik hoofd dat speciaal is gemaakt om ruimte te bieden aan zijn brede lach."
                            }
                        ]
