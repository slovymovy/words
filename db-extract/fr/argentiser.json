                "senses": [
                    {
                        "sense_id": "9e4bee95-49b9-3dce-bde9-91394e1962b8",
                        "entry_id": "57a76419-a7f3-373d-8521-2d8b1249fab4",
                        "glosses": [
                            "Faire passer (une image numérique) sur une pellicule photo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4de369e3-3196-48b9-8dd9-4d3ac1ae0a5c",
                                "sense_id": "9e4bee95-49b9-3dce-bde9-91394e1962b8",
                                "text": "C'est un peu de la \"triche\" d'argentiser du numérique .... mais ca me donne plusieurs idées ......"
                            },
                            {
                                "example_id": "1ad187e2-163f-42de-ab52-91617fa8f80c",
                                "sense_id": "9e4bee95-49b9-3dce-bde9-91394e1962b8",
                                "text": "A l'inverse, on peut \"argentiser\" une photo numérique pour lui donner le grain du film."
                            },
                            {
                                "example_id": "ed778ef9-42db-4eff-b612-9f8d74e63adc",
                                "sense_id": "9e4bee95-49b9-3dce-bde9-91394e1962b8",
                                "text": "Si tu veux avoir un beau rendu en numérique il faut passer un peu de temps sur la photo pour \" l'humaniser \" ou plutôt \" l'argentiser \"."
                            }
                        ]
                    }
