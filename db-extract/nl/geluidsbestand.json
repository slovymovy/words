                        "examples": [
                            {
                                "example_id": "88fd46d8-2175-46f8-9945-e83aeaa58e50",
                                "sense_id": "1da107b0-801f-3cea-b036-231287e96f00",
                                "text": "Volgens de VRT is het geluidsbestand een opname van een of meerdere gesprekken tussen een van de terroristen hier en iemand in Syrië. In het gesprek zouden ze brainstormen over mogelijke doelwitten in België en Frankrijk. Ze zouden ook hun tactiek bespreken."
                            },
                            {
                                "example_id": "188f6748-9b7b-40a2-a51c-20ad436216af",
                                "sense_id": "1da107b0-801f-3cea-b036-231287e96f00",
                                "text": "Naast een computeranalyse maakten ze ook een geluidsbestand van de reconstructie, om zelf naar te luisteren. Het resultaat bleek een herkenbare versie van het nummer. De melodie en het ritme komen goed overeen met origineel. De gitaar en de zang zijn herkenbaar, al is de tekst zo sterk vervormd dat de woorden nauwelijks verstaanbaar zijn."
                            }
                        ]
                    }
