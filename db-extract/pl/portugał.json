                "senses": [
                    {
                        "sense_id": "90ce6d8d-7212-3530-aebe-1199a49c2b50",
                        "entry_id": "6789825a-e4e5-3780-a1f1-f7786e3c92a2",
                        "glosses": [
                            "potoczna nazwa złotej monety wielodukatowej, używanej w handlu europejskim w XVI-XVII wieku, bitej na wzór monet portugalskich także w Polsce"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6b84b004-5d99-4572-8be9-856be32df478",
                                "sense_id": "90ce6d8d-7212-3530-aebe-1199a49c2b50",
                                "text": "Przecież tam masz… leżące złoto, osobno holenderskie, osobno portugały…"
                            },
                            {
                                "example_id": "340280cd-1fbe-4559-8d8a-f05023546d2f",
                                "sense_id": "90ce6d8d-7212-3530-aebe-1199a49c2b50",
                                "text": "Podczaszy wydobył sakwę spod poły, wysunął z niej dwa świecące, ogromne portugały i położył je przed nim"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
