                                "example_id": "7983f9a4-7414-4de8-8640-9160660fa823",
                                "sense_id": "28fdf253-2e71-3778-9f26-d38b0f137d6c",
                                "text": "„Die Zoogeographie (Tiergeographie) ist die Wissenschaft von der räumlichen Verbreitung der Tiere.“"
                            },
                            {
