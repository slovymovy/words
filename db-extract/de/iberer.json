                ],
                "senses": [
                    {
                        "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                        "entry_id": "7ba6822c-e370-3fc5-a655-a6873d60e443",
                        "glosses": [
                            "Urbewohner der Pyrenäenhalbinsel vor Ankunft der Indogermanen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67411fd0-a941-4996-87a8-5f6724eb5d88",
                                "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                                "text": "Die Söldner waren jetzt alle von erschreckender Magerkeit. Ihre Haut bedeckte sich mit bläulichen Flecken. Am Abend des neunten Tages starben drei Iberer."
                            },
                            {
                                "example_id": "0f197db2-6b44-4a27-9402-d85150c40ed5",
                                "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                                "text": "Hadrian suchte freundliche Beziehungen mit den Albanern und Iberern anzuknüpfen."
                            },
                            {
                                "example_id": "a0d38a60-6446-47fc-b390-585d65338fe9",
                                "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                                "text": "Dafür legen auch Zeugnis ab die Frauenheere der Aschantis und des Königs von Dahome in Westafrika, die sich durch Tapferkeit und Wildheit auszeichnen. Auch Tacitus' Urteil über die Frauen der alten Germanen und die Angaben Cäsars über die Frauen der Iberer und Schotten bestätigen dieses."
                            },
                            {
                                "example_id": "90b1f73e-64bd-46b0-83cf-0abd15574a8d",
                                "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                                "text": "Dass es sich tatsächlich um die Reste des biblischen Bethaniens handelt, schließen die Forscher auch aus frühen Chroniken und Reiseberichten wie denen von Petrus dem Iberer und der galizischen Nonne Aetheria."
                            },
                            {
                                "example_id": "566dbcdd-513d-4354-8d89-0ba58887fc19",
                                "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                                "text": "Ein Studienreisender darf nicht schlappmachen, schon gar nicht in einer Stadt, in der bereits die Iberer siedelten, die westgotischen Könige ihr Reich etablierten, die Mauren bis zum Ende des 11. Jahrhunderts residierten und in der selbst die rigiden spanischen Könige den Einfluß der Araber und Juden noch lange duldeten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
