                                                "sense_id": "529c9e44-f8d9-3dae-9239-e99a96fbd2af",
                                                "text": "After his fall from the emperor's favor, the general was posted to a remote outpost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00bb2e37-1b3b-34de-8d85-9e02aa869225",
