                        "entry_id": "33f7073f-3c01-3e5d-8720-f684fe40ec4e",
                        "glosses": [
                            "Dahlia, rodzaj roślin nasiennych należących do rodziny astrowatych, mających kolorowe kwiaty ułożone w koszyczki; uprawiana jako roślina ozdobna"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "83efc7c4-c349-3f6d-9861-136c72c07460",
                        "entry_id": "33f7073f-3c01-3e5d-8720-f684fe40ec4e",
                        "glosses": [
                            "Dallia pectoralis, słodkowodna ryba z rodziny muławkowatych występująca w niewielkich rzekach, jeziorach i bagnach tundry na Alasce i Syberii"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d1047d2-a0ae-497a-8d32-6017e7894592",
                        "source_entry_id": "33f7073f-3c01-3e5d-8720-f684fe40ec4e",
                        "source_sense_id": "cb649313-a287-384f-8d7a-70a9f34a8c67",
                        "target_lang_word": "Dahlie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dahlie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0de3fd39-eb71-36f5-985a-a14aa58d9594",
                                        "entry_id": "6358fc10-9b47-3f49-b8c2-385f3506c084",
                                        "glosses": [
                                            "Gartenpflanze (Dahlia) aus der Familie der Korbblütler (Asteraceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa868a88-ce9a-47b0-b7af-a3553f32e77f",
                                                "sense_id": "0de3fd39-eb71-36f5-985a-a14aa58d9594",
                                                "text": "Dahlien gibt es nahezu in allen Blütenfarben, außer in Blau."
                                            },
                                            {
                                                "example_id": "8f421b97-175c-4cca-92aa-46c2b112e02a",
                                                "sense_id": "0de3fd39-eb71-36f5-985a-a14aa58d9594",
                                                "text": "Die Dahlie ist eine beliebte Gartenpflanze."
                                            },
                                            {
                                                "example_id": "a0734bd2-c56f-4e68-b4ed-daa54cba4557",
                                                "sense_id": "0de3fd39-eb71-36f5-985a-a14aa58d9594",
                                                "text": "Nach den Rosen sind die Dahlien unsere Lieblinge."
                                            },
                                            {
                                                "example_id": "b3e43276-dcd0-474d-bebd-6d308f8de795",
                                                "sense_id": "0de3fd39-eb71-36f5-985a-a14aa58d9594",
                                                "text": "„[Die Saatgutmischung] \"Bienenparadies\" enthält unter anderem bienenfreundliche gelbe Dahlien und blaue Anemonen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
