                        "sense_id": "f8e2db2d-cf8d-3fc0-8f36-48b69d53fcda",
                        "entry_id": "91e177b6-f839-312e-9dbb-33bbdceb9a9f",
                        "glosses": [
                            "ein künstlicher, schiffbarer Kanal, der das Mittelmeer mit dem Roten Meer verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f9a6f01-4de6-4c72-ae65-ba218c70b25d",
                                "sense_id": "f8e2db2d-cf8d-3fc0-8f36-48b69d53fcda",
                                "text": "Durch den Sueskanal brauchen europäische Schiffe nicht mehr Afrika zu umfahren, um nach Indien oder China zu kommen."
                            },
                            {
                                "example_id": "60a24f43-ec53-458d-ab38-bdd2eccd893d",
                                "sense_id": "f8e2db2d-cf8d-3fc0-8f36-48b69d53fcda",
                                "text": "„Der Nord-Ostsee-Kanal ist die meistbefahrene künstliche Wasserstraße der Welt; ihn passieren mehr Schiffe als Panama- und Sueskanal zusammen.“"
                            }
                        ],
