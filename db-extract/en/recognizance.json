                "entry_id": "2af699d5-3f03-3245-bc46-9ef080d93c39",
                "word": "recognizance",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "94ff2501-5ff8-4572-95a6-ddc6dba9cae1",
                        "entry_id": "2af699d5-3f03-3245-bc46-9ef080d93c39",
                        "tags": [
                            "plural"
                        ],
                        "form": "recognizances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e44d3c46-c25d-3a6e-8829-411212fc0594",
                        "entry_id": "2af699d5-3f03-3245-bc46-9ef080d93c39",
                        "glosses": [
                            "A form of bail; a promise made by the accused to the court that they will attend all required judicial proceedings and will not engage in further illegal activity or other prohibited conduct as set by the court."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3b59297b-79c2-4159-9050-c7bd0be71fe8",
                                "sense_id": "e44d3c46-c25d-3a6e-8829-411212fc0594",
                                "text": "The defendant was released on his own recognizance."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bc5b2dd-8756-35da-b7b2-853d37a8b960",
                        "entry_id": "2af699d5-3f03-3245-bc46-9ef080d93c39",
                        "glosses": [
                            "A token; a symbol; a pledge."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "61f9d154-0b47-4dcf-9165-504ad074fd3f",
                                "sense_id": "6bc5b2dd-8756-35da-b7b2-853d37a8b960",
                                "text": "That recognizance and pledge of love / Which I first gave her."
                            },
                            {
                                "example_id": "454ca3ea-c160-4b6b-a3d6-06b9cc225012",
                                "sense_id": "6bc5b2dd-8756-35da-b7b2-853d37a8b960",
                                "text": "Hobhouse's insolence to Mr. Hunt is not seen in its true light, unless we remember, that the latter is held under heavy recognizances to keep the peace!"
                            }
                        ]
                    },
                    {
                        "sense_id": "7397ec18-3b69-3a3c-87d1-52a35211cf9e",
                        "entry_id": "2af699d5-3f03-3245-bc46-9ef080d93c39",
                        "glosses": [
                            "Acknowledgment of a person or thing; avowal; profession; recognition."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
