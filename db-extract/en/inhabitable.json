                    {
                        "translation_id": "a4f75e64-f3de-4a89-afc3-a9e06aae9fce",
                        "source_entry_id": "bb014cf2-4140-3432-9e0e-a97a3d9e99c1",
                        "source_sense_id": "97aeac71-a6ec-35a1-858f-2b61a4c29ca0",
                        "source_sense_description": "fit to live in",
                        "target_lang_word": "bewoonbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bewoonbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "575938a5-9563-3879-b4ed-bf08016ab6e5",
                                        "entry_id": "aa9daa1f-e814-3794-a703-3024bb267d54",
                                        "glosses": [
                                            "geschikt om te bewonen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba01c86-e22e-4822-8bbb-310a65524d6c",
                                                "sense_id": "575938a5-9563-3879-b4ed-bf08016ab6e5",
                                                "text": "Het bewoonbare huis werd al snel verkocht."
                                            },
                                            {
                                                "example_id": "bda45e20-05f1-4922-850e-6f859d2431d5",
                                                "sense_id": "575938a5-9563-3879-b4ed-bf08016ab6e5",
                                                "text": "Het lijkt misschien het makkelijkst om op aarde een kant-en-klare maanmodule te bouwen en die vervolgens naar de maan te sturen. Toch pleit Vermeulen om juist gebruik te maken van de grondstoffen van de maan zelf, om zo onafhankelijk te zijn van de aarde. Een efficiënte manier is om bijvoorbeeld gebruik te maken van de bewoonbare lavatunnels waar een vestiging in gebouwd kan worden. Op die manier biedt het oppervlak van de maan zelf voldoende bescherming"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fe68267-f286-487a-a1f5-1ec13655089d",
                        "source_entry_id": "bb014cf2-4140-3432-9e0e-a97a3d9e99c1",
                        "source_sense_id": "97aeac71-a6ec-35a1-858f-2b61a4c29ca0",
                        "source_sense_description": "fit to live in",
                        "target_lang_word": "habitable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habitable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60970395-cf3b-3de0-8781-f790ecbd5e64",
                                        "entry_id": "4aff194a-40af-397f-a593-d142da4a3bdb",
                                        "glosses": [
                                            "Qui peut être habité ; où l'on peut habiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f806c3-b638-4bd9-951e-2e189da4372e",
                                                "sense_id": "60970395-cf3b-3de0-8781-f790ecbd5e64",
                                                "text": "Les archers entrèrent dans le corps de bâtiment qui leur paraissait le plus habitable […]."
                                            },
                                            {
                                                "example_id": "412e83d5-78c0-48b0-aa37-1429734865b8",
                                                "sense_id": "60970395-cf3b-3de0-8781-f790ecbd5e64",
                                                "text": "Mais tous ses soins furent pour le salon. Elle réussit presque à en faire un lieu habitable. Il était garni d’un meuble de velours jaunâtre, à fleurs satinées. Au milieu se trouvait un guéridon à tablette de marbre ; des consoles, surmontées de glaces, s’appuyaient aux deux bouts de la pièce. Il y avait même un tapis qui ne couvrait que le milieu du parquet, et un lustre garni d’un étui de mousseline blanche que les mouches avaient piqué de chiures noires."
                                            },
                                            {
                                                "example_id": "29689bb5-630e-4279-b827-23b5030fa912",
                                                "sense_id": "60970395-cf3b-3de0-8781-f790ecbd5e64",
                                                "text": "Sur une petite cour intérieure, deux pièces encore habitables s'ouvraient."
                                            },
                                            {
                                                "example_id": "77413df5-cc96-46d9-a027-8f538fedfded",
                                                "sense_id": "60970395-cf3b-3de0-8781-f790ecbd5e64",
                                                "text": "Maintenant, la terre habitable est connue : la carte en est faite."
                                            },
                                            {
                                                "example_id": "b0969e17-1c04-4717-b930-77519f866f60",
                                                "sense_id": "60970395-cf3b-3de0-8781-f790ecbd5e64",
                                                "text": "La partie habitable mesurait deux cent cinquante pieds de long, et comprenait deux rangées de cabines superposées."
                                            },
                                            {
                                                "example_id": "071320e7-45fa-4b05-9f5c-1793b16583a2",
                                                "sense_id": "60970395-cf3b-3de0-8781-f790ecbd5e64",
                                                "text": "Nous eûmes à nous transporter par équipes, jusqu'à des villages habitables où l'on nous apprit à tendre des fils sur des perches et à faire des épissures, ce que nous savions très bien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8bb04dd-6b5b-4f81-ac88-be13a5e1f357",
                        "source_entry_id": "bb014cf2-4140-3432-9e0e-a97a3d9e99c1",
                        "source_sense_id": "97aeac71-a6ec-35a1-858f-2b61a4c29ca0",
                        "source_sense_description": "fit to live in",
                        "target_lang_word": "bewohnbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bewohnbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7759dd7-980a-3a77-9a92-b2deb412a224",
                                        "entry_id": "f5f9ab58-f25d-3f86-aa6e-16658c23276a",
                                        "glosses": [
                                            "zum Bewohnen geeignet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3884796f-8469-420e-8150-c7c82aa6c201",
                                                "sense_id": "b7759dd7-980a-3a77-9a92-b2deb412a224",
                                                "text": "„Ein internationales Forscherteam hat eine potenziell bewohnbare \"Super-Erde\" in einem nahen Sternsystem aufgespürt.“"
                                            },
                                            {
                                                "example_id": "761c77fb-6ce6-449d-b9cb-95404f83ca93",
                                                "sense_id": "b7759dd7-980a-3a77-9a92-b2deb412a224",
                                                "text": "„Seit November 2000 ist die ISS bewohnbar und Arbeitsplatz für ein kleines Astronauten-Team.“"
                                            },
                                            {
                                                "example_id": "81f0d535-918c-4610-9963-f2e6f38292f9",
                                                "sense_id": "b7759dd7-980a-3a77-9a92-b2deb412a224",
                                                "text": "Nach dem Brand ist mein Haus nicht mehr bewohnbar."
                                            },
                                            {
                                                "example_id": "781df45a-9aaf-4ace-aec6-fd52806b0f40",
                                                "sense_id": "b7759dd7-980a-3a77-9a92-b2deb412a224",
                                                "text": "„[…] zur guten Zukunft [unserer Kinder] gehören neben Bildung und berufliche Perspektiven vor allem ein bewohnbarer Planet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
