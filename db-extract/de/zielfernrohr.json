                "senses": [
                    {
                        "sense_id": "b7e6af2a-8f52-3931-bb10-583ffa191809",
                        "entry_id": "6ede5fdb-490f-370a-aaf6-998615b1f907",
                        "glosses": [
                            "Fernrohr als Zusatzgerät an Messgeräten und Schusswaffen, um das Erfassen von Zielobjekten zu verbessern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9cf8f11-973a-4927-9be1-936b0a996ba3",
                                "sense_id": "b7e6af2a-8f52-3931-bb10-583ffa191809",
                                "text": "„Ich bekam sie beide ins Visier, und das Zielfernrohr holte sie ganz nahe heran.“"
                            },
                            {
                                "example_id": "73e41e12-0c6d-44a0-9c24-8c666e5bf55a",
                                "sense_id": "b7e6af2a-8f52-3931-bb10-583ffa191809",
                                "text": "Als Scharfschütze benötigt man ein exzellentes Zielfernrohr."
                            },
                            {
                                "example_id": "1b2ec305-5b31-46f4-a256-313631d55721",
                                "sense_id": "b7e6af2a-8f52-3931-bb10-583ffa191809",
                                "text": "„Das ist ein Infanterist pro Einheit, der ein leichtes Sturmgewehr mit Zielfernrohr erhält.“"
                            },
                            {
                                "example_id": "21f6d906-7fb6-4cfb-988f-abc32c9009ca",
                                "sense_id": "b7e6af2a-8f52-3931-bb10-583ffa191809",
                                "text": "„Der Kapellmeister will auch durchs Zielfernrohr sehen, und danach darf Thomas gucken.“"
                            },
                            {
                                "example_id": "9e7199a6-afd1-423f-869c-e00c22dc0a34",
                                "sense_id": "b7e6af2a-8f52-3931-bb10-583ffa191809",
                                "text": "„Er schob sich im Geröll zurecht, zog einen Stiefel aus, legte ihn auf die Steine, senkte den Vorderschaft der Büchse auf das Leder, entsicherte mit dem Daumen und visierte durch das Zielfernrohr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9cae368-83d7-4944-94c7-80a31e5795dd",
                        "source_entry_id": "6ede5fdb-490f-370a-aaf6-998615b1f907",
                        "source_sense_id": "b7e6af2a-8f52-3931-bb10-583ffa191809",
