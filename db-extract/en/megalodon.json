                        "entry_id": "6b9929bb-5e28-3e05-8234-2214c161b8ac",
                        "glosses": [
                            "A species of extinct shark that lived during the Miocene and Pliocene epochs (†Otodus megalodon)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c853a85-66bf-4edd-8853-7c17c3879a15",
                                "sense_id": "5cd263a2-dfd0-3f4b-9b6c-4a826a45c673",
                                "text": "Throughout the period, toothy giants persisted in the oceans. Perhaps the most spectacular was the megalodon shark."
                            }
                        ]
                    }
                ],
