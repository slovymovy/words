                "senses": [
                    {
                        "sense_id": "c2e8a778-528e-3313-8535-e84ea90b3e2c",
                        "entry_id": "ab924078-70fa-34e8-b2b2-ec4dc8154474",
                        "glosses": [
                            "Eigenschaft, leidenschaftlich zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "162fe5b7-4db9-4b84-9682-286f88883554",
                                "sense_id": "c2e8a778-528e-3313-8535-e84ea90b3e2c",
                                "text": "„Ihre Auskünfte schnurrte sie herunter mit der Leidenschaftlichkeit des Bahnbeamten am Fahrkartenschalter.“"
                            },
                            {
                                "example_id": "bde86671-7630-42bd-9012-1d02d1457e60",
                                "sense_id": "c2e8a778-528e-3313-8535-e84ea90b3e2c",
                                "text": "„Er sah sie an und war betroffen von der ernsten Leidenschaftlichkeit ihres Gesichtsausdrucks.“"
                            },
                            {
                                "example_id": "0c401e5d-54ab-4d32-a890-03c532d2f013",
                                "sense_id": "c2e8a778-528e-3313-8535-e84ea90b3e2c",
                                "text": "„Nach einem Kuß, dessen Leidenschaftlichkeit ihr ebenso gefallen mochte wie seine Süße, verließ ich sie.“"
                            },
                            {
                                "example_id": "471b7e01-4668-495e-8410-be0fd10eab7c",
                                "sense_id": "c2e8a778-528e-3313-8535-e84ea90b3e2c",
                                "text": "„Ihre Stimme, ihr ganzes Wesen zeugte von einer Aufregung, einer Leidenschaftlichkeit, die etwas Wahnsinniges hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
