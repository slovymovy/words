                    {
                        "translation_id": "1336720f-ef21-4ca2-8611-14ea469a5649",
                        "source_entry_id": "13dff6a4-64d9-33e4-a088-077257ce3442",
                        "source_sense_id": "8249e006-87df-3c7e-bb5c-6d539330c24b",
