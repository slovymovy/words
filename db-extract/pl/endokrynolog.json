                                "target_senses": [
                                    {
                                        "sense_id": "842aa027-befb-3631-b817-2f27616fbd10",
                                        "entry_id": "75f23517-f6b0-32f1-8a89-b931c31bd55d",
                                        "glosses": [
                                            "auf Endokrinologie spezialisierter Arzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d94afb2b-5d1d-4ce5-abe4-e9ec8eb51dcb",
                                                "sense_id": "842aa027-befb-3631-b817-2f27616fbd10",
                                                "text": "„Nummer 137 sagt, Cassie Wright habe sechs Monate lang einem Endokrinologen bei der Arbeit zugesehen, habe gelernt, was er mache, und seine Körpersprache studiert, bevor sie bei dem bahnbrechenden Porno Emergency Room Back Door Dog Pile die Rolle einer Ärztin übernommen habe.“"
