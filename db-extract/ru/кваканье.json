                "senses": [
                    {
                        "sense_id": "139ee52f-5e63-3355-9eeb-a2f1f324396b",
                        "entry_id": "89e474d5-7fcb-3c5c-b6d4-cf7caf79c397",
                        "glosses": [
                            "действие по значению гл. квакать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac6db263-41b5-4efc-93ad-96ebe5b2870d",
                                "sense_id": "139ee52f-5e63-3355-9eeb-a2f1f324396b",
                                "text": "Всё было естественно, как пение птиц и кваканье лягушек."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c64d7fb-4a35-3934-b67d-74562dfc9238",
                        "entry_id": "89e474d5-7fcb-3c5c-b6d4-cf7caf79c397",
                        "glosses": [
                            "результат такого действия, звуки, издаваемые лягушками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0650a0a-215f-48e9-b440-b91a45b924da",
                                "sense_id": "0c64d7fb-4a35-3934-b67d-74562dfc9238",
                                "text": "В летней тишине .. слышалось кваканье лягушек, пение сверчков и далёкий зов привязанного на задах базара осла…"
                            }
                        ]
                    },
                    {
                        "sense_id": "18045b4e-a62f-3dc8-ada5-24128305d861",
                        "entry_id": "89e474d5-7fcb-3c5c-b6d4-cf7caf79c397",
                        "glosses": [
                            "рег. утиный крик"
                        ],
