                                "target_senses": [
                                    {
                                        "sense_id": "9d620961-7401-363b-8033-b5b5673ec589",
                                        "entry_id": "f5145b97-4eaf-31c8-a024-00a2228bfb41",
                                        "glosses": [
                                            "Rendre fluide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6614885-540c-4f2e-bda1-534fd7ea1a6b",
                                                "sense_id": "9d620961-7401-363b-8033-b5b5673ec589",
                                                "text": "Le ministre de la défense, Hervé Morin, a annoncé des mesures destinées à « simplifier et fluidifier » les procédures de vente à l'étranger."
                                            },
                                            {
                                                "example_id": "f921974f-f664-4109-8ef4-82e9e0f53778",
                                                "sense_id": "9d620961-7401-363b-8033-b5b5673ec589",
                                                "text": "Un test sera lancé ce mercredi sur pour la première fois sur la E313 Anvers-Liège lors des heures de pointe afin de fluidifier le trafic."
                                            },
                                            {
                                                "example_id": "81d43ba9-d90e-4d11-966a-1146853af966",
                                                "sense_id": "9d620961-7401-363b-8033-b5b5673ec589",
                                                "text": "Pour fluidifier les démarches, il n’y a qu’un seul dossier de demande d’aide pour l’ensemble des copropriétaires, qui doit être déposé par le syndic de copropriété."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c857d97-d71d-3aed-a214-8c865bee34e1",
                                        "entry_id": "f5145b97-4eaf-31c8-a024-00a2228bfb41",
                                        "glosses": [
                                            "Devenir plus fluide."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d08a7a-cb5b-4c63-84c0-0502276dd67c",
                                                "sense_id": "2c857d97-d71d-3aed-a214-8c865bee34e1",
                                                "text": "Toute société ne peut exister qu’à la condition de se déconcréter, de se fluidifier, de se développer, de grandir, en un mot de progresser incessamment dans la vie."
                                            }
                                        ]
                                    }
                                ]
                            }
