                        "glosses": [
                            "zijn zenuwuiteinden op de tong die door stoffen in voedsel worden geprikkeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62a42733-3e17-4b48-be5f-2eeea173fad2",
                                "sense_id": "e364f243-58e1-3504-8f17-f609ce4b37fd",
                                "text": "De mens kan met deze smaakpapillen vijf verschillende smaken onderscheiden: zoet, bitter, zout, umami en zuur. Alle typen papil kunnen die vijf smaken onderscheiden."
                            }
                        ]
