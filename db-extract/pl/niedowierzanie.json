                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bb67677-7e40-41e5-8fa8-7bcfe2c2efc4",
                        "source_entry_id": "57cc256e-d7e0-333a-92c1-a8c88bede64d",
                        "source_sense_id": "1c42ff40-cd8d-3168-bfa3-89bac3ccf972",
                        "target_lang_word": "disbelief",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disbelief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "996f4771-ee53-322b-80c2-3015064627a2",
                                        "entry_id": "18f3bdac-e5a6-374d-9919-76e1b9d40a8a",
                                        "glosses": [
                                            "An unpreparedness, unwillingness, or an inability to believe that something is the case."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "767badf0-32b3-4249-85d6-887601099990",
                                                "sense_id": "996f4771-ee53-322b-80c2-3015064627a2",
                                                "text": "She cried out in disbelief on hearing that terrorists had crashed an airplane into the World Trade Center in New York City."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21ae535-e72a-3e37-812e-bd763050f9e9",
                                        "entry_id": "18f3bdac-e5a6-374d-9919-76e1b9d40a8a",
                                        "glosses": [
                                            "Astonishment."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18dd6a3c-a92a-4e8d-9a40-b3b7c79ff93e",
                                                "sense_id": "c21ae535-e72a-3e37-812e-bd763050f9e9",
                                                "text": "I stared in disbelief at the Grand Canyon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c042fc21-5f66-3217-b98a-6e2ed610c949",
                                        "entry_id": "18f3bdac-e5a6-374d-9919-76e1b9d40a8a",
                                        "glosses": [
                                            "The loss or abandonment of a belief; the cessation of belief."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "223247ab-ddaf-43ea-8a57-54f8eed5eda0",
                                                "sense_id": "c042fc21-5f66-3217-b98a-6e2ed610c949",
                                                "text": "Just like the disbelief in Santa Claus happens gradually, I wondered if it was similar for people leaving their faith."
                                            },
                                            {
                                                "example_id": "096db3af-4220-49cd-be58-f753959cad0b",
                                                "sense_id": "c042fc21-5f66-3217-b98a-6e2ed610c949",
                                                "text": "There is an agony of suffering in that lingering doubt which haunts the human soul in the beginnings of disbelief."
                                            },
                                            {
                                                "example_id": "469f2194-8c9c-44e7-8551-6678e3f28c70",
                                                "sense_id": "c042fc21-5f66-3217-b98a-6e2ed610c949",
                                                "text": "No adolescent can achieve disbelief in the stork without an eruption of young oaths and cynicisms."
                                            },
                                            {
                                                "example_id": "8d8df236-c22a-4f54-bd33-4ad49f145202",
                                                "sense_id": "c042fc21-5f66-3217-b98a-6e2ed610c949",
                                                "text": "His later left-wing films prevented any pure and strong emotional attachment between the two sexes from gaining narrative momentum, which might reflect his gradual disbelief in romantic love."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "031bef29-f29e-4071-b7fd-12993491962e",
                        "source_entry_id": "57cc256e-d7e0-333a-92c1-a8c88bede64d",
                        "source_sense_id": "1c42ff40-cd8d-3168-bfa3-89bac3ccf972",
                        "target_lang_word": "distrust",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distrust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad7f9d98-247f-383b-9c38-e0b9a5da4801",
                                        "entry_id": "937844e8-36a4-3694-b5b0-f6f6a0115993",
                                        "glosses": [
                                            "Lack of trust or confidence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "distrust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb8de488-6b24-36e0-8cda-11cd9b0a74e4",
                                        "entry_id": "c262332e-1ae6-3af7-bdac-6b105e4de030",
                                        "glosses": [
                                            "To put no trust in; to have no confidence in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e956a15-f47d-4fa1-b438-bb402ef3b477",
                                                "sense_id": "cb8de488-6b24-36e0-8cda-11cd9b0a74e4",
                                                "text": "Lord Baelish, perhaps I was wrong to distrust you.\nPetyr Baelish (Aidan Gillen): Distrusting me was the wisest thing you've done since you climbed off your horse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c886bdf2-b1f3-41bd-a49a-3336372a9a3f",
                        "source_entry_id": "57cc256e-d7e0-333a-92c1-a8c88bede64d",
                        "source_sense_id": "1c42ff40-cd8d-3168-bfa3-89bac3ccf972",
                        "target_lang_word": "incredulity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incredulity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d42f089-f312-3945-b4d4-46b5e0f895d8",
                                        "entry_id": "066b0394-ce23-3878-800f-61c82876292a",
                                        "glosses": [
                                            "Unwillingness or inability to believe; doubt about the truth or verisimilitude of something; disbelief."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9d7626d-12bc-4dd1-8555-0d6918af2702",
                                                "sense_id": "4d42f089-f312-3945-b4d4-46b5e0f895d8",
                                                "text": "Wide went her eyes in wonder and incredulity, as she beheld this seeming apparition risen from the dead."
                                            },
                                            {
                                                "example_id": "a2bdd224-cc1a-4dc1-8270-b5e0c6c9f430",
                                                "sense_id": "4d42f089-f312-3945-b4d4-46b5e0f895d8",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            },
                                            {
                                                "example_id": "0434d5c8-ecc9-4539-abfc-0eafd6c2f0fc",
                                                "sense_id": "4d42f089-f312-3945-b4d4-46b5e0f895d8",
                                                "text": "At any other time Jessamy would have laughed at the expressions that chased each other over his freckled face: crossness left over from his struggle with the baby; incredulity; distress; and finally delight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85a4be68-2bcf-3cb3-9014-b725b94823f7",
                                        "entry_id": "066b0394-ce23-3878-800f-61c82876292a",
                                        "glosses": [
                                            "Religious disbelief; lack of faith."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "402a205c-5a08-450e-b98f-6593be187fb8",
                        "source_entry_id": "57cc256e-d7e0-333a-92c1-a8c88bede64d",
                        "source_sense_id": "1c42ff40-cd8d-3168-bfa3-89bac3ccf972",
                        "target_lang_word": "défiance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défiance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34b02a8e-6906-32be-b645-1dcf6b1b2397",
                                        "entry_id": "f7cfef6e-3eff-369c-9362-cd8bddc06650",
                                        "glosses": [
                                            "Sentiment de celui qui se défie de quelqu’un, de quelque chose, ou de lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a6c18ce-9544-4c31-afe4-c11052ddbb0a",
                                                "sense_id": "34b02a8e-6906-32be-b645-1dcf6b1b2397",
                                                "text": "Depuis le commencement de 1820, Cadiz est, aux yeux du gouvernement d’Espagne, en état de suspicion et de défiance."
                                            },
                                            {
                                                "example_id": "9c6c5c13-2e2e-4ef3-927a-4fb7fb598acc",
                                                "sense_id": "34b02a8e-6906-32be-b645-1dcf6b1b2397",
                                                "text": "Las enfin de voir mes instances inutiles, je fis servir ; alors ils se décidèrent à accoster, bientôt même ils montèrent à bord sans défiance."
                                            },
                                            {
                                                "example_id": "b29004dc-acc1-499a-9e3c-7a3fa3a0ac09",
                                                "sense_id": "34b02a8e-6906-32be-b645-1dcf6b1b2397",
                                                "text": "L'université de Paris a provoqué souvent les défiances de Rome."
                                            },
                                            {
                                                "example_id": "e0b3f912-bb9f-44d4-8fec-f78a923dda4d",
                                                "sense_id": "34b02a8e-6906-32be-b645-1dcf6b1b2397",
                                                "text": "Pour sonder son frère, Aristide, qui n’osait paraître inquiet ouvertement, se contenta de lui demander :\n— As-tu lu mon article d’hier ? Qu’en penses-tu ?\nEugène eut un léger mouvement d’épaules.\n— Vous êtes un niais, mon frère, répondit-il simplement.\n— Alors, s’écria le journaliste en pâlissant, tu donnes raison à Vuillet, tu crois au triomphe de Vuillet.\n— Moi !… Vuillet…\nIl allait certainement ajouter : « Vuillet est un niais comme toi. » Mais en apercevant la face grimaçante de son frère qui se tendait anxieusement vers lui, il parut pris d’une subite défiance."
                                            },
                                            {
                                                "example_id": "eec94b86-eae4-49ac-b2bc-61aa8cfb6c49",
                                                "sense_id": "34b02a8e-6906-32be-b645-1dcf6b1b2397",
                                                "text": "Les bourgeois d’une place eussent-ils voulu capituler, que la garnison se gardait contre eux et leur interdisait l’accès des tours et des courtines. C’est un système de défiance adopté envers et contre tous."
                                            },
                                            {
                                                "example_id": "69085e06-e4d2-4c57-a0a8-1c788099cb9f",
                                                "sense_id": "34b02a8e-6906-32be-b645-1dcf6b1b2397",
                                                "text": "Défiance est mère de sûreté, pour éviter d’être trompé, il faut ne pas donner légèrement sa confiance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e09aa8e-4049-3e71-ba29-975102a6fb10",
                                        "entry_id": "f7cfef6e-3eff-369c-9362-cd8bddc06650",
                                        "glosses": [
                                            "Défi, action de défier."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b7c8f1f-ddd8-4e1c-9ddb-3138fdc5bd12",
                                                "sense_id": "4e09aa8e-4049-3e71-ba29-975102a6fb10",
                                                "text": "On annonça qu’un héraut du comte de Ravenstein venait d’entrer dans la cour du château, apportant les défiances de son maître."
                                            },
                                            {
                                                "example_id": "d4ad9aea-bd43-46d4-b586-d36c16555c46",
                                                "sense_id": "4e09aa8e-4049-3e71-ba29-975102a6fb10",
                                                "text": "Dans un geste de défiance envers Donald Trump, engagé dans une lutte sans merci pour faire annuler sa défaite électorale, le chef de la majorité républicaine au Sénat, Mitch McConnell, a félicité Joe Biden et Kamala Harris pour leur victoire électorale et a demandé aux républicains de cesser leurs manœuvres pour tenter de renverser le résultat du scrutin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "défiance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dcd3ce48-c187-399e-a13b-3a9637cb162f",
                                        "entry_id": "ff8cae27-8878-314f-b16c-ae69b39a5868",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de défiancer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
