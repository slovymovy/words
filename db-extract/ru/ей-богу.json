                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "db98e7a2-5a87-35f8-9b2b-39536ee19fb5",
                        "entry_id": "0f26fe07-e66c-3d1f-8a69-7dd2dc701351",
                        "glosses": [
                            "возглас, выражающий уверенное подтверждение чего-либо или клятвенное заверение в чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d869ee2-2c25-47b0-8f41-8aab9cd44bb1",
                                "sense_id": "db98e7a2-5a87-35f8-9b2b-39536ee19fb5",
                                "text": "А оттуда домой иду ― на Марсовом поле навстречу мне человек в одном жилете, ей-Богу!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e32bc854-06f3-3c36-83aa-4ccb39b59fbb",
                        "entry_id": "0f26fe07-e66c-3d1f-8a69-7dd2dc701351",
                        "glosses": [
                            "выражает эмоциональное усиление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b73f31c-d572-47d8-8e71-ac297211a3cf",
                                "sense_id": "e32bc854-06f3-3c36-83aa-4ccb39b59fbb",
                                "text": "― Как вам не стыдно, Лиза, ей-Богу?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2c8c28a-0d2d-44c8-8b06-27cda375fee3",
