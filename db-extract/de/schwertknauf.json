                        "glosses": [
                            "Knauf als Teil eines Schwertgriffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f73d5e75-dc4a-466a-a244-46aa28bea302",
                                "sense_id": "07be14a7-91d7-394b-aabc-39e45b5f60b1",
                                "text": "„Er war ein kräftiger Mann in der bekannten Uniform und mit dem Gang der Prätorianer, und er schritt einher, die linke Hand auf dem blinkenden mit Silber beschlagenen Schwertknauf gestützt, und zwang nach Soldatenmanier alle ihm Entgegenkommenden zum Ausweichen.“"
                            },
                            {
                                "example_id": "eca64e23-eca4-4142-a80d-922a303f6aa1",
                                "sense_id": "07be14a7-91d7-394b-aabc-39e45b5f60b1",
                                "text": "„Hier wachten Ritter und Fürsten in Holz und Stein gewordenem Schmuck ihrer Rüstung und reichen Gewandung, breitbeinig feststehend, die Hand zuweilen auf den Schwertknauf gestützt, dort lehnte ein Stifterpaar in patrizischer Selbstsicherheit am Eingang einer Grotte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
