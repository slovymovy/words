                ],
                "senses": [
                    {
                        "sense_id": "95030172-ef11-3dec-a61d-2142c0b45e4c",
                        "entry_id": "fa28d4f6-bfe7-3b1d-833d-e7442df3c27f",
                        "glosses": [
                            "een lange vakantie in de zomer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e87cdb7-0365-4791-8eb6-9c9ab2f6098e",
                                "sense_id": "95030172-ef11-3dec-a61d-2142c0b45e4c",
                                "text": "Kinderen in de lagere school hebben tussen twee schooljaren een zomervakantie van zes weken."
                            },
                            {
                                "example_id": "92a3bd35-52fb-4b19-aafe-4b68e4afbd95",
                                "sense_id": "95030172-ef11-3dec-a61d-2142c0b45e4c",
                                "text": "Hij haalde een goed cijfer voor wiskunde, kreeg zelfs een ruime voldoende. Maar toen we afscheid namen voor de zomervakantie miste ik hem geen seconde."
                            },
                            {
                                "example_id": "abddd8bd-958a-48e9-a96e-a12a4ae31641",
                                "sense_id": "95030172-ef11-3dec-a61d-2142c0b45e4c",
                                "text": "Van de zomer zouden we het hoe dan ook niet nog een keer verknallen. Het ergste was dat het nog zo oneindig lang duurde tot de zomervakantie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67032b4a-b736-46eb-8cb7-144a013b6066",
                        "source_entry_id": "fa28d4f6-bfe7-3b1d-833d-e7442df3c27f",
                        "source_sense_id": "95030172-ef11-3dec-a61d-2142c0b45e4c",
                        "source_sense_description": "een lange vakantie in de zomer",
                        "target_lang_word": "Sommerferien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sommerferien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                        "entry_id": "8219c38f-e85e-3820-8501-c222b95111cb",
                                        "glosses": [
                                            "zusammenhängende unterrichtsfreie Tage im Sommer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c498506-9055-483f-bea0-77ffce7e13ee",
                                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                                "text": "In den Sommerferien fahren wir nach Italien."
                                            },
                                            {
                                                "example_id": "ddf33530-5696-4f0a-bafb-663a8d8e1fca",
                                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                                "text": "„Es ist das Ende der Sommerferien, jedenfalls für die, die das Glück haben, einer Arbeit nachgehen zu können, von der sie sich erholen müssen.“"
                                            },
                                            {
                                                "example_id": "273b7c58-d15b-4b36-a92a-492df6c1ae29",
                                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                                "text": "„Die Sommerferien erschienen ihm zu lang.“"
                                            },
                                            {
                                                "example_id": "0aaacb1f-357b-4906-b8d3-18923d8f774a",
                                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                                "text": "„Die Sommerferien erschienen uns unendlich lang.“"
                                            },
                                            {
                                                "example_id": "6b5674b9-f62b-4632-ad0b-bc6ce9e14254",
                                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                                "text": "„Es folgen die ersten Sommerferien im Kinderdorf.“"
                                            },
                                            {
                                                "example_id": "68d2d7cf-4c79-42eb-a74e-66de49dfdfd7",
                                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                                "text": "„Zur Einstimmung in die Sommerferien hatte Renate sich Asterix in Spanien gekauft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
