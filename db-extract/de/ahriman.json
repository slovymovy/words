                            {
                                "example_id": "0889e8c0-8064-4ea7-85b7-801165c2f9fa",
                                "sense_id": "0fd1e4ec-f2c1-3b80-8acc-61cb5a5d3529",
                                "text": "„Die Mohameddaner, die seine Dämonen anbetenden Anhänger hassen, sagen, er sei der Ursprung alles Bösen im Universum - der Prinz der Finsternis - Ahriman - die uralte Schlange - der leibhaftige Satan!“"
                            },
                            {
                                "example_id": "449aed5b-9b5b-47ee-80a4-7522a47dcee5",
                                "sense_id": "0fd1e4ec-f2c1-3b80-8acc-61cb5a5d3529",
                                "text": "„Aus einer Zelle in der Nähe ruft ein Junge: ›Das war Ahriman, bloß so ein Dämon aus der iranischen Wüste.‹“"
                            }
                        ],
