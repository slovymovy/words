                        "sense_id": "65c3fd7f-f689-3b57-b125-5ae673ae7419",
                        "entry_id": "351ff501-9ea2-361b-b99a-c5cbdb44571e",
                        "glosses": [
                            "subtiel verschil aangeven; het nuanceren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9690ecd0-9985-4265-87a1-e21412d40ae5",
                                "sense_id": "65c3fd7f-f689-3b57-b125-5ae673ae7419",
                                "text": "Ze wordt onderscheiden om ,\"haar gerijpte, doorleefde karakterisering en stijl en de nuancering in haar grote, als vanzelfsprekende, danstechnische vaardigheden."
                            },
                            {
                                "example_id": "45aa6f7d-e989-4d7c-8e2f-a413216bc934",
                                "sense_id": "65c3fd7f-f689-3b57-b125-5ae673ae7419",
                                "text": "Ik heb zelf soms de wellicht naïeve gedachte dat taal is uitgevonden om vrede te stichten. Met knotsen het bijlen was het namelijk moeilijk nuanceringen in een redenering aan te brengen."
                            },
                            {
                                "example_id": "4c954980-5033-4390-9d49-649f97e8dbc9",
                                "sense_id": "65c3fd7f-f689-3b57-b125-5ae673ae7419",
                                "text": "De BV Nederland loopt gevaar en dient nog beter beschermd te worden. Althans, dit is wat men de Nederlandse samenleving wil laten geloven. Ruimte voor enige nuancering lijkt niet geboden, Internationale hedgefundmanagers worden weggezet als hijgerige 'kortetermijn-$hareholders'."
                            }
                        ]
                    }
