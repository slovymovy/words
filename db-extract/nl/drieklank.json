                    },
                    {
                        "translation_id": "4e0bbe73-83fb-4cfe-b139-ce983000a406",
                        "source_entry_id": "c81ba41f-ff46-3ec5-8736-0fc4863a47b4",
                        "source_sense_id": "a79e5a91-144a-322e-9cbf-69fe63676a8f",
