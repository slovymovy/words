{
    "word_family": [
        "zapper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1acdf7b4-b0e4-3d3c-b862-741f5aef0ef9",
                    "sense_definition": "A sudden, small electric shock.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You might feel a little <w>zap</w> when touching a metal doorknob in dry weather.",
                            "target_lang_translations": {
                                "tr": "Kuru havalarda metal bir kapı koluna dokunduğunuzda küçük bir <w>elektrik çarpması</w> hissedebilirsiniz."
                            }
                        },
                        {
                            "text": "The static <w>zap</w> from the carpet surprised the child.",
                            "target_lang_translations": {
                                "tr": "Halıdan gelen statik <w>çarpılma</w> çocuğu şaşırttı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Ani ve küçük bir elektrik çarpması."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "elektrik çarpması",
                                "target_lang_sense_clarification": "Statik elektrik veya küçük bir şok için kullanılır."
                            },
                            {
                                "target_lang_word": "çarpılma",
                                "target_lang_sense_clarification": "Ani bir elektrik boşalması hissi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e708f5fb-352b-3ad6-8269-d0363a8a46e5",
                    "sense_definition": "The act of heating food in a microwave oven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leftovers just need a quick <w>zap</w> in the microwave.",
                            "target_lang_translations": {
                                "tr": "Artan yemeklerin mikrodalgada hızlıca bir <w>ısıtılması</w> yeterli."
                            }
                        },
                        {
                            "text": "Give the soup a <w>zap</w> for thirty seconds to make it hot.",
                            "target_lang_translations": {
                                "tr": "Çorbayı ısıtmak için otuz saniye <w>mikrodalgaya atın</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yiyeceği mikrodalga fırında ısıtma eylemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "mikrodalgada ısıtma",
                                "target_lang_sense_clarification": "Yiyecekleri mikrodalgada hızlıca ısıtma işlemi."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b3ea182-6555-3464-811a-08fb2e8a373a",
                    "sense_definition": "To strike something with electricity or energy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The science fiction hero used a laser gun to <w>zap</w> the alien robots.",
                            "target_lang_translations": {
                                "tr": "Bilim kurgu kahramanı, uzaylı robotları <w>elektrikle vurmak</w> için lazer silahı kullandı."
                            }
                        },
                        {
                            "text": "Be careful not to <w>zap</w> yourself while fixing the old lamp.",
                            "target_lang_translations": {
                                "tr": "Eski lambayı tamir ederken kendini <w>çarpma</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi elektrik veya enerji ile vurmak veya çarpmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "elektrik vermek",
                                "target_lang_sense_clarification": "Bir nesneye veya kişiye elektrik akımı uygulamak."
                            },
                            {
                                "target_lang_word": "çarpmak",
                                "target_lang_sense_clarification": "Elektrik şoku vermek anlamında."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19e64699-ceab-37c0-933c-d0ae96aec5e7",
                    "sense_definition": "To heat food in a microwave oven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the coffee is cold, just <w>zap</w> it for a few seconds.",
                            "target_lang_translations": {
                                "tr": "Eğer kahve soğuksa, birkaç saniyeliğine <w>mikrodalgada ısıt</w>."
                            }
                        },
                        {
                            "text": "I usually <w>zap</w> my frozen dinner when I am in a hurry.",
                            "target_lang_translations": {
                                "tr": "Acelem olduğunda genellikle dondurulmuş yemeğimi <w>mikrodalgada ısıtırım</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yiyeceği mikrodalga fırında ısıtmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "mikrodalgada ısıtmak",
                                "target_lang_sense_clarification": "Yiyecekleri mikrodalga fırın kullanarak ısıtmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29cf6cdd-4fef-3d05-9063-0c127d2bfca7",
                    "sense_definition": "To use a remote control to repeatedly change television channels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "television",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He likes to <w>zap</w> through the channels during commercial breaks.",
                            "target_lang_translations": {
                                "tr": "Reklam aralarında kanallar arasında <w>hızlıca geçiş yapmayı</w> sever."
                            }
                        },
                        {
                            "text": "Stop <w>zapping</w> and just pick a movie to watch.",
                            "target_lang_translations": {
                                "tr": "Kanal <w>değiştirmeyi</w> bırak ve izlemek için bir film seç."
                            }
                        }
                    ],
                    "synonyms": [
                        "channel surf",
                        "channel hop"
                    ],
                    "target_lang_definitions": {
                        "tr": "Televizyon kanalları arasında sürekli geçiş yapmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kanal değiştirmek",
                                "target_lang_sense_clarification": "Kumanda ile kanallar arasında hızlıca gezinmek."
                            },
                            {
                                "target_lang_word": "kanal sörfü yapmak",
                                "target_lang_sense_clarification": "Televizyon kanalları arasında hızlıca dolaşmak."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "810ba176-4b84-31c5-a0e5-8a55478a9665",
                    "sense_definition": "A word representing the sound of a sudden action or energy release.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comic book read <w>zap</w> as the hero fired his weapon.",
                            "target_lang_translations": {
                                "tr": "Kahraman silahını ateşlediğinde çizgi romanda <w>çat</w> yazıyordu."
                            }
                        },
                        {
                            "text": "The computer screen went <w>zap</w> and then turned completely black.",
                            "target_lang_translations": {
                                "tr": "Bilgisayar ekranı <w>çat</w> diye bir ses çıkardı ve tamamen karardı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Ani bir hareketin veya enerji boşalmasının çıkardığı sesi temsil eden sözcük."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çat",
                                "target_lang_sense_clarification": "Ani bir elektrik veya patlama sesini yansıtan yansıma sözcük."
                            },
                            {
                                "target_lang_word": "vın",
                                "target_lang_sense_clarification": "Hızlı bir enerji hareketini temsil eden yansıma sözcük."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "af41d8ca-0a86-37c2-ba3a-d628afb26a5e",
                    "sense_definition": "A city in North Dakota.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small town of <w>Zap</w> on their way west.",
                            "target_lang_translations": {
                                "tr": "Batıya giderken küçük <w>Zap</w> kasabasından geçtiler."
                            }
                        },
                        {
                            "text": "The population of <w>Zap</w> is quite small.",
                            "target_lang_translations": {
                                "tr": "<w>Zap</w>'ın nüfusu oldukça azdır."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kuzey Dakota'da bir şehir."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Zap",
                                "target_lang_sense_clarification": "Özel isim olduğu için çevrilmez."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}