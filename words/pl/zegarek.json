                    "sense_id": "b97962e2-dac7-3e18-89c9-3192a79f71ce",
                    "sense_definition": "przenośny przyrząd do mierzenia czasu, noszony zwykle na ręku lub w kieszeni",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój <w>zegarek</w> spóźnia się o pięć minut.",
                            "target_lang_translations": {
                                "ru": "Мои <w>часы</w> отстают на пять минут.",
                                "en": "My <w>watch</w> is five minutes slow.",
                                "nl": "Mijn <w>horloge</w> loopt vijf minuten achter.",
                                "de": "Meine <w>Uhr</w> geht fünf Minuten nach.",
                                "fr": "Ma <w>montre</w> retarde de cinq minutes.",
                                "it": "Il mio <w>orologio</w> ritarda di cinque minuti.",
                                "cs": "Moje <w>hodinky</w> se zpožďují o pět minut.",
                                "tr": "Benim <w>saatim</w> beş dakika geri kalıyor.",
                                "es": "Mi <w>reloj</w> se retrasa cinco minutos.",
                                "zh": "我的<w>表</w>慢了五分钟。"
                            }
                        },
                        {
                            "text": "Dostałem nowy <w>zegarek</w> na rękę od rodziców.",
                            "target_lang_translations": {
                                "ru": "Я получил от родителей новые наручные <w>часы</w>.",
                                "en": "I got a new <w>wristwatch</w> from my parents.",
                                "nl": "Ik heb van mijn ouders een nieuw <w>polshorloge</w> gekregen.",
                                "de": "Ich habe von meinen Eltern eine neue <w>Armbanduhr</w> bekommen.",
                                "fr": "J'ai reçu une nouvelle <w>montre</w> de mes parents.",
                                "it": "Ho ricevuto dai miei genitori un nuovo <w>orologio da polso</w>.",
                                "cs": "Dostal jsem od rodičů nové náramkové <w>hodinky</w>.",
                                "tr": "Ailemden yeni bir <w>kol saati</w> hediye aldım.",
                                "es": "Mis padres me regalaron un nuevo <w>reloj de pulsera</w>.",
                                "zh": "我从父母那里收到了一块新的<w>手表</w>。"
                            }
