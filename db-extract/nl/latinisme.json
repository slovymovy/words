                "senses": [
                    {
                        "sense_id": "d20d92e5-885c-38d5-aa4a-d287bcc718ae",
                        "entry_id": "c1fb2a9e-820b-3229-99fa-c9b4f5085df7",
                        "glosses": [
                            "woord of uitdrukking overgenomen uit het Latijn of gevormd naar Latijns voorbeeld"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a16eba05-a4c0-42fe-b740-8131d9157825",
                                "sense_id": "d20d92e5-885c-38d5-aa4a-d287bcc718ae",
                                "text": "Maar hij heeft kennelijk ook geen bezwaar tegen modieuze latinismen als 'non-participatie', 'ametrisch' of 'inertie'."
                            },
                            {
                                "example_id": "c3eba238-3249-41fe-8195-7665f24271ed",
                                "sense_id": "d20d92e5-885c-38d5-aa4a-d287bcc718ae",
                                "text": "Zo is een latinisme een nabootsing van een Latijnse constructie: Elk meent zijn uil een valk te zijn; ijs en weder dienende gaan we morgen schaatsen (accus. cum infinitivo; ablativus absolutus)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9636c19-d31c-4970-a9bb-0875b8a438bf",
                        "source_entry_id": "c1fb2a9e-820b-3229-99fa-c9b4f5085df7",
                        "source_sense_id": "d20d92e5-885c-38d5-aa4a-d287bcc718ae",
                        "source_sense_description": "woord of uitdrukking overgenomen uit het Latijn of gevormd naar Latijns voorbeeld",
                        "target_lang_word": "Latinismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Latinismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40f4d7f6-c8a4-3cf5-8bfc-f0c5d999be28",
                                        "entry_id": "6286f2cd-a80d-3512-8caf-7638aa85e6d4",
                                        "glosses": [
                                            "Ausdruck des Lateinischen, der in eine andere Sprache entlehnt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90574ed8-14b0-4181-9f15-dc0af571c71e",
                                                "sense_id": "40f4d7f6-c8a4-3cf5-8bfc-f0c5d999be28",
                                                "text": "„Erwähnt wurde in der Abfolge der wesentlichen Stationen in der geschichtlichen Entwicklung auch der Allgemeine Deutsche Sprachverein, der Latinismen aus der Verwaltungssprache eliminiert habe.“"
                                            },
                                            {
                                                "example_id": "2c6346ac-672f-4cae-a096-263e5016e086",
                                                "sense_id": "40f4d7f6-c8a4-3cf5-8bfc-f0c5d999be28",
                                                "text": "„Während Latinismen und Gräzismen noch immer überwiegend den Wortschätzen in Bildung und Wissenschaft angehören und Gallizismen sich vor allem im Vokabular von Lifestyle und Kulinarik vermehren, finden sich Anglizismen buchstäblich überall, von der Jugendsprache bis zur Informatik, vom Bankeridiom bis zur Werbung.“"
                                            },
                                            {
                                                "example_id": "e012c53b-8081-42a1-badc-6c61a69bba5b",
                                                "sense_id": "40f4d7f6-c8a4-3cf5-8bfc-f0c5d999be28",
                                                "text": "„Sie redeten in ihrer Schülersprache davon, ihre Sätze waren mit Latinismen gespickt und auch im Gebrauch von Ausdrücken wie »kolossal« oder »fein mit Ei« waren sie nicht schüchtern.“"
                                            },
                                            {
                                                "example_id": "65500bf9-6af7-4a49-80e1-66def8b5f00f",
                                                "sense_id": "40f4d7f6-c8a4-3cf5-8bfc-f0c5d999be28",
                                                "text": "„Da Casanova, obwohl Italiener, französisch schreibe, so argumentiert der Redaktor, sei der Text voller grammatischer Fehler, voller Italianismen und Latinismen; außerdem nenne der Autor alle Dinge bei ihrem Namen.“"
                                            },
                                            {
                                                "example_id": "e2d334dd-ddfb-49de-b7b6-145aa7de234c",
                                                "sense_id": "40f4d7f6-c8a4-3cf5-8bfc-f0c5d999be28",
                                                "text": "„Etliche andere Gräzismen und Latinismen sind in der fremdsprachigen Schreibung seit jeher ohne Varianz geblieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14651f4b-0c5d-4959-88a8-59933f01766f",
                        "source_entry_id": "c1fb2a9e-820b-3229-99fa-c9b4f5085df7",
                        "source_sense_id": "d20d92e5-885c-38d5-aa4a-d287bcc718ae",
