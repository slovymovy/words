                        "examples": [
                            {
                                "example_id": "9debcb8f-ff19-4c6a-b3c3-5950bb06b480",
                                "sense_id": "1f125b04-b5ad-3301-8daf-8b95cec0e6b0",
                                "text": "Ryght soo departed Galahad / Percyual / and Bors with hym / and soo they rode thre dayes / and thenne they came to a Ryuage and fonde the shyp[…]/ And whanne they cam to the borde / they fonde in the myddes the table of syluer / whiche they had lefte with the maymed kynge and the Sancgreal whiche was couerd with rede samyte"
                            },
                            {
                                "example_id": "f6b3f0ca-44cc-4c1f-ab68-258b0470e13a",
                                "sense_id": "1f125b04-b5ad-3301-8daf-8b95cec0e6b0",
                                "text": "Pactolus with his waters shere\nThrowes forth upon the rivage"
                            },
                            {
                                "example_id": "e3ee3af6-ab3e-4cac-94f3-adcd1f3dd2bd",
                                "sense_id": "1f125b04-b5ad-3301-8daf-8b95cec0e6b0",
                                "text": "From the green rivage many a fall / Of diamond rillets musical, […]"
                            },
                            {
                                "example_id": "fafcf26f-7645-449d-b19e-3ab181b421a0",
                                "sense_id": "1f125b04-b5ad-3301-8daf-8b95cec0e6b0",
                                "text": "[…] leaves have taken flight\nFrom yon\nSlim seedling-birch on the rivage, the flock\nOf herons has the quiet of solitude […]"
                            }
                        ]
                    },
