                "senses": [
                    {
                        "sense_id": "950c35e4-4914-3190-b29d-ad1579dc577c",
                        "entry_id": "3002e3d8-4ddc-30f2-9902-f9fcb0c003a9",
                        "glosses": [
                            "periodischer Ablauf der Existenz eines Lebewesens oder Gegenstandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5223b7ad-9a57-49f1-87d4-523f5b959067",
                                "sense_id": "950c35e4-4914-3190-b29d-ad1579dc577c",
                                "text": "Tod und Wiedergeburt ist in fernöstlichen Religionen der ewige Lebenszyklus."
                            },
                            {
                                "example_id": "d06a252a-f561-43aa-a915-86802a5e3219",
                                "sense_id": "950c35e4-4914-3190-b29d-ad1579dc577c",
                                "text": "Die nächste Kollision in ferner Zukunft werde das Universum wieder so erschüttern, dass sein jetziger Lebenszyklus endet und ein neuer beginnt."
                            },
                            {
                                "example_id": "7b8e9c7a-da75-47d0-bdb6-8d6f03a3cfc3",
                                "sense_id": "950c35e4-4914-3190-b29d-ad1579dc577c",
                                "text": "Wellmer: Jeder Rohstoff und jedes Rohstofflager durchläuft einen typischen Lebenszyklus: Zunächst steigt die Förderung, dann verharrt sie auf einem Plateau, um anschließend zu sinken."
                            },
                            {
                                "example_id": "267a78b2-83aa-40a0-afe1-ca8cbe1f5573",
                                "sense_id": "950c35e4-4914-3190-b29d-ad1579dc577c",
                                "text": "[2025:] „[…] Die Zukunft gehört dem Elektroauto. Es stößt im Betrieb kein CO2 aus und ist über seinen gesamten Lebenszyklus deutlich klimafreundlicher als ein Verbrenner.“"
                            },
                            {
                                "example_id": "a129040c-5e43-4c01-ac24-c8f64da07dc6",
                                "sense_id": "950c35e4-4914-3190-b29d-ad1579dc577c",
                                "text": "Ein Seidenspinner gehört zur Ordnung der Schmetterlinge. Ein ganzer Lebenszyklus dauert etwa 6 Wochen."
                            },
                            {
                                "example_id": "16670e53-e814-40c4-aa1e-93f25cc6c67b",
                                "sense_id": "950c35e4-4914-3190-b29d-ad1579dc577c",
                                "text": "Der Lebenszyklus von Prozessen ist eng mit dem Zustand seiner Threads verknüpft und beginnt im Zustand ready."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd63ea00-d460-42f5-91b3-8cbee9d02dee",
                        "source_entry_id": "3002e3d8-4ddc-30f2-9902-f9fcb0c003a9",
                        "source_sense_id": "950c35e4-4914-3190-b29d-ad1579dc577c",
                        "source_sense_description": "periodischer Ablauf der Existenz eines Lebewesens oder Gegenstandes",
                        "target_lang_word": "life cycle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "life cycle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6def6ef8-3d5f-3e01-a674-68fedcb7238e",
                                        "entry_id": "a557eb55-bbef-3142-a968-fe5e3af30b33",
                                        "glosses": [
                                            "The course of stages through which an organism passes from fertilized zygote until maturity, reproduction, and death."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0426f901-d62c-4fc1-9ef8-4c011ce49873",
                                                "sense_id": "6def6ef8-3d5f-3e01-a674-68fedcb7238e",
                                                "text": "Plants’ life cycles are an attractive subject of study for citizen science because they are relatively easy to discern. In fact, the name for the field in which we work, phenology, literally means “the science of appearance.” The word was coined just a few years after Thoreau made his phenological observations, from the Greek phaino (to show or appear) and logos (to study)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62c43499-a4d5-319f-b106-461391da0207",
                                        "entry_id": "a557eb55-bbef-3142-a968-fe5e3af30b33",
                                        "glosses": [
                                            "The useful life of a product or system; the developmental history of an individual or group in society."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5cce03b-10be-4834-b761-a57027b888a7",
                                                "sense_id": "62c43499-a4d5-319f-b106-461391da0207",
                                                "text": "Since it began operating in 1950, Sellafield has had different duties. First it manufactured plutonium for nuclear weapons. Then it generated electricity for the National Grid, until 2003. It also carried out years of fuel reprocessing: extracting uranium and plutonium from nuclear fuel rods after they’d ended their life cycles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
