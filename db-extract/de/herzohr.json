                "senses": [
                    {
                        "sense_id": "901f9a45-b4b4-3182-9884-51a9f388f7c8",
                        "entry_id": "5f2b39da-4472-3dd5-8fff-2c5bee4e90f4",
                        "glosses": [
                            "an den Vorhöfen befindliche Ausstülpungen beim Herzen von Menschen und Säugetieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa6838c-f25e-4384-9bd7-e578e343a350",
                                "sense_id": "901f9a45-b4b4-3182-9884-51a9f388f7c8",
                                "text": "„Der Ramus circumflexus (RCX) zieht am linken Herzohr weiter zum linken Herzrand.“"
                            },
                            {
                                "example_id": "28b482fa-f244-4f51-8027-ee71fbcd7a93",
                                "sense_id": "901f9a45-b4b4-3182-9884-51a9f388f7c8",
                                "text": "„Das rechte Herzohr wird entfernt und eine senkrechte Inzision in den rechten Vorhofgelegt.“"
                            },
                            {
                                "example_id": "13600a43-bc58-4964-973b-8f2a6340159d",
                                "sense_id": "901f9a45-b4b4-3182-9884-51a9f388f7c8",
                                "text": "„Sie bilden je eine nach links gerichtete, dreieckige Ausstülpung, das Herzohr, die Auricula dextra et sinistra.“"
                            },
                            {
                                "example_id": "899b7c24-6f6c-4f4f-b5ea-f8bafc9f7625",
                                "sense_id": "901f9a45-b4b4-3182-9884-51a9f388f7c8",
                                "text": "„Herzohr ist nunmehr im sagittalen Durchmesser gelegen und erscheint daher bei der Ansicht von vorn in starker Verkürzung.“"
                            },
                            {
                                "example_id": "b647c78d-355a-4dac-9d8e-e7b3ad28af10",
                                "sense_id": "901f9a45-b4b4-3182-9884-51a9f388f7c8",
                                "text": "„Das rechte Herzohr hat eine nahezu dreieckige Form und liegt neben der aufsteigenden Aorta.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
