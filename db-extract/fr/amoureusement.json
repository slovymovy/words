        "fr-extract.jsonl": [
            {
                "entry_id": "9163e3d1-50f9-3df7-820b-d92c3b00791b",
                "word": "amoureusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b27eb1c2-0af3-3b5f-b6f8-33e8c601deb6",
                        "entry_id": "9163e3d1-50f9-3df7-820b-d92c3b00791b",
                        "glosses": [
                            "Avec amour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c25f8c8b-5aeb-42df-b926-c158be2d9e4a",
                                "sense_id": "b27eb1c2-0af3-3b5f-b6f8-33e8c601deb6",
                                "text": "Sa langue, d’une mobilité étonnante, courait amoureusement sur ses lèvres comme si elle se promettait de goûter à toutes les félicités d’ici-bas."
                            },
                            {
                                "example_id": "ecbe1b4b-3494-46de-a38e-b3a608ebce9a",
                                "sense_id": "b27eb1c2-0af3-3b5f-b6f8-33e8c601deb6",
                                "text": "Elle faisait fondre chacun en larmes, en se jetant amoureusement sur le corps de cette mourante, qu’elle appelait sa chère mère."
                            },
                            {
                                "example_id": "272b1df0-b873-46b8-90fb-780b2845f69e",
                                "sense_id": "b27eb1c2-0af3-3b5f-b6f8-33e8c601deb6",
                                "text": "Il ne doit pas accuser de la violence qu’il souffre la mère qui le retient amoureusement, mais ses injustes ravisseurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "59a08951-89f0-3efb-9bc4-d610f4eb916a",
                        "entry_id": "9163e3d1-50f9-3df7-820b-d92c3b00791b",
                        "glosses": [
                            "Avec un soin jaloux ; soigneusement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87175e3d-07d0-4a9d-b90d-bac5fe9dc6f9",
                                "sense_id": "59a08951-89f0-3efb-9bc4-d610f4eb916a",
                                "text": "Leur camp était alors situé aux environs, et ils venaient à l'aurore et au crépuscule, avant et après leur pesant labeur forcé, travailler amoureusement à leur petite église."
                            },
                            {
                                "example_id": "5d9d6e2c-4042-439c-8c7c-54bb3dab9ffe",
                                "sense_id": "59a08951-89f0-3efb-9bc4-d610f4eb916a",
                                "text": "Elle se passionnait pour la botanique depuis le jour où, encore petite fille, elle avait vu Joshua Pershore, le jardinier de ses parents, passer des heures à soigner amoureusement ses fleurs et ses légumes."
                            }
                        ]
                    },
                    {
                        "sense_id": "07977c3d-49c0-3f51-984f-e29fd5379efb",
                        "entry_id": "9163e3d1-50f9-3df7-820b-d92c3b00791b",
                        "glosses": [
                            "Avec grâce et délicatesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71021bdc-8b74-4407-8520-842939d6871f",
                                "sense_id": "07977c3d-49c0-3f51-984f-e29fd5379efb",
                                "text": "Ce petit tableau est peint amoureusement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30a7994f-1417-4902-81ea-df25aff2df15",
                        "source_entry_id": "9163e3d1-50f9-3df7-820b-d92c3b00791b",
                        "target_lang_word": "liebevoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liebevoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa6ed33-f523-32c0-8cac-5478a5f4e7e3",
                                        "entry_id": "487ca11f-5a9d-3664-9ee8-0914ad29a224",
                                        "glosses": [
                                            "voller Liebe, Zuneigung zu jemandem, mit großer innerer Anteilnahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "defd1340-6124-4f8c-8314-92470f6981e3",
                                                "sense_id": "2fa6ed33-f523-32c0-8cac-5478a5f4e7e3",
                                                "text": "Sie waren immer liebevolle Eltern."
                                            },
                                            {
                                                "example_id": "c12b37fd-fded-4dfa-8dd4-9f2ff7c7ed3b",
                                                "sense_id": "2fa6ed33-f523-32c0-8cac-5478a5f4e7e3",
                                                "text": "Er ist seinen Kinder ein liebevoller Vater."
                                            },
                                            {
                                                "example_id": "805a7404-4408-423c-8f16-d083ea15b703",
                                                "sense_id": "2fa6ed33-f523-32c0-8cac-5478a5f4e7e3",
                                                "text": "Sie blickte ihren kleinen Sohn zärtlich an und gab ihm noch einen liebevollen Gutenachtkuss. „Schlaf schön,“ sagte sie und ging hinaus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "25ebc65d-2ec3-3dd0-963b-f7ddedb49381",
                                        "entry_id": "487ca11f-5a9d-3664-9ee8-0914ad29a224",
                                        "glosses": [
                                            "mit großer Hingebung erstellt, mit großer Achtsamkeit vollbracht"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2402e23-239c-4ae0-a445-896714e4206c",
                        "source_entry_id": "9163e3d1-50f9-3df7-820b-d92c3b00791b",
                        "target_lang_word": "sorgfältig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorgfältig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7d7120d-3aee-3012-a248-d0037cd06e41",
                                        "entry_id": "3a6ec86f-f6f6-37f7-b675-5338302b751c",
                                        "glosses": [
                                            "mit großer Achtsamkeit und Sorgfalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd398f6c-42fa-478e-863d-e03d6d1d7a53",
                                                "sense_id": "e7d7120d-3aee-3012-a248-d0037cd06e41",
                                                "text": "Die Nachrichten sind neue, wahrheitsmäßig und sorgfältig wiedergegebene Informationen."
                                            },
                                            {
                                                "example_id": "58ac83fc-5282-4860-af65-5c7217d89dd5",
                                                "sense_id": "e7d7120d-3aee-3012-a248-d0037cd06e41",
                                                "text": "„Das Licht im Patio war sorgfältig arrangiert, damit es den Damen schmeichelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e364e15-1fd0-4d0e-a49e-998932dc5bf2",
