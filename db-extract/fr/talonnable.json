                        "entry_id": "675bd98a-a2f2-3a29-b832-3d47d977b942",
                        "glosses": [
                            "Qualifie un aiguillage qui peut être franchi par le talon (le côté opposé à la pointe), sans avoir à manœuvrer l'aiguille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02dc3896-1fab-4f7c-88d6-6dfd740bb347",
                                "sense_id": "1706d704-c31c-38ef-8df8-f2ceb66f58d1",
                                "text": "Lorsque le calage est talonnable, il est animé pendant la manœuvre, avec l'aiguille entrebâillée, d'une vitesse plus grande qu'il n'est nécessaire; mais cette vitesse permet à la masse d'entraîner, dès le commencement de son mouvement, l'aiguille collée montre le rail contre-aiguille."
                            },
                            {
                                "example_id": "94a65ad8-8088-497a-b5dc-5ed8b81c6761",
                                "sense_id": "1706d704-c31c-38ef-8df8-f2ceb66f58d1",
                                "text": "Les aiguilles d'entrée, talonnables dans leurs deux positions, sont disposées pour donner accès à la voie habituelle de circulation."
                            }
                        ]
                    }
