                    },
                    {
                        "sense_id": "6a6d6008-56be-3726-bdc7-e22d33949618",
                        "entry_id": "06e5d61a-8ff2-3a37-9ee3-01dcaed6c153",
                        "glosses": [
                            "Celui qui fait essayer un vêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f28ed29c-ef52-4ec2-9998-26056cae216b",
                                "sense_id": "6a6d6008-56be-3726-bdc7-e22d33949618",
                                "text": "Duchotel.— Je te demande s’il y en a long, parce que je vais te dire, l’essayeur m’attend."
                            }
                        ]
                    },
                    {
                        "sense_id": "67b29245-499c-336b-b413-fb9e3787f1e9",
                        "entry_id": "06e5d61a-8ff2-3a37-9ee3-01dcaed6c153",
                        "glosses": [
                            "Employé qui, à la monnaie, fait l’essai des matières d’or et d’argent destinées à la fabrication et vérifie si elles sont au titre auquel elles doivent être."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d49b08f8-f830-439c-bb2d-cf00e99594ed",
                                "sense_id": "67b29245-499c-336b-b413-fb9e3787f1e9",
                                "text": "L’office (et charge) de l’essayeur fut contresigné par son titulaire Maître Jehan Morel, orfèvre et bourgeois de Montbéliard, après prestation du même serment le 15 janvier 1585 (style ancien)."
                            }
                        ]
                    }
