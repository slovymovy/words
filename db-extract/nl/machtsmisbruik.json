                    {
                        "sense_id": "2117b3d1-b1f8-39da-9222-d9a56fda412c",
                        "entry_id": "eb61dfb6-c6c6-3e41-8b8b-7494403d9ad4",
                        "glosses": [
                            "het gebruiken van macht voor doeleinden waarvoor het niet bedoeld is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d36b157-97cf-4699-98b9-455a089ee341",
                                "sense_id": "2117b3d1-b1f8-39da-9222-d9a56fda412c",
                                "text": "De Saudische politie meldt dat koning Salman de aanhouding van prins Saud bin Musa’id beval voor mishandeling. Hij wil met de arrestatie aantonen dat geen enkele overtreding of geweldpleging ongestraft mag blijven en dat ‘afkomst, conditie of status er niets toe doet’. De koning maant zijn bevolking ook aan om waakzaam te blijven en machtsmisbruik te melden."
                            },
                            {
                                "example_id": "577917ad-d014-4fc9-bb68-103afe57a5f9",
                                "sense_id": "2117b3d1-b1f8-39da-9222-d9a56fda412c",
                                "text": "Amnesty International noemt de arrestatie van Eser en de andere mensenrechtenactivisten in een verklaring „grotesk machtsmisbruik” en roept op tot hun onmiddellijke vrijlating."
                            },
                            {
                                "example_id": "88f5c7c6-3ef0-4024-9869-bcff96fc1365",
                                "sense_id": "2117b3d1-b1f8-39da-9222-d9a56fda412c",
                                "text": "Na het protest gisteren op de Dam in Amsterdam worden ook vandaag en morgen in onder meer Den Haag, Groningen en Rotterdam demonstraties gehouden tegen racisme en machtsmisbruik door de politie. Maar kunnen zulke grote protesten wel als je de anderhalve-meter-regels in acht wil nemen?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40a40270-4ff5-4c19-810b-42d79b64b7c1",
                        "source_entry_id": "eb61dfb6-c6c6-3e41-8b8b-7494403d9ad4",
                        "source_sense_id": "2117b3d1-b1f8-39da-9222-d9a56fda412c",
                        "source_sense_description": "het gebruiken van macht voor doeleinden waarvoor het niet bedoeld is",
                        "target_lang_word": "Machtmissbrauch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Machtmissbrauch",
