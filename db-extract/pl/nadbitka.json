                                "target_senses": [
                                    {
                                        "sense_id": "aa014760-022a-3dbe-9ea3-5a8492143a8d",
                                        "entry_id": "ba91423d-d011-3750-ba2e-5c339b9fbdbd",
                                        "glosses": [
                                            "Extraausgabe einer kleineren Schrift (Aufsatz, Rezension,…) in geringer Auflage, die dem Autor vom Verlag für die Verteilung an Kollegen und sonstige Interessierte zur Verfügung gestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38d947ca-9d92-44c7-bfad-281562bd56f0",
                                                "sense_id": "aa014760-022a-3dbe-9ea3-5a8492143a8d",
                                                "text": "„Es sind Sonderdrucke zweier Aufsätze von Turing, die der Autor auf Anfrage eines münsterschen Professors ins Westfälische sandte.“"
                                            },
                                            {
                                                "example_id": "e982a356-d1de-4f8b-947f-01c1bb9dafa6",
                                                "sense_id": "aa014760-022a-3dbe-9ea3-5a8492143a8d",
                                                "text": "„Am Anfang, als Assistent und Privatdozent, hatte er auf jeden Sonderdruck mit einem Brief reagiert, der oft die Länge einer Rezension hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
