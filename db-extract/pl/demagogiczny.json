                                        "glosses": [
                                            "Of or pertaining to demagogy or a demagogue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13e88258-17b9-46ec-9bcc-ec5850a09caa",
                                                "sense_id": "9c26664f-ad0b-3112-87a3-1d196c6ed0ca",
                                                "text": "Politicians knew that the law [barring HIV-positive immigrants] would do nothing to stop the spread of AIDS, and that medical experts agreed the law would actually facilitate it. But politicians did know a cheap and demagogic way to \"do something\" about AIDS."
                                            },
                                            {
                                                "example_id": "76590a5e-febc-42b5-918e-3f1c9ca2fcc2",
                                                "sense_id": "9c26664f-ad0b-3112-87a3-1d196c6ed0ca",
                                                "text": "The desire for politicians who are sincere explains not only the strategic value of demagoguery (and hence the campaign choices of candidates like Trump who may not in fact believe their own demagogic bombast)."
                                            }
                                        ]
                                    }
                                ]
