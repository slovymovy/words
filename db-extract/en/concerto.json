                                                "sense_id": "4ab9c2ae-e1d1-3f1c-90bb-e0ad414ddddb",
                                                "text": "Koncert to najczęściej trzyczęściowy utwór na wiodący instrument oraz orkiestrę."
                                            },
                                            {
                                                "example_id": "14268d0f-4e0c-454e-bac6-71db6bbece5f",
                                                "sense_id": "4ab9c2ae-e1d1-3f1c-90bb-e0ad414ddddb",
                                                "text": "Orkiestra symfoniczna wykonała koncert skrzypcowy Czajkowskiego."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "8ba6205f-4bbb-32c3-905d-571390f2b61b",
                                        "entry_id": "5d6d8f7c-4784-3119-8e50-9948b4a6df19",
                                        "glosses": [
                                            "hałaśliwe zachowanie ludzi lub zwierząt"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a97f5655-d9aa-46e9-a34e-35f04d6859e8",
                                                "sense_id": "8ba6205f-4bbb-32c3-905d-571390f2b61b",
                                                "text": "Zawsze od połowy marca mamy pod domem koci koncert."
                                            },
                                            {
                                                "example_id": "39b5a6e6-82e1-47b1-afb6-b6bbe582d6d5",
                                                "sense_id": "8ba6205f-4bbb-32c3-905d-571390f2b61b",
                                                "text": "Podobał ci się wczorajszy koncert u sąsiadów? Mnie on wykańcza każdego dnia."
                                            }
