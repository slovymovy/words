                        "examples": [
                            {
                                "example_id": "9d30552b-644e-450f-8916-b0353cbfcff3",
                                "sense_id": "32d7ba71-0284-39fb-9c4b-539c9eaff0ed",
                                "text": "Est-ce au notaire qui procède à l'inventaire à réapposer les scellés à la fin de chaque vacation ?"
                            },
                            {
                                "example_id": "be9792d7-b8e0-4bbb-a3dc-29415e7c8ec8",
                                "sense_id": "32d7ba71-0284-39fb-9c4b-539c9eaff0ed",
                                "text": "Si les scellés avaient été posés par l'officier de police qui opère, il doit, s'il y a lieu, les réapposer après son opération."
                            }
                        ]
                    }
