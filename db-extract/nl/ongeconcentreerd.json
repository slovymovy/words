                "senses": [
                    {
                        "sense_id": "95a4b558-dbc3-3fc0-919d-22c3098770ca",
                        "entry_id": "1101e581-e8de-3039-a242-5c51defe4bb2",
                        "glosses": [
                            "zonder aandacht, zonder focus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "802274de-722f-4cfa-9cbb-968fee8c8321",
                                "sense_id": "95a4b558-dbc3-3fc0-919d-22c3098770ca",
                                "text": "Ik was zo ongeconcentreerd dat de leraren het zagen en me uit pure balorigheid vragen stelden zodat ik of ging staan en lijdend voorwerp antwoordde wanneer het naamwoordelijk deel van het gezegde moest zijn of me moest verontschuldigen omdat ik de vraag niet had gehoord."
                            },
                            {
                                "example_id": "6c7ad239-df6e-431a-be69-8dd3ba62621e",
                                "sense_id": "95a4b558-dbc3-3fc0-919d-22c3098770ca",
                                "text": "Dat het verschil uiteindelijk maar veertien punten bedroeg, had Jolly Jumpers geheel aan zichzelf te danken. De Tubbergse formatie speelde in de eerste helft ongeconcentreerd en vreselijk slordig. Ballen werden zo maar weggegooid, eenvoudige kansen werden gemist en Haren profiteerde optimaal."
                            }
                        ]
                    }
