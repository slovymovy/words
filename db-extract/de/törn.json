                ],
                "senses": [
                    {
                        "sense_id": "4fc22b80-f0a1-3031-ae27-00ce7731d76d",
                        "entry_id": "d9a19fab-5380-30cb-8835-527576a9341f",
                        "glosses": [
                            "Fahrt mit einem Segelboot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00bdbb75-55da-4d92-9e6d-14d2a3171a00",
                                "sense_id": "4fc22b80-f0a1-3031-ae27-00ce7731d76d",
                                "text": "„Schon seine ersten Törns führten ihn zu Beutezügen bis an die afrikanische Küste der römischen Provinz Mauretanien, des heutigen Marokko.“"
                            },
                            {
                                "example_id": "52fb8dc5-0b4d-47fa-ba13-ab0348ee5808",
                                "sense_id": "4fc22b80-f0a1-3031-ae27-00ce7731d76d",
                                "text": "„Diese Art Törn ist heute so alltäglich und die Methode des Walfangs so gut bekannt, dass ich über beides nur wenig erzählen möchte.“"
                            },
                            {
                                "example_id": "02a6a40e-da07-4dc8-8b14-7edea091f708",
                                "sense_id": "4fc22b80-f0a1-3031-ae27-00ce7731d76d",
                                "text": "„Sie sagten, sie wären lieber mit einem Fischkutter nach Island gesegelt, statt diesen langweiligen Törn durch ein ödes Land zu unternehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "50eaaa33-b0e0-3b88-80ac-413cc3697378",
                        "entry_id": "d9a19fab-5380-30cb-8835-527576a9341f",
                        "glosses": [
                            "eine mit einem Tauwerk wie eine Leine oder ein Seil gemachte Schlinge"
                        ],
                        "tags": [
