                        "examples": [
                            {
                                "example_id": "06f82fb5-f1c5-4aae-a20b-6551cd7d3dac",
                                "sense_id": "09a3a92b-5f0e-381d-8ec1-6eb1b91dc265",
                                "text": "De overvaller eiste geld en nadat hij dat had gekregen heeft hij de vrouw van haar kneveling bevrijd. Hij dwong haar naar het toiletruimte te gaan en is daarna weggerend richting de Dinkelstraat. Hij zou daarna zijn weggefietst op een zwarte omafiets in de richting van de Lijsterstraat."
                            },
                            {
                                "example_id": "cf35fa50-0ba3-431a-8105-68c2c656dc2a",
                                "sense_id": "09a3a92b-5f0e-381d-8ec1-6eb1b91dc265",
                                "text": "Veel buren zijn bang. Eén omwonende heeft er bij woningstichting St. Joseph op aangedrongen om het slot van de eigen woning te laten vervangen. Wie er achter de kneveling zit en of die verband houdt met eerdere dreigementen aan het adres van de man, is vooralsnog niet bekend."
                            }
                        ]
                    }
