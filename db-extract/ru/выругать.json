                            {
                                "example_id": "2f3fc9b5-4058-4388-b86e-f745b2dd84d5",
                                "sense_id": "23b46b35-4f7b-3551-be2d-8c99c0c76f35",
                                "text": "— Куса́й! Ешь! Никто́ отродя́сь мне пу́тного сло́ва не сказа́л… Все то́лько в душе́ подлецо́м счита́ют, а в глаза́ кро́ме хвале́ний да улы́бок — ни-ни́! Хоть бы раз кто по мо́рде съе́здил да вы́ругал! Ешь, пёс! Куса́й! Рррви ана́фему! Ло́пай преда́теля!",
                                "translation": "Anton Chekhov",
                                "english": "Anton Chekhov"
                            }
                        ]
                    }
