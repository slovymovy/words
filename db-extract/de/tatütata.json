                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f30be3b-eddc-3e90-ad48-4f8c88755953",
                                        "entry_id": "c4eb1562-5383-38af-9aba-0b740b8abdd6",
                                        "glosses": [
                                            "Imitating the two-tone siren on a vehicle used by emergency services."
                                        ],
                                        "tags": [
                                            "British",
                                            "childish",
                                            "onomatopoeic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61d61445-3c4f-4bcc-878c-f4063b4cb32d",
                                                "sense_id": "9f30be3b-eddc-3e90-ad48-4f8c88755953",
                                                "text": "If it had not been preceded by the nee-naw of fire engines it meant that no warning had been given. There would be casualties."
                                            },
                                            {
                                                "example_id": "44b68e22-188e-4e35-9e37-b83a1b9cb203",
                                                "sense_id": "9f30be3b-eddc-3e90-ad48-4f8c88755953",
                                                "text": "Whenever an opponent went down, be it genuine or feigned, the West Ham faithful would simultaneously cry 'Nee-naw, nee-naw, nee-naw, nee-naw', mimicking the sound of an ambulance."
                                            },
                                            {
                                                "example_id": "e86a86bc-ef9a-4861-af3a-75e4a8fe4431",
                                                "sense_id": "9f30be3b-eddc-3e90-ad48-4f8c88755953",
                                                "text": "Tom is in rapt communion with his police car, lying on his stomach, pushing it round and round, making nee-naw noises."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f27712dc-7cb7-4bbc-91ac-1a5f45d4ab99",
