                                    {
                                        "sense_id": "58e17b07-5009-3c07-827c-7b15490ea23f",
                                        "entry_id": "c7fa1703-0f1e-39e5-b3c0-e5b2f4f6f03b",
                                        "glosses": [
                                            "Défaut très apparent dans la forme, dans les proportions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b01d8721-7cb2-4714-8986-d580522493ae",
                                                "sense_id": "58e17b07-5009-3c07-827c-7b15490ea23f",
                                                "text": "Les loupes, la bosse sont des difformités."
                                            },
                                            {
                                                "example_id": "9b1a32b7-0891-44bd-827b-0861b9728c56",
                                                "sense_id": "58e17b07-5009-3c07-827c-7b15490ea23f",
                                                "text": "Les difformités de la taille."
                                            },
                                            {
                                                "example_id": "ca1a9123-103f-43f9-aeeb-f5915253c7a0",
                                                "sense_id": "58e17b07-5009-3c07-827c-7b15490ea23f",
                                                "text": "La difformité d’un membre."
                                            },
                                            {
                                                "example_id": "799c2688-ec68-4d39-99bd-9eccc3c8073b",
                                                "sense_id": "58e17b07-5009-3c07-827c-7b15490ea23f",
                                                "text": "Corriger une difformité."
                                            },
                                            {
                                                "example_id": "7478bc7e-3b9f-4797-b465-455193c89539",
                                                "sense_id": "58e17b07-5009-3c07-827c-7b15490ea23f",
                                                "text": "À chaque moment, elle découvrait en Quasimodo quelque difformité de plus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
