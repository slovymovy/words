                "senses": [
                    {
                        "sense_id": "427ba3aa-f1ca-3ea9-a9bd-39a0f99041af",
                        "entry_id": "429791d2-a17b-3027-b740-5a3d8d7611ff",
                        "glosses": [
                            "Espèce de tortues marines, à écaille épaisse, fréquentant les océans du monde entier et la Méditerranée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82c69b3b-19e6-45b8-9e5c-683afd14a74f",
                                "sense_id": "427ba3aa-f1ca-3ea9-a9bd-39a0f99041af",
                                "text": "Une tortue caouanne' a brièvement quitté les eaux de la Méditerranée pour pondre sur la sable languedocien."
                            },
                            {
                                "example_id": "5435e2e6-0ee8-4344-b38f-70f92c44a450",
                                "sense_id": "427ba3aa-f1ca-3ea9-a9bd-39a0f99041af",
                                "text": "En Belgique, seulement deux caouannes ont été observées au début des années 1800."
                            },
                            {
                                "example_id": "324380b8-4f1d-4159-b37b-170176c03e64",
                                "sense_id": "427ba3aa-f1ca-3ea9-a9bd-39a0f99041af",
                                "text": "La caouanne a disparu de Corse dans la seconde moitié du XXᵉ siècle en raison du tourisme nautique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
