                "senses": [
                    {
                        "sense_id": "595694c5-39a7-3b06-acdf-c38c07356ebd",
                        "entry_id": "d660ea5e-9b2a-3c95-a663-3c667a8f0f4c",
                        "glosses": [
                            "Agent des israelischen Auslandsgeheimdiensts Mossad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ca8aa82-f14c-4d62-be00-362245b5a090",
                                "sense_id": "595694c5-39a7-3b06-acdf-c38c07356ebd",
                                "text": "„Als Mossad-Agenten Eichmann 1960 aus Argentinien entführten, lernte ich gerade im ersten Schuljahr lesen und schreiben.“"
                            },
                            {
                                "example_id": "0df39723-912c-44bd-a3c0-a241ded017c0",
                                "sense_id": "595694c5-39a7-3b06-acdf-c38c07356ebd",
                                "text": "„Im Dezember 1966 wollte die pornografische Boulevardzeitung Bul einen Artikel veröffentlichen, in dem angedeutet wurde, Eschkol werde wegen der Verwicklung von Mossad-Agenten in die Ermordung Ben Barkas durch Yigal Allon abgelöst.“"
                            },
                            {
                                "example_id": "9bfa2758-1eae-478c-aad4-874e84117f4a",
                                "sense_id": "595694c5-39a7-3b06-acdf-c38c07356ebd",
                                "text": "„›Gestern mitgerechnet summiert sich die Zahl der vermuteten Mossad-Agenten damit auf sechs.‹“"
                            },
                            {
                                "example_id": "1e592fb8-2d62-432e-8ed7-00cbf7cac363",
                                "sense_id": "595694c5-39a7-3b06-acdf-c38c07356ebd",
                                "text": "„Levi erinnerte sich sofort an die Stimme des Palästinensers, die im Zuge einer Überwachung von einem Mossad-Agenten aufgezeichnet worden war; die Stimme hatte einem hübschen Fräulein auf Deutsch die Liebe des Palästinensers erklärt.“"
                            },
                            {
                                "example_id": "16bbeff7-858d-44b5-960b-69c1469660d3",
                                "sense_id": "595694c5-39a7-3b06-acdf-c38c07356ebd",
                                "text": "„Hier wurde ein Jude, zumal ein jüdischer Mossad-Agent, wohl kaum mit offenen Armen empfangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
