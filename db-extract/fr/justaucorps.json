                                        "entry_id": "e8a337b3-ed8c-3f6a-b1ca-088ce28a4eb1",
                                        "glosses": [
                                            "Kleidungsstück für Männer, das eng am Körper liegt, bis zu den Knien reicht"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
