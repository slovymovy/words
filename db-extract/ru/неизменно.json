                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf2a1c05-b89e-4003-a6a4-8365d42bfb19",
                        "source_entry_id": "3cefd55f-d1ef-35db-9f77-343f37bd7dce",
                        "source_sense_id": "63903bd0-0183-3106-877e-0c2b14f48d69",
                        "target_lang_word": "niezmienione",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "24b8fdc5-d330-40e5-b2d4-83b9aff23ad4",
                        "source_entry_id": "3cefd55f-d1ef-35db-9f77-343f37bd7dce",
                        "source_sense_id": "63903bd0-0183-3106-877e-0c2b14f48d69",
                        "target_lang_word": "constamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                        "entry_id": "3f23cbf7-3750-3705-a925-35a37ef27653",
                                        "glosses": [
                                            "Avec constance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01956101-9305-476e-a61e-6ae03ca11dbd",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Dans ma tente même, aux endroits qui ne sont pas constamment piétinés, sous mon lit, dans les coins, il y a maintenant tout un jardinet d'herbes vertes et de fleurettes multicolores."
                                            },
                                            {
                                                "example_id": "6946dcfe-73ec-404f-a814-9b286ee28a8f",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Les autorités prirent soin que ce mouvement ne leur glissât pas des mains, comme cela s'était produit en Californie et en Alaska ; elles le surveillèrent et le régulèrent constamment."
                                            },
                                            {
                                                "example_id": "6013dbad-7441-4275-bfc1-b0c7bbd9046f",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Combien de fois le peuple Romain avait-il porté constamment la défaite des armées !"
                                            },
                                            {
                                                "example_id": "e8c63cd0-e1ce-4912-b879-0c8c6133786b",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "[…]Préparons-nous à montrer constamment Ce que doit une amante à la mort d’un amant."
                                            },
                                            {
                                                "example_id": "7be7ee07-f223-44a0-ac0e-ee2630b7890e",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Parlons de sa mort, s'il se peut, aussi constamment qu’elle est morte."
                                            },
                                            {
                                                "example_id": "71c290a6-dc9c-4bf7-9da3-b4432fb28ef9",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Seigneur, je ne vous demande pas cette raison orgueilleuse qui cherche dans la gloire de souffrir constamment toute la consolation de ses peines."
                                            },
                                            {
                                                "example_id": "4c12dde1-a886-4c93-97c5-62b69ecfef92",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Il sait souffrir constamment et meurt en paix."
                                            },
                                            {
                                                "example_id": "14e71dce-7620-4089-bf42-ae0b5fe0a887",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "On ne pense pas toujours constamment d’un même sujet ; l’entêtement et le dégoût se suivent de près."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe762cb-37a8-31eb-a973-60cf53fcc8d7",
                                        "entry_id": "3f23cbf7-3750-3705-a925-35a37ef27653",
                                        "glosses": [
                                            "Invariablement ; sans interruption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dd27428-e896-4860-b42e-5a49a0a2d669",
                                                "sense_id": "bbe762cb-37a8-31eb-a973-60cf53fcc8d7",
                                                "text": "Le coq , ses aides et les hommes affectés au service des cuisines, porteront constamment la vareuse et le pantalon de fatigue ; […]."
                                            },
                                            {
                                                "example_id": "6cedebad-9653-4c30-be88-9d70c0c0c91c",
                                                "sense_id": "bbe762cb-37a8-31eb-a973-60cf53fcc8d7",
                                                "text": "J'ai pour compagnon de couchette un affreux ronfleur sur qui les coups de poing n'ont point d'effet, et qui gigotte constamment comme une grenouille."
                                            },
                                            {
                                                "example_id": "2da658af-2c5c-4d44-a8b5-fe2d4d372fc9",
                                                "sense_id": "bbe762cb-37a8-31eb-a973-60cf53fcc8d7",
                                                "text": "Les vagues brisent à bord et submergent constamment le pont qui, mal calfaté à New-York, laisse pénétrer l'eau dans la cabine."
                                            },
                                            {
                                                "example_id": "e50a3d00-247e-4aff-a60a-15f359cb019f",
                                                "sense_id": "bbe762cb-37a8-31eb-a973-60cf53fcc8d7",
                                                "text": "L’Empire romain, qui s’étendait des sables d’Arabie jusqu'aux neiges d’Écosse, fut constamment à la recherche de frontières défendables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db611181-24c3-39c9-aacb-4594987e9357",
                                        "entry_id": "3f23cbf7-3750-3705-a925-35a37ef27653",
                                        "glosses": [
                                            "Certainement ; assurément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf1d6d07-810e-4d8d-b425-1a80377698e8",
                                                "sense_id": "db611181-24c3-39c9-aacb-4594987e9357",
                                                "text": "Cette nouvelle est constamment vraie."
                                            },
                                            {
                                                "example_id": "a2c8283c-31bd-41e1-af13-ce6b7fba38c0",
                                                "sense_id": "db611181-24c3-39c9-aacb-4594987e9357",
                                                "text": "Quand il cite pour un maître celui qui constamment est un ignorant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04b83327-c150-4cb8-908f-5077c59388a5",
                        "source_entry_id": "3cefd55f-d1ef-35db-9f77-343f37bd7dce",
                        "source_sense_id": "63903bd0-0183-3106-877e-0c2b14f48d69",
                        "target_lang_word": "invariablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invariablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cdaebe22-fba3-3149-860b-37e6fd604742",
                                        "entry_id": "27a5e193-1599-352a-b302-5901093a78c4",
                                        "glosses": [
                                            "D’une manière invariable ; d’une façon constante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "304bc3d3-87fb-4cad-9529-47291540f97f",
                                                "sense_id": "cdaebe22-fba3-3149-860b-37e6fd604742",
                                                "text": "C’étaient invariablement les mêmes essences, des pins, des sapins, des saules, dont la présence attestait, dans cette terre froide, une certaine force végétative."
                                            },
                                            {
                                                "example_id": "fb00d2a0-da89-48fd-8ad5-cf5273b31721",
                                                "sense_id": "cdaebe22-fba3-3149-860b-37e6fd604742",
                                                "text": "Apparemment conçu pour que personne ne s’y attarde, sauf les chauffeurs-gardes du corps venus déposer et attendre leurs ministres qui assistent au Conseil ou à diverses autres réunions, ce hall ne comporte aucun véritable endroit pour s’asseoir, à l’exception de deux longues banquettes de bois peu invitantes et sur lesquelles traînent invariablement colis et enveloppes en attente d’un messager ou d'un taxi."
                                            },
                                            {
                                                "example_id": "bf57720a-8c48-4387-a5f9-fb48d742b784",
                                                "sense_id": "cdaebe22-fba3-3149-860b-37e6fd604742",
                                                "text": "C'est chez la veuve Thorsdal que j'appris à savourer les délices de la cuisine islandaise. Le dîner se composait invariablement de poisson bouilli."
                                            },
                                            {
                                                "example_id": "b81036d2-6665-47f2-8fad-2312c3fd778c",
                                                "sense_id": "cdaebe22-fba3-3149-860b-37e6fd604742",
                                                "text": "Invariablement les fonctionnaires, arrivés récemment ici des autres parties de la France, éprouvent de l’étonnement en voyant ces classes drues, ces hordes de galopins qui déambulent par les routes."
                                            },
                                            {
                                                "example_id": "450e3708-f9c7-431c-943f-5779e0804477",
                                                "sense_id": "cdaebe22-fba3-3149-860b-37e6fd604742",
                                                "text": "Il m’était impossible de rester cinq minutes avec elle, qu’une dispute —qui se terminait invariablement par des violences de sa part— n’éclatât aussitôt."
                                            },
                                            {
                                                "example_id": "ce7ce49e-5ae5-4c8f-bf6b-a8abef00abfd",
                                                "sense_id": "cdaebe22-fba3-3149-860b-37e6fd604742",
                                                "text": "Je l’ai vu en photo, sur un canapé en velours, tapotant de la main sur l’accoudoir, avec ses cheveux invariablement blancs et son air de pythie grecque assise sur les fumerolles de l’île de Ré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eacbef82-b22a-4e9c-aad2-a7abaaf43e23",
                        "source_entry_id": "3cefd55f-d1ef-35db-9f77-343f37bd7dce",
                        "source_sense_id": "63903bd0-0183-3106-877e-0c2b14f48d69",
                        "target_lang_word": "continuellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continuellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                        "entry_id": "21c83ecc-d27d-36c0-894d-0da3feb3533c",
                                        "glosses": [
                                            "Sans interruption, de manière continue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "957ca6d5-768a-4c0c-8d0d-7fe378a3b7d6",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "On n’a point continuellement des juges devant les yeux, et l’on craint la magistrature et non pas les magistrats."
                                            },
                                            {
                                                "example_id": "102357e9-f805-4bf8-8baf-7126def780fd",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "Nous le voyons continuellement occupé du soin d’acquérir ce qu’il juge utile et d’écarter ce qu’il présume devoir nuire à sa félicité."
                                            },
                                            {
                                                "example_id": "f5fecb57-70cc-44e1-810b-b4478cf6c3db",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "Ces champs ne sont-ils pas à moi, et ces bois chanteurs, et ce ciel que raye continuellement le vol fantaisiste des martinets ?"
                                            },
                                            {
                                                "example_id": "62e5c941-5b8a-4dd5-b009-efc856f04fd0",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "Le filage au continu permet d’obtenir une plus grande production, car le fil se produit et se renvide continuellement."
                                            },
                                            {
                                                "example_id": "cb07ea95-6948-4268-b6ed-b350d20b38b5",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "[…], Galilée a dû combattre continuellement les Péripatéticiens qui occupaient alors presque toutes les chaires magistrales des Universités."
                                            },
                                            {
                                                "example_id": "a1664d04-bd9f-4a86-bb05-a5e8e559cc2b",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "[…] le progrès est un perpétuel devenir, nulle méthode ne saurait être considérée comme immuable, tout est en mouvement, tout est continuellement améliorable, tout ce qui existe aujourd’hui sera demain mieux encore…"
                                            },
                                            {
                                                "example_id": "12afbee1-d8c4-48e2-954a-5849f1c7db2f",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "L’inlandsis du continent groenlandais se déversant lentement mais continuellement dans les fjords par des glaciers importants, vêle des icebergs de tailles variant à l’infini […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
