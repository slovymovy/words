            {
                "entry_id": "d6c118a9-4726-39ed-aa45-5b5fc47141d4",
                "word": "gobelin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "57cd87d9-1866-48e3-8355-5767d6e8ea58",
                        "entry_id": "d6c118a9-4726-39ed-aa45-5b5fc47141d4",
                        "tags": [
                            "plural"
                        ],
                        "form": "gobelins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86bde05c-31ba-35a0-9d59-6dd015fd082e",
                        "entry_id": "d6c118a9-4726-39ed-aa45-5b5fc47141d4",
                        "glosses": [
                            "Tapisserie provenant de la manufacture des Gobelins ou tapisserie de même style."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd974286-e9b3-4eeb-8d44-9e92088f9291",
                                "sense_id": "86bde05c-31ba-35a0-9d59-6dd015fd082e",
                                "text": "Au mur, il y a quelques Gobelins prêtés à l'occasion de la visite de l'empereur de Russie et qui sont restés."
                            },
                            {
                                "example_id": "6b2c4656-a69a-42d8-a978-08025adecfd5",
                                "sense_id": "86bde05c-31ba-35a0-9d59-6dd015fd082e",
                                "text": "Les rideaux en faux Gobelins, écartés pour laisser apparaître le lit, venaient aggraver ce spectacle de leurs verts tirant sur le gris, leurs bordeaux délayés, leurs jeux de beige, teinte poussière."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a2c9846-6b66-35d7-bcd6-66cc9dca1354",
                        "entry_id": "d6c118a9-4726-39ed-aa45-5b5fc47141d4",
                        "glosses": [
                            "Technique qui permet d'obtenir cette tapisserie."
                        ],
                        "tags": [
                            "Tapisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "16e6c1a9-2b11-4098-b119-e87b6878a275",
                                "sense_id": "7a2c9846-6b66-35d7-bcd6-66cc9dca1354",
                                "text": "Le travail en gobelin est fréquemment allié [en Amérique] au nouage de la trame qui servait à fixer sur l'étoffe des plumes d'oiseaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9e18270-e694-4ea7-9afd-492aa7f5e3c2",
                        "source_entry_id": "d6c118a9-4726-39ed-aa45-5b5fc47141d4",
                        "target_lang_word": "Gobelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gobelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                        "entry_id": "fd2041c1-190a-3916-9474-bf95c23ba600",
                                        "glosses": [
                                            "Wandteppich mit kunstvollen Stickereien, die Muster oder Bildszenen darstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34566f36-587b-40c4-9acc-afe1a9ce91d6",
                                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                                "text": "„An einer Wand hängt ein großes Landschaftsgemälde, an einer anderen ein Gobelin.“"
                                            },
                                            {
                                                "example_id": "7da0a768-4691-4696-bef1-412eb28c669e",
                                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                                "text": "„Ruge hatte sich vorn in den Sessel mit der hohen Lehne gesetzt, dessen gestickte Polster an Gobelins erinnerten.“"
                                            },
                                            {
                                                "example_id": "1ed4a375-2932-44f9-ace9-e4cab7a471a1",
                                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                                "text": "„Die Burgunder eilen die Ehrentreppe hinauf, vorbei an den Marmorlöwen auf den Absätzen, vorbei an den Gobelins, die die Wände schmücken.“"
                                            },
                                            {
                                                "example_id": "26dad7a4-254a-42cc-89da-fed06e4e2017",
                                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                                "text": "„Nahrung zu requirieren sei reine Notdurft, sagte er, bei Bildern und Gobelins fange die Räuberei an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
