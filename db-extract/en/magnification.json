                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b9323d-20cf-4d93-a2a4-5c3a95f6ab95",
                                                "sense_id": "c2e636c6-4ce0-3a09-9412-84a5332cc111",
                                                "text": "Увеличение составляет несколько сантиметров."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46c2d48f-39a7-351c-92ea-3fd21dd48b61",
                                        "entry_id": "ca7997e6-4ad0-32aa-ad0b-fd85f28f9809",
                                        "glosses": [
