                    {
                        "translation_id": "4866175f-a41a-4bbc-a83a-27505149bdbb",
                        "source_entry_id": "3ecc10ab-7e6b-37b3-886e-e5535e9003ea",
                        "source_sense_description": "dance",
                        "target_lang_word": "mazurka",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mazurka",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e3e7b9d-69ca-3cef-9b20-f85ac4cb91af",
                                        "entry_id": "ed63f040-56cf-3672-8c5b-5d971297d35b",
                                        "glosses": [
                                            "Danse à trois temps, d’origine polonaise, tenant son nom de la province de Mazurie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d5a7502-58bf-4da7-8223-7aa8f0c12031",
                                                "sense_id": "1e3e7b9d-69ca-3cef-9b20-f85ac4cb91af",
                                                "text": "Là, il passa la soirée avec plaisir et se distinguais si bien dans la mazurka qu’il enthousiasma non seulement les dames, mais les cavaliers."
                                            },
                                            {
                                                "example_id": "bab05df5-468d-4e16-982a-8707a0daded5",
                                                "sense_id": "1e3e7b9d-69ca-3cef-9b20-f85ac4cb91af",
                                                "text": "Ces dames dansèrent. Les polkas, les valses, les mazurkas, alternèrent avec les quadrilles."
                                            },
                                            {
                                                "example_id": "9fb9b6ad-d1c3-4f3f-8e73-38425c963002",
                                                "sense_id": "1e3e7b9d-69ca-3cef-9b20-f85ac4cb91af",
                                                "text": "Le soir, après dîner, Lucile Bucolin ne s’approchait pas à notre table de famille, mais, assise au piano, jouait avec complaisance de lentes mazurkas de Chopin ; parfois rompant la mesure, elle s’immobilisait sur un accord…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mazurka",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1662997b-0309-3ccc-9d18-e89d99db390a",
                                        "entry_id": "516a80c9-8031-3727-bda6-0de73a0cea6c",
                                        "glosses": [
                                            "Troisième personne du singulier du passé simple de mazurker."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04cfb24c-9712-42e9-b7bf-977b207b824e",
                        "source_entry_id": "3ecc10ab-7e6b-37b3-886e-e5535e9003ea",
                        "source_sense_description": "dance",
                        "target_lang_word": "mazurque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mazurque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19e08bf7-56b4-3d88-82bd-6aa0927f80e0",
                                        "entry_id": "c92ff94a-fc75-374e-8f08-692c142e9423",
                                        "glosses": [
                                            "Mazurka."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d48239d-17f6-41a7-92da-e2f32779f83d",
                                                "sense_id": "19e08bf7-56b4-3d88-82bd-6aa0927f80e0",
                                                "text": "De ce fait, pour être dansante, une musique n’épouse pas forcément un « rythme de danse » tel qu’on l’entend vulgairement : rythme de valse, de mazurque, long adage, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6416f39f-e078-4968-9969-02e30d8931c1",
                        "source_entry_id": "3ecc10ab-7e6b-37b3-886e-e5535e9003ea",
                        "source_sense_description": "dance",
                        "target_lang_word": "Mazurka",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mazurka",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27b979f2-727a-3399-b8bf-e72046b4de4b",
                                        "entry_id": "a12b794b-250f-3cb7-b3df-d97f3c48f7b5",
                                        "glosses": [
                                            "polnischer Tanz unterschiedlichen Tempos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bca2224-4ca4-4fb5-9d44-f03ca155fcbe",
                                                "sense_id": "27b979f2-727a-3399-b8bf-e72046b4de4b",
                                                "text": "„Von Zeit zu Zeit wandte er sich, in die Hände klatschend, zum Kapellmeister, damit dieser den Einsatz zu einer Polka oder einer Mazurka gebe, um die Wartezeit zu überbrücken.“"
                                            },
                                            {
                                                "example_id": "c34388f2-9b51-459e-ad5a-13d34cdfd66f",
                                                "sense_id": "27b979f2-727a-3399-b8bf-e72046b4de4b",
                                                "text": "„Vor Freude setzte ich mich sofort ans Klavier und spielte drei lustige Mazurken von Chopin, die der ganzen unsterblichen Lebenskraft des polnischen Volkes und seines tänzerischen Gemüts Ausdruck verliehen.“"
                                            },
                                            {
                                                "example_id": "e8e727d2-e0a2-4553-8168-d17f638160e1",
                                                "sense_id": "27b979f2-727a-3399-b8bf-e72046b4de4b",
                                                "text": "„Die Musik spielte die neue Mazurka.“"
                                            },
                                            {
                                                "example_id": "19e62313-fa7a-491e-aad4-9a6e0873c87a",
                                                "sense_id": "27b979f2-727a-3399-b8bf-e72046b4de4b",
                                                "text": "„Ich hätte nicht versuchen dürfen, diesen Augenblick zu wiederholen: als ich von Marie nach Hause kam und Leo im Musikzimmer die Mazurka spielte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
