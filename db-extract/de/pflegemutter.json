                "senses": [
                    {
                        "sense_id": "0bf68220-3b74-3f4b-bdd8-21fca1fdb3da",
                        "entry_id": "3f245bc1-0635-306f-a3fd-d20c32d93af4",
                        "glosses": [
                            "Frau, die die Fürsorge über jemanden übernommen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f39b9dac-2b8b-4389-8f5b-d8f6b8261110",
                                "sense_id": "0bf68220-3b74-3f4b-bdd8-21fca1fdb3da",
                                "text": "„Christel, die eigentlich mit der Heirat den Schlägen der Pflegemutter entfliehen wollte, ist vom Regen in die Traufe gekommen.“"
                            },
                            {
                                "example_id": "9ed98747-1ce2-4ea3-9158-5684976aa5c5",
                                "sense_id": "0bf68220-3b74-3f4b-bdd8-21fca1fdb3da",
                                "text": "„Selbst bestieg sie, so früh es ihr möglich war, die Sänfte, um Frau Mondtraut einen Besuch abzustatten und sie zu bitten, an ihr die Rolle einer Pflegemutter zu übernehmen.“"
                            },
                            {
                                "example_id": "8283db23-1799-473d-85c4-526fc9bdd8b3",
                                "sense_id": "0bf68220-3b74-3f4b-bdd8-21fca1fdb3da",
                                "text": "„Snaefrídur küßte ihre Pflegemutter Gudrídur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
