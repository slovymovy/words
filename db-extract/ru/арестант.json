                                                "example_id": "0f8b0448-ed30-4c72-ae61-b924ad41848e",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "Władysław Bartoszewski ist tot. Der Auschwitz-Häftling und ehemalige polnische Außenminister engagierte sich über Jahrzehnte für die deutsch-polnische Versöhnung."
                                            },
                                            {
                                                "example_id": "a08e64ba-e21b-4834-bc10-a4ee34ae5ae9",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "200 Häftlinge seien [aus der Haftanstalt] ausgebrochen, nur zehn habe man bislang wieder dingfest machen können, berichteten Polizei und Justiz in der Stadt Minna in Zentralnigeria."
                                            },
                                            {
                                                "example_id": "0242a2b0-8eaf-4cf8-924a-72fad6313b75",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "„Die anderen Häftlinge starrten ihn mit eisiger Miene an.“"
                                            },
                                            {
                                                "example_id": "46c35574-62b3-4c9c-a1e7-3c5dd2eef46a",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "„Unser Häftling war vollkommen eingeschüchtert.“"
                                            },
                                            {
                                                "example_id": "728cbf0a-f497-47d2-9fbf-442e2698fa92",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "„Als Schülerin demonstrierte ich gegen den Golfkrieg, während meines Psychologiestudiums probte ich mit Häftlingen ein Theaterstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df00580e-46b7-493f-9736-ed75ba77eb2d",
                        "source_entry_id": "3adf9abf-b372-3d59-8201-06beb30888d9",
                        "source_sense_id": "a61f899b-098b-3a3c-8d1e-2b56c4779498",
                        "target_lang_word": "détenu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détenu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53f38ba5-faf7-3809-8ad3-4451961bc6cd",
                                        "entry_id": "00e52a87-c7d1-3f75-a42c-26cb4133fcf8",
                                        "glosses": [
                                            "Qui est en état de détention, qui est prisonnier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09e6a3be-8ec7-4bd2-abe4-2ffa8999e5c0",
                                                "sense_id": "53f38ba5-faf7-3809-8ad3-4451961bc6cd",
                                                "text": "Un homme détenu."
                                            },
                                            {
                                                "example_id": "390d1832-5fbd-4532-892b-78adb04ed051",
                                                "sense_id": "53f38ba5-faf7-3809-8ad3-4451961bc6cd",
                                                "text": "Une femme détenue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "détenu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc77b17c-731f-3483-8404-883823bbd6c5",
                                        "entry_id": "9fcb6930-bbf6-3a97-a1ad-50f30c7c8433",
                                        "glosses": [
                                            "Personne en détention, emprisonnée."
                                        ],
                                        "tags": [
                                            "Prison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d1c73bd-9ac3-4947-bd06-f3ca758a1837",
                                                "sense_id": "bc77b17c-731f-3483-8404-883823bbd6c5",
                                                "text": "— Et elle m’a traité comme un chien, pis que cela, comme un laquais ; je dirai mieux : comme un détenu politique."
                                            },
                                            {
                                                "example_id": "5ec502fb-3e21-43e1-858a-94c554a9d80d",
                                                "sense_id": "bc77b17c-731f-3483-8404-883823bbd6c5",
                                                "text": "Pas un détenu qui ne se retourne le soir sur sa paillasse à l'idée que l'aube peut être sinistre, qui ne s'endort sans souhaiter qu'il ne se passe rien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "détenu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "005aa4d3-bde2-36d9-bb46-a0830a4d9007",
                                        "entry_id": "25e2e41a-ac08-353a-866d-1eee5893c674",
                                        "glosses": [
                                            "Participe passé masculin singulier de détenir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60756756-4403-469d-90b4-b97630d077d4",
                                                "sense_id": "005aa4d3-bde2-36d9-bb46-a0830a4d9007",
                                                "text": "M. de La Motte-Guerin, qui commandait dans ces îles, du temps que j’y étais détenu, m’assura que ce prisonnier était le duc de Beaufort, qu’on disait avoir été tué au siège de Candie, et dont on ne put trouver le corps suivant toutes les relations de ce temps-là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
