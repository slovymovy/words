                        "source_entry_id": "8b7c52e3-ce76-3e0c-a8f5-abdc7992692d",
                        "source_sense_id": "16499337-2107-3af3-b8a9-df7342999199",
                        "source_sense_description": "Landschaft in Osteuropa, die größtenteils in Moldawien liegt",
