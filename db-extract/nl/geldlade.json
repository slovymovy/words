                        "examples": [
                            {
                                "example_id": "1dbbd90a-0804-4acd-b80b-419e6db90dd7",
                                "sense_id": "24888025-eb03-30fe-b0d7-286a8241a564",
                                "text": "Ook zijn voorwerpen gevonden die worden gebruikt bij plofkraken, zoals twee zogeheten 'pizzaschuiven' waarmee explosieven via de geldlade diep in het binnenste van een pinautomaat worden geduwd."
                            },
                            {
                                "example_id": "cedf8517-21c7-4d9f-bd00-6b8e89943a06",
                                "sense_id": "24888025-eb03-30fe-b0d7-286a8241a564",
                                "text": "Het aantal plofkraken rijst de pan uit dit jaar. Maandag werd daarom besloten alle geldautomaten voortaan van 23.00 tot 07.00 uur uit te zetten. Als de geldlade dicht blijft, zou het moeilijker zijn een kraak uit te voeren."
                            }
                        ]
