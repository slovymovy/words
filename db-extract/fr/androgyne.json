                                                "example_id": "e213dc55-c8e8-4a5c-8dfa-8887fd07a750",
                                                "sense_id": "a7dd7398-4345-30bd-85f6-7c471c49da37",
                                                "text": "The yogi is in this way the androgyne of prehistory reachieved."
                                            },
