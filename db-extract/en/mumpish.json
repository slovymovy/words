                    {
                        "sense_id": "57330d4f-2fbc-3005-9bdc-edf5cf00078d",
                        "entry_id": "b141b773-38c2-32ac-add0-9dd2b5db49bd",
                        "glosses": [
                            "Suffering from mumps (the disease)."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "49dbd617-a006-461d-a5b8-4b3106eaf808",
                                "sense_id": "57330d4f-2fbc-3005-9bdc-edf5cf00078d",
                                "text": "I wouldn't mind being sick if I could look interesting, but mumps! The funny thing is, I haven't had time to get them from these children and must have been exposed before. […] [S]omehow I was feeling far from well, myself, and when Dr. Weston came about ten o'clock he broke the dreadful news that I was mumpish too, and sent me off to bed."
                            }
                        ]
                    }
