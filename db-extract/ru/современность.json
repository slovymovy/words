                                                "sense_id": "8cd03dc4-87df-344f-a183-062654dd68e8",
                                                "text": "The organization survived from ancient times to modernity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0ede8b-25ad-30cb-b499-9ee2b89e000a",
                                        "entry_id": "b7d591c0-090f-3334-93c2-9814cf76df2b",
                                        "glosses": [
                                            "Quality of being of the modern period of contemporary historiography."
                                        ],
