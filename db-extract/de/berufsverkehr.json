                ],
                "senses": [
                    {
                        "sense_id": "f6d29ae1-301e-3405-a804-263176bbaa25",
                        "entry_id": "e6b2ed4e-97c0-334a-83bb-3d4cd4f57286",
                        "glosses": [
                            "hohes Verkehrsaufkommen zu bestimmten Zeiten aufgrund von Pendlern, die von oder zur Arbeitsstätte fahren"
                        ],
                        "tags": [
                            "Verkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "b5f0b6bc-f60b-43a1-919e-647a9e510619",
                                "sense_id": "f6d29ae1-301e-3405-a804-263176bbaa25",
                                "text": "Du kommst immer auf die Idee später einkaufen zu gehen, wenn wir schon mitten im Berufsverkehr stecken."
                            },
                            {
                                "example_id": "a1a124b6-ef6c-4fb7-8349-38487c00e76f",
                                "sense_id": "f6d29ae1-301e-3405-a804-263176bbaa25",
                                "text": "Schlimm wird es, wenn der Berufsverkehr und der Zulieferverkehr sich die Straße teilen muss."
                            },
                            {
                                "example_id": "38bc7480-dc50-47ac-a667-23fd4f91db0d",
                                "sense_id": "f6d29ae1-301e-3405-a804-263176bbaa25",
                                "text": "„Es war Dienstagmorgen und ich brach früh auf, um die österreichische Hauptstadt noch vor dem Berufsverkehr zu verlassen.“"
                            },
                            {
                                "example_id": "7d15258a-5f9c-48e6-97a1-fd961e83b5a0",
                                "sense_id": "f6d29ae1-301e-3405-a804-263176bbaa25",
                                "text": "„Nun aber, bei der Aktion am 6. Dezember, standen so viele Autos im morgendlichen Berufsverkehr, dass die Polizei einfach eingreifen musste. Sie lösten uns von der Straße und es folgte Präventivgewahrsam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
