                "senses": [
                    {
                        "sense_id": "17286771-fa26-375c-b9e1-6f210ca4f1aa",
                        "entry_id": "f9d4e26a-ab8e-3971-95b4-ae032072e3a5",
                        "glosses": [
                            "Handlung, Maßnahme, etwas möglich zu machen, die Voraussetzungen für etwas herzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a258c5fc-9fe2-4301-b3de-3c1ce5c21f4a",
                                "sense_id": "17286771-fa26-375c-b9e1-6f210ca4f1aa",
                                "text": "„Zweck der Kommunikation in Unternehmen ist die Ermöglichung von Interaktion, Koordination und Steuerung in arbeitsteiligen Systemen.“"
                            },
                            {
                                "example_id": "231f1681-351a-4fb4-a320-6e51b6024899",
                                "sense_id": "17286771-fa26-375c-b9e1-6f210ca4f1aa",
                                "text": "„Stephanie Staudner betrachtet Auswirkungen des Ganztags im Sinne der Ermöglichung von Bildungsgelegenheiten aus der Sicht von Kindern.“"
                            },
                            {
                                "example_id": "e988d6d3-16b6-4cfb-a266-7b8d9e8946f0",
                                "sense_id": "17286771-fa26-375c-b9e1-6f210ca4f1aa",
                                "text": "„Die moderne Medizin sieht eine Reihe von Maßnahmen zur Ermöglichung, Vorhersage oder Verhinderung von Geburten vor, die nicht immer erfolgreich sind.“"
                            },
                            {
                                "example_id": "8a91d919-74ca-4f41-940e-6d5569a6a25d",
                                "sense_id": "17286771-fa26-375c-b9e1-6f210ca4f1aa",
                                "text": "„Deutschland hat sich danach bei der Ermöglichung von mobiler Arbeit und Homeoffice im Vergleich zu den meisten anderen Ländern zurückgehalten.“"
                            },
                            {
                                "example_id": "8c625960-7d4d-4ddb-951d-f407a19ae83c",
                                "sense_id": "17286771-fa26-375c-b9e1-6f210ca4f1aa",
                                "text": "„Ihr Ziel ist die Ermöglichung von Bildungsabschlüssen für Menschen mit Sehbehinderung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
