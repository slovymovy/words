                        "sense_id": "491b663a-9cf3-3b91-a608-b5aebbf1acd9",
                        "entry_id": "6fc17f06-79ef-3253-bb99-d995fa743892",
                        "glosses": [
                            "Somebody who is debauched; somebody who is dissolute and acts without moral restraint."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "79a9e597-4f25-32d7-961d-58e10f4767ab",
                        "entry_id": "6fc17f06-79ef-3253-bb99-d995fa743892",
                        "glosses": [
                            "A person addicted to excessive indulgence in sensual pleasures."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6d3e2a9-c639-4256-a89e-ea161bceb39e",
                        "source_entry_id": "6fc17f06-79ef-3253-bb99-d995fa743892",
                        "source_sense_description": "somebody who is debauched; somebody who is dissolute and acts without moral restraint",
                        "target_lang_word": "Verführer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verführer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                        "entry_id": "54e91b65-e6d1-3f22-be23-873a6d43fe97",
                                        "glosses": [
                                            "jemand, der jemand anderen zu etwas bringt, das dieser nicht ohnehin beabsichtigt hatte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8558578-b38b-46a5-b94a-ab6157fd5b23",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Der wahre Verführer beginnt das Vorspiel am Herd.“"
                                            },
                                            {
                                                "example_id": "40ba8c06-c5a3-4d38-bf3e-88b2ba70d01d",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Im Lehrtheater lernt das Kind, wie eine Ampel funktioniert, wie man sicher eine Straße überquert, welche Verkehrszeichen, Einrichtungen oder Menschen helfen, wo Verführer und Gefahren lauern und wie man sich gegen sie wehren kann.“"
                                            },
                                            {
                                                "example_id": "2ce27e4a-605f-4e1a-8f32-13f0e39bacf2",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Wenn die Freundin sich, um nicht erröten zu müssen, eine ganz unbedeutende Gunst rauben läßt, wird sie die erste sein, die andere zu einer größeren anzuspornen; und wenn der Verführer geschickt ist, hat sich die Unschuldige bereits zu weit vorgewagt, um noch zurückweichen zu können.“"
                                            },
                                            {
                                                "example_id": "1eac1562-30e2-4b49-8396-3f847418da5b",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Blieb noch das ernste Bühnenstück oder das bürgerliche Trauerspiel, in dem untröstliche Familienväter, Diener, die ihre Herren retten, Reiche, die ihr Vermögen verschenken, unschuldige Näherinnen und ruchlose Verführer auftreten, ein Genre, das bei Diderot anfängt und sich bis zu Pixérécourt fortsetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bf3f2ee-308b-4d88-9e7e-fdab3f484fc1",
                        "source_entry_id": "6fc17f06-79ef-3253-bb99-d995fa743892",
                        "source_sense_description": "somebody who is debauched; somebody who is dissolute and acts without moral restraint",
                        "target_lang_word": "Wüstling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wüstling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "858abacd-7922-3161-9f43-cee47bd0149e",
                                        "entry_id": "2ac3a0a0-5507-3354-826d-7253ca7ef7e9",
                                        "glosses": [
                                            "abwertend: Mensch mit sexuell ausschweifendem Lebenswandel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9771bfaf-8ef3-4c4c-9b41-bc2d670e8d4e",
                                                "sense_id": "858abacd-7922-3161-9f43-cee47bd0149e",
                                                "text": "„Den Auslassungen des Postmeisters von Bodendorf nach hatten sich die Gardelegener jedenfalls vor Lachen gebogen, als die Unschuld vom Lande dem städtischen Gieregauch ein Schnippchen nach dem andern schlug, und hatten vom Parkett her gute Ratschläge erteilt, wie mit dem Wüstling umzugehen sei, der es auf eine der ihren abgesehen habe der schnöden Wollust wegen.“"
                                            },
                                            {
                                                "example_id": "635d2eed-d304-4d29-ad5b-55d9e54b7794",
                                                "sense_id": "858abacd-7922-3161-9f43-cee47bd0149e",
                                                "text": "„Man lobte meine Bescheidenheit, weil ich keinen einzigen Kirchenvater zitiert hatte, die ich bei meiner Jugend gar nicht kennen konnte, und die Frauen fanden es bewundernswert, daß kein anderes lateinisches Zitat darin vorkam als der Text des Horaz, der zwar ein großer Wüstling gewesen sei, aber dennoch sehr kluge Sachen gesagt habe.“"
                                            },
                                            {
                                                "example_id": "e3661ea1-c85b-499f-b456-2334a5ae2cbd",
                                                "sense_id": "858abacd-7922-3161-9f43-cee47bd0149e",
                                                "text": "„Er verlangte, dass sie die Beziehung und auch die Freundschaft mit einem so berüchigten Wüstling beende, und Kaysie gehorchte.“"
                                            },
                                            {
                                                "example_id": "bb618a93-e7ae-43d4-86fb-1d891bc386b2",
                                                "sense_id": "858abacd-7922-3161-9f43-cee47bd0149e",
                                                "text": "„Dergleichen mag in jenen Zeiten unter Wüstlingen vorgekommen sein; ein wenig Inzest erhöhte den Genuß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d14725c-d4af-33f3-b11a-45083cf33579",
                                        "entry_id": "2ac3a0a0-5507-3354-826d-7253ca7ef7e9",
                                        "glosses": [
                                            "abwertend: rücksichtsloser, zu Gewalt neigender Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6a92d4-52ad-45fd-aecd-f644b9c0ee78",
                                                "sense_id": "2d14725c-d4af-33f3-b11a-45083cf33579",
                                                "text": "„Kutusow war ein Verräter, und Fürst Wassilij sagte während der visites de condoléance, die man ihm anlässlich des Todes seiner Tochter machte, von Kutusow, den er doch früher so sehr gerühmt hatte, von diesem blinden, greisen Wüstling habe sich auch nichts anderes erwarten lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85967ab6-b1dd-40f4-9b13-9c869fc98b2f",
                        "source_entry_id": "6fc17f06-79ef-3253-bb99-d995fa743892",
                        "source_sense_description": "somebody who is debauched; somebody who is dissolute and acts without moral restraint",
                        "target_lang_word": "Lüstling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lüstling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9d07351-71e3-3e21-940c-b8372eeb0fc0",
                                        "entry_id": "a89bfb96-e8f2-31d3-aaad-7cf355190856",
                                        "glosses": [
                                            "Mann, der sich über das normale Maß hinaus geschlechtlichen Begierden hingibt, unter Umständen bis dahin, Frauen deretwegen sogar sexuell zu belästigen"
                                        ],
                                        "tags": [
                                            "beleidigend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b25a748-ae8f-4c4f-ad1d-47b537bc8d06",
                                                "sense_id": "c9d07351-71e3-3e21-940c-b8372eeb0fc0",
                                                "text": "„Dieser Lüstling hat mir vorhin an den Hintern gefasst!“"
                                            },
                                            {
                                                "example_id": "de2ecaf1-77de-418e-9dda-b962bc63bc60",
                                                "sense_id": "c9d07351-71e3-3e21-940c-b8372eeb0fc0",
                                                "text": "„Das letzte, was ich wollte, war wieder ein Cousin Eli in meinem Leben, wieder ein Lüstling vor Ort, der mich drängte, an seinen sinnlichen Freuden teilzuhaben.“"
                                            },
                                            {
                                                "example_id": "2161bc60-f84b-42c1-91e9-01173d5a881a",
                                                "sense_id": "c9d07351-71e3-3e21-940c-b8372eeb0fc0",
                                                "text": "Der späte Arno Schmidt erscheint zuweilen wie ein alter Lüstling, der sich seinen Freuden literarisch hingibt."
                                            },
                                            {
                                                "example_id": "4def258c-3769-4887-8ffc-94cc0e6cb25b",
                                                "sense_id": "c9d07351-71e3-3e21-940c-b8372eeb0fc0",
                                                "text": "„Ihre Unbefangenheit, ihr quecksilbriges Wesen, ihre Neugier, ihr häufiges Erröten, wenn sie mir Dinge sagte, über die ich lachen mußte und bei denen sie sich nichts Arges gedacht hatte, all das bewies mir, daß sie ein leibhaftiger Engel war, der unfehlbar dem ersten besten Lüstling zum Opfer fallen mußte, der es auf sie abgesehen hatte.“"
                                            },
                                            {
                                                "example_id": "eb4b9c69-344e-4e01-afe7-08bd78f91fc9",
                                                "sense_id": "c9d07351-71e3-3e21-940c-b8372eeb0fc0",
                                                "text": "„Sie gewinnt nichts dabei, er ist ein Lüstling.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
