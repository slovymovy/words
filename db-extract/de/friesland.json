                "translations": [
                    {
                        "translation_id": "28507063-8006-4dc0-9210-5a50a2bf6cba",
                        "source_entry_id": "4de49313-1859-3273-8e3d-87df4c401987",
                        "source_sense_id": "70278c8e-a346-3477-8a91-7634f1fa14d8",
                        "target_lang_word": "Frisia",
