                                    {
                                        "sense_id": "b9faaf99-385e-3333-8273-6ec5d85fefcc",
                                        "entry_id": "e1723cad-903a-3349-9e7d-98092a26f7a4",
                                        "glosses": [
                                            "Ready-to-eat food obtainable from a streetside vendor, often from a makeshift or portable stall."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33b26802-b811-4a74-8650-35cb43601534",
                                                "sense_id": "b9faaf99-385e-3333-8273-6ec5d85fefcc",
                                                "text": "All studies sought to distinguish between street food meals and snacks..."
                                            },
                                            {
                                                "example_id": "5d4f440d-e669-42ed-a94c-d5735fa818ab",
                                                "sense_id": "b9faaf99-385e-3333-8273-6ec5d85fefcc",
                                                "text": "In fact, street food may well be fresher than that served in restaurants and cafes, as it is cooked at the point of sale. It's certainly much cheaper."
                                            },
                                            {
                                                "example_id": "608b5a97-6d0a-4af1-857c-07ee48598906",
                                                "sense_id": "b9faaf99-385e-3333-8273-6ec5d85fefcc",
                                                "text": "They specialize in all sorts of events, such as athletic competitions, fairs, and conventions, as well as receptions, banquets, and street food."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b023d33-baab-3583-ba44-72a50c93c0fa",
                                        "entry_id": "e1723cad-903a-3349-9e7d-98092a26f7a4",
                                        "glosses": [
                                            "Food of this kind served in other contexts such as dine-in restaurants."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bccdd87-c4d9-4ad7-b8ac-854d1d92b3b0",
                                                "sense_id": "8b023d33-baab-3583-ba44-72a50c93c0fa",
                                                "text": "Bustling with a lively crowd, this restaurant serves finger-licking Korean street food."
                                            }
                                        ]
                                    }
                                ]
