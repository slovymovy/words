                "senses": [
                    {
                        "sense_id": "84524b34-535a-3fd4-a8d2-3a3c999b43a1",
                        "entry_id": "0f2ff213-03b4-3353-aad9-64ebd6830587",
                        "glosses": [
                            "so, dass es gewährt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d8982c7-bb39-4285-a712-d8d60dc0e39c",
                                "sense_id": "84524b34-535a-3fd4-a8d2-3a3c999b43a1",
                                "text": "„… also kann auch das Gebet beitragen, etwas, was sonst nicht gewährbar wäre, gewährbar zu machen ….“"
                            },
                            {
                                "example_id": "61e23659-8c13-4d6a-8422-a4f94a83356e",
                                "sense_id": "84524b34-535a-3fd4-a8d2-3a3c999b43a1",
                                "text": "„Sage mir, was du verlangst: alles wird dir mein Herz gewähren, was ich nur gewähren kann und was an sich gewährbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
