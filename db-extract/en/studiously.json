                                            {
                                                "example_id": "841e18e8-bc1e-46a1-8657-43a6edb6a04c",
                                                "sense_id": "97857acd-c8e0-325d-8c2b-effa1922e2ad",
                                                "text": "Stop-Schilder werden von Autofahrern geflissentlich übersehen."
                                            },
                                            {
                                                "example_id": "d5b6492b-125d-414c-b004-47df79a4c963",
                                                "sense_id": "97857acd-c8e0-325d-8c2b-effa1922e2ad",
                                                "text": "Er arbeitete sich geflissentlich in sein neues Aufgabengebiet ein."
                                            },
                                            {
                                                "example_id": "63386de2-e1fa-4987-9491-fa6496d893e9",
                                                "sense_id": "97857acd-c8e0-325d-8c2b-effa1922e2ad",
                                                "text": "„Die Leute im Saal schlagen geflissentlich den Psalm auf - sodass durch den Raum ein sanfter Hauch weht - und stimmen sodann in den Gesang ein.“"
                                            },
                                            {
                                                "example_id": "f4f0c449-25d5-4d55-8519-12466b42325c",
                                                "sense_id": "97857acd-c8e0-325d-8c2b-effa1922e2ad",
                                                "text": "Diese Idee kannst du ganz geflissentlich vergessen!"
                                            },
                                            {
                                                "example_id": "68d43114-81c4-454f-acbc-a472c8fa8113",
                                                "sense_id": "97857acd-c8e0-325d-8c2b-effa1922e2ad",
                                                "text": "„Am folgenden Morgen schickte der Portier geflissentlich den Daily Mirror aufs Zimmer.“"
                                            },
                                            {
                                                "example_id": "827251fb-ea72-46eb-aae2-61b595afb1ed",
                                                "sense_id": "97857acd-c8e0-325d-8c2b-effa1922e2ad",
                                                "text": "„Die Anschaffungen rund um den Salon ließ sie geflissentlich unerwähnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
