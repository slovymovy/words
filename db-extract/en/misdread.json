                        "examples": [
                            {
                                "example_id": "9a40def8-2743-49f4-acc9-998d1ab27a0c",
                                "sense_id": "5608f17b-4f3b-39a4-aec5-b83afdf6d30d",
                                "text": "Needs me then hope, or doth me need misdread?"
                            },
                            {
                                "example_id": "d69effe3-3ebf-454c-84be-786628a85af0",
                                "sense_id": "5608f17b-4f3b-39a4-aec5-b83afdf6d30d",
                                "text": "To auoyd a mischiefe which he misdreaded."
                            },
                            {
                                "example_id": "71ef5acf-a8c6-47fa-8774-c3f83c1fcc15",
                                "sense_id": "5608f17b-4f3b-39a4-aec5-b83afdf6d30d",
                                "text": "and the Romanes likewise misdreaded that the Iewes should inuade their campe."
                            },
                            {
                                "example_id": "8b470b19-b705-434d-9950-77c11b2ddfae",
                                "sense_id": "5608f17b-4f3b-39a4-aec5-b83afdf6d30d",
                                "text": "\"Of that I misdreaded,\" said he, \"for full well wist I that either he would rescue her or else he would die in the field; and, to say the truth, he had not been a man of worship had he not rescued the Queen, [...]\""
                            }
                        ]
                    }
