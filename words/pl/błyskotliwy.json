                        "ru": "отличающийся острым умом, сообразительностью, выдающимся интеллектом или остроумием; свидетельствующий о таких качествах"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brilliant",
                                "target_lang_sense_clarification": "exceptionally clever or talented"
                            },
                            {
                                "target_lang_word": "quick-witted",
                                "target_lang_sense_clarification": "sharp, agile in thought and response"
                            },
                            {
                                "target_lang_word": "witty",
                                "target_lang_sense_clarification": "clever and humorous"
                            },
                            {
                                "target_lang_word": "scintillating",
                                "target_lang_sense_clarification": "sparklingly clever or brilliant"
