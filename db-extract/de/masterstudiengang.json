                    {
                        "sense_id": "17ef1acf-bb61-3c9e-9ac4-b3fd270dfae1",
                        "entry_id": "6923be78-88fd-36a4-880c-fb0a2571dde7",
                        "glosses": [
                            "Studiengang, an dessen Ende eine Masterarbeit steht, der mit einem Masterabschluss endet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e29c6ff-5d0c-4384-9334-f5a0be339bee",
                                "sense_id": "17ef1acf-bb61-3c9e-9ac4-b3fd270dfae1",
                                "text": "„Aus unserem Jahrgang wurden nur zwei Leute am RCA angenommen (ich und David French, der mir wie Hundescheiße am Schuh klebte), beide für den Masterstudiengang Fotografie.“"
                            },
                            {
                                "example_id": "270cd864-99ba-48ab-b992-172b5fdc0130",
                                "sense_id": "17ef1acf-bb61-3c9e-9ac4-b3fd270dfae1",
                                "text": "„Er war im zweiten Jahr seines Masterstudiengangs am Caltech, und als er ihr an jenem Sommerabend zusah, wusste er, dass er verloren war.“"
                            }
                        ],
