                "senses": [
                    {
                        "sense_id": "bb78ed05-62aa-384d-a0ef-e3386fffb959",
                        "entry_id": "7a00a2bf-e593-35d5-bb9e-6dfacb9193ec",
                        "glosses": [
                            "Situation, in der mehrere/viele Tore in einem Spiel erzielt werden"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "45efc991-4919-4762-914c-0835eac8cfde",
                                "sense_id": "bb78ed05-62aa-384d-a0ef-e3386fffb959",
                                "text": "„In der ersten Hälfte gegen Australien eröffnete Rapinoe den Torreigen mit einer direkt verwandelten Ecke.“"
                            },
                            {
                                "example_id": "cfaa0cc5-85eb-4c63-9135-7e44c4dde01d",
                                "sense_id": "bb78ed05-62aa-384d-a0ef-e3386fffb959",
                                "text": "„Augsburgs Jeffrey Gouweleeuw eröffnete den Torreigen in der 9. Minute mit einem Eigentor, danach schossen Serge Gnabry, Joshua Kimmich und Kingsley Coman die Bayern zu einem beruhigenden 4:0-Pausenvorsprung.“"
                            },
                            {
                                "example_id": "cdb317d2-b241-4a1b-98fb-a4c00e013bbb",
                                "sense_id": "bb78ed05-62aa-384d-a0ef-e3386fffb959",
                                "text": "„Der Torreigen ging aber unbeirrt weiter.“"
                            },
                            {
                                "example_id": "cb370e4b-952b-41f4-95a4-ecefbabc8d63",
                                "sense_id": "bb78ed05-62aa-384d-a0ef-e3386fffb959",
                                "text": "„Mit diesem Torreigen hat Bayern München jedenfalls seinen Champions-League-Rekord aus dem Jahr 2012 (7:0 gegen Basel) eingestellt.“"
                            },
                            {
                                "example_id": "381fcf27-cc6a-4a1a-aef1-1f7585a5c323",
                                "sense_id": "bb78ed05-62aa-384d-a0ef-e3386fffb959",
                                "text": "„Nachdem OFC-Youngster Egon Bihn den Torreigen in der Schlussminute mit einem Flachschuss freistehend von der Fünfmeterraumlinie zum 6:0 beschließt, bleibt Udo Lattek bei der Pressekonferenz nur noch beißende Ironie […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
