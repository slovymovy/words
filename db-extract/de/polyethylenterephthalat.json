                        "entry_id": "857e51d0-742a-3007-83e4-9e39feb83aa1",
                        "glosses": [
                            "Kunststoff aus der Familie der Polyester, der glasklar ist und dessen Aggregatzustand fest ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b9d51f-b347-4bf6-9fbc-4769c2389468",
                                "sense_id": "2f4dc1dc-45d1-3df2-b604-f0f11a1b13a6",
                                "text": "„Verpackungen aus Kunststoffen im Sinne des Abs. 1 sind Flaschen oder sonstige Gebinde aus Kunststoffen, wie zB Polyethylen (PE), Polypropylen (PP), Polyethylenterephthalat (PET), Polyvinylchlorid (PVC), Polystyrol (PS) oder aus Gemischen oder Materialverbünden dieser Stoffe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
