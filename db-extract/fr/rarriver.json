                ],
                "senses": [
                    {
                        "sense_id": "cc48854e-4144-3eee-8194-880c3f80d431",
                        "entry_id": "1cb1bc4f-55b5-3255-b2a9-999f11991163",
                        "glosses": [
                            "Revenir à son point de départ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f160f20-3fcc-4fb2-acd9-d7d3455acc5e",
                                "sense_id": "cc48854e-4144-3eee-8194-880c3f80d431",
                                "text": "Vu l’heure, il ne devrait pas tarder à rarriver."
                            },
                            {
                                "example_id": "571fc89d-4b71-4a7d-b34e-a80bc5d5e91b",
                                "sense_id": "cc48854e-4144-3eee-8194-880c3f80d431",
                                "text": "Il patinait merveilleusement,\nS’élançant, qu’impétueusement !\nR’arrivant si joliment vraiment."
                            },
                            {
                                "example_id": "65ac6bf3-b019-4f36-b5ec-aef2b0664f3f",
                                "sense_id": "cc48854e-4144-3eee-8194-880c3f80d431",
                                "text": "Si cette affaire réussit, vous me verrez rarriver en France vers l’automne de 1886 pour acheter de nouvelles marchandises moi-même."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb0be615-cca3-339f-933a-3dc70336db20",
                        "entry_id": "1cb1bc4f-55b5-3255-b2a9-999f11991163",
                        "glosses": [
                            "Arriver à nouveau (à quelqu’un)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d037c50-5e45-4c97-8923-e17b8919e32e",
                                "sense_id": "eb0be615-cca3-339f-933a-3dc70336db20",
                                "text": "Tu ne fais que jeter des pierres, Alexis; mais si cela te rarrive, gare !"
                            }
                        ]
                    },
                    {
                        "sense_id": "a05cf6fc-bb39-3e96-b68e-eb50758e92ac",
                        "entry_id": "1cb1bc4f-55b5-3255-b2a9-999f11991163",
                        "glosses": [
                            "Arriver (à quelqu’un)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3316776-e368-43b5-9677-0c056e1a2270",
                                "sense_id": "a05cf6fc-bb39-3e96-b68e-eb50758e92ac",
                                "text": "A m'sure, est-ce pas, j' sais tout c' qui va rarriver, mais chaque fois ça m'en bouche un coin d' voir comment qu' c'est dit."
                            }
                        ]
                    }
                ],
