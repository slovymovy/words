                                    {
                                        "sense_id": "0db535da-6d04-3527-9f45-f8e323f70d75",
                                        "entry_id": "4dbbdb88-b238-3ce1-901e-5ec470271927",
                                        "glosses": [
                                            "Historien et philosophe romain, né en 55 et mort vers 120 ap. J.-C."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac76c843-d26a-449e-b0d5-ac00be259abd",
                                                "sense_id": "0db535da-6d04-3527-9f45-f8e323f70d75",
                                                "text": "Il se souvint alors qu’une dame, à qui il avait déclamé, un jour, un passage de Tacite, lui avait dit d’un ton fâché : « Vous pouvez bien m’insulter si vous voulez, je ne comprends pas ce que vous dites. »"
                                            },
                                            {
                                                "example_id": "86b6bea4-34be-4c6c-8edd-137c7f142ef3",
                                                "sense_id": "0db535da-6d04-3527-9f45-f8e323f70d75",
                                                "text": "Tacite le sait, il ne dit d’ailleurs pas vraiment le contraire, mais fidèle à son habitude générale il manie le sous-entendu avec un art consommé."
                                            },
                                            {
                                                "example_id": "105c334a-710a-448a-bdec-1c17af5d94ec",
                                                "sense_id": "0db535da-6d04-3527-9f45-f8e323f70d75",
                                                "text": "Strabon, Pline et Tacite se plaignent de la mala aria."
                                            }
                                        ]
                                    }
