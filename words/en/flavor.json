{
    "word_family": [
        "flavorful",
        "flavoring",
        "flavorless",
        "flavorsome",
        "flavorist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed110aa2-c90d-33d6-8028-9623b33ca09c",
                    "sense_definition": "A specific variety of taste, especially of food, candy, or drink.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "taste_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chocolate is my favorite <w>flavor</w> of ice cream.",
                            "target_lang_translations": {
                                "ru": "Шоколад — мой любимый <w>вкус</w> мороженого.",
                                "zh": "巧克力是我最喜欢的冰淇淋<w>口味</w>。"
                            }
                        },
                        {
                            "text": "The store sells gum in almost every fruit <w>flavor</w>.",
                            "target_lang_translations": {
                                "ru": "В магазине продается жвачка почти с любым фруктовым <w>вкусом</w>.",
                                "zh": "这家店卖的口香糖几乎涵盖了所有水果<w>口味</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "variety",
                        "kind",
                        "taste"
                    ],
                    "common_phrases": [
                        "favorite flavor",
                        "ice cream flavor",
                        "fruit flavor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность вкуса, особенно еды, сладостей или напитков.",
                        "zh": "指食物、糖果或饮料的特定口味种类。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкус",
                                "target_lang_sense_clarification": "ощущение вкуса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口味",
                                "target_lang_sense_clarification": "指食物或饮料的种类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8d8dd7b-97af-3b1f-a503-5534ebb54e55",
                    "sense_definition": "The particular quality of a food or drink that is perceived by the tongue and nose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "taste_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fresh herbs can add a wonderful <w>flavor</w> to the soup.",
                            "target_lang_translations": {
                                "ru": "Свежая зелень может придать супу чудесный <w>вкус</w>.",
                                "zh": "新鲜香草能为汤增添美妙的<w>风味</w>。"
                            }
                        },
                        {
                            "text": "I do not like the spicy <w>flavor</w> of this sauce.",
                            "target_lang_translations": {
                                "ru": "Мне не нравится острый <w>вкус</w> этого соуса.",
                                "zh": "我不喜欢这种酱料辛辣的<w>味道</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "taste",
                        "savour"
                    ],
                    "common_phrases": [
                        "strong flavor",
                        "rich flavor",
                        "mild flavor",
                        "distinct flavor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое свойство еды или напитка, воспринимаемое языком и носом.",
                        "zh": "食物或饮料通过舌头和鼻子感知到的特定品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкус",
                                "target_lang_sense_clarification": "общее вкусовое впечатление"
                            },
                            {
                                "target_lang_word": "аромат",
                                "target_lang_sense_clarification": "запах, букет"
                            },
                            {
                                "target_lang_word": "привкус",
                                "target_lang_sense_clarification": "оттенок вкуса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "味道",
                                "target_lang_sense_clarification": "食物的整体口感"
                            },
                            {
                                "target_lang_word": "风味",
                                "target_lang_sense_clarification": "独特的口感特色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26ff2835-fb44-3d6c-bc36-497a8cc7ba63",
                    "sense_definition": "A substance added to food or drink to give it a specific taste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "taste_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This beverage contains no artificial colors or <w>flavors</w>.",
                            "target_lang_translations": {
                                "ru": "Этот напиток не содержит искусственных красителей или <w>ароматизаторов</w>.",
                                "zh": "这种饮料不含人工色素或<w>调味剂</w>。"
                            }
                        },
                        {
                            "text": "The chef used a natural vanilla <w>flavor</w> in the cake mix.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар использовал натуральный ванильный <w>ароматизатор</w> в смеси для торта.",
                                "zh": "厨师在蛋糕预拌粉中使用了天然香草<w>调味剂</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flavoring",
                        "seasoning"
                    ],
                    "common_phrases": [
                        "artificial flavor",
                        "natural flavor",
                        "add flavor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, добавляемое в пищу или напиток для придания определенного вкуса.",
                        "zh": "为食物或饮料添加以赋予其特定味道的物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ароматизатор",
                                "target_lang_sense_clarification": "пищевая добавка"
                            },
                            {
                                "target_lang_word": "приправа",
                                "target_lang_sense_clarification": "специи, добавки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调味剂",
                                "target_lang_sense_clarification": "用于增加味道的添加剂"
                            },
                            {
                                "target_lang_word": "调味料",
                                "target_lang_sense_clarification": "烹饪中使用的配料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d120e7e5-45ed-3b8a-9def-216d383840d8",
                    "sense_definition": "The distinctive atmosphere, quality, or character of a place, time, or experience.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The outdoor market has a distinct international <w>flavor</w>.",
                            "target_lang_translations": {
                                "ru": "Уличный рынок имеет отчетливый международный <w>колорит</w>.",
                                "zh": "这个露天市场有着独特的国际<w>风情</w>。"
                            }
                        },
                        {
                            "text": "Her stories capture the true <w>flavor</w> of life in the 1920s.",
                            "target_lang_translations": {
                                "ru": "Её рассказы передают истинный <w>колорит</w> жизни 1920-х годов.",
                                "zh": "她的故事捕捉到了20世纪20年代生活的真实<w>风情</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "atmosphere",
                        "character",
                        "feel",
                        "ambience"
                    ],
                    "common_phrases": [
                        "local flavor",
                        "international flavor",
                        "capture the flavor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерная атмосфера, качество или дух места, времени или события.",
                        "zh": "某地、某时或某种经历所具有的独特氛围、品质或特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колорит",
                                "target_lang_sense_clarification": "местный колорит, своеобразие"
                            },
                            {
                                "target_lang_word": "атмосфера",
                                "target_lang_sense_clarification": "общий дух"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风情",
                                "target_lang_sense_clarification": "地方特色或独特氛围"
                            },
                            {
                                "target_lang_word": "特色",
                                "target_lang_sense_clarification": "独特的性质或风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92af16ac-93c1-3731-892b-0986ffeeaf0a",
                    "sense_definition": "A particular type, version, or variety of something, often used in computing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are many different <w>flavors</w> of the Linux operating system.",
                            "target_lang_translations": {
                                "ru": "Существует много разных <w>разновидностей</w> операционной системы Linux.",
                                "zh": "Linux操作系统有很多不同的<w>版本</w>。"
                            }
                        },
                        {
                            "text": "The software comes in two <w>flavors</w>: standard and professional.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение поставляется в двух <w>вариантах</w>: стандартном и профессиональном.",
                                "zh": "该软件有两种<w>版本</w>：标准版和专业版。"
                            }
                        }
                    ],
                    "synonyms": [
                        "version",
                        "variant",
                        "type"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in technical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный тип, версия или разновидность чего-либо (часто в информатике).",
                        "zh": "某事物的特定类型、版本或变体，常用于计算机领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разновидность",
                                "target_lang_sense_clarification": "вариант"
                            },
                            {
                                "target_lang_word": "версия",
                                "target_lang_sense_clarification": "выпуск ПО"
                            },
                            {
                                "target_lang_word": "тип",
                                "target_lang_sense_clarification": "вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "版本",
                                "target_lang_sense_clarification": "软件或系统的不同变体"
                            },
                            {
                                "target_lang_word": "类型",
                                "target_lang_sense_clarification": "事物的种类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e2cdbf7-c041-3d66-93c6-3d629aa82209",
                    "sense_definition": "A quantum number or property that distinguishes different types of quarks and leptons.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Physicists have identified six different <w>flavors</w> of quarks.",
                            "target_lang_translations": {
                                "ru": "Физики определили шесть различных <w>ароматов</w> кварков.",
                                "zh": "物理学家已经确定了六种不同的夸克<w>味</w>。"
                            }
                        },
                        {
                            "text": "The weak force is capable of changing the <w>flavor</w> of a particle.",
                            "target_lang_translations": {
                                "ru": "Слабое взаимодействие способно изменять <w>аромат</w> частицы.",
                                "zh": "弱相互作用能够改变粒子的<w>味</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Квантовое число или свойство, различающее типы кварков и лептонов.",
                        "zh": "区分不同类型夸克和轻子的量子数或属性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аромат",
                                "target_lang_sense_clarification": "физический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "味",
                                "target_lang_sense_clarification": "物理学中的粒子属性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "237c6632-d8f4-30eb-a7da-5c797a504b2a",
                    "sense_definition": "To give a distinctive taste to food or drink by adding spices, herbs, or other substances.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>flavor</w> the sauce with garlic and fresh basil.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>приправить</w> соус чесноком и свежим базиликом.",
                                "zh": "你可以用大蒜和新鲜罗勒为酱汁<w>调味</w>。"
                            }
                        },
                        {
                            "text": "The rice was <w>flavored</w> with saffron to give it a yellow color.",
                            "target_lang_translations": {
                                "ru": "Рис был <w>приправлен</w> шафраном для придания ему желтого цвета.",
                                "zh": "米饭用藏红花<w>调味</w>，使其呈现黄色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "season",
                        "spice"
                    ],
                    "common_phrases": [
                        "flavor with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать вкус еде или напитку добавлением специй, трав или других веществ.",
                        "zh": "通过添加香料、草药或其他物质使食物或饮料具有独特的味道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приправлять",
                                "target_lang_sense_clarification": "добавлять специи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调味",
                                "target_lang_sense_clarification": "给食物增加味道"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}