                                "target_senses": [
                                    {
                                        "sense_id": "9a14d9d9-0ead-38ec-8764-9e9f61886763",
                                        "entry_id": "10b36a1f-3efa-3ae9-9555-8996843fbfb9",
                                        "glosses": [
                                            "большой турецкий тесак или кинжал с двойным изгибом, отточенный с одной стороны"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433fbfc8-6170-4bc7-ac04-431c8b251c91",
                                                "sense_id": "9a14d9d9-0ead-38ec-8764-9e9f61886763",
                                                "text": "В простенках меж окнами висели турецкие пистолеты, ятаганы, польские сабли и прочие домашние трофеи военных подвигов Ивана Алексеевича Асанова."
                                            },
                                            {
                                                "example_id": "2fb349fc-54ac-40fd-9913-bf610e822ea6",
                                                "sense_id": "9a14d9d9-0ead-38ec-8764-9e9f61886763",
                                                "text": "Янычары перерубали ятаганами древки казачьих пик, и обезоруженные казаки погибали сотнями."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
