                ],
                "senses": [
                    {
                        "sense_id": "a74def6d-80d0-397a-a44e-c9c76a5bd44e",
                        "entry_id": "392fff9a-5e58-3735-a543-d01373dcdbbb",
                        "glosses": [
                            "Souverain safavide, roi de la Perse."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "770f1491-dbe7-4396-b4d7-52caff33d0dc",
                                "sense_id": "a74def6d-80d0-397a-a44e-c9c76a5bd44e",
                                "text": "Ismaël sofi envoya au Kaire une ambassade solennelle, pour obtenir la paix."
                            },
                            {
                                "example_id": "37c13254-97fc-4805-af5c-242715304d03",
                                "sense_id": "a74def6d-80d0-397a-a44e-c9c76a5bd44e",
                                "text": "Hé ! qu'avons-nous affaire Du turc ni du sophy ?\nPourvu que j'aye à boire, Des grandeurs je di : fy !"
                            },
                            {
                                "example_id": "5d26b00a-8c1c-4280-bba6-f8f76e3011df",
                                "sense_id": "a74def6d-80d0-397a-a44e-c9c76a5bd44e",
                                "text": "Sophiz, voyant qu’il avoit subjugué et mis en obeissance la region et pays dudit Usson Cassan, et mis seurement et stablement chacun en son endroit, retourna en la dicte ville de Thauriz, qui est la cité principale du pays."
                            },
                            {
                                "example_id": "7971b306-33ac-45bd-85ca-de17bc4cc26e",
                                "sense_id": "a74def6d-80d0-397a-a44e-c9c76a5bd44e",
                                "text": "Quand je suis seul, je fais au plus brave un défi ;\nJe m’écarte, je vais détrôner le Sophi ;\nOn m’élit roi, mon peuple m’aime ;"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cabb55d-f3d2-42df-9e40-77c6e2c9e6d1",
                        "source_entry_id": "392fff9a-5e58-3735-a543-d01373dcdbbb",
