                "senses": [
                    {
                        "sense_id": "20acc106-71c9-340d-84e1-cd4b159518ad",
                        "entry_id": "d9d495b8-4ea7-3f83-b295-adfda293130c",
                        "glosses": [
                            "Sauce piquante faite d’huile, de moutarde, de fines herbes pilées et de divers condiments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6a6a4b8-e21a-473d-b0f3-788f0232783f",
                                "sense_id": "20acc106-71c9-340d-84e1-cd4b159518ad",
                                "text": "Oignons, échalotes et câpres viennent souvent constituer l'assaisonnement; la rémoulade (mayonnaise augmentée d'herbes et épices) est une sauce courante."
                            }
                        ]
                    },
                    {
                        "sense_id": "d556e2f3-1396-33c8-ac6f-680df188488c",
                        "entry_id": "d9d495b8-4ea7-3f83-b295-adfda293130c",
                        "glosses": [
                            "Sorte de mets préparé avec cette sauce."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f009d3ee-65d1-450b-86a9-6e9455a8847c",
                                "sense_id": "d556e2f3-1396-33c8-ac6f-680df188488c",
                                "text": "Au déjeuner, le menu carte remporte tous les suffrages, notamment avec une rémoulade de céleri, crevettes et coques à la ciboulette et une soupe de chocolat, fruits secs caramélisés."
                            }
                        ]
                    },
                    {
                        "sense_id": "67379590-6279-38ff-8b40-574133c6c113",
                        "entry_id": "d9d495b8-4ea7-3f83-b295-adfda293130c",
                        "glosses": [
                            "Sorte d'onguent à base de lie-de-vin et de miel que l'on utilisait en cataplasme sur les chevaux en cas de foulure."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ea3448cd-1f94-45ac-b307-bc54c48c5a67",
                                "sense_id": "67379590-6279-38ff-8b40-574133c6c113",
                                "text": "Il faut en le pansant avoir soin de faire sortir la matière qui peut y rester, & si la seconde fois qu'on le fait la rémoulade est trop séche , il en faut mettre de la nouvelle."
                            }
                        ]
                    }
                ],
