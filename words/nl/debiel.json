{
    "word_family": [
        "debiliteit"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "91d3a534-255e-353d-9429-dc35b3744165",
                    "sense_definition": "Bespottelijk, idioot of uiterst dom.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stupid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die kerel is echt <w>debiel</w> als hij denkt dat hij dat zomaar kan doen.",
                            "target_lang_translations": {
                                "en": "That guy is really <w>idiotic</w> if he thinks he can just do that."
                            }
                        },
                        {
                            "text": "Ik vind het echt een <w>debiel</w> idee om nu nog naar buiten te gaan.",
                            "target_lang_translations": {
                                "en": "I think it is a truly <w>ridiculous</w> idea to go outside at this hour."
                            }
                        }
                    ],
                    "synonyms": [
                        "idioot",
                        "belachelijk",
                        "bespottelijk",
                        "ridicuul",
                        "achterlijk"
                    ],
                    "antonyms": [
                        "verstandig",
                        "slim"
                    ],
                    "common_phrases": [
                        "een debiel idee",
                        "echt debiel gedrag"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used as an insult or informal intensifier."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Ridiculous, idiotic, or extremely stupid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ridiculous",
                                "target_lang_sense_clarification": "highly foolish or absurd"
                            },
                            {
                                "target_lang_word": "ludicrous",
                                "target_lang_sense_clarification": "idiotic or unthinkable to the point of being funny"
                            },
                            {
                                "target_lang_word": "retarded",
                                "target_lang_sense_clarification": "extremely stupid or obtuse (highly offensive/colloquial)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63d1343c-7989-3036-a84b-c74fd5ed9c2b",
                    "sense_definition": "In lichte mate verstandelijk of mentaal beperkt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disabled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>debiel</w> iemand zou die ingewikkelde mop minder snel of helemaal niet doorhebben.",
                            "target_lang_translations": {
                                "en": "A <w>mentally disabled</w> person would be less likely to understand that complicated joke, or might not get it at all."
                            }
                        },
                        {
                            "text": "In oude medische handboeken werd deze term gebruikt voor een <w>debiele</w> patiënt.",
                            "target_lang_translations": {
                                "en": "In old medical textbooks, this term was used for a <w>debile</w> patient."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwakzinnig",
                        "verstandelijk beperkt"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This clinical term is now considered offensive and is outdated in medical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Mildly mentally disabled or intellectually impaired."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "retarded",
                                "target_lang_sense_clarification": "having mental retardation (dated, offensive)"
                            },
                            {
                                "target_lang_word": "debile",
                                "target_lang_sense_clarification": "having debilism or mild mental subnormality (historical/dated)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3c04c3e-54a2-3864-b86a-359de149c8fb",
                    "sense_definition": "Een bespottelijk of uiterst dom persoon; een idioot.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stupid_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>debiel</w> maakt zichzelf volkomen belachelijk door te denken dat hij grappig is.",
                            "target_lang_translations": {
                                "en": "That <w>moron</w> is making a complete fool of himself by thinking he is funny."
                            }
                        },
                        {
                            "text": "Doe niet zo raar, je gedraagt je als een <w>debiel</w> op straat.",
                            "target_lang_translations": {
                                "en": "Don't be so weird, you are behaving like an <w>idiot</w> in the street."
                            }
                        }
                    ],
                    "synonyms": [
                        "idioot",
                        "halve gare",
                        "oest",
                        "gek"
                    ],
                    "common_phrases": [
                        "gedragen als een debiel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a strong insult."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A ridiculous or extremely stupid person; an idiot."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moron",
                                "target_lang_sense_clarification": "a stupid person or fool (informal, derogatory)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9021d04-7b01-3482-9b33-073101d822f7",
                    "sense_definition": "Iemand die in lichte mate verstandelijk beperkt is.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disabled_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger werd iemand met een IQ tussen 50 en 75 officieel bestempeld als een <w>debiel</w>.",
                            "target_lang_translations": {
                                "en": "In the past, someone with an IQ between 50 and 75 was officially classified as a <w>moron</w>."
                            }
                        },
                        {
                            "text": "In de moderne zorg vermijdt men het woord <w>debiel</w> vanwege het stigmatiserende karakter.",
                            "target_lang_translations": {
                                "en": "In modern healthcare, the word <w>retard</w> is avoided because of its stigmatizing nature."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwakzinnige"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This clinical term is now considered offensive and is outdated in medical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is mildly mentally disabled."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moron",
                                "target_lang_sense_clarification": "a person of mild mental subnormality in former classifications (dated)"
                            },
                            {
                                "target_lang_word": "debile",
                                "target_lang_sense_clarification": "a person with mild mental defects in historical medical contexts"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}