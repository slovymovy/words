                    }
                ],
                "translations": [
                    {
                        "translation_id": "a70ca0fc-bc01-4244-b9c9-817bf0983228",
                        "source_entry_id": "c794e072-d947-3847-8828-cc96d957f350",
                        "source_sense_id": "e3b5f864-033a-3b33-9879-679b644aaa2d",
                        "target_lang_word": "puerpera",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puerpera",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "513c54a4-8cd8-30cf-884a-89b900338d27",
                                        "entry_id": "550b0348-0d6e-31f0-861c-1e7f721e28ba",
                                        "glosses": [
                                            "A woman undergoing puerperium; a woman whose uterus is still enlarged from pregnancy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37d4257-0813-4460-9216-781535d86695",
                                                "sense_id": "513c54a4-8cd8-30cf-884a-89b900338d27",
                                                "text": "I saw a very serious hemorrhage result from relaxation of the uterus on the eleventh day when the puerpera had been frightened by a domestic quarrel."
                                            },
                                            {
                                                "example_id": "42ede984-81a9-4ca7-98ae-ccfe02c34ce5",
                                                "sense_id": "513c54a4-8cd8-30cf-884a-89b900338d27",
                                                "text": "Since one of the principal reasons for keeping the puerpera in a recumbent posture is avoidance of strain upon relaxed and weakened supporting structures by a large heavy uterus, the length of the stay in bed is not made a matter of routine"
                                            },
                                            {
                                                "example_id": "741070dd-8b52-4886-958b-e1980b1a5468",
                                                "sense_id": "513c54a4-8cd8-30cf-884a-89b900338d27",
                                                "text": "A statistically significant circadian rhythm for urine volume was revealed in 6 of 10 pregnant women in the first trimester and in 6 of 9 puerperas on the 7th puerperal day."
                                            },
                                            {
                                                "example_id": "b3d8d350-533e-4e52-8874-a2c491f04f2e",
                                                "sense_id": "513c54a4-8cd8-30cf-884a-89b900338d27",
                                                "text": "Abdominal ultrasound of the puerpera usually does not require a full bladder, because the enlarged uterus directly abuts the anterior abdominal wall and can be scanned without difficulty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a97f14b8-50e3-3ba1-b010-fac7323d9bfe",
                                        "entry_id": "550b0348-0d6e-31f0-861c-1e7f721e28ba",
                                        "glosses": [
                                            "A woman who has recently given birth."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c38e095-b793-4b60-8928-0c90c8adbafa",
                                                "sense_id": "a97f14b8-50e3-3ba1-b010-fac7323d9bfe",
                                                "text": "An often proved Remedy to bring away what is, or should not be left in the Womb of a Puerpera, though it were Part of a dead Child."
                                            },
                                            {
                                                "example_id": "fc173d71-9e4e-4686-ab2a-fde640343f09",
                                                "sense_id": "a97f14b8-50e3-3ba1-b010-fac7323d9bfe",
                                                "text": "\"I must acknowledge, if Kolletschka's disease and the disease from which I saw so many puerperae die, are identical, then in the puerperae it must be produced by the self-same engendering cause, which produced it in Kolletschka.\""
                                            },
                                            {
                                                "example_id": "8fe87969-5f29-4b4b-a43d-6b584093ae6e",
                                                "sense_id": "a97f14b8-50e3-3ba1-b010-fac7323d9bfe",
                                                "text": "Among the ancient Iranians, the puerpera, like the menstruating woman, was regarded as \"unclean\"."
                                            },
                                            {
                                                "example_id": "36c410b7-bfa8-4c45-a8ef-e3e34de75511",
                                                "sense_id": "a97f14b8-50e3-3ba1-b010-fac7323d9bfe",
                                                "text": "With the exception of the very nearest, — for instance, the husband and the mother of the puerpera, — visitors should be kept away until she has been out of bed for a few days, and even then admitted only in small numbers and one at a time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b9157fb-95a9-4f19-bd97-3937b653a7d1",
                        "source_entry_id": "c794e072-d947-3847-8828-cc96d957f350",
                        "source_sense_id": "e3b5f864-033a-3b33-9879-679b644aaa2d",
