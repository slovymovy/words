                        "examples": [
                            {
                                "example_id": "4e2b520b-9e33-4744-acbf-661618fe0308",
                                "sense_id": "9116a343-9fb4-39d0-887a-b7e660f8e5b6",
                                "text": "Duinen werden afgegraven, kronkelende wegen en riviertjes recht gemaakt, boomgaarden en akkers vervangen door kassenbouw en de oude landgoederen zo goed als allemaal van de kaart geveegd."
                            },
                            {
                                "example_id": "218adbd7-6d6a-4683-97df-82c38387cc13",
                                "sense_id": "9116a343-9fb4-39d0-887a-b7e660f8e5b6",
                                "text": "In de jaren dertig kwam de kelder door het afgraven van de duinen bij Monster ten behoeve van de kassenbouw vijf meter boven het maaiveld te liggen en veranderde daardoor in een grafheuvel."
                            },
                            {
                                "example_id": "3ae43912-fd60-4ed8-899d-b612d5f29445",
                                "sense_id": "9116a343-9fb4-39d0-887a-b7e660f8e5b6",
                                "text": "Ook de oer-Hollandse kassenbouw zou het goed kunnen gaan doen in Iran. \"Iran is een interessant land met vijf klimaatzones\", zegt manager Den Heijer van Van der Hoeven Horticultural. \"Het gaat dus niet om standaard kassenbouw. Ook op de watertekorten kunnen wij goed inspelen met onze kassen.\""
                            }
                        ]
                    }
