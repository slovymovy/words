                    {
                        "sense_id": "4b932b51-bbe2-391b-8e50-ffda3f56682c",
                        "entry_id": "be7341c7-fe4e-37a9-97ea-d9ab6049a85e",
                        "glosses": [
                            "die Gesamtheit der Techniken, die genutzt werden, um Information zu erzeugen, zu verarbeiten, zu transportieren und zu speichern. Die Informationstechnik ist dabei ein Bindeglied zwischen der Elektrotechnik und der Informatik."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee92c6b1-94c8-4c13-bcd7-9e15b1c848b0",
                                "sense_id": "4b932b51-bbe2-391b-8e50-ffda3f56682c",
                                "text": "„Seit mehr als einem Jahrzehnt verändert die Informationstechnik unser Leben in einem raschen Tempo: Internet und Mobilfunk sind die Grundlage für neue Formen der Kommunikation, des Handels und der Unterhaltung geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
