                "senses": [
                    {
                        "sense_id": "e76f8592-05fb-3d41-b7cc-76d215276757",
                        "entry_id": "3b6a433a-4f07-3072-ab5a-1a9edc7dd41f",
                        "glosses": [
                            "A country in Central America. Official name: Republic of Panama."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aec2ce50-6a28-4a90-aa54-1e2d64b4db14",
                                "sense_id": "e76f8592-05fb-3d41-b7cc-76d215276757",
                                "text": "A man, a plan, a canal — Panama!"
                            },
                            {
                                "example_id": "a7a87994-d6df-4217-9a20-00633912804f",
                                "sense_id": "e76f8592-05fb-3d41-b7cc-76d215276757",
                                "text": "Economists at Capital Economics wrote in an August note that dollarized countries El Salvador, Panama and Ecuador show “markedly lower inflation than elsewhere in the region.”"
                            }
                        ]
                    }
                ],
