                ],
                "senses": [
                    {
                        "sense_id": "971ebe8e-03a9-38cd-87aa-5e4afc3ba17e",
                        "entry_id": "75321310-f07c-33f7-b05f-04930618f5fb",
                        "glosses": [
                            "osoba zajmująca się szerzeniem propagandy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca43d5d-27cf-4cba-ad0e-fb21d19cfdfc",
                                "sense_id": "971ebe8e-03a9-38cd-87aa-5e4afc3ba17e",
                                "text": "Jeszcze w 1986 r. kanclerz Kohl porównał swego późniejszego przyjaciela Gorbaczowa z hitlerowskim propagandzistą Josephem Goebbelsem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a25c043b-19e4-447d-b3a7-4d60b41f67e9",
                        "source_entry_id": "75321310-f07c-33f7-b05f-04930618f5fb",
                        "source_sense_id": "971ebe8e-03a9-38cd-87aa-5e4afc3ba17e",
                        "target_lang_word": "propagandist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "propagandist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c03c1c9-e671-3096-bee0-7ca4165bf386",
                                        "entry_id": "9cd2803a-24ce-31b3-96f8-4702dc1a41da",
                                        "glosses": [
                                            "A person who disseminates propaganda."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b7135ab-368c-4d3f-8ad2-85db4629a013",
                                                "sense_id": "2c03c1c9-e671-3096-bee0-7ca4165bf386",
                                                "text": "Every country has been officially invited by the Belgian Government to send delegates to the International Congress of Agricultural Associations, which will take pace at Brussels in September, 1910. In most countries propagandist committees have been formed in connection with this Congress."
                                            },
                                            {
                                                "example_id": "984b804a-4cb2-47a2-94ac-48778dfe45da",
                                                "sense_id": "2c03c1c9-e671-3096-bee0-7ca4165bf386",
                                                "text": "\"Astroturfers and propagandists tend to attack and controversialize the news organizations, personalities and people surrounding an issue rather than sticking to the facts.\""
                                            },
                                            {
                                                "example_id": "ed4935f6-bff0-435d-91ab-aebbfe0afb44",
                                                "sense_id": "2c03c1c9-e671-3096-bee0-7ca4165bf386",
                                                "text": "It's Alexander the Great who everyone remembers and much of that is down to his and his propagandists' genius."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "propagandist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32f0387e-cc04-3a8e-aada-00ed67164087",
                                        "entry_id": "91a22915-d56a-3fd4-a696-a0f1774409b1",
                                        "glosses": [
                                            "Consisting of or spreading propaganda."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d248fc-085f-4179-b033-5103bbc55e37",
                                                "sense_id": "32f0387e-cc04-3a8e-aada-00ed67164087",
                                                "text": "Of course many of these accounts were propagandist in intention and designed for an unsophisticated audience."
                                            },
                                            {
                                                "example_id": "c62681f3-fe35-44e0-9f98-ac1bda8c1ce7",
                                                "sense_id": "32f0387e-cc04-3a8e-aada-00ed67164087",
                                                "text": "In another comment from the audience, one woman raised what is perhaps the anti-pornography movement's strongest point. \"There's a strain of pornography which is incredibly propagandist against women,\" she said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "166e41e4-b51f-4224-9e1c-0bb98cdad45c",
                        "source_entry_id": "75321310-f07c-33f7-b05f-04930618f5fb",
                        "source_sense_id": "971ebe8e-03a9-38cd-87aa-5e4afc3ba17e",
                        "target_lang_word": "propagandista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "propagandista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "412ed1b3-f30d-3cad-9fab-7f2e23636da1",
                                        "entry_id": "a5678390-3a9c-3af6-b016-c38da4d29afc",
                                        "glosses": [
                                            "Aquel que hace propaganda."
                                        ],
                                        "tags": [
