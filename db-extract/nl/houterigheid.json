                        "translation_id": "4c8e612a-cc6c-4800-bfe8-bd449e371926",
                        "source_entry_id": "0c356713-1668-3675-9343-004feab79573",
                        "source_sense_id": "f11d6824-789e-39a0-9dd0-6130133b2c85",
