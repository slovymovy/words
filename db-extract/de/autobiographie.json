                    },
                    {
                        "form_id": "51b82af4-7759-4490-963f-184ce8326415",
                        "entry_id": "cbac4d55-96a3-3a5b-ae65-c558360c0b0d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Autobiographien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49fd0258-64b5-3251-953c-03d3c28bd3a3",
                        "entry_id": "cbac4d55-96a3-3a5b-ae65-c558360c0b0d",
                        "glosses": [
                            "Lebensbeschreibung einer Person, die von dieser Person selbst verfasst wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25afb3ee-a767-4e4e-a678-407a22f9cd5b",
                                "sense_id": "49fd0258-64b5-3251-953c-03d3c28bd3a3",
                                "text": "„In Wahrheit siechte Seume dahin, schrieb zwischen den geliebten Toten aus dem alten Griechenland seine Autobiographie, exzerpierte Plutarch und notierte Aphorismen, von denen er schon ahnte, dass sie apokryph bleiben würden.“"
                            },
                            {
                                "example_id": "e8bf9246-f174-4fd6-b330-4dd6483e6ea5",
                                "sense_id": "49fd0258-64b5-3251-953c-03d3c28bd3a3",
                                "text": "„Außerdem erzähl ich euch auch nicht meine ganze verfluchte Autobiographie oder so was.“"
                            },
                            {
                                "example_id": "58583b0c-a699-4447-940b-cee5c8d452e3",
                                "sense_id": "49fd0258-64b5-3251-953c-03d3c28bd3a3",
                                "text": "„So verwundert es nicht, dass die Mehrzahl der von Roma geschriebenen literarischen Werke entweder Autobiographien sind oder autobiographische Züge tragen.“"
                            },
                            {
                                "example_id": "14cc34d2-a5a0-4b3c-8e50-d6fcd42dc3a4",
                                "sense_id": "49fd0258-64b5-3251-953c-03d3c28bd3a3",
                                "text": "„Er erlebt Paris, er lebt es, und er fängt es in Büchern ein, die endlose Autobiographien nach der einen Seite, endlose Abwandlungen des Themas Paris nach der anderen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
