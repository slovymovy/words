                                        "sense_id": "383ca025-ad67-3598-9af3-0b7a9a654963",
                                        "entry_id": "df38ee38-1612-350e-99f1-12e4de5ed977",
                                        "glosses": [
                                            "Alternative form of vetero-testamentary."
