                                            {
                                                "example_id": "342a3df8-1532-48a4-b0d8-9e1323a81d63",
                                                "sense_id": "7f7e351b-349d-3a6c-b5ef-14826a4c1cf1",
                                                "text": "Mr. Pemoulie said the chefs tried various types of flour, multiple fryings, turning the batter into foam, and adding vodka to it (that idea stuck)."
                                            },
                                            {
                                                "example_id": "0f511dd0-ae5e-4be0-93a2-a227df5cc077",
                                                "sense_id": "7f7e351b-349d-3a6c-b5ef-14826a4c1cf1",
                                                "text": "There were signs of recent roastings and fryings, and Frank explained he’d been eating pretty well, making his way through frozen stocks from the shop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
