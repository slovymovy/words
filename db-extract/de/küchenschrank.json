                ],
                "senses": [
                    {
                        "sense_id": "6fddf081-edc1-31a1-996c-4ba76c4fade4",
                        "entry_id": "5e837d1b-f6de-3056-b738-ad1eebdcb44f",
                        "glosses": [
                            "Schrank für die Küche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8481cca7-59f4-4b67-91ca-0be49b4437f8",
                                "sense_id": "6fddf081-edc1-31a1-996c-4ba76c4fade4",
                                "text": "„Lassehn lehnt gegen den Küchenschrank und hat die Arme über der Brust gekreuzt.“"
                            },
                            {
                                "example_id": "90b5d161-36eb-4bab-8f59-fe402722dee2",
                                "sense_id": "6fddf081-edc1-31a1-996c-4ba76c4fade4",
                                "text": "„Es gibt doch noch einen Küchenschrank.“"
                            },
                            {
                                "example_id": "b320a8bd-ceb1-4713-b2d4-c6b8f3b0d5a1",
                                "sense_id": "6fddf081-edc1-31a1-996c-4ba76c4fade4",
                                "text": "„An den Küchenschrank gelehnt, stand ein hochgewachsener, eleganter deutscher Offizier, die Arme vor der Brust verschränkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
