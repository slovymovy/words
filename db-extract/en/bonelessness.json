                        "glosses": [
                            "The state or quality of being boneless."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "82ad24d3-a110-496b-b6ef-2582eb9960e4",
                                "sense_id": "6cbf074c-dbf5-3d61-a3a0-0871022a63be",
                                "text": "1889, Pan [pseudonym of Oliver Herbrand Gordon Leigh], Dinnerology: Our Experiments in Diet, Chicago, New York and San Francisco: Belford, Clarke & Co., Chapter 3, p. 41,\nOur “fish” course would include salmon steaks, cod rissoles, oysters and other finny-cal morsels, and we prided ourselves on their bonelessness."
                            },
                            {
                                "example_id": "1c0640be-47eb-4997-abdb-f00476c0998b",
                                "sense_id": "6cbf074c-dbf5-3d61-a3a0-0871022a63be",
                                "text": "The dancer wears a long, soft drapery, which is never lifted to her ankles. Agility and apparent bonelessness are her characteristics."
                            },
                            {
                                "example_id": "4b489052-97a1-4bf7-83aa-5adb84e68d29",
                                "sense_id": "6cbf074c-dbf5-3d61-a3a0-0871022a63be",
                                "text": "His face was as soft and round as a dumpling. There seemed to be no structure in it. no indication of a skull beneath the skin. ¶ This unpleasant effect might have argued an equally unpleasant temperament. Luckily this was not so. But it exemplified a parallel bonelessness of outlook."
                            }
                        ]
                    }
