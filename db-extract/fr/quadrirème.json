                        "cross_references": [
                            {
                                "target_word": "quadrireme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd61b979-e0be-36af-91ad-25fc74e5839d",
                                        "entry_id": "610dc92f-188f-38f5-acd8-5df681bc0de0",
                                        "glosses": [
                                            "A galley with four banks of oars, each rowed by two oarsmen."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95c2eacf-bb1a-42d9-a9a9-54ae9b037982",
                                                "sense_id": "cd61b979-e0be-36af-91ad-25fc74e5839d",
                                                "text": "The Romanes hauing gained this prise, & ioyned hir to the Quadrireme bothe well furnished of all necessaries, kept them continnally in the entraunce, prohibiting withoute any difficultie the easie entrance of their enimies into Lilybeum."
                                            },
                                            {
                                                "example_id": "8a04cd11-77dd-472e-b179-fa9168cddfb6",
                                                "sense_id": "cd61b979-e0be-36af-91ad-25fc74e5839d",
                                                "text": "During three decades of peace the Venetian battle fleet had stagnated, but soon, once again, reserve galleys were pushing out of the Arsenal. A colossal quadrireme constructed by the scholar-turned-shipwright Vettor Fausto was loaded with batteries of cannon."
                                            }
                                        ]
                                    }
                                ]
                            }
