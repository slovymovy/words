                        "entry_id": "7135f533-6ea7-3ff8-a6d5-62b1ab56798c",
                        "glosses": [
                            "Messgerät, mit dem der Anteil der Grundfarben in einem Farbgemisch ermittelt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2703c584-3945-4102-85cf-28cb7ba1eae0",
                                "sense_id": "67133701-b474-3bf8-8f1e-299f63b199c4",
                                "text": "„Die Monosaccharide wie Xylose, Arabinose, Glucose und Galactose wurden mit dem Chromatometer auch quantitativ bestimmt.“"
                            },
                            {
                                "example_id": "4aad18b9-77ac-4493-8802-9d4a5d053ff1",
                                "sense_id": "67133701-b474-3bf8-8f1e-299f63b199c4",
                                "text": "„Bei den Grundeinstellungen für die Kalibrierung zeigt die Software die exakte Stelle für die Positionierung des Chromatometers an.“"
                            }
                        ],
