{
    "word": "respire",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b2ff09d3-6700-3899-ad8e-618c967260a8",
                "word": "respire",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "596dab23-4b34-388b-a939-83ffc3dd5b47",
                        "entry_id": "b2ff09d3-6700-3899-ad8e-618c967260a8",
                        "glosses": [
                            "Rest, respite."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7ac147c4-fe68-471e-9e60-551263ec6280",
                                "sense_id": "596dab23-4b34-388b-a939-83ffc3dd5b47",
                                "text": "He cast to suffer him no more respire,\nBut gan his sturdie sterne about to weld,\nAnd him so strongly stroke, that to the ground him feld."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a5224ee4-6c26-3da5-ac10-55459656aae7",
