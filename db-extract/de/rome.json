                "senses": [
                    {
                        "sense_id": "c9901cc0-015f-3314-a566-67ea1a59fa71",
                        "entry_id": "76718cb8-61b9-31a4-848f-9ba4693901d3",
                        "glosses": [
                            "Ort im US-Bundesstaat Georgia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eeb13c3-0aca-40b2-90a4-f8833e6034d1",
                                "sense_id": "c9901cc0-015f-3314-a566-67ea1a59fa71",
                                "text": "„Einma’, in Rome, Georgia, ha’mwer gesehn, wiese einen aufknüpfen; der Kerl steht hinten auf so’nem Karren, und plötzlich brüllt er los, sie sollen sich alle zur Hölle scheren, er wär’s doch garnich gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "077842cf-3a79-4e32-ab48-ed03a24bfb09",
                        "source_entry_id": "76718cb8-61b9-31a4-848f-9ba4693901d3",
                        "source_sense_id": "c9901cc0-015f-3314-a566-67ea1a59fa71",
                        "source_sense_description": "Ort in Georgia",
                        "target_lang_word": "Rome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6b70d19-2b86-3773-90b4-b0cacbba13c8",
                                        "entry_id": "f70b55d4-1fe9-3c43-b113-65641d6f7037",
                                        "glosses": [
                                            "A major city, the capital of Italy and the Italian region of Lazio, located on the Tiber River; the ancient capital of the Roman Empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa02ad15-91ed-4e6e-b7b0-d1aa9bcb6d60",
                                                "sense_id": "f6b70d19-2b86-3773-90b4-b0cacbba13c8",
                                                "text": "When could they say (till now) that talk'd of Rome,\nThat her wide Walles incompast but one man?\nNow is it Rome indeed, and Roome enough\nWhen there is in it but one onely man."
                                            },
                                            {
                                                "example_id": "64e5bb8f-0072-4b99-bd10-23732ac6403b",
                                                "sense_id": "f6b70d19-2b86-3773-90b4-b0cacbba13c8",
                                                "text": "Within the last thirty weeks I have heard the word Rome pronounced Room by several old-fashioned people in the north of Ireland, some of my own relations among the number. On remonstrating with one of these, she said, \"It was always Room when I was at school (say about 1830), and I am too old to change it now.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecf33b3e-88c8-3dd9-8d51-3a38c6ddb8f3",
                                        "entry_id": "f70b55d4-1fe9-3c43-b113-65641d6f7037",
                                        "glosses": [
                                            "A metropolitan city of Lazio, Italy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f41b6b27-078a-3d8b-9f04-bd478c258036",
                                        "entry_id": "f70b55d4-1fe9-3c43-b113-65641d6f7037",
                                        "glosses": [
                                            "The Italian government."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a789ee77-7c4a-492c-9484-fdbad754bea4",
                                                "sense_id": "f41b6b27-078a-3d8b-9f04-bd478c258036",
                                                "text": "At first, Berlin tried to amend the agreement to restore a German trade surplus, but Rome refused."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53937397-4956-312f-a986-8f24f2becbb3",
                                        "entry_id": "f70b55d4-1fe9-3c43-b113-65641d6f7037",
                                        "glosses": [
                                            "An ancient empire based out of the city of Rome, covering vast territories in Europe, Asia and Africa; in full, Roman Empire."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b021488-027a-45fe-9b2f-d046f013ce7e",
                                                "sense_id": "53937397-4956-312f-a986-8f24f2becbb3",
                                                "text": "These that suruiue, let Rome reward with loue."
                                            },
                                            {
                                                "example_id": "793c820d-fc90-4b4e-a4a5-68d54be373d1",
                                                "sense_id": "53937397-4956-312f-a986-8f24f2becbb3",
                                                "text": "Learning and Rome alike in Empire grew,\nAnd Arts still follow'd where her Eagles flew;\nFrom the same Foes [viz., Tyranny and Superstition], at last, both felt their Doom,\nAnd the same Age saw Learning fall, and Rome."
                                            },
                                            {
                                                "example_id": "a9f13d44-5962-449c-898f-8907a5a4cb8d",
                                                "sense_id": "53937397-4956-312f-a986-8f24f2becbb3",
                                                "text": "A wife's dishonour unking'd Rome for ever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ed9c4da-7e54-3ba3-bec0-4e906fa325cc",
                                        "entry_id": "f70b55d4-1fe9-3c43-b113-65641d6f7037",
                                        "glosses": [
                                            "The Holy See, the leadership of the Roman Catholic Church, particularly prior to the establishment of the Vatican City in the 19th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e96e2a4b-9c83-4da5-9397-3895e8f00c60",
                                                "sense_id": "1ed9c4da-7e54-3ba3-bec0-4e906fa325cc",
                                                "text": "The wych you perauenture wyl impute to thys defectyon from Rome."
                                            },
                                            {
                                                "example_id": "a2140927-3b56-45d8-b623-eda9e089fd0c",
                                                "sense_id": "1ed9c4da-7e54-3ba3-bec0-4e906fa325cc",
                                                "text": "Winch. Rome shall remedie this\nWarw. Roame thither then."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4b5982f-6c45-3ce9-bd79-d69465889bbf",
                                        "entry_id": "f70b55d4-1fe9-3c43-b113-65641d6f7037",
                                        "glosses": [
                                            "The Church of Rome, the Roman Catholic Church generally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c5958a-08ac-4da5-8b94-dff10ce022b2",
                                                "sense_id": "a4b5982f-6c45-3ce9-bd79-d69465889bbf",
                                                "text": "King Iohn hath reconcil'd Himselfe to Rome."
                                            }
                                        ]
                                    },
