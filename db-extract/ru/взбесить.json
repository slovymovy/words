                    {
                        "form_id": "ff3abc97-50c4-457d-83d7-ade1e08ef878",
                        "entry_id": "2dcb13ad-4c8c-3f33-ac57-5bbfb62ba6de",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "взбеси́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b0ce29d-e098-3bc3-bed2-36eb199d399b",
                        "entry_id": "2dcb13ad-4c8c-3f33-ac57-5bbfb62ba6de",
                        "glosses": [
                            "разг. привести кого-либо в крайнее раздражение; очень сильно рассердить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5696b082-b2e7-46c8-a81f-e5976dc41576",
                                "sense_id": "0b0ce29d-e098-3bc3-bed2-36eb199d399b",
                                "text": "Он стоял под пистолетом, выбирая из фуражки спелые черешни и выплевывая косточки, которые долетали до меня. Его равнодушие взбесило меня."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e9435cb-23d8-40cd-9564-dc453d4e983b",
                        "source_entry_id": "2dcb13ad-4c8c-3f33-ac57-5bbfb62ba6de",
                        "source_sense_id": "0b0ce29d-e098-3bc3-bed2-36eb199d399b",
                        "target_lang_word": "exaspérer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exaspérer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4172a6a7-7884-3d25-babb-8286a0cb8306",
                                        "entry_id": "42bb17d6-52bd-3989-9b4e-e7677e65cbb4",
                                        "glosses": [
                                            "Augmenter, accroître, aviver, exacerber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c879b294-eccf-4825-a173-95f015e9db18",
                                                "sense_id": "4172a6a7-7884-3d25-babb-8286a0cb8306",
                                                "text": "Et son désespoir n’avait rien d’humain;\nPareil au foyer que l’huile exaspère,\nSon courroux croissait, […]"
                                            },
                                            {
                                                "example_id": "766e06ab-dc20-4705-955b-e6dd42d91e4d",
                                                "sense_id": "4172a6a7-7884-3d25-babb-8286a0cb8306",
                                                "text": "Dès le lendemain du crime, je devins éperdument amoureux de Rosalie. Je songeai aussitôt à en faire ma maîtresse, mais je me heurtai à une résistance entêtée et joviale, qui exaspéra et redoubla ma passion."
                                            },
                                            {
                                                "example_id": "21b36b48-5442-4753-8add-d19632a4f10a",
                                                "sense_id": "4172a6a7-7884-3d25-babb-8286a0cb8306",
                                                "text": "C’était un pays plus libre et plus sauvage, où la terre, laissant affleurer sa surface pure, semblait nous inviter, en exaspérant d’elle-même notre vitesse, à nous rendre sensible comme du doigt sa seule courbure austère."
                                            },
                                            {
                                                "example_id": "96bb8d63-b6dc-4450-b0be-365febfb44ad",
                                                "sense_id": "4172a6a7-7884-3d25-babb-8286a0cb8306",
                                                "text": "[…] François se dévoyait auprès des filles publiques, […]. On dit que ces professionnelles ont des charmes secrets, des recettes magiques pour exaspérer la volupté de leurs clients et leur procurer des extases sans pareilles […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cba0357-c76d-3fe6-ac57-403a119586dc",
                                        "entry_id": "42bb17d6-52bd-3989-9b4e-e7677e65cbb4",
                                        "glosses": [
                                            "Rendre un mal encore plus intense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5b0fbc5-03c7-4a73-a6ae-950a66d2d84f",
                                                "sense_id": "1cba0357-c76d-3fe6-ac57-403a119586dc",
                                                "text": "La trop grande chaleur exaspérait les souffrances du malade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71e4430b-57ef-3dc9-881d-06248853699a",
                                        "entry_id": "42bb17d6-52bd-3989-9b4e-e7677e65cbb4",
                                        "glosses": [
                                            "Aigrir, énerver, irriter à l’excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c16c736f-9b95-4c86-a6ff-6bafe6bad197",
                                                "sense_id": "71e4430b-57ef-3dc9-881d-06248853699a",
                                                "text": "Abd-el-Kader voyait bien que sa femme ne l'aimait point, et cela l'exaspérait."
                                            },
                                            {
                                                "example_id": "7ab1a5c4-a2d2-481d-8346-6d1f42879d6e",
                                                "sense_id": "71e4430b-57ef-3dc9-881d-06248853699a",
                                                "text": "La richesse des Roudier et des Granoux exaspérait Aristide au point de lui faire perdre toute prudence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
