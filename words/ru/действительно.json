{
    "word_family": [
        "действие",
        "действительность",
        "действительный",
        "действовать",
        "воздействие"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "11df83e9-08bf-3f38-8256-eea7cea6b5e2",
                    "sense_definition": "На самом деле, в действительности; используется для подтверждения истинности факта или усиления утверждения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "reality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <действительно> не знал, что ты приедешь сегодня.",
                            "target_lang_translations": {
                                "en": "I <w>really</w> didn't know that you were coming today.",
                                "zh": "我<w>真的</w>不知道你今天会来。"
                            }
                        },
                        {
                            "text": "Этот фильм <действительно> стоит посмотреть в кинотеатре.",
                            "target_lang_translations": {
                                "en": "This movie is <w>really</w> worth watching in the cinema.",
                                "zh": "这部电影<w>确实</w>值得去电影院看。"
                            }
                        }
                    ],
                    "synonyms": [
                        "на самом деле",
                        "в самом деле",
                        "вправду",
                        "поистине",
                        "впрямь",
                        "правда",
                        "реально"
                    ],
                    "antonyms": [
                        "вряд ли",
                        "неправда"
                    ],
                    "common_phrases": [
                        "действительно так",
                        "действительно важно",
                        "действительно нужно"
                    ],
                    "target_lang_definitions": {
                        "en": "In fact, in reality; used to confirm the truth of a fact or to emphasize a statement.",
                        "zh": "用于强调事实的真实性或加强语气，表示“确实”、“真的”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "really",
                                "target_lang_sense_clarification": "used for emphasis or to assert truth"
                            },
                            {
                                "target_lang_word": "actually",
                                "target_lang_sense_clarification": "used to assert a fact, often contrasting with expectation"
                            },
                            {
                                "target_lang_word": "truly",
                                "target_lang_sense_clarification": "used to emphasize sincerity or truth"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真的",
                                "target_lang_sense_clarification": "用于强调事实或表达真实性"
                            },
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "用于肯定事实，语气较正式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "893ce5b2-8f82-3c1f-bd14-aac08f6851e2",
                    "sense_definition": "Вводное слово, выражающее уверенность говорящего в истинности сообщаемого; соответствует по значению словам «и правда», «в самом деле».",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Действительно>, мы никогда не забудем этот замечательный день.",
                            "target_lang_translations": {
                                "en": "<w>Indeed</w>, we will never forget this wonderful day.",
                                "zh": "<w>的确</w>，我们永远不会忘记这美好的一天。"
                            }
                        },
                        {
                            "text": "<Действительно>, погода сегодня просто великолепная.",
                            "target_lang_translations": {
                                "en": "<w>Indeed</w>, the weather today is simply magnificent.",
                                "zh": "<w>确实</w>，今天的天气真是太棒了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "в самом деле",
                        "правда"
                    ],
                    "common_phrases": [
                        "и действительно"
                    ],
                    "target_lang_definitions": {
                        "en": "An introductory word expressing the speaker's confidence in the truth of the statement; corresponds to 'indeed' or 'truly'.",
                        "zh": "作为插入语，表示说话人对所说内容真实性的确信，意为“的确”、“确实”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "indeed",
                                "target_lang_sense_clarification": "used to introduce a confirmation or amplification"
                            },
                            {
                                "target_lang_word": "really",
                                "target_lang_sense_clarification": "used to express certainty"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "的确",
                                "target_lang_sense_clarification": "用于引入确认或加强语气"
                            },
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "用于表达确信"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6281c1a-a399-38aa-8882-32fc37159583",
                    "sense_definition": "Употребляется при уверенном подтверждении чьих-либо слов или при выражении согласия; да, верно, точно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Ты выглядишь уставшим. — <Действительно>, я сегодня много работал.",
                            "target_lang_translations": {
                                "en": "— You look tired. — <w>Indeed</w>, I worked a lot today.",
                                "zh": "——你看上去很累。——<w>确实</w>，我今天工作了很多。"
                            }
                        },
                        {
                            "text": "— Это было очень смешно. — <Действительно>, мы все долго смеялись.",
                            "target_lang_translations": {
                                "en": "— It was very funny. — <w>Indeed</w>, we all laughed for a long time.",
                                "zh": "——那太搞笑了。——<w>没错</w>，我们都笑了好久。"
                            }
                        }
                    ],
                    "synonyms": [
                        "верно",
                        "точно",
                        "правда"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разг."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to confidently confirm someone's words or express agreement; yes, true, exactly.",
                        "zh": "用于自信地确认他人的话或表示同意，意为“没错”、“确实如此”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "indeed",
                                "target_lang_sense_clarification": "used to express agreement"
                            },
                            {
                                "target_lang_word": "that's true",
                                "target_lang_sense_clarification": "used to confirm a statement"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "用于表示同意"
                            },
                            {
                                "target_lang_word": "没错",
                                "target_lang_sense_clarification": "用于确认对方的陈述"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "038e0e67-fe4f-34f6-8a30-497c5499c4e6",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>действительный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это удостоверение <действительно> до конца текущего года.",
                            "target_lang_translations": {
                                "en": "This ID is <w>valid</w> until the end of the current year.",
                                "zh": "这张证件在今年年底前<w>有效</w>。"
                            }
                        },
                        {
                            "text": "Ваше предложение всё ещё <действительно> или уже нет?",
                            "target_lang_translations": {
                                "en": "Is your offer still <w>valid</w> or not anymore?",
                                "zh": "你的提议现在还<w>有效</w>吗，还是已经失效了？"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short neuter singular form of the adjective 'valid'.",
                        "zh": "形容词“有效的”的中性短尾形式，指在法律或规定上仍然生效。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "valid",
                                "target_lang_sense_clarification": "legally or officially acceptable"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有效",
                                "target_lang_sense_clarification": "指法律或官方认可的有效性"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}