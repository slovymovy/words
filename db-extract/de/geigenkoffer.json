                    {
                        "sense_id": "d0779816-a53c-3e0f-a6cf-dcd2e3405eab",
                        "entry_id": "a9f5fe23-8758-3a72-8aaa-fba7f7247377",
                        "glosses": [
                            "Gegenstand, der die Form einer Geige hat, damit diese dort hinein gelegt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc50ef2-c9c4-4c04-8822-d0bdbac44e3f",
                                "sense_id": "d0779816-a53c-3e0f-a6cf-dcd2e3405eab",
                                "text": "Sein Geigenkoffer ist aus Mahagoni und innen mit Samt ausgekleidet."
                            },
                            {
                                "example_id": "96903b5e-9bc4-40cc-9551-ca46318984c5",
                                "sense_id": "d0779816-a53c-3e0f-a6cf-dcd2e3405eab",
                                "text": "„Würde man mit einer Kamera festhalten, was Dutzende von Menschen rund um den Globus tun, als sie davon erfahren, würde man der Geigerin Alexandra Soumm dabei zusehen, wie sie ihren Geigenkoffer aufklappt, wie sie ihre Stradivari, die sie von Machold erworben hat, aus einem Seidentuch wickelt und hofft, die möge echt sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
