                                    {
                                        "sense_id": "e61f2f1b-9e43-3cad-b04c-4a359fff0103",
                                        "entry_id": "6a58b143-3439-3060-b342-b1e06c2ae4f9",
                                        "glosses": [
                                            "de mate waarin een tekst begrijpelijk is voor de lezer."
                                        ],
                                        "tags": [
                                            "media"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9f6fa46-3632-465d-9e04-1c6deb417a69",
                                                "sense_id": "e61f2f1b-9e43-3cad-b04c-4a359fff0103",
                                                "text": "De leesbaarheid van de Franse filosoof was zeer slecht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05561818-c7c9-3845-abce-c4d990e00c31",
                                        "entry_id": "6a58b143-3439-3060-b342-b1e06c2ae4f9",
                                        "glosses": [
                                            "de mate waarin een handschrift begrijpelijk is voor de lezer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1aae662-e7a0-41be-803b-e0a6a6d1d518",
                                                "sense_id": "05561818-c7c9-3845-abce-c4d990e00c31",
                                                "text": "De leesbaarheid van het handschrift van de lerares was zeer goed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8d03209-4b7e-4f11-a9d2-749d5ffa7a83",
                        "source_entry_id": "2f948803-7978-3c6a-86bc-805f6925c945",
                        "source_sense_id": "af3c0b25-14bb-3cb6-ad34-4297227bf371",
                        "source_sense_description": "property of being legible or easily readable — see also readability",
                        "target_lang_word": "lisibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lisibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c705c16-d6f7-34a2-846c-7faff71386f4",
                                        "entry_id": "c82b86e4-d6d4-3882-afe6-f65db275a840",
                                        "glosses": [
                                            "Qualité de ce qui est lisible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30288fdd-3c21-4363-8c71-22645b36ba4f",
                                                "sense_id": "5c705c16-d6f7-34a2-846c-7faff71386f4",
                                                "text": "Tout manuscrit doit être remis à l’éditeur en état de lisibilité parfaite."
                                            },
                                            {
                                                "example_id": "b25cc064-d284-45bd-8704-7cfb810b0fe6",
                                                "sense_id": "5c705c16-d6f7-34a2-846c-7faff71386f4",
                                                "text": "Pour des questions de lisibilité et d'homogénéité d'écriture, il est préférable d'éviter les combinaisons de simples quotes et antislash dans une même expression si cela n'est pas indispensable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2b58604-aaad-3d68-9f0a-55e1ee7df916",
                                        "entry_id": "c82b86e4-d6d4-3882-afe6-f65db275a840",
                                        "glosses": [
                                            "Clarté, compréhensibilité, cohérence."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c28bb51c-94e9-4c19-96d9-d0911ce00b27",
                                                "sense_id": "b2b58604-aaad-3d68-9f0a-55e1ee7df916",
                                                "text": "Même si beaucoup d'agglomérations ont déjà passé des secteurs à 30 km/h, Régis Muller insiste sur l'enjeu de \"lisibilité\" : \"Nous avons des départementales qui sont à 80 km/h, c'est la règle, avec des dérogations à 90 km/h et du coup on est un peu perdu … En ville, c'est un peu la même chose, malgré le marquage, les panneaux de signalisation, on ne sait plus.\""
                                            },
                                            {
                                                "example_id": "5bb3a2c3-f2e3-4c7f-af37-a577d47d5bc9",
                                                "sense_id": "b2b58604-aaad-3d68-9f0a-55e1ee7df916",
                                                "text": "Le ministre de l’environnement a pourtant rappelé qu’il fallait une lisibilité à moyen et long terme pour optimiser les investissements en économie d’énergie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac198d70-3f72-3361-ad78-a2e88bab4c9a",
                                        "entry_id": "c82b86e4-d6d4-3882-afe6-f65db275a840",
                                        "glosses": [
                                            "Qualité exprimant la netteté de la perception visuelle d’un contenu d’une carte et la facilité de distinction de ses éléments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae507c17-0e6a-4911-a6f4-c383987f9560",
                        "source_entry_id": "2f948803-7978-3c6a-86bc-805f6925c945",
                        "source_sense_id": "af3c0b25-14bb-3cb6-ad34-4297227bf371",
                        "source_sense_description": "property of being legible or easily readable — see also readability",
                        "target_lang_word": "Lesbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lesbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1a51853-af66-320a-8923-5f680db4f6f8",
                                        "entry_id": "f7b67999-33c5-381b-b9cf-43ea8c8dc338",
                                        "glosses": [
                                            "sprachliche Gestaltung (vor allem: Wortwahl, Syntax) als ein Aspekt, eine Komponente der Verständlichkeit von Texten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65efe5e1-b1d2-4a1e-8423-5b94d523e6ae",
                                                "sense_id": "f1a51853-af66-320a-8923-5f680db4f6f8",
                                                "text": "Texte, die in ihrem Inhalt gleich sind, können aufgrund ihrer sprachlichen Gestaltung eine unterschiedliche Lesbarkeit aufweisen. Wählt man bei ein und demselben Inhalt komplexere Wort- und Satzstrukturen, erhält ein Text eine geringere Lesbarkeit: man kann ihn nur mit mehr Aufwand verstehen."
                                            },
                                            {
                                                "example_id": "5f85a739-6e67-4fda-b83d-a6d6bbd6b304",
                                                "sense_id": "f1a51853-af66-320a-8923-5f680db4f6f8",
                                                "text": "„Die Leserlichkeit stellt dann einen Teilaspekt und zugleich eine Vorstufe zur Lesbarkeit dar, die Lesbarkeit wiederum einen Teilaspekt und eine Vorstufe zur Verständlichkeit von Informationstexten.“"
                                            },
                                            {
                                                "example_id": "3648c08a-dfa7-4643-a284-5fe1350eb376",
                                                "sense_id": "f1a51853-af66-320a-8923-5f680db4f6f8",
                                                "text": "„Wenn man sich mit den Problemen des Wissenstransfers befasst, dann ist Lesbarkeit ein besonders wichtiges Thema.“"
                                            },
                                            {
                                                "example_id": "8b7b0945-ec67-468d-8ac2-09644da91fbd",
                                                "sense_id": "f1a51853-af66-320a-8923-5f680db4f6f8",
                                                "text": "„Dabei sollte es insgesamt um eine bessere Lesbarkeit für den Bürger gehen.“"
                                            },
                                            {
                                                "example_id": "2d20ba9b-778c-4422-872d-32a4012fdee3",
                                                "sense_id": "f1a51853-af66-320a-8923-5f680db4f6f8",
                                                "text": "„Sie dienen sowohl der Ästhetik als auch der besseren Lesbarkeit von Texten, indem sie Zusammengehöriges verbinden oder Unübersichtliches gliedern.“"
                                            },
                                            {
                                                "example_id": "f69ff19d-9fae-4455-8d81-8bdf51ca6842",
                                                "sense_id": "f1a51853-af66-320a-8923-5f680db4f6f8",
                                                "text": "„Einzig der besseren Lesbarkeit halber verwende ich das generische Maskulinum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
