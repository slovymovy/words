                ],
                "senses": [
                    {
                        "sense_id": "ca87d919-2062-37a7-a9e9-d9e40b48a2ae",
                        "entry_id": "91fbaf20-7686-3875-8577-ac268aa87464",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bddc369-0728-4499-9b48-5d00efcfb948",
                                "sense_id": "ca87d919-2062-37a7-a9e9-d9e40b48a2ae",
                                "text": "Frau Gremm ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bbd3618d-cc0c-4000-81fe-d626f1e8c3b2",
                                "sense_id": "ca87d919-2062-37a7-a9e9-d9e40b48a2ae",
                                "text": "Herr Gremm wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9c1c78ed-52b6-45ad-b43d-48feaa7a578e",
                                "sense_id": "ca87d919-2062-37a7-a9e9-d9e40b48a2ae",
                                "text": "Die Gremms kommen heute aus der Rhön."
                            },
                            {
                                "example_id": "47c890cc-497e-4efa-af8e-e53e99b7c9fe",
                                "sense_id": "ca87d919-2062-37a7-a9e9-d9e40b48a2ae",
                                "text": "Der Gremm trägt nie die Schals, die die Gremm ihm strickt."
                            },
                            {
                                "example_id": "2e3fbb97-5915-4adf-b272-2f0e086727cd",
                                "sense_id": "ca87d919-2062-37a7-a9e9-d9e40b48a2ae",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gremm kommt, geht der Herr Gremm.“"
                            },
                            {
                                "example_id": "0699247c-883a-4e23-9b44-7df8a77634e8",
                                "sense_id": "ca87d919-2062-37a7-a9e9-d9e40b48a2ae",
                                "text": "Gremm kommt und geht."
                            },
                            {
                                "example_id": "01b1a5fb-5973-4e8a-9a70-02658f8fe7d2",
                                "sense_id": "ca87d919-2062-37a7-a9e9-d9e40b48a2ae",
                                "text": "Gremms kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
