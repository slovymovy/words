                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f2224f-d400-4a62-998e-177b316461a2",
                                "sense_id": "8c30dca0-103e-3e85-b41f-af68ef76a31d",
                                "text": "Das traditionsreiche Gestüt züchtet seit drei Jahren die edelsten Araber."
                            },
                            {
                                "example_id": "593b60c1-83e5-40a9-b8e2-29f159d9b99f",
                                "sense_id": "8c30dca0-103e-3e85-b41f-af68ef76a31d",
                                "text": "„Das Gestüt versorgte die britische Armee in Indien mit Pferden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
