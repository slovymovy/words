                    "frequency": "Low",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The studio specializes in commercial <w>tabletops</w> for advertising catalogs.",
                            "target_lang_translations": {
                                "es": "El estudio se especializa en <w>fotografías de producto</w> comerciales para catálogos publicitarios."
                            }
                        },
                        {
                            "text": "Creating a beautiful <w>tabletop</w> requires precise control over lighting and shadows.",
                            "target_lang_translations": {
                                "es": "Crear un hermoso <w>bodegón</w> requiere un control preciso de la iluminación y las sombras."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Una fotografía de un objeto o producto colocado sobre una mesa."
                    },
                    "translations": {
