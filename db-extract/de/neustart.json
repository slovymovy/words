                                "target_senses": [
                                    {
                                        "sense_id": "f74d1ac3-6a56-3a85-9db0-983615c7175b",
                                        "entry_id": "d11eb348-2c5e-3f18-980d-fb402b7ebaaf",
                                        "glosses": [
                                            "Nouveau départ, remise en route."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83459aa5-f458-47d3-9506-26d15105fe72",
                                                "sense_id": "f74d1ac3-6a56-3a85-9db0-983615c7175b",
                                                "text": "Le géant agroalimentaire Nestlé a annoncé, jeudi, qu’il visait le redémarrage, en novembre, sous réserve du feu vert des autorités, d’une des deux lignes de production de son usine de Caudry (Nord)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15e8f635-cc79-4111-bc2c-ee572568d20f",
                        "source_entry_id": "36293660-5830-3ac9-a1ab-eea3df9e0e74",
