                ],
                "senses": [
                    {
                        "sense_id": "7c2844da-b155-3bfe-9d47-fb06bf2eadb5",
                        "entry_id": "60fd63f1-9507-3263-b78c-56138aed9111",
                        "glosses": [
                            "The slaves of the Rizeghat and Habbania Arabs and their descendants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "043e54b9-2a3d-48e0-afea-696555c01db5",
                                "sense_id": "7c2844da-b155-3bfe-9d47-fb06bf2eadb5",
                                "text": "The Bandala of the Western Bahr el Ghazal have been described in an interesting article by Captain G. K. C. Hebbert in Volume VIII (1925) of Sudan Notes and Records."
                            },
                            {
                                "example_id": "d445f456-3975-4a80-bd9b-62a20ce6b958",
                                "sense_id": "7c2844da-b155-3bfe-9d47-fb06bf2eadb5",
                                "text": "It was decided that all the Bandala should be settled with their ex-masters in Darfur."
                            },
                            {
                                "example_id": "d47ae9e3-3bc3-4448-b850-4e11276dbef4",
                                "sense_id": "7c2844da-b155-3bfe-9d47-fb06bf2eadb5",
                                "text": "Bandala were totally assimilated to the religious and cultural norms of their masters."
                            }
                        ]
                    }
                ],
