                "senses": [
                    {
                        "sense_id": "a53f11a6-7dcd-33d3-a84c-c508eba97bd6",
                        "entry_id": "c5a85b76-667a-3975-90fc-43683027d45b",
                        "glosses": [
                            "relativ geringer Anteil der Vokale an allen Lauten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b3cdf6-550f-4f43-9b32-38936c5aebfb",
                                "sense_id": "a53f11a6-7dcd-33d3-a84c-c508eba97bd6",
                                "text": "„Assonanzen werden aufgrund der relativen »Vokalarmut« des Deutschen im Deutschen leicht überhört.“"
                            },
                            {
                                "example_id": "0517b09e-5254-4f79-90c9-439a534a8c3a",
                                "sense_id": "a53f11a6-7dcd-33d3-a84c-c508eba97bd6",
                                "text": "„Das Vorurteil, dass die deutsche Sprache wegen ihrer (verglichen mit dem Italienischen und Französischen) Vokalarmut »unpoetischer« sei, war lange Zeit etwas wie eine poetologische Gewissheit, die zu widerlegen Wieland wie einen Selbstauftrag empfand.“"
                            },
                            {
                                "example_id": "9c882a9f-3862-4856-aec2-20995b4507c0",
                                "sense_id": "a53f11a6-7dcd-33d3-a84c-c508eba97bd6",
                                "text": "„Ein zweites Problem besteht in der Vokalarmut des gesprochenen Arabisch.“"
                            },
                            {
                                "example_id": "ee87093d-cbef-4df7-a625-96e59eeb64a6",
                                "sense_id": "a53f11a6-7dcd-33d3-a84c-c508eba97bd6",
                                "text": "„Der Vokalismus germanischer Sprachen ist durch vergleichende (mit anderen indogermanischen Sprachen) Vokalarmut und zahlreiche kombinatorische Veränderungen gekennzeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
