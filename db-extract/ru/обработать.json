                    {
                        "sense_id": "336d3194-988a-3c00-8597-638166e33b97",
                        "entry_id": "5a8c6906-c9dc-3e47-a915-c21bbab3f066",
                        "glosses": [
                            "подвергнуть производственной операции; готовя для посева, возделать"
