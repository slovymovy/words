        "nl-extract.jsonl": [
            {
                "entry_id": "3e322691-17ca-30c0-86c1-ddfc18bf8703",
                "word": "rechttrekken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b590423-6b85-3b59-90bf-bb74f4b03ddf",
                        "entry_id": "3e322691-17ca-30c0-86c1-ddfc18bf8703",
                        "glosses": [
                            "door trekken weer recht of glad maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f019fb58-0c34-42fe-a89a-952dac31e813",
                                "sense_id": "0b590423-6b85-3b59-90bf-bb74f4b03ddf",
                                "text": "- Sara: „De kinderen hebben wel de regel dat ze hun eigen speelgoed moeten opruimen en hun bed rechttrekken.”"
                            },
                            {
                                "example_id": "7028c7f1-9eb3-4bc2-8774-eeb7a9ae55e3",
                                "sense_id": "0b590423-6b85-3b59-90bf-bb74f4b03ddf",
                                "text": "- Ik trok na het opstaan de dekens weer recht."
                            }
                        ]
                    },
                    {
                        "sense_id": "59a1a593-7ad1-3025-82dc-3b910b06f662",
                        "entry_id": "3e322691-17ca-30c0-86c1-ddfc18bf8703",
                        "glosses": [
                            "iets recht maken wat krom was"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4e022a8-1690-4274-a86d-714aaf249379",
                                "sense_id": "59a1a593-7ad1-3025-82dc-3b910b06f662",
                                "text": "- De beschrijving van de rijksgrens, zoals verwoord in het verdrag van 1839, stemt „niet meer overeen met de feitelijke situatie”, meldt de provincie Limburg. Dat komt vooral door de bouw van een kanaal bij Ternaaien, een sluizencomplex ter plaatse en door de grootschalige grindwinning en het rechttrekken van de ooit zo bochtige Maas. Op die manier zijn Belgische gronden in Nederland „aangeland” en vice versa."
                            }
                        ]
                    },
                    {
                        "sense_id": "e026498a-a3a7-374e-bf06-738d6d35bca6",
                        "entry_id": "3e322691-17ca-30c0-86c1-ddfc18bf8703",
                        "glosses": [
                            "corrigeren wat verkeerd gegaan is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9888c85-02bb-4254-827d-d4f93b9f001a",
                                "sense_id": "e026498a-a3a7-374e-bf06-738d6d35bca6",
                                "text": "- De veronderstelde onderconsumptie van de Nederlander, en de sterke financiële positie van bedrijven hebben hun weerslag in een overschot op de betalingsbalans van Nederland met het buitenland. Dat overschot loopt volgend jaar terug, van 8,7 procent van het bbp naar 8,2 procent, maar is nog steeds uitzonderlijk groot. Een extra loonstijging, met de zegen van De Nederlandsche Bank, zou dat deels kunnen rechttrekken."
                            }
                        ]
                    }
                ],
