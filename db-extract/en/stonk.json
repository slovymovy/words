                "senses": [
                    {
                        "sense_id": "464a8a27-9a0a-3bc7-92f4-d61b87995636",
                        "entry_id": "63cc443a-96a7-3689-9a48-fdaaa9c60f95",
                        "glosses": [
                            "A stock, especially a bullish one."
                        ],
                        "tags": [
                            "Internet",
                            "humorous",
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c9f014cd-b327-4fa6-a090-f6273e61ce22",
                                "sense_id": "464a8a27-9a0a-3bc7-92f4-d61b87995636",
                                "text": "Stonk is essentially just a funny way to say “stock” – and once you understand that, it explains everything else that has happened."
                            },
                            {
                                "example_id": "6083d44e-2b34-46ae-b45c-49806e90c7a7",
                                "sense_id": "464a8a27-9a0a-3bc7-92f4-d61b87995636",
                                "text": "Long before Reddit, the Yahoo message boards of the late 1990s democratized the expression of strong opinions about stocks (they didn’t call them “stonks” in those days)."
                            },
                            {
                                "example_id": "706ff659-1e0b-433e-bbb1-37e2cd91b99a",
                                "sense_id": "464a8a27-9a0a-3bc7-92f4-d61b87995636",
                                "text": "Other so-called “stonks” – an intentional misspelling of “stocks” – favoured by retail traders on sites such as Reddit’s WallStreetBets also shot higher."
                            },
                            {
                                "example_id": "0ca963c6-2c67-446a-8141-9dfc502443e3",
                                "sense_id": "464a8a27-9a0a-3bc7-92f4-d61b87995636",
                                "text": "It’s all part of our wild new YOLO FOMO LOL economy, where stonks only go up, memes count as financial advice and stimmies buy Hemis."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8d9b6cb-6eab-3530-a7c9-72ae6cd3e65e",
