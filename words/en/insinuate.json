                    "frequency": "Low",
                    "semantic_group_id": "social_maneuvering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>insinuate</w> himself into the inner circle of the company's leadership."
                        },
                        {
                            "text": "The spy tried to <w>insinuate</w> himself into the confidence of the diplomat."
                        }
                    ],
                    "common_phrases": [
