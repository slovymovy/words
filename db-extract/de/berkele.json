                "senses": [
                    {
                        "sense_id": "18f7e823-6366-39aa-b5ac-d53c92162d7b",
                        "entry_id": "5f38002c-d035-3cfb-b757-bdfca2ee8b5d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe8cc5b6-9cf5-4767-bd45-235378a28717",
                                "sense_id": "18f7e823-6366-39aa-b5ac-d53c92162d7b",
                                "text": "Frau Berkele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4aa7bd82-79de-4aa9-b0e0-9d75695b9f92",
                                "sense_id": "18f7e823-6366-39aa-b5ac-d53c92162d7b",
                                "text": "Herr Berkele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "86eea887-a58a-4f3c-9076-c821e12be2bd",
                                "sense_id": "18f7e823-6366-39aa-b5ac-d53c92162d7b",
                                "text": "Die Berkeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "a45eaabe-57d1-4a00-9724-64e9c6bd5b5f",
                                "sense_id": "18f7e823-6366-39aa-b5ac-d53c92162d7b",
                                "text": "Der Berkele trägt nie die Pullover, die die Berkele ihm strickt."
                            },
                            {
                                "example_id": "655f6125-88ca-48c9-bab0-df31efaf37b2",
                                "sense_id": "18f7e823-6366-39aa-b5ac-d53c92162d7b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Berkle kommt, geht der Herr Berkele.“"
                            },
                            {
                                "example_id": "243ccd46-7f2d-4a04-a530-bfb209b1938e",
                                "sense_id": "18f7e823-6366-39aa-b5ac-d53c92162d7b",
                                "text": "Berkele kommt und geht."
                            },
                            {
                                "example_id": "ce07ec36-3150-4222-ab3e-0de84bd9a351",
                                "sense_id": "18f7e823-6366-39aa-b5ac-d53c92162d7b",
                                "text": "Berkeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
