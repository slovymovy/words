        "fr-extract.jsonl": [
            {
                "entry_id": "c0327e60-5a30-3196-8857-12ba9671d39a",
                "word": "Gibraltar",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "341e7336-97c8-3588-90c0-f0a60d0e4a1f",
                        "entry_id": "c0327e60-5a30-3196-8857-12ba9671d39a",
                        "glosses": [
                            "Territoire dépendant du Royaume-Uni, situé en Europe du sud-ouest, qui forme une péninsule au sud de l’Espagne, en bordure du détroit de Gibraltar."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "e6fa4792-040c-43ee-8c11-8cc247338ec1",
                                "sense_id": "341e7336-97c8-3588-90c0-f0a60d0e4a1f",
                                "text": "Il faut bien que la Grande-Bretagne s’y résigne ; sous un rapport, Gibraltar est perdu pour elle. Cette précieuse conquête ne sera plus dans ses mains qu’un poste militaire, une forteresse; comme bazar, comme marché public, elle va cesser d’être."
                            },
                            {
                                "example_id": "ddc0d35f-9419-4dd0-b082-cce03188d671",
                                "sense_id": "341e7336-97c8-3588-90c0-f0a60d0e4a1f",
                                "text": "Un steamer en partance emporta la missive du caïd Maclean à Tanger, d’où la légation d’Angleterre la transmit par le télégraphe à Gibraltar et au Foreign Office."
                            }
                        ]
                    },
                    {
                        "sense_id": "09b35d88-2374-3130-b26d-4f19e3970cef",
                        "entry_id": "c0327e60-5a30-3196-8857-12ba9671d39a",
                        "glosses": [
                            "Autorités gouvernant ce territoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f22ae63-6b20-47ca-9e17-05aa92dd761b",
                                "sense_id": "09b35d88-2374-3130-b26d-4f19e3970cef",
                                "text": "Gibraltar a vendu, pour 39,2 millions d’euros, le yacht saisi de l’oligarque russe Dmitry Pumpyansky, visé par des sanctions occidentales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bcaf4e1-c649-4890-8c05-8211c0ec9311",
                        "source_entry_id": "c0327e60-5a30-3196-8857-12ba9671d39a",
                        "source_sense_description": "Territoire",
                        "target_lang_word": "Gibraltar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gibraltar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6050ee02-76ea-3873-af77-b662ab2ee687",
                                        "entry_id": "a7074294-01ae-3b40-9a00-400c02021b11",
                                        "glosses": [
                                            "Halbinsel an der Südspitze Spaniens unter britischer Herrschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b327e5f6-759f-497e-a89e-ee13db1c3fba",
                                                "sense_id": "6050ee02-76ea-3873-af77-b662ab2ee687",
                                                "text": "Gibraltar gehört (trotz der Lage auf dem europäischen Festland) als Britisches Überseegebiet zum Vereinigten Königreich Großbritannien und Nordirland."
                                            },
                                            {
                                                "example_id": "5eee4e87-16c9-42ee-97ce-5d1e99cb8b97",
                                                "sense_id": "6050ee02-76ea-3873-af77-b662ab2ee687",
                                                "text": "„Noch in Wien als Thronfolger vereidigt kam Karl (III.) im Mai 1704 in Lissabon an. Nunmehr griffen die Kriegshandlungen auch auf Spanien selbst über, und die Engländer besetzten in einem Vorstoß Gibraltar, das sich seitdem in ihrem Besitz befindet. Dieser Verlust band Philipp V. und Madrid noch enger an Ludwig XIV.“"
                                            },
                                            {
                                                "example_id": "fec5c747-1998-41cb-9254-181715b3a13a",
                                                "sense_id": "6050ee02-76ea-3873-af77-b662ab2ee687",
                                                "text": "„Am gegenüberliegenden Tisch bekamen zwei Leute Streit, auf welche Weise Gibraltar künstlich vernebelt werde, sobald ein Schiff gemeldet war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
