                        "entry_id": "88edabf4-2c3c-32e6-814f-564faf80fd1d",
                        "glosses": [
                            "hypothetische topologische Erscheinung der Raumzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42059123-9436-4e80-9808-354e050055b6",
                                "sense_id": "0d55ea63-f242-3779-8df0-b4378592f42b",
                                "text": "„Wir sitzen direkt vor dem Wurmloch, dürfen aber nicht mal einen Blick hindurchwerfen. Das ist nicht fair, oder?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "126536a3-b34f-388c-9c56-bbd55271221c",
                        "entry_id": "88edabf4-2c3c-32e6-814f-564faf80fd1d",
                        "glosses": [
                            "durch ein kriechendes Wesen, wie zum Beispiel durch eine Made, verursachtes Loch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fb437ee-3ef0-4338-b0cf-a6212c25235e",
                                "sense_id": "126536a3-b34f-388c-9c56-bbd55271221c",
                                "text": "Der Apfel hat ein Wurmloch."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0b3bf22-9aa5-4537-9a4b-f5bdc29bdefa",
                        "source_entry_id": "88edabf4-2c3c-32e6-814f-564faf80fd1d",
                        "source_sense_id": "0d55ea63-f242-3779-8df0-b4378592f42b",
                        "source_sense_description": "hypothetische topologische Erscheinung der Raumzeit",
                        "target_lang_word": "wormhole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wormhole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "870da139-a89f-35ee-87d1-38a657d96a94",
                                        "entry_id": "c9ae84ee-8c11-39f9-b1b9-9d86a2527e3e",
                                        "glosses": [
                                            "A hole burrowed by a worm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a7bfef-25ad-4be8-b7dd-876517a708dd",
                                                "sense_id": "870da139-a89f-35ee-87d1-38a657d96a94",
                                                "text": "To fill with worme-holes stately monuments."
                                            },
                                            {
                                                "example_id": "aa453334-b336-4c2e-89f1-7b9b42c4ab4d",
                                                "sense_id": "870da139-a89f-35ee-87d1-38a657d96a94",
                                                "text": "But he had no sooner got through the worm-hole, than the lad put a small peg in the hole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10416308-2fbe-3ccc-bff5-49a773a8799a",
                                        "entry_id": "c9ae84ee-8c11-39f9-b1b9-9d86a2527e3e",
                                        "glosses": [
                                            "A hypothetical shortcut between two points in spacetime, permitting faster-than-light travel and sometimes time travel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2f54eb7-7dda-470a-a4f6-33d9b149e56e",
                                                "sense_id": "10416308-2fbe-3ccc-bff5-49a773a8799a",
                                                "text": "[…]where there is a net flux of lines of force, through what topologists would call \"a handle\" of the multiply-connected space, and what physicists might perhaps be excused for more vividly terming a \"wormhole\"."
                                            },
                                            {
                                                "example_id": "6fcf2ec6-9a8b-4929-b5fa-6225c01bd89b",
                                                "sense_id": "10416308-2fbe-3ccc-bff5-49a773a8799a",
                                                "text": "Wormhole distortion has overloaded main power systems!"
                                            },
                                            {
                                                "example_id": "584744ba-0420-4ecb-96e4-bc0261ba9a9a",
                                                "sense_id": "10416308-2fbe-3ccc-bff5-49a773a8799a",
                                                "text": "I think the wormhole that we used to travel here passed directly through this planet's sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d44441ad-572a-3ee4-9c8f-fa83d663f7fa",
                                        "entry_id": "c9ae84ee-8c11-39f9-b1b9-9d86a2527e3e",
                                        "glosses": [
                                            "A location in a monitor program containing the address of a routine, allowing the user to substitute different functionality."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
