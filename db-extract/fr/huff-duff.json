                "senses": [
                    {
                        "sense_id": "91d60017-43fe-3731-9fbe-758e72ffa67e",
                        "entry_id": "7d46e696-2e2b-345c-b82c-c1ce6386ad78",
                        "glosses": [
                            "Surnom donné à un système de radiogoniométrie utilisé comme dispositif de repérage pendant et après la Seconde Guerre mondiale. Ce nom évoque « HF/DF », abréviation de High Frequency/Direction Finding (« Haute fréquence/Découverte de direction »)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bff4960b-413a-45c8-9507-c30f93f3b8b4",
                                "sense_id": "91d60017-43fe-3731-9fbe-758e72ffa67e",
                                "text": "Les Huff Duff automatiques utilisés, groupés par 4, donnaient 4 relèvements simultanés qui permettaient de positionner l'émission et de commencer la chasse."
                            },
                            {
                                "example_id": "2c349cd4-3a32-4052-9720-e2b7b88c8f36",
                                "sense_id": "91d60017-43fe-3731-9fbe-758e72ffa67e",
                                "text": "Quant à Maurice Deloraine, co-inventeur d’un système de radar surnommé Huff-Duff qui permit de repérer les sous-marins allemands pendant la bataille de l’Atlantique, lui aussi eut des parents avisés qui le firent naître le plus loin possible du village haut-patatois de Clairegoutte, où il revint triomphalement terminer sa vie comme maire."
                            }
                        ]
                    }
