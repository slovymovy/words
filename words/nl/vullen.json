                },
                {
                    "sense_id": "f68633b5-5066-311d-ba67-90f26a4623bb",
                    "sense_definition": "een bepaalde tijd of ruimte in beslag nemen of nuttig besteden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bezigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jij kan je tijd hier wel <w>vullen</w> met lezen.",
