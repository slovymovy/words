                ],
                "senses": [
                    {
                        "sense_id": "6570d813-3911-373d-90fb-ba40c4d43f1b",
                        "entry_id": "8c9c9608-a3f4-3677-a0b5-d27d813e6606",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b318236a-9b4e-456f-baf8-fc1d7b8a68f1",
                                "sense_id": "6570d813-3911-373d-90fb-ba40c4d43f1b",
                                "text": "Frau Frenkle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1c8da4f7-bff3-4f4c-a259-0c0661e16019",
                                "sense_id": "6570d813-3911-373d-90fb-ba40c4d43f1b",
                                "text": "Herr Frenkle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1c881b71-d67e-4fc8-830a-bd30e15e4387",
                                "sense_id": "6570d813-3911-373d-90fb-ba40c4d43f1b",
                                "text": "Die Frenkles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e92754ed-08fd-4418-9a1f-bb346f6ac778",
                                "sense_id": "6570d813-3911-373d-90fb-ba40c4d43f1b",
                                "text": "Der Frenkle trägt nie die Schals, die die Frenkle ihm strickt."
                            },
                            {
                                "example_id": "6b07dbc6-085b-4b3d-bfce-ff19f178f0a5",
                                "sense_id": "6570d813-3911-373d-90fb-ba40c4d43f1b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Frenkle kommt, geht der Herr Frenkle.“"
                            },
                            {
                                "example_id": "b5b49cd3-bb99-4759-bb21-296d3ea1098e",
                                "sense_id": "6570d813-3911-373d-90fb-ba40c4d43f1b",
                                "text": "Frenkle kommt und geht."
                            },
                            {
                                "example_id": "1aed96dd-5bb6-49d8-ac5c-ea1724b8fbe9",
                                "sense_id": "6570d813-3911-373d-90fb-ba40c4d43f1b",
                                "text": "Frenkles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
