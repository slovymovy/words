                "translations": [
                    {
                        "translation_id": "fa290889-2753-4876-8b7c-d5b8d8e35b4e",
                        "source_entry_id": "a5973b37-d3a8-3d35-8e64-e6dca1569400",
                        "source_sense_id": "1dbf9f6e-1ad2-36cb-aa8d-ea8766573d30",
                        "target_lang_word": "Diarrhöe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diarrhöe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07c15ef4-ecbd-3600-9ead-4e1ef4e664de",
                                        "entry_id": "f8ee1230-d476-3026-bd32-5db350042b31",
                                        "glosses": [
                                            "dünnflüssiger, krankhafter Stuhlgang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed2c591-3b95-4970-83f0-eb6b1ed919d0",
                                                "sense_id": "07c15ef4-ecbd-3600-9ead-4e1ef4e664de",
                                                "text": "„Diarrhöe wird ebensosehr durch die Nerven wie durch Nahrung verursacht.“"
                                            },
                                            {
                                                "example_id": "260dbdaf-49c9-4725-ba13-6422d72dd393",
                                                "sense_id": "07c15ef4-ecbd-3600-9ead-4e1ef4e664de",
                                                "text": "„Ein Trost: Der Blutordensträger, der sich durch diese schlimme Zeit beim amerikanischen CIC hinlänglich gegen die Gefahr des Verhungerns absicherte, überstand auch die erwähnte Diarrhöe gut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c7e43f6-8862-454d-94f1-89f3b884f792",
                        "source_entry_id": "a5973b37-d3a8-3d35-8e64-e6dca1569400",
                        "source_sense_id": "1dbf9f6e-1ad2-36cb-aa8d-ea8766573d30",
                        "target_lang_word": "Durchfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durchfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                        "entry_id": "0b5b71c7-1f49-3205-803e-d55e7184c4c1",
                                        "glosses": [
                                            "zu schnelle Ausscheidung von breiigem bis flüssigem Stuhl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fbe183a-8417-4087-acdb-c3b74b2b5151",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "Bei Magen-Darm-Grippe hat man auch Durchfall."
                                            },
                                            {
                                                "example_id": "b6d8a74c-c555-4573-bdb0-f2d79c7bf8a2",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "„Das mit dem Durchfall störte mich weniger, aber was anderes passierte.“"
                                            },
                                            {
                                                "example_id": "cd25695b-4fea-41fa-8191-47b147860c06",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "„Plötzlich hatte er den Eindruck, Durchfall zu bekommen, und rannte auf die Toilette.“"
                                            },
                                            {
                                                "example_id": "7ba72c70-d774-4511-a45e-3f06179bf743",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "„Bald tritt bei der Kleinen zum Hunger noch ein hartnäckiger Durchfall hinzu.“"
                                            },
                                            {
                                                "example_id": "0487ccd0-e260-4b4b-947b-e375a3dc3643",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "Als Allgemeinarzt kann man ein Lied singen von gehäuft auftretenden Durchfällen im Altenheim."
                                            },
                                            {
                                                "example_id": "82af62d2-e85c-414c-b367-eea6063c88f1",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "„Schwerwiegende Infektionskrankheiten des Magen-Darm-Traktes, die mit blutigen Durchfällen und Fieberschüben einhergingen, waren zu allen Zeiten die gefürchteten Begleiter des Heeres.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9dad6d1-5d9e-34d6-8002-81ca64953a2d",
                                        "entry_id": "0b5b71c7-1f49-3205-803e-d55e7184c4c1",
                                        "glosses": [
                                            "Misserfolg; das Scheitern beispielsweise bei einer Prüfung (das Durchfallen)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4426542-6325-479e-86c8-6c5aea324891",
                                                "sense_id": "b9dad6d1-5d9e-34d6-8002-81ca64953a2d",
                                                "text": "„Im Jahre 1783 wurde Lessings ‚Nathan der Weise‘ zum ersten Male in Berlin aufgeführt, erlebte aber einen vollkommenen Durchfall, und zwar infolge eines unseligen Versprechens des Darstellers des Sultans.“"
                                            },
                                            {
                                                "example_id": "829c4628-02fb-4813-9cab-e62fc0ad6c62",
                                                "sense_id": "b9dad6d1-5d9e-34d6-8002-81ca64953a2d",
                                                "text": "„So ging ihm, als der ‚Prinz von Homburg‘ von Kleist durchfiel und vom Wiener Publicum theilweise ausgelacht wurde, dieser Kleist’sche Durchfall sehr zu Herzen.“"
                                            },
                                            {
                                                "example_id": "f7331a4c-7982-4d96-9ac4-d356ed8a1b77",
                                                "sense_id": "b9dad6d1-5d9e-34d6-8002-81ca64953a2d",
                                                "text": "„Wenn, wie wieder Otto Elben erzählt, einer der prüfenden Professoren sagte, ‚M. habe die vorhandenen juristischen Kenntnisse so geschickt und vernünftig angewandt vorzutragen gewußt, daß man ihn unmöglich durchfallen lassen konnte‘, so kann sich dies unseres Erachtens unmöglich auf das ganze Examen, dessen Ergebniß die Gefahr des Durchfalls völlig ausschließt, sondern höchstens auf ein Einzelfach beziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1aa1571f-5af5-4599-a123-83943bd5139f",
                        "source_entry_id": "a5973b37-d3a8-3d35-8e64-e6dca1569400",
                        "source_sense_id": "1dbf9f6e-1ad2-36cb-aa8d-ea8766573d30",
                        "target_lang_word": "diarrhea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diarrhea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea87c697-9261-3bb2-862b-f03f16663458",
                                        "entry_id": "f885718d-5d6d-306e-a7ba-a9760eb26f21",
                                        "glosses": [
                                            "A gastrointestinal disorder characterized by frequent and very soft or watery bowel movements."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74f59a34-f720-3371-bdb9-d068e9b33acd",
                                        "entry_id": "f885718d-5d6d-306e-a7ba-a9760eb26f21",
                                        "glosses": [
                                            "The watery or very soft excrement that comes from such bowel movements."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fc1dd31-11f4-42d2-afb1-6bb35f5c5417",
                                                "sense_id": "74f59a34-f720-3371-bdb9-d068e9b33acd",
                                                "text": "My Pampers bill is higher than your paycheck, my hands are raw from washing them every six minutes, and I do eight loads of laundry a day because everything we own is covered in diarrhea, and you want me to \"plug him up\" and wait another three weeks?"
                                            },
                                            {
                                                "example_id": "0f91a169-e426-4ba8-9f02-9fca034c4a43",
                                                "sense_id": "74f59a34-f720-3371-bdb9-d068e9b33acd",
                                                "text": "I looked and saw that she and her hammock were covered in diarrhea."
                                            },
                                            {
                                                "example_id": "605c14c3-435e-4a23-a601-3c6ef164acc6",
                                                "sense_id": "74f59a34-f720-3371-bdb9-d068e9b33acd",
                                                "text": "Why was she covered in diarrhea?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e4beb95-294b-4a44-91e3-2ca679922a57",
                        "source_entry_id": "a5973b37-d3a8-3d35-8e64-e6dca1569400",
                        "source_sense_id": "1dbf9f6e-1ad2-36cb-aa8d-ea8766573d30",
                        "target_lang_word": "diarrhée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diarrhée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff9d6fa6-3887-3732-97bc-dd0d8a087e21",
                                        "entry_id": "594c1527-d34f-3cb4-849f-aabe1860cdef",
                                        "glosses": [
                                            "Maladie caractérisée par des évacuations de selles, liquides et fréquentes, et qui est ordinairement due à l’inflammation de l’intestin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d810277-0c4e-4d53-ac1a-5ba0dd41893f",
                                                "sense_id": "ff9d6fa6-3887-3732-97bc-dd0d8a087e21",
                                                "text": "« J’avais en outre une diarrhée du diable, que j’ai vaincue sans nul médicament, par la contention mentale et donc musculaire. Le résultat fut magnifique, mais c’est un effort que je ne demanderais pas au passant de la rue »"
                                            },
                                            {
                                                "example_id": "98e729b7-8736-44a7-ad25-c035c4a26ad1",
                                                "sense_id": "ff9d6fa6-3887-3732-97bc-dd0d8a087e21",
                                                "text": "Ce fut encore cette diarrhée verte qui faillit l’enlever, qui, d’une enfant « rêtue » déjà, et plaisante, fit une sorte de morte."
                                            },
                                            {
                                                "example_id": "ff6d1ea7-76fc-43af-a409-434e94f884ff",
                                                "sense_id": "ff9d6fa6-3887-3732-97bc-dd0d8a087e21",
                                                "text": "Ces comprimés lui feront un pansement gastrique, et s’il n’a pas d’autres vomissements ou diarrhées, tu pourras considérer qu’il est sorti d’affaire."
                                            },
                                            {
                                                "example_id": "583ea3e3-cdb4-4b69-8386-490de992a6f7",
                                                "sense_id": "ff9d6fa6-3887-3732-97bc-dd0d8a087e21",
                                                "text": "Le traitement des formes non compliquées est simple et comporte à chacun des changes une désinfection bactérienne par un antiseptique à base de chlorhexidine par exemple suivie d’un séchage soigneux puis de l’application d’une crème ou d’un lait antifungique associée à un traitement antifungique per os uniquement en cas de muguet ou de diarrhée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b109d52b-45f7-3516-9c0a-ef9f7389fb39",
                                        "entry_id": "594c1527-d34f-3cb4-849f-aabe1860cdef",
                                        "glosses": [
                                            "Fort écoulement de liquide."
                                        ],
                                        "tags": [
                                            "Par comparaison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b1093a4-df31-451b-8e34-cb4021b0b777",
                                                "sense_id": "b109d52b-45f7-3516-9c0a-ef9f7389fb39",
                                                "text": "Comme une soudaine diarrhée le lahar engloutit le village."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5e75e12-8d11-3c71-9793-7c98fad6feb2",
                                        "entry_id": "594c1527-d34f-3cb4-849f-aabe1860cdef",
                                        "glosses": [
                                            "Flot d’informations intenses et sans intérêt pour l’interlocuteur."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f37e800-3aeb-425f-9a64-38550bca7f29",
                                                "sense_id": "e5e75e12-8d11-3c71-9793-7c98fad6feb2",
                                                "text": "Sa diarrhée nous assommait à longueur de journée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
