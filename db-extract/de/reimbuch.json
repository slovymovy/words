                "senses": [
                    {
                        "sense_id": "ba8946ad-7ef8-39e4-bc04-03cdd775c5f4",
                        "entry_id": "59c27c31-9844-3566-83e9-affea99c0832",
                        "glosses": [
                            "Buch, das Reime/Reimmöglichkeiten auflistet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b78dcc7c-cb5c-47b2-84b4-727758690b07",
                                "sense_id": "ba8946ad-7ef8-39e4-bc04-03cdd775c5f4",
                                "text": "„Dann verschwinden die Reimbücher im Schrank und werden die Kochbücher hervorgeholt und massenweise Frauenzeitschriften mit Rezeptbeilagen gekauft.“"
                            },
                            {
                                "example_id": "2c8c2c7a-63f5-47f7-8e73-45cdcd499542",
                                "sense_id": "ba8946ad-7ef8-39e4-bc04-03cdd775c5f4",
                                "text": "„Es gibt aber auch verschiedene Reimbücher oder Datenbanken im Internet.“"
                            },
                            {
                                "example_id": "8bcba61e-12ac-4648-965e-da11554f8877",
                                "sense_id": "ba8946ad-7ef8-39e4-bc04-03cdd775c5f4",
                                "text": "„Die Bedeutung der Reimbücher braucht nicht erst besprochen zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "53b9a584-2e72-309f-a2cb-8e6645d6b731",
                        "entry_id": "59c27c31-9844-3566-83e9-affea99c0832",
                        "glosses": [
                            "Buch, dessen Text gereimt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74bd5748-f284-432d-9ae7-c481a45796cd",
                                "sense_id": "53b9a584-2e72-309f-a2cb-8e6645d6b731",
                                "text": "„Dazu gehören gute Bilderbücher, Reimbücher, Liedertexte und Hörkassetten.“"
                            },
                            {
                                "example_id": "56e60991-a8d1-4fe6-babb-c2ca54db110d",
                                "sense_id": "53b9a584-2e72-309f-a2cb-8e6645d6b731",
                                "text": "„Das Spektrum der gesammelten Literatur reicht vom Bilder- und Reimbuch für die Kleinen - so ein Band Kinderreime in Hochdeutsch, Plattdeutsch und Englisch (1882) - über Fabel-, Sagen- und Märchenbücher aus aller Welt, Abenteuer- und Reiseliteratur sowie historische Erzählungen bis hin zu Sachbüchern, auch zum Schulgebrauch.“"
                            },
                            {
                                "example_id": "a252bece-5400-49d9-8d32-7997a15d6866",
                                "sense_id": "53b9a584-2e72-309f-a2cb-8e6645d6b731",
                                "text": "„Bei den Bilderbüchern reicht es von Alltags- und Tiergeschichten über Märchen und Reimbücher bis zu Sachbüchern und ersten Nachschlagewerken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
