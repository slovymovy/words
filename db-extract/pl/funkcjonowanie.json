                                                "sense_id": "4f3e6911-b278-3f15-9209-cc9b223f5d4d",
                                                "text": "This weekend, as videos of robotaxi malfunctions began appearing on social media, opponents say they are seeing their fears realized."
                                            },
                                            {
                                                "example_id": "593a0a31-c3bc-4440-8012-6e350a12df5a",
                                                "sense_id": "4f3e6911-b278-3f15-9209-cc9b223f5d4d",
                                                "text": "A former OceanGate scientific director said the Titan submersible suffered a malfunction six days before imploding in June 2023, killing all five people on board."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088a2a84-801a-3a79-9e1d-61e045cd4db4",
                                        "entry_id": "7e13940c-5b93-364d-a2f1-4cc225ff7181",
                                        "glosses": [
                                            "Failure to function."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
