                                            {
                                                "example_id": "4e68da78-c0e3-47b5-985e-304b9b2e1e2a",
                                                "sense_id": "eccd7be6-ed22-33e1-a493-30d90de84e3e",
                                                "text": "„In Ägypten wurden die Neujahrsriten zu Beginn des Nil-Hochwassers im Juli zelebriert.“"
                                            },
                                            {
                                                "example_id": "bde39a10-9b4b-4200-b8b0-2043742686d2",
                                                "sense_id": "eccd7be6-ed22-33e1-a493-30d90de84e3e",
                                                "text": "„Am 27. Juli 1936 beginnt er ein neues Buch.“"
                                            },
                                            {
                                                "example_id": "0c0636fd-e100-4b2f-bba6-56e1691b7519",
                                                "sense_id": "eccd7be6-ed22-33e1-a493-30d90de84e3e",
                                                "text": "„Der Juli mit seiner permanenten Helligkeit überstrahlte noch alles.“"
