                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "53aa3f87-c2f6-35bd-89b7-921bf4378998",
                                        "entry_id": "ed4e65a0-58c9-34d1-8f15-dd8703638eda",
                                        "glosses": [
                                            "выдуманная история, повествование, не соответствующее действительности; выдумка, вымысел"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18592974-e111-40be-b646-90e3226bf680",
                                                "sense_id": "53aa3f87-c2f6-35bd-89b7-921bf4378998",
                                                "text": "Расхвастался о том, где он бывал, и к былям небылиц без счету прилыгал."
                                            },
                                            {
                                                "example_id": "c2f6746c-60ce-47a1-a433-8c344b587664",
                                                "sense_id": "53aa3f87-c2f6-35bd-89b7-921bf4378998",
                                                "text": "Всю ночь читаешь небылицы."
                                            },
                                            {
                                                "example_id": "388cbb6c-7cfa-4b27-b058-ec95e872cf40",
                                                "sense_id": "53aa3f87-c2f6-35bd-89b7-921bf4378998",
                                                "text": "Распускать небылицу, глупее которой трудно выдумать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15a8b73c-7ad6-33e3-84f1-722cee9e1391",
                                        "entry_id": "ed4e65a0-58c9-34d1-8f15-dd8703638eda",
                                        "glosses": [
                                            "разновидность шутливых произведений словесности; сказка, выдумка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "337e32e7-23dc-4aea-a9a5-ee098f4a0fd1",
                                                "sense_id": "15a8b73c-7ad6-33e3-84f1-722cee9e1391",
                                                "text": "Механически водя карандашом по ватману, я придумывал какие-нибудь забавные стишки или короткие небылицы, записывал на клочках бумаги, а потом, спустившись в гардероб, находил ее пальто и вкладывал их в карман."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
