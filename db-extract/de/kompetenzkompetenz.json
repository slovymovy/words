                "senses": [
                    {
                        "sense_id": "06fa2f29-c6ca-3c5c-95d1-42b3734c04ee",
                        "entry_id": "f4c5b466-fb0e-34f6-b5b1-6c785b498235",
                        "glosses": [
                            "Befugnis, Zuständigkeiten zuzuweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2abfe293-280b-429a-9823-6d091f4dd678",
                                "sense_id": "06fa2f29-c6ca-3c5c-95d1-42b3734c04ee",
                                "text": "„Seehofer beansprucht für sich also diese Kompetenzkompetenz.“"
                            },
                            {
                                "example_id": "35f29c0a-db45-4ac4-b76c-0478a1f276c3",
                                "sense_id": "06fa2f29-c6ca-3c5c-95d1-42b3734c04ee",
                                "text": "„Und so gab es die unvergessliche Kompetenzkompetenz, die regellose Regelung, den Transrapid des Wahnsinns und die gludernde Lot.“"
                            },
                            {
                                "example_id": "f942386a-60f7-4912-a61c-199bb8a6bbce",
                                "sense_id": "06fa2f29-c6ca-3c5c-95d1-42b3734c04ee",
                                "text": "„So könnten sich die Mitglieder eines Vereins möglicherweise aus Angst vor Sanktionen gehindert sehen, von ihrer Kompetenzkompetenz Gebrauch zu machen und das Mitwirkungsrecht des Dritten zu beseitigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
