                "senses": [
                    {
                        "sense_id": "64f202a9-773f-33bc-890d-92eeff91d818",
                        "entry_id": "d06bc3a2-e7f8-375b-b485-c8cb5d9706fb",
                        "glosses": [
                            "kleinste Struktureinheit des Sprachsystems (Langue), die auf der Ausdrucksseite als Keneme, auf der Seite der Bedeutung/des Inhalts als Plereme erscheinen"
                        ],
                        "tags": [
                            "speziell Glossematik"
                        ],
                        "examples": [
                            {
                                "example_id": "5b50e1b4-e3d4-4e9e-b8a1-7d53f99ff549",
                                "sense_id": "64f202a9-773f-33bc-890d-92eeff91d818",
                                "text": "Glossem ist eine Grundeinheit der Glossematik."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5bf1452c-311f-38f9-84a3-0710dabcc7be",
                        "entry_id": "d06bc3a2-e7f8-375b-b485-c8cb5d9706fb",
                        "glosses": [
                            "bei Bloomfield Oberbegriff für die Tagmeme (= grammatischen Morpheme) und die lexikalischen Morpheme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef4d35f2-0c02-479f-996c-4b86c57e26fc",
                                "sense_id": "5bf1452c-311f-38f9-84a3-0710dabcc7be",
                                "text": "Glossem ist ein Begriff, der dem des Morphems in seiner weiten Bedeutung (sowohl grammatische als auch lexikalische Morpheme) entspricht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a4af8ad3-5356-3691-8374-2aa4d4248220",
                        "entry_id": "d06bc3a2-e7f8-375b-b485-c8cb5d9706fb",
                        "glosses": [
                            "Anmerkung in alten Handschriften; Glosse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36c61123-fee0-49f3-9f0e-1da9d7bf05f9",
                                "sense_id": "a4af8ad3-5356-3691-8374-2aa4d4248220",
                                "text": "„Beide Glosseme kamen nun später auf die gewöhnliche Weise in den Text.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4d00e81-0052-41d0-b103-ca7f3b865f96",
                        "source_entry_id": "d06bc3a2-e7f8-375b-b485-c8cb5d9706fb",
