                    {
                        "translation_id": "91a3c8b6-ccd5-45de-a239-458fe8dc019a",
                        "source_entry_id": "937e6d24-5203-33f8-988d-38663d3b7da0",
                        "source_sense_id": "934bf00c-f65b-3a5d-8e02-5b83295f8930",
