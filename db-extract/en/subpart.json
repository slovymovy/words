                            {
                                "example_id": "5f0e1989-f68c-4848-8cbb-276941335477",
                                "sense_id": "b6089066-b7bd-3226-91fa-b67729661e43",
                                "text": "You will find your obligations in this regard clearly defined in Part D, Subpart b, Section 8 of the second Addendum to the contract."
