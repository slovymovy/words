    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "22c87be7-c90b-3689-84e9-9ae3a4f7eb05",
                    "sense_definition": "taki, który nie poczuwa się do odpowiedzialności za swoje czyny, nie przewiduje konsekwencji, na którym nie można polegać",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "brak odpowiedzialności",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Skończył studia, założył rodzinę, ale wciąż był <w>nieodpowiedzialny</w> jak nastolatek.",
                            "target_lang_translations": {
                                "en": "He finished his studies and started a family, but he was still <w>irresponsible</w> like a teenager."
                            }
                        },
                        {
                            "text": "Robert był <w>nieodpowiedzialny</w>, siadał za kierownicą po pijaku.",
                            "target_lang_translations": {
                                "en": "Robert was <w>irresponsible</w>; he would get behind the wheel while drunk."
                            }
                        }
                    ],
                    "synonyms": [
                        "lekkomyślny",
                        "beztroski",
                        "niefrasobliwy",
                        "nierozważny",
                        "niedojrzały"
                    ],
                    "antonyms": [
                        "odpowiedzialny",
                        "rozważny",
                        "dojrzały"
                    ],
                    "common_phrases": [
                        "nieodpowiedzialny człowiek",
                        "nieodpowiedzialny pracownik"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who does not take responsibility for their actions, does not foresee consequences, or cannot be relied upon."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irresponsible",
                                "target_lang_sense_clarification": "describing a person who lacks a sense of responsibility or acts negligently"
                            },
                            {
                                "target_lang_word": "reckless",
                                "target_lang_sense_clarification": "describing a person who acts without thinking about the consequences"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e477122-23f7-3c61-aa3c-184557585fbe",
                    "sense_definition": "będący wynikiem, świadectwem postawy braku odpowiedzialności",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "brak odpowiedzialności",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Twoje postępowanie było <w>nieodpowiedzialne</w>.",
                            "target_lang_translations": {
                                "en": "Your conduct was <w>irresponsible</w>."
                            }
                        },
                        {
                            "text": "To była bardzo <w>nieodpowiedzialna</w> decyzja finansowa.",
                            "target_lang_translations": {
                                "en": "That was a very <w>irresponsible</w> financial decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "lekkomyślny",
                        "nierozważny"
                    ],
                    "antonyms": [
                        "odpowiedzialny",
                        "rozważny"
                    ],
                    "common_phrases": [
                        "nieodpowiedzialne zachowanie",
                        "nieodpowiedzialne działanie"
                    ],
                    "target_lang_definitions": {
                        "en": "Resulting from or serving as evidence of an attitude of irresponsibility."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irresponsible",
                                "target_lang_sense_clarification": "describing an action or decision that shows a lack of proper care or judgment"
                            },
                            {
                                "target_lang_word": "reckless",
                                "target_lang_sense_clarification": "describing an action that is dangerous or done without regard for the consequences"
                            }
                        ]
                    }
                }
            ]
        }
    ]
