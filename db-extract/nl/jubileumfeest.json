                        "examples": [
                            {
                                "example_id": "99d4182f-9420-41f6-b073-57d0f10215c3",
                                "sense_id": "4216dcc5-1c78-3d7d-a5fe-08b8de63a072",
                                "text": "Op het jubileumfeest in Rotterdam zijn optredens van onder anderen Erwin Nyhoff en De Dopegezinde Gemeente. Ook wordt er een salsaworkshop gegeven op muziek van de Rolling Stones."
                            },
                            {
                                "example_id": "d3e6413b-0a0d-42fb-b8eb-99d7099adb7b",
                                "sense_id": "4216dcc5-1c78-3d7d-a5fe-08b8de63a072",
                                "text": "Het jubileumfeest begon vanmiddag met 41 saluutschoten die tegelijkertijd werden afgevuurd in Londen, Edinburgh, Cardiff en Belfast. Dat zijn de hoofdsteden van de vier landen die samen het Verenigd Koninkrijk vormen."
                            }
