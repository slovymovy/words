                    "sense_definition": "The smallest possible amount, degree, or thing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lowest_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Helping with the cleanup is the <w>least</w> I can do.",
                            "target_lang_translations": {
