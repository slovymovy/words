                "senses": [
                    {
                        "sense_id": "f8e23c89-8a39-3d0d-bdd0-ed8783357c67",
                        "entry_id": "39e0aaad-2101-3257-86a6-06a42eed16af",
                        "glosses": [
                            "Kapsel aus Gelatine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4c1c636-f3fb-4ac8-90f0-dc7045a19896",
                                "sense_id": "f8e23c89-8a39-3d0d-bdd0-ed8783357c67",
                                "text": "„Ich schraube eine Flasche auf und schüttle mir eine glänzende dunkelrote Pille auf die Handfläche. Ich lecke daran. Es ist mit Zucker überzogene Schokolade. Andere sind mit Puderzucker gefüllte Gelatinekapseln.“"
                            },
                            {
                                "example_id": "51c813a7-9874-4a6b-b0f5-e617cebf7d90",
                                "sense_id": "f8e23c89-8a39-3d0d-bdd0-ed8783357c67",
                                "text": "„In einer Ecke des Zimmers ist eine Tüte Reis aufgerissen und über den Teppich verstreut worden, und daneben entdeckt Garvey ein weißes Pulver, wahrscheinlich Kokain, und etwa einhundert leere Gelatinekapseln.“"
                            },
                            {
                                "example_id": "361a621b-eeb8-4c75-bdd0-7d0a6f3b74e8",
                                "sense_id": "f8e23c89-8a39-3d0d-bdd0-ed8783357c67",
                                "text": "„Er macht die Flasche auf und schüttelt sich zwei durchsichtige Gelatinekapseln auf die Hand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
