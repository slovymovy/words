                "senses": [
                    {
                        "sense_id": "def85f0d-fa92-32f0-bbdd-8ec87b224a5a",
                        "entry_id": "57990b04-0691-3dfc-9a00-804509c43096",
                        "glosses": [
                            "mit Gipsplatten versehen: verkleiden, verblenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6704d542-ede0-4b9e-824e-40edaa667102",
                                "sense_id": "def85f0d-fa92-32f0-bbdd-8ec87b224a5a",
                                "text": "“We sheetrocked the walls and made the building alive.”",
                                "translation": "Wir verkleideten die Wände mit Gipsplatten und machten das Gebäude lebendig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdf95d68-79c6-4293-9979-c57977d65e53",
                        "source_entry_id": "57990b04-0691-3dfc-9a00-804509c43096",
                        "source_sense_id": "def85f0d-fa92-32f0-bbdd-8ec87b224a5a",
                        "source_sense_description": "mit Gipsplatten versehen",
                        "target_lang_word": "verkleiden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verkleiden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8629bda-f3f1-340e-8ca2-2f7d0c872e0a",
                                        "entry_id": "836f2946-229b-396d-9336-88e746f6c1bd",
                                        "glosses": [
                                            "sich mit einem Kostüm versehen; kostümieren; formelle Kleidung anziehen"
                                        ],
                                        "tags": [
                                            "humorous",
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2e6532d-7358-4796-a083-ecaa0d9142c4",
                                                "sense_id": "f8629bda-f3f1-340e-8ca2-2f7d0c872e0a",
                                                "text": "An Fasching verkleidete er sich als Pirat und sie sich als Prinzessin."
                                            },
                                            {
                                                "example_id": "f93843c4-0f3d-4be4-a06a-31a7a42f157e",
                                                "sense_id": "f8629bda-f3f1-340e-8ca2-2f7d0c872e0a",
                                                "text": "Wir gehen ja nun heute Abend ins Theater, aber dazu musst du dich nicht verkleiden. Komm, wie du bist!"
                                            },
                                            {
                                                "example_id": "2fa6a653-9c4f-4176-8bb7-d58ea3477920",
                                                "sense_id": "f8629bda-f3f1-340e-8ca2-2f7d0c872e0a",
                                                "text": "Die Trainer verkleideten ihren eigenen Hund als Schaf, damit die anderen Hunde etwas zu Riechen und zu Treiben hatten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ddfa9d5d-6d3c-3556-bca4-eb7a0191a4bb",
                                        "entry_id": "836f2946-229b-396d-9336-88e746f6c1bd",
                                        "glosses": [
                                            "mit einer verhüllenden Schicht oder Blende bedecken; verdecken, verhüllen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d2302f-989e-4c5b-bcb6-0d5cdd86dfd1",
                                                "sense_id": "ddfa9d5d-6d3c-3556-bca4-eb7a0191a4bb",
                                                "text": "Die Wand wird mit einer Holztäfelung verkleidet."
                                            },
                                            {
                                                "example_id": "7064a621-4e41-40cc-86db-bf3f40e30c64",
                                                "sense_id": "ddfa9d5d-6d3c-3556-bca4-eb7a0191a4bb",
                                                "text": "Vielleicht können wir Ihr Engagement noch etwas verkleiden, aber ich bin fast sicher, dass das jemand in Kürze aufdecken wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bafe133e-19e2-4ab6-84a4-2cc03025d594",
                        "source_entry_id": "57990b04-0691-3dfc-9a00-804509c43096",
