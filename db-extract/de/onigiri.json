                                "example_id": "38c60680-d23e-4568-892b-f3325699ff2f",
                                "sense_id": "ee018fee-7574-3407-910f-80056558fb77",
                                "text": "Wieder war die Berliner Boheme, die sich auf Kunst und Stil versteht, vollzählig zugegen und frühstückte Onigiri, traditionelle japanische Reisbällchen."
                            },
                            {
                                "example_id": "39fefb13-0bf4-48b5-bd72-ca33e99d78ef",
                                "sense_id": "ee018fee-7574-3407-910f-80056558fb77",
                                "text": "Sie holte das Onigiri hervor, das sie sich zum Frühstück im Konbini gekauft hatte, und schälte es aus dem Zellophan."
                            }
                        ]
                    }
