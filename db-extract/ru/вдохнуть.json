                    },
                    {
                        "form_id": "adecd40d-b97e-48a6-ab67-991c9ca91569",
                        "entry_id": "dbb0f8c7-0e83-3307-982a-e9ee58f44535",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "вдохну́в"
                    },
                    {
                        "form_id": "7e5b0492-d990-480c-b2ed-e42f5c270902",
                        "entry_id": "dbb0f8c7-0e83-3307-982a-e9ee58f44535",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "вдохну́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04ed3069-6685-3820-87d5-13682518193f",
                        "entry_id": "dbb0f8c7-0e83-3307-982a-e9ee58f44535",
                        "glosses": [
                            "вобрать, втянуть в себя воздух при вдохе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9398db3-6913-4525-900e-79c9e1f79089",
                                "sense_id": "04ed3069-6685-3820-87d5-13682518193f",
                                "text": "Морозный воздух вдохну я полной грудью, и сразу проясненье в моей наступает голове."
                            }
                        ]
                    },
                    {
                        "sense_id": "f96799c3-5007-34ec-a053-3aec21162bfb",
                        "entry_id": "dbb0f8c7-0e83-3307-982a-e9ee58f44535",
                        "glosses": [
                            "перен. вселить, внушить"
                        ],
                        "tags": [
                            "в сочет. с сущ. жизнь, энергия, энтузиазм и т. п."
                        ],
                        "examples": [
                            {
                                "example_id": "50c4b250-94eb-4439-974b-0742ea64869b",
                                "sense_id": "f96799c3-5007-34ec-a053-3aec21162bfb",
                                "text": "Но перед нами стоит и более близкая задача: спасти новые сотни отчаявшихся, вдохнуть в них надежду и бодрость, вырвать их из их одиночества, их оторванности, их отчаяния и вернуть их с пути смерти на путь жизни."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3783910b-2149-464c-b657-f3f9e3c8e6e7",
                        "source_entry_id": "dbb0f8c7-0e83-3307-982a-e9ee58f44535",
                        "target_lang_word": "inhale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bd2000b-d7ee-3e7a-96a6-10b2fcf971b0",
                                        "entry_id": "c0188d59-444e-3b6a-8d41-90c98f35b1a7",
                                        "glosses": [
                                            "To draw air into the lungs, through the nose or mouth by action of the diaphragm."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0254ec75-03c1-4b05-b151-b86b1aa44a6f",
                                                "sense_id": "4bd2000b-d7ee-3e7a-96a6-10b2fcf971b0",
                                                "text": "“Please. I’m starved.” Her gaze followed the man with the meatpies while she inhaled deeply, trying to hold onto the heavenly scent. […] “I find myself ravenous for meatpie.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d02529-d21c-309e-a2b0-b787e92a94dd",
                                        "entry_id": "c0188d59-444e-3b6a-8d41-90c98f35b1a7",
                                        "glosses": [
                                            "To draw air or any form of gas (either in a pure form, or mixed with small particles in form of aerosols/smoke -sometimes stemming from a medicament) into the lungs, through the nose or mouth by action of the diaphragm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f653d2d-f66e-4402-ab5d-c2bcee24fe02",
                                                "sense_id": "93d02529-d21c-309e-a2b0-b787e92a94dd",
                                                "text": "[…] this room, where misfortune seems to ooze, where speculation lurks in corners, and of which Madame Vauquer inhales the warm, fetid air without being nauseated."
                                            },
                                            {
                                                "example_id": "345395b6-a3e4-4485-a2fb-1f5bfc9ec762",
                                                "sense_id": "93d02529-d21c-309e-a2b0-b787e92a94dd",
                                                "text": "And he led the way from the station, stopping once to gloat over the sunset across Trafalgar Square, and again to inhale the tarry scent of the warm wood-paving, which was perfume to his nostrils as the din of its traffic was music to his ears, before we came to one of those political palaces which permit themselves to be included in the list of ordinary clubs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b83e36b-e28b-3679-8231-5f458813b615",
                                        "entry_id": "c0188d59-444e-3b6a-8d41-90c98f35b1a7",
                                        "glosses": [
                                            "To eat very quickly."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2657f0c5-d794-4a2b-9c24-ff31eb5ec344",
                                                "sense_id": "0b83e36b-e28b-3679-8231-5f458813b615",
                                                "text": "She had also forgotten both diet and protocol as she joined Sven in guzzling large cokes, practically inhaling fries and gravy, and rounding off the meal with double malts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inhale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe175168-84f8-3476-8475-33ad4faffcd5",
                                        "entry_id": "6d67addd-6fbc-36dc-8e1d-78bb62480cbd",
                                        "glosses": [
                                            "An inhalation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee65d0a9-f030-42eb-a828-f448faf79d76",
                                                "sense_id": "fe175168-84f8-3476-8475-33ad4faffcd5",
                                                "text": "Now have client take slower, normal breaths through the nose and notice how the abdomen moves slightly outward with each inhale and then deflates with each exhale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
