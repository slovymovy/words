                        "entry_id": "58d99297-e039-3f61-8756-a480718e73b3",
                        "glosses": [
                            "Caravane autotractée ou véhicule automobile dont l’intérieur est équipé pour le séjour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45ee55ac-e3ba-4e9d-97a6-f544d09de0be",
                                "sense_id": "371eae58-1815-3c81-b043-51dab3371adb",
                                "text": "Appareil qui refroidit et ventile l'air à l'intérieur de l'auto-caravane lorsque la température extérieure est élevée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb8dcfac-1bd1-4881-bb2a-e6e18cbfd215",
                        "source_entry_id": "58d99297-e039-3f61-8756-a480718e73b3",
                        "source_sense_id": "371eae58-1815-3c81-b043-51dab3371adb",
                        "target_lang_word": "Wohnmobil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohnmobil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "807e9097-635e-3bbd-938a-b31c30bae74f",
                                        "entry_id": "b4552fc6-e4dc-3ed9-acd2-f9d40234ce8c",
                                        "glosses": [
                                            "Kraftfahrzeug mit einer zum Wohnen geeigneten Ausstattung, um darin bei Reisen übernachten zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb493c47-ac85-4de6-b3f1-f53e779bbae1",
                                                "sense_id": "807e9097-635e-3bbd-938a-b31c30bae74f",
                                                "text": "Sie bereisten Skandinavien mit einem gemieteten Wohnmobil."
                                            },
                                            {
                                                "example_id": "40b91938-7b0e-4bb5-aaef-42b3af7f3e5e",
                                                "sense_id": "807e9097-635e-3bbd-938a-b31c30bae74f",
                                                "text": "„Es ist kurz vor sechs Uhr morgens und noch dunkel, der Hafen von Chania nur spärlich beleuchtet, als sich Marco Didone auf den Fahrersitz des vollbepackten Wohnmobils schwingt.“"
                                            },
                                            {
                                                "example_id": "691b6a5e-7725-435a-ae37-09fabb96e1bf",
                                                "sense_id": "807e9097-635e-3bbd-938a-b31c30bae74f",
                                                "text": "„Also verkaufte er eines Tages sein Business und besorgte sich ein Wohnmobil.“"
                                            },
                                            {
                                                "example_id": "4d9f7334-3597-463f-8b29-482838b79f9e",
                                                "sense_id": "807e9097-635e-3bbd-938a-b31c30bae74f",
                                                "text": "„In einem Wohnmobil gab es heißes Wasser auf Knopfdruck.“"
                                            },
                                            {
                                                "example_id": "4469da75-ee48-4b9a-85c4-454b9236e4d5",
                                                "sense_id": "807e9097-635e-3bbd-938a-b31c30bae74f",
                                                "text": "„Der Mann, in Begleitung seiner Leute, verlud ein Wohnmobil und eine Yacht und verschwand in der Fähre ohne Gruß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
