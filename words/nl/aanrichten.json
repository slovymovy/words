    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d0041e2-4f6b-3f23-a04e-43241f5fa27e",
                    "sense_definition": "het veroorzaken van iets negatiefs, zoals schade, ellende of een ravage",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "veroorzaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zware storm heeft vannacht veel schade <w>aangericht</w> aan de daken van de huizen.",
                            "target_lang_translations": {
                                "en": "The heavy storm <w>caused</w> a lot of damage to the roofs of the houses last night."
                            }
                        },
                        {
                            "text": "Je moet er niet aan denken wat die gevaarlijke combinatie van medicijnen kan <w>aanrichten</w>.",
                            "target_lang_translations": {
                                "en": "You shouldn't think about what that dangerous combination of medicines can <w>do</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "veroorzaken",
                        "teweegbrengen",
                        "berokkenen"
                    ],
                    "antonyms": [
                        "herstellen",
                        "voorkomen"
                    ],
                    "common_phrases": [
                        "schade aanrichten",
                        "een ravage aanrichten",
                        "onheil aanrichten",
                        "bloedbad aanrichten"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause something negative, such as damage, misery, or havoc."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cause",
                                "target_lang_sense_clarification": "to bring about something negative like damage"
                            },
                            {
                                "target_lang_word": "wreak",
                                "target_lang_sense_clarification": "to cause great damage or havoc"
                            },
                            {
                                "target_lang_word": "inflict",
                                "target_lang_sense_clarification": "to cause suffering or harm"
                            },
                            {
                                "target_lang_word": "do",
                                "target_lang_sense_clarification": "used in the phrase 'to do damage'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c425417-2145-30e8-8a84-4873ee9bac42",
                    "sense_definition": "iets voorbereiden of klaarmaken, vaak met betrekking tot een maaltijd of feest",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voorbereiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft een heerlijke maaltijd voor al haar gasten <w>aangericht</w>.",
                            "target_lang_translations": {
                                "en": "She <w>prepared</w> a delicious meal for all her guests."
                            }
                        },
                        {
                            "text": "Voor het huwelijksfeest werd er een groot banket <w>aangericht</w> in de tuin.",
                            "target_lang_translations": {
                                "en": "A large banquet was <w>laid out</w> in the garden for the wedding party."
                            }
                        }
                    ],
                    "synonyms": [
                        "bereiden",
                        "klaarmaken",
                        "toebereiden"
                    ],
                    "common_phrases": [
                        "een maaltijd aanrichten",
                        "een feestmaal aanrichten"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Deze betekenis wordt tegenwoordig minder vaak gebruikt dan de betekenis van schade veroorzaken."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To prepare or set up something, often referring to a meal or a feast."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prepare",
                                "target_lang_sense_clarification": "to get a meal or feast ready"
                            },
                            {
                                "target_lang_word": "set up",
                                "target_lang_sense_clarification": "to arrange or organize a banquet or feast"
                            },
                            {
                                "target_lang_word": "lay out",
                                "target_lang_sense_clarification": "to spread out a large meal or spread"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}