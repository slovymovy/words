        "fr-extract.jsonl": [
            {
                "entry_id": "9a143bc3-a6bd-3842-a6a3-b82213e8535c",
                "word": "tractation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d370d2b8-2f40-48cf-98e7-ccd045851095",
                        "entry_id": "9a143bc3-a6bd-3842-a6a3-b82213e8535c",
                        "tags": [
                            "plural"
                        ],
                        "form": "tractations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16f8ddf9-c36d-34f4-bf7a-d04fe6b9295e",
                        "entry_id": "9a143bc3-a6bd-3842-a6a3-b82213e8535c",
                        "glosses": [
                            "Ensemble de démarches, de pourparlers ayant un caractère officieux ou occulte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97c9dd4c-b7c4-44eb-b1c6-fb15e255ae68",
                                "sense_id": "16f8ddf9-c36d-34f4-bf7a-d04fe6b9295e",
                                "text": "Quelque part des gens travaillaient clandestinement pour le retour de la paix, que ce fût en favorisant des tractations entre les gouvernements, ou en conspirant contre certains de ces gouvernements."
                            },
                            {
                                "example_id": "6f1cd3d6-3e01-4e2c-ab1c-99aa81595d1c",
                                "sense_id": "16f8ddf9-c36d-34f4-bf7a-d04fe6b9295e",
                                "text": "La délégation à l’informatique avait un droit de veto, ce qui nécessitait beaucoup de tractations préalables pour l’éviter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cd2bf9a-f92c-4d47-a453-7b573f3394ba",
                        "source_entry_id": "9a143bc3-a6bd-3842-a6a3-b82213e8535c",
                        "source_sense_id": "16f8ddf9-c36d-34f4-bf7a-d04fe6b9295e",
                        "target_lang_word": "tractation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tractation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9d4cb3d-d324-34f3-b38e-9c1d4838544c",
                                        "entry_id": "0d4f6a23-6185-38aa-82a0-eca5104e689d",
                                        "glosses": [
                                            "treatment or handling of a subject; discussion"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16238aae-17b2-488d-a6ad-6de295cd0692",
                                                "sense_id": "f9d4cb3d-d324-34f3-b38e-9c1d4838544c",
                                                "text": "a full tractation of the points controverted"
                                            },
                                            {
                                                "example_id": "7d06ff21-3de8-4530-93e3-135697b3ff5d",
                                                "sense_id": "f9d4cb3d-d324-34f3-b38e-9c1d4838544c",
                                                "text": "In the tractation of all which things our chief purpose and endeavour shall be (so near as the Lord will give us grace), not so much to intermeddle with outward affairs of princes[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9864a28-5576-47fb-96ca-a8eb5afcf9ae",
                        "source_entry_id": "9a143bc3-a6bd-3842-a6a3-b82213e8535c",
                        "source_sense_id": "16f8ddf9-c36d-34f4-bf7a-d04fe6b9295e",
                        "target_lang_word": "negotiation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "negotiation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe503ad9-2807-360a-b3d0-893292b0bfcf",
                                        "entry_id": "ddeea71a-39f6-31e0-9481-166a15c4154e",
                                        "glosses": [
                                            "The process of achieving agreement through discussion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07dcc29b-9de2-450c-97db-defc335a4f1f",
                                                "sense_id": "fe503ad9-2807-360a-b3d0-893292b0bfcf",
                                                "text": "The two parties entered into negotiations about the merger."
                                            },
                                            {
                                                "example_id": "d772a681-ca34-4261-89d0-85d26cb5936a",
                                                "sense_id": "fe503ad9-2807-360a-b3d0-893292b0bfcf",
                                                "text": "The specifics of the contract are still under negotiation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4abb2c25-3c48-4d51-a857-6771f8d9f95b",
                        "source_entry_id": "9a143bc3-a6bd-3842-a6a3-b82213e8535c",
                        "source_sense_id": "16f8ddf9-c36d-34f4-bf7a-d04fe6b9295e",
                        "target_lang_word": "сделка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сделка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3294f5c5-0bc0-398e-83bd-a017ef868a5b",
                                        "entry_id": "48b3636c-d23f-3cfb-b31a-03f710be6aea",
                                        "glosses": [
                                            "юр. соглашение между несколькими субъектами о совместных действиях и взаимных обязательствах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "814542b4-e5a7-4f42-b385-b514768c8eb1",
                                                "sense_id": "3294f5c5-0bc0-398e-83bd-a017ef868a5b",
                                                "text": "Заключить сделку. Расторгнуть сделку. Завершить сделку. Вести переговоры о сделке. Торговая сделка. Финансовая сделка. Сделка слияния."
                                            },
                                            {
                                                "example_id": "c991aaa3-c945-4bcd-8a52-992cec93639b",
                                                "sense_id": "3294f5c5-0bc0-398e-83bd-a017ef868a5b",
                                                "text": "На данный момент уже есть подписанные договоры и зарегистрированные сделки."
                                            },
                                            {
                                                "example_id": "4cc0e23e-0dc2-4a12-8fee-84acb2791de7",
                                                "sense_id": "3294f5c5-0bc0-398e-83bd-a017ef868a5b",
                                                "text": "Что является налоговой базой по договору комиссии ― вся сумма по сделке или сумма, поступающая на счёт налогоплательщика за минусом комиссионного вознаграждения?"
                                            },
                                            {
                                                "example_id": "27fef4e5-22bc-484c-b74a-4a5609c72ca2",
                                                "sense_id": "3294f5c5-0bc0-398e-83bd-a017ef868a5b",
                                                "text": "― о недопущении действий, создающих угрозу нарушения антимонопольного законодательства; об устранении последствий нарушения антимонопольного законодательства; о восстановлении положения, существовавшего до нарушения антимонопольного законодательства; о принудительном разделении коммерческой организации или некоммерческой организации либо о выделении из их состава одной или нескольких организаций; об изменении условий или о расторжении договоров и иных сделок; о заключении договоров с хозяйствующими субъектами; о перечислении в федеральный бюджет дохода, полученного в результате нарушения антимонопольного законодательства; об изменении или ограничении использования фирменного наименования; о выполнении экономических, технических, информационных и иных требований, направленных на предупреждение создания дискриминационных условий; о совершении действий, направленных на обеспечение конкуренции;"
                                            },
                                            {
                                                "example_id": "7c4d946f-b78d-45c9-a225-16c048e6e8a0",
                                                "sense_id": "3294f5c5-0bc0-398e-83bd-a017ef868a5b",
                                                "text": "К договорам, иным сделкам или обязательствам из причинения вреда оно отношения не имеет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "293f1f73-07a4-327a-bb76-4a577bb743de",
                                        "entry_id": "48b3636c-d23f-3cfb-b31a-03f710be6aea",
                                        "glosses": [
                                            "неодобр. неблаговидный, предосудительный, часто негласный сговор"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df708335-0b10-4b46-9435-572caf9cabc2",
                                                "sense_id": "293f1f73-07a4-327a-bb76-4a577bb743de",
                                                "text": "Закулисные сделки."
                                            },
                                            {
                                                "example_id": "64af0e6b-e403-4109-b163-bf92572595db",
                                                "sense_id": "293f1f73-07a4-327a-bb76-4a577bb743de",
                                                "text": "Аншлюс Австрии и мюнхенская сделка были дополнительным доказательством того, что западные политики готовы всё простить Гитлеру, лишь бы он выполнил обязательство, данное в его «евангелии» ― «Майн кампф», и уничтожил большевизм."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63367ba4-7b09-3a2c-b64d-35bc0bda5f42",
                                        "entry_id": "48b3636c-d23f-3cfb-b31a-03f710be6aea",
                                        "glosses": [
                                            "конечный уговор, условие, соглашение; полюбовная мировая и взаимные обязательства по согласию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef7e0e9a-c7a7-4c5a-ad44-4f3b92d1e57c",
                                                "sense_id": "63367ba4-7b09-3a2c-b64d-35bc0bda5f42",
                                                "text": "Сделка между купцами и без договорного документа крепка. Слово купеческое — крепче камня."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed6ab7e4-9773-4739-9f5a-aab1ab50b5d9",
                        "source_entry_id": "9a143bc3-a6bd-3842-a6a3-b82213e8535c",
                        "source_sense_id": "16f8ddf9-c36d-34f4-bf7a-d04fe6b9295e",
