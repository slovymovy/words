                    {
                        "translation_id": "c0618882-9309-4b7f-93d5-0c97bf3d5f27",
                        "source_entry_id": "256c0dea-3373-3d29-9dd6-755051526302",
                        "source_sense_id": "5e0d0842-83dd-311a-b61f-6ce587457831",
