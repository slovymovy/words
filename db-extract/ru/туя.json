                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thuya",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0538422-1e55-3c43-95cf-e1efc490996f",
                                        "entry_id": "db4553e5-bebb-3446-9d8d-3a245c091454",
                                        "glosses": [
                                            "Any member of the genus Thuya."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f57f5754-6983-4a5f-92c7-b71cafbf3fda",
                                                "sense_id": "e0538422-1e55-3c43-95cf-e1efc490996f",
                                                "text": "Thuya, Ara, or Sandrac-tree, is probably the Arbor vitæ of Theophrastus: it is similar in leaf to the juniper, and, besides producing the gum sandrac, the wood is invaluable [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
