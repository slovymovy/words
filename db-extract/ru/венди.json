                "senses": [
                    {
                        "sense_id": "9071f119-7ffb-3b5d-82b3-0fdc288be40d",
                        "entry_id": "84c7b963-8de5-3861-ac4e-d7d205b7b773",
                        "glosses": [
                            "европейское женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79556458-3d2f-4cd3-8c25-b5798c4bad8e",
                                "sense_id": "9071f119-7ffb-3b5d-82b3-0fdc288be40d",
                                "text": "Психиатр Венди Хеллер отвергает мысль, будто «человеческое» содержится в левом полушарии, а «животное» ― в правом."
                            },
                            {
                                "example_id": "fdc976ef-611c-4482-8767-ff93e849e22a",
                                "sense_id": "9071f119-7ffb-3b5d-82b3-0fdc288be40d",
                                "text": "Одна из этих книг написана антропологом и «свободной» писательницей Венди Орент, поместившей на обложку гигантское изображение блохи."
                            }
                        ]
                    }
                ],
