        "nl-extract.jsonl": [
            {
                "entry_id": "0d28af5d-177a-3b88-bb01-0235f598913e",
                "word": "waterkringloop",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "6ca89407-e1e7-45f0-91c9-885c226700c8",
                        "entry_id": "0d28af5d-177a-3b88-bb01-0235f598913e",
                        "tags": [
                            "plural"
                        ],
                        "form": "waterkringlopen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab8a303d-6da9-3e8f-847d-05b62f87248c",
                        "entry_id": "0d28af5d-177a-3b88-bb01-0235f598913e",
                        "glosses": [
                            "het proces van verdamping, condensatie, neerslag en terugstroom van water vanuit oppervlaktewater zoals b.v. de zeeën"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8b7e6a3-86f5-412a-9714-5fc8bec0523a",
                        "source_entry_id": "0d28af5d-177a-3b88-bb01-0235f598913e",
                        "source_sense_id": "ab8a303d-6da9-3e8f-847d-05b62f87248c",
                        "target_lang_word": "Wasserkreislauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserkreislauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35316b19-6c6c-386c-ae84-62b903fd27ef",
                                        "entry_id": "5798c9ee-4e15-3cdd-b356-40a0fc8c5dcb",
                                        "glosses": [
                                            "System von Wasserleitungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f72d098-7691-4427-9f59-479861693724",
                                                "sense_id": "35316b19-6c6c-386c-ae84-62b903fd27ef",
                                                "text": "„Das Produktportfolio aus Fittings, Ventilen, Rohren, Automation und Verbindungstechnologien deckt alle Anwendungen des Wasserkreislaufes ab.“"
                                            },
                                            {
                                                "example_id": "befd755a-b16c-406d-8a05-86746a1ca3c7",
                                                "sense_id": "35316b19-6c6c-386c-ae84-62b903fd27ef",
                                                "text": "„Um Trinkwasser zu sparen, wurde in den Bauabschnitten 1 – 3 ein zweiter Wasserkreislauf' mit Regenwasser installiert.“"
                                            },
                                            {
                                                "example_id": "e1bfc2e6-048c-41b7-8b2c-8f08a7753756",
                                                "sense_id": "35316b19-6c6c-386c-ae84-62b903fd27ef",
                                                "text": "„Es ist eine neue Methode des Salatanbaus: Ein Gewächshaus mit einem eigenen Wasserkreislauf, sodass ganzjährig Salat angebaut und geerntete werden kann.“"
                                            },
                                            {
                                                "example_id": "d5e08437-7b8d-4009-aea2-f655dd8c5560",
                                                "sense_id": "35316b19-6c6c-386c-ae84-62b903fd27ef",
                                                "text": "[Kühltürme von Kraftwerken:] „Ab gewissen Temperaturen im Wasserkreislauf können sich Bakterien (z. B. Legionellen) vermehren.“"
                                            },
                                            {
                                                "example_id": "25d58ba2-bf54-40cd-9a01-26218dda4814",
                                                "sense_id": "35316b19-6c6c-386c-ae84-62b903fd27ef",
                                                "text": "„In einem Wärmekraftwerk gibt es mindestens zwei getrennte Wasserkreisläufe:“ […]."
                                            },
                                            {
                                                "example_id": "1790077c-db2b-4e3b-9014-02c957bc6aa0",
                                                "sense_id": "35316b19-6c6c-386c-ae84-62b903fd27ef",
                                                "text": "[…] „beim Betrieb eines Wärmekraftwerkes mit 3 GW thermischer Leistung können pro Tag etwa zehn Tonnen Kalk anfallen, die z. B. durch Lösen mit Ameisensäure aus dem Wasserkreislauf entfernt werden müssen.“"
                                            },
                                            {
                                                "example_id": "af11789a-3fe4-4bce-bdea-9547d4cacb54",
                                                "sense_id": "35316b19-6c6c-386c-ae84-62b903fd27ef",
                                                "text": "„Immerhin 4 Prozent der Papierproduktion stammt aus Werken, die ihren Wasserkreislauf völlig geschlossen haben, was aber nur mit salz- und härtearmen Wasserqualitäten und für geeignete Anwendungen möglich ist.“"
                                            },
                                            {
                                                "example_id": "cfa4d680-2613-4fd9-b529-0b6c58e33e79",
                                                "sense_id": "35316b19-6c6c-386c-ae84-62b903fd27ef",
                                                "text": "[Aquarium:] „Gegen Schwebealgen können UV-Lampen in den Wasserkreislauf eines Außenfilters installiert werden.“"
                                            },
                                            {
                                                "example_id": "c4f65c1d-e666-4ab3-94dd-74835afaac86",
                                                "sense_id": "35316b19-6c6c-386c-ae84-62b903fd27ef",
                                                "text": "[Naturbad Vörden:] „Vom Ausgleichsschacht des Regenerationsbereiches gelangt das gereinigte Wasser zurück in den Badebereich (geschlossener Wasserkreislauf).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1258cd82-abb3-349c-b9e1-3d78b7bcf996",
                                        "entry_id": "5798c9ee-4e15-3cdd-b356-40a0fc8c5dcb",
                                        "glosses": [
                                            "Transport und Speicherung von Wasser in den Meeren, in der Atmosphäre und auf und im Boden, in Flüssen und ähnlich (beispielsweise durch Verdunstung, Niederschlag, Versickern)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2796078a-0970-4478-899a-1c9ab720aae1",
                                                "sense_id": "1258cd82-abb3-349c-b9e1-3d78b7bcf996",
                                                "text": "„Die Wasservorräte der Erde sind festgelegt und befinden sich in einem Wasserkreislauf. In dem geschlossenen Kreis geht kein Tröpfchen Wasser verloren, es kann aber auch keines dazukommen.“"
                                            },
                                            {
                                                "example_id": "df2823dc-dcf4-4d12-81a6-5d786190f67a",
                                                "sense_id": "1258cd82-abb3-349c-b9e1-3d78b7bcf996",
                                                "text": "„Auch der Wasserkreislauf der Erde wird von der Sonnenenergie angetrieben.“"
                                            },
                                            {
                                                "example_id": "15a3f5aa-776d-4ecd-a750-614006c61f19",
                                                "sense_id": "1258cd82-abb3-349c-b9e1-3d78b7bcf996",
                                                "text": "„Diese langwellige Strahlung erwärmt die unteren Luftschichten und regt den Wasserkreislauf der Erde an.“"
                                            },
                                            {
                                                "example_id": "c1274c78-1a85-4cdd-af4c-f33e965f501d",
                                                "sense_id": "1258cd82-abb3-349c-b9e1-3d78b7bcf996",
                                                "text": "„Monsunregen und Dürre hängen zusammen: beide gehören zum Wasserkreislauf der Erde.“"
                                            },
                                            {
                                                "example_id": "30fcf538-a5d7-42de-94b1-1d017ff9ac14",
                                                "sense_id": "1258cd82-abb3-349c-b9e1-3d78b7bcf996",
                                                "text": "„Der Wasserkreislauf sorgt für eine kontinuierliche Bewegung des Wassers durch Land, Meer und die Erdatmosphäre“"
                                            },
                                            {
                                                "example_id": "5dd26272-33f1-4d98-b49b-cde79f640e0d",
                                                "sense_id": "1258cd82-abb3-349c-b9e1-3d78b7bcf996",
                                                "text": "„Jüngste Forschungsergebnisse zeigen, dass sich der Wasserkreislauf in einigen Teilen der Welt als Reaktion auf den vom Menschen verursachten Klimawandel beschleunigt.“"
                                            },
                                            {
                                                "example_id": "b7e0d093-3ff2-466e-b832-4052aac1004f",
                                                "sense_id": "1258cd82-abb3-349c-b9e1-3d78b7bcf996",
                                                "text": "„Städte können den Wasserkreislauf unterstützen, indem sie städtische Oberflächen durchlässiger machen.“"
                                            },
                                            {
                                                "example_id": "dcea8da5-a733-45d3-92a7-570975a2e22a",
                                                "sense_id": "1258cd82-abb3-349c-b9e1-3d78b7bcf996",
                                                "text": "„Weltweit gesehen nehmen die Niederschläge infolge des Klimawandels tendenziell zu – der Wasserkreislauf wird beschleunigt, es verdunstet mehr und infolgedessen regnet es auch mehr.“"
                                            },
                                            {
                                                "example_id": "3b06a13f-4623-436e-8ef4-0bd1bee064b9",
                                                "sense_id": "1258cd82-abb3-349c-b9e1-3d78b7bcf996",
                                                "text": "„Der Klimawandel hat starke Auswirkungen auf globale Wasserkreisläufe, mit Fluten in einigen Regionen und Dürren anderswo.“"
                                            },
                                            {
                                                "example_id": "a00631d1-850b-4aac-99bf-c0691f923086",
                                                "sense_id": "1258cd82-abb3-349c-b9e1-3d78b7bcf996",
                                                "text": "[Wüstenbildung:] „Es ist möglich, versandete Böden und Vegetation wiederzubeleben und Wasserkreisläufe wiederherstellen - sei es mit natürlichen Methoden oder mit Hightech.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
