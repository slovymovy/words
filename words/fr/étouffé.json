                                "target_lang_word": "smother",
                                "target_lang_sense_clarification": "suffocate by covering breath"
                            },
                            {
                                "target_lang_word": "hush up",
                                "target_lang_sense_clarification": "conceal a scandal from public"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "заглушить",
                                "target_lang_sense_clarification": "подавить звук или смех"
                            },
                            {
                                "target_lang_word": "задушить",
                                "target_lang_sense_clarification": "лишить воздуха, перекрыть дыхание"
                            },
                            {
                                "target_lang_word": "замять",
                                "target_lang_sense_clarification": "скрыть скандал от публики"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ersticken",
                                "target_lang_sense_clarification": "jemandem die Luft nehmen"
                            },
                            {
                                "target_lang_word": "unterdrücken",
                                "target_lang_sense_clarification": "Gefühle oder Geräusche zurückhalten"
                            },
                            {
                                "target_lang_word": "vertuschen",
                                "target_lang_sense_clarification": "Skandal oder Fehler verbergen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sofocar",
                                "target_lang_sense_clarification": "asfixiar con humo o calor"
                            },
                            {
                                "target_lang_word": "acallar",
                                "target_lang_sense_clarification": "silenciar un escándalo o rumor"
                            },
                            {
                                "target_lang_word": "encubrir",
                                "target_lang_sense_clarification": "ocultar un delito o error"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压制",
