                        "form": "сдава́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f817762-cfc5-3fa3-a967-1e0464e2c197",
                        "entry_id": "06ba6a0b-168b-36bd-91fe-a48409521e03",
                        "glosses": [
                            "交付，交出"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2e5573e2-473a-4a37-8451-1af158b27c47",
                                "sense_id": "9f817762-cfc5-3fa3-a967-1e0464e2c197",
                                "text": "Учи́тель сказа́л сдать сочине́ния.",
                                "translation": "老師讓我們交作業。"
                            }
                        ]
                    },
                    {
                        "sense_id": "7bed8fdd-32d7-38ee-baa0-06d58584ec03",
                        "entry_id": "06ba6a0b-168b-36bd-91fe-a48409521e03",
                        "glosses": [
                            "上交，交還"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5782d67e-3e40-4622-9dfc-409650453d1c",
                                "sense_id": "7bed8fdd-32d7-38ee-baa0-06d58584ec03",
                                "text": "сдать ве́щи в бага́ж",
                                "translation": "檢查/登記行李"
                            },
                            {
                                "example_id": "72103e19-4c3f-413e-99b7-8afdf084aaa7",
                                "sense_id": "7bed8fdd-32d7-38ee-baa0-06d58584ec03",
                                "text": "сдать дела",
                                "translation": "移交職責"
                            },
                            {
                                "example_id": "e77f4c8b-4c00-4345-b635-ea085e7c7214",
                                "sense_id": "7bed8fdd-32d7-38ee-baa0-06d58584ec03",
                                "text": "сдать внаем",
                                "translation": "出租，租用"
                            },
                            {
                                "example_id": "e866e652-9b11-4f5f-803d-624eb0586840",
                                "sense_id": "7bed8fdd-32d7-38ee-baa0-06d58584ec03",
                                "text": "сдать в аре́нду",
                                "translation": "租賃，租用"
                            }
                        ]
                    },
                    {
                        "sense_id": "8b2e3341-f20e-3d34-bc09-8ff129c56370",
                        "entry_id": "06ba6a0b-168b-36bd-91fe-a48409521e03",
                        "glosses": [
                            "服從，屈服"
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "40296cb4-0dd1-4276-9b4d-108986cda191",
                                "sense_id": "8b2e3341-f20e-3d34-bc09-8ff129c56370",
                                "text": "Проти́вник сдал го́род без бо́я.",
                                "translation": "敵人不戰而降。"
                            }
                        ]
                    },
                    {
                        "sense_id": "a330bbad-05c2-3243-aef5-a184656ad0d0",
                        "entry_id": "06ba6a0b-168b-36bd-91fe-a48409521e03",
                        "glosses": [
                            "發牌"
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "449392e8-f14e-343e-8c72-d8c20c19025d",
                        "entry_id": "06ba6a0b-168b-36bd-91fe-a48409521e03",
                        "glosses": [
                            "參加/通過，通常指考試"
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fa0237ca-d4c8-4a2f-9435-2464a3a906b0",
                                "sense_id": "449392e8-f14e-343e-8c72-d8c20c19025d",
                                "text": "Пе́тька сдал экза́мен без осо́бых уси́лий.",
                                "translation": "彼得不費吹灰之力就通過考試。"
                            }
                        ]
                    },
                    {
                        "sense_id": "69b5dd52-0d96-37a3-890b-3f1bbe3d68e6",
                        "entry_id": "06ba6a0b-168b-36bd-91fe-a48409521e03",
                        "glosses": [
                            "被削弱，被減弱"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dedd33b-4e32-4bc0-8ba5-a881bfaa28ee",
                                "sense_id": "69b5dd52-0d96-37a3-890b-3f1bbe3d68e6",
                                "text": "Твой оте́ц совсе́м сдал.",
                                "translation": "你父親健康狀況大不如前。"
                            }
                        ]
                    },
                    {
                        "sense_id": "585726a7-55bd-30eb-b9e0-b9590d6f059b",
                        "entry_id": "06ba6a0b-168b-36bd-91fe-a48409521e03",
                        "glosses": [
                            "向後退 (像是開車時)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0641d59-54b8-4b28-ba60-56c1d15b6ed9",
                                "sense_id": "585726a7-55bd-30eb-b9e0-b9590d6f059b",
                                "text": "Что́бы поверну́ть ну́жно бы́ло снача́ла сдать наза́д.",
                                "translation": "為了轉彎，他必須向後退一點。"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ]
    }
}