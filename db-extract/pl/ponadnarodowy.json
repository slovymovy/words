                        "sense_id": "518bb40d-c66f-34a1-b658-b812cc7346ae",
                        "entry_id": "01317175-b18c-3629-9233-5326a442152d",
                        "glosses": [
                            "nadrzędny w stosunku do poszczególnych narodów, dotyczący wszystkich narodów"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "3b58c840-0280-4cb0-ae43-44f19a1375c8",
                                "sense_id": "518bb40d-c66f-34a1-b658-b812cc7346ae",
                                "text": "Dziś w Unii Europejskiej jednocześnie z władzami krajowymi i lokalnymi istnieje niezależna władza ponadnarodowa"
                            },
                            {
                                "example_id": "05bc05f2-daeb-439d-8c8d-d8c372afeced",
                                "sense_id": "518bb40d-c66f-34a1-b658-b812cc7346ae",
                                "text": "Jej troską pozostaje jednak kształtowanie jedności Europy w sferze ducha poprzez ukazywanie wartości, które będą ożywiać pojętą pozytywnie świadomość ponadnarodową"
                            }
                        ],
