                "senses": [
                    {
                        "sense_id": "b938e1e1-61e5-3b85-9022-6b5a4e6e4364",
                        "entry_id": "93964a63-7939-3c56-8d4f-2ec2053b1305",
                        "glosses": [
                            "Homme homosexuel."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5e9864f1-449e-4d8c-8790-92d7bc51c877",
                                "sense_id": "b938e1e1-61e5-3b85-9022-6b5a4e6e4364",
                                "text": "En 1894, Raffalovitch donne ses Quelques observations sur l'inversion sexuelle où il emploie le terme d’unisexuel. Un unisexuel qu’il conforte dans son identité d’égalité en déclarant que l’unisexuel qui s'essaye à la bisexualité devient aussi corrompu que l'homme sexuel normal qui s'essaye à l'unisexualité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e68af43-0b61-4a35-9663-cc410365367b",
                        "source_entry_id": "93964a63-7939-3c56-8d4f-2ec2053b1305",
                        "source_sense_id": "b938e1e1-61e5-3b85-9022-6b5a4e6e4364",
