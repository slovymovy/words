                "senses": [
                    {
                        "sense_id": "abd12e55-33ef-334f-a6e8-e3b230c0084d",
                        "entry_id": "d5ddf5fa-2027-3d4b-9eed-6f7175da343c",
                        "glosses": [
                            "ein durch den Brand des eigenen Hauses Geschädigter"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "c25c7579-a2d5-4568-bc1f-3049bcc4a3ce",
                                "sense_id": "abd12e55-33ef-334f-a6e8-e3b230c0084d",
                                "text": "Man half nicht nur beim Löschen, man nahm Abbrandler auf und veranstaltete Sammlungen für sie, die von der Kanzel herab verkündet wurden."
                            },
                            {
                                "example_id": "efc327e8-2fac-4a2c-8c63-6dbbedb9f718",
                                "sense_id": "abd12e55-33ef-334f-a6e8-e3b230c0084d",
                                "text": "„[…]; denn er war vorsichtig genug, sich nicht der Gefahr auszusetzen, etwa gelegentlich eines Streites mit allem Um und Auf vor das Haus gesetzt zu werden, und ehe er noch ein solches hatte, einem ›armen Abbrandler‹ gleich, unter Gerümpel und blockendem Vieh ratlos dazustehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eedbd4a6-6695-3c40-b231-e03c2d177b5b",
                        "entry_id": "d5ddf5fa-2027-3d4b-9eed-6f7175da343c",
                        "glosses": [
                            "armer Schlucker"
                        ],
                        "tags": [
                            "Bavarian",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "cb724f3d-b780-49eb-a1f6-31e2a9eb1e9b",
                                "sense_id": "eedbd4a6-6695-3c40-b231-e03c2d177b5b",
                                "text": "„Auweh, denkt er, ihr seid's abg'haust. Bettlleut und Abbrandler auf einmal.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
