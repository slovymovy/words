                ],
                "senses": [
                    {
                        "sense_id": "50902e80-0d9c-3181-b217-0f642a57566b",
                        "entry_id": "ceb40799-b2fb-330d-b610-56befbeae883",
                        "glosses": [
                            "A car with a sloping, hinged rear door that opens upwards."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80650302-b1f0-43ae-87a4-b0fabec3add5",
                                "sense_id": "50902e80-0d9c-3181-b217-0f642a57566b",
                                "text": "The accident happened in Lottbridge Drove, Eastbourne, when the 26-year-old male victim was struck by a small dark hatchback."
                            },
                            {
                                "example_id": "41919d28-21b8-417f-890c-12b0a8f7f208",
                                "sense_id": "50902e80-0d9c-3181-b217-0f642a57566b",
                                "text": "As I tentatively reverse, I have a sense of foreboding, unsure I’ll be able to control this overgrown mechanical beast. I am posing to the salesman as someone who is seeking maximum protection on the city roads, yet I suspect that I look very much like a man who usually drives a tiny hatchback."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcc79fa3-ee0b-3149-8f2b-f85acb85fb75",
                        "entry_id": "ceb40799-b2fb-330d-b610-56befbeae883",
                        "glosses": [
                            "The door itself."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7c34947-c2a9-4739-8e2c-123483aeafbd",
                        "source_entry_id": "ceb40799-b2fb-330d-b610-56befbeae883",
                        "source_sense_description": "a car with a sloping, hinged rear door that opens upwards",
                        "target_lang_word": "hayon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hayon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48959d54-9155-3291-8aa6-3548d26699bd",
                                        "entry_id": "158c8cda-17ff-3211-87bd-85348d86ecb5",
                                        "glosses": [
                                            "Planche de bois amovible fermant l’arrière d’une charrette."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b98a9c9e-78f0-488c-915b-ae4b13843ce4",
                                                "sense_id": "48959d54-9155-3291-8aa6-3548d26699bd",
                                                "text": "Et puis, alors que les prisonniers montaient un à un dans le char, sa tête se mit à tourner et ses jambes l’abandonnèrent.\nC’était impossible, et pourtant il le voyait, escaladant avec peine le hayon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83f7b764-4b72-3ad9-8bac-29fd3607c5c9",
                                        "entry_id": "158c8cda-17ff-3211-87bd-85348d86ecb5",
                                        "glosses": [
                                            "Panneau amovible fermant le coffre d’une voiture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269043e0-1509-4bf1-96f4-b0b4824bbf67",
                                                "sense_id": "83f7b764-4b72-3ad9-8bac-29fd3607c5c9",
                                                "text": "Les deux autres se tenaient près d'un monospace Mercedes dont le hayon était ouvert, la presse hydraulique posée au sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90f37ec7-e3a9-37a1-b1b2-40630b74a5c3",
                                        "entry_id": "158c8cda-17ff-3211-87bd-85348d86ecb5",
                                        "glosses": [
                                            "Ouverture arrière des voitures et des camionnettes facilitant le chargement et de déchargement des marchandises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dfaace1-6830-4027-b2aa-0f6e330ee216",
                                                "sense_id": "90f37ec7-e3a9-37a1-b1b2-40630b74a5c3",
                                                "text": "On s’attaque au fait que l’arrière finit sur un hayon plutôt que sur une valise."
                                            },
                                            {
                                                "example_id": "6628590d-1fff-41cd-a841-22b13e96dff4",
                                                "sense_id": "90f37ec7-e3a9-37a1-b1b2-40630b74a5c3",
                                                "text": "Hacine se gara en marche arrière, cul à cul et ouvrit le hayon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8420fd7e-354e-30ee-a1fb-b4ff7fdc1e39",
                                        "entry_id": "158c8cda-17ff-3211-87bd-85348d86ecb5",
                                        "glosses": [
                                            "Abri utilisé par les pâtres et les bergers installé au milieu des prés."
                                        ],
                                        "tags": [
                                            "Le Mans"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b231dbb4-8279-34ad-80b5-25097c18615c",
                                        "entry_id": "158c8cda-17ff-3211-87bd-85348d86ecb5",
                                        "glosses": [
                                            "Tente servant à abriter les commerces forains sur les marchés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
