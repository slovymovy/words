    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "96d04782-c332-392f-83da-ae6d156c90ee",
                    "sense_definition": "przenieść coś z jednego miejsca w drugie lub oddać komuś przedmiot będący wcześniej w czyimś posiadaniu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "przenoszenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>przekazać</w> klucze nowym właścicielom mieszkania.",
                            "target_lang_translations": {
                                "ru": "Я должен <w>передать</w> ключи новым владельцам квартиры."
                            }
                        },
                        {
                            "text": "Proszę <w>przekazać</w> tę paczkę sąsiadowi z dołu.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>передайте</w> эту посылку соседу снизу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przekazać klucze",
                        "przekazać władzę"
                    ],
                    "target_lang_definitions": {
                        "ru": "переместить что-либо из одного места в другое или вручить кому-либо предмет, который ранее находился в чьем-то владении"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передать",
                                "target_lang_sense_clarification": "вручить из рук в руки"
                            },
                            {
                                "target_lang_word": "отдать",
                                "target_lang_sense_clarification": "передать во владение или пользование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e43521ed-98c9-36b1-95a9-d3081b923dc3",
                    "sense_definition": "poinformować kogoś o czymś, zakomunikować wiadomość lub treść",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "komunikacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chciałbym <w>przekazać</w> ważne informacje całemu zespołowi.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы <w>передать</w> важную информацию всей команде."
                            }
                        },
                        {
                            "text": "Muszę <w>przekazać</w> pozdrowienia od mojej mamy.",
                            "target_lang_translations": {
                                "ru": "Я должен <w>передать</w> привет от моей мамы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przekazać wiadomość",
                        "przekazać pozdrowienia"
                    ],
                    "target_lang_definitions": {
                        "ru": "сообщить кому-либо информацию, передать содержание сообщения или приветствие"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передать",
                                "target_lang_sense_clarification": "сообщить информацию или приветствие"
                            },
                            {
                                "target_lang_word": "сообщить",
                                "target_lang_sense_clarification": "довести до сведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "286031bc-b10e-37ec-bee7-ded3dae6c062",
                    "sense_definition": "wysyłać sygnał lub fale do urządzenia odbiorczego",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "komunikacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Antena musi <w>przekazać</w> sygnał do odbiornika w domu.",
                            "target_lang_translations": {
                                "ru": "Антенна должна <w>передать</w> сигнал на приемник в доме."
                            }
                        },
                        {
                            "text": "System potrafi <w>przekazać</w> dane w czasie rzeczywistym.",
                            "target_lang_translations": {
                                "ru": "Система способна <w>передать</w> данные в режиме реального времени."
                            }
                        }
