                                        "glosses": [
                                            "ohne Vermögen, kein Geld besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d60d36-4a9f-4b25-bf26-75af5dc55197",
                                                "sense_id": "7ec89c49-a108-39db-9091-0a01a08c7fe4",
                                                "text": "„Schließlich war Mary Rose keine mittellose Dienstmagd, die nichts weiter als zwei Pence und einen Ersatzunterrock besaß.“"
                                            }
