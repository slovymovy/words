                "senses": [
                    {
                        "sense_id": "4c66a17f-edd0-3d82-ae65-3a210a4e5888",
                        "entry_id": "16422d8d-980c-33d6-921a-e0f3cad95654",
                        "glosses": [
                            "häufig unter den Achseln aufgebrachtes Mittel zur Bekämpfung von Körpergeruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab3894ed-9934-43dc-848b-b2a681106eba",
                                "sense_id": "4c66a17f-edd0-3d82-ae65-3a210a4e5888",
                                "text": "„Dieser Deospray lässt sich auch perfekt nach einem Schwimmbadbesuch verwenden.“"
                            },
                            {
                                "example_id": "e386a28f-58e8-458e-9d7b-557a32cf5bf0",
                                "sense_id": "4c66a17f-edd0-3d82-ae65-3a210a4e5888",
                                "text": "„Ich greife nach dem Deospray mit Lavendelduft und atme nach dem Sprühen genüsslich ein.“"
                            },
                            {
                                "example_id": "1a00c318-cc7f-4b5a-95af-803016c9ed81",
                                "sense_id": "4c66a17f-edd0-3d82-ae65-3a210a4e5888",
                                "text": "„Ich hatte immer ein Deospray und Kaugummis dabei, damit meine Mutter bei meiner Heimkehr keinesfalls etwas roch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
