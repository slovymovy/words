                "senses": [
                    {
                        "sense_id": "7148bd2d-392c-3a40-887e-29a6704df8e7",
                        "entry_id": "8a3ccd0e-07c3-385c-aa26-3bf19581f42b",
                        "glosses": [
                            "Person, die unterrichtet, ohne Beamter zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b979216d-2ac8-41c0-8c4c-16a519603f89",
                                "sense_id": "7148bd2d-392c-3a40-887e-29a6704df8e7",
                                "text": "„Der Vertragslehrer ist nach Möglichkeit im vollen Ausmaß der für ihn festgelegten Lehrverpflichtung unbeschadet der Bestimmungen nach Abs.3 und 4 zur Unterrichtserteilung heranzuziehen.“"
                            },
                            {
                                "example_id": "619b7b0a-7ded-487a-92cb-caf216bbe4bc",
                                "sense_id": "7148bd2d-392c-3a40-887e-29a6704df8e7",
                                "text": "„Hier erhalten von 70 Bewerbern alle 70 eine Beschäftigung, wobei 48 als Beamte auf Probe, 10 als Vertragslehrer mit der Zusage auf eine spätere Verbeamtung und 12 als Vertragslehrer ohne Zusage auf eine spätere Verbeamtung beschäftigt werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
