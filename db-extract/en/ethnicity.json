                ],
                "senses": [
                    {
                        "sense_id": "f95782ee-4e70-3889-8c00-5b1c2325bb82",
                        "entry_id": "a6006c0a-bd20-3892-ae3f-abb981f80a72",
                        "glosses": [
                            "The common characteristics of a group of people, especially regarding ancestry, culture, language or national experiences."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9402a5e5-5802-44a5-8817-a10133bdebed",
                                "sense_id": "f95782ee-4e70-3889-8c00-5b1c2325bb82",
                                "text": "Few concepts are as emotionally charged as that of race. The word conjures up a mixture of associations—culture, ethnicity, genetics, subjugation, exclusion and persecution. But is the tragic history of efforts to define groups of people by race really a matter of the misuse of science, the abuse of a valid biological concept?"
                            }
                        ]
                    },
                    {
                        "sense_id": "af094677-f9a8-3687-a76d-a15b0b5561a8",
                        "entry_id": "a6006c0a-bd20-3892-ae3f-abb981f80a72",
                        "glosses": [
                            "An ethnic group."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c11be16e-b577-3638-97de-2688bf2df1df",
                        "entry_id": "a6006c0a-bd20-3892-ae3f-abb981f80a72",
                        "glosses": [
                            "Race; common ancestry."
                        ],
                        "tags": [
                            "countable",
                            "euphemistic",
                            "informal",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
