                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecf298e5-8268-47cd-bf3a-6bbeb063813b",
                                                "sense_id": "deaedbf7-fec8-3516-8fa4-9f4b97a374f5",
                                                "text": "again, libtard randroids would have argued that the only civil rights are property rights and would have seen no problem."
                                            },
                                            {
                                                "example_id": "7b33e4be-c140-46ef-8250-8d084eebcf18",
                                                "sense_id": "deaedbf7-fec8-3516-8fa4-9f4b97a374f5",
                                                "text": "I guess the libtard is against corporations \"Stealing\" but sees nothing wrong when it comes to the government. How are these \"Rich corporations\" Stealing from the people and how is Ron Paul eliminating these regulations?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
