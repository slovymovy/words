                        "divertit"
                    ],
                    "antonyms": [
                        "ennuie"
                    ]
                },
                {
                    "sense_id": "7e0b6eda-756a-3025-9122-1b5fcb75af44",
                    "sense_definition": "Participe passé masculin singulier de <w>distraire</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "forme_verbale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La musique douce a <w>distrait</w> le malade de ses douleurs pendant quelques instants."
                        },
                        {
                            "text": "Le spectacle d'humour a beaucoup <w>distrait</w> les spectateurs venus nombreux ce soir-là."
