                        "examples": [
                            {
                                "example_id": "bf7de77c-3a4d-4b99-9e2f-ae7315df013b",
                                "sense_id": "9c5a128b-0641-3299-a4cb-c446c484c17c",
                                "text": "Vorig jaar stond het nog in de schaduw van Deventer op Stelten, dit weekend ontpopte het festival zich bij de tweede editie tot een waar zomerfestival. De tweede editie van het OE OE Festival deed denken aan het Vordense festival Mañana Mañana, het relaxte festival van Nederland."
                            },
                            {
                                "example_id": "eea06f3c-8e5b-4abe-88ea-8f776c781d32",
                                "sense_id": "9c5a128b-0641-3299-a4cb-c446c484c17c",
                                "text": "Nieuw dit jaar is het Zomerfestival van De Drie Straatjes dat zich heeft aangesloten bij het tropische evenement. Van 13.00 uur tot en met 17.00 uur kunnen bezoekers van de Drienerstraat, de Wetstraat en Smutsstraat genieten van een Ibiza-stijl markt, live muziek en nog veel meer."
                            }
                        ]
