                        "glosses": [
                            "Celle qui est coupable de contrefaçon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a23d36b-a6bc-4a0a-995b-520b797d36e4",
                                "sense_id": "165394ac-4325-3aa2-a4f3-4c65364eccb4",
                                "text": "La Belgique, devenue contrefactrice des publications imprimées dans les cinq parties du monde, avait fini par manquer de places pour emmagasiner ses in-18 et ses in-32."
                            }
                        ]
                    }
                ],
