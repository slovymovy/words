                "senses": [
                    {
                        "sense_id": "06049801-773f-3b4b-a7ec-144a647652f2",
                        "entry_id": "d067a76d-3148-3eff-88e8-8e71774b2a3d",
                        "glosses": [
                            "Discipline scientifique qui utilise la connaissance que l’on a du génome et de ses variations individuelles pour identifier de nouvelles cibles pharmacologiques et prévoir l’efficacité d’un traitement médicamenteux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35c028e3-27d1-4337-81e7-a772e1c06d1b",
                                "sense_id": "06049801-773f-3b4b-a7ec-144a647652f2",
                                "text": "On la distingue aujourd’hui de la pharmacogénomique qui, d'un point de vue plus vaste, étudie non pas les modifications de séquence de notre génome, mais le profil d’expression de nos gènes impliqués dans la susceptibilité aux maladies, et la réponse aux médicaments au niveau d’une cellule, d’un tissu, d’un individu, d’une population."
                            }
                        ]
                    }
                ],
