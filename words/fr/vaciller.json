                    ]
                },
                {
                    "sense_id": "ee878ff3-0ae7-39f8-af48-f3908b65a546",
                    "sense_definition": "Hésiter, devenir incertain dans ses décisions, ses convictions ou perdre son autorité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Devant les questions précises du journaliste, le ministre s'est mis à <w>vaciller</w> dans ses réponses."
