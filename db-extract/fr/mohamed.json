                "senses": [
                    {
                        "sense_id": "b7c38886-7007-3e63-a310-9b594484cf58",
                        "entry_id": "4160e47e-2133-3e33-a2f3-2c1dd307ef6c",
                        "glosses": [
                            "Maghrébin, Arabe, musulman"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "af981ed4-d99b-4cb7-9957-7ae90744318a",
                                "sense_id": "b7c38886-7007-3e63-a310-9b594484cf58",
                                "text": "« Avec les Mohamed, on est jamais déçu, y'en a pas un pour racheter l'autre … »"
                            },
                            {
                                "example_id": "93899f20-2038-47ce-a819-46e08e8698c0",
                                "sense_id": "b7c38886-7007-3e63-a310-9b594484cf58",
                                "text": "« À chaque attentat, ma première réaction, c’est de dire : j’espère que ce n’est pas un Mohamed ! ». Car quand c’est « un Mohamed », il en résulte des semaines de débats sur l’islam …."
                            }
                        ]
                    }
                ],
