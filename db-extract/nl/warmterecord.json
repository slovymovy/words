                        "examples": [
                            {
                                "example_id": "91e3b315-e3a6-4455-9def-89a8969a25d6",
                                "sense_id": "7233f87a-d580-36fb-bd9b-94ac3943dd45",
                                "text": "Muggen, hooikoorts, vlinders: we brengen ze in verband met het voorjaar, pollen en warme zomers. Toch wordt er nu al volop melding van gemaakt. De oorzaak laat zich raden: het zachte weer van de afgelopen periode, met het ene gesneuvelde warmterecord na het andere."
                            },
                            {
                                "example_id": "cb1823a5-2fd2-43ce-8ce7-5de41ecea0c1",
                                "sense_id": "7233f87a-d580-36fb-bd9b-94ac3943dd45",
                                "text": "Het landelijke warmterecord voor Oudejaarsdag is gesneuveld. Bij het KNMI in De Bilt steeg de temperatuur vannacht tot 14,4 graden. Dat is 0,7 graden meer dan het oude record uit 2017."
                            }
