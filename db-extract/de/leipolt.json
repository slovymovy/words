                "senses": [
                    {
                        "sense_id": "698b7941-363f-37b3-97b4-c31d7965448a",
                        "entry_id": "9e68b4dd-3656-3a21-8fcf-412e48659c95",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd404853-d7fc-490a-b49a-70a79f8dad77",
                                "sense_id": "698b7941-363f-37b3-97b4-c31d7965448a",
                                "text": "Frau Leipolt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "00339628-ee52-4eab-85ea-0a8a64f855bd",
                                "sense_id": "698b7941-363f-37b3-97b4-c31d7965448a",
                                "text": "Herr Leipolt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "41a8955e-dd3b-49d5-9d0c-f65298fa8c52",
                                "sense_id": "698b7941-363f-37b3-97b4-c31d7965448a",
                                "text": "Die Leipolts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "876a4523-1721-4c62-b0ea-bd42d8e22331",
                                "sense_id": "698b7941-363f-37b3-97b4-c31d7965448a",
                                "text": "Der Leipolt trägt nie die Schals, die die Leipolt ihm strickt."
                            },
                            {
                                "example_id": "e694b7a9-6249-4e53-801d-42e01e5bffca",
                                "sense_id": "698b7941-363f-37b3-97b4-c31d7965448a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Leipolt kommt, geht der Herr Leipolt.“"
                            },
                            {
                                "example_id": "f7635bcd-1dc4-40d6-82c1-89210e120e24",
                                "sense_id": "698b7941-363f-37b3-97b4-c31d7965448a",
                                "text": "Leipolt kommt und geht."
                            },
                            {
                                "example_id": "a0449f1e-e8c7-4696-a7a2-cd9376c991f9",
                                "sense_id": "698b7941-363f-37b3-97b4-c31d7965448a",
                                "text": "Leipolts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
