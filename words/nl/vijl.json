                    "sense_id": "0e864100-a776-353a-8682-d9d09141e139",
                    "sense_definition": "een werktuig met een ruw oppervlak om materiaal glad te maken of weg te nemen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt dit stukje hout gemakkelijk met een <w>vijl</w> passend maken.",
                            "target_lang_translations": {
                                "en": "You can easily make this piece of wood fit with a <w>file</w>.",
                                "ru": "Вы можете легко подогнать этот кусок дерева с помощью <w>напильника</w>."
                            }
                        },
                        {
                            "text": "Zij gebruikt een kleine <w>vijl</w> om haar nagels korter te maken.",
                            "target_lang_translations": {
                                "en": "She uses a small <w>file</w> to shorten her nails.",
                                "ru": "Она использует маленькую <w>пилку</w>, чтобы укоротить ногти."
                            }
                        }
                    ],
                    "common_phrases": [
