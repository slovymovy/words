                        "entry_id": "b771cc8f-15c0-3c55-9ac6-47ff4cf90cc6",
                        "glosses": [
                            "heel erg hard; zo hard als steen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5d8b459-3b09-4fc3-b484-800a7a84a85a",
                                "sense_id": "3f3e4378-dc11-30c5-98dc-aa0a2b41c856",
                                "text": "Iedere ruimte heeft weer een andere atmosfeer, geschikt voor een bepaalde kaas want de een heeft meer vocht nodig dan de ander bijvoorbeeld. Je kunt ze ook weer niet te lang laten liggen want dan blijft er niks over en droogt het uit tot een steenharde brok. Onverkoopbaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "c53ddf10-71b2-3d4c-9c83-9bff3dd9fc28",
                        "entry_id": "b771cc8f-15c0-3c55-9ac6-47ff4cf90cc6",
                        "glosses": [
                            "zonder gevoel"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e8b82cc7-1772-418b-9f7a-1f675a0a70e2",
                                "sense_id": "c53ddf10-71b2-3d4c-9c83-9bff3dd9fc28",
                                "text": "Laat u niet met een kluitje in het riet sturen. Zoals een reporter die zich door onvoldoende basiskennis van de zakelijke mores liet afbluffen door een steenharde en goedgebekte directrice van een overkoepelende kinderdagverblijf-instelling."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfd318f0-531c-31b3-9a5c-a00eb81ed7b6",
                        "entry_id": "b771cc8f-15c0-3c55-9ac6-47ff4cf90cc6",
                        "glosses": [
                            "heel erg snel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ae69d6-2aa7-4146-ad45-5be0ec3bf82f",
                                "sense_id": "cfd318f0-531c-31b3-9a5c-a00eb81ed7b6",
                                "text": "Dost opende na vier minuten de score en verdubbelde tien minuten later de marge met een steenharde kopbal van dichtbij. In de tweede helft sloeg hij nogmaals toe. Daarmee bracht de Nederlander zijn totale productie in Portugal op zeven doelpunten. Vorig jaar eindigde Dost op een totaal van 34."
                            }
                        ]
                    }
