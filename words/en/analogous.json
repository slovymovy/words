{
    "word_family": [
        "analogy",
        "analogously",
        "analogue"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fb2e709c-bdb7-3a84-9bfe-07e6a5b0ccc9",
                    "sense_definition": "Similar or comparable in certain respects, typically in a way that makes clearer the nature of the things compared.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The relationship between a teacher and a student is often <w>analogous</w> to that of a parent and a child."
                        },
                        {
                            "text": "He suggested that the brain's processing capacity is broadly <w>analogous</w> to a computer's central processor."
                        }
                    ],
                    "synonyms": [
                        "comparable",
                        "parallel",
                        "similar"
                    ],
                    "common_phrases": [
                        "analogous to",
                        "broadly analogous",
                        "roughly analogous"
                    ]
                },
                {
                    "sense_id": "5b5cec49-e6bc-37a0-8618-673a1777acf1",
                    "sense_definition": "Performing a similar function but having a different evolutionary origin, such as the wings of birds and insects.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wings of a bat and the wings of a butterfly are <w>analogous</w> structures resulting from convergent evolution."
                        },
                        {
                            "text": "Biologists noted that the fins of sharks and dolphins are <w>analogous</w> organs adapted for swimming."
                        }
                    ],
                    "common_phrases": [
                        "analogous structures",
                        "analogous organs"
                    ]
                }
            ]
        }
    ]
}