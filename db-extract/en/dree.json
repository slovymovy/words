                        "entry_id": "12075899-db6c-38f4-863b-3b5f074e61e3",
                        "tags": [
                            "plural"
                        ],
                        "form": "drees"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ea60fd1-4939-37c3-a6da-fa4673715445",
                        "entry_id": "12075899-db6c-38f4-863b-3b5f074e61e3",
                        "glosses": [
                            "Grief; suffering; trouble."
                        ],
                        "tags": [
                            "Northern-England",
                            "Northumbria",
                            "Scotland",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "668e423f-b5f8-4dbd-8e02-82a5cac46382",
                                "sense_id": "3ea60fd1-4939-37c3-a6da-fa4673715445",
                                "text": "Life is blood, shed and offered. / The eagle’s eye can face this dree. / To beasts of chase the lie is proffered: / Timor Mortis Conturbat Me."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
