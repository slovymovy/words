                ],
                "senses": [
                    {
                        "sense_id": "ecade7c7-65c4-3291-9500-c5a0386034cc",
                        "entry_id": "7fe38198-f4fc-3bb1-9dcf-c22d451c9ce7",
                        "glosses": [
                            "Umhüllung von Fleisch-, Fisch- oder Geflügelgerichten bestehend meist aus Mehl, geschlagenem Ei und Paniermehl/Semmelbrösel. Das Gericht wird in einer Pfanne mit reichlich Fett gebacken"
                        ],
                        "tags": [
                            "Nahrungsmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "fe29b11e-faaf-436e-b348-efe38fb523f2",
                                "sense_id": "ecade7c7-65c4-3291-9500-c5a0386034cc",
                                "text": "Das Wiener Restaurant Figlmüller ist seit mehr als 110 Jahren Spezialist für die Zubereitung des Fleischklassikers [Wiener Schnitzel] und verrät […] das Rezept für eine gelungene Panade […]."
                            },
                            {
                                "example_id": "72cac77d-83a9-4374-ab32-49ff8eb25dad",
                                "sense_id": "ecade7c7-65c4-3291-9500-c5a0386034cc",
                                "text": "Die Pfanne immer ein wenig rütteln, damit Fett und Schnitzel in Bewegung bleiben. So hebt sich die Panade am besten ab, und das Schnitzel bekommt seine einzigartige wellige Struktur."
                            },
                            {
                                "example_id": "27e29992-a823-4ccb-baf0-e831013df839",
                                "sense_id": "ecade7c7-65c4-3291-9500-c5a0386034cc",
                                "text": "Das geschnetzelte Fleisch wird zunächst in Stärke gewendet – und danach im Wok in heißem Fett kurz gebraten. Durch die dünne Panade bleibt es saftiger, und es bilden sich zusätzlich ein paar Aroma gebende Röststoffe."
                            },
                            {
                                "example_id": "e1bf6ac6-29bb-45d2-a291-3f629b057f25",
                                "sense_id": "ecade7c7-65c4-3291-9500-c5a0386034cc",
                                "text": "In Stevens Panade [für den Fisch in Fish and Chips] kommt Bier aus London, Cayennepfeffer, Backpulver und glutenfreies Mehl […]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4f560643-c880-392d-b676-67c0a3b10407",
                        "entry_id": "7fe38198-f4fc-3bb1-9dcf-c22d451c9ce7",
                        "glosses": [
                            "Brei zur Füllung (Farce) in Fleisch-, Fisch- oder Geflügelgerichten bestehend unter anderem aus Brot (oder Mehl oder Semmelbrösel), Fleischbrühe (oder Wasser, Milch), Butter, Eiern und Gewürzen"
                        ],
                        "tags": [
                            "Nahrungsmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "faee255e-1535-4786-980f-714fc8b08fe2",
                                "sense_id": "4f560643-c880-392d-b676-67c0a3b10407",
                                "text": "[Für eine Farce wird] gebratenes oder rohes, gehacktes oder gestoßenes Fleisch (oder Fisch), mit einer Panade aus Butter, eingeweichtem Brötchen, Eiern zu Mus gerührt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
