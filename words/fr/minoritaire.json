            "senses": [
                {
                    "sense_id": "27abcb3d-81f3-3c06-9ae1-a7e76672761b",
                    "sense_definition": "Qui constitue une minorité ou qui représente moins de la moitié d'un ensemble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le parti au pouvoir est devenu <w>minoritaire</w> après les dernières élections législatives."
                        },
                        {
                            "text": "En tant qu'actionnaire <w>minoritaire</w>, il ne peut pas imposer ses décisions au conseil."
                        }
                    ],
                    "antonyms": [
                        "majoritaire"
                    ],
                    "common_phrases": [
                        "actionnaire minoritaire",
                        "gouvernement minoritaire"
                    ]
                },
                {
                    "sense_id": "b02b055e-43ee-3c0d-bdfe-fc42ab5168fa",
                    "sense_definition": "Qui est faiblement représenté ou pratiqué par un nombre restreint de personnes dans un domaine donné.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette région protège les langues <w>minoritaires</w> pour préserver son patrimoine culturel."
                        },
                        {
                            "text": "Certaines traditions <w>minoritaires</w> risquent de disparaître sans le soutien de la communauté."
                        }
                    ],
                    "antonyms": [
                        "majoritaire"
                    ],
                    "common_phrases": [
