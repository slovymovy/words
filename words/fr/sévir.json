                    "frequency": "Middle",
                    "semantic_group_id": "repression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a décidé de <w>sévir</w> contre les automobilistes roulant à une vitesse excessive."
                        },
                        {
                            "text": "Le directeur n'hésitera pas à <w>sévir</w> si les élèves continuent de perturber le cours."
                        }
                    ],
                    "synonyms": [
                        "punir",
                        "réprimer",
                        "sanctionner"
                    ],
                    "antonyms": [
                        "pardonner",
                        "tolérer"
