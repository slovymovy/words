{
    "word_family": [
        "bekommeren",
        "bekommernis",
        "overkomen",
        "aankomen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2db30de5-c9d4-357c-83f7-209b1c782352",
                    "sense_definition": "weer op krachten of tot rust komen na een schrik, inspanning of ziekte",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "herstel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij van de schrik was <w>bekomen</w>, kon hij eindelijk weer rustig nadenken over wat er was gebeurd.",
                            "target_lang_translations": {
                                "en": "Once he had <w>recovered</w> from the shock, he was finally able to think calmly again about what had happened."
                            }
                        },
                        {
                            "text": "Zij moest eerst even rustig gaan zitten om te <w>bekomen</w> van die zware wandeling door de bergen.",
                            "target_lang_translations": {
                                "en": "She first had to sit down quietly for a moment to <w>catch her breath</w> from that strenuous hike through the mountains."
                            }
                        }
                    ],
                    "synonyms": [
                        "herstellen",
                        "bijkomen"
                    ],
                    "common_phrases": [
                        "bekomen van de schrik"
                    ],
                    "target_lang_definitions": {
                        "en": "to regain strength, recover, or calm down after a shock, exertion, or illness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "recover",
                                "target_lang_sense_clarification": "from shock, exertion, or illness"
                            },
                            {
                                "target_lang_word": "get over",
                                "target_lang_sense_clarification": "recover from a shock or surprise"
                            },
                            {
                                "target_lang_word": "catch one's breath",
                                "target_lang_sense_clarification": "rest after physical exertion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "832e752d-113e-3cf8-a048-24fad622fc28",
                    "sense_definition": "in bezit krijgen of verwerven, vaak na een zekere moeite of procedure",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verwerven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij deed er alles aan om via de gemeente een officiële vergunning te <w>bekomen</w>.",
                            "target_lang_translations": {
                                "en": "He did everything he could to <w>obtain</w> an official permit through the municipality."
                            }
                        },
                        {
                            "text": "De wetenschappers probeerden een betrouwbaar resultaat te <w>bekomen</w> met hun nieuwe meetmethode.",
                            "target_lang_translations": {
                                "en": "The scientists tried to <w>get</w> a reliable result using their new measurement method."
                            }
                        }
                    ],
                    "synonyms": [
                        "verkrijgen",
                        "verwerven"
                    ],
                    "antonyms": [
                        "verliezen"
                    ],
                    "common_phrases": [
                        "een resultaat bekomen",
                        "een vergunning bekomen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral gangbaar in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to acquire, obtain, or get possession of something, often after effort or formal procedure (chiefly Belgian Dutch)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obtain",
                                "target_lang_sense_clarification": "acquire through effort or formal procedure"
                            },
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "acquire or receive"
                            },
                            {
                                "target_lang_word": "acquire",
                                "target_lang_sense_clarification": "gain possession of"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "733ecfaf-31e7-381f-a279-093efe9553c4",
                    "sense_definition": "een bepaalde, gunstige of ongunstige lichamelijke of geestelijke uitwerking op iemand hebben",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uitwerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die zware maaltijd met veel vet vlees is mij gisteravond helemaal niet goed <w>bekomen</w>.",
                            "target_lang_translations": {
                                "en": "That heavy meal with lots of fatty meat did not <w>agree with</w> me at all last night."
                            }
                        },
                        {
                            "text": "Zijn ondoordachte opmerking tegenover de directeur zal hem waarschijnlijk zuur <w>bekomen</w>.",
                            "target_lang_translations": {
                                "en": "His reckless remark to the director will likely <w>cost</w> him dearly."
                            }
                        }
                    ],
                    "common_phrases": [
                        "goed bekomen",
                        "slecht bekomen",
                        "zuur bekomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to affect someone favorably or unfavorably, physically or mentally; to agree or disagree with someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "agree with",
                                "target_lang_sense_clarification": "suit one's stomach or health"
                            },
                            {
                                "target_lang_word": "go down",
                                "target_lang_sense_clarification": "be received or settle (of food or actions)"
                            },
                            {
                                "target_lang_word": "affect",
                                "target_lang_sense_clarification": "have an impact or consequence on"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d15a95e-a08e-341c-a880-558ee202d218",
                    "sense_definition": "voltooid deelwoord van <w>bekomen</w>",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nadat de reizigers waren <w>bekomen</w>, vervolgden zij hun tocht naar het dal.",
                            "target_lang_translations": {
                                "en": "After the travelers had <w>recovered</w>, they continued their journey to the valley."
                            }
                        },
                        {
                            "text": "De tijdens het onderzoek <w>bekomen</w> gegevens werden door de specialisten zorgvuldig geanalyseerd.",
                            "target_lang_translations": {
                                "en": "The data <w>obtained</w> during the study were carefully analyzed by the specialists."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "deelwoordvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of bekomen: recovered; obtained or acquired"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "recovered",
                                "target_lang_sense_clarification": "having regained composure or strength"
                            },
                            {
                                "target_lang_word": "obtained",
                                "target_lang_sense_clarification": "acquired or gathered"
                            }
                        ]
                    }
                }
            ]
        }
    ]
