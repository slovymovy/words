                ],
                "senses": [
                    {
                        "sense_id": "68cb4def-4de7-3c9d-b45f-f2cf3f1f1180",
                        "entry_id": "2ba0ddf9-866f-3309-bcdd-596b8bed3351",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f2d54a1-f0e8-4872-b2c1-6e6ce5dee84b",
                                "sense_id": "68cb4def-4de7-3c9d-b45f-f2cf3f1f1180",
                                "text": "Frau Fränzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "51c9a156-4987-4297-badd-8fd1d20360d2",
                                "sense_id": "68cb4def-4de7-3c9d-b45f-f2cf3f1f1180",
                                "text": "Herr Fränzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4c65a97b-b087-4d6d-89bd-34af2672b451",
                                "sense_id": "68cb4def-4de7-3c9d-b45f-f2cf3f1f1180",
                                "text": "Die Fränzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4f452b36-8404-49d8-ad28-80d243bb3d83",
                                "sense_id": "68cb4def-4de7-3c9d-b45f-f2cf3f1f1180",
                                "text": "Der Fränzle trägt nie die Schals, die die Fränzle ihm strickt."
                            },
                            {
                                "example_id": "a15d8cf1-10b8-419c-ac6f-66d50ac915b0",
                                "sense_id": "68cb4def-4de7-3c9d-b45f-f2cf3f1f1180",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fränzle kommt, geht der Herr Fränzle.“"
                            },
                            {
                                "example_id": "59410264-baef-492b-a2c2-3cd0d86ae512",
                                "sense_id": "68cb4def-4de7-3c9d-b45f-f2cf3f1f1180",
                                "text": "Fränzle kommt und geht."
                            },
                            {
                                "example_id": "34b62197-34f6-4a5e-8591-989f1cce4d80",
                                "sense_id": "68cb4def-4de7-3c9d-b45f-f2cf3f1f1180",
                                "text": "Fränzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
