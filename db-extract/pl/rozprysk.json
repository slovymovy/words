                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab0e44ed-2900-4a39-9b32-287bef0ed40f",
                        "source_entry_id": "4d41c134-6d86-3d4b-ad43-ecc899cabc42",
                        "source_sense_id": "e9f6afdd-7fa0-3d1e-8137-48e1200bad6c",
                        "target_lang_word": "spray",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b51f7da-ca77-3513-b9db-f3a606057aea",
                                        "entry_id": "c733f51b-5c17-3c8c-a588-fb035c4a75e0",
                                        "glosses": [
                                            "A fine, gentle, dispersed mist of liquid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "402487e8-70d7-4d65-b5cd-93bcc108bf48",
                                                "sense_id": "5b51f7da-ca77-3513-b9db-f3a606057aea",
                                                "text": "The sailor could feel the spray from the waves."
                                            },
                                            {
                                                "example_id": "3b17f6f4-e9e0-46a8-bf7a-02058674c1a1",
                                                "sense_id": "5b51f7da-ca77-3513-b9db-f3a606057aea",
                                                "text": "A strong sirocco was blowing the spray from the waves as far as the little café, whose glass doors were shut. The café reeked of brewing sage and human beings whose breath steamed the windows because of the cold outside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1938b0c-5975-3357-9019-eb46c20777ed",
                                        "entry_id": "c733f51b-5c17-3c8c-a588-fb035c4a75e0",
                                        "glosses": [
                                            "Something resembling a spray of liquid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cef359f6-3634-45df-a45f-e2748b26bf63",
                                                "sense_id": "f1938b0c-5975-3357-9019-eb46c20777ed",
                                                "text": "Nurse Cramer had a cute nose and a radiant, blooming complexion dotted with fetching sprays of adorable freckles that Yossarian detested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39895e07-966b-38ae-b0ee-fe38451dc2a9",
                                        "entry_id": "c733f51b-5c17-3c8c-a588-fb035c4a75e0",
                                        "glosses": [
                                            "A pressurized container; an atomizer."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a1f8d09-fa40-3fea-a4ba-1e9ca1c9a565",
                                        "entry_id": "c733f51b-5c17-3c8c-a588-fb035c4a75e0",
                                        "glosses": [
                                            "Any of numerous commercial products, including paints, cosmetics, and insecticides, that are dispensed from containers in this manner."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51fbad65-558b-3b2e-9eaf-099238a8e990",
                                        "entry_id": "c733f51b-5c17-3c8c-a588-fb035c4a75e0",
                                        "glosses": [
                                            "A jet of fine medicated vapour, used either as an application to a diseased part or to charge the air of a room with a disinfectant or a deodorizer."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec0835aa-72bd-315c-b322-2e9efd8ac0fc",
                                        "entry_id": "c733f51b-5c17-3c8c-a588-fb035c4a75e0",
                                        "glosses": [
                                            "A side channel or branch of the runner of a flask, made to distribute the metal to all parts of the mold."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34a07239-c8fa-321e-b4e7-3c426bbd884b",
                                        "entry_id": "c733f51b-5c17-3c8c-a588-fb035c4a75e0",
                                        "glosses": [
                                            "A group of castings made in the same mold and connected by sprues formed in the runner and its branches."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ef30e29-825b-3af8-8216-a5a15b8e8dca",
                                        "entry_id": "c733f51b-5c17-3c8c-a588-fb035c4a75e0",
                                        "glosses": [
                                            "The allocation and filling of blocks of memory with the same byte sequence, hoping to establish that sequence in a certain predetermined location as part of an exploit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a65346e-a672-4ab6-812d-663b766ddd50",
                                                "sense_id": "4ef30e29-825b-3af8-8216-a5a15b8e8dca",
                                                "text": "This approach would be altered for an optimal omelette based exploit. One would spray the heap with the omelette code solely, then load a single copy of the additional shellcode eggs into memory outside the target region for the spray."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2daf58a3-8d44-30c0-a9af-0b93e858e039",
                                        "entry_id": "c733f51b-5c17-3c8c-a588-fb035c4a75e0",
                                        "glosses": [
                                            "A loud scolding or reprimand, usually delivered by a sports coach or similar figure."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e836b4-8f9e-4655-8e2a-24b07fbd9251",
                                                "sense_id": "2daf58a3-8d44-30c0-a9af-0b93e858e039",
                                                "text": "On match days he could give a good spray, and in many ways he was an old-fashioned coach, having learned a lot of his approach from Ron Barassi."
                                            },
                                            {
                                                "example_id": "5db3cb9d-1dd5-433a-b848-6fe43a7dfa3c",
                                                "sense_id": "2daf58a3-8d44-30c0-a9af-0b93e858e039",
                                                "text": "Expectations of what they will put up with have changed and a big spray probably doesn't have the effect it used to have. It certainly worked for me, I would get really aggressive and get fired up 'cause it's a motivational device they used."
                                            },
                                            {
                                                "example_id": "800ab24f-848e-4683-8445-7ae846b56bef",
                                                "sense_id": "2daf58a3-8d44-30c0-a9af-0b93e858e039",
                                                "text": "He could give a bloody good spray, Bricey,' Cook says. 'He'd be frothing at the mouth after he'd finished."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3abcd37c-ab9a-3268-bb84-6e35d80ee46c",
                                        "entry_id": "366b20d8-df24-3d79-a0d9-272d58b762b0",
                                        "glosses": [
                                            "To project a liquid in a dispersive manner toward something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9179f134-a704-4c45-bf13-271ee2de8335",
                                                "sense_id": "3abcd37c-ab9a-3268-bb84-6e35d80ee46c",
                                                "text": "The firemen sprayed the house."
                                            },
                                            {
                                                "example_id": "28247ad8-8059-4013-83e9-4b39409a8531",
                                                "sense_id": "3abcd37c-ab9a-3268-bb84-6e35d80ee46c",
                                                "text": "Using a water cannon, the national guard sprayed the protesters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4488e04e-922b-30e5-a266-b6777bd04dad",
                                        "entry_id": "366b20d8-df24-3d79-a0d9-272d58b762b0",
                                        "glosses": [
                                            "To project in a dispersive manner."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dd26a72-aee6-4833-aac5-0658e183414e",
                                                "sense_id": "4488e04e-922b-30e5-a266-b6777bd04dad",
                                                "text": "Spray some ointment on that scratch."
                                            },
                                            {
                                                "example_id": "e1a3a706-ff51-448e-8829-d3d40bb62fe9",
                                                "sense_id": "4488e04e-922b-30e5-a266-b6777bd04dad",
                                                "text": "The water sprayed out of the hose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b32181f-a625-33df-b86b-8f1cfaf4c2e7",
                                        "entry_id": "366b20d8-df24-3d79-a0d9-272d58b762b0",
                                        "glosses": [
                                            "To project many small items dispersively."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f178262-58ea-4b12-abf2-b5851d6729c0",
                                                "sense_id": "4b32181f-a625-33df-b86b-8f1cfaf4c2e7",
                                                "text": "The sprawl of sheds like Magna Parks 1 to 3 are a particularly vivid measure, because they host the final moment of relative stasis for millions of products that are then sprayed out to homes in every direction."
                                            },
                                            {
                                                "example_id": "61d80b70-9629-4eaf-a7db-5c4398a11800",
                                                "sense_id": "4b32181f-a625-33df-b86b-8f1cfaf4c2e7",
                                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5d05ad8-b46f-3c38-83f6-de5134a71026",
                                        "entry_id": "366b20d8-df24-3d79-a0d9-272d58b762b0",
                                        "glosses": [
                                            "To urinate in order to mark territory."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7fd3a25-4b90-3767-af38-4ef940697d89",
                                        "entry_id": "366b20d8-df24-3d79-a0d9-272d58b762b0",
                                        "glosses": [
                                            "To allocate blocks of memory from (a heap, etc.), and fill them with the same byte sequence, hoping to establish that sequence in a certain predetermined location as part of an exploit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e27be2e-4cf9-49d3-a81f-157150a4809c",
                                                "sense_id": "d7fd3a25-4b90-3767-af38-4ef940697d89",
                                                "text": "to spray the heap of a target process"
                                            },
                                            {
                                                "example_id": "64d887a5-6b9c-4cda-a6ca-75538676d79d",
                                                "sense_id": "d7fd3a25-4b90-3767-af38-4ef940697d89",
                                                "text": "This approach would be altered for an optimal omelette based exploit. One would spray the heap with the omelette code solely, then load a single copy of the additional shellcode eggs into memory outside the target region for the spray."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf940787-0e41-34e9-b86e-b285c411994a",
                                        "entry_id": "366b20d8-df24-3d79-a0d9-272d58b762b0",
                                        "glosses": [
                                            "To pass (a ball), usually laterally across the field and often a long distance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7f7d50c-d649-41ea-8c16-ca1a96d17291",
                                                "sense_id": "bf940787-0e41-34e9-b86e-b285c411994a",
                                                "text": "Kevin McLeod sprayed the ball across from the left flank where a raging Ainsworth met it on the volley from 25 yards out, crashing the ball into the roof of the net."
                                            },
                                            {
                                                "example_id": "81e891b0-ff56-4505-8802-9a9d076f34ad",
                                                "sense_id": "bf940787-0e41-34e9-b86e-b285c411994a",
                                                "text": "Yunus sprayed it to the wing where Ali was in some space."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e978336b-6167-3a51-b4f3-e94325fbb8fa",
                                        "entry_id": "366b20d8-df24-3d79-a0d9-272d58b762b0",
                                        "glosses": [
                                            "To kick (a ball) poorly and in an unintended direction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42e891be-ca89-4161-9f01-8dbe72bf9794",
                                                "sense_id": "e978336b-6167-3a51-b4f3-e94325fbb8fa",
                                                "text": "Despite a goal to Vin Gardiner for Carlton, courtesy of an infringement, the Blues squandered many opportunities in attack. They sprayed the ball with their field kicking, and in their path toward goal."
                                            },
                                            {
                                                "example_id": "0424473c-9d69-425d-9a4d-0f49777c75fa",
                                                "sense_id": "e978336b-6167-3a51-b4f3-e94325fbb8fa",
                                                "text": "But once again their forwards, including Sloss, sprayed the ball in front of goal and squandered their momentum by kicking a solitary goal and six careless behinds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01b61d3b-a15f-3bd4-9e0e-4e46b1ea2a4e",
                                        "entry_id": "366b20d8-df24-3d79-a0d9-272d58b762b0",
                                        "glosses": [
                                            "To give unwanted advice."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3f11a99-7ca3-3076-b27b-b8f198eba5ae",
                                        "entry_id": "366b20d8-df24-3d79-a0d9-272d58b762b0",
                                        "glosses": [
                                            "To shower guests dancing at a function with money"
                                        ],
                                        "tags": [
                                            "Nigeria"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b24b4d-3009-4352-b840-ec98c816497b",
                                                "sense_id": "c3f11a99-7ca3-3076-b27b-b8f198eba5ae",
                                                "text": "“If a celebrator is dancing and you spray him/her, you may go to jail from the party venue because the law enforcement agents will be there, waiting to arrest you."
                                            },
                                            {
                                                "example_id": "781341af-840d-4934-a1fa-c194a279c247",
                                                "sense_id": "c3f11a99-7ca3-3076-b27b-b8f198eba5ae",
                                                "text": "Politicians have been known to spray crowds with cash. There is a cottage industry of vendors offering fresh banknotes to partygoers looking to spray their hosts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95a9f2c0-18fb-3ced-b231-2ac23a906959",
                                        "entry_id": "1bf910f0-9c25-34f8-9d72-174be720ce0f",
                                        "glosses": [
                                            "A small branch of flowers or berries."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6291766-52d5-47f3-8101-42e3397ebcc6",
                                                "sense_id": "95a9f2c0-18fb-3ced-b231-2ac23a906959",
                                                "text": "The bridesmaid carried a spray of lily-of-the-valley."
                                            },
                                            {
                                                "example_id": "7d6d1502-700c-432b-8d21-8a5ff39c2189",
                                                "sense_id": "95a9f2c0-18fb-3ced-b231-2ac23a906959",
                                                "text": "O Nightingale, that on yon bloomy ſpray / Warbleſt at eve, when all the woods are ſtill, / Thou with freſh hope the lover’s heart doſt fill, / While the jolly hours lead on propitious May."
                                            },
                                            {
                                                "example_id": "592b5ed3-adb4-4347-9f44-982a819418b0",
                                                "sense_id": "95a9f2c0-18fb-3ced-b231-2ac23a906959",
                                                "text": "The painted Birds, Companions of the Spring, / Hopping from Spray to Spray, were heard to ſing ; / Both Eyes and Ears receiv’d a like Delight, / Enchanting Muſick, and a charming Sight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5822a3f-91dc-376e-8614-b00c602ea294",
                                        "entry_id": "1bf910f0-9c25-34f8-9d72-174be720ce0f",
                                        "glosses": [
                                            "A collective body of small branches."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cef5dfeb-e1a8-4cdd-95eb-bfc8e2431f6f",
                                                "sense_id": "d5822a3f-91dc-376e-8614-b00c602ea294",
                                                "text": "The tree has a beautiful spray."
                                            },
                                            {
                                                "example_id": "e3fdb0fa-3695-4a61-a66f-cc55f9e9dbf4",
                                                "sense_id": "d5822a3f-91dc-376e-8614-b00c602ea294",
                                                "text": "A blisful flour, owt of this spray schal springe ; / The fruyt þer-of schal be ful precïous ; / A causë haue [we] for to ioye & synge, / In honure of þat maidë gracïous, / That gret comfort schal cause[n] vnto vs ; / ffor now schal faste oure company encrees, / And god with man schal makë smallë pees.",
                                                "translation": "A blissful flower out will spring out of this spray; / Its fruit shall be very precious; / We have cause for joy and song, / In honour of that gracious maid, / Who will make us very comfortable; / for now our company will grow quickly, / And man will make peace with God.",
                                                "english": "A blissful flower out will spring out of this spray; / Its fruit shall be very precious; / We have cause for joy and song, / In honour of that gracious maid, / Who will make us very comfortable; / for now our company will grow quickly, / And man will make peace with God."
                                            },
                                            {
                                                "example_id": "4b17c2d6-47db-4fe4-8fdd-8e353a722ecd",
                                                "sense_id": "d5822a3f-91dc-376e-8614-b00c602ea294",
                                                "text": "And from the Trees did lop the needless Spray;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d60d451-2a92-3db3-8da3-eeba8a86c7c3",
                                        "entry_id": "1bf910f0-9c25-34f8-9d72-174be720ce0f",
                                        "glosses": [
                                            "Branches and twigs collectively; foliage."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58069337-e9da-43ec-ac37-502a0749f602",
                                                "sense_id": "6d60d451-2a92-3db3-8da3-eeba8a86c7c3",
                                                "text": "Gret fur he made þer aniȝt of wode & of sprai.",
                                                "translation": "There, at night, he made a great box out of wood and spray.",
                                                "english": "There, at night, he made a great box out of wood and spray."
                                            },
                                            {
                                                "example_id": "9f839887-feed-4ad9-b6e3-cd3594dccab3",
                                                "sense_id": "6d60d451-2a92-3db3-8da3-eeba8a86c7c3",
                                                "text": "Troubled, 'wilder'd, and forlorn, / Dark, benighted, travel-worn, / Over many a tangled spray, / All heart-broke I heard her say"
                                            },
                                            {
                                                "example_id": "29df6977-59d4-4309-ba80-11bf87eaff85",
                                                "sense_id": "6d60d451-2a92-3db3-8da3-eeba8a86c7c3",
                                                "text": "The pea, being a tendrilled climber, whenever it is to be cultivated to the greatest advantage, ought to be supported by pea sticks, which are branches of trees or shrubs well furnished with spray, and of lengths suited to the height to which the plants grow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8008153a-e88e-3a47-8f65-666fa5b0ec36",
                                        "entry_id": "1bf910f0-9c25-34f8-9d72-174be720ce0f",
                                        "glosses": [
                                            "An orchard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d48718d-a7af-35ee-80cd-ac067568de1e",
                                        "entry_id": "1bf910f0-9c25-34f8-9d72-174be720ce0f",
                                        "glosses": [
                                            "An ornament or design that resembles a branch."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
