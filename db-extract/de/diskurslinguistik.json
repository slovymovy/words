                    {
                        "sense_id": "313516a2-7360-3f15-82fa-cb11431e49b6",
                        "entry_id": "cfd34ff5-f251-3de5-ba1b-d1800c43cb2e",
                        "glosses": [
                            "Untersuchung der spezifischen linguistischen Bedingungen, die einen Diskurs ausmachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bebdf6-8b38-4a37-bf83-f2ca67316828",
                                "sense_id": "313516a2-7360-3f15-82fa-cb11431e49b6",
                                "text": "„Die Diskurslinguistik als relativ neue Teildisziplin der germanistischen Linguistik beschäftigt sich mit der Frage, wie soziale Wiklichkeiten in transtextuell organisierten Einheiten konstruiert werden.“"
                            },
                            {
                                "example_id": "a996df36-7975-4b86-8416-43ed03a602da",
                                "sense_id": "313516a2-7360-3f15-82fa-cb11431e49b6",
                                "text": "„Tatsächlich spielt die Netzmetapher als Denkfigur eine große Rolle gerade in denjenigen Ansätzen der Diskurslinguistik, die sich dem Gegenstand primär aus der textlinguistischen Perspektive und damit über die Beobachtung von Intertextualität nähern.“"
                            },
                            {
                                "example_id": "07cdf8ff-9c0a-4601-81db-5a6f428e3618",
                                "sense_id": "313516a2-7360-3f15-82fa-cb11431e49b6",
                                "text": "„Ist das Reich der Diskurslingustik ein unübersichtlicher Flickenteppich?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
