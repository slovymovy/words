                                "target_senses": [
                                    {
                                        "sense_id": "2c117828-8f1c-36c2-b745-959fa21b226f",
                                        "entry_id": "c90459ac-d3f3-305b-aa9b-6b8d8e911fb8",
                                        "glosses": [
                                            "Balaeniceps rex een vogel uit de familie Balaenicipitidae. Het is het enige lid van deze familie. Deze vogel heeft een grijs verenkleed. Dankzij zijn brede bek kan hij makkelijk vis vangen (scheppen) in het troebele water. De lichaamslengte bedraagt 110 tot 140 cm en het gewicht 5,5 tot 6,5 kg"
                                        ],
                                        "tags": [
                                            "roeipotigen"
                                        ],
