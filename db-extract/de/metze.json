                "senses": [
                    {
                        "sense_id": "20d40f54-c383-3c55-90b2-699d700038a3",
                        "entry_id": "d5025297-f7ee-3026-a821-750eda1f0b5f",
                        "glosses": [
                            "historisches Hohlmaß insbesondere für Getreide, mit regional sehr unterschiedlicher Größe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9064e902-cb07-4e53-a956-84418637ad0c",
                                "sense_id": "20d40f54-c383-3c55-90b2-699d700038a3",
                                "text": "„Die Production von Hülsenfrüchten im Kammerbezirke betrug im Jahre 1859 83.200 Metzen […].“"
                            },
                            {
                                "example_id": "1cc12dff-59ad-4bc2-af32-5d5a29820faa",
                                "sense_id": "20d40f54-c383-3c55-90b2-699d700038a3",
                                "text": "„Lai-an ging und kam nach einiger Zeit mit einem halben gepökelten Schinken, zwei Kuchen, zwei Metzen Hirse und zwei eingelegten Gurken wieder.“"
                            },
                            {
                                "example_id": "c99ae2d3-f2c6-40ba-8a84-860b3acec839",
                                "sense_id": "20d40f54-c383-3c55-90b2-699d700038a3",
                                "text": "„Zwei Tage hindurch schleppte er Korn, und am dritten Tag lernte er mit Dreschflegel und Metze umgehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
