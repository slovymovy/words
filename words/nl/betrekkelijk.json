                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relative",
                                "target_lang_sense_clarification": "grammatical term"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4d9789c6-5d69-3093-b72d-e38fcd0de0e3",
                    "sense_definition": "in een zekere mate maar niet extreem",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "graad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die winkel zijn de meeste artikelen <w>betrekkelijk</w> goedkoop vergeleken met de concurrentie.",
                            "target_lang_translations": {
                                "en": "In that shop, most items are <w>relatively</w> cheap compared to the competition."
                            }
