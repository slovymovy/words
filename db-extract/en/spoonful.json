                                                "sense_id": "2ac5cba6-8ce7-35b8-9024-10138fc41d43",
                                                "text": "Až bude salát hotový, nakonec přidej lžíci olivového oleje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0784c397-ad80-3e96-896b-4846ebc97419",
                                        "entry_id": "2011c7a2-b92b-3b7c-93fe-1d164cd56cb5",
                                        "glosses": [
                                            "nástroj nebo součást stroje ve tvaru lžíce"
