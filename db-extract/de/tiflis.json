                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28e7aad2-a3dd-471c-9b5e-030be3882a9e",
                                                "sense_id": "14363989-d93a-37d8-b7cb-71525ed5ec06",
                                                "text": "Jestem w więzieniu w Tbilisi z przyczyny, której nie znam."
                                            },
                                            {
                                                "example_id": "5bf4f7c2-615b-4fba-aa30-6feb5c549a1e",
                                                "sense_id": "14363989-d93a-37d8-b7cb-71525ed5ec06",
                                                "text": "Co najmniej trzy osoby zginęły w wyniku potężnego wybuchu na przedmieściach Tbilisi."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b69455c3-2794-4743-9566-d3c85e1b6071",
                        "source_entry_id": "72a6c181-0134-3b92-8535-f413b3c97aa9",
                        "source_sense_id": "64739c82-c4a3-3057-b139-e21af6def660",
                        "source_sense_description": "Hauptstadt von Georgien",
                        "target_lang_word": "Тбилиси",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Тбилиси",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9da6b69c-a3e0-395f-b20a-7e5487f6d997",
                                        "entry_id": "2a9ed50b-fd13-33c5-91fa-5254f3d4fa5c",
                                        "glosses": [
                                            "город в Закавказье, столица Грузии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "293a7b0c-6d81-4c48-be2e-1153b5e99eed",
                                                "sense_id": "9da6b69c-a3e0-395f-b20a-7e5487f6d997",
                                                "text": "И вдруг совсем недавно в Тбилиси перед ним на столе появился точно такой же кувшинчик из той же крепкой красной глины, и в сопровождении первого секретаря вошёл самый настоящий дядя Шалва ― такой же усатый, быстроглазый, жульковатый, как в те годы, и лет ему было примерно столько же."
                                            },
                                            {
                                                "example_id": "ecf21170-4a06-48e2-8184-c908bd3fcd0f",
                                                "sense_id": "9da6b69c-a3e0-395f-b20a-7e5487f6d997",
                                                "text": "В восьмидесятые годы я был на гастролях в Тбилиси."
                                            },
                                            {
                                                "example_id": "275c1d68-1cfd-4385-a99c-199a0df838e0",
                                                "sense_id": "9da6b69c-a3e0-395f-b20a-7e5487f6d997",
                                                "text": "Анжелика, девчушка двух лет, заболела внезапно, когда жила в Тбилиси."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
