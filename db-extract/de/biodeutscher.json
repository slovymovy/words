                "senses": [
                    {
                        "sense_id": "cec0b66f-a49d-3daf-8b42-2966aed98a97",
                        "entry_id": "873586ad-f2a0-38e3-bc2b-ca8d75e8fef0",
                        "glosses": [
                            "autochthonous German"
                        ],
                        "tags": [
                            "adjectival",
                            "informal",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "c13355db-80bb-47dc-8748-84e55775aced",
                                "sense_id": "cec0b66f-a49d-3daf-8b42-2966aed98a97",
                                "text": "Wir sind heute angesichts von Wahlbeteiligungen von teilweise unter 50 Prozent dankbar für jede Wählerin, für jeden Wähler. Egal ob Biodeutscher, Beutedeutscher oder Namibiadeutscher, der immer noch glaubt, dass es noch einen Kaiser gibt: […]"
                            },
                            {
                                "example_id": "e3493ac9-27cf-4e64-918e-640accb7901b",
                                "sense_id": "cec0b66f-a49d-3daf-8b42-2966aed98a97",
                                "text": "Und dass die Herrschaften von rechts gerne eine völkische Demokratie hätten, in der Biodeutsche, bevorzugt Männer, das Sagen haben, ist auch klar. Dass es dann aber keine Demokratie mehr wäre, das wissen wir natürlich."
                            }
                        ]
                    }
