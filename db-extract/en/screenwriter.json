                                                "example_id": "d2bda6ec-a51b-442f-8ed8-6602b41f3182",
                                                "sense_id": "d98b3df7-9871-340d-a99d-813d3a30979a",
                                                "text": "Dramaturg, scénárista, režisér a herec pořadu Karel Pech tu z počátku platil do jisté míry daň tomu, že pro pořad vybojoval maximálně výhodný vysílací čas, tj. sobotní večer."
                                            },
                                            {
                                                "example_id": "3320100d-d1f8-49a8-a05b-70e7c168fb9e",
                                                "sense_id": "d98b3df7-9871-340d-a99d-813d3a30979a",
                                                "text": "Od roku 1989 se věnuje především publicistice, příležitostně píše literaturu pro děti a spolupracuje jako scénárista s filmem a rozhlasem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
