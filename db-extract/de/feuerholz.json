                "senses": [
                    {
                        "sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
                        "entry_id": "ad27fbd7-7c9d-3083-ab1a-93eb4640d54c",
                        "glosses": [
                            "Holz, das zum Heizen oder Kochen genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edfbe573-91c2-4976-9a42-1238ea2e5ae5",
                                "sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
                                "text": "Das Feuerholz aus dem Wald ist noch nass und muss erst getrocknet werden."
                            },
                            {
                                "example_id": "b04ce935-d4c0-47b2-8604-c4a95a3c15ad",
                                "sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
                                "text": "„Als wir Feuerholz suchten, entdeckten wir eine Wegkreuzung und menschliche Spuren, die vielleicht acht Tage alt waren.“"
                            },
                            {
                                "example_id": "7f1d4850-a1f1-4505-bc36-518c7f5fe06e",
                                "sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
                                "text": "„Er brauchte Unmengen Feuerholz und den Rest des Tages pendelte Brian zwischen dem Lagerplatz und dem Wald hin und her, um genug Äste heranzuschleppen.“"
                            },
                            {
                                "example_id": "20ba31cf-733e-44d9-a0c2-d30413dba7c2",
                                "sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
                                "text": "„Er war gerade dabei, Feuerholz zu sammeln, als er sah, wie sie aus Maria Antonownas Haus und über die schneebedeckte Straße in Richtung Wald schoss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b05ba8d1-8514-4c95-86f0-065441cae6e7",
                        "source_entry_id": "ad27fbd7-7c9d-3083-ab1a-93eb4640d54c",
                        "source_sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
