                            "comment": "used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Weird, strange, or suspicious.",
                        "ru": "Странный, необычный или подозрительный.",
                        "zh": "指奇怪、古怪或可疑的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sketchy",
                                "target_lang_sense_clarification": "informal; implying something is suspicious or unsafe"
                            },
                            {
                                "target_lang_word": "shady",
                                "target_lang_sense_clarification": "suspicious or of doubtful honesty"
                            },
                            {
                                "target_lang_word": "weird",
                                "target_lang_sense_clarification": "strange or odd"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мутный",
