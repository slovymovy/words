                                "sense_id": "a7b6cf71-3d12-3519-92a5-b0c499f5fbaa",
                                "text": "Пусть посмеётся над королём, как наш Тиль Уленшпигель!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4f5c36d-ecc1-405a-9dd3-7077d13bb568",
                        "source_entry_id": "7f17e277-d3f9-3f97-a9bf-fa67b2b56dcf",
                        "source_sense_id": "a7b6cf71-3d12-3519-92a5-b0c499f5fbaa",
                        "target_lang_word": "Thiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4f46239-4d8b-3fb3-8bcc-288a0dbfb928",
                                        "entry_id": "65165819-64ae-39b2-bdfc-507a59a5961c",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname; Vorkommen in Deutschland fast flächendeckend, größte Dichte westlich des Mittelrheins, im südlichen Niederrhein-Gebiet und im südlichen Westfalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c2369a1-d54c-4183-b1b2-d148921ea515",
                                                "sense_id": "a4f46239-4d8b-3fb3-8bcc-288a0dbfb928",
                                                "text": "„Thiel fühlte ein Grauen und, je näher der Zug kam, eine umso größere Angst.“"
                                            },
                                            {
                                                "example_id": "5931c2d1-1a64-4cac-bb49-4185f2499fb6",
                                                "sense_id": "a4f46239-4d8b-3fb3-8bcc-288a0dbfb928",
                                                "text": "Frau Thiel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "0b528e6f-dc7a-440f-9771-85593746b106",
                                                "sense_id": "a4f46239-4d8b-3fb3-8bcc-288a0dbfb928",
                                                "text": "Herr Thiel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "70c7f4da-e22f-4c5a-b74f-3aeb827d4973",
                                                "sense_id": "a4f46239-4d8b-3fb3-8bcc-288a0dbfb928",
                                                "text": "Die Thiels kommen heute von der Mosel."
                                            },
                                            {
                                                "example_id": "b375ab74-65d1-4c35-bc82-e345f95598e7",
                                                "sense_id": "a4f46239-4d8b-3fb3-8bcc-288a0dbfb928",
                                                "text": "Der Thiel trägt nie die Schals, die die Thiel ihm strickt."
                                            },
                                            {
                                                "example_id": "10228956-25d2-4d6d-b816-5b9d7f27748d",
                                                "sense_id": "a4f46239-4d8b-3fb3-8bcc-288a0dbfb928",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Thiel kommt, geht der Herr Thiel.“"
                                            },
                                            {
                                                "example_id": "3ea2f0d9-b5a6-42df-b187-ab8713af23af",
                                                "sense_id": "a4f46239-4d8b-3fb3-8bcc-288a0dbfb928",
                                                "text": "Thiel kommt und geht."
                                            },
                                            {
                                                "example_id": "74bfde04-61f5-46f3-a824-87885d81c0af",
                                                "sense_id": "a4f46239-4d8b-3fb3-8bcc-288a0dbfb928",
                                                "text": "Thiels kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "092aa4bd-a841-4b34-b165-57acdce35ec0",
                                                "sense_id": "a4f46239-4d8b-3fb3-8bcc-288a0dbfb928",
                                                "text": "An verregneten Herbsttagen ist Familie Thiels liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "3d06b74b-dec2-4eaa-b8b3-0ed636a63761",
                                                "sense_id": "a4f46239-4d8b-3fb3-8bcc-288a0dbfb928",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Thiel das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
