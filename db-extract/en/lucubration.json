                                    {
                                        "sense_id": "badc16a3-9020-3c91-b1f5-7033c5565283",
                                        "entry_id": "69491886-21d5-35d3-ba83-e9a1104159dd",
                                        "glosses": [
                                            "die wissenschaftliche Arbeit bei Nacht"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a42add4e-c100-4f70-a959-f93819b301e4",
                                                "sense_id": "badc16a3-9020-3c91-b1f5-7033c5565283",
                                                "text": "„Spät und verstört schliefen wir ein, und ein unerfreuliches Erwachen trug noch die Spuren der unseligen Lukubration!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
