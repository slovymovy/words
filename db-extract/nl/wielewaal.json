                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc639245-b700-4e7f-8e69-f9692ef26030",
                                                "sense_id": "f7f92360-5cf5-3e96-a0b5-946471fe2d47",
                                                "text": "Im tiefen 20. Jahrhundert machte im DDR-Fernsehen ein Minol-Pirol Werbung für Treib- und Schmierstoffe."
                                            }
