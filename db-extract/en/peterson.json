                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e988a08f-81a6-482a-8a7d-bacc36f485ff",
                                                "sense_id": "70f71507-3b5a-3905-b5a7-9c30d353e586",
                                                "text": "Накануне финала старший тренер сборной России Глеб Петров, который вернулся в большое плавание спустя десятилетие и первенство в Берлине, по собственному признанию, воспринимает как «очень интересную экскурсию», поделился со спецкором «Известий» мнением: «Финал расставит всех в итоговом протоколе по тем строчкам, которых они заслуживают»."
                                            },
                                            {
                                                "example_id": "7d056099-f1b7-41b6-a250-26e6a17ff795",
                                                "sense_id": "70f71507-3b5a-3905-b5a7-9c30d353e586",
                                                "text": "Из города исчезает память о великих одесситах ― Бабеле, Багрицком, Катаеве, Ильфе, Петрове."
                                            },
                                            {
                                                "example_id": "70e3c86b-e025-4cdc-8a43-26ddcab0a3ef",
                                                "sense_id": "70f71507-3b5a-3905-b5a7-9c30d353e586",
                                                "text": "С некоторых пор мне стало казаться, что Рязанов — это искусный повар, создавший из будничных ингредиентов что-то диковинное и потрясающее воображение. Уверен, дай другому режиссеру красавицу-Фрейндлих, умницу-Мягкова, гения-Петрова, и он бы не оправдал надежд."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Петро́в",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "136e7aa4-24b6-3fe4-8f1c-b28d48f87168",
                                        "entry_id": "bbbeeeb9-0588-3492-9a0b-4080980eb347",
                                        "glosses": [
                                            "принадлежащий Петру, свойственный Петру и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa4e444-d10b-402e-8804-d6ef4956a94d",
                                                "sense_id": "136e7aa4-24b6-3fe4-8f1c-b28d48f87168",
                                                "text": "Петров день."
                                            },
                                            {
                                                "example_id": "443e216c-dc3b-433f-b57e-2e09cbd2928e",
                                                "sense_id": "136e7aa4-24b6-3fe4-8f1c-b28d48f87168",
                                                "text": "Иначе, нынешний закат Петрова города станет и крушением всего Петрова дела, закатом России."
                                            }
                                        ]
                                    }
                                ]
