                        "entry_id": "9c0aca2c-3826-35bd-a007-ca9c28e1481a",
                        "glosses": [
                            "fragment biblijnych Trenów Jeremiasza wykonywany podczas liturgii chrześcijańskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69a023c0-50ce-4d40-8364-d9261172ea07",
                                "sense_id": "0f7d7924-f852-32e0-85fe-e614d15cbac2",
                                "text": "Biblijne Lamentacje, których autorstwo tradycja przypisuje Jeremiaszowi, opłakują zburzenie Jerozolimy przez Nabuchodonozora i zniewolenie przez niego ludu Izraela"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
