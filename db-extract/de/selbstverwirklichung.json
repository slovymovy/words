                        ],
                        "form": "die Selbstverwirklichung"
                    },
                    {
                        "form_id": "20de4747-bb1c-4ad3-a657-7ba832edee1d",
                        "entry_id": "c2f745a9-26a8-3116-826c-7c0f22810ba9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Selbstverwirklichungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                        "entry_id": "c2f745a9-26a8-3116-826c-7c0f22810ba9",
                        "glosses": [
                            "Realisierung der Vorstellungen, die jemand von sich selbst und seinen Möglichkeiten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a49e8285-862d-4e72-8840-82676c0e2fdd",
                                "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                                "text": "„Die Selbstverwirklichung des sowjetischen Menschen, sein politisches Engagement und sein Befreiungskampf fanden ausschließlich jenseits der eigenen Heimat statt.“"
                            },
                            {
                                "example_id": "403c7d08-1473-44e2-bf8b-f4bf999941ba",
                                "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                                "text": "Die Idee der Selbstverwirklichung zählt zu den zentralen Werten der westlichen Moderne."
                            },
                            {
                                "example_id": "9f65b409-5274-4731-b942-aa403f87a882",
                                "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                                "text": "Selbstverwirklichung - ein Schlag- oder eigentlich schon Modewort, das von esoterisch angehauchten Hausfrauen bis zu dynamischen Jungunternehmern immer wieder gerne benutzt wird."
                            },
                            {
                                "example_id": "fc1ac090-5d3c-4abe-8415-00ae94e2834e",
                                "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                                "text": "Andere streben die Selbstverwirklichung im Beruf an, so dass sie es nicht nötig haben, außerberuflichen Aktivitäten als den eigentlich interessanten Tätigkeiten nachzugehen."
                            },
                            {
                                "example_id": "0a26e0ab-c3b2-4e39-b325-c04179ba8a50",
                                "sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                                "text": "„Das Lebensgefühl der westlichen Welt oder, genauer gesagt, des nicht mehr ganz so Wilden Westens drückt sich in der Suche nach Freiheit und Selbstverwirklichung aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb206985-12f3-4d33-bf2d-8b35cad73ac0",
                        "source_entry_id": "c2f745a9-26a8-3116-826c-7c0f22810ba9",
                        "source_sense_id": "67d070a2-59c4-3f77-8899-cbc50059bce9",
                        "source_sense_description": "Realisierung der Vorstellungen, die jemand von sich selbst und seinen Möglichkeiten hat",
                        "target_lang_word": "self-actualization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-actualization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "393eb468-7ebb-3644-b5cb-ce1e1893e9f8",
                                        "entry_id": "955d2d5e-e2c9-3c2b-8ad3-d39aa7e58dd9",
                                        "glosses": [
                                            "Psychological development that can be achieved when all basic and mental needs are fulfilled."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd5fe2bf-4da9-447f-91e1-30b5e79f57e7",
                                                "sense_id": "393eb468-7ebb-3644-b5cb-ce1e1893e9f8",
                                                "text": "This is not an exercise in self-actualization at other people's expense. That's what you've been doing up until now. This is about acknowledging your faults to the people you've hurt without hurting them more."
                                            },
                                            {
                                                "example_id": "aa23a1a9-f599-43b7-bc2d-e4692f71a929",
                                                "sense_id": "393eb468-7ebb-3644-b5cb-ce1e1893e9f8",
                                                "text": "The pursuit of individual autonomy or “self-actualisation”, for example, has become mired in an identity politics that subsumes the individual into rigidly defined groupings based on ethnicity, gender or sexuality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
