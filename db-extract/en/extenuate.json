                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b0e926-73b1-4401-b6fb-926609303b7f",
                                                "sense_id": "0c1f730e-f9b5-34b0-9610-e3e4c84b87b5",
                                                "text": "Hij verdunde de oplossing tienvoudig."
                                            }
