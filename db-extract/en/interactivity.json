                                        "entry_id": "cda7f0b7-f804-33ac-a07c-b5c148dd89ee",
                                        "glosses": [
                                            "Capacité d’interagir avec quelque chose, en particulier l'accès à l'information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccf145bd-58c4-4b78-bb4f-b1488a4bef6a",
                                                "sense_id": "f2af28fd-ace8-3777-9591-9e62980e3873",
                                                "text": "La ludologie mise quant à elle sur les mécaniques de gameplay pour faire passer les messages. L’interactivité est riche, mais peut-être s'opère-t-elle au détriment de la qualité de l'interprétation du message."
                                            }
                                        ]
                                    }
                                ]
