                ],
                "senses": [
                    {
                        "sense_id": "52c55918-35db-3a29-9e8f-ad0c8eae6943",
                        "entry_id": "ea68404d-6270-3073-a314-f6644bcdcd6a",
                        "glosses": [
                            "jüdischer Gelehrter, der sich in den heiligen Schriften auskannte, neuerdings auch übertragen auf muslimische Gelehrte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97629caa-217a-42f5-b3d1-71cd5431de75",
                                "sense_id": "52c55918-35db-3a29-9e8f-ad0c8eae6943",
                                "text": "„Weh euch, Schriftgelehrte und Pharisäer, ihr Heuchler, die ihr das Himmelreich zuschließet vor den Menschen! Ihr kommt nicht hinein, und die hinein wollen, laßt ihr nicht hineingehen.“"
                            },
                            {
                                "example_id": "b8db49d4-5a5f-429a-bfc7-dd97202e9cc9",
                                "sense_id": "52c55918-35db-3a29-9e8f-ad0c8eae6943",
                                "text": "„Doch nicht nur sie ist eine gefährliche Konkurrenz für die talmudischen Schriftgelehrten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c99312a9-7e21-304e-8032-09c125a611bd",
                        "entry_id": "ea68404d-6270-3073-a314-f6644bcdcd6a",
                        "glosses": [
                            "Person, die schreiben und lesen konnte, in einer Zeit, in der diese Kenntnisse nur wenigen vorbehalten waren, und die aufgrund dieser Fähigkeiten oft eine Rolle im öffentlichen Leben spielte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05486c12-dde9-4046-8821-3b2fb73a52a7",
                                "sense_id": "c99312a9-7e21-304e-8032-09c125a611bd",
                                "text": "„Infolgedessen galten die zwei Schriftsprachen, nämlich Elamisch im Südwesten des Iran und Aramäisch, das zunächst die Lingua franca im assyrisch-babylonischen Gebiet und dann Verkehrssprache im gesamten Reich war, lange Zeit nur als Medium der Schriftgelehrten.“"
                            },
                            {
                                "example_id": "ffdd9198-ecab-4d05-a8d5-744e21fd7b7e",
                                "sense_id": "c99312a9-7e21-304e-8032-09c125a611bd",
                                "text": "„Schriftgelehrter im historischen Sinn ist eine Person, die die Schrift praktiziert.“"
                            },
                            {
                                "example_id": "de3a1c20-99b3-432d-b8b2-69e8d2be0bf3",
                                "sense_id": "c99312a9-7e21-304e-8032-09c125a611bd",
                                "text": "„Die Schriftgelehrten schrieben auf Stein, auf Holz, auf Leder und natürlich auf dem berühmten Papyrus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a928fcd0-b955-4d74-8e57-7d8c23606fad",
                        "source_entry_id": "ea68404d-6270-3073-a314-f6644bcdcd6a",
                        "source_sense_id": "52c55918-35db-3a29-9e8f-ad0c8eae6943",
                        "target_lang_word": "scribe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scribe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d1eac3d-8521-3192-a812-ff5edca39955",
                                        "entry_id": "68b3fbff-ff78-3ad2-a1d9-966153464565",
                                        "glosses": [
                                            "Copiste, homme employé à faire des écritures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65faad88-5ade-4dd7-9200-65f9da5b4c76",
                                                "sense_id": "7d1eac3d-8521-3192-a812-ff5edca39955",
                                                "text": "Chez les Juifs on donnait ce nom à des espèces de docteurs qui se divisaient en trois classes : les scribes du sanhédrin, qui n’étaient que des greffiers de ce tribunal; les scribes de la loi, dont les décisions étaient exécutées à l’égal de la loi elle-même, et les scribes du peuple, véritables magistrats prononçant des sentences dans les affaires privées et contre les coupables de délits."
                                            },
                                            {
                                                "example_id": "7a1594d7-120e-41bd-b745-9ac2a0cba442",
                                                "sense_id": "7d1eac3d-8521-3192-a812-ff5edca39955",
                                                "text": "Mais une fois établis les principes de la comptabilité, n’importe quel scribe s'en serait tiré au moins aussi bien que moi."
                                            },
                                            {
                                                "example_id": "34a0db59-cb04-4360-a1b2-85229726c10b",
                                                "sense_id": "7d1eac3d-8521-3192-a812-ff5edca39955",
                                                "text": "Ces vieillards de quarante à cinquante ans, tous réservistes, certains anciens combattants de la Première Guerre Mondiale, avaient été, malgré les \"macarons\" de pilote qu’ils arboraient fièrement, maintenus pendant toute la guerre dans des fonctions \"de rampants\", popotiers, scribes, chefs de bureau, en dépit des promesses de mise à l’entraînement aérien toujours renouvelées et jamais tenues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9425401f-0acb-3551-956d-b29a26203538",
                                        "entry_id": "68b3fbff-ff78-3ad2-a1d9-966153464565",
                                        "glosses": [
                                            "Docteur qui enseignait la loi de Moïse au peuple et qui l’interprétait."
                                        ],
                                        "tags": [
                                            "Antiquité judaïque"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a4ef3be-fcc5-423c-9534-c6176f5c696c",
                                                "sense_id": "9425401f-0acb-3551-956d-b29a26203538",
                                                "text": "Les scribes et les pharisiens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
