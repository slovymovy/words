                "senses": [
                    {
                        "sense_id": "cfe5d068-4366-344b-a54f-3caf54e0c659",
                        "entry_id": "4b9c888a-a784-3ecf-bf60-e7c6d21c01b7",
                        "glosses": [
                            "Traité à l’eau de Javel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b5da83b-c883-4969-98a3-721bab796969",
                                "sense_id": "cfe5d068-4366-344b-a54f-3caf54e0c659",
                                "text": "12 juin 43 – Le soir venu, nous sommes si laides et si vannées, maman et moi, que nous ne savons que le rester et dînons la mèche en bataille et les mains javellisées, sans même essayer de rectifier notre apparence."
                            },
                            {
                                "example_id": "730165fe-b59e-4342-a3ff-094bdb3b1b8f",
                                "sense_id": "cfe5d068-4366-344b-a54f-3caf54e0c659",
                                "text": "On ne le voyait jamais, mais on devinait sa présence à cause de cette odeur de chiottes javellisées qui lui collait à la peau et du bruit que faisait la machine à écrire sur laquelle il marteau-piquait ses cours et ses livres politiques à longueur de vie. — (Gaël Faye, Petit Pays, Grasset, 2016, page 86)"
                            }
                        ]
                    }
