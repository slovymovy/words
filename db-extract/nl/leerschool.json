                                    {
                                        "sense_id": "a5396b7c-e23d-3838-aba7-0fa24f6b08d7",
                                        "entry_id": "2303605d-f46e-30b7-af71-2ace2cc3fda8",
                                        "glosses": [
                                            "An institution dedicated to teaching and learning; an educational institution."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30d765eb-1bf5-43b6-942a-6b45ba4c07ee",
                                                "sense_id": "a5396b7c-e23d-3838-aba7-0fa24f6b08d7",
                                                "text": "Our children attend a public school in our neighborhood."
                                            },
                                            {
                                                "example_id": "712fed9a-5e94-495f-b3c2-928b72e22ecd",
                                                "sense_id": "a5396b7c-e23d-3838-aba7-0fa24f6b08d7",
                                                "text": "Harvard University is a famous American postsecondary school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6958d8e-c604-3371-9393-146f0e3232da",
                                        "entry_id": "2303605d-f46e-30b7-af71-2ace2cc3fda8",
                                        "glosses": [
                                            "An educational institution providing primary and secondary education, prior to tertiary education (college or university)."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbfbb99c-09ea-4b34-a56d-99586abfb69b",
                                                "sense_id": "c6958d8e-c604-3371-9393-146f0e3232da",
                                                "text": "One particularly damaging, but often ignored, effect of conflict on education is the proliferation of attacks on schools[…]as children, teachers or school buildings become the targets of attacks. Parents fear sending their children to school. Girls are particularly vulnerable to sexual violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c5c0434-893a-315b-a77e-211610f3b74a",
                                        "entry_id": "2303605d-f46e-30b7-af71-2ace2cc3fda8",
                                        "glosses": [
                                            "At Eton College, a period or session of teaching."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78303bfc-ca12-477b-8beb-eb55fa3abefa",
                                                "sense_id": "2c5c0434-893a-315b-a77e-211610f3b74a",
                                                "text": "Divinity, history and geography are studied for two schools per week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63d2a3bd-696b-35eb-8655-b8ebdfd269b9",
                                        "entry_id": "2303605d-f46e-30b7-af71-2ace2cc3fda8",
                                        "glosses": [
                                            "Within a larger educational institution, an organizational unit, such as a department or institute, which is dedicated to a specific subject area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9301756a-25f5-4b59-b5b3-1dabeefd499f",
                                                "sense_id": "63d2a3bd-696b-35eb-8655-b8ebdfd269b9",
                                                "text": "We are enrolled in the same university, but I attend the School of Economics and my brother is in the School of Music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c92a8364-5843-3db6-80c8-72e368eebeb1",
                                        "entry_id": "2303605d-f46e-30b7-af71-2ace2cc3fda8",
                                        "glosses": [
                                            "An art movement, a community of artists."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fd4cd45-a90d-4618-a335-bc30cdcd55c4",
                                                "sense_id": "c92a8364-5843-3db6-80c8-72e368eebeb1",
                                                "text": "The Barbizon school of painters were part of an art movement towards Realism in art, which arose in the context of the dominant Romantic movement of the time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e3b5284-a3c8-3d03-880d-14de7e8308ac",
                                        "entry_id": "2303605d-f46e-30b7-af71-2ace2cc3fda8",
                                        "glosses": [
                                            "The followers of a particular doctrine; a particular way of thinking or particular doctrine; a school of thought."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d1c5454-7dee-4011-bc92-faa2d0862791",
                                                "sense_id": "2e3b5284-a3c8-3d03-880d-14de7e8308ac",
                                                "text": "These economists belong to the monetarist school."
                                            },
                                            {
                                                "example_id": "6fde1a83-8268-4169-ac2b-b5e68c823bbf",
                                                "sense_id": "2e3b5284-a3c8-3d03-880d-14de7e8308ac",
                                                "text": "Let no man be leſſe confident in his holy faith […] by reason of any difference of judgement vvhich is in the ſeveral Schools of Chriſtians concerning the effects and conſequent bleſſings of this Sacrament."
                                            },
                                            {
                                                "example_id": "2ebd6d95-8a0d-4f80-b186-3d8289dac945",
                                                "sense_id": "2e3b5284-a3c8-3d03-880d-14de7e8308ac",
                                                "text": "Here the stripped panelling was warmly gold and the pictures, mostly of the English school, were mellow and gentle in the afternoon light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72eaa46c-deb7-3c19-b75e-2ae7673a9367",
                                        "entry_id": "2303605d-f46e-30b7-af71-2ace2cc3fda8",
                                        "glosses": [
                                            "The time during which classes are attended or in session in an educational institution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c549e87-1cf5-4d1e-a2da-5dda5b051e52",
                                                "sense_id": "72eaa46c-deb7-3c19-b75e-2ae7673a9367",
                                                "text": "I’ll see you after school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c5f0924-bcba-39b5-b372-b6a1457b8575",
                                        "entry_id": "2303605d-f46e-30b7-af71-2ace2cc3fda8",
                                        "glosses": [
                                            "The room or hall in English universities where the examinations for degrees and honours are held."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e493486-f194-3941-8185-6e4574970e45",
                                        "entry_id": "2303605d-f46e-30b7-af71-2ace2cc3fda8",
                                        "glosses": [
                                            "The canons, precepts, or body of opinion or practice, sanctioned by the authority of a particular class or age."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0ac009d-5d7a-45ef-9c9a-ecce3d92ee78",
                                                "sense_id": "9e493486-f194-3941-8185-6e4574970e45",
                                                "text": "He was a gentleman of the old school."
                                            },
                                            {
                                                "example_id": "95f62c3a-4805-458e-b4ab-ef84567d6a4a",
                                                "sense_id": "9e493486-f194-3941-8185-6e4574970e45",
                                                "text": "His face pale but striking, though not handsome after the schools."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f8d305-1806-33d1-80fd-79d85b6e8039",
