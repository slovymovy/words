        "fr-extract.jsonl": [
            {
                "entry_id": "6657e544-b7ab-3c36-9b5f-cf37cee15245",
                "word": "emplâtre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "008b9f26-f505-4fa8-9f5c-77e2dc01503c",
                        "entry_id": "6657e544-b7ab-3c36-9b5f-cf37cee15245",
                        "tags": [
                            "plural"
                        ],
                        "form": "emplâtres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e18f752-ed2f-3905-a242-4bcf991e00b7",
                        "entry_id": "6657e544-b7ab-3c36-9b5f-cf37cee15245",
                        "glosses": [
                            "Médicament solide et glutineux, qui se ramollit par la chaleur et qu'on applique sur telle ou telle partie du corps, après l’avoir étendu sur de la toile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5924c2c-ab61-4f5b-81f6-6c5ff251632c",
                                "sense_id": "2e18f752-ed2f-3905-a242-4bcf991e00b7",
                                "text": "Me voici de nouveau dans mon lit, le corps couvert d’emplâtres qui me brûlent."
                            },
                            {
                                "example_id": "7c0ef9ba-e423-4fa5-b184-710f91c73028",
                                "sense_id": "2e18f752-ed2f-3905-a242-4bcf991e00b7",
                                "text": "Le traitement par l’obturation canulaire et l'application de l’emplâtre vinrent à bout assez rapidement de la sténose spasmodique, qui, se joignant à la sténose vraie, se produisait quand on décanulait cette enfant."
                            },
                            {
                                "example_id": "45298500-d8dd-4d64-979e-4de7834a18f3",
                                "sense_id": "2e18f752-ed2f-3905-a242-4bcf991e00b7",
                                "text": "[…] la « petite », fendue au genou, pelée au coude, saignait tranquillement sous des emplâtres de toiles d’araignée et de poivre moulu, liés d’herbes rubanées…"
                            },
                            {
                                "example_id": "b2b75594-bb03-4af4-9d1e-ec95c8efc379",
                                "sense_id": "2e18f752-ed2f-3905-a242-4bcf991e00b7",
                                "text": "Et mon emplâtre bourré d'asticots? J'ai pu aller à la pêche pendant des mois!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c6cd426f-3a42-3618-a4b5-7507819abad3",
                        "entry_id": "6657e544-b7ab-3c36-9b5f-cf37cee15245",
                        "glosses": [
                            "Maçonnerie appliquée à un mur pour le consolider."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "f5393418-38d9-4824-b2ad-833410c05de6",
                                "sense_id": "c6cd426f-3a42-3618-a4b5-7507819abad3",
                                "text": "Quantité de jours, de fenêtres ont été bouchés pour empêcher l’écroulement ; sur la droite, de haut en bas, on a plaqué un énorme emplâtre de maçonnerie, cela est piteux."
                            }
                        ]
                    },
                    {
                        "sense_id": "26cf12c8-78bf-3238-b234-361f059f4ec7",
                        "entry_id": "6657e544-b7ab-3c36-9b5f-cf37cee15245",
                        "glosses": [
                            "Personne qui n’a aucune vigueur d’esprit, qui est incapable d’agir comme il convient, qui ne fait qu’apporter de l’embarras dans les affaires dont elle se mêle."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3b4e40f6-4b2a-4e26-8bb3-1aa4656fc22b",
                                "sense_id": "26cf12c8-78bf-3238-b234-361f059f4ec7",
                                "text": "C’est un pauvre emplâtre. Quel emplâtre que cet homme-là !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b97bbb88-7457-316b-bc3b-a2983c6f5433",
                        "entry_id": "6657e544-b7ab-3c36-9b5f-cf37cee15245",
                        "glosses": [
                            "Coup porté en se battant."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4ac25756-6ef8-42c8-8b38-b169e1b1caa3",
                                "sense_id": "b97bbb88-7457-316b-bc3b-a2983c6f5433",
                                "text": "Et l’inconnue pleura\nComme on pleure au théâtre\nEn voyant des pantins\nSe foutre des emplâtres."
                            }
                        ]
                    },
                    {
                        "sense_id": "302f34a2-a865-3fba-85d4-b6e2aee4e208",
                        "entry_id": "6657e544-b7ab-3c36-9b5f-cf37cee15245",
                        "glosses": [
                            "Englumen utilisé pour accélérer la cicatrisation des arbres."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dd4d5ec1-98df-3207-ae16-487db7e5d77b",
                        "entry_id": "6657e544-b7ab-3c36-9b5f-cf37cee15245",
                        "glosses": [
                            "Pièce que l'on colle sur une chambre à air pour boucher un trou, rustine."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
