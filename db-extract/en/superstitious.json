                                            {
                                                "example_id": "fe9ab8b2-161a-401f-8545-0a7d01d0a210",
                                                "sense_id": "fac5bbd7-a7ff-39f6-98d2-1dd73d345080",
                                                "text": "De bijgelovige man durfde bijna niet meer over straat uit angst voor zwarte katten en ladders."
