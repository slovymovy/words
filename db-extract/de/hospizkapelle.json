                "senses": [
                    {
                        "sense_id": "d0b43d0d-181b-3d70-838c-4c9b8b2539eb",
                        "entry_id": "b6107be4-a7f4-3731-83aa-9d32530397a3",
                        "glosses": [
                            "einfach gestalteter Kapellenbau oder abgeteilter Bereich in einem Hospiz, der für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ba6e644-d883-41b9-90a4-451b80dc78b3",
                                "sense_id": "d0b43d0d-181b-3d70-838c-4c9b8b2539eb",
                                "text": "„Der Bilderfries in der Hospizkapelle will uns helfen auf dem vielleicht letzten, entscheidenden Abschnitt unseres Lebensweges, bei der Beantwortung der letzten Fragen, die uns bedrängen.“"
                            },
                            {
                                "example_id": "0760abf2-2d3b-4291-9fd4-4022020399c7",
                                "sense_id": "d0b43d0d-181b-3d70-838c-4c9b8b2539eb",
                                "text": "„Die heilige Messe wurde in der Hospizkapelle vom Bischof Paweł Stobrawa verrichtet.“"
                            },
                            {
                                "example_id": "c07be6ff-346b-42d8-9b80-946e95b12a11",
                                "sense_id": "d0b43d0d-181b-3d70-838c-4c9b8b2539eb",
                                "text": "„Hochmeister Erzherzog Eugen finanzierte unter anderem auch die beiden Seitenaltäre der Hospizkapelle.“"
                            },
                            {
                                "example_id": "de28d579-7903-492a-8fed-65d950ce481f",
                                "sense_id": "d0b43d0d-181b-3d70-838c-4c9b8b2539eb",
                                "text": "„Die Kapelle aus dem 15. Jahrhundert ist dem heiligen Nikolaus gewidmet und war lange eine Hospizkapelle.“"
                            },
                            {
                                "example_id": "152d260d-5031-4093-8ea7-f08719433311",
                                "sense_id": "d0b43d0d-181b-3d70-838c-4c9b8b2539eb",
                                "text": "„Der Salzburger Erzbischof Dr. Alois Kothgasser feierte am 2. Juni in unserer Hospizkapelle einen Dank- und Festgottesdienst, zu dem wir auch den Präsidenten der Österreichischen Gesellschaft vom Hl. Land, unserem Freundeskreis, Dr. Gustav Ortner willkommen heißen durften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
