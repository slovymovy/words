                                    {
                                        "sense_id": "cbd6b5b6-afad-30c0-92a4-c4deacaa9500",
                                        "entry_id": "af06a98b-7fbe-3708-b9ef-8b72b71d9acf",
                                        "glosses": [
                                            "Person, die einen Brand absichtlich oder fahrlässig verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2def5a-029b-4807-a4d4-f50112fe77a7",
                                                "sense_id": "cbd6b5b6-afad-30c0-92a4-c4deacaa9500",
                                                "text": "Die Behörden gehen davon aus, dass die Brandstifter aus der rechten Szene stammen."
                                            },
                                            {
                                                "example_id": "19469e3b-1220-44e8-b81b-e95aef9b1577",
                                                "sense_id": "cbd6b5b6-afad-30c0-92a4-c4deacaa9500",
                                                "text": "„Durch unglückliche Umstände kommt der Wastl jedoch selbst in den Verdacht, der Brandstifter zu sein.“"
                                            },
                                            {
                                                "example_id": "ae5f0317-ff97-4f53-aaf8-3538082d9542",
                                                "sense_id": "cbd6b5b6-afad-30c0-92a4-c4deacaa9500",
                                                "text": "„Was die Jurisdiktion angeht, so brannte nach der Hinrichtung der angeblichen Brandstifter auch noch die andere Hälfte von Moskau ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bfcaf5b-ad6c-47fe-b918-d220d46c45a7",
