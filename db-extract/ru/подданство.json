                        "target_lang_word": "Staatsangehörigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staatsangehörigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4988f43d-35e3-3373-b678-91935a60bfee",
                                        "entry_id": "21546c04-9883-363d-abe9-8ef305eb3844",
                                        "glosses": [
                                            "Eigenschaft, Bürger eines bestimmten Staates zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67ce3708-b0af-4935-986d-665c7a5c6d02",
                                                "sense_id": "4988f43d-35e3-3373-b678-91935a60bfee",
                                                "text": "„In Amerika wissen wir vieles nicht, aber wir verstehen immerhin, dass Staatsangehörigkeit nichts mit Herkunft zu tun hat.“"
                                            },
                                            {
                                                "example_id": "00d05dba-974d-45e8-9a72-1ed89a7daf56",
                                                "sense_id": "4988f43d-35e3-3373-b678-91935a60bfee",
                                                "text": "„Komplexer als der ausschließlich an der Staatsangehörigkeit orientierte Ausländerbegriff ist das Konzept der »Personen mit Migrationshintergrund«.“"
                                            },
                                            {
                                                "example_id": "4a6f88c7-6ce3-422c-b74d-634b05e47ddf",
                                                "sense_id": "4988f43d-35e3-3373-b678-91935a60bfee",
                                                "text": "„Der Schulbesuch wurde abgebrochen, die deutsche Staatsangehörigkeit aufgegeben, die Verbindung zur israelischen Religionsgemeinschaft gelöst.“"
                                            },
                                            {
                                                "example_id": "6afb87b9-be49-4d3e-965f-1ca4c32cbc2b",
                                                "sense_id": "4988f43d-35e3-3373-b678-91935a60bfee",
                                                "text": "„Man habe ihr aus humanitären Gründen sofort die französische Staatsangehörigkeit verliehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
