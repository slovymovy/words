                                "example_id": "cc4c403d-81d8-4c34-b862-6d3056a1aaf5",
                                "sense_id": "b9e5e34f-276b-3e73-bf5e-f66302230abd",
                                "text": "„Beim ersten Anzeichen von Kratzgeräuschen wird er von hier verschwinden, so schnell er kann.“"
                            },
                            {
                                "example_id": "885ba463-15fe-46d7-931d-f336d4132c71",
                                "sense_id": "b9e5e34f-276b-3e73-bf5e-f66302230abd",
                                "text": "„Der Federkiel verursacht ein schwaches Kratzgeräusch auf dem Papier, dann fast ein Quietschen, als die Feder plötzlich in einem Ruck rückwärts geführt wird, um ein Wort durchzustreichen.“"
                            }
