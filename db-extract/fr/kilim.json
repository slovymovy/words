                        "sense_id": "66fde2a4-54fc-3412-9e61-3f39a082763e",
                        "entry_id": "9bd9347e-bc15-3643-896a-e746eb1d89f0",
                        "glosses": [
                            "Tapis d’Orient à motifs géométriques, dépourvu de velours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9afbbaf-562f-4fcc-b47a-1d561e2edc10",
                                "sense_id": "66fde2a4-54fc-3412-9e61-3f39a082763e",
                                "text": "Il est superbe ton kilim ! Tu l’as acheté où ?"
                            },
                            {
                                "example_id": "f043ec02-87cc-4a23-b51f-e93d1634b50a",
                                "sense_id": "66fde2a4-54fc-3412-9e61-3f39a082763e",
                                "text": "Emma porte son choix sur un kilim turc, tapis tissé et non noué, de laine à point plat, aux motifs géométriques hérités des croyances chamaniques et utilisés autrefois sur le sol ou les murs des mosquées ou des yourtes."
                            },
                            {
                                "example_id": "39c8724d-38b4-4899-9b20-57472be70bd4",
                                "sense_id": "66fde2a4-54fc-3412-9e61-3f39a082763e",
                                "text": "Un bouchon et deux couvercles avaient atterri on ne sait comment sur le kilim."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38b32bda-da82-4509-98aa-2994968cc9c2",
                        "source_entry_id": "9bd9347e-bc15-3643-896a-e746eb1d89f0",
