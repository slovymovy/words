                                                "example_id": "d038c467-fbe7-4c3a-a6ef-7e46e4397d23",
                                                "sense_id": "106e3097-78a7-35ea-a4a1-e712d091c031",
                                                "text": "明朝和清朝是篆刻艺术的两段黄金时期。"
                                            }
                                        ]
                                    }
                                ]
                            },
