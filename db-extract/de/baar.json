                        "entry_id": "f88b36b5-a9e6-38ec-ac81-85549dd6b6ea",
                        "glosses": [
                            "südwestdeutsche Hochebene oder Hochmulde zwischen dem Schwarzwald im Westen und der Schwäbischen Alb im Osten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa7bddc1-a3d0-43d3-bc59-28ba55c20e03",
                                "sense_id": "f3d1cee2-2b03-3c07-bcf2-e14438a513ba",
                                "text": "Die Hochebene der Baar liegt im Regenschatten des Schwarzwaldes und weist deswegen ein kontinental geprägtes Klima auf."
                            },
                            {
                                "example_id": "4e9c3d47-81bf-4616-a34c-339a5da778c3",
                                "sense_id": "f3d1cee2-2b03-3c07-bcf2-e14438a513ba",
                                "text": "Auf der hügeligen Hochebene der Baar liegt im Schwenninger Moos das Quellgebiet des Neckars. (Quelle: nach Wikipedia, Artikel Baar)"
                            }
                        ],
                        "sense_index_json": "\"1\""
