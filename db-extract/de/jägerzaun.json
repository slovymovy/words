                "senses": [
                    {
                        "sense_id": "14694761-e370-35b7-b506-18e7a3e5165d",
                        "entry_id": "970f8d8e-01e9-32b5-9ce0-187b0177fae9",
                        "glosses": [
                            "Holzzaun aus zugespitzten Latten, die über Kreuz angeordnet sind und ein Rautenmuster bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2868a225-71ac-4cdc-a0c8-7c10fbaf9d72",
                                "sense_id": "14694761-e370-35b7-b506-18e7a3e5165d",
                                "text": "Jägerzäune sind einfach zu bauen, aber trotzdem stabil."
                            },
                            {
                                "example_id": "8703b1d2-5dd1-4458-8cf2-915cb71f4177",
                                "sense_id": "14694761-e370-35b7-b506-18e7a3e5165d",
                                "text": "„Ein Jägerzaun schloß den großen, völlig verwilderten Garten ein.“"
                            },
                            {
                                "example_id": "4253b3f5-30b9-44a7-a359-2c9b348e78a3",
                                "sense_id": "14694761-e370-35b7-b506-18e7a3e5165d",
                                "text": "„Der deutsche Hobbygärtner liebt ordentliche Begrenzungen. Schnurgerade Jägerzäune, glatt rasierte Thujenhecken, pflegeleichte Gabionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
