                        "glosses": [
                            "das durch Fotomontage^([1]) entstandene Bild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b6e601-627f-486d-bc72-6776f8f9b445",
                                "sense_id": "50c6c7fc-4a5f-3fb1-85b0-968e86f25adf",
                                "text": "Das muss eine Fotomontage sein. Aus dieser Pespektive kann man dieses Motiv gar nicht aufnehmen!"
                            }
                        ],
                        "sense_index_json": "\"2\""
