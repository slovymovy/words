                "senses": [
                    {
                        "sense_id": "c31045b7-b308-3a45-92e9-00cf4ee58c82",
                        "entry_id": "78bd294f-feaa-3397-972b-9f9a6a6b46dd",
                        "glosses": [
                            "Recorriger encore une nouvelle fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3c2e8f4-8a7e-477a-8c2b-39d7d9e5df4d",
                                "sense_id": "c31045b7-b308-3a45-92e9-00cf4ee58c82",
                                "text": "D’autre part, il faut bien compter trois mois pour relire, faire copier, re-recorriger la copie et faire imprimer."
                            },
                            {
                                "example_id": "d2b49fc1-ba18-426d-a9ad-4ce4022b5e20",
                                "sense_id": "c31045b7-b308-3a45-92e9-00cf4ee58c82",
                                "text": "Je l’ai tellement corrigé, recorriger, re-recorrigé, que je n’en pouvais plus et j’ai ignoré ces conseils."
                            }
                        ]
                    }
