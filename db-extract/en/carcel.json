                "senses": [
                    {
                        "sense_id": "f7d8af5c-b63e-36bf-a4a3-16ea2b3c4401",
                        "entry_id": "38add1e2-f2d7-310c-837b-e7049a2db958",
                        "glosses": [
                            "A former unit to measure the intensity of light, approximately 9.74 candelas."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d5a45c7e-8e1f-4e89-b5d3-d6307762a65e",
                                "sense_id": "f7d8af5c-b63e-36bf-a4a3-16ea2b3c4401",
                                "text": "Desroziers in a series of experiments obtained as much as 250 carcel spherical luminous value per horse-power; this characteristic is one likely to be of great value in electric lighting by incandescence of high intensity."
                            },
                            {
                                "example_id": "b30674c0-233b-4d14-ad13-200109fe19d6",
                                "sense_id": "f7d8af5c-b63e-36bf-a4a3-16ea2b3c4401",
                                "text": "When experimenting in Paris with a No. 3 lamp in a vertical direction, it showed a consumption of 34.6 liters (1.2 cubic feet) per carcel obtained."
                            },
                            {
                                "example_id": "9a77aa66-2b82-4e5c-b6e5-49fee3d4acd6",
                                "sense_id": "f7d8af5c-b63e-36bf-a4a3-16ea2b3c4401",
                                "text": "In all systems of lighting, save electricity, the unit of light is the carcel."
                            }
                        ]
                    }
                ],
