                                "sense_id": "535cc515-4789-3416-9162-f9f82e649b9a",
                                "text": "влива́ть му́жество (реши́мость) (в)",
                                "translation": "instill courage (resolution) (in, into)",
                                "english": "instill courage (resolution) (in, into)"
                            }
