                        "examples": [
                            {
                                "example_id": "fbd68659-23af-4c0b-9606-6fb627a82960",
                                "sense_id": "ec10bdc0-3d5d-3395-b991-5f4784eb3d14",
                                "text": "Beim „Poi-Spiel“ wird üblicherweise in jeder Hand ein Poi durch Ausnutzung der Zentrifugalkraft in abwechslungsreichen, kreisähnlichen Bahnen um den Körper geschwungen."
                            }
