                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ebcfd3e-275b-4b66-87ff-81e98009fd6f",
                                                "sense_id": "70792e9b-6178-39a0-abc2-53461c077ab4",
