                    {
                        "sense_id": "109569ae-e905-33cb-9d34-01bbeb8b3463",
                        "entry_id": "c6ce6b27-d5cb-3415-a672-5cdfce469fa1",
                        "glosses": [
                            "van zilver gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25046c08-b7d7-47b7-aa2a-ee15ac9bb783",
                                "sense_id": "109569ae-e905-33cb-9d34-01bbeb8b3463",
                                "text": "De zilveren hanger was niet zo veel waard omdat die machinaal gemaakt was."
                            },
                            {
                                "example_id": "2c63827c-40a4-4fbc-99dc-94a2d26f44f1",
                                "sense_id": "109569ae-e905-33cb-9d34-01bbeb8b3463",
                                "text": "Natuurlijk had ik Clio onderschat. In plaats van de deur open te doen in verhuis-T-shirt en joggingbroek verscheen zij, alsof ze wist dat dit haar eerste opkomst zou zijn in mijn boek, als een vrouw die weet hoe zij haar entree moet maken, in een spectaculair kort zwart jurkje van Elsa Schiaparelli, dat was afgezet met een bloemmotief van witte glaskraaltjes en een wufte kraag van witte raffia, met daarbij zwarte open schoenen met een hoge hak van Fendi en lange, hangende, zilveren oorbellen van Gucci."
                            },
                            {
                                "example_id": "c975e956-8f1c-4170-b87c-cd9414ec6375",
                                "sense_id": "109569ae-e905-33cb-9d34-01bbeb8b3463",
                                "text": "Er was weinig tot geen beschutting tegen de bloedhete zon en ik klapte al snel mijn zilveren paraplu uit."
                            }
                        ]
                    },
                    {
                        "sense_id": "57d069e9-2783-3c65-b781-801266360f7e",
                        "entry_id": "c6ce6b27-d5cb-3415-a672-5cdfce469fa1",
                        "glosses": [
                            "een tweede plaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3866bf-8ffc-4591-bcc8-d9dcec01db17",
                                "sense_id": "57d069e9-2783-3c65-b781-801266360f7e",
                                "text": "Bij de Olympische Spelen heeft hij een zilveren medaille behaald."
                            }
                        ]
                    },
                    {
                        "sense_id": "d03a888a-ac08-3c68-b327-f008966ec4a9",
                        "entry_id": "c6ce6b27-d5cb-3415-a672-5cdfce469fa1",
                        "glosses": [
                            "25 jaar gehuwd zijn."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0f93518-37b3-4179-94dd-f90c60314eea",
                                "sense_id": "d03a888a-ac08-3c68-b327-f008966ec4a9",
                                "text": "Mijn ouders gaven een groot feest op hun zilveren bruiloft."
                            }
                        ]
                    }
