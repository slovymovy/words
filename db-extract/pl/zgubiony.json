                ],
                "senses": [
                    {
                        "sense_id": "7147318f-a8aa-3cc5-8224-fa96545690b8",
                        "entry_id": "ebd344b6-a317-3610-84ba-134fbe142883",
                        "glosses": [
                            "który poniósł klęskę, który jest bliski zguby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5784da2-1095-48ec-bf3e-2d4b78860ab4",
                                "sense_id": "7147318f-a8aa-3cc5-8224-fa96545690b8",
                                "text": "Że Henryk Jakubowski zmarł, to dobrze zrobił, od kilku lat już był zgubiony, a nawet obłąkaniem swym niebezpieczny"
                            },
                            {
                                "example_id": "56495512-b65b-4002-b439-73a6c1e31765",
                                "sense_id": "7147318f-a8aa-3cc5-8224-fa96545690b8",
                                "text": "(…) wierzysz w prawdę, jesteś zbawiony; jeśli wierzysz w kłamstwo, jesteś zgubiony"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9bd6555e-8d92-3d83-83eb-4df8b782ef1f",
                        "entry_id": "ebd344b6-a317-3610-84ba-134fbe142883",
                        "glosses": [
                            "zaginiony; taki, którego ktoś zgubił"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "030afe3b-be4b-4939-bc99-5581b5351c51",
                                "sense_id": "9bd6555e-8d92-3d83-83eb-4df8b782ef1f",
                                "text": "Natomiast ciążyła na nim odpowiedzialność osobista za zgubione książki, za które miał zwracać pełną wartość, względnie mógł mu uniwersytet potrącić odpowiednią kwotę z uposażenia"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8012bd3-0571-4bd7-b633-0aaf2c89e5ea",
                        "source_entry_id": "ebd344b6-a317-3610-84ba-134fbe142883",
