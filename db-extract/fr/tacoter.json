                "senses": [
                    {
                        "sense_id": "e1189f4a-a8bd-3e29-80a4-f7add393ddb3",
                        "entry_id": "1b2f5c43-9fb0-3c02-9dc0-b9554283d538",
                        "glosses": [
                            "Tapoter."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "f9fa1f34-1978-4d04-9e18-1225ab3e9437",
                                "sense_id": "e1189f4a-a8bd-3e29-80a4-f7add393ddb3",
                                "text": "On ne trouve jamais rien, et pourtant les fellaghas viennent de temps en temps le soir nous « tacoter » pour nous montrer qu’ils sont là."
                            },
                            {
                                "example_id": "06ed65ee-e75d-47ed-b1a4-36f2deac4709",
                                "sense_id": "e1189f4a-a8bd-3e29-80a4-f7add393ddb3",
                                "text": "Les machines se mirent bientôt à tacoter, je me souviens que la mienne s’arrêta cent quarante-cinq fois dans une nuit, ce qui me permit de faire moins de mille cartouches."
                            }
                        ]
                    },
