                        "examples": [
                            {
                                "example_id": "5df5fbf3-752b-4b09-816d-7ae2c37a0457",
                                "sense_id": "42940437-7eef-33b3-83ed-03c7b9999531",
                                "text": "Now euery lowt muſt haue his ſonne a Courtnoll,and thoſe dunghill dꝛudges ware ſo pꝛoud,that they wil pꝛeſume to wear on their feet,what kings haue woꝛne on their heades."
                            },
                            {
                                "example_id": "c6fd063d-701e-4a7a-89f2-e098537cbc73",
                                "sense_id": "42940437-7eef-33b3-83ed-03c7b9999531",
                                "text": "\"Heere,\" quoth the Miller, \"good fellowe, Ile drinke to thee\n& to all the courtnolls that curteous bee.\"\n\"I pledge thee,\" quoth our King, \"& thanke thee heartilye for my good welcome in euerye degree ;\n& heere in like manner I drinke to thy sonne.\"\n\"doe then,\" saies Richard, \"& quicke let it come.\""
                            }
                        ]
