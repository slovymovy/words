                "translations": [
                    {
                        "translation_id": "9e041084-abd1-425e-8345-3207f9491b72",
                        "source_entry_id": "dc078f69-a0fc-3444-93fd-d9ded559f0d0",
                        "source_sense_id": "cb371ded-b544-3f90-a9e3-8058f19d7ebf",
                        "target_lang_word": "originality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "originality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a7b4184-2fcd-3a04-b3cb-d2bd251ab82a",
                                        "entry_id": "fc94f515-1fb9-3ba4-9dd2-aa54737e7ac0",
                                        "glosses": [
                                            "The quality of being original or novel."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18889f8a-040d-42ee-9135-4f20523f6fad",
                                                "sense_id": "8a7b4184-2fcd-3a04-b3cb-d2bd251ab82a",
                                                "text": "The space at my disposal does not permit me to go into Mr. Bulleid's paper in detail, but it is impossible to refrain from an expression of admiration at the originality that has been packed into this outstanding design."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e1b7d6b-fc6a-3768-b49c-33f58df18440",
                                        "entry_id": "fc94f515-1fb9-3ba4-9dd2-aa54737e7ac0",
                                        "glosses": [
                                            "The capacity to think independently or be inventive."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25633869-3179-4770-b5e3-20a3acfc48d6",
                                                "sense_id": "5e1b7d6b-fc6a-3768-b49c-33f58df18440",
                                                "text": "Originality may be the capacity to look at the same facts and see new explanations."
                                            },
                                            {
                                                "example_id": "11d4af71-45f8-4ddb-9d5d-75c76923337d",
                                                "sense_id": "5e1b7d6b-fc6a-3768-b49c-33f58df18440",
                                                "text": "This story of how American originality lost its way is arresting and well told. On an alternate timeline without Donald Trump in office dismantling the American scientific establishment and Elon Musk kneecapping the American state, it might have been the manifesto of a new politics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95e9f6dc-115c-32bb-8afe-86f042126b6e",
                                        "entry_id": "fc94f515-1fb9-3ba4-9dd2-aa54737e7ac0",
                                        "glosses": [
                                            "Something original."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "355a5af5-b0f4-4a7f-bf80-c3d2e2e1168d",
                                                "sense_id": "95e9f6dc-115c-32bb-8afe-86f042126b6e",
                                                "text": "This houses a waiting room and gentlemen's toilets which, despite some new sanitary fittings in early BR days, fell out of use over 40 years ago, becoming dilapidated - and so remained as the only room on the station to retain its originality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa78c764-9376-3fba-9612-8b668b7dbb24",
                                        "entry_id": "fc94f515-1fb9-3ba4-9dd2-aa54737e7ac0",
                                        "glosses": [
                                            "The original state or condition of a thing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b3c90ce-2a5f-4a2d-ad73-05f70f33c584",
                                                "sense_id": "aa78c764-9376-3fba-9612-8b668b7dbb24",
                                                "text": "Church Street has been reclaimed from vendors who had encroached every bit of pedestrian walk. BBMP evicted more than 70 of them and restored to its originality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
