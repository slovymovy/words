                ],
                "senses": [
                    {
                        "sense_id": "4823711a-0c1b-3408-afbe-c6d6b3fec72f",
                        "entry_id": "141cb13b-d89b-3f8e-949e-4c97a7c7097b",
                        "glosses": [
                            "Bactérie à gram négatif, longue et enroulée en hélice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d28a501-b348-42d5-bec4-1d3539d5f4bb",
                                "sense_id": "4823711a-0c1b-3408-afbe-c6d6b3fec72f",
                                "text": "Il existe dans le Sud marocain (de Marrakech à Goulimine et Tata) un spirochète du mérion (Borrelia merionesi) transmis par la petite variété d’Ornithodorus erraticus."
                            },
                            {
                                "example_id": "c3c0884e-c312-4647-94bd-e5fbdcc8a35d",
                                "sense_id": "4823711a-0c1b-3408-afbe-c6d6b3fec72f",
                                "text": "La cellule du spirochète est construite d’une façon unique et qui rend obscure sa relation phylogénétique avec les autres bactéries."
                            },
                            {
                                "example_id": "8411a1b7-fd5a-4236-ae4e-ecf1c0517ce9",
                                "sense_id": "4823711a-0c1b-3408-afbe-c6d6b3fec72f",
                                "text": "Il avait l’impression que des millions de microbes glaireux, de bacilles hémoptysiques, de spirochètes muqueux, de pneumocoques catarrheux, s’abattaient sur lui comme les urubus sur la poubelle."
                            }
                        ]
                    }
                ],
