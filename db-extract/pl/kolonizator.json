                                "target_senses": [
                                    {
                                        "sense_id": "2da205ba-c9b4-302c-bd65-cc6610dc18c4",
                                        "entry_id": "fe2ddeb1-e0f6-373e-9112-d00232bf8f9f",
                                        "glosses": [
                                            "One who colonizes:",
                                            "One who makes a group or place into a colony; one who establishes a colonial relationship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2e02ed4-6a92-39f9-93e4-21d7dfdffb9f",
                                        "entry_id": "fe2ddeb1-e0f6-373e-9112-d00232bf8f9f",
                                        "glosses": [
                                            "One who colonizes:",
                                            "One who establishes a colony; one who joins a colony or is born and raised there."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d3fd0ec-a169-3bf5-857c-882c689fe83a",
                                        "entry_id": "fe2ddeb1-e0f6-373e-9112-d00232bf8f9f",
                                        "glosses": [
                                            "One who colonizes:",
                                            "One who intrudes and takes over."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7be552a-d1c3-3049-91e6-fd6f443b1b4f",
                                        "entry_id": "fe2ddeb1-e0f6-373e-9112-d00232bf8f9f",
                                        "glosses": [
                                            "A species that establishes itself in a new area."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4844d302-f27f-3402-8337-190aa10786f2",
                                        "entry_id": "fe2ddeb1-e0f6-373e-9112-d00232bf8f9f",
                                        "glosses": [
                                            "A white person."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "derogatory",
                                            "neologism",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8c3d18f-0712-46fa-9f44-040129f43080",
                                                "sense_id": "4844d302-f27f-3402-8337-190aa10786f2",
                                                "text": "Don't scare me like that, colonizer!"
                                            },
                                            {
                                                "example_id": "2ec5b356-96dd-47e2-94ad-c1acdf289ed0",
                                                "sense_id": "4844d302-f27f-3402-8337-190aa10786f2",
                                                "text": "\"Howard University is supposed to be a safe space for black people and we don't need you colonizers infiltrating it,\" said Charlemagne, radio personality and the co-host of The Breakfast Club."
                                            },
                                            {
                                                "example_id": "86af2a89-f917-47ac-a7bc-5dc7da05be19",
                                                "sense_id": "4844d302-f27f-3402-8337-190aa10786f2",
                                                "text": "\"Disgusted isn't even close to a word for it,\" they wrote. \"How?? how is this okay?? she was a REAL LITTLE GIRL — to do this her, to us, over and over again… i am just at a loss. disgusting. does she not deserve rest? reclamation? honor? you colonizers make me vom,\" she wrote."
                                            },
                                            {
                                                "example_id": "45bdb450-d916-4ec5-b393-f0f15777e8b7",
                                                "sense_id": "4844d302-f27f-3402-8337-190aa10786f2",
                                                "text": "Jokes and memes about colonizers' bland-ass food resonate, and not because of their originality or comedic genius; implicit in those quips is a declaration of allegiance with people whose ancestral lands were once plundered by colonial powers for spices and other riches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca9481a8-546e-41bd-8df0-42295998243d",
                        "source_entry_id": "c9ea285b-0447-3e9b-af6f-823226817ef3",
                        "source_sense_id": "40bc43d0-5fc7-3cf1-bab7-dfa3dc5797c4",
                        "target_lang_word": "colonisateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colonisateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deaeb35c-072b-3657-ae57-5e63d3314429",
                                        "entry_id": "854ce657-6d8e-3683-84dc-5c81ecee0f50",
                                        "glosses": [
                                            "Qui colonise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f151090-0a57-49d9-939b-fc4cdeebd9bb",
                                                "sense_id": "deaeb35c-072b-3657-ae57-5e63d3314429",
                                                "text": "Notons tout de suite que, de même que les diverses plantes n’ont pas le même pouvoir colonisateur, de même elles réagissent différemment devant les obstacles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "colonisateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a652e58-0049-33ed-812d-246ce21b7619",
                                        "entry_id": "993b1552-7dbd-3907-9bf1-ebfce5b07de5",
                                        "glosses": [
                                            "Celui qui colonise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81a6f376-cec2-440d-9fa7-38c617746f2f",
                                                "sense_id": "3a652e58-0049-33ed-812d-246ce21b7619",
                                                "text": "Présentées de la sorte, les tares de la colonisation pouvaient-elles faire horreur au colonisateur ? Pouvaient-elles l’interroger au point de le faire douter de lui-même ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
