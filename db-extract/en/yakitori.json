                                "sense_id": "fa12ee98-738d-3847-ae17-ee8ef8e45666",
                                "text": "Friday night on Ninsei. He passed yakitori stands and massage parlors, a franchised coffee shop called Beautiful Girl, the electronic thunder of an arcade."
                            },
                            {
                                "example_id": "04b3cb96-4733-414d-b2d7-79bfd076e6c9",
                                "sense_id": "fa12ee98-738d-3847-ae17-ee8ef8e45666",
                                "text": "We should have the bazaars full of yakitori pitches and geishas in bamboo cages."
                            }
                        ]
