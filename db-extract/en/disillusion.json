                            "plural"
                        ],
                        "form": "disillusions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae6bcdc9-06b5-3f07-aca8-c4b21aa63199",
                        "entry_id": "d5d42f62-1348-3f65-bac5-f483d00f3e74",
                        "glosses": [
                            "The act or process of disenchanting or freeing from a false belief or illusion."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "206d76dd-6eb3-365c-81c9-31f660389128",
                        "entry_id": "d5d42f62-1348-3f65-bac5-f483d00f3e74",
                        "glosses": [
                            "The state of being freed from a constructed or imposed illusion; the recognition of an underlying truth previously obscured by a false or controlled narrative."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "4726cffb-002a-4ca5-bda7-f093a7c24825",
                                "sense_id": "206d76dd-6eb3-365c-81c9-31f660389128",
                                "text": "Disillusion is not disappointment; it is the breaking of the spell—the moment the veil falls and truth becomes inescapable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e5a16df-1498-4891-bab0-ed456d729d7a",
                        "source_entry_id": "d5d42f62-1348-3f65-bac5-f483d00f3e74",
                        "source_sense_description": "act or state of disenchanting or freeing from a false belief",
