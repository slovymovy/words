                ],
                "senses": [
                    {
                        "sense_id": "5ac63a4a-c8ca-3068-b05b-f3b5a2d61e90",
                        "entry_id": "e3a06553-0f96-3e91-8644-cdd91c283cf1",
                        "glosses": [
                            "Funktion in Programmen zur Textverarbeitung, die während der Eingabe automatisch Korrekturen oder Vorschläge zu orthografischen und/oder grammatischen Fehlern macht"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "c595c225-930a-4ec4-a589-8f99d531137f",
                                "sense_id": "5ac63a4a-c8ca-3068-b05b-f3b5a2d61e90",
                                "text": "„Er ist die Coca-Cola-Formel des Internet-Zeitalters – und für manche eine sehr komfortable Entmündigung, die zusammen mit algorithmischen Empfehlungssystemen und Autokorrekturen zu einem virtuellen Vormund anwächst, der seine Vollendung in Facebook findet – einem softwareüberwachten Erwachsenenkindergarten, in dem die Menschen brav miteinander spielen und sich die Werbung am Rand angucken sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b0753e4-5bdd-48c5-a4bd-987530e336fc",
                        "source_entry_id": "e3a06553-0f96-3e91-8644-cdd91c283cf1",
                        "source_sense_id": "5ac63a4a-c8ca-3068-b05b-f3b5a2d61e90",
                        "source_sense_description": "Programmfunktion, die während der Eingabe automatisch Korrekturen oder Vorschläge zu Fehlern macht",
                        "target_lang_word": "autocorrect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocorrect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd047d5-881d-3cf0-a500-a4968540b274",
                                        "entry_id": "bb1c9161-e012-3e35-8040-2fc046887a3a",
                                        "glosses": [
                                            "To make an autocorrection; to correct something automatically."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b5d6611-14f4-4158-9c94-09d7102bf82a",
                                                "sense_id": "8bd047d5-881d-3cf0-a500-a4968540b274",
                                                "text": "In [16], motion-free MR brain (Figure 2a) image was corrupted with motion artifacts and the resulting image (Figure 2b) was autocorrected to fix the motion artifacts."
                                            },
                                            {
                                                "example_id": "7c739cc5-c8b5-4ec7-9f5c-eabde5692b32",
                                                "sense_id": "8bd047d5-881d-3cf0-a500-a4968540b274",
                                                "text": "But the good news is that it autocorrects all of your subcommunications."
                                            },
                                            {
                                                "example_id": "1f879c2b-58ed-40db-9474-733d4a4187bf",
                                                "sense_id": "8bd047d5-881d-3cf0-a500-a4968540b274",
                                                "text": "The computer usually defaults to autocorrecting certain spellings and capitalising first words of sentences."
                                            },
                                            {
                                                "example_id": "63ea051e-f2bc-4f4e-8fbb-27f9ae1338e5",
                                                "sense_id": "8bd047d5-881d-3cf0-a500-a4968540b274",
                                                "text": "That is the angriest Lindsey Graham has been about a cellphone since his name got autocorrected to “Linty Grandma”. “Stupid phone! Luhn mah name, Ah am your bawss! Stupid! So duhmb!”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "autocorrect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ef120e1-6f47-382e-9f05-3d29b1fcc30b",
                                        "entry_id": "86c519c9-f6f5-3dfe-aff3-3bc41211a9f5",
                                        "glosses": [
                                            "A software feature that attempts to correct presumed errors as soon as they are generated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dc5be89-00b9-4992-aefb-db54ca89b78a",
                                                "sense_id": "9ef120e1-6f47-382e-9f05-3d29b1fcc30b",
                                                "text": "Anthony Bourdain would have hated that autocorrect turns his name into Boursin, a bland cheese with zero culinary credibility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fba5cd5-c61c-4ba8-8622-fb582a037d51",
                        "source_entry_id": "e3a06553-0f96-3e91-8644-cdd91c283cf1",
                        "source_sense_id": "5ac63a4a-c8ca-3068-b05b-f3b5a2d61e90",
                        "source_sense_description": "Programmfunktion, die während der Eingabe automatisch Korrekturen oder Vorschläge zu Fehlern macht",
                        "target_lang_word": "autocorrection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocorrection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6f56b1c-0e7b-3b3e-98f1-dd7f232de2f9",
                                        "entry_id": "72e15d3e-9f6d-37b6-bd12-21bcb2513b18",
                                        "glosses": [
                                            "Fait de se corriger soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4f5c4d-e21d-4434-9b59-62d3dc9d8c8f",
                                                "sense_id": "a6f56b1c-0e7b-3b3e-98f1-dd7f232de2f9",
                                                "text": "Dans la communauté, l’élève développe des habiletés critiques et d’autocorrection, car ses idées sont soumises à la réflexion et à la critique des autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01d559e7-9369-3e72-a290-8369bbe37cd7",
                                        "entry_id": "72e15d3e-9f6d-37b6-bd12-21bcb2513b18",
                                        "glosses": [
                                            "Figure de style fondée sur la reprise volontaire de paroles que l’on vient d’énoncer afin de les reformuler avec davantage de justesse ou de force."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a48c76ea-c59f-4709-9f63-699da9d68ce5",
                                                "sense_id": "01d559e7-9369-3e72-a290-8369bbe37cd7",
                                                "text": "Plus complexe, le deuxième exemple d’autocorrection repose sur un enchaînement du type \"non (…) non plus (…) n’importe\" où la négation porte sur un seul terme : \"… il faudrait que la terre tremble, ce n’est pas de la terre, on ne sait pas ce que c’est, c’est comme de la sargasse, non, c’est comme de la mélasse, non plus, n’importe…\"."
                                            }
                                        ]
                                    },
