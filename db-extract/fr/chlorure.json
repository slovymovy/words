        "fr-extract.jsonl": [
            {
                "entry_id": "094becfe-52e2-316e-a08c-75c8ddd76a0b",
                "word": "chlorure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dd7df56e-9950-4bbf-b329-8a4fe276bab8",
                        "entry_id": "094becfe-52e2-316e-a08c-75c8ddd76a0b",
                        "tags": [
                            "plural"
                        ],
                        "form": "chlorures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "937133fb-effd-31c5-a930-f06d5623fb66",
                        "entry_id": "094becfe-52e2-316e-a08c-75c8ddd76a0b",
                        "glosses": [
                            "Nom générique des corps composés de chlore et d’une substance simple, autre que l’oxygène et l’hydrogène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7ef0366-1ab1-4bc8-9fa3-38196380888c",
                                "sense_id": "937133fb-effd-31c5-a930-f06d5623fb66",
                                "text": "Nous citerons les solutions aqueuses étendues de chlorure de cobalt, d’acétate ou de nitrate de cobalt, mêlées de 1/4 de sel marin; elles donnent une encre sympathique avec laquelle l'écriture, invisible sur le papier, apparaît en bleu par une légère application de la chaleur, puis disparaît ensuite par degrés, à mesure que le chlorure de cobalt reprend de l'eau, et reparaît de nouveau par la chaleur."
                            },
                            {
                                "example_id": "b54aacda-df5c-48ab-9b9f-8710bdcf445a",
                                "sense_id": "937133fb-effd-31c5-a930-f06d5623fb66",
                                "text": "Quelquefois on décape l’argent à l'acide azotique, mais il faut employer de l’acide bien exempt de chlore, qui formerait du chlorure d’argent à la surface de l’objet."
                            },
                            {
                                "example_id": "8140ebf4-917a-4853-925e-b29fb79921cf",
                                "sense_id": "937133fb-effd-31c5-a930-f06d5623fb66",
                                "text": "Si on mélange ensemble une solution de chlorure ferrique et une solution de prussiate rouge, on obtient une solution rouge qui teint en bleu de Prusse les fibres végétales plongées dans la liqueur, tandis que les fibres animales ne teignent pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a2212d9-ef5c-435d-b31a-5587f8b18f16",
                        "source_entry_id": "094becfe-52e2-316e-a08c-75c8ddd76a0b",
                        "source_sense_id": "937133fb-effd-31c5-a930-f06d5623fb66",
                        "source_sense_description": "Tout sel d'un acide hydrochlorique",
                        "target_lang_word": "Chlorid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chlorid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c6d7931-1348-381a-9fa5-bbbb8808b3f0",
                                        "entry_id": "87adc78e-9c65-3609-8022-a0348dc99f7e",
                                        "glosses": [
                                            "Salz der Chlorwasserstoffsäure (auch Salzsäure) mit ionischer Bindung"
                                        ],
                                        "tags": [
                                            "anorganische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50e6be87-bd03-45e5-817a-dc619d69823f",
                                                "sense_id": "3c6d7931-1348-381a-9fa5-bbbb8808b3f0",
                                                "text": "Kochsalz ist das bekannteste Chlorid."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e94de12-4abf-3793-bb59-77454ff472d5",
                                        "entry_id": "87adc78e-9c65-3609-8022-a0348dc99f7e",
                                        "glosses": [
                                            "Derivat der verschiedenen Verbindungen der Kohlenwasserstoffe mit molekularer Bindung"
                                        ],
                                        "tags": [
                                            "organische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61cf7174-a26a-4d1a-9399-644f1e1c36a7",
                                                "sense_id": "2e94de12-4abf-3793-bb59-77454ff472d5",
                                                "text": "„Die Bezeichnung dieser nicht salzartigen organischen Verbindungen als ‚Chlorid‘ ist fragwürdig, aber dennoch üblich.“",
                                                "translation": "„Polen hatte die Übernahme russischen Öls am Mittwochabend gestoppt, nachdem starke Verunreinigungen mit Chloriden nachgewiesen worden waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eda485d6-d221-4c8c-a32e-b0f41b9834b0",
                        "source_entry_id": "094becfe-52e2-316e-a08c-75c8ddd76a0b",
                        "source_sense_id": "937133fb-effd-31c5-a930-f06d5623fb66",
                        "source_sense_description": "Tout sel d'un acide hydrochlorique",
                        "target_lang_word": "chloride",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chloride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47517bbd-f0c4-3b34-81eb-a16b656e0bbb",
                                        "entry_id": "a6ff7b9e-c48a-3329-9cee-c67671dca549",
                                        "glosses": [
                                            "Any binary compound of chlorine and another element or radical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b3b8684-b45d-3e29-a1c9-d9965877b89e",
                                        "entry_id": "a6ff7b9e-c48a-3329-9cee-c67671dca549",
                                        "glosses": [
                                            "Any binary compound of chlorine and another element or radical.",
                                            "Any salt of hydrochloric acid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc7cee50-4007-421a-bbd6-fcf2e15b46eb",
                                                "sense_id": "8b3b8684-b45d-3e29-a1c9-d9965877b89e",
                                                "text": "Another type, also common in the Taipei area has more chlorides than sulfates, and while it is also hot, its flavor is more salty than sour. The springs at Chinshan on the north coast are typical of this type."
                                            },
                                            {
                                                "example_id": "48d131fb-8dc8-4f83-a8c5-95a2ca0f135b",
                                                "sense_id": "8b3b8684-b45d-3e29-a1c9-d9965877b89e",
                                                "text": "Klopfer and Gamble (1966) gave 16 female goats (C. hircus) 5 min of contact with their young at parturition. Nine of the mothers had been temporarily rendered anosmic (could not smell) at parturition by spraying a 10% cocaine hydrogen chloride solution into their nostrils 20–90 min prior to parturition. […] Eight of the nine females who were anosmic at parturition but could smell at reintroduction accepted their own offspring, as well as alien young during reinstatement."
                                            },
                                            {
                                                "example_id": "4013ed23-c435-4a28-b24d-91afbf88a6a7",
                                                "sense_id": "8b3b8684-b45d-3e29-a1c9-d9965877b89e",
                                                "text": "The Renew is also free of polyvinyl chloride, asbestos, chlorofluorocarbons and halons."
                                            },
                                            {
                                                "example_id": "f16c534b-0030-42c0-90b0-6abf65500760",
                                                "sense_id": "8b3b8684-b45d-3e29-a1c9-d9965877b89e",
                                                "text": "McCoy’s team, including 66 researchers across four continents, found the salt and minerals left behind as water on Bennu, or its larger parent asteroid, evaporated. The minerals include sodium phosphates, carbonates, sulfates, chlorides and fluorides, some of which are necessary to the formation of life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67deaa11-aaad-30c2-b8d4-4e428c5a217e",
                                        "entry_id": "a6ff7b9e-c48a-3329-9cee-c67671dca549",
                                        "glosses": [
                                            "The anionic form of a chlorine atom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
