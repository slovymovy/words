                "senses": [
                    {
                        "sense_id": "e4cce405-ea57-3904-8281-84c7243fe2e7",
                        "entry_id": "55653fd2-0340-33ca-8559-d10c5c4fe35b",
                        "glosses": [
                            "Berufsbezeichnung: einer Brücke zugeteilter Baumeister, welcher der Ingenieurwissenschaften mächtig ist und den Brückenbau fachgerecht vorantreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2b17e25-5f20-4051-b4e1-ae4c1305a583",
                                "sense_id": "e4cce405-ea57-3904-8281-84c7243fe2e7",
                                "text": "„Die noch heute im ehemaligen Kurhessen ansässige Familie Fürer stammt nachweislich von dem Brückenbaumeister Johann Michael Führer ab.“"
                            },
                            {
                                "example_id": "cbb98f1a-fda4-410f-a2db-78f64a2c4554",
                                "sense_id": "e4cce405-ea57-3904-8281-84c7243fe2e7",
                                "text": "„Mit stiller Bekümmernis bemerkte dies der Brückenbaumeister.“"
                            },
                            {
                                "example_id": "989b3b1b-0638-46b2-85c8-dda68599c705",
                                "sense_id": "e4cce405-ea57-3904-8281-84c7243fe2e7",
                                "text": "„Der Brückenbaumeister akzeptierte die Forderung und der Teufel hielt sein versprechen und die Brücke war rechtzeitig zur Eröffnung fertig.“"
                            },
                            {
                                "example_id": "672e85f3-e21a-48c3-8b88-cbc90862e7d9",
                                "sense_id": "e4cce405-ea57-3904-8281-84c7243fe2e7",
                                "text": "„Der Brückenbaumeister aber sperrte die Brücke, sowie sie vollendet war, damit kein Mensch darüberginge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
