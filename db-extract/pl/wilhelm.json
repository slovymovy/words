                ],
                "senses": [
                    {
                        "sense_id": "2fd81b13-8363-3b04-9d49-335515a405e6",
                        "entry_id": "d2855d09-818c-3ee5-842b-bc2a8915f429",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14cd90c3-0208-4467-b99b-aacf023c0dd8",
                                "sense_id": "2fd81b13-8363-3b04-9d49-335515a405e6",
                                "text": "Wilhelm poznał znanego szekspirologa w Londynie."
                            },
                            {
                                "example_id": "315dd314-5fe7-45ec-84e1-91ae687480e9",
                                "sense_id": "2fd81b13-8363-3b04-9d49-335515a405e6",
                                "text": "Nawet najlepsze systemy gry w bakarata zawodzą, więc któregoś dnia dziewiętnastoletni Wilhelm dowiedział się od matki, że odtąd musi sam zarobkować na siebie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8df50298-b237-472b-b126-09cb2f9d1614",
                        "source_entry_id": "d2855d09-818c-3ee5-842b-bc2a8915f429",
                        "source_sense_id": "2fd81b13-8363-3b04-9d49-335515a405e6",
                        "target_lang_word": "William",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "William",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71edb961-1879-3097-8e6b-8aeb447bf677",
                                        "entry_id": "495b99e9-5c28-33a6-9f01-7b60f5eaa895",
                                        "glosses": [
                                            "radiotelephony clear-code word for the letter W."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "William",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f8270f3-4f7c-30cf-8b3a-1a0503cca252",
                                        "entry_id": "a6701fe0-e4e6-32b1-a272-aee54b19c5df",
                                        "glosses": [
                                            "A male given name from the Germanic languages popular since the Norman Conquest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "177754c2-2cea-4a6b-8957-5e1ad6c96585",
                                                "sense_id": "8f8270f3-4f7c-30cf-8b3a-1a0503cca252",
                                                "text": "This name hath been most common in England since King William the Conquerour, insomuch that upon a festival day in the Court of King Henry the Second, when Sir William Saint-John, and Sir William Fitz-Hamon, especial Officers, had commanded that none but of the name of William should dine in the great Chamber with them, they were accompanied with a hundred and twenty Williams."
                                            },
                                            {
                                                "example_id": "2420708e-cd71-437d-bc29-f76a85073311",
                                                "sense_id": "8f8270f3-4f7c-30cf-8b3a-1a0503cca252",
                                                "text": "But we have known Williams and Richards, names not found in sacred story, but familiar to our country, prove as gracious saints as any Safe deliverance, Fight the good fight of faith, or such like,"
                                            },
                                            {
                                                "example_id": "323be5ee-b005-41e6-b218-9c3639f5402b",
                                                "sense_id": "8f8270f3-4f7c-30cf-8b3a-1a0503cca252",
                                                "text": "By the same token I should probably have called myself 'Bill'. With a name like William you have choices. Very handy for us chameleons. 'William' is stern and dignified. A little austere and unapproachable. He conquers things. It is what my mother calls me when she is angry with me."
                                            },
                                            {
                                                "example_id": "b716b944-913c-47ee-a340-218fed130d59",
                                                "sense_id": "8f8270f3-4f7c-30cf-8b3a-1a0503cca252",
                                                "text": "One was a piece, Two Cheers for the Whig Interpretation of History, by William Cronon, president of the American Historical Association."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98580051-56ec-323e-bdb6-5c0bb4da34fe",
                                        "entry_id": "a6701fe0-e4e6-32b1-a272-aee54b19c5df",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a41ece37-76f1-4488-9761-a9df3fe558e9",
                        "source_entry_id": "d2855d09-818c-3ee5-842b-bc2a8915f429",
                        "source_sense_id": "2fd81b13-8363-3b04-9d49-335515a405e6",
                        "target_lang_word": "Guillaume",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guillaume",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7517343c-4d5d-3d3b-9c8a-642dc8f98dc4",
                                        "entry_id": "6a578090-386f-3beb-a5a3-d08bca211bdf",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7df24ce4-a2b8-4353-80e3-98669af2baa2",
                                                "sense_id": "7517343c-4d5d-3d3b-9c8a-642dc8f98dc4",
                                                "text": "Il en conclut que si Guillaume aime tant cette lettre K, c’est parce qu’elle affecte l’allure d’un soldat prussien marchant au pas de l’oie."
                                            },
                                            {
                                                "example_id": "a33149a6-0f3d-40c3-918a-b949e1998dd2",
                                                "sense_id": "7517343c-4d5d-3d3b-9c8a-642dc8f98dc4",
                                                "text": "Tous deux passés par des maisons étoilées avant de créer Bo-tannique en association avec Guillaume Rossi, ils proposent une cuisine semi-gastronomique française, twistée par les inspirations rapportées de leur voyage, épices et mélanges de saveurs originaux."
                                            },
                                            {
                                                "example_id": "9c54a1d2-c543-41d9-a4c3-77ddfc884964",
                                                "sense_id": "7517343c-4d5d-3d3b-9c8a-642dc8f98dc4",
                                                "text": "Il se rappelle très bien son geste, foudroyant, incontrôlable. Le long couteau qui s’enfonce dans la chair chaude. Et le sang bouillonnant qui en jaillit. Il le recueille dans un grand bol. Et il dépèce Guillaume, comme dans un rêve."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Guillaume",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "333f73d3-61f9-33aa-9556-f2999bf110dc",
                                        "entry_id": "db4f0860-4ee8-32fb-b25b-99ecacd9a2f8",
                                        "glosses": [
                                            "Nom de famille français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23483760-9895-4369-ab92-efb0eebbb45a",
                                                "sense_id": "333f73d3-61f9-33aa-9556-f2999bf110dc",
                                                "text": "Baptiste Guillaume coupe au premier poteau et moi je finis au second, tout seul."
                                            },
                                            {
                                                "example_id": "d7b6849b-db09-4c12-a15d-eba632f98130",
                                                "sense_id": "333f73d3-61f9-33aa-9556-f2999bf110dc",
                                                "text": "Certes, le scénographe Maciej Fiszer — en lien étroit avec Philippe Starck, directeur artistique de l’événement et Valérie Guillaume, directrice de Carnavalet et commissaire — a réussi à composer des ambiances immersives."
                                            },
                                            {
                                                "example_id": "e120792b-63d9-4c86-9fec-d64328d95372",
                                                "sense_id": "333f73d3-61f9-33aa-9556-f2999bf110dc",
                                                "text": "Ce 1ᵉʳ juin Asttre 19 (sauvegarde du Viaduc) réunissait comme tous les ans son conseil d’administration (CA) en présence de Serge Guillaume maire de Soursac et Benoît Armengaud adjoint au maire de Lapleau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
