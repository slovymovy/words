        "fr-extract.jsonl": [
            {
                "entry_id": "02aa3cc7-68ed-3958-a5a2-f03e486fe1b4",
                "word": "spiritualité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bcca64e0-180d-417f-afc1-71e7c72e8371",
                        "entry_id": "02aa3cc7-68ed-3958-a5a2-f03e486fe1b4",
                        "tags": [
                            "plural"
                        ],
                        "form": "spiritualités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "919175dd-dbec-3e47-82b5-6be113984669",
                        "entry_id": "02aa3cc7-68ed-3958-a5a2-f03e486fe1b4",
                        "glosses": [
                            "Caractère spirituel, nature spirituelle."
                        ],
                        "tags": [
                            "Métaphysique"
                        ],
                        "examples": [
                            {
                                "example_id": "d5b527f5-0bed-44fa-a988-4e01a20b4ccd",
                                "sense_id": "919175dd-dbec-3e47-82b5-6be113984669",
                                "text": "La spiritualité de l’âme."
                            },
                            {
                                "example_id": "9b48da01-b7b9-4f56-ac5e-f9732fde65fb",
                                "sense_id": "919175dd-dbec-3e47-82b5-6be113984669",
                                "text": "Le mot « spiritualité » doit être pris avec beaucoup de délicatesse, car on le confond trop souvent avec « religion ». Je respecte les croyances religieuses qui viennent nourrir une spiritualité ; pris au sens philosophique, au sens très concret, « spiritualité » veut dire : donner du sens et de la valeur à ce que l'on est, à ce que l'on fait, à ce que l'on devient."
                            }
                        ]
                    },
                    {
                        "sense_id": "b12251c3-9ad6-36eb-b303-d5ccf4098fac",
                        "entry_id": "02aa3cc7-68ed-3958-a5a2-f03e486fe1b4",
                        "glosses": [
                            "Théologie mystique qui regarde la nature de l’âme, la vie intérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fac033-c87e-4b0b-81d6-48597d0222d5",
                                "sense_id": "b12251c3-9ad6-36eb-b303-d5ccf4098fac",
                                "text": "Passant une à une les autres preuves de l’existence de Dieu, Ockham montre qu’elles sont inconsistantes. Il en est de même de la spiritualité et de l’immortalité de l’âme. L’intuition interne nous révèle nos états psychologiques, la joie, la tristesse, nos volontés, nos différentes opérations intellectuelles, mais non une substance immatérielle qui en serait le sujet et qui serait la forme de notre corps."
                            },
                            {
                                "example_id": "286f9916-b45f-440f-806b-9b3a8391314c",
                                "sense_id": "b12251c3-9ad6-36eb-b303-d5ccf4098fac",
                                "text": "Peu de chefs religieux bénéficient d’une réputation aussi enviable que celle de Tenzin Gyasto, […]. Nombre d’Occidentaux voient en lui un modèle de sagesse et de spiritualité."
                            },
                            {
                                "example_id": "3fe2651b-741d-45c8-bd28-56c756c6cfa6",
                                "sense_id": "b12251c3-9ad6-36eb-b303-d5ccf4098fac",
                                "text": "Tout ou presque dans l’antispécisme peut être ramené à une sorte de religion sécularisée, bien que ses militants soient plutôt athées ou porté sur les spiritualités asiatiques. Ils scindent le monde en deux. Les bons : les animaux , […]. Et les méchants : ceux qui pensent […] que l'homme vit dans le danger constant de s’animaliser."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea64aec6-5e96-30ed-b611-8d89578ebcd3",
                        "entry_id": "02aa3cc7-68ed-3958-a5a2-f03e486fe1b4",
                        "glosses": [
                            "Nuance de pensée religieuse propre à une école théologique, à un institut religieux ou à un peuple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fca7e116-6873-4cde-ae82-2367102e00cb",
                                "sense_id": "ea64aec6-5e96-30ed-b611-8d89578ebcd3",
                                "text": "Introduire une spiritualité si raffinée, si haute, une telle prétention à la perfection suprême, dans ce monde convenu, cérémoniel de Versailles, et cela à une fin de règne où tout semblait glacé, quelle entreprise téméraire !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bda2b0a5-2c59-4a05-9378-186a8886a4e6",
                        "source_entry_id": "02aa3cc7-68ed-3958-a5a2-f03e486fe1b4",
                        "target_lang_word": "spirituality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spirituality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f74d972f-cfd6-3719-97d2-28dc9ea2c851",
                                        "entry_id": "7df20e4b-9030-387e-a068-4cdf60535cef",
                                        "glosses": [
                                            "The quality or state of being spiritual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e0f5db0-887e-4d1a-9666-3740a210a0a4",
                                                "sense_id": "f74d972f-cfd6-3719-97d2-28dc9ea2c851",
                                                "text": ", \"The Ways of Wisdom are Ways of Pleasantness\"\na pleasure made for the soul, suitable to its spirituality"
                                            },
                                            {
                                                "example_id": "0d04b09b-fde4-4024-9ef3-057f85e10c13",
                                                "sense_id": "f74d972f-cfd6-3719-97d2-28dc9ea2c851",
                                                "text": "If this light be not spiritual, yet it approacheth nearest unto spirituality."
                                            },
                                            {
                                                "example_id": "00c46ac1-5933-4ff1-b690-1afde2c4fba2",
                                                "sense_id": "f74d972f-cfd6-3719-97d2-28dc9ea2c851",
                                                "text": "Much of our spirituality and comfort in public worship depends on the state of mind in which we come."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4b150e4-f7e3-377b-97fc-242551cf6154",
                                        "entry_id": "7df20e4b-9030-387e-a068-4cdf60535cef",
                                        "glosses": [
                                            "Concern for that which is unseen and intangible, as opposed to physical or mundane."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81dda6ef-fb40-3934-8fe4-abdf2468c2d2",
                                        "entry_id": "7df20e4b-9030-387e-a068-4cdf60535cef",
                                        "glosses": [
                                            "Appreciation for religious values."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3766b159-1b6f-3362-a1bb-62f4a855204f",
                                        "entry_id": "7df20e4b-9030-387e-a068-4cdf60535cef",
                                        "glosses": [
                                            "That which belongs to the church, or to a person as an ecclesiastic, or to religion, as distinct from temporalities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "904d811a-5de3-4561-90d4-cab09cfa63fd",
                                                "sense_id": "3766b159-1b6f-3362-a1bb-62f4a855204f",
                                                "text": "During the vacancy of a see, the archbishop is guardian of the spiritualities thereof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db63e15d-49fe-3d4e-b4af-f92ae6ae2a49",
                                        "entry_id": "7df20e4b-9030-387e-a068-4cdf60535cef",
                                        "glosses": [
                                            "An ecclesiastical body; the whole body of the clergy, as distinct from, or opposed to, the temporality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07fcae89-6539-429f-b36f-cb68e349cefa",
                                                "sense_id": "db63e15d-49fe-3d4e-b4af-f92ae6ae2a49",
                                                "text": "Five entire subsidies were granted to the king by the spirituality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
