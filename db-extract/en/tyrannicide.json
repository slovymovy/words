                                        "sense_id": "e9c3496c-452d-3583-9054-3d8ddb777aee",
                                        "entry_id": "c1b217d9-4c71-37fc-9daa-d50b7784b735",
                                        "glosses": [
                                            "vorsätzliche Tötung einer Person, die als Tyrann angesehen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "572f0f0f-48ab-453b-a10f-71f1b9a56d50",
                                                "sense_id": "e9c3496c-452d-3583-9054-3d8ddb777aee",
                                                "text": "„Bloß die Berner Tagwacht nennt Adler einen \"entschlossenen, mutvollen Kämpfer\", der niemals zum letzten Mittel des Tyrannenmords gegriffen hätte, wenn in Österreich \"die geringste Möglichkeit der freien Meinungsäußerung, ein Mindestmaß von Freiheit und Volksrechten bestanden hätte\".“"
                                            },
                                            {
                                                "example_id": "e036b576-fe0c-400a-9dd2-06ff59ab8eb1",
                                                "sense_id": "e9c3496c-452d-3583-9054-3d8ddb777aee",
                                                "text": "„Ihr Anschlag wird – auch wenn er aus Versehen nicht Durnowo, den finsteren Handlanger des Zaren, getroffen hat – von ihrem Verteidiger als Tyrannenmord eingestuft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
