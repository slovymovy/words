{
    "word_family": [
        "bludgeoner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7b945a3-6adb-36d7-9674-58b566749215",
                    "sense_definition": "To strike or hit someone or something with a heavy object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The attacker <w>bludgeoned</w> the victim with a heavy wooden stick.",
                            "target_lang_translations": {
                                "cs": "Útočník oběť <w>ubil</w> těžkým dřevěným klackem."
                            }
                        },
                        {
                            "text": "The criminal was <w>bludgeoned</w> to death during the violent robbery.",
                            "target_lang_translations": {
                                "cs": "Zločinec byl během násilného přepadení <w>umlácen</w> k smrti."
                            }
                        }
                    ],
                    "synonyms": [
                        "cudgel"
                    ],
                    "common_phrases": [
                        "bludgeoned to death"
                    ],
                    "target_lang_definitions": {
                        "cs": "Udeřit nebo praštit někoho či něco těžkým předmětem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ubít",
                                "target_lang_sense_clarification": "způsobit smrt nebo zranění údery těžkým předmětem"
                            },
                            {
                                "target_lang_word": "umlátit",
                                "target_lang_sense_clarification": "opakovaně bít někoho těžkým předmětem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fe243e6-6b7f-395c-a15d-524a5cc702e2",
                    "sense_definition": "To force or coerce someone into doing something through aggressive pressure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "coercion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They tried to <w>bludgeon</w> the committee into accepting their unpopular proposal.",
                            "target_lang_translations": {
                                "cs": "Snažili se výbor <w>donutit</w> k přijetí jejich nepopulárního návrhu."
                            }
                        },
                        {
                            "text": "It is difficult to <w>bludgeon</w> through bureaucracy when you lack political support.",
                            "target_lang_translations": {
                                "cs": "Je těžké <w>prorazit</w> byrokracii, když postrádáte politickou podporu."
                            }
                        }
                    ],
                    "synonyms": [
                        "harass",
                        "pummel"
                    ],
                    "common_phrases": [
                        "bludgeon through"
                    ],
                    "target_lang_definitions": {
                        "cs": "Někoho k něčemu nutit nebo přinutit agresivním nátlakem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "donutit",
                                "target_lang_sense_clarification": "přimět někoho k něčemu silou nebo nátlakem"
                            },
                            {
                                "target_lang_word": "dotlačit",
                                "target_lang_sense_clarification": "přimět někoho k souhlasu vytrvalým nátlakem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20f226ae-ced5-3856-b547-b8680faac42e",
                    "sense_definition": "A short, heavy club, often made of wood, used as a weapon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard carried a heavy <w>bludgeon</w> for protection.",
                            "target_lang_translations": {
                                "cs": "Strážný nosil pro ochranu těžký <w>obušek</w>."
                            }
                        },
                        {
                            "text": "Police found a wooden <w>bludgeon</w> hidden near the crime scene.",
                            "target_lang_translations": {
                                "cs": "Policie našla poblíž místa činu schovaný dřevěný <w>kyj</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cudgel"
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátký, těžký kyj, často dřevěný, používaný jako zbraň."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "obušek",
                                "target_lang_sense_clarification": "krátká úderná zbraň"
                            },
                            {
                                "target_lang_word": "kyj",
                                "target_lang_sense_clarification": "těžký dřevěný nástroj nebo zbraň"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}