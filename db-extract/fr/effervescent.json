                                        "sense_id": "4dc36b7a-cf0e-3203-b722-e163fe0d8b24",
                                        "entry_id": "766e60d5-a301-39f9-ae21-634fb4f5ce0c",
                                        "glosses": [
                                            "Giving off bubbles; fizzy."
                                        ],
                                        "tags": [
                                            "of a liquid"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9be0cf9-7fbb-34a1-8979-87245969284d",
                                        "entry_id": "766e60d5-a301-39f9-ae21-634fb4f5ce0c",
                                        "glosses": [
                                            "Vivacious and enthusiastic."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed294165-3fa4-44ec-8a86-c988d379710f",
                                                "sense_id": "f9be0cf9-7fbb-34a1-8979-87245969284d",
                                                "text": "\"It is rarely in human life,\" rejoined Douglas, \"we realize the inimitable paintings our imaginations form, and less so during the effervescent period of youth. The bright impression glows upon the fancy, ravishes the mental view, but ere long vanishes, and leaves the prospect desolate and forlorn.\""
                                            },
                                            {
                                                "example_id": "12187fbe-1f0c-45f0-b6cd-9e3b952c83e2",
                                                "sense_id": "f9be0cf9-7fbb-34a1-8979-87245969284d",
                                                "text": "The effervescent Suarez then went close again as he worked space for a shot after a mazy run but could not keep his close-range shot below the crossbar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
