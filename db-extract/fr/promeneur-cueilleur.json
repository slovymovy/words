                        "glosses": [
                            "Promeneur qui a pour idée de cueillir (des champignons, des fruits ou des fleurs, par exemple)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d63e4ab6-28f3-4926-938d-430c9d782fcf",
                                "sense_id": "5c968c9c-c688-3b3b-8181-faabb7d4d8f9",
                                "text": "Il y a une dizaine d’années, on trouvait plusieurs kilos de cèpes en automne, constate Paco, promeneur-cueilleur girondin."
                            },
                            {
                                "example_id": "356b8b71-fe5f-4d81-a7ba-649f9b0224c4",
                                "sense_id": "5c968c9c-c688-3b3b-8181-faabb7d4d8f9",
                                "text": "Des centaines de promeneurs-cueilleurs viennent cueillir ces fleurs, sans respecter la nature et pourtant une réglementation précise existe."
                            },
                            {
                                "example_id": "ef3803cd-bbe6-4f60-9fed-6d1e9a23eaf8",
                                "sense_id": "5c968c9c-c688-3b3b-8181-faabb7d4d8f9",
                                "text": "Un peu tardive cette année, mais les promeneurs-cueilleurs sont déjà légion dans les sous-bois."
                            }
                        ]
