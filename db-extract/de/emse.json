                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "e63f7f35-3ea5-4985-9e50-4e388ef5b7bb",
                                "sense_id": "3037a0ce-a8de-31f3-9260-ab1255ef565e",
                                "text": "Die fleißigen Emsen krabbelten geschäftig auf ihrem Bau umher."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07becb7e-f793-4f77-86e6-5aa5b08e2642",
                        "source_entry_id": "983c3978-cb66-3ea7-8c5c-561da5e8c373",
                        "source_sense_id": "3037a0ce-a8de-31f3-9260-ab1255ef565e",
                        "source_sense_description": "veraltet, dichterisch: Ameise",
                        "target_lang_word": "emmet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emmet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d66c843c-0e63-3be5-9a83-274759446667",
                                        "entry_id": "64857f0b-6ed7-3965-9267-1f1eb950764b",
                                        "glosses": [
                                            "An ant."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8520fcfa-2b16-4744-995d-1cb27e8505a7",
                                                "sense_id": "d66c843c-0e63-3be5-9a83-274759446667",
                                                "text": "Once a dream did weave a shade / O'er my angel-guarded bed / That an emmet lost its way / Where on grass methought I lay."
                                            },
                                            {
                                                "example_id": "438c81ff-ec27-4b3e-b26e-4d47cbcc0095",
                                                "sense_id": "d66c843c-0e63-3be5-9a83-274759446667",
                                                "text": "He told him that he saw a vast multitude and a promiscuous, their habitations like molehills, the men as emmets […]"
                                            },
                                            {
                                                "example_id": "4731e6e4-a60a-4825-9696-0809f6b04643",
                                                "sense_id": "d66c843c-0e63-3be5-9a83-274759446667",
                                                "text": "1666, Dr. Edmund King, Philosophical Transactions (1665-1678) Observations Concerning Emmets or Ants, Their Eggs, Production, Progress, Coming to Maturity, Use, &c"
                                            },
                                            {
                                                "example_id": "609ce121-3744-4c60-8f40-ab5159e095d4",
                                                "sense_id": "d66c843c-0e63-3be5-9a83-274759446667",
                                                "text": "What shall a Mote up to a Monarch rise?\nAn Emmet match an Emperor in might?"
                                            },
                                            {
                                                "example_id": "3f7b1ad5-84b3-4303-8951-42e2dadfae07",
                                                "sense_id": "d66c843c-0e63-3be5-9a83-274759446667",
                                                "text": "[A benignity that] to the emmet gives / Her foresight, and intelligence that makes / The tiny creatures strong by social league."
                                            },
                                            {
                                                "example_id": "4ce1168e-abef-4e4f-9ce9-7dc84a2fdc70",
                                                "sense_id": "d66c843c-0e63-3be5-9a83-274759446667",
                                                "text": "We are scurrying emmets or pismires with our sad little comedies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7129fd97-7df1-3c7a-99d3-c14bd18c49c6",
                                        "entry_id": "64857f0b-6ed7-3965-9267-1f1eb950764b",
                                        "glosses": [
                                            "A tourist."
                                        ],
                                        "tags": [
                                            "Cornwall",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
