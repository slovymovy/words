                "entry_id": "98c3c3ff-0e1a-3404-afa4-c4bedc81f371",
                "word": "désengrammer",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0119918a-d4f4-3c31-b2f5-881dc0e72279",
                        "entry_id": "98c3c3ff-0e1a-3404-afa4-c4bedc81f371",
                        "glosses": [
                            "Enlever du système nerveux ce qui y avait été fixé sous forme d’engramme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "733feacc-2a27-4a8a-8cd8-d49f1c59c889",
                                "sense_id": "0119918a-d4f4-3c31-b2f5-881dc0e72279",
                                "text": "La myéline est le principal élément à désengrammer dans la sclérose en plaques et la cause est à rechercher au sein de l’enquête."
                            },
                            {
                                "example_id": "92c7b023-e1a6-4fa7-aaf3-4158760c578c",
                                "sense_id": "0119918a-d4f4-3c31-b2f5-881dc0e72279",
                                "text": "Je le désengramme mais ce n'est pas suffisant. Il faut désengrammer le vrai coupable, c’est-à-dire le produit toxique."
                            },
                            {
                                "example_id": "0869a694-de5e-4b90-aaa6-f44e97fac496",
                                "sense_id": "0119918a-d4f4-3c31-b2f5-881dc0e72279",
                                "text": "Il suffit de désengrammer et l’allergie disparait définitivement."
                            },
                            {
                                "example_id": "4bcf9844-69eb-45d5-a4bc-8e41944874be",
                                "sense_id": "0119918a-d4f4-3c31-b2f5-881dc0e72279",
                                "text": "L’ostéopathe va alors désengrammer les molécules auxquelles l’organe est intolérant pour qu’il puisse de nouveau les supporter."
                            },
                            {
                                "example_id": "8716addf-d4ac-4d76-b350-6783263d334e",
                                "sense_id": "0119918a-d4f4-3c31-b2f5-881dc0e72279",
                                "text": "Ceux-ci reposent en effet sur un très subtil travail de transformation où tout a sa place, mais peut se relier à sa cause, se transformer, recouvrer sa vraie nature et se désengrammer de toute structure préalablement établie."
                            },
                            {
                                "example_id": "ffc08b0a-b0d4-4530-aa94-335226b25fcb",
                                "sense_id": "0119918a-d4f4-3c31-b2f5-881dc0e72279",
                                "text": "Mais combien d’années faut-il pour se désengrammer des croyances limitantes qui nous ont été inculquées par l’éducation !"
                            }
                        ]
                    }
                ],
