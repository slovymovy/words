                    },
                    {
                        "translation_id": "a61ba46c-20bb-47b7-93e1-eea81d7fa804",
                        "source_entry_id": "7d304fe7-e972-3a05-be90-10cf5168592d",
                        "source_sense_id": "8304775c-3ce0-3552-9300-caf5290b0264",
                        "source_sense_description": "crockery",
                        "target_lang_word": "vaisselle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaisselle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                        "entry_id": "1d0d08c1-86d1-3b66-828a-ced5ad02b494",
                                        "glosses": [
                                            "Ce qui sert à l’usage ordinaire de la table, comme plats, assiettes, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e0c2973-6b98-46ad-9048-c8fb8adb09b4",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Pif ! paf ! les gifles commencèrent à pleuvoir et la vaisselle à danser : […]."
                                            },
                                            {
                                                "example_id": "d9131889-91c0-4145-bffd-030ca8f7e156",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Vaisselle d’or, d’argent, de vermeil, de faïence, de porcelaine. — Vaisselle unie, ciselée, armoriée."
                                            },
                                            {
                                                "example_id": "b58fd149-fcfb-4d56-8e7c-220aa7b81933",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "De vieille vaisselle. — Vaisselle au poinçon de Paris."
                                            },
                                            {
                                                "example_id": "22d35201-be66-4a1c-9ec9-a108db77f426",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Nettoyer la vaisselle."
                                            },
                                            {
                                                "example_id": "635a21d8-9023-401f-b2b6-55d562b2ea03",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Écurer, laver la vaisselle."
                                            },
                                            {
                                                "example_id": "39f7940c-bca9-48be-9139-852a613cf4a3",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Faire la vaisselle, laver la vaisselle qui a servi."
                                            },
                                            {
                                                "example_id": "9a982409-5c58-482a-96c7-72cf59fd630e",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Vaisselle montée, celle qui est composée de plusieurs pièces jointes avec de la soudure."
                                            },
                                            {
                                                "example_id": "a1abeec6-ccee-4d05-8b1a-47f2a9e7dfa7",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Vaisselle plate, vaisselle d’or ou d’argent où il n’y a point de soudure ; il se dit aujourd’hui plus particulièrement des Plats et des assiettes d’argent, à la différence de la vaisselle de porcelaine, de faïence, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00dce542-566b-319b-950f-b4b48dc05cc8",
                                        "entry_id": "1d0d08c1-86d1-3b66-828a-ced5ad02b494",
                                        "glosses": [
                                            "Objets en métal précieux servant à l'usage de la table d’un seigneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efae21a2-d6bd-4e07-888f-0b25583f5eb0",
                                                "sense_id": "00dce542-566b-319b-950f-b4b48dc05cc8",
                                                "text": "Romulus accueillit ce prétendant avec faveur, espérant qu’une alliance avec cet homme puissant l’aiderait à rétablir ses propres affaires qu’il avait dérangées par le luxe de son palais, de sa vaisselle et de ses jardins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28942b89-d26e-3974-ad93-21760b96a9dc",
                                        "entry_id": "1d0d08c1-86d1-3b66-828a-ced5ad02b494",
                                        "glosses": [
                                            "Ensemble des récipients, des plats, des assiettes, des couverts, des verres et des ustensiles de cuisine qui sont à laver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d9ed120-d700-43ea-9b16-e203010f35a6",
                                                "sense_id": "28942b89-d26e-3974-ad93-21760b96a9dc",
                                                "text": "Ce jour-là, elle négligea son ménage. Elle laissa même la vaisselle s’empiler sur l’évier et elle cousit longtemps"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4777d41-cc97-498a-b35f-c0015737a83b",
                        "source_entry_id": "7d304fe7-e972-3a05-be90-10cf5168592d",
                        "source_sense_id": "8304775c-3ce0-3552-9300-caf5290b0264",
                        "source_sense_description": "crockery",
                        "target_lang_word": "Geschirr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschirr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f8ce033-fefd-34db-b999-3099e5fb9141",
                                        "entry_id": "4200df57-b3b7-3c84-9d0e-54e2c9eb4210",
                                        "glosses": [
                                            "Gesamtheit aller Werkzeuge und Gefäße, die beim Essen und Trinken benötigt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "419debab-4975-4fa1-b2ce-94d45870a5bf",
                                                "sense_id": "5f8ce033-fefd-34db-b999-3099e5fb9141",
                                                "text": "Wir haben uns neues Geschirr gekauft."
                                            },
                                            {
                                                "example_id": "20cf2b9f-8523-4454-a046-da575285cfc2",
                                                "sense_id": "5f8ce033-fefd-34db-b999-3099e5fb9141",
                                                "text": "Er holt sein Geschirr und deckt den Tisch."
                                            },
                                            {
                                                "example_id": "e1eecc2a-a91d-41fe-8302-e1c531604ea2",
                                                "sense_id": "5f8ce033-fefd-34db-b999-3099e5fb9141",
                                                "text": "„Er trug das Geschirr und alles, was wir zum Kochen benutzt hatten, zurück in den Parnassus, zäumte Peg wieder auf und band Bock an den Wagen.“"
                                            },
                                            {
                                                "example_id": "d3c6ca36-4286-4b2b-902a-0443ac1de270",
                                                "sense_id": "5f8ce033-fefd-34db-b999-3099e5fb9141",
                                                "text": "„Geschirr wird auf der Freitreppe so reichlich zerschlagen, als sei es im Überfluß vorhanden wie je.“"
                                            },
                                            {
                                                "example_id": "01ec9d7b-76fa-4a63-a081-bd20e056e1dd",
                                                "sense_id": "5f8ce033-fefd-34db-b999-3099e5fb9141",
                                                "text": "„Es war das gute Geschirr mit dem Goldrand, das Mama nur zu Ostern und Weihnachten und nur mit der blütenweißen, gestärkten Tischdecke hergenommen hatte.“"
                                            },
                                            {
                                                "example_id": "3ce4bed3-5496-41ac-9e94-491725b66e7f",
                                                "sense_id": "5f8ce033-fefd-34db-b999-3099e5fb9141",
                                                "text": "„Ihre Mutter hatte schon recht, sie brauchte einige Sachen, aber vor allem Kleinkram: Geschirr und Besteck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1eba64f-2df2-33fe-a8a4-635e60fe31b8",
                                        "entry_id": "4200df57-b3b7-3c84-9d0e-54e2c9eb4210",
                                        "glosses": [
                                            "Gesamtheit aller Werkzeuge und Gefäße, die für das Kochen benötigt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c643b0-0535-4fe1-b20a-f6493b1581c4",
                                                "sense_id": "e1eba64f-2df2-33fe-a8a4-635e60fe31b8",
                                                "text": "Zum Kochen auf dem Campingplatz empfiehlt sich folgendes Geschirr: Kochtopf, Kasserolle, Pfanne, Schöpflöffel, Bratenwender und ein scharfes Messer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c8322aae-2c87-3fb9-a3ba-a20fc0c99ab3",
                                        "entry_id": "4200df57-b3b7-3c84-9d0e-54e2c9eb4210",
                                        "glosses": [
                                            "Lederkonstruktion zum Einspannen von Zugtieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "500d26b1-54c1-476c-b948-309b059f7292",
                                                "sense_id": "c8322aae-2c87-3fb9-a3ba-a20fc0c99ab3",
                                                "text": "Heute ist das Brustblattgeschirr aufgrund seiner Einfachheit und der vielfältigen Verstellmöglichkeiten zum meistverwendeten Geschirr im Freizeitbereich des Fahrsports geworden."
                                            },
                                            {
                                                "example_id": "492a175d-e7ae-42f7-afae-1113fc1de557",
                                                "sense_id": "c8322aae-2c87-3fb9-a3ba-a20fc0c99ab3",
                                                "text": "„Vier Rentiere mit goldenem Geschirr und roten Nasen standen davor.“"
                                            },
                                            {
                                                "example_id": "7447adc3-e979-47d6-9a14-e1e01ef1d8c2",
                                                "sense_id": "c8322aae-2c87-3fb9-a3ba-a20fc0c99ab3",
                                                "text": "„Nach einer Weile hörten sie vom Berg her ein zweites Geschirr läuten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
