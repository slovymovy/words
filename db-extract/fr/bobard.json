        "fr-extract.jsonl": [
            {
                "entry_id": "d54e3dc3-87ac-3578-8208-3f8af977989a",
                "word": "bobard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "90ff3ee4-b7b7-440c-98ac-63f86ed6fb1f",
                        "entry_id": "d54e3dc3-87ac-3578-8208-3f8af977989a",
                        "tags": [
                            "plural"
                        ],
                        "form": "bobards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae49f8e8-7a60-356c-933a-98910903370f",
                        "entry_id": "d54e3dc3-87ac-3578-8208-3f8af977989a",
                        "glosses": [
                            "Mensonge, fausse nouvelle."
                        ],
                        "tags": [
                            "familiar",
                            "very-familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1f1975a7-3396-46c0-853f-38b8927d8691",
                                "sense_id": "ae49f8e8-7a60-356c-933a-98910903370f",
                                "text": "Attention aux artistes ! nous prévint le patron. J’les paie leur poids d'bobards et j’tiens pas à m’faire agonir."
                            },
                            {
                                "example_id": "5c7d7342-50ba-405b-bf07-bb12dbf07b3b",
                                "sense_id": "ae49f8e8-7a60-356c-933a-98910903370f",
                                "text": "Je ne me laisse pas éblouir par les bobards : je suis pour les actes, moi, mon cher monsieur."
                            },
                            {
                                "example_id": "dbb870a5-4063-4567-a78f-c5c86b5f24d8",
                                "sense_id": "ae49f8e8-7a60-356c-933a-98910903370f",
                                "text": "D’ailleurs on dit que les Allemands sont antisémites, mais ce n’est peut-être même pas vrai ! On nous fait avaler tant de bobards…"
                            },
                            {
                                "example_id": "fc531d5d-2f4d-4b4c-9f2e-250027c1c9cc",
                                "sense_id": "ae49f8e8-7a60-356c-933a-98910903370f",
                                "text": "« Je me suis rendu compte en vieillissant que ces slogans étaient des bobards, mais il est difficile de reprocher à un jeune de 20 ans d’être idéaliste »"
                            },
                            {
                                "example_id": "0404174a-b13d-44a3-b61b-1d0b7c919587",
                                "sense_id": "ae49f8e8-7a60-356c-933a-98910903370f",
                                "text": "Même maintenant il n’arrivait pas à y croire. Et si c’était une blague, un énorme bobard rutilant ?"
                            },
                            {
                                "example_id": "54bb6f0e-20d5-470f-be58-a55e32e77604",
                                "sense_id": "ae49f8e8-7a60-356c-933a-98910903370f",
                                "text": "– Attendez-moi là, communiste vigilant, je vais procéder à ma petite enquête moi aussi et j’espère pour vous que vous ne m’avez pas raconté de bobards !"
                            },
                            {
                                "example_id": "151eaa9d-0dd4-48b9-813c-c6130dda1d59",
                                "sense_id": "ae49f8e8-7a60-356c-933a-98910903370f",
                                "text": "Comme autres pigistes, il y avait Jean-Joël, que je trouvais un pipoteur de première, je n'arrivais même pas à comprendre comment les gens pouvaient acheter ses bobards […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f451c9f-ec7a-4f72-b5b1-38a69066123a",
                        "source_entry_id": "d54e3dc3-87ac-3578-8208-3f8af977989a",
                        "source_sense_id": "ae49f8e8-7a60-356c-933a-98910903370f",
                        "target_lang_word": "Lüge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lüge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed215df5-23dc-3aa0-b153-c08d77b300ba",
                                        "entry_id": "d0ffe14a-6d8d-3d64-832e-a7abe2f576a6",
                                        "glosses": [
                                            "falsche Aussage, mit der andere bewusst getäuscht werden sollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57d5d6e0-e705-4930-919b-ed09812bcde3",
                                                "sense_id": "ed215df5-23dc-3aa0-b153-c08d77b300ba",
                                                "text": "Die Politiker in Deutschland werden vielfach beschuldigt, dass ihre Aussagen eine einzige Lüge seien."
                                            },
                                            {
                                                "example_id": "03441275-75c3-4956-9bfe-329eb7e0c909",
                                                "sense_id": "ed215df5-23dc-3aa0-b153-c08d77b300ba",
                                                "text": "„Phantasie und Lüge sind zweierlei.“"
                                            },
                                            {
                                                "example_id": "765a5cd8-2c20-42c0-adc2-dd62811873e9",
                                                "sense_id": "ed215df5-23dc-3aa0-b153-c08d77b300ba",
                                                "text": "„Nun wurde ich noch strenger verhört und sah mich zu einer aalglatten Lüge gezwungen, um mein Ziel zu erreichen.“"
                                            },
                                            {
                                                "example_id": "44cda78f-a078-44c2-8fc3-1ac51206d1ae",
                                                "sense_id": "ed215df5-23dc-3aa0-b153-c08d77b300ba",
                                                "text": "„Die Lüge steht groß auf seinen dicken Backen geschrieben.“"
                                            },
                                            {
                                                "example_id": "19106230-c6b9-4eff-8ca8-a95f002ac160",
                                                "sense_id": "ed215df5-23dc-3aa0-b153-c08d77b300ba",
                                                "text": "„Trotz aller Schikanen, Frivolitäten und Lügen glaubte ich an sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cef8a51e-a095-4c92-bd0f-a17b85c4ee98",
                        "source_entry_id": "d54e3dc3-87ac-3578-8208-3f8af977989a",
                        "source_sense_id": "ae49f8e8-7a60-356c-933a-98910903370f",
