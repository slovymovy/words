                    },
                    {
                        "translation_id": "fe06f2c5-e7ba-48d3-a1cf-369c669dc110",
                        "source_entry_id": "8ae8ce35-d634-3dbb-8339-74c158f73c50",
                        "source_sense_id": "63019949-0949-3999-b709-5c35072affe2",
                        "source_sense_description": "die größte indigene nordamerikanische Sprache, die im Südwesten der USA gesprochen wird",
                        "target_lang_word": "Navajo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Navajo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72dbf652-7008-3e85-a87a-4787094d49d3",
                                        "entry_id": "f8e6adb0-15eb-35e6-9c16-26a83f66bca0",
                                        "glosses": [
                                            "A member of the Navajo people, currently the largest Native American tribe in North America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f8e9d86-27ae-4925-a640-2a95c734176d",
                                                "sense_id": "72dbf652-7008-3e85-a87a-4787094d49d3",
                                                "text": "As a code talker, Newman was one of a group of Navajos who learned a secret, unbreakable language that was used to send information on tactics, troop movements and orders over the radio and telephone during WWII."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Navajo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d193f4be-dcd6-3dc5-b35d-b3ac563373f9",
                                        "entry_id": "432e022f-96e9-3108-81eb-2bad295d08e6",
                                        "glosses": [
                                            "An Apachean (Southern Athabaskan) language of the Athabascan language family belonging to the Na-Dené phylum. It is spoken by 149,000 people in the American Southwest (Arizona, New Mexico, Utah, and Colorado)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13334a69-7c0a-41b3-a45e-74818d9f6d49",
                                                "sense_id": "d193f4be-dcd6-3dc5-b35d-b3ac563373f9",
                                                "text": "Endangered language communities would be thrilled with and proud of that kind of exposure for their language, like when Star Wars was dubbed into Navajo and Ojibwe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9797bc2-fa00-3112-b826-2abef02c0af6",
                                        "entry_id": "432e022f-96e9-3108-81eb-2bad295d08e6",
                                        "glosses": [
                                            "An Amerindian people who traditionally speak the Navajo language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7157d1b7-2e6b-4321-a859-f1b47925693c",
                                                "sense_id": "d9797bc2-fa00-3112-b826-2abef02c0af6",
                                                "text": "One of the last remaining members of the Navajo Code Talkers, who used their difficult-to-learn language to form an indecipherable code that helped the Allies win World War II, has died."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "889bd896-4756-4d81-aa86-f61983f63bf6",
                        "source_entry_id": "8ae8ce35-d634-3dbb-8339-74c158f73c50",
                        "source_sense_id": "63019949-0949-3999-b709-5c35072affe2",
                        "source_sense_description": "die größte indigene nordamerikanische Sprache, die im Südwesten der USA gesprochen wird",
                        "target_lang_word": "navajo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navajo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2239565-218f-3fd9-ae0a-4e4f4f6de895",
                                        "entry_id": "86617698-36bc-334d-b4b7-102bde419ba8",
                                        "glosses": [
                                            "Langue amérindienne parlée par les Navajos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "291dadfe-6a24-4bbc-bf4d-8a8c394dfab9",
                                                "sense_id": "e2239565-218f-3fd9-ae0a-4e4f4f6de895",
                                                "text": "Le navajo compte plus de locuteurs que n’importe quelle autre langue amérindienne au nord de la frontière entre le Mexique et les États-Unis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "navajo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c3479d9-8f7c-34aa-8f4d-f3e966901bcc",
                                        "entry_id": "33857543-35ee-3190-9a86-d5fcb45b0be6",
                                        "glosses": [
                                            "Relatif aux Navajos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76640440-53cf-49f3-a67c-62f88d058016",
                                                "sense_id": "9c3479d9-8f7c-34aa-8f4d-f3e966901bcc",
                                                "text": "La langue navajo."
                                            },
                                            {
                                                "example_id": "ef5c22a6-73cc-4d31-86ee-327ec796492a",
                                                "sense_id": "9c3479d9-8f7c-34aa-8f4d-f3e966901bcc",
                                                "text": "Leur langue est si particulière qu’elle fut utilisée pendant la Seconde Guerre mondiale dans la guerre du Pacifique : les services secrets américains employèrent des auxiliaires navajos qui traduisirent dans leur langue les messages les plus confidentiels avant qu'ils ne soient cryptés."
                                            },
                                            {
                                                "example_id": "37ea2b6d-9abc-4a33-8eb1-4ec91f4d456b",
                                                "sense_id": "9c3479d9-8f7c-34aa-8f4d-f3e966901bcc",
                                                "text": "En attendant ces conclusions, le tribut à payer est déjà lourd pour les territoires amérindiens navajo, particulièrement concernés par cette marée orange."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
