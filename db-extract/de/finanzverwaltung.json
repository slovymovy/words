                "senses": [
                    {
                        "sense_id": "7cf5b277-89f1-3d76-927e-3bd171ff4a02",
                        "entry_id": "a38f62fc-ee28-3f46-adc1-0b960bff7f79",
                        "glosses": [
                            "Behörde beziehungsweise Gesamtheit der Behörden, die für die Festsetzung und Erhebung von Steuern zuständig ist/sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ca1ea9-ac61-4adc-b2ff-5ff42c0d682a",
                                "sense_id": "7cf5b277-89f1-3d76-927e-3bd171ff4a02",
                                "text": "„Nach Auffassung der Finanzverwaltung ist ein eingetretener Währungsverlust grundsätzlich im Jahr der Entstehung bei der Ermittlung der ausländischen Einkünfte zu berücksichtigen.“"
                            },
                            {
                                "example_id": "4dd58f86-9978-4012-93a9-4f69f83399d4",
                                "sense_id": "7cf5b277-89f1-3d76-927e-3bd171ff4a02",
                                "text": "„Die Finanzverwaltung ist an die gesetzgeberische Entscheidung gebunden, die Beurteilung der Erhaltungswürdigkeit den entsprechenden Landesbehörden zu übertragen.“"
                            },
                            {
                                "example_id": "c573039c-6258-408c-bb80-66e2ff6c409c",
                                "sense_id": "7cf5b277-89f1-3d76-927e-3bd171ff4a02",
                                "text": "„Auf Seiten der Finanzverwaltungen wird sich mithin reichlich Spielraum für Interpretationsmöglichkeiten ergeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
