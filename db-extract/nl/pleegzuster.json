                    {
                        "sense_id": "41bdc336-c3bd-30a4-88c6-86b9e1be0c35",
                        "entry_id": "bd48c3b0-d4f8-373f-9482-5414d49fc96a",
                        "glosses": [
                            "vrouwelijke verpleger"
