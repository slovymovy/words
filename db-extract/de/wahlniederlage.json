                "senses": [
                    {
                        "sense_id": "096a4d0d-f9c5-3193-93c5-c3fba34d0291",
                        "entry_id": "4513f9b2-58bf-3966-8217-2e1f36ce1250",
                        "glosses": [
                            "das Verlieren einer Wahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1fb55e1-43c0-400e-8301-6d50b43f3816",
                                "sense_id": "096a4d0d-f9c5-3193-93c5-c3fba34d0291",
                                "text": "Der amtierende Bürgermeister muss mit einer Wahlniederlage rechnen."
                            },
                            {
                                "example_id": "f5a698e2-0ee0-4991-bfbd-6cf7168c732e",
                                "sense_id": "096a4d0d-f9c5-3193-93c5-c3fba34d0291",
                                "text": "Die Partei xy hat eine katastrophale Wahlniederlage hinnehmen müssen."
                            },
                            {
                                "example_id": "18d9b6c7-1c12-4eb7-8538-b3271f1ee2a3",
                                "sense_id": "096a4d0d-f9c5-3193-93c5-c3fba34d0291",
                                "text": "In der politischen Auseinandersetzung liegen Wahlsieg und Wahlniederlage oft sehr dicht beieinander."
                            },
                            {
                                "example_id": "36ac7633-2084-470b-8b4d-c433bb96ac64",
                                "sense_id": "096a4d0d-f9c5-3193-93c5-c3fba34d0291",
                                "text": "„Die Wahlniederlage der Muslimliga 1937, die der Kongresspartei die alleinige Regierungsmacht bescherte, veranlasste Erstere umso stärker, sich für Autonomie und Souveränität von territorial festzulegenden Einheiten in ganz Indien einzusetzen, in denen Muslime die Bevölkerungsmehrheit stellten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
