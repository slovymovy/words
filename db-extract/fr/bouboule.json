        "fr-extract.jsonl": [
            {
                "entry_id": "ace36495-bf4d-3299-ae50-786f665bbce9",
                "word": "Bouboule",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d3cc2a5-c629-3e6e-ba18-43fd3a95e0b5",
                        "entry_id": "ace36495-bf4d-3299-ae50-786f665bbce9",
                        "glosses": [
                            "Surnom parfois donné à une personne ayant une surcharge pondérale."
                        ],
                        "tags": [],
                        "note": "À l'origine plutôt affectueux, neutre ou insultant selon le cas, mais de plus en plus considéré comme inconvenant aujourd'hui",
                        "examples": [
                            {
                                "example_id": "cecf61de-1111-4220-b447-3e2b2bdb2128",
                                "sense_id": "5d3cc2a5-c629-3e6e-ba18-43fd3a95e0b5",
                                "text": "Elle posait sur son mari un regard protecteur et peiné, poussant l'exercice jusqu'à lui caresser la joue en disant :\n– Hein, Bouboule, que tu es un émotif?"
                            },
                            {
                                "example_id": "939527fb-a630-4f1e-b8b3-2a13c7f1760b",
                                "sense_id": "5d3cc2a5-c629-3e6e-ba18-43fd3a95e0b5",
                                "text": "Fidèle à sa rigueur, Jean-Pierre Koscielniak ne s'aventure pas dans les légendes et rumeurs entourant Prosper Delpuch (alias « Bouboule », surnom donné à la fin de sa vie, eu égard à son embonpoint)."
                            },
                            {
                                "example_id": "a909cbb1-b54a-4a9d-ad0a-797bd86fd45b",
                                "sense_id": "5d3cc2a5-c629-3e6e-ba18-43fd3a95e0b5",
                                "text": "Bouboule et Freluquet en ont ras la casquette\nSociologie. L'apparence physique (poids, taille, look) est le « motif principal des formes d'ostracismes » dont souffrent les jeunes, selon une étude."
                            }
                        ]
                    }
                ],
