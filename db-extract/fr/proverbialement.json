                "senses": [
                    {
                        "sense_id": "32cdab4d-a9f1-334b-8f69-0bfab366cc6f",
                        "entry_id": "0f86ac78-8ca5-3037-a451-d3439e3bc89a",
                        "glosses": [
                            "D’une manière proverbiale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7477af73-77ac-44a1-9dae-c88d1273b5fc",
                                "sense_id": "32cdab4d-a9f1-334b-8f69-0bfab366cc6f",
                                "text": "À mesure qu’on a drainé, déjonqué, défriché la Bresse, elle a cessé de disséminer des fièvres ; le Bressan, chaussé de sabots sur sa terre de glaise, s’en est regaillardi d’autant, lui qu’on surnommait proverbialement, par une vive allitération, le laid, lourd, long, lent, lâche."
                            },
                            {
                                "example_id": "360d20e3-d437-41ae-adea-5f2c363fa8ae",
                                "sense_id": "32cdab4d-a9f1-334b-8f69-0bfab366cc6f",
                                "text": "On dit proverbialement : tant va la cruche à l’eau qu’à la fin elle se casse."
                            }
                        ]
                    }
