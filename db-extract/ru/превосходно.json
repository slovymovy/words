                                                "example_id": "ded1b0bf-d9e2-4df0-8a80-4a3314984bd9",
                                                "sense_id": "3ea24f71-0564-3476-99aa-065396114203",
                                                "text": "„Der Herzog von Guise war auch ein vortrefflicher Schütze, aber dabei ein vortrefflicher Hofmann.“"
                                            }
                                        ],
