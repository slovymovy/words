                                    {
                                        "sense_id": "7051776c-bd6a-3bfe-beb4-2b694f7b8d68",
                                        "entry_id": "931d639f-f51f-3454-addd-52477d8e395f",
                                        "glosses": [
                                            "opakovaně v neurčeném počtu případů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeba61a2-8384-49e4-93d1-9e02cc8e9ff8",
                                                "sense_id": "7051776c-bd6a-3bfe-beb4-2b694f7b8d68",
                                                "text": "Myslím, že v tom domě nebydlí, i když už jsem ho tam několikrát viděl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
