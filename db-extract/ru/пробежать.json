                "senses": [
                    {
                        "sense_id": "f8593d73-8992-32b1-95fa-129574158c6f",
                        "entry_id": "75b3e72f-8a98-3475-aca0-43dd5344f09b",
                        "glosses": [
                            "бегом преодолеть какое-то расстояние"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f1f85ddd-cb8a-3c2d-b6b7-3aa2fa9ec5df",
                        "entry_id": "75b3e72f-8a98-3475-aca0-43dd5344f09b",
                        "glosses": [
                            "бегом переместиться мимо чего-либо или через что-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "370f843b-20b9-3198-bf56-3d65de3f6a34",
                        "entry_id": "75b3e72f-8a98-3475-aca0-43dd5344f09b",
                        "glosses": [
                            "перен. быстро появиться и исчезнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c63b35e5-a347-419a-83fe-fc549d452c5d",
                                "sense_id": "370f843b-20b9-3198-bf56-3d65de3f6a34",
                                "text": "По его лицу пробежала лёгкая усмешка."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9e861bb-68d2-3eee-ad8c-98e04d9aa608",
                        "entry_id": "75b3e72f-8a98-3475-aca0-43dd5344f09b",
                        "glosses": [
                            "перен. быстро преодолеть некоторое расстояние"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b70c34f6-fe88-49c2-ae61-6808d60e7b13",
                                "sense_id": "f9e861bb-68d2-3eee-ad8c-98e04d9aa608",
                                "text": "По фасаду здания пробежали трещины."
                            },
                            {
                                "example_id": "25ad0766-0037-4be2-ae3d-74855a9b9dfa",
                                "sense_id": "f9e861bb-68d2-3eee-ad8c-98e04d9aa608",
                                "text": "При установке на полное время горения трубки пламени нужно пробежать верхний желобок до самого конца."
                            }
                        ]
                    },
                    {
                        "sense_id": "6801ed65-94d5-3b5d-a972-e173306acb11",
                        "entry_id": "75b3e72f-8a98-3475-aca0-43dd5344f09b",
                        "glosses": [
                            "перен. обычно в сочетании с «глазами» быстро просмотреть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654dbb4d-ac8d-46f0-b666-2591f50e8020",
                                "sense_id": "6801ed65-94d5-3b5d-a972-e173306acb11",
                                "text": "Он быстро пробежал первые строки, и сердце у него радостно забилось."
                            },
                            {
                                "example_id": "6491c553-feee-4439-99e5-0cb27a331b2e",
                                "sense_id": "6801ed65-94d5-3b5d-a972-e173306acb11",
                                "text": "Он пробежал глазами договор, разместившийся на двух страницах убористого компьютерного текста"
                            }
                        ]
                    },
                    {
                        "sense_id": "2350f537-aaf9-39eb-9863-4d676ffcd195",
                        "entry_id": "75b3e72f-8a98-3475-aca0-43dd5344f09b",
                        "glosses": [
                            "разг. проехать, покрыть какое-либо расстояние (о колёсном транспортном средстве)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
