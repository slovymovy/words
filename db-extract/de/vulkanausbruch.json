                "senses": [
                    {
                        "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                        "entry_id": "92af820e-73f0-39fd-a91d-db51732806cd",
                        "glosses": [
                            "vulkanischer Ausstoß von Lava, Gestein und Asche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f33681f0-8a10-438f-9006-aa8f6b614a60",
                                "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                                "text": "Bei dem Vulkanausbruch starben keine Menschen, weil sie rechtzeitig evakuiert wurden."
                            },
                            {
                                "example_id": "a6be8807-880b-460e-a1d4-c3268acb0f13",
                                "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                                "text": "„Du bist ziemlich sicher, dass Roland alle Sagas gelesen hat und noch weiß, wann der Vulkanausbruch von Surtsey war.“"
                            },
                            {
                                "example_id": "c7e1e53a-691f-416e-b332-5cf6278f71ec",
                                "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                                "text": "„Vor etwa 200.000 Jahren schufen die Vulkanausbrüche des Bellerbergs die Voraussetzungen für die spätere Basaltlavagewinnung und -verarbeitung in Mayen.“"
                            },
                            {
                                "example_id": "26b484ef-5497-4b26-9d92-7328528dc69b",
                                "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                                "text": "„Die Vulkanausbrüche Islands haben auch ein Reiseziel erschaffen, das ich bis heute nicht erreichen konnte: 1963 ist vor der Südküste Islands eine neue Insel entstanden.“"
                            },
                            {
                                "example_id": "66958477-7274-4b7c-a8d6-ecfd63353f55",
                                "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                                "text": "„In Millionen von Jahren haben ständige Vulkanausbrüche die Berge geformt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
