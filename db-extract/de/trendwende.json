                "senses": [
                    {
                        "sense_id": "5fda1155-65c6-3fe6-afd4-cf1cc088eafd",
                        "entry_id": "5a3d82b5-5877-3f0f-8224-9c130caea394",
                        "glosses": [
                            "einschneidende Veränderung einer bestehenden Tendenz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10aa299f-febc-452b-bbbb-5f3983999739",
                                "sense_id": "5fda1155-65c6-3fe6-afd4-cf1cc088eafd",
                                "text": "„Im Zuge der neoliberalen Trendwende gelten solche Institutionen als unmodern und sterben allmählich aus.“"
                            },
                            {
                                "example_id": "2b6e7fc7-af8f-42f7-b62b-d7b08c9e72e9",
                                "sense_id": "5fda1155-65c6-3fe6-afd4-cf1cc088eafd",
                                "text": "„Finanzstadtrat Peter Hanke (SPÖ) kündigt für das Jahr 2020 ein Nulldefizit und eine Trendwende im Schuldenbereich an.“"
                            },
                            {
                                "example_id": "1331a2aa-b6fc-46ed-a594-1a739725face",
                                "sense_id": "5fda1155-65c6-3fe6-afd4-cf1cc088eafd",
                                "text": "„Die CO2-Emissionen der Menschheit stagnieren derzeit bei 40 Milliarden Tonnen jährlich, viel zu viel, um eine Trendwende bei der kommenden Klimaüberhitzung auch nur einzuleiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
