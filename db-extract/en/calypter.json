                        "glosses": [
                            "Either of two rounded lobes at the posterior base of the wing in many true flies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "977ab58c-de2e-4ecd-ad8f-ba3493030a40",
                                "sense_id": "195e50c4-54bc-3422-b9db-8eb0f1f03f46",
                                "text": "The acrosticals are irregularly paired, with numerous accessory setulae between the rows; the lower calypters protrude distinctly beyond the margin of the upper;[…]."
                            },
                            {
                                "example_id": "1a709327-6e3d-4eaa-9f2b-cdddf686c3b3",
                                "sense_id": "195e50c4-54bc-3422-b9db-8eb0f1f03f46",
                                "text": "The wings are hyaline and slightly smoky yellowish, while the calypters and wing fringes are pale yellowish (Steyskal, 1980)."
                            },
                            {
                                "example_id": "c7ac3f0c-6900-4f92-b654-b352f6031301",
                                "sense_id": "195e50c4-54bc-3422-b9db-8eb0f1f03f46",
                                "text": "Traditionally this taxon^([Schizophora]) is subdivided into Calyptratae and Acalyptratae, based respectively on the strong or reduced development of the lower calypter."
                            }
                        ]
