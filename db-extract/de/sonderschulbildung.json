                "senses": [
                    {
                        "sense_id": "8b3b3033-ee57-38e9-990e-09f9749979fa",
                        "entry_id": "36324585-845d-3a6b-a522-437a687b9e78",
                        "glosses": [
                            "Schulbildung, die durch eine Sonderschule vermittelt wird"
                        ],
                        "tags": [
                            "Bildung"
                        ],
                        "examples": [
                            {
                                "example_id": "5e0b52ff-bd73-4985-b058-ad4c09f0661f",
                                "sense_id": "8b3b3033-ee57-38e9-990e-09f9749979fa",
                                "text": "„Heute umfasst die Sonderschulbildung ein breites Arbeitsspektrum: Von der eng begrenzten handwerklichen Zielrichtung für die Gewerbeklassen bis hin zu vielfältigen Lehrprogrammen, die den Fähigkeiten, dem Entwicklungsstand, dem Gesundheitszustand der SchülerInnen [sic] und nicht zuletzt den örtlichen bzw. regionalen Möglichkeiten entsprechen.“"
                            },
                            {
                                "example_id": "3801d4f3-1cb0-491b-a2e2-20620577609b",
                                "sense_id": "8b3b3033-ee57-38e9-990e-09f9749979fa",
                                "text": "„Für diese beiden Systeme gelten (oder galten zumindest noch bis vor kurzem) verschiedene rechtliche Regelungen, d. h. andere Gesetze für die reguläre Schulbildung als für die Sonderschulbildung“ (Meijer/Soriano/Watkins 2003‚ S. 8).“"
                            },
                            {
                                "example_id": "ac1aba8b-9b66-4c2b-a973-d2de09993560",
                                "sense_id": "8b3b3033-ee57-38e9-990e-09f9749979fa",
                                "text": "„Das Auskunftszentrum zur Sonderschulbildung soll sich dem systematischen Austausch von Ergebnissen der wissenschaftlichen Arbeit, der Schulpraxis und der Lehrerbildung auf diesem Gebiet widmen.“"
                            },
                            {
                                "example_id": "84bb0020-5c36-447a-8ee2-9ee87ca3ee9a",
                                "sense_id": "8b3b3033-ee57-38e9-990e-09f9749979fa",
                                "text": "„Um die Sonderschulbildung zu fördern, hat die Regierung 1989 dafür einen speziellen Fonds eingerichtet, der von der zentralen Finanzbehörde jährlich mit 23 Millionen Yuan ausgestattet wird.“"
                            },
                            {
                                "example_id": "4216e71f-4de6-47a1-8350-30c7d802564f",
                                "sense_id": "8b3b3033-ee57-38e9-990e-09f9749979fa",
                                "text": "„Der Anteil der Lehranfänger/innen mit nicht mehr als Sonderschulbildung liegt seit 1980 unter 2,0 %.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
