            {
                "entry_id": "46be245d-3447-309b-9374-3e5dab4e2b61",
                "word": "Golfstroom",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "331ba6e6-0eee-39ee-bb2d-2c94fe31230f",
                        "entry_id": "46be245d-3447-309b-9374-3e5dab4e2b61",
                        "glosses": [
                            "warme zeestroming in het noorden van de Atlantische Oceaan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02b6393a-e01b-4618-9c28-0f0b8aef89da",
                                "sense_id": "331ba6e6-0eee-39ee-bb2d-2c94fe31230f",
                                "text": "Normaal gesproken hebben we in het oostelijk deel van de Noord-Atlantische Oceaan de Golfstroom, een warme oceaanstroming die zorgt voor een mild klimaat."
                            },
                            {
                                "example_id": "79778f2e-12d5-40b6-a895-5e775d22db4b",
                                "sense_id": "331ba6e6-0eee-39ee-bb2d-2c94fe31230f",
                                "text": "Nederland ligt bijvoorbeeld rond 52 graden noorderbreedte - net als Canada, maar daar is het 's winters flink wat kouder dan bij ons, door het ontbreken van de Golfstroom."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6b47b7d-3adb-4019-8486-f4e85c349b81",
                        "source_entry_id": "46be245d-3447-309b-9374-3e5dab4e2b61",
                        "source_sense_id": "331ba6e6-0eee-39ee-bb2d-2c94fe31230f",
                        "target_lang_word": "Golfstrom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Golfstrom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b898d663-c8ef-3bb5-ac8a-82bbdd2405a7",
                                        "entry_id": "75c19ca6-62e4-3f2a-9a4f-4e94a3ccf71e",
                                        "glosses": [
                                            "warme Meeresströmung im Atlantischen Ozean"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13e32b15-d6dc-47d0-a671-04a36687b55f",
                                                "sense_id": "b898d663-c8ef-3bb5-ac8a-82bbdd2405a7",
                                                "text": "„Der Golfstrom hat sich zwei- bis dreimal so rasch erwärmt wie der Atlantische Ozean.“"
                                            },
                                            {
                                                "example_id": "ad74b8d6-282a-424b-b442-d28f5faf5a14",
                                                "sense_id": "b898d663-c8ef-3bb5-ac8a-82bbdd2405a7",
                                                "text": "Der Golfstrom ist wichtig für das milde Klima in Westeuropa. Nun deutet eine Studie darauf hin, dass sich die Strömung abschwächt. Ursache sei der Klimawandel, vermuten die Forscher."
                                            },
                                            {
                                                "example_id": "1b8ebb9b-4b43-40d8-ad32-b02d44fc386f",
                                                "sense_id": "b898d663-c8ef-3bb5-ac8a-82bbdd2405a7",
                                                "text": "„Der Golfstrom, der an der Insel vorbeistreift, macht die Winter im Flachland milde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
