                        "glosses": [
                            "Unterricht über einen bestimmten Zeitraum, der dem Aufbau oder der Verbesserung der Französischkenntnisse der Kursteilnehmer dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab1828c0-138a-431c-b8f3-c06c9439d91a",
                                "sense_id": "aeff86ed-8f14-3276-9080-f0babaa4bf5b",
                                "text": "„Im Französischkurs im Kindergarten sind noch zwei Plätze frei. Aber du musst dich schnell entscheiden.“"
                            },
                            {
                                "example_id": "a00dc4cc-537b-46b4-b267-c0157ac48abf",
                                "sense_id": "aeff86ed-8f14-3276-9080-f0babaa4bf5b",
                                "text": "„Ob alle rund 600 Basler Wagenführer in den Französischkurs müssen oder nur ein Teil, sei derzeit noch offen.“"
                            }
                        ],
