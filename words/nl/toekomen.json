{
    "word_family": [
        "komst",
        "toekomst",
        "aankomen",
        "inkomen",
        "uitkomen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae8e2004-27ff-3958-91cf-c11d7def94c2",
                    "sense_definition": "Op een bepaalde bestemming arriveren.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "arriveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kom</w> morgen <w>toe</w> op het vliegveld om tien uur.",
                            "target_lang_translations": {
                                "en": "I will <w>arrive</w> at the airport tomorrow at ten o'clock."
                            }
                        },
                        {
                            "text": "Wanneer de trein eindelijk <w>toekomt</w>, kunnen we onze reis voortzetten.",
                            "target_lang_translations": {
                                "en": "When the train finally <w>arrives</w>, we can continue our journey."
                            }
                        }
                    ],
                    "synonyms": [
                        "aankomen",
                        "arriveren"
                    ],
                    "antonyms": [
                        "vertrekken"
                    ],
                    "common_phrases": [
                        "veilig toekomen",
                        "op tijd toekomen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To arrive at a specific destination."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arrive",
                                "target_lang_sense_clarification": "to reach a destination"
                            },
                            {
                                "target_lang_word": "get in",
                                "target_lang_sense_clarification": "to arrive, especially of transport"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "baa2d4cb-49de-3407-9387-3b736bc199de",
                    "sense_definition": "Ervoor zorgen dat iemand iets ontvangt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bezorgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik laat u hier de beloofde documenten <w>toekomen</w> via de post.",
                            "target_lang_translations": {
                                "en": "I am <w>sending</w> you the promised documents here by mail."
                            }
                        },
                        {
                            "text": "Zou je mij die informatie zo snel mogelijk kunnen laten <w>toekomen</w>?",
                            "target_lang_translations": {
                                "en": "Could you <w>forward</w> that information to me as soon as possible?"
                            }
                        }
                    ],
                    "synonyms": [
                        "bezorgen",
                        "sturen",
                        "toezenden"
                    ],
                    "common_phrases": [
                        "laten toekomen",
                        "informatie toekomen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vaak in zakelijke correspondentie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To ensure that someone receives something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "send",
                                "target_lang_sense_clarification": "to cause something to be delivered"
                            },
                            {
                                "target_lang_word": "forward",
                                "target_lang_sense_clarification": "to send on or transmit information"
                            },
                            {
                                "target_lang_word": "provide",
                                "target_lang_sense_clarification": "to supply or make available"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30685d6f-51ef-3e40-adf9-a0666feaa5c6",
                    "sense_definition": "Ergens recht op hebben of iets verdienen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recht hebben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit salaris <w>komt</w> je echt <w>toe</w> na al dat harde werk.",
                            "target_lang_translations": {
                                "en": "This salary is truly <w>due</w> to you after all that hard work."
                            }
                        },
                        {
                            "text": "De eer die hem <w>toekomt</w>, wordt eindelijk publiekelijk erkend.",
                            "target_lang_translations": {
                                "en": "The honor that <w>belongs</w> to him is finally being publicly recognized."
                            }
                        }
                    ],
                    "synonyms": [
                        "behorend",
                        "verdienen"
                    ],
                    "common_phrases": [
                        "iemand toekomen",
                        "rechtens toekomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To have a right to something or to deserve it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be due to",
                                "target_lang_sense_clarification": "to be owed to someone"
                            },
                            {
                                "target_lang_word": "belong to",
                                "target_lang_sense_clarification": "to be rightfully someone's"
                            },
                            {
                                "target_lang_word": "deserve",
                                "target_lang_sense_clarification": "to be worthy of something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}