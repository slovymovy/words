                "senses": [
                    {
                        "sense_id": "09914f52-fa03-3db0-82da-6bc286c33893",
                        "entry_id": "7be84118-6231-32c9-9645-0aa5e97820de",
                        "glosses": [
                            "Minorer, diminuer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d14da964-af18-48d5-ae4b-4fb5deddecd1",
                                "sense_id": "09914f52-fa03-3db0-82da-6bc286c33893",
                                "text": "Face à cette menace, l’Angleterre doit encore faire contrepoids et les colonies doivent unir leurs efforts sans toutefois minoriser le Bas-Canada."
                            },
                            {
                                "example_id": "03f088a0-757b-4ce9-a0c3-009d3cf5cc99",
                                "sense_id": "09914f52-fa03-3db0-82da-6bc286c33893",
                                "text": "Ce exemple illustre comment, à travers une initiative de visibilisation de personnes minorisées, l'acharnement qui a suivi a rendu le sigle totalement inutilisable."
                            },
                            {
                                "example_id": "6b6d50c3-ea53-40b0-a0ce-0a74009d1881",
                                "sense_id": "09914f52-fa03-3db0-82da-6bc286c33893",
                                "text": "Faudra-t-il, pour parler le même langage, qu’elle se laisse minoriser ?"
                            }
                        ]
                    }
