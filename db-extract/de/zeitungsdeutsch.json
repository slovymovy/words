                    {
                        "sense_id": "7a9b9ef6-c2c4-3852-baf9-0c6a7268fae4",
                        "entry_id": "20c96d23-0e31-3cd4-9e51-4ceb9e0725ac",
                        "glosses": [
                            "Ausprägung des Deutschen in Zeitungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43ab7958-1385-4469-a733-5c439520e920",
                                "sense_id": "7a9b9ef6-c2c4-3852-baf9-0c6a7268fae4",
                                "text": "„Daß Zeitungsdeutsch und Pressesprache späterhin stets im Kreuzfeuer sprachkritischer Auseinandersetzungen verblieben, bedarf keiner Hervorhebung, und das erst recht im heutigen Zeitalter der Massenmedien.“"
                            },
                            {
                                "example_id": "91def405-1baa-474e-b0e7-362b5949d6bd",
                                "sense_id": "7a9b9ef6-c2c4-3852-baf9-0c6a7268fae4",
                                "text": "„Die unbekannte Beifahrerin war noch an der Unfallstelle ihren Verletzungen erlegen, wie es im üblichen Zeitungsdeutsch hieß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
