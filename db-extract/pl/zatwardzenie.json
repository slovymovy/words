                                        "entry_id": "898229ee-848c-323b-9556-8ba55483a707",
                                        "glosses": [
                                            "nahromadění většího množství lidí, vozidel či jiných pohyblivých entit, ztěžující další pohyb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b6147ef-f08e-4546-9bb9-7215617124cd",
                                                "sense_id": "30b58c63-2d9b-389a-bee4-efe591d715bd",
                                                "text": "Protože taková zácpa nastane patrně tuze často, přemýšlí o tom mnoho lidí. Není dosud rozhodnuto, bude-li se chodit po střechách nebo pod zemí; jenom to je jisto, že na zemi to už nejde, což je pozoruhodná vymoženost moderní civilizace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fdbdb1a-a202-3b1f-9b99-0132920847f6",
                                        "entry_id": "898229ee-848c-323b-9556-8ba55483a707",
                                        "glosses": [
                                            "obtížné vylučování tuhé stolice"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab771306-1efd-4787-b96d-e289fa943cb1",
                                                "sense_id": "9fdbdb1a-a202-3b1f-9b99-0132920847f6",
                                                "text": "To se rozumí, začali k němu volat všechny možné doktory, a jak už to chodí, jeden lazebník říkal, že ty závratě jsou od přepracování, druhý, že je to nějaká nemoc labyrintu, třetí, že to pochází od zácpy, a čtvrtý, že to způsobuje nedokrevnost mozku;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5267f94b-3bd1-3220-8f55-fe4cc80a6980",
                                        "entry_id": "898229ee-848c-323b-9556-8ba55483a707",
                                        "glosses": [
                                            "objekt bránící pohybu, plnící funkci ucpávky"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "325ba975-0d80-48a6-b5e7-d0fe94169934",
                                                "sense_id": "5267f94b-3bd1-3220-8f55-fe4cc80a6980",
                                                "text": "Opět za několik okamžiků bylo slyšeti uvnitř stromu těžký pád — Kudjo vyňal zácpu z hořejšího otvoru — silný dým vyrazil — medvěd byl již asi mrtev; neboť v takovém dýmu nelze nižádnému živočichu živu býti."
                                            }
                                        ]
                                    }
