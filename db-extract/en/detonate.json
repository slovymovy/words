                                                "example_id": "22f2b4b3-df37-4c88-bed0-7026d9f6b5fc",
                                                "sense_id": "ff7613c6-d7fb-3353-892a-8b6f7671d9f5",
                                                "text": "Окруженное пеной, судно направлялось на юг, взрывая воду острым носом."
                                            },
                                            {
                                                "example_id": "75e199bf-e8a0-405f-959e-ba094c144524",
                                                "sense_id": "ff7613c6-d7fb-3353-892a-8b6f7671d9f5",
                                                "text": "Бразды пушистые взрывая, // Летит кибитка удалая; // Ямщик сидит на облучке // В тулупе, в красном кушаке."
                                            },
                                            {
                                                "example_id": "2c26c093-c586-418e-88c4-ba545ab50156",
                                                "sense_id": "ff7613c6-d7fb-3353-892a-8b6f7671d9f5",
                                                "text": "Борона ездит в неумелых и растерянных руках, лошади бегут, зубья легонько взрывают почву только с поверхности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa5d179-8256-3911-93b3-e2bdef2e8a8a",
                                        "entry_id": "991cb50b-bffc-3aed-a019-1d632700c8f9",
                                        "glosses": [
                                            "перен., разг. приводить в беспорядок"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "445e0cb6-214f-4e4c-9197-880c743317f8",
                        "source_entry_id": "d2bdf622-c45b-3389-9aa8-e4058b1e3246",
                        "source_sense_description": "to cause to explode",
                        "target_lang_word": "взорва́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "взорва́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b635a44d-7143-363c-8212-c2634ae39bcb",
                                        "entry_id": "9fdca204-a02c-30c0-9db3-6923763e674c",
                                        "glosses": [
                                            "произвести взрыв чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6335c2e3-448e-49eb-8fef-04d8e8c65839",
                                                "sense_id": "b635a44d-7143-363c-8212-c2634ae39bcb",
                                                "text": "Взорвать бомбу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fe06792-bdd5-3381-9b56-52d492504437",
                                        "entry_id": "9fdca204-a02c-30c0-9db3-6923763e674c",
                                        "glosses": [
                                            "разрушить что-либо взрывом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c374eeee-cd03-4caf-8bc5-83c634e52584",
                                                "sense_id": "8fe06792-bdd5-3381-9b56-52d492504437",
                                                "text": "Взорвать мост."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc76ed52-3d64-35d0-a473-8b23a31be776",
                                        "entry_id": "9fdca204-a02c-30c0-9db3-6923763e674c",
                                        "glosses": [
                                            "перен. резко изменить что-либо, вызвать значительное потрясение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a68d64-fe4e-47a3-994d-9a123fd9d46d",
                                                "sense_id": "bc76ed52-3d64-35d0-a473-8b23a31be776",
                                                "text": "Сидорова буквально взорвала парламент своими эмоциональными выступлениями."
                                            },
                                            {
                                                "example_id": "132f874b-a09a-4058-9e72-2abf4a01b52a",
                                                "sense_id": "bc76ed52-3d64-35d0-a473-8b23a31be776",
                                                "text": "Она взорвала музыкальный мир своими хитами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b425b4b9-1d0f-3841-bd0b-f64769315838",
                                        "entry_id": "9fdca204-a02c-30c0-9db3-6923763e674c",
                                        "glosses": [
                                            "жарг. выкурить какое-то количество, часть наркотического вещества"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04696b47-2bf0-4396-8d35-87bb7a8d52e2",
                                                "sense_id": "b425b4b9-1d0f-3841-bd0b-f64769315838",
                                                "text": "Он взорвал три банки и не закашлялся."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "325a9f4d-282e-4a3d-b7cc-22989fd6a8ba",
                        "source_entry_id": "d2bdf622-c45b-3389-9aa8-e4058b1e3246",
                        "source_sense_description": "to cause to explode",
                        "target_lang_word": "детони́ровать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "детони́ровать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "34cffc71-bd3f-34a8-9365-94e704b8d39f",
                                        "entry_id": "ef6da8e3-3238-35b3-89d8-5e02940b34bb",
                                        "glosses": [
                                            "спец. мгновенно взрываться под действием детонации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72d5c10c-2386-4405-a72b-9af2974f7694",
                                                "sense_id": "34cffc71-bd3f-34a8-9365-94e704b8d39f",
                                                "text": "С мостика «С-13» были видны два высоких султана, а затем один за другим раздались еще три мощных взрыва, ― вероятно, детонировал боезапас."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "детони́ровать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3fb72e47-2a24-3290-9e8f-51789acecaad",
                                        "entry_id": "b12ef031-7f7e-3e0e-8fd0-3ad00297504c",
                                        "glosses": [
                                            "муз. отклоняться от правильного тона при пении или игре на музыкальном инструменте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca841d2a-56b7-4fba-8965-6f79c3fc5c52",
                                                "sense_id": "3fb72e47-2a24-3290-9e8f-51789acecaad",
                                                "text": "Представьте себе, что певец, певший с успехом, вдруг, под старость, узнает, что он всю жизнь детонировал при пении."
                                            },
                                            {
                                                "example_id": "e260471d-f389-4bd4-8b76-2eb8884bdbb5",
                                                "sense_id": "3fb72e47-2a24-3290-9e8f-51789acecaad",
                                                "text": "Те же, что поют плохо, бездарные песни, да ещё детонируют ― те поют друг перед дружкой и хотят сниматься."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58b9bcdb-08a9-3c52-9f9f-818d8e1fbc32",
                                        "entry_id": "b12ef031-7f7e-3e0e-8fd0-3ad00297504c",
                                        "glosses": [
                                            "техн. изменять обычный ритм работы; стучать (о двигателях внутреннего сгорания)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
