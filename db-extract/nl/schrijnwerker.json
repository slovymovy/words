                                    },
                                    {
                                        "sense_id": "8436eba7-53b6-34f9-8842-21e285121625",
                                        "entry_id": "637e6e9c-ead2-3127-8111-25ee6165b998",
                                        "glosses": [
                                            "A woodworking machine used to prepare edges of wooden elements to join to other wood pieces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "joiner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de5bcd9b-506e-3e4b-821e-24bdaef93c53",
                                        "entry_id": "369addfd-d055-383a-807a-bb79396ee549",
                                        "glosses": [
                                            "A thing that joins two separate items, e.g. software to connect video or music clips."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43bae88a-14f8-4be7-8ec7-9b76f9a9beff",
                                                "sense_id": "de5bcd9b-506e-3e4b-821e-24bdaef93c53",
                                                "text": "The zero-width joiner (ZWJ) has a code point but no corresponding symbol. It is used to connect two or more other Unicode code points to create a new \"compound character\" with a unique glyph all its own. […] I'm making a point of mentioning Ninja Cat because it is another example of the use of zero-width joiners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf9b2922-4c78-3cfc-97b9-9031f362ccd6",
                                        "entry_id": "369addfd-d055-383a-807a-bb79396ee549",
                                        "glosses": [
                                            "A person who joins societies or organizations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0164eeb-d2c0-493a-bae5-8d52201814b5",
                                                "sense_id": "cf9b2922-4c78-3cfc-97b9-9031f362ccd6",
                                                "text": "I am not a joiner. I am reluctant to sign up as a member of any organization, because I generally can't find myself or my ideas in it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c76265-c965-34ae-b049-ead00023beb3",
                                        "entry_id": "369addfd-d055-383a-807a-bb79396ee549",
                                        "glosses": [
                                            "Synonym of hensopper."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6b147c3-8ba0-4f84-8d4c-99df315a204f",
                        "source_entry_id": "ee2249ea-2568-3c6b-977d-6a70de2b7616",
                        "source_sense_id": "5c6fd690-1295-3fa4-acaa-5335c4b411f2",
                        "target_lang_word": "ébéniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ébéniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cdb8ff2e-8699-34f7-92c7-c3fea303bb00",
                                        "entry_id": "e8539263-05ef-3579-9499-66f9d9171c18",
                                        "glosses": [
                                            "Ouvrier qui travaille en ébène et autres bois précieux pour en faire des meubles ou qui fait des ouvrages d’ébénisterie et de marqueterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fddebe4-a60c-4497-90f2-a34646b6d67b",
                                                "sense_id": "cdb8ff2e-8699-34f7-92c7-c3fea303bb00",
                                                "text": "C'est le bois d'ébène, une des premières essences exotiques utilisées au début du xviiᵉ siècle pour habiller les meubles qui donna son nom au terme ébéniste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31953e45-2a22-3546-9bae-5c6eacc76759",
                                        "entry_id": "e8539263-05ef-3579-9499-66f9d9171c18",
                                        "glosses": [
                                            "Menuisier, fabricant ou marchand de meubles de qualité ou de luxe."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6834df9f-d8e9-4330-af56-48a10d4fd8e4",
                                                "sense_id": "31953e45-2a22-3546-9bae-5c6eacc76759",
                                                "text": "D’un coup de manivelle, on escamote la bibliothèque, la table de lit ou le prie-Dieu. Une « table mécanique », conçue par le même ébéniste, se transforme en clin d’œil en support d’écriture ou en cabinet de toilette."
                                            },
                                            {
                                                "example_id": "280ee9e4-1fa5-49d2-be5b-d0de666455b9",
                                                "sense_id": "31953e45-2a22-3546-9bae-5c6eacc76759",
                                                "text": "— Camille-Eugène-Marie Dieudonné. Il a vingt-six ans, quand éclate l’affaire Bonnot. De métier, il est ouvrier ébéniste ; d’idées : anarchiste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
