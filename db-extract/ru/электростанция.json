                ],
                "senses": [
                    {
                        "sense_id": "fb0adcaa-f8cd-390e-b7f7-c1ba467ef644",
                        "entry_id": "37aa56b9-69ad-3907-8ec6-edfc416c9da2",
                        "glosses": [
                            "сокр. от электрическая станция — предприятие, включающее совокупность установок и сооружений, необходимых для производства электрической энергии"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8155b949-422c-458c-8ec0-353dbd3d3383",
                        "source_entry_id": "37aa56b9-69ad-3907-8ec6-edfc416c9da2",
                        "source_sense_id": "fb0adcaa-f8cd-390e-b7f7-c1ba467ef644",
                        "target_lang_word": "power plant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "power plant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25526573-2420-3f5b-a668-9910f53c47b8",
                                        "entry_id": "0e6f2ea3-6d7d-3641-8430-64663654be95",
                                        "glosses": [
                                            "A station built for the production of electric power; a power station."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eb29e19-51b8-4d4b-8bef-cf4bb7f79a60",
                                                "sense_id": "25526573-2420-3f5b-a668-9910f53c47b8",
                                                "text": "All of this areas power comes from the nuclear power plant across the river."
                                            },
                                            {
                                                "example_id": "cc179228-eaca-4212-86d4-ec1cbf67cfdb",
                                                "sense_id": "25526573-2420-3f5b-a668-9910f53c47b8",
                                                "text": "Fortuitously, Marge is looking for a job after an endless hiatus from the working world. After Lisa helps her mother “polish” up her résumé so that she now appears to be the most accomplished woman in the world, Marge lands a job at the power plant operating a machine her ridiculously padded résumé claims she helped invent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5627bf29-d9a2-3f8a-ba34-14c7db7f8d48",
                                        "entry_id": "0e6f2ea3-6d7d-3641-8430-64663654be95",
                                        "glosses": [
                                            "The portion of a vehicle devoted to providing energy for motion; the engine or motor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ed6f4c7-5049-49e7-9674-221f19b38ae6",
                                                "sense_id": "5627bf29-d9a2-3f8a-ba34-14c7db7f8d48",
                                                "text": "A train without the power plant is just a bunch of metal boxes on wheels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "330632b2-472b-4e41-b0ae-2c284d37b5c9",
                        "source_entry_id": "37aa56b9-69ad-3907-8ec6-edfc416c9da2",
                        "source_sense_id": "fb0adcaa-f8cd-390e-b7f7-c1ba467ef644",
                        "target_lang_word": "electric power plant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9b34cf4b-a829-428d-bea6-c41c4fb04346",
                        "source_entry_id": "37aa56b9-69ad-3907-8ec6-edfc416c9da2",
                        "source_sense_id": "fb0adcaa-f8cd-390e-b7f7-c1ba467ef644",
                        "target_lang_word": "power station",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "power station",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "658bdecd-7e0b-3eef-8f23-f6a0692ab0c5",
                                        "entry_id": "6eff8e6d-1494-3bb2-9e23-d6aaf2d28e0d",
                                        "glosses": [
                                            "An industrial complex where electricity is produced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3032dc5b-5736-4933-acc7-3cc04f7a138c",
                                                "sense_id": "658bdecd-7e0b-3eef-8f23-f6a0692ab0c5",
                                                "text": "All the bigger towns in this vast area are to have new power stations. Yinchuan and Bayenhot in Ningsia province, Sining in Chinghai, Tienshui, Tunhchuan and Paochi in Shensi, and Tihua in Sinkiang have all been mentioned in Press reports."
                                            },
                                            {
                                                "example_id": "37ca6817-a279-4ab5-9790-ec9b647e224c",
                                                "sense_id": "658bdecd-7e0b-3eef-8f23-f6a0692ab0c5",
                                                "text": "The Underground would eventually be powered by two giant power stations, as we will see, before plugging itself directly into the National Grid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3133d41-1a9b-4956-9587-f26d6fae864c",
                        "source_entry_id": "37aa56b9-69ad-3907-8ec6-edfc416c9da2",
