{
    "word_family": [
        "zwellen",
        "zwelling",
        "opzwellen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93b7bb5f-7e0c-3382-90cc-cc71821f15ad",
                    "sense_definition": "Toenemen in omvang, luidheid of intensiteit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toenemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De orkaan was inmiddels <w>aangezwollen</w> tot categorie 3.",
                            "target_lang_translations": {
                                "en": "The hurricane had meanwhile <w>swelled</w> to category 3."
                            }
                        },
                        {
                            "text": "Het geluid van de muziek bleef maar <w>aanzwellen</w> tot het de hele zaal vulde.",
                            "target_lang_translations": {
                                "en": "The sound of the music kept <w>building up</w> until it filled the entire hall."
                            }
                        }
                    ],
                    "synonyms": [
                        "toenemen",
                        "groeien",
                        "versterken"
                    ],
                    "antonyms": [
                        "afnemen",
                        "afzwakken",
                        "krimpen"
                    ],
                    "common_phrases": [
                        "in geluid aanzwellen",
                        "tot een storm aanzwellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To increase in size, volume, loudness, or intensity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swell",
                                "target_lang_sense_clarification": "to grow gradually in force, volume, or intensity"
                            },
                            {
                                "target_lang_word": "build up",
                                "target_lang_sense_clarification": "to increase in intensity or volume"
                            },
                            {
                                "target_lang_word": "crescendo",
                                "target_lang_sense_clarification": "to increase in loudness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f442f5b-ec46-3a49-8216-e72b343df9ac",
                    "sense_definition": "Fysiek groter of dikker worden door vocht of druk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_zwellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de insectenbeet begon zijn enkel behoorlijk <w>aan</w> te <w>zwellen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the insect bite, his ankle began to <w>swell up</w> considerably."
                            }
                        },
                        {
                            "text": "De rivier begon na de zware regenval gevaarlijk <w>aan</w> te <w>zwellen</w>.",
                            "target_lang_translations": {
                                "en": "The river began to <w>swell</w> dangerously after the heavy rainfall."
                            }
                        }
                    ],
                    "synonyms": [
                        "opzwellen",
                        "zwellen"
                    ],
                    "antonyms": [
                        "slenken"
                    ],
                    "common_phrases": [
                        "door vocht aanzwellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically become larger or thicker due to fluid accumulation or pressure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swell",
                                "target_lang_sense_clarification": "to become larger physically, especially due to fluid or pressure"
                            },
                            {
                                "target_lang_word": "swell up",
                                "target_lang_sense_clarification": "to puff up or become bloated"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}