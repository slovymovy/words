                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ff45d38-a936-4475-ad0e-1b985eed8f07",
                        "source_entry_id": "3365a9ca-da2c-3ea4-916f-50e1e2fdc0b9",
                        "source_sense_id": "90969716-89f3-3c56-92fe-77e3b957d43a",
