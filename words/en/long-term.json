{
    "word_family": [
        "term",
        "mid-term",
        "short-term"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a6bbea39-35fc-3751-84c4-a61d3dbccf06",
                    "sense_definition": "Extending over or lasting for a relatively long period of time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is looking for a <w>long-term</w> solution to its financial problems rather than a quick fix.",
                            "target_lang_translations": {
                                "ru": "Компания ищет <w>долгосрочное</w> решение своих финансовых проблем, а не временную меру."
                            }
                        },
                        {
                            "text": "They entered into a <w>long-term</w> contract that will last for the next ten years.",
                            "target_lang_translations": {
                                "ru": "Они заключили <w>долгосрочный</w> контракт, который будет действовать в течение следующих десяти лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "enduring",
                        "lasting",
                        "long-standing"
                    ],
                    "antonyms": [
                        "short-term"
                    ],
                    "common_phrases": [
                        "long-term solution",
                        "long-term contract",
                        "long-term relationship",
                        "long-term goal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжающийся или длящийся в течение относительно длительного периода времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "долгосрочный",
                                "target_lang_sense_clarification": "рассчитанный на долгий срок"
                            },
                            {
                                "target_lang_word": "длительный",
                                "target_lang_sense_clarification": "продолжающийся долгое время"
                            },
                            {
                                "target_lang_word": "долговременный",
                                "target_lang_sense_clarification": "рассчитанный на длительное использование или существование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18374a89-5949-35cc-9109-ed51561402b6",
                    "sense_definition": "Becoming apparent or having an effect only after a long period of time has passed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are still studying the <w>long-term</w> effects of the new medication on patients.",
                            "target_lang_translations": {
                                "ru": "Ученые все еще изучают <w>долгосрочные</w> последствия приема нового лекарства пациентами."
                            }
                        },
                        {
                            "text": "We need to consider the <w>long-term</w> impact of climate change on coastal cities.",
                            "target_lang_translations": {
                                "ru": "Нам необходимо учитывать <w>долгосрочное</w> влияние изменения климата на прибрежные города."
                            }
                        }
                    ],
                    "antonyms": [
                        "short-term"
                    ],
                    "common_phrases": [
                        "long-term effect",
                        "long-term impact",
                        "long-term consequences"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становящийся очевидным или имеющий эффект только по прошествии длительного периода времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "долгосрочный",
                                "target_lang_sense_clarification": "проявляющийся через долгое время"
                            },
                            {
                                "target_lang_word": "отдаленный",
                                "target_lang_sense_clarification": "относящийся к далекому будущему"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "25d05db2-cb1e-3bcb-ad98-1920a72f8a53",
                    "sense_definition": "Over a relatively long period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The treatment is more effective when the patient stays in the program <w>long-term</w>.",
                            "target_lang_translations": {
                                "ru": "Лечение более эффективно, когда пациент остается в программе <w>на длительный срок</w>."
                            }
                        },
                        {
                            "text": "Investing <w>long-term</w> in the stock market usually yields better results than day trading.",
                            "target_lang_translations": {
                                "ru": "Инвестирование в фондовый рынок <w>в долгосрочной перспективе</w> обычно приносит лучшие результаты, чем дневная торговля."
                            }
                        }
                    ],
                    "antonyms": [
                        "short-term"
                    ],
                    "common_phrases": [
                        "invest long-term",
                        "stay long-term"
                    ],
                    "target_lang_definitions": {
                        "ru": "В течение относительно длительного периода времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в долгосрочной перспективе",
                                "target_lang_sense_clarification": "на протяжении долгого времени"
                            },
                            {
                                "target_lang_word": "на длительный срок",
                                "target_lang_sense_clarification": "в течение долгого периода"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}