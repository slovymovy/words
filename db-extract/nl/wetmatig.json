                                ]
                            },
                            {
                                "target_word": "legitimate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "014bd11a-85ad-392e-b4fe-39524a546abb",
                                        "entry_id": "2ada9508-ebf8-3623-ae83-52b5fad3a344",
                                        "glosses": [
                                            "A person born to a legally married couple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30fbd5be-5b25-4fbe-9e81-f48a20d3b6cb",
                                                "sense_id": "014bd11a-85ad-392e-b4fe-39524a546abb",
                                                "text": "But should a “holy alliance of legitimates” extinguish it, it will be but for a season."
                                            },
                                            {
                                                "example_id": "7745ccca-784a-46c6-8da6-e29accb77e2b",
                                                "sense_id": "014bd11a-85ad-392e-b4fe-39524a546abb",
                                                "text": "This extraordinarily mixed family of legitimates and illegitimates seems to have maintained a certain kind of harmony."
                                            },
                                            {
                                                "example_id": "ecadd03d-29a7-4ea5-afdf-dd2606f2d3f7",
                                                "sense_id": "014bd11a-85ad-392e-b4fe-39524a546abb",
                                                "text": "His overweening pride received another shock through his new friends the legitimates."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "legitimate",
                                "target_lang_code": "en",
