                                        "glosses": [
                                            "Œuvre autoproduite par un artiste ou un collectif, généralement un manga, le plus souvent vendue lors d’une convention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d504995-8791-4c26-a27e-c84702695682",
                                                "sense_id": "8adaeb45-8957-3968-84dd-c4ad3dd3d7ce",
                                                "text": "Samouraï choisit aussi bien des mangas réputés (Berserk, Vampire Princess Miyu) que des titres peu évocateurs (Exodus Creators, Metal Hunters D), et même des dōjinshis !"
                                            }
                                        ]
