                "senses": [
                    {
                        "sense_id": "f0342c65-62d8-33d6-b2b3-927c68c17393",
                        "entry_id": "16e58927-fb6a-384c-9eff-5b7475d7da12",
                        "glosses": [
                            "in Anzugs- oder Kostümstoffen sich klar von den Grundstreifen abhebender, mäßig breiter Längsstreifen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b3a9262-492d-423b-8a44-6f40f615fbe8",
                                "sense_id": "f0342c65-62d8-33d6-b2b3-927c68c17393",
                                "text": "Da der Anzugstoff mit Nadelstreifen einige Fehler hatte, so konnte ich ihn günstig kaufen."
                            },
                            {
                                "example_id": "a1f7fd8b-0f21-4a0e-93bb-3f95b91505dc",
                                "sense_id": "f0342c65-62d8-33d6-b2b3-927c68c17393",
                                "text": "„Mit seiner sanften Stimme und dem eleganten Anzug, den, passend zum rosa Hemd, rote Nadelstreifen durchziehen, ist Fawcett der perfekte Repräsentant einer Branche, bei der die Öffentlichkeit an vorlaute 30-Jährige im Ferrari denkt.“"
                            },
                            {
                                "example_id": "49c748c5-64c9-4779-b198-01f29ba2a686",
                                "sense_id": "f0342c65-62d8-33d6-b2b3-927c68c17393",
                                "text": "„Die Liberalen im Bund geben sich wie Revolutionäre in Nadelstreifen - die letzte übrig gebliebene Reformpartei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
