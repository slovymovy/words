                                "target_senses": [
                                    {
                                        "sense_id": "9b43d157-11aa-3b53-8dc3-8bc6b1e896eb",
                                        "entry_id": "172cfb0e-a3eb-3319-90d2-e2cd4cc61ba7",
                                        "glosses": [
                                            "Alternative letter-case form of Earth; our planet, third out from the Sun."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98d44c41-506d-4ddc-8bc7-b509fed9dea5",
                                                "sense_id": "9b43d157-11aa-3b53-8dc3-8bc6b1e896eb",
                                                "text": "The astronauts saw the earth from the porthole."
                                            },
                                            {
                                                "example_id": "4cd78311-08fb-4a1f-a0f4-cc81eef690e5",
                                                "sense_id": "9b43d157-11aa-3b53-8dc3-8bc6b1e896eb",
                                                "text": "We live in the flicker - may it last as long as the old earth keeps rolling!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "earth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7182755d-5d13-375f-b6c6-e42191af44db",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "Soil."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41599e97-198b-42b4-88d2-dfeda57dbedf",
                                                "sense_id": "7182755d-5d13-375f-b6c6-e42191af44db",
                                                "text": "This is good earth for growing potatoes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7db3087-164c-3275-bc33-2806ac0836af",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "Any general rock-based material."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7122c275-c63a-4834-a428-93bee0ef4f14",
                                                "sense_id": "a7db3087-164c-3275-bc33-2806ac0836af",
                                                "text": "She sighed when the plane's wheels finally touched earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d97207cc-2870-3ee1-bbd3-ace8ac85a81f",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "The ground, land (as opposed to the sky or sea)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1787620a-9621-4d3c-b114-5cc3100bb8e7",
                                                "sense_id": "d97207cc-2870-3ee1-bbd3-ace8ac85a81f",
                                                "text": "Birds are of the sky, not of the earth."
                                            },
                                            {
                                                "example_id": "882959f0-c3a3-492f-849e-899cb6fd6c63",
                                                "sense_id": "d97207cc-2870-3ee1-bbd3-ace8ac85a81f",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ffb0bb7-996c-3f98-aa88-78564fdeb88d",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "A connection electrically to the earth ((US) ground); on equipment: a terminal connected in that manner."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bfcd3f80-e475-35b0-8be2-80b82a8a99c8",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "The lair or den (as a hole in the ground) of an animal such as a fox."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c172f8e-857d-360b-b4cd-5f0a7a522ad0",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "A region of the planet; a land or country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d5da435-2a8c-3c5c-9a89-eb2a2c163316",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "Worldly things, as against spiritual ones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04d5b01d-04db-3ac8-b165-2978305af30a",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "The world of our current life (as opposed to heaven or an afterlife)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a42ee2bd-cf63-4d0a-aee3-884bea429621",
                                                "sense_id": "04d5b01d-04db-3ac8-b165-2978305af30a",
                                                "text": "\"Beauty is truth, truth beauty,\"—that is all / Ye know on earth, and all ye need to know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e663f2a8-ddca-3ea8-9c18-f6ae37bea43a",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "The people on the globe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "metonymically",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b11c181c-ef2d-4100-881c-9f0a7a189627",
                                                "sense_id": "e663f2a8-ddca-3ea8-9c18-f6ae37bea43a",
                                                "text": "And the whole earth was of one language, and of one ſpeach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba2dde89-31a8-3054-aa06-240bae327e4c",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "Any planet similar to the Earth (our earth): an exoplanet viewed as another earth, or a potential one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e499964-5928-4079-b982-4e1b4bdf0d01",
                                                "sense_id": "ba2dde89-31a8-3054-aa06-240bae327e4c",
                                                "text": "New space telescopes may accelerate the search for other earths that may be out there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7913672-9c40-3f76-8e65-e5d8e37cd537",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "The human body."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fb4d1c7-a84d-3732-a121-11165a1cb5ad",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
                                        "glosses": [
                                            "The aforementioned soil- or rock-based material, considered one of the four or five classical elements."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "387e691e-13d6-3c70-b7b3-6236c703422d",
                                        "entry_id": "41b55cb5-6a82-3a81-96cc-394ab8087af4",
