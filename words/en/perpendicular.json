{
    "word_family": [
        "perpendicularity",
        "perpendicularly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "807841b8-06be-3bd9-9143-0eab20531b68",
                    "sense_definition": "At or forming a right angle (to something).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In most houses, the walls are <w>perpendicular</w> to the floor.",
                            "target_lang_translations": {
                                "de": "In den meisten Häusern stehen die Wände <w>senkrecht</w> zum Boden."
                            }
                        },
                        {
                            "text": "Draw a <w>perpendicular</w> line from the top vertex to the base of the triangle.",
                            "target_lang_translations": {
                                "de": "Zeichne eine <w>senkrechte</w> Linie von der oberen Spitze zur Basis des Dreiecks."
                            }
                        }
                    ],
                    "synonyms": [
                        "normal",
                        "orthogonal"
                    ],
                    "antonyms": [
                        "parallel"
                    ],
                    "common_phrases": [
                        "perpendicular line",
                        "perpendicular to the floor"
                    ],
                    "target_lang_definitions": {
                        "de": "In einem rechten Winkel (zu etwas) stehend oder einen solchen bildend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "senkrecht",
                                "target_lang_sense_clarification": "im rechten Winkel stehend"
                            },
                            {
                                "target_lang_word": "rechtwinklig",
                                "target_lang_sense_clarification": "einen 90-Grad-Winkel bildend"
                            },
                            {
                                "target_lang_word": "orthogonal",
                                "target_lang_sense_clarification": "mathematisch rechtwinklig"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83206436-aa7d-31b3-9050-676074ccc44e",
                    "sense_definition": "Exactly upright; extending in a straight line toward the centre of the earth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uprightness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climbers struggled to scale the nearly <w>perpendicular</w> cliff face.",
                            "target_lang_translations": {
                                "de": "Die Kletterer hatten Mühe, die fast <w>senkrechte</w> Felswand zu erklimmen."
                            }
                        },
                        {
                            "text": "The ancient pillars remained perfectly <w>perpendicular</w> despite centuries of earthquakes.",
                            "target_lang_translations": {
                                "de": "Die antiken Säulen blieben trotz jahrhundertelanger Erdbeben perfekt <w>lotrecht</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "orthogonal"
                    ],
                    "antonyms": [
                        "horizontal"
                    ],
                    "common_phrases": [
                        "perpendicular cliff"
                    ],
                    "target_lang_definitions": {
                        "de": "Exakt aufrecht; in einer geraden Linie zum Erdmittelpunkt verlaufend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "senkrecht",
                                "target_lang_sense_clarification": "steil nach oben oder unten verlaufend"
                            },
                            {
                                "target_lang_word": "lotrecht",
                                "target_lang_sense_clarification": "exakt vertikal ausgerichtet"
                            },
                            {
                                "target_lang_word": "vertikal",
                                "target_lang_sense_clarification": "aufrecht stehend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa914f5c-075e-3e92-b7dc-67d2c6346e49",
                    "sense_definition": "Independent of or irrelevant to each other; orthogonal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "independence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These two issues are completely <w>perpendicular</w> to each other and should be discussed separately.",
                            "target_lang_translations": {
                                "de": "Diese beiden Themen stehen völlig <w>orthogonal</w> zueinander und sollten getrennt diskutiert werden."
                            }
                        },
                        {
                            "text": "The new feature is <w>perpendicular</w> to our main development goals.",
                            "target_lang_translations": {
                                "de": "Die neue Funktion ist völlig <w>unabhängig</w> von unseren Hauptentwicklungszielen."
                            }
                        }
                    ],
                    "synonyms": [
                        "orthogonal"
                    ],
                    "target_lang_definitions": {
                        "de": "Unabhängig voneinander oder ohne gegenseitigen Bezug; orthogonal im übertragenen Sinne."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "orthogonal",
                                "target_lang_sense_clarification": "völlig unabhängig voneinander"
                            },
                            {
                                "target_lang_word": "unabhängig",
                                "target_lang_sense_clarification": "keinen Bezug zueinander habend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "791f71a3-a249-3784-9fab-d999c15ff8a1",
                    "sense_definition": "Of a style of English Gothic architecture from the fourteenth and fifteenth centuries, marked by stiff and rectilinear lines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral is a magnificent example of the <w>Perpendicular</w> style.",
                            "target_lang_translations": {
                                "de": "Die Kathedrale ist ein prächtiges Beispiel für den <w>Perpendicular</w>-Stil."
                            }
                        },
                        {
                            "text": "They studied the intricate tracery of <w>Perpendicular</w> Gothic windows.",
                            "target_lang_translations": {
                                "de": "Sie untersuchten das kunstvolle Maßwerk der Fenster der <w>perpendikulären</w> Gotik."
                            }
                        }
                    ],
                    "common_phrases": [
                        "perpendicular style",
                        "perpendicular gothic"
                    ],
                    "target_lang_definitions": {
                        "de": "Bezieht sich auf einen Stil der englischen Gotik des 14. und 15. Jahrhunderts, der durch straffe, geradlinige Maßwerke gekennzeichnet ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Perpendicular",
                                "target_lang_sense_clarification": "bezogen auf den spätgotischen Baustil in England"
                            },
                            {
                                "target_lang_word": "perpendikulär",
                                "target_lang_sense_clarification": "architektonischer Stilbegriff"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c5434c8-0c34-357b-afd8-937e9f9db3c6",
                    "sense_definition": "A line or plane that is perpendicular to another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To find the height of the triangle, you must drop a <w>perpendicular</w> from the apex.",
                            "target_lang_translations": {
                                "de": "Um die Höhe des Dreiecks zu finden, musst du eine <w>Senkrechte</w> von der Spitze fällen."
                            }
                        },
                        {
                            "text": "The architect drew a <w>perpendicular</w> to ensure the walls would align correctly.",
                            "target_lang_translations": {
                                "de": "Der Architekt zeichnete eine <w>Senkrechte</w>, um sicherzustellen, dass die Wände korrekt ausgerichtet sind."
                            }
                        }
                    ],
                    "synonyms": [
                        "normal"
                    ],
                    "common_phrases": [
                        "drop a perpendicular"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Linie oder Ebene, die senkrecht auf einer anderen steht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Senkrechte",
                                "target_lang_sense_clarification": "eine vertikale oder rechtwinklige Linie"
                            },
                            {
                                "target_lang_word": "Lotrechte",
                                "target_lang_sense_clarification": "eine exakt vertikale Linie"
                            },
                            {
                                "target_lang_word": "Normale",
                                "target_lang_sense_clarification": "mathematisch senkrechte Linie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0aa7d81-60bf-36ed-a100-d29d6329892d",
                    "sense_definition": "A device such as a plumb line that is used in making or marking a perpendicular line.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mason used a simple <w>perpendicular</w> to check the alignment of the brick wall.",
                            "target_lang_translations": {
                                "de": "Der Maurer benutzte ein einfaches <w>Senkblei</w>, um die Ausrichtung der Ziegelwand zu überprüfen."
                            }
                        },
                        {
                            "text": "Without a proper <w>perpendicular</w>, the wooden frame began to lean slightly.",
                            "target_lang_translations": {
                                "de": "Ohne ein ordentliches <w>Lot</w> begann der Holzrahmen sich leicht zu neigen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Werkzeug wie ein Senkblei, das zur Bestimmung oder Überprüfung einer senkrechten Linie verwendet wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Senkblei",
                                "target_lang_sense_clarification": "Werkzeug zur Messung des senkrechten Verlaufs"
                            },
                            {
                                "target_lang_word": "Bleilot",
                                "target_lang_sense_clarification": "Lot zur vertikalen Ausrichtung"
                            },
                            {
                                "target_lang_word": "Lot",
                                "target_lang_sense_clarification": "Messwerkzeug für die Vertikale"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e118c1c-ffa9-3752-8d44-38dfa58209bd",
                    "sense_definition": "A meal eaten at a tavern bar while standing up.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We didn't have time for a proper sit-down dinner, so we settled for a quick <w>perpendicular</w> at the pub.",
                            "target_lang_translations": {
                                "de": "Wir hatten keine Zeit für ein richtiges Abendessen im Sitzen, also gaben wir uns mit einem schnellen <w>Stehimbiss</w> im Pub zufrieden."
                            }
                        },
                        {
                            "text": "The tavern was packed, forcing many patrons to enjoy a <w>perpendicular</w> near the counter.",
                            "target_lang_translations": {
                                "de": "Die Taverne war brechend voll, was viele Gäste dazu zwang, ihr Essen als <w>Stehimbiss</w> nahe der Theke zu genießen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "humorous or regional slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Mahlzeit, die im Stehen an einer Wirtshaustheke eingenommen wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stehimbiss",
                                "target_lang_sense_clarification": "Essen im Stehen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}