                ],
                "senses": [
                    {
                        "sense_id": "4c36b0c3-55e7-37ab-aad1-7cb37269b7c9",
                        "entry_id": "fa87ef66-7342-3aee-ab93-99ab89d9e0f0",
                        "glosses": [
                            "waardevolle grondstof die uit de aarde verkregen wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ff2b19d-fdbb-437b-9100-4247d6963f5b",
                                "sense_id": "4c36b0c3-55e7-37ab-aad1-7cb37269b7c9",
                                "text": "Steenkool, aardolie en vooral aardgas zijn belangrijke delfstoffen uit Nederland."
                            },
                            {
                                "example_id": "a862810f-fd0e-44dc-b580-5ceb9e54737f",
                                "sense_id": "4c36b0c3-55e7-37ab-aad1-7cb37269b7c9",
                                "text": "Sinds 2003 staat in de wet dat boeren verplicht zijn de winning van delfstoffen onder hun gronden te gedogen. Daar krijgen ze niks voor terug. De Vereniging Rechtskundig Bureau voor de Landbouwer roept boeren nu op deze gedoogplicht aan te vechten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d04fd79a-6796-4a3a-9716-101088051e48",
                        "source_entry_id": "fa87ef66-7342-3aee-ab93-99ab89d9e0f0",
                        "source_sense_id": "4c36b0c3-55e7-37ab-aad1-7cb37269b7c9",
                        "target_lang_word": "Erz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2a4494-45c6-336f-848b-69072a14957e",
                                        "entry_id": "c9e8e89c-e6d6-3420-abf4-731a1340c2ab",
                                        "glosses": [
                                            "natürlich vorkommende metallhaltige Mineralien und Mineraliengemische, aus denen durch Verhüttung Metalle gewonnen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb0a5727-fe0f-42eb-866e-03313ae2ccbd",
                                                "sense_id": "ff2a4494-45c6-336f-848b-69072a14957e",
                                                "text": "Erze glänzen oft metallisch."
                                            },
                                            {
                                                "example_id": "27c62aee-c41d-419b-950a-73aa6113cd0d",
                                                "sense_id": "ff2a4494-45c6-336f-848b-69072a14957e",
                                                "text": "Diese Grube fördert schon viele Jahre kein Erz mehr."
                                            },
                                            {
                                                "example_id": "1fe16104-ea79-4dd1-bbd8-49bbb733d657",
                                                "sense_id": "ff2a4494-45c6-336f-848b-69072a14957e",
                                                "text": "„So wie die Männer für ihre Arbeit eigene Bereiche brauchten, wo das Erz geschmolzen und Eisen geschmiedet wurde, so hatten auch die Frauen ihr Weberhaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09eae3c1-6f7f-3770-b929-ad9f7f964d65",
                                        "entry_id": "c9e8e89c-e6d6-3420-abf4-731a1340c2ab",
                                        "glosses": [
                                            "in alten Schriften (zum Beispiel in Mythologien und der Bibel) verwendete Bezeichnung für metallartige Materialien, vermutlich schlecht geläuterte Metallmischungen mit hohem Kupferanteil; Bronze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc85069f-4831-4093-be8c-b8b21902f1fd",
                                                "sense_id": "09eae3c1-6f7f-3770-b929-ad9f7f964d65",
                                                "text": "Ein Schwert aus Erz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52014a16-279a-4f16-98b9-ebe897072326",
                        "source_entry_id": "fa87ef66-7342-3aee-ab93-99ab89d9e0f0",
                        "source_sense_id": "4c36b0c3-55e7-37ab-aad1-7cb37269b7c9",
                        "target_lang_word": "Mineral",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mineral",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e48c7cd-02df-324a-92e4-67ac003b62c0",
                                        "entry_id": "1929f34a-7a7c-30ee-9109-3c78ffb576df",
                                        "glosses": [
                                            "natürlich vorkommender, meist kristalliner, Feststoff mit einer einheitlichen chemischen Zusammensetzung und einem auf mikroskopischer Ebene gleichförmigen Aufbau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f571995a-1d5e-4eab-b2b0-e007def5706a",
                                                "sense_id": "3e48c7cd-02df-324a-92e4-67ac003b62c0",
                                                "text": "Eine der weltgrößten Sammlungen von Mineralien befindet sich in Freiberg."
                                            },
                                            {
                                                "example_id": "185ea09d-d1ef-45dc-bf18-4d9faf8fcc53",
                                                "sense_id": "3e48c7cd-02df-324a-92e4-67ac003b62c0",
                                                "text": "„Nach Diamant ist Korund das härteste Mineral.“"
                                            },
                                            {
                                                "example_id": "fa93efe5-8b86-4d82-b777-c19fccb80772",
                                                "sense_id": "3e48c7cd-02df-324a-92e4-67ac003b62c0",
                                                "text": "„Rom war als Siedlungsplatz wohl deshalb besonders attraktiv, weil es an einer Furt des Tiber lag, die wichtig war für die Verbindungen zwischen dem nördlich gelegenen Etrurien und dem südlich gelegenen Kampanien, und weil hier die Salzstraße vorbeiführte, auf der dieses schon in der Frühgeschichte wichtige Mineral von den Salzbuchten an der Tibermündung ins Landesinnere geschafft wurde.“"
                                            },
                                            {
                                                "example_id": "f546e1ee-6992-4646-802b-2f44e346a3a8",
                                                "sense_id": "3e48c7cd-02df-324a-92e4-67ac003b62c0",
                                                "text": "„Gleichzeitig gehen die Reserven an Gold, Diamanten und wertvollen Mineralien zur Neige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "249d50ec-9681-443a-a628-877f20462153",
                        "source_entry_id": "fa87ef66-7342-3aee-ab93-99ab89d9e0f0",
                        "source_sense_id": "4c36b0c3-55e7-37ab-aad1-7cb37269b7c9",
                        "target_lang_word": "mineral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mineral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1c20031-e5d4-385d-85a6-18b7cb725f37",
                                        "entry_id": "394fb000-4192-315e-bb47-96246d086c95",
                                        "glosses": [
                                            "Any naturally occurring material that has a (more or less) definite chemical composition and characteristic physical properties; especially, an inorganic one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590ae920-9411-4820-a9be-556624af6a56",
                                                "sense_id": "c1c20031-e5d4-385d-85a6-18b7cb725f37",
                                                "text": "The physiology of matter in the abstract is dynamical, that of mineral species is both dynamical and chemical, while that of organized forms is at once dynamical, chemical, and biotical."
                                            },
                                            {
                                                "example_id": "c44886e0-14df-44e3-ac02-7696fdbd9574",
                                                "sense_id": "c1c20031-e5d4-385d-85a6-18b7cb725f37",
                                                "text": "Formation of alteration minerals in the host rock during deformation within the shear zone is indicated by the parallel foliation within the secondary micaceous minerals and the unmineralized host schist."
                                            },
                                            {
                                                "example_id": "6f50f5ab-e9d7-4216-8133-1850e1b9ce98",
                                                "sense_id": "c1c20031-e5d4-385d-85a6-18b7cb725f37",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are diamond, ruby and sapphire, emerald and other gem forms of the mineral beryl, chrysoberyl, tanzanite, tsavorite, topaz and jade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e02825-4289-3127-a2ff-49eb28b1c3d2",
                                        "entry_id": "394fb000-4192-315e-bb47-96246d086c95",
                                        "glosses": [
                                            "Any inorganic material (as distinguished from animal or vegetable)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "205ab0ef-d1cd-3ad3-b985-13ff9bf8d7b2",
                                        "entry_id": "394fb000-4192-315e-bb47-96246d086c95",
                                        "glosses": [
                                            "Any inorganic element that is essential to nutrition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2823aae-3ed7-3d26-9836-3773be9687a1",
