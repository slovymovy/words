                ],
                "senses": [
                    {
                        "sense_id": "91f83a23-ad04-3095-bfd7-b2f18dc92499",
                        "entry_id": "a0736839-40a4-3107-bff6-b9dbdeaff4df",
                        "glosses": [
                            "Qui a du fiel, de la méchanceté."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "908dcb4e-743b-4b5f-a67e-ec56e4ee17c6",
                                "sense_id": "91f83a23-ad04-3095-bfd7-b2f18dc92499",
                                "text": "Ses lèvres ne prononçaient que des paroles fielleuses et des insultes perpétuelles."
                            },
                            {
                                "example_id": "a441b0ae-a19c-407e-841a-1de775d1c696",
                                "sense_id": "91f83a23-ad04-3095-bfd7-b2f18dc92499",
                                "text": "Cet écrivain petit poseur, qui jouait au pamphlétaire et poussait l’outrecuidance jusqu’à se croire un Rochefort – ce qui le fit baptiser Rochefaible par Sébastien Roll, – s’avisa de publier sur les gens de théâtre un article aussi sot que fielleux."
                            },
                            {
                                "example_id": "f5ee25a6-b56c-4168-ae34-72572d189400",
                                "sense_id": "91f83a23-ad04-3095-bfd7-b2f18dc92499",
                                "text": "« Si vous n’aviez pas perdu la foi, la mort ne vous effraierait pas tant », m’écrivaient, avec une fielleuse commisération, des dévots."
                            },
                            {
                                "example_id": "3c5a8258-ccea-4757-a2eb-88384e430fc4",
                                "sense_id": "91f83a23-ad04-3095-bfd7-b2f18dc92499",
                                "text": "À deux cents mètres de là, le seul et unique photographe de N… qui, quelques heures plus tôt, accompagné de l’espion Pjetër Prenushi, avait pris en cliché chacune des pages du carnet de notes des nouveaux arrivants, développait à présent la pellicule sous le regard menaçant et fielleux de l’indicateur."
                            },
                            {
                                "example_id": "937f8a8b-8bcb-4a6e-815b-a35de0876278",
                                "sense_id": "91f83a23-ad04-3095-bfd7-b2f18dc92499",
                                "text": "Il avait beaucoup parlé sans la regarder. S’était plaint du nouvel hôtel construit près de la gare, une laideur qui ne respectait pas l’architecture urbaine. Il faisait des commentaires sur tout. Les petites gens, la politique, son milieu de travail. Que des propos fielleux."
                            },
                            {
                                "example_id": "8c03d320-c71a-438b-998e-4a5744ac3dc4",
                                "sense_id": "91f83a23-ad04-3095-bfd7-b2f18dc92499",
                                "text": "C’est un homme fielleux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2af81a3-d3de-41be-8a32-8d54a43fab69",
                        "source_entry_id": "a0736839-40a4-3107-bff6-b9dbdeaff4df",
                        "source_sense_id": "91f83a23-ad04-3095-bfd7-b2f18dc92499",
                        "target_lang_word": "gallig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gallig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "890b157d-622f-361a-8e68-0580cbddc7e7",
                                        "entry_id": "521c47b2-1f59-3863-84ae-7207c6fbf50e",
                                        "glosses": [
                                            "bitter wie Galle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7a0a33-f2e2-4c3a-9f32-66ec9ccae1e7",
                                                "sense_id": "890b157d-622f-361a-8e68-0580cbddc7e7",
                                                "text": "Durch unsauberes Ausweiden war der Truthahn gallig und ungenießbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7895c2a-a40c-3852-8dfd-ea6b1d510664",
                                        "entry_id": "521c47b2-1f59-3863-84ae-7207c6fbf50e",
                                        "glosses": [
                                            "verbittert, mit scharfen Aussprüchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "663d7eff-94b2-4d8c-8848-ffbaf8aaf622",
                                                "sense_id": "c7895c2a-a40c-3852-8dfd-ea6b1d510664",
                                                "text": "Wegen der vielen Schicksalsschläge waren seine Bemerkungen nur mit galligem Humor."
                                            },
                                            {
                                                "example_id": "739b39e0-cbba-43d8-94bf-041da4ce5e91",
                                                "sense_id": "c7895c2a-a40c-3852-8dfd-ea6b1d510664",
                                                "text": "„Je mehr er sich für sein Thema erwärmte, desto mehr wich sein mephistophelischer Charme galligem Zynismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7c15e844-7040-35df-a8da-801d8d3132a8",
                                        "entry_id": "521c47b2-1f59-3863-84ae-7207c6fbf50e",
                                        "glosses": [
                                            "unangenehm aggressiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd835342-f9c5-459d-8abb-1843457c0ffe",
                                                "sense_id": "7c15e844-7040-35df-a8da-801d8d3132a8",
                                                "text": "„Die Mannschaft sei nicht gallig genug gewesen“; „gallig und gierig ins Spiel gegen [den Gegener] gehen“; „eine gewisse Galligkeit sowie Intensität […] auf den Platz bringen“; das Team sei „hart, konsequent und manchmal auch gallig gewesen“."
                                            },
                                            {
                                                "example_id": "595e6106-d6de-42e4-9331-a91362096bf0",
                                                "sense_id": "7c15e844-7040-35df-a8da-801d8d3132a8",
                                                "text": "„Der Trainer […] befahl seinen Kickern: Seid nervig, gallig, quält den Gegner, zwingt ihn zu Fehlern […]“"
                                            },
                                            {
                                                "example_id": "a5f34ecb-0770-4f25-bff1-674e552d89b0",
                                                "sense_id": "7c15e844-7040-35df-a8da-801d8d3132a8",
                                                "text": "„Die Spieler müssen gallig und gierig sein, sie sollen jedes Spiel gewinnen wollen.“"
                                            },
                                            {
                                                "example_id": "628e289a-405d-4e3d-bb08-dc0fcb803fa2",
                                                "sense_id": "7c15e844-7040-35df-a8da-801d8d3132a8",
                                                "text": "„Lätschert statt gallig“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d11ca1e-478d-41c2-b2f9-b013e108119a",
                        "source_entry_id": "a0736839-40a4-3107-bff6-b9dbdeaff4df",
                        "source_sense_id": "91f83a23-ad04-3095-bfd7-b2f18dc92499",
                        "target_lang_word": "gehässig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gehässig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bad4f822-5c24-3dd4-97fb-ba5d3b798f5b",
                                        "entry_id": "3cd67155-145a-38e0-ab40-84a96784ce2b",
                                        "glosses": [
                                            "jemand anderem Übles wünschend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d4d32ed-88a0-4475-9018-6bb990ebe1bc",
                                                "sense_id": "bad4f822-5c24-3dd4-97fb-ba5d3b798f5b",
                                                "text": "Mit einer gehässigen Bemerkung zeigte er allen seine negative Einstellung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbd1541c-f5f8-4cfe-93cb-3d13a3c19cc3",
                        "source_entry_id": "a0736839-40a4-3107-bff6-b9dbdeaff4df",
                        "source_sense_id": "91f83a23-ad04-3095-bfd7-b2f18dc92499",
                        "target_lang_word": "bilious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bilious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8be9dd20-95af-3068-883e-818ba8a74f88",
                                        "entry_id": "75404116-207a-36ce-b177-6047035d9796",
                                        "glosses": [
                                            "Of or pertaining to something containing or consisting of bile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "456b6e17-0fbd-3b7d-9647-51b4f953de59",
                                        "entry_id": "75404116-207a-36ce-b177-6047035d9796",
                                        "glosses": [
                                            "Resembling bile, especially in color."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "019e4e59-12a4-4e5d-9541-fb823d368305",
                                                "sense_id": "456b6e17-0fbd-3b7d-9647-51b4f953de59",
                                                "text": "Does money fail?—come to my mint—coin paper,\nTill gold be at a discount, and ashamed\nTo show his bilious face, go purge himself,\nIn emulation of her vestal whiteness."
                                            },
                                            {
                                                "example_id": "5960bc2c-e9a5-45b4-96cf-f121fe2781f8",
                                                "sense_id": "456b6e17-0fbd-3b7d-9647-51b4f953de59",
                                                "text": "His complexion was pale, not of that deadly pallor which is a kind of neutral beauty, but of a bilious, yellow hue; his colorless hair was short and scarcely extended beyond the circle formed by the hat around his head, and his light blue eyes seemed destitute of any expression."
                                            },
                                            {
                                                "example_id": "25f97695-5172-4611-b040-575c4d88fdf8",
                                                "sense_id": "456b6e17-0fbd-3b7d-9647-51b4f953de59",
                                                "text": "The business-center of Schoenstrom took up one side of one block, facing the railroad. It was a row of one-story shops covered with galvanized iron, or with clapboards painted red and bilious yellow."
                                            },
                                            {
                                                "example_id": "54297d52-52a4-45d2-9c5c-26aa95d54db9",
                                                "sense_id": "456b6e17-0fbd-3b7d-9647-51b4f953de59",
                                                "text": "A beautiful girl once told me of a recurring nightmare in which she lay in the center of a large dark room and felt her face expand until it filled the whole room, becoming a formless mass while her eyes ran in bilious jelly up the chimney."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c9def46-1fef-305b-97a6-a43b0e15c8d5",
                                        "entry_id": "75404116-207a-36ce-b177-6047035d9796",
                                        "glosses": [
                                            "Suffering from real or supposed liver disorder, especially excessive secretions of bile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "059a831f-8a5f-47f3-8b0f-6d1943ff8c67",
                                                "sense_id": "9c9def46-1fef-305b-97a6-a43b0e15c8d5",
                                                "text": "Perry tells me that Mr. Cole never touches malt liquor. You would not think it to look at him, but he is bilious—Mr. Cole is very bilious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de5934e6-911f-3177-99c3-7a859f3b7fe2",
                                        "entry_id": "75404116-207a-36ce-b177-6047035d9796",
                                        "glosses": [
                                            "Peevishly ill-humored, irritable or bad tempered; irascible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584a666b-a967-44cf-a8ea-f91bef01a5c1",
                                                "sense_id": "de5934e6-911f-3177-99c3-7a859f3b7fe2",
                                                "text": "The glorified spirit of a great statesman and philosopher dawdling, like a bilious old Nabob at a watering-place, over quarterly reviews and novels—dropping in to pay long calls—making excursions in search of the picturesque!"
                                            },
                                            {
                                                "example_id": "be014ec2-9f53-48df-93d4-050970a25c6c",
                                                "sense_id": "de5934e6-911f-3177-99c3-7a859f3b7fe2",
                                                "text": "The boarders, sharp-tongued bilious widows, pursued the only man in the establishment, a mild, bald creature who worked in La Samaritaine […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22807ee2-bdeb-46d6-9af1-0bcf551de807",
                        "source_entry_id": "a0736839-40a4-3107-bff6-b9dbdeaff4df",
                        "source_sense_id": "91f83a23-ad04-3095-bfd7-b2f18dc92499",
