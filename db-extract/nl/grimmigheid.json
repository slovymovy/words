                "senses": [
                    {
                        "sense_id": "0444c2da-f65f-318f-a3b0-cdd1e6d0c07e",
                        "entry_id": "fd69c202-8e90-360d-bbe2-ac3bb1e7a9c5",
                        "glosses": [
                            "het ruw, boos, verbolgen en onvriendelijk zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bafbef2e-dfc6-4633-9e8b-82d98d646348",
                                "sense_id": "0444c2da-f65f-318f-a3b0-cdd1e6d0c07e",
                                "text": "Met heldere en stralende blik keek hij iedereen aan alsof hij de aandacht erop wilde vestigen hoe rustig hij de schoten onderging. Toch tekende ook op zijn gezicht die uitdrukking van een nieuwe grimmigheid zich rond de mond af."
                            },
                            {
                                "example_id": "3e9ed33d-eb6c-434f-bf9d-8bf1e8318000",
                                "sense_id": "0444c2da-f65f-318f-a3b0-cdd1e6d0c07e",
                                "text": "\"Die grimmigheid richt zich niet alleen op kunst maar ook op Amsterdam en waar Amsterdam voor staat. Het is eigenlijk ook een aanval op de Hedy's van onze stad, die de stad tot een humane, beschaafde en vrijzinnige maken\", aldus Van der Laan."
                            }
                        ]
                    },
                    {
                        "sense_id": "2489efd1-b2fc-36be-95ba-b3ce3eb9496d",
                        "entry_id": "fd69c202-8e90-360d-bbe2-ac3bb1e7a9c5",
                        "glosses": [
                            "iets ruws en onvriendelijks"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "435637e9-13c1-4b35-b126-ce1a19e9c094",
                        "source_entry_id": "fd69c202-8e90-360d-bbe2-ac3bb1e7a9c5",
                        "source_sense_id": "0444c2da-f65f-318f-a3b0-cdd1e6d0c07e",
