                                "sense_id": "3d1f14fd-7d34-3b77-8450-018926d0f658",
                                "text": "De coronacrisis roept elke dag nieuwe vragen op."
                            },
                            {
                                "example_id": "864e19a5-6d39-4462-8ce2-8a394ac1ebee",
                                "sense_id": "3d1f14fd-7d34-3b77-8450-018926d0f658",
                                "text": "In veel gevallen is het leerbedrijf door de coronacrisis gesloten, waardoor het al onmogelijk is geworden met de stage door te gaan."
                            },
                            {
                                "example_id": "efab4946-4e2f-4e91-bef6-9c66c1b9003e",
                                "sense_id": "3d1f14fd-7d34-3b77-8450-018926d0f658",
                                "text": "‘Ook in de sectoren buiten de directe economie gaat het echt verschrikkelijk”, zegt de minister na afloop van het crisisberaad van het kabinet over de coronacrisis."
                            }
                        ]
