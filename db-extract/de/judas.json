                    {
                        "sense_id": "1899fe6a-f565-36a1-b4c8-e55894390630",
                        "entry_id": "d050eaed-8b56-3fcc-95c0-d66e8e7b15c3",
                        "glosses": [
                            "Jünger von Jesus Christus, den er später verraten hat"
                        ],
                        "tags": [
                            "Bibel"
                        ],
                        "examples": [
                            {
                                "example_id": "0d33e6c8-5c38-46ef-b650-22a05524401d",
                                "sense_id": "1899fe6a-f565-36a1-b4c8-e55894390630",
                                "text": "Nachdem Judas Jesus verraten hat, tötete er sich anschließend selbst."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d02c5215-dc65-4873-a260-44e183c37925",
                        "source_entry_id": "d050eaed-8b56-3fcc-95c0-d66e8e7b15c3",
                        "source_sense_id": "1899fe6a-f565-36a1-b4c8-e55894390630",
                        "source_sense_description": "Bibel: Jünger von Jesus Christus, den er später verraten hat",
                        "target_lang_word": "Judas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Judas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae6d7e68-0c19-3f01-bab2-fdabb89c46cf",
                                        "entry_id": "78db29a5-51f0-3b9d-aede-626c55d90c57",
                                        "glosses": [
                                            "Judas Iscariot, one of the twelve original Apostles of Jesus, known for his role in Jesus' betrayal into the hands of Roman authorities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "683eb742-f05c-3470-8c81-4ef62dd8f626",
                                        "entry_id": "78db29a5-51f0-3b9d-aede-626c55d90c57",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e6bd1a5-c6b4-39aa-b6a3-cf292dd612f0",
                                        "entry_id": "78db29a5-51f0-3b9d-aede-626c55d90c57",
                                        "glosses": [
                                            "Alternative form of Jude, the penultimate book of the Bible and its ascribed author, Jude the Apostle (Judas Thaddaeus)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f67b904d-9c7d-4fee-ac4b-791350fb1172",
                                                "sense_id": "9e6bd1a5-c6b4-39aa-b6a3-cf292dd612f0",
                                                "text": "The Catholique (or General) Epistle of the Apostle JUDAS"
                                            },
                                            {
                                                "example_id": "c4b9d6d7-6eb8-49f8-9106-93adc8e2cde2",
                                                "sense_id": "9e6bd1a5-c6b4-39aa-b6a3-cf292dd612f0",
                                                "text": "St. Peter writes against those that had the doctrine of Balaam, 2 Pet. ii. 15, 16. St. Judas did the same, Jud. v. 11."
                                            },
                                            {
                                                "example_id": "7fad7134-9462-4149-aff5-7bac1a363caa",
                                                "sense_id": "9e6bd1a5-c6b4-39aa-b6a3-cf292dd612f0",
                                                "text": "[…] you should as well reject those Deuterocanonici of the new testament as the epistle to the Hebrewes, Judas epistle and the Apocalyps […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Judas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9730811-94f5-30b5-8c8a-c32a6df6ddf1",
                                        "entry_id": "0ebb157a-8b58-321b-96f6-669f47124988",
                                        "glosses": [
                                            "A traitor; a person not to be trusted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9464245b-dcc9-4e29-ac32-5fe0e002f7a9",
                                                "sense_id": "a9730811-94f5-30b5-8c8a-c32a6df6ddf1",
                                                "text": "If there was a moment when Jack Dorsey first morphed from Jesus to Judas in the minds of many former Twitter staffers, it was when he described Elon Musk as the “singular solution” to take over the social media platform he co-founded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "048b27c8-5252-3f5a-ba4e-10ee0e3b864a",
                                        "entry_id": "0ebb157a-8b58-321b-96f6-669f47124988",
                                        "glosses": [
                                            "Ellipsis of Judas-hole (“small hole for spying”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e0ffc3e-a614-404e-bc5f-11630394c3d0",
                                                "sense_id": "048b27c8-5252-3f5a-ba4e-10ee0e3b864a",
                                                "text": "The door was slammed in his face, and the Judas clicked shut, leaving him alone in the draughty street, now smelling of night and approaching snow."
                                            },
                                            {
                                                "example_id": "60e81cba-67f9-4639-ae75-af9c3fe78288",
                                                "sense_id": "048b27c8-5252-3f5a-ba4e-10ee0e3b864a",
                                                "text": "At the top of the stairs was a heavy door with a peephole. Flick banged on it and stood where her face could be seen through the judas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Judas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed96eabc-927a-3488-b4f7-c0b8de7e0a97",
                                        "entry_id": "d1c14648-6bad-3472-a84e-fe257e6c87cc",
                                        "glosses": [
                                            "Jesus! (an exclamation used to express shock or surprise at something negative)"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
