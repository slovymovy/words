                "senses": [
                    {
                        "sense_id": "10047c7a-e8c0-39bc-af02-39c451fe8303",
                        "entry_id": "e2ad6fe9-9303-30f5-b55a-f47f6a7a8f38",
                        "glosses": [
                            "действие по значению гл. игнорировать; оставление без внимания, пренебрежение кем-либо или чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46426495-837b-4073-8ad2-81039b3c1e47",
                                "sense_id": "10047c7a-e8c0-39bc-af02-39c451fe8303",
                                "text": "Одним из проявлений европоцентризма является морфологизм, заключающийся, в частности, в игнорировании при описании современных языков представленных в них аналитических конструкций, ..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7d2f0c1-cd1f-4945-9e3b-d4bc8064f460",
                        "source_entry_id": "e2ad6fe9-9303-30f5-b55a-f47f6a7a8f38",
                        "source_sense_id": "10047c7a-e8c0-39bc-af02-39c451fe8303",
                        "target_lang_word": "ignoring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ignoring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebb50e09-c47b-389d-98dd-8f63abb2e4e6",
                                        "entry_id": "90b70c61-1911-3d4b-9a24-0285d97af3cf",
                                        "glosses": [
                                            "present participle and gerund of ignore"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ignoring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b68ca31e-ffc5-3e38-ad9d-466080297f14",
                                        "entry_id": "5a688b7c-934f-3b45-b602-fc95b12f76d9",
                                        "glosses": [
                                            "The act by which something is ignored."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f13f5c12-6ace-4b3d-af8c-ffeafb730dd6",
                                                "sense_id": "b68ca31e-ffc5-3e38-ad9d-466080297f14",
                                                "text": "Employ two revokes, two trumpings of your partner's best card and two ignorings of a call — all in the same hand!"
                                            },
                                            {
                                                "example_id": "19031584-549e-4e59-ab10-98c6594d12a7",
                                                "sense_id": "b68ca31e-ffc5-3e38-ad9d-466080297f14",
                                                "text": "We ignore various far-fetched possibilities, as hard-headed detectives should. But S does not ignore them. S is by profession a sceptical epistemologist. He never ignores much of anything. If it is our own ignorings that matter, then we are wrong, because S never knew much of anything."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d621b89-6ab2-40b8-83ed-561c6b658368",
                        "source_entry_id": "e2ad6fe9-9303-30f5-b55a-f47f6a7a8f38",
                        "source_sense_id": "10047c7a-e8c0-39bc-af02-39c451fe8303",
                        "target_lang_word": "Ignorierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ignorierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8c474dd-f6fc-345a-917a-da3caa5f0972",
                                        "entry_id": "cae903a7-76ef-38cb-815a-677a87260f69",
                                        "glosses": [
                                            "(absichtliche) Nichtbeachtung, Vernachlässigung von jemandem oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28922c74-9f12-429d-8be1-49ca71d2e4a8",
                                                "sense_id": "e8c474dd-f6fc-345a-917a-da3caa5f0972",
                                                "text": "„Die Ignorierung der Grenzen für die Macht des Willens aber ist der verhängnisvolle Rechenfehler in der Politik des Bolschewismus.“"
                                            },
                                            {
                                                "example_id": "891b859e-49df-4d83-910e-956c4e1cb534",
                                                "sense_id": "e8c474dd-f6fc-345a-917a-da3caa5f0972",
                                                "text": "„Die Ignorierung der Beschaffungsplanung würde zwangsläufig zum Stillstand aller Produktionsprozesse aufgrund Materialmangels führen.“"
                                            },
                                            {
                                                "example_id": "c7c6a4f3-1d09-42f5-ac88-ea3729fc44dd",
                                                "sense_id": "e8c474dd-f6fc-345a-917a-da3caa5f0972",
                                                "text": "„Die Ignorierung Jesu seitens des Judentums darf nicht als Ignorierung Gottes verstanden werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
