                "senses": [
                    {
                        "sense_id": "2d854140-3cb2-3aed-9d91-1080d1e59d6a",
                        "entry_id": "df6cecbc-c47c-367f-bfd5-060bd910bd1b",
                        "glosses": [
                            "To fish for eels using a bab."
                        ],
                        "tags": [
                            "East-Anglia",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "54058ca4-9bf5-4f77-afe3-3d395c49fb2a",
                                "sense_id": "2d854140-3cb2-3aed-9d91-1080d1e59d6a",
                                "text": "The babbers follow the eels, and you may see fifteen boats as close together as possible, babbing away, and catching as much as four stone-weight of eels per boat of a night."
                            },
                            {
                                "example_id": "77df65b4-a8de-4a53-b910-82fdb1aac7f7",
                                "sense_id": "2d854140-3cb2-3aed-9d91-1080d1e59d6a",
                                "text": "Sometimes we trolled or set liggers for pike, we seldom babbed for eels, it was such a slimy job."
                            },
                            {
                                "example_id": "f1240a41-e582-4e62-abc5-124c26d59a03",
                                "sense_id": "2d854140-3cb2-3aed-9d91-1080d1e59d6a",
                                "text": "Another classic example was babbing for eels; he would come along and say — ‘Goodnight for babbing, make you some babs’."
                            }
                        ]
                    }
