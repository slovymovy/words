                ],
                "senses": [
                    {
                        "sense_id": "a7bbe4ac-a13e-3d76-9a61-c6b528654f63",
                        "entry_id": "c96a90a8-876a-3449-a82a-78f516110992",
                        "glosses": [
                            "durch eine einflussreiche Institution oder Person vorgegebene, verbindliche Darstellung eines Sachverhalts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e02147b6-13c9-4970-97ee-0c61466973b7",
                                "sense_id": "a7bbe4ac-a13e-3d76-9a61-c6b528654f63",
                                "text": "Im politischen und wirtschaftlichen Raum gibt es viele Sprachregelungen. So war es lange verpönt, die \"Bundesrepublik Deutschland\" nur als \"BRD\" zu bezeichnen. Eine andere Sprachregelung betraf die Ersetzung von \"Atomkraftwerk\" durch \"Kernkraftwerk\"."
                            },
                            {
                                "example_id": "cc845f97-85b3-4d33-a442-4a3f95b4323a",
                                "sense_id": "a7bbe4ac-a13e-3d76-9a61-c6b528654f63",
                                "text": "Mit Sprachregelungen will man in der Regel unerwünschte Assoziationen vermeiden."
                            },
                            {
                                "example_id": "3dc0951f-bc2e-4623-aee0-e67bc389004e",
                                "sense_id": "a7bbe4ac-a13e-3d76-9a61-c6b528654f63",
                                "text": "Sprachregelungen laufen oft auf Euphemismen hinaus."
                            },
                            {
                                "example_id": "862b72d7-66f0-41eb-9058-ca23048dc972",
                                "sense_id": "a7bbe4ac-a13e-3d76-9a61-c6b528654f63",
                                "text": "„Das Wort »Sprachlenkung« wird in der Literatur auf zwei verschiedenen Ebenen der Allgemeinheit zur Bezeichnung verschiedener Sachverhalte verwendet und konkurriert mit einer Vielzahl anderer Ausdrücke, unter anderem mit »Sprachpolitik«, »Sprachplanung«, »Sprachnormierung«, »Sprachpflege«, Sprachregelung und ihren fremdsprachigen Entsprechungen.“"
                            },
                            {
                                "example_id": "2c2f80c7-f267-44d6-992d-0cc71f5ae31a",
                                "sense_id": "a7bbe4ac-a13e-3d76-9a61-c6b528654f63",
                                "text": "„Dabei wird vor allem die lautliche (»Aussprache«) und graphische („Rechtschreibung“) Ebene der Sprache einer institutionellen Sprachregelung unterworfen....“"
                            },
                            {
                                "example_id": "c42fcb06-136c-4dfb-8529-36122c28aa82",
                                "sense_id": "a7bbe4ac-a13e-3d76-9a61-c6b528654f63",
                                "text": "„Schwarze sind Afro-Amerikaner - auch wenn sich selbst nicht alle Schwarzen, vor allem der älteren Generation, an diese Sprachregelung halten.“"
                            },
                            {
                                "example_id": "4913e1d9-b451-4f10-942f-7b422214dbcb",
                                "sense_id": "a7bbe4ac-a13e-3d76-9a61-c6b528654f63",
                                "text": "„Nun sind Sprachregelungen nicht immer nur organisationssichernd und schaffen kontroverse Machtsituationen, sie enthalten vor allem auch religiös interpretierte Normen zur Lebensgestaltung.“"
                            },
                            {
                                "example_id": "0878ce79-35b5-493d-9704-5daafc5d1499",
                                "sense_id": "a7bbe4ac-a13e-3d76-9a61-c6b528654f63",
                                "text": "„Der offiziellen Sprachregelung zufolge gab es im Oppelner Schlesien ab etwa 1947, spätestens ab 1948 keine Deutschen mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
