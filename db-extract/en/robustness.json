                                    {
                                        "sense_id": "20b5defc-aaef-3a83-acda-76c469fbb971",
                                        "entry_id": "6920d1b2-526a-3cfb-bc4d-c1e504e632c9",
                                        "glosses": [
                                            "von Personen: Unempfindlichkeit gegen fremde Einflüsse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac6eace-d4dd-4623-b667-4f3c68136334",
                                                "sense_id": "20b5defc-aaef-3a83-acda-76c469fbb971",
                                                "text": "Seine körperliche und psychische Robustheit half ihm, die Anstrengungen der Reise zu bewältigen."
                                            },
                                            {
                                                "example_id": "b31b335c-36c0-4237-93be-51f992373513",
                                                "sense_id": "20b5defc-aaef-3a83-acda-76c469fbb971",
                                                "text": "„Es war einmal ein Junge, der in einer kleinen, armen Familie aufwuchs, aber nie die dazu nötige Robustheit erlangte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c518b63-352f-341b-9111-0a20a1534b27",
                                        "entry_id": "6920d1b2-526a-3cfb-bc4d-c1e504e632c9",
                                        "glosses": [
                                            "von Sachen: Stabilität gegenüber Störungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0f1024c-9e80-4b41-a601-f31a7942b4e3",
                                                "sense_id": "0c518b63-352f-341b-9111-0a20a1534b27",
                                                "text": "„Ein Mobiltelefon muss aber nicht nur funktionieren, es soll auch hübsch und möglichst aktuell sein, und es darf keinesfalls in Sachen Robustheit den Kampf gegen Schlüsselbund, Parfumfläschchen und Konsorten in der Handtasche verlieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
