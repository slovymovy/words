                                        "sense_id": "50477a0e-1bc5-32e4-b845-e53bbe0654d7",
                                        "entry_id": "4f779064-cf0f-3cbc-83e6-2e87cb8a0ec8",
                                        "glosses": [
                                            "Pluriel de révélation."
