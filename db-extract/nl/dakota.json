                                        "glosses": [
                                            "A unisex given name transferred from the place name."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60c3ad4f-2fda-4ff7-a951-ab5fb3594afb",
                                                "sense_id": "7cc83e5c-8061-3554-a717-5f2d0d426d60",
                                                "text": "'Montana?' I said. 'You can't call a kid Montana'―these friends of mine were going to call their new baby girl Montana and I tried to talk them out of it, because I'm sick of Australians naming their kids after American placenames, I'm sick of all these Montanas and Delawares and Indianas and Dallases. You'd never hear it the other way around; you're not going to hear about an American kid called Warrnambool or Kooweerup― [- - -] and they said,'Okay okay, we won't call her Montana.' So they called her Dakota."
                                            }
                                        ]
                                    }
