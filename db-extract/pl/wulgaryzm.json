                "senses": [
                    {
                        "sense_id": "0691392a-2c5e-3a7a-83c6-372d23f7ab6a",
                        "entry_id": "2dee13bc-1a0f-30f9-ab06-a6981ba54cf0",
                        "glosses": [
                            "słowo albo wyrażenie wulgarne, obelżywe, ordynarne i łamiące normy społeczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aff2afcb-635a-442e-be3b-ed6320814afc",
                                "sense_id": "0691392a-2c5e-3a7a-83c6-372d23f7ab6a",
                                "text": "Przeglądanie słownika Edward rozpoczął od wyszukiwania wulgaryzmów."
                            },
                            {
                                "example_id": "cb9c0148-5358-467c-a01c-1c5bb0c202f5",
                                "sense_id": "0691392a-2c5e-3a7a-83c6-372d23f7ab6a",
                                "text": "Język więźniów jest pełen wulgaryzmów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db573bd1-408c-4377-88b4-0787ef49f142",
                        "source_entry_id": "2dee13bc-1a0f-30f9-ab06-a6981ba54cf0",
                        "source_sense_id": "0691392a-2c5e-3a7a-83c6-372d23f7ab6a",
                        "target_lang_word": "vulgarism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vulgarism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80e297eb-c943-3f36-9ac8-fa1e9fefe536",
                                        "entry_id": "001a8938-a4bd-35a9-a71d-0304231a905c",
                                        "glosses": [
                                            "A word or term that is considered offensive or vulgar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c8173b-da20-43a5-a481-f8e436e20422",
                                                "sense_id": "80e297eb-c943-3f36-9ac8-fa1e9fefe536",
                                                "text": "\"Shit\" is a vulgarism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0782ced-f33b-3a67-a14e-75612b936f93",
                                        "entry_id": "001a8938-a4bd-35a9-a71d-0304231a905c",
                                        "glosses": [
                                            "A spelling, word, or phrase used in common speech that is considered improper or incorrect for formal communication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d098548a-abe4-472e-9408-85fbf873a7f0",
                                                "sense_id": "d0782ced-f33b-3a67-a14e-75612b936f93",
                                                "text": "We never descended to the vulgarism of a quarrel. People said that neither of us had a heart, but it appears to me that politeness is an excellent substitute."
                                            },
                                            {
                                                "example_id": "06930bf9-889d-4da2-a4a4-7f3f0e504f37",
                                                "sense_id": "d0782ced-f33b-3a67-a14e-75612b936f93",
                                                "text": "Editors of newspapers allow more vulgarisms to go to print today than they used to."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7c5bfdf-0e2f-4c64-8bd6-ad06e9ac2f41",
                        "source_entry_id": "2dee13bc-1a0f-30f9-ab06-a6981ba54cf0",
                        "source_sense_id": "0691392a-2c5e-3a7a-83c6-372d23f7ab6a",
                        "target_lang_word": "vulgarisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vulgarisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4dad9fd-55d2-3e3c-a1ed-b7dd69f00c06",
                                        "entry_id": "46f82d54-1ff8-373f-91ee-ba526f01bebc",
                                        "glosses": [
                                            "Expression vulgaire, populaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c2588db-6d0b-4595-a2c0-c1d47b34eea5",
                                                "sense_id": "b4dad9fd-55d2-3e3c-a1ed-b7dd69f00c06",
                                                "text": "C'est là un solécisme que le grammairien s'empressera de taxer de vulgarisme, mais que le linguiste, plus magnanime, s'efforcera d'expliquer en invoquant quelque action analogique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eef383fb-35d9-4371-9646-184cf34f782d",
                        "source_entry_id": "2dee13bc-1a0f-30f9-ab06-a6981ba54cf0",
                        "source_sense_id": "0691392a-2c5e-3a7a-83c6-372d23f7ab6a",
