                "senses": [
                    {
                        "sense_id": "86aa38b6-44b4-3cdf-82fd-cc9478c642b2",
                        "entry_id": "f109feb0-9cf2-3b46-ae74-f17f1dd9f479",
                        "glosses": [
                            "een intieme romantische relatie tussen twee personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fad0f496-a433-4a1d-827f-93cd020fb3f5",
                                "sense_id": "86aa38b6-44b4-3cdf-82fd-cc9478c642b2",
                                "text": "Hun liefdesverhouding duurde twee maanden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c001da0-37f2-42c0-8993-c2e00eb3e248",
                        "source_entry_id": "f109feb0-9cf2-3b46-ae74-f17f1dd9f479",
                        "source_sense_id": "86aa38b6-44b4-3cdf-82fd-cc9478c642b2",
                        "source_sense_description": "liefdesrelatie",
                        "target_lang_word": "Liebesverhältnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liebesverhältnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9eb50e3a-6c19-33b7-b7a4-87fe873ae036",
                                        "entry_id": "9fbe113c-ecce-36dc-89e2-906122f3d0be",
                                        "glosses": [
                                            "Beziehung aufgrund von Liebesgefühlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c70de6e-bcb9-443a-84fa-5fe5e288eb87",
                                                "sense_id": "9eb50e3a-6c19-33b7-b7a4-87fe873ae036",
                                                "text": "„Wie zitiert, hören Genievra und Lanzelot der Geschichte zu, und wie wir wissen, wird das Liebesverhältnis der beiden das Artusreich in seine größte Krise stürzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d3852e5-df7e-4097-9005-7254d628286d",
                        "source_entry_id": "f109feb0-9cf2-3b46-ae74-f17f1dd9f479",
                        "source_sense_id": "86aa38b6-44b4-3cdf-82fd-cc9478c642b2",
                        "source_sense_description": "liefdesrelatie",
                        "target_lang_word": "Liebesbeziehung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liebesbeziehung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                        "entry_id": "55fa2373-3faa-3dde-9a19-33b09ca056fc",
                                        "glosses": [
                                            "Verhältnis zwischen mindestens zwei Menschen, das von inniger Zuneigung, starker körperlicher und geistiger Anziehung und dem Wunsch nach Nähe geprägt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e10a5be-4f38-406f-8ec7-0bbae4ca0fbe",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "„Am stärksten beeindruckte es sie natürlich, daß Dincklage seine Liebesbeziehung zu ihr ruhig fortführte.“"
                                            },
                                            {
                                                "example_id": "fccdd272-f1f0-4431-8762-f89441911274",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "Er unterhält derzeit gleich mehrere Liebesbeziehungen in verschiedenen Städten."
                                            },
                                            {
                                                "example_id": "330ef697-383c-4419-90a5-da98f4786161",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "Besteht zwischen dir und Daniel nun eine Liebesbeziehung oder nicht?"
                                            },
                                            {
                                                "example_id": "a84c9290-0e05-4645-b7cd-c2744959173a",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "Simon leidet sehr unter dem Ende seiner Liebesbeziehung mit Hugo."
                                            },
                                            {
                                                "example_id": "5f94f8df-f587-4eb9-be14-252fc6ca6839",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "Veit hat sich auf eine Liebesbeziehung mit seiner Nachbarin eingelassen."
                                            },
                                            {
                                                "example_id": "7ebae253-15d1-48a5-bbef-5cf53e37f92b",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "Obwohl er sie gernhatte, ging er keine Liebesbeziehung mit Wilma ein, weil er den Widerstand seines Umfelds zu sehr fürchtete."
                                            },
                                            {
                                                "example_id": "a8b88233-e7e7-408f-9ff5-0079e1c1173f",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "Durch die Liebesbeziehung mit Leah gewann er immens an Selbstbewusstsein und blühte regelrecht auf."
                                            },
                                            {
                                                "example_id": "300e5206-36c2-4f87-88c5-2b42beb9e9e8",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "Nach sieben gescheiterten Liebesbeziehungen hat Herr Schmidt den Glauben an das Glück zu zweit verloren."
                                            },
                                            {
                                                "example_id": "0c2e43d0-6661-4769-87cd-0327a140ffa5",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "Sie hatte noch nie eine Liebesbeziehung gehabt, bevor sie ihre jetzige Lebenspartnerin traf."
                                            },
                                            {
                                                "example_id": "523e2fa0-846a-4ac1-a507-de65ab9f8d7f",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "Tim, Mia und Finn führen eine glückliche Liebesbeziehung zu dritt."
                                            },
                                            {
                                                "example_id": "963dcfa7-e40d-4596-abe1-5aaa984cda8b",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "„Das sei nicht ehetypisch, entgegnete Thomas, das könne sie auch über jede andere Liebesbeziehung sagen.“"
                                            },
                                            {
                                                "example_id": "264969bd-c072-4bc1-ace5-07df2db1e7cc",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "„Zweifellos, die Liebesbeziehung zu Marlene Dietrich, die im Sommer 1937 beginnt und 1940 wieder beendet ist, und das sich unmittelbar anschließende Verhältnis mit der russischen Schauspielerin Natascha Paley (1941 bis 1950) haben das ihre zur Krisenstimmung beigetragen.“"
                                            },
                                            {
                                                "example_id": "2a9ebcf6-3da5-4572-a6b0-2fd597b10772",
                                                "sense_id": "1912a164-8e3c-3e30-b7b7-34f8c1196e68",
                                                "text": "„Dass die Wunder in einer Liebesbeziehung sehr schnell erlöschen, will sie nicht hinnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcc3a834-a1e8-4ea1-83cc-849d2f55e943",
                        "source_entry_id": "f109feb0-9cf2-3b46-ae74-f17f1dd9f479",
                        "source_sense_id": "86aa38b6-44b4-3cdf-82fd-cc9478c642b2",
                        "source_sense_description": "liefdesrelatie",
                        "target_lang_word": "relationship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relationship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1aab639d-abb5-308b-acd1-4b10e374123d",
                                        "entry_id": "5acd993f-c391-333f-a937-f2bd089e57e3",
                                        "glosses": [
                                            "Connection or association; the condition of being related."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ef8298-2903-4a98-a57b-c8d970435574",
                                                "sense_id": "1aab639d-abb5-308b-acd1-4b10e374123d",
                                                "text": "But some discussion of the complex relationship between “allohistory” and sf is appropriate here, as the genres overlap in certain ways. Classical allohistory— such as Trevelyan's \"What if Napoleon had won the Battle of Waterloo?\" and Churchill's \"If Lee had not won the Battle of Gettysburg\" —is a rigorously consistent thought-experiment in historical causality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "735ff23d-acd1-3e91-ab64-9378f5ed9711",
                                        "entry_id": "5acd993f-c391-333f-a937-f2bd089e57e3",
                                        "glosses": [
                                            "The links between the x-values and y-values of ordered pairs of numbers especially coordinates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "989cd24f-f6b6-42ed-a12c-305fafecf4be",
                                                "sense_id": "735ff23d-acd1-3e91-ab64-9378f5ed9711",
                                                "text": "Policing the relationship between government and business in a free society is difficult. Businesspeople have every right to lobby governments, and civil servants to take jobs in the private sector."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb67e5df-3166-3d90-b3c8-829b847ccfdb",
                                        "entry_id": "5acd993f-c391-333f-a937-f2bd089e57e3",
                                        "glosses": [
                                            "Kinship; being related by blood or marriage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c43f5eb5-e459-3652-baaf-d9b3febefc7d",
                                        "entry_id": "5acd993f-c391-333f-a937-f2bd089e57e3",
                                        "glosses": [
                                            "A romantic or sexual involvement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d0c4ff4-8c27-4e42-a9c1-6321ab18f792",
                                                "sense_id": "c43f5eb5-e459-3652-baaf-d9b3febefc7d",
                                                "text": "Contrary to the popular perception that love typically sparks from passion, a new study finds two-thirds of romantic relationships begin as long-term friendships."
                                            },
                                            {
                                                "example_id": "7cb452cd-260c-4914-8b8e-cb6ee7dea244",
                                                "sense_id": "c43f5eb5-e459-3652-baaf-d9b3febefc7d",
                                                "text": "They have been in a relationship for ten years, but have never married."
                                            },
                                            {
                                                "example_id": "0b102733-dd85-4b4e-b823-e34f47e99573",
                                                "sense_id": "c43f5eb5-e459-3652-baaf-d9b3febefc7d",
                                                "text": "I'm not advocating sexual promiscuity but I think it's possible for a woman to have many kinds of sexual relationships with many men and that shouldn't affect the status of the marriage."
                                            },
                                            {
                                                "example_id": "90b7e26e-9734-4930-a3df-2a027513f91d",
                                                "sense_id": "c43f5eb5-e459-3652-baaf-d9b3febefc7d",
                                                "text": "Her most satisfying sexual relationship seemed to be a threesome with Charles Chaplin Jr. and Eddy Robinson Jr., the spurned sons of famous film fathers."
                                            },
                                            {
                                                "example_id": "7d77c89e-5bf9-4639-93fe-27bc91f331d7",
                                                "sense_id": "c43f5eb5-e459-3652-baaf-d9b3febefc7d",
                                                "text": "Only 25.3% of our participants had a social peer group, and just 3.4% had ever been in a romantic relationship. None were currently in a relationship or married."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "138addaf-78ea-3daf-9707-286b80359d88",
                                        "entry_id": "5acd993f-c391-333f-a937-f2bd089e57e3",
                                        "glosses": [
                                            "A way in which two or more people behave and are involved with each other"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff6a0416-114b-40c2-b31b-342971c20390",
                                                "sense_id": "138addaf-78ea-3daf-9707-286b80359d88",
                                                "text": "I have a good working relationship with my boss."
                                            },
                                            {
                                                "example_id": "0d047995-4cee-4219-a155-5444fd234a26",
                                                "sense_id": "138addaf-78ea-3daf-9707-286b80359d88",
                                                "text": "“I Love Lisa” opens with one of my favorite underappreciated running jokes from The Simpsons: the passive-aggressive, quietly contentious relationship of radio jocks Bill and Marty, whose mindless happy talk regularly gives way to charged exchanges that betray the simmering resentment and disappointment perpetually lingering just under the surface of their relationship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fe6772f-c8cd-3f0a-9b16-11e0b2824dfb",
                                        "entry_id": "5acd993f-c391-333f-a937-f2bd089e57e3",
                                        "glosses": [
                                            "The level or degree of affinity between keys, chords and tones."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49a74e1b-ae51-4063-abd6-b3b8ac077420",
                        "source_entry_id": "f109feb0-9cf2-3b46-ae74-f17f1dd9f479",
