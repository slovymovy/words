                "senses": [
                    {
                        "sense_id": "ae39e0ad-f4c8-31f7-aec8-29fe56e33137",
                        "entry_id": "74d7e05a-bbe0-374c-b752-f62b57f7c41f",
                        "glosses": [
                            "действие по значению гл. раздваивать, раздвоить, раздваиваться, раздвоиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ced0f460-14b9-4b53-a6b8-384fbf69425c",
                                "sense_id": "ae39e0ad-f4c8-31f7-aec8-29fe56e33137",
                                "text": "Важно не упустить начало формирования растений томата, чтобы не допустить отрастания пасынков или раздвоения вершин."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4f4a26f-d551-3c8e-996a-c7edfb0ceeed",
                        "entry_id": "74d7e05a-bbe0-374c-b752-f62b57f7c41f",
                        "glosses": [
                            "то же, что раздвоенность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a06bc1b-a3a9-4519-a885-31a1996b71c5",
                                "sense_id": "c4f4a26f-d551-3c8e-996a-c7edfb0ceeed",
                                "text": "Ощущать в себе раздвоение."
                            },
                            {
                                "example_id": "1e976e91-7edd-4e5f-acb6-a18623c27177",
                                "sense_id": "c4f4a26f-d551-3c8e-996a-c7edfb0ceeed",
                                "text": "Унылое раздвоение."
                            }
                        ]
                    },
                    {
                        "sense_id": "af43cef3-45eb-384e-a330-e6b84fb1e769",
                        "entry_id": "74d7e05a-bbe0-374c-b752-f62b57f7c41f",
                        "glosses": [
                            "раздвоившаяся, раздвоенная часть чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e53aa9-093a-47f2-b0f2-c7c8741caba2",
                                "sense_id": "af43cef3-45eb-384e-a330-e6b84fb1e769",
                                "text": "Копыто с раздвоением."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37b11f20-8299-40c5-93db-8d71a76501d4",
                        "source_entry_id": "74d7e05a-bbe0-374c-b752-f62b57f7c41f",
                        "source_sense_description": "действие по значению гл. «раздваивать», «раздвоить», «раздваиваться», «раздвоиться»",
                        "target_lang_word": "division",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "division",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d80445c-2942-3d7c-a7fa-ff586439dcf9",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Action de diviser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94666a9a-8606-4579-bffe-81ad0cab3f02",
                                                "sense_id": "7d80445c-2942-3d7c-a7fa-ff586439dcf9",
                                                "text": "La division d’un entrepôt en plusieurs appartements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5119293c-6b0a-3120-b9c7-96aa75ad03c8",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Action de diviser.",
                                            "Partage arithmétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7b114e7-25f2-42b0-abd2-3243bb8fac68",
                                                "sense_id": "5119293c-6b0a-3120-b9c7-96aa75ad03c8",
                                                "text": "Le but de ces programmes, évidemment, est d’être si nazes et inregardables que les enfants préféreraient être encore en classe. Ainsi, quand ils doivent se lever le lendemain matin et se coltiner des divisions complexes, ils se diront : Au moins, je ne suis pas entrain de regarder ces affreux films à la maison."
                                            },
                                            {
                                                "example_id": "f484d820-de13-4803-bcc7-fc3a9bf80cae",
                                                "sense_id": "5119293c-6b0a-3120-b9c7-96aa75ad03c8",
                                                "text": "La Division euclidienne. — La division d’un nombre par un autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c5e990-b0d1-3cb6-91f8-0113871646c2",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Action de diviser.",
                                            "Action de se diviser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9acc1924-afed-47c3-adea-41467666c13f",
                                                "sense_id": "11c5e990-b0d1-3cb6-91f8-0113871646c2",
                                                "text": "La méiose est un type de division cellulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a78266f1-a6ce-3710-b9a9-19760e10ba31",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Action de diviser.",
                                            "Fractionnement d’une action par division de son nominal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbac5fc1-fa43-3384-88d0-1c1b03bde934",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Action de diviser.",
                                            "Formation artificielle d’une colonie, par isolation d’une partie de ses abeilles et de ses rayons dans une nouvelle ruche afin de simuler un essaimage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32fadac1-ea58-331a-8469-0f41ca45b8d9",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Graduation, marque qui divise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8beeb1e8-41de-42e5-9450-b1da4931fc01",
                                                "sense_id": "32fadac1-ea58-331a-8469-0f41ca45b8d9",
                                                "text": "Les cadrans bleus, mauves et rouges des instruments avec leurs divisions de radium forment curieusement le décor d’une scène de féerie enfantine aux teintes vives."
                                            },
                                            {
                                                "example_id": "be3ee5dc-0b68-479d-8500-3086a0710e4a",
                                                "sense_id": "32fadac1-ea58-331a-8469-0f41ca45b8d9",
                                                "text": "Les divisions du thermomètre sont graduées en degrés Celsius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e14429-9227-3424-84f6-4c7111daa71f",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Élément d’un ensemble divisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d9f05e-c813-40f6-8fff-8b31e44ed755",
                                                "sense_id": "33e14429-9227-3424-84f6-4c7111daa71f",
                                                "text": "Tel qu’il est aujourd’hui installé, l’asile de la rue Lecourbe peut recevoir 200 enfants. Il comprend trois divisions : le grands, les petits et les infirmes."
                                            },
                                            {
                                                "example_id": "0967c049-0dfc-43f5-a5cc-6827acf7736a",
                                                "sense_id": "33e14429-9227-3424-84f6-4c7111daa71f",
                                                "text": "Le département est une division administrative du territoire français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0383842c-dce7-33c6-9c76-9c95f969cdb0",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Direction opérationnelle."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff97663-8c46-4f90-987f-9e5f0c2b26d6",
                                                "sense_id": "0383842c-dce7-33c6-9c76-9c95f969cdb0",
                                                "text": "La division du personnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641bdfbb-c0c9-358e-a01b-ad422f6bae8d",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Direction opérationnelle.",
                                            "Bureau d’un état-major qui traite les questions militaires d’une espèce particulière, telles que personnel, renseignement, plans et instructions, ou approvisionnements et évacuation."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd1c42d8-81dc-3d1a-89b7-8cb2333e3cf5",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Unité ou détachement tactique qui possède organiquement les armes et les services nécessaires à un combat d’une certaine durée ; elle se situe entre le corps d’armée et la brigade (ou le régiment)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d22ae81-d62d-4ce7-8581-17a1502546d8",
                                                "sense_id": "dd1c42d8-81dc-3d1a-89b7-8cb2333e3cf5",
                                                "text": "À la nuit, on apprit que la division de Forton avait eu un engagement sérieux, du côté de Mars-la-Tour."
                                            },
                                            {
                                                "example_id": "96f1c5a6-9632-4728-9df0-aa0945c74fdd",
                                                "sense_id": "dd1c42d8-81dc-3d1a-89b7-8cb2333e3cf5",
                                                "text": "La 7ᵉ division de cavalerie recevait enfin une mission appropriée à cette arme, celle d’éclairer en avant de Buzancy."
                                            },
                                            {
                                                "example_id": "19b2f1ff-c4fa-40a2-ad1a-1d9de6c39c53",
                                                "sense_id": "dd1c42d8-81dc-3d1a-89b7-8cb2333e3cf5",
                                                "text": "Le 17 octobre, seulement, Le Caire comprit que les Israéliens continuaient à renforcer leur tête de pont ; à cette date, un pont flottant était déjà en place et une division au grand complet avait pu traverser."
                                            },
                                            {
                                                "example_id": "3f4d80f8-15b7-4bd2-8fea-1ef790936ff8",
                                                "sense_id": "dd1c42d8-81dc-3d1a-89b7-8cb2333e3cf5",
                                                "text": "Division navale, ensemble de navires groupés sous un même commandement opérationnel ou logistique, unité tactique d’une escadrille aéronavale, comprenant plusieurs sections."
                                            },
                                            {
                                                "example_id": "bfb6a7c7-7241-4247-a829-98c427150683",
                                                "sense_id": "dd1c42d8-81dc-3d1a-89b7-8cb2333e3cf5",
                                                "text": "Division aérienne, groupement aérien de combat consistant normalement en deux groupes ou plus avec les unités des services appropriés."
                                            },
                                            {
                                                "example_id": "b8aefffc-feda-4a8d-9df9-7cf6d90acb43",
                                                "sense_id": "dd1c42d8-81dc-3d1a-89b7-8cb2333e3cf5",
                                                "text": "Les groupes de combat d’une division aérienne comprennent normalement des unités de type similaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcc8dd2b-6ca2-3ad1-9236-2450ce2e8032",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Désunion, opposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4847c34b-197c-4e1e-bc50-bd9199eed91d",
                                                "sense_id": "bcc8dd2b-6ca2-3ad1-9236-2450ce2e8032",
                                                "text": "Je ne voudrais pas semer la division dans les esprits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36ca0241-c0bc-308f-a8ec-28a70ca1405d",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Distribution entre plusieurs personnes ou catégories de personnes."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a215134-5cd5-4407-9e2c-c2272cfd34fa",
                                                "sense_id": "36ca0241-c0bc-308f-a8ec-28a70ca1405d",
                                                "text": "La division du travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c0c274f-8e2c-3318-af84-c2f41f3bcb4e",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Deuxième rang phylogénétique de la hiérarchie codifiée de la taxinomie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df783817-f051-3ca2-af60-e9ab8ab348a0",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Trait d’union utilisé pour marquer la coupure d’un mot en fin de ligne — (Unicode : ‐ (U+2010) ou plus souvent - (U+002D))."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1c3cb7b-1c61-4110-bff4-664e20395eb9",
                                                "sense_id": "df783817-f051-3ca2-af60-e9ab8ab348a0",
                                                "text": "La division, ‐, est le signe de la coupure des mots par syllabes à la fin des lignes. Elle n’est autre d’ailleurs que le trait d’union grammatical, auquel, par une anomalie qu’il est bon de remarquer, elle donne le plus souvent son nom dans le langage typographique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38623bb1-cf17-3a1d-a9b9-30bc21685c48",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Niveau de championnat, regroupant des équipes destinées à se rencontrer. Les trois premiers niveaux d'un championnat sont désignés par les termes D1, D2 et D3."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "923732de-67cb-41de-a8e0-507c0a2b6899",
                                                "sense_id": "38623bb1-cf17-3a1d-a9b9-30bc21685c48",
                                                "text": "Bien sûr, depuis longtemps le Red Star est descendu en deuxième division. Mais c’est bien, la deuxième division. Le jeu y est de qualité correcte, sans cette suspicion qui plane sur les événements trop conséquents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a61ae1b-6ab0-3865-8bc3-e13076481147",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Enseignement d’une année scolaire d’un niveau déterminé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89b680ae-3c63-38f3-a987-09a1d17a6825",
                                        "entry_id": "fe7810ca-ef4b-3298-9edc-f14e2c57baec",
                                        "glosses": [
                                            "Groupe d’élèves suivant les enseignements ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06116bca-07c5-471a-bb9a-2e2a5714e784",
                                                "sense_id": "89b680ae-3c63-38f3-a987-09a1d17a6825",
                                                "text": "[Cet enseignement] est pris en charge simultanément par un enseignant de STI et un enseignant de physique (deux enseignants dans une division) dès lors que l’effectif de la division est supérieur à 15 étudiants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
