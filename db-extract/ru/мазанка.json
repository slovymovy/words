                "senses": [
                    {
                        "sense_id": "b2a6deb1-5b3c-381e-b498-5e7bc49d155c",
                        "entry_id": "8e480dac-7b1f-338e-84f9-190eb46c8d4e",
                        "glosses": [
                            "дом из глины или обмазанного глиной дерева, сырцового кирпича"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f272cc3-d4d6-427c-b3e1-8deb3e4d495b",
                                "sense_id": "b2a6deb1-5b3c-381e-b498-5e7bc49d155c",
                                "text": "В середине сада стояла двухэтажная каменная дача, и с другого боку — длинная мазанка, видимо, для прислуги."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5f4e400-9687-49d8-92ef-7c718a53e167",
                        "source_entry_id": "8e480dac-7b1f-338e-84f9-190eb46c8d4e",
                        "source_sense_id": "b2a6deb1-5b3c-381e-b498-5e7bc49d155c",
                        "target_lang_word": "wattle house",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4529551f-f860-4402-9fc5-0f7c14d4c924",
                        "source_entry_id": "8e480dac-7b1f-338e-84f9-190eb46c8d4e",
                        "source_sense_id": "b2a6deb1-5b3c-381e-b498-5e7bc49d155c",
                        "target_lang_word": "Lehmhütte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lehmhütte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4d7aaaa-19e5-3619-b0be-c2006d069d04",
                                        "entry_id": "966a33e7-9401-3a0d-976c-01d9a3adba73",
                                        "glosses": [
                                            "einfache Behausung, dessen Baumittel vorwiegend Lehm ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87b24443-d02c-4418-bc16-038a489c9ba4",
                                                "sense_id": "f4d7aaaa-19e5-3619-b0be-c2006d069d04",
                                                "text": "„Die Dorfbewohner waren so verängstigt, dass sie sich nicht aus ihren Lehmhütten wagten.“"
                                            },
                                            {
                                                "example_id": "7edd6cd2-c1fa-4d64-b08b-cec943aa3439",
                                                "sense_id": "f4d7aaaa-19e5-3619-b0be-c2006d069d04",
                                                "text": "„Dies war ebenfalls eine Gewohnheit aus dem Dorf, wo die Menschen den Tag unter freiem Himmel verbrachten, unter einem Baum oder im Hof, und ihre Lehmhütten nur zum Schlafen oder als Schutz gegen nachtaktive Tiere benutzten.\""
                                            },
                                            {
                                                "example_id": "eeef5e58-c61b-46f9-a7e6-ba7f8ad181c0",
                                                "sense_id": "f4d7aaaa-19e5-3619-b0be-c2006d069d04",
                                                "text": "„Dort wohnt die Lokalbevölkerung in einfachen Lehmhütten.“"
                                            },
                                            {
                                                "example_id": "83f33adc-1181-443b-8253-387dd9ffcd31",
                                                "sense_id": "f4d7aaaa-19e5-3619-b0be-c2006d069d04",
                                                "text": "„Nachdem die Lehmhütte eingestürzt war und eine Lawine den Felsspalt geschlossen hatte, war sogar der Ort der Ereignisse aus dem Gedächtnis der Menschen gestrichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
