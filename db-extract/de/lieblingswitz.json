                    {
                        "sense_id": "db74fa7f-cba7-3a8a-9afb-037d92883c00",
                        "entry_id": "f35fab65-7d4e-31bb-a8b6-8e632110c5bb",
                        "glosses": [
                            "Witz, den eine Person(engruppe) am meisten mag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8fcbb47-c3fe-4a39-88e2-5c9ffafcfb40",
                                "sense_id": "db74fa7f-cba7-3a8a-9afb-037d92883c00",
                                "text": "„Ich denke an ihren Lieblingswitz, den mit dem Meterpreis für Jungfernhäutchen.“"
                            },
                            {
                                "example_id": "5694b71d-4895-4ea9-b43e-7a34364f7f0c",
                                "sense_id": "db74fa7f-cba7-3a8a-9afb-037d92883c00",
                                "text": "„Wir unterhielten uns im Vorgespräch, es war 6 Uhr morgens, über Alterswitze, und ich erzählte ihr prompt meinen damaligen Lieblingswitz, den ich meinem Freund Marcel Reif verdanke.“"
                            },
                            {
                                "example_id": "51dadb5b-a797-4a58-8315-3ba0b7640ea9",
                                "sense_id": "db74fa7f-cba7-3a8a-9afb-037d92883c00",
                                "text": "„Die Psychologie kann daher einen Menschen nach seinem Lieblingswitz testen, und dieses Verfahren ist gar nicht so neuartig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
