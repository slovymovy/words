                                        "entry_id": "aed13011-fb59-3a84-baa9-e9f14cb3c182",
                                        "glosses": [
                                            "The possession of more than the normal number of digits."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ef394f4-393f-444b-b9a1-4d9fa184492c",
                                                "sense_id": "fa284878-921c-3ac0-9672-5e1e3dd0fa7f",
                                                "text": "Devendra Harne, pictured above, (India; born January 9, 1995) also has 25 in total (12 fingers and 13 toes) as a result of the condition polydactylism."
                                            }
                                        ]
                                    }
                                ]
