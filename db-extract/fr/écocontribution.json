                        "glosses": [
                            "Participation financière des consommateurs à l’effort fait pour diminuer les impacts écologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5777f12b-1372-47f1-bed8-981d4f1b4d24",
                                "sense_id": "e8474561-b7bf-36a9-8939-516f64ae2e8d",
                                "text": "Via l’écocontribution que nous versons lors de l’achat d’un réfrigérateur, d'un aspirateur, d’un téléphone, d’un ordinateur portable, d’un téléviseur, de lampes, de piles ou encore d’emballages, de papiers ou de textiles."
                            },
                            {
                                "example_id": "c61572a4-9477-481a-bd33-c89670a6f86e",
                                "sense_id": "e8474561-b7bf-36a9-8939-516f64ae2e8d",
                                "text": "Le groupe Les Écologistes a lui jugé \"prometteuse pour la transition écologique et la justice territoriale\" la mise en place de l' écocontribution des poids-lourds."
                            }
                        ]
