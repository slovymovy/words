                        "source_sense_id": "3a822778-eb0b-3ced-9b0a-ad9331273073",
                        "source_sense_description": "een mouwloos jasje, te dragen onder de jas van het kostuum",
                        "target_lang_word": "Weste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6b8aaa5-ae08-3d44-a21e-33fdaed98a21",
                                        "entry_id": "990a1945-cf9d-38a2-9ee6-a571d6d68f93",
                                        "glosses": [
                                            "ein ärmelloses Kleidungsstück der Herrenoberbekleidung"
                                        ],
                                        "tags": [
                                            "Bekleidung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1619879-5c3a-40d4-9226-8f92a2d68ad5",
                                                "sense_id": "c6b8aaa5-ae08-3d44-a21e-33fdaed98a21",
                                                "text": "Sobald der Wind aufkam, zog ich mir zusätzlich eine Weste an."
                                            },
                                            {
                                                "example_id": "b634bc2e-3499-4bf0-9aaa-de3bca8f97a9",
                                                "sense_id": "c6b8aaa5-ae08-3d44-a21e-33fdaed98a21",
                                                "text": "„Er trug ein Tweedjackett und eine Weste in Beige, seine dunklen Haare waren kurz und grau meliert, die Haut ein wenig dunkler als die seiner Frau.“"
                                            },
                                            {
                                                "example_id": "4e09e2eb-ef7d-41c3-b2e3-45c052dba029",
                                                "sense_id": "c6b8aaa5-ae08-3d44-a21e-33fdaed98a21",
                                                "text": "„Der größere trug einen Leinenanzug und hatte den Hut nach hinten geschoben, die Weste aufgeknöpft und die Halsbinde in der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
