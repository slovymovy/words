                        "glosses": [
                            "Relatif à un objectif, une chose objective."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c21c541-e596-44e6-a4e7-9a79e30893c5",
                                "sense_id": "c6cbaf8e-a817-30de-b730-ba88e6b35695",
                                "text": "Cette dichotomie ne privilégie-t-elle pas une perspective génétique qui ne pourra que s'écarteler entre des préconditions objectivales, maîtrisables, et un sujet insaisissable, non situé dans son ou ses émergences structurales ?"
                            },
                            {
                                "example_id": "73f72945-2e1a-43cd-9918-44a38c947796",
                                "sense_id": "c6cbaf8e-a817-30de-b730-ba88e6b35695",
                                "text": "Plus les éléments de la valeur chosale sont apparents, plus ils sont objectivaux, et moins la valeur de vérité l'est."
                            }
                        ]
                    }
