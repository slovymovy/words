            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2c16c13-a179-314e-af05-e532b29f7e5b",
                    "sense_definition": "The people who come from Scotland, considered as a group.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Scottish</w> are known for their warm hospitality.",
                            "target_lang_translations": {
                                "ru": "<w>Шотландцы</w> известны своим теплым гостеприимством.",
                                "zh": "<w>苏格兰人</w>以热情好客而闻名。"
                            }
                        },
                        {
                            "text": "Many of the <w>Scottish</w> celebrate Burns Night every year.",
                            "target_lang_translations": {
                                "ru": "Многие <w>шотландцы</w> ежегодно празднуют Ночь Бернса.",
                                "zh": "许多<w>苏格兰人</w>每年都会庆祝彭斯之夜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Scots"
                    ],
                    "common_phrases": [
                        "the Scottish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди родом из Шотландии как группа; шотландский народ.",
                        "zh": "来自苏格兰的人群，即苏格兰民族。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шотландцы",
                                "target_lang_sense_clarification": "народ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苏格兰人",
                                "target_lang_sense_clarification": "指代苏格兰民族群体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4c7ae600-37e2-3f19-9291-1a25ced16f00",
                    "sense_definition": "The variety of the English language spoken in Scotland.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "It can be difficult to understand broad <w>Scottish</w> if you are not used to it.",
                            "target_lang_translations": {
                                "ru": "Трудно понять сильный <w>шотландский</w> акцент, если вы к нему не привыкли.",
                                "zh": "如果你不习惯的话，可能很难听懂浓重的<w>苏格兰英语</w>。"
                            }
                        },
                        {
                            "text": "Some words in <w>Scottish</w> are different from standard British English.",
                            "target_lang_translations": {
                                "ru": "Некоторые слова в <w>шотландском</w> отличаются от стандартного британского английского.",
                                "zh": "<w>苏格兰英语</w>中的一些词汇与标准英式英语不同。"
                            }
