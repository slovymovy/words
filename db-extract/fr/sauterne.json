                        "examples": [
                            {
                                "example_id": "fa435361-5aa7-4bc0-b912-8039c17d0bec",
                                "sense_id": "cf06032f-90b0-307b-99c4-65b4169be186",
                                "text": "Boire un sauterne."
                            },
                            {
                                "example_id": "39a23c92-b811-4fe8-9b21-0f770d4e0b37",
                                "sense_id": "cf06032f-90b0-307b-99c4-65b4169be186",
                                "text": "Il y avait Bibulus O’Bumper. Il dit son mot sur le latour et le markbrünnen, sur le champagne mousseux et le chambertin, sur le richebourg et le saint-georges, sur le haut-brion, le léoville et le médoc, sur le barsac et le preignac, sur le grave, sur le sauterne, sur le laffite et sur le saint-péray. Il hocha la tête à l’endroit du clos-vougeot, et se vanta de distinguer, les yeux fermés, le xérès de l’amontillado."
                            },
                            {
                                "example_id": "b6f6f078-8e8f-4b22-b662-edb466f0d51d",
                                "sense_id": "cf06032f-90b0-307b-99c4-65b4169be186",
                                "text": "Et pour faire passer cette mauvaise nouvelle, le général dégusta, à petits coups, un verre de sauterne."
                            },
                            {
                                "example_id": "eb847e95-5bc9-4d8c-917c-8398ea4e4ae5",
                                "sense_id": "cf06032f-90b0-307b-99c4-65b4169be186",
                                "text": "Et il vida dans un hanap ciselé un flacon de sauterne."
                            }
                        ]
                    }
