                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas de brancher le câble d'<w>alimentation</w> de votre ordinateur avant la réunion.",
                            "target_lang_translations": {
                                "en": "Don't forget to plug in your computer's <w>power</w> cable before the meeting.",
