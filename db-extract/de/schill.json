                ],
                "senses": [
                    {
                        "sense_id": "8b4bd981-744c-392b-baf1-d560705e6f5e",
                        "entry_id": "fb821bd0-b95e-3770-b7d8-ef192f38a847",
                        "glosses": [
                            "andere Bezeichnung für den Zander, einen im Süßwasser lebenden Raubfisch aus der Familie der Barsche. Der taxonomische Name lautet Stizostedion lucioperca."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b47c756-ad2d-4702-8240-44301d18979d",
                                "sense_id": "8b4bd981-744c-392b-baf1-d560705e6f5e",
                                "text": "Ich habe einen Schill gefangen."
                            },
                            {
                                "example_id": "d379f2b3-5438-4caf-9dbd-03d3d8033793",
                                "sense_id": "8b4bd981-744c-392b-baf1-d560705e6f5e",
                                "text": "„Die Metaphern und Epitheta, die ich für Forelle, Schill und Waller, Natur- oder Wiener Schnitzel, Schweinsstelze, Paprikarostbraten, verschiedene Salate und Erdäpfelspezien und schließlich die Gleichgewichtstorte oder die Linzerschnitten, das Gösser Bier, die Dürnsteiner, Kremser und Vöslauer Schoppenweine fand, kann ich mir nicht ins Gedächtnis zurückrufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "35048443-b8d1-3b23-924f-66cf517d2a30",
                        "entry_id": "fb821bd0-b95e-3770-b7d8-ef192f38a847",
                        "glosses": [
                            "Ansammlung leerer Muschelschalen"
                        ],
                        "tags": [
                            "unzählbar"
                        ],
                        "examples": [
                            {
                                "example_id": "de7b68b2-1f6f-424a-a408-85bd80a00f71",
                                "sense_id": "35048443-b8d1-3b23-924f-66cf517d2a30",
                                "text": "Bei dem vielen Schill ist es gefährlich, barfuß zu laufen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
