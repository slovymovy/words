                        "entry_id": "9e5abfd6-efc6-34c1-a187-341607295936",
                        "glosses": [
                            "Corps céleste du système solaire qui, à l’instar de Pluton est en résonance orbitale 2:3 avec Neptune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82b9baf6-96c5-46d8-8925-3f1b1e97a389",
                                "sense_id": "ea759ef8-1405-33c1-9c56-92164fc5e6c5",
                                "text": "Par définition, Pluton est le prototype des plutinos."
                            }
                        ]
                    }
                ],
                "translations": [
