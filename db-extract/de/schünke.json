                ],
                "senses": [
                    {
                        "sense_id": "b5c28bb9-654c-3e3b-9613-36042ce24717",
                        "entry_id": "30539b21-9c27-383c-9c37-cb87b86ef22b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb75447d-4ad4-4119-9193-ef359b419d49",
                                "sense_id": "b5c28bb9-654c-3e3b-9613-36042ce24717",
                                "text": "Frau Schünke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "035365e7-cad5-452b-9a14-f46cc7b68642",
                                "sense_id": "b5c28bb9-654c-3e3b-9613-36042ce24717",
                                "text": "Herr Schünke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5407ba41-a91b-4f8e-92b1-071329f979c8",
                                "sense_id": "b5c28bb9-654c-3e3b-9613-36042ce24717",
                                "text": "Die Schünkes fahren heute nach Leipzig."
                            },
                            {
                                "example_id": "09d0f059-4c7d-4e1a-8bf7-7b2f244a8222",
                                "sense_id": "b5c28bb9-654c-3e3b-9613-36042ce24717",
                                "text": "Der Schünke trägt nie die Pullover, die die Schünke ihm strickt."
                            },
                            {
                                "example_id": "5d0463cb-800b-44a7-95a5-54dd1a659f59",
                                "sense_id": "b5c28bb9-654c-3e3b-9613-36042ce24717",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schünke kommt, geht der Herr Schünke.“"
                            },
                            {
                                "example_id": "e246af87-8acf-46ea-85ec-5432473dc38d",
                                "sense_id": "b5c28bb9-654c-3e3b-9613-36042ce24717",
                                "text": "Schünke kommt und geht."
                            },
                            {
                                "example_id": "9e8363c0-47c3-44ca-84b8-393711f8b95a",
                                "sense_id": "b5c28bb9-654c-3e3b-9613-36042ce24717",
                                "text": "Schünkes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
