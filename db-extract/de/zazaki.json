                "senses": [
                    {
                        "sense_id": "ebb27383-b799-3497-8de9-3d96f608c630",
                        "entry_id": "e9a0846e-2859-3d2a-91d4-a5f0a4975a40",
                        "glosses": [
                            "eine Sprache, die im Osten der Türkei von den Zaza gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45ab83e1-aaed-404d-a848-2f9d88b335f9",
                                "sense_id": "ebb27383-b799-3497-8de9-3d96f608c630",
                                "text": "„Zazaki ist in seinem Kerngebiet Zentral-Ostanatolien dominierend neben Türkisch und den kurdischen Sprachen.“"
                            },
                            {
                                "example_id": "37c3bc9a-0051-47e7-bb94-400773ccfe97",
                                "sense_id": "ebb27383-b799-3497-8de9-3d96f608c630",
                                "text": "„Das Zazaki wird von den Zazaki sprechenden Alevitinnen und Aleviten auch nicht als kurdische Sprache bezeichnet."
                            },
                            {
                                "example_id": "6e3b39bd-d23c-4ff8-9570-49ebd3193b95",
                                "sense_id": "ebb27383-b799-3497-8de9-3d96f608c630",
                                "text": "„Die Muttersprache der Bewohner ist weit überwiegend Zazaki, eine eigene nordwestiranische Sprache."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
