                ],
                "senses": [
                    {
                        "sense_id": "ffcc3ac9-9eed-37c5-81e8-62edbb1da7c5",
                        "entry_id": "ed7a5055-5a0b-3141-a65b-191ddc41511f",
                        "glosses": [
                            "Faire perdre sa pagination à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1822aad-1cb8-4e81-bf4d-d0452a9bfa50",
                                "sense_id": "ffcc3ac9-9eed-37c5-81e8-62edbb1da7c5",
                                "text": "La curieuse structuration des recettes \"grasses\", où — contrairement à ce qu'on attendrait — les préparations simples, de \"grosses chars\", suivent les potages et les entremets, laisse penser qu'un manuscrit antérieur — peut-être le modèle du nôtre — avait été dépaginé."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b5f85f0-1177-3a36-80fb-dcba2c0d91d1",
                        "entry_id": "ed7a5055-5a0b-3141-a65b-191ddc41511f",
                        "glosses": [
                            "Perdre ses pages, qui se détachent de la reliure."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "1c7c4fb1-f17c-47ed-9b8c-d9d0aefaade1",
                                "sense_id": "7b5f85f0-1177-3a36-80fb-dcba2c0d91d1",
                                "text": "Vend les deux volumes Le deuxième se dépagine;"
                            },
                            {
                                "example_id": "52c42ee3-6837-4b16-a98c-5f0864e64d8c",
                                "sense_id": "7b5f85f0-1177-3a36-80fb-dcba2c0d91d1",
                                "text": "Très bon état, solide (voir photo), intérieur très frais, non dépaginé."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f3e1a76-d3a7-39e2-b07c-80666dcdb104",
                        "entry_id": "ed7a5055-5a0b-3141-a65b-191ddc41511f",
                        "glosses": [
                            "Restaurer en mémoire vive des pages préalablement sauvegardées en mémoire virtuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "840d0b67-46a5-4d7c-89e9-967c8865b8e4",
                                "sense_id": "1f3e1a76-d3a7-39e2-b07c-80666dcdb104",
                                "text": "Le code serait en permanence paginé et dépaginé sur le disque."
                            },
                            {
                                "example_id": "b93cfff4-830b-4f2f-9146-34683e4912d1",
                                "sense_id": "1f3e1a76-d3a7-39e2-b07c-80666dcdb104",
                                "text": "La mémoire allouée par le biais du mécanisme AWE ne peut pas être dépaginée."
                            }
                        ]
                    }
                ],
