                                "example_id": "e54f48a5-8059-433f-ac18-f15381bf038d",
                                "sense_id": "caa48db2-b422-38d8-b326-275405a6b620",
                                "text": "„Swantje hatte Marmorkuchen gebacken und Kaffee gekocht.“"
                            },
                            {
                                "example_id": "ccd134f3-1c10-4f49-8de6-0a192d4b04ea",
                                "sense_id": "caa48db2-b422-38d8-b326-275405a6b620",
                                "text": "„Hafrún setzt Kaffee auf, stellt Schmalzkringel und Marmorkuchen auf den Tisch.“"
