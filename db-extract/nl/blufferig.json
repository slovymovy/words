                "senses": [
                    {
                        "sense_id": "bc0a84f9-2a15-3436-b79d-8ed8c0289e54",
                        "entry_id": "1c437a97-8ac8-375f-9c31-11b3762d9b6a",
                        "glosses": [
                            "met veel grootspraak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0bffc55-1234-4365-afe5-08124cadcc88",
                                "sense_id": "bc0a84f9-2a15-3436-b79d-8ed8c0289e54",
                                "text": "Doel van de bijeenkomst is de promotie van het gevecht tussen Rico Verhoeven en Badr Hari. En dus wordt de verzamelde pers door Hari getrakteerd op de blufferige ’trash talk’ die bij dit soort evenementen gebruikelijk is."
                            },
                            {
                                "example_id": "b0541af0-789d-4322-9ec0-962022356be7",
                                "sense_id": "bc0a84f9-2a15-3436-b79d-8ed8c0289e54",
                                "text": "De stukken laten een schrijver zien die onstuimig was, groots, blufferig, gevoelig, frech, zoals de Duitser het zegt. En altijd met volle kracht vooruit. Wat niet in De laatste duik van de dag staat, zijn de vele brieven die hij bij zijn naderende dood schreef aan zijn vrouw en dochters."
                            }
                        ]
                    }
