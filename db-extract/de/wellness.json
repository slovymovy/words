                                                "text": "health and wellness"
                                            },
                                            {
                                                "example_id": "a4cc0211-1c89-41cc-8f6d-dd728dcae611",
                                                "sense_id": "df61bfe5-02d7-323a-bcfb-03c2c5669b02",
                                                "text": "Diet and exercise are cornerstones of wellness."
                                            },
                                            {
                                                "example_id": "2af0fa8d-f822-444f-920f-b62b14fc4b55",
                                                "sense_id": "df61bfe5-02d7-323a-bcfb-03c2c5669b02",
                                                "text": "The police conducted a wellness check."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4e5117b-d487-3260-aa07-e9db4887c72d",
                                        "entry_id": "0bba760f-d08d-31e0-9a4f-cda0ae523b57",
                                        "glosses": [
                                            "The process of learning about and engaging in behaviors that are likely to result in optimal health."
                                        ],
                                        "tags": [
