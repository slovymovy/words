                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f9a7bb9-187f-459b-ae8a-826c03e1555b",
                                                "sense_id": "40e74e9a-9519-335b-8408-cba7899abac9",
                                                "text": "Hier sehen Sie den Römer."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
