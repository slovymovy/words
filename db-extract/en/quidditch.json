    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d8b4824d-7c16-373d-ad23-ec2b13f27778",
                "word": "Quidditch",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d553d4b-a2e8-3524-a3f2-a7a9fa802d57",
                        "entry_id": "d8b4824d-7c16-373d-ad23-ec2b13f27778",
                        "glosses": [
                            "A fictional ball game played between two teams of seven players riding flying broomsticks, using four balls and six elevated ring-shaped goals."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "24bb94e4-6737-4850-95e2-ed5cfa4bf835",
                                "sense_id": "7d553d4b-a2e8-3524-a3f2-a7a9fa802d57",
                                "text": "Maybe you wish your parents were smarter or funnier or richer or better looking, but you might as well wish for a spot on the local Quidditch team."
                            },
                            {
                                "example_id": "e0db0e90-dbe6-4ccb-81dc-4fb2ce37fbe0",
                                "sense_id": "7d553d4b-a2e8-3524-a3f2-a7a9fa802d57",
                                "text": "Turn to the south, and you see the Central Acropolis, a five-story palace where the nobles might have sat to watch plaza ceremonies or the famous Quidditch-like Mayan ball games."
                            },
                            {
                                "example_id": "b2b74672-bde7-43c3-b2d8-91c60dbe73e9",
                                "sense_id": "7d553d4b-a2e8-3524-a3f2-a7a9fa802d57",
                                "text": "Whichever team gets Yegor holds the edge. This is like Quidditch in hell."
                            },
                            {
                                "example_id": "d8ae5483-fa42-4b6b-b57f-6575ce8f4b80",
                                "sense_id": "7d553d4b-a2e8-3524-a3f2-a7a9fa802d57",
                                "text": "Eton’s playing fields are famous, not least because of the Eton Field Game. It’s played only there. It’s sort of like Quidditch for real people."
                            }
                        ]
                    }
                ],
