                        "glosses": [
                            "Participe présent du verbe rendre."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "2968e1f3-384f-44a9-a270-95705d50dc71",
                                "sense_id": "c863b8a1-deca-3947-bce9-77f45333b3b9",
                                "text": "Si le cabinet de Berlin déclare qu’il ne se laissera point majoriser (c’est-à-dire dominer par la majorité de la Diète), la Bavière annonce à son tour, rendant barbarisme pour barbarisme, qu’elle ne se laissera pas cavouriser."
                            },
                            {
                                "example_id": "3fc5f72d-2ff1-4303-961a-afeb178f3603",
                                "sense_id": "c863b8a1-deca-3947-bce9-77f45333b3b9",
                                "text": "Il portait les fleurs terminées en se rendant à son bureau, en revenant il achetait les matières premières ; puis, en attendant le dîner, il taillait ou estampait les feuilles, garnissait les tiges, délayait les couleurs."
                            }
                        ]
                    }
