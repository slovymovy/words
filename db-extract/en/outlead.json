                    {
                        "form_id": "c22ae70b-e01b-4ef4-8c9e-88eb7c7662ec",
                        "entry_id": "c14903ff-c58c-35a3-94cd-2cacc0157509",
                        "tags": [
                            "past"
                        ],
                        "form": "outled"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "89c563df-b460-3abd-b94f-937f238e690c",
                        "entry_id": "c14903ff-c58c-35a3-94cd-2cacc0157509",
                        "glosses": [
                            "To lead out."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "7afca627-4cd1-473c-9598-69a675d0dd50",
                                "sense_id": "89c563df-b460-3abd-b94f-937f238e690c",
                                "text": "So he came down from his tower and called his knights. Lordings, —he said — to arms; the Emperour Divoun beleaguers us within our walls. Now let us make three sallies brave and sure. The first I will outlead myself."
                            },
                            {
                                "example_id": "d16f0d05-3cc3-452f-8b02-55b3dea78d3c",
                                "sense_id": "89c563df-b460-3abd-b94f-937f238e690c",
                                "text": "Interest in this meeting of extremes may be added by the fact that in my experience they were waymarks of my outleading from an individualistic educational and religious training to a more altruistic point of view for thought and action;"
                            }
                        ]
                    },
                    {
                        "sense_id": "f09afc14-b108-3a93-9491-2ce68efb7253",
                        "entry_id": "c14903ff-c58c-35a3-94cd-2cacc0157509",
                        "glosses": [
                            "To bring about; to encourage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d89fd5-11a0-4b33-bd3c-e1acf81dd3c1",
                                "sense_id": "f09afc14-b108-3a93-9491-2ce68efb7253",
                                "text": "This is an Education which consists in the outleading of the blackguardizing, pauperizing, vagrant-like, and theftuous elements of the mentality, entirely withdrawn, and apart from any moral guidance, any elevating tendency, any ameliorating influence, nay, directly under the direction of the demoralized and the abandoned."
                            },
                            {
                                "example_id": "25072286-440f-4024-874a-075aafb33b72",
                                "sense_id": "f09afc14-b108-3a93-9491-2ce68efb7253",
                                "text": "All discourse is educative, and should have for its object the outleading and upbuilding of the intellect."
                            },
                            {
                                "example_id": "56f7a0d1-fd91-4f2c-9ae0-b72e1cd81158",
                                "sense_id": "f09afc14-b108-3a93-9491-2ce68efb7253",
                                "text": "Education is the fostering and outleading of everything of worth in a personality to its fulfilment."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
