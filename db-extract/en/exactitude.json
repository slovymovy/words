    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cd7dedeb-876a-375b-a42b-84050cdd6a0c",
                "word": "exactitude",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "34e0a048-b655-41ca-bcb0-b41c1af47ab2",
                        "entry_id": "cd7dedeb-876a-375b-a42b-84050cdd6a0c",
                        "tags": [
                            "plural"
                        ],
                        "form": "exactitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0b4ab26-b9ad-34f2-95ae-86ba35ab199e",
                        "entry_id": "cd7dedeb-876a-375b-a42b-84050cdd6a0c",
                        "glosses": [
                            "Attention to small details; accuracy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "361be0f9-cb4e-449c-9761-2c0091ecbfb9",
                                "sense_id": "e0b4ab26-b9ad-34f2-95ae-86ba35ab199e",
                                "text": "[W]hen making a passage from one feeding-ground to another, the sperm whales, guided by some infallible instinct—say, rather, secret intelligence from the Deity—mostly swim in veins, as they are called; continuing their way along a given ocean-line with such undeviating exactitude, that no ship ever sailed her course, by any chart, with one tithe of such marvellous precision."
                            },
                            {
                                "example_id": "4da097e6-532b-4e2d-b764-a3e759812732",
                                "sense_id": "e0b4ab26-b9ad-34f2-95ae-86ba35ab199e",
                                "text": "He paced stiffly, looking with extreme exactitude at Lingard's face; looking neither to the right nor to the left but at the face only, as if there was nothing in the world but those features familiar and dreaded; […]"
                            },
                            {
                                "example_id": "4f5186ee-87a0-4947-a222-3a91012f33de",
                                "sense_id": "e0b4ab26-b9ad-34f2-95ae-86ba35ab199e",
                                "text": "In Newspeak, euphony outweighed every consideration other than exactitude of meaning."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62f1f0ba-0d35-4f10-bf8c-65fc3ba572a8",
                        "source_entry_id": "cd7dedeb-876a-375b-a42b-84050cdd6a0c",
                        "source_sense_id": "e0b4ab26-b9ad-34f2-95ae-86ba35ab199e",
                        "source_sense_description": "attention to small details — see also accuracy",
                        "target_lang_word": "exactitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exactitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Qualité de celui qui est exact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f779d5f-b5a4-41cf-9b6e-07e78b73211a",
                                                "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                                "text": "La collection des vice-présidents des États-Unis, qu’il avait décrite avec tant d’exactitude, formait une image persistante."
                                            },
                                            {
                                                "example_id": "8afb063d-41cc-43e8-b592-fffa816e4732",
                                                "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                                "text": "Mais, à part une série d’ouvrages géographiques, historiques, ethnographiques, parmi lesquels il y a des œuvres magistrales, et quelques bijoux littéraires sans prétention à l’exactitude scientifique, beaucoup de ces livres révèlent une connaissance insuffisante du sujet et n’ont souvent servi qu’à propager une foule de notions erronées […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8517f09b-dfd5-3ed5-bfa2-51ce2a08c23e",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Qualité de ce qui est conforme ; conformité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb669b2-ed73-4117-b6fa-8a5504d64702",
                                                "sense_id": "8517f09b-dfd5-3ed5-bfa2-51ce2a08c23e",
                                                "text": "L’industrie moderne est caractérisée par un souci toujours plus grand de l’exactitude ; au fur et à mesure que l’outillage devient plus scientifique, on exige que le produit présente moins de défauts cachés et que sa qualité réponde ainsi parfaitement, durant l'usage, aux apparences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Caractère de ce qui est exact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3c4415-e1a4-4abb-9a3f-9cddcac91bdb",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "Parce que l’astronomie parvenait à calculer les tables de la lune, on a cru que le but de toute science était de prévoir avec exactitude l’avenir; […]."
                                            },
                                            {
                                                "example_id": "f858e23a-96a2-4ed1-bddb-e55b66e24624",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "L’exactitude d’une mesure, d’un calcul, d’une horloge, d’une balance. — L’exactitude de l’esprit, des définitions."
                                            },
                                            {
                                                "example_id": "7f7c40a8-924c-425e-a449-d7c7bf813f54",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "Il faut avoir de l’exactitude dans les affaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
