                        "glosses": [
                            "Chez Jean Vautrin, variante de chiragre."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "807e5191-0c49-4841-bacf-5732661bdd65",
                                "sense_id": "addf0f2b-260e-320b-ac24-d8daad4b05df",
                                "text": "Ils n’ont plus voulu de leur oncle entre les pattes. Ces jeunes parvenus ! Ils ont dit qu’il avait la chinagre."
                            },
                            {
                                "example_id": "b83f4dc2-6b0c-452d-ada8-633a29322dd2",
                                "sense_id": "addf0f2b-260e-320b-ac24-d8daad4b05df",
                                "text": "Sa main ne bougeait pas. Elle attendait. Une main qui n’aurait jamais son heure de douceur et de galanterie. Une main d’esclave. De pauvre. De rebutée. Une main née pour l’eau glacée, pour la crasse, pour la chinagre."
                            }
                        ]
                    }
