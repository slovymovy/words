                                "example_id": "4609b1a2-814d-4dfe-ac4b-bd4823d86202",
                                "sense_id": "2bd56369-fc59-3ba1-ad98-785360d79adb",
                                "text": "De bewijsvoering van Galilei bij de verdediging van het copernicaans systeem was op zichzelf al een probleem voor vele jezuïeten van het Collegio Romano."
                            }
                        ]
                    },
                    {
