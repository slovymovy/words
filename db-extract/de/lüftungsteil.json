                "senses": [
                    {
                        "sense_id": "9dbe5cc5-8e87-3c8a-a71a-db141589a54a",
                        "entry_id": "2be98235-d4d3-35bf-ad76-3699f4df5ec0",
                        "glosses": [
                            "Gegenstand an oder in einer Lüftungsanlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d730e121-ad52-4258-9b67-e54383db15d2",
                                "sense_id": "9dbe5cc5-8e87-3c8a-a71a-db141589a54a",
                                "text": "„Das Lüftungsteil wird in die Fensterführung eingeschoben danach wird die Fensterscheibe hochgefahren.“"
                            },
                            {
                                "example_id": "c69969f0-05d1-4791-a2f4-6c50fcc67bc1",
                                "sense_id": "9dbe5cc5-8e87-3c8a-a71a-db141589a54a",
                                "text": "„Als Hersteller und Händler von Lüftungsteilen bieten wir privaten-, gewerblichen-, industriellen Kunden und Kommunen das gesamte Spektrum der Lüftungstechnik an.“"
                            },
                            {
                                "example_id": "edc51620-4530-4908-80c9-baf64df091c7",
                                "sense_id": "9dbe5cc5-8e87-3c8a-a71a-db141589a54a",
                                "text": "„Jetzt wird das Lüftungsteil aufgesetzt und mit einem Gegenstand beschwert, damit der Nistkasten bei starkem Wind einen festen Stand hat.“"
                            },
                            {
                                "example_id": "1d03c87c-03ac-4cb0-8119-834cc0acafc3",
                                "sense_id": "9dbe5cc5-8e87-3c8a-a71a-db141589a54a",
                                "text": "„Dies führt jedoch zu einer derartigen Lageveränderung des Lüftungsteiles, daß dies in Offenstellung der Lüftungsklappe in den Fahrgastraum hineinragt bzw. von der Armaturentafel entsprechend weit absteht.“"
                            },
                            {
                                "example_id": "0d0921c6-b759-484c-8683-1b8cd0844308",
                                "sense_id": "9dbe5cc5-8e87-3c8a-a71a-db141589a54a",
                                "text": "„Durch eigene Dilatation sind das Eingangsbauwerk und die Ausführung des im Tunnel am Bauwerksende gebauten nördlichen Lüftungsteiles angeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
