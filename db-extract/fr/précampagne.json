                        "glosses": [
                            "Campagne qui précède le début, généralement officiel, d’une campagne électorale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27a29148-6455-4785-a115-063c4b51fb4f",
                                "sense_id": "245c7477-85b8-3800-95a4-2bf2e20a7ac8",
                                "text": "L’UMP organise ce samedi à Paris son premier forum de précampagne présidentielle, en présence de Nicolas Sarkozy, seul candidat déclaré à ce jour."
                            },
                            {
                                "example_id": "470bac07-7513-410d-b4f8-eeef8f0e25b4",
                                "sense_id": "245c7477-85b8-3800-95a4-2bf2e20a7ac8",
                                "text": "Aussi s’agira-t-il dans un premier temps de revenir sur les définitions possibles de campagne et précampagne qui, constamment mobilisés, nous semblent essentiels."
                            }
                        ]
                    }
                ],
