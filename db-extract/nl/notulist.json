                                                "example_id": "489c633d-29f7-4d1a-ad90-66b074887abc",
                                                "sense_id": "6ba288c0-4d4c-3387-8fc4-1f9f60a8e11f",
                                                "text": "None of us can type, Minister. Mrs. McKay types (laugh track). She's the secretary (laugh track)."
                                            }
                                        ]
                                    },
