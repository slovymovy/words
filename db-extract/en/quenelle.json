                            {
                                "example_id": "7ddfb6fd-07c8-4fe4-b0ad-b428d2b1ee39",
                                "sense_id": "b24fd63a-ca35-3cbd-8eb7-91984bd675b8",
                                "text": "Before the chef’s life was made immeasurably softer with the invention of the food processor, making quenelles was a slow and arduous task.",
