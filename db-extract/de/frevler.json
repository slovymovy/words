                    {
                        "sense_id": "67b20572-23a9-3883-95e5-060e63be065c",
                        "entry_id": "0d5b3c38-c7f1-3a9b-bbfd-a3e5dde8cb20",
                        "glosses": [
                            "Person, die gegen sittliche Richtlinien verstößt (häufig in christlichem Zusammenhang verwendet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "152f5b7e-d4ed-4b6b-a519-b8b182bf38c6",
                                "sense_id": "67b20572-23a9-3883-95e5-060e63be065c",
                                "text": "Dieser Frevler hat doch tatsächlich eine Bibel verbrannt!"
                            },
                            {
                                "example_id": "64cc927b-20ff-453a-91b7-76b8739bc3af",
                                "sense_id": "67b20572-23a9-3883-95e5-060e63be065c",
                                "text": "„Und diesen Frevler wollte er vor den versammelten Schülern der Karl-Marx-Oberschule, die heute wieder Carolinum heißt, und vor ihren Klassenlehrern ermitteln, zumindest dazu aufrufen, sich zu stellen, sich selbst anzuzeigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
