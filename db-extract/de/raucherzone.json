                "senses": [
                    {
                        "sense_id": "b441985a-b504-3c84-a4aa-76951768c2ab",
                        "entry_id": "b9024e06-be00-3eca-b82d-6a00eb831dd8",
                        "glosses": [
                            "bestimmter, räumlicher Bereich, in dem das Tabakrauchen erlaubt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79705ca0-2900-4631-9ec1-85f9c7555304",
                                "sense_id": "b441985a-b504-3c84-a4aa-76951768c2ab",
                                "text": "„Während der kurze Weg durch die Raucherzone gesundheitlich unbedenklich ist, sei es für alle, die dort stundenlang als Gast sitzen oder dort arbeiten müssen, durchaus schädlich.“"
                            },
                            {
                                "example_id": "df3e516b-e629-41ae-8620-463ca19500fe",
                                "sense_id": "b441985a-b504-3c84-a4aa-76951768c2ab",
                                "text": "„An der bei vielen Jugendlichen und Touristen beliebten großen Kreuzung in Shibuya gab es vor einigen Wochen Ärger, weil die mit hohen Schutzwänden abgetrennte Raucherzone nahe der Hachiko-Hundestatue auf einen weniger prominenten Platz an einer anderen Seite des Shibuya-Bahnhofs verlegt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
