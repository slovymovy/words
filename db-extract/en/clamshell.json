                    {
                        "sense_id": "42a29b1b-6b48-3a97-9725-2de42141f185",
                        "entry_id": "322c8184-f231-3f9f-8bf8-41880ae0a1dd",
                        "glosses": [
                            "The shell of a clam."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0b358b1b-b0b8-3142-9d02-fe7b4019d6da",
                        "entry_id": "322c8184-f231-3f9f-8bf8-41880ae0a1dd",
                        "glosses": [
                            "Any object that, in (literal or figurative) resemblance to the shell of a clam, has a hinge on one edge and two surfaces that close together."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeb19119-f914-424c-a0d8-663dc7d39159",
                                "sense_id": "0b358b1b-b0b8-3142-9d02-fe7b4019d6da",
                                "text": "You'll find a mix among clamshell laptops for strong laps, lunchboxes, and sewing-machine configurations; the latter two designs typically have detachable keyboards."
                            }
                        ]
                    },
                    {
                        "sense_id": "a17b60ed-5487-304c-9c53-0b8143703fae",
                        "entry_id": "322c8184-f231-3f9f-8bf8-41880ae0a1dd",
                        "glosses": [
                            "Any object that, in (literal or figurative) resemblance to the shell of a clam, has a hinge on one edge and two surfaces that close together.",
                            "A dredging bucket with hinges like the shell of a clam."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c3e905-f793-4919-a549-6d1b4f4b2756",
                                "sense_id": "a17b60ed-5487-304c-9c53-0b8143703fae",
                                "text": "The wall has been constructed one panel at a time by a machine which uses a clamshell bucket to excavate straight down to a depth of 30 metres. […] Specialised long-reach excavators with a clamshell grab then reach though the openings to lift the spoil to the surface, which is then deposited in articulated dump trucks (ADTs)."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f02dca6-6f97-3c14-87a3-7fae059ad6b5",
                        "entry_id": "322c8184-f231-3f9f-8bf8-41880ae0a1dd",
                        "glosses": [
                            "Any object that, in (literal or figurative) resemblance to the shell of a clam, has a hinge on one edge and two surfaces that close together.",
                            "In food service, the closing box (usually styrofoam but sometimes cardboard) given to consumers with takeout food."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c5e384df-55ec-3aaf-bdf1-1ea0626c70a6",
                        "entry_id": "322c8184-f231-3f9f-8bf8-41880ae0a1dd",
                        "glosses": [
                            "Any object that, in (literal or figurative) resemblance to the shell of a clam, has a hinge on one edge and two surfaces that close together.",
                            "mouth"
                        ],
                        "tags": [
                            "US",
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0db3b8e0-5314-4135-8db5-06e3eedc890c",
                                "sense_id": "c5e384df-55ec-3aaf-bdf1-1ea0626c70a6",
                                "text": "Shut your clam-shell!"
                            },
                            {
                                "example_id": "e04c73f9-9a34-4d4b-9bcf-81da82c73723",
                                "sense_id": "c5e384df-55ec-3aaf-bdf1-1ea0626c70a6",
                                "text": "He was quickly silenced, however, by a burly individual, who \"reckoned that it mout be jist as well for the stranger to keep his clam-shell shut.\""
                            },
                            {
                                "example_id": "b9526ab3-9758-47f9-9ac4-6947643094c6",
                                "sense_id": "c5e384df-55ec-3aaf-bdf1-1ea0626c70a6",
                                "text": "\"Shut your clamshell, Toby,\" grumbled the Baron."
                            }
                        ]
                    },
                    {
                        "sense_id": "f88a6f8d-13b7-3fc6-a2c9-6d2cdf72a097",
                        "entry_id": "322c8184-f231-3f9f-8bf8-41880ae0a1dd",
                        "glosses": [
                            "Any object with some other resemblance to either one or both halves of the shell of a clam."
                        ],
                        "tags": [
                            "attributive",
                            "often"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7a2c4d1e-3cdf-3a0a-8c1c-d9a5787aa01d",
                        "entry_id": "322c8184-f231-3f9f-8bf8-41880ae0a1dd",
                        "glosses": [
                            "Any object with some other resemblance to either one or both halves of the shell of a clam.",
