                "senses": [
                    {
                        "sense_id": "68920f75-87a8-36f4-8fe3-67c06fa77e2f",
                        "entry_id": "ee8ea1b5-6874-30bb-bb1d-3aead768f56f",
                        "glosses": [
                            "osoba, rzecz lub zjawisko niezwykle piękne lub nadzwyczajne"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cb46962f-b3f7-4c69-90f6-968592cbfad8",
                                "sense_id": "68920f75-87a8-36f4-8fe3-67c06fa77e2f",
                                "text": "Spojrzenie jej trafia na prześliczną, szylkretową puderniczkę, leżącą na wystawie. — O jej, co to za cudo!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6de0c784-271f-3d2d-a99d-c28b8c0eb6e4",
                        "entry_id": "ee8ea1b5-6874-30bb-bb1d-3aead768f56f",
                        "glosses": [
                            "rzecz dziwna, dziwaczna, straszydło, dziwoląg"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "94d03b08-9347-4063-9d79-17a499f520f2",
                                "sense_id": "6de0c784-271f-3d2d-a99d-c28b8c0eb6e4",
                                "text": "Rzecz trudna do wiary, bajka, cudo, pokusa, omamienie, czary, dziwo, mara… bies tego nie zgadnie, co znaczy?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
