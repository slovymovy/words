                                        "sense_id": "ccd2fae0-69a1-3f25-bf6c-8de68cc38939",
                                        "entry_id": "468e4b2f-0e31-33ea-b619-e8ed36651046",
                                        "glosses": [
                                            "Knives, forks and spoons."
                                        ],
                                        "tags": [
                                            "Atlantic-Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afec0ac6-8222-37bf-990f-dea35a0e991c",
                                        "entry_id": "468e4b2f-0e31-33ea-b619-e8ed36651046",
                                        "glosses": [
                                            "Trophies, success in a competition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "165290a0-1da8-4a83-b904-2d7f008115fe",
                                                "sense_id": "afec0ac6-8222-37bf-990f-dea35a0e991c",
                                                "text": "February 2008, BBC Sport - Ramos takes centre stage\nHow different it was at Wembley as Ramos confirmed his reputation as a relentless pursuer of silverware by giving Spurs their first trophy in nine years."
                                            },
                                            {
                                                "example_id": "b1725905-082d-4d6a-86eb-8375463242f3",
                                                "sense_id": "afec0ac6-8222-37bf-990f-dea35a0e991c",
                                                "text": "The performance was a sign of real intent for Arsenal as they continue their pursuit for silverware on four fronts - and with Van Persie firing on all cylinders, the odds look good on them winning a first trophy since 2005."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6102bdbe-1264-40f8-b194-50d4c221dab7",
                        "source_entry_id": "55a1eee5-33ba-372c-95e9-10c52049e861",
                        "source_sense_id": "e6959dcf-0494-3b52-8e73-bfafb0c07ca2",
                        "source_sense_description": "Geschirr aus Silber",
                        "target_lang_word": "silver tableware",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "422ef46c-bd14-4f53-9a75-d40171bdc2b1",
                        "source_entry_id": "55a1eee5-33ba-372c-95e9-10c52049e861",
                        "source_sense_id": "e6959dcf-0494-3b52-8e73-bfafb0c07ca2",
                        "source_sense_description": "Geschirr aus Silber",
                        "target_lang_word": "tafelzilver",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tafelzilver",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6a21eed2-b55f-3794-a3c6-5d9079660064",
                                        "entry_id": "a79ff252-77c3-32bd-99d9-f4f94a0e3f0b",
                                        "glosses": [
                                            "zilveren voorwerpen voor op tafel inclusief het zilveren vaatwerk"
                                        ],
                                        "tags": [
                                            "huishouden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afcc47f6-abc1-45a9-907e-6673b83ea0b5",
                                                "sense_id": "6a21eed2-b55f-3794-a3c6-5d9079660064",
                                                "text": "Dat waren nog eens tijden. Vonken uit elkaars neus trekken, gilletjes ontlokken aan gravinnen, het tafelzilver blauwe bliksems laten maken - of er zwarte putjes in slaan. Toen wetenschappelijk onderzoek voornamelijk een tijdverdrijf was voor de adel, ging het er wel eens frivool aan toe."
                                            },
                                            {
                                                "example_id": "435d4c18-c4c8-4f82-9a13-71756e0dba25",
                                                "sense_id": "6a21eed2-b55f-3794-a3c6-5d9079660064",
                                                "text": "De premier was onderhoudend en hield van dineren in stijl. Het tafelzilver leek gepoetst en de kaarsen stonden perfect recht in hun antieke kandelaar."
                                            },
                                            {
                                                "example_id": "3e2cb57e-2491-4006-aedd-02eeaabe53b9",
                                                "sense_id": "6a21eed2-b55f-3794-a3c6-5d9079660064",
                                                "text": "Bijna had het Congres het Washington Monument met een schitterende bekleding van aluminium bedekt om te laten zien wat een superieure en welvarende natie we waren geworden, en de Franse keizerlijke familie deed in die tijd het tafelzilver voor staatsbanketten weg om deze door aluminium te vervangen. Men moest en zou de trend volgen, hoe onbruikbaar de messen ook waren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38159640-0a9a-36dd-b3a0-f5ba212f863a",
                                        "entry_id": "a79ff252-77c3-32bd-99d9-f4f94a0e3f0b",
                                        "glosses": [
                                            "het meest waardevolle wat iets of iemand bezit"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ef9ccd6-fae2-43cc-b64e-abf4c382c1dc",
                                                "sense_id": "38159640-0a9a-36dd-b3a0-f5ba212f863a",
                                                "text": "In de bestuurskamer van Unilever, Akzo of Shell vinden ze het logisch dat politici meewerken aan het beschermen van het Hollands tafelzilver."
                                            },
                                            {
                                                "example_id": "1a7b8c87-e0a2-473e-8158-0f9fd5f430b7",
                                                "sense_id": "38159640-0a9a-36dd-b3a0-f5ba212f863a",
                                                "text": "Desondanks gaat de verkwanseling van het publieke tafelzilver, al dan niet in opdracht van, dan wel gedekt door, dan wel met als excuus Europa'gewoon verder, getuige de verkoop van gemeentelijke aandelen in energiebedrijf Eneco dezer dagen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
