                        ]
                    },
                    {
                        "translation_id": "e329a1bd-3fab-4d81-8c0c-5c6874e3336c",
                        "source_entry_id": "89d4112d-d59e-377d-9d57-fe82fd2a0239",
                        "source_sense_id": "bcc02121-3838-36cf-8f6a-bea9ae9088ab",
                        "source_sense_description": "to make legitimate",
                        "target_lang_word": "узако́нивать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "узако́нивать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1976aa7e-7a2c-3055-995d-781d67e75fa4",
                                        "entry_id": "cc7b67f7-de4c-39f2-9073-191d844a4f6a",
                                        "glosses": [
                                            "придавать чему-либо законную силу, утверждать на законном основании"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd86ac6a-0884-41f4-8afb-3751a2b1515a",
                                                "sense_id": "1976aa7e-7a2c-3055-995d-781d67e75fa4",
                                                "text": "Борьба гугенотов увенчивается победой лишь в 1598 году: Нантский эдикт узаконивает свободу вероисповедания и для истерзанной междоусобицей и войнами Франции наступает на какое-то время долгожданный мир."
                                            },
                                            {
                                                "example_id": "f9004502-830d-4345-b9cd-f3ba668f6e6b",
                                                "sense_id": "1976aa7e-7a2c-3055-995d-781d67e75fa4",
                                                "text": "Предложение Гибсона, узаконивающее применение полицией слезоточивых газов, принимается."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f29c60e-d62e-3b03-8139-9dbea008c9e2",
                                        "entry_id": "cc7b67f7-de4c-39f2-9073-191d844a4f6a",
                                        "glosses": [
                                            "перен. вводить в обиход на правах общепризнанного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e6dc5c1-42d5-4dcf-a8d4-269c72925806",
                                                "sense_id": "1f29c60e-d62e-3b03-8139-9dbea008c9e2",
                                                "text": "И взяточник, и плантатор, и развратник, всеми признанные за таковых, — если только они богаты, или чиновны, или знатны, и позовут общество к себе на пир: разве общество не поедет к ним и, тем самым, разве оно не одобряет разврата и неправды, не узаконивает их?"
                                            },
                                            {
                                                "example_id": "51014487-7529-41d9-98e8-d7c861a30efa",
                                                "sense_id": "1f29c60e-d62e-3b03-8139-9dbea008c9e2",
                                                "text": "Школьное воспитание продолжает то, что сделано дома, оно обобщает оптический обман, книжно упрочивает его, теоретически узаконивает традиционный хлам и приучает детей к тому, чтоб они знали, не понимая, и принимали бы названия за определения."
                                            },
                                            {
                                                "example_id": "1e43c02d-b885-4878-bfdd-d9eedc20eb03",
                                                "sense_id": "1f29c60e-d62e-3b03-8139-9dbea008c9e2",
                                                "text": "Оставалось напомнить, что квантовые идеи узаконивают прерывистые процессы в микромире."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "634900fb-b52b-46ab-b1b1-d6c1acedac95",
                        "source_entry_id": "89d4112d-d59e-377d-9d57-fe82fd2a0239",
                        "source_sense_id": "bcc02121-3838-36cf-8f6a-bea9ae9088ab",
