                        "examples": [
                            {
                                "example_id": "701014d9-b1e4-4cee-8476-df74fcf6251b",
                                "sense_id": "088c6cdf-e469-3bc3-8756-066ae6bc2c1b",
                                "text": "„Das Zimmer war klein, aber gut ausgestattet, genau wie das Hotel insgesamt. Ein Übernachtungsort für besonders Eingeweihte, schon viele Monate im Voraus ausgebucht, das hatte die PR-Frau erzählt.“"
                            },
                            {
                                "example_id": "162e15e8-7912-48e4-a3cc-058d100321b6",
                                "sense_id": "088c6cdf-e469-3bc3-8756-066ae6bc2c1b",
                                "text": "„So müssen sich die Teilnehmer während der Fahrt um den Einkauf, um Reparaturen und um Übernachtungsorte selbst kümmern.“"
                            }
                        ],
