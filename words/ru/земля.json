                {
                    "sense_id": "420ecc91-b260-3936-bbae-5b8c69f03404",
                    "sense_definition": "Третья планета Солнечной системы, родина человечества.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "planet",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "О происхождении <w>Земли</w> до сих пор спорят учёные.",
                            "target_lang_translations": {
                                "en": "Scientists are still debating the origin of the <w>Earth</w>.",
                                "de": "Wissenschaftler streiten noch immer über den Ursprung der <w>Erde</w>."
                            }
                        },
                        {
                            "text": "В слове сокрыта самая великая энергия, известная на <w>Земле</w>.",
                            "target_lang_translations": {
                                "en": "The greatest energy known on <w>Earth</w> is hidden in the word.",
                                "de": "In dem Wort verbirgt sich die größte Energie, die auf der <w>Erde</w> bekannt ist."
                            }
                        }
                    ],
                    "synonyms": [
                        "♁"
                    ],
                    "common_phrases": [
                        "на Земле"
                    ],
                    "target_lang_definitions": {
                        "en": "The third planet from the Sun, the home of humanity.",
                        "de": "Der dritte Planet von der Sonne, die Heimat der Menschheit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Earth",
                                "target_lang_sense_clarification": "The planet we live on"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "die Erde",
                                "target_lang_sense_clarification": "Der Planet, auf dem wir leben"
                            }
                        ]
                    }
                }
            ]
