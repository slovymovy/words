                ],
                "senses": [
                    {
                        "sense_id": "012ad76d-c340-3794-8fda-5caa01e06f16",
                        "entry_id": "8341153a-be20-3843-943f-2fe0a1d0d56a",
                        "glosses": [
                            "weibliche Person, die auf die Jagd geht"
                        ],
                        "tags": [
                            "Jagdwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "470f4f80-f30b-490b-824c-7b3526beb267",
                                "sense_id": "012ad76d-c340-3794-8fda-5caa01e06f16",
                                "text": "Erschöpft trat am Sonntagmorgen die Jägerin aus dem Wald."
                            },
                            {
                                "example_id": "4e0ed4e2-680d-4329-bfd2-fc2ae3d4b313",
                                "sense_id": "012ad76d-c340-3794-8fda-5caa01e06f16",
                                "text": "„Er sah Elisabeth zum erstenmal völlig losgelöst von der Zeit, bei sich selbst, hingegeben einer unbefangenen und tiefen Spielerei, überschüttet von Licht und Zärtlichkeit und Liebe, ernst und gesammelt wie eine Jägerin, die ihre Waffen zum Kampfe prüft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0d89721-a16d-4b4f-966f-b270af495305",
                        "source_entry_id": "8341153a-be20-3843-943f-2fe0a1d0d56a",
                        "source_sense_id": "012ad76d-c340-3794-8fda-5caa01e06f16",
                        "source_sense_description": "Jagdwesen: weibliche Person, die auf die Jagd geht",
                        "target_lang_word": "hunter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hunter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33b3e360-ed37-3df0-99b6-13cfa32e507c",
                                        "entry_id": "821a5121-4869-3408-b243-b604534656f5",
                                        "glosses": [
                                            "One who hunts game for sport or for food; a huntsman or huntswoman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "652e94e9-67bd-36bf-bb00-13c9311587a3",
                                        "entry_id": "821a5121-4869-3408-b243-b604534656f5",
                                        "glosses": [
                                            "A dog used in hunting; a hunting dog."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "463a57d3-937f-4e0e-b59f-4a0a668552ff",
                                                "sense_id": "652e94e9-67bd-36bf-bb00-13c9311587a3",
                                                "text": "thy intercepter, full of despite, bloody as the hunter, attends thee at the orchard end"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28e8fd09-9500-3020-b7d8-63415a62fef5",
                                        "entry_id": "821a5121-4869-3408-b243-b604534656f5",
                                        "glosses": [
                                            "A horse used in hunting, especially a thoroughbred, bred and trained for hunting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ac6152f-2d38-4930-b07e-36defc544bea",
                                                "sense_id": "28e8fd09-9500-3020-b7d8-63415a62fef5",
                                                "text": "‘His favourite Hunter who was turned out in the park on his going abroad, somehow or other fell ill […] .’"
                                            },
                                            {
                                                "example_id": "589b2355-c3b9-46e1-b18d-273ac1c0d12d",
                                                "sense_id": "28e8fd09-9500-3020-b7d8-63415a62fef5",
                                                "text": "a sound, swift, well-bred hunter and roadster"
                                            },
                                            {
                                                "example_id": "9568b0f4-138e-4cc9-9d97-ca606405b184",
                                                "sense_id": "28e8fd09-9500-3020-b7d8-63415a62fef5",
                                                "text": "No one, however, thought of the haughty and secluded young gentleman who […] when he rode on his black hunter into Dublin, avoided the village, and took the high-road by Inchicore."
                                            },
                                            {
                                                "example_id": "b4fe2c2c-0393-48bb-a1d9-cd3c7bb5c6b6",
                                                "sense_id": "28e8fd09-9500-3020-b7d8-63415a62fef5",
                                                "text": "Henry, laughing, spurs away his hunter under the dripping trees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f06c26f3-3328-3fa1-a1c4-e9314ae0cda2",
                                        "entry_id": "821a5121-4869-3408-b243-b604534656f5",
                                        "glosses": [
                                            "One who hunts or seeks after anything."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "319c4ce2-3aeb-4c5e-889b-4159a011dd4f",
                                                "sense_id": "f06c26f3-3328-3fa1-a1c4-e9314ae0cda2",
                                                "text": "The hunter becomes the hunted."
                                            },
                                            {
                                                "example_id": "6adb3e2e-bb8e-42c9-89ff-e085087f9337",
                                                "sense_id": "f06c26f3-3328-3fa1-a1c4-e9314ae0cda2",
                                                "text": "a fortune hunter"
                                            },
                                            {
                                                "example_id": "ed5dd10c-d562-4897-b74e-fd60391e1059",
                                                "sense_id": "f06c26f3-3328-3fa1-a1c4-e9314ae0cda2",
                                                "text": "You know right well, how meek soe'er he seem, / No keener hunter after glory breathes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "191203c6-08d4-391b-a716-72a99fb2644b",
                                        "entry_id": "821a5121-4869-3408-b243-b604534656f5",
                                        "glosses": [
                                            "A person who bottles up their aggression and eventually releases it explosively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b29a20-276f-49c4-b5a8-e04ed0b73968",
                                                "sense_id": "191203c6-08d4-391b-a716-72a99fb2644b",
                                                "text": "Although their behavior does not have the same impact as hunters, howlers nevertheless distract the public figure and compel security and law enforcement […]"
                                            },
                                            {
                                                "example_id": "58cc50b6-127b-42a8-8973-8a237434ef20",
                                                "sense_id": "191203c6-08d4-391b-a716-72a99fb2644b",
                                                "text": "Hunters stalk their targets, make detailed plans, acquire and practice with weapons, and try to hurt or kill people. Howlers make bomb threats to schools, malls, churches, businesses, and government offices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2da606c0-851c-380f-b184-faf53dbb59c4",
                                        "entry_id": "821a5121-4869-3408-b243-b604534656f5",
                                        "glosses": [
                                            "A kind of spider, the huntsman or hunting spider."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "013f2737-d8ff-37a1-a78e-dc70d488a69b",
                                        "entry_id": "821a5121-4869-3408-b243-b604534656f5",
                                        "glosses": [
                                            "A pocket watch with a spring-hinged circular metal cover that closes over the dial and crystal, protecting them from dust and scratches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8140cc8-4b0d-42e4-8468-c210db703ab4",
                        "source_entry_id": "8341153a-be20-3843-943f-2fe0a1d0d56a",
                        "source_sense_id": "012ad76d-c340-3794-8fda-5caa01e06f16",
                        "source_sense_description": "Jagdwesen: weibliche Person, die auf die Jagd geht",
                        "target_lang_word": "huntress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huntress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                        "entry_id": "519c58d4-ada3-3ddf-9884-20b93e6e626a",
                                        "glosses": [
                                            "A female hunter."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77693f2c-47a6-402e-bddb-287ac02b086f",
                                                "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                                "text": "In those same woods ye well remember may / How that a noble hunteress did wonne [...]."
                                            },
                                            {
                                                "example_id": "7ddc2bb4-34b7-440d-a429-7f58e6c8cc90",
                                                "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                                "text": "Ashol-Pan, the daughter of a particularly celebrated hunter, may well be the country's only apprentice huntress."
                                            },
                                            {
                                                "example_id": "be6c18aa-dcfa-4118-8806-fe2c4ef696d0",
                                                "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                                "text": "Grief and fear cannot rule you;\nlet them be your faithful servants, protective of their mistress.\nLoss serves a huntress like fuel serves fire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c6b90ac-ac0d-4d3f-9a0a-b57a5f82ba12",
                        "source_entry_id": "8341153a-be20-3843-943f-2fe0a1d0d56a",
