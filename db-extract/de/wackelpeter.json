                "translations": [
                    {
                        "translation_id": "55ff060f-3867-4f5c-9aee-9d28b71ee23f",
                        "source_entry_id": "01b2dda5-b0f5-3f59-8108-5babcb3a6c32",
                        "source_sense_id": "3816bff8-d674-31bb-be80-99b6943fc21a",
                        "source_sense_description": "Wackelpudding, ein Pudding, der bei Berührung in eine wackelnde, zitternde Bewegung gerät",
                        "target_lang_word": "jelly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jelly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edd4286d-0943-3a56-abea-bf9355c80d3a",
                                        "entry_id": "e7b141ad-7b10-3fcc-98c6-ed83a4210233",
                                        "glosses": [
                                            "A dessert made by boiling gelatine (or a plant-based alternative such as agar or carrageenan), sugar and some flavouring (often derived from fruit) and allowing it to set."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9214d911-d70f-4234-9678-1d8f06d0633d",
                                                "sense_id": "edd4286d-0943-3a56-abea-bf9355c80d3a",
                                                "text": "His mother prepared jelly for him and his friends for dessert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2684ddd-80e9-35ac-82e2-2581ba0a7608",
                                        "entry_id": "e7b141ad-7b10-3fcc-98c6-ed83a4210233",
                                        "glosses": [
                                            "A clear or translucent fruit preserve, made from fruit juice and set using either naturally occurring, or added, pectin."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aebe3be-3b18-441e-91c4-dbe4f64ccb76",
                                                "sense_id": "f2684ddd-80e9-35ac-82e2-2581ba0a7608",
                                                "text": "Perfect jelly is of appetizing flavor; beautifully colored and translucent; tender enough to cut easily with a spoon, yet firm enough to hold its shape when turned from the glass."
                                            },
                                            {
                                                "example_id": "efbafa66-7cb6-407d-8ff5-e1edbdc53317",
                                                "sense_id": "f2684ddd-80e9-35ac-82e2-2581ba0a7608",
                                                "text": "Jelly has great clarity. Two cooking processes are involved. First, the juice alone is extracted from the fruit. Only that portion thin and clear enough to drip through a cloth is cooked with sugar until sufficiently firm to hold its shape. It is never stiff and never gummy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d145d167-d675-3d23-9173-4b020f087def",
                                        "entry_id": "e7b141ad-7b10-3fcc-98c6-ed83a4210233",
                                        "glosses": [
                                            "Clipping of jelly coconut."
                                        ],
                                        "tags": [
                                            "Caribbean",
                                            "Jamaica",
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7aded63c-6d2b-3b5d-96cf-a54c54fd21ae",
                                        "entry_id": "e7b141ad-7b10-3fcc-98c6-ed83a4210233",
                                        "glosses": [
                                            "A savoury substance, derived from meat, that has the same texture as the dessert."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "227318a1-3b6e-37f2-b914-97a784955c84",
                                        "entry_id": "e7b141ad-7b10-3fcc-98c6-ed83a4210233",
                                        "glosses": [
                                            "Any substance or object having the consistency of the dessert or preserve."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78096a52-bd51-4e60-84b0-4cbb7e07cc73",
                                                "sense_id": "227318a1-3b6e-37f2-b914-97a784955c84",
                                                "text": "calf's-foot jelly"
                                            },
                                            {
                                                "example_id": "7bfccdaf-135c-4582-9035-d7a1997e0194",
                                                "sense_id": "227318a1-3b6e-37f2-b914-97a784955c84",
                                                "text": "Sam floored him perpetually, and beat his face to a jelly, without getting a scratch."
                                            },
                                            {
                                                "example_id": "ebdfd02a-dfad-4af7-83b9-50819fe2cf37",
                                                "sense_id": "227318a1-3b6e-37f2-b914-97a784955c84",
                                                "text": "[…] some of the profounder scholars are altogether too great for locomotion, and are carried from place to place in a sort of sedan tub, wabbling jellies of knowledge that enlist my respectful astonishment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1386138e-177b-3475-ad79-358fa0cb6a41",
                                        "entry_id": "e7b141ad-7b10-3fcc-98c6-ed83a4210233",
                                        "glosses": [
                                            "A jellyfish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acc82737-e421-4b0b-bed0-b589a8743ec6",
                                                "sense_id": "1386138e-177b-3475-ad79-358fa0cb6a41",
                                                "text": "Species of the phylum Cnidaria – the classic jelly – have existed in something close to their current form for at least 565 million years; Ctenophora, the comb jellies, are not much younger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4108a436-0cc8-3de6-90e7-9023fa70dd70",
                                        "entry_id": "e7b141ad-7b10-3fcc-98c6-ed83a4210233",
                                        "glosses": [
                                            "A pretty girl; a girlfriend."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a8b2d4a-58c0-4f85-8dd2-00a57bdd2019",
                                                "sense_id": "4108a436-0cc8-3de6-90e7-9023fa70dd70",
                                                "text": "‘Gowan goes to Oxford a lot,’ the boy said. ‘He′s got a jelly there.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9bccb18-f5c2-3ba8-821f-4da9261f32de",
                                        "entry_id": "e7b141ad-7b10-3fcc-98c6-ed83a4210233",
                                        "glosses": [
                                            "A large backside, especially a woman's."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f92b6ef-3b43-4f26-b763-db966a409463",
                                                "sense_id": "e9bccb18-f5c2-3ba8-821f-4da9261f32de",
                                                "text": "I shake my jelly at every chance / When I whip with my hips you slip into a trance"
                                            },
                                            {
                                                "example_id": "a42a0336-be78-4b6e-88d3-aa5dd8cc8583",
                                                "sense_id": "e9bccb18-f5c2-3ba8-821f-4da9261f32de",
                                                "text": "At that Sister Samantha seemed to shake her jelly so that she sank back into her chair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eecbca8a-a324-334c-b50e-6ad057a0fcfd",
                                        "entry_id": "e7b141ad-7b10-3fcc-98c6-ed83a4210233",
                                        "glosses": [
                                            "Clipping of gelignite."
                                        ],
                                        "tags": [
