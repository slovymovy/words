{
    "word_family": [
        "ascend",
        "ascendant",
        "ascendancy",
        "ascension",
        "ascender"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48f4200f-f6bb-3be5-9f14-6753279cf4e5",
                    "sense_definition": "The act of moving upward or climbing a height.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climbers began their final <w>ascent</w> to the summit of the mountain at dawn.",
                            "target_lang_translations": {
                                "ru": "Альпинисты начали свое финальное <w>восхождение</w> на вершину горы на рассвете.",
                                "de": "Die Bergsteiger begannen im Morgengrauen ihren letzten <w>Aufstieg</w> zum Gipfel des Berges."
                            }
                        },
                        {
                            "text": "He made a tedious <w>ascent</w> of the hill while carrying a heavy backpack.",
                            "target_lang_translations": {
                                "ru": "Он совершил утомительный <w>подъём</w> на холм, неся тяжелый рюкзак.",
                                "de": "Er bewältigte den mühsamen <w>Aufstieg</w> auf den Hügel, während er einen schweren Rucksack trug."
                            }
                        }
                    ],
                    "synonyms": [
                        "climb",
                        "rise",
                        "climbing"
                    ],
                    "antonyms": [
                        "descent"
                    ],
                    "common_phrases": [
                        "steep ascent",
                        "final ascent",
                        "rapid ascent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по перемещению вверх или восхождение на высоту.",
                        "de": "Die Bewegung nach oben oder das Besteigen einer Höhe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восхождение",
                                "target_lang_sense_clarification": "на гору или вершину"
                            },
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "движение вверх"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Aufstieg",
                                "target_lang_sense_clarification": "Hinaufsteigen auf einen Berg oder eine Höhe"
                            },
                            {
                                "target_lang_word": "Besteigung",
                                "target_lang_sense_clarification": "eines Berges oder Gipfels"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0382b2b5-ae29-3610-98c0-4e745a19f361",
                    "sense_definition": "An increase or advancement in status, popularity, or power.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "advancement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young politician's rapid <w>ascent</w> to power surprised many experienced observers.",
                            "target_lang_translations": {
                                "ru": "Стремительное <w>восхождение</w> молодого политика к власти удивило многих опытных наблюдателей.",
                                "de": "Der rasante <w>Aufstieg</w> des jungen Politikers an die Macht überraschte viele erfahrene Beobachter."
                            }
                        },
                        {
                            "text": "The company's commercial <w>ascent</w> was driven by its innovative new technology.",
                            "target_lang_translations": {
                                "ru": "Коммерческий <w>подъём</w> компании был обусловлен её новыми инновационными технологиями.",
                                "de": "Der wirtschaftliche <w>Aufstieg</w> des Unternehmens wurde durch seine innovative neue Technologie angetrieben."
                            }
                        }
                    ],
                    "synonyms": [
                        "rise",
                        "advancement",
                        "progression"
                    ],
                    "antonyms": [
                        "decline",
                        "fall"
                    ],
                    "common_phrases": [
                        "ascent to power",
                        "commercial ascent",
                        "rapid ascent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рост или продвижение в статусе, популярности или власти.",
                        "de": "Ein Aufstieg oder eine Verbesserung von Status, Ansehen oder Macht."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восхождение",
                                "target_lang_sense_clarification": "к власти или славе"
                            },
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "развитие или успех"
                            },
                            {
                                "target_lang_word": "продвижение",
                                "target_lang_sense_clarification": "по карьерной или социальной лестнице"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Aufstieg",
                                "target_lang_sense_clarification": "zu Macht, Erfolg oder sozialem Status"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4a64347-144b-32c9-809a-65461c480da3",
                    "sense_definition": "A path, slope, or way that leads upward.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a difficult northern <w>ascent</w> from the village leading to the peak.",
                            "target_lang_translations": {
                                "ru": "Из деревни к пику ведет трудный северный <w>подъём</w>.",
                                "de": "Vom Dorf aus führt ein schwieriger nördlicher <w>Aufstieg</w> zum Gipfel."
                            }
                        },
                        {
                            "text": "The rocky <w>ascent</w> was narrow and dangerous for inexperienced hikers.",
                            "target_lang_translations": {
                                "ru": "Каменистый <w>подъём</w> был узким и опасным для неопытных туристов.",
                                "de": "Der felsige <w>Anstieg</w> war schmal und gefährlich für unerfahrene Wanderer."
                            }
                        }
                    ],
                    "synonyms": [
                        "slope",
                        "incline",
                        "upgrade"
                    ],
                    "antonyms": [
                        "descent"
                    ],
                    "common_phrases": [
                        "rocky ascent",
                        "difficult ascent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тропа, склон или путь, ведущий вверх.",
                        "de": "Ein Weg, Pfad oder Hang, der nach oben führt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "участок пути, идущий вверх"
                            },
                            {
                                "target_lang_word": "склон",
                                "target_lang_sense_clarification": "наклонная поверхность"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Anstieg",
                                "target_lang_sense_clarification": "aufwärts führender Weg oder Hang"
                            },
                            {
                                "target_lang_word": "Aufstieg",
                                "target_lang_sense_clarification": "Route oder Weg nach oben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b405394-d235-3513-ba47-d8f4095edadb",
                    "sense_definition": "The degree of upward slope or the angle of inclination.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road has an <w>ascent</w> of five degrees, making it hard for cyclists.",
                            "target_lang_translations": {
                                "ru": "Дорога имеет <w>уклон</w> в пять градусов, что затрудняет движение велосипедистов.",
                                "de": "Die Straße hat eine <w>Steigung</w> von fünf Grad, was es für Radfahrer mühsam macht."
                            }
                        },
                        {
                            "text": "Engineers measured the steep <w>ascent</w> of the track to ensure safety.",
                            "target_lang_translations": {
                                "ru": "Инженеры измерили крутой <w>уклон</w> трассы, чтобы обеспечить безопасность.",
                                "de": "Ingenieure maßen die steile <w>Steigung</w> der Strecke, um die Sicherheit zu gewährleisten."
                            }
                        }
                    ],
                    "synonyms": [
                        "gradient",
                        "inclination",
                        "steepness"
                    ],
                    "common_phrases": [
                        "steep ascent",
                        "degree of ascent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень наклона вверх или угол наклона.",
                        "de": "Das Maß der Neigung nach oben oder der Steigungswinkel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уклон",
                                "target_lang_sense_clarification": "крутизна дороги или поверхности"
                            },
                            {
                                "target_lang_word": "крутизна",
                                "target_lang_sense_clarification": "степень наклона"
                            },
                            {
                                "target_lang_word": "градиент",
                                "target_lang_sense_clarification": "технический термин для наклона"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Steigung",
                                "target_lang_sense_clarification": "Neigungsgrad oder Winkel nach oben"
                            },
                            {
                                "target_lang_word": "Anstieg",
                                "target_lang_sense_clarification": "Neigung oder Steilheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "727d8241-8aaf-3f97-8b14-1a667e06038a",
                    "sense_definition": "A high place, such as a hill or eminence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From the top of the <w>ascent</w>, they could see the entire valley below.",
                            "target_lang_translations": {
                                "ru": "С вершины <w>возвышенности</w> они могли видеть всю долину внизу.",
                                "de": "Von der Spitze der <w>Anhöhe</w> aus konnten sie das gesamte Tal überblicken."
                            }
                        },
                        {
                            "text": "The castle was built upon a natural <w>ascent</w> to provide a better defense.",
                            "target_lang_translations": {
                                "ru": "Замок был построен на естественной <w>возвышенности</w> для обеспечения лучшей обороны.",
                                "de": "Die Burg wurde auf einer natürlichen <w>Anhöhe</w> erbaut, um eine bessere Verteidigung zu gewährleisten."
                            }
                        }
                    ],
                    "synonyms": [
                        "hill",
                        "height",
                        "eminence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокое место, такое как холм или возвышенность.",
                        "de": "Ein höher gelegener Ort, wie ein Hügel oder eine Erhebung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвышенность",
                                "target_lang_sense_clarification": "высокое место"
                            },
                            {
                                "target_lang_word": "высота",
                                "target_lang_sense_clarification": "возвышенное место в ландшафте"
                            },
                            {
                                "target_lang_word": "холм",
                                "target_lang_sense_clarification": "небольшая гора"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Anhöhe",
                                "target_lang_sense_clarification": "Erhebung oder Hügel"
                            },
                            {
                                "target_lang_word": "Erhebung",
                                "target_lang_sense_clarification": "höher gelegenes Gelände"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df07572b-3c15-3122-b114-38a01c54bf15",
                    "sense_definition": "The height of the upward strokes of letters in a typeface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer adjusted the <w>ascent</w> of the font to improve readability.",
                            "target_lang_translations": {
                                "ru": "Дизайнер скорректировал <w>верхние выносные элементы</w> шрифта, чтобы улучшить читаемость.",
                                "de": "Der Designer passte die <w>Oberlänge</w> der Schriftart an, um die Lesbarkeit zu verbessern."
                            }
                        },
                        {
                            "text": "In typography, the <w>ascent</w> refers to the part of a lowercase letter that rises above the mean line.",
                            "target_lang_translations": {
                                "ru": "В типографике <w>асцендер</w> — это часть строчной буквы, которая поднимается выше средней линии.",
                                "de": "In der Typografie bezeichnet die <w>Oberlänge</w> den Teil eines Kleinbuchstabens, der über die Mittellinie hinausragt."
                            }
                        }
                    ],
                    "antonyms": [
                        "descent"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высота верхних штрихов букв в шрифте.",
                        "de": "Die Höhe der nach oben ragenden Teile von Kleinbuchstaben in einer Schriftart."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "асцендер",
                                "target_lang_sense_clarification": "верхний выносной элемент буквы"
                            },
                            {
                                "target_lang_word": "верхний выносной элемент",
                                "target_lang_sense_clarification": "типографический термин"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Oberlänge",
                                "target_lang_sense_clarification": "typografischer Begriff für den oberen Teil von Buchstaben"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}