                        ],
                        "examples": [
                            {
                                "example_id": "316caac3-d8e9-46bc-b9fc-1f872e041be6",
                                "sense_id": "5cd9e811-48ff-389a-86f8-62e8b6cef998",
                                "text": "The East Neuk indeed is infinitely more suggestive of a Stevensonian tragedy than the Ayrshire village, with the valley of the Stinchar steeped in peace and eupepticity behind it, which has given its name to the grimmest and keenest story of human diabolism ever written."
                            },
                            {
                                "example_id": "ba5bb1fc-1256-4179-b464-88038f2944ab",
                                "sense_id": "5cd9e811-48ff-389a-86f8-62e8b6cef998",
                                "text": "He is now turned of forty: no man has been in such adventures, has swum through such seas of transcendent eupepticity determined to have its fill."
                            },
                            {
                                "example_id": "47206641-898a-44ff-b1c7-9b42906c0680",
                                "sense_id": "5cd9e811-48ff-389a-86f8-62e8b6cef998",
                                "text": "Eupeptic, energetic, with the eupepticity and energy of a hardy, honourable, and, in every sense, well-brought up boy, Watson was bound to be an all—round successful man."
                            }
                        ]
                    }
