                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legislator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec13ea85-cdc5-3e45-8a96-999404f17ccc",
                                        "entry_id": "2f8d6ea8-a30c-3c94-adcb-9c4d279f1e90",
                                        "glosses": [
                                            "Someone who creates or enacts laws.",
                                            "especially a member of a legislative body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae63ea24-c47b-4ed6-bb8c-eeb6604084b1",
                                                "sense_id": "ec13ea85-cdc5-3e45-8a96-999404f17ccc",
                                                "text": "Give the children of the poor that portion of education which will enable them to know their own resources; which will cultivate in them an onward-looking hope, and give them rational amusement in their leisure hours: this, and this only, will work out that moral revolution, which is the legislator's noblest purpose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db4affef-fd1c-3aa5-b41e-1facd19d2820",
                                        "entry_id": "2f8d6ea8-a30c-3c94-adcb-9c4d279f1e90",
                                        "glosses": [
                                            "Someone who creates or enacts laws.",
                                            "especially not any individual member of a legislative body but the abstracted author of a statute or statutes relevant for the principles of interpretation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecebe06b-4c3d-4bf8-b5fe-23380dd974a1",
                        "source_entry_id": "c70392a3-6202-319a-9efc-4fee03fc074e",
                        "source_sense_id": "c21d69ae-29f7-3374-a4e5-4e842b1775dc",
                        "target_lang_word": "legislatrix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legislatrix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f154f706-13df-3bcb-b0dd-6787e25fad56",
                                        "entry_id": "78d588b8-950a-3ec9-95ec-71c974616906",
                                        "glosses": [
                                            "A female legislator."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82641904-b10b-4b17-bf4b-c4d3919472bf",
                                                "sense_id": "f154f706-13df-3bcb-b0dd-6787e25fad56",
                                                "text": "Every woman too is her own legislatrix. 'Good doctor, reprint this sheet; add, but in capitals,—“every woman is her own legislatrix.”—These words alone will sell at least nine more editions of your work."
                                            },
                                            {
                                                "example_id": "6a2e2afb-4fb4-4333-95cb-54cf9f6be78f",
                                                "sense_id": "f154f706-13df-3bcb-b0dd-6787e25fad56",
                                                "text": "The Ganges has been held in the most profound veneration ever since De-arg, according to the received tradition, precipitated herself into it. She was a celebrated legislatrix. In her advanced age, she descended into the Ganges, where she now dwells."
                                            },
                                            {
                                                "example_id": "727a5867-b32d-4fc6-bdd6-91f97823cf9b",
                                                "sense_id": "f154f706-13df-3bcb-b0dd-6787e25fad56",
                                                "text": "The Empress as Legislatrix gazed down upon a long table also covered in red velvet, surrounded by twelve carved and gilded armchairs reserved for the first twelve recipients of the Order, her true “disciples”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
