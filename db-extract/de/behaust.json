                ],
                "senses": [
                    {
                        "sense_id": "7a8f1a6d-a083-3adb-8c54-2fc1b520bb04",
                        "entry_id": "08702170-89fe-3259-8696-a7865478725c",
                        "glosses": [
                            "eine Wohnung, Unterkunft habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ddd4aab-c1cf-4705-b425-c45dc3d8509c",
                                "sense_id": "7a8f1a6d-a083-3adb-8c54-2fc1b520bb04",
                                "text": "„Die Entwicklung zeigt jedoch neben der Zunahme von behausten Unfreien auch eine allmähliche Ablösung der Frondienste durch Stückdienste.“"
                            },
                            {
                                "example_id": "4614d7eb-dda9-468e-8264-1f81d97845d1",
                                "sense_id": "7a8f1a6d-a083-3adb-8c54-2fc1b520bb04",
                                "text": "„Die Nomaden sind, so Mayhew, in allen Zivilisationen die Parasiten der behausten Gesellschaft.“"
                            },
                            {
                                "example_id": "3a23dfb3-a7cf-4dfb-9e86-505e5fa83ba6",
                                "sense_id": "7a8f1a6d-a083-3adb-8c54-2fc1b520bb04",
                                "text": "„In der Regel überwog die Zahl der behausten Familien in Folge der bäuerlichen Miteigenthumsverhältnisse diejenige der Häuser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
