                                        "examples": [
                                            {
                                                "example_id": "00b63846-b091-4db7-b97e-99c6f1519aa9",
                                                "sense_id": "3680c48b-003a-3a66-aa20-349c7c58a2ea",
                                                "text": "As a result, we talked – about a hundred and one things."
                                            },
                                            {
                                                "example_id": "bda8f287-c1e9-451e-9081-65837aa3c5cd",
                                                "sense_id": "3680c48b-003a-3a66-aa20-349c7c58a2ea",
                                                "text": "The company has one hundred and one reasons for keeping Negroes out. The union, too, has one hundred and one reasons."
                                            },
                                            {
                                                "example_id": "3f977e4c-9878-4410-8d8a-b1bba624bb2e",
                                                "sense_id": "3680c48b-003a-3a66-aa20-349c7c58a2ea",
                                                "text": "[T]o offset the massive cost of learning 101 ways to embellish spatchcock, perhaps the readers may need 101 ways to cook two-minute noodles."
                                            }
                                        ]
                                    }
                                ]
