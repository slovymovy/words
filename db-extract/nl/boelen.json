                        ],
                        "examples": [
                            {
                                "example_id": "39414ef9-7c53-42b2-864a-5b5d83e930d7",
                                "sense_id": "1db186cb-67ba-347f-a1f6-1b227240285b",
                                "text": "‘Ow, wat leuk’, zei ze, en toen boog zij zich naar me toe en zei fluisterend: ‘maar pas op, hij boelt; hij heeft het zelf aan een paar leerlingen gezegd.’",
                                "translation": "‘Oh, how nice’, she said, and then she leaned over to me and said, whispering, ‘but watch out, he's a homo; he said so himself to a few students’.",
                                "english": "‘Oh, how nice’, she said, and then she leaned over to me and said, whispering, ‘but watch out, he's a homo; he said so himself to a few students’."
                            }
                        ]
                    },
                    {
                        "sense_id": "4624cce1-e58c-32e6-9bcb-00be66b9a2ad",
                        "entry_id": "fa398379-7e49-399b-851f-bc5a4eb309ee",
                        "glosses": [
                            "to adulterate, to have extramarital sex"
                        ],
