                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce concert était vraiment <w>génial</w>, nous avons passé une soirée inoubliable.",
                            "target_lang_translations": {
                                "en": "This concert was really <w>great</w>, and we had an unforgettable evening.",
                                "ru": "Этот концерт был действительно <w>классным</w>, мы провели незабываемый вечер.",
                                "nl": "Dit concert was echt <w>geweldig</w>, we hebben een onvergetelijke avond gehad.",
                                "de": "Dieses Konzert war wirklich <w>toll</w>, und wir hatten einen unvergesslichen Abend.",
                                "pl": "Ten koncert był naprawdę <w>świetny</w>, spędziliśmy niezapomniany wieczór.",
                                "it": "Questo concerto era davvero <w>fantastico</w>, abbiamo passato una serata indimenticabile.",
                                "cs": "Ten koncert byl opravdu <w>skvělý</w>, strávili jsme nezapomenutelný večer.",
                                "tr": "Bu konser gerçekten <w>harikaydı</w>, unutulmaz bir akşam geçirdik.",
                                "es": "Este concierto fue realmente <w>genial</w>, pasamos una velada inolvidable.",
                                "zh": "这场音乐会真的<w>很棒</w>，我们度过了一个难忘的夜晚。"
                            }
                        },
                        {
                            "text": "Elle a trouvé une idée <w>géniale</w> pour organiser la fête d'anniversaire.",
                            "target_lang_translations": {
                                "en": "She came up with a <w>brilliant</w> idea for organising the birthday party.",
                                "ru": "Она придумала <w>классную</w> идею для организации дня рождения.",
                                "nl": "Ze bedacht een <w>geweldig</w> idee voor de organisatie van het verjaardagsfeest.",
                                "de": "Sie kam auf eine <w>tolle</w> Idee für die Organisation der Geburtstagsfeier.",
                                "pl": "Wpadła na <w>genialny</w> pomysł, jak zorganizować przyjęcie urodzinowe.",
                                "it": "Ha avuto un'idea <w>geniale</w> per organizzare la festa di compleanno.",
                                "cs": "Vymyslela <w>skvělý</w> nápad, jak zorganizovat narozeninovou oslavu.",
                                "tr": "Doğum günü partisini düzenlemek için <w>harika</w> bir fikir buldu.",
                                "es": "Se le ocurrió una idea <w>genial</w> para organizar la fiesta de cumpleaños.",
                                "zh": "她想到了一个<w>很棒</w>的主意，来筹办生日派对。"
                            }
