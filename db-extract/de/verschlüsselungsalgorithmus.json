                "senses": [
                    {
                        "sense_id": "32d1e37b-7912-3c1a-97a6-462bef0a4ac2",
                        "entry_id": "00197e4d-dc3d-3b54-9a84-4251b92dd0ed",
                        "glosses": [
                            "Verfahren zur Umwandlung eines Klartextes in einen Geheimtext; Verfahren zum Verschlüsseln einer Nachricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c6339cf-490f-4bdf-ab2c-fe806261192a",
                                "sense_id": "32d1e37b-7912-3c1a-97a6-462bef0a4ac2",
                                "text": "„Mit diesem Wissen war es IT-Experten nun gelungen, den Verschlüsselungsalgorithmus zu knacken.“"
                            },
                            {
                                "example_id": "02b520ad-dea7-46ed-ab79-7342f2ad8211",
                                "sense_id": "32d1e37b-7912-3c1a-97a6-462bef0a4ac2",
                                "text": "„Die Sicherheit eines Verschlüsselungsverfahrens basiert auf der Geheimhaltung des Schlüssels und nicht auf der Geheimhaltung des Verschlüsselungsalgorithmus.“"
                            },
                            {
                                "example_id": "c1d10831-19d2-4de3-af77-ed2f9c24b245",
                                "sense_id": "32d1e37b-7912-3c1a-97a6-462bef0a4ac2",
                                "text": "„Anstatt einen direkten Hardware-Schlüssel zu verwenden, läuft der Verschlüsselungsalgorithmus in einer sogenannten ‚Trust Zone‘ ab, also einem ‚vertrauenswürdigen Bereich‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
