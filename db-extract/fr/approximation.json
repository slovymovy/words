                                                "sense_id": "f94002b0-bb09-35a3-91ab-836ff06151ac",
                                                "text": "Sie war sehr verärgert über seine Annäherungen."
                                            },
                                            {
                                                "example_id": "55de1022-25e3-49e0-85cb-84f8764c65ef",
                                                "sense_id": "f94002b0-bb09-35a3-91ab-836ff06151ac",
