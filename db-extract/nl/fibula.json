                        "sense_id": "488f05d3-930a-3274-9bde-a658bb1411c2",
                        "entry_id": "509c5d39-fb5a-3765-a562-f55eb44088be",
                        "glosses": [
                            "lang bot in het onderbeen, naast het scheenbeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "962293cf-0a65-456d-9452-4e1988f906a9",
                                "sense_id": "488f05d3-930a-3274-9bde-a658bb1411c2",
                                "text": "De fibula is met het onderste deel van het scheenbeen verbonden bij de laterale gewrichtsknobbel van het scheenbeen."
                            }
                        ]
                    }
