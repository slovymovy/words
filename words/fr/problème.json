            "senses": [
                {
                    "sense_id": "da35d706-60ba-3681-9e5d-a0ea0612a5b0",
                    "sense_definition": "Difficulté, ennui ou obstacle qui complique une situation ou perturbe la vie quotidienne.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si vous avez un <w>problème</w> avec votre chambre, prévenez immédiatement le personnel de l'hôtel."
                        },
                        {
                            "text": "Nous pouvons terminer ce travail avant midi sans <w>problème</w> grâce à votre précieuse aide."
                        }
                    ],
                    "synonyms": [
                        "ennui",
                        "souci"
                    ],
                    "antonyms": [
                        "solution"
                    ],
                    "common_phrases": [
