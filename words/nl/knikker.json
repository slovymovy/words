{
    "word_family": [
        "knikkeren"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f264803-4eed-3d89-a763-5e38d9c49f3b",
                    "sense_definition": "Een klein bolletje van glas, steen of klei, gebruikt als speelgoed door kinderen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "speelgoed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind speelde de hele middag in de tuin met zijn <w>knikkers</w>.",
                            "target_lang_translations": {
                                "ru": "Ребенок весь день играл в саду со своими <w>стеклянными шариками</w>."
                            }
                        },
                        {
                            "text": "Hij won alle <w>knikkers</w> van zijn vriendjes tijdens het spel op het schoolplein.",
                            "target_lang_translations": {
                                "ru": "Он выиграл все <w>шарики</w> у своих друзей во время игры на школьном дворе."
                            }
                        }
                    ],
                    "synonyms": [
                        "stuiter"
                    ],
                    "common_phrases": [
                        "met knikkers spelen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький шарик из стекла, камня или глины, используемый детьми в качестве игрушки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стеклянный шарик",
                                "target_lang_sense_clarification": "наиболее распространенное название игрушки"
                            },
                            {
                                "target_lang_word": "марблс",
                                "target_lang_sense_clarification": "современное заимствованное название игры и самих шариков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "062d3878-ff0b-388b-9d93-f5f1fd6d00cf",
                    "sense_definition": "Een informeel woord voor het hoofd, vaak gebruikt in de context van een kale schedel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lichaamsdeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft een glimmende kale <w>knikker</w>.",
                            "target_lang_translations": {
                                "ru": "У него блестящая лысая <w>башка</w>."
                            }
                        },
                        {
                            "text": "Zet je hoed op, anders verbrandt je <w>knikker</w> in de zon.",
                            "target_lang_translations": {
                                "ru": "Надень шляпу, иначе твоя <w>голова</w> сгорит на солнце."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kale knikker"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel gebruik voor het hoofd."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное обозначение головы, часто используется применительно к лысому черепу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "башка",
                                "target_lang_sense_clarification": "разговорное, фамильярное обозначение головы"
                            },
                            {
                                "target_lang_word": "котелок",
                                "target_lang_sense_clarification": "ироничное обозначение головы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "543f14fc-8cf9-31f2-8d01-90e0170e7ff8",
                    "sense_definition": "De inzet of het belang bij een spel of een zakelijke overeenkomst.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij deze onderhandelingen gaat het echt om de <w>knikkers</w>.",
                            "target_lang_translations": {
                                "ru": "В этих переговорах речь идет о серьезных <w>ставках</w>."
                            }
                        },
                        {
                            "text": "Hij wil altijd winnen, ongeacht of het om de <w>knikkers</w> gaat of niet.",
                            "target_lang_translations": {
                                "ru": "Он всегда хочет побеждать, независимо от того, высоки ли <w>ставки</w> или нет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "om de knikkers spelen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставка или значимость в игре или деловой сделке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставка",
                                "target_lang_sense_clarification": "то, что поставлено на кон в игре или споре"
                            },
                            {
                                "target_lang_word": "суть дела",
                                "target_lang_sense_clarification": "в переносном смысле о важности результата"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f86faced-fb73-3ef8-8319-ab424da09eb6",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>knikkeren</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "handeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>knikker</w> graag met mijn buurjongen in de pauze.",
                            "target_lang_translations": {
                                "ru": "Я люблю <w>играть в шарики</w> с соседским мальчиком на перемене."
                            }
                        },
                        {
                            "text": "Elke middag <w>knikker</w> ik op het plein voor de school.",
                            "target_lang_translations": {
                                "ru": "Каждый день после обеда я <w>играю в шарики</w> на площади перед школой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Первое лицо единственного числа настоящего времени от глагола «играть в шарики»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играю в шарики",
                                "target_lang_sense_clarification": "процесс игры в марблс"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}