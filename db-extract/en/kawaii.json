            {
                "entry_id": "1449e254-2e65-35a9-9ca5-bb953a5ea646",
                "word": "kawaii",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "66292a1c-187f-4e49-bc21-50a9c78cc788",
                        "entry_id": "1449e254-2e65-35a9-9ca5-bb953a5ea646",
