                "senses": [
                    {
                        "sense_id": "1729e4d3-981e-3313-92b5-6939d5d8d000",
                        "entry_id": "45fca0b0-bde3-31fb-bad6-5cf160d7430f",
                        "glosses": [
                            "To move at full speed, especially in retreat."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "informal",
                            "transitive",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3a6ace1b-a38d-4d21-9ad5-6e4ec394c105",
                                "sense_id": "1729e4d3-981e-3313-92b5-6939d5d8d000",
                                "text": "He hightailed it toward town."
                            },
                            {
                                "example_id": "434d0750-9846-4fb3-9894-69b097cfceae",
                                "sense_id": "1729e4d3-981e-3313-92b5-6939d5d8d000",
                                "text": "I want you to hightail your butt out of there before they come back."
                            },
                            {
                                "example_id": "2402485c-4434-4192-8bed-72e78b796e65",
                                "sense_id": "1729e4d3-981e-3313-92b5-6939d5d8d000",
                                "text": "When I saw he had scored, I just hightailed out of there, because all those people started running down on the field and that's a lot more dangerous than playing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "332b46c2-467d-44d2-ab6d-50795623db61",
                        "source_entry_id": "45fca0b0-bde3-31fb-bad6-5cf160d7430f",
                        "source_sense_id": "1729e4d3-981e-3313-92b5-6939d5d8d000",
                        "source_sense_description": "to move at full speed, especially in retreat",
                        "target_lang_word": "abrauschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abrauschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34dfd551-596b-3988-bb33-1e34c66a5de4",
                                        "entry_id": "7b44729b-4dde-33fb-a64d-61d060e007cf",
                                        "glosses": [
                                            "sich rasch motorisiert entfernen"
                                        ],
                                        "tags": [
                                            "intransitiv, umgangssprachlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2f86863-890b-4eb0-8a74-7d017ca97212",
                                                "sense_id": "34dfd551-596b-3988-bb33-1e34c66a5de4",
                                                "text": "Auch auf dem Wochenmarkt bedienen sich die älteren Herrschaften ausgiebig am Käsestand, fragen dem Händler Löcher in den Bauch über seinen feinen Gruyère, um dann gestärkt auf ihren E-Bikes abzurauschen."
                                            },
                                            {
                                                "example_id": "9afb4118-fd71-4c85-971c-e90bec338689",
                                                "sense_id": "34dfd551-596b-3988-bb33-1e34c66a5de4",
                                                "text": "Und der, bevor der weisse SUV abrauschte, geistesgegenwärtig die Autonummer fotografiert hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b4830b98-bf89-369e-8e0f-e913f056fbe9",
                                        "entry_id": "7b44729b-4dde-33fb-a64d-61d060e007cf",
                                        "glosses": [
                                            "sich auffällig und geräuschvoll entfernen"
                                        ],
                                        "tags": [
                                            "intransitiv, umgangssprachlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3da70656-9c10-4916-a8a1-2ef27bd7b625",
                                                "sense_id": "b4830b98-bf89-369e-8e0f-e913f056fbe9",
                                                "text": "Der Star der Bullen rauschte nach einer Übungseinheit einfach ab und ließ Jesse Marsch und Co. regelrecht stehen."
                                            },
                                            {
                                                "example_id": "9d69483d-d54f-4e9e-a094-fcf33122db7d",
                                                "sense_id": "b4830b98-bf89-369e-8e0f-e913f056fbe9",
                                                "text": "Die Dame ignoriert die freundlichen Worte: \"Das geht schon, wir haben einen Schal hingelegt!!!!\" und rauschte ab."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "572cca01-6591-46fa-aa81-1299cf5ef6d8",
                        "source_entry_id": "45fca0b0-bde3-31fb-bad6-5cf160d7430f",
                        "source_sense_id": "1729e4d3-981e-3313-92b5-6939d5d8d000",
                        "source_sense_description": "to move at full speed, especially in retreat",
                        "target_lang_word": "flüchten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flüchten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "444fd1dd-d29e-35cf-8d8e-b35607d35aec",
                                        "entry_id": "594d2e82-e013-351c-89ea-85e58ab283ae",
                                        "glosses": [
                                            "meist schnell und wenig vorbereitet, vor einer drohenden Gefahr oder aus einer unangenehmen Situation fliehen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa5e49d8-81e9-4322-b084-c800774a93d7",
                                                "sense_id": "444fd1dd-d29e-35cf-8d8e-b35607d35aec",
                                                "text": "Sie flüchteten aus dem Dorf, nachdem bewaffnete Truppen in der Ferne sichtbar wurden."
                                            },
                                            {
                                                "example_id": "346c16b8-119c-4810-87bc-95b8ed17ebb6",
                                                "sense_id": "444fd1dd-d29e-35cf-8d8e-b35607d35aec",
                                                "text": "Der Gefangene flüchtete aus der Haftanstalt."
                                            },
                                            {
                                                "example_id": "a22da44c-0b0f-4615-ab8a-c4d42ed6256b",
                                                "sense_id": "444fd1dd-d29e-35cf-8d8e-b35607d35aec",
                                                "text": "Als das Glockengeläut begann, versuchte jeder so schnell wie möglich in den Wald zu flüchten."
                                            },
                                            {
                                                "example_id": "e159787a-8392-4544-96b2-0df66b054bb8",
                                                "sense_id": "444fd1dd-d29e-35cf-8d8e-b35607d35aec",
                                                "text": "Franz Stangl war für den Tod von nahezu einer Million Juden verantwortlich. Nach Kriegsende flüchtete der KZ-Kommandant nach Syrien, kurz darauf nach Brasilien."
                                            },
                                            {
                                                "example_id": "eef4ccc3-802b-4305-991f-05f2601d85a9",
                                                "sense_id": "444fd1dd-d29e-35cf-8d8e-b35607d35aec",
                                                "text": "1948, bei der Gründung des Staates Israel, wurden sie [die Palästinenser] aus ihrer Heimat vertrieben und sind nach Syrien geflüchtet."
                                            },
                                            {
                                                "example_id": "3a1fda2b-39b2-4df4-936d-c2e937e5c8f3",
                                                "sense_id": "444fd1dd-d29e-35cf-8d8e-b35607d35aec",
                                                "text": "Ungefähr 150.000 geflüchtete Tibeter haben in verschiedenen Ländern der Welt ihr Asyl gefunden, der größte Teil in Indien"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b98c174d-e405-3949-bbcf-d8f8da8e5580",
                                        "entry_id": "594d2e82-e013-351c-89ea-85e58ab283ae",
                                        "glosses": [
                                            "woanders Zuflucht suchen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1047efa-9e71-4389-8a26-495707ad7cf5",
                                                "sense_id": "b98c174d-e405-3949-bbcf-d8f8da8e5580",
                                                "text": "Nach dem Tod des Ehemannes flüchtete sie sich in die Arbeit."
                                            },
                                            {
                                                "example_id": "f6b8816a-be4e-4e10-a068-2742441c77e0",
                                                "sense_id": "b98c174d-e405-3949-bbcf-d8f8da8e5580",
                                                "text": "Er flüchtete sich in eine wiederum andere «andere Welt» - in die Welt der Bücher."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
