                        ]
                    },
                    {
                        "translation_id": "bc7b2cec-c1b6-4a43-b461-b89dc3e7961f",
                        "source_entry_id": "3fc307de-8231-388b-a879-9a894c559327",
                        "source_sense_id": "a927e9b0-fd36-36f8-9196-fa2b39dcdd1a",
                        "target_lang_word": "bercail",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bercail",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3cffcf0-3d9b-3b70-82d0-45d19d98d52a",
                                        "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                                        "glosses": [
                                            "Bergerie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcaf5646-64b9-47ee-bad1-5bf0b7c4622e",
                                                "sense_id": "f3cffcf0-3d9b-3b70-82d0-45d19d98d52a",
                                                "text": "Un jardin grand et riche, une maison jolie,\nUn bercail spacieux pour tes chères brebis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb831109-52a9-35a9-aeee-faab49dad563",
                                        "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                                        "glosses": [
                                            "Troupeau de brebis, de moutons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f99210-54d2-4915-823f-9ea4955dcee0",
                                                "sense_id": "cb831109-52a9-35a9-aeee-faab49dad563",
                                                "text": "Le pâtre absent par fraude !\nLe chien mort ! le loup rôde,\nEt tend ses noirs panneaux.\nAu bercail qui frissonne,\nQui veillera ? personne.\nPauvres petits agneaux !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fc040a1-94f6-34c6-81bf-6f0bde4464bd",
                                        "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                                        "glosses": [
                                            "En allusion à la parabole du Bon Pasteur : espace de l’Église où les fidèles trouvent sûreté et paix, hors duquel ils sont égarés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9a7147f-5784-4363-933e-a00b7059707c",
                                                "sense_id": "5fc040a1-94f6-34c6-81bf-6f0bde4464bd",
                                                "text": "Revenir, rentrer au bercail, revenir à la pratique de la vraie religion, à une conduite pieuse dont on s’était écarté."
                                            },
                                            {
                                                "example_id": "fb2cec85-d5cf-47a7-9b9a-e423b0c405da",
                                                "sense_id": "5fc040a1-94f6-34c6-81bf-6f0bde4464bd",
                                                "text": "Dieu ne défend pas les routes fleuries, quand elles servent à revenir à lui, et ce n'est pas toujours par les sentiers rudes et sublimes de la montagne, que la brebis égarée retourne au bercail."
                                            },
                                            {
                                                "example_id": "3b4a9025-8b93-437f-af6a-e32de33e9eab",
                                                "sense_id": "5fc040a1-94f6-34c6-81bf-6f0bde4464bd",
                                                "text": "Hélas ! mes frères, reprit le curé, cet ancien négociant, ce Kernok, c’était aussi un agneau éloigné du bercail !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4de336e6-4fe2-3a39-9d85-f2c30dce92eb",
                                        "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                                        "glosses": [
                                            "Communauté religieuse plus ou moins nombreuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "067a4ce9-774b-4958-8b6e-d04f4b41d21d",
                                                "sense_id": "4de336e6-4fe2-3a39-9d85-f2c30dce92eb",
                                                "text": "Il y avait à Paris des milliers de retraites semblables, où le clergé réfractaire réunissait clandestinement de petits troupeaux de fidèles. La police des sections, bien que vigilante et soupçonneuse, fermait les yeux sur ces bercails cachés, de peur des ouailles irritées et par un reste de vénération pour les choses saintes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee707365-f142-30d8-bc8b-f29a1d0c71f0",
                                        "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                                        "glosses": [
                                            "Maison."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5c83178-0a02-417c-badd-1f64dbae7599",
                                                "sense_id": "ee707365-f142-30d8-bc8b-f29a1d0c71f0",
                                                "text": "Mais revenons à nos amis qui, eux-mêmes, reviennent au bercail…"
                                            },
                                            {
                                                "example_id": "d9169b74-d4d8-4d16-8eda-e4243e8f83c8",
                                                "sense_id": "ee707365-f142-30d8-bc8b-f29a1d0c71f0",
                                                "text": "Ainsi, après le départ de Pauline Barrat à Toulouse faute d’accès à l’élite, alors qu’elle est suivie par les Bleues, Lucie Coupé a souhaité rentrer dans son bercail agenais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
