                    },
                    {
                        "translation_id": "a8cbc688-bc17-4810-93e5-5d9251e87db1",
                        "source_entry_id": "a9eda06d-e299-3082-8a1c-e12af3855ff5",
                        "source_sense_id": "3ad51ba8-552f-32e2-8546-52eee1e0f6fe",
                        "source_sense_description": "süddeutsch, österreichisch: nicht mehr",
                        "target_lang_word": "no longer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "no longer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2292a1ca-b89e-3242-b1e6-ba08424122e2",
                                        "entry_id": "d24dd95e-ed40-37f8-bd6e-241f19b073a0",
                                        "glosses": [
                                            "Not anymore; no more."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68f12269-ea4e-4317-8ea5-d7ac89ba686f",
                                                "sense_id": "2292a1ca-b89e-3242-b1e6-ba08424122e2",
                                                "text": "no longer with us"
                                            },
                                            {
                                                "example_id": "c555273d-eba9-46aa-8e9f-a16b889171a5",
                                                "sense_id": "2292a1ca-b89e-3242-b1e6-ba08424122e2",
                                                "text": "Maybe it no longer matters who the emperor is."
                                            },
                                            {
                                                "example_id": "03c2f48b-1bef-448c-81e8-98881713d1eb",
                                                "sense_id": "2292a1ca-b89e-3242-b1e6-ba08424122e2",
                                                "text": "It was once acceptable to say \"honestest\", but no longer."
                                            },
                                            {
                                                "example_id": "d0227bac-2ab3-44bc-b419-056e96bc17f6",
                                                "sense_id": "2292a1ca-b89e-3242-b1e6-ba08424122e2",
                                                "text": "Preservation of two railway routes between Belfast and Derry could no longer be justified and one of them must go."
                                            },
                                            {
                                                "example_id": "3bc68344-7a90-4981-946f-1dc60746656b",
                                                "sense_id": "2292a1ca-b89e-3242-b1e6-ba08424122e2",
                                                "text": "Thirty-five years ago, many journeys around London meant having to pass through the centre of the capital. That's no longer the case, which takes real pressure off the city's termini as well as underground routes such as the Circle Line."
                                            },
                                            {
                                                "example_id": "125a90ec-bc19-4ad9-bb42-79af65df8d71",
                                                "sense_id": "2292a1ca-b89e-3242-b1e6-ba08424122e2",
                                                "text": "ISMs and topics that were under meeting sections 6 to 10 are now no longer a thing. Players that wish to submit a proposal (Transport Project, Event, Inactive Asset Bypass/Transfer, MRT Line, or something else) should no longer email staff and should instead submit them to the new #proposals Discord forum channel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
