                "translations": [
                    {
                        "translation_id": "bb6826e7-7d1e-4b28-b602-85aef0a80dce",
                        "source_entry_id": "66f3979e-a67d-3950-9e0a-93d1843b25be",
                        "source_sense_id": "4e88cd46-6f8f-3285-8b36-f7bfe194d08e",
                        "source_sense_description": "eine Insel, worauf England, Wales und Schottland liegen",
                        "target_lang_word": "Großbritannien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großbritannien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e47970b0-8e95-3a52-9073-9a7f816a1fea",
                                        "entry_id": "57f6ce46-dd66-3d8f-9f11-90aac8895695",
                                        "glosses": [
                                            "eine im Nordwesten Europas gelegene Insel, die größte der Britischen Inseln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddcdc361-2e10-4d74-b84b-913a567daf04",
                                                "sense_id": "e47970b0-8e95-3a52-9073-9a7f816a1fea",
                                                "text": "„Der geographische Begriff ‹Großbritannien› (Great Britain) schränkt den Raum auf die britische Hauptinsel ein und umfaßt England, Schottland und Wales, schließt aber die irische Insel aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99564a52-bda2-3e22-82d2-b9c871702e3c",
                                        "entry_id": "57f6ce46-dd66-3d8f-9f11-90aac8895695",
                                        "glosses": [
                                            "der britische Staat"
                                        ],
                                        "tags": [
                                            "kurz"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "081f9c66-9121-3a88-99fc-c390b01da470",
                                        "entry_id": "57f6ce46-dd66-3d8f-9f11-90aac8895695",
                                        "glosses": [
                                            "der britische Staat",
                                            "Königreich Großbritannien (1707–1801)"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d995ac-2756-4412-ae84-50eb437132da",
                                                "sense_id": "081f9c66-9121-3a88-99fc-c390b01da470",
                                                "text": "Großbritannien wurde 1801 ein Teil des Vereinigten Königreichs Großbritannien und Irland."
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "34820849-b51d-3720-8286-84bbefbcb048",
                                        "entry_id": "57f6ce46-dd66-3d8f-9f11-90aac8895695",
                                        "glosses": [
                                            "der britische Staat",
                                            "Vereinigtes Königreich Großbritannien und Irland (1801–1927)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b2b57c4-055f-4b4e-8261-945f7108b580",
                                                "sense_id": "34820849-b51d-3720-8286-84bbefbcb048",
                                                "text": "1801 schlossen sich das Königreich Irland und Großbritannien zu einem Königreich zusammen."
                                            },
                                            {
                                                "example_id": "6055cdfa-3ef7-4ee1-9d04-e7d5c7eb3742",
                                                "sense_id": "34820849-b51d-3720-8286-84bbefbcb048",
                                                "text": "„Er eignete sich in Großbritannien Kenntnisse über Dampfmaschinen an und verbesserte die Maschinen in englischen Kohlegruben maßgeblich.“"
                                            },
                                            {
                                                "example_id": "d2ec157e-2087-490a-905e-dbfa58b44f46",
                                                "sense_id": "34820849-b51d-3720-8286-84bbefbcb048",
                                                "text": "„Grammatiker und Stilisten in Großbritannien veröffentlichten zur gleichen Zeit Warnungen gegen den Gebrauch von zu vielen Zeichen und einen übermäßig exklamatorischen Ton.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "303f0b3e-f890-3372-bffe-e620c065831f",
                                        "entry_id": "57f6ce46-dd66-3d8f-9f11-90aac8895695",
                                        "glosses": [
                                            "der britische Staat",
                                            "Vereinigtes Königreich Großbritannien und Nordirland (1927–heute)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c174aeec-c9e3-4274-81c1-ef89f8ca1858",
                                                "sense_id": "303f0b3e-f890-3372-bffe-e620c065831f",
                                                "text": "Das Vereinigte Königreich Großbritannien und Nordirland verkürzt als Großbritannien zu bezeichnen ist heute sachlich falsch."
                                            }
                                        ],
                                        "sense_index_json": "\"2c\""
