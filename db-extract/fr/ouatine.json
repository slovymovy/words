                "senses": [
                    {
                        "sense_id": "75739528-eca4-398e-bc74-f3d68fd2db4f",
                        "entry_id": "b17b7e1d-6360-3942-885f-8a17e6a917f6",
                        "glosses": [
                            "Étoffe molletonnée servant à doubler certains vêtements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5a9dca3-eb4e-454e-a109-60c590ef9ff1",
                                "sense_id": "75739528-eca4-398e-bc74-f3d68fd2db4f",
                                "text": "L’aube décousait le ciel dont les nuages bas étalés comme des pannes d'habits mal faufilés sur la table d'un tailleur laissaient voir l'endroit et l'envers, le drap, la doublure, la ouatine et le crin des rembourrages."
                            },
                            {
                                "example_id": "f35b7447-2cd3-4109-9af2-61a9de32be22",
                                "sense_id": "75739528-eca4-398e-bc74-f3d68fd2db4f",
                                "text": "Ce qui vous étonne peut-être c’est que, quand vous m’avez vue dans Chalamont, je portais une ouatine que m’avait prêtée Mme Tim."
                            },
                            {
                                "example_id": "0cdd8d0d-11e7-4311-992a-77f438e0b710",
                                "sense_id": "75739528-eca4-398e-bc74-f3d68fd2db4f",
                                "text": "Ils arrachaient la toile à grands coups secs, s'acharnaient sur la ouatine du rembourrage et la doublure en peau de lapin."
                            }
                        ]
                    }
                ],
