                "senses": [
                    {
                        "sense_id": "f0604f54-c29b-3410-8921-b5ef767b5975",
                        "entry_id": "3e716623-7c74-3b57-b4ae-7469fd22899a",
                        "glosses": [
                            "ein der Zentralgewalt unmittelbar unterstelltes Verwaltungsgebiet, in dem sich zumeist die Hauptstadt befindet"
                        ],
                        "tags": [
                            "in föderativen Staaten"
                        ],
                        "examples": [
                            {
                                "example_id": "ce7b7898-c870-441b-856a-2d67eeac6b32",
                                "sense_id": "f0604f54-c29b-3410-8921-b5ef767b5975",
                                "text": "Einen Bundesdistrikt haben unter anderem Argentinien, Australien, Brasilien, Indien, Mexiko, Venezuela und die USA."
                            },
                            {
                                "example_id": "deeccc47-bc33-41a2-a7b8-ef75e5110139",
                                "sense_id": "f0604f54-c29b-3410-8921-b5ef767b5975",
                                "text": "Sie halten es dabei für die vernünftigste Lösung, wenn Berlin ein Bundesdistrikt werde."
                            },
                            {
                                "example_id": "e04022c9-df7a-4ad3-95e2-f4b9e3269e1a",
                                "sense_id": "f0604f54-c29b-3410-8921-b5ef767b5975",
                                "text": "Was immer die auf ihre Selbständigkeit bedachten „Anschlußgemeinden\" im Laufe der Jahre als Alternativen vorschlugen: einen Zweckverband, eine Regionalstadt, einen Stadtkreis, einen Bundesdistrikt nach dem Vorbild des District of Columbia um Washington — alles dies verschwand im Orkus."
                            },
                            {
                                "example_id": "938d344a-3f43-47fd-b677-890e01a5fc30",
                                "sense_id": "f0604f54-c29b-3410-8921-b5ef767b5975",
                                "text": "Gewählt wurden am Sonntag auch der Kongreß in Brasilia, die Landesparlamente der 26 Bundesländer und des Bundesdistrikts Brasilia sowie die Gouverneure."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
