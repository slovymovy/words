                "entry_id": "e08acacd-7b2a-3c37-bd0f-3cbaee44e5b7",
                "word": "doléance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d369e069-24eb-4795-8812-7eac7098281f",
                        "entry_id": "e08acacd-7b2a-3c37-bd0f-3cbaee44e5b7",
                        "tags": [
                            "plural"
                        ],
                        "form": "doléances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6675ec3-d760-3b58-acbd-28e699158540",
                        "entry_id": "e08acacd-7b2a-3c37-bd0f-3cbaee44e5b7",
                        "glosses": [
                            "État de souffrance qui rend dolent."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "564bfb44-240b-4df4-a944-9020d4862dfe",
                                "sense_id": "e6675ec3-d760-3b58-acbd-28e699158540",
                                "text": "En voyant que son pénitent en revenait toujours à la honte de son inertie et à cet état de comateuse doléance dans lequel le plongeait la transe du Sacrement, le vieux prêtre lui dit : […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "661dcd21-8f8e-39fb-9fa9-e1e141ba5379",
                        "entry_id": "e08acacd-7b2a-3c37-bd0f-3cbaee44e5b7",
                        "glosses": [
                            "Plainte pour réclamer, récriminer."
                        ],
                        "tags": [
                            "Surtout au pluriel"
                        ],
                        "examples": [
                            {
                                "example_id": "ccb3bb99-fd3d-486d-a8fd-d26f2136a506",
                                "sense_id": "661dcd21-8f8e-39fb-9fa9-e1e141ba5379",
                                "text": "Elle recommença ses doléances, elle se mit à geindre de plus belle sur le manque de fortune qui la faisait échouer au port."
                            },
                            {
                                "example_id": "8891345c-18a8-49c5-a701-5a9dc1c218d4",
                                "sense_id": "661dcd21-8f8e-39fb-9fa9-e1e141ba5379",
                                "text": "Puis il fallut écouter les compliments des paysans et leurs doléances enveloppées dans des protestations de respect."
                            },
                            {
                                "example_id": "f1122a7b-5dbf-4f2d-b244-ea17a1e2f021",
                                "sense_id": "661dcd21-8f8e-39fb-9fa9-e1e141ba5379",
                                "text": "Les gouvernement libéraux avaient toujours refusé de céder aux doléances des évêques."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ffbb0ad-1e33-3eb0-b39c-9bda8a97db2e",
                        "entry_id": "e08acacd-7b2a-3c37-bd0f-3cbaee44e5b7",
                        "glosses": [
                            "Demandes ou représentations contenues dans les cahiers des états généraux ou provinciaux, pour demander le redressement de quelque grief, la diminution ou la suppression d’un impôt, etc."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "48c8abff-a3a8-495d-8817-6b6afc1d3f7c",
                                "sense_id": "7ffbb0ad-1e33-3eb0-b39c-9bda8a97db2e",
                                "text": "Cahiers de doléances."
                            }
                        ]
                    }
                ],
