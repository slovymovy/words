                    {
                        "sense_id": "56d0d923-e398-324e-ba3f-91b453ab1898",
                        "entry_id": "634e89af-75d2-30da-9777-fed182f90cf9",
                        "glosses": [
                            "Linguistik, Geschwindigkeit, mit der jemand spricht"
