                ],
                "senses": [
                    {
                        "sense_id": "0eda00e4-7184-32de-9c32-cf74bcfabfa7",
                        "entry_id": "be8ee660-bef9-3098-b826-fb87bb391ca5",
                        "glosses": [
                            "lauter Ruf nach Hilfe aus einer Notsituation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5c13cd-aa2f-41d7-bc99-89039a3bfa12",
                                "sense_id": "0eda00e4-7184-32de-9c32-cf74bcfabfa7",
                                "text": "Als formeller Grund für das Eindringen der Polizei gilt ein Hilferuf, der aus der Wohnung heraus an sie ergeht."
                            },
                            {
                                "example_id": "23d01b39-7a1d-4776-aee5-3740d1706320",
                                "sense_id": "0eda00e4-7184-32de-9c32-cf74bcfabfa7",
                                "text": "„Ihre Hilferufe verhallten ungehört, auch die Große Armee war in Eile und konnte sich nicht um verwundete Russen kümmern.“"
                            },
                            {
                                "example_id": "b194d77c-3619-43a3-8e79-95f1ed76777f",
                                "sense_id": "0eda00e4-7184-32de-9c32-cf74bcfabfa7",
                                "text": "„Die Männer lauschten einen Augenblick, und wieder drang der schrille Hilferuf der Indianerin durch die stille Nacht daher, daß die Eule in den dunkeln Fichten am Flußufer höhnend darauf antwortete und neugierig dem Orte zuflog, von dem solch unheimliche Laute herübertönten.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b9d231fe-ca2a-32e3-ac49-9a3e6b08ee97",
                        "entry_id": "be8ee660-bef9-3098-b826-fb87bb391ca5",
                        "glosses": [
                            "Signal, das übermittelt wird, um bei einem Notfall Hilfe zu alarmieren, üblicherweise das telefonische Anfordern von Rettungsdiensten wie Feuerwehr, Polizei oder Rettung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4dd8bea-457a-4ca2-bbcf-39a050b947dd",
                                "sense_id": "b9d231fe-ca2a-32e3-ac49-9a3e6b08ee97",
                                "text": "„Als die Retter nach dem Hilferuf das Schiff enterten fehlten von den Seeräubern jede Spur.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
