                "senses": [
                    {
                        "sense_id": "36193c43-0364-38af-9252-6aeb9c584b3d",
                        "entry_id": "efc13119-50ce-3048-b0c6-ca6fb9c59ba8",
                        "glosses": [
                            "Faire perdre son caractère boursouflé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a02c05c-62d5-478b-82ce-4562daa0610a",
                                "sense_id": "36193c43-0364-38af-9252-6aeb9c584b3d",
                                "text": "On eût dit un corps autrefois adipeux, maintenant dégraissé et déboursouflé, et dont l’enveloppe était restée flottante, suspendue aux articulations de l’armature."
                            },
                            {
                                "example_id": "aea9cd36-e835-4b34-ad92-f5d180116ad6",
                                "sense_id": "36193c43-0364-38af-9252-6aeb9c584b3d",
                                "text": "Ce fonds est financé par le maigre budget européen que le Royaume-Uni avec cinq autres complices avait voulu déboursoufler fin 2003 alors qu’il aurait fallu renforcer sa dotation pour que les élargissements se réalisent dans des conditions optimales."
                            },
                            {
                                "example_id": "359cb5e7-bab2-4a2f-89bf-e9383e45c522",
                                "sense_id": "36193c43-0364-38af-9252-6aeb9c584b3d",
                                "text": "J’ai pourtant un écran de 24\", avec des graphismes baissés au maximum pour optimiser et déboursoufler mais rien à faire."
                            }
                        ]
                    }
                ],
