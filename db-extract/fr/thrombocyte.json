                "senses": [
                    {
                        "sense_id": "dded3a8a-125b-3eac-a8bc-27c4d3155a5b",
                        "entry_id": "c2b87b5e-0284-3146-8510-51fad7bc5683",
                        "glosses": [
                            "Fragment de mégacaryocyte présent dans le sang et qui joue un rôle important dans la coagulation sanguine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14edf809-b526-4ba8-9789-c7b7fe926b9a",
                                "sense_id": "dded3a8a-125b-3eac-a8bc-27c4d3155a5b",
                                "text": "La liaison déclenche l’activation du thrombocyte qui émet alors des pseudopodes et sécrète le contenu de ses granules ainsi que des substances produites extemporanément (des dérivés de l’acide arachidonique par exemple)."
                            },
                            {
                                "example_id": "6de70c8f-34f3-4884-b094-7b6f89ff1129",
                                "sense_id": "dded3a8a-125b-3eac-a8bc-27c4d3155a5b",
                                "text": "La moelle rouge produit les cellules souches hématopoïétiques (les érythrocytes, les leucocytes, les thrombocytes)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58b5432d-26df-4228-ad87-01a2032af283",
                        "source_entry_id": "c2b87b5e-0284-3146-8510-51fad7bc5683",
                        "source_sense_id": "dded3a8a-125b-3eac-a8bc-27c4d3155a5b",
                        "target_lang_word": "Thrombozyt",
