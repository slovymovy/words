                    },
                    {
                        "form_id": "9c682c0c-9853-4bd5-8616-39b82538f92a",
                        "entry_id": "1377b205-4978-3a98-9c20-d104f96396ab",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most beguiling"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94aa1a71-ff7e-3d7e-a6e2-dec3c62716d7",
                        "entry_id": "1377b205-4978-3a98-9c20-d104f96396ab",
                        "glosses": [
                            "That beguiles or beguile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6489fd3-2c7c-4344-af33-aecd2ad02d17",
                                "sense_id": "94aa1a71-ff7e-3d7e-a6e2-dec3c62716d7",
                                "text": "a beguiling look"
                            },
                            {
                                "example_id": "a22afc2d-ea7e-42bb-baf8-f8fc218c38c7",
                                "sense_id": "94aa1a71-ff7e-3d7e-a6e2-dec3c62716d7",
                                "text": "I thought he was supposed to be my mentor. But, in actuality, what did I know about the often beguiling world of adults?"
                            },
                            {
                                "example_id": "aa5b970e-d6f7-45dd-9a3d-7b0846110084",
                                "sense_id": "94aa1a71-ff7e-3d7e-a6e2-dec3c62716d7",
                                "text": "“You don't need to count it. It's all there, necromancer.” “I should trust you when you show me no respect for me or my beguiling powers?” “Respect? For a fraud?” “But you've seen my methods succeed.” “I've seen your magic. It has a fraudulent vibe.”"
                            },
                            {
                                "example_id": "bdfb8e14-5f5e-4378-9033-76828ff67fee",
                                "sense_id": "94aa1a71-ff7e-3d7e-a6e2-dec3c62716d7",
                                "text": "Rutland (and some of the bordering ‘Notswolds’ counties of Lincolnshire, Leicestershire and Northamptonshire) have the same mellow, creamy limestone as the Cotswolds and boast beguiling market towns and villages that are every bit as attractive, but without the tourists or hefty prices."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5811683f-07ba-4885-a3ed-e8976ac900a9",
                        "source_entry_id": "1377b205-4978-3a98-9c20-d104f96396ab",
                        "source_sense_id": "94aa1a71-ff7e-3d7e-a6e2-dec3c62716d7",
                        "source_sense_description": "that beguiles",
                        "target_lang_word": "verleidelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verleidelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "beb5e206-f16e-3763-95a3-71a0cae6ef1a",
                                        "entry_id": "6f50093f-6b19-3bef-ae39-07a9bf8e91d5",
                                        "glosses": [
                                            "gemakkelijk te verleiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9675c5af-f8f5-434f-a404-deabee2f6abe",
                                                "sense_id": "beb5e206-f16e-3763-95a3-71a0cae6ef1a",
                                                "text": "Het is een verleidelijk beeld, als je langs talloze kerken en kastelen rijdt, door stadjes waar geen leven te bekennen is, laat staan enige moderne vorm van bedrijvigheid. Maar daarmee misken je de dynamiek die je even goed langs de Nationale 7 aantreft."
                                            },
                                            {
                                                "example_id": "eefd6eb8-fa48-4edf-bbe0-cc70c019f3ed",
                                                "sense_id": "beb5e206-f16e-3763-95a3-71a0cae6ef1a",
                                                "text": "Het is verleidelijk om na een maand presidentschap Trump en Poetin over één kam te scheren. Ze delen immers hun honger naar macht en rijkdom, zijn geobsedeerd met zichzelf, haten de media, hebben lak aan wetten en instituties en liegen er vrolijk op los."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f63aa174-2043-4c89-a87b-6f9f14972967",
                        "source_entry_id": "1377b205-4978-3a98-9c20-d104f96396ab",
                        "source_sense_id": "94aa1a71-ff7e-3d7e-a6e2-dec3c62716d7",
                        "source_sense_description": "that beguiles",
                        "target_lang_word": "séduisant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séduisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76e55310-a550-3e27-885f-133159c5e2bf",
                                        "entry_id": "346ccb8d-a938-3174-85dd-d2a5da0f188e",
                                        "glosses": [
                                            "Qui séduit, qui est propre à séduire, à plaire."
                                        ],
                                        "tags": [],
                                        "note": "Il se dit ordinairement en bonne part",
                                        "examples": [
                                            {
                                                "example_id": "7cc9203d-8454-4312-ba1b-cda2ffe88447",
                                                "sense_id": "76e55310-a550-3e27-885f-133159c5e2bf",
                                                "text": "Parfois, on rencontre une fille dont le teint noisette et les yeux de baies sauvages sont séduisants, mais leurs traits sont rarement beaux, et elles enlaidissent vite, dès que la première fraîcheur de la jeunesse est passée..."
                                            },
                                            {
                                                "example_id": "adae371e-8708-4d05-92bf-c3d3db224036",
                                                "sense_id": "76e55310-a550-3e27-885f-133159c5e2bf",
                                                "text": "Il était beau, il avait toutes les raisons d'être séduisant, mais Roxanne voulait des mots, et Christian ne les avait pas."
                                            },
                                            {
                                                "example_id": "d2409cd0-55f2-4b13-8ca8-541619e7b642",
                                                "sense_id": "76e55310-a550-3e27-885f-133159c5e2bf",
                                                "text": "C'étaient, en un sens, de fausses bonnes idées. Séduisantes sur le plan esthétique, mais parfaitement irréalisables pour tout un tas de raisons complexes. La science-fiction en est remplie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "séduisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b936749-acda-3893-8c2f-e483b7fbbb54",
                                        "entry_id": "1a67772b-fefc-347f-abc1-116262a5d97b",
                                        "glosses": [
                                            "Participe présent de séduire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a632cc15-1c93-45a4-9730-baccd321430e",
                                                "sense_id": "6b936749-acda-3893-8c2f-e483b7fbbb54",
                                                "text": "Comme tout bon auteur de littérature enfantine, La Fontaine semble dès l’abord jouer sur les deux tableaux, instruisant les enfants à travers leurs parents, mais aussi séduisant les adultes par l’intermédiaire de leur progéniture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
