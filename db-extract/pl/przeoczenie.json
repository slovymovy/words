                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oversight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e31c699-4aaa-35dc-8b8a-a4681bf4bd4a",
                                        "entry_id": "c6ff3efc-a749-38cb-9dbe-60cf70d3e39e",
                                        "glosses": [
                                            "An omission; something that is left out, missed, or forgotten."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f592703-f803-43c5-9fcc-db33306db27c",
                                                "sense_id": "3e31c699-4aaa-35dc-8b8a-a4681bf4bd4a",
                                                "text": "A small oversight at this stage can lead to big problems later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd30bdb2-a8c2-345d-8fd9-d75134a56a85",
                                        "entry_id": "c6ff3efc-a749-38cb-9dbe-60cf70d3e39e",
                                        "glosses": [
                                            "Supervision or management."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "106d8ec8-1a29-4588-aae7-003f56279b18",
                                                "sense_id": "fd30bdb2-a8c2-345d-8fd9-d75134a56a85",
                                                "text": "oversight mechanism"
                                            },
                                            {
                                                "example_id": "b830fbd4-dc45-4c61-96a7-794944b20cd0",
                                                "sense_id": "fd30bdb2-a8c2-345d-8fd9-d75134a56a85",
                                                "text": "The bureaucracy was subject to government oversight."
                                            },
                                            {
                                                "example_id": "63563da9-83b1-4749-a231-7c765a7c011e",
                                                "sense_id": "fd30bdb2-a8c2-345d-8fd9-d75134a56a85",
                                                "text": "It has jailed environmental activists and is planning to limit the power of judicial oversight by handing a state-approved body a monopoly over bringing environmental lawsuits."
                                            },
                                            {
                                                "example_id": "42a20b24-05ac-4b49-b7cd-c4c158a8cc32",
                                                "sense_id": "fd30bdb2-a8c2-345d-8fd9-d75134a56a85",
                                                "text": "The drone operation is subject to strict regulatory oversight. Russell notes that due to UK Civil Aviation Authority (CAA) and privacy laws, BTP can only fly its drones if they have a named specific purpose to do so."
                                            },
                                            {
                                                "example_id": "c862667c-485c-40df-95bc-8028fa9100af",
                                                "sense_id": "fd30bdb2-a8c2-345d-8fd9-d75134a56a85",
                                                "text": "\"Yeah.\" It was him, alright; if the world's weariest pair of workboots hadn't tipped her off, his world-weary voice certainly would have. \"Where were you?\"\n\"My quarters. We've got a full ticket set today, and techs work best without oversight.\" Neither of these things was untrue, though the curation was more than a little dishonest.\n\"Maybe yours do.\" Nascimbeni rolled out, back flat against a neon orange creeper, and sat up with an audible wince. \"Mine fuck the dog.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fb674fb-3eba-3eed-adc9-4b21dc3796ae",
                                        "entry_id": "c6ff3efc-a749-38cb-9dbe-60cf70d3e39e",
                                        "glosses": [
                                            "Overview."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81490fc7-c1b4-4985-a77f-a5e810a5b785",
                                                "sense_id": "1fb674fb-3eba-3eed-adc9-4b21dc3796ae",
                                                "text": "A large map of the kingdom, in which the Protestant churches, including the Unitarian, are indicated in colors, gives a convenient oversight of the matter treated of by the writer."
                                            }
                                        ]
                                    }
                                ]
                            },
