                "senses": [
                    {
                        "sense_id": "53cee318-a007-3312-aee6-0953528540fb",
                        "entry_id": "59db9645-44b6-30c8-85ab-6d666845c017",
                        "glosses": [
                            "Rockersprache: Mitglied eines Motorradclubs, zuständig für Organisation und Sicherheit der Ausfahrten oder Treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62e086a0-471b-469d-9ff2-0ce72bdb2070",
                                "sense_id": "53cee318-a007-3312-aee6-0953528540fb",
                                "text": "„Der Road-Captain muss einen halbwegs guten Draht zur Polizei haben, damit die bei den Touren ein Auge zudrücken, wenn gnadenlos rote Ampeln übersehen oder Vorfahrtsstraßen blockiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22251284-39d8-4fa0-80d8-cd49b7c041eb",
                        "source_entry_id": "59db9645-44b6-30c8-85ab-6d666845c017",
                        "source_sense_id": "53cee318-a007-3312-aee6-0953528540fb",
                        "target_lang_word": "tour guide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tour guide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "527de106-f152-3cdc-b09d-4d2a057c0cab",
                                        "entry_id": "3df35409-bd18-30cc-9689-d1c26daed75f",
                                        "glosses": [
                                            "One who provides assistance and information to people on organised tours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1a0b7a3-ec98-4eb7-b7c2-674562521d28",
                                                "sense_id": "527de106-f152-3cdc-b09d-4d2a057c0cab",
                                                "text": "Before he came to Stanford, Thrun had worked on robotic tour guides for museums in Germany, an interactive humanoid robot that worked in a nursing home near Pittsburgh, and a system of robots that could search out mines."
                                            },
                                            {
                                                "example_id": "187df638-c12e-4e92-b77f-df3650617b50",
                                                "sense_id": "527de106-f152-3cdc-b09d-4d2a057c0cab",
                                                "text": "Government licensed tour guides would take the groups through the site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16b5e62a-981c-397e-8089-341f95a0229b",
                                        "entry_id": "3df35409-bd18-30cc-9689-d1c26daed75f",
                                        "glosses": [
                                            "Synonym of travel guide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b098feb2-df94-4b31-bd7c-0d201c86277f",
                                                "sense_id": "16b5e62a-981c-397e-8089-341f95a0229b",
                                                "text": "I opened my Bible at the first chapter of the Gospel according to St Mark and as I read, it was as if I were reading a tour guide of my own home district."
                                            },
                                            {
                                                "example_id": "3ae408b3-6967-4805-ae7e-c964362d669c",
                                                "sense_id": "16b5e62a-981c-397e-8089-341f95a0229b",
                                                "text": "Using a Tour Guide / Another handy feature you can try when familiarizing yourself with Internet content are the guides provided by Netscape."
                                            },
                                            {
                                                "example_id": "64210d3b-b91d-4992-9fd1-365d4427167a",
                                                "sense_id": "16b5e62a-981c-397e-8089-341f95a0229b",
                                                "text": "You can learn about the places to visit by seeing a tour presentation or by reading a tour guide. A good guide or presentation will have both pictures and text. Computer software can be used to make tour guides and presentations."
                                            },
                                            {
                                                "example_id": "256d3a87-2600-4447-86f9-83154826e25c",
                                                "sense_id": "16b5e62a-981c-397e-8089-341f95a0229b",
                                                "text": "Michelle lounged in the passenger seat reading a tour guide she’d picked up in the hotel confectionary story before they’d checked out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
