                                    {
                                        "sense_id": "1bb08802-00f5-3df5-bab9-ac6ec7e2b20c",
                                        "entry_id": "8992f0a1-deec-302a-87d6-f8d2f5105877",
                                        "glosses": [
                                            "Genetisch bedingte Störung der Melaninsynthese bei Tieren und beim Menschen, die zum Fehlen der dunklen Farbstoffe in der Haut, den Haaren und den Augen führen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "685c5f42-ddda-4861-89dc-123c4caf54ed",
                                                "sense_id": "1bb08802-00f5-3df5-bab9-ac6ec7e2b20c",
                                                "text": "„Bei Menschen mit Albinismus sind die Haare aufgrund des Fehlens von Melaninen weiß bis hellblond.“"
