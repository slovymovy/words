                "senses": [
                    {
                        "sense_id": "9d102aec-c316-379e-99f1-f2bb4a3c00b8",
                        "entry_id": "08fe6497-1d40-39f2-8403-e19156dc62e8",
                        "glosses": [
                            "Fleuve côtier des Préalpes méditerranéennes qui traverse Nice."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "3be77223-1013-46e3-89fe-53bb62c50ab1",
                                "sense_id": "9d102aec-c316-379e-99f1-f2bb4a3c00b8",
                                "text": "En contraste à cet apparat, le vieux Nice offrait ses tuiles brûlées et ses pierres blanches : à l’embouchure du tortueux Paillon, la petite rivière clownesque sautillante jusqu’aux galets de la grève, des bugadières troublaient l’eau de leurs lessives."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cda38cd-bc32-454f-a337-c094aad82558",
                        "source_entry_id": "08fe6497-1d40-39f2-8403-e19156dc62e8",
