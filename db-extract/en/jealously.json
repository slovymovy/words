                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed4e333-6c37-421e-a86d-0ddf141e330e",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "Ich bin nicht eifersüchtig, wie oft soll ich das noch sagen!"
                                            },
                                            {
                                                "example_id": "d7c75c0b-3f81-4c7d-a2ec-15b1579d6d16",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "Ihr zweiter Mann ist noch eifersüchtiger als der erste."
                                            },
                                            {
                                                "example_id": "e896fa6a-e128-42c3-8fa9-3c7ee6871d71",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "Die eifersüchtige Sekretärin verfolgte die Frau ihres Chefs."
                                            },
                                            {
                                                "example_id": "a6d2df9e-0ac4-449f-991e-6ffbe6aeb9fc",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "Du bist doch nicht etwa eifersüchtig auf mich?"
                                            },
                                            {
                                                "example_id": "633fc52b-69c4-49a7-83da-b872a2a23f86",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "Eifersüchtig musterte sie ihre Rivalin."
                                            },
                                            {
                                                "example_id": "15b8d61a-3ed0-4092-9542-770b407cad41",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "„In seiner pompösen Hotelsuite in Los Angeles trank sich Johnny Fontane einen Rausch an, wie jeder andere eifersüchtige Ehemann.“"
