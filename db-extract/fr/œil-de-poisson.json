                                                "example_id": "cb31ff5d-a600-4ddd-ae1c-87860c1e86a1",
                                                "sense_id": "d7362f68-5b4e-3015-8e14-ff7ed93b1366",
                                                "text": "My father with his Christmas-red vest and braggart’s moustache is boycotting the party. It must be Sunday or Saturday morning and he’s cold and sleepy fisheyeing his long-haired sons."
                                            }
                                        ]
