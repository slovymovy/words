                        "examples": [
                            {
                                "example_id": "9a18396d-e140-454b-a3f9-c4ead6695498",
                                "sense_id": "9526e5f5-0a45-38c6-82f8-4daba0fd3779",
                                "text": "The Paphian mimp was a certain pucker of the lips considered needful for the highly genteel."
                            },
                            {
                                "example_id": "79d1e93d-c0f9-4a54-9c8e-f96b0d6c42c4",
                                "sense_id": "9526e5f5-0a45-38c6-82f8-4daba0fd3779",
                                "text": "Sure you muſt have obſerved the drop of the under lip is exploded ſince Lady Simpermode broke a tooth—(Sets her mouth affectedly)—I am preparing the caſt of the lips for the enſuing winter—thus—It is to be call’d the Paphian mimp."
                            },
                            {
                                "example_id": "db317df4-f6ef-427e-bfe4-b19a0c203835",
                                "sense_id": "9526e5f5-0a45-38c6-82f8-4daba0fd3779",
                                "text": "My working hunch was that the very young leopard frog tadpole would make a near-perfect donor. […] While he’s little, he’ll mimp-mouth algae from the flanks of a tubifex and harm nothing but a little vermigrade pride."
                            }
                        ]
                    }
