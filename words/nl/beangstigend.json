                            }
                        },
                        {
                            "text": "Het is een <w>beangstigend</w> idee dat we helemaal geen controle hebben over de situatie.",
                            "target_lang_translations": {
                                "en": "It is a <w>scary</w> idea that we have absolutely no control over the situation.",
                                "fr": "C'est une idée <w>angoissante</w> que nous n'ayons aucun contrôle sur la situation."
                            }
