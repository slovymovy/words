{
    "word_family": [
        "contortion",
        "contortionist",
        "contortive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fbb1167a-1620-3864-b00f-fb94e3135dc7",
                    "sense_definition": "To twist or bend something into a violent or unnatural shape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "twisting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete's face <w>contorted</w> in pain after the severe injury.",
                            "target_lang_translations": {
                                "cs": "Sportovcova tvář se po vážném zranění bolestí <w>zkřivila</w>."
                            }
                        },
                        {
                            "text": "Strong winds <w>contorted</w> the metal frame of the old building.",
                            "target_lang_translations": {
                                "cs": "Silný vítr <w>zkroutil</w> kovový rám staré budovy."
                            }
                        }
                    ],
                    "synonyms": [
                        "twist",
                        "deform"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zkroutit nebo ohnout něco do násilného nebo nepřirozeného tvaru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zkroutit",
                                "target_lang_sense_clarification": "fyzické ohnutí nebo deformace předmětu"
                            },
                            {
                                "target_lang_word": "zkřivit se",
                                "target_lang_sense_clarification": "o tváři: stáhnout se bolestí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdec2034-174c-3452-b092-8cbce236349a",
                    "sense_definition": "To twist the face or body into a strained or unusual expression.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "twisting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>contorted</w> his features to mimic a scary monster.",
                            "target_lang_translations": {
                                "cs": "Svůj obličej <w>zkřivil</w>, aby napodobil děsivé monstrum."
                            }
                        },
                        {
                            "text": "She <w>contorted</w> her body into a strange position during the yoga class.",
                            "target_lang_translations": {
                                "cs": "Během hodiny jógy <w>zkroutila</w> své tělo do podivné polohy."
                            }
                        }
                    ],
                    "synonyms": [
                        "twist"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zkroutit obličej nebo tělo do napjatého nebo neobvyklého výrazu či polohy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zkřivit se",
                                "target_lang_sense_clarification": "používá se zejména pro obličejové rysy"
                            },
                            {
                                "target_lang_word": "zkroutit se",
                                "target_lang_sense_clarification": "používá se pro tělo nebo jeho části"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}