                        "sense_id": "f567be1a-20ac-3f77-a2cd-ef0250c8b178",
                        "entry_id": "6b7ecf7b-0e65-3d58-a53a-8b8cd57ad1a7",
                        "glosses": [
                            "In flames, on fire, flaming, with flames coming from it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc11436b-dcc7-4f3f-9be1-ddb75f363a9c",
                                "sense_id": "f567be1a-20ac-3f77-a2cd-ef0250c8b178",
                                "text": "My heart's aflame, my body's strained, but, God, I like it"
                            }
                        ]
                    },
                    {
                        "sense_id": "772d4a27-1dc1-373b-90ca-75427eeeec77",
                        "entry_id": "6b7ecf7b-0e65-3d58-a53a-8b8cd57ad1a7",
                        "glosses": [
                            "Showing anger or contempt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85522e54-d146-4140-82c0-95d776813896",
                                "sense_id": "772d4a27-1dc1-373b-90ca-75427eeeec77",
                                "text": "She said nothing and simply stared at him, eyes aflame."
                            }
                        ]
                    },
                    {
                        "sense_id": "32613862-c441-342e-a776-70a589e46eb7",
                        "entry_id": "6b7ecf7b-0e65-3d58-a53a-8b8cd57ad1a7",
                        "glosses": [
                            "Having the colour of flames."
                        ],
                        "tags": [],
                        "examples": [
