                    },
                    {
                        "translation_id": "ae830ba0-eeaa-464b-845f-22e0cdbf8424",
                        "source_entry_id": "9d685249-243d-353c-b0c2-a6dceb0d3201",
                        "source_sense_id": "716c8d9a-28ab-3fbe-9b27-b7ef43f6a625",
                        "target_lang_word": "settler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "settler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "Someone who settles in a new location, especially one who takes up residence in a previously uninhabited place; a colonist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7939f95-5ddf-4655-821d-910db909bc84",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "the first settlers of New England"
                                            },
                                            {
                                                "example_id": "52579e07-6333-46ef-88dd-f34be51f8b08",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "The law, which let settlers stay on private land if they had built there without knowing the property belonged to Palestinians or had done so at the state’s direction, was backed by Israel’s most right-wing governing coalition to date."
                                            },
                                            {
                                                "example_id": "a96ceb0e-4704-4f57-a394-17ba58908b57",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "It was the racist, settler colonialism that created whiteness, that created blackness, half-caste, quarter-caste, octoroon, that saw mixed-race people as a third race. […] This belief was one of the drivers of the ‘protection’ laws that led to the settler government’s theft of children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f6dfcc-cc19-3cd8-a353-b98529b3dcca",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "Someone who decides or settles something, such as a dispute."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5146319-0904-3f07-bdc9-7d0926625dec",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "That which settles or finishes, such as a blow that decides a contest."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec4ceef8-d623-33f8-a7a0-24115af212b1",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "The person in a betting shop who calculates the winnings."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8e27349-eddc-3829-84a6-6e18640aa36f",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "A drink which settles the stomach, especially a bitter drink, often a nightcap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "525268af-54b3-4f76-b911-29805489aefe",
                                                "sense_id": "d8e27349-eddc-3829-84a6-6e18640aa36f",
                                                "text": "[H]aving got out the rum bottle for a quiet “settler” just as the victim of his fascinations glided through the carefully adjusted door, he had been persuaded to go on drinking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa0f0776-e6e7-3884-8d04-0ddfcd8e147a",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "A vessel, such as a tub, in which something, such as pulverized ore suspended in a liquid, is allowed to settle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b2a9f2-7664-466b-962d-12e5514cfbac",
                                                "sense_id": "aa0f0776-e6e7-3884-8d04-0ddfcd8e147a",
                                                "text": "First, there will be little reaction in the settler so that the concentrations of soluble constituents in the recycle stream are the same as those in the bioreactor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1350308d-58c7-45e5-ba9e-a975db06d08e",
                        "source_entry_id": "9d685249-243d-353c-b0c2-a6dceb0d3201",
                        "source_sense_id": "716c8d9a-28ab-3fbe-9b27-b7ef43f6a625",
                        "target_lang_word": "colonista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "86e5a082-e28c-45f6-ba84-642fd90bd0a6",
                        "source_entry_id": "9d685249-243d-353c-b0c2-a6dceb0d3201",
                        "source_sense_id": "716c8d9a-28ab-3fbe-9b27-b7ef43f6a625",
                        "target_lang_word": "femme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "femme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a212c6d5-02d1-376c-acc2-7bc259780ffd",
                                        "entry_id": "745da67c-e148-352d-b4c7-303c8042eb8d",
                                        "glosses": [
                                            "Être humain adulte de genre ou de sexe féminin (par opposition à fille, fillette, femme-enfant)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa8d40bd-4a7a-42bd-9eeb-1b33e1ce4b2f",
                                                "sense_id": "a212c6d5-02d1-376c-acc2-7bc259780ffd",
                                                "text": "Mais peu avant sa vingtième année, quand de jeune fille elle devint femme et vit s’effiler sous les seins le premier pli charmant de la maturité qui va naître, il lui vint tout à coup des ambitions."
                                            },
                                            {
                                                "example_id": "6e4c9b9e-7fc9-4330-9715-ccb45bfc93c0",
                                                "sense_id": "a212c6d5-02d1-376c-acc2-7bc259780ffd",
                                                "text": "Mes tempes battent ; toute ma chair va à cette femme presque nue et charmante dans le matin et dans le transparent vêtement qui enferme la douce odeur d’elle."
                                            },
                                            {
                                                "example_id": "a4679a33-1255-40d5-9e5d-33fbd1529ca4",
                                                "sense_id": "a212c6d5-02d1-376c-acc2-7bc259780ffd",
                                                "text": "Les femmes qui ont réussi à s’imposer à la tête des entreprises de médias sont des ultras : ultracompétentes, ultraconvaincantes, ultradéterminées."
                                            },
                                            {
                                                "example_id": "f6cc833e-924b-4a8e-a2be-9e80783d8468",
                                                "sense_id": "a212c6d5-02d1-376c-acc2-7bc259780ffd",
                                                "text": "De plus, les déserts médicaux risquent de s’intensifier car les nouveaux médecins (et de plus en plus de femmes) ne veulent plus multiplier les heures de travail au-delà de ce qui est raisonnable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f034b68-9859-3074-a324-1bb72921ba2d",
                                        "entry_id": "745da67c-e148-352d-b4c7-303c8042eb8d",
                                        "glosses": [
                                            "Conjointe ; épouse ; partenaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f998575-063b-4251-a6ca-fd99d3dd3e41",
                                                "sense_id": "1f034b68-9859-3074-a324-1bb72921ba2d",
                                                "text": "Néanmoins la foi conjugale est sans cesse violée dans les grandes sociétés policées. Il est peu de maris qui soient fidèles à leurs femmes ; il est peu de femmes qui soient fidelles à leurs maris."
                                            },
                                            {
                                                "example_id": "a9f4a7d7-3085-4c23-af72-3197dce430c8",
                                                "sense_id": "1f034b68-9859-3074-a324-1bb72921ba2d",
                                                "text": "Cette révélation ne fut pas sans conséquence : dorénavant, je décidai qu'une femme ne m'aimait pas si elle me refusait ce petit cratère étoilé dont je caressais délicatement les fronces lors de mes premières approches."
                                            },
                                            {
                                                "example_id": "f1ddd41f-e4a2-402a-b1d3-dedc238a778e",
                                                "sense_id": "1f034b68-9859-3074-a324-1bb72921ba2d",
                                                "text": "Quand je la menai à l’autel, j’étais bien convaincu que ma femme l’emportait en beauté sur toutes les femmes belles de la terre."
                                            },
                                            {
                                                "example_id": "da233aee-4219-4e01-9f31-7e24fe91f9ac",
                                                "sense_id": "1f034b68-9859-3074-a324-1bb72921ba2d",
                                                "text": "Préviens ta femme de ton arrivée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c87d3a18-74d1-36fa-b941-9ba96e6663f2",
                                        "entry_id": "745da67c-e148-352d-b4c7-303c8042eb8d",
                                        "glosses": [
                                            "Personne adulte de genre féminin, qui possède les qualités supposées des femmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28812232-b218-4ede-9eb4-2cb0919e46de",
                                                "sense_id": "c87d3a18-74d1-36fa-b941-9ba96e6663f2",
                                                "text": "Tout penseur complet doit être femme par les côtés délicats du cœur."
                                            },
                                            {
                                                "example_id": "31ee3ffd-f7df-498a-a1a3-327433223bcc",
                                                "sense_id": "c87d3a18-74d1-36fa-b941-9ba96e6663f2",
                                                "text": "— Monsieur, je ne suis qu’une femme, et, par conséquent, mon jugement est peu de chose."
                                            },
                                            {
                                                "example_id": "3a92657a-544c-49be-8acb-5128686b52fe",
                                                "sense_id": "c87d3a18-74d1-36fa-b941-9ba96e6663f2",
                                                "text": "Je suis l’ennemi de ce règne de l’homme qui n’est pas encore terminé. Pour moi, la femme est l’avenir de l’homme, au sens où Marx disait que l’homme est l’avenir de l’homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b630b1-59be-3e44-94db-062ef64593a2",
                                        "entry_id": "745da67c-e148-352d-b4c7-303c8042eb8d",
                                        "glosses": [
                                            "Personnel féminin. → voir femme de ménage et femme de chambre."
                                        ],
                                        "tags": [
                                            "dated",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbbffdd5-b67e-41a9-904d-b8e64c2db593",
                                                "sense_id": "e1b630b1-59be-3e44-94db-062ef64593a2",
                                                "text": "Elle se tourna de l’autre côté en achevant ces paroles, et commanda à sa ﬁlle d’appeler ses femmes sans vouloir l’écouter, ni parler davantage."
                                            },
                                            {
                                                "example_id": "086db799-8286-428f-9bf1-e806301a340a",
                                                "sense_id": "e1b630b1-59be-3e44-94db-062ef64593a2",
                                                "text": "Faut-il que j’appelle vos femmes ? demanda le roi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a4458bc-b869-3402-a5c0-b46b8f98a28f",
                                        "entry_id": "745da67c-e148-352d-b4c7-303c8042eb8d",
                                        "glosses": [
                                            "Avant ou après un nom épicène pour lever une ambiguïté."
                                        ],
                                        "tags": [
                                            "En apposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9d7e3d6-703b-4d6a-bebd-6de029baa54f",
                                                "sense_id": "1a4458bc-b869-3402-a5c0-b46b8f98a28f",
                                                "text": "Si seules de rares femmes photographes marquent l’histoire de la photographie au XIXᵉ siècle, elles prennent superbement leur revanche à partir des années vingt."
                                            },
                                            {
                                                "example_id": "07bcb96d-8630-4feb-9eb2-8493440a683e",
                                                "sense_id": "1a4458bc-b869-3402-a5c0-b46b8f98a28f",
                                                "text": "Si elle réussissait comme femme-policier, elle pouvait réussir dans n'importe quel domaine. Les autres agents secrets de son service disaient qu'elle avait des couilles. Pour eux, c'était un compliment, et Jezzie l'acceptait comme tel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f4fe13-ae2b-3093-bd25-77608ac4fd03",
                                        "entry_id": "745da67c-e148-352d-b4c7-303c8042eb8d",
                                        "glosses": [
                                            "Femelle de l’Homo sapiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be828693-fb07-4d4a-8cb6-dab48bfd1b53",
                                                "sense_id": "e2f4fe13-ae2b-3093-bd25-77608ac4fd03",
                                                "text": "Les divers préjugés sur le rapport d’excellence de l’homme à la femme, ont été produits par les coutumes des anciens peuples, les systèmes de politique et les religions qu’ils ont modifiés à leur tour. J’en excepte la religion chrétienne, qui a établi, comme je le dirai plus bas, une supériorité réelle dans l’homme, en conservant néanmoins à la femme les droits de l’égalité. […] Un proverbe hébreu borne presque toute l’habileté des femmes à leur quenouille, et Sophocle a dit que le silence était leur plus grand ornement. Par un excès opposé, Platon veut qu’elles aient les mêmes occupations que les hommes. Voyez le cinquième dialogue Πολιτειῶν."
                                            },
                                            {
                                                "example_id": "ce59c817-e862-46c8-a46f-e775f4ea9097",
                                                "sense_id": "e2f4fe13-ae2b-3093-bd25-77608ac4fd03",
                                                "text": "Ce n’est jamais d’après le masque hypocrite des femmes qu’il faut s’aviser de les juger."
                                            },
                                            {
                                                "example_id": "2e9fbbd2-108b-435b-9398-e80246b23b24",
                                                "sense_id": "e2f4fe13-ae2b-3093-bd25-77608ac4fd03",
                                                "text": "Les Benjamites furent avertis qu’ils pourroient s’approcher secrètement du lieu de la fête, s’aposter de manière à bien voir les femmes qui s’y trouveroient, et enlever sans résistance celles qu’ils voudroient pour épouses."
                                            },
                                            {
                                                "example_id": "22d346e8-73a4-4b2c-87e4-c618991b8605",
                                                "sense_id": "e2f4fe13-ae2b-3093-bd25-77608ac4fd03",
                                                "text": "Cependant les femmes de Lima gouvernent les hommes parce qu’elles leur sont bien supérieures en intelligence et en force morale."
                                            },
                                            {
                                                "example_id": "bdf0e29f-01d1-441c-96e6-c3bfe90ccbb8",
                                                "sense_id": "e2f4fe13-ae2b-3093-bd25-77608ac4fd03",
                                                "text": "La part des femmes dans les responsables d’accidents diminue en même temps que la gravité de ceux-ci. Ainsi 20% des responsables d’accidents corporels sont des femmes. Elles commettent moins d'infractions que les hommes et leur première infraction survient plus tardivement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
