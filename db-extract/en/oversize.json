                                    {
                                        "sense_id": "1d2dd421-2528-344f-8844-e48b5f4eed0c",
                                        "entry_id": "4e0a25a0-6813-3187-b063-ddef1574ff31",
                                        "glosses": [
                                            "Très ou trop grand, dont la dimension est plus importante que la normale dans sa catégorie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3d05b89-3385-48e2-a171-743c54e39969",
                                                "sense_id": "1d2dd421-2528-344f-8844-e48b5f4eed0c",
                                                "text": "Mais parler de « rassemblement » pour Les Républicains, en morceaux, n’en frise pas moins l’abus de langage. Le mot est surdimensionné, presque autant que le nombre des adhérents."
                                            },
                                            {
                                                "example_id": "8bd17f09-9a72-43b2-888d-886c56c993a4",
                                                "sense_id": "1d2dd421-2528-344f-8844-e48b5f4eed0c",
                                                "text": "On a longtemps cru à tort que le refus de Donald Trump de concéder la défaite relevait de son ego surdimensionné."
                                            },
                                            {
                                                "example_id": "b907d7f0-9180-46aa-9ce3-eceee4ff7d8d",
                                                "sense_id": "1d2dd421-2528-344f-8844-e48b5f4eed0c",
                                                "text": "Un appareil surdimensionné fonctionne le plus souvent au ralenti, tirage fermé."
                                            }
                                        ]
                                    }
