                "senses": [
                    {
                        "sense_id": "150f78ae-3c5a-3df5-aec6-c5fd8b4dd79b",
                        "entry_id": "bbfa52bb-9c3a-39d9-93c4-1eca678847ca",
                        "glosses": [
                            "eine verbindliche Vorschrift oder Anweisung, ohne Gesetzescharakter für den Emissionshandel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "566589b9-5b92-43a8-8203-5e46c060751a",
                                "sense_id": "150f78ae-3c5a-3df5-aec6-c5fd8b4dd79b",
                                "text": "„Der Emissionshandel wird durch die Emissionshandelsrichtlinie (EHRL) auf der Ebene der Unternehmen im Gemeinschaftssystem der EU eingeführt.“"
                            },
                            {
                                "example_id": "b0a1c554-5cd8-4d11-81e5-d47ec17522eb",
                                "sense_id": "150f78ae-3c5a-3df5-aec6-c5fd8b4dd79b",
                                "text": "„In diesem Beitrag wird der Diskussionsstand der UAG III im Hinblick auf den Anlagenbegriff der Emissionshandelsrichtlinie und die damit verbundenen Umsetzungsprobleme zusammengefasst.“"
                            },
                            {
                                "example_id": "dab9c808-5d0c-4daa-af2f-bd639d6bd6b4",
                                "sense_id": "150f78ae-3c5a-3df5-aec6-c5fd8b4dd79b",
                                "text": "„Die Richtlinie 2009/29/EG zur Änderung der Emissionshandelsrichtlinie 2003/87/EG (EHS-Richtlinie) macht die Kompensation indirekter CO2-Kosten möglich, und auch in Deutschland ist jetzt der Startschuss für die lang ersehnte Förderung gefallen: Das Bundesministerium für Wirtschaft und Technologie (BMWi) hat […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
