                                        "entry_id": "3dc89a5f-ccdf-33eb-adc9-fe9bc4562555",
                                        "glosses": [
                                            "Person, welche den Lehren des kommunistischen Revolutionärs Wladimir Lenin anhängt und sich an seiner Denkweise orientiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1249d92f-548b-4377-a2bf-5c84d89bcb3a",
                                                "sense_id": "48664d0c-7f35-37c9-9072-c7e42adb55d8",
                                                "text": "„Der Bundesregierung sind keine Äußerungen bekannt, in denen behauptet worden ist, der derzeitige Präsident des Bundesgesundheitsamtes sei Leninist.”"
