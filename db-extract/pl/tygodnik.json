                                                "sense_id": "664b06e3-79ee-3177-b98e-af38618639f7",
                                                "text": "He's going for his weekly check-up at the hospital."
                                            },
                                            {
                                                "example_id": "219f8d37-23e3-499c-8922-f196ee929e19",
                                                "sense_id": "664b06e3-79ee-3177-b98e-af38618639f7",
                                                "text": "In summer, we cut the grass on a weekly basis."
                                            },
                                            {
                                                "example_id": "786ccf7d-44f1-4d57-89b0-20e0868ff776",
                                                "sense_id": "664b06e3-79ee-3177-b98e-af38618639f7",
                                                "text": "In Virginia, gone are the weekly outings to Walmart to stock up on provisions; to El Ranchito, the Mexican convenience store, to buy shell-shaped concha pastries; and to the laundromat to machine wash heavily soiled garments."
                                            }
