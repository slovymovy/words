                        "examples": [
                            {
                                "example_id": "4033c419-e56f-478e-b344-0d85319f3aea",
                                "sense_id": "7628e3b8-643a-303b-bd62-969bc1f7e883",
                                "text": "Rekenen met reeksen is meestal niet eenvoudig."
