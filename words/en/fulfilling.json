        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e0420e36-ac54-3aff-8293-6654e757fb63",
                    "sense_definition": "Causing a sense of happiness and satisfaction because one is doing something useful, important, or realizing one's potential.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She found her new career in teaching to be incredibly <w>fulfilling</w>.",
                            "target_lang_translations": {
                                "ru": "Она находила свою новую карьеру в преподавании невероятно <w>приносящей удовлетворение</w>.",
                                "it": "Ha trovato la sua nuova carriera nell'insegnamento incredibilmente <w>appagante</w>.",
                                "es": "Encontró que su nueva carrera en la enseñanza era increíblemente <w>gratificante</w>."
                            }
                        },
                        {
                            "text": "Living a <w>fulfilling</w> life often involves helping others and pursuing your passions.",
                            "target_lang_translations": {
                                "ru": "Жизнь <w>полноценной</w> жизнью часто включает в себя помощь другим и следование своим увлечениям.",
                                "it": "Vivere una vita <w>appagante</w> comporta spesso aiutare gli altri e seguire le proprie passioni.",
                                "es": "Llevar una vida <w>plena</w> a menudo implica ayudar a los demás y seguir tus pasiones."
                            }
                        }
                    ],
                    "synonyms": [
                        "satisfying",
                        "rewarding",
                        "gratifying"
                    ],
                    "antonyms": [
                        "unfulfilling",
                        "disappointing",
                        "frustrating"
                    ],
                    "common_phrases": [
                        "fulfilling life",
                        "fulfilling career",
                        "fulfilling experience",
                        "fulfilling job"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий чувство счастья и удовлетворения от осознания полезности дела или реализации своего потенциала.",
                        "it": "Che suscita un senso di felicità e soddisfazione perché si fa qualcosa di utile, importante o che realizza il proprio potenziale.",
                        "es": "Que produce una sensación de felicidad y satisfacción porque uno hace algo útil, importante o realiza su propio potencial."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приносящий удовлетворение",
