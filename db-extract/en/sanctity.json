                                        "glosses": [
                                            "Cualidad de santo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afc9c60c-893e-4a8f-b372-16d6aa3c9578",
                                                "sense_id": "e2c08d95-d34b-3137-86e8-f82d04780412",
                                                "text": "«22. Quévarones ilustres en santidad y milagros ha tenido que sean dignos de memoria»."
                                            },
                                            {
                                                "example_id": "ce193814-21ee-4dc7-acc0-18f038fd1274",
                                                "sense_id": "e2c08d95-d34b-3137-86e8-f82d04780412",
                                                "text": "«Esta santidad mentida fue, sin duda, el señuelo de que te valiste»."
                                            }
