                                            {
                                                "example_id": "0748fb35-f65d-4cc9-b2df-287a49b49f08",
                                                "sense_id": "9bdbc93a-0105-38d7-b6ad-2b386925cf83",
                                                "text": "Louis-Philippe, le roi-citoyen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                        "entry_id": "c0e3f69d-76f7-3992-96e5-37baa8cc5cc7",
                                        "glosses": [
                                            "Qui se rapporte à la citoyenneté ou au civisme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29822029-b434-4f64-8506-a3066e99ed8a",
                                                "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                                "text": "Un sursaut citoyen est nécessaire."
                                            },
                                            {
                                                "example_id": "701dfc50-bc9b-4c0a-8e55-bc98d405eb99",
                                                "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                                "text": "Le Mouvement républicain et citoyen (MRC) est un parti politique français de gauche républicaine qui a été fondé en 2003,"
                                            },
                                            {
                                                "example_id": "d4d2d3d5-f3c7-441b-bfcb-8cb6fb251215",
                                                "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                                "text": "Mais faire un petit effort pour écarter les fautes d'orthographe et de grammaire est un acte citoyen : il démontre un souci de l'autre, un respect pour la conversation en cours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
