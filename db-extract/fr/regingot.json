                        "entry_id": "d340b62b-c7e7-3628-8d19-3a7ff2889f39",
                        "glosses": [
                            "Pièce maçonnée, préfabriquée ou coulée en place, destinée à supporter la traverse basse du dormant de la fenêtre tout en évacuant l’eau de la baie à l’extérieur sans ruisseler sur la façade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0568bc2-7260-4cd0-9db7-4b80fc238d65",
                                "sense_id": "a3e065e6-81c2-3381-85ce-d80faaeace18",
                                "text": "Les pièces d'appui auront 0m 11 (onze centimètres) de largeur sur 0m 08 (huit centimètres) de hauteur ; elles seront arrondies à l'extérieur avec regingot en dessous."
                            }
                        ]
                    },
                    {
                        "sense_id": "8efe5ed7-2742-3ef2-be25-17f267544943",
                        "entry_id": "d340b62b-c7e7-3628-8d19-3a7ff2889f39",
                        "glosses": [
                            "Repas de fête."
                        ],
                        "tags": [
                            "Bourgogne"
                        ],
                        "examples": [
                            {
                                "example_id": "b2e8a6af-d87b-4457-94d7-1372bc91ad17",
                                "sense_id": "8efe5ed7-2742-3ef2-be25-17f267544943",
                                "text": "Il y eut ce soir-là une part de venaison pour chacun des trente feux du village et il en resta un beau quartier qu’Hippolyte le cocher fut chargé de porter à l’hôpital du canton pour le regingot des fêtes."
                            }
                        ]
                    }
