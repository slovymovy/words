                        "translation_id": "a973c916-1a7e-4b9d-acf3-2ca43f6a4c9b",
                        "source_entry_id": "c9cc3755-1f28-39a6-9b3d-59179f744a1a",
                        "source_sense_id": "f69aeebf-9ef6-3329-9f7f-dff7b304d0f2",
                        "target_lang_word": "wrangler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wrangler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "230a29fe-954c-3c7c-b827-226a6b3e86fe",
                                        "entry_id": "5f4f230f-e917-383c-ae63-1fc5f1c4ddf1",
                                        "glosses": [
                                            "Someone who wrangles or corrals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc453328-424a-49e3-9755-3bc2365c98b6",
                                                "sense_id": "230a29fe-954c-3c7c-b827-226a6b3e86fe",
                                                "text": "And all over Hollywood, suits are licking their chops at the prospect of more malleable actors. “She’s not going to talk back,” one top talent wrangler told me dryly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43b49651-66fb-30ea-b380-ebe1a7f46819",
                                        "entry_id": "5f4f230f-e917-383c-ae63-1fc5f1c4ddf1",
                                        "glosses": [
                                            "A brawler or disputant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af8613f2-51e7-431b-aeca-6ee686f4c071",
                                                "sense_id": "43b49651-66fb-30ea-b380-ebe1a7f46819",
                                                "text": "The Seas and Windes (old Wranglers) tooke a Truce, / And did him ſeruice; he touch'd the Ports desir'd,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d94961ed-fad9-3679-ad8e-72882f51546d",
                                        "entry_id": "5f4f230f-e917-383c-ae63-1fc5f1c4ddf1",
                                        "glosses": [
                                            "A cowboy who takes care of saddle horses."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f88b448a-fd9f-4349-9bd8-5d286f3a1d3e",
                                                "sense_id": "d94961ed-fad9-3679-ad8e-72882f51546d",
                                                "text": "Even as I stretched my arms and shivered a little, the two wranglers threw down their tin plates with a clatter, mounted horses and rode away in the direction of the thousand acres or so known as the pasture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f2c177-fe29-3ae8-8920-05521b01cc6f",
                                        "entry_id": "5f4f230f-e917-383c-ae63-1fc5f1c4ddf1",
                                        "glosses": [
                                            "A cowboy who takes care of tourists."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a969019b-15e2-3bc5-aa08-9b26ad67e69f",
                                        "entry_id": "5f4f230f-e917-383c-ae63-1fc5f1c4ddf1",
                                        "glosses": [
                                            "An animal handler or trainer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7be83ec0-50da-3fdf-8d29-71cbea113327",
                                        "entry_id": "5f4f230f-e917-383c-ae63-1fc5f1c4ddf1",
                                        "glosses": [
                                            "A student who has completed the third year of the mathematical tripos with first-class honours."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1951059-84de-40a5-aaf2-4d7fa5c625f2",
                                                "sense_id": "7be83ec0-50da-3fdf-8d29-71cbea113327",
                                                "text": "During all this excursion, she condescended to say civil things to him: she quoted Italian and French poetry to the poor bewildered lad, and persisted that he was a fine scholar, and was perfectly sure he would gain a gold medal, and be a Senior Wrangler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74de6efb-c2d6-3ef6-b094-af5452bbbba1",
                                        "entry_id": "5f4f230f-e917-383c-ae63-1fc5f1c4ddf1",
                                        "glosses": [
                                            "A special education teacher."
                                        ],
