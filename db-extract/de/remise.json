                                        "entry_id": "f005ff35-5391-3797-afe4-f700c84eb3ce",
                                        "glosses": [
                                            "A house for covered carriages; a chaise house."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5977ec7b-5aa7-4a80-ac19-cd0a04def28a",
                                                "sense_id": "f86a7c27-e9f2-3ba9-b52e-2cf0e5e809fd",
                                                "text": "long before we had got to the door of the remise, Fancy had finished the whole head"
                                            },
                                            {
                                                "example_id": "30201940-ac8e-44df-bf40-e8c2d595a117",
                                                "sense_id": "f86a7c27-e9f2-3ba9-b52e-2cf0e5e809fd",
                                                "text": "[T]his technique implied the existence of garages specializing in \"stage-automobile\" operations, but I never could discover the remises he used […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d2cb33d-11a6-31ff-b93a-d75b7315937e",
                                        "entry_id": "f005ff35-5391-3797-afe4-f700c84eb3ce",
                                        "glosses": [
                                            "A hired livery carriage of a kind superior to an ordinary fiacre; so called because kept in a remise."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c5855c6-a4d4-4693-a4a3-9fb4ca5590e3",
                                                "sense_id": "3d2cb33d-11a6-31ff-b93a-d75b7315937e",
                                                "text": "[H]e actually departed from Paris with two or three gentlemen of his acquaintance, who had hired a Remise for a jaunt to Versailles; and having accompanied them as far as the village of Passé, returned in the dusk of the evening on foot."
                                            }
                                        ]
                                    },
