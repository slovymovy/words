            {
                "entry_id": "83a7fd3d-7a32-3236-9827-931267bc3428",
                "word": "Pantagruelian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "31232058-00b0-44fd-abe3-b36b21d260f2",
                        "entry_id": "83a7fd3d-7a32-3236-9827-931267bc3428",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more Pantagruelian"
                    },
                    {
                        "form_id": "705dcea7-83d9-40a7-b6ff-aeb7335f25e1",
                        "entry_id": "83a7fd3d-7a32-3236-9827-931267bc3428",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Pantagruelian"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d22526d-876a-3acb-8a70-1ee842331a80",
                        "entry_id": "83a7fd3d-7a32-3236-9827-931267bc3428",
                        "glosses": [
                            "Alternative letter-case form of pantagruelian."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a2e2cee8-919c-4160-b4ec-eb825e5d2309",
                                "sense_id": "9d22526d-876a-3acb-8a70-1ee842331a80",
                                "text": "Giant pheasants and thrushes, crisply roasted and garnished with rich sauces, a huge vat of potage de légumes, a tub of salade Niçoise, a side of bifteck drenched in gravy. This Pantagruelian feast, the doctor surmised, was a reflection of the frustration M. Testevin faced from the restrictions placed on his diet over the past years because of his liver condition."
                            },
                            {
                                "example_id": "fcad4e4b-f669-44ec-b134-e10e0dfe4222",
                                "sense_id": "9d22526d-876a-3acb-8a70-1ee842331a80",
                                "text": "What still remains a mystery is how she managed to put away the entire midday meal that I had left for her, Ted, and Bill. And that this Pantagruelian triple lunch in no way diminished the gusto with which she silently tucked into her dinner, doing more than justice to sundry delectable coals of fire contributed by Margot."
                            },
                            {
                                "example_id": "8ec32ece-9cab-4979-8414-73a0a49bd00c",
                                "sense_id": "9d22526d-876a-3acb-8a70-1ee842331a80",
                                "text": "[H]e espied a heavily built woman waddling towards him eating a large meat pie. She looked like an earthy peasant from a Brueghel painting. / […] ‘I wonder if you could direct me to the Vice-Principal’s office.’ / ‘Yis, I can,’ she said, gravy running down her chin. […] / ‘Thanks,’ he said, wondering who this Pantagruelian lady might be."
                            },
                            {
                                "example_id": "22b178ba-15d6-45ab-baaf-e0325991296f",
                                "sense_id": "9d22526d-876a-3acb-8a70-1ee842331a80",
                                "text": "Indeed, including the wines, liqueurs, coffee, tips, service charges and various taxes, this Pantagruelian feast which must have provided pleasant memories for the guests, cost us . . . a little less than two Swiss francs per person!"
                            },
                            {
                                "example_id": "80d1c447-501c-41a3-92b7-8e78154f0595",
                                "sense_id": "9d22526d-876a-3acb-8a70-1ee842331a80",
                                "text": "The soldier, however, indicated that I should begin eating, and after checking with my parents one last time, I sat down and dug into this Pantagruelian feast."
                            }
                        ]
                    }
