                    {
                        "translation_id": "cff04651-525b-4b87-b2ef-853968bcf2be",
                        "source_entry_id": "3a8c7dd2-2982-3f6c-9dc0-ecb3900834a2",
                        "source_sense_id": "1d6b0a63-24aa-3c2d-af78-38e3142b4838",
