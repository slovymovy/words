            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9d03ff8-b2b3-3c45-a427-1983a84a3acc",
                    "sense_definition": "ребёнок или подросток мужского пола",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Маленький <w>мальчик</w> играет в песочнице с машинками.",
                            "target_lang_translations": {
                                "en": "A little <w>boy</w> is playing in the sandbox with toy cars.",
                                "de": "Ein kleiner <w>Junge</w> spielt mit Spielzeugautos im Sandkasten.",
                                "pl": "Mały <w>chłopiec</w> bawi się w piaskownicy autkami.",
                                "fr": "Un petit <w>garçon</w> joue dans le bac à sable avec des petites voitures."
                            }
                        },
                        {
                            "text": "Все <w>мальчики</w> в классе любят играть в футбол.",
                            "target_lang_translations": {
                                "en": "All the <w>boys</w> in the class love to play soccer.",
                                "de": "Alle <w>Jungen</w> in der Klasse spielen gerne Fußball.",
                                "pl": "Wszyscy <w>chłopcy</w> w klasie lubią grać w piłkę nożną.",
                                "fr": "Tous les <w>garçons</w> de la classe aiment jouer au football."
                            }
                        }
                    ],
                    "synonyms": [
                        "парень",
                        "мальчишка"
                    ],
                    "antonyms": [
                        "девочка"
                    ],
                    "common_phrases": [
                        "маленький мальчик"
                    ],
                    "target_lang_definitions": {
                        "en": "A male child or adolescent.",
                        "de": "Ein männliches Kind oder Jugendlicher.",
                        "pl": "Dziecko lub nastolatek płci męskiej.",
                        "fr": "Enfant ou adolescent de sexe masculin."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boy",
                                "target_lang_sense_clarification": "A male child."
                            }
                        ],
