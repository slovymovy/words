                "senses": [
                    {
                        "sense_id": "b2798fb5-8af2-3278-9cec-4b70ce7f766e",
                        "entry_id": "e85c998c-d941-3823-85ee-ae1c1cff7c5a",
                        "glosses": [
                            "Wäsche, die getragen oder sonst wie verwendet und dabei verschmutzt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5a75fd1-cd0b-4795-a627-af96a6599f5c",
                                "sense_id": "b2798fb5-8af2-3278-9cec-4b70ce7f766e",
                                "text": "„Als ich einen Armvoll Schmutzwäsche nach unten bringen sollte, war in der Waschküche ein Feuersalamander, gelb und schwarz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fd2ab3e-4588-4783-9a02-e5927e3b2273",
                        "source_entry_id": "e85c998c-d941-3823-85ee-ae1c1cff7c5a",
                        "source_sense_id": "b2798fb5-8af2-3278-9cec-4b70ce7f766e",
                        "source_sense_description": "Wäsche, die getragen oder sonst wie verwendet und dabei verschmutzt wurde",
                        "target_lang_word": "linge sale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linge sale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1022235f-1269-3b9d-90a0-de05c2074ab8",
                                        "entry_id": "f14ba577-ef9a-3b1c-953c-c8ed7db42b05",
                                        "glosses": [
                                            "Affaires privées et confidentielles qui ne sont pas destinées à être dévoilées en public."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4a99e64-b55f-49be-b9c5-86757e86bbbb",
                                                "sense_id": "1022235f-1269-3b9d-90a0-de05c2074ab8",
                                                "text": "Elle fut accusée d’être brutale, commune, dénuée de goût, de vouloir importer sur le théâtre des habitudes d’outre-Rhin et d’outre-Pyrénées, des castagnettes, des éperons, des talons de bottes, — sans compter qu’elle buvait comme un grenadier, qu’elle aimait trop les petits chiens et la fille de sa portière, — et autres linges sales de la vie privée, qui sont la pâture et la friandise journalière de certains petits journaux."
                                            },
                                            {
                                                "example_id": "c448a3a6-e695-4e10-a241-a1c33a6afeaf",
                                                "sense_id": "1022235f-1269-3b9d-90a0-de05c2074ab8",
                                                "text": "Elle en gardait une terrible rancune, elle l’aurait tué, si elle l’avait osé, chaque fois qu’elle le revoyait, plus d’aplomb sur ses jambes d’ivrogne, lui ricanant à la face, sachant bien qu’elle guettait sa mort, et triomphant de ce qu’il ne lui donnait pas le plaisir d’enterrer avec lui le linge sale ancien, le sang et la boue des deux conquêtes de Plassans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
