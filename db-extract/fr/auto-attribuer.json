                            {
                                "example_id": "053aaaf6-41f3-4b6b-b6ea-131daea87ed1",
                                "sense_id": "13f51129-4d13-3e48-a2fe-f899fe903aa4",
                                "text": "Auparavant, chacun pourra se voir invité à évaluer son propre travail de/dans le journal et à s'auto-attribuer la note qu'il jugera avoir mérité à ses propres yeux, en la justifiant."
                            },
