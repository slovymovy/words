    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "72239dd1-e94a-381e-8d77-4a8f910d8e4c",
                "word": "amazed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "825eeb73-95c1-4c99-ba95-973975330c6a",
                        "entry_id": "72239dd1-e94a-381e-8d77-4a8f910d8e4c",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more amazed"
                    },
                    {
                        "form_id": "876b39c3-9c8c-471a-8757-4c1614750b51",
                        "entry_id": "72239dd1-e94a-381e-8d77-4a8f910d8e4c",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most amazed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28cd33d2-9e5a-30e5-91e3-9da6d227c5bd",
                        "entry_id": "72239dd1-e94a-381e-8d77-4a8f910d8e4c",
                        "glosses": [
                            "Astonished or confounded with fear, surprise, or wonder; greatly surprised (often with ensuing adpositions e.g. at, with, or by)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c385882c-200a-4a24-8b23-85cc11ebca93",
                                "sense_id": "28cd33d2-9e5a-30e5-91e3-9da6d227c5bd",
                                "text": "I am amazed at your passionate words"
                            },
                            {
                                "example_id": "4a434ff8-7006-451b-ac39-86366cc479e6",
                                "sense_id": "28cd33d2-9e5a-30e5-91e3-9da6d227c5bd",
                                "text": "I am amazed with matter"
                            },
                            {
                                "example_id": "8c0b5193-318d-4c36-bad7-09ed4db9ff6f",
                                "sense_id": "28cd33d2-9e5a-30e5-91e3-9da6d227c5bd",
                                "text": "1917, Frederic Harrison, The Mill on the Floss. Vol. IX. Harvard Classics Shelf of Fiction\nwe are amazed by forked flashes of wisdom"
                            },
                            {
                                "example_id": "8d9aa462-ef02-4be4-87fd-e826bc48dbfa",
                                "sense_id": "28cd33d2-9e5a-30e5-91e3-9da6d227c5bd",
                                "text": "And it was while all were passionately intent upon the pleasing and snake-like progress of their uncle that a young girl in furs, ascending the stairs two at a time, peeped perfunctorily into the nursery as she passed the hallway—and halted amazed."
                            },
                            {
                                "example_id": "92fc10c6-c433-47ee-a6c6-fc5440d3d854",
                                "sense_id": "28cd33d2-9e5a-30e5-91e3-9da6d227c5bd",
                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57f2ffa0-b84b-4e48-976b-b0d2eac07e7c",
                        "source_entry_id": "72239dd1-e94a-381e-8d77-4a8f910d8e4c",
                        "source_sense_id": "28cd33d2-9e5a-30e5-91e3-9da6d227c5bd",
                        "source_sense_description": "astonished; confounded with fear, surprise or wonder",
                        "target_lang_word": "stupéfié",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupéfié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11f64cc0-1600-36de-b840-c37296c64b7e",
                                        "entry_id": "d1c16474-2f2e-3eb2-a4f3-0e65a1e173ec",
                                        "glosses": [
                                            "Être pétrifié ou engourdi par la stupeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4563963a-4cd0-4533-aa15-73bc21a28c60",
                                                "sense_id": "11f64cc0-1600-36de-b840-c37296c64b7e",
                                                "text": "C’était ma première traversée véritable ; c’était aussi ma première rencontre, stupéfiée plutôt qu’horrifiée (l’adjectif est trop fort pour mes émotions encore superficielles et mal dégrossies), avec les misérables séquelles de la guerre."
                                            },
                                            {
                                                "example_id": "490b7634-162e-450a-a534-8cf4f5765ab4",
                                                "sense_id": "11f64cc0-1600-36de-b840-c37296c64b7e",
                                                "text": "Stupéfié, Morange se rapprocha insensiblement. On aurait dit qu’une bête sauvage aux griffes démesurées lui avait lacéré la peau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbe3318e-69aa-334b-85de-3aaf223ef23b",
                                        "entry_id": "d1c16474-2f2e-3eb2-a4f3-0e65a1e173ec",
                                        "glosses": [
                                            "Extrêmement surpris."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stupéfié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f9bf2b7-e17a-3907-99f7-a8e9309c3644",
                                        "entry_id": "69578ee2-6eb7-3bcc-bede-af988f64819f",
                                        "glosses": [
                                            "Participe passé masculin singulier de stupéfier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12ab8380-f53d-42ec-b27d-e65dfd348812",
                                                "sense_id": "5f9bf2b7-e17a-3907-99f7-a8e9309c3644",
                                                "text": "Je suis stupéfié par l’adresse des télétypistes locaux qui recopient sur une bande le texte polonais sans aucune faute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60fdacbf-75d5-4a5b-ab68-0486fe6b77cf",
                        "source_entry_id": "72239dd1-e94a-381e-8d77-4a8f910d8e4c",
                        "source_sense_id": "28cd33d2-9e5a-30e5-91e3-9da6d227c5bd",
                        "source_sense_description": "astonished; confounded with fear, surprise or wonder",
                        "target_lang_word": "abasourdi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abasourdi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "082e250b-e839-3d19-83a8-0a4fcd8ad2f3",
                                        "entry_id": "70f02f8e-f7c5-3b33-ae81-be3d2ee72d80",
                                        "glosses": [
                                            "Extrêmement surpris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "057357e4-784b-4b22-8eb9-62f023c5304f",
                                                "sense_id": "082e250b-e839-3d19-83a8-0a4fcd8ad2f3",
                                                "text": "À cette audace inattendue dans un homme ordinairement si craintif, je les vis l’un et l’autre atterrés, abasourdis, ne répondant pas un mot ; […]"
                                            },
                                            {
                                                "example_id": "9d4d8794-f313-493c-8ac0-834d480af0fd",
                                                "sense_id": "082e250b-e839-3d19-83a8-0a4fcd8ad2f3",
                                                "text": "Dès le seuil, nous fûmes parfaitement abasourdis par un terrible vacarme de battoirs, de cris, de rires et de vapeur sifllante."
                                            },
                                            {
                                                "example_id": "59412e86-4a03-43a8-936c-8623f9b791b5",
                                                "sense_id": "082e250b-e839-3d19-83a8-0a4fcd8ad2f3",
                                                "text": "Par contre, il a fait une déclaration-choc qui m’a laissée « abasourdie », telle Mélanie Joly devant les propos d’Emmanuella Lambropoulos."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abasourdi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
