                    },
                    {
                        "translation_id": "8ae0c70d-58cc-448b-9851-7aecf0b2a94c",
                        "source_entry_id": "476eb0e8-0823-31aa-b053-5713c802825e",
                        "source_sense_id": "d9b5cd7c-b50d-3166-9b5b-177aef90f6e6",
