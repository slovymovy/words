                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36ac701d-066b-43a5-ba25-11c05c9448b7",
                                                "sense_id": "2a920d8b-aa27-3830-aee4-39cebb9ae3d6",
                                                "text": "„Bereits Robert Fludd hatte den Zusammenhang von Mikrokosmos und Makrokosmos gelehrt.“"
                                            }
