                    {
                        "translation_id": "86f2c4a4-1ca5-455c-8bb8-0c0fd82646c6",
                        "source_entry_id": "7522b376-9fb0-3202-8767-a399085bb526",
                        "source_sense_id": "3b00a97f-9975-3c21-9fa1-3639937f7395",
                        "target_lang_word": "Parmesan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parmesan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "739fc6d9-8080-3408-88ea-9f04bc925c9e",
                                        "entry_id": "007db17f-7129-36c4-8460-1523b0e98181",
                                        "glosses": [
                                            "ein italienischer Hartkäse aus Kuhmilch"
                                        ],
                                        "tags": [
                                            "italienische Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1df4219-5919-4e18-93df-2e93634dcb1b",
                                                "sense_id": "739fc6d9-8080-3408-88ea-9f04bc925c9e",
                                                "text": "Der Parmesan sollte klein gerieben sein."
                                            },
                                            {
                                                "example_id": "cb36629b-16c8-4fa4-96fb-a1aba2027e61",
                                                "sense_id": "739fc6d9-8080-3408-88ea-9f04bc925c9e",
                                                "text": "„Manchmal isst er seine Zucchini auch roh als Salat: mit einem Dressing aus Olivenöl und Zitrone, darüber geriebenen Parmesan und geröstete Pinienkerne.“"
                                            },
                                            {
                                                "example_id": "59c76239-a460-44e3-9b13-c585ccf82631",
                                                "sense_id": "739fc6d9-8080-3408-88ea-9f04bc925c9e",
                                                "text": "„Am Tag des heiligen Michael erschien Lorenzo in aller Frühe mit einem großen Kessel, in dem die Makkaroni kochten; ich stellte sogleich Butter auf ein Kohlenbecken, um sie zu schmelzen, und bereitete meine zwei Platten vor, die ich mit Parmesan bestreute, den er mir fertig gerieben gebracht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f39c493e-f207-41b0-8d86-07dfb7d8a45f",
                        "source_entry_id": "7522b376-9fb0-3202-8767-a399085bb526",
                        "source_sense_id": "3b00a97f-9975-3c21-9fa1-3639937f7395",
                        "target_lang_word": "Parmesankäse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parmesankäse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba290b6d-8b24-3012-9691-f0a66a2ade9b",
                                        "entry_id": "4ff0ab86-df72-3929-9417-06dc649fcd64",
                                        "glosses": [
                                            "ein italienischer Hartkäse aus Kuhmilch"
                                        ],
                                        "tags": [
                                            "italienische Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f4873b6-39d9-44a1-8396-4fb23068a205",
                                                "sense_id": "ba290b6d-8b24-3012-9691-f0a66a2ade9b",
                                                "text": "„[…] er […] findet am Ortseingang einen Tante-Emma-Laden. Die Dame verkauft Ravioli, etwa zum doppelten Normalpreis. Parmesankäse hat sie nicht. Vielleicht tut es auch Gouda in Scheiben.“"
                                            },
                                            {
                                                "example_id": "221761cd-9662-418d-b6c0-a61e6a8d9783",
                                                "sense_id": "ba290b6d-8b24-3012-9691-f0a66a2ade9b",
                                                "text": "„Sie legten rasch drei Gedecke auf, brachten Brot, Parmesankäse und Wasser, und unter Gelächter aßen sie und tranken mit mir den ihnen ganz ungewohnten Zyperwein, der ihnen bald in den Kopf stieg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f082e97a-385c-4daf-90ab-5af865ef6064",
