                "senses": [
                    {
                        "sense_id": "11c04854-c6e9-399f-8d4c-14e88765c320",
                        "entry_id": "773f8896-affa-3769-8424-54fdeed2526f",
                        "glosses": [
                            "To emerge from a huddle or tight group."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "27781182-e5e3-4ee1-8f4a-baf512638179",
                                "sense_id": "11c04854-c6e9-399f-8d4c-14e88765c320",
                                "text": "But hearing my voice, they would unhuddle and run toward me. We brought them inside and contemplated keeping them. But they were still bonded with their mother, so we decided to leave them to their fate outside."
                            },
                            {
                                "example_id": "9a5cfba6-f131-4f77-a527-e000136bcaff",
                                "sense_id": "11c04854-c6e9-399f-8d4c-14e88765c320",
                                "text": "When ready to share, they unhuddle. When all groups are done, call a number and ask students with that number to rotate to a new group."
                            }
                        ]
                    }
                ],
