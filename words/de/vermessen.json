    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d93e2569-6a11-351a-b4fa-5356596bfc9d",
                    "sense_definition": "Ein Gelände, ein Grundstück oder ein Objekt mit Messgeräten genau erfassen und bestimmen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Ingenieure müssen das gesamte Baugelände sorgfältig <w>vermessen</w>, bevor die Arbeiten beginnen können."
                        },
                        {
                            "text": "Vor dem Kauf des Grundstücks ließ der Eigentümer die genauen Grenzen von einem Experten <w>vermessen</w>."
                        }
                    ],
                    "synonyms": [
                        "abmessen",
                        "ausmessen"
                    ],
                    "common_phrases": [
                        "ein Grundstück vermessen",
                        "das Gelände vermessen"
                    ]
                },
                {
                    "sense_id": "2c56d5fa-5677-3b06-977c-3ce4520c5975",
                    "sense_definition": "Beim Feststellen von Maßen versehentlich einen Fehler machen (reflexiv verwendet).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement_error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Tischler hat sich um wenige Millimeter <w>vermessen</w>, weshalb das neue Regal nicht in die Nische passt."
                        },
                        {
                            "text": "Wenn man die Skala nicht richtig abliest, kann man sich bei diesem Experiment leicht <w>vermessen</w>."
                        }
                    ],
                    "common_phrases": [
                        "sich beim Messen vermessen",
                        "sich um Millimeter vermessen"
                    ]
                },
                {
                    "sense_id": "5cc18447-1f1b-3da4-be6c-ddd883a8a48b",
                    "sense_definition": "Aus Anmaßung oder Selbstüberschätzung die Grenzen des Erlaubten oder Schicklichen überschreiten (reflexiv verwendet).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "presumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand am Hofe <w>vermaß</w> sich, die strenge Entscheidung des Königs offen infrage zu stellen."
                        },
                        {
                            "text": "Er <w>vermaß</w> sich zu behaupten, dass er die schwierige Aufgabe ohne jegliche Hilfe lösen könne."
                        }
                    ],
                    "common_phrases": [
                        "sich vermessen etwas zu tun"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "gehoben bis veraltend"
                        }
                    ],
                    "synonyms": [
                        "sich anmaßen"
                    ]
                }
            ]
        },
        {
