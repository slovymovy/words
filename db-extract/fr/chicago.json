        "fr-extract.jsonl": [
            {
                "entry_id": "1a7cb224-b823-34ee-94fa-875455db107f",
                "word": "Chicago",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "62df6223-e58b-32ae-9603-00827bddde04",
                        "entry_id": "1a7cb224-b823-34ee-94fa-875455db107f",
                        "glosses": [
                            "Grande ville de l’Illinois (États-Unis d’Amérique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e38f6a7-106b-4f1b-aa32-cbe49763ac51",
                                "sense_id": "62df6223-e58b-32ae-9603-00827bddde04",
                                "text": "L'étranger n'est pas resté insensible aux malheurs de nos populations : Chicago a adopté Reims ; Glasgow, Guivry et Martinpuich ; un journal de New-York, le Delincator, Landres-et-Saint-Georges des Ardennes ; M. et Mme Houston, de Philadelphie, Arcis-le-Ponsart ; une Société de Toronto (Canada), Vimy ; […]."
                            },
                            {
                                "example_id": "6ef549bf-a9f6-44bc-816f-cd9905f5832f",
                                "sense_id": "62df6223-e58b-32ae-9603-00827bddde04",
                                "text": "Le manufacturier québécois pourrait fournir jusqu'à 600 autobus à la ville de Chicago et à ses banlieues au cours des prochaines années."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dfc8324-f3f1-4888-95a5-c459fa3f107f",
                        "source_entry_id": "1a7cb224-b823-34ee-94fa-875455db107f",
                        "source_sense_id": "62df6223-e58b-32ae-9603-00827bddde04",
                        "target_lang_word": "Chicago",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chicago",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                        "entry_id": "02695c99-b3e7-33e0-84bd-c41e46a47d5b",
                                        "glosses": [
                                            "drittgrößte Stadt in den Vereinigten Staaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd152014-b97a-4e32-9d55-77e041ef3276",
                                                "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                                "text": "Chicago liegt am Südwestufer des Michigansees."
                                            },
                                            {
                                                "example_id": "e2d3f6a5-9a81-4afb-84ba-461f42aa5eac",
                                                "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                                "text": "Chicago liegt im US-Bundesstaat Illinois."
                                            },
                                            {
                                                "example_id": "16f5d331-c6ff-4132-8e5a-a0204d9ed430",
                                                "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                                "text": "Chicago hat 77 Stadtbezirke."
                                            },
                                            {
                                                "example_id": "73b71b98-04c0-4370-a9c5-6b73afdbf6b7",
                                                "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                                "text": "„Als habe jemand einen Schalter umgelegt, war es wieder da, das Charisma, das er schon in Chicago ausgestrahlt hatte.“"
                                            },
                                            {
                                                "example_id": "cf224ee7-fa87-48c6-a030-721d60abd9f8",
                                                "sense_id": "c39e4d08-d39f-3608-ab53-8aa943afd2f6",
                                                "text": "„Ein bespielbares Stadion war in Chicago und Umgebung nicht zu finden, aber Halas hatte die rettende Idee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8af20676-3d5d-48b0-ad10-189dfe950cd1",
                        "source_entry_id": "1a7cb224-b823-34ee-94fa-875455db107f",
                        "source_sense_id": "62df6223-e58b-32ae-9603-00827bddde04",
                        "target_lang_word": "Chicago",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chicago",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22331d6f-132b-335c-86b4-a009abb53312",
                                        "entry_id": "6c6ce34a-03b2-3b9b-8f3c-af23e356dd24",
                                        "glosses": [
                                            "A large city, the county seat of Cook County, in northeastern Illinois, United States, located on Lake Michigan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f03761-8f65-4043-89e7-e43a84280e29",
                                                "sense_id": "22331d6f-132b-335c-86b4-a009abb53312",
                                                "text": "I am an American, Chicago born—Chicago, that somber city—and go at things as I have taught myself, free-style, and will make the record in my own way: first to knock, first admitted; sometimes an innocent knock, sometimes a not so innocent."
                                            },
                                            {
                                                "example_id": "13fbf256-acdb-45a2-b6fd-a2e3d734d937",
                                                "sense_id": "22331d6f-132b-335c-86b4-a009abb53312",
                                                "text": "Chicago is now #1 in murder and sausages. That sounds like my kind of town!"
                                            },
                                            {
                                                "example_id": "c5c3bfc7-186e-42fa-8a63-4a53c8a6d1b3",
                                                "sense_id": "22331d6f-132b-335c-86b4-a009abb53312",
                                                "text": "Homan, who was on the ground in Chicago, maintained it was a “criminal operation.” Acting Deputy Attorney General Emil Bove was also in Chicago on Sunday to observe immigration enforcement operations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
