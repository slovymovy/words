                "entry_id": "5ca084c7-c552-3e9c-ab52-cfd1a7537955",
                "word": "pudibond",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2bcb9cbe-ca66-4f1d-9794-193de24233b7",
                        "entry_id": "5ca084c7-c552-3e9c-ab52-cfd1a7537955",
