                "senses": [
                    {
                        "sense_id": "340e6aa4-dbca-3358-bf35-f2743900d13b",
                        "entry_id": "6064eff9-772b-3da1-a9f5-eac5a76c695f",
                        "glosses": [
                            "Phase, in der das Metall Lithium stark nachgefragt und viel davon abgebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac3d2491-a94f-4cc9-b8f4-ec3180f17807",
                                "sense_id": "340e6aa4-dbca-3358-bf35-f2743900d13b",
                                "text": "„Auch die argentinische Zentralregierung sieht im Lithiumboom den wirtschaftlichen Segen.“"
                            },
                            {
                                "example_id": "24c0c641-0b2c-4a22-835a-572c6ff8069c",
                                "sense_id": "340e6aa4-dbca-3358-bf35-f2743900d13b",
                                "text": "„Das Dreiländereck Argentinien-Chile-Bolivien, das weit über die Hälfte der weltweit bekannten Vorkommen beherbergt, könnte also vor einem großen Lithiumboom stehen.“"
                            },
                            {
                                "example_id": "abff6bc5-2701-4a08-b48c-c9de8ecb68a2",
                                "sense_id": "340e6aa4-dbca-3358-bf35-f2743900d13b",
                                "text": "„Doch wegen des derzeitigen Lithiumbooms hat der chilenische Staat Anfang 2018 eine Verdreifachung der Fördermengen ge- nehmigt, sehr zum Ärger der umliegenden Gemeinden […].“"
                            },
                            {
                                "example_id": "210280d7-d8ac-4274-b069-c9a546373b60",
                                "sense_id": "340e6aa4-dbca-3358-bf35-f2743900d13b",
                                "text": "„Ein Durchbruch in der Elektromobilität würde wahrscheinlich zu einem Lithiumboom führen, auf den sich die Börsen weltweit bereits einstellen.“"
                            },
                            {
                                "example_id": "eaebf91c-b44f-4563-9f57-0c285d6c7f37",
                                "sense_id": "340e6aa4-dbca-3358-bf35-f2743900d13b",
                                "text": "„Jetzt fördert Reed den Rohstoff in großem Stil. Denn keiner weiß, wie lange der Lithiumboom anhält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
