                ],
                "translations": [
                    {
                        "translation_id": "5db9d5ed-9492-4464-80df-e1b255317b4b",
                        "source_entry_id": "da0d70cc-8797-3dc7-b719-0f3722b7c89c",
                        "source_sense_description": "used to express assent, especially to a superior",
                        "target_lang_word": "jawel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jawel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f549776d-b06e-3b3c-9bf1-476f15d61b22",
                                        "entry_id": "0b863bbe-8c4e-3c1b-9627-7df2d2215550",
                                        "glosses": [
                                            "ja, antwoordend op een ontkennende vraag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c5b5396-2af4-405b-bbe2-7d368adf385b",
                                                "sense_id": "f549776d-b06e-3b3c-9bf1-476f15d61b22",
                                                "text": "Kom je niet mee vanavond? Jawel, ik kom."
                                            },
                                            {
                                                "example_id": "5f0c4bf9-5d84-41a9-ae99-54e7b917be14",
                                                "sense_id": "f549776d-b06e-3b3c-9bf1-476f15d61b22",
                                                "text": "Maar wat was hij van plan? Ik bracht mijn vinger naar de trekker en bewoog mijn geweer 'O, jawel."
                                            },
                                            {
                                                "example_id": "7b2da859-bddc-4b9e-aa21-eb16ee88a636",
                                                "sense_id": "f549776d-b06e-3b3c-9bf1-476f15d61b22",
                                                "text": "'Pardon?' 'Moeten wij niet met respect behandeld worden?' 'O jawel, natuurlijk jullie ook,' haast hij zich te zeggen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c561ae4d-f83c-4ad8-829f-f9b9d6953f3b",
                        "source_entry_id": "da0d70cc-8797-3dc7-b719-0f3722b7c89c",
                        "source_sense_description": "used to express assent, especially to a superior",
                        "target_lang_word": "oui monsieur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bf661150-fcb4-4042-a60a-5306a1d0fd91",
                        "source_entry_id": "da0d70cc-8797-3dc7-b719-0f3722b7c89c",
                        "source_sense_description": "used to express assent, especially to a superior",
                        "target_lang_word": "jawohl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jawohl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                        "entry_id": "c0ca7df8-de46-3bca-8be4-e3bc5725239e",
                                        "glosses": [
                                            "gibt eine positive Antwort auf eine Entscheidungsfrage; drückt Bekräftigung, Zustimmung aus"
                                        ],
                                        "tags": [
                                            "verstärkend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5468581f-8a42-46c4-a579-4359122ff07d",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "Jawohl, Herr Major!"
                                            },
                                            {
                                                "example_id": "23e520e0-e9d0-4038-91b6-2c1bd28a6dfd",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Krämer, von Reineboth im Rücken angesprochen, drehte sich zu diesem um, antwortete: «Jawohl.»“"
                                            },
                                            {
                                                "example_id": "35cd9598-2f84-4535-a817-717364ccce1d",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Ich hielt sie am Arm, die junge Person, die meine Tochter hätte sein können, beziehungsweise am Handgelenk; ich sagte ihr (natürlich zum Spaß!) mit erhobenem Finger, sie habe mich zu diesem Flug gezwungen, jawohl, niemand anders als sie - sie sagte: ‚there is no danger, Sir, no danger at all. We’re going to land in Mexico-City in about one hour and twenty minutes‘.“"
                                            },
                                            {
                                                "example_id": "43e4710a-9bb7-4e63-8245-cae66801ca30",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Jawohl war die Trennung bis zum November abgemacht; sie selbst hatte darauf bestanden, damit auch sie Opfer vorzuweisen hatte.“"
                                            },
                                            {
                                                "example_id": "affae6e1-68ba-4f40-82ea-6737909470ac",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Jawohl, ihr habt recht gehört, die Großtante raucht; sie raucht eine für eine Heilige ziemlich unheilige Baumelpfeife mit geschnitztem Holzkopf.“"
                                            },
                                            {
                                                "example_id": "c9e2e381-c907-4b37-b5f8-715a2becb7cc",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Stieß man ihn so hinaus, hatte auch er keinerlei Verpflichtung, er konnte sich fallenlassen, wohin er wollte, jawohl, und die sollten seinen Stürzen noch einmal schaudernd zuschauen, dann würden sie es vielleicht bereuen, ihn nicht aufgenommen zu haben.“"
                                            },
                                            {
                                                "example_id": "0af68453-1b46-493e-9780-246b06f0cafb",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Hatte sie recht? Jawohl, es kommt vor, daß Blinddarmentzündungen durch Fremdkörper hervorgerufen werden, die sich im Appendix festgesetzt haben.“"
                                            },
                                            {
                                                "example_id": "d4a8b553-e11a-4568-8398-8139b0e13977",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Jawohl bin ich ungerecht.“"
                                            },
                                            {
                                                "example_id": "5ce5d60d-9f62-4e51-ab9f-c3566dea7c55",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Kann ein US-Magazin in Australien für Verleumdung verurteilt werden, wenn es auf seiner Webseite Unwahrheiten über einen Australier verbreitet? Jawohl, entschied jetzt der oberste australische Gerichtshof.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ffc8d5b-757e-4cf6-b8ad-dcd72dc0d814",
                        "source_entry_id": "da0d70cc-8797-3dc7-b719-0f3722b7c89c",
