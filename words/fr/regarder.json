{
    "word_family": [
        "regard"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a6d7e1c-bc65-3a0b-9073-f1a6f9bb959b",
                    "sense_definition": "Porter la vue sur quelqu'un ou quelque chose avec attention ; fixer des yeux un spectacle ou un écran.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants s'assoient sur le canapé pour <w>regarder</w> un dessin animé."
                        },
                        {
                            "text": "Il s'arrête un instant afin de <w>regarder</w> par la fenêtre du train."
                        }
                    ],
                    "synonyms": [
                        "jeter un coup d'œil",
                        "jeter un œil",
                        "poser les yeux"
                    ],
                    "common_phrases": [
                        "regarder par la fenêtre",
                        "regarder la télévision"
                    ]
                },
                {
                    "sense_id": "08ef95a9-37b5-36c4-ab73-867596290e09",
                    "sense_definition": "Contempler sa propre image dans un miroir ou une surface réfléchissante.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle passe de longues minutes à se <w>regarder</w> dans la glace avant de sortir."
                        },
                        {
                            "text": "Le jeune homme se <w>regarde</w> attentivement dans la vitre du magasin."
                        }
                    ],
                    "common_phrases": [
                        "se regarder dans la glace",
                        "se regarder dans un miroir"
                    ]
                },
                {
                    "sense_id": "1ac2add4-5826-36d7-996e-9679e1a55caa",
                    "sense_definition": "S'observer l'un l'autre, échanger des regards mutuels.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux amis se <w>regardent</w> en souriant avant d'entrer dans la salle."
                        },
                        {
                            "text": "Pendant toute la réunion, ils se sont <w>regardés</w> sans dire un seul mot."
                        }
                    ],
                    "common_phrases": [
                        "se regarder dans les yeux"
                    ]
                },
                {
                    "sense_id": "e6dc2ff9-f72e-3002-b515-06ca56584334",
                    "sense_definition": "Être l'affaire de quelqu'un, le concerner directement ou lui importer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce choix personnel et délicat ne <w>regarde</w> personne d'autre dans cette famille."
                        },
                        {
                            "text": "Ce qui se passe dans ma vie privée ne vous <w>regarde</w> absolument pas."
                        }
                    ],
                    "synonyms": [
                        "concerner"
                    ],
                    "common_phrases": [
                        "ne regarder personne",
                        "ne regarder en rien"
                    ]
                },
                {
                    "sense_id": "52fdf958-1a3d-34ea-b222-7a52bf21c03a",
                    "sense_definition": "Être tourné vers, donner sur, en parlant d'un bâtiment ou d'une ouverture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La terrasse de notre appartement <w>regarde</w> vers le sud et reçoit du soleil."
                        },
                        {
                            "text": "Toutes les grandes fenêtres de la villa <w>regardent</w> la mer et la plage."
                        }
                    ],
                    "common_phrases": [
                        "regarder vers le sud",
                        "regarder la mer"
                    ]
                },
                {
                    "sense_id": "0fe3712d-eb12-3661-b0b3-c323f6b4645d",
                    "sense_definition": "Considérer, estimer ou juger quelqu'un ou quelque chose d'une certaine façon.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a tendance à <w>regarder</w> cet employé comme son successeur logique."
                        },
                        {
                            "text": "Ils ont fini par <w>regarder</w> ce changement comme une opportunité très favorable."
                        }
                    ],
                    "common_phrases": [
                        "regarder comme un ami"
                    ]
                },
                {
                    "sense_id": "70e739a4-5b2e-3bbc-ba3e-6ecc7682f0bd",
                    "sense_definition": "Prendre garde, faire attention à quelque chose, en particulier aux dépenses ou aux détails.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour organiser cette grande fête, ils n'ont pas hésité à ne pas <w>regarder</w> à la dépense."
                        },
                        {
                            "text": "Quand il s'agit d'aider ses enfants, il ne <w>regarde</w> jamais aux frais engagés."
                        }
                    ],
                    "common_phrases": [
                        "ne pas regarder à la dépense",
                        "regarder au prix"
                    ]
                }
            ]
        }
    ]
}