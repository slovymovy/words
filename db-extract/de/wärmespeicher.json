                "senses": [
                    {
                        "sense_id": "4cce0cfb-4e6c-3997-9f9a-f781fef4ddf2",
                        "entry_id": "5eb8062e-235d-3907-84fb-1028d3f97cc7",
                        "glosses": [
                            "natürlicher oder künstlich angelegter Speicher, der Wärmeenergie speichert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ad3a52-3230-4d9f-8bf4-b17785f46055",
                                "sense_id": "4cce0cfb-4e6c-3997-9f9a-f781fef4ddf2",
                                "text": "„Diese Wärme wird dem Erdreich wieder zugeführt, der Wärmespeicher also wieder aufgefüllt; diese Speicherregeneration soll einen langlebigen Rhythmus aus Wärmenutzung und Wärmewiedergewinnung ermöglichen.“"
                            },
                            {
                                "example_id": "24ffebe1-3ee8-4f4d-b1e6-10df95bc6a1a",
                                "sense_id": "4cce0cfb-4e6c-3997-9f9a-f781fef4ddf2",
                                "text": "„Sie ist die weltweit erste und einzige Versuchsanlage für ein Druckluftspeicherkraftwerk mit Wärmespeicher in einer Felskaverne.“"
                            }
                        ],
