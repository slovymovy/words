                                "target_senses": [
                                    {
                                        "sense_id": "97307198-1fd4-3d0a-8ffb-c394d4686c8c",
                                        "entry_id": "66ec0797-9b5c-368e-89fe-5e621af29b6d",
                                        "glosses": [
                                            "кулин. кушанье, приготовленное из мелко нарезанного тушёного мяса с овощами или из тушёных овощей с острым соусом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd39a9d-86a8-4010-bca0-945199f9a76f",
                                                "sense_id": "97307198-1fd4-3d0a-8ffb-c394d4686c8c",
                                                "text": "Чтоб сделать рагу из зайца, надо прежде всего зайца."
                                            },
                                            {
                                                "example_id": "59cb4851-18b8-4ab0-a125-a7bb5fdb5504",
                                                "sense_id": "97307198-1fd4-3d0a-8ffb-c394d4686c8c",
                                                "text": "Стол — смесь английского с французским: зелень, например, вся приготовлена по-французски, а мясо и рыба поданы по-английски, неразрезанными; к ним особо опять французские рагу, тут же и сои, пикули."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "рагу",
                                "target_lang_code": "ru",
