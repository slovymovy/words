                                        "sense_id": "99480cc9-047b-3e4f-99af-21bbf5f03b1c",
                                        "entry_id": "171c4feb-11bd-34b5-a127-5aa4172ffb2b",
                                        "glosses": [
                                            "(généralement au pluriel) Enfant d’environ 9 ou 10 ans inscrit dans un club de sport (les limites d’âge variant d’un sport à l’autre)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97999afe-5175-4687-bf1f-9498f08d691f",
                                                "sense_id": "99480cc9-047b-3e4f-99af-21bbf5f03b1c",
                                                "text": "Béziers fait jouer 500 gosses tous les ans dans les tournois de poussins de rugby à sept et en fait des champions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4875eba-3602-3fa9-b54d-e721edc03e91",
                                        "entry_id": "171c4feb-11bd-34b5-a127-5aa4172ffb2b",
                                        "glosses": [
                                            "(équivalent féminin éventuel : poussine) Nom donné à une personne que l’on aime, notamment un enfant."
                                        ],
                                        "tags": [
                                            "Affectueux"
                                        ],
                                        "examples": [
