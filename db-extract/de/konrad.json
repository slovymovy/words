                ],
                "senses": [
                    {
                        "sense_id": "3a64f7e7-3fc0-3d33-8d57-271ed1105e81",
                        "entry_id": "dcef0a45-14a1-3b52-ab11-175d160f88b4",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b56e79-7702-4c45-9c44-b12010a51e2c",
                                "sense_id": "3a64f7e7-3fc0-3d33-8d57-271ed1105e81",
                                "text": "Konrad ist ein kluges Kerlchen."
                            },
                            {
                                "example_id": "67945fde-303f-4096-baff-621f8bea8d26",
                                "sense_id": "3a64f7e7-3fc0-3d33-8d57-271ed1105e81",
                                "text": "\"Konrad\", sprach die Frau Mama, \"Ich geh´ aus und du bleibst da. Sei hübsch ordentlich und fromm, bis nach Haus ich wieder komm’. Und vor allem, Konrad, hör’! Lutsche nicht…\" (Aus Der Struwwelpeter)"
                            },
                            {
                                "example_id": "a7d5a682-ffab-4729-b6eb-c25c1f1eab34",
                                "sense_id": "3a64f7e7-3fc0-3d33-8d57-271ed1105e81",
                                "text": "„Bereits Konrad Adenauer kritisierte in seiner Weihnachtsansprache 1955 die Kommerzialisierung des Weihnachtsfests.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa6713e2-394e-455c-b902-5f1f0d138cda",
                        "source_entry_id": "dcef0a45-14a1-3b52-ab11-175d160f88b4",
                        "source_sense_id": "3a64f7e7-3fc0-3d33-8d57-271ed1105e81",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Conrad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Conrad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01ad9130-af29-34b5-b41e-139eea1c84b3",
                                        "entry_id": "4765d018-e584-3c44-bab0-4f8a0a0d663b",
                                        "glosses": [
                                            "A male given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a32b108b-2d75-4650-b107-7f5dce9bfa1c",
                                                "sense_id": "01ad9130-af29-34b5-b41e-139eea1c84b3",
                                                "text": "There was no further need for words, because the lexicon of Romance jargon has just been fully deployed. In it chaps are called names like Conrad, and girls names like Delora, quite unlike the names of those who are reading it on the way to work."
                                            },
                                            {
                                                "example_id": "3da14f6b-a74f-43ef-9f8c-15ee0e18a876",
                                                "sense_id": "01ad9130-af29-34b5-b41e-139eea1c84b3",
                                                "text": "Career diplomat Conrad Tribble said on Twitter that multiculturalism “is one of our greatest strengths as a country, and I go to that well often as an American diplomat. It’s hard to overstate the global soft power impact of America’s cultural diversity.”"
                                            }
                                        ]
                                    },
