                                "target_senses": [
                                    {
                                        "sense_id": "51da0c37-584f-3d65-8b30-49c9d57bc506",
                                        "entry_id": "b24b0d92-0205-38f5-8321-17a340091199",
                                        "glosses": [
                                            "The act of pouring a liquid, most often wine, in sacrifice on the ground, on a ritual object, or on a victim, in honor of some deity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81cb63a6-6bf3-41be-8ba7-8c97434233e6",
                                                "sense_id": "51da0c37-584f-3d65-8b30-49c9d57bc506",
                                                "text": "While we to Jove the pure libations pay,\n Than Jove what apter claims the hallow'd lay?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "786f02a0-d958-3048-84c6-c576f9d041dd",
                                        "entry_id": "b24b0d92-0205-38f5-8321-17a340091199",
                                        "glosses": [
                                            "The wine or liquid thus poured out."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55b0528a-6717-3f24-8de1-8495a5b080fc",
                                        "entry_id": "b24b0d92-0205-38f5-8321-17a340091199",
                                        "glosses": [
                                            "A beverage, especially an alcoholic one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "humorous",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd01b2e6-45cb-4e18-9527-be71acc587e0",
                                                "sense_id": "55b0528a-6717-3f24-8de1-8495a5b080fc",
                                                "text": "[…] watching you, the waiters, not quite making eye-contact but scanning for any little way to be of service, plus plum-jacketed sommeliers walking around to see if you need a non-buffet libation…"
                                            },
                                            {
                                                "example_id": "806a8505-3061-4221-92d9-cf24b3a69a01",
                                                "sense_id": "55b0528a-6717-3f24-8de1-8495a5b080fc",
                                                "text": "What's more, Swedish researchers found that the fat and fiber in nuts slow the absorption of alcohol into your bloodstream. This can help smooth out the effects of moderate alcohol consumption. For best results, try to eat about 15 minutes before taking your first libation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
