                "senses": [
                    {
                        "sense_id": "025da28b-481b-37c3-a6ad-624af60c5f64",
                        "entry_id": "30c2c955-649f-3224-b495-6d6fdb85698f",
                        "glosses": [
                            "город в Закавказье, столица Армении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "321914c6-83e2-4b6f-ad7e-544195c55b8d",
                                "sense_id": "025da28b-481b-37c3-a6ad-624af60c5f64",
                                "text": "Мы поехали вместе с Люсей: сначала провели несколько прекрасных дней в Грузии, еще с 1968 года милой моему сердцу, а затем вылетели в Ереван."
                            },
                            {
                                "example_id": "d559cd50-cccc-47db-99f5-2c2f17afabe0",
                                "sense_id": "025da28b-481b-37c3-a6ad-624af60c5f64",
                                "text": "Сразу же после Риги мне предстояло ехать в Ереван."
                            },
                            {
                                "example_id": "09dbb741-5576-4922-a6bc-2ebba93280b2",
                                "sense_id": "025da28b-481b-37c3-a6ad-624af60c5f64",
                                "text": "За год до того, как мы с Володей познакомились, я летела в Ереван."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2eb74502-c216-41aa-95ef-c2c33b0d4bc9",
                        "source_entry_id": "30c2c955-649f-3224-b495-6d6fdb85698f",
                        "source_sense_id": "025da28b-481b-37c3-a6ad-624af60c5f64",
                        "target_lang_word": "Yerevan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yerevan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a726bca5-9af6-341f-aa20-1d1353818b24",
                                        "entry_id": "0e473297-1fd0-3f60-a95e-2adb7343f5cc",
                                        "glosses": [
                                            "The capital and largest city of Armenia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e1b8dea-f73d-4647-ba25-5341ca1cb8c6",
                                                "sense_id": "a726bca5-9af6-341f-aa20-1d1353818b24",
                                                "text": "Before long Abbas Mirza suffered a succession of defeats, which culminated in the capture of Erivan, today capital of Armenia."
                                            },
                                            {
                                                "example_id": "d1a87fee-3d33-4b30-8202-5b213d6af218",
                                                "sense_id": "a726bca5-9af6-341f-aa20-1d1353818b24",
                                                "text": "Crammed to the gills with history, it nestles in the shadow of Mount Ararat and has a medieval centre but it's Yerevan's religious heritage that is its main claim to fame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
