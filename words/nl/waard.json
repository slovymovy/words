            "senses": [
                {
                    "sense_id": "5506ddbf-5095-3566-a59b-86500e5411c1",
                    "sense_definition": "De eigenaar of beheerder van een herberg, café of restaurant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>waard</w> schonk ons nog een glas bier in.",
                            "target_lang_translations": {
                                "ru": "<w>Трактирщик</w> налил нам еще по бокалу пива.",
                                "en": "The <w>innkeeper</w> poured us another glass of beer.",
                                "it": "L'<w>oste</w> ci ha versato un altro bicchiere di birra."
                            }
                        },
                        {
                            "text": "We vroegen de <w>waard</w> of er nog een kamer vrij was voor de nacht.",
                            "target_lang_translations": {
                                "ru": "Мы спросили <w>хозяина</w>, есть ли свободная комната на ночь.",
                                "en": "We asked the <w>innkeeper</w> if there was a room free for the night.",
                                "it": "Abbiamo chiesto al <w>locandiere</w> se c'era ancora una camera libera per la notte."
                            }
                        }
                    ],
                    "synonyms": [
