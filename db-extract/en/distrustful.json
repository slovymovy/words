                    {
                        "translation_id": "ac591673-24ea-4174-af88-e6f6365284d0",
                        "source_entry_id": "a0789b93-17b8-364c-bbd5-0ac1ce4027b1",
                        "source_sense_description": "marked by distrust; doubtful; suspicious",
                        "target_lang_word": "suspicieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
