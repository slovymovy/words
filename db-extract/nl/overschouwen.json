        "nl-extract.jsonl": [
            {
                "entry_id": "502879be-6c59-3098-bfae-0b5e29bea42c",
                "word": "overschouwen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "74e84c73-e787-3549-bbbc-17fa303e3dd5",
                        "entry_id": "502879be-6c59-3098-bfae-0b5e29bea42c",
                        "glosses": [
                            "vanaf een hoogte alles kunnen zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45f2ca2e-998f-4c32-bb76-8fc5c311303f",
                                "sense_id": "74e84c73-e787-3549-bbbc-17fa303e3dd5",
                                "text": "De ‘Wet 89’ telt nu acht verdiepingen waar alle oude geledingen hun plekje kregen, maar waar het overzicht totaal zoek was. Coens wil zijn ploeg ‘op één verdieping in één oogopslag kunnen overschouwen’ en is op zoek naar ‘een open space office’."
                            },
                            {
                                "example_id": "71cfb239-9e93-472b-ab3a-ef54d193d975",
                                "sense_id": "74e84c73-e787-3549-bbbc-17fa303e3dd5",
                                "text": "We moeten het hele veld overschouwen, het doel blijft nog altijd het aantal contacten beperken. Het ergste wat we nu kunnen meemaken, is te snel versoepelen en dan weer moeten terugplooien.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "6c74c404-ade4-3d51-91ca-8a1c95c2a594",
                        "entry_id": "502879be-6c59-3098-bfae-0b5e29bea42c",
                        "glosses": [
                            "iets achteraf overdenken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "92af590e-08dd-414a-9a14-7d9171d3bf74",
                                "sense_id": "6c74c404-ade4-3d51-91ca-8a1c95c2a594",
                                "text": "De oude Helena, hoofdpersoon in de nieuwe roman ”Godenslaap” van de Belgische schrijver Erwin Mortier, schrijft de herinneringen aan haar leven op: „Misschien is het mogelijk om, vlak voor ik volledig verdwijn, het bestaan zelf te overschouwen alsof ik eruit losgeweekt ben.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "92de925f-2742-31a6-9701-c717241d108d",
                        "entry_id": "502879be-6c59-3098-bfae-0b5e29bea42c",
                        "glosses": [
                            "alles kunnen zien en beoordelen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "89c21eb8-1613-4dff-8cff-63cf36b1ada4",
                                "sense_id": "92de925f-2742-31a6-9701-c717241d108d",
                                "text": "Naar eigen zeggen kon ze zo als \"schaduwkabinet\" overschouwen op alle dossiers en departementen en letten op het naleven van het bestuursakkoord."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "295d1f98-5c80-4c1e-b45f-280ce8445fcc",
                        "source_entry_id": "502879be-6c59-3098-bfae-0b5e29bea42c",
                        "source_sense_id": "74e84c73-e787-3549-bbbc-17fa303e3dd5",
                        "source_sense_description": "vanaf een hoogte alles kunnen zien",
                        "target_lang_word": "oversee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oversee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df495403-bf81-3195-8ce1-40389af4865e",
                                        "entry_id": "39a9eec6-c988-3b44-a5d2-f02b014e483c",
                                        "glosses": [
                                            "To survey, look at something in a wide angle."
                                        ],
                                        "tags": [
                                            "literally",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f0e2aa9-07c1-34e4-bc0c-4901eaaab2a6",
                                        "entry_id": "39a9eec6-c988-3b44-a5d2-f02b014e483c",
                                        "glosses": [
                                            "To supervise, guide, review or direct the actions of a person or group."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e055681-fdca-4404-ac00-49d864851d62",
                                                "sense_id": "1f0e2aa9-07c1-34e4-bc0c-4901eaaab2a6",
                                                "text": "It is congress's duty to oversee the spending of federal funds."
                                            },
                                            {
                                                "example_id": "7592bb64-d4a1-4a2f-9c97-1d358f6b70d1",
                                                "sense_id": "1f0e2aa9-07c1-34e4-bc0c-4901eaaab2a6",
                                                "text": "Based at BTP's London headquarters, Russell's team of three full-timers in the drone unit are responsible for overseeing the safety of drones in support of police officers."
                                            },
                                            {
                                                "example_id": "04818245-bc60-4416-b63b-80e1c722c3a2",
                                                "sense_id": "1f0e2aa9-07c1-34e4-bc0c-4901eaaab2a6",
                                                "text": "Treasury could also ask why High Speed 2's finances are so adrift from what was promised. The answers will make for difficult DfT reading, because it can't escape the fact that it has been the government department overseeing rail spending for the past 20 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d657e13-d405-3326-804f-23e6bbcbe0b7",
                                        "entry_id": "39a9eec6-c988-3b44-a5d2-f02b014e483c",
                                        "glosses": [
                                            "To inspect, examine"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66a1733c-b6b1-42c7-99e9-40d3c058cb27",
                                                "sense_id": "5d657e13-d405-3326-804f-23e6bbcbe0b7",
                                                "text": "Gamekeepers oversee a hunting ground to see to the wildlife's welfare and look for poachers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8561be17-9968-3e53-829f-7cfeed641f69",
                                        "entry_id": "39a9eec6-c988-3b44-a5d2-f02b014e483c",
                                        "glosses": [
                                            "To fail to see; to overlook, ignore."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48570ac7-b84e-4a8b-8f96-ae29222220a1",
                                                "sense_id": "8561be17-9968-3e53-829f-7cfeed641f69",
                                                "text": "Thereat the Elfe did blush in priuitee, / And turnd his face away; but she the same / Dissembled faire, and faynd to ouersee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a8c3256-b86e-3a96-94f9-800fdc9d0820",
                                        "entry_id": "39a9eec6-c988-3b44-a5d2-f02b014e483c",
                                        "glosses": [
                                            "To observe secretly or unintentionally."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
