                "senses": [
                    {
                        "sense_id": "5f2b453c-ffc6-3d3a-b271-a6fc39d685bf",
                        "entry_id": "73f3a257-ce4d-3999-bca2-ed6d8accaccf",
                        "glosses": [
                            "Clouer, fixer, placarder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "615d51ba-94da-4809-8319-406423049616",
                                "sense_id": "5f2b453c-ffc6-3d3a-b271-a6fc39d685bf",
                                "text": "прибить дощечку к двери : clouer (ou fixer) une planchette à la porte."
                            },
                            {
                                "example_id": "4faa9ca9-608d-4ccb-8c83-262ef2e97593",
                                "sense_id": "5f2b453c-ffc6-3d3a-b271-a6fc39d685bf",
                                "text": "Прибить половицу. : Clouer le plancher."
                            }
                        ]
                    },
                    {
                        "sense_id": "e72b8ede-67dc-36eb-be3e-25d565e722be",
                        "entry_id": "73f3a257-ce4d-3999-bca2-ed6d8accaccf",
                        "glosses": [
                            "Abattre, rabattre, pousser, repousser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5077eff3-01b1-488c-beb0-047f4352976c",
                                "sense_id": "e72b8ede-67dc-36eb-be3e-25d565e722be",
                                "text": "дождик прибил пыль : la pluie a rabattu la poussière."
                            },
                            {
                                "example_id": "66e62495-fdab-441a-b7ad-1376c2c60cce",
                                "sense_id": "e72b8ede-67dc-36eb-be3e-25d565e722be",
                                "text": "лодку прибило к берегу : le bateau a été poussé vers le rivage."
                            },
                            {
                                "example_id": "59797841-3012-4352-b01d-62d402d90dbe",
                                "sense_id": "e72b8ede-67dc-36eb-be3e-25d565e722be",
                                "text": "ветром нас прибило к скале : le vent nous a jetés sur un écueil."
                            }
                        ]
                    }
