                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "ee67c5e0-3a6a-38bf-8d6d-58ad44d83d51",
                    "sense_definition": "Agacer profondément quelqu'un ou l'exaspérer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de te plaindre constamment, tes remarques commencent vraiment à me <w>gaver</w>."
                        },
                        {
                            "text": "Cette musique trop forte me <w>gave</w> depuis ce matin."
                        }
                    ],
                    "synonyms": [
                        "souler"
                    ],
                    "common_phrases": [
                        "ça me gave"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
