                "senses": [
                    {
                        "sense_id": "4c51be42-1542-3ea0-ac9f-8c76a41451a6",
                        "entry_id": "6a9f6b7c-2bcb-381a-987a-964105bed224",
                        "glosses": [
                            "The state of being oral."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5ce9e15f-a267-41a4-95b3-4eb7baf41c91",
                                "sense_id": "4c51be42-1542-3ea0-ac9f-8c76a41451a6",
                                "text": "Indeed, this reading is particularly inappropriate among these oralities and physicalities, bordering on cannibalism."
                            },
                            {
                                "example_id": "14181d88-0d55-4190-9f40-8815eeb2feee",
                                "sense_id": "4c51be42-1542-3ea0-ac9f-8c76a41451a6",
                                "text": "The oralities and literacies of the past are regularly made the subject of inquiries by linguists, philosophers, theologians, anthropologists,"
                            },
                            {
                                "example_id": "1b76c48a-ac22-4580-b02d-85f5ccfc7cdd",
                                "sense_id": "4c51be42-1542-3ea0-ac9f-8c76a41451a6",
                                "text": "McLuhan thought that writing was a supplement to speech; in fact, it was sandwiched between two oralities"
                            },
                            {
                                "example_id": "b72c1e36-97ad-4981-a614-8df8e69f75e1",
                                "sense_id": "4c51be42-1542-3ea0-ac9f-8c76a41451a6",
                                "text": "Falk's theory of consumption is based on evidence of a shift in the hierarchy between two oralities: speaking and eating."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f467f268-4944-4f9f-989a-f9939352ee14",
                        "source_entry_id": "6a9f6b7c-2bcb-381a-987a-964105bed224",
                        "source_sense_id": "4c51be42-1542-3ea0-ac9f-8c76a41451a6",
                        "source_sense_description": "being oral",
                        "target_lang_word": "oralité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oralité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16eff662-5d1e-3f97-984f-ed139e458961",
                                        "entry_id": "8fddb2b5-10dc-37b1-b3a7-b558e9e85f21",
                                        "glosses": [
                                            "Caractère de ce qui est oral, parlé, par opposition à scribalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "247fc9dc-ea73-436c-926d-15bb0fec8674",
                                                "sense_id": "16eff662-5d1e-3f97-984f-ed139e458961",
                                                "text": "La littérature gabonaise, comme l’a si bien montré la critique , procède nettement d’un rapport essentiel, d’une relation assumée entre l’écriture et l’oralité."
                                            },
                                            {
                                                "example_id": "030f3c09-48b8-461c-8678-e14a07776e07",
                                                "sense_id": "16eff662-5d1e-3f97-984f-ed139e458961",
                                                "text": "Dans un style réaliste, proche de l'oralité, Paré y raconte la mort de son père et le travail forestier, « la colère, les cris et les jurons » de ses oncles et frères bûcherons."
                                            },
                                            {
                                                "example_id": "98c2eadf-33ad-42dc-95b3-f4c8c5f1f574",
                                                "sense_id": "16eff662-5d1e-3f97-984f-ed139e458961",
                                                "text": "Le gaga était donc langue écrite et langue parlée ce qui implique les concepts de scripturalité et d’oralité selon Koch et Oesterreicher, avec un code oral et un code écrit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
