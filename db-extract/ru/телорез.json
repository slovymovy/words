                                "target_senses": [
                                    {
                                        "sense_id": "79634b52-a85b-3ce9-a70a-590eefc6d2e1",
                                        "entry_id": "cd5dc775-785f-34fc-a2d5-d35432218610",
                                        "glosses": [
                                            "To continue steadfast; to keep striving."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2b98e5e-aa9e-30ac-b876-e225853dd230",
                                        "entry_id": "cd5dc775-785f-34fc-a2d5-d35432218610",
                                        "glosses": [
                                            "To serve as a soldier."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9cb4e87-77ef-36ca-bec4-6d90c72162e6",
                                        "entry_id": "cd5dc775-785f-34fc-a2d5-d35432218610",
                                        "glosses": [
                                            "To intentionally restrict labor productivity; to work at the slowest rate that goes unpunished."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b28c2806-4b05-3d1c-a25c-20f44e8f14dc",
                                        "entry_id": "cd5dc775-785f-34fc-a2d5-d35432218610",
                                        "glosses": [
                                            "To take a ride on (another person's horse) without permission."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aba6a82-d481-4b29-b9c9-618e1b5813e3",
                                                "sense_id": "b28c2806-4b05-3d1c-a25c-20f44e8f14dc",
                                                "text": "It was the first time I had ever “soldiered” a horse. Soldiering means using a horse without the owner's leave or knowledge. Two of our lost horses we never found. Probably some one was soldiering them!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
