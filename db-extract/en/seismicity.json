                    {
                        "translation_id": "cede9cb8-2665-449e-a0b1-4bba5a1bf0cb",
                        "source_entry_id": "514bcc79-458e-345d-a3c4-38fbe9cade44",
                        "source_sense_id": "5505fe72-c136-3a56-aec4-76f7cd283c53",
                        "source_sense_description": "factor of how seismic a region is",
                        "target_lang_word": "sismicidad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sismicidad",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "175159b9-4ec2-3867-8753-a10e6ea37fdf",
                                        "entry_id": "78e27580-2f79-38db-8df7-5e8546b173c3",
                                        "glosses": [
                                            "Actividad sísmica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d053508c-d78e-48c7-ad73-5346ffcf4549",
                                                "sense_id": "175159b9-4ec2-3867-8753-a10e6ea37fdf",
                                                "text": "Cuanto menor sea este número, más frecuentemente la región estará sujeta á temblores. Así la superficie expresada en kilómetros cuadrados dará el inverso de la sismicidad buscada."
                                            },
                                            {
                                                "example_id": "d39a64fb-248c-42a2-bb35-f8fff8baed3c",
                                                "sense_id": "175159b9-4ec2-3867-8753-a10e6ea37fdf",
                                                "text": "Es decir, se intenta identificar los momentos en los que la probabilidad aumenta para una determinada región, basándose en aumentos de la sismicidad local, agrupamiento espacio-temporal de la sismicidad, etc."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
