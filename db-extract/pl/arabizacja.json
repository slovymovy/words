                "senses": [
                    {
                        "sense_id": "7eefe26f-2aed-3cdb-98d5-c4cdc7480bf6",
                        "entry_id": "64ddaa0f-97e2-3d14-a742-078bd168b570",
                        "glosses": [
                            "narzucanie danemu ludowi lub przyswajanie przez dany lud arabskiej kultury, obyczajów i języka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cf06ddc-d488-4823-a0fc-a156c53f727d",
                                "sense_id": "7eefe26f-2aed-3cdb-98d5-c4cdc7480bf6",
                                "text": "W przeciwieństwie do Egiptu czy Syrii, w Iranie ostatecznie islamizacja nie została jednak połączona z arabizacją"
                            },
                            {
                                "example_id": "991b099d-d25f-4a73-bfd0-8ed8ccbac45b",
                                "sense_id": "7eefe26f-2aed-3cdb-98d5-c4cdc7480bf6",
                                "text": "Berberzy i chrześcijanie zostali poddani przymusowej islamizacji oraz arabizacji, od której obecnie wielu próbuje się uwolnić"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f193e50c-0c58-3bfe-b8ed-582f355a944a",
                        "entry_id": "64ddaa0f-97e2-3d14-a742-078bd168b570",
                        "glosses": [
                            "nadawanie czemuś lub komuś cech arabskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3a45d46-e734-4ef6-aa15-79b66b6d68db",
                                "sense_id": "f193e50c-0c58-3bfe-b8ed-582f355a944a",
                                "text": "Tam z łatwością znajdują pracę jako nauczyciele języka arabskiego, gdyż kraj ten zaraz po wyzwoleniu się spod mandatu Francji rozpoczyna arabizację szkolnictwa oraz państwowych urzędów, dlatego szczególnie poszukiwani są arabiści"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6511d2b3-a538-3300-a725-2cf89f8578bb",
                        "entry_id": "64ddaa0f-97e2-3d14-a742-078bd168b570",
                        "glosses": [
                            "rozpowszechnienie języka arabskiego, dostosowywanie czegoś do języka arabskiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a517c7b-1765-4397-b32c-387e5c26906f",
                                "sense_id": "6511d2b3-a538-3300-a725-2cf89f8578bb",
                                "text": "Arabscy literaturoznawcy rozróżniają trzy określenia: ta'rib (arabizacja), tamsir (egipcjanizacja) i targama (tłumaczenie), dla form adaptacji dzieł literatury obcej w Egipcie"
                            },
                            {
                                "example_id": "57524f5c-4ee9-4df0-89a4-6eca5025c51c",
                                "sense_id": "6511d2b3-a538-3300-a725-2cf89f8578bb",
                                "text": "Rok 1966 przyniósł wypowiedź ministra Benhimy, który na konferencji prasowej stwierdził, że należy zarzucić rozpoczęty projekt całkowitej arabizacji i przywrócić nauczanie przedmiotów ścisłych w języku francuskim"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
