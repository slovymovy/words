                    "sense_definition": "een aantal van ongeveer tien",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er waren een <w>tiental</w> mensen aanwezig bij de kleine vergadering.",
                            "target_lang_translations": {
                                "en": "There were <w>about ten</w> people present at the small meeting.",
