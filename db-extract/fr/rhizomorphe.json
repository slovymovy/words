                ],
                "senses": [
                    {
                        "sense_id": "6048bed9-2efd-3c34-b417-dea3bc4092e7",
                        "entry_id": "9fada106-dad6-3c9f-be5b-f3f93195b4b7",
                        "glosses": [
                            "Organe de champignon résistant, permettant une propagation sans reproduction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43e7659a-8bf9-40d7-9219-b8bc48ba8f7e",
                                "sense_id": "6048bed9-2efd-3c34-b417-dea3bc4092e7",
                                "text": "Aucun rhizomorphe de ce champignon pathogène n'a été trouvé sur des semis naturels du même âge."
                            },
                            {
                                "example_id": "d4280f50-3bae-414e-b0ed-1d2d8a8cd4a1",
                                "sense_id": "6048bed9-2efd-3c34-b417-dea3bc4092e7",
                                "text": "Les résidus ligneux issus d'arbres indemnes d'armillaire à l'arrachage peuvent être envahis par la suite si des rhizomorphes sont présent dans le sol, et donc servir de source d'inoculum par la suite. Il en est de même pour les fragments de racines hébergeant A. mellea à l'état saprophyte."
                            },
                            {
                                "example_id": "ff872298-b242-4ffd-a918-cdeb003e95cd",
                                "sense_id": "6048bed9-2efd-3c34-b417-dea3bc4092e7",
                                "text": "La partie végétative de la mérule est un mycélium composé d'hyphes de moins de 10 μm de diamètre qui se développent dans les cavités du bois. En surface, les hyphes s'agglomèrent ou s'entremêlent et forment soit une toile grisâtre, soit des rhizomorphes souvent ramifiés en palmettes."
                            }
                        ]
                    }
                ],
