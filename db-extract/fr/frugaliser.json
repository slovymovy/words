                "senses": [
                    {
                        "sense_id": "301a436b-e1ea-3506-843d-dec7c12df666",
                        "entry_id": "ecba526f-1b9c-37f6-8bcd-60ad87504aa1",
                        "glosses": [
                            "Donner un caractère frugal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce25c71f-6cb4-43af-926a-30f40491ebf4",
                                "sense_id": "301a436b-e1ea-3506-843d-dec7c12df666",
                                "text": "Dès lors, quoi de plus commode pour faire avancer les choses dans la direction souhaitée qu’une bonne loi, un ferme décret, un règlement musclé, un arrêté précis, bref une solide contrainte sur l’individu agissant pour l’amener malgré lui à se simplifier la vie et à frugaliser son comportement."
                            },
                            {
                                "example_id": "d7e80aba-4070-4686-833e-a26231b37259",
                                "sense_id": "301a436b-e1ea-3506-843d-dec7c12df666",
                                "text": "C'est le désir de durer qui motive la conscience collective de l'entreprise à innover, frugaliser, fiabiliser pour une entreprise bien vivante !"
                            },
                            {
                                "example_id": "48ba4f09-ba38-410e-8ac1-900c8664b7cb",
                                "sense_id": "301a436b-e1ea-3506-843d-dec7c12df666",
                                "text": "Découpage des items à « frugaliser »;"
                            }
                        ]
                    }
