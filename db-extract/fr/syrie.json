                    {
                        "sense_id": "925a9962-2e62-3ae1-a6a7-5c637a6d3f4d",
                        "entry_id": "efa05dae-28e5-368b-82ea-fd2969e0dfec",
                        "glosses": [
                            "Pays arabe entouré au nord par la Turquie, à l’ouest par la mer Méditerranée et le Liban, au sud-ouest par Israël, au sud-sud-ouest par la Jordanie et à l’est par l’Irak, et dont la capitale est Damas."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "67f0bc76-a433-4afe-8248-df4711f5c651",
                                "sense_id": "925a9962-2e62-3ae1-a6a7-5c637a6d3f4d",
                                "text": "Les forces américaines maintiennent une base militaire à Al-Tanf (dans le sud du pays, à la frontière de la Syrie avec l’Irak et la Jordanie)."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0e9b79e-5951-3ad1-a9b5-ce4f6a97c9a5",
                        "entry_id": "efa05dae-28e5-368b-82ea-fd2969e0dfec",
                        "glosses": [
                            "Province romaine qui couvrait la territoire correspondant à peu près au pays moderne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c3fbc2f1-b6e6-368d-84a6-ff65564d4ce3",
                        "entry_id": "efa05dae-28e5-368b-82ea-fd2969e0dfec",
                        "glosses": [
                            "Ensemble des pays mis sous mandat français par la Société des Nations, de 1920 et 1946, faisant partie des anciens vilayets ottomans de Beyrouth, de Damas, d’Alep, une partie de Saint-Jean d’Acre et du moutessarifat du Liban."
                        ],
                        "tags": [
                            "obsolete",
                            "toponymic"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd8a9372-6c28-43db-a61e-7e5a6412c863",
