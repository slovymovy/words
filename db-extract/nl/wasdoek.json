                "senses": [
                    {
                        "sense_id": "1a830461-a7d7-3b75-8653-9b7287ac014e",
                        "entry_id": "d53b7679-949d-38b1-8b2e-07bcd5bac17a",
                        "glosses": [
                            "weefsel van linnen, katoen of jute, dat aan één zijde met vernis uit lijnolie wordt bestreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf549b12-54c9-4903-9443-b7a502a41f30",
                                "sense_id": "1a830461-a7d7-3b75-8653-9b7287ac014e",
                                "text": "Ze hadden hun masker op van wasdoek en paraffine, met die nerveuze, licht radeloze blik. Op hun borst droegen ze de grote koperen bel, en om hun middel een gordel met belletjes."
                            },
                            {
                                "example_id": "fccedb0b-3b1b-4bbb-87c9-52b88c265329",
                                "sense_id": "1a830461-a7d7-3b75-8653-9b7287ac014e",
                                "text": "Kant-en-klare wasdoeken zijn wel prijzig. Het van origine Amerikaanse merk Bee’s wrap biedt verschillende modellen en formaten aan. De versie voor een lunchpakketje kost bijna 13 euro. Voor drie lappen in verschillende maten betaal je 23,50 euro."
                            }
                        ]
                    },
                    {
                        "sense_id": "d16301bb-8d47-3e16-bc0d-7a69f23ada8d",
                        "entry_id": "d53b7679-949d-38b1-8b2e-07bcd5bac17a",
                        "glosses": [
                            "doek waarmee men parketvloeren voorziet van was"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc0cf8c-1ebb-4e0c-895c-ae1160c4b1a7",
                                "sense_id": "d16301bb-8d47-3e16-bc0d-7a69f23ada8d",
                                "text": "Claudel speelt met licht, geluiden, geuren: „Het smalle vertrek rook naar wasdoek en gietijzer, naar biergist, naar geboend parket. Daar dronk ik mijn jonge leven als een glas vruchtenlimonade.” Hij roept een verleden op dat soms bevreemdend, soms heel herkenbaar is."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a41a874-b0f6-307e-8114-027209357d98",
                        "entry_id": "d53b7679-949d-38b1-8b2e-07bcd5bac17a",
                        "glosses": [
                            "doek waarmee men zich kan wassen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
