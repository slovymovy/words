{
    "word_family": [
        "pluck",
        "plucky",
        "pluckiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8fab8841-7a4a-3e06-b9f5-06e0fb949292",
                    "sense_definition": "Having had feathers or hair removed by pulling them out.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared the <w>plucked</w> chicken for roasting.",
                            "target_lang_translations": {
                                "fr": "Le chef a préparé le poulet <w>plumé</w> pour le rôtissage."
                            }
                        },
                        {
                            "text": "She bought a <w>plucked</w> goose at the market for the holiday dinner.",
                            "target_lang_translations": {
                                "fr": "Elle a acheté une oie <w>plumée</w> au marché pour le dîner de fête."
                            }
                        }
                    ],
                    "synonyms": [
                        "featherless",
                        "bare"
                    ],
                    "target_lang_definitions": {
                        "fr": "Ayant eu les plumes ou les poils retirés en les arrachant."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "plumé",
                                "target_lang_sense_clarification": "se dit d'un oiseau dont on a retiré les plumes"
                            },
                            {
                                "target_lang_word": "épilé",
                                "target_lang_sense_clarification": "se dit d'une zone dont on a retiré les poils"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ec2815f-4ecc-37c0-9642-20a051b19d96",
                    "sense_definition": "Produced by pulling the strings of a musical instrument.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "musical_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The piece features a delicate <w>plucked</w> melody on the harp.",
                            "target_lang_translations": {
                                "fr": "Le morceau présente une délicate mélodie <w>pincée</w> à la harpe."
                            }
                        },
                        {
                            "text": "He played a <w>plucked</w> note on the guitar to start the song.",
                            "target_lang_translations": {
                                "fr": "Il a joué une note <w>pincée</w> à la guitare pour commencer la chanson."
                            }
                        }
                    ],
                    "antonyms": [
                        "bowed"
                    ],
                    "common_phrases": [
                        "plucked strings"
                    ],
                    "target_lang_definitions": {
                        "fr": "Produit en tirant sur les cordes d'un instrument de musique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pincé",
                                "target_lang_sense_clarification": "se dit d'une note ou d'une corde jouée en la pinçant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "060c3683-b0c9-3301-bd92-c294df4fe38f",
                    "sense_definition": "Having courage and spirit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>plucked</w> young soldier refused to retreat despite the heavy fire.",
                            "target_lang_translations": {
                                "fr": "Le jeune soldat <w>courageux</w> a refusé de battre en retraite malgré les tirs nourris."
                            }
                        },
                        {
                            "text": "She was a <w>plucked</w> individual who never backed down from a challenge.",
                            "target_lang_translations": {
                                "fr": "C'était une personne <w>vaillante</w> qui ne reculait jamais devant un défi."
                            }
                        }
                    ],
                    "synonyms": [
                        "courageous",
                        "brave",
                        "spirited"
                    ],
                    "antonyms": [
                        "cowardly"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely replaced by the adjective plucky."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui fait preuve de courage et d'esprit."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "courageux",
                                "target_lang_sense_clarification": "qui a du courage"
                            },
                            {
                                "target_lang_word": "vaillant",
                                "target_lang_sense_clarification": "qui fait preuve de bravoure"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50a86a35-dfb1-3e99-99c0-f2d09a99c505",
                    "sense_definition": "Simple past and past participle of <w>pluck</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>plucked</w> a fresh flower from the garden.",
                            "target_lang_translations": {
                                "fr": "Elle a <w>cueilli</w> une fleur fraîche dans le jardin."
                            }
                        },
                        {
                            "text": "He <w>plucked</w> the guitar strings to test the sound.",
                            "target_lang_translations": {
                                "fr": "Il a <w>pincé</w> les cordes de la guitare pour tester le son."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb pluck."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Passé simple et participe passé du verbe cueillir ou arracher."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "cueilli",
                                "target_lang_sense_clarification": "pour une fleur ou un fruit"
                            },
                            {
                                "target_lang_word": "arraché",
                                "target_lang_sense_clarification": "pour quelque chose retiré avec force"
                            },
                            {
                                "target_lang_word": "pincé",
                                "target_lang_sense_clarification": "pour une corde d'instrument"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}