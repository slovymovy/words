                "translations": [
                    {
                        "translation_id": "45a093b5-e759-4b37-8dcf-6e6485f938b3",
                        "source_entry_id": "070ba859-e5be-3009-ba41-cae5be239b7d",
                        "source_sense_id": "2ebf3bf7-fc5c-3166-a7f0-fc387737444b",
                        "target_lang_word": "surprise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surprise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                        "entry_id": "fb352ebc-f523-3c75-827e-2710312414b4",
                                        "glosses": [
                                            "Something unexpected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "664adb9f-bec1-4193-b78a-d4bc8564bc09",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "It was a surprise to find out I owed twice as much as I thought."
                                            },
                                            {
                                                "example_id": "e40a0c56-9f1b-484c-b45f-2f1a2f1abd1f",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "It came as a surprise when he succeed."
                                            },
                                            {
                                                "example_id": "99e96222-7ec0-40fb-a482-43104960340d",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "England were graphically illustrating the huge gulf in class between the sides and it was no surprise when Lampard added the second just before the half hour. Steven Gerrard found his Liverpool team-mate Glen Johnson and Lampard arrived in the area with perfect timing to glide a header beyond Namasco."
                                            },
                                            {
                                                "example_id": "ed1b64e4-0090-4da4-9877-8950795a2fb0",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "They had begun brightly but the opening goal was such a blow to their confidence it almost came as a surprise when Walcott, running through the inside-right channel, beat the offside trap and, checking back on to his left foot, turned a low shot beyond Allan McGregor in the Scotland goal."
                                            },
                                            {
                                                "example_id": "3db522ee-dc80-448d-b9e3-2abf98cf2c8e",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "Surprise! - A party! Awesome!"
                                            },
                                            {
                                                "example_id": "7bd90f86-c051-43f2-9e92-604fe510fdda",
                                                "sense_id": "813e6eac-11cc-3f2c-af82-81f795c09f20",
                                                "text": "She bought the model as a surprise gift for a friend who is a lifelong HST fan and railwayman, and who will soon be celebrating a milestone birthday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "998456a3-a7f3-3c48-86b5-25163dfd57b0",
                                        "entry_id": "fb352ebc-f523-3c75-827e-2710312414b4",
                                        "glosses": [
                                            "Something unexpected.",
                                            "A mess of feces, left by a pet or small child in an unexpected place or at an unexpected time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2205206b-c2ea-4def-b1d7-e713bd541f7a",
                                                "sense_id": "998456a3-a7f3-3c48-86b5-25163dfd57b0",
                                                "text": "After the housecleaners drove off, the cat left a surprise for us on the carpet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36b6d41e-2651-3703-8ced-6b91fa33a147",
                                        "entry_id": "fb352ebc-f523-3c75-827e-2710312414b4",
                                        "glosses": [
                                            "The feeling that something unexpected has happened."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1e1263a-bb75-41a6-83a8-3975a273aff7",
                                                "sense_id": "36b6d41e-2651-3703-8ced-6b91fa33a147",
                                                "text": "Imagine my surprise on learning I owed twice as much as I thought I did."
                                            },
                                            {
                                                "example_id": "4b652be0-ae1a-4932-8450-df3fa03f5853",
                                                "sense_id": "36b6d41e-2651-3703-8ced-6b91fa33a147",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen.[…]The second note, the high alarum, not so familiar and always important since it indicates the paramount sin in Man’s private calendar, took most of them by surprise although they had been well prepared."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "surprise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa9464e8-236f-3bfd-b800-d2b08a899600",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To cause (someone) to feel unusually alarmed or delighted by something unexpected."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7acfdebf-e0cf-4bd0-b7c6-4b2345fa0292",
                                                "sense_id": "aa9464e8-236f-3bfd-b800-d2b08a899600",
                                                "text": "It surprises me that I owe twice as much as I thought I did."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9462f32-8b32-3dc2-b257-c25ab65759e9",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To do something to (a person) that they are not expecting, as a surprise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "116118db-3248-4399-b070-479b4cf51ac9",
                                                "sense_id": "a9462f32-8b32-3dc2-b257-c25ab65759e9",
                                                "text": "He doesn’t know that I’m in the country – I thought I’d turn up at his house and surprise him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e4fa1af-993e-37d5-bc56-57a6f64cd9b6",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To undergo or witness something unexpected."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5aeadf-0543-4d86-9ba0-dad4bbcbdfc7",
                                                "sense_id": "4e4fa1af-993e-37d5-bc56-57a6f64cd9b6",
                                                "text": "He doesn’t surprise easily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eededea1-be11-36ca-be2a-6ecc05b7abb2",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To cause surprise."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30814010-fb1e-3c78-a702-29f3b9cdb356",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To attack unexpectedly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39291bd9-e6ea-31cf-a039-5e57831d099c",
                                        "entry_id": "f19b84af-debe-37a7-b62e-05a4df9ae7e1",
                                        "glosses": [
                                            "To take unawares."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27f5bf4d-f004-447c-a618-9f8f2c830e7f",
                                                "sense_id": "39291bd9-e6ea-31cf-a039-5e57831d099c",
                                                "text": "\"You were right,\" replied Isabella, \"and I should not have surprised your confidence, had I not had something I wished to say. I know what you mean to do with Mr. Glentworth's gift—a marriage would scarcely be one without wedding-dresses—he has been equally generous to me, and you must keep the money till it is wanted, which, I hope, will be soon.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "surprise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b9c32cb-e337-3a63-a7a0-b7146af72a27",
                                        "entry_id": "404ba35f-be8d-36a1-b315-17f95efaf63f",
                                        "glosses": [
                                            "Drawing attention to a surprising action by oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45bd26b3-221d-4413-b387-65ecde640f9f",
                                                "sense_id": "1b9c32cb-e337-3a63-a7a0-b7146af72a27",
                                                "text": "\"Surprise!\" we shouted as we jumped out from the cupboard. \"Happy birthday!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2663fd6d-9954-3b2a-8a4c-70a8b9fc1a73",
                                        "entry_id": "404ba35f-be8d-36a1-b315-17f95efaf63f",
                                        "glosses": [
                                            "Sarcastically drawing attention to something that should have been obvious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6784f4fe-4ffc-4308-86bb-6ac65a9a3484",
                                                "sense_id": "2663fd6d-9954-3b2a-8a4c-70a8b9fc1a73",
                                                "text": "When we add code modules, we will have an additional folder called (surprise!) Modules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
