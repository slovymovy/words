                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b435dd0d-9523-3bfa-a941-01f952a5cbfb",
                        "entry_id": "23de073d-ad7c-3831-955f-2788d182e02c",
                        "glosses": [
                            "Of this, that, or it."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ad4da42e-09d1-4452-af74-868d32f9912d",
                                "sense_id": "b435dd0d-9523-3bfa-a941-01f952a5cbfb",
                                "text": "Hee [Solomon] ouerlaid also the house, the beames, the postes and the wals thereof, and the doores thereof with gold, and graued Cherubims on the walles."
                            },
                            {
                                "example_id": "05f77186-340b-40ad-814c-12bce6da1961",
                                "sense_id": "b435dd0d-9523-3bfa-a941-01f952a5cbfb",
                                "text": "I would swallow my pride, I would choke on the rinds / But the lack thereof would leave me empty inside"
                            }
                        ]
                    },
                    {
                        "sense_id": "520ae370-e158-316b-ac34-1b74dd386105",
                        "entry_id": "23de073d-ad7c-3831-955f-2788d182e02c",
                        "glosses": [
                            "From that circumstance or origin; therefrom, thence."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82433735-e096-46f6-a778-5e765ad27a36",
