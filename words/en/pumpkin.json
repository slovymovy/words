{
    "word_family": [
        "pumpkiny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4052685d-a29c-3507-ba14-a85ef7fe7ffc",
                    "sense_definition": "The round yellow or orange fruit of a vine plant, often used as food or for decoration.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plant_and_fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We carved a scary face into the <w>pumpkin</w> for Halloween.",
                            "target_lang_translations": {
                                "ru": "Мы вырезали страшную рожицу на <w>тыкве</w> для Хэллоуина.",
                                "zh": "为了万圣节，我们在<w>南瓜</w>上雕刻了一张可怕的脸。"
                            }
                        },
                        {
                            "text": "She baked a delicious <w>pumpkin</w> pie for Thanksgiving dinner.",
                            "target_lang_translations": {
                                "ru": "Она испекла вкусный пирог из <w>тыквы</w> к ужину на День благодарения.",
                                "zh": "她为感恩节晚餐烤了一个美味的<w>南瓜</w>派。"
                            }
                        }
                    ],
                    "synonyms": [
                        "squash",
                        "gourd"
                    ],
                    "common_phrases": [
                        "pumpkin pie",
                        "pumpkin patch",
                        "carve a pumpkin",
                        "pumpkin spice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Круглый желтый или оранжевый плод вьющегося растения, часто используемый в пищу или для украшения.",
                        "zh": "一种圆形的黄色或橙色藤本植物果实，常用于食用或装饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тыква",
                                "target_lang_sense_clarification": "плод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "南瓜",
                                "target_lang_sense_clarification": "指植物的果实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2004d207-6238-331a-8417-21ee03e25055",
                    "sense_definition": "A trailing plant with large leaves that produces round, orange fruit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_and_fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pumpkin</w> grew rapidly across the garden soil during the summer.",
                            "target_lang_translations": {
                                "ru": "<w>Тыква</w> быстро разрослась по садовой земле за лето.",
                                "zh": "夏天的时候，<w>南瓜</w>在花园的土地上迅速蔓延生长。"
                            }
                        },
                        {
                            "text": "Farmers need plenty of space to grow a healthy <w>pumpkin</w>.",
                            "target_lang_translations": {
                                "ru": "Фермерам нужно много места, чтобы вырастить здоровую <w>тыкву</w>.",
                                "zh": "农民需要充足的空间来种植健康的<w>南瓜</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pumpkin seed",
                        "pumpkin vine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стелющееся растение с крупными листьями, которое дает круглые оранжевые плоды.",
                        "zh": "一种叶片宽大、结出圆形橙色果实的蔓生植物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тыква",
                                "target_lang_sense_clarification": "растение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "南瓜",
                                "target_lang_sense_clarification": "指南瓜植株"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce6d5719-1a9b-3d84-ac51-7c8951783021",
                    "sense_definition": "A term of affection used for someone small, cute, or loved.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Come here and give me a hug, my little <w>pumpkin</w>.",
                            "target_lang_translations": {
                                "ru": "Иди сюда и обними меня, моя маленькая <w>тыковка</w>.",
                                "zh": "过来，让我也抱抱，我的<w>小宝贝</w>。"
                            }
                        },
                        {
                            "text": "Don't worry, <w>pumpkin</w>, everything will be okay in the morning.",
                            "target_lang_translations": {
                                "ru": "Не волнуйся, <w>тыковка</w>, утром всё будет хорошо.",
                                "zh": "别担心，<w>小宝贝</w>，明天早上一切都会好起来的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sweetie",
                        "darling",
                        "honey"
                    ],
                    "common_phrases": [
                        "little pumpkin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a term of endearment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое обращение к кому-то маленькому, милому или любимому.",
                        "zh": "用于称呼可爱、亲近之人的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тыковка",
                                "target_lang_sense_clarification": "ласковое обращение"
                            },
                            {
                                "target_lang_word": "лапочка",
                                "target_lang_sense_clarification": "аналог по смыслу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小宝贝",
                                "target_lang_sense_clarification": "亲昵称呼"
                            },
                            {
                                "target_lang_word": "心肝",
                                "target_lang_sense_clarification": "亲昵称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6392f453-0cf4-38cb-8a02-1f5cb582ccd9",
                    "sense_definition": "A deep orange color typical of the ripe fruit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evening sky turned a beautiful shade of <w>pumpkin</w> as the sun set.",
                            "target_lang_translations": {
                                "ru": "На закате вечернее небо окрасилось в красивый оттенок <w>тыквы</w>.",
                                "zh": "日落时分，晚霞变成了美丽的<w>南瓜</w>色。"
                            }
                        },
                        {
                            "text": "She wore a bright <w>pumpkin</w> scarf to match the autumn leaves.",
                            "target_lang_translations": {
                                "ru": "Она надела яркий шарф <w>тыквенного</w> цвета под стать осенним листьям.",
                                "zh": "她戴了一条鲜艳的<w>南瓜</w>色围巾，与秋叶相映成趣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "orange"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насыщенный оранжевый цвет, характерный для спелого плода.",
                        "zh": "一种深橙色，类似于成熟南瓜的颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тыквенный цвет",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "南瓜色",
                                "target_lang_sense_clarification": "颜色名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
