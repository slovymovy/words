            {
                "entry_id": "8e07f260-8cf8-3ecf-9a9c-4923a5deba19",
                "word": "coadjuteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "de923697-1923-47f6-86aa-5289c0bfd10f",
                        "entry_id": "8e07f260-8cf8-3ecf-9a9c-4923a5deba19",
                        "tags": [
                            "plural"
                        ],
                        "form": "coadjuteurs"
                    },
                    {
                        "form_id": "9d2b75df-2c7d-4f46-b7af-7a91711f3aa5",
                        "entry_id": "8e07f260-8cf8-3ecf-9a9c-4923a5deba19",
                        "tags": [
                            "feminine"
                        ],
                        "form": "coadjutrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d5eb611-7c64-3e82-b06b-cfb799597368",
                        "entry_id": "8e07f260-8cf8-3ecf-9a9c-4923a5deba19",
                        "glosses": [
                            "Celui qui est adjoint à un prélat de l’Église catholique romaine, pour l’aider à remplir ses fonctions, et qui est ordinairement destiné à lui succéder après sa mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25658415-a81d-47bd-98d3-30b1068f9ef8",
                                "sense_id": "8d5eb611-7c64-3e82-b06b-cfb799597368",
                                "text": "Je vais voir, dans quelques moments, monseigneur le coadjuteur, et il vous témoignera bientôt sa satisfaction."
                            },
                            {
                                "example_id": "d6197815-a8ea-4322-b07f-c7e130253e67",
                                "sense_id": "8d5eb611-7c64-3e82-b06b-cfb799597368",
                                "text": "Quant au coadjuteur, M. Pictursson, il faisait actuellement une tournée épiscopale dans le bailliage du nord."
                            },
                            {
                                "example_id": "cb8849e0-4f64-48d4-a6ae-1988142b60d3",
                                "sense_id": "8d5eb611-7c64-3e82-b06b-cfb799597368",
                                "text": "[…] il était nommé coadjuteur de l’abbé Olivieri, et après plusieurs voyages en Afrique, de retour à Rome, il se préparait à une grande campagne de rédemption au centre de ce pays."
                            }
                        ]
                    },
                    {
                        "sense_id": "12df18ea-27b3-3174-99d2-6aedb3887b78",
                        "entry_id": "8e07f260-8cf8-3ecf-9a9c-4923a5deba19",
                        "glosses": [
                            "Moine ou nonne qui assiste un abbé, une abbesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1566d73f-e080-4d0b-838a-dd8f63ab9a39",
                                "sense_id": "12df18ea-27b3-3174-99d2-6aedb3887b78",
                                "text": "Le père coadjuteur."
                            },
                            {
                                "example_id": "8bad7920-3945-4a69-9684-17853df11db5",
                                "sense_id": "12df18ea-27b3-3174-99d2-6aedb3887b78",
                                "text": "Le frère coadjuteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f48d8f62-06bf-41f2-b4b2-40fcb69748a5",
                        "source_entry_id": "8e07f260-8cf8-3ecf-9a9c-4923a5deba19",
                        "target_lang_word": "Koadjutor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1ba269d5-f415-42b3-9e40-ae43e2b8012f",
                        "source_entry_id": "8e07f260-8cf8-3ecf-9a9c-4923a5deba19",
                        "target_lang_word": "coadjutor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coadjutor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "007949de-9958-32bc-8ff5-d054902d45c5",
                                        "entry_id": "3eb2655c-0dea-324a-ab9c-82ab6c01b000",
                                        "glosses": [
                                            "An assistant or helper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60575512-2555-49fd-a7f4-bfa8d0f94c58",
                                                "sense_id": "007949de-9958-32bc-8ff5-d054902d45c5",
                                                "text": "Then have the lady patronesses and their active coadjutors, whether noble or ignoble, all the work of beating up for recruits to go over again."
                                            },
                                            {
                                                "example_id": "e889e16c-9270-40c5-876a-c862e2a0548c",
                                                "sense_id": "007949de-9958-32bc-8ff5-d054902d45c5",
                                                "text": "The mountaineer, with all his pulses aquiver, looked down into his coadjutor’s white, startled face."
                                            },
                                            {
                                                "example_id": "1eff7c02-a1be-424b-a9b5-a80d31e24ad1",
                                                "sense_id": "007949de-9958-32bc-8ff5-d054902d45c5",
                                                "text": "Hitherto I have been but the witness, little more; and I should hardly think now to take another tone, that of your coadjutor, for the time, did I not perceive in you,—at the crisis too—a troubled hesitancy, proceeding, I doubt not, from the clash of military duty with moral scruple—scruple vitalized by compassion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ba147dc-3668-3d61-a752-5d64f26df2f1",
                                        "entry_id": "3eb2655c-0dea-324a-ab9c-82ab6c01b000",
                                        "glosses": [
                                            "An assistant to a bishop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43355767-9638-4cf9-8387-e7b0d2ecc7c2",
                                                "sense_id": "6ba147dc-3668-3d61-a752-5d64f26df2f1",
                                                "text": "When old age rendered any Bishop unable to perform his duties, the first example of which occurs AD 211, when Alexander became coadjutor to Narcissus at Jerusalem"
                                            },
                                            {
                                                "example_id": "de08c239-5cc9-48be-8804-8be681fdc4ab",
                                                "sense_id": "6ba147dc-3668-3d61-a752-5d64f26df2f1",
                                                "text": "August then appointed Prince George III of Anhalt (who was both a theologian and a priest as well as a prince) to be his coadjutor in spiritual matters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2a47d22-5675-41cd-a18c-f22ed2374275",
                        "source_entry_id": "8e07f260-8cf8-3ecf-9a9c-4923a5deba19",
                        "target_lang_word": "coadjutor",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coadjutor",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "95eabac1-b2e5-3b54-9548-f7debc04ec16",
                                        "entry_id": "c92d3ca4-6cb5-321f-9347-73b7a2e1935b",
                                        "glosses": [
                                            "ajudante, auxiliar, adjunto"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b55afdf2-47e3-4b7b-8f54-95d678accc42",
                                                "sense_id": "95eabac1-b2e5-3b54-9548-f7debc04ec16",
                                                "text": "E o Santa Rosa ali à espera do coadjutor, de uma perna de governo que fizesse as vezes do meu avô."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
