                    {
                        "sense_id": "62364e37-56e3-334a-b530-b217e2918458",
                        "entry_id": "1e44e78c-6de1-320d-8675-f0122be6c00d",
                        "glosses": [
                            "van iets of iemand dat het een brommend geluid maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f908a279-70d4-40b4-85bc-d568d6398e26",
                                "sense_id": "62364e37-56e3-334a-b530-b217e2918458",
                                "text": "Op het bureau in Rijssen bleek de bromfiets maar liefst 83 kilometer per uur te kunnen rijden. Vandaar dat tegen de jongen opnieuw een proces-verbaal is opgemaakt. Hij kreeg tevens een brief mee met een laatste waarschuwing. Als hij nog eens door dezelfde reden wordt aangehouden, is de Markeloër zijn brommende ros kwijt."
                            },
                            {
                                "example_id": "3ca8e1e6-a609-4c69-a43d-e1279cf96b40",
                                "sense_id": "62364e37-56e3-334a-b530-b217e2918458",
                                "text": "Onderweg merkte Marco aan alles dat er iets niet klopte. ,,Ik zag overal politiebootjes varen en hoorde een heel vreemd geluid. Het was een ongekend harde, brommende suis. Alsof de schipper vol gas gaf, maar de boot helemaal niet meer onder controle had.\""
                            }
                        ]
                    }
