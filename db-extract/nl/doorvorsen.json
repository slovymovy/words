                                                "sense_id": "4d8fc36e-fbdb-3ac6-b7bb-a28953a7c773",
                                                "text": "He was asked to investigate a robbery."
                                            },
                                            {
                                                "example_id": "b9b9da2c-41bb-4c28-a5c9-a43e0fbab03a",
                                                "sense_id": "4d8fc36e-fbdb-3ac6-b7bb-a28953a7c773",
                                                "text": "We investigated the presence of CNM in ornithophagous ticks from migrating birds."
                                            },
                                            {
                                                "example_id": "81cf77f0-6f63-4e1f-b72c-71d0ed87f965",
                                                "sense_id": "4d8fc36e-fbdb-3ac6-b7bb-a28953a7c773",
                                                "text": "The current study investigates autoantibodies against steroid synthesis enzymes in dogs with spontaneous hypoadrenocorticism."
                                            },
                                            {
                                                "example_id": "749ad9b6-3d23-4ddb-be80-aee6c2b69723",
                                                "sense_id": "4d8fc36e-fbdb-3ac6-b7bb-a28953a7c773",
                                                "text": "ESP, using the tools of corpus linguistics, has advanced the methodologies for investigating discipline-specific language, yet there has been little cross-fertilization so far with disciplinary literacy in secondary education."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81fd7aba-ffbd-33c8-a69e-022f1c05ca97",
                                        "entry_id": "7c1412a9-d394-3123-b861-c98f2dacbd81",
                                        "glosses": [
                                            "To examine, look into, or scrutinize in order to discover something hidden or secret."
