                "senses": [
                    {
                        "sense_id": "212b8c64-cf0d-3b75-9860-8ac93cb61395",
                        "entry_id": "bf0e3af2-87e3-3f97-92a8-a83e81dfeeaf",
                        "glosses": [
                            "A female given name originating as a coinage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e3c8a54-8804-4ebc-a547-7b930a2e85b2",
                                "sense_id": "212b8c64-cf0d-3b75-9860-8ac93cb61395",
                                "text": "Half-way down the shore Evangeline waited in silence,\nNot overcome with grief, but strong in the hour of affliction."
                            },
                            {
                                "example_id": "1efc0f5b-2b9b-40d6-95d7-8561492ba247",
                                "sense_id": "212b8c64-cf0d-3b75-9860-8ac93cb61395",
                                "text": "\"What's the little missy's name?\" said Tom, at last, when he thought matters were ripe to push such an inquiry.\n\"Evangeline St. Clare,\" said the little one, \"though papa and everybody else call me Eva.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a7d1b93-1d09-4a16-8964-0a5791dabcfd",
                        "source_entry_id": "bf0e3af2-87e3-3f97-92a8-a83e81dfeeaf",
                        "source_sense_id": "212b8c64-cf0d-3b75-9860-8ac93cb61395",
