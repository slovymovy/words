                            {
                                "target_lang_word": "fessura",
                                "target_lang_sense_clarification": "apertura stretta e lunga"
                            },
                            {
                                "target_lang_word": "crepaccio",
                                "target_lang_sense_clarification": "spaccatura profonda, spesso nel terreno o nel ghiaccio"
                            }
                        ]
