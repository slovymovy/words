                        "sense_id": "dd375c90-9726-3cbd-b063-5263c298c67b",
                        "entry_id": "c3452e0d-b3cc-3877-b57a-8ed6912be9d8",
                        "glosses": [
                            "związany z epoką panowania królowej Wiktorii Hanowerskiej"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fb556a09-058d-355a-bb1b-189e184b63ec",
                        "entry_id": "c3452e0d-b3cc-3877-b57a-8ed6912be9d8",
                        "glosses": [
                            "odznaczający się eklektyzmem oraz pompatycznością"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e71972-1a13-4632-8070-e81b11e3656f",
                                "sense_id": "fb556a09-058d-355a-bb1b-189e184b63ec",
                                "text": "W 1858 roku na zachodnich obrzeżach Toronto powstała wiktoriańska gotycka rezydencja zbudowana przez Sir Kazimierza Gzowskiego"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cae044e-0a53-425e-b47f-6f6d26f7780b",
                        "source_entry_id": "c3452e0d-b3cc-3877-b57a-8ed6912be9d8",
                        "source_sense_id": "dd375c90-9726-3cbd-b063-5263c298c67b",
                        "target_lang_word": "Victorian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Victorian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "692cdb27-3a32-30a8-bb9a-6f465da79de8",
                                        "entry_id": "2cf0c672-41a4-3202-9ca7-133f3babea83",
                                        "glosses": [
                                            "Of or relating to the reign of Queen Victoria from 1837 to 1901, or that period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b65ace71-00bf-43d4-8069-96c343ecb6f9",
                                                "sense_id": "692cdb27-3a32-30a8-bb9a-6f465da79de8",
                                                "text": "From the platforms at Wapping or Rotherhithe you can see the tunnel fleetingly illuminated as the trains approach; it looks so incredibly Victorian that you expect to see Jack the Ripper loitering between the arches."
                                            },
                                            {
                                                "example_id": "d7041abe-c80e-41ba-8800-9010b5ab2d1f",
                                                "sense_id": "692cdb27-3a32-30a8-bb9a-6f465da79de8",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains. Isolating a city's effluent and shipping it away in underground sewers has probably saved more lives than any medical procedure except vaccination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0864ab3d-bef1-335f-8eff-0ddd4d0472e0",
                                        "entry_id": "2cf0c672-41a4-3202-9ca7-133f3babea83",
                                        "glosses": [
                                            "Of or relating to the culture or social conditions of that period.",
                                            "In a situation of poverty and social injustice; Dickensian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce800a40-8152-4d94-9d13-02606e71bfb7",
                                                "sense_id": "0864ab3d-bef1-335f-8eff-0ddd4d0472e0",
                                                "text": "In some cases, teachers reported being aware of pupils living in \"Victorian conditions\", of youngsters coming to school with no socks or coat and of more families depending on food banks."
                                            },
                                            {
                                                "example_id": "0cc695d1-2884-4c5c-8af9-5679d7e167b8",
                                                "sense_id": "0864ab3d-bef1-335f-8eff-0ddd4d0472e0",
                                                "text": "I'm not proposing a return to Victorian working conditions, or anything like that, but there are two areas where things need changing."
                                            },
                                            {
                                                "example_id": "98e25b58-c0de-4959-b343-2e7f7c63636b",
                                                "sense_id": "0864ab3d-bef1-335f-8eff-0ddd4d0472e0",
                                                "text": "While masturbation was never favored in Judeo-Christian tradition, Victorian morality, along with the Great Awakening and other religious revivals in America, created a perfect storm for people to really get obsessed with it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a84a16b-c547-316e-a377-2769f1740f7c",
                                        "entry_id": "2cf0c672-41a4-3202-9ca7-133f3babea83",
                                        "glosses": [
                                            "Of or relating to the culture or social conditions of that period.",
                                            "Of the style of architecture or furnishings of that period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65f1d8a5-71bf-4b91-a71a-b086accc9cd3",
                                                "sense_id": "5a84a16b-c547-316e-a377-2769f1740f7c",
                                                "text": "Unhappily, however, all that remains of Cherhill's claim to an old manor house is a rather cold ungabled building, blue-slated in hard ruled lines, and a porch which might have been transplanted from a late Victorian house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "531cea5d-5dcd-38db-a309-374d7f7edbf7",
                                        "entry_id": "2cf0c672-41a4-3202-9ca7-133f3babea83",
                                        "glosses": [
                                            "Of or displaying the (supposed) ideals or standards of morality of that period; conservative; also, old-fashioned, out-of-date."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4c422d9-67ce-4cb0-8637-e8f7af040830",
                                                "sense_id": "531cea5d-5dcd-38db-a309-374d7f7edbf7",
                                                "text": "“I’m asking you your intentions, damn it!” said Wimsey, “and if that’s not Victorian enough, I don’t know what is.”"
                                            },
                                            {
                                                "example_id": "97bdf36e-463c-40d5-967f-a12ca8867813",
                                                "sense_id": "531cea5d-5dcd-38db-a309-374d7f7edbf7",
                                                "text": "The Labor Church did not last; but the reaction did; and the last I heard of its founder was that he was helping the movement against Victorian prudery in a very practical way as a Nudist photographer, […]"
                                            },
                                            {
                                                "example_id": "e14754eb-c9a6-40ee-b54f-c75ba18353ef",
                                                "sense_id": "531cea5d-5dcd-38db-a309-374d7f7edbf7",
                                                "text": "Even the legalization and vastly increased approval of same-sex marriage has a Victorian aspect. The early same-sex marriage advocates Andrew Sullivan and Jonathan Rauch argued that marriage would domesticate homosexuals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Victorian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66794e73-ea16-38e9-a229-c66086d5d835",
                                        "entry_id": "bf2db115-ff4d-3608-a36f-f0afe077dfbb",
                                        "glosses": [
                                            "A person born in or living in the Victorian period, or exhibiting characteristics of that period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5cda5e4-d2ea-4bca-9662-9f2115e883d6",
                                                "sense_id": "66794e73-ea16-38e9-a229-c66086d5d835",
                                                "text": "What a perfect Victorian you are, Charles. I should like to keep you in a glass case."
                                            },
                                            {
                                                "example_id": "e8ee3ca3-e266-4998-8407-ae29f1a5c69f",
                                                "sense_id": "66794e73-ea16-38e9-a229-c66086d5d835",
                                                "text": "It was not until the late 1800s when older members of New York society, aghast at the invasion of vulgar \"new money,\" devised a daunting system of social rules – not to mention silverware – meant to repel anyone of humble origins who dared to sit down at one of their twelve-course dinners. It was the Victorians who gave us such useful implements as the strawberry knife."
                                            },
                                            {
                                                "example_id": "5db526b8-5446-4561-bb42-7a2f0184eab7",
                                                "sense_id": "66794e73-ea16-38e9-a229-c66086d5d835",
                                                "text": "The arrival of the railway turned this isolated fishing village into a popular seaside destination for Victorians who came to breathe fresh sea air, clear their lungs or take the waters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8513610-fe27-33e0-90b8-fbe7a067a0f2",
                                        "entry_id": "bf2db115-ff4d-3608-a36f-f0afe077dfbb",
                                        "glosses": [
                                            "An item of furniture from that period."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccea166a-e9fe-3fde-963b-b294ced11862",
                                        "entry_id": "bf2db115-ff4d-3608-a36f-f0afe077dfbb",
                                        "glosses": [
                                            "A house built in the Victorian architectural style."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8421eb4a-fb3c-48cd-94b1-140e57f47051",
                                                "sense_id": "ccea166a-e9fe-3fde-963b-b294ced11862",
                                                "text": "The commercial resurgence brought about by the area's changing tastes is reflected in midtown's conglomeration of refurbished Victorians, apartments, specialty shops, offices, corner groceries, restaurants, single-family homes, and bed and breakfast inns."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Victorian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5a6e454-0631-306f-9cfb-9b8072d4495f",
                                        "entry_id": "8d583cfa-ecac-3e20-8b6c-efb5745efcd4",
                                        "glosses": [
                                            "Of, from or relating to the state of Victoria, Australia."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
