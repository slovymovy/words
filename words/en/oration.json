    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee830b68-8721-344a-b2ae-de059799c90c",
                    "sense_definition": "A formal, often ceremonial speech delivered to a public audience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senator delivered an impassioned <w>oration</w> honoring the fallen soldiers."
                        },
                        {
                            "text": "Many guests were moved to tears during the funeral <w>oration</w>."
                        }
                    ],
                    "synonyms": [
                        "address",
                        "discourse"
                    ],
                    "common_phrases": [
                        "funeral oration",
                        "deliver an oration"
                    ]
                },
                {
                    "sense_id": "6ec1c755-ae28-3ea2-853a-a7382e71ea3a",
                    "sense_definition": "A lengthy speech or argument made in a private or informal setting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt embarrassed after giving a long <w>oration</w> to her family at the dinner table."
                        },
                        {
                            "text": "His father paused his <w>oration</w> only when the tea was finally served."
                        }
                    ],
                    "synonyms": [
                        "lecture",
                        "spiel"
                    ]
                },
                {
                    "sense_id": "029687aa-5673-3f6a-bc1d-869a7868fa14",
                    "sense_definition": "A specific form of short, solemn liturgical prayer recited by the celebrant on behalf of the congregation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "prayer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest concluded the opening rite with a solemn <w>oration</w>."
                        },
                        {
                            "text": "The congregation bowed their heads in silence as the final <w>oration</w> was spoken."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8a355c0-79b8-3c64-b2e1-669e2af59fb5",
                    "sense_definition": "To deliver a speech or hold forth at length.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He loved to <w>oration</w> about local politics whenever a crowd gathered."
                        },
                        {
                            "text": "Stop lecturing and <w>orationing</w> when you do not even understand the issue."
                        }
                    ],
                    "synonyms": [
                        "orate",
                        "speechify",
                        "hold forth"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or nonstandard compared to 'orate'."
                        }
                    ]
                }
            ]
        }
    ]
