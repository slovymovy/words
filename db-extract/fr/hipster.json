                                            "US",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07e1fa32-ae53-3767-8650-e5cc5d414faf",
                                        "entry_id": "dc0995f8-bf2c-3d12-9044-dff36ae151a4",
