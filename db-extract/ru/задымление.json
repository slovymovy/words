                    },
                    {
                        "translation_id": "3531a828-79e6-4051-a9e8-15d0c7a16d79",
                        "source_entry_id": "29f12651-4cde-3d93-b2af-7bba8b7e7774",
                        "source_sense_description": "действие по значению гл. задымлять; задымить; заполнение, пропитывание чего-либо дымом",
                        "target_lang_word": "Verrauchung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ec9d6a94-462e-4290-ac5c-39b00869d9e5",
                        "source_entry_id": "29f12651-4cde-3d93-b2af-7bba8b7e7774",
                        "source_sense_description": "насыщенность дымом, наличие большого количества дыма; пропитанность копотью",
                        "target_lang_word": "smokescreen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smokescreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "904db0c4-b9ae-37f8-b560-fae780045cbd",
                                        "entry_id": "febe71c2-53ae-39ea-9728-5b71324879d2",
                                        "glosses": [
                                            "Smoke used as a disguise, mask or cover, as of troops in battle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5be7d06a-22af-4ae3-b43a-32b3c7e3d5b7",
                                                "sense_id": "904db0c4-b9ae-37f8-b560-fae780045cbd",
                                                "text": "Ensign Whitely began to tell of the surprise encounter of Admiral Sprague’s escort-carrier force with the main battle line of the Japanese Navy off Samar, in a chaos of rain squalls and smoke screens."
                                            },
                                            {
                                                "example_id": "443d7cff-a99c-4090-9b38-6c3a8d5c8693",
                                                "sense_id": "904db0c4-b9ae-37f8-b560-fae780045cbd",
                                                "text": "C.I.E. Class \"D14\" 4-4-0 No. 89 covers its tracks with a magnificent smokescreen as it pulls out of Dun Laoghaire with the 9.0 a.m. boat train for Dublin."
                                            },
                                            {
                                                "example_id": "f1336a0b-be8c-480f-ab5c-54b97402a5cd",
                                                "sense_id": "904db0c4-b9ae-37f8-b560-fae780045cbd",
                                                "text": "However, before most of this was experimentally and observationally discovered, they were perhaps best known for their “almost unique” ability to squirt ink when harangued, creating a smokescreen before jetting off to safety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07be60c-132e-324d-8112-5d3ecd686f0f",
                                        "entry_id": "febe71c2-53ae-39ea-9728-5b71324879d2",
                                        "glosses": [
                                            "Anything used metaphorically to conceal or distract."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e95e466-16ac-4e98-835c-c3abaef2ace2",
                                                "sense_id": "a07be60c-132e-324d-8112-5d3ecd686f0f",
                                                "text": "All that talk is just a smokescreen to disguise the fact that he has nothing to say."
                                            },
                                            {
                                                "example_id": "e8ca12f3-38bc-4941-a7ad-416ee7129ccd",
                                                "sense_id": "a07be60c-132e-324d-8112-5d3ecd686f0f",
                                                "text": "It was all very plausible and, as he poured out his smokescreen of words, I became fidgety for fear Fallon would be too direct with him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
