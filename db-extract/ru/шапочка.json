                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "bf715916-626f-4d77-82d4-10333a0cfcb7",
                                "sense_id": "86b441d6-32a7-3445-ae83-4c0084e984fa",
                                "text": "Проходи́ли проститу́тки ми́мо, в зелёных, кра́сных, чёрных и бе́лых ша́почках, краси́вые, как ку́клы[...]",
                                "translation": "A bevy of prostitutes walked by dressed in green, red, black and white hats, pretty as dolls…",
                                "english": "A bevy of prostitutes walked by dressed in green, red, black and white hats, pretty as dolls…"
                            }
                        ]
                    }
