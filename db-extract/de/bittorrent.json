                "senses": [
                    {
                        "sense_id": "31082453-201b-39cc-ae5e-f6debc5ffb45",
                        "entry_id": "ad727a63-663f-345f-8b93-88f662beaa19",
                        "glosses": [
                            "ein Filesharing-Protokoll, das besonders für große Dateien geeignet ist und von der Firma BitTorrent, Inc. entwickelt wurde"
                        ],
                        "tags": [
                            "kurz für „BitTorrent peer-to-peer protocol“"
                        ],
                        "examples": [
                            {
                                "example_id": "3916a891-dcf1-436b-bba4-1678c580a316",
                                "sense_id": "31082453-201b-39cc-ae5e-f6debc5ffb45",
                                "text": "BitTorrent ist eines der am weitesten verbreiteten Protokolle für den Transfer umfangreicher Dateien."
                            },
                            {
                                "example_id": "1531ae3c-fc4e-4f17-8b4b-087f822e8451",
                                "sense_id": "31082453-201b-39cc-ae5e-f6debc5ffb45",
                                "text": "Bereits 2001 existierten BitTorrent und eDonkey, um 2003 hatten die beiden Tauschprotokolle massive Verbreitung gefunden und waren, so diverse Studien, für den größten Teil des Internet-Traffics verantwortlich."
                            },
                            {
                                "example_id": "794a3fa3-63ea-41b6-a733-81b906d7957c",
                                "sense_id": "31082453-201b-39cc-ae5e-f6debc5ffb45",
                                "text": "Auf der anderen Seite ist zu berücksichtigen, dass die Anbieter oder \"Quellen\", die geschützte Werke zum Download zur Verfügung stellen und diejenigen, die mittels BitTorrent solche herunterladen, ebenfalls nicht anders einzuordnen und zu beurteilen sind als die Nutzer herkömmlicher P2P-Netzwerke."
                            }
                        ],
