                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "98f497d3-8a76-4889-9d03-cfcc990145eb",
                                "sense_id": "452eb534-e8c7-31e6-9779-0f126b08861f",
                                "text": "I lately left a furrow, one or twayne,\n Unplough'd, the which my coulter hath not cleft […]"
                            },
                            {
                                "example_id": "4510c85b-b409-4b2a-b345-f434532bdb44",
                                "sense_id": "452eb534-e8c7-31e6-9779-0f126b08861f",
                                "text": "What is it but a servitude like that impos'd by the Philistims, not to be allow'd the sharpning of our own axes and coulters, but we must repair from all quarters to twenty licencing forges."
                            },
                            {
                                "example_id": "527305da-1c9e-44f7-8cf9-f84029016f62",
                                "sense_id": "452eb534-e8c7-31e6-9779-0f126b08861f",
                                "text": "With colters bright the rushy sward bisect,\n And in new veins the gushing rills direct […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
