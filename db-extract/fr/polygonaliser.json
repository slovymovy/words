                "senses": [
                    {
                        "sense_id": "0167745f-c1b0-3d3f-ad46-44fda1830e57",
                        "entry_id": "e4bb5dcb-ae49-3cdb-8940-720aed7f65ba",
                        "glosses": [
                            "Donner un caractère polygonal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d1569ba-9c6a-4660-ac78-f7e96a6377b0",
                                "sense_id": "0167745f-c1b0-3d3f-ad46-44fda1830e57",
                                "text": "Il ne souscrivit pas non plus à la tentation de Penrose de « polygonaliser » la courbe et d’expliquer le stylobate du Parthénon par la mathématique de la parabole."
                            },
                            {
                                "example_id": "a16360a9-d097-416b-a920-35af324513ad",
                                "sense_id": "0167745f-c1b0-3d3f-ad46-44fda1830e57",
                                "text": "Enfin, on note des objets circulaires qui, en haute résolution, apparaissent clairement comme étant des « oignons » de graphite, une espèce carbonée découverte récemment). Ces oignons d’environ 100 nm de diamètre tendent à se polygonaliser quand ils grossissent."
                            }
                        ]
                    }
                ],
