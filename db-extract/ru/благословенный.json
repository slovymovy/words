                        "examples": [
                            {
                                "example_id": "91bdb0b2-e2c5-4337-aa3c-386e84cb126c",
                                "sense_id": "270f4737-d8ee-36ec-ad65-236b01678a68",
                                "text": "— Вот мы и в гора́х, — сказа́л мне това́рищ, когда́ парохо́д стал, сокраща́ясь, удаля́ться. — Жизнь оста́лась где́-то там, за э́тими гора́ми, а мы вступа́ем в благослове́нную страну́ той тишины́, кото́рой нет и́мени на на́шем языке́.",
                                "translation": "Ivan Bunin",
                                "english": "Ivan Bunin"
                            }
                        ]
                    }
