{
    "word_family": [
        "triumphant",
        "triumphal",
        "triumphantly",
        "triumphalism"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "399e6a1f-9eff-30bb-8992-d6207e41eb6c",
                    "sense_definition": "A conclusive success or victory following an effort, conflict, or difficult struggle.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "success_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team celebrated their <w>triumph</w> in the championship final.",
                            "target_lang_translations": {
                                "ru": "Команда праздновала свой <w>триумф</w> в финале чемпионата.",
                                "zh": "该队庆祝了他们在冠军决赛中的<w>胜利</w>。"
                            }
                        },
                        {
                            "text": "Her graduation was a moment of personal <w>triumph</w> after years of hard work.",
                            "target_lang_translations": {
                                "ru": "Её выпускной стал моментом личного <w>триумфа</w> после долгих лет упорного труда.",
                                "zh": "她的毕业是多年努力后个人<w>成就</w>的时刻。"
                            }
                        }
                    ],
                    "synonyms": [
                        "victory",
                        "success",
                        "conquest",
                        "achievement",
                        "win"
                    ],
                    "antonyms": [
                        "defeat",
                        "failure",
                        "loss"
                    ],
                    "common_phrases": [
                        "triumph over adversity",
                        "great triumph",
                        "personal triumph",
                        "moment of triumph"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решающий успех или победа после усилий, конфликта или трудной борьбы.",
                        "zh": "经过努力、冲突或艰难斗争后取得的决定性成功或胜利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "триумф",
                                "target_lang_sense_clarification": "блестящий успех"
                            },
                            {
                                "target_lang_word": "победа",
                                "target_lang_sense_clarification": "успех в борьбе"
                            },
                            {
                                "target_lang_word": "торжество",
                                "target_lang_sense_clarification": "великое достижение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胜利",
                                "target_lang_sense_clarification": "在竞争或斗争中取得成功"
                            },
                            {
                                "target_lang_word": "成就",
                                "target_lang_sense_clarification": "经过努力取得的成果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b65c42d-6e20-3910-9986-42371507b879",
                    "sense_definition": "A state of great joy, pride, or exultation resulting from success or victory.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "success_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He raised his arms in <w>triumph</w> as he crossed the finish line first.",
                            "target_lang_translations": {
                                "ru": "Он вскинул руки в <w>ликовании</w>, первым пересекая финишную черту.",
                                "zh": "他第一个冲过终点线时，<w>欢呼</w>着举起了双臂。"
                            }
                        },
                        {
                            "text": "The crowd roared in <w>triumph</w> when their team scored the winning goal.",
                            "target_lang_translations": {
                                "ru": "Толпа взревела от <w>восторга</w>, когда их команда забила победный гол.",
                                "zh": "当他们的球队踢进致胜一球时，人群<w>欢欣鼓舞</w>地欢呼起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exultation",
                        "jubilation",
                        "elation",
                        "joy"
                    ],
                    "antonyms": [
                        "despair",
                        "sorrow"
                    ],
                    "common_phrases": [
                        "in triumph",
                        "shout in triumph",
                        "smile in triumph"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние огромной радости, гордости или ликования от успеха или победы.",
                        "zh": "因成功或胜利而产生的巨大喜悦、自豪或狂喜的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ликование",
                                "target_lang_sense_clarification": "бурная радость"
                            },
                            {
                                "target_lang_word": "торжество",
                                "target_lang_sense_clarification": "чувство победителя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狂喜",
                                "target_lang_sense_clarification": "极度兴奋和高兴"
                            },
                            {
                                "target_lang_word": "欢欣鼓舞",
                                "target_lang_sense_clarification": "形容因胜利而振奋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "799ae5dc-1fc2-3ed2-a7d9-75e87b729567",
                    "sense_definition": "A work of art, cuisine, or other creation of very high quality and success.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "success_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics described the new bridge as an engineering <w>triumph</w>.",
                            "target_lang_translations": {
                                "ru": "Критики назвали новый мост инженерным <w>триумфом</w>.",
                                "zh": "评论家们称这座新桥是工程学上的<w>杰作</w>。"
                            }
                        },
                        {
                            "text": "The chef's dessert was a <w>triumph</w> of flavor and presentation.",
                            "target_lang_translations": {
                                "ru": "Десерт шеф-повара стал настоящим <w>триумфом</w> вкуса и подачи.",
                                "zh": "这位厨师的甜点在口味和摆盘上都是<w>巅峰之作</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "masterpiece",
                        "tour de force",
                        "success"
                    ],
                    "antonyms": [
                        "disaster",
                        "failure",
                        "flop"
                    ],
                    "common_phrases": [
                        "architectural triumph",
                        "cinematic triumph",
                        "absolute triumph"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произведение искусства, кулинарии или другое творение высочайшего качества.",
                        "zh": "艺术、烹饪或其他领域中极高品质且成功的作品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "триумф",
                                "target_lang_sense_clarification": "выдающееся достижение"
                            },
                            {
                                "target_lang_word": "шедевр",
                                "target_lang_sense_clarification": "вершина мастерства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杰作",
                                "target_lang_sense_clarification": "出色的作品"
                            },
                            {
                                "target_lang_word": "巅峰之作",
                                "target_lang_sense_clarification": "最高水平的成就"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0069c3f-56ac-35ea-88e6-220d5e98ecf4",
                    "sense_definition": "A public ceremony or procession, especially in ancient Rome, held to celebrate a military victory.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "success_ceremony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general returned to the city for a magnificent <w>triumph</w> in his honor.",
                            "target_lang_translations": {
                                "ru": "Генерал вернулся в город ради великолепного <w>триумфа</w> в свою честь.",
                                "zh": "将军回到城里，参加了为他举行的盛大<w>凯旋仪式</w>。"
                            }
                        },
                        {
                            "text": "Crowds gathered to watch the <w>triumph</w> parade through the streets.",
                            "target_lang_translations": {
                                "ru": "Толпы собрались посмотреть на парад <w>триумфа</w>, проходящий по улицам.",
                                "zh": "人群聚集在一起观看穿过街道的<w>凯旋仪式</w>游行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "procession",
                        "parade"
                    ],
                    "common_phrases": [
                        "Roman triumph"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичная церемония или шествие, особенно в Древнем Риме, в честь военной победы.",
                        "zh": "一种公开的仪式或游行，尤指古罗马时期为庆祝军事胜利而举行的活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "триумф",
                                "target_lang_sense_clarification": "историческая церемония"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凯旋仪式",
                                "target_lang_sense_clarification": "庆祝胜利的游行"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75f3cd59-60d3-3e53-979d-44ef47ab8984",
                    "sense_definition": "To achieve a victory; to prevail over rivals, challenges, or difficulties.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "to_succeed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We believe that truth and justice will eventually <w>triumph</w>.",
                            "target_lang_translations": {
                                "ru": "Мы верим, что правда и справедливость в конце концов <w>восторжествуют</w>.",
                                "zh": "我们相信真理和正义终将<w>获胜</w>。"
                            }
                        },
                        {
                            "text": "She <w>triumphed</w> over many difficulties to reach her current position.",
                            "target_lang_translations": {
                                "ru": "Она <w>восторжествовала</w> над многими трудностями, чтобы достичь своего нынешнего положения.",
                                "zh": "她<w>战胜</w>了许多困难才达到目前的位置。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prevail",
                        "succeed",
                        "win",
                        "conquer",
                        "overcome"
                    ],
                    "antonyms": [
                        "fail",
                        "lose",
                        "succumb"
                    ],
                    "common_phrases": [
                        "triumph over",
                        "triumph in the end"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одержать победу; взять верх над соперниками, вызовами или трудностями.",
                        "zh": "取得胜利；在竞争、挑战或困难中胜出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восторжествовать",
                                "target_lang_sense_clarification": "победить в итоге"
                            },
                            {
                                "target_lang_word": "победить",
                                "target_lang_sense_clarification": "одержать верх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获胜",
                                "target_lang_sense_clarification": "在比赛或竞争中取得胜利"
                            },
                            {
                                "target_lang_word": "战胜",
                                "target_lang_sense_clarification": "克服困难或对手"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db694e77-23d8-3979-8b6f-aeaf0025eeea",
                    "sense_definition": "To express great joy or exultation because of a success or victory.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "to_celebrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winning team <w>triumphed</w> loudly in the locker room.",
                            "target_lang_translations": {
                                "ru": "Победившая команда громко <w>ликовала</w> в раздевалке.",
                                "zh": "获胜的队伍在更衣室里大声<w>欢呼</w>。"
                            }
                        },
                        {
                            "text": "He <w>triumphed</w> over his opponent's mistake with a smug smile.",
                            "target_lang_translations": {
                                "ru": "Он <w>торжествовал</w> над ошибкой соперника с самодовольной улыбкой.",
                                "zh": "他带着自鸣得意的微笑，对对手的失误感到<w>得意洋洋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exult",
                        "rejoice",
                        "gloat",
                        "celebrate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать бурную радость или ликование по поводу успеха или победы.",
                        "zh": "因成功或胜利而表现出极大的喜悦或狂喜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ликовать",
                                "target_lang_sense_clarification": "бурно радоваться"
                            },
                            {
                                "target_lang_word": "торжествовать",
                                "target_lang_sense_clarification": "праздновать победу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "欢呼",
                                "target_lang_sense_clarification": "大声表达喜悦"
                            },
                            {
                                "target_lang_word": "得意洋洋",
                                "target_lang_sense_clarification": "因胜利而表现出满足感"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5a31e38d-16ae-36b1-af50-81bb1ead5811",
                    "sense_definition": "A former British brand of motor car and motorcycle.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "He spent the weekend restoring his vintage <w>Triumph</w>.",
                            "target_lang_translations": {
                                "ru": "Он провел выходные, восстанавливая свой старинный <w>Триумф</w>.",
                                "zh": "他花了一个周末修复他那辆老式<w>凯旋</w>摩托车。"
                            }
                        },
                        {
                            "text": "The museum displayed a rare <w>Triumph</w> from the 1960s.",
                            "target_lang_translations": {
                                "ru": "В музее был выставлен редкий <w>Триумф</w> 1960-х годов.",
                                "zh": "博物馆展出了一辆罕见的20世纪60年代的<w>凯旋</w>汽车。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бывшая британская марка автомобилей и мотоциклов.",
                        "zh": "一个已停产的英国汽车和摩托车品牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Триумф",
                                "target_lang_sense_clarification": "название бренда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凯旋",
                                "target_lang_sense_clarification": "品牌名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}