                "senses": [
                    {
                        "sense_id": "c3abbcbf-5915-3526-aeb3-7b5350db5aaa",
                        "entry_id": "474344c9-5a16-3a4b-bac1-761db2eff0b2",
                        "glosses": [
                            "Impôt coranique dû au sultan."
                        ],
                        "tags": [
                            "Maroc"
                        ],
                        "examples": [
                            {
                                "example_id": "6258c408-1b8a-4952-8d39-2f8729f3d1a7",
                                "sense_id": "c3abbcbf-5915-3526-aeb3-7b5350db5aaa",
                                "text": "Le prince Almohade Yacoub el-Mansour avait été le premier à percevoir les deux impôts coraniques, l’achour et le zekkat ; quant à la naïba c'est, en principe, un impôt supplémentaire, destiné à parer aux frais extraordinaires de la guerre, que les Almohades et les Mérinides avaient déjà commencé de percevoir."
                            },
                            {
                                "example_id": "499e05cf-f922-4eaf-843e-d660583acc13",
                                "sense_id": "c3abbcbf-5915-3526-aeb3-7b5350db5aaa",
                                "text": "Les anciens impôts coraniques de l’achour ou dîme sur les récoltes et du zekat représentant le 2,5% de la valeur des troupeaux avaient été supprimés dès 1901 et remplacés, en théorie seulement, par le tertib qui n'avait aucun caractère religieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "0081e015-06da-3021-b34f-2868f50fdeb7",
                        "entry_id": "474344c9-5a16-3a4b-bac1-761db2eff0b2",
                        "glosses": [
                            "Impôt payé par les Algériens au gouvernement français du temps de la colonisation."
                        ],
                        "tags": [
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "6885ff8a-4062-4fe1-b2b7-4a3e94141e2d",
                                "sense_id": "0081e015-06da-3021-b34f-2868f50fdeb7",
                                "text": "— Qui me les livrera ?… — Les razzias, l’achour, les khalifas."
                            }
                        ]
                    }
