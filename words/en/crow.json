{
    "word_family": [
        "scarecrow",
        "crowbar",
        "crow's nest"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ced763c-c4c8-3adb-864a-62bb6765ecde",
                    "sense_definition": "A large bird with shiny black feathers and a harsh cry.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bird_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A black <w>crow</w> landed on the fence.",
                            "target_lang_translations": {
                                "ru": "Черная <w>ворона</w> села на забор.",
                                "tr": "Çitin üzerine siyah bir <w>karga</w> kondu.",
                                "zh": "一只黑色的<w>乌鸦</w>落在了栅栏上。",
                                "es": "Un <w>cuervo</w> negro aterrizó en la valla."
                            }
                        },
                        {
                            "text": "The farmer put up a scarecrow to frighten every <w>crow</w> away.",
                            "target_lang_translations": {
                                "ru": "Фермер поставил пугало, чтобы отпугнуть всех <w>ворон</w>.",
                                "tr": "Çiftçi her <w>kargayı</w> korkutup kaçırmak için bir korkuluk dikti.",
                                "zh": "农夫立起一个稻草人，想把所有的<w>乌鸦</w>都吓跑。",
                                "es": "El granjero puso un espantapájaros para ahuyentar a cada <w>cuervo</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "as the crow flies",
                        "white crow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная птица с блестящим черным оперением и резким криком.",
                        "tr": "Parlak siyah tüyleri ve tiz çığlığı olan büyük bir kuş.",
                        "zh": "一种羽毛呈亮黑色、叫声刺耳的大型鸟类。",
                        "es": "Un ave grande con plumas negras brillantes y un graznido fuerte."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворона",
                                "target_lang_sense_clarification": "птица"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karga",
                                "target_lang_sense_clarification": "kuş türü"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乌鸦",
                                "target_lang_sense_clarification": "鸟类名称"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cuervo",
                                "target_lang_sense_clarification": "ave de la familia Corvidae"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "083d7727-c633-363b-80a4-191c88c25e0c",
                    "sense_definition": "A member of a Native American tribe originally from Montana.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tribe_group",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Crow</w> people have a rich cultural history.",
                            "target_lang_translations": {
                                "ru": "Народ <w>кроу</w> имеет богатую культурную историю.",
                                "tr": "<w>Crow</w> halkının zengin bir kültürel tarihi vardır.",
                                "zh": "<w>克罗人</w>拥有丰富的文化历史。",
                                "es": "El pueblo <w>Crow</w> tiene una rica historia cultural."
                            }
                        },
                        {
                            "text": "He is studying the traditions of the <w>Crow</w> tribe.",
                            "target_lang_translations": {
                                "ru": "Он изучает традиции племени <w>кроу</w>.",
                                "tr": "<w>Crow</w> kabilesinin geleneklerini inceliyor.",
                                "zh": "他正在研究<w>克罗</w>部落的传统。",
                                "es": "Él está estudiando las tradiciones de la tribu <w>Crow</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Absaroki",
                        "Crow Indian"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель индейского племени, изначально проживавшего в Монтане.",
                        "tr": "Aslen Montana bölgesinden olan bir Kızılderili kabilesinin üyesi.",
                        "zh": "原居住于蒙大拿州的美国原住民部落成员。",
                        "es": "Miembro de una tribu nativa americana originaria de Montana."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроу",
                                "target_lang_sense_clarification": "племя"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Kro",
                                "target_lang_sense_clarification": "kabile üyesi"
                            },
                            {
                                "target_lang_word": "Crow",
                                "target_lang_sense_clarification": "kabile adı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "克罗人",
                                "target_lang_sense_clarification": "部落名称"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "crow",
                                "target_lang_sense_clarification": "pueblo indígena"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc37ccc4-a3f9-369e-ac52-95602c854a95",
                    "sense_definition": "The loud cry made by a rooster, especially in the morning.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We woke up to the loud <w>crow</w> of the rooster.",
                            "target_lang_translations": {
                                "ru": "Мы проснулись от громкого <w>кукареканья</w> петуха.",
                                "tr": "Horozun yüksek sesli <w>ötüşüyle</w> uyandık.",
                                "zh": "我们被公鸡响亮的<w>打鸣</w>声吵醒了。",
                                "es": "Nos despertamos con el fuerte <w>cacareo</w> del gallo."
                            }
                        },
                        {
                            "text": "The <w>crow</w> signaled the start of a new day.",
                            "target_lang_translations": {
                                "ru": "<w>Кукареканье</w> возвестило о начале нового дня.",
                                "tr": "Horozun <w>ötmesi</w> yeni bir günün başlangıcını haber verdi.",
                                "zh": "公鸡的<w>打鸣</w>预示着新的一天开始了。",
                                "es": "El <w>cacareo</w> señaló el comienzo de un nuevo día."
                            }
                        }
                    ],
                    "synonyms": [
                        "cock-a-doodle-doo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий крик петуха, особенно по утрам.",
                        "tr": "Horozun özellikle sabahları çıkardığı yüksek sesli ötüş.",
                        "zh": "公鸡发出的响亮叫声，尤指在清晨。",
                        "es": "El sonido fuerte que hace un gallo, especialmente por la mañana."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кукареканье",
                                "target_lang_sense_clarification": "звук"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "horoz ötüşü",
                                "target_lang_sense_clarification": "ses"
                            },
                            {
                                "target_lang_word": "ötme",
                                "target_lang_sense_clarification": "horoz sesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打鸣",
                                "target_lang_sense_clarification": "公鸡的叫声"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cacareo",
                                "target_lang_sense_clarification": "canto del gallo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcc43525-4d28-3e42-8817-8f80403de11e",
                    "sense_definition": "An unpleasant, ill-tempered, or ugly woman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was rude and called his neighbor an old <w>crow</w>.",
                            "target_lang_translations": {
                                "ru": "Он был груб и назвал соседку старой <w>каргой</w>.",
                                "tr": "Kabaydı ve komşusuna eski bir <w>kocakarı</w> dedi.",
                                "zh": "他很没礼貌，管邻居叫<w>老巫婆</w>。",
                                "es": "Él fue grosero y llamó a su vecina una vieja <w>bruja</w>."
                            }
                        },
                        {
                            "text": "Don't listen to that bitter old <w>crow</w>.",
                            "target_lang_translations": {
                                "ru": "Не слушай эту злобную старую <w>каргу</w>.",
                                "tr": "O huysuz yaşlı <w>cadıyı</w> dinleme.",
                                "zh": "别听那个尖酸刻薄的<w>老巫婆</w>胡说。",
                                "es": "No escuches a esa vieja <w>arpía</w> amargada."
                            }
                        }
                    ],
                    "synonyms": [
                        "harridan",
                        "shrew",
                        "harpy"
                    ],
                    "common_phrases": [
                        "old crow"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятная, сварливая или безобразная женщина.",
                        "tr": "Kötü huylu, çirkin veya huysuz kadın.",
                        "zh": "指代令人讨厌、脾气暴躁或长相丑陋的女性（贬义）。",
                        "es": "Una mujer desagradable, malhumorada o fea."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карга",
                                "target_lang_sense_clarification": "бранное"
                            },
                            {
                                "target_lang_word": "грымза",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kocakarı",
                                "target_lang_sense_clarification": "hakaret içerikli"
                            },
                            {
                                "target_lang_word": "cadı",
                                "target_lang_sense_clarification": "kötü huylu kadın"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老巫婆",
                                "target_lang_sense_clarification": "贬义称呼"
                            },
                            {
                                "target_lang_word": "泼妇",
                                "target_lang_sense_clarification": "形容脾气暴躁的女性"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "bruja",
                                "target_lang_sense_clarification": "término despectivo"
                            },
                            {
                                "target_lang_word": "arpía",
                                "target_lang_sense_clarification": "mujer malintencionada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29f224e7-a509-3913-978b-9c9eb336ed6c",
                    "sense_definition": "A bar of iron used as a lever.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker used a <w>crow</w> to pry the heavy lid open.",
                            "target_lang_translations": {
                                "ru": "Рабочий использовал <w>лом</w>, чтобы поддеть тяжелую крышку.",
                                "tr": "İşçi ağır kapağı kaldırmak için bir <w>levye</w> kullandı.",
                                "zh": "工人用<w>撬棍</w>撬开了沉重的盖子。",
                                "es": "El trabajador usó una <w>palanca</w> para abrir la pesada tapa."
                            }
                        },
                        {
                            "text": "He grabbed a <w>crow</w> to break the lock.",
                            "target_lang_translations": {
                                "ru": "Он схватил <w>лом</w>, чтобы сломать замок.",
                                "tr": "Kilidi kırmak için bir <w>levye</w> kaptı.",
                                "zh": "他抓起一根<w>撬棍</w>去砸锁。",
                                "es": "Él agarró una <w>palanca</w> para romper la cerradura."
                            }
                        }
                    ],
                    "synonyms": [
                        "crowbar"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "short for crowbar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Железный прут, используемый в качестве рычага.",
                        "tr": "Manivela olarak kullanılan demir çubuk.",
                        "zh": "一种用作杠杆的铁棒。",
                        "es": "Una barra de hierro utilizada como palanca."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лом",
                                "target_lang_sense_clarification": "инструмент"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "levye",
                                "target_lang_sense_clarification": "alet"
                            },
                            {
                                "target_lang_word": "manivela",
                                "target_lang_sense_clarification": "kaldıraç"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撬棍",
                                "target_lang_sense_clarification": "工具"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "palanca",
                                "target_lang_sense_clarification": "herramienta de metal"
                            },
                            {
                                "target_lang_word": "palanca de hierro",
                                "target_lang_sense_clarification": "barra rígida"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aac8ece0-dd28-37f6-9e46-69e7d6ca7cd1",
                    "sense_definition": "To make the loud, shrill sound characteristic of a rooster; or to make a happy sound like a baby.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rooster began to <w>crow</w> as soon as the sun came up.",
                            "target_lang_translations": {
                                "ru": "Петух начал <w>кукарекать</w>, как только взошло солнце.",
                                "tr": "Güneş doğar doğmaz horoz <w>ötmeye</w> başladı.",
                                "zh": "太阳一出来，公鸡就开始<w>打鸣</w>了。",
                                "es": "El gallo comenzó a <w>cacarear</w> tan pronto como salió el sol."
                            }
                        },
                        {
                            "text": "The baby started to <w>crow</w> with delight when she saw her mother.",
                            "target_lang_translations": {
                                "ru": "Ребенок начал радостно <w>гулить</w>, когда увидел маму.",
                                "tr": "Bebek annesini görünce sevinçten neşeyle <w>sesler çıkarmaya</w> başladı.",
                                "zh": "婴儿看到妈妈时，高兴地<w>咿呀</w>叫了起来。",
                                "es": "El bebé comenzó a <w>gorjear</w> de alegría cuando vio a su madre."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать громкий, пронзительный звук, характерный для петуха; или издавать радостные звуки (о младенце).",
                        "tr": "Horoza özgü yüksek sesle ötmek veya bir bebeğin neşeyle mırıldanması.",
                        "zh": "指公鸡发出响亮刺耳的叫声；或指婴儿发出欢快的叫声。",
                        "es": "Emitir el sonido fuerte y agudo característico de un gallo; o emitir sonidos alegres como un bebé."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кукарекать",
                                "target_lang_sense_clarification": "о петухе"
                            },
                            {
                                "target_lang_word": "гулить",
                                "target_lang_sense_clarification": "о младенце"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ötmek",
                                "target_lang_sense_clarification": "horoz hakkında"
                            },
                            {
                                "target_lang_word": "gülüşmek",
                                "target_lang_sense_clarification": "bebeğin neşeli ses çıkarması"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打鸣",
                                "target_lang_sense_clarification": "指公鸡叫"
                            },
                            {
                                "target_lang_word": "咿呀学语",
                                "target_lang_sense_clarification": "指婴儿发出欢快声音"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cacarear",
                                "target_lang_sense_clarification": "sonido del gallo"
                            },
                            {
                                "target_lang_word": "gorjear",
                                "target_lang_sense_clarification": "sonidos alegres de un bebé"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "779aa752-5032-35da-aaf8-340c9618c047",
                    "sense_definition": "To talk with too much pride about something you have achieved.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He continued to <w>crow</w> about his victory for weeks.",
                            "target_lang_translations": {
                                "ru": "Он продолжал <w>бахвалиться</w> своей победой неделями.",
                                "tr": "Haftalarca zaferi hakkında <w>böbürlenmeye</w> devam etti.",
                                "zh": "他连续几周都在<w>吹嘘</w>自己的胜利。",
                                "es": "Él continuó <w>alardeando</w> de su victoria durante semanas."
                            }
                        },
                        {
                            "text": "It is not polite to <w>crow</w> over your opponent's defeat.",
                            "target_lang_translations": {
                                "ru": "Невежливо <w>злорадствовать</w> над поражением противника.",
                                "tr": "Rakibinizin yenilgisine <w>sevinip böbürlenmek</w> kibar bir davranış değildir.",
                                "zh": "对对手的失败<w>炫耀</w>是不礼貌的。",
                                "es": "No es educado <w>jactarse</w> de la derrota de tu oponente."
                            }
                        }
                    ],
                    "synonyms": [
                        "brim",
                        "brimstone"
                    ],
                    "common_phrases": [
                        "crow over"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить с чрезмерной гордостью о своих достижениях.",
                        "tr": "Elde edilen bir başarı hakkında aşırı gururla konuşmak, böbürlenmek.",
                        "zh": "对自己的成就表现出过分的骄傲。",
                        "es": "Hablar con demasiada soberbia sobre algo que se ha logrado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бахвалиться",
                                "target_lang_sense_clarification": "хвастаться"
                            },
                            {
                                "target_lang_word": "кичиться",
                                "target_lang_sense_clarification": "гордиться"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "böbürlenmek",
                                "target_lang_sense_clarification": "övünmek"
                            },
                            {
                                "target_lang_word": "hava atmak",
                                "target_lang_sense_clarification": "günlük kullanım"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吹嘘",
                                "target_lang_sense_clarification": "夸耀"
                            },
                            {
                                "target_lang_word": "炫耀",
                                "target_lang_sense_clarification": "显摆"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "alardear",
                                "target_lang_sense_clarification": "presumir de algo"
                            },
                            {
                                "target_lang_word": "jactarse",
                                "target_lang_sense_clarification": "presumir con orgullo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a6f7b1fe-43f8-34db-b598-314ba946eab2",
                    "sense_definition": "A surname.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Crow</w> lives down the street.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Кроу</w> живет в конце улицы.",
                                "tr": "Bay <w>Crow</w> caddenin aşağısında oturuyor.",
                                "zh": "<w>克罗</w>先生住在街那头。",
                                "es": "El señor <w>Crow</w> vive al final de la calle."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "tr": "Bir soyadı.",
                        "zh": "一种姓氏。",
                        "es": "Un apellido."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кроу",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "tr": [
