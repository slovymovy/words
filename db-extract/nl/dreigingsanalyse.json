                        "examples": [
                            {
                                "example_id": "f598c995-dfea-46d9-b357-1c7582a0bd1e",
                                "sense_id": "29ec74a3-9991-383d-88f4-c563e19a8e19",
                                "text": "In Nederland is nog geen sprake van structurele gewelddadigheden tegen azc's, stelt de Nationaal Coördinator Terrorismebestrijding en Veiligheid. De NCTV schrijft in de nieuwe dreigingsanalyse dat het hier anders is dan in Duitsland, waar het aantal geweldsincidenten tegen azc's dit jaar is verdubbeld. Van januari tot en met augustus waren er in Duitsland 340 aanslagen op azc's."
                            },
                            {
                                "example_id": "c83bc3b6-eafe-4d41-b708-9af041441727",
                                "sense_id": "29ec74a3-9991-383d-88f4-c563e19a8e19",
                                "text": "Het dreigingsniveau blijft in Brussel in principe nog een week lang op het hoogste niveau. Dat maakte de Belgische premier Charles Michel vanavond bekend, na een nieuwe dreigingsanalyse door het Coördinatieorgaan voor de Dreigingsanalyse (OCAD) en na overleg met de Nationale Veiligheidsraad."
                            }
                        ]
                    }
