                                    }
                                ]
                            },
                            {
                                "target_word": "domineering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af5e4224-2cdd-3887-aaf8-38adea9bd3fb",
                                        "entry_id": "d81a8da5-ca9f-375b-b8d8-b3c8a2aacb0c",
                                        "glosses": [
                                            "The act of one who domineers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efbfd1e6-90c6-4f61-afc1-4c30c66a98e1",
                                                "sense_id": "af5e4224-2cdd-3887-aaf8-38adea9bd3fb",
                                                "text": "In strange contrast to the hardly tolerable constraint and nameless invisible domineerings of the captain's table, was the entire care-free license and ease, the almost frantic democracy of those inferior fellows the harpooneers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0abe2535-8e7d-4fd2-8f73-f766a899a5e5",
                        "source_entry_id": "4e152ef8-360b-33f6-ad4e-2accef9db2a4",
                        "target_lang_word": "tiránico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
