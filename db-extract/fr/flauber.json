                "senses": [
                    {
                        "sense_id": "acd439d9-8bf5-3d17-9c10-2d8381fb5801",
                        "entry_id": "438ce71e-87d5-3e0f-a8b1-c276835dbc18",
                        "glosses": [
                            "Gaspiller de l’argent, dépenser inconsidérément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d26d1978-bbcb-4814-bb29-afc64ddf17bb",
                                "sense_id": "acd439d9-8bf5-3d17-9c10-2d8381fb5801",
                                "text": "Je vais pas flauber 300 piastres de chambre d’hôtel quand la maison de ton père est là qui sert à rien ! (Mauvais Karma)"
                            },
                            {
                                "example_id": "4d0605b9-b58f-4778-9822-2cd1140ef2b5",
                                "sense_id": "acd439d9-8bf5-3d17-9c10-2d8381fb5801",
                                "text": "J’ai flaubé TOUTE ma paye en moins d’une heure !"
                            },
                            {
                                "example_id": "c74c1745-f512-4e11-b60f-f5fbef93a23e",
                                "sense_id": "acd439d9-8bf5-3d17-9c10-2d8381fb5801",
                                "text": "Potin : Les Pussycat Dolls auraient flaubé 27 000 $ dans un club de Londres, les détails sur www.hollywoodpq.com."
                            },
                            {
                                "example_id": "6781697a-da88-4f67-8a02-c0e0bf675d36",
                                "sense_id": "acd439d9-8bf5-3d17-9c10-2d8381fb5801",
                                "text": "Bon ben là ça va faire\n M’as descendre en enfer\n M’as flauber ma paye\n M’as aller vendre des bouteilles"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1a4a858-67ad-48a8-9e4d-0471ca5a8cc1",
                        "source_entry_id": "438ce71e-87d5-3e0f-a8b1-c276835dbc18",
                        "source_sense_id": "acd439d9-8bf5-3d17-9c10-2d8381fb5801",
                        "source_sense_description": "Gaspiller de l’argent",
                        "target_lang_word": "squander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15b3a7bd-64b7-3b66-957d-f5e59f7f87d0",
                                        "entry_id": "ce75bf18-da81-31f7-b156-74c40e2763a9",
                                        "glosses": [
                                            "To waste, lavish, splurge; to spend lavishly or profusely; to dissipate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c4baad0-5f4c-4273-9f13-d2b50551765e",
                                                "sense_id": "15b3a7bd-64b7-3b66-957d-f5e59f7f87d0",
                                                "text": "."
                                            },
                                            {
                                                "example_id": "2c539a4d-ff42-4c25-9bca-36fcb1c5fb7b",
                                                "sense_id": "15b3a7bd-64b7-3b66-957d-f5e59f7f87d0",
                                                "text": "1886, Cora Pearl, Memoirs. \"I have squandered money enormously.... I ought to have saved, but saving is not easy in such a whirl of excitement as that in which I have lived.\""
                                            },
                                            {
                                                "example_id": "f3f5c821-751c-4280-9237-0f90248b7008",
                                                "sense_id": "15b3a7bd-64b7-3b66-957d-f5e59f7f87d0",
                                                "text": "1746, Benjamin Franklin, Poor Richard's Almanac\nDost thou love life? Then do not squander time, for that's the stuff life is made of."
                                            },
                                            {
                                                "example_id": "8a58277a-4801-4a17-a329-94f6adb2b922",
                                                "sense_id": "15b3a7bd-64b7-3b66-957d-f5e59f7f87d0",
                                                "text": "As the game opened up, Bolton squandered a fine opportunity to equalise - Chris Eagles shooting straight at Szczesny - but then back came Arsenal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b19b473c-a786-331d-a165-06f3ac07553f",
                                        "entry_id": "ce75bf18-da81-31f7-b156-74c40e2763a9",
                                        "glosses": [
                                            "To scatter; to disperse."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aafbfba1-f772-4fb6-a5cf-7d2c7eeb6834",
                                                "sense_id": "b19b473c-a786-331d-a165-06f3ac07553f",
                                                "text": "[…]our ſquander’d Troops he rallies:[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "577d4bf7-9bd1-3954-9400-66bfb6b84ba2",
                                        "entry_id": "ce75bf18-da81-31f7-b156-74c40e2763a9",
                                        "glosses": [
                                            "To wander at random; to scatter."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be510f23-3afd-4610-b763-5474404528c9",
                                                "sense_id": "577d4bf7-9bd1-3954-9400-66bfb6b84ba2",
                                                "text": "[…]The Wiſe-mans folly is anathomiz’d / Euen by ſquandring glances of the foole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
