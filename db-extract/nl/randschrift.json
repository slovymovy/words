                                "target_word": "legend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afcd7581-11ca-39c7-9706-543575472008",
                                        "entry_id": "04d63f5b-243d-33c8-ba2f-978ac5fbae6d",
                                        "glosses": [
                                            "The life story of a saint (such stories are often embellished, but any kind is called a legend)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a0c2515-0815-4c8c-9a20-9594e1f5f15e",
                                                "sense_id": "afcd7581-11ca-39c7-9706-543575472008",
                                                "text": "As a child she had nothing to read but the legends of early Christian martyrs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "795f17e3-3d37-30f1-bf80-707288f5f996",
                                        "entry_id": "04d63f5b-243d-33c8-ba2f-978ac5fbae6d",
                                        "glosses": [
                                            "An unrealistic story depicting past events.",
                                            "A story of unknown origin describing plausible but extraordinary past events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4152760f-d256-4a51-a5ce-dc2195058a09",
                                                "sense_id": "795f17e3-3d37-30f1-bf80-707288f5f996",
                                                "text": "The legend of Troy was discovered to have a historical basis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "777980fc-f9f1-3d7f-a98f-0feaa86a86de",
                                        "entry_id": "04d63f5b-243d-33c8-ba2f-978ac5fbae6d",
                                        "glosses": [
                                            "An unrealistic story depicting past events.",
                                            "A plausible story set in the historical past, but whose historicity is uncertain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e77814ea-5284-440d-8b44-014989071a91",
                                                "sense_id": "777980fc-f9f1-3d7f-a98f-0feaa86a86de",
                                                "text": "the legend of Robin Hood"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e16bdde-2078-3975-9d48-db5da59aace0",
                                        "entry_id": "04d63f5b-243d-33c8-ba2f-978ac5fbae6d",
                                        "glosses": [
                                            "An unrealistic story depicting past events.",
                                            "A story in which a kernel of truth is embellished to an unlikely degree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9b3c38f-e048-4b0a-b696-d24ae9ade8f9",
                                                "sense_id": "9e16bdde-2078-3975-9d48-db5da59aace0",
                                                "text": "The 1984 Rose Bowl prank has spawned many legends. Here's the real story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c0cbe3b-17a8-3975-9ed4-cd17943db348",
                                        "entry_id": "04d63f5b-243d-33c8-ba2f-978ac5fbae6d",
                                        "glosses": [
                                            "An unrealistic story depicting past events.",
                                            "A fabricated backstory for a spy, with associated documents and records."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22c697c8-4065-4c19-9cd9-c9dbbf0c5291",
                                                "sense_id": "3c0cbe3b-17a8-3975-9ed4-cd17943db348",
                                                "text": "According to his legend, he once worked for the Red Cross, spreading humanitarian aid in Africa."
                                            },
                                            {
                                                "example_id": "121e48bd-07b1-4816-8039-c3eb7234d6e6",
                                                "sense_id": "3c0cbe3b-17a8-3975-9ed4-cd17943db348",
                                                "text": "If the documents are needed to establish \"a light legend,\" meaning a superficial cover story, no steps are taken to make sure that if someone calls the college or motor vehicle department, the name on the document will be registered."
                                            },
                                            {
                                                "example_id": "c2feb5bb-657a-436a-b091-26794ad7fc89",
                                                "sense_id": "3c0cbe3b-17a8-3975-9ed4-cd17943db348",
                                                "text": "Sorge solidified his own position by returning to Germany and developing a new legend. He joined the Nazi Party[…]."
                                            },
                                            {
                                                "example_id": "9517beb0-c4bb-4b38-9fe7-6155bcef5f12",
                                                "sense_id": "3c0cbe3b-17a8-3975-9ed4-cd17943db348",
                                                "text": "Both the agent's legend and documents were intended to stand up against casual questions from Soviet citizens, such as during a job interview, or a routine police document check, such as were made at railway stations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93e56bc7-4dc7-3044-8fde-2d55eadb07e4",
                                        "entry_id": "04d63f5b-243d-33c8-ba2f-978ac5fbae6d",
                                        "glosses": [
                                            "Such stories considered collectively; unverified traditional tales."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b059996e-4d27-4733-aa5f-8bfe7fe0b9c7",
                                                "sense_id": "93e56bc7-4dc7-3044-8fde-2d55eadb07e4",
                                                "text": "According to ancient legend, a Greek girl, partaking of saffron for an entire week, could not resist a lover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f337974-8004-351e-84fe-421017464134",
                                        "entry_id": "04d63f5b-243d-33c8-ba2f-978ac5fbae6d",
                                        "glosses": [
                                            "A person related to a legend or legends.",
                                            "A leading protagonist in a historical legend."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "860b31dc-a2a3-4bf1-b04e-f24ada84ee36",
                                                "sense_id": "0f337974-8004-351e-84fe-421017464134",
                                                "text": "Achilles is a legend in Greek culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "781c4b50-7e66-355c-91ce-ab7228827692",
                                        "entry_id": "04d63f5b-243d-33c8-ba2f-978ac5fbae6d",
                                        "glosses": [
                                            "A person related to a legend or legends.",
                                            "A person of extraordinary fame or accomplishments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f3a4d35-9afa-42e6-be94-16453d5e9b32",
                                                "sense_id": "781c4b50-7e66-355c-91ce-ab7228827692",
                                                "text": "Michael Jordan stands as a legend in basketball."
                                            },
                                            {
                                                "example_id": "95798683-fe58-4995-b61b-f297f28fa0e1",
                                                "sense_id": "781c4b50-7e66-355c-91ce-ab7228827692",
                                                "text": "Sachin Tendulkar stands as a legend in cricket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93de88e5-9543-3bd3-8918-3b52eeb0ebc3",
                                        "entry_id": "04d63f5b-243d-33c8-ba2f-978ac5fbae6d",
                                        "glosses": [
                                            "A person related to a legend or legends.",
                                            "A person of extraordinary fame or accomplishments.",
                                            "A cool, nice or helpful person, especially one who is male."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Ireland",
                                            "New-Zealand",
                                            "UK",
                                            "colloquial",
                                            "countable",
                                            "slang",
