        "fr-extract.jsonl": [
            {
                "entry_id": "18d6fed6-bd43-3665-b1d4-f896bbfde4e8",
                "word": "demi-frère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9ba0c7ac-34c2-42e7-8033-768b70ba6020",
                        "entry_id": "18d6fed6-bd43-3665-b1d4-f896bbfde4e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "demi-frères"
                    },
                    {
                        "form_id": "ed1c3e2b-63f3-4e6c-8ba9-75db56b365e4",
                        "entry_id": "18d6fed6-bd43-3665-b1d4-f896bbfde4e8",
                        "tags": [
                            "feminine"
                        ],
                        "form": "demi-sœur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                        "entry_id": "18d6fed6-bd43-3665-b1d4-f896bbfde4e8",
                        "glosses": [
                            "Frère n’ayant qu’un seul parent en commun (père ou mère)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60b6b263-9486-44f2-a25b-e1ac11dc8e75",
                                "sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                                "text": "J’ai un demi-frère depuis que mon père s’est remarié."
                            },
                            {
                                "example_id": "802a066f-7b32-4075-bca4-0648ec303f99",
                                "sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                                "text": "Ce n’est que mon demi-frère, mais ce n’est pas une raison pour le laisser tomber."
                            },
                            {
                                "example_id": "0c37bd68-22ff-4ecf-893c-d90cae23f06c",
                                "sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                                "text": "Je ne me propose pas d’évoquer souvent ce demi-frère de dix-huit ans mon aîné, mais ne puis sans amputer mon récit l’en éliminer tout à fait."
                            },
                            {
                                "example_id": "6b3ac2b0-4b26-4856-9704-1ba1de7d7675",
                                "sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                                "text": "Il est généralement possible d’éviter les effets environnementaux communs en comparant des individus demi-frères ou demi-sœurs paternels — qui ont le même père mais sont issus de mères différentes, comme par exemple la progéniture d’un taureau reproducteur utilisé pour inséminer un grand nombre de vaches. Les demi-frères ou sœurs ont en commun un quart de leurs gènes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70224d4c-bcfd-46a8-89a0-45bfad87241b",
                        "source_entry_id": "18d6fed6-bd43-3665-b1d4-f896bbfde4e8",
                        "source_sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                        "target_lang_word": "Halbbruder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbbruder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                        "entry_id": "25f34ba6-461e-3e39-b363-547d37534d8c",
                                        "glosses": [
                                            "blutsverwandter Bruder anderer Kinder nur von Vater oder Mutter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d903934-eff1-40c8-be12-a5b6d4cef3da",
                                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                                "text": "„Mein älterer Halbbruder nahm die Sache klaglos so, wie sie kam.“"
                                            },
                                            {
                                                "example_id": "9ee54ec9-3cd1-4717-b688-b2fb1595c298",
                                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                                "text": "„Mit dieser Bemerkung erinnerte er Henriette daran, dass sie einen Halbbruder in Skopun hatte.“"
                                            },
                                            {
                                                "example_id": "42f603a3-899c-4642-8c3a-6ddc44f53f52",
                                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                                "text": "„Es gibt ein Foto von Annie und ihrem Vater und ihrem Halbbruder, die drei blicken direkt in die Kamera.“"
                                            },
                                            {
                                                "example_id": "ed8a4102-76d3-463e-bb02-ef32ea2d16a8",
                                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                                "text": "„Doch die ehelichen Kinder erfuhren erst nach dessen Tod von der Existenz ihres Halbbruders.“"
                                            },
                                            {
                                                "example_id": "06dd869d-d0e6-4a58-b3db-aa3d4e0d8fd6",
                                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                                "text": "„Vorsitzender des Gewerkschaftsdachverbands ZCTU wurde 1981 Mugabes Halbbruder Albert, der die Arbeiterorganisationen auf Parteilinie bringen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82b2a000-366f-4397-a987-14d20014b8ca",
                        "source_entry_id": "18d6fed6-bd43-3665-b1d4-f896bbfde4e8",
                        "source_sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                        "target_lang_word": "Stiefbruder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stiefbruder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef7f47ff-539d-346a-b9df-d6274db6383a",
                                        "entry_id": "a339cdb7-d2a6-39f4-abfd-99dd6a9bc316",
                                        "glosses": [
                                            "halbbürtiger Bruder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eae7205-0186-409d-9e2e-0df8370e63b4",
                                                "sense_id": "ef7f47ff-539d-346a-b9df-d6274db6383a",
                                                "text": "Meinen Stiefbruder kann ich überhaupt nicht leiden."
                                            },
                                            {
                                                "example_id": "d555ed7e-e5c2-4896-9d26-0c199ed407d7",
                                                "sense_id": "ef7f47ff-539d-346a-b9df-d6274db6383a",
                                                "text": "„Weder Serenissimus noch sein Stiefbruder sind Menschen aus Fleisch und Blut, und sie sind auch keine literarischen Gestalten, denen sich eine psychologische Tiefe zuschreiben ließe.“"
                                            },
                                            {
                                                "example_id": "0b27c553-21bc-4047-94eb-db99f9b63324",
                                                "sense_id": "ef7f47ff-539d-346a-b9df-d6274db6383a",
                                                "text": "„Die Schwägerin und der Stiefbruder betrachteten diese Forografien oft mit großem Vergnügen und konnten sich immer wieder darüber verwundern, wie Rotermund scheinbar von heute auf morgen unbeobachtet der Kindheit entwachsen war.“"
                                            },
                                            {
                                                "example_id": "cf88cc2f-bfdd-4346-9d09-71783332a61d",
                                                "sense_id": "ef7f47ff-539d-346a-b9df-d6274db6383a",
                                                "text": "„Wilckens' Briefe waren geschickte Lobbyarbeit für seinen Stiefbruder und andere Bremer Kaufleute, die noch Anfang des 19. Jahrhunderts Plantagen in der Karibik betrieben – wie Richard Fritze auf Kuba.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "46c5e17e-0871-3af9-ab64-de31b354fc57",
                                        "entry_id": "a339cdb7-d2a6-39f4-abfd-99dd6a9bc316",
                                        "glosses": [
                                            "männliches Kind in einer Stieffamilie aus der Sicht eines anderen Kindes derselben Familie, mit dem es keinen gemeinsamen Elternteil hat (Kind nur des eigenen Stiefvaters oder nur der eigenen Stiefmutter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3797a8ae-76c1-4e23-aa81-9923e8f3f0e9",
                                                "sense_id": "46c5e17e-0871-3af9-ab64-de31b354fc57",
                                                "text": "Meinen Stiefbruder kann ich überhaupt nicht leiden."
                                            },
                                            {
                                                "example_id": "ce41b120-a67a-4926-a0bf-b3897c587c38",
                                                "sense_id": "46c5e17e-0871-3af9-ab64-de31b354fc57",
                                                "text": "„Weder Serenissimus noch sein Stiefbruder sind Menschen aus Fleisch und Blut, und sie sind auch keine literarischen Gestalten, denen sich eine psychologische Tiefe zuschreiben ließe.“"
                                            },
                                            {
                                                "example_id": "ee17d8a8-4a24-4f24-8eb3-2cbd28e32084",
                                                "sense_id": "46c5e17e-0871-3af9-ab64-de31b354fc57",
                                                "text": "„Die Schwägerin und der Stiefbruder betrachteten diese Forografien oft mit großem Vergnügen und konnten sich immer wieder darüber verwundern, wie Rotermund scheinbar von heute auf morgen unbeobachtet der Kindheit entwachsen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
