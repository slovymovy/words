                    {
                        "sense_id": "9d8a2169-1e8c-32d4-862a-6c84163bb92e",
                        "entry_id": "ae5f4159-5774-39cf-861e-f4277fc24a40",
                        "glosses": [
                            "een vrouwelijke beheerder van een kerkgebouw"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "b3c19e7f-092d-4d19-9512-3f0ef2231909",
                                "sense_id": "9d8a2169-1e8c-32d4-862a-6c84163bb92e",
                                "text": "Zo was Ensink ruim 25 jaar vrijwilliger bij de geloofsgemeenschap Vasse en ook een tijdje lid van het parochiebestuur, kosteres, samensteller van het parochieblad en lid van het dameskoor. Plus nog tal van andere taken binnen die gemeenschap."
                            },
                            {
                                "example_id": "088afd64-443e-4874-91c5-9118cdc7c32a",
                                "sense_id": "9d8a2169-1e8c-32d4-862a-6c84163bb92e",
                                "text": "Een volbloed Broeker, maar zijn vrouw overtreft hem: die is geboren onder de kerktoren als dochter van de koster en kosteres."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b428aec-2c8e-33fb-b80c-851de9da10f4",
                        "entry_id": "ae5f4159-5774-39cf-861e-f4277fc24a40",
                        "glosses": [
                            "de vrouw van de koster"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7454726b-de32-4ce6-9007-d10d1b77930a",
                        "source_entry_id": "ae5f4159-5774-39cf-861e-f4277fc24a40",
                        "source_sense_id": "9d8a2169-1e8c-32d4-862a-6c84163bb92e",
