                ],
                "senses": [
                    {
                        "sense_id": "a77f74c3-b72d-3036-aac4-9d1c611a4b40",
                        "entry_id": "7a6fd4e1-3283-319f-9391-95bad250a867",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname mit einer hohen Dichte in Österreich und Bayern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8d4da9e-4064-4431-b3a0-ee1f161fe3c5",
                                "sense_id": "a77f74c3-b72d-3036-aac4-9d1c611a4b40",
                                "text": "Frau Aigner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bae1a123-4cff-4d87-9460-bf9c9bfa9053",
                                "sense_id": "a77f74c3-b72d-3036-aac4-9d1c611a4b40",
                                "text": "Herr Aigner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "32ed7c02-6cb4-469f-9bc1-8ba56a05cf76",
                                "sense_id": "a77f74c3-b72d-3036-aac4-9d1c611a4b40",
                                "text": "Die Aigners fliegen heute nach Budapest."
                            },
                            {
                                "example_id": "1163ab57-0382-4d3e-9fd6-cd64c3e221b1",
                                "sense_id": "a77f74c3-b72d-3036-aac4-9d1c611a4b40",
                                "text": "Der Aigner trägt nie die Pullover, die die Aigner ihm strickt."
                            },
                            {
                                "example_id": "fefeb196-3d2a-4e34-bc8d-16f11a1e8ff7",
                                "sense_id": "a77f74c3-b72d-3036-aac4-9d1c611a4b40",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aigner kommt, geht der Herr Aigner.“"
                            },
                            {
                                "example_id": "8cd0400c-5b72-497e-b39b-6267376926a8",
                                "sense_id": "a77f74c3-b72d-3036-aac4-9d1c611a4b40",
                                "text": "Aigner kommt und geht."
                            },
                            {
                                "example_id": "1432092f-c843-494c-8082-dc8b4781a99c",
                                "sense_id": "a77f74c3-b72d-3036-aac4-9d1c611a4b40",
                                "text": "Aigners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
