{
    "word_family": [
        "preludial",
        "preludious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8945dbd-fe39-3c76-81bb-1cfa4e43667b",
                    "sense_definition": "An introductory or preliminary performance or event.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small argument was just a <w>prelude</w> to a much larger fight."
                        },
                        {
                            "text": "The opening ceremony served as a <w>prelude</w> to the main sporting event."
                        }
                    ],
                    "synonyms": [
                        "preface",
                        "overture"
                    ],
                    "common_phrases": [
                        "a prelude to"
                    ]
                },
                {
                    "sense_id": "ac8086f3-76e3-37f5-80ed-e31695e38dca",
                    "sense_definition": "A short piece of music that serves as an introduction or stands alone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist played a beautiful <w>prelude</w> before starting the main concerto."
                        },
                        {
                            "text": "Chopin wrote many famous <w>preludes</w> for the piano."
                        }
                    ],
                    "synonyms": [
                        "intrada",
                        "overture"
                    ]
                },
                {
                    "sense_id": "e78aa6ff-000a-3099-9ec3-068fc4a7ce47",
