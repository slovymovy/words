                                    {
                                        "sense_id": "d6ca8334-a3c0-37b0-a8a5-75e60ec6837f",
                                        "entry_id": "a302355c-9cc6-3972-a239-140b54bf0f1e",
                                        "glosses": [
                                            "En forme d’hélice, disposé en hélice, en colimaçon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49dbf047-304a-4e10-b48f-bbb0bf784335",
                                                "sense_id": "d6ca8334-a3c0-37b0-a8a5-75e60ec6837f",
                                                "text": "Les trous seront effectués à la tarière hélicoïdale ou à la barre à mine avec comme objectif d’enfoncer la tige à 1 mètre de profondeur."
                                            },
                                            {
                                                "example_id": "8cbe39cb-e4c4-41ee-b570-c4311204e6fc",
                                                "sense_id": "d6ca8334-a3c0-37b0-a8a5-75e60ec6837f",
                                                "text": "Enfin, derrière un battant, nous manquons de chuter dans un escalier hélicoïdal qui plonge vers une cave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "912c6194-11bd-330c-83c1-a294aa923181",
                                        "entry_id": "a302355c-9cc6-3972-a239-140b54bf0f1e",
                                        "glosses": [
                                            "Formé de la combinaison d’une translation et d’une rotation autour d’un axe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e325486-9d51-4457-b4fb-0d81d397b2f4",
                                                "sense_id": "912c6194-11bd-330c-83c1-a294aa923181",
                                                "text": "Mouvement hélicoïdal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bd32a75-7bdd-481f-adde-10c5f8c9510e",
                        "source_entry_id": "c0106af3-cd8f-3f00-8dcc-886b0450f3bd",
                        "source_sense_id": "c56d1ec1-7c7c-3ebe-a2d2-21e17c1468e3",
                        "source_sense_description": "in the shape of a helix",
                        "target_lang_word": "spiralförmig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spiralförmig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f93d89ae-a267-3b38-9ae3-5b2fcadb0506",
                                        "entry_id": "e091978d-96cf-3d03-af40-681f3cf25d8e",
                                        "glosses": [
                                            "wie eine Spirale geformt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c496a8df-9f87-4255-b02f-411145292f5d",
                                                "sense_id": "f93d89ae-a267-3b38-9ae3-5b2fcadb0506",
                                                "text": "„Die Ju-52 ging in einer spiralförmigen Flugbahn zu Boden.“"
                                            },
                                            {
                                                "example_id": "c20d1133-f80c-4aba-b234-567377a106d7",
                                                "sense_id": "f93d89ae-a267-3b38-9ae3-5b2fcadb0506",
                                                "text": "„Als einzige gegenwärtig noch lebende (rezente) Gattung besitzen die fünf Nautilus-Arten ein spiralförmiges, gekammertes Gehäuse.“"
                                            },
                                            {
                                                "example_id": "64871d0f-dfcc-4070-8944-5b7bf8672942",
                                                "sense_id": "f93d89ae-a267-3b38-9ae3-5b2fcadb0506",
                                                "text": "„Nach der Form unterteilt man die Bakterien in Stäbchenbakterien (Bazillen), spiralförmige Bakterien (Spirochäten) und kugelförmige Bakterien (Kokken) […].“"
                                            },
                                            {
                                                "example_id": "860564a8-f429-4103-9202-85b72186466e",
                                                "sense_id": "f93d89ae-a267-3b38-9ae3-5b2fcadb0506",
                                                "text": "„Coubertin schuf damit eine Formel, unter welcher der Spitzensport, der Extremsport und der Wagnissport spiralförmig aufblühten.“"
                                            },
                                            {
                                                "example_id": "5bfde741-a499-47db-93dc-58828e32722c",
                                                "sense_id": "f93d89ae-a267-3b38-9ae3-5b2fcadb0506",
                                                "text": "„Am 24. August 1940 starb der Ingenieur Paul Nipkow. Mit einer spiralförmig gelochten Scheibe, der \"Nipkow-Scheibe\" erfand er eine technische Grundlage für das Fernsehen.“"
                                            },
                                            {
                                                "example_id": "11eaa5bd-8b63-472f-be6f-cdbdc0fad2d2",
                                                "sense_id": "f93d89ae-a267-3b38-9ae3-5b2fcadb0506",
                                                "text": "[Brockenbahn:] „Die spektakuläre Strecke, die spiralförmig um den Berg führt, um die Steigung zu mildern, gehört zu den größten Touristenattraktionen im Harz.“"
                                            },
                                            {
                                                "example_id": "cabe78f3-1ad5-4e65-899b-19f81e8138e2",
                                                "sense_id": "f93d89ae-a267-3b38-9ae3-5b2fcadb0506",
                                                "text": "„Wie beim Hurrikan werden auch beim Medicane die Wolken und Regenbänder rund um das Auge spiralförmig und im Gegenuhrzeigersinn herumgewirbelt.“"
                                            },
                                            {
                                                "example_id": "a94a777c-03d8-4d10-bdb5-4809c4ef0461",
                                                "sense_id": "f93d89ae-a267-3b38-9ae3-5b2fcadb0506",
                                                "text": "„Wer unsere spiralförmige Heimatgalaxie mit ihren unzähligen Sternen und Nebeln beobachten will, sollte jetzt gucken: So gut wie jetzt sieht man sie sonst nicht mehr im Jahr.“"
                                            },
                                            {
                                                "example_id": "5b2f571e-0f24-47d0-ba00-236d165c3cf1",
                                                "sense_id": "f93d89ae-a267-3b38-9ae3-5b2fcadb0506",
                                                "text": "„Das Ozeanium in Basel soll frühestens 2020 eröffnet werden. Die Besucher sollen in einem spiralförmigen Rundgang anhand von 30 Themenaquarien einen Einblick in die Welt der Ozeane erhalten.“",
                                                "translation": "[*] „Torfmoose gehören zu den Laubmoosen, haben also Stämmchen, an denen spiralförmig mit Blättern besetzte Astbüschel sitzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
