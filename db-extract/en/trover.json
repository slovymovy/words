                        "entry_id": "b854f071-7367-395f-b221-bcb9e1a33bac",
                        "glosses": [
                            "Taking possession of personal property which has been found."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4d510b78-9aec-4355-8919-7944af7e65ee",
                                "sense_id": "0b92b4f2-9499-327d-803b-405777f6c7ad",
                                "text": "How did he like it when the live creatures\nTickled and toused and browsed him all over,\nAnd worm, slug, eft, with serious features\nCame in, each one, for his right of trover?"
                            }
                        ]
                    },
                    {
                        "sense_id": "5f9d8e48-03ff-3ed8-96eb-147b457ca6d0",
                        "entry_id": "b854f071-7367-395f-b221-bcb9e1a33bac",
                        "glosses": [
                            "A legal action brought to recover such property by its original owner."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ddcaa18c-58a6-41c3-be57-2e70c74c194e",
                                "sense_id": "5f9d8e48-03ff-3ed8-96eb-147b457ca6d0",
                                "text": "The pocket-book was a late present from Mrs Western […]. A prudent person […] would not have offered more than a shilling, or perhaps sixpence, for it; nay, some perhaps would have given nothing, and left the fellow to his action of trover, which some learned serjeants may doubt whether he could, under these circumstances, have maintained."
                            },
                            {
                                "example_id": "89a7dbe7-8332-47f2-974e-2a4266ee2504",
                                "sense_id": "5f9d8e48-03ff-3ed8-96eb-147b457ca6d0",
                                "text": "By a fiction of law, actions of trover are now permittedto be brought against any person who hath got into his possession by any means whatsoever the goods of another, and sold them or used them without the consent of the owner, or refused to deliver them when demanded."
                            }
                        ]
                    }
