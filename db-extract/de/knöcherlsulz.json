                ],
                "senses": [
                    {
                        "sense_id": "b4267cd4-6fd3-361c-b94a-66869840e14d",
                        "entry_id": "f2a699bc-556f-32e6-a9bb-32c0528cb6c9",
                        "glosses": [
                            "Sülze aus Schweine- oder Kalbsfüßen (Knöcherl), eventuell auch Ohren, Rüssel, Schwanz oder ähnlichen üblicherweise nicht verwerteten Teilen von Schlachtvieh"
                        ],
                        "tags": [
                            "bayrische Küche"
                        ],
                        "examples": [
                            {
                                "example_id": "0025a573-4a8e-4a3c-b398-6f51656898f8",
                                "sense_id": "b4267cd4-6fd3-361c-b94a-66869840e14d",
                                "text": "„‚d'Sau – d'Sau hat an schweinern Kopf und – und – und an Schwanz aa!‘ heißt es in einem Volkslied. Es bringt damit zum Ausdruck, dass an einer Sau alles zu gebrauchen ist – vom gesottenen Schweinskopf im Kraut bis zum Sauschwanzl in der Knöcherlsulz.“"
                            },
                            {
                                "example_id": "4f4c9f07-be24-4f18-b8b2-468426c80892",
                                "sense_id": "b4267cd4-6fd3-361c-b94a-66869840e14d",
                                "text": "„Knöcherlsulz: Die 4 Schweinsfüßl, der Rüssel und die Ohren werden sehr sauber geputzt, in Stücke gehackt und in Salzwasser mit Essigzusatz halbweich gekocht.“"
                            },
                            {
                                "example_id": "0e70a595-0ad2-44e2-8dac-7a6b8984f5ab",
                                "sense_id": "b4267cd4-6fd3-361c-b94a-66869840e14d",
                                "text": "„Wir gingen zu einem Biergarten an der Donau, an grün gestrichenen Tischen, unter grünen Bäumen, Kastanien, zu Abend zu essen, einen Emmenthaler oder eine Knöcherlsulz und einen scharfen Rettich.“"
                            },
                            {
                                "example_id": "8123f562-cdcf-43da-a9a3-aeaee24a0e6a",
                                "sense_id": "b4267cd4-6fd3-361c-b94a-66869840e14d",
                                "text": "„Wie schmeckt eigentlich ‚Knöcherlsulz‘? ‚Hab ich noch nie probiert. Aber ich glaub, ich will’s gar nicht wissen.‘“"
                            },
                            {
                                "example_id": "1a54117f-308b-44a9-9cce-d58946e25fbe",
                                "sense_id": "b4267cd4-6fd3-361c-b94a-66869840e14d",
                                "text": "„Ich denke aber wohl darüber nach, im nächsten Herbst Hagebutten für selbstgemachtes Mark zu sammeln und mich auf die Suche nach einem Berliner Fleischer zu begeben, der mir Schweinsfüße und -schwänze für eine Knöcherlsulz zur Verfügung stellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
