                ],
                "senses": [
                    {
                        "sense_id": "7bdfc8b6-7ca7-3e4f-9074-2eeabb79104b",
                        "entry_id": "fc8e72fb-00f6-3b07-b351-761c4c8bf43d",
                        "glosses": [
                            "Oberbegriff für Laterale und Vibranten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7594efd7-3087-4c07-833c-93077861ae65",
                                "sense_id": "7bdfc8b6-7ca7-3e4f-9074-2eeabb79104b",
                                "text": "[l] und [ʀ] sind Liquide im Deutschen."
                            },
                            {
                                "example_id": "fd63e340-7931-4e59-b137-fa398d478d8d",
                                "sense_id": "7bdfc8b6-7ca7-3e4f-9074-2eeabb79104b",
                                "text": "Die Liquiden l, m, n, r, und die Spiraten v, h, s laufen wesentlich unverändert durch alle deutschen Mundarten[.]"
                            },
                            {
                                "example_id": "5c594339-8d7e-44b7-84ca-3bbae49b948d",
                                "sense_id": "7bdfc8b6-7ca7-3e4f-9074-2eeabb79104b",
                                "text": "„Schließlich können die Nasale und Liquiden die Rolle eines Vokals übernehmen und silben tragen; man bezeichnet sie in dieser Funktion durch den indogermanischen Ablaut bestimmten Funktion als nasales beziehungsweise liquidae sonantes oder kurz als Sonanten (geschrieben m̩, n̩, r̩, l̩).“"
                            },
                            {
                                "example_id": "0f7de983-5fba-4e56-a418-bee85caab35e",
                                "sense_id": "7bdfc8b6-7ca7-3e4f-9074-2eeabb79104b",
                                "text": "„Von den grundsprachlich-indogermanischen Vorgängen ist die Tatsache hervorzuheben, daß auslautende Langdiphthonge, wozu auch Verbindungen mit Liquida oder Nasal an zweiter Stelle zu rechnen sind, ihren zweiten Bestandteil verlieren konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98995280-e85d-43e8-9466-f8c9d70345a3",
                        "source_entry_id": "fc8e72fb-00f6-3b07-b351-761c4c8bf43d",
                        "source_sense_id": "7bdfc8b6-7ca7-3e4f-9074-2eeabb79104b",
                        "source_sense_description": "Linguistik: Oberbegriff für Laterale und Vibranten",
                        "target_lang_word": "liquide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liquide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b4c20fd-7cde-3e6c-97cb-c31b287d5e7a",
                                        "entry_id": "ffe6a47e-da72-387b-b707-60e8ce810f82",
                                        "glosses": [
                                            "Fluide, qui tend à couler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b845256-fc14-42c8-88c7-117e8d623398",
                                                "sense_id": "2b4c20fd-7cde-3e6c-97cb-c31b287d5e7a",
                                                "text": "Ce breuvage n’est pas assez liquide."
                                            },
                                            {
                                                "example_id": "6ea52fce-913c-4257-9029-15543e9f1a42",
                                                "sense_id": "2b4c20fd-7cde-3e6c-97cb-c31b287d5e7a",
                                                "text": "La phase liquide est un état de la matière compris entre l'état gazeux et l'état solide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a36971c2-910f-382f-8443-94cf4e207e20",
                                        "entry_id": "ffe6a47e-da72-387b-b707-60e8ce810f82",
                                        "glosses": [
                                            "Liquéfié."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09ba2ffb-28f3-47ff-bd30-0cd15e96ce29",
                                                "sense_id": "a36971c2-910f-382f-8443-94cf4e207e20",
                                                "text": "L’extrême petitesse de l’amortissement aux températures de la neige carbonique et de l’air liquide oblige à beaucoup de circonspections dans l’interprétation des résultats."
                                            },
                                            {
                                                "example_id": "46212119-ae19-4e30-8f8d-27d61bb8fc25",
                                                "sense_id": "a36971c2-910f-382f-8443-94cf4e207e20",
                                                "text": "Les choses se fondaient, perdaient doucement leur forme ; on eût dit que l’assiette de porcelaine s’écoulait, et que le couteau d’acier devenait liquide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3e5df86-a898-3107-ab1b-5ced1fd52b60",
                                        "entry_id": "ffe6a47e-da72-387b-b707-60e8ce810f82",
                                        "glosses": [
                                            "De faible consistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "111647bb-9db0-4e7a-b663-b0d8d2c8ae66",
                                                "sense_id": "a3e5df86-a898-3107-ab1b-5ced1fd52b60",
                                                "text": "Cette sauce est trop liquide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aae1c0e-2c26-3851-b0d5-3e536c8f57e4",
                                        "entry_id": "ffe6a47e-da72-387b-b707-60e8ce810f82",
                                        "glosses": [
                                            "Relatif aux consonnes « l, r », qui, étant employées à la suite d’une autre consonne dans une même syllabe, sont coulantes et se prononcent aisément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "066b710c-531a-43e0-bc9f-32b68a4858d7",
                                                "sense_id": "0aae1c0e-2c26-3851-b0d5-3e536c8f57e4",
                                                "text": "Une consonne liquide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fecbe3d-35da-3010-853d-81d5869610c3",
                                        "entry_id": "ffe6a47e-da72-387b-b707-60e8ce810f82",
                                        "glosses": [
                                            "Rapidement disponible, en parlant d’actifs financiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7424515d-db2b-4b8d-a4d5-507abc287de7",
                                                "sense_id": "6fecbe3d-35da-3010-853d-81d5869610c3",
                                                "text": "Livrets A, LDDS et LEP sont garantis par l’Etat et exonérés d’impôts et de prélèvements sociaux. Ils sont de plus totalement liquides, c’est-à-dire que chaque titulaire peut retirer tout ou partie de ses fonds à tout moment."
                                            },
                                            {
                                                "example_id": "db485bfe-f108-400b-92e8-d65570de95fe",
                                                "sense_id": "6fecbe3d-35da-3010-853d-81d5869610c3",
                                                "text": "Un portefeuille d’actif assez liquide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51a920be-f529-3478-8590-20d9be3e6e04",
                                        "entry_id": "ffe6a47e-da72-387b-b707-60e8ce810f82",
                                        "glosses": [
                                            "Qui est net et clair, qui n’est pas sujet à contestation, qui n’est pas chargé de dettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f733c5-925e-48a8-bed8-589a5afba565",
                                                "sense_id": "51a920be-f529-3478-8590-20d9be3e6e04",
                                                "text": "On ne peut saisir que pour une dette liquide et certaine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "liquide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "376672c3-61b1-307a-8872-9a82ee1b700a",
                                        "entry_id": "ed152467-6d23-3f12-b820-138263b83806",
                                        "glosses": [
                                            "Fluide qui peut couler, et possède son volume propre, qui ne varie (peu) qu’avec la température ou la pression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "005a3328-a367-49e4-aec2-fdb76ca2f94d",
                                                "sense_id": "376672c3-61b1-307a-8872-9a82ee1b700a",
                                                "text": "L’examen peut être complété par une séquence privilégiant le signal des liquides stationnaires en vue d’obtenir une uro-IRM qui remplace la classique urographie intraveineuse à la recherche d’une dilatation du système urinaire."
                                            },
                                            {
                                                "example_id": "842e9141-2242-47c1-82a8-60f9c08ae28d",
                                                "sense_id": "376672c3-61b1-307a-8872-9a82ee1b700a",
                                                "text": "Tout corps plongé dans un liquide éprouve de bas en haut une pression égale au poids du liquide déplacé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5af4de63-fccf-340b-ba81-d6f4c8dd4c20",
                                        "entry_id": "ed152467-6d23-3f12-b820-138263b83806",
                                        "glosses": [
                                            "Liqueur, boisson alcoolisée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51f80de1-e467-485d-a70d-3cdeca83ef07",
                                                "sense_id": "5af4de63-fccf-340b-ba81-d6f4c8dd4c20",
                                                "text": "Droits sur les liquides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c17fa48-32ea-3252-9a75-ba001864c886",
                                        "entry_id": "ed152467-6d23-3f12-b820-138263b83806",
                                        "glosses": [
                                            "Solution organique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07bbc687-8a15-4b16-9ae9-027bb0280681",
                                                "sense_id": "1c17fa48-32ea-3252-9a75-ba001864c886",
                                                "text": "Le liquide amniotique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b3e45f9-a735-34bf-876a-58761141a788",
                                        "entry_id": "ed152467-6d23-3f12-b820-138263b83806",
                                        "glosses": [
                                            "Argent disponible immédiatement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f54004f-8e4c-4700-a1b7-c66c45a8befe",
                                                "sense_id": "7b3e45f9-a735-34bf-876a-58761141a788",
                                                "text": "Une nénette enceinte, c’est pas l’Himalaya, et un contrôle fiscal, c’est pas un mardi noir à Wall Street. D’abord tu largues la nénette, je te file l’oseille en liquide pour les formalités. Ensuite, tu disparais du bureau, […]."
                                            },
                                            {
                                                "example_id": "13807eb6-77b3-4209-9745-2ca3217e5a7c",
                                                "sense_id": "7b3e45f9-a735-34bf-876a-58761141a788",
                                                "text": "Et pour cause, nos voisins germaniques payent encore régulièrement en espèces (90%, dont 50% souvent). Ils arrivent en tête des pays européens où l’on utilise le plus du liquide, devant l’Italie (82%) et la Pologne (82%)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "liquide",
                                "target_lang_code": "fr",
