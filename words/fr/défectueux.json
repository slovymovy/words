                    ]
                },
                {
                    "sense_id": "4c5c7e36-64c5-3a04-9eae-2719ec450bbe",
                    "sense_definition": "Qui ne réunit pas toutes les qualités requises, qui comporte des lacunes ou des insuffisances.",
