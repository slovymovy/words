                                "target_senses": [
                                    {
                                        "sense_id": "f1781010-5f86-3705-9fa0-f622cdae346a",
                                        "entry_id": "0b51a861-79ca-30a0-92ea-ce93bda2680f",
                                        "glosses": [
                                            "Of or relating to pantheism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277dbcf0-c910-444b-87eb-c7d6c6f507e9",
                                                "sense_id": "f1781010-5f86-3705-9fa0-f622cdae346a",
                                                "text": "[S]ome pragmatists (such as William James) took a more pantheist or pandeist approach by rejecting views of God as separate from the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b0f93dd-a2fb-4b9e-a4ed-5a61a5ab5dde",
                        "source_entry_id": "73617fe0-8cd7-3034-b101-b2c60bc66f4a",
                        "source_sense_id": "60079987-4891-3a46-a1c3-b2dd089f51e4",
