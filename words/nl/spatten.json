            "senses": [
                {
                    "sense_id": "683d2afa-0557-39d0-9c6a-807b09ecc5bf",
                    "sense_definition": "vloeistof in kleine druppels in het rond laten vliegen of uiteenspringen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vloeistofbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regen begon hard tegen het raam te <w>spatten</w>.",
                            "target_lang_translations": {
                                "en": "The rain began to <w>splash</w> hard against the window.",
                                "ru": "Дождь начал сильно <w>барабанить</w> по окну, разлетаясь брызгами."
                            }
                        },
                        {
                            "text": "Pas op dat je niet gaat <w>spatten</w> met die natte kwast.",
                            "target_lang_translations": {
                                "en": "Be careful not to <w>splatter</w> with that wet brush.",
                                "ru": "Смотри не начни <w>брызгать</w> этой мокрой кистью."
                            }
                        }
                    ],
                    "synonyms": [
                        "spetteren",
                        "plonzen"
                    ],
                    "common_phrases": [
                        "water laten spatten",
                        "tegen het raam spatten"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause liquid to fly around in small drops or to burst apart",
                        "ru": "разлетаться или разбрызгиваться мелкими каплями жидкости"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "splash",
                                "target_lang_sense_clarification": "to hit or agitate liquid so it disperses"
                            },
                            {
                                "target_lang_word": "splatter",
                                "target_lang_sense_clarification": "to scatter liquid in an uneven mess"
                            },
                            {
                                "target_lang_word": "spatter",
                                "target_lang_sense_clarification": "to splash with small drops"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "брызгать",
                                "target_lang_sense_clarification": "разлетать каплями"
                            },
                            {
                                "target_lang_word": "разбрызгиваться",
                                "target_lang_sense_clarification": "разлетаться в разные стороны"
                            },
                            {
