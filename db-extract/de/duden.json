                ],
                "senses": [
                    {
                        "sense_id": "0a0a8759-12e3-3497-adb8-14c48a2b4872",
                        "entry_id": "d45cbcf7-1675-3f14-8fbb-9fe5f4980de3",
                        "glosses": [
                            "bekanntes Wörterbuch der deutschen Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ec83fb-cdf3-48d3-b682-1878da6a256c",
                                "sense_id": "0a0a8759-12e3-3497-adb8-14c48a2b4872",
                                "text": "Reich mir bitte den Duden, ich muss da die Schreibweise eines Wortes herausfinden."
                            },
                            {
                                "example_id": "15a054bb-6fe6-4588-a812-a741d34ad206",
                                "sense_id": "0a0a8759-12e3-3497-adb8-14c48a2b4872",
                                "text": "„Die Bibliographisches Institut GmbH ist Teil der international tätigen Unternehmensgruppe Cornelsen und mit den Marken Duden, Meyers, Sauerländer, Sauerländer Audio, Artemis & Winkler sowie Albatros ein renommiertes Medienhaus im Bereich Publikumsverlage.“"
                            },
                            {
                                "example_id": "9c280ac0-ccc5-4bf4-9089-a43776355747",
                                "sense_id": "0a0a8759-12e3-3497-adb8-14c48a2b4872",
                                "text": "„Der Duden steht seit einem Jahrhundert für Kompetenz in Fragen zur deutschen Sprache und Rechtschreibung – Duden Kinderbücher begleiten Kinder und Eltern in den wichtigen ersten Jahren, legen den Grundstein für die Entwicklung von Sprachvermögen und Wissenserwerb.“"
                            },
                            {
                                "example_id": "542296db-bbec-4cf0-abc6-4191e1077697",
                                "sense_id": "0a0a8759-12e3-3497-adb8-14c48a2b4872",
                                "text": "„»Der Duden«, also das Rechtschreibwörterbuch, besitzt heute keinerlei Verbindlichkeit mehr.“"
                            },
                            {
                                "example_id": "0d0fc31a-1d9d-41c3-b3c1-07b668915e20",
                                "sense_id": "0a0a8759-12e3-3497-adb8-14c48a2b4872",
                                "text": "„Deren regionale Besonderheiten wie Paradeiser oder Kren werden vom Österreichischen Wörterbuch und längst auch vom Duden als gleichberechtigte Varietäten der Standardsprache anerkannt.“"
                            },
                            {
                                "example_id": "cf9a4344-e708-43ee-b9c5-d3829e2d2ca4",
                                "sense_id": "0a0a8759-12e3-3497-adb8-14c48a2b4872",
                                "text": "„Insgesamt enthält der neue Duden knapp 140.000 Einträge - etwa das Zehnfache des aktiven Wortschatzes eines Durchschnittsdeutschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd346e47-e2a0-46af-a7ad-82323dde7c07",
                        "source_entry_id": "d45cbcf7-1675-3f14-8fbb-9fe5f4980de3",
                        "source_sense_id": "0a0a8759-12e3-3497-adb8-14c48a2b4872",
