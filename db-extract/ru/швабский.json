                "senses": [
                    {
                        "sense_id": "7b5844e3-8596-3405-81c9-d7bf46bc79e5",
                        "entry_id": "48a4c0af-3081-3fe8-b5b8-cd3af5dfe358",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными Швабия, шваб"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63321d9-089e-4f44-85bb-dd710f17de96",
                                "sense_id": "7b5844e3-8596-3405-81c9-d7bf46bc79e5",
                                "text": "В этом затруднительном положении Спарта поступила точно так же, как в средние века поступали саксонские и швабские герцоги, мечтавшие об императорской короне."
                            },
                            {
                                "example_id": "b14ae099-2caa-461f-9e00-11e062a09362",
                                "sense_id": "7b5844e3-8596-3405-81c9-d7bf46bc79e5",
                                "text": "Швабский городок Вайнгартен находится неподалеку от Боденского озера, на границе с Австрией и Швейцарией."
                            }
                        ]
                    }
