                {
                    "sense_id": "7f8a1714-ba35-3957-8a6d-4be0a02ea17a",
                    "sense_definition": "Popularny ptak wodny, który pływa po rzekach i stawach, ma płaski dziób i płetwy między palcami",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W parku dzieci karmiły <kaczki> chlebem.",
                            "target_lang_translations": {
                                "ru": "В парке дети кормили <уток> хлебом.",
                                "de": "Im Park fütterten die Kinder die <Enten> mit Brot."
                            }
                        },
                        {
                            "text": "Po jeziorze pływa duża, biała <kaczka>.",
                            "target_lang_translations": {
                                "ru": "По озеру плавает большая белая <утка>.",
                                "de": "Auf dem See schwimmt eine große, weiße <Ente>."
                            }
                        }
