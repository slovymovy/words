                    },
                    {
                        "translation_id": "3f57e8d1-d546-4b25-81f0-d49ba25605b2",
                        "source_entry_id": "cf5eb0a2-52b5-307d-8f2e-a18beff6fb6c",
                        "source_sense_id": "a5a72060-d592-3528-a6cd-5099dd0f4925",
                        "target_lang_word": "gramophone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gramophone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba774cb4-3411-3b82-9ace-a675dd6e0f31",
                                        "entry_id": "c9f3c717-da05-3f7f-b781-ad6227f25165",
                                        "glosses": [
                                            "Phonographe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c194035-4504-4581-b838-6b572d93d3d8",
                                                "sense_id": "ba774cb4-3411-3b82-9ace-a675dd6e0f31",
                                                "text": "Je leur fis voir des photographies de ma croisière, mes trophées de tennis et jouai en leur honneur sur le gramophone quelques disques de Granados."
                                            },
                                            {
                                                "example_id": "355dd24b-f2f5-48c9-af84-7d02eb6a041c",
                                                "sense_id": "ba774cb4-3411-3b82-9ace-a675dd6e0f31",
                                                "text": "Le palais des papes est à nous! Les petits hommes turbulents du XXᵉ siècle font, en ces jours d'exposition, nasiller leurs gramophones sous la majesté de ces murailles,..."
                                            },
                                            {
                                                "example_id": "c498c76c-9fd2-4095-ab97-7c4a530eb4e1",
                                                "sense_id": "ba774cb4-3411-3b82-9ace-a675dd6e0f31",
                                                "text": "Boulotte, blonde et frisottée, son visage rose de bécassine constamment paré d’un sourire niais, Mme Comparois accueillit Simon comme un fils, les bras ouverts, avec des cris de bonheur aigus, inouïs, pareils aux éclats d’un vieux gramophone."
                                            },
                                            {
                                                "example_id": "eb7d79bf-abad-4aa3-a305-9a5fca36f3c8",
                                                "sense_id": "ba774cb4-3411-3b82-9ace-a675dd6e0f31",
                                                "text": "On avait installé le gramophone à rouleaux et l’on écoutait les chansons de Léon Bérard."
                                            },
                                            {
                                                "example_id": "c99f7a91-05fd-4753-a507-25087b451a91",
                                                "sense_id": "ba774cb4-3411-3b82-9ace-a675dd6e0f31",
                                                "text": "Après le départ des clientes, le salon était gaiement éclairé, le tapis roulé, un gramophone placé sur la table et ma mère s'asseyait dans un des fauteuils Louis XVI récemment acquis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
