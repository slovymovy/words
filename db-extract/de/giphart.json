                ],
                "senses": [
                    {
                        "sense_id": "e785dc2b-e238-320b-91d8-af1841f7661d",
                        "entry_id": "845ca029-8715-3420-bcc0-854e13d6a0df",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "458a7a1c-5e70-4448-a072-9449b21df5c8",
                                "sense_id": "e785dc2b-e238-320b-91d8-af1841f7661d",
                                "text": "Frau Giphart ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3a8cacda-d566-4099-9925-6df646e809d7",
                                "sense_id": "e785dc2b-e238-320b-91d8-af1841f7661d",
                                "text": "Herr Giphart wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f7213dd5-9e4f-4413-8178-2dbe76ba1ac7",
                                "sense_id": "e785dc2b-e238-320b-91d8-af1841f7661d",
                                "text": "Die Gipharts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b3416e36-ad11-4604-862f-caa46e0d9cce",
                                "sense_id": "e785dc2b-e238-320b-91d8-af1841f7661d",
                                "text": "Der Giphart trägt nie die Schals, die die Giphart ihm strickt."
                            },
                            {
                                "example_id": "b88270cb-afa6-44e2-9b99-9caa128a1a4f",
                                "sense_id": "e785dc2b-e238-320b-91d8-af1841f7661d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Giphart kommt, geht der Herr Giphart.“"
                            },
                            {
                                "example_id": "2bd86c4e-fe20-41a4-9452-639fb9772f3f",
                                "sense_id": "e785dc2b-e238-320b-91d8-af1841f7661d",
                                "text": "Giphart kommt und geht."
                            },
                            {
                                "example_id": "2173df4e-5368-40bb-a7c3-431bdd6d412d",
                                "sense_id": "e785dc2b-e238-320b-91d8-af1841f7661d",
                                "text": "Gipharts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
