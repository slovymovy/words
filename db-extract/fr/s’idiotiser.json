                        "glosses": [
                            "Devenir idiot."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "03ed90a5-3ea1-4fa3-9470-3222a43ac59d",
                                "sense_id": "f5190985-48ad-3500-853b-8a9d98406172",
                                "text": "Les efforts que l’on fait pour arriver usent les forces, atrophient l’organisme ; on se surmène, on a hâte de toucher le but et on chancèle, on succombe, on meurt, ou on s’idiotise."
                            },
                            {
                                "example_id": "e9febf1b-9cf7-46c7-8ca0-6dab32f38090",
                                "sense_id": "f5190985-48ad-3500-853b-8a9d98406172",
                                "text": "- Encore un qui s’embête - pensa Tercinet. - C’est vrai qu’on s’idiotise, en province."
                            },
                            {
                                "example_id": "c87edbc1-f1ec-46ab-961f-372482d9fd53",
                                "sense_id": "f5190985-48ad-3500-853b-8a9d98406172",
                                "text": "Depuis la Réforme, on a sacrifié les grands cœurs pour conserver les béguines et les cuistres : prône bref, la morale littéraire aujourd’hui s’idiotise."
                            }
                        ]
                    }
