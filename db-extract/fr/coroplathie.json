                        "sense_id": "846cd933-cf55-3066-b760-62540fd4bec3",
                        "entry_id": "2d37b1a7-1fb6-3cff-8062-bbe4ac0106d5",
                        "glosses": [
                            "Mode de fabrication de figures le plus souvent en terre cuite dont l’origine est proche-orientale et importée dans le bassin occidental de la mer Méditerranée par les Phéniciens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4063eda4-d5c2-4205-8ae6-b93762e07bbd",
                                "sense_id": "846cd933-cf55-3066-b760-62540fd4bec3",
                                "text": "Ils témoignent alors des échanges techniques et iconographiques qui s’opèrent à l'intérieur des ateliers de coroplathie et entre les différents corps de métier."
                            },
                            {
                                "example_id": "e1aa1b38-d9c6-40f6-b78c-67a777c29fed",
                                "sense_id": "846cd933-cf55-3066-b760-62540fd4bec3",
                                "text": "En dépit du caractère insolite de cette figurine, qui se démarque nettement du corpus de la coroplathie de l’Égypte romaine, l’ensemble des attributs permet d’identifier Isis, dont la parure de tête est une version abâtardie du disque solaire encadré des cornes de vache."
                            }
                        ]
                    }
