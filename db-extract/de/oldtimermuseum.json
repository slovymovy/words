                "senses": [
                    {
                        "sense_id": "b6e59c5d-263b-3a94-8765-1a444a058e7e",
                        "entry_id": "8ff0c27b-efaa-3f25-a6ad-db798b640134",
                        "glosses": [
                            "Museum, in dem alte Kraftfahrzeuge ausgestellt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72381658-42c3-45c3-90b6-c56d888a22b9",
                                "sense_id": "b6e59c5d-263b-3a94-8765-1a444a058e7e",
                                "text": "„Des Weiteren beherbergt das Oldtimermuseum als Besonderheit im Obergeschoss das weltweit einzig erhaltene Schakomobil.“"
                            },
                            {
                                "example_id": "88ce6b89-f062-47d8-ac00-b186d79b5a63",
                                "sense_id": "b6e59c5d-263b-3a94-8765-1a444a058e7e",
                                "text": "„Die Produktion der Fahrzeuge wurde von den Hiller-Automobilwerken übernommen und Ende 1927 eingestellt. Ein Fahrzeug ist erhalten geblieben und steht im Oldtimermuseum in Bredstedt.“"
                            },
                            {
                                "example_id": "26994e70-1f10-453a-8664-781b53f89906",
                                "sense_id": "b6e59c5d-263b-3a94-8765-1a444a058e7e",
                                "text": "„Im Oldtimermuseum ist u. a. ein weisser Rolls-Royce aus dem Jahr 1927 zu sehen, der einst Greta Garbo gehörte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
