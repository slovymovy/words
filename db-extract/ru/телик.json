                        "translation_id": "35e57c18-57aa-42b3-8940-81c37f4f16af",
                        "source_entry_id": "1b7ece8b-a3e2-3d84-ad41-647bf7ca4fd4",
                        "target_lang_word": "TV",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "TV",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7858835-d8b3-3ea7-97aa-0f38b30057bd",
                                        "entry_id": "6f9e6247-0d9b-3c5f-a88c-0833c26459d0",
                                        "glosses": [
                                            "Abbreviation of television."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afe73848-62d7-433b-bc77-3bace241a1f9",
                                                "sense_id": "e7858835-d8b3-3ea7-97aa-0f38b30057bd",
                                                "text": "I saw an ad for that on TV."
                                            },
                                            {
                                                "example_id": "9ddde282-9550-479c-b26e-7ca8ea23f166",
                                                "sense_id": "e7858835-d8b3-3ea7-97aa-0f38b30057bd",
                                                "text": "Believe me, the sun always shines on TV"
                                            },
                                            {
                                                "example_id": "bfce16a9-ef7a-42a0-acad-5019276ca0b2",
                                                "sense_id": "e7858835-d8b3-3ea7-97aa-0f38b30057bd",
                                                "text": "USB-C isn’t just how many PC laptops are charged; it’s also how the Chromecast With Google TV draws power. It’s also the only USB port in any modern MacBook, and it’s used for charging and data transfer in many Samsung Galaxy phones (dating back to 2016’s infamous Galaxy Note 7)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d010399-455c-3558-8de0-5711fc1b03cf",
                                        "entry_id": "6f9e6247-0d9b-3c5f-a88c-0833c26459d0",
                                        "glosses": [
                                            "Abbreviation of transvestite."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35db5174-b781-4fde-9452-3180b8fb140d",
                                                "sense_id": "2d010399-455c-3558-8de0-5711fc1b03cf",
                                                "text": "1970-1975, Lou Sullivan, personal diary, quoted in 2019, Ellis Martin, Zach Ozma (editors), We Both Laughed In Pleasure\nShe spoke of her male side as her \"brother\" as do older, more conventional TVs."
                                            },
                                            {
                                                "example_id": "75ea616d-b355-4ea1-ba02-0d7d02b9bd8a",
                                                "sense_id": "2d010399-455c-3558-8de0-5711fc1b03cf",
                                                "text": "I am in isolation and am lonely and would like to correspond with TVs, TSs and queens."
                                            },
                                            {
                                                "example_id": "8330dde9-0d76-422e-94e0-6a05a669e6e4",
                                                "sense_id": "2d010399-455c-3558-8de0-5711fc1b03cf",
                                                "text": "TV's who dominate and TV's who are dominated! TV's who are hot, sexy and horny as hell!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "592499cb-7f93-3e4d-8f29-cad1fb34f22c",
                                        "entry_id": "6f9e6247-0d9b-3c5f-a88c-0833c26459d0",
                                        "glosses": [
                                            "Initialism of tidal volume."
                                        ],
