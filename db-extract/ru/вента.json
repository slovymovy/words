                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fd8c42b-09b1-4cbd-ae36-83c215053e70",
                                "sense_id": "965cf0ff-ae7e-320d-9713-08abe3bdae36",
                                "text": "[Дон Гуан:] Я только что приехал.// И то тихонько - я ведь не прощён. [Лаура:] И вспомнил тотчас о своей Лауре? // Что хорошо, то хорошо. Да полно, // Не верю я. Ты мимо шёл случайно // И дом увидел. [Дон Гуан:] Нет, моя Лаура, // Спроси у Лепорелло. Я стою // За городом, в проклятой венте. Я Лауры // Пришёл искать в Мадриде. А.С. Пушкин"
                            }
                        ]
                    }
