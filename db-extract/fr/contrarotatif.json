                                        "glosses": [
                                            "Rotating in two directions by contrarotation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f258cf8-1efe-40b4-ad95-a7457441efff",
                                                "sense_id": "e8818937-9478-3859-b7f9-884919cd627d",
                                                "text": "Contrarotating propellers are two propellers rotating in opposite directions about the same shaft axis and usually driven by the same engine. Do not confuse them with counterrotating propellers which are propellers rotating in opposite directions, but on different shaft axes."
                                            }
