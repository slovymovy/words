                ],
                "senses": [
                    {
                        "sense_id": "0f79482d-2ec1-3e16-ba98-cdb2955b844a",
                        "entry_id": "cc3de472-12e0-3602-89b8-61d3e771dae6",
                        "glosses": [
                            "Zusatzartikel einer Verfassung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80f0f34e-ef94-4a3e-9946-0117373f1ca2",
                                "sense_id": "0f79482d-2ec1-3e16-ba98-cdb2955b844a",
                                "text": "„Jetzt wird es verdammt schwierig werden, den Kerl vor die Grand Jury zu bringen, denn wenn er die Zeitung liest - das heißt, wenn sein Anwalt sie liest -, wird er vorsichtshalber den fünfte Verfassungszusatz bemühen und sich auf sein Schweigerecht berufen.“"
                            },
                            {
                                "example_id": "742de6d0-8927-4cf9-b2b8-c485c5299c79",
                                "sense_id": "0f79482d-2ec1-3e16-ba98-cdb2955b844a",
                                "text": "„›Der Oberste Gerichtshof hat geurteilt, dass Firmen genau wie Menschen gemäß dem Ersten Verfassungszusatz das Recht besitzen, Wahlkampfspenden zu tätigen.‹“"
                            },
                            {
                                "example_id": "91ddd06e-4a42-41fc-a4a5-a183a4ef7476",
                                "sense_id": "0f79482d-2ec1-3e16-ba98-cdb2955b844a",
                                "text": "„›Die Gewerkschaft steckt voller Subversiver, und sie haben einen sogenannten Fachberatungsausschuss, der die Sache regelt: eine Frau und ein halbes Dutzend Männer - alle tief verbunden mit Gesinnungsgenossen, die ins Gefängnis gingen, weil sie sich 47 vor dem HUAC auf den fünften Verfassungszusatz beriefen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
