                        "examples": [
                            {
                                "example_id": "5630f13b-0767-4105-9091-6cee1db16d47",
                                "sense_id": "63f5fd99-a0db-36b1-b88a-2bd54c01b8af",
                                "text": "Le menuisier ne vint pas lui-même : il envoya Limousin, son ouvrier. Celui-ci était un de ces soûlauds qui ne se plaisent qu’auprès d’une bouteille de vin."
                            },
                            {
                                "example_id": "b9dad433-e37e-431e-99ee-04cf1d2b4837",
                                "sense_id": "63f5fd99-a0db-36b1-b88a-2bd54c01b8af",
                                "text": "Il y a bien eu un soûlaud qui cherchait la bagarre et qui a fait une scène terrible, il y a deux mois, mais c’était pas grand-chose."
                            }
                        ]
                    }
