                    {
                        "translation_id": "a7826987-cfe0-4742-b42e-21731a80c3b9",
                        "source_entry_id": "5cf42f44-7345-3fad-8fac-2426909e0572",
                        "source_sense_description": "early state in development",
                        "target_lang_word": "Anfangsphase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anfangsphase",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a0a9490-4b09-3359-bbed-269a0f3ee373",
                                        "entry_id": "aea8b260-f6a8-3e69-990d-68c86cb43d6b",
                                        "glosses": [
                                            "erster Teil eines Zeitraumes (Phase), der den Anfang einer Entwicklung markiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5cc674d-131b-4226-8a3e-4cdb8dc45242",
                                                "sense_id": "0a0a9490-4b09-3359-bbed-269a0f3ee373",
                                                "text": "In der Anfangsphase des Projektes gab es viele Schwierigkeiten mit den neuen Kollegen."
                                            },
                                            {
                                                "example_id": "c4e41a08-4744-4ba8-8a30-c29b7dabcab4",
                                                "sense_id": "0a0a9490-4b09-3359-bbed-269a0f3ee373",
                                                "text": "„Folglich bildete das Militär in der Anfangsphase der \"Kulturrevolution\" vor allem in den Großstädten das wichtigste Machtinstrument der politischen Gruppe um Mao.“"
                                            },
                                            {
                                                "example_id": "c8879098-c981-4190-bb48-1afc1c1a42df",
                                                "sense_id": "0a0a9490-4b09-3359-bbed-269a0f3ee373",
                                                "text": "„Und auch in den Anfangsphasen der Aviatik, von den ersten Fesselballons des 18. Jahrhunderts bis zu den Sichtflügen in der Pionierphase der Fliegerei, wiederholen sich die paradoxen Erfahrungen von ausgeschlossener Gegenwart, wie sie bis dahin lediglich bei Bergbesteigungen durch den Höhenblick aufgetreten waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ed0d4ec-c2b6-4699-95ad-7dce1d0ba58b",
                        "source_entry_id": "5cf42f44-7345-3fad-8fac-2426909e0572",
                        "source_sense_description": "law: state of being minor",
                        "target_lang_word": "несовершенноле́тие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "несовершенноле́тие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c33143b7-9bec-3931-8c3b-9a51dafac2ce",
                                        "entry_id": "858e0b0b-3dc9-31d8-9b99-2e3daae1a3e4",
                                        "glosses": [
                                            "юр., офиц. возраст человека, не достигшего совершеннолетия, являющийся в силу присущих ему особенностей основанием для издания специальных норм, ограждающих интересы лиц этой возрастной группы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a30778e-ca89-4a31-9390-0f853d6a9ee0",
                                                "sense_id": "c33143b7-9bec-3931-8c3b-9a51dafac2ce",
                                                "text": "Погрозив, что он разведет Парашу с мужем по её несовершеннолетию, он отправился домой, но заехал по дороге к священнику, который венчал Куролесовых."
                                            },
                                            {
                                                "example_id": "50d8b67e-797d-4268-a6c0-acda2b93210d",
                                                "sense_id": "c33143b7-9bec-3931-8c3b-9a51dafac2ce",
                                                "text": "Суд признал его виновным, но, в виду его несовершеннолетия, приговорил к 8-ми годам тюрьмы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
