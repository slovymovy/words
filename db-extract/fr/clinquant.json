                ],
                "senses": [
                    {
                        "sense_id": "bf0dbad2-df7b-35e7-a1a7-b7e1e9eae535",
                        "entry_id": "b2c5e313-e631-3110-b2c0-855fe11d3d03",
                        "glosses": [
                            "Qualifie ce qui se donne à voir comme artificiellement brillant ou prétentieux."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ec424708-7ea3-45ba-986c-c2d5127ed865",
                                "sense_id": "bf0dbad2-df7b-35e7-a1a7-b7e1e9eae535",
                                "text": "Le « Virtuosa » est un vaisseau clinquant, joyeux, coloré, kitch, digne représentant assumé du gigantisme et de tous les superlatifs, devant lequel il est difficile de rester impassible."
                            },
                            {
                                "example_id": "5a882918-dc40-4a33-8f87-10e566ded07f",
                                "sense_id": "bf0dbad2-df7b-35e7-a1a7-b7e1e9eae535",
                                "text": "Par son travail sur les costumes, Sophie Desmarais a mis en évidence les contrastes entre MTS [Marie-Stella, ainsi surnommée par ses camarades de classe] et Marie-Clown. Cheveux gaufrés, vêtements amples couleur saumon et bas de nylon donnent à la première une allure de gamine venue tout droit des années 80. À l’opposé, la seconde est clairement de son temps : jupe courte, chandail bedaine, bracelets clinquants, gomme à mâcher, maquillage, espadrilles. Toutes deux paraissent pourtant déguisées : pas encore adultes, encore un peu enfants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e33cbc04-5838-486e-9d51-5e1bda6985b6",
                        "source_entry_id": "b2c5e313-e631-3110-b2c0-855fe11d3d03",
                        "source_sense_id": "bf0dbad2-df7b-35e7-a1a7-b7e1e9eae535",
                        "target_lang_word": "clinquant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clinquant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0b9d0c8-816f-3c8d-ac84-dd6d0b51a324",
                                        "entry_id": "0c136889-5e15-3845-b34a-a1571c377f2c",
                                        "glosses": [
                                            "Glittery; gleaming; sparkling; dressed in, or overlaid with, tinsel finery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13530c12-b665-46a4-a383-14a1a5eac45c",
                                                "sense_id": "c0b9d0c8-816f-3c8d-ac84-dd6d0b51a324",
                                                "text": "Today the French, / All clinquant, all in gold, like heathen gods, / Shone down the English;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clinquant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abaaa9e2-a59c-3b8a-8073-cb941bc27db0",
                                        "entry_id": "5e47a46e-9b65-30ee-9243-53e84841cc23",
                                        "glosses": [
                                            "Dutch metal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f76fb10-80ab-3aba-83ad-67e38c438ff8",
                                        "entry_id": "5e47a46e-9b65-30ee-9243-53e84841cc23",
                                        "glosses": [
                                            "Tinsel; glitter."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04246cb2-b1fd-4b4a-890c-edd4e8ca20d1",
                                                "sense_id": "7f76fb10-80ab-3aba-83ad-67e38c438ff8",
                                                "text": "Harrison came that day in a scarlett coate and cloake, both laden with gold and silver lace, and the coate so cover'd with clinquant, that scarcely could one discerne the ground,"
                                            },
                                            {
                                                "example_id": "02883429-acbd-402b-abb3-4eaadb250c25",
                                                "sense_id": "7f76fb10-80ab-3aba-83ad-67e38c438ff8",
                                                "text": "Lely supplied the want of taste with clinquant; his nymphs trail fringes and embroidery through meadows and purling streams."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1f3e99a-cf72-4975-a3c8-5452cb965000",
                        "source_entry_id": "b2c5e313-e631-3110-b2c0-855fe11d3d03",
                        "source_sense_id": "bf0dbad2-df7b-35e7-a1a7-b7e1e9eae535",
