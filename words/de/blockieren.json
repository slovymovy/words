            "senses": [
                {
                    "sense_id": "7e83b459-e3c7-36ff-a638-020f48076cab",
                    "sense_definition": "Einen Weg, eine Durchfahrt oder einen Zugang versperren und dadurch unpassierbar machen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "versperren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen eines schweren Unfalls <w>blockierten</w> mehrere Autos die Straße."
                        },
                        {
                            "text": "Bitte stellen Sie Ihre Koffer nicht in den Flur, damit Sie nicht den Notausgang <w>blockieren</w>."
                        }
                    ],
                    "synonyms": [
                        "abriegeln",
                        "absperren",
                        "sperren",
                        "versperren"
                    ],
                    "antonyms": [
                        "freiräumen"
                    ],
                    "common_phrases": [
                        "die Straße blockieren",
                        "den Verkehr blockieren",
                        "den Notausgang blockieren"
                    ]
                },
                {
                    "sense_id": "c8f13860-8112-3f65-b677-a9960e403e6f",
                    "sense_definition": "Einen Ablauf, eine Entwicklung oder ein Vorhaben gezielt stören oder verhindern.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verhindern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Opposition versuchte mit allen Mitteln, das neue Gesetz im Parlament zu <w>blockieren</w>."
                        },
                        {
                            "text": "Seit einigen Tagen <w>blockiert</w> das Netzwerk den Zugriff auf externe Webseiten."
                        }
                    ],
                    "synonyms": [
                        "aufhalten",
                        "blocken"
                    ],
                    "common_phrases": [
                        "eine Entscheidung blockieren",
                        "den Zugang blockieren"
                    ]
                },
                {
                    "sense_id": "716c7987-2c0e-381b-af36-53e1b3d2312c",
                    "sense_definition": "Die reguläre Bewegung eines Geräts oder Maschinenteils durch Defekt, Klemmen oder extremen Druck zum Stillstand bringen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn Sie auf nassem Laub zu stark bremsen, können die Räder plötzlich <w>blockieren</w>."
                        },
                        {
                            "text": "Ein kleines Steinchen geriet in den Mechanismus und hat das Getriebe <w>blockiert</w>."
                        }
                    ],
                    "common_phrases": [
                        "die Räder blockieren"
                    ]
                },
                {
                    "sense_id": "4fccbf06-29be-3894-bded-60a398ded996",
                    "sense_definition": "Mental oder emotional unfähig sein weiterzudenken, zu handeln oder sich auf etwas einzulassen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei der wichtigen Prüfung bekam er plötzlich Panik und <w>blockierte</w> völlig."
                        },
                        {
                            "text": "Sobald man sie auf diesen alten Konflikt anspricht, <w>blockiert</w> sie sofort."
                        }
                    ],
                    "common_phrases": [
                        "völlig blockieren"
                    ]
                }
            ]
        }
    ]
