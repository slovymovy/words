                "senses": [
                    {
                        "sense_id": "a3bdfcda-75f0-3457-b9d7-d30de9057733",
                        "entry_id": "1439e2bc-9cee-313c-bf35-0e9fbdce1d58",
                        "glosses": [
                            "związany z sunnitami lub sunnizmem"
                        ],
                        "tags": [],
