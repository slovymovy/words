                "senses": [
                    {
                        "sense_id": "ecd1570f-0580-39b1-905a-8150d8dd160a",
                        "entry_id": "3918af08-62f4-36a5-8ef4-6eff0d8a4314",
                        "glosses": [
                            "aus zwei Graphen bestehendes Graphem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7e7a6d9-7757-40f2-b601-43e43d1bfb6d",
                                "sense_id": "ecd1570f-0580-39b1-905a-8150d8dd160a",
                                "text": "„Es zeigt sich jedoch eine starke Abhängigkeit vom jeweiligen Digraphem, z.B. hat die Kombination ‹o—t› bei den kombinierten Silben- und Morphemgrenzen zwar eine relativ geringe mittlere Dauer, aber eine sehr hohe Anzahl von Luftsprüngen.“"
                            },
                            {
                                "example_id": "9707af89-0765-479d-8340-bde7f9958e76",
                                "sense_id": "ecd1570f-0580-39b1-905a-8150d8dd160a",
                                "text": "„Im Inlaut intervokalisch jedoch begegnet konsequent in einer Umgebung, in der im Mhd. dem ein Digraphem oder ein bei Krafft digraphemisiertes Monographem vorangeht.“"
                            },
                            {
                                "example_id": "2f846ffd-fe42-4e99-9201-6500ea9bf962",
                                "sense_id": "ecd1570f-0580-39b1-905a-8150d8dd160a",
                                "text": "„Phoneme bestehen im Deutschen aus einem Buchstaben (Monographem , zweien (Digraphem ) oder dreien .“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
