                    },
                    {
                        "translation_id": "34096dee-308c-4c63-8b17-1a9009baa779",
                        "source_entry_id": "32959e04-a71d-3a07-9cd3-792ed27b842e",
                        "source_sense_id": "6b715f74-0511-31e0-a525-2307330743b3",
                        "target_lang_word": "durchfurchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a7b71fe9-18f5-42e7-a0d4-9f8aa5d251f5",
                        "source_entry_id": "32959e04-a71d-3a07-9cd3-792ed27b842e",
                        "source_sense_id": "6b715f74-0511-31e0-a525-2307330743b3",
                        "target_lang_word": "sillonner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sillonner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8222aaa9-c78a-34f9-8fbd-72e65c95dab2",
                                        "entry_id": "294fca38-8711-3414-9e64-7a3d96bbdadc",
                                        "glosses": [
                                            "Faire des sillons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c69b3d4-c354-4940-97cf-ee5699f7627f",
                                                "sense_id": "8222aaa9-c78a-34f9-8fbd-72e65c95dab2",
                                                "text": "Il faut observer que, si l’on plante en côtes, il faut sillonner en travers, cela conserve la fraicheur & les terres ; au lieu de quoi si l’on sillonnoit de haut en bas, les pluies feroient des ravins : […]."
                                            },
                                            {
                                                "example_id": "1219930c-365c-40ae-9afe-16faef4f996a",
                                                "sense_id": "8222aaa9-c78a-34f9-8fbd-72e65c95dab2",
                                                "text": "— […], ils supprimèrent les innombrables droits de douane qui sillonnaient le sol de la France et qui le déchiraient dans tous les sens; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b1a1fb9-efb7-3a55-8e58-720ee6f67b6e",
                                        "entry_id": "294fca38-8711-3414-9e64-7a3d96bbdadc",
                                        "glosses": [
                                            "Marquer d'un sillon."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b77cce5e-e63d-43a2-81e5-de2c1af64746",
                                                "sense_id": "8b1a1fb9-efb7-3a55-8e58-720ee6f67b6e",
                                                "text": "L’adolescent se tenait debout, son calot à la main. Il avait l'air songeur, préoccupé : une ride lui sillonnait douloureusement le front."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e76be92-888d-34d4-836d-c7d042d8b61f",
                                        "entry_id": "294fca38-8711-3414-9e64-7a3d96bbdadc",
                                        "glosses": [
                                            "Laisser des traces de son passage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ba8e7b-bac6-4fbf-aec7-f1193d07d102",
                                                "sense_id": "5e76be92-888d-34d4-836d-c7d042d8b61f",
                                                "text": "Il y a tantôt soixante-sept ans que les ballons sillonnent l’espace, et cependant, à chaque ascension, une sorte de curiosité inquiète rassemble autour de l'aérostat une foule aussi nombreuse que si c’était la première fois que ce spectacle fût donné aux hommes."
                                            },
                                            {
                                                "example_id": "ad1bfa38-7fe6-4f83-a64e-f57611a21a42",
                                                "sense_id": "5e76be92-888d-34d4-836d-c7d042d8b61f",
                                                "text": "Aucune route frayée ne sillonnait le voisinage, et, pour atteindre notre heureuse retraite, il fallait repousser le feuillage de milliers d’arbres forestiers […]."
                                            },
                                            {
                                                "example_id": "48f849a1-07d5-4d8c-8ec8-aee566b95e7c",
                                                "sense_id": "5e76be92-888d-34d4-836d-c7d042d8b61f",
                                                "text": "Les rafales d’une violence inouïe, accès de colère de Wottan ou de Thor, tombent des hauteurs en sifflant et soulèvent des tourbillons d’embruns qui sillonnent la mer."
                                            },
                                            {
                                                "example_id": "6da2989d-7fe7-4683-9a7f-72577d0661d0",
                                                "sense_id": "5e76be92-888d-34d4-836d-c7d042d8b61f",
                                                "text": "Leurs vaisseaux sillonnent les mers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d860a1c2-4f4c-33f0-9b92-53886c3d9ed3",
                                        "entry_id": "294fca38-8711-3414-9e64-7a3d96bbdadc",
                                        "glosses": [
                                            "Parcourir en tous sens."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fa8b0c7-9d5b-4167-a9d8-3bee35bb5eca",
                                                "sense_id": "d860a1c2-4f4c-33f0-9b92-53886c3d9ed3",
                                                "text": "Ce fut pour moi le début d’une longue errance à travers Paris, à la recherche de celle qui m’obsédait de plus en plus. Je sillonnais la ville avec méthode, arrondissement par arrondissement, quartier par quartier, rue par rue, station de métro par station de métro."
                                            },
                                            {
                                                "example_id": "362329c3-49a3-496e-8150-e18886abf4fc",
                                                "sense_id": "d860a1c2-4f4c-33f0-9b92-53886c3d9ed3",
                                                "text": "« GAI COMME LE CANAL ». Cette expression d’effroi glacé n'est pas usurpée quand nous prend l’idée saugrenue de sillonner les parties les plus urbaines des canaux de l’Ourcq et de Saint-Denis."
                                            },
                                            {
                                                "example_id": "dc748ef3-013f-4493-8ddf-90c73749ade1",
                                                "sense_id": "d860a1c2-4f4c-33f0-9b92-53886c3d9ed3",
                                                "text": "Au-dehors, les chiens sillonnent la pelouse en se disputant un vieux ballon de foot."
                                            },
                                            {
                                                "example_id": "ab064e80-64eb-494b-9496-2140fd0154a0",
                                                "sense_id": "d860a1c2-4f4c-33f0-9b92-53886c3d9ed3",
                                                "text": "Il me suffirait de suivre le vieux, le long de la rue Mitjaville, sillonner dans les escaliers, exiger qu'il prenne du cash à la tirette de la Banque Populaire, et le braquer sans violence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
