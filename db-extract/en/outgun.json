                "senses": [
                    {
                        "sense_id": "f2e93848-0566-3aa8-af46-a044aa3a2442",
                        "entry_id": "9a192d58-8fcc-3aa7-9035-fa0aa140388c",
                        "glosses": [
                            "To defeat in terms of firepower."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a5ae6bc4-6316-4647-afe3-72004b3b52fd",
                                "sense_id": "f2e93848-0566-3aa8-af46-a044aa3a2442",
                                "text": "Two can play at destructive industrialism, and now we out-gun you. We are piling up munitions now faster than you."
                            },
                            {
                                "example_id": "0777de55-4d56-48e0-89e2-f7c6923ecea5",
                                "sense_id": "f2e93848-0566-3aa8-af46-a044aa3a2442",
                                "text": "\"Boarding is our only chance here. We are too heavily outgunned.\""
                            },
                            {
                                "example_id": "01172a49-20da-4a0f-80ec-fa9df2cc3d7e",
                                "sense_id": "f2e93848-0566-3aa8-af46-a044aa3a2442",
                                "text": "There is no sporting purpose on earth that should stop the United States Congress from banishing assault weapons that outgun police and cut down children."
                            }
                        ]
                    }
                ],
