                "senses": [
                    {
                        "sense_id": "e48be679-30c9-3908-ae30-3d99a896101f",
                        "entry_id": "8cc3be0e-cdd3-3d8f-8aa5-f2f28fdbec12",
                        "glosses": [
                            "een deel van een gebouw waarin men een gevangene achter slot en grendel kan bewaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c3b137-01b2-43d3-ab8e-06df97bb0c55",
                                "sense_id": "e48be679-30c9-3908-ae30-3d99a896101f",
                                "text": "En dan die ene celruimte. Het slot van de celdeur is stuk. Om de gedetineerden toch achter de tralies te houden, hebben agenten de celdeur is gebarricadeerd met een houten balk!"
                            }
                        ]
                    },
                    {
                        "sense_id": "32d7f2a7-88fb-3d52-8aa0-c45363b0787d",
                        "entry_id": "8cc3be0e-cdd3-3d8f-8aa5-f2f28fdbec12",
                        "glosses": [
                            "ruimten die gebruikt kunnen worden als gevangeniscel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96825b92-8f5a-4895-a637-c452aa73ed21",
                                "sense_id": "32d7f2a7-88fb-3d52-8aa0-c45363b0787d",
                                "text": "Psychiatrisch patiënt Paul B. uit Hengelo is in verzekering gesteld. Bij gebrek aan celruimte in een speciale gevangenis voor psychiatrische verdachten, mag hij de verzekering doorbrengen in het psychiatrisch ziekenhuis Helmerzijde in Enschede, waar hij al verbleef."
                            },
                            {
                                "example_id": "a38d2630-357e-4b72-a4de-6ab1e77633d4",
                                "sense_id": "32d7f2a7-88fb-3d52-8aa0-c45363b0787d",
                                "text": "Teeven moest zijn bezuinigingsplannen voor de justitiële inrichtingen twee weken gelden aanpassen, omdat een meerderheid in de Tweede Kamer niets ziet in grootschalige invoer van elektronische detentie. Daardoor is veel meer celruimte nodig."
                            }
                        ]
                    }
