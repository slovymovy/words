                                "target_senses": [
                                    {
                                        "sense_id": "e8e741ca-ec9d-3009-94b9-20b0426b0196",
                                        "entry_id": "bf9dae15-8cbc-359a-8657-e6dfb472a682",
                                        "glosses": [
                                            "alt wirkend, Merkmale des Alters aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbc7e3b3-4162-428e-982b-8a8bb1e9cba3",
                                                "sense_id": "e8e741ca-ec9d-3009-94b9-20b0426b0196",
                                                "text": "„Etwas an ihrem dünnen, ältlichen, stets anklagenden Gesicht würde ihm fehlen, wäre sie einmal nicht mehr da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
