                "senses": [
                    {
                        "sense_id": "ff126e6a-44ab-30a7-88d1-116036ba75f6",
                        "entry_id": "739a128b-5fef-3afa-97f1-955e8eaa46ff",
                        "glosses": [
                            "имеющий белую или очень светлую гриву"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1bb8a72-4d8c-4889-bc6c-e667a17732b7",
                                "sense_id": "ff126e6a-44ab-30a7-88d1-116036ba75f6",
                                "text": "В последний раз Гудал садится // На белогривого коня."
                            }
                        ]
                    },
                    {
                        "sense_id": "8294ec5a-f1ad-3cc9-a000-e912d443dd8f",
                        "entry_id": "739a128b-5fef-3afa-97f1-955e8eaa46ff",
                        "glosses": [
                            "перен. имеющий белый, пенистый гребень (о волнах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca514b95-d5dc-466b-92bd-773b93617ca3",
                                "sense_id": "8294ec5a-f1ad-3cc9-a000-e912d443dd8f",
                                "text": "По Неве бежали в темноте белогривые волны, с моря порывами дул влажный ветер и выл в воздухе."
                            }
                        ]
                    }
