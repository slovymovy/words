                ],
                "senses": [
                    {
                        "sense_id": "e616068d-87d3-39f0-8ead-e18c927b34fe",
                        "entry_id": "abf2ec8b-3c1b-3f29-8364-4f7587a3ea1c",
                        "glosses": [
                            "so, dass es nicht entfernt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02d78eb6-264b-44a7-9ad8-8bd0754d0b8b",
                                "sense_id": "e616068d-87d3-39f0-8ead-e18c927b34fe",
                                "text": "„Bringen doch die Flamme und das Ofenfutter in jedes noch so reine Metall Zusätze hinein, ganz abgesehen von denjenigen Stoffen, die bei der hier beschriebenen schwierigen Verhüttung ohnehin unentfernbar sind.“"
                            },
                            {
                                "example_id": "fd7cd5f2-fd8e-43ee-9ebe-d5de8ce8654b",
                                "sense_id": "e616068d-87d3-39f0-8ead-e18c927b34fe",
                                "text": "„Den Westen und Süden hielt eifersüchtig, unentfernbar und unentbehrlich, der Präfekt.“"
                            },
                            {
                                "example_id": "85f4900e-b912-40a2-af96-6ef83c1336fc",
                                "sense_id": "e616068d-87d3-39f0-8ead-e18c927b34fe",
                                "text": "„Ich habe zwar einige Erfahrung mit unentfernbaren Flecken, was ich gar nicht weiter ausführen möchte, aber ich wollte definitiv kein Sofa mit Kulifleck.“"
                            },
                            {
                                "example_id": "183e893c-207b-41dd-9ce7-c9a25636023c",
                                "sense_id": "e616068d-87d3-39f0-8ead-e18c927b34fe",
                                "text": "„Es passiert Ihnen nicht mehr, dass an sich entfernbare Flecken durch falsche Behandlung unentfernbar werden.“"
                            },
                            {
                                "example_id": "ed6bf200-8ee2-47c3-ba51-52154d4c0639",
                                "sense_id": "e616068d-87d3-39f0-8ead-e18c927b34fe",
                                "text": "„Das digitale Wasserzeichen für Audio-Dateien erlaubt es, aus jeder Kopie eines Musikstückes ein Unikat zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
