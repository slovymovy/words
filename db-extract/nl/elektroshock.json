                        "source_sense_id": "7f1a078f-f591-34bd-99a1-f73ae014417f",
                        "target_lang_word": "électrochoc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "électrochoc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8527a49e-0b49-3e4d-9259-74cbe404dea6",
                                        "entry_id": "07b1e055-a327-3894-8bd3-7efb9713bd85",
                                        "glosses": [
                                            "Choc électrique au niveau du crâne qui engendre une crise convulsive généralisée et une perte de conscience, utilisé à des fins thérapeutiques. → voir sismothérapie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57009737-de5d-426e-b937-3116ce8f16e1",
                                                "sense_id": "8527a49e-0b49-3e4d-9259-74cbe404dea6",
                                                "text": "Merveilleux et terribles électrochocs qui révolutionnèrent le traitement de la mélancolie avant de devenir, 20 ans plus tard, une cible privilégiée des antipsychiatres."
                                            },
                                            {
                                                "example_id": "ed1243b4-c7c2-4017-9bb8-3f7753c2f3a3",
                                                "sense_id": "8527a49e-0b49-3e4d-9259-74cbe404dea6",
                                                "text": "En 1947, aux États-Unis, on lui avait administré des électrochocs pour des troubles psychiatriques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d08c015e-e2a1-3d9c-855c-a1b51fe88307",
                                        "entry_id": "07b1e055-a327-3894-8bd3-7efb9713bd85",
                                        "glosses": [
                                            "Synonyme de sismothérapie."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2694110b-3829-3e14-8cd2-684167cb3a62",
                                        "entry_id": "07b1e055-a327-3894-8bd3-7efb9713bd85",
                                        "glosses": [
                                            "Événement brutal, marquant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b14a134-28c1-4c24-83fc-3c8e5ef25bd1",
                                                "sense_id": "2694110b-3829-3e14-8cd2-684167cb3a62",
                                                "text": "L'Union européenne a lancé ses propres plans sur la sécurité de ces objets connectés, après l'électrochoc Mirai fin 2016."
                                            },
                                            {
                                                "example_id": "804a74f0-c872-4c82-b035-36fc5cdc8cd6",
                                                "sense_id": "2694110b-3829-3e14-8cd2-684167cb3a62",
                                                "text": "Il faut espérer que ces images qui circulent depuis hier aient l’effet d’un électrochoc et qu’elles secouent la classe politique."
                                            },
                                            {
                                                "example_id": "3df023a4-8d15-48d3-92f7-fa3827e93721",
                                                "sense_id": "2694110b-3829-3e14-8cd2-684167cb3a62",
                                                "text": "La dauphine de Labeaume doit réaliser que la sienne a besoin d’un électrochoc, alors qu’elle a plutôt ralenti le rythme."
                                            }
                                        ]
                                    }
                                ]
                            }
