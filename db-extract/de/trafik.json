                                        "glosses": [
                                            "negozio dove si possono comprare generi di monopolio statale come sigarette, schedine del lotto, ricariche telefoniche e altro; il cui nome ufficiale è rivendita di sali e tabacchi"
                                        ],
                                        "tags": [],
