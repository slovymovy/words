            "pos": "verb",
            "senses": [
                {
                    "sense_id": "07e4a2a0-1373-37fa-a1ed-04945f1944fd",
                    "sense_definition": "podawać leki wyłączające odczuwanie bólu podczas zabiegu medycznego",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medycyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyrwaniem chorego zęba dentysta miejscowo <w>znieczula</w> dziąsło pacjenta.",
                            "target_lang_translations": {
                                "ru": "Перед удалением больного зуба стоматолог местно <w>обезболивает</w> десну пациента."
                            }
                        },
                        {
                            "text": "Lekarz anestezjolog ostrożnie <w>znieczulał</w> chorego przed skomplikowaną operacją serca.",
                            "target_lang_translations": {
                                "ru": "Врач-анестезиолог осторожно <w>вводил наркоз</w> больному перед сложной операцией на сердце."
                            }
                        }
                    ],
                    "common_phrases": [
                        "znieczulać miejscowo",
                        "znieczulać pacjenta"
                    ],
                    "target_lang_definitions": {
                        "ru": "вводить обезболивающие препараты перед медицинской процедурой или во время неё"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезболивать",
                                "target_lang_sense_clarification": "лишать чувствительности к боли перед процедурой"
                            },
                            {
                                "target_lang_word": "анестезировать",
                                "target_lang_sense_clarification": "проводить анестезию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19ff6081-80a1-33da-b580-586fd013a144",
                    "sense_definition": "czynić kogoś lub siebie obojętnym na emocje, cierpienie lub bodźce",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ciągły stres i trudne doświadczenia powoli <w>znieczulają</w> człowieka na krzywdę innych.",
                            "target_lang_translations": {
                                "ru": "Постоянный стресс и тяжелый опыт постепенно <w>делают</w> человека <w>равнодушным</w> к чужой беде."
                            }
                        },
                        {
                            "text": "Mężczyzna próbował <w>znieczulać</w> swój ból po stracie bliskiej osoby alkoholem.",
                            "target_lang_translations": {
                                "ru": "Мужчина пытался <w>заглушать</w> свою боль от утраты близкого человека алкоголем."
                            }
                        }
                    ],
                    "synonyms": [
                        "zobojętniać"
                    ],
                    "common_phrases": [
                        "znieczulać na ból",
                        "znieczulać na cierpienie"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать кого-либо нечувствительным, равнодушным к эмоциям, страданиям или переживаниям; заглушать душевную боль"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожесточать",
                                "target_lang_sense_clarification": "делать черствым или равнодушным"
                            },
                            {
                                "target_lang_word": "притуплять",
                                "target_lang_sense_clarification": "делать чувства или боль менее острыми"
                            },
                            {
                                "target_lang_word": "заглушать",
                                "target_lang_sense_clarification": "подавлять внутреннюю боль или переживания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bc3030a-c516-349a-9963-7b8b0c22f967",
                    "sense_definition": "pić alkohol w celu uśmierzenia przykrych emocji lub odurzenia się",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "alkohol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W każdy piątkowy wieczór spotykali się w barze i wspólnie <w>znieczulali</w> się piwem.",
                            "target_lang_translations": {
                                "ru": "Каждый вечер пятницы они встречались в баре и вместе <w>заливали тоску</w> пивом."
                            }
                        },
                        {
                            "text": "Zamiast stawić czoła codziennym problemom, wolał wieczorami regularnie <w>znieczulać</w> się drogimi trunkami.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы решать повседневные проблемы, он предпочитал по вечерам регулярно <w>глушить боль</w> дорогими напитками."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie picia alkoholu"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "употреблять алкоголь, чтобы заглушить неприятные эмоции или одурманить себя (разг.)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заливать",
                                "target_lang_sense_clarification": "заливать тоску или проблемы алкоголем"
                            },
                            {
                                "target_lang_word": "глушить",
                                "target_lang_sense_clarification": "подавлять переживания выпивкой"
                            },
                            {
                                "target_lang_word": "накачиваться",
                                "target_lang_sense_clarification": "напиваться до потери чувствительности"
                            }
                        ]
                    }
                }
            ]
        }
