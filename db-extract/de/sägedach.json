                        "form": "die Sägedächer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "939ad07b-6969-3a1f-8943-779c83e19fb1",
                        "entry_id": "156ef7dc-d407-3bbc-ae18-68bfffaf2f2d",
                        "glosses": [
                            "Dach mit aufgesetzten über die Dachbreite verlaufenden im Profil dreieckigen Teildächern; oft mit Lichteinlässen/Lufteinlässen; oft im Industriebau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dea3f793-11cf-4803-b04e-a7586bdcc1b7",
                                "sense_id": "939ad07b-6969-3a1f-8943-779c83e19fb1",
                                "text": "„Vor allem gewährleisten Sägedächer eine ideale natürliche Beleuchtung.“"
                            },
                            {
                                "example_id": "b7ceb933-3087-415f-ac4a-7f977bacf24a",
                                "sense_id": "939ad07b-6969-3a1f-8943-779c83e19fb1",
                                "text": "„Sägedächer werden häufig beim Bau von Fabrikhallen und anderen größeren Gebäuden verwendet.“"
                            },
                            {
                                "example_id": "bafef8b5-90e7-4feb-9b41-c4fc2cb8069c",
                                "sense_id": "939ad07b-6969-3a1f-8943-779c83e19fb1",
                                "text": "„Die Sägedächer gehen auf Ernst Neufert zurück und Konstrukteur der 1950 fertiggestellten Stahlhalle war Josef Gartner.“"
                            },
                            {
                                "example_id": "d64ccdf9-53cd-4bd8-9c32-22e8dfc1ce81",
                                "sense_id": "939ad07b-6969-3a1f-8943-779c83e19fb1",
                                "text": "„Die Giebelseite des Hauses ist in drei Achsen gegliedert, die jedoch unregelmäßig mit Fenstern bestückt sind, daran schließt die ehemalige Werkstatt mit Sägedach an.“"
                            },
                            {
                                "example_id": "d89cdee9-1a14-4694-8315-89c90383a0c7",
                                "sense_id": "939ad07b-6969-3a1f-8943-779c83e19fb1",
                                "text": "„Ein ſolches Sägedach iſt eigentlich weiter nichts als ein Satteldach (von 5-8m Spannweite) mit ungleich großen Dachflächen und verſchiedenen Neigungen.“"
                            },
                            {
                                "example_id": "2b155458-396f-4575-80b4-0b96e39e5dfa",
                                "sense_id": "939ad07b-6969-3a1f-8943-779c83e19fb1",
                                "text": "Das Glasdach ſoll mindeſtens so groß sein, daß der unter einem Sägedach befindliche Webſtuhl vom ganzen einfallenden Lichtbündel beleuchtet werden kann."
                            },
                            {
                                "example_id": "8d0f33d8-8e15-478f-bfdb-789dc8559dd7",
                                "sense_id": "939ad07b-6969-3a1f-8943-779c83e19fb1",
                                "text": "„Der Bau trägt sein vierzackiges Sägedach wie eine Krone und wendet dem Besucher eine breite Backsteinbrust zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
