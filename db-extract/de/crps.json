                "senses": [
                    {
                        "sense_id": "4904e731-48e2-34e9-b3cc-bb2abebd05a9",
                        "entry_id": "1d2f52db-40dd-38af-92f3-22841f9ab5f9",
                        "glosses": [
                            "neurologisch-orthopädisch-traumatologische Erkrankung, bei der es zu Kraftverlust, Verlust der Willkürbewegung, Tremor und Koordinationsstörungen der Gliedmaßen (Hand, Finger, Fuß) kommen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de6c5e77-01e7-40bd-9f68-42787f06ddf6",
                                "sense_id": "4904e731-48e2-34e9-b3cc-bb2abebd05a9",
                                "text": "„Auch motorische Störungen gehören zum CRPS und führen zu einer frühen Behinderung. Dazu zählen: Kraftverlust, Verlust der Willkürbewegung, Tremor und Koordinationsstörungen.“"
                            },
                            {
                                "example_id": "44ca8165-9cc8-41f2-a7bb-922ce26a37c2",
                                "sense_id": "4904e731-48e2-34e9-b3cc-bb2abebd05a9",
                                "text": "CRPS „gehört zu den neurologisch-orthopädisch-traumatologischen Erkrankungen. Der Begriff fasst die synonym verwendeten Bezeichnungen Reflexdystrophie, Morbus Sudeck, Sudeck-Dystrophie, Algodystrophie und sympathische Reflexdystrophie zusammen, die nach vorliegendem Konsens nicht mehr benutzt werden.“"
                            },
                            {
                                "example_id": "cbce9166-d796-4b83-9513-6cee00f66ca8",
                                "sense_id": "4904e731-48e2-34e9-b3cc-bb2abebd05a9",
                                "text": "Nach einer Operation am Oberarm leidet der Patient an CRPS."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
