                ],
                "senses": [
                    {
                        "sense_id": "973a1b5e-a3ca-3972-aca3-ad07749a97fb",
                        "entry_id": "28fd7667-3909-3179-bac7-d04337bb1903",
                        "glosses": [
                            "imię żeńskie, Katarzyna"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "6b6393ac-a290-455d-bc9f-6f6ebbd578b5",
                                "sense_id": "973a1b5e-a3ca-3972-aca3-ad07749a97fb",
                                "text": "Pożyczyłam Kaśce ten zeszyt."
                            },
                            {
                                "example_id": "6ebc3671-c63c-41f4-8a74-865795f972b5",
                                "sense_id": "973a1b5e-a3ca-3972-aca3-ad07749a97fb",
                                "text": "Aaaa, Kaśka pipę pokazała! – krzyknął umorusany blondynek, wskazując brudnym paluchem na dziewczynkę, której twarz natychmiast pokryła się rumieńcem"
                            },
                            {
                                "example_id": "2fa66915-cf09-462a-ac30-484ff12131ae",
                                "sense_id": "973a1b5e-a3ca-3972-aca3-ad07749a97fb",
                                "text": "Kaśka nawet nie próbowała mamić się mrzonkami, że Zbigniew na wieść o dziecku odejdzie od żony."
                            },
                            {
                                "example_id": "82f2d48e-fc05-4067-845c-4f0569a519ad",
                                "sense_id": "973a1b5e-a3ca-3972-aca3-ad07749a97fb",
                                "text": "Mój pradziad, Jakub, przywiózł z Polski syna Jędrka. Tego samego roku powiedział do niego: – Idź, Jędruś, do Kosińskich, tam jest Kaśka, może ona się z tobą ożeni. A jak się ożeni, to ci dam dwadzieścia pięć hektarów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4545c3ce-3b25-4806-8a58-d62ac5a2b7d4",
                        "source_entry_id": "28fd7667-3909-3179-bac7-d04337bb1903",
                        "source_sense_id": "973a1b5e-a3ca-3972-aca3-ad07749a97fb",
                        "target_lang_word": "Cathy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cathy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e45ca9b-be1b-356d-aeb7-5c44a62656ad",
                                        "entry_id": "d204bc61-bba3-3b93-b7dd-15198ca3872e",
                                        "glosses": [
                                            "A diminutive of the female given name Catherine and of its variant forms, also used as a formal given name in the 20th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca67b647-6548-40f5-a8a1-c032561961be",
                                                "sense_id": "0e45ca9b-be1b-356d-aeb7-5c44a62656ad",
                                                "text": "It was named Catherine, but he never called it the name in full, as he had never called the first Catherine short, probably because Heathcliff had a habit of doing so. The little one was always Cathy, it formed to him a distinction from the mother, and yet, a connection with her; ( - - - )"
                                            },
                                            {
                                                "example_id": "05a404a8-fa1b-4d37-ae31-207cc78a4fc1",
                                                "sense_id": "0e45ca9b-be1b-356d-aeb7-5c44a62656ad",
                                                "text": "'Cathy sounds like the name of a truck-stop waitress,' she overheard her father-in-law tell Adam after they returned from their honeymoon. 'Tell her to call herself Cat and, for Christ's sake, get her to stop biting her lip all the time.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
