                "senses": [
                    {
                        "sense_id": "62d356d9-32dd-3de6-98b1-67e71f82f042",
                        "entry_id": "c3073f00-dfb1-3a7b-8aeb-142116b9c31a",
                        "glosses": [
                            "Avoir une révélation, trouver soudainement la solution à un problème difficile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca2a52e3-1731-4b49-86d2-c9d4d27ee02a",
                                "sense_id": "62d356d9-32dd-3de6-98b1-67e71f82f042",
                                "text": "Boarf, y'a mon pote Archimède qui a eurékaté un truc pour que je n'ai pas à me fatiguer, alors."
                            },
                            {
                                "example_id": "a4f414a1-4fa3-4695-9bc4-04f2d02c8d59",
                                "sense_id": "62d356d9-32dd-3de6-98b1-67e71f82f042",
                                "text": "Merci pour la promptitude de la réponse que je dois relire avant d'Eurékater!"
                            },
                            {
                                "example_id": "15aa06b4-58b1-41d9-986d-10fce317a979",
                                "sense_id": "62d356d9-32dd-3de6-98b1-67e71f82f042",
                                "text": "Merci d'eurékater kèkchose et kouavouar à Luga !"
                            },
                            {
                                "example_id": "9b7f154e-f5d9-4d54-9be6-e3b251689f56",
                                "sense_id": "62d356d9-32dd-3de6-98b1-67e71f82f042",
                                "text": "Je les regarde de plus près. Eurékate : - Visez un peu moi ça…"
                            }
                        ]
                    }
                ],
