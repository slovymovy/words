                                                "sense_id": "7d0b828b-91b0-3678-b064-c37e5ca020f4",
                                                "text": "Eric played a catchy tune on his acoustic guitar and Alyssa played the drums."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e407255-65fa-3cef-8936-4f9fbe1dc4de",
                                        "entry_id": "7aac9b9d-24c8-3b0d-ba8f-d11308a7e619",
                                        "glosses": [
                                            "A song, or short musical composition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8c007fa-ed18-32bb-b139-b4a43fafb4be",
                                        "entry_id": "7aac9b9d-24c8-3b0d-ba8f-d11308a7e619",
                                        "glosses": [
                                            "The act of tuning or maintenance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8243fbe-d43c-476b-9e06-c1187d65cb42",
                                                "sense_id": "c8c007fa-ed18-32bb-b139-b4a43fafb4be",
                                                "text": "Your engine needs a good tune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86383aea-511e-3b4c-9929-bf0d9fb16064",
                                        "entry_id": "7aac9b9d-24c8-3b0d-ba8f-d11308a7e619",
                                        "glosses": [
                                            "The state or condition of being correctly tuned."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10b6cd4b-a252-4d23-9817-4b78849b631c",
                                                "sense_id": "86383aea-511e-3b4c-9929-bf0d9fb16064",
                                                "text": "Your engine is now in tune."
                                            },
                                            {
                                                "example_id": "7d9043e5-3ed1-498f-be99-d53c11f1b742",
                                                "sense_id": "86383aea-511e-3b4c-9929-bf0d9fb16064",
                                                "text": "This piano is not in tune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e38ddea-6806-3db0-9df3-d2ebe8828e9a",
                                        "entry_id": "7aac9b9d-24c8-3b0d-ba8f-d11308a7e619",
                                        "glosses": [
                                            "Temper; frame of mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da8bb08c-d6a5-3be3-8ca3-e53ab941a387",
                                        "entry_id": "7aac9b9d-24c8-3b0d-ba8f-d11308a7e619",
                                        "glosses": [
                                            "A sound; a note; a tone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eebd78d-04e5-41bf-ac21-62e347a7f4c5",
                                                "sense_id": "da8bb08c-d6a5-3be3-8ca3-e53ab941a387",
                                                "text": "Pray you now, if it may the ſtand with the tune of your voices, that I may bee Conſull, I haue heere the Cuſtomarie Gowne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2e2934d-9388-3350-abc0-a337a4303bbe",
                                        "entry_id": "7aac9b9d-24c8-3b0d-ba8f-d11308a7e619",
                                        "glosses": [
                                            "Order; harmony; concord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7b056b3-a759-4187-89d1-30156977db52",
                                                "sense_id": "a2e2934d-9388-3350-abc0-a337a4303bbe",
                                                "text": "A child will learn three times as much when he is in tune, as when he […] is dragged unwillingly to [his task]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2472a159-b87a-3cb3-a702-2e6be3659a52",
                                        "entry_id": "87be04b7-adc6-3055-8e74-1346f09d6a20",
                                        "glosses": [
                                            "Used to show appreciation or approval of a song."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcab3f8f-7d3b-4268-9ea2-967662c50bab",
                                                "sense_id": "2472a159-b87a-3cb3-a702-2e6be3659a52",
                                                "text": "You heard the new Rizzle Kicks song? — Tune!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c04aef3-5125-3cbf-955d-a226cf8ea67d",
                                        "entry_id": "609aed3e-fae3-3384-b5cc-3ca659d9c2d4",
                                        "glosses": [
                                            "To adjust (a musical instrument) so that it produces the correct pitches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d34439f-3607-48d9-93e5-14c782fb8137",
                                                "sense_id": "8c04aef3-5125-3cbf-955d-a226cf8ea67d",
                                                "text": "to tune a piano or a violin"
                                            },
                                            {
                                                "example_id": "a6c6d395-dc8a-4fd0-a9d4-268cd21f6ac3",
                                                "sense_id": "8c04aef3-5125-3cbf-955d-a226cf8ea67d",
                                                "text": "The Harpe. […] A harper with his wreſt maye tune the harpe wrong / Mys tunying of an Inſtrument ſhal hurt a true ſonge"
                                            },
                                            {
                                                "example_id": "a68a08f0-c9d0-4284-8a44-8bc9d41fcc33",
                                                "sense_id": "8c04aef3-5125-3cbf-955d-a226cf8ea67d",
                                                "text": "She bids me hope; oh Heav'ns; ſhe pities me! / And pity ſtill foreruns approching love; / As Lightning does the Thunder! Tune your Harps / Ye Angels to that ſound; and thou, my Heart, / Make room to entertain thy flowing Joy."
                                            },
                                            {
                                                "example_id": "cb8648c3-53fe-4d4a-9e5b-dda2d4085118",
                                                "sense_id": "8c04aef3-5125-3cbf-955d-a226cf8ea67d",
                                                "text": "Fortune foretun'd the Dying Notes of Rome: / Till I, thy Conſul ſole, conſol'd thy Doom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69c86b97-4ffd-3135-a3f9-4ea040ae8802",
                                        "entry_id": "609aed3e-fae3-3384-b5cc-3ca659d9c2d4",
                                        "glosses": [
                                            "To adjust or modify (especially a mechanical or electrical device) so that it functions optimally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5374f719-b78d-4d52-88d7-74ef3c6088a6",
                                                "sense_id": "69c86b97-4ffd-3135-a3f9-4ea040ae8802",
                                                "text": "Tuning the engine gave me an extra twenty horsepower."
                                            },
                                            {
                                                "example_id": "a7baae68-c01c-4e28-b75f-794a0642d21a",
                                                "sense_id": "69c86b97-4ffd-3135-a3f9-4ea040ae8802",
                                                "text": "Tune your mind, and anything becomes possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67e971dc-a696-3041-a3ea-0ec6f1241022",
                                        "entry_id": "609aed3e-fae3-3384-b5cc-3ca659d9c2d4",
                                        "glosses": [
                                            "To adjust the frequency on a radio or TV set, so as to receive the desired channel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a16b366-3781-47d7-9567-6668bb28f59d",
                                                "sense_id": "67e971dc-a696-3041-a3ea-0ec6f1241022",
                                                "text": "Tune to Channel 6 for all your favourite daytime shows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fcb35d8-77c5-3eab-ad3b-a19061222601",
                                        "entry_id": "609aed3e-fae3-3384-b5cc-3ca659d9c2d4",
                                        "glosses": [
                                            "Of faculties, senses, etc.: to adapt to or direct towards a particular target."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "771994c8-eeed-458a-94d8-3f0f166afefe",
                                                "sense_id": "9fcb35d8-77c5-3eab-ad3b-a19061222601",
                                                "text": "My ears were tuned to the sounds of the forest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1c213c8-234c-38b1-aed9-8ffc53d3053b",
                                        "entry_id": "609aed3e-fae3-3384-b5cc-3ca659d9c2d4",
                                        "glosses": [
                                            "To make more precise, intense, or effective; to put into a proper state or disposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc8744a-fa2d-490d-902b-00ea3c5ac97a",
                                                "sense_id": "d1c213c8-234c-38b1-aed9-8ffc53d3053b",
                                                "text": "[H]ee hath incurred the euerlaſting diſpleaſure of the King, who had euen tun'd his bounty to ſing happineſſe to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7d49514-cbfb-361f-b221-4c60c1687c2f",
                                        "entry_id": "609aed3e-fae3-3384-b5cc-3ca659d9c2d4",
                                        "glosses": [
                                            "To attune; to adapt in style of music; to make harmonious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608ee9e3-7d36-4341-b120-954209088618",
                                                "sense_id": "d7d49514-cbfb-361f-b221-4c60c1687c2f",
                                                "text": "For now to ſorrow must I tune my ſong, / And ſet my Harpe to notes of ſaddeſt wo, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e62f7d2b-9b8b-3346-bbf8-0d9cf06a6544",
                                        "entry_id": "609aed3e-fae3-3384-b5cc-3ca659d9c2d4",
                                        "glosses": [
                                            "To give a certain tone or character to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3550e370-37b9-3ee6-9537-ffeb24e7e88e",
                                        "entry_id": "609aed3e-fae3-3384-b5cc-3ca659d9c2d4",
                                        "glosses": [
                                            "To set (lyrics) to music."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "894d3ce9-3629-40d3-a033-dc4b63700c21",
                                                "sense_id": "3550e370-37b9-3ee6-9537-ffeb24e7e88e",
                                                "text": "Ginsberg sang some poems from William Blake which he had \"tuned\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dbd8519-a2cf-34f9-8444-af1983a7889c",
                                        "entry_id": "609aed3e-fae3-3384-b5cc-3ca659d9c2d4",
                                        "glosses": [
                                            "To sing with melody or harmony."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d5f9d9-e346-4df7-832c-0029a62e4f5f",
                                                "sense_id": "6dbd8519-a2cf-34f9-8444-af1983a7889c",
                                                "text": "To ſee great Hercules whipping a Gigge, / And profound Sallomon to tune a Iigge."
                                            },
                                            {
                                                "example_id": "4decbfa5-a5c8-4d58-8426-c4002b04f2ab",
                                                "sense_id": "6dbd8519-a2cf-34f9-8444-af1983a7889c",
                                                "text": "Fountains and yee, that warble, as ye flow, / Melodious murmurs, warbling tune his praiſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bcf8aa2-a449-35ff-97b3-e1cf87a07f87",
                                        "entry_id": "609aed3e-fae3-3384-b5cc-3ca659d9c2d4",
                                        "glosses": [
                                            "To be impudent towards; to cheek."
                                        ],
                                        "tags": [
                                            "South-Africa",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4144f73f-6c81-495d-b7ad-caed897a1be4",
                                                "sense_id": "5bcf8aa2-a449-35ff-97b3-e1cf87a07f87",
                                                "text": "Are you tuning me?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7628d60b-a0ab-38e6-a1f1-6173216be17d",
                                        "entry_id": "609aed3e-fae3-3384-b5cc-3ca659d9c2d4",
                                        "glosses": [
                                            "to adjust the parameters of singing voice synthesis software such as VOCALOID (in order to achieve certain singing techniques, increase the human quality of the voice, etc.)"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1715487c-6858-4dc7-9669-3661e93df8d4",
                                                "sense_id": "7628d60b-a0ab-38e6-a1f1-6173216be17d",
                                                "text": "[…] Those who are highly skilled in manipulating the Vocaloid technology—e.g., tuning Miku's singing voices—arrange existing[…]"
                                            },
                                            {
                                                "example_id": "32bef1ed-9672-46cb-a0ba-3501c57e508d",
                                                "sense_id": "7628d60b-a0ab-38e6-a1f1-6173216be17d",
                                                "text": "LOLA's voice is used simply to render basic notes and words with no pitch or expression tuning applied."
                                            },
                                            {
                                                "example_id": "7dac336d-29fa-450e-a271-4490d25cb27a",
                                                "sense_id": "7628d60b-a0ab-38e6-a1f1-6173216be17d",
                                                "text": "This compiling of a track holds many parallels with “tuning” a Miku track, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
