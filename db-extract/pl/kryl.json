                "translations": [
                    {
                        "translation_id": "b7c9c2ba-faf0-495c-8a64-80d092279d92",
                        "source_entry_id": "950269b4-4b2c-3bc7-ba4e-f38c86a1e881",
                        "source_sense_id": "c399f1c4-16bd-3125-a781-8fc9242cd5e3",
                        "target_lang_word": "krill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab4ab82f-2444-39e3-85f9-60d1df644e3c",
                                        "entry_id": "58ac9bdc-85f2-39c4-9bd5-a3c7fa3b97ec",
                                        "glosses": [
                                            "Any of several small marine crustacean species of plankton in the order Euphausiacea in the class Malacostraca."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c097d094-dc41-37ae-b199-e602ceb46f51",
                                        "entry_id": "58ac9bdc-85f2-39c4-9bd5-a3c7fa3b97ec",
                                        "glosses": [
                                            "Crack cocaine."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60551053-891f-473c-9e99-2e2b265de516",
                                                "sense_id": "c097d094-dc41-37ae-b199-e602ceb46f51",
                                                "text": "Instead she wanna hear the beatbox / Take pills and make fake krills as sheetrock"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a5eb94e-bf2a-4084-b9e5-9abafe238f12",
                        "source_entry_id": "950269b4-4b2c-3bc7-ba4e-f38c86a1e881",
                        "source_sense_id": "c399f1c4-16bd-3125-a781-8fc9242cd5e3",
                        "target_lang_word": "krill",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krill",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6373dc70-0d37-3644-a4f6-b01382ad67fc",
                                        "entry_id": "a296bc0f-6f23-3228-a3e9-c3fb9b4e6fa7",
                                        "glosses": [
                                            "Nom générique de petites crevettes des eaux froides, de la famille des euphausiacés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d8df10-efd9-4fbe-b931-c8cfdfdb76de",
                                                "sense_id": "6373dc70-0d37-3644-a4f6-b01382ad67fc",
                                                "text": "Le mot krill est utilisé par les baleiniers pour désigner les milliards d'animaux planctoniques qui constituent la nourriture des baleines."
                                            },
                                            {
                                                "example_id": "12fb6c00-d1c8-4a35-8f37-9eaaa4105ba2",
                                                "sense_id": "6373dc70-0d37-3644-a4f6-b01382ad67fc",
                                                "text": "Les eaux australes nourrissent en étoiles de mers, oursins, algues, invertébrés microscopiques, planctons et krills (près de 500 millions de tonnes), deux cents espèces de poissons, baleines, phoques, manchots et autres oiseaux migrateurs."
                                            },
                                            {
                                                "example_id": "ea438d85-be97-4b49-a069-cbc1ea522669",
                                                "sense_id": "6373dc70-0d37-3644-a4f6-b01382ad67fc",
                                                "text": "Le krill, ces sont des milliards de petits crustacés qui se multiplient avec une rapidité étonnante pendant l’été et donnent à la mer une couleur rouge-brun."
                                            },
                                            {
                                                "example_id": "f91fb71a-80ae-47a0-8d2c-270ec170ab52",
                                                "sense_id": "6373dc70-0d37-3644-a4f6-b01382ad67fc",
                                                "text": "«  L’industrie de la pêche au krill en Antarctique se rend dans l’un des derniers espaces quasi vierges de notre planète et y livre une compétition féroce aux manchots et aux baleines dans le but de capturer une espèce absolument clé pour tout l’écosystème de l’Antarctique  », déclare Hélène Bourges, responsable de la campagne Océans à Greenpeace France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afafd077-43d4-4bdb-868f-d0fdbdfeaefd",
                        "source_entry_id": "950269b4-4b2c-3bc7-ba4e-f38c86a1e881",
                        "source_sense_id": "c399f1c4-16bd-3125-a781-8fc9242cd5e3",
                        "target_lang_word": "криль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "криль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dce46bc1-7872-3ebf-a5c0-ae0ad045c79f",
                                        "entry_id": "d831b05d-62c2-31d4-9002-7f597efa2eab",
                                        "glosses": [
                                            "зоол. промысловое название планктонных морских рачков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131b2a23-2e71-4cd5-a0c5-84ce5c6a8d2f",
                                                "sense_id": "dce46bc1-7872-3ebf-a5c0-ae0ad045c79f",
                                                "text": ".. крупная рыба вылавливается очень интенсивно. Чтобы сохранить равновесие, надо в соответствующей пропорции выбирать из моря его мелких обитателей. Сейчас уже взялись за криль. Этот маленький рачок даёт нам почти чистый животный белок. Считается, что по массе его можно добыть много больше, чем рыбы во всём мире."
                                            },
                                            {
                                                "example_id": "625ec5f5-eab9-429d-8bec-d28ae25bb982",
                                                "sense_id": "dce46bc1-7872-3ebf-a5c0-ae0ad045c79f",
                                                "text": "До начала XX в. главным и, по существу, единственным районом китобойного промысла оставалась Северная Атлантика. Затем этот промысел стал постепенно перемещаться в воды Антарктики — в так называемый Южный океан, особенно богатый крилем — главной пищей усатых китов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
