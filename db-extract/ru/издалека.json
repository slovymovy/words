                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee4c9cf-e794-4fd3-8843-239384c25888",
                                "sense_id": "7b82fac8-b4be-3ad2-afff-ac689ce95c00",
                                "text": "Но мудреца от дурака / Не различить издалека, / А ближе подходить не стоит."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1f3300c-fee9-3341-b433-f79c37dd2af9",
