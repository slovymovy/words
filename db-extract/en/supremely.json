                    {
                        "sense_id": "cd7a81ef-1813-36ba-9781-6ffaa3b303ae",
                        "entry_id": "343a39f8-e4a2-3e00-a8c8-0c316f4400bb",
                        "glosses": [
                            "To the greatest, highest, or utmost degree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a4c5ee3-5a2d-42cf-bb9f-ec2a78950217",
                                "sense_id": "cd7a81ef-1813-36ba-9781-6ffaa3b303ae",
                                "text": "They were supremely confident at the beginning of the season."
                            },
                            {
                                "example_id": "7438fcd7-7364-4cae-b096-486d8db30d07",
                                "sense_id": "cd7a81ef-1813-36ba-9781-6ffaa3b303ae",
                                "text": "The second half was a test United passed supremely. They began with an equaliser that again illustrated how ruthless their attacking play can be."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad46272b-471e-49ae-a937-77cc3d5bb7f4",
