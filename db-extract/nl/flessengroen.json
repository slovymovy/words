                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9d70e0f-0bca-46a0-b1b2-6befaec0a7e8",
                                                "sense_id": "3049cf02-9580-366e-9f8c-c531ad73c77d",
                                                "text": "He stopped to look at a shop selling ladies' wear, and stared for a long time at a bottle-green suit of corduroy slacks."
                                            },
                                            {
                                                "example_id": "416e9bdc-7eba-4830-9ae8-5f591d615de4",
                                                "sense_id": "3049cf02-9580-366e-9f8c-c531ad73c77d",
                                                "text": "Anne Talbot looked demurely ravishing, as was her intention, in a very low-cut evening frock of bottle-green, choker of Kelantan silver, earrings in the shape of krises."
                                            }
                                        ]
                                    }
                                ]
