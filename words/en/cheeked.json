            "senses": [
                {
                    "sense_id": "d6c07482-afca-3615-acc3-b42af3fea7d0",
                    "sense_definition": "Having cheeks of a specified appearance or shape.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rosy-cheeked</w> child played happily in the cold winter snow.",
                            "target_lang_translations": {
                                "ru": "<w>Розовощекий</w> ребенок счастливо играл в холодном зимнем снегу."
                            }
                        },
                        {
                            "text": "He looked tired and <w>hollow-cheeked</w> after working long hours for many weeks.",
                            "target_lang_translations": {
                                "ru": "Он выглядел уставшим и <w>впалощеким</w> после многонедельной изнурительной работы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rosy-cheeked",
                        "hollow-cheeked"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий щеки определенного вида или формы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "-щекий",
                                "target_lang_sense_clarification": "суффикс, используемый в сложных прилагательных для описания формы или цвета щек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
