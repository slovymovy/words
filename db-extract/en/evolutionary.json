        "zh-extract.jsonl": [
            {
                "entry_id": "b5a66833-8c89-3185-92bb-9df037aabf7e",
                "word": "evolutionary",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "68f9e8e7-247e-3690-9cbc-3888b05a8c54",
                        "entry_id": "b5a66833-8c89-3185-92bb-9df037aabf7e",
                        "glosses": [
                            "進化論的，演化論的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df82f37a-8b1c-4818-934f-ba977747a60b",
                                "sense_id": "68f9e8e7-247e-3690-9cbc-3888b05a8c54",
                                "text": "The evolutionary history of marine mammals includes land-dwelling ancestors.",
                                "translation": "海洋哺乳动物的进化史包括其在陆地的祖先。"
                            },
                            {
                                "example_id": "7718c194-17b5-44f5-9720-69144c574568",
                                "sense_id": "68f9e8e7-247e-3690-9cbc-3888b05a8c54",
                                "text": "It is likely that the long evolutionary trajectory of Mycoplasma went from a reductive autotroph to oxidative heterotroph to a cell-wall–defective degenerate parasite. This evolutionary trajectory assumes the simplicity to complexity route of biogenesis, a point of view that is not universally accepted.",
                                "translation": "支原体的漫长进化轨迹很可能是从还原性自养生物进化为氧化异养生物，再进化为细胞壁缺陷的退化寄生虫。这一进化轨迹假设了从简单到复杂的生物发生路径，但这一观点并未得到普遍接受。"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d180a86-b8e4-3dee-809e-67deb24abe75",
                        "entry_id": "b5a66833-8c89-3185-92bb-9df037aabf7e",
                        "glosses": [
                            "類似進化論的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dad2dded-38fa-4530-985c-975b0cd47dbf",
                                "sense_id": "7d180a86-b8e4-3dee-809e-67deb24abe75",
                                "text": "The basic elements of an evolutionary growth theory are discussed in Section II.",
                                "translation": "第二部分讨论了演化增长理论的基本要素。"
                            }
                        ]
                    }
                ],
