                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb3c724f-972c-3f52-9e51-1fb99765195d",
                        "entry_id": "c267858e-5ee6-350e-adf4-9b3a7f3c360d",
                        "glosses": [
                            "Disque numérique lu par un faisceau laser."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "9846ad69-efdd-4c86-b5ec-945f8e8b2908",
                                "sense_id": "fb3c724f-972c-3f52-9e51-1fb99765195d",
                                "text": "Jay, 36 ans, reconnaît, lui, ne plus acheter de CD et écouter « principalement des MP3 »."
                            },
                            {
                                "example_id": "007462a5-e7da-4fb7-80e4-aa8cce3c03de",
                                "sense_id": "fb3c724f-972c-3f52-9e51-1fb99765195d",
                                "text": "Jadis sur disque vinyle, puis sur K7 et CD, le bouquin lu à voix haute se diffuse, aujourd’hui, sur les smartphones et les tablettes, où il s’écoute, le plus souvent, avec un casque ou des écouteurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c533e5a-7cf7-4e16-87af-8035fcd0b58c",
                        "source_entry_id": "c267858e-5ee6-350e-adf4-9b3a7f3c360d",
                        "source_sense_id": "fb3c724f-972c-3f52-9e51-1fb99765195d",
                        "target_lang_word": "CD",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "CD",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                        "entry_id": "a3f49540-6315-324d-a92b-104dddb35cf4",
                                        "glosses": [
                                            "Compact Disc"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf4c8048-9b9d-4139-9e30-52a76d373e3f",
                                                "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                                "text": "Ich habe ein paar gute CDs bei mir zuhause."
                                            },
                                            {
                                                "example_id": "8b26bcf0-84ec-40b1-b92e-24aca61dbc59",
                                                "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                                "text": "„Mama Eko stand auf und legte die CD ein.“"
                                            },
                                            {
                                                "example_id": "df8d764f-a52b-43c5-a42c-941440fe0df7",
                                                "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                                "text": "„Dann lege ich die CD auf, die Valmont – dramaturgisch geschickt – im Schlafwagen liegen ließ.“"
                                            },
                                            {
                                                "example_id": "2adbac6e-fe62-43c8-9b53-24e66f7926b6",
                                                "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                                "text": "„Aus den Lautsprechern erklang plötzlich sehr laut ein Stück klassischer Musik, das Ben hektisch leiser drehte, bevor er schnell mehrfach auf den Radioknopf drückte, sodass statt der CD nun Popgedudel zu hören war.“"
                                            },
                                            {
                                                "example_id": "b77c2957-b47b-460f-acb6-1ed04b8b3cfc",
                                                "sense_id": "78f0e20a-f79c-3c55-873e-5eb31c3f8493",
                                                "text": "„Er brachte mir eine CD dieser Band mit, ich wusste, dass ich die nicht hören würde, trotzdem legte ich sie gut sichtbar auf meinen Schreibtisch, wie einen weiteren Beweis dafür, dass Ola mir gehörte und keiner anderen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d9cb635-a70f-4ba1-9dd8-87a9604437bc",
                        "source_entry_id": "c267858e-5ee6-350e-adf4-9b3a7f3c360d",
