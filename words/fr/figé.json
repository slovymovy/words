                },
                {
                    "sense_id": "2cd83038-70ee-3d28-9cda-d5ac9c91344b",
                    "sense_definition": "Qui n'évolue plus, qui refuse ou interdit tout changement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stabilité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette langue n'est pas un système <w>figé</w>, elle évolue constamment.",
                            "target_lang_translations": {
                                "en": "This language is not a <w>fixed</w> system; it is constantly evolving.",
                                "ru": "Этот язык — не <w>статичная</w> система: он постоянно развивается.",
                                "de": "Diese Sprache ist kein <w>starres</w> System, sie entwickelt sich ständig.",
                                "es": "Esta lengua no es un sistema <w>estático</w>: evoluciona constantemente.",
                                "zh": "这种语言不是一个<w>僵化</w>的系统，它在不断发展。"
                            }
                        },
                        {
                            "text": "La négociation est bloquée dans une situation devenue totalement <w>figée</w>.",
                            "target_lang_translations": {
                                "en": "The negotiations are stuck in a situation that has become completely <w>frozen</w>.",
                                "ru": "Переговоры зашли в тупик: ситуация стала полностью <w>застывшей</w>.",
                                "de": "Die Verhandlung ist blockiert, die Lage ist inzwischen völlig <w>festgefahren</w>.",
                                "es": "La negociación está bloqueada en una situación que se ha vuelto totalmente <w>estática</w>.",
                                "zh": "谈判陷入了僵局，局势已经完全<w>僵化</w>。"
                            }
                        }
                    ],
