                "senses": [
                    {
                        "sense_id": "2471260b-0973-38ce-9ca9-8cd927daa104",
                        "entry_id": "35ae2127-006e-319d-b04a-06af2bd7346d",
                        "glosses": [
                            "Ader zur Rückführung des Blutes zum Herzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "829c1bf0-0684-43bc-a615-ff3265f31c8a",
                                "sense_id": "2471260b-0973-38ce-9ca9-8cd927daa104",
                                "text": "„Die Injektion kann in oder unter die Haut (intrakutan oder subkutan), in die Muskulatur (intramuskulär), in die Blutadern (intravenös) oder in Organe, z. B. Herz (intrakardial) erfolgen.“"
                            },
                            {
                                "example_id": "2825bdfc-3e0b-47c2-b8f4-07e14e116b06",
                                "sense_id": "2471260b-0973-38ce-9ca9-8cd927daa104",
                                "text": "„Das Zentralnervensystem steuert den Tonus der Blutadern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
