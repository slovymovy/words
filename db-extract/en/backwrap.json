                            {
                                "example_id": "adf5313e-c01d-43c0-81b7-2ba66e3a3a93",
                                "sense_id": "2ad54cb3-1ef2-3a64-8e09-dad981345ce6",
                                "text": "After applying insulation boards, adhere reinforcing mesh to the board surface. This mesh must wrap around any exposed edge of the insulation board. (This is called backwrapping.)"
                            },
                            {
                                "example_id": "77ead269-edfd-496e-8ed3-37cbea072744",
                                "sense_id": "2ad54cb3-1ef2-3a64-8e09-dad981345ce6",
                                "text": "The insulation boards should be backwrapped at terminations, with the mesh fully embedded in the base coat."
                            }
                        ]
                    },
