                ],
                "senses": [
                    {
                        "sense_id": "47a96597-76f9-3cab-8f5b-53ce3addf124",
                        "entry_id": "1674affb-b0f4-35b6-9a5e-9a990b6e4767",
                        "glosses": [
                            "ein Adverb, das für die Formulierung von Ergänzungsfragen und indirekte Fragen verwendet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad757c88-3e15-4709-96cb-bcf2d223c47b",
                                "sense_id": "47a96597-76f9-3cab-8f5b-53ce3addf124",
                                "text": "Interrogativadverbien sind Wörter wie „wo“, „woher“, „wozu“, „worüber“."
                            },
                            {
                                "example_id": "2aabf06b-91cf-41a8-989c-dcb3d7626cf4",
                                "sense_id": "47a96597-76f9-3cab-8f5b-53ce3addf124",
                                "text": "Mit einem Interrogativadverb kann man eine Ergänzungsfrage formulieren: „Wann kommt Peter?“"
                            },
                            {
                                "example_id": "d125f462-e6dc-4210-abff-9d231d5ef3f7",
                                "sense_id": "47a96597-76f9-3cab-8f5b-53ce3addf124",
                                "text": "Mit einem Interrogativadverb kann eine indirekte Frage formuliert werden: „Ich wüsste gern, wann Peter kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
