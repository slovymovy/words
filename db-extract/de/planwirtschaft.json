                        ]
                    },
                    {
                        "translation_id": "a4768d32-7b5c-484d-98a5-22430449aa00",
                        "source_entry_id": "a2fe1469-9ab8-312d-8d4f-23d9ec7fb6da",
                        "source_sense_id": "a65e530d-2f0a-31fb-abf6-697a50df313f",
                        "target_lang_word": "économie planifiée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "économie planifiée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0855683-4b15-3073-b5ae-524c1cd9f127",
                                        "entry_id": "f8344e82-7974-3cb4-9fc6-423185d86832",
                                        "glosses": [
                                            "Économie où l'État ou ses organismes habilités font les choix en matière d’investissement, de production, du marché du travail et de la fixation des prix."
                                        ],
                                        "tags": [
                                            "Économie",
                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5432adaf-dc18-4996-a90c-6bc2148c5cec",
                                                "sense_id": "c0855683-4b15-3073-b5ae-524c1cd9f127",
                                                "text": "Aujourd'hui, l'opposition entre les deux types d'économie n'est pas aussi tranchée. Si la plupart des économies planifiées sont disparues avec l'éclatement de l'Union soviétique (1991), la chute du mur de Berlin (1989) et le virage de l'économie chinoise au lendemain de la mort de Mao Zedong (1976), le principe de l'intervention de l'État comme agent régulateur et planificateur constitue une composante importante de la logique économique moderne. Les partis travaillistes et socialistes (centre gauche et gauche modérée), mêmes s'ils reconnaissent les vertus de l'économie de marché, cherchent à combiner celle-ci avec les avantages de mécanismes d'arbitrage ou d'intervention étatique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
