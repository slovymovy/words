                    {
                        "sense_id": "00f4c13a-f442-350b-b5b5-b03eda2bd38d",
                        "entry_id": "0c1cc23d-ed22-3b67-a442-36b73d18597b",
                        "glosses": [
                            "Très violent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d0eae4b-3151-4756-923c-3fb7c6464ad9",
                                "sense_id": "00f4c13a-f442-350b-b5b5-b03eda2bd38d",
                                "text": "Un art sadien d’aujourd’hui serait, ou plutôt est, celui qui, avec âpreté, questionne la duplicité intrinsèque de ce processus de « civilisation » consistant à dé-violentiser la société en saturant l’horizon de ses sujets d’images hyperviolentes."
                            },
                            {
                                "example_id": "9f80e901-1ba3-4674-9617-269f38d7a2fe",
                                "sense_id": "00f4c13a-f442-350b-b5b5-b03eda2bd38d",
                                "text": "On prétend qu'au moment de la reconstitution, Storme se serait présenté comme une sorte de James Bond ou de Superman et aurait tenu un récit hyperviolent, manquant d'empathie, marqué par un réalisme froid."
                            }
                        ]
                    }
