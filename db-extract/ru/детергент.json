                                "target_senses": [
                                    {
                                        "sense_id": "96b56a39-ba21-373c-8bce-9d288a957796",
                                        "entry_id": "9077bcf4-1449-362e-b95b-93b7ecc16c4b",
                                        "glosses": [
                                            "Substance détergente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2264895-4ac9-4428-b893-f4684c23387c",
                                                "sense_id": "96b56a39-ba21-373c-8bce-9d288a957796",
                                                "text": "Une bourre de soie sèche, telle qu'on l'obtient par la longue ébullition avec une grande quantité de détergent, comme à l'ordinaire, ne contient que 5% de séricine."
                                            },
                                            {
                                                "example_id": "1c7660f2-0ca8-4811-abc3-26f536b62d41",
                                                "sense_id": "96b56a39-ba21-373c-8bce-9d288a957796",
                                                "text": "Verser plus de détergent dans sa machine pour obtenir un linge plus propre… Les Américains le font, comme sans doute les Français aussi. Mais l’effet n’est pas évident, voire complètement contre-productif."
                                            },
                                            {
                                                "example_id": "e5a558a1-356f-435d-8f7f-00d9e4bfbebd",
                                                "sense_id": "96b56a39-ba21-373c-8bce-9d288a957796",
                                                "text": "La pièce a été soigneusement nettoyée à grands coups de balai, de serpillière et de détergent afin de rendre l'endroit vivable."
                                            },
                                            {
                                                "example_id": "210d4f5e-2ee5-4910-b71d-fa99821adc95",
                                                "sense_id": "96b56a39-ba21-373c-8bce-9d288a957796",
                                                "text": "Placer les pastilles de détergent dans le compartiment à lessive et non dans le panier à couverts et respecter les doses indiquées par les fabricants."
                                            }
                                        ]
                                    }
                                ]
