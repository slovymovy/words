                                        "entry_id": "171a675f-822f-30cb-82bc-0a3f2ef4727f",
                                        "glosses": [
                                            "bizyklischer aromatischer Kohlenwasserstoff, der aus Steinkohlenteer gewonnen wird und zur Herstellung von Farbstoffen, Lösungsmitteln und Insektiziden verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811fc711-84a2-4d93-b590-74d9ade47b98",
                                                "sense_id": "b9b38b34-d4d8-39b9-92ce-0f8385d2cbd5",
                                                "text": "„In diesem Zimmer, das nach Kampfer und Naphthalin roch, habe ich einige der entscheidendsten Augenblicke meines Lebens verbracht.“"
                                            },
                                            {
                                                "example_id": "798fbffc-ee70-4a9c-a86d-569dca6a787f",
                                                "sense_id": "b9b38b34-d4d8-39b9-92ce-0f8385d2cbd5",
                                                "text": "„Es roch nach Holzwolle und Naphthalin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
