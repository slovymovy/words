                "translations": [
                    {
                        "translation_id": "b12fb4d5-fdc5-47f8-bed8-690d8cf178e8",
                        "source_entry_id": "1ce8473c-7f48-3da7-94cc-5aeb7c6f2404",
                        "source_sense_id": "f9df03f4-d24a-3b3d-8969-fb3f5e0ed619",
                        "target_lang_word": "algin",
