                                "sense_id": "c5767d01-0941-3e42-af20-349b508c65a9",
                                "text": "Un pigeon aime une pigeonne."
                            },
                            {
                                "example_id": "9555eaa0-8325-463c-8d58-7c4ecd6e98b7",
                                "sense_id": "c5767d01-0941-3e42-af20-349b508c65a9",
                                "text": "La pigeonne s'est aplatie."
