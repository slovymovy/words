                    {
                        "sense_id": "a01f9f19-22c1-34f5-a92e-1a82aeb0928f",
                        "entry_id": "2eed355f-7fc0-310a-9a1b-ef8333e8c37f",
                        "glosses": [
                            "Rétrodiffusion."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "66ca6313-5fff-4802-a130-465bfa2746f8",
                                "sense_id": "a01f9f19-22c1-34f5-a92e-1a82aeb0928f",
                                "text": "In particular, X-ray backscatter is the main technology deployed and operated in the US and the UK.",
                                "translation": "Plus particulièrement, la rétrodiffusion de rayons X constitue la principale technologie mise en service et exploitée aux États-Unis ainsi qu'au Royaume-Uni."
                            }
                        ]
                    },
                    {
                        "sense_id": "667ca9d8-88c4-3913-8c9d-a8cc3ff9a615",
                        "entry_id": "2eed355f-7fc0-310a-9a1b-ef8333e8c37f",
                        "glosses": [
                            "Type de scanner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "095f326b-ffda-4f74-afd2-6cb409b738e2",
                                "sense_id": "667ca9d8-88c4-3913-8c9d-a8cc3ff9a615",
                                "text": "Backscatter X-ray.",
                                "translation": "Scanner à rayons X."
                            }
                        ]
                    },
                    {
                        "sense_id": "0106118e-4792-3fb2-86f1-e6bc87820178",
                        "entry_id": "2eed355f-7fc0-310a-9a1b-ef8333e8c37f",
                        "glosses": [
                            "Orbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a15cdfb-f649-426b-866b-8406065b1846",
                                "sense_id": "0106118e-4792-3fb2-86f1-e6bc87820178",
                                "text": "In photography, backscatter (also called near-camera reflection) is an optical phenomenon resulting in typically circular artifacts on an image, due to the camera's flash being reflected from unfocused motes of dust, water droplets, or other particles in the air or water.",
                                "translation": "En photographie, les orbes sont un phénomène optique représenté par des taches blanches ou blanchâtres, souvent transparentes, de taille variable et de forme circulaire qui apparaissent parfois sur les photos."
                            }
                        ]
                    }
                ],
