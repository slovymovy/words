{
    "word_family": [
        "resist",
        "resistance",
        "resistant",
        "resistible",
        "irresistibility",
        "irresistibly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "821eaecf-e006-3021-96f3-9b0c7c5aaaed",
                    "sense_definition": "Extremely attractive, charming, or alluring in a way that is difficult to ignore.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "attractiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bakery window was filled with <w>irresistible</w> cakes that made everyone stop and look.",
                            "target_lang_translations": {
                                "ru": "Витрина пекарни была заполнена <w>соблазнительными</w> пирожными, которые заставляли каждого остановиться и посмотреть.",
                                "tr": "Fırının vitrini, herkesi durup baktıracak kadar <w>karşı konulmaz</w> pastalarla doluydu."
                            }
                        },
                        {
                            "text": "She found his smile completely <w>irresistible</w> when they first met.",
                            "target_lang_translations": {
                                "ru": "При первой встрече его улыбка показалась ей совершенно <w>неотразимой</w>.",
                                "tr": "İlk karşılaştıklarında onun gülümsemesini tamamen <w>karşı konulmaz</w> buldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "alluring",
                        "enticing",
                        "captivating",
                        "enchanting",
                        "tempting"
                    ],
                    "antonyms": [
                        "repulsive",
                        "unattractive"
                    ],
                    "common_phrases": [
                        "irresistible charm",
                        "irresistible smile",
                        "irresistible offer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно привлекательный, обаятельный или соблазнительный, так что перед ним трудно устоять.",
                        "tr": "Karşı konulamayacak veya görmezden gelinemeyecek derecede çekici, büyüleyici ya da baştan çıkarıcı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неотразимый",
                                "target_lang_sense_clarification": "о внешности или обаянии"
                            },
                            {
                                "target_lang_word": "соблазнительный",
                                "target_lang_sense_clarification": "вызывающий сильное желание"
                            },
                            {
                                "target_lang_word": "заманчивый",
                                "target_lang_sense_clarification": "о предложении или виде"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karşı konulmaz",
                                "target_lang_sense_clarification": "çekicilik veya cazibe için"
                            },
                            {
                                "target_lang_word": "baştan çıkarıcı",
                                "target_lang_sense_clarification": "güçlü arzu uyandıran durumlar için"
                            },
                            {
                                "target_lang_word": "cazip",
                                "target_lang_sense_clarification": "teklif veya görünüş için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e5c2000-7069-3dae-8963-b67142e99ea4",
                    "sense_definition": "Impossible to stop, oppose, or prevent from happening.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "unstoppable force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army moved forward with <w>irresistible</w> force, quickly overcoming all obstacles in its path.",
                            "target_lang_translations": {
                                "ru": "Армия продвигалась вперед с <w>непреодолимой</w> силой, быстро преодолевая все препятствия на своем пути.",
                                "tr": "Ordu, yolundaki tüm engelleri hızla aşarak <w>karşı konulamaz</w> bir güçle ilerledi."
                            }
                        },
                        {
                            "text": "He felt an <w>irresistible</w> urge to tell the truth after keeping the secret for so long.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал <w>непреодолимое</w> желание сказать правду после того, как так долго хранил секрет.",
                                "tr": "Sırrı bu kadar uzun süre sakladıktan sonra gerçeği söylemek için <w>önüne geçilmez</w> bir dürtü hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "unstoppable",
                        "overwhelming",
                        "uncontrollable",
                        "inexorable"
                    ],
                    "antonyms": [
                        "resistible",
                        "avoidable",
                        "weak"
                    ],
                    "common_phrases": [
                        "irresistible force",
                        "irresistible urge",
                        "irresistible impulse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, который невозможно остановить, которому нельзя противостоять или который нельзя предотвратить.",
                        "tr": "Durdurulması, karşı durulması veya engellenmesi imkânsız olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непреодолимый",
                                "target_lang_sense_clarification": "о силе, желании или чувстве"
                            },
                            {
                                "target_lang_word": "неудержимый",
                                "target_lang_sense_clarification": "о порыве или движении"
                            },
                            {
                                "target_lang_word": "несокрушимый",
                                "target_lang_sense_clarification": "о силе или мощи"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karşı konulamaz",
                                "target_lang_sense_clarification": "güç, arzu veya hisler için"
                            },
                            {
                                "target_lang_word": "önüne geçilmez",
                                "target_lang_sense_clarification": "durdurulamayan güç veya istek için"
                            },
                            {
                                "target_lang_word": "engellenemez",
                                "target_lang_sense_clarification": "önlenemeyen durum veya ilerleme için"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}