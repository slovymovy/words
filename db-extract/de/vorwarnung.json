                    {
                        "translation_id": "5653c85b-7dab-40b2-8c68-cf8055f1208b",
                        "source_entry_id": "9ebc601c-0d59-3838-8cfe-10da084570c6",
                        "source_sense_id": "4c9ae128-6e68-35ac-abb0-a805e4b5fdda",
                        "source_sense_description": "rechtzeitige Mitteilung oder Anzeige einer drohenden Gefahr, Hinweis auf eine solche",
                        "target_lang_word": "avertissement",
