                                        "glosses": [
                                            "Langue parlée au Kenya et appartenant aux langues bantoues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32df8faa-696b-4315-89b4-aef186cdfcd2",
                                                "sense_id": "28557cf2-3050-3e70-945b-b0de8e8f0374",
                                                "text": "Le kikuyu possède trois dialectes principaux mutuellement intelligibles."
                                            },
                                            {
                                                "example_id": "2891ea38-0df9-4701-9a06-4fca9b2e28af",
                                                "sense_id": "28557cf2-3050-3e70-945b-b0de8e8f0374",
                                                "text": "La police commença dès cet instant à se faire pressante, ce qui conduit le leader kikuyu à faire le signe de la victoire en criant en anglais « Plus de partis », puis en kikuyu « On veut le multipartisme »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kikuyu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "719bb855-7cb5-3dd1-ba80-f11491e9115d",
                                        "entry_id": "0c46039c-7026-32c4-80ad-fbe4f98671d5",
                                        "glosses": [
                                            "Herbe de pâturage des régions chaudes ^([1]). → voir kikouyou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe59f938-b838-43a1-a595-5553f4d9242e",
                                                "sense_id": "719bb855-7cb5-3dd1-ba80-f11491e9115d",
                                                "text": "Des espèces spécifiques aux régions tropicales, comme le gazon kikuyu originaire d’Afrique centrale, sont de plus en plus utilisées dans le sud de la France pour leur qualités d’adaptation à la sécheresse."
                                            }
                                        ]
                                    }
                                ]
                            },
