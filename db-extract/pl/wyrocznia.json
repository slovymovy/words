                    },
                    {
                        "sense_id": "eca23724-6c76-3eb0-9f63-0ef4dd21d060",
                        "entry_id": "794f3943-78a3-3d51-81d5-d04cddfa35af",
                        "glosses": [
                            "ten, kto jest autorytetem w pewnym środowisku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d9490b9-e349-44a4-b094-07a53b35a04e",
                                "sense_id": "eca23724-6c76-3eb0-9f63-0ef4dd21d060",
                                "text": "Według wyroczni w przyszłości będę bardzo bogaty."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
