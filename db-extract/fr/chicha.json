                "translations": [
                    {
                        "translation_id": "5d7f2daf-9e75-4073-88d1-44c9776e8b53",
                        "source_entry_id": "5e8c1b4d-bc28-3538-b147-7b4c93fd921f",
                        "source_sense_id": "6aac0ca9-a9e3-3c11-9300-5f7ab62931ae",
                        "source_sense_description": "Shisha, Schischa, Wasserpfeife",
                        "target_lang_word": "Shisha",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Shisha",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e66f875c-699b-3989-a353-8f5f31c45f63",
                                        "entry_id": "b7675984-f1a5-33be-a5b1-c34e45c4e00c",
                                        "glosses": [
                                            "Wasserpfeife arabischen Ursprungs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9430dea-0166-4372-a8a6-8706ea9a4df5",
                                                "sense_id": "e66f875c-699b-3989-a353-8f5f31c45f63",
                                                "text": "Bei seinem Urlaub in Ägypten kaufte er sich eine Shisha."
                                            },
                                            {
                                                "example_id": "a8ede92b-cbdc-4a46-92d8-69a099191280",
                                                "sense_id": "e66f875c-699b-3989-a353-8f5f31c45f63",
                                                "text": "„Ich bestelle ebenfalls eine Shisha und suche unter zehn Sorten den Klassiker, also den Apfeltabak, aus.“"
                                            },
                                            {
                                                "example_id": "5e6ef2e1-cef2-4570-b66f-bdb7d71cf0ba",
                                                "sense_id": "e66f875c-699b-3989-a353-8f5f31c45f63",
                                                "text": "„In Bayern zum Beispiel raucht man in einer Shisha-Bar selbstverständlich Shisha.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e79ba26f-470e-4c49-9b1b-9ccb6daa51f8",
                        "source_entry_id": "5e8c1b4d-bc28-3538-b147-7b4c93fd921f",
                        "source_sense_id": "6aac0ca9-a9e3-3c11-9300-5f7ab62931ae",
                        "source_sense_description": "Shisha, Schischa, Wasserpfeife",
                        "target_lang_word": "Schischa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schischa",
