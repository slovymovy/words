                ],
                "senses": [
                    {
                        "sense_id": "ce80b9ae-00a6-3d40-a8f7-c0f5a1e3206c",
                        "entry_id": "d7155e33-d0b9-3381-8992-6498f28030e1",
                        "glosses": [
                            "Eine oder mehrere Personen, die ein Unternehmen / eine Firma leiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc57afc5-3b00-41b4-97ee-c446eb4955cf",
                                "sense_id": "ce80b9ae-00a6-3d40-a8f7-c0f5a1e3206c",
                                "text": "Die Geschäftsführung der Mühlhäuser Konfitüren GmbH in Tangermünde und die Mühlhäuser Pflaumenmus GmbH haben heute ihre Zahlungsunfähigkeit angemeldet."
                            },
                            {
                                "example_id": "44f8752e-7eb9-4882-aab4-49b88916f2be",
                                "sense_id": "ce80b9ae-00a6-3d40-a8f7-c0f5a1e3206c",
                                "text": "[…] die Redaktion [der Berliner Zeitung wollte] ein Mitspracherecht bei der Ernennung des Chefredakteurs erreichen und hatte die Geschäftsführung aufgefordert, für den Zeitraum der Verhandlungen keinen neuen Chefredakteur zu benennen."
                            },
                            {
                                "example_id": "d29f081e-71e9-423c-b09c-17a5929fae6c",
                                "sense_id": "ce80b9ae-00a6-3d40-a8f7-c0f5a1e3206c",
                                "text": "Nick Reilly, neuer Vorsitzender der Geschäftsführung der Adam Opel AG, erklärte am Donnerstag in Brüssel, der Opel-Standort in Antwerpen (Belgien) solle zur Jahresmitte geschlossen werden."
                            },
                            {
                                "example_id": "5592b18f-193c-48e5-9779-4aa0d291e931",
                                "sense_id": "ce80b9ae-00a6-3d40-a8f7-c0f5a1e3206c",
                                "text": "Nach nur einer Spielzeit fordert die Geschäftsführung die Absetzung der Intendantin des berühmten Tanztheaters [Pina Bausch]."
                            },
                            {
                                "example_id": "e978ba3b-ec86-49b7-a828-b9770464429e",
                                "sense_id": "ce80b9ae-00a6-3d40-a8f7-c0f5a1e3206c",
                                "text": "Die Aufgaben von Geschäftsführung, Abteilungsleitung oder [sonstigen Verantwortlichen] sind die die konkrete Zieldefinition und die Reportingstruktur und Häufigkeit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "36f046a9-7ef9-3b95-80c4-2c48d8abbd24",
                        "entry_id": "d7155e33-d0b9-3381-8992-6498f28030e1",
                        "glosses": [
                            "Leitung eines Unternehmens / einer Firma durch [1] (Tätigkeit)"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "7b30f48f-517c-4c74-88da-93b61aab3b7e",
                                "sense_id": "36f046a9-7ef9-3b95-80c4-2c48d8abbd24",
                                "text": "25 Schokoladensorten bestimmten das berufliche Leben von Alfred Ritter als Chef von Ritter Sport. Jetzt gibt er die Geschäftsführung ab."
                            },
                            {
                                "example_id": "482aec75-4cfc-4bfe-aed8-8add4b17b40c",
                                "sense_id": "36f046a9-7ef9-3b95-80c4-2c48d8abbd24",
                                "text": "„Sie haben uns auch geschult. Wir haben alles über Hygiene und Sauberkeit gelernt, über Geschäftsführung, über das Bankwesen. Davon hatten wir vorher keine Ahnung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e50d545d-11b8-4276-875d-71e91021f3c2",
                        "source_entry_id": "d7155e33-d0b9-3381-8992-6498f28030e1",
                        "source_sense_id": "ce80b9ae-00a6-3d40-a8f7-c0f5a1e3206c",
