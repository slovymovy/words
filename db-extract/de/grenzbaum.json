                "senses": [
                    {
                        "sense_id": "9ff1bb75-651f-3339-b4c3-baaf285107e6",
                        "entry_id": "873ae15c-628c-36c7-9369-fd940f5aa6ef",
                        "glosses": [
                            "bestimmter Baum, der eine Grenze, einen Grenzverlauf kennzeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50e91d9-a4b4-4dc0-bf0c-3f4f98eeb6a9",
                                "sense_id": "9ff1bb75-651f-3339-b4c3-baaf285107e6",
                                "text": "„Längs dem rauschenden Bach gingen sie wohl eine Wegstunde, bis sie dahin kamen, wo die letzten Markzeichen in den Grenzbaum gehauen waren und die Geleise der Holzwagen aufhörten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d8b030ed-df33-3150-8435-73563fcf3e99",
                        "entry_id": "873ae15c-628c-36c7-9369-fd940f5aa6ef",
                        "glosses": [
                            "bewegbare Schranke an einem Grenzübergang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00468a2d-9b27-4674-9bdd-ca399ef25a1b",
                                "sense_id": "d8b030ed-df33-3150-8435-73563fcf3e99",
                                "text": "„Sie zogen den Grenzbaum hoch, zerbrachen die Tore und jagten die Wächter durch abgeschossene Pfeile in die Flucht. Dann zogen sie in die Stadt ein.“"
                            },
                            {
                                "example_id": "c054c012-075b-48fc-906d-24a8d1fa015a",
                                "sense_id": "d8b030ed-df33-3150-8435-73563fcf3e99",
                                "text": "„Er hatte eine solche Gruppe, die ihre Rollkoffer in Richtung Grenzbaum zog, offenbar noch nie gesehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
