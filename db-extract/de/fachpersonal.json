                "senses": [
                    {
                        "sense_id": "8a7f942b-33d8-3085-8372-793a35b4ab94",
                        "entry_id": "2a570465-3a4c-3d19-b895-e99d2bf7ec1b",
                        "glosses": [
                            "Gruppe von Mitarbeitern eines Unternehmens oder einer Einrichtung, die für ihre Tätigkeit eine Fachausbildung absolviert haben; qualifizierte Arbeitskräfte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc60e2cd-a014-4629-9878-9dd8240e0b3d",
                                "sense_id": "8a7f942b-33d8-3085-8372-793a35b4ab94",
                                "text": "Das Fachpersonal steht an vorderster Front, es hat die Möglichkeit, Patienten direkt auf die Impfung anzusprechen und über ihren Impfstatus zu befragen."
                            },
                            {
                                "example_id": "65d76c58-a4c3-4b6b-a9d7-1f5f925bf852",
                                "sense_id": "8a7f942b-33d8-3085-8372-793a35b4ab94",
                                "text": "Wer ein UV-Bestrahlungsgerät betreibt, muss sicherstellen, dass mindestens eine für den Umgang mit UV-Bestrahlungsgeräten qualifizierte Person als Fachpersonal während der Betriebszeiten anwesend ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
