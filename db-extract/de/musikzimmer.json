                ],
                "senses": [
                    {
                        "sense_id": "a7d2f225-4d89-3dd5-82d2-dd8a1fa8bbdb",
                        "entry_id": "c6432e58-2a74-37b7-b0ec-ab22fbbad341",
                        "glosses": [
                            "Raum, in dem Musik gehört und/oder gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e26424e4-bb8c-4a38-9e3c-0d3f00a3191b",
                                "sense_id": "a7d2f225-4d89-3dd5-82d2-dd8a1fa8bbdb",
                                "text": "„Ich hätte nicht versuchen dürfen, diesen Augenblick zu wiederholen: als ich von Marie nach Hause kam und Leo im Musikzimmer die Mazurka spielte.“"
                            },
                            {
                                "example_id": "ec28b76e-6ac3-42e1-9cab-213f8d692945",
                                "sense_id": "a7d2f225-4d89-3dd5-82d2-dd8a1fa8bbdb",
                                "text": "„Neben dem Musikzimmer befand sich ein kleiner entzückender Raum, das Abendboudoir der Sängerin, wie sie es nannte.“"
                            },
                            {
                                "example_id": "6c53f0f1-b003-4909-bce3-de55bcea55b0",
                                "sense_id": "a7d2f225-4d89-3dd5-82d2-dd8a1fa8bbdb",
                                "text": "„Setzte sie sich an den Flügel im Musikzimmer, um für eine Weile in eine andere Welt abzutauchen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
