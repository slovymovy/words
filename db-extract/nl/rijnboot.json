                                "example_id": "5246cba8-e12d-492d-affe-f3d11259a257",
                                "sense_id": "8a1e0fb1-39d2-3541-88de-aa0c2251cedb",
                                "text": "Britse toeristen gewond op Rijnboot - Meer dan twintig Britse toeristen zijn gewond geraakt toen hun boot op de rivier de Rijn in de Elzas (Oost-Frankrijk) op een betonnen richel botste."
                            },
                            {
                                "example_id": "368c37c3-cf1c-45c7-a74b-c53783d9d1a7",
                                "sense_id": "8a1e0fb1-39d2-3541-88de-aa0c2251cedb",
                                "text": "Tientallen passagiers van een Duitse rijnboot zijn zondag gewond geraakt toen de boot, de ms Loreley, in de Rijn op een rots voer."
                            }
                        ]
