                "senses": [
                    {
                        "sense_id": "9de3f993-5158-361c-be3a-187110c949ec",
                        "entry_id": "fb4047a1-a474-3a92-9995-ee5f49c864df",
                        "glosses": [
                            "besitzanzeigendes Eigenschaftswort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f707cd1b-3859-41c0-9eb1-a15f14d7346b",
                                "sense_id": "9de3f993-5158-361c-be3a-187110c949ec",
                                "text": "„Bei mehreren Besitzern von jeweils gleichen Kleidungsstücken stehen das Possessivadjektiv + das folgende Substantiv im Singular.“"
                            },
                            {
                                "example_id": "c319f70f-7357-451e-b3a9-8ce181fa5238",
                                "sense_id": "9de3f993-5158-361c-be3a-187110c949ec",
                                "text": "„Im obigen Beispiel dringt ein zusätzliches Berichtsmerkmal unauffällig in die erlebte Rede ein, wenn statt des Pronomen ‚jeho‘ ein Possessivadjektiv aus der Bezeichnung des Sprechenden (‚basnikovu srdci‘) verwendet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
