                ],
                "senses": [
                    {
                        "sense_id": "1b95472b-dd7b-3f66-b3b2-990870500f9d",
                        "entry_id": "9876e4e0-bb33-3ed8-95b2-ae2da2a1161c",
                        "glosses": [
                            "An instrument for measuring the air capacity of the lungs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cdfd3c7-454b-4106-939d-87ed181b9151",
                                "sense_id": "1b95472b-dd7b-3f66-b3b2-990870500f9d",
                                "text": "In humans, a spirometer can be used to record and measure lung volumes and oxygen consumption (illustration 1)."
                            },
                            {
                                "example_id": "a5965ceb-680d-4663-ab4c-2e1fb32f8f93",
                                "sense_id": "1b95472b-dd7b-3f66-b3b2-990870500f9d",
                                "text": "2002, H. Nancy Holmes (editorial director), Illustrated Manual of Nursing Practice, Wolters Kluwer Health (Lippincott Williams & Wilkins), 3rd Edition, page 154,\nWhile all spirometers encourage slow, sustained maximal inspiration, they can be divided into two types: flow incentive and volume incentive."
                            },
                            {
                                "example_id": "18992f44-7f43-48cb-ab35-349d3d834422",
                                "sense_id": "1b95472b-dd7b-3f66-b3b2-990870500f9d",
                                "text": "Wet-type spirometers (such as the classical bell spirometer with a water seal) are simple and accurate but are no longer in use as they have a hygiene problem; they are distinguished from dry-type spirometers (e.g., bellows or piston spirometer)."
                            }
                        ]
                    }
                ],
