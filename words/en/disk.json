{
    "word_family": [
        "diskette",
        "diskless",
        "subdisk",
        "multidisk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4c0bcdb-95c6-3151-9c19-962eb9ef3195",
                    "sense_definition": "A flat, circular magnetic or optical device used for storing computer data.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computing_storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should save your work to the <w>disk</w> frequently.",
                            "target_lang_translations": {
                                "ru": "Тебе следует часто сохранять свою работу на <w>диск</w>.",
                                "zh": "你应该经常把工作保存到<w>磁盘</w>里。"
                            }
                        },
                        {
                            "text": "My computer needs a new hard <w>disk</w> because the old one is full.",
                            "target_lang_translations": {
                                "ru": "Моему компьютеру нужен новый жесткий <w>диск</w>, так как старый переполнен.",
                                "zh": "我的电脑需要一个新的硬盘，因为旧的已经满了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drive"
                    ],
                    "common_phrases": [
                        "hard disk",
                        "floppy disk",
                        "disk drive",
                        "disk space",
                        "save to disk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоское круглое магнитное или оптическое устройство, используемое для хранения компьютерных данных.",
                        "zh": "一种用于存储计算机数据的扁平圆形磁性或光学设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диск",
                                "target_lang_sense_clarification": "компьютерный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磁盘",
                                "target_lang_sense_clarification": "计算机存储介质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "767b15b5-6121-3e4b-86cc-9e4722c0557a",
                    "sense_definition": "A thin, flat, circular plate or object.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "shape_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun appeared as a bright red <w>disk</w> in the evening sky.",
                            "target_lang_translations": {
                                "ru": "Солнце появилось в вечернем небе как ярко-красный <w>диск</w>.",
                                "zh": "傍晚的天空中，太阳看起来像一个亮红色的<w>圆盘</w>。"
                            }
                        },
                        {
                            "text": "He threw the plastic <w>disk</w> across the park for his dog to catch.",
                            "target_lang_translations": {
                                "ru": "Он бросил пластиковый <w>диск</w> через парк, чтобы его поймала собака.",
                                "zh": "他把塑料<w>飞盘</w>扔过公园，让他的狗去接。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plate",
                        "disc"
                    ],
                    "common_phrases": [
                        "metal disk",
                        "spinning disk",
                        "flat disk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий плоский круглый предмет или пластина.",
                        "zh": "一种薄而扁平的圆形物体或板。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диск",
                                "target_lang_sense_clarification": "предмет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆盘",
                                "target_lang_sense_clarification": "形状"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "045119a5-97b9-3696-85f0-e80bb701b2ca",
                    "sense_definition": "A flat, circular structure of cartilage located between the vertebrae of the spine.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lifting heavy objects incorrectly can cause a slipped <w>disk</w>.",
                            "target_lang_translations": {
                                "ru": "Неправильный подъем тяжестей может привести к смещению <w>диска</w>.",
                                "zh": "搬运重物姿势不当会导致<w>椎间盘</w>突出。"
                            }
                        },
                        {
                            "text": "The doctor said the pain in his back was due to a damaged <w>disk</w>.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что боль в спине вызвана поврежденным <w>диском</w>.",
                                "zh": "医生说他背部的疼痛是由于<w>椎间盘</w>受损引起的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disc"
                    ],
                    "common_phrases": [
                        "slipped disk",
                        "herniated disk"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often spelled 'disc' in medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская круглая хрящевая структура, расположенная между позвонками позвоночника.",
                        "zh": "位于脊椎骨之间的扁平圆形软骨结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диск",
                                "target_lang_sense_clarification": "анатомия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "椎间盘",
                                "target_lang_sense_clarification": "解剖学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52ae0c8c-fdca-31cb-9142-ded9f6769b8a",
                    "sense_definition": "A vinyl phonograph record used to play music.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully placed the needle on the spinning <w>disk</w>.",
                            "target_lang_translations": {
                                "ru": "Он осторожно опустил иглу на вращающуюся <w>пластинку</w>.",
                                "zh": "他小心翼翼地把唱针放在旋转的<w>唱片</w>上。"
                            }
                        },
                        {
                            "text": "Collectors still pay high prices for a rare <w>disk</w> from that era.",
                            "target_lang_translations": {
                                "ru": "Коллекционеры до сих пор платят высокие цены за редкую <w>пластинку</w> той эпохи.",
                                "zh": "收藏家们至今仍愿意花高价购买那个时代的稀有<w>唱片</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "record",
                        "LP"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "referring to vinyl records"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Виниловая грампластинка, используемая для воспроизведения музыки.",
                        "zh": "用于播放音乐的黑胶唱片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пластинка",
                                "target_lang_sense_clarification": "виниловая"
                            },
                            {
                                "target_lang_word": "диск",
                                "target_lang_sense_clarification": "музыкальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唱片",
                                "target_lang_sense_clarification": "音乐媒体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "040b4421-842f-333e-90c2-93789a9d2eba",
                    "sense_definition": "A two-dimensional region on a plane bounded by a circle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the math problem, we had to calculate the area of the <w>disk</w>.",
                            "target_lang_translations": {
                                "ru": "В математической задаче нам нужно было вычислить площадь <w>круга</w>.",
                                "zh": "在这道数学题中，我们需要计算这个<w>圆</w>的面积。"
                            }
                        },
                        {
                            "text": "The geometric shape is defined as a closed <w>disk</w> of radius five.",
                            "target_lang_translations": {
                                "ru": "Геометрическая фигура определяется как замкнутый <w>круг</w> радиусом пять.",
                                "zh": "这个几何图形被定义为一个半径为五的闭合<w>圆</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двумерная область на плоскости, ограниченная окружностью.",
                        "zh": "平面上由圆周界定的二维区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "круг",
                                "target_lang_sense_clarification": "геометрия"
                            },
                            {
                                "target_lang_word": "диск",
                                "target_lang_sense_clarification": "математика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆",
                                "target_lang_sense_clarification": "几何学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9f21fbe-7968-387e-82a1-14c1ddef1ef0",
                    "sense_definition": "A piece of agricultural equipment with sharp circular blades used to break up soil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer attached the <w>disk</w> to the tractor to prepare the field.",
                            "target_lang_translations": {
                                "ru": "Фермер прицепил <w>дисковую борону</w> к трактору, чтобы подготовить поле.",
                                "zh": "农民把<w>圆盘耙</w>挂在拖拉机上以准备耕地。"
                            }
                        },
                        {
                            "text": "Using a <w>disk</w> helps to cut through weeds and smooth the ground.",
                            "target_lang_translations": {
                                "ru": "Использование <w>дисковой бороны</w> помогает срезать сорняки и выравнивать землю.",
                                "zh": "使用<w>圆盘耙</w>有助于切断杂草并平整土地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "harrow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сельскохозяйственное оборудование с острыми круглыми лезвиями для рыхления почвы.",
                        "zh": "一种带有锋利圆形刀片的农业设备，用于破碎土壤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисковая борона",
                                "target_lang_sense_clarification": "оборудование"
                            },
                            {
                                "target_lang_word": "диск",
                                "target_lang_sense_clarification": "деталь плуга"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆盘耙",
                                "target_lang_sense_clarification": "农业工具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "395fc4b5-5deb-3d24-b00c-ec47d2c462c6",
                    "sense_definition": "To cultivate or prepare land using a harrow with circular cutting blades.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer <w>disked</w> the field early in the spring to get it ready for planting.",
                            "target_lang_translations": {
                                "ru": "Фермер <w>дисковал</w> поле ранней весной, чтобы подготовить его к посадке.",
                                "zh": "农民在早春时节<w>耙</w>了地，为播种做准备。"
                            }
                        },
                        {
                            "text": "After plowing, the soil must be <w>disked</w> to break up the large clumps of earth.",
                            "target_lang_translations": {
                                "ru": "После вспашки почву необходимо <w>продисковать</w>, чтобы разбить крупные комья земли.",
                                "zh": "犁地后，必须对土壤进行<w>耙</w>地处理，以打碎大块的土团。"
                            }
                        }
                    ],
                    "synonyms": [
                        "harrow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать или подготавливать землю с помощью бороны с круглыми режущими лезвиями.",
                        "zh": "使用带有圆形切割刀片的耙子来耕作或准备土地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисковать",
                                "target_lang_sense_clarification": "обрабатывать землю"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耙地",
                                "target_lang_sense_clarification": "农业动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}