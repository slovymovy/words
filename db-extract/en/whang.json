                "senses": [
                    {
                        "sense_id": "58d88da5-859c-3db5-8513-ab39677e3090",
                        "entry_id": "19b0334b-e856-3ad5-a78b-37b91783a87e",
                        "glosses": [
                            "To make a noise like something moving quickly through the air."
                        ],
                        "tags": [
                            "of an object"
                        ],
                        "examples": [
                            {
                                "example_id": "a2b38012-e4eb-4fa4-8962-d4ba3acb5468",
                                "sense_id": "58d88da5-859c-3db5-8513-ab39677e3090",
                                "text": "The holder of the torch grunted, and (after pausing a second at B.'s bed to inspect a picture of perfect innocence) banged out through the door which whanged to behind him..."
                            }
                        ]
                    },
                    {
                        "sense_id": "6174bb26-2097-3127-9673-467fedc209c4",
                        "entry_id": "19b0334b-e856-3ad5-a78b-37b91783a87e",
                        "glosses": [
                            "To throw with a rapid slamming motion."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "30a3b804-7c7c-49ca-95c4-35d9972e6615",
                                "sense_id": "6174bb26-2097-3127-9673-467fedc209c4",
                                "text": "I don't know how long it might have gone on if Grandfather hadn't lost his temper. He swung the bridle up over his head and whanged it down across the buckskin's rump."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff39802e-cf80-3eac-918e-4dfaae9563e2",
                        "entry_id": "19b0334b-e856-3ad5-a78b-37b91783a87e",
                        "glosses": [
                            "To whack or beat."
                        ],
                        "tags": [
                            "British",
                            "Scotland",
                            "US",
                            "dialectal",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2442c778-e289-4f50-8917-4f5980b3c259",
                                "sense_id": "ff39802e-cf80-3eac-918e-4dfaae9563e2",
                                "text": "I ought to have whanged him one in the eye."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a7fc749-d219-368e-b954-a0f02df9cbcc",
                        "entry_id": "19b0334b-e856-3ad5-a78b-37b91783a87e",
                        "glosses": [
                            "To slice, especially into large pieces; to chop."
