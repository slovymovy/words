                            {
                                "target_word": "Aubusson",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7577982-98e3-3b6a-9011-319e3de646fa",
                                        "entry_id": "0e3348ab-9be2-35e4-b172-15da91197e39",
                                        "glosses": [
                                            "Tapisserie fabriquée à Aubusson."
                                        ],
                                        "tags": [
                                            "Tapisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62cf7bcc-eb07-422c-9517-de45d9aecfb1",
                                                "sense_id": "d7577982-98e3-3b6a-9011-319e3de646fa",
                                                "text": "Faux Aubusson, fausses armures,\nFaux tableaux de maîtres aux murs,\nFausses perles et faux bijoux,\nFaux grains de beauté sur les joues"
                                            },
                                            {
                                                "example_id": "247aa7f6-5367-4fc0-86d2-3c122bf784c9",
                                                "sense_id": "d7577982-98e3-3b6a-9011-319e3de646fa",
                                                "text": "A dormir peu notre homme accoutumé,\nSe réveille à toute aventure;\nPuis sur les pans d'un Aubusson fumé,\nDécouvre une chasse en peinture."
                                            },
                                            {
                                                "example_id": "2fea1afe-4f96-4601-a0c6-55507bc2f033",
                                                "sense_id": "d7577982-98e3-3b6a-9011-319e3de646fa",
                                                "text": "Les affaires reprirent au cours de la dernière guerre, le public s’étant avisé que des Aubusson pouvaient constituer des placements sûrs au milieu de l’insécurité générale."
                                            },
                                            {
                                                "example_id": "be77943c-2a21-4ad9-b17d-6622472b4884",
                                                "sense_id": "d7577982-98e3-3b6a-9011-319e3de646fa",
                                                "text": "Oh, oh ! ça, les amis, ça m’a tout l’air d'un Aubusson. Un Aubusson, putain de sort !\nMarie pouffe derrière sa main.\n— Aubusson ? Je croyais que c’était une espèce de gruyère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
