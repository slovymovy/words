                "word": "crânement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5eb95573-32e8-327c-975c-e97416293d95",
                        "entry_id": "29879dd9-e823-354c-b17c-9aaecc1e1cc2",
                        "glosses": [
                            "En crânant, en voulant en remontrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dc53503-2fdc-4b54-b9e8-ba1d5b3b7469",
                                "sense_id": "5eb95573-32e8-327c-975c-e97416293d95",
                                "text": "Ensuite il y eut un grand moment participatif de débat citoyen, que Mlle. Muchielli qualifia crânement d’Agora."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0007aa7-b87a-394a-b8b5-8132f6b618a3",
                        "entry_id": "29879dd9-e823-354c-b17c-9aaecc1e1cc2",
                        "glosses": [
                            "D’une manière crâne, intrépide ou hardie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6019242-6751-42d3-b737-6924ac5aa158",
                                "sense_id": "d0007aa7-b87a-394a-b8b5-8132f6b618a3",
                                "text": "Aujourd’hui la muse, gaillarde\nAu corset crânement ouvert,\nArbore comme une cocarde\nL’affreux bonnet, le bonnet vert; …"
                            },
                            {
                                "example_id": "a2796c9e-41e8-401f-8c98-5f3b7e034038",
                                "sense_id": "d0007aa7-b87a-394a-b8b5-8132f6b618a3",
                                "text": "Bientôt une lame énorme le renfloue, mais la machine s'arrête, arrêtant les pompes, et la proue enfonce. Alors le commandant Le Conniat joue crânement sa dernière carte : il se met à la cape."
                            },
                            {
                                "example_id": "8f1fd655-45f1-4cc2-9b81-63e97e839ff8",
                                "sense_id": "d0007aa7-b87a-394a-b8b5-8132f6b618a3",
                                "text": "Les Brestois veulent défendre crânement leur chance en Ligue des champions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbb2e1c3-e6d8-410d-bd2c-7f341c905ee8",
                        "source_entry_id": "29879dd9-e823-354c-b17c-9aaecc1e1cc2",
                        "target_lang_word": "kranig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kranig",
