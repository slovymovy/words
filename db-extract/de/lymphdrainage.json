                "senses": [
                    {
                        "sense_id": "f1260c05-13c1-3b0a-8644-431c53f0f46e",
                        "entry_id": "257a1b6c-2a7b-3faa-aaa7-3e2a8168fb0e",
                        "glosses": [
                            "verkürzt für „physiologische Lymphdrainage“, physiologischer Abtransport überschüssiger Flüssigkeit aus Körpergewebe über die Lymphgefäße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50d2d284-fa36-415e-ac8e-91a878faeee0",
                                "sense_id": "f1260c05-13c1-3b0a-8644-431c53f0f46e",
                                "text": "„Im Hinblick auf eine reduzierte physiologische Lymphdrainage der Membrana fibrosa, liegt es nahe, nach einer Unterstützung der manuellen Lymphdrainage zu suchen, […]“"
                            },
                            {
                                "example_id": "12de0314-2c50-4d50-b9f6-dd602a9b7f69",
                                "sense_id": "f1260c05-13c1-3b0a-8644-431c53f0f46e",
                                "text": "„Es existiert keine direkte Lymphdrainage der Haut in die Lnn. submandibulares, da diese Lymphknotengruppe unterhalb des Platysma lokalisiert ist. […] Die physiologische Lymphdrainage des Nasenrachens verläuft zunächst in dorsolateraler, dann in dorsolateralkaudaler Richtung. […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "41891954-f5cd-35fc-8d9a-0ce90682b3ab",
                        "entry_id": "257a1b6c-2a7b-3faa-aaa7-3e2a8168fb0e",
                        "glosses": [
                            "verkürzt für „manuelle Lymphdrainage“, eine spezielle physiotherapeutische Behandlung, wobei durch sanfte oberflächliche Manipulation des Bindegewebes die Lymphflüssigkeit verschoben und der Lymphabfluss (Lymphsystem) aktiviert wird"
                        ],
                        "tags": [
                            "Physiotherapie"
                        ],
                        "examples": [
                            {
                                "example_id": "39337c6f-bcff-4d14-b6f7-11afaae8a3f0",
                                "sense_id": "41891954-f5cd-35fc-8d9a-0ce90682b3ab",
                                "text": "Nach der Lymphdrainage tun die Beine nicht mehr weh."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
