                "senses": [
                    {
                        "sense_id": "d24a09b8-b1c9-3851-919c-ff913dac5ead",
                        "entry_id": "cbe6fdad-1c6a-310a-afaf-0480334dfb46",
                        "glosses": [
                            "mittlerer Wert der Noten einer Person, einer Klasse oder eines Jahrgangs"
                        ],
                        "tags": [
                            "Schule",
                            "Universität"
                        ],
                        "examples": [
                            {
                                "example_id": "37e72ebe-dc86-4ce4-bd82-881b5852d771",
                                "sense_id": "d24a09b8-b1c9-3851-919c-ff913dac5ead",
                                "text": "Mein Zensurendurchschnitt ist nicht gut genug, um Medizin zu studieren."
                            },
                            {
                                "example_id": "a1ffa5de-5f90-41c6-b38d-c4fc8886982e",
                                "sense_id": "d24a09b8-b1c9-3851-919c-ff913dac5ead",
                                "text": "„In der achten Klasse gelang ihm ein Zensurendurchschnitt von 2,7.“"
                            },
                            {
                                "example_id": "67a06043-dcd4-4294-9588-ac9592df1cfe",
                                "sense_id": "d24a09b8-b1c9-3851-919c-ff913dac5ead",
                                "text": "„Jette hat die Oberschule Rothenburg mit einem Zensurendurchschnitt von 1,15 abgeschlossen.“"
                            },
                            {
                                "example_id": "a3986949-1936-486a-890c-ce140ae9999a",
                                "sense_id": "d24a09b8-b1c9-3851-919c-ff913dac5ead",
                                "text": "„Und was machen Kinder mit einem schlechteren Zensurendurchschnitt fragen sich die Eltern?“"
                            },
                            {
                                "example_id": "d2ef1e53-d49c-45c2-b452-46dac7f4e824",
                                "sense_id": "d24a09b8-b1c9-3851-919c-ff913dac5ead",
                                "text": "„Während früher der Zensurendurchschnitt bei 1,7 lag, rutschte er nun auf 3,98 herunter.“"
                            },
                            {
                                "example_id": "0d024183-7de4-47a8-92c0-fe1d95fbcdea",
                                "sense_id": "d24a09b8-b1c9-3851-919c-ff913dac5ead",
                                "text": "[USA:] „Die Universität hatte […] 16 ihrer einhundert freien Studienplätze Angehörigen rassischer Minoritäten reserviert. Während reguläre Bewerber einen Zensurendurchschnitt von 3.49 für die Zulassung aufweisen mußten, genügte für die Sonderkandidaten schon ein Durchschnitt von 2.88.“"
                            },
                            {
                                "example_id": "fa91bd39-6308-46e5-afa5-84206437a876",
                                "sense_id": "d24a09b8-b1c9-3851-919c-ff913dac5ead",
                                "text": "„Die Schüler-Union […] bekommt zu spüren, daß auch konservativen Jugendlichen bei wachsendem Leistungsdruck der Zensurendurchschnitt wichtiger ist als die CDU.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
