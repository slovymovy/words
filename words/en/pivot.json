{
    "word_family": [
        "pivotal",
        "pivoting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b26bfa6-daee-3ff4-b0f8-5eef06dea19d",
                    "sense_definition": "To turn or rotate on a single fixed point.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer <w>pivoted</w> on her toes to face the audience."
                        },
                        {
                            "text": "He <w>pivoted</w> on his heel and walked out of the room."
                        }
                    ],
                    "synonyms": [
                        "rotate",
                        "spin",
                        "swivel"
                    ],
                    "common_phrases": [
                        "pivot on heel"
                    ]
                },
                {
                    "sense_id": "2a4e9e74-967a-304b-b550-d8b5bf46c639",
                    "sense_definition": "To make a sudden or significant change in business strategy or policy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The startup had to <w>pivot</w> its business model after failing to attract enough individual customers."
                        },
                        {
                            "text": "Successful entrepreneurs often <w>pivot</w> their strategy when they realize their initial plan is not working."
                        }
                    ],
                    "synonyms": [
                        "shift",
                        "reorient"
                    ],
                    "common_phrases": [
                        "pivot strategy"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b517850-2f36-3042-9b86-f6508c137039",
                    "sense_definition": "A central pin or shaft on which a mechanism turns.",
