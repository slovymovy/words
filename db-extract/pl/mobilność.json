                                "example_id": "c332aa1b-5a8b-4e7e-9635-3d27e3f1b7bc",
                                "sense_id": "c7e161a2-2cfb-3960-8ef2-d7a89ad3c1e4",
                                "text": "Mobilność, przeludnienie i brak higieny to czynniki, które pozwalały tym wirusom i bakteriom zbierać krwawe żniwo"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
