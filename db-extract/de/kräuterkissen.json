                "senses": [
                    {
                        "sense_id": "52e738b6-96ad-3d09-985f-a28cf117204a",
                        "entry_id": "69884e34-b7a0-365b-ab57-7c538be582b4",
                        "glosses": [
                            "Kissen, das einen wohltuenden Duft (der Kräuter, mit denen es gefüllt ist) entfalten soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "286e1c49-e33e-4e05-9c07-402ca6cfba05",
                                "sense_id": "52e738b6-96ad-3d09-985f-a28cf117204a",
                                "text": "„Ihre Verwendung beschränkt sich nicht auf die Bereitung von Riechwassern; das Kraut kann zur Vertreibung von Motten aus Kleiderschränken, zur Anfertigung von Kräuterkissen, Umschlägen und Bädern benutzt werden. “"
                            },
                            {
                                "example_id": "62a584c8-2166-426e-a030-c1039718235f",
                                "sense_id": "52e738b6-96ad-3d09-985f-a28cf117204a",
                                "text": "„»Was habe ich denn gemacht, gnädiger Herr?« fragte der alte Diener, durch die Mißlaune Cherubins ganz erschreckt. »Was? Jasmin! Du hast mich in Wohlgerüchen gebadet ... Du hast alle meine Kleider damit benetzt ... ich war ein lebendiges, parfümirtes Kräuterkissen.«“"
                            },
                            {
                                "example_id": "9c56a0e1-1e35-4b6e-832d-60ae76ce0e67",
                                "sense_id": "52e738b6-96ad-3d09-985f-a28cf117204a",
                                "text": "„»Wo willst du hin?« fragte Luise die Älteste, die mit einem Kräuterkissen auf der Backe umherlief, weil sie Zahnschmerzen hatte.“"
                            },
                            {
                                "example_id": "bdf9725b-2e3c-4331-8fa9-1a3300c23b2c",
                                "sense_id": "52e738b6-96ad-3d09-985f-a28cf117204a",
                                "text": "„Damals freilich, da hatte ich auch ein Heumagazin von gedörrten Rosen, Vergißmeinnicht und sonst noch allerlei Grünlichkeiten so gut wie eine von euch zarten Seelen, wie ich aber einmal gewahr ward, daß ich alle das Zeug sogar nicht einmal zum Kräuterkissen bei Zahnweh brauchen konnte, warf ich es zum Fenster hinaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
