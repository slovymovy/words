{
    "word_family": [
        "pendant",
        "pendent",
        "pending",
        "pendulum",
        "pension",
        "pensive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45ee12ae-dc08-38f8-9815-a356ad6ac505",
                    "sense_definition": "A vaulted passageway or archway leading through a building to a rear courtyard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old city apartment block had a dark <w>pend</w> that led to a quiet garden.",
                            "target_lang_translations": {
                                "zh": "老城区的公寓楼有一条昏暗的<w>拱道</w>，通向一座安静的花园。"
                            }
                        },
                        {
                            "text": "We walked through the stone <w>pend</w> to reach the hidden courtyard behind the shops.",
                            "target_lang_translations": {
                                "zh": "我们穿过石质<w>过道</w>，来到商店后面隐秘的院子里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alley"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Scotland."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（苏格兰）穿过建筑物通向后院的拱形通道或过道"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拱道",
                                "target_lang_sense_clarification": "建筑中通向后院的拱形通道"
                            },
                            {
                                "target_lang_word": "过道",
                                "target_lang_sense_clarification": "穿过建筑物的通道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c38919bb-c325-3b5f-bd4a-06d36f2ba3c5",
                    "sense_definition": "A compressed block of oil-rich plant material used as animal feed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer bought a large supply of <w>pend</w> to feed the cattle during winter.",
                            "target_lang_translations": {
                                "zh": "农夫采购了大量的<w>油饼</w>，以备冬天喂养牲口。"
                            }
                        },
                        {
                            "text": "High-quality <w>pend</w> is essential for maintaining livestock health in cold climates.",
                            "target_lang_translations": {
                                "zh": "高品质的<w>油饼</w>对于寒冷气候下维持牲畜健康至关重要。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用作牲畜饲料的油料植物压制块（油饼）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "油饼",
                                "target_lang_sense_clarification": "榨油后压制成的牲畜饲料"
                            },
                            {
                                "target_lang_word": "饼粕饲料",
                                "target_lang_sense_clarification": "压制植物饲料"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b3a9129-32cd-3af1-b616-0a21cc35b779",
                    "sense_definition": "To be contingent or dependent upon something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dependency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final decision will <w>pend</w> upon the results of the upcoming investigation.",
                            "target_lang_translations": {
                                "zh": "最终决定将<w>取决于</w>即将进行的调查结果。"
                            }
                        },
                        {
                            "text": "Success in this project will <w>pend</w> on our ability to secure more funding.",
                            "target_lang_translations": {
                                "zh": "这个项目的成功将<w>取决于</w>我们争取到更多资金的能力。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely replaced by depend."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古）取决于，视……而定"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "取决于",
                                "target_lang_sense_clarification": "依赖于某事"
                            },
                            {
                                "target_lang_word": "依",
                                "target_lang_sense_clarification": "视情况而定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa4383b7-fa90-324f-8dc8-76cc1df85fe5",
                    "sense_definition": "To delay or postpone the processing of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided to <w>pend</w> the application until further documentation is provided.",
                            "target_lang_translations": {
                                "zh": "经理决定先<w>搁置</w>这份申请，直到补齐进一步的文件。"
                            }
                        },
                        {
                            "text": "We must <w>pend</w> all non-urgent requests until the end of the fiscal year.",
                            "target_lang_translations": {
                                "zh": "我们必须把所有非紧急请求<w>暂缓</w>处理，直到本财年结束。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "暂缓处理，推迟，搁置"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "搁置",
                                "target_lang_sense_clarification": "暂时不予处理"
                            },
                            {
                                "target_lang_word": "暂缓",
                                "target_lang_sense_clarification": "推迟处理流程"
                            },
                            {
                                "target_lang_word": "延后",
                                "target_lang_sense_clarification": "延迟办理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe4471f8-abe1-3499-83ec-ffd58ca57bbd",
                    "sense_definition": "To hang down or cause to hang down.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy curtains <w>pend</w> from the ceiling to the floor.",
                            "target_lang_translations": {
                                "zh": "厚重的窗帘从天花板一直<w>垂下</w>到地板。"
                            }
                        },
                        {
                            "text": "The artist chose to <w>pend</w> the sculpture from a single thin wire.",
                            "target_lang_translations": {
                                "zh": "艺术家选择用一根细金属丝将雕塑<w>悬挂</w>起来。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古）悬挂，下垂"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "悬挂",
                                "target_lang_sense_clarification": "吊起，垂下"
                            },
                            {
                                "target_lang_word": "垂下",
                                "target_lang_sense_clarification": "向下挂着"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8053ea9d-0ed4-338d-9d07-ef42e176084e",
                    "sense_definition": "To form an arch over something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient stone bridges <w>pend</w> over the narrow river.",
                            "target_lang_translations": {
                                "zh": "古老的石桥如拱门般<w>拱跨</w>在狭窄的河流之上。"
                            }
                        },
                        {
                            "text": "The branches of the trees <w>pend</w> over the path like a natural tunnel.",
                            "target_lang_translations": {
                                "zh": "树枝如天然隧道般在小路上方<w>拱跨</w>成荫。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古）在……上方成拱形横跨"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拱跨",
                                "target_lang_sense_clarification": "在上方形成拱形"
                            },
                            {
                                "target_lang_word": "笼罩",
                                "target_lang_sense_clarification": "拱状覆于上方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5cdf9b6-85ff-3922-a0fd-18c6867ee2e8",
                    "sense_definition": "To confine or enclose someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old laws allowed authorities to <w>pend</w> vagrants in small cells.",
                            "target_lang_translations": {
                                "zh": "旧法律允许当局将流民<w>关押</w>在狭小的牢房里。"
                            }
                        },
                        {
                            "text": "They had to <w>pend</w> the animals in a secure area during the storm.",
                            "target_lang_translations": {
                                "zh": "暴风雨期间，他们不得不把动物<w>圈禁</w>在一个安全的区域。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古）关押，圈禁，限制"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "圈禁",
                                "target_lang_sense_clarification": "关押在封闭空间"
                            },
                            {
                                "target_lang_word": "关押",
                                "target_lang_sense_clarification": "拘禁人或动物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}