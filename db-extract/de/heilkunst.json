                "senses": [
                    {
                        "sense_id": "9eb7132e-d284-38a2-ac10-fbed523f4c3b",
                        "entry_id": "b8a381da-df20-3462-9880-366a266def33",
                        "glosses": [
                            "Gesamtheit der menschlichen (insbesondere ärztlichen) Kenntnisse und Fähigkeiten, Krankheiten zu heilen, zu lindern und vorzubeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aae9eb4b-640e-495e-a47f-52a00f44519e",
                                "sense_id": "9eb7132e-d284-38a2-ac10-fbed523f4c3b",
                                "text": "„Es begann mir zu dämmern, daß die Heilkunst durchaus nicht das war, was die Leute sich darunter vorstellten, sondern daß sie etwas sehr Einfaches, tatsächlich zu Einfaches für den gewöhnlichen Verstand war, um sie zu begreifen.“"
                            },
                            {
                                "example_id": "ba3df2c9-a239-49cb-b905-0edd2ff9808e",
                                "sense_id": "9eb7132e-d284-38a2-ac10-fbed523f4c3b",
                                "text": "„Das war keine Heilkunst, eine schlechte Ablenkung war das, weil der Arzt nicht weiterwusste.“"
                            },
                            {
                                "example_id": "36317497-15e5-4ad9-b983-82edc2e2274e",
                                "sense_id": "9eb7132e-d284-38a2-ac10-fbed523f4c3b",
                                "text": "„Ich behauptete, daß die Heilkunst nichts tauge, ja, überhaupt nicht existiere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
