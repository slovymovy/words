                "senses": [
                    {
                        "sense_id": "bccc5f4b-80b6-3605-b0e3-ff298eee7179",
                        "entry_id": "24ed5ced-ec60-31c7-bbd1-28d3da4d3414",
                        "glosses": [
                            "das, was von essbaren Produkten (Nahrung) übrigbleibt/übriggeblieben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38a5086b-f97d-4ac6-a572-c19fdc8f7a81",
                                "sense_id": "bccc5f4b-80b6-3605-b0e3-ff298eee7179",
                                "text": "„Sie hatten das Ziel, auf Grund der in den Gewöllen enthaltenen Nahrungsreste (Knochen, Haare u. a. m.) die Nahrung der Eule qualitativ und quantitativ genau zu analysieren.“"
                            },
                            {
                                "example_id": "99fb62ef-b03c-4424-8297-f778cb471207",
                                "sense_id": "bccc5f4b-80b6-3605-b0e3-ff298eee7179",
                                "text": "„Als nächste Ursache kommen die Buchten des Zungengrundes in Frage. Hier bleiben Sekret- und Nahrungsreste liegen.“"
                            },
                            {
                                "example_id": "382e364c-f896-40a1-babf-beb9b07f7401",
                                "sense_id": "bccc5f4b-80b6-3605-b0e3-ff298eee7179",
                                "text": "„Dickdarm. Hier wird der Nahrungsrest zur Ausscheidung vorbereitet. Enddarm. Hier wird der Nahrungsrest ausgeschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
