                                        "glosses": [
                                            "One who squalls; a crier, complainer, or bad singer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2fb921a-4bef-4fad-b531-6b7f5df97430",
                                                "sense_id": "d479b8c1-5f29-3891-9e83-0f2a8a8f6060",
                                                "text": "A conviction of Bedlam broken loose scattered Bradly's wits. Edmund circled the uproar with hackles up, craving a signal from Bradly to nip this old squaller by her broomstick legs. Cora kept edging off, her frown dark with impotent rebellion."
                                            }
