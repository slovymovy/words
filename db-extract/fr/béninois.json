                                                "sense_id": "d36fac55-db6c-3c04-83c4-baede2640ad1",
                                                "text": "„Etwa mehr als ein Drittel der Beniner leben unterhalb der Armutsgrenze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
