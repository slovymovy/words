        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "635f5f6d-1bce-33c4-9534-a6fe8e8ed9a1",
                "word": "Genevieve",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c906e3ae-3f6c-3b0e-9dab-f249c5eb5eaa",
                        "entry_id": "635f5f6d-1bce-33c4-9534-a6fe8e8ed9a1",
                        "glosses": [
                            "A female given name from French."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e65da1f8-fff1-48f4-969a-16d35a18fede",
                                "sense_id": "c906e3ae-3f6c-3b0e-9dab-f249c5eb5eaa",
                                "text": "Her name was Genevieve. A classy name and she was a classy woman or had been, not long ago;"
                            },
                            {
                                "example_id": "a02f58a5-b9ce-418f-8610-e8b95c507735",
                                "sense_id": "c906e3ae-3f6c-3b0e-9dab-f249c5eb5eaa",
                                "text": "But I like it when Stella calls me Genevieve, because though I'm Jenny to everyone else, always have been since I was born, I was christened Genevieve. My dad called me after a vintage car in a film, if you can credit it, and to most people it's a bit embarrassing, but the way Stella says it it's got a pretty sound."
                            }
                        ]
                    }
                ],
