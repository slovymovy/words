                    },
                    {
                        "sense_id": "50ed7fbf-6218-3abd-b1a2-9981d36a72fe",
                        "entry_id": "27c8da06-ac57-345a-b885-ad76659f3398",
                        "glosses": [
                            "To doctor or modify for deceptive purposes."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ba5f826e-9bbd-406f-802c-8356aafeaf92",
                                "sense_id": "50ed7fbf-6218-3abd-b1a2-9981d36a72fe",
                                "text": "When the operator began losing, he gaffed the wheel and then the patron had no chance to win. With his secret device an experienced grifter could stop the wheel at will on any number."
                            },
                            {
                                "example_id": "513166b0-7a3a-481d-8527-f64e96b59095",
                                "sense_id": "50ed7fbf-6218-3abd-b1a2-9981d36a72fe",
                                "text": "However, this apathy will quickly disappear if it is learned the friendly game involves marked (gaffed) cards."
                            },
                            {
                                "example_id": "eb95cb9b-af9c-4b28-a309-c45787dfc722",
                                "sense_id": "50ed7fbf-6218-3abd-b1a2-9981d36a72fe",
                                "text": "You will be using gaffed cards: a double faced card."
                            }
                        ]
                    },
                    {
                        "sense_id": "152d4414-3e97-3543-94de-974e326b7dc8",
                        "entry_id": "27c8da06-ac57-345a-b885-ad76659f3398",
                        "glosses": [
                            "To gamble, especially by tossing coins."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a50c8c80-5f68-37a6-94ef-34e0ab493bb2",
                        "entry_id": "27c8da06-ac57-345a-b885-ad76659f3398",
                        "glosses": [
                            "To affix gaffer tape to, or cover with gaffer tape."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fe0801df-8521-4d2c-8d08-d0ad5e73e419",
                                "sense_id": "a50c8c80-5f68-37a6-94ef-34e0ab493bb2",
                                "text": "I gaffed down the sleeves to my lens hoods instead of just relying on the drawstring to hold it in place."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
