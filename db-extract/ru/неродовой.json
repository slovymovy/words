                    },
                    {
                        "translation_id": "794d4569-4b3e-430a-b346-44f63deae453",
                        "source_entry_id": "c78077c5-4d5d-3e86-b0fd-ef1ab28654be",
                        "target_lang_word": "insexué",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insexué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3fe28c2-0f05-3ecb-b1d1-4ed04f36835c",
                                        "entry_id": "5cb8085a-b650-3afe-a389-b4f82054a210",
                                        "glosses": [
                                            "Asexué."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39075871-6f04-4d11-b592-fed5a4456fd8",
                                                "sense_id": "c3fe28c2-0f05-3ecb-b1d1-4ed04f36835c",
                                                "text": "Une moue d’Hyacinthe dit son dégoût de la fécondité. La belle affaire ! Le premier goujat venu faisait un enfant. Ce qui devenait exquis et rare, c’était l’idée insexuée existant par elle-même."
                                            },
                                            {
                                                "example_id": "a6ed6ff4-030f-4212-86ab-41648a254429",
                                                "sense_id": "c3fe28c2-0f05-3ecb-b1d1-4ed04f36835c",
                                                "text": "Je ne suis pas en question. Il s’agit de Philippe Audebert et non de Camille Dalleray. Il leva les yeux sur elle avec l’étonnement que lui causait, encore une fois, le prénom insexué."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
