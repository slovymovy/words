                    "frequency": "High",
                    "semantic_group_id": "comparative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het weekend voel ik me meestal een stuk <w>vrijer</w> dan tijdens de werkweek.",
                            "target_lang_translations": {
