                "senses": [
                    {
                        "sense_id": "d1fb1a25-96b5-3e95-8837-ba39cbb04388",
                        "entry_id": "0d80ac04-e73c-316c-b3f6-945d522a5e53",
                        "glosses": [
                            "dunklere Stelle auf der Haut, die durch ein erhöhtes Vorhandensein von Pigment (Farbstoff) zustande kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a65978e2-ed44-4e8c-8081-66614731d738",
                                "sense_id": "d1fb1a25-96b5-3e95-8837-ba39cbb04388",
                                "text": "„Im Gesicht finden sich verschiedene, punktförmige Pigmentflecke, von denen der übrige Körper frei ist.“"
                            },
                            {
                                "example_id": "48426583-0c0b-4af8-9109-bb51980d0e9d",
                                "sense_id": "d1fb1a25-96b5-3e95-8837-ba39cbb04388",
                                "text": "„Es fielen eine Blaufärbung des Ohrknorpels beiderseits und ein schwacher dunkler Pigmentfleck in einem Auge auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
