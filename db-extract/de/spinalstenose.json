                "senses": [
                    {
                        "sense_id": "73b44194-804d-3def-b329-372e1c6304eb",
                        "entry_id": "53e96fdf-0e5d-3021-b43f-460876ff8c4e",
                        "glosses": [
                            "eine Einengung des Wirbelkanals z. B. infolge von Arthrose an den Wirbelgelenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e4dd7c1-737b-4b1b-b26e-b12c6daf151d",
                                "sense_id": "73b44194-804d-3def-b329-372e1c6304eb",
                                "text": "„Als Spinalstenose wird eine bei Mastrinder-Kälbern verschiedener Rassen beobachtete angeborene dorso- ventrale Einengung des thorako-lumbalen Wirbelkanals bezeichnet, die mit Hydro- und Syringomyelie verbunden sein kann.“"
                            },
                            {
                                "example_id": "9b01b3af-4cd6-48ed-87ba-478b5e537bf5",
                                "sense_id": "73b44194-804d-3def-b329-372e1c6304eb",
                                "text": "„Spinalstenose Definition. Der Durchmesser des Spinalkanals ist kongenital oder sekundär aufgrund degenerativer Veränderungen reduziert.“"
                            },
                            {
                                "example_id": "c4e6291a-4299-4736-b50a-ace7bb5ada5a",
                                "sense_id": "73b44194-804d-3def-b329-372e1c6304eb",
                                "text": "„Die Bildgebung der Wahl bei lumbaler Spinalstenose ist die MRT.“"
                            },
                            {
                                "example_id": "3f17dc1d-0c67-4b5d-974b-fde582816558",
                                "sense_id": "73b44194-804d-3def-b329-372e1c6304eb",
                                "text": "Bei Spinalstenosen stellt sich beim Gehen oft das Gefühl „auf Gummi zu gehen“ ein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
