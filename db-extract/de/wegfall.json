                        ],
                        "form": "des Wegfalles"
                    },
                    {
                        "form_id": "7dbd31cb-d5ff-4a0a-ad32-206f408633b5",
                        "entry_id": "8583ab45-88c0-34cb-bc45-73f8a2ddc99a",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Wegfall"
                    },
                    {
                        "form_id": "2ba6b97c-2a1e-43d8-9db0-6558a6faa0ec",
                        "entry_id": "8583ab45-88c0-34cb-bc45-73f8a2ddc99a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Wegfall"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                        "entry_id": "8583ab45-88c0-34cb-bc45-73f8a2ddc99a",
                        "glosses": [
                            "etwas, was mal existiert hat (beispielsweise ein Gesetz, ein Zuschuss, eine Stelle), ist nicht mehr gegeben/weggefallen"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "afef0f38-9355-4288-947c-82360d07b3f0",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "Der Wegfall der Grenzen durch das Schengen-Abkommen war für Europa ein Glücksfall."
                            },
                            {
                                "example_id": "e7920bfd-66c0-416f-9ef2-2a776cc6d353",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "Der Wegfall von Inlandsflügen ist ein Gewinn für die Umwelt."
                            },
                            {
                                "example_id": "3d4f3b0f-d3a5-4506-bf54-cab2a49d3199",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "Der Wegfall der Beschränkungen in der Coronakrise kommt in Deutschland zu früh."
                            },
                            {
                                "example_id": "4864d2bc-3985-4aec-8f89-c9704ddf0577",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "[Coronakrise 2020:] „»Der Wegfall des Angebots von Schnellrestaurants, Pommes-Buden und Italiener-um-die-Ecke wirft die Leute nun dramatisch zurück auf ihre eigenen Kochkünste«, sagte BVE-Hauptgeschäftsführer Christoph Minhoff.“"
                            },
                            {
                                "example_id": "5c8948a8-8c21-47f9-8adb-05430be9c03a",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "„Schweizer Milchbauern beargwöhnen den Wegfall der Milchquoten in der EU. Sie fürchten, dass dadurch der Schweizer Milchpreis unter Druck geraten könnte.“"
                            },
                            {
                                "example_id": "42cd7f18-d7e9-4939-8388-60723badcd71",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "„Mittlerweile aber leben 80 Prozent der Inselbewohner in irgendeiner Form vom Tourismus und sie sorgen sich vor dem Wegfall der Einnahmequellen.“"
                            },
                            {
                                "example_id": "17a27926-d1a7-4598-94dc-78f64866db59",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "„Nach dem Wegfall der Bindung an Byzanz versucht das Zarentum, die Kontrolle über die russische Kirche zu erlangen und eine auf seine Bedürfnisse zugeschnittene Staatskirche zu formen.“"
                            },
                            {
                                "example_id": "374a3146-0c6e-41ab-b422-f8421e6363a7",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "„Nach dem Wegfall der Atomsanktionen drückt der Iran bei der Modernisierung seiner Wirtschaft aufs Tempo.“"
                            },
                            {
                                "example_id": "bbb7e8b2-6cce-4772-baf0-3153bd7a1f59",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "Geesthacht wird durch den Wegfall der Gewerbesteuer vom Kernkraftwerk Krümmel Schwierigkeiten haben, seinen Haushalt zu finanzieren."
                            },
                            {
                                "example_id": "c4d4d16d-cae8-46d1-a8fd-6cff6d68a728",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "[Bedingungsloses Grundeinkommen:] „Durch den Wegfall aller Sozialtransferleistungen und einer unbürokratischen Zuweisung der Grundeinkommen, sollten im Sozialbereich große Einsparungen entstehen.“"
                            },
                            {
                                "example_id": "7461c630-0ad6-4a11-9f21-045373b4ebe6",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "„[…] Mörder, die erst in der Bundesrepublik ihre Straftaten begingen, können durch den Wegfall der Verjährungsfrist ebenso verfolgt werden, auch wenn ihre Taten schon lange zurückliegen. Zum Beispiel mit neuen Beweismitteln wie DNA-Proben.“"
                            },
                            {
                                "example_id": "63c60d59-68bc-4171-815a-5dd115a5a73a",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "[Weltweite Coronakrise:] „Allein im zweiten Quartal dieses Jahres rechnet die ILO mit dem Verlust rund 305 Millionen Vollzeitstellen. Die Kalkulation der ILO basiert auf einem erwarteten Wegfall von Arbeitsstunden im zweiten Quartal verglichen mit dem letzten Quartal vor der Krise, dem vierten Quartal 2019.“"
                            },
                            {
                                "example_id": "bc9a4188-068f-43f3-9199-b85e424e02f0",
                                "sense_id": "f3bf32cf-7fd1-3026-b639-e9e7977a850f",
                                "text": "„Linux Mint 19.3 erschienen: […] Wie bei den Vorgängern werden seit dem Wegfall der KDE-Edition die Desktop-Umgebungen Cinnamon, Xfce und Mate mit jeweils eigenen Abbildern für 32 und 64 Bit veröffentlicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
