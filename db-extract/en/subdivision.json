                    {
                        "sense_id": "f1a8998e-9657-37fe-b7a8-7a126b2ec890",
                        "entry_id": "593f01f2-5566-35bb-bc14-07b67965a1fc",
                        "glosses": [
                            "同一建商或地區所建造的房子。"
