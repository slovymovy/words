                                        "glosses": [
                                            "Verpfändung von Schiff und Ladung durch den Kapitän (der nicht der Eigentümer der beiden ist) zwecks Kreditaufnahme (in Deutschland abgekommenes Institut des Seehandelsrechts)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b787ba-1de0-42c9-8310-2d5dd0c53e47",
                                                "sense_id": "cb03285c-05fb-3035-87e8-86fab6e8d0d6",
                                                "text": "Um die teure Schiffsschraube in Iquique ersetzen zu lassen, musste der Kapitän, da der Reeder nicht zu erreichen war, zum Notmittel der Bodmerei greifen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
