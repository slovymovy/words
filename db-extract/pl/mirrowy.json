                        "translation_id": "3059456a-92cb-4acf-94da-4e5b61d42543",
                        "source_entry_id": "218de3f9-1b5f-35b2-9b47-4c0ea4f7f22e",
                        "source_sense_id": "61276938-f478-3f8f-a585-60fa66a2f1d5",
                        "target_lang_word": "myrrhic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myrrhic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b719fd9b-bb86-378d-aa57-e414143bdbb9",
                                        "entry_id": "dac22e48-3ab0-3b58-acbc-acc6f9a6d516",
                                        "glosses": [
                                            "Of, related to, or derived from myrrh."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ebb2dc-f3b8-476f-be3a-11730ddf797a",
                                                "sense_id": "b719fd9b-bb86-378d-aa57-e414143bdbb9",
                                                "text": "Corpses, treatment of.—A solution of myrrhic resin is obtained by treating powdered myrrh […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c466cd2-a4a0-3aff-9fd0-847e272e2cdd",
                                        "entry_id": "dac22e48-3ab0-3b58-acbc-acc6f9a6d516",
                                        "glosses": [
                                            "Having a pleasant fragrance; aromatic."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c70316eb-0c96-4d13-a397-ebf845c9d438",
                                                "sense_id": "6c466cd2-a4a0-3aff-9fd0-847e272e2cdd",
                                                "text": "All the fragrances of dew, O angel, are there, / The myrrhic rapture of young hair, […]"
                                            },
                                            {
                                                "example_id": "80703fa5-1dcb-4ed1-8dd3-aeab22e0787b",
                                                "sense_id": "6c466cd2-a4a0-3aff-9fd0-847e272e2cdd",
                                                "text": "Above us the avern brooded like a gonfalon; from it there drifted a myrrhic perfume."
                                            },
                                            {
                                                "example_id": "6382ce6c-6bd3-471d-9438-0f83385df412",
                                                "sense_id": "6c466cd2-a4a0-3aff-9fd0-847e272e2cdd",
                                                "text": "It reverberates with layer on layer of flavour and aroma, from springtime zephyr at the top of the register to a myrrhic basso profundo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
