                                        "examples": [
                                            {
                                                "example_id": "d513a0e8-bef6-4df0-b094-63fd79bd61fe",
                                                "sense_id": "a2785b6f-9d38-3717-82a9-7fc9e12f4330",
                                                "text": "La démocrate américaine Catherine Cortez Masto a remporté, samedi, l’État du Nevada, octroyant à son parti 50 sénateurs sur 100."
                                            },
                                            {
                                                "example_id": "5413f3ff-3104-46c8-9fbe-44b0a9ca22c2",
                                                "sense_id": "a2785b6f-9d38-3717-82a9-7fc9e12f4330",
                                                "text": "Si on ajoute le Nevada, l’équipe de Joe Biden peut se réjouir d’avoir conquis des territoires acquis aux républicains depuis plusieurs cycles électoraux."
                                            }
                                        ]
                                    }
