                ],
                "senses": [
                    {
                        "sense_id": "34794d56-1e0e-30c8-ac3f-9ec0d0698332",
                        "entry_id": "f5efcbd6-0893-33aa-a6ed-fdd4acfee1bf",
                        "glosses": [
                            "Faire perdre à quelque chose son caractère gradué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29c93bc8-671b-4651-96d9-e5d9ba678717",
                                "sense_id": "34794d56-1e0e-30c8-ac3f-9ec0d0698332",
                                "text": "Il me semble qu’on devrait reconsidérer cette idée de dégraduer, si vous voulez, de façon progressive toute allocation de dépendance sociale, peu importent les formules à établir, mais que ce soit prescriptif sans calcul, sans enquête et sans chinoiserie, de façon à pouvoir vraiment faire une incitation au travail."
                            }
                        ]
                    },
                    {
                        "sense_id": "581f2e49-3491-394b-8c79-3bb7cbc83986",
                        "entry_id": "f5efcbd6-0893-33aa-a6ed-fdd4acfee1bf",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e941c2b3-339d-406a-8e73-28be272f80e5",
                                "sense_id": "581f2e49-3491-394b-8c79-3bb7cbc83986",
                                "text": "C’est ce que nous appelons dégraduer."
                            },
                            {
                                "example_id": "6d794677-c1c2-4299-8d51-685958fc2c0b",
                                "sense_id": "581f2e49-3491-394b-8c79-3bb7cbc83986",
                                "text": "Si ce sont les vides, m’objectera-t-on, qui produisent le refroidissement des parties de la matière en position corporelle (246), comment la glace, qui a ses vides plus grands que ceux de l’eau la plus froide (25), fait-elle moins dégraduer le thermomètre que les vides de cette dernière ?"
                            }
                        ]
                    }
                ],
