                "senses": [
                    {
                        "sense_id": "55705d98-8c30-3af9-bd27-55eb1935c098",
                        "entry_id": "1f4eb088-7267-335e-82ad-342b6c56cd19",
                        "glosses": [
                            "bedekt door aanslag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38ec5b2b-408c-42a0-a34e-1f6ed8b6163f",
                                "sense_id": "55705d98-8c30-3af9-bd27-55eb1935c098",
                                "text": "Door zijn aangeslagen brillenglazen kon hij de weg niet meer goed zien."
                            }
                        ]
                    },
                    {
                        "sense_id": "57317945-46f3-3283-828d-3a05088ad53c",
                        "entry_id": "1f4eb088-7267-335e-82ad-342b6c56cd19",
                        "glosses": [
                            "tijdelijk naar een hoger energieniveau gebracht, bijvoorbeeld door de absorptie van een energierijk foton"
                        ],
                        "tags": [
                            "van een elektron of een atoom dat een dergelijk elektron bezit"
                        ],
                        "examples": [
                            {
                                "example_id": "ce9677df-1ff9-4ced-9149-01250dc20ef1",
                                "sense_id": "57317945-46f3-3283-828d-3a05088ad53c",
                                "text": "Als het atoom niet in de grondtoestand is, dan spreken we van een aangeslagen toestand."
                            }
                        ]
                    },
                    {
                        "sense_id": "79d9e328-9c2e-3728-8e50-c3fd6eb4356d",
                        "entry_id": "1f4eb088-7267-335e-82ad-342b6c56cd19",
                        "glosses": [
                            "tijdelijk niet in staat om iets te doen vanwege een emotionele of lichamelijke klap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38dbe3cf-1893-4e82-bd21-174707a95478",
                                "sense_id": "79d9e328-9c2e-3728-8e50-c3fd6eb4356d",
                                "text": "De buurt is zwaar aangeslagen door het drama."
                            },
                            {
                                "example_id": "e4f09196-d99b-473a-bc83-ba4dc174c2b3",
                                "sense_id": "79d9e328-9c2e-3728-8e50-c3fd6eb4356d",
                                "text": "Van het ene op het andere moment zat er een oude, diep aangeslagen vrouw naast het bed van haar enige zoon."
                            },
                            {
                                "example_id": "229ad5bc-7fc2-4e7b-b95f-7d9f6e8aedc7",
                                "sense_id": "79d9e328-9c2e-3728-8e50-c3fd6eb4356d",
                                "text": "\"We zijn aangeslagen maar dankbaar voor de belangrijke bijdrage die hij heeft geleverd aan de ontwikkeling van het kunsthart\", aldus UMC Utrecht."
                            }
                        ]
                    }
                ],
