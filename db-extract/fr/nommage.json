                            {
                                "example_id": "bf3993a8-1105-4115-b916-c94fa7509876",
                                "sense_id": "a517e1b4-a94f-316d-97b3-ec576e8a787a",
                                "text": "La règle de nommage des noms de variable est de les écrire en minuscules, et en séparant les mots à l’aide du caractère « tiret bas »."
                            }
                        ]
                    },
                    {
