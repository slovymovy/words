                                            {
                                                "example_id": "e0192b09-5227-4005-918d-e75cf86343af",
                                                "sense_id": "226be66a-0d7e-3f12-bb52-c78e4644bec6",
                                                "text": "La loi répute actes de commerce : […] nᵒ 7 Toute opération de change, banque et courtage ; […]."
