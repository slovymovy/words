                "senses": [
                    {
                        "sense_id": "a4a4f094-eedf-33a3-9df0-14a7c3fe6cf5",
                        "entry_id": "156a6447-6d1d-3ae0-b485-b72987c5cb2a",
                        "glosses": [
                            "Pappe, die durch Zusammenkleben von mindestens einer glatten und einer gewellten Papierbahn hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33a301d1-b314-44f9-a466-effa87d79b60",
                                "sense_id": "a4a4f094-eedf-33a3-9df0-14a7c3fe6cf5",
                                "text": "„Im Set sind sowohl der Grundkörper für die Tüte aus 3D-Wellpappe, Holzspitze, 3D-Applikationen sowie eine Bastelanleitung enthalten.“"
                            },
                            {
                                "example_id": "39cc2d83-29e3-4773-ba10-b6d727f9f24d",
                                "sense_id": "a4a4f094-eedf-33a3-9df0-14a7c3fe6cf5",
                                "text": "„Sie produzieren Wellpappe für Transporte, Kartons für Supermarktregale, Papier für Etiketten, Taschentücher und Bücher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
