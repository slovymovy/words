                "senses": [
                    {
                        "sense_id": "bf95da93-e6ab-3442-b27f-f12d316d82ef",
                        "entry_id": "8e04e24c-1d3c-3099-82e3-5b2f803adb74",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4cf8f59-6942-4802-990e-08acccde6a17",
                                "sense_id": "bf95da93-e6ab-3442-b27f-f12d316d82ef",
                                "text": "Oskars rote Nase ist sein Markenzeichen."
                            },
                            {
                                "example_id": "ebd0e9c4-9b1a-4199-bcf8-89cd672b1c09",
                                "sense_id": "bf95da93-e6ab-3442-b27f-f12d316d82ef",
                                "text": "Die Zwillinge Oskar und Oswald sind wegen Einbruchsdiebstahls angeklagt."
                            },
                            {
                                "example_id": "b885d466-e1ef-47ac-9367-9098c5e75a43",
                                "sense_id": "bf95da93-e6ab-3442-b27f-f12d316d82ef",
                                "text": "Dem Pleitier Oskar ist nun auch die Frau weggelaufen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02a8a3e8-c03f-4f98-a231-deb5ee11a42a",
                        "source_entry_id": "8e04e24c-1d3c-3099-82e3-5b2f803adb74",
