                {
                    "sense_id": "2ba50f20-591d-3880-a400-c6ca9becf220",
                    "sense_definition": "A road including the sidewalks and the buildings that line it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "thoroughfare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I live on the <w>street</w> down from Joyce Avenue.",
                            "target_lang_translations": {
                                "ru": "Я живу на <w>улице</w> ниже Джойс-авеню."
                            }
                        },
                        {
                            "text": "The whole <w>street</w> came out to celebrate the neighborhood festival.",
                            "target_lang_translations": {
                                "ru": "Вся <w>улица</w> вышла отпраздновать районный фестиваль."
                            }
                        }
                    ],
                    "common_phrases": [
                        "live on the street",
                        "down the street"
                    ],
                    "target_lang_definitions": {
