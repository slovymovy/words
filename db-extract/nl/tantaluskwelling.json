                        "examples": [
                            {
                                "example_id": "c8978132-7989-4e00-ac7d-016e101ecc8a",
                                "sense_id": "064c9ed2-b26a-34f4-9617-801f8cdb85b9",
                                "text": "Weinig reden voor afgunst dus jegens hen die elke dag omringd worden door zoveel moois, en eerder permanent bloot staan aan een Tantaluskwelling dan dat hen een literaire Hof van Eden deelachtig is geworden."
                            },
                            {
                                "example_id": "ae118b4b-ae84-45e5-a5d9-6d50d237345e",
                                "sense_id": "064c9ed2-b26a-34f4-9617-801f8cdb85b9",
                                "text": "‘Een glas zonder wijn is een Tantaluskwelling voor een kittebroer als jij,’ zei ze."
                            }
                        ]
                    }
