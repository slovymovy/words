                "senses": [
                    {
                        "sense_id": "86cf4d09-1299-3909-923c-a6cdfe27e890",
                        "entry_id": "0fe43b40-fe32-3fae-b5ba-5e186617d12b",
                        "glosses": [
                            "sehr stark vom Normalzustand abweichendes Wetter; sehr schlechtes Wetter"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "588339bb-cda3-42c5-91f2-69b71a2ab2b2",
                                "sense_id": "86cf4d09-1299-3909-923c-a6cdfe27e890",
                                "text": "„Am Ende geht es um den Schutz der Menschen vor Risiken wie Extremwetter, Meeresspiegelanstieg, Wirtschaftsschäden, auch zusätzlichen Konflikten.“"
                            },
                            {
                                "example_id": "b793353a-f2b9-4896-9b22-a755722cf9eb",
                                "sense_id": "86cf4d09-1299-3909-923c-a6cdfe27e890",
                                "text": "„Deutschland gehörte im Jahr 2018 erstmals zu den drei am stärksten von Extremwetter betroffenen Ländern der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
