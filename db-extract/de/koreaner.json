                                        "entry_id": "955ec26e-8a2e-398a-9e9d-2a8146a02fe0",
                                        "glosses": [
                                            "Of or relating to the Asian Peninsula comprising North Korea and South Korea."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2091185c-d320-4d6e-bb4d-b32bb01934e7",
                                                "sense_id": "6f3f1f59-d300-3e6b-8b5a-f02257bc3515",
                                                "text": "The show’s stage design features bojagi, traditional Korean patchwork. The audience members are also presented with Korean traditional dance, including buchaechum, or “fan dance,” performed by a group of female dancers using fans painted in different colors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40cc4663-db0d-3dfc-ba76-3302677c892c",
