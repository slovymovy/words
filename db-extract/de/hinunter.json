                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44700830-b362-49c6-a7da-94aba4730cf1",
                                "sense_id": "5419df10-9a67-34b8-aa5c-705723661879",
                                "text": "Wieso hinunter? Ich will jetzt erst mal bis zum Gipfelkreuz hinauf!",
                                "translation": "為什麼要下去？我想先上去看看山頂的十字架！"
                            },
                            {
                                "example_id": "4ac1d3de-1dd3-49cb-8be0-e1df812b960e",
                                "sense_id": "5419df10-9a67-34b8-aa5c-705723661879",
                                "text": "Hinunter geht es da im Treppenhaus am Westturm.",
                                "translation": "你可以從西塔旁的樓梯下去。"
                            },
                            {
                                "example_id": "3fa1bb0b-5290-4190-856e-2132db28ad4e",
                                "sense_id": "5419df10-9a67-34b8-aa5c-705723661879",
                                "text": "Willst du hinunter gehen oder soll ich lieber ein Taxi rufen?",
                                "translation": "你想下去，還是我幫你叫計程車？"
                            },
                            {
                                "example_id": "932586d0-cfbf-46e6-89ac-55424c8bac88",
                                "sense_id": "5419df10-9a67-34b8-aa5c-705723661879",
                                "text": "Falls du da hinunterklettern möchtest, solltest du eine Sicherheitsleine anlegen.",
                                "translation": "如果你想從那裡爬下去，你應該繫上安全繩。"
                            }
                        ]
                    }
