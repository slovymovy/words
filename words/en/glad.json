                                "nl": "We zijn <w>blij</w> met de resultaten van de test.",
                                "pl": "Jesteśmy <w>zadowoleni</w> z wyników testu.",
                                "de": "Wir sind <w>erfreut</w> über die Testergebnisse.",
                                "fr": "Nous sommes <w>heureux</w> des résultats du test.",
                                "it": "Siamo <w>contenti</w> dei risultati del test.",
                                "cs": "Máme <w>radost</w> z výsledků toho testu.",
                                "tr": "Testin sonuçlarından <w>memnunuz</w>.",
                                "es": "Estamos <w>contentos</w> con los resultados de la prueba."
                            }
                        }
