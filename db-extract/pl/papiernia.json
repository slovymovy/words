                                            {
                                                "example_id": "48cc9036-51f9-4041-a39c-b0b1b0a82ef1",
                                                "sense_id": "997cafff-c302-3909-95cf-ca68b5d70f6b",
                                                "text": "Během staletí se v držení papírny vystřídala celá řada papírnických rodin a mistrů."
                                            },
                                            {
                                                "example_id": "9b003c52-5985-49e9-9ce0-6915303d67e3",
                                                "sense_id": "997cafff-c302-3909-95cf-ca68b5d70f6b",
