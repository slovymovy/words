{
    "word_family": [
        "picketing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "047eceea-951f-33e5-8af1-a28195c50c17",
                    "sense_definition": "A pointed stake driven into the ground, often used as part of a fence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was surrounded by a white <w>picket</w> fence.",
                            "target_lang_translations": {
                                "cs": "Zahrada byla obehnána bílým <w>plaňkovým</w> plotem."
                            }
                        },
                        {
                            "text": "He drove a wooden <w>picket</w> into the ground to mark the boundary.",
                            "target_lang_translations": {
                                "cs": "Zatloukl do země dřevěný <w>kůl</w>, aby vyznačil hranici."
                            }
                        }
                    ],
                    "synonyms": [
                        "stake",
                        "post"
                    ],
                    "common_phrases": [
                        "picket fence"
                    ],
                    "target_lang_definitions": {
                        "cs": "Špičatý kůl zaražený do země, často používaný jako součást plotu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kůl",
                                "target_lang_sense_clarification": "špičatý dřevěný kolík zaražený do země"
                            },
                            {
                                "target_lang_word": "kolík",
                                "target_lang_sense_clarification": "obecný výraz pro menší dřevěný nebo kovový kolík"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8304aa22-7782-3362-bc6b-9787c696bb92",
                    "sense_definition": "A person or group of people protesting outside a workplace during a strike.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pickets</w> stood outside the factory entrance all morning.",
                            "target_lang_translations": {
                                "cs": "<w>Stávkující</w> stáli celé dopoledne před vchodem do továrny."
                            }
                        },
                        {
                            "text": "Union members formed a <w>picket</w> to prevent workers from entering.",
                            "target_lang_translations": {
                                "cs": "Členové odborů vytvořili <w>hlídku</w>, aby zabránili pracovníkům ve vstupu."
                            }
                        }
                    ],
                    "synonyms": [
                        "protester",
                        "demonstrator"
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba nebo skupina lidí protestující před pracovištěm během stávky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stávkující",
                                "target_lang_sense_clarification": "osoba účastnící se stávky"
                            },
                            {
                                "target_lang_word": "demonstrant",
                                "target_lang_sense_clarification": "osoba účastnící se protestu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfe1536d-2ac9-3619-a18a-e2edf3c5b640",
                    "sense_definition": "A soldier or guard stationed at a forward position to watch for the enemy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "guard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>picket</w> signaled that the enemy was approaching the camp.",
                            "target_lang_translations": {
                                "cs": "<w>Hlídka</w> signalizovala, že se k táboru blíží nepřítel."
                            }
                        },
                        {
                            "text": "They were caught by a <w>picket</w> while trying to sneak past the lines.",
                            "target_lang_translations": {
                                "cs": "Když se pokoušeli proplížit kolem linií, chytila je <w>stráž</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sentry",
                        "guard",
                        "watchman"
                    ],
                    "target_lang_definitions": {
                        "cs": "Voják nebo stráž umístěná na předsunutém stanovišti, aby hlídala nepřítele."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hlídka",
                                "target_lang_sense_clarification": "vojenská stráž nebo pozorovatel"
                            },
                            {
                                "target_lang_word": "stráž",
                                "target_lang_sense_clarification": "osoba střežící určité místo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "208a3449-3a4a-3e5b-90eb-33be5852369b",
                    "sense_definition": "To protest outside a workplace, usually as part of a labor strike.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers decided to <w>picket</w> the company headquarters.",
                            "target_lang_translations": {
                                "cs": "Pracovníci se rozhodli <w>stávkovat</w> před sídlem společnosti."
                            }
                        },
                        {
                            "text": "They have been <w>picketing</w> for better wages for three days.",
                            "target_lang_translations": {
                                "cs": "Již tři dny <w>demonstrují</w> za lepší mzdy."
                            }
                        }
                    ],
                    "synonyms": [
                        "protest",
                        "demonstrate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Protestovat před pracovištěm, obvykle jako součást pracovní stávky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stávkovat",
                                "target_lang_sense_clarification": "účastnit se stávky"
                            },
                            {
                                "target_lang_word": "demonstrovat",
                                "target_lang_sense_clarification": "veřejně vyjadřovat nesouhlas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "195f8a3c-b7d3-3fe0-b90c-58f06ebba218",
                    "sense_definition": "To tie an animal to a stake in the ground.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tether",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer had to <w>picket</w> his horse in the field.",
                            "target_lang_translations": {
                                "cs": "Farmář musel svého koně na poli <w>přivázat ke kolíku</w>."
                            }
                        },
                        {
                            "text": "They <w>picketed</w> the animals near the river for the night.",
                            "target_lang_translations": {
                                "cs": "Na noc zvířata <w>přivázali ke kolíkům</w> u řeky."
                            }
                        }
                    ],
                    "synonyms": [
                        "tether",
                        "tie"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přivázat zvíře ke kolíku v zemi."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přivázat",
                                "target_lang_sense_clarification": "upevnit zvíře ke kolíku"
                            },
                            {
                                "target_lang_word": "kolíkovat",
                                "target_lang_sense_clarification": "připevnit zvíře ke kolíku (méně časté)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}