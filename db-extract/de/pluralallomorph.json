                ],
                "senses": [
                    {
                        "sense_id": "5dd29dc2-0b43-37bd-98f5-320a68d8e9bb",
                        "entry_id": "1e22a243-3abb-3eec-b4ce-00f9afd5e107",
                        "glosses": [
                            "Realisierung/Variante des Pluralmorphems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7cea227-a789-4e71-8017-1d713137d966",
                                "sense_id": "5dd29dc2-0b43-37bd-98f5-320a68d8e9bb",
                                "text": "„Im Deutschen finden wir gegenüber dem Englischen wesentlich mehr Pluralallomorphe.“"
                            },
                            {
                                "example_id": "2a4a31f7-2a0e-4655-87eb-d90aa3da38b2",
                                "sense_id": "5dd29dc2-0b43-37bd-98f5-320a68d8e9bb",
                                "text": "„Untersuchungen zur Häufigkeit der Pluralallomorphe auf der Grundlage eines Morpheminventars hat Gerhard AUGST (1975) vorgelegt.“"
                            },
                            {
                                "example_id": "028c2317-3371-480a-9976-5b0a04aef6e5",
                                "sense_id": "5dd29dc2-0b43-37bd-98f5-320a68d8e9bb",
                                "text": "„Damit eine auswertbare Anzahl an Pluralallomorphen zur Verfügung stand, wurden aus dem Korpus der Kurzgeschichten die längeren Geschichten ausgewählt.“"
                            },
                            {
                                "example_id": "e8b59ca4-3e6d-4223-8c21-9711d4a0096a",
                                "sense_id": "5dd29dc2-0b43-37bd-98f5-320a68d8e9bb",
                                "text": "„Die neun Pluralallomorphe sind: {-e, -en, -er, -n, -s, -0, Umlaut, Umlaut + -e, Umlaut + -er}.“"
                            },
                            {
                                "example_id": "b8caabc9-943e-4f23-8722-69769d3e14ef",
                                "sense_id": "5dd29dc2-0b43-37bd-98f5-320a68d8e9bb",
                                "text": "„Bei den weitaus meisten Substantiven, die auf Vokal enden wie ‚Video‘, wird nur -s als mögliches Pluralallomorph zugelassen; der Auslaut des Wortes bestimmt also die Wahl des Allomorphs.“"
                            },
                            {
                                "example_id": "e9ed976d-e6da-4054-8d19-88a265b8c70f",
                                "sense_id": "5dd29dc2-0b43-37bd-98f5-320a68d8e9bb",
                                "text": "„In §2.3 wurde beispielsweise gezeigt, daß die Regeln für Epenthese und Assimilation genau in dieser Reihenfolge angewendet werden müssen, um die Distribution der drei regulären Pluralallomorphe des Englischen [s], [z] und [ɪz] zu erfassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
