{
    "word_family": [
        "significance",
        "significantly",
        "signify",
        "signification"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a2456383-cd43-3e08-91dc-6f966976c24c",
                    "sense_definition": "Having a noticeable or major effect; sufficiently great or important to be worthy of attention.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy had a <w>significant</w> impact on the local economy.",
                            "target_lang_translations": {
                                "ru": "Новая политика оказала <w>значительное</w> влияние на местную экономику.",
                                "tr": "Yeni politikanın yerel ekonomi üzerinde <w>önemli</w> bir etkisi oldu."
                            }
                        },
                        {
                            "text": "Winning the competition was a <w>significant</w> achievement for the young athlete.",
                            "target_lang_translations": {
                                "ru": "Победа в соревновании стала <w>важным</w> достижением для молодого спортсмена.",
                                "tr": "Yarışmayı kazanmak genç atlet için <w>büyük</w> bir başarıydı."
                            }
                        }
                    ],
                    "synonyms": [
                        "important",
                        "notable",
                        "major",
                        "considerable"
                    ],
                    "antonyms": [
                        "insignificant",
                        "negligible",
                        "slight",
                        "ignorable"
                    ],
                    "common_phrases": [
                        "significant role",
                        "significant impact",
                        "significant change",
                        "significant difference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий заметный эффект или влияние; достаточно важный, чтобы заслуживать внимания.",
                        "tr": "Fark edilir veya büyük bir etkiye sahip; dikkat çekmeye değer derecede önemli."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "значи́тельный",
                                "target_lang_sense_clarification": "имеющий вес, влияние или большие размеры"
                            },
                            {
                                "target_lang_word": "суще́ственный",
                                "target_lang_sense_clarification": "важный, весомый, основной"
                            },
                            {
                                "target_lang_word": "ва́жный",
                                "target_lang_sense_clarification": "имеющий большое значение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "öğemli",
                                "target_lang_sense_clarification": "büyük bir etkisi veya değeri olan"
                            },
                            {
                                "target_lang_word": "kayda değer",
                                "target_lang_sense_clarification": "dikkate değer, göze çarpan"
                            },
                            {
                                "target_lang_word": "mühim",
                                "target_lang_sense_clarification": "önem taşıyan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f6b8afd-20b7-3342-a1a9-c72d63c7becc",
                    "sense_definition": "Reasonably large in number or amount.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent a <w>significant</w> amount of money on her new car.",
                            "target_lang_translations": {
                                "ru": "Она потратила <w>значительную</w> сумму денег на свою новую машину.",
                                "tr": "Yeni arabasına <w>önemli</w> miktarda para harcadı."
                            }
                        },
                        {
                            "text": "A <w>significant</w> number of students passed the exam with distinction.",
                            "target_lang_translations": {
                                "ru": "<w>Значительное</w> число студентов сдали экзамен с отличием.",
                                "tr": "<w>Kayda değer</w> sayıda öğrenci sınavı üstün başarıyla geçti."
                            }
                        }
                    ],
                    "synonyms": [
                        "notable"
                    ],
                    "antonyms": [
                        "negligible",
                        "slight"
                    ],
                    "common_phrases": [
                        "significant amount",
                        "significant number",
                        "significant portion",
                        "significant increase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достаточно большой по количеству или объему.",
                        "tr": "Miktar veya sayıca oldukça büyük, azımsanmayacak derecede."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "значи́тельный",
                                "target_lang_sense_clarification": "большой по размеру или количеству"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "önemli",
                                "target_lang_sense_clarification": "miktar veya sayı olarak büyük"
                            },
                            {
                                "target_lang_word": "kayda değer",
                                "target_lang_sense_clarification": "azımsanmayacak miktarda"
                            },
                            {
                                "target_lang_word": "ciddi",
                                "target_lang_sense_clarification": "yüksek miktarda"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08126418-b227-365d-875e-4318d4839cc7",
                    "sense_definition": "Suggesting a meaning that is not explicitly stated; carrying a special or hidden meaning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave her a <w>significant</w> look that made her stop talking immediately.",
                            "target_lang_translations": {
                                "ru": "Он бросил на нее <w>многозначительный</w> взгляд, который заставил ее немедленно замолчать.",
                                "tr": "Ona, konuşmasını hemen kesmesine neden olan <w>anlamlı</w> bir bakış attı."
                            }
                        },
                        {
                            "text": "The silence in the room felt heavy and <w>significant</w>.",
                            "target_lang_translations": {
                                "ru": "Тишина в комнате казалась тяжелой и <w>многозначительной</w>.",
                                "tr": "Odadaki sessizlik ağır ve <w>manidar</w> hissettiriyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "meaningful",
                        "pregnant"
                    ],
                    "common_phrases": [
                        "significant look",
                        "significant glance",
                        "significant silence",
                        "significant gesture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий скрытый смысл или намек; выразительный.",
                        "tr": "Açıkça ifade edilmeyen, özel veya gizli bir anlam taşıyan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многозначи́тельный",
                                "target_lang_sense_clarification": "выражающий скрытый смысл"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "anlamlı",
                                "target_lang_sense_clarification": "gizli bir anlam taşıyan veya üstü kapalı"
                            },
                            {
                                "target_lang_word": "manalı",
                                "target_lang_sense_clarification": "derin veya özel bir anlamı olan"
                            },
                            {
                                "target_lang_word": "manidar",
                                "target_lang_sense_clarification": "düşündürücü ve imalı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c0bcc7e-05b9-3d56-aaca-b94638edf67f",
                    "sense_definition": "Having a low probability of occurring by chance, indicating a systematic relationship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "statistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study found a statistically <w>significant</w> correlation between diet and health.",
                            "target_lang_translations": {
                                "ru": "Исследование выявило статистически <w>значимую</w> корреляцию между диетой и здоровьем.",
                                "tr": "Araştırma, beslenme ve sağlık arasında istatistiksel olarak <w>anlamlı</w> bir ilişki buldu."
                            }
                        },
                        {
                            "text": "These results are not <w>significant</w> enough to prove the theory.",
                            "target_lang_translations": {
                                "ru": "Эти результаты недостаточно <w>значимы</w>, чтобы доказать теорию.",
                                "tr": "Bu sonuçlar teoriyi kanıtlamak için yeterince <w>anlamlı</w> değil."
                            }
                        }
                    ],
                    "common_phrases": [
                        "statistically significant",
                        "significant correlation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маловероятный как случайное событие; указывающий на закономерность (в статистике).",
                        "tr": "İstatistikte, bir ilişkinin tesadüfen ortaya çıkma olasılığının düşük olduğunu gösteren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зна́чимый",
                                "target_lang_sense_clarification": "статистически достоверный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "anlamlı",
                                "target_lang_sense_clarification": "istatistiksel olarak rastlantısal olmayan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d7862eb-091b-365c-ab3c-58a2525e8364",
                    "sense_definition": "Relating to the digits of a number that contribute to its precision.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should round the answer to three <w>significant</w> figures.",
                            "target_lang_translations": {
                                "ru": "Вам следует округлить ответ до трех <w>значащих</w> цифр.",
                                "tr": "Cevabı üç <w>anlamlı</w> basamağa yuvarlamalısınız."
                            }
                        },
                        {
                            "text": "Zeros at the end of the number are not always <w>significant</w>.",
                            "target_lang_translations": {
                                "ru": "Нули в конце числа не всегда являются <w>значащими</w>.",
                                "tr": "Sayının sonundaki sıfırlar her zaman <w>anlamlı</w> değildir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "significant figure",
                        "significant digit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к цифрам числа, которые влияют на его точность (в математике).",
                        "tr": "Bir sayının hassasiyetine katkıda bulunan basamaklarla ilgili."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зна́чащий",
                                "target_lang_sense_clarification": "влияющий на точность числа"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "anlamlı",
                                "target_lang_sense_clarification": "bir sayının hassasiyetini belirten (anlamlı basamak)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a3d42bc-6668-3522-b390-0d09504815a8",
                    "sense_definition": "Something that serves as a sign, symbol, or token.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient carvings were <w>significants</w> of a forgotten religion.",
                            "target_lang_translations": {
                                "ru": "Древняя резьба была <w>знаками</w> забытой религии.",
                                "tr": "Eski oymalar, unutulmuş bir dinin <w>sembolleriydi</w>."
                            }
                        },
                        {
                            "text": "In the play, gestures act as <w>significants</w> of the characters' inner thoughts.",
                            "target_lang_translations": {
                                "ru": "В пьесе жесты выступают как <w>символы</w> внутренних мыслей персонажей.",
                                "tr": "Oyunda jestler, karakterlerin iç düşüncelerinin <w>işaretleri</w> olarak işlev görür."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что служит знаком или символом (устар.).",
                        "tr": "Bir işaret, sembol veya simge işlevi gören şey (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знак",
                                "target_lang_sense_clarification": "символ или указание"
                            },
                            {
                                "target_lang_word": "си́мвол",
                                "target_lang_sense_clarification": "условное обозначение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sembol",
                                "target_lang_sense_clarification": "bir şeyi temsil eden simge"
                            },
                            {
                                "target_lang_word": "işaret",
                                "target_lang_sense_clarification": "gösterge veya simge"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}