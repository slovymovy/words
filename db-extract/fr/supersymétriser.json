                "senses": [
                    {
                        "sense_id": "5bc808fd-bee8-3d73-b94c-d4a0f1834f8c",
                        "entry_id": "12d35346-e4a9-3e78-a8b8-151dd874b836",
                        "glosses": [
                            "Rendre supersymétrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bee821c-69ac-4553-9a49-f770acdca9f1",
                                "sense_id": "5bc808fd-bee8-3d73-b94c-d4a0f1834f8c",
                                "text": "Pour vérifier son intuition, il calcule que, parmi toutes les naines blanches qui dorment par milliards dans les galaxies, il suffit qu’une seule transmute en son cœur le faux vide en vrai vide, qu’une seule supersymétrise son cœur, pour rendre compte du taux mesuré de sursaut gamma."
                            },
                            {
                                "example_id": "0155e7ec-b473-4402-8c9a-9727541d3551",
                                "sense_id": "5bc808fd-bee8-3d73-b94c-d4a0f1834f8c",
                                "text": "Le modèle supersymétrique le plus simple et le plus étudié, dit Modèle Standard Supersymétrique Minimal (MSSM), introduit le moins de nouveaux champs possibles afin de supersymétriser le lagrangien du MS."
                            }
                        ]
                    }
