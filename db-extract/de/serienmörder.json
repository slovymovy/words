                "senses": [
                    {
                        "sense_id": "5660d695-c28b-332b-854a-907e96e73e3b",
                        "entry_id": "786dfbb1-17f9-301b-ae6e-8fbcdb70a78a",
                        "glosses": [
                            "Mörder, der mehrere ähnliche Morde in einer Serie begeht oder begangen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "370e1d6a-9024-4f79-bc04-78f2374fb972",
                                "sense_id": "5660d695-c28b-332b-854a-907e96e73e3b",
                                "text": "„Für die Begriffe ‚Serienmord‘ und ‚Serienmörder‘ gibt es verschiedene Definitionen, aber im deutschsprachigen Raum keine Legaldefinition.“"
                            },
                            {
                                "example_id": "59178288-1def-4621-99e2-3689896e6573",
                                "sense_id": "5660d695-c28b-332b-854a-907e96e73e3b",
                                "text": "„Vor rund einem Jahr hat sich das hessische Landeskriminalamt mit einem spektakulären Verdacht an die Öffentlichkeit gewandt: Der Rentner Manfred S. aus Schwalbach am Taunus könnte ein Serienmörder gewesen sein.“"
                            },
                            {
                                "example_id": "227c878a-3385-45c4-bf71-321ec17713ed",
                                "sense_id": "5660d695-c28b-332b-854a-907e96e73e3b",
                                "text": "„Einer meiner Lieblingsmomente in Filmen war seit jeher gewesen, wenn zum ersten Mal das Zuhause eines schizophrenen Professors oder eines irren Serienmörders gezeigt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
