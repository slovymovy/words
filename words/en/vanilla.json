            "senses": [
                {
                    "sense_id": "46e1c015-282a-3d19-aa77-05244400d29d",
                    "sense_definition": "Relating to or having the flavor or scent of vanilla.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "flavor_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like a large <w>vanilla</w> milkshake, please.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел большой <w>ванильный</w> молочный коктейль, пожалуйста.",
                                "zh": "请给我来一杯大杯<w>香草</w>奶昔。"
                            }
                        },
                        {
                            "text": "The candle has a pleasant <w>vanilla</w> scent.",
                            "target_lang_translations": {
                                "ru": "У свечи приятный <w>ванильный</w> аромат.",
                                "zh": "这支蜡烛有一种宜人的<w>香草</w>香气。"
                            }
