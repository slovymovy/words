                        ],
                        "form": "dem Proletariat"
                    },
                    {
                        "form_id": "0c5700e4-c9ed-4378-83f5-53771c96d490",
                        "entry_id": "b4ff3479-ece0-32f5-9fa5-17cacfcafc7f",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Proletariat"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de7348bd-c13f-3792-922e-2b3a62150db7",
                        "entry_id": "b4ff3479-ece0-32f5-9fa5-17cacfcafc7f",
                        "glosses": [
                            "gesellschaftliche Schicht der Land- und Besitzlosen, die aber keine Sklaven waren"
                        ],
                        "tags": [
                            "Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "7a29733d-9453-4790-9999-c009d99c8607",
                                "sense_id": "de7348bd-c13f-3792-922e-2b3a62150db7",
                                "text": "„Augustus hat die Gefahr des Proletariates in Rom erkannt, das auf Dauer dem Princeps in Rom gefährlich werden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "47851519-b68e-36b4-9763-18fa9e7668e6",
                        "entry_id": "b4ff3479-ece0-32f5-9fa5-17cacfcafc7f",
                        "glosses": [
                            "gesellschaftliche Schicht ehemaliger Bauern oder Handwerker, die in die Städte zogen, um dort in der Industrie zu arbeiten"
                        ],
                        "tags": [
                            "Industrielle Revolution"
                        ],
                        "examples": [
                            {
                                "example_id": "79dfe95f-4e21-42a0-aa2b-d52734246f08",
                                "sense_id": "47851519-b68e-36b4-9763-18fa9e7668e6",
                                "text": "Gibt es noch ein Proletariat?"
                            },
                            {
                                "example_id": "6eb4c1e0-056c-4772-8e25-03e0034793be",
                                "sense_id": "47851519-b68e-36b4-9763-18fa9e7668e6",
                                "text": "„An einem Sonntagnachmittag, wenn die Läden geschlossen sind und das Proletariat mit einer Art von starrem Stumpfsinn die Straße beherrscht, gibt es gewisse Verkehrsadern, die einen an nichts Geringeres gemahnen als an einen großen, der Länge nach aufgeschnittenen, von Schanker behafteten Pint.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5a3b028a-3302-3c11-b53e-331ed7f9d4e5",
                        "entry_id": "b4ff3479-ece0-32f5-9fa5-17cacfcafc7f",
                        "glosses": [
                            "die Klasse der Lohnarbeiter"
                        ],
                        "tags": [
                            "Marxismus"
                        ],
                        "examples": [
                            {
                                "example_id": "c9d7205a-0484-4b20-97da-fb884b073130",
                                "sense_id": "5a3b028a-3302-3c11-b53e-331ed7f9d4e5",
                                "text": "„Er [der Freihandel] zersetze die früheren Nationalitäten und treibe den Gegensatz zwischen Bourgeoisie und Proletariat auf die Spitze.“"
                            },
                            {
                                "example_id": "bc8b025b-dc93-4ff2-aa27-229822b01cf5",
                                "sense_id": "5a3b028a-3302-3c11-b53e-331ed7f9d4e5",
                                "text": "„In seinem Bestseller „Rückkehr nach Reims“ beschreibt Eribon am Beispiel seiner eigenen Familie die Entfremdung des Proletariats von der politischen Linken und ihre Hinwendung zur extremen Rechten. Eine Entwicklung, die in allen Industrieländern zu beobachten ist.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50540f78-67b2-405b-b7be-427f1f482eb5",
                        "source_entry_id": "b4ff3479-ece0-32f5-9fa5-17cacfcafc7f",
                        "source_sense_id": "de7348bd-c13f-3792-922e-2b3a62150db7",
                        "source_sense_description": "Antike: gesellschaftliche Schicht der Land- und Besitzlosen, die aber keine Sklaven waren",
                        "target_lang_word": "proletariat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proletariat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "262a0114-409a-304c-a26b-5b4688231a7f",
                                        "entry_id": "eb6dc2f8-7ed2-32f0-ad4f-5d4210bea8f5",
                                        "glosses": [
                                            "The lowest class of society; also, the lower classes of society generally; the masses."
                                        ],
                                        "tags": [
                                            "also",
                                            "derogatory",
                                            "figuratively",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4942ce4a-1de1-36a1-95fb-f7f1a9436c48",
                                        "entry_id": "eb6dc2f8-7ed2-32f0-ad4f-5d4210bea8f5",
                                        "glosses": [
                                            "Wage earners collectively; people who own no capital and depend on their labour for survival; the working class, especially when seen as engaged in a class struggle with the bourgeoisie (“the capital-owning class”)."
                                        ],
                                        "tags": [
                                            "Marxism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d11ebe3-57e1-4bd0-bcd5-faf98d02bd24",
                                                "sense_id": "4942ce4a-1de1-36a1-95fb-f7f1a9436c48",
                                                "text": "Of all the classes that stand face to face with the bourgeoisie to-day, the proletariat alone is a really revolutionary class. The other classes decay and finally disappear in the face of modern industry; the proletariat is its special and essential product."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e67373-207f-3e68-86a7-2b42281b6f36",
                                        "entry_id": "eb6dc2f8-7ed2-32f0-ad4f-5d4210bea8f5",
                                        "glosses": [
                                            "The lowest class of citizens, who had no property and few rights, and were regarded as contributing only their offspring to the state."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b548539-29cd-48d5-ad13-edb7bd7155df",
                        "source_entry_id": "b4ff3479-ece0-32f5-9fa5-17cacfcafc7f",
                        "source_sense_id": "de7348bd-c13f-3792-922e-2b3a62150db7",
                        "source_sense_description": "Antike: gesellschaftliche Schicht der Land- und Besitzlosen, die aber keine Sklaven waren",
                        "target_lang_word": "prolétariat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prolétariat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e7029a9-8719-3a88-8ffd-648fed453ddf",
                                        "entry_id": "7b18126e-a954-3c51-a84d-0f3aec199f41",
                                        "glosses": [
                                            "Classe des travailleur libre qui, dépourvus d’accès aux moyens de production, n’ont à vendre que leur force de travail contre un salaire."
                                        ],
                                        "tags": [
                                            "Marxism",
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "821af2cd-afee-4bf5-9b2d-d7d81621ca03",
                                                "sense_id": "9e7029a9-8719-3a88-8ffd-648fed453ddf",
                                                "text": "Cette domestication des conduites sexuelles me parait essentielle en ce qu’elle accompagne et même, semble-t-il, précède l’atténuation de la violence diffuse au sein du prolétariat, processus qui recouvre, on le sait, tout le XIXᵉ siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba586476-5eba-3b7e-abb7-77019a54cdfb",
                                        "entry_id": "7b18126e-a954-3c51-a84d-0f3aec199f41",
                                        "glosses": [
                                            "Classe ouvrière d’un pays, d’une ville ou d’un secteur à une époque donnée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950758be-0401-4b24-9f8c-3d44b8f766d0",
                                                "sense_id": "ba586476-5eba-3b7e-abb7-77019a54cdfb",
                                                "text": "Aucun autre prolétariat n’est aussi riche en souvenirs historiques, car aucun n’a eu une destinée aussi dramatique que le prolétariat français."
                                            },
                                            {
                                                "example_id": "5bcecf73-6d4d-47c3-8231-d87b7f229b8b",
                                                "sense_id": "ba586476-5eba-3b7e-abb7-77019a54cdfb",
                                                "text": "Le militant faisait connaissance avec le prolétariat ardennais de la première industrialisation, prompt et quelque peu libertaire, qui put le gêner dans la discussion […]"
                                            },
                                            {
                                                "example_id": "fa09d087-2805-4bac-8af2-70a7fdeeabc6",
                                                "sense_id": "ba586476-5eba-3b7e-abb7-77019a54cdfb",
                                                "text": "Le prolétariat de Thiers, très fermé, vivant en quelque sorte en vase clos, constitue d’ailleurs un monde d’exception doué corporativement, croirait-on, de certaines dextérités manuelles transmises par ses ancêtres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
