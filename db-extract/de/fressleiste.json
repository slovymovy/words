                "senses": [
                    {
                        "sense_id": "7bc8a73e-2f88-3b9b-9db0-a43694298883",
                        "entry_id": "19388671-6841-3857-bf08-3c3a692cfc0f",
                        "glosses": [
                            "Mund, auch Zähne, Kauwerkzeug"
                        ],
                        "tags": [
                            "Jugendsprache"
                        ],
                        "examples": [
                            {
                                "example_id": "ff9ff31f-65ca-4aae-b29a-7c06b787f08f",
                                "sense_id": "7bc8a73e-2f88-3b9b-9db0-a43694298883",
                                "text": "„Ich rate zur Vorsicht: Wenn Sie die Luke herunterklappen, kommt Ihnen 'ne Ausziehleiter entgegen, und das genau auf Höhe Ihrer Fressleiste.“"
                            },
                            {
                                "example_id": "11e719c9-f68c-4869-9686-6debaf9e2952",
                                "sense_id": "7bc8a73e-2f88-3b9b-9db0-a43694298883",
                                "text": "„Ich hab dir jetzt die ganze Fressleiste poliert, du kaust schon auf den Felgen, wo soll ich denn noch hinhauen, du Idiot.“"
                            },
                            {
                                "example_id": "e26a25ac-8990-418c-b7d2-2cd3073a9c9e",
                                "sense_id": "7bc8a73e-2f88-3b9b-9db0-a43694298883",
                                "text": "„Ich stellte mir vor, wie ich ihm seinen Hut breit lächelns in seine überheblich grinsende Fressleiste deuen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
