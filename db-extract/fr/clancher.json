                "senses": [
                    {
                        "sense_id": "6f507f3c-268a-32df-ba66-a11610502254",
                        "entry_id": "9ef6194f-95da-3df5-89de-2fa5b4c18ffe",
                        "glosses": [
                            "Actionner la clanche."
                        ],
                        "tags": [
                            "Lorraine",
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "124492e4-ff86-4d69-9ee4-b43412abe151",
                                "sense_id": "6f507f3c-268a-32df-ba66-a11610502254",
                                "text": "L’homme a été interpellé le soir même, vers 20 h 30, au centre-ville de Verdun. Et a été placé en garde à vue. Après la perquisition dans son appartement, celui-ci a expliqué qu’il commettait régulièrement des vols dans des voitures : « Je clanchais les portières. Et prenais ce que je trouvais. »"
                            },
                            {
                                "example_id": "80ae754d-5394-42d3-b091-a5359478c556",
                                "sense_id": "6f507f3c-268a-32df-ba66-a11610502254",
                                "text": "J’ai voulu clancher en dehors ; j’ai senti de la résistance, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e4b6da72-1149-3005-8744-9efb91a9532f",
                        "entry_id": "9ef6194f-95da-3df5-89de-2fa5b4c18ffe",
                        "glosses": [
                            "Fermer la porte."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "579a91e8-7603-4de9-b8f3-d702c02550d9",
                                "sense_id": "e4b6da72-1149-3005-8744-9efb91a9532f",
                                "text": "Une institutrice nous a demandé un jour s’il fallait écrire « clencher la porte » (ou clancher) parce qu’un écriteau mis par son propriétaire invitait chacun à « clancher la porte en sortant »."
                            },
                            {
                                "example_id": "70957a57-cb57-48b1-8463-82b3401b15ea",
                                "sense_id": "e4b6da72-1149-3005-8744-9efb91a9532f",
                                "text": "Il enseigne essentiellement à l’ensorcelé comment se protéger du contact en se clôturant soigneusement : non seulement « tout clancher », mais aussi se taire, ne pas serrer les mains, etc."
                            },
                            {
                                "example_id": "34b36d1b-ba92-4498-bac6-027722ca5e2f",
                                "sense_id": "e4b6da72-1149-3005-8744-9efb91a9532f",
                                "text": "« Clancher » (fermer) devient alors le maître-mot, le fil conducteur de l’action ; « clancher » les portes, les fenêtres, les seuils de bâtiments et les entrées de champs […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbe33a0c-1ae8-32df-9b92-082d6d74a317",
                        "entry_id": "9ef6194f-95da-3df5-89de-2fa5b4c18ffe",
                        "glosses": [
                            "Fermer à clé."
                        ],
                        "tags": [
                            "Bretagne",
                            "Ille-et-Vilaine"
                        ],
                        "examples": [
                            {
                                "example_id": "2108aa4e-8a2e-47c0-ab30-8c56bed38131",
                                "sense_id": "fbe33a0c-1ae8-32df-9b92-082d6d74a317",
                                "text": "Vous me clancheriez au fin fond de la tour de Mélusine (et elle montra une des tours du château), que les Chuins sauraient ben m’y venir tuer !"
                            }
                        ]
                    },
                    {
                        "sense_id": "af143646-ca1e-3fea-96e5-b3e47b074298",
                        "entry_id": "9ef6194f-95da-3df5-89de-2fa5b4c18ffe",
                        "glosses": [
                            "Fermer la porte violemment, en faisant du bruit."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e66de6ae-7284-3d4a-bebd-8643f26ee22d",
                        "entry_id": "9ef6194f-95da-3df5-89de-2fa5b4c18ffe",
                        "glosses": [
                            "Accélérer, partir rapidement, dépasser, s’en aller."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "04aabb6d-a92d-46f7-b03e-edccb6f5c575",
                                "sense_id": "e66de6ae-7284-3d4a-bebd-8643f26ee22d",
                                "text": "On les a clanché sur l’autoroute."
                            },
                            {
                                "example_id": "301263a1-94c3-4d29-869c-659cc7a1e4c4",
                                "sense_id": "e66de6ae-7284-3d4a-bebd-8643f26ee22d",
                                "text": "Il a clanché aussitôt qu’il est arrivé."
                            }
                        ]
                    },
                    {
                        "sense_id": "b626881b-5e4b-3de4-87f8-7d6d6f320b72",
                        "entry_id": "9ef6194f-95da-3df5-89de-2fa5b4c18ffe",
                        "glosses": [
                            "Commencer, démarrer avec l'intention de parvenir promptement à la fin ou l'objectif."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a069a0e1-4cef-4502-a9fb-f43b81ff4fd1",
                                "sense_id": "b626881b-5e4b-3de4-87f8-7d6d6f320b72",
                                "text": "Je vais clancher un film."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c45544c-ef0d-34c9-a4c6-1000255662cd",
                        "entry_id": "9ef6194f-95da-3df5-89de-2fa5b4c18ffe",
                        "glosses": [
                            "Abuser, boire/fumer excessivement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f2646508-23ae-432e-ad06-d11835d4f62d",
                                "sense_id": "6c45544c-ef0d-34c9-a4c6-1000255662cd",
                                "text": "Sarah se clanche à tous les soirs."
                            }
                        ]
                    }
