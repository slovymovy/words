                                "target_senses": [
                                    {
                                        "sense_id": "f760a65e-6edc-36b9-84f5-0fe530e14b86",
                                        "entry_id": "291d96bb-3d75-3ddd-9920-f69710075883",
                                        "glosses": [
                                            "Small, rural, and unimportant."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "433cfbb5-73b5-424b-bb9a-2beefb148355",
                                                "sense_id": "f760a65e-6edc-36b9-84f5-0fe530e14b86",
                                                "text": "\"'A Super Bowl win can legitimize us as a town. We're not some small podunk town anymore,'\" said Spencer Venable of Indianapolis."
                                            },
                                            {
                                                "example_id": "7ee52a01-d344-40e2-b0d1-e31168b30641",
                                                "sense_id": "f760a65e-6edc-36b9-84f5-0fe530e14b86",
                                                "text": "Yes the beautiful time every year when this little podunk town [of Pendleton, Oregon] swells to four or five times her size with Round-Up feverish Cowboy types who chew, spit and chase four-legged critters around a screaming arena….check that….That’s normal…"
