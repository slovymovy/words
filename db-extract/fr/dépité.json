                "senses": [
                    {
                        "sense_id": "5327d1c4-fd93-3bd6-a535-e9daaad57f37",
                        "entry_id": "8dd15ceb-5229-3409-a514-2d9bfa99cbb3",
                        "glosses": [
                            "Qui éprouve du dépit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c1967e6-54f6-4760-9aac-38b3a2aa39c7",
                                "sense_id": "5327d1c4-fd93-3bd6-a535-e9daaad57f37",
                                "text": "Mais à l’offre des vœux d’un amant dépité, Trouvez-vous, je vous prie, entière sûreté ?"
                            },
                            {
                                "example_id": "43d7715c-7a1d-4be7-a5bb-7ba2016ae840",
                                "sense_id": "5327d1c4-fd93-3bd6-a535-e9daaad57f37",
                                "text": "Dépité, exaspéré et furieux, Trump est un danger clair et immédiat pour la sécurité nationale des États-Unis. Il le sera encore plus après le 20 janvier 2021."
                            },
                            {
                                "example_id": "99037b48-ad92-4120-ab27-da74aea98184",
                                "sense_id": "5327d1c4-fd93-3bd6-a535-e9daaad57f37",
                                "text": "Je l’ai eu après, il était dépité."
                            }
                        ]
                    }
