                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e88ed6-4052-45fd-bad1-6a44782b190d",
                                "sense_id": "068d84d8-77f4-3fab-824d-7b11e0331d07",
                                "text": "„Hinter den beiden hatten Außenminister Lindsay, Botschafter Priest, mehrere US-Senatoren und Kongressmitglieder Platz genommen.“"
                            },
                            {
                                "example_id": "cb945104-be94-454e-9db0-1368c05bf5ea",
                                "sense_id": "068d84d8-77f4-3fab-824d-7b11e0331d07",
                                "text": "„Kaz sauste ja nicht mit einer Bande von Attentätern durch die USA und brachte US-Senatoren um.“"
                            },
                            {
                                "example_id": "64160eb7-183c-43a8-908a-6fd042b43998",
                                "sense_id": "068d84d8-77f4-3fab-824d-7b11e0331d07",
                                "text": "„Mal erinnerte sich an Loftis aufgrund der Western, die er mit Stefan gesehen hatte: ein großer, schlanker, silberhaariger Mann, der wie die Idealvorstellung von einem US-Senator wirkte.“"
                            }
                        ],
