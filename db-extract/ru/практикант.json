                                    {
                                        "sense_id": "baff1d51-220d-36c8-8c58-666ef2583875",
                                        "entry_id": "e946d41a-6682-36fd-af62-ce18a2f7390f",
                                        "glosses": [
                                            "Person, die ein – in der Regel berufsvorbereitendes – Praktikum absolviert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c8a0c7e-d628-43bc-9911-75c9341a8503",
                                                "sense_id": "baff1d51-220d-36c8-8c58-666ef2583875",
                                                "text": "„Offenbar kann jedermann einfach in ein x-beliebiges Krankenhaus hineinlaufen und seine Arbeitskraft als Praktikant anbieten, gratis, versteht sich.“"
                                            },
                                            {
                                                "example_id": "712b4264-6103-4f6d-8d25-38e86faa257a",
                                                "sense_id": "baff1d51-220d-36c8-8c58-666ef2583875",
                                                "text": "„Diese gemeine Frage haben sich die genervten Praktikanten ausgedacht, die zum Abnehmen der Prüfung auf die armen Fremden angesetzt worden waren.“"
                                            }
