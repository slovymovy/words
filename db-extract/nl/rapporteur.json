                "senses": [
                    {
                        "sense_id": "50bd2b7f-ae67-3f23-87c1-40e018823290",
                        "entry_id": "8dc94ae7-4dba-3d21-8c43-259bef44508c",
                        "glosses": [
                            "iemand die volgens opdracht of krachtens functie een rapport, verslag (van een voorval) uitbrengt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85bf9035-434a-4429-869f-4f25d0432941",
                                "sense_id": "50bd2b7f-ae67-3f23-87c1-40e018823290",
                                "text": "De rapporteur sprak maandag zijn woede uit over de executie van vier mensen, die direct betrokken waren bij de protesten."
                            },
                            {
                                "example_id": "f28712ee-63ef-4bf4-92c3-ef6eb7c5cd2d",
                                "sense_id": "50bd2b7f-ae67-3f23-87c1-40e018823290",
                                "text": "⧖ want al wat sy hem gaf, droegh hy in stilte aen d'arme menschen uyt den naem vande milde, en goethertige Coninginne: niet-te-min den Coninck dat vals rapport gehoort hebbende, heeft den valschen rapporteur geloof ghegeven"
                            }
                        ]
                    },
                    {
                        "sense_id": "28a0acfe-7e59-31dd-941e-806c0a12bbe9",
                        "entry_id": "8dc94ae7-4dba-3d21-8c43-259bef44508c",
                        "glosses": [
                            "gradenboog, hoekmeter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d231fc74-7cbd-43f4-99fd-240a8627457e",
                                "sense_id": "28a0acfe-7e59-31dd-941e-806c0a12bbe9",
                                "text": "⧖ Meet den hoek geteikent op het Bestek met een Rapporteur, plaatzende zyn middelpunt op het stippunt a. en zyn onderste ter lengte van de linie a"
                            }
                        ]
                    }
