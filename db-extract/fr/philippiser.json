                ],
                "senses": [
                    {
                        "sense_id": "10d0fd40-195d-37ef-ba59-96f6fc821184",
                        "entry_id": "df6716a3-e2d7-3481-8e7c-273e2473f7e3",
                        "glosses": [
                            "Suivre les opinions de Philippe (de Macédoine)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6edd4982-7a08-42a7-a875-b3071439ca97",
                                "sense_id": "10d0fd40-195d-37ef-ba59-96f6fc821184",
                                "text": "Agésilas et Ëpaminondas ne cachent pas leur mépris pour ses réponses ambiguës. Démosthènes lui reproche ironiquement de philippiser."
                            },
                            {
                                "example_id": "56a8038c-56bb-48dd-bf64-f8510b370e00",
                                "sense_id": "10d0fd40-195d-37ef-ba59-96f6fc821184",
                                "text": "Puis, quand Philippe de Macédoine se sera octroyé le contrôle de l'amphictyonie en 346, il sera clair pour tous que la Pythie ne fera plus que « philippiser »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "242fd327-b44c-4dcd-a9f4-1d6359eaf5e0",
                        "source_entry_id": "df6716a3-e2d7-3481-8e7c-273e2473f7e3",
                        "source_sense_id": "10d0fd40-195d-37ef-ba59-96f6fc821184",
                        "source_sense_description": "Suivre les opinions de Philippe",
                        "target_lang_word": "philippize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "philippize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a06abe9e-6729-3008-8a63-3d9b42429544",
                                        "entry_id": "ee5a1692-3829-3441-9797-8c035a3a0f43",
                                        "glosses": [
                                            "To support or advocate the cause of Philip of Macedon; (more generally) to speak as someone who has been wrongly inspired or corrupted."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a02833c1-77fd-4988-ae4c-ff5ac1c91bd6",
                                                "sense_id": "a06abe9e-6729-3008-8a63-3d9b42429544",
                                                "text": "I know they set him up as a sort of oracle; because, with the best intentions in the world, he naturally philippizes, and chaunts his prophetic song in exact unison with their designs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "philippize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c64647ef-fb39-36ad-b3bd-9700b57b1145",
                                        "entry_id": "4b8cbe5c-8890-3c75-9cd1-61faac07dbe2",
                                        "glosses": [
                                            "To write or speak in the style of a philippic; to rant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3333d490-f379-4327-8cc4-d04e4a93bee1",
                                                "sense_id": "c64647ef-fb39-36ad-b3bd-9700b57b1145",
                                                "text": "I feel tempted, just here, to philippize the press. It needs castigation, but this will never prove effective, because a portion of the evil lies in the popular appetite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
