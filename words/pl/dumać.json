{
    "word_family": [
        "zaduma",
        "zadumany",
        "zadumać",
        "dumanie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d88ea7c-ca03-3839-99b6-c307bc227e0e",
                    "sense_definition": "głęboko myśleć o czymś, rozważać coś w skupieniu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "myślenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Często <w>duma</w> nad sensem życia, patrząc w okno.",
                            "target_lang_translations": {
                                "ru": "Он часто <w>размышляет</w> о смысле жизни, глядя в окно."
                            }
                        },
                        {
                            "text": "Nie <w>dumaj</w> tyle, tylko zacznij działać.",
                            "target_lang_translations": {
                                "ru": "Не <w>размышляй</w> так много, а просто начни действовать."
                            }
                        }
                    ],
                    "synonyms": [
                        "myśleć",
                        "rozmyślać",
                        "medytować"
                    ],
                    "common_phrases": [
                        "dumać nad czymś"
                    ],
                    "target_lang_definitions": {
                        "ru": "глубоко размышлять о чем-либо, погружаться в мысли"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размышлять",
                                "target_lang_sense_clarification": "всесторонне обдумывать что-либо"
                            },
                            {
                                "target_lang_word": "предаваться размышлениям",
                                "target_lang_sense_clarification": "погружаться в глубокие мысли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e560560-5314-3871-af6c-8536cf6e935d",
                    "sense_definition": "odczuwać tęsknotę lub smutek z powodu braku kogoś lub czegoś",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tęsknota",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Siedział samotnie i <w>dumał</w> za dawnymi czasami.",
                            "target_lang_translations": {
                                "ru": "Он сидел в одиночестве и <w>тосковал</w> по былым временам."
                            }
                        },
                        {
                            "text": "Nie ma sensu <w>dumać</w> za tym, co już minęło.",
                            "target_lang_translations": {
                                "ru": "Нет смысла <w>тосковать</w> о том, что уже прошло."
                            }
                        }
                    ],
                    "synonyms": [
                        "tęsknić"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "użycie w tym znaczeniu jest przestarzałe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "испытывать тоску или грусть по кому-либо или чему-либо (устар.)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тосковать",
                                "target_lang_sense_clarification": "испытывать сильную грусть или печаль"
                            },
                            {
                                "target_lang_word": "грустить",
                                "target_lang_sense_clarification": "предаваться печальным мыслям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9df4584c-a280-36a9-9cbf-611ab85be3b7",
                    "sense_definition": "wymyślać coś nowego, tworzyć koncepcję",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tworzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Artysta <w>dumał</w> nowy projekt przez wiele miesięcy.",
                            "target_lang_translations": {
                                "ru": "Художник <w>придумывал</w> новый проект в течение многих месяцев."
                            }
                        },
                        {
                            "text": "Znowu coś <w>dumają</w> w swoim warsztacie.",
                            "target_lang_translations": {
                                "ru": "Они опять что-то <w>замышляют</w> в своей мастерской."
                            }
                        }
                    ],
                    "synonyms": [
                        "wymyślać",
                        "knować"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "придумывать что-то новое, создавать концепцию (разг.)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придумывать",
                                "target_lang_sense_clarification": "создавать что-то в воображении"
                            },
                            {
                                "target_lang_word": "замышлять",
                                "target_lang_sense_clarification": "планировать или задумывать что-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}