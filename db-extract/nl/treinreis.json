                "senses": [
                    {
                        "sense_id": "7351cb0f-80a9-3924-8273-710ca6c34bec",
                        "entry_id": "899ca047-0793-3127-943b-b3a653d156f4",
                        "glosses": [
                            "een reis die je maakt met een trein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "730edf8c-42b6-42b1-ac6d-533d0cc73286",
                                "sense_id": "7351cb0f-80a9-3924-8273-710ca6c34bec",
                                "text": "Met een Interrailkaart kun je lange treinreizen maken door Europa."
                            },
                            {
                                "example_id": "059f30a9-1691-466e-a6b3-388f393ab2dd",
                                "sense_id": "7351cb0f-80a9-3924-8273-710ca6c34bec",
                                "text": "Ik zou gaan lopen. Ik verheugde mij daarop. Ik had de hele treinreis de tijd gehad om met behulp van mijn mobiele telefoon de route van het station naar de Calle Nuova Sant'Agnese uit mijn hoofd te leren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3660b3fb-768b-4610-80c6-d6b2dcf1fc3c",
                        "source_entry_id": "899ca047-0793-3127-943b-b3a653d156f4",
                        "source_sense_id": "7351cb0f-80a9-3924-8273-710ca6c34bec",
                        "target_lang_word": "Bahnfahrt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bahnfahrt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16ad4d98-c571-3685-9588-96e81cecdd41",
                                        "entry_id": "2e0d899e-646f-3c32-9fea-0571883f5f6b",
                                        "glosses": [
                                            "Fahrt mit einem Zug, einer Eisenbahn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45535099-4320-4312-95a4-14b1579842e0",
                                                "sense_id": "16ad4d98-c571-3685-9588-96e81cecdd41",
                                                "text": "„Eines Tages während einer Bahnfahrt wurde mir ohne jeden Anlass plötzlich klar, dass eigentlich jede Postsendung per Nachname geschickt wird, aber noch lange nicht jede per Nachnahme.“"
                                            },
                                            {
                                                "example_id": "27d93fe0-ebe5-40c6-9b26-6a76c3a31724",
                                                "sense_id": "16ad4d98-c571-3685-9588-96e81cecdd41",
                                                "text": "„Nach nächtlicher Bahnfahrt wurden die stets sorgfältig ausgewählten Passagiere in Genua eingeschifft.“"
                                            },
                                            {
                                                "example_id": "2001cb32-616a-4148-ab35-e9f867b9fb1e",
                                                "sense_id": "16ad4d98-c571-3685-9588-96e81cecdd41",
                                                "text": "„Zum Beispiel habe ich ihn noch nicht einmal gefragt, woher er das Geld für die Bahnfahrt hierher genommen hat.“"
                                            },
                                            {
                                                "example_id": "a2dd1239-1c92-434e-9a13-5996d6371540",
                                                "sense_id": "16ad4d98-c571-3685-9588-96e81cecdd41",
                                                "text": "„Jeden Tag sterben im Schnitt 40 Menschen bei Bahnfahrten in Indien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e36654a0-4e21-408d-a017-f06bf57f1445",
                        "source_entry_id": "899ca047-0793-3127-943b-b3a653d156f4",
                        "source_sense_id": "7351cb0f-80a9-3924-8273-710ca6c34bec",
                        "target_lang_word": "Zugfahrt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zugfahrt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b143eb97-a7f0-38c6-990e-e0037a04ebc7",
                                        "entry_id": "8c00d2f9-3e15-3ffa-8c45-9b84fe0b613d",
                                        "glosses": [
                                            "die Reise in einer Eisenbahn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "959838c2-607f-4f2d-9c1f-29db4cebefec",
                                                "sense_id": "b143eb97-a7f0-38c6-990e-e0037a04ebc7",
                                                "text": "Während der Zugfahrt fuhren sie an vielen Bahnhöfen vorbei."
                                            },
                                            {
                                                "example_id": "59845927-f263-4d4f-86d4-c23b19a4879b",
                                                "sense_id": "b143eb97-a7f0-38c6-990e-e0037a04ebc7",
                                                "text": "„Die Zugfahrt hatte ihn erledigt.“"
                                            },
                                            {
                                                "example_id": "78466db2-fabb-4f01-8051-d88bfad1cac4",
                                                "sense_id": "b143eb97-a7f0-38c6-990e-e0037a04ebc7",
                                                "text": "„Wie geht die Ansage richtig weiter? a) Diese Zugfahrt endet hier! b) Dieser Zug endet hier! c) Dieser Zug verendet hier!“"
                                            },
                                            {
                                                "example_id": "2272f9f1-73ed-45d0-8730-38a577304dc1",
                                                "sense_id": "b143eb97-a7f0-38c6-990e-e0037a04ebc7",
                                                "text": "„Auf den Zugfahrten zwischen New York und Boston soll ihm, angesichts des Hämmerns der Bahnschwellen, der Rhythmus zu der »Rhapsody in Blue« gekommen sein, an der er zu der Zeit gerade arbeitete.“"
                                            },
                                            {
                                                "example_id": "dbe7e06c-96c6-40d4-8d9e-b1caa6f79622",
                                                "sense_id": "b143eb97-a7f0-38c6-990e-e0037a04ebc7",
                                                "text": "„Er sei in Kapstadt aufs Internat gegangen, erzählte er, eine lange Zugfahrt entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
