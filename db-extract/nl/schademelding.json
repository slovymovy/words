                            {
                                "example_id": "ff1e2dc2-1f27-4167-9fbb-19d2eee7b743",
                                "sense_id": "077113e2-0491-3c47-a396-8f8014482bcb",
                                "text": "Nooit eerder in mijn leven had ik te maken gehad met de politie, afgezien van standaardzaken zoals een nieuw paspoort en een schademelding toen mijn auto een keer was aangereden."
                            },
                            {
                                "example_id": "6ffefb75-7ecd-4d7f-940c-ded521b45293",
                                "sense_id": "077113e2-0491-3c47-a396-8f8014482bcb",
                                "text": "De nieuwe aanpak moet kleine en eenvoudige schadegevallen snel kunnen afhandelen. Volgens het IMG nemen die nu te veel tijd in beslag. De regeling is er alleen voor mensen die nog nooit een claim hebben ingediend of die net een eerste schademelding hebben gedaan. Het gaat om zo'n 200.000 huishoudens."
                            }
