                        "translation_id": "88d5532b-ad8b-4a61-b8e1-e6c99f372ed5",
                        "source_entry_id": "3e0053db-cd18-3f53-a2f8-84a79ff49393",
                        "source_sense_id": "a8882dc2-afca-3713-a8c3-1a0f11a732b6",
