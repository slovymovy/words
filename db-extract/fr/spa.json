                "translations": [
                    {
                        "translation_id": "2b6f1fc4-f21a-4782-8051-b589622c80e9",
                        "source_entry_id": "a0d04872-d7c0-3470-81bd-7234915743b4",
                        "source_sense_id": "7ffb9faa-0cc3-3685-8377-8b4e0e6cbbbf",
                        "source_sense_description": "Wellness: Whirlpool",
                        "target_lang_word": "Whirlpool",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Whirlpool",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a150d40b-d2e4-306a-96f2-563ddb8815fd",
                                        "entry_id": "7667b47b-bce7-30ed-bf5b-2c2ebe36861c",
                                        "glosses": [
                                            "kleines Wasserbecken mit warmen Wasser, das angesaugt und unterhalb der Wasseroberfläche unter hohem Druck wieder zurückgeströmt wird, wodurch ein Sprudel entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e585482c-3ef4-4b3e-bf37-182967645308",
                                                "sense_id": "a150d40b-d2e4-306a-96f2-563ddb8815fd",
                                                "text": "Gestern Abend saß ich mit meiner Verlobten im Whirlpool und wir tranken Wein."
                                            },
                                            {
                                                "example_id": "89b9d36a-ff81-45a6-a461-b713275aab1b",
                                                "sense_id": "a150d40b-d2e4-306a-96f2-563ddb8815fd",
                                                "text": "„Dafür gibt es kein Schwimmbecken und keinen Whirlpool, keinen Fitnessraum und keine Tischtennisplatte.“"
                                            },
                                            {
                                                "example_id": "b3b14aa0-5a20-48f2-98dc-79c6a56af6f7",
                                                "sense_id": "a150d40b-d2e4-306a-96f2-563ddb8815fd",
                                                "text": "„Da gab's dann bald mehr Diskos als Kühe in den Dörfern, in den Landgasthöfen sprudelten die Whirlpools, und die Sennerinnen wurden mit dem Paragleiter auf die Alm geflogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c3a121a-bb09-4b82-b098-615354200ee7",
                        "source_entry_id": "a0d04872-d7c0-3470-81bd-7234915743b4",
                        "source_sense_id": "5ca59f34-447c-35b4-9973-cfd887022166",
                        "source_sense_description": "Wellness, auch Medizin: Spa",
                        "target_lang_word": "Spa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spa",
