                        "entry_id": "b45c9943-1b00-334e-adb3-7361d3d7e64d",
                        "glosses": [
                            "Méthode d’analyse chimique et bactériologique, de type optique, dans laquelle la concentration d’une substance est déterminée en comparant l’intensité de la lumière diffusée par ses particules constitutives en suspension avec celle qui est diffusée par une suspension de concentration connue du même type de particules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03c72308-bd89-42af-ac94-c0bbcf927715",
                                "sense_id": "04b9f65d-a23c-39dc-9747-83ccc2b83f9e",
                                "text": "Mesure de la turbidité par néphélométrie."
                            },
                            {
                                "example_id": "4cc77b61-4768-4e58-badc-76de57802bc7",
                                "sense_id": "04b9f65d-a23c-39dc-9747-83ccc2b83f9e",
                                "text": "La détermination de la turbidité se mesure par néphélométrie."
                            }
                        ]
                    }
