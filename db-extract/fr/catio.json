                                        "glosses": [
                                            "specjalny wybieg dla kota domowego zaspokajający jego potrzebę ruchu, obserwacji i eksplotacji, a jednocześnie zapewniający bezpieczeństwo tak dla samego kota, jak i dla środowiska"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
