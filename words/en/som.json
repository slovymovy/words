        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50356ae0-6391-3ba6-b574-c25824f62020",
                    "sense_definition": "The official currency of Uzbekistan.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I needed to exchange my dollars for Uzbek <w>som</w> before visiting the local market.",
                            "target_lang_translations": {
                                "ru": "Мне нужно было обменять доллары на узбекские <w>сумы</w> перед посещением местного рынка."
                            }
                        },
                        {
                            "text": "The price of the silk scarf was several thousand <w>som</w>.",
                            "target_lang_translations": {
                                "ru": "Цена шелкового шарфа составляла несколько тысяч <w>сумов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Uzbek som"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная валюта Узбекистана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сум",
                                "target_lang_sense_clarification": "валюта Узбекистана"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f054160-4ea8-3f00-b035-cfbccad87d65",
                    "sense_definition": "The official currency of Kyrgyzstan.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When traveling through Central Asia, you will use the Kyrgyz <w>som</w> in Bishkek.",
                            "target_lang_translations": {
                                "ru": "Путешествуя по Центральной Азии, в Бишкеке вы будете использовать киргизский <w>сом</w>."
                            }
                        },
                        {
                            "text": "The exchange rate for the <w>som</w> has remained relatively stable this month.",
                            "target_lang_translations": {
                                "ru": "Курс <w>сома</w> в этом месяце оставался относительно стабильным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Kyrgyz som"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная валюта Киргизии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сом",
                                "target_lang_sense_clarification": "валюта Киргизии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a31a338b-f88e-30a0-a794-a74daa4a85a8",
                    "sense_definition": "A shortened, informal term for a <w>sommelier</w>, a wine professional.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wine_professional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>som</w> who first introduced me to it leaned in close and whispered the news.",
                            "target_lang_translations": {
                                "ru": "<w>Сомелье</w>, который впервые познакомил меня с этим, наклонился поближе и прошептал новость."
                            }
                        },
                        {
                            "text": "We asked the head <w>som</w> to recommend a pairing for the main course.",
                            "target_lang_translations": {
                                "ru": "Мы попросили главного <w>сомелье</w> порекомендовать вино к основному блюду."
                            }
                        }
                    ],
                    "synonyms": [
                        "sommelier"
                    ],
                    "common_phrases": [
                        "head som",
                        "floor som"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal abbreviation used in the hospitality industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное, неформальное название сомелье, специалиста по винам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомелье",
                                "target_lang_sense_clarification": "профессионал по винам"
                            },
                            {
                                "target_lang_word": "сом",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "643a3162-afab-3544-8c63-7a365bf0ce82",
                    "sense_definition": "An abbreviation for system on a module, a circuit integrating a system function in a single package.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineering team decided to use a compact <w>SoM</w> for the new prototype.",
                            "target_lang_translations": {
                                "ru": "Инженерная группа решила использовать компактную <w>систему на модуле</w> для нового прототипа."
                            }
                        },
                        {
                            "text": "Integrating a <w>SoM</w> into the design reduced the overall development time significantly.",
                            "target_lang_translations": {
                                "ru": "Интеграция <w>SoM</w> в конструкцию значительно сократила общее время разработки."
                            }
                        }
                    ],
                    "synonyms": [
                        "system-on-module"
                    ],
                    "common_phrases": [
                        "embedded SoM"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для «системы на модуле» (system on a module), микросхемы, объединяющей функции системы в одном корпусе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "SoM",
                                "target_lang_sense_clarification": "система на модуле"
                            },
                            {
                                "target_lang_word": "модуль",
                                "target_lang_sense_clarification": "в контексте электроники"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7cbef9b-0c16-3133-9b20-3b8dc98ec648",
                    "sense_definition": "An initialism for a self-organizing map, a type of artificial neural network.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "machine_learning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher used a <w>SOM</w> to visualize the high-dimensional data in two dimensions.",
                            "target_lang_translations": {
                                "ru": "Исследователь использовал <w>SOM</w> для визуализации многомерных данных в двух измерениях."
                            }
                        },
                        {
                            "text": "A <w>SOM</w> is particularly effective for clustering complex datasets without supervision.",
                            "target_lang_translations": {
                                "ru": "<w>Самоорганизующаяся карта</w> особенно эффективна для кластеризации сложных наборов данных без учителя."
                            }
                        }
                    ],
                    "synonyms": [
                        "self-organizing map"
                    ],
                    "common_phrases": [
                        "SOM algorithm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для самоорганизующейся карты (self-organizing map), типа искусственной нейронной сети."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "SOM",
                                "target_lang_sense_clarification": "самоорганизующаяся карта Кохонена"
                            },
                            {
                                "target_lang_word": "карта Кохонена",
                                "target_lang_sense_clarification": "нейронная сеть"
                            }
                        ]
                    }
                }
            ]
