                "senses": [
                    {
                        "sense_id": "ff4b0255-a70e-3a8f-a6ae-6e8241e71d8d",
                        "entry_id": "342b7af0-7d5d-3275-acef-0579f8cfd154",
                        "glosses": [
                            "Activer sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f4cc32-0cea-4fe4-9365-c06f7afe544b",
                                "sense_id": "ff4b0255-a70e-3a8f-a6ae-6e8241e71d8d",
                                "text": "Ces protéases seraient donc capables de s'auto-activer ou de s'activer entre elles."
                            },
                            {
                                "example_id": "a0df7b4f-4dd0-4ce3-82bf-2cbc1bb0bf83",
                                "sense_id": "ff4b0255-a70e-3a8f-a6ae-6e8241e71d8d",
                                "text": "À l'étage mésencéphalique, l'objet n'a pas acquis une existence autonome mais, soumis au message afférent, le système nerveux cesse de s'auto-activer « en vase clos » pour entrer en alerte."
                            }
                        ]
                    }
