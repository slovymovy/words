                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'il a appris la nouvelle, il est <w>aussitôt</w> parti la rejoindre.",
                            "target_lang_translations": {
                                "en": "As soon as he heard the news, he <w>immediately</w> set off to join her.",
                                "ru": "Как только он узнал новость, он <w>тут же</w> отправился к ней.",
                                "nl": "Zodra hij het nieuws hoorde, vertrok hij <w>meteen</w> om zich bij haar te voegen.",
                                "de": "Sobald er die Nachricht erfahren hatte, machte er sich <w>sofort</w> auf den Weg zu ihr.",
                                "pl": "Gdy tylko dowiedział się o tej wiadomości, <w>natychmiast</w> ruszył, żeby do niej dołączyć.",
                                "it": "Non appena ha saputo la notizia, è <w>subito</w> partito per raggiungerla.",
                                "cs": "Jakmile se o té zprávě dozvěděl, <w>hned</w> se za ní vydal.",
                                "tr": "Haberi öğrenir öğrenmez <w>hemen</w> onun yanına gitmek için yola çıktı.",
                                "es": "En cuanto se enteró de la noticia, partió <w>enseguida</w> a reunirse con ella.",
                                "zh": "他一得知这个消息，就<w>马上</w>动身去找她了。"
                            }
                        },
                        {
                            "text": "Elle a accepté la proposition et a commencé à travailler <w>aussitôt</w>.",
                            "target_lang_translations": {
                                "en": "She accepted the proposal and started working <w>right away</w>.",
                                "ru": "Она приняла предложение и начала работать <w>сразу</w>.",
                                "nl": "Zij accepteerde het voorstel en begon <w>meteen</w> te werken.",
                                "de": "Sie nahm den Vorschlag an und begann <w>sofort</w> zu arbeiten.",
                                "pl": "Przyjęła propozycję i <w>od razu</w> zabrała się do pracy.",
                                "it": "Ha accettato la proposta e ha cominciato a lavorare <w>subito</w>.",
                                "cs": "Návrh přijala a <w>hned</w> začala pracovat.",
                                "tr": "Teklifi kabul etti ve <w>hemen</w> çalışmaya başladı.",
                                "es": "Aceptó la propuesta y empezó a trabajar <w>enseguida</w>.",
                                "zh": "她接受了这个提议，并<w>立刻</w>开始工作。"
                            }
                        }
