{
    "word_family": [
        "dash"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b4a0f2a-207b-33c7-8e97-61df30b6b913",
                    "sense_definition": "Present participle of <w>dash</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>dashing</w> across the busy street to catch the arriving train.",
                            "target_lang_translations": {
                                "ru": "Он <w>мчался</w> через оживленную улицу, чтобы успеть на прибывающий поезд."
                            }
                        },
                        {
                            "text": "She spent the whole morning <w>dashing</w> from one meeting to another.",
                            "target_lang_translations": {
                                "ru": "Она провела все утро, <w>метаясь</w> с одной встречи на другую."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола dash; несущийся, мчащийся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мчащийся",
                                "target_lang_sense_clarification": "быстро передвигающийся"
                            },
                            {
                                "target_lang_word": "несущийся",
                                "target_lang_sense_clarification": "стремительно бегущий или едущий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4515677f-9f24-37b4-903c-03ecb91673bc",
                    "sense_definition": "Attractive, confident, and stylish, often in an adventurous or elegant way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stylish_and_lively",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked very <w>dashing</w> in his tailored suit at the wedding reception.",
                            "target_lang_translations": {
                                "ru": "На свадебном приеме он выглядел очень <w>щеголевато</w> в сшитом на заказ костюме."
                            }
                        },
                        {
                            "text": "All heads turned when the <w>dashing</w> officer entered the ballroom.",
                            "target_lang_translations": {
                                "ru": "Все обернулись, когда в бальный зал вошел <w>лихой</w> офицер."
                            }
                        }
                    ],
                    "synonyms": [
                        "debonair",
                        "stylish",
                        "smart",
                        "jaunty"
                    ],
                    "antonyms": [
                        "dowdy",
                        "shabby"
                    ],
                    "common_phrases": [
                        "dashing figure",
                        "dashing young man"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекательный, уверенный в себе и элегантный, часто с оттенком авантюризма или щегольства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лихой",
                                "target_lang_sense_clarification": "молодецкий, удалой, щеголеватый"
                            },
                            {
                                "target_lang_word": "щеголеватый",
                                "target_lang_sense_clarification": "модно и эффектно одетый, франтоватый"
                            },
                            {
                                "target_lang_word": "видный",
                                "target_lang_sense_clarification": "статный, привлекающий внимание"
                            },
                            {
                                "target_lang_word": "эффектный",
                                "target_lang_sense_clarification": "производящий сильное впечатление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f84b692-8340-3b74-8195-75c82b3dcc2a",
                    "sense_definition": "Spirited, audacious, and full of lively energy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stylish_and_lively",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band delivered a <w>dashing</w> performance that thrilled the energetic audience.",
                            "target_lang_translations": {
                                "ru": "Группа выдала <w>энергичное</w> выступление, приведшее в восторг активную публику."
                            }
                        },
                        {
                            "text": "Her <w>dashing</w> attack on the opposing team secured the sudden victory.",
                            "target_lang_translations": {
                                "ru": "Ее <w>стремительная</w> атака на команду соперников обеспечила внезапную победу."
                            }
                        }
                    ],
                    "synonyms": [
                        "spirited",
                        "audacious",
                        "bold",
                        "gallant"
                    ],
                    "antonyms": [
                        "timid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пылкий, дерзкий, смелый и полный живой энергии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "энергичный",
                                "target_lang_sense_clarification": "полный сил и активности"
                            },
                            {
                                "target_lang_word": "стремительный",
                                "target_lang_sense_clarification": "быстрый, решительный и напористый"
                            },
                            {
                                "target_lang_word": "лихой",
                                "target_lang_sense_clarification": "смелый, дерзкий"
                            },
                            {
                                "target_lang_word": "задорный",
                                "target_lang_sense_clarification": "бодрый, воодушевленный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91d8334f-eecb-3dc9-a787-d2e99a95fbe9",
                    "sense_definition": "The action of rushing, splashing, or moving suddenly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We listened to the constant <w>dashing</w> of heavy waves against the rocky shore.",
                            "target_lang_translations": {
                                "ru": "Мы слушали непрерывные <w>удары</w> тяжелых волн о скалистый берег."
                            }
                        },
                        {
                            "text": "The sudden <w>dashing</w> of horses disturbed the peaceful village evening.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>топот несущихся</w> лошадей нарушил тишину деревенского вечера."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремительное движение, рывок или удар с плеском (о волнах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удары",
                                "target_lang_sense_clarification": "шумный всплеск или накатывание волн"
                            },
                            {
                                "target_lang_word": "плеск",
                                "target_lang_sense_clarification": "звук бьющихся волн"
                            },
                            {
                                "target_lang_word": "стремительный бег",
                                "target_lang_sense_clarification": "быстрое, внезапное движение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}