                "senses": [
                    {
                        "sense_id": "7376d57f-cf63-383b-b68d-4e3386fce507",
                        "entry_id": "c149b5fe-ed92-3a40-9ee2-f39e937a1723",
                        "glosses": [
                            "hailstorm"
                        ],
                        "tags": [
                            "countable",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e77442ef-bf2c-45c7-8a25-8546555d4da5",
                                "sense_id": "7376d57f-cf63-383b-b68d-4e3386fce507",
                                "text": "Durch die besonderen klimatischen Bedingungen kommt es immer wieder zu heftigen Hagelschlägen.",
                                "translation": "Because of the peculiar climate conditions, severe hailstorms are a common occurrence.",
                                "english": "Because of the peculiar climate conditions, severe hailstorms are a common occurrence."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8fa181e-ab7f-3761-a665-cdb180595d7f",
                        "entry_id": "c149b5fe-ed92-3a40-9ee2-f39e937a1723",
                        "glosses": [
                            "impact of hail, damage caused by it"
                        ],
                        "tags": [
                            "masculine",
                            "strong",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "4a5e232d-8ac6-48ca-b988-5b8c106c8600",
                                "sense_id": "b8fa181e-ab7f-3761-a665-cdb180595d7f",
                                "text": "Die Windschutzscheibe musste nach Hagelschlag ausgetauscht werden.",
                                "translation": "The windscreen had to be replaced after hail impact.",
                                "english": "The windscreen had to be replaced after hail impact."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7f4202f-10b5-3776-83c9-fe2c127d6d45",
                        "entry_id": "c149b5fe-ed92-3a40-9ee2-f39e937a1723",
                        "glosses": [
                            "alternative form of Hagelslag (“hagelslag, oblong chocolate sprinkles”), usually called Schokostreusel"
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "masculine",
                            "rare",
                            "strong",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c95ada4f-acac-4d5e-b093-3196cba150e9",
                                "sense_id": "f7f4202f-10b5-3776-83c9-fe2c127d6d45",
                                "text": "Tipps zum kreativen Handeln findest du im letzten unteren Abschnitt. Wissenschaftlich betrachtet: Gleichwertig zur virtuellen Brille sind Butterbrot mit Hagelschlag (niederländische Schokostreusel) sowie eine Ladung Ziegelsteine ein guter kreativer Einstieg."
                            },
                            {
                                "example_id": "6b39700a-c5c2-4c91-9b31-b8e4ec223cb2",
                                "sense_id": "f7f4202f-10b5-3776-83c9-fe2c127d6d45",
                                "text": "300g Mehl[,] 1 pkt Backpulver[,] 100-150g Schokostreusel, Hagelschlag"
                            }
                        ]
                    }
                ],
