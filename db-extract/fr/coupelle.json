                                            {
                                                "example_id": "d7a58ef0-a1d6-4d3f-8cbe-dbac726f509c",
                                                "sense_id": "b2959d9e-6f66-3d50-9050-49b0800a3805",
                                                "text": "I drank two cups of water but still felt thirsty."
                                            },
                                            {
                                                "example_id": "9a192d0d-d6af-459f-b0c3-c8472e0393d3",
                                                "sense_id": "b2959d9e-6f66-3d50-9050-49b0800a3805",
