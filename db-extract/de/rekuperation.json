                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d77dab4d-7a23-3268-84a1-6d468a59ceaa",
                                        "entry_id": "e0aa1cea-e0b8-3ab1-9b2d-51a38f2eaf81",
                                        "glosses": [
                                            "Process by which radical or subversive ideas are co-opted by mainstream society."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3719f850-f22c-489a-85e7-3539e6af6708",
                                                "sense_id": "d77dab4d-7a23-3268-84a1-6d468a59ceaa",
                                                "text": "[Raoul Vaneigem] I have nothing in common with the spectacular recuperation of a project that, in my case, has remained revolutionary throughout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8fa3279-a6aa-406c-b547-f9a716068e3a",
                        "source_entry_id": "97a10fbe-8f8e-340f-853d-a3d3e4907db3",
                        "source_sense_id": "96fcd8eb-6aa7-3141-ae5d-817efaffbb01",
                        "source_sense_description": "Technik: Rückgewinnung von Energie",
                        "target_lang_word": "récupération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "récupération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f85bd92-d91b-3c7b-bf29-08c758422146",
                                        "entry_id": "f46da252-5d5f-304a-aa95-48053185fd1e",
                                        "glosses": [
                                            "Action de récupérer, de recueillir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9632169-32be-4b30-a3ad-af9f6c8ca57e",
                                                "sense_id": "7f85bd92-d91b-3c7b-bf29-08c758422146",
                                                "text": "Une idée intéressante, qui pourrait améliorer très sensiblement le prix de revient total du transport, est celle de la récupération des frigories disponibles à la regazéification."
                                            },
                                            {
                                                "example_id": "e8d31ef3-f82d-44de-8270-c339f7ee43f0",
                                                "sense_id": "7f85bd92-d91b-3c7b-bf29-08c758422146",
                                                "text": "Ce que nous savons du genre d’élevage pratiqué nous incite à penser que la récupération du fumier était faible. Les 20 à 30 millions de moutons pacageaient presque toute l'année sur les landes ; une faible part pacageait les jachères."
                                            },
                                            {
                                                "example_id": "c6398103-4a77-48e9-9ae7-de22aa468468",
                                                "sense_id": "7f85bd92-d91b-3c7b-bf29-08c758422146",
                                                "text": "La valorisation du patrimoine juif est un processus de grande ampleur en Catalogne où la restauration des calls (nom hébreu désignant les quartiers juifs au Moyen Âge) et la récupération des témoignages du passé, ont donné des résultats notoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4ef1eb0-819f-34d4-bba3-beb2c768e843",
                                        "entry_id": "f46da252-5d5f-304a-aa95-48053185fd1e",
                                        "glosses": [
                                            "Collecte d’objets et matières considérés comme des déchets par leurs propriétaires, afin de les revaloriser par le recyclage, le compostage ou tout autre type de transformation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f1d5e5f-9764-4cc0-b34e-942087c5944f",
                                                "sense_id": "f4ef1eb0-819f-34d4-bba3-beb2c768e843",
                                                "text": "Les acides ayant servi à la nitration peuvent aussi être récupérés à l’aide de dénitrants. Ces appareils sont à notre avis les plus économiques à employer pour la récupération des acides ayant servi à la fabrication des nitro-celluloses."
                                            },
                                            {
                                                "example_id": "d9945bf6-1c06-42d3-b301-b48f338b12ca",
                                                "sense_id": "f4ef1eb0-819f-34d4-bba3-beb2c768e843",
                                                "text": "Elle était dingue des fringues de créateur et ne kiffait pas trop mon style vestimentaire, tendance récupération. Mais elle ne désespérait pas qu'un jour je prenne exemple sur elle : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8584edd5-7cfe-3e62-970c-9ca7d16645cb",
                                        "entry_id": "f46da252-5d5f-304a-aa95-48053185fd1e",
                                        "glosses": [
                                            "Procédé visant à déformer les idées ou les propos d’autrui, afin de cautionner ses propres avis."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57a5379c-f52a-4953-bef9-02e1c3b545cc",
                                                "sense_id": "8584edd5-7cfe-3e62-970c-9ca7d16645cb",
                                                "text": "Mick Jagger écourte son séjour à Davos, craignant une récupération politique : « J’ai toujours été intéressé par l’économie et les événements mondiaux. Mais je me retrouve utilisé comme jouet politique et beaucoup de commentaires inexacts ont été faits sur mes opinions politiques »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "811df7b3-45ab-301b-b04c-4b10971e6fe1",
                                        "entry_id": "f46da252-5d5f-304a-aa95-48053185fd1e",
                                        "glosses": [
                                            "État de repos après un effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81e6a56c-7b36-454e-80b7-ebbfa2ad4fcf",
                                                "sense_id": "811df7b3-45ab-301b-b04c-4b10971e6fe1",
                                                "text": "Attablé à une terrasse, cours de la République, un nom qui sonne toujours bien à l'oreille, Alfred expliqua qu'il était en phase de récupération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f8e3a36-37ce-3ce1-96c2-17e1bd3a830b",
                                        "entry_id": "f46da252-5d5f-304a-aa95-48053185fd1e",
                                        "glosses": [
                                            "Par extension, action visant à revenir dans un état normal maitrisé après l’avoir quitté depuis un événement initiateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc36d7d8-5468-45f2-a12c-5a761441625a",
                                                "sense_id": "4f8e3a36-37ce-3ce1-96c2-17e1bd3a830b",
                                                "text": "Une porte vers l’accident s’est ouverte, et le cours des événements va inexorablement conduire à l’accident si une action de récupération volontaire et efficace n’est pas effectuée à temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
