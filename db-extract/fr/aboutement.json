                        "entry_id": "52cea88e-861d-3e3f-9e3e-0670b25117cc",
                        "glosses": [
                            "Assemblage de plusieurs pièces mises bout à bout avec un ou des éléments de liaison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b725f1d9-2b12-4fec-b93a-c7a60d8539bc",
                                "sense_id": "a10f511f-c6f1-3f8e-8868-7ccf0eac1c8c",
                                "text": "Les raccords d’aboutement de diagonales sollicitées à la traction doivent être construits pour résister aux efforts de traction à envisager."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f8d0891-c2a8-3bea-8630-969772df27a5",
                        "entry_id": "52cea88e-861d-3e3f-9e3e-0670b25117cc",
                        "glosses": [
                            "Mise en relation de deux lignes sans interrompre la connexion."
                        ],
                        "tags": [],
                        "examples": [
                            {
