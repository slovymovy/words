    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5d3807ea-6bec-34b6-8041-c43f4fec2b7f",
                "word": "misname",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c99e63d0-4b33-4ba6-92a9-c917bf7f1a56",
                        "entry_id": "5d3807ea-6bec-34b6-8041-c43f4fec2b7f",
                        "tags": [
                            "plural"
                        ],
                        "form": "misnames"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2c6c87d-a695-39bd-8d2d-56f499edc4c3",
                        "entry_id": "5d3807ea-6bec-34b6-8041-c43f4fec2b7f",
                        "glosses": [
                            "A wrong, unsuitable, misleading, or injurious name or designation; misnomer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f73454f-2a0a-4e48-a4e3-a5f0f7b03ed7",
                                "sense_id": "e2c6c87d-a695-39bd-8d2d-56f499edc4c3",
                                "text": "Like the name Macon Dead, it is a misname imposed by someone with no concern about the consequences."
                            },
                            {
                                "example_id": "16799c01-bf83-4f4f-b8a9-32308fd9cfc0",
                                "sense_id": "e2c6c87d-a695-39bd-8d2d-56f499edc4c3",
                                "text": "And it was a misname, because the woman who stood before him now in all her naked glory presented a picture beauteous beyond belief—to Vagn, leastways."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
