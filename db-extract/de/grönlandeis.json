                ],
                "senses": [
                    {
                        "sense_id": "dcfdf340-cbcc-3596-b936-c049303d453d",
                        "entry_id": "0829c958-d0de-3eca-9dcb-c60893a31547",
                        "glosses": [
                            "großer Eisschild, der die Insel Grönland bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0648dfc-f7f8-4d87-8631-ec5c826bda9b",
                                "sense_id": "dcfdf340-cbcc-3596-b936-c049303d453d",
                                "text": "„So niedrige Temperaturen hatten wir droben auf dem Grönlandeise in den Sommermonaten, nach der Erfahrung, welche Jensen, Nordenskiöld und Peary gemacht hatten, nicht in Rechnung gezogen.“"
                            },
                            {
                                "example_id": "a6723cef-207e-4002-a559-145a4e61b99a",
                                "sense_id": "dcfdf340-cbcc-3596-b936-c049303d453d",
                                "text": "„Bohrkerne aus dem Grönlandeis beweisen, dass es binnen eines Jahrzehnts zu großen Temperatursprüngen kam.“"
                            },
                            {
                                "example_id": "1e61bbee-8599-44d6-8642-3272c0f91a02",
                                "sense_id": "dcfdf340-cbcc-3596-b936-c049303d453d",
                                "text": "„Infolge der gestiegenen Temperaturen schmelzen die Gletscher in den Bergen, das Grönlandeis und das Eis der Arktis und Antarktis.“"
                            },
                            {
                                "example_id": "ae0b7c8c-eee0-4e25-a683-a32613e8db58",
                                "sense_id": "dcfdf340-cbcc-3596-b936-c049303d453d",
                                "text": "„Sollte das gesamte Grönlandeis abschmelzen, rechnen die Gletscherforscher mit einem Anstieg des Meeresspiegels um bis zu sieben Meter.“"
                            },
                            {
                                "example_id": "b4c5c725-0951-4ef2-9662-d840a7886c8a",
                                "sense_id": "dcfdf340-cbcc-3596-b936-c049303d453d",
                                "text": "„Der Eisblock war aus dem ewigen Grönlandeis herausgeschnitten worden und für einen Eisskulpturen-Wettbewerb in Kapstadt vorgesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
