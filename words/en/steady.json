            "senses": [
                {
                    "sense_id": "d18485bf-2f62-308a-9ce9-6159916f50f6",
                    "sense_definition": "To make something firm, stable, or calm; to stop something from shaking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She grabbed the rail to <w>steady</w> herself on the moving bus.",
                            "target_lang_translations": {
                                "ru": "Она схватилась за поручень, чтобы <w>удержать равновесие</w> в движущемся автобусе.",
                                "zh": "她在行驶的公交车上抓住了扶手以<w>稳住</w>身体。"
                            }
                        },
                        {
                            "text": "He took a moment to <w>steady</w> his breathing before speaking.",
                            "target_lang_translations": {
                                "ru": "Он взял паузу, чтобы <w>успокоить</w> дыхание перед тем, как заговорить.",
                                "zh": "他在说话前花了一点时间<w>平复</w>呼吸。"
                            }
