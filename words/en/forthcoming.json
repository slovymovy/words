                            {
                                "target_lang_word": "beliren",
                                "target_lang_sense_clarification": "görünür hale gelen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03855e0a-1fc8-36fc-b135-a97fbaf690ae",
                    "sense_definition": "Something that is yet to arrive or happen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "future things",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher spoke of the great <w>forthcomings</w> of the next century.",
                            "target_lang_translations": {
                                "ru": "Философ говорил о великих <w>грядущих событиях</w> следующего века.",
                                "tr": "Filozof, gelecek yüzyılın büyük <w>gelecek olaylarından</w> bahsetti."
                            }
                        },
                        {
                            "text": "We must prepare ourselves for the <w>forthcomings</w> of eternity.",
                            "target_lang_translations": {
                                "ru": "Мы должны подготовить себя к <w>пришествию</w> вечности.",
                                "tr": "Kendimizi sonsuzluğun <w>geleceğine</w> hazırlamalıyız."
                            }
                        }
