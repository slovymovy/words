                "senses": [
                    {
                        "sense_id": "f9d9c986-51e4-32b8-a533-bb95a3321f98",
                        "entry_id": "0ee182d6-d8cc-38cf-af94-f7d8ebc4a260",
                        "glosses": [
                            "Brasquer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39c1bc9c-5fc8-451d-87ae-3fa9115d016a",
                                "sense_id": "f9d9c986-51e4-32b8-a533-bb95a3321f98",
                                "text": "Les sous-traitants responsables de la réfection des cuves pour l’entreprise s’affaireront, en équipe avec les employés d’Alouette, à débrasquer et rebrasquer majoritairement les cuves issues de la seconde phase qui a démarré en 2005."
                            },
                            {
                                "example_id": "a57fa0fd-33cd-47e7-9061-465cbf1f303a",
                                "sense_id": "f9d9c986-51e4-32b8-a533-bb95a3321f98",
                                "text": "Un point important, puisqu'Alcan a annoncé récemment sa décision de ne plus rebrasquer à partir de juin 2006."
                            }
                        ]
                    }
