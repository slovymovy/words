                        ],
                        "examples": [
                            {
                                "example_id": "d0ecb3d1-4b0e-4353-b611-c8a2d9034515",
                                "sense_id": "35f1adef-0669-3854-8462-11485e77a4ad",
                                "text": "Or j'accueillis ensemble les géométries du thème latin et de l'algèbre, et les finesses de la musique et de l'esprit bellétrien."
                            }
                        ]
                    },
                    {
                        "sense_id": "700d46d8-2317-32dc-a2ed-3c455c63fafd",
                        "entry_id": "e9dee00b-34d8-3dbb-ae08-ac026c95fe1a",
                        "glosses": [
                            "Qui fronde, qui critique les autorités établies ou les opinions reçues."
