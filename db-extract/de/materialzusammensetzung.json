                "senses": [
                    {
                        "sense_id": "8d3ce49e-f77c-3d82-a1fa-ab31516153ff",
                        "entry_id": "14d084c7-219d-377c-ad40-7b6a98118c5f",
                        "glosses": [
                            "Kombination von Materialien oder Stoffen, aus denen ein Produkt oder Stoff besteht, häufig in Form ihrer prozentualen Anteile angegeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc917ee9-0220-42bf-adf6-caba3f5774dc",
                                "sense_id": "8d3ce49e-f77c-3d82-a1fa-ab31516153ff",
                                "text": "„Rana aus der Basic-Kollektion bietet eine optimalen Tragekomfort und durch seine Materialzusammensetzung einen erhöhten Feuchtigkeitstransport.“"
                            },
                            {
                                "example_id": "56d47761-f3e1-4fbc-a203-5f0cd12e64b7",
                                "sense_id": "8d3ce49e-f77c-3d82-a1fa-ab31516153ff",
                                "text": "„Bei Bekleidung sei jedenfalls die Materialzusammensetzung von entscheidender Bedeutung.“"
                            },
                            {
                                "example_id": "22e1b179-dcff-4816-b7bc-37406c50f3ea",
                                "sense_id": "8d3ce49e-f77c-3d82-a1fa-ab31516153ff",
                                "text": "„Diese Materialzusammensetzung reduziert die Umweltauswirkungen erheblich und setzt einen neuen Standard für umweltfreundliche Schutzkleidung.“"
                            },
                            {
                                "example_id": "28862efd-2bfe-43fb-a196-2043300ca650",
                                "sense_id": "8d3ce49e-f77c-3d82-a1fa-ab31516153ff",
                                "text": "„Materialzusammensetzung: 46 % Polyamid / 43 % Polyester / 11 % Elastan.“"
                            },
                            {
                                "example_id": "02c11123-2931-48fe-8e39-efb34607ec04",
                                "sense_id": "8d3ce49e-f77c-3d82-a1fa-ab31516153ff",
                                "text": "„Materialzusammensetzung: Hauptstoff: 100 % Polyamid“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
