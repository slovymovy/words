                                        "entry_id": "7f402dc2-1ed8-34bb-bc86-1d7747d67954",
                                        "glosses": [
                                            "The number of hands such that each player at the table has posted the big blind once."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
