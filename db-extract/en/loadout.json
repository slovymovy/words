                            {
                                "example_id": "e0b8755f-6021-4c7e-9f53-bf4d8e8d50f0",
                                "sense_id": "6928a264-fe1c-3190-975b-5226e9ab681a",
                                "text": "'Load-out' : The transfer of a major assembly onto a barge by horizontal movement or by lifting. (For the purposes of this document, the term Barge can be considered to include Pontoon, Ship or Vessel where appropriate)."
                            }
                        ]
