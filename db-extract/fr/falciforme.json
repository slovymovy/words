                                        "sense_id": "707142a2-dcb8-3e53-aca1-a82a99902499",
                                        "entry_id": "b469f8f2-c347-36f2-a449-124cc5fce70f",
                                        "glosses": [
                                            "in Form einer Sichel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4a8d032-20d0-44b3-b5e4-dd4c71368945",
                                                "sense_id": "707142a2-dcb8-3e53-aca1-a82a99902499",
                                                "text": "Sie trug einen kleinen, sichelförmigen Anhänger, der vielleicht den Mond darstellen sollte."
                                            },
                                            {
                                                "example_id": "c8652ab7-f291-4c1c-8710-15c75527263f",
                                                "sense_id": "707142a2-dcb8-3e53-aca1-a82a99902499",
                                                "text": "„Oft wird es mit schweren Tunnels in den Ohren, Tätowierungen, sichelförmig gezupften Brauen und pinkem Haarschopf kombiniert.“"
                                            },
                                            {
                                                "example_id": "eabadc66-12c7-479d-8327-7fb79949a9f0",
                                                "sense_id": "707142a2-dcb8-3e53-aca1-a82a99902499",
                                                "text": "„Und so flog der Geist zurück zu dem schwachen, sichelförmigen Mond, während der Dämon gründlich ein Äffchen auf einem Baum betrachtete, der in einem verfallenden Hof wuchs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
