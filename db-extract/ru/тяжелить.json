                "senses": [
                    {
                        "sense_id": "7333b8cb-fab9-3359-8d4e-2a7de2552ca4",
                        "entry_id": "e6e8887a-8f3e-3c44-ba2b-ea80f908e854",
                        "glosses": [
                            "делать тяжёлым или более тяжёлым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "171dd558-1694-45cd-99d2-84b0862749de",
                                "sense_id": "7333b8cb-fab9-3359-8d4e-2a7de2552ca4",
                                "text": "Кувшины для воды и кринки для молока он приспособил под веники цветов, запахи которых превращали избу в лесной шалаш и сладко тяжелили голову."
                            }
                        ]
                    },
                    {
                        "sense_id": "54c2b7ff-9745-396f-9ce2-608bef62f303",
                        "entry_id": "e6e8887a-8f3e-3c44-ba2b-ea80f908e854",
                        "glosses": [
                            "отягощать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51a6279e-fe46-4713-b10d-2321810d0430",
                                "sense_id": "54c2b7ff-9745-396f-9ce2-608bef62f303",
                                "text": "Творческая беременность тяжелит, мутит."
                            },
                            {
                                "example_id": "43408ebd-c9a5-4120-88fe-41175e898de6",
                                "sense_id": "54c2b7ff-9745-396f-9ce2-608bef62f303",
                                "text": "Бабушка первой произнесла слово, которое давно уже тяжелило сердца обитателей «Вороньей слободки»."
                            }
                        ]
                    }
