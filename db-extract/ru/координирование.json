                    },
                    {
                        "translation_id": "e86a9dda-0670-442b-9d23-be2c338a5a86",
                        "source_entry_id": "714bc8e8-b15f-33e9-b609-1f98dc60b0df",
                        "source_sense_id": "52124659-c0c8-30e2-84c6-f7f1aceec6c4",
