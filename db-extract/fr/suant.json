                "senses": [
                    {
                        "sense_id": "bc141648-5398-3807-bb70-d7c2495cf13a",
                        "entry_id": "a1e97707-13c9-363d-a28e-597d5f84859f",
                        "glosses": [
                            "Qui sue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f86f1df-8ffb-4c99-aacd-b6d27310f3e6",
                                "sense_id": "bc141648-5398-3807-bb70-d7c2495cf13a",
                                "text": "Il est venu tout suant."
                            },
                            {
                                "example_id": "43c36dd7-cab4-4d29-ab60-83ccf2ab60a2",
                                "sense_id": "bc141648-5398-3807-bb70-d7c2495cf13a",
                                "text": "Un peuple d’ouvriers suants, noirs des poussières épandues, y peinait encore ; mais c’était pourtant la fin de la journée, le dernier effort de la tâche."
                            },
                            {
                                "example_id": "2fe4abf9-c17a-4cb1-8bac-b42a49c346f8",
                                "sense_id": "bc141648-5398-3807-bb70-d7c2495cf13a",
                                "text": "Nous ne pouvions pas arriver à nous procurer de la glace. J’essuyais, pendant des après-midi sans fin, sa petite figure suante qui attirait les mouches."
                            }
                        ]
                    }
                ],
