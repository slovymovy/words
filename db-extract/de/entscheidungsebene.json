                ],
                "senses": [
                    {
                        "sense_id": "957a8526-1cb4-37fb-a3d5-d325794d0a5b",
                        "entry_id": "caa77c46-ca01-389e-aa18-212a67b237cb",
                        "glosses": [
                            "bestimmte Stelle, die für das Treffen von Entscheidungen zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e914eec-e009-4fab-818e-2cfcb57ef04c",
                                "sense_id": "957a8526-1cb4-37fb-a3d5-d325794d0a5b",
                                "text": "„Betriebliche Planungsaufgaben lassen sich in drei unterschiedliche Entscheidungsebenen aufteilen.“"
                            },
                            {
                                "example_id": "44e15b1c-7e04-4d32-bde3-fc349ed1b5ad",
                                "sense_id": "957a8526-1cb4-37fb-a3d5-d325794d0a5b",
                                "text": "„Unterschiedliche Entscheidungsebenen müssen eingebunden werden und der Kommunikationsfluss über die Ebenen hinweg muss gewährleistet sein.“"
                            },
                            {
                                "example_id": "0a44912e-c307-4c3c-9858-4abf559c1ec0",
                                "sense_id": "957a8526-1cb4-37fb-a3d5-d325794d0a5b",
                                "text": "„Die Vielfalt der Entscheidungserfordernisse des Finanzmanagements läßt sich in eine dispositive, operative und strategische Entscheidungsebene unterteilen.“"
                            },
                            {
                                "example_id": "4cf9d2b5-1cf1-4ad5-b599-2ba7505304d3",
                                "sense_id": "957a8526-1cb4-37fb-a3d5-d325794d0a5b",
                                "text": "„Das Management vollzieht sich damit im Krankenhaus auf strategischer Entscheidungsebene, dispositiver Entscheidungsebene und operativer Entscheidungsebene.“"
                            },
                            {
                                "example_id": "17f3f041-b5ee-47e3-bed3-aa8c59f2fe24",
                                "sense_id": "957a8526-1cb4-37fb-a3d5-d325794d0a5b",
                                "text": "„Als übergeordnete Entscheidungsebene wird ein headquarter (Unternehmenszentrale) gebildet, in dem die Unternehmensziele festgelegt und die funktionalen Entscheidungsbereiche koordiniert und überwacht werden.“"
                            },
                            {
                                "example_id": "c7e39ce2-c26f-4c4a-9080-107080381b25",
                                "sense_id": "957a8526-1cb4-37fb-a3d5-d325794d0a5b",
                                "text": "„Die Festplatte des Gehirns ist ein Speichermedium, von dem sich die Entscheidungsebene des Gehirns die Informationen abholt.“"
                            },
                            {
                                "example_id": "e0fc8917-60eb-4df4-86e6-6975a8c9f01d",
                                "sense_id": "957a8526-1cb4-37fb-a3d5-d325794d0a5b",
                                "text": "„Dazwischen befindet sich das vernünftige »Ich« als bewusste Vernunft- und Entscheidungsebene.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
