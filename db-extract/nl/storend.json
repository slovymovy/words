                            {
                                "example_id": "ba5e18ee-3c7a-44a6-9c28-045d25e753fa",
                                "sense_id": "369ba1d5-6fb2-3992-b906-c0563bf4034b",
                                "text": "Winkeliers mogen bedragen al sinds 2014 afronden, maar maken weinig gebruik van die mogelijkheid. Veel bedrijven en consumenten ervaren dat als storend, motiveert vicepremier Kris Peeters het besluit."
                            },
                            {
                                "example_id": "6afdc192-bd01-412f-abb9-f4da9dfc3a99",
                                "sense_id": "369ba1d5-6fb2-3992-b906-c0563bf4034b",
                                "text": "Voor een auto van deze prijs is het interieur voorbeeldig, er is bijna geen staal te zien en op de plek waar dit wel gebeurt (deuren) is het niet storend."
                            }
                        ]
                    }
