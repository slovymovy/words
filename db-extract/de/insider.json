                    },
                    {
                        "translation_id": "5bf37f98-846f-4dcb-bfc7-9dcd49520ae9",
                        "source_entry_id": "24ae2a7c-b044-3947-89e8-ff9af0f30c86",
                        "source_sense_id": "0a2d5236-ea9d-3ba2-a86e-fe191765047c",
                        "source_sense_description": "Witz, den man nur versteht, wenn man bestimmte Hintergrundinformationen kennt",
                        "target_lang_word": "in-joke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
