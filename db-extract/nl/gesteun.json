                "forms": [],
                "senses": [
                    {
                        "sense_id": "470d480c-3132-37a1-b30e-3f63695b8e27",
                        "entry_id": "698dab11-2fe6-3c40-8a63-2f247b1308f5",
                        "glosses": [
                            "een voortdurend klagend, zuchtend, steunend geluid maken als tegen van vermoeidheid en ontevredenheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa15aad-1dd1-49b1-bd03-e29569f91926",
                                "sense_id": "470d480c-3132-37a1-b30e-3f63695b8e27",
                                "text": "Geen kapotgemediatrainde quotes, geen onnavolgbare tactische beschouwingen, geen gezucht en gesteun bij een vervelende vraag. Soms gaf hij een antwoord zo gecompliceerd, dat je er nog dagen op kunt kauwen, soms had hij aan een paar woorden genoeg."
                            },
                            {
                                "example_id": "ffe26ce7-340f-44bd-8ce6-f7655d76640b",
                                "sense_id": "470d480c-3132-37a1-b30e-3f63695b8e27",
                                "text": "De PVV'ers die de afgelopen dagen zijn opgestapt, hebben de uitspraken van Geert Wilders over Marokkanen aangegrepen om de partij de rug toe te keren. 'Ik hoorde al langer gezucht en gesteun onder PVV'ers."
                            }
                        ]
                    }
                ],
