                        "entry_id": "2016a599-b8e1-35b1-ba60-f2a337da0dcf",
                        "glosses": [
                            "Bahnhof, der im Westen von etwas (einer Stadt, Land oder dergleichen) liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a69da9-8eec-4397-bc32-e5805b4c7607",
                                "sense_id": "589a2fe5-7a8b-336c-8a53-2b417bf81754",
                                "text": "„Sobald der Orientexpress in den Westbahnhof von Wien einfuhr, würden Mary, Justine und Diana eine Kutsche nehmen und zu Mrs Nortons Wohnung fahren.“"
                            },
                            {
                                "example_id": "2cb18ecf-ac7a-4554-a5d4-8f083a982c7a",
                                "sense_id": "589a2fe5-7a8b-336c-8a53-2b417bf81754",
                                "text": "„Vom Westbahnhof fuhren früher die Züge in Richtung Westen, vor allem nach Wien.“"
                            }
                        ],
