                "senses": [
                    {
                        "sense_id": "ee41922e-36c8-3741-bcbe-27387a4e4f57",
                        "entry_id": "ca47d0f9-5bed-3370-a791-f1ed98433874",
                        "glosses": [
                            "waardeloze persoon"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ec54cae1-2e82-44cd-bbbe-df2fb262a6e2",
                                "sense_id": "ee41922e-36c8-3741-bcbe-27387a4e4f57",
                                "text": "Als ik een paar maanden niet naar college was geweest, dacht ik: wat zou Gunnar daarvan vinden? Elke keer als ik een beetje over de schreef ging, dook Gunnar in mijn gedachten op. Dat had niets met hem als persoon te maken, het was mijn eigen werk, maar helemaal nergens op gebaseerd was het niet: de zomer dat ik schreef aan wat mijn debuut zou worden, logeerde ik bij mama in JoIster, ik was achtentwintig, en toen ik op een middag bij oma's zus Borghild op bezoek was om het er met haar over te hebben hoe het leven op de boerderij er vroeger had uitgezien, aangezien ik dat in mijn roman wilde gebruiken, was Gunnar bij mama langs geweest en hij had haar erop aangesproken dat ik zo'n slampamper en nietsnut was die het nooit ver zou schoppen."
                            },
                            {
                                "example_id": "20165793-b8e6-4989-8c61-17647f25955c",
                                "sense_id": "ee41922e-36c8-3741-bcbe-27387a4e4f57",
                                "text": "Rond half zes zaten Emile en ik aan de koffie. Toen riep Emile uit het niets: Stelletje slampampers, we moeten langs de deuren! Ik viel van m'n stoel van het lachen want ik had nog nooit van het woord slampamper gehoord. Bij deze wil ik slampamper nomineren voor het woord van het jaar.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "50d47354-1a40-3cf8-9aab-051775720528",
                        "entry_id": "ca47d0f9-5bed-3370-a791-f1ed98433874",
                        "glosses": [
                            "iemand die veel alcohol drinkt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b7280b53-daa9-3a0a-b2e8-881a2e271a2a",
                        "entry_id": "ca47d0f9-5bed-3370-a791-f1ed98433874",
                        "glosses": [
                            "een stalen pen die door de laatste schalm van de ankerketting wordt gestoken om als laatste zekering de ketting aan het schip te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8703a8fe-e43a-405c-a767-19af3a6b4258",
                                "sense_id": "b7280b53-daa9-3a0a-b2e8-881a2e271a2a",
                                "text": "De schipper van de Zeemanshoop adviseerde daarop om het anker te laten gaan door de slampamper, de borgpen van het anker aan het schip, te verwijderen."
                            }
                        ]
                    }
                ],
