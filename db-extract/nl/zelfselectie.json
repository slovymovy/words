                        "glosses": [
                            "automatisch, door zichzelf onderscheid maken tussen verschillende leden van een groep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9479b77-1c9e-43c3-be86-6d5e4198ac10",
                                "sense_id": "2e3d02e1-bfe3-3bf9-8641-c43697cd3438",
                                "text": "Daarover zegt De Nie: ,,Deze selecterende maatregelen hebben natuurlijk effect op scholieren. Bij ons nemen de zorgen toe dat dit leidt tot verkeerde vormen van zelfselectie."
                            },
                            {
                                "example_id": "2fa1d855-3d15-4d4a-ac69-061ab50baf97",
                                "sense_id": "2e3d02e1-bfe3-3bf9-8641-c43697cd3438",
                                "text": "Het was verrassend veilig in het gebruik dankzij de zelfselectie: alleen kinderen die goed konden klimmen, kwamen bovenin. De piramide was ook een levendig sociaal ontmoetingspunt en een gezichtsbepalend baken van het plein."
                            }
                        ]
