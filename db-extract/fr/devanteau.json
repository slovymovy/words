                "senses": [
                    {
                        "sense_id": "cf603b2a-1fbe-3c41-b233-a601b2fbc563",
                        "entry_id": "1e0b45c3-6431-3228-8457-37cc9aae58a1",
                        "glosses": [
                            "Sorte de petit tablier d'ornement du vêtement féminin."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7353fc13-ca1d-4b65-b70f-8ebaab8a4aa7",
                                "sense_id": "cf603b2a-1fbe-3c41-b233-a601b2fbc563",
                                "text": "Le devanteau est un tablier que ne portent plus au XVIIᵉ siècle que les paysannes, mais qui existe encore dans le costume traditionnel de plusieurs provinces (Bretagne)."
                            },
                            {
                                "example_id": "73992434-7a5f-41f5-a04b-a7561d846244",
                                "sense_id": "cf603b2a-1fbe-3c41-b233-a601b2fbc563",
                                "text": "Aussitôt j'enfouis mon visage dans le devanteau blanc et empesé de ma nourrice, qui m'entoura les épaules de ses bras pour me presser contre elle et me pacifier sur le ton de la gronderie, de la goguenarderie, presque, […]."
                            },
                            {
                                "example_id": "97f08d50-d3b2-472d-ba4f-99f46fb5b6a8",
                                "sense_id": "cf603b2a-1fbe-3c41-b233-a601b2fbc563",
                                "text": "Les devanteaux ou devantières étaient des espèces de tabliers d'un seul morceau en hauteur, en forme de jupon , dont les femmes se servaient pour monter à cheval , afin de conserver leurs vêtements. Ce mot est encore usité dans ce sens à la campagne."
                            }
                        ]
                    }
