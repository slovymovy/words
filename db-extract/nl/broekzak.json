                                        "sense_id": "e09e9724-b0bc-34bc-addc-05af6c875764",
                                        "entry_id": "35954e65-d902-3a2c-9424-e6a86d46d61e",
                                        "glosses": [
                                            "A small, isolated group or area."
                                        ],
                                        "tags": [],
