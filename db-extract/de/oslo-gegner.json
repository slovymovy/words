                    {
                        "sense_id": "0a194b25-21cd-3a88-b535-f86893b99e5a",
                        "entry_id": "1fdd0c13-04c3-3f4b-bb97-4d9fc1cbe39c",
                        "glosses": [
                            "Person, die den Oslo-Friedensprozess zur Lösung des Nahostkonflikts ablehnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb30ce9e-029a-4085-bbbf-402b25014524",
                                "sense_id": "0a194b25-21cd-3a88-b535-f86893b99e5a",
                                "text": "„Doch Oslo-Gegner, jüdische wie palästinensische, bereiteten Dannys Hoffnungen gewaltsam ein Ende.“"
                            },
                            {
                                "example_id": "e34c2774-d9d0-4d68-a3e7-77e324a8b929",
                                "sense_id": "0a194b25-21cd-3a88-b535-f86893b99e5a",
                                "text": "„Seine Arbeiterpartei verlor 1996 die Macht an die Likud-Partei unter Netanjahu und damit an das Lager der Oslo-Gegner, die seitdem bis auf eine kurze Unterbrechung (1999–2001) die Regierungspolitik dominieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
