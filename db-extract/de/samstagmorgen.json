                        ],
                        "form": "die Samstagmorgen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2f64dd1-d5ed-3425-96b0-5ac79ece4ce3",
                        "entry_id": "326efb4b-9ecc-3cd6-a292-37e7b4866ec8",
                        "glosses": [
                            "der Morgen eines Samstages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "818a2d01-be6b-4c0d-8c17-a3e0631bddd3",
                                "sense_id": "b2f64dd1-d5ed-3425-96b0-5ac79ece4ce3",
                                "text": "Samstagmorgen musst du früh aufstehen."
                            },
                            {
                                "example_id": "9d46d208-b317-4fdc-8c43-f23e163645bd",
                                "sense_id": "b2f64dd1-d5ed-3425-96b0-5ac79ece4ce3",
                                "text": "An Samstagmorgen lassen wir es immer ruhiger angehen."
                            },
                            {
                                "example_id": "c109367f-c41e-4ddc-a54a-5dce54839bd9",
                                "sense_id": "b2f64dd1-d5ed-3425-96b0-5ac79ece4ce3",
                                "text": "„Bei einem schweren Verkehrsunfall in Brakel (Kreis Höxter) sind am frühen Samstagmorgen zwei junge Männer im Alter von 20 und 23 Jahren ums Leben gekommen.“"
                            },
                            {
                                "example_id": "98b8435f-3358-414d-a1a3-c1a3861f3686",
                                "sense_id": "b2f64dd1-d5ed-3425-96b0-5ac79ece4ce3",
                                "text": "„Am Freitagabend kam Carolyn geradewegs vom Flughafen zu mir, und am Samstagmorgen saß ich bereits am Frühstückstisch, als sie in meinem Frotteebademantel aus dem Badezimmer in die Küche marschiert kam und in der ausgestreckten Hand einen halb in Toilettenpapier gewickelten blutigen Tampon hielt.“"
                            },
                            {
                                "example_id": "13c46f10-fbd5-4f39-977d-7b1ffe7f87d4",
                                "sense_id": "b2f64dd1-d5ed-3425-96b0-5ac79ece4ce3",
                                "text": "„In der Stille hallte das Knarren der Schuhe wider – es war nicht viel los an diesem Samstagmorgen spät im November.“"
                            },
                            {
                                "example_id": "e4b44aa8-b348-4a13-8e03-0eae03a04a84",
                                "sense_id": "b2f64dd1-d5ed-3425-96b0-5ac79ece4ce3",
                                "text": "„Am Samstagmorgen wurde Ari von seinem klingelnden Handy geweckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
