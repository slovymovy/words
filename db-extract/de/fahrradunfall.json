                ],
                "senses": [
                    {
                        "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                        "entry_id": "75bc7ace-de8f-3a64-9057-d1b20725c9ee",
                        "glosses": [
                            "Unfall einer Person mit einem Fahrrad, meist durch eine Kollision, einem Sturz oder einem anderen Vorfall, der zu Verletzungen oder Sachschäden führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b251f20c-ab04-4e20-9f4b-e4b9ed9be06b",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "Fahrradunfälle lassen sich vermeiden durch Vorsicht und Rücksicht."
                            },
                            {
                                "example_id": "0b4f3a11-e087-4a36-b16f-39555108dd6b",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "„Am 8. Mai 2021 starb Jahn im Alter von 81 Jahren bei einem Fahrradunfall.“"
                            },
                            {
                                "example_id": "16669830-13a0-4507-9c36-961bb40cd0b1",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "„Selbst der kraftstrotzende und noch relativ junge Ernest hatte ein verbundenes Bein nach einem Fahrradunfall.“"
                            },
                            {
                                "example_id": "bdff477f-0469-49b3-a8b7-12eacf1472f1",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "„Er verletzte sich im vergangenen Herbst bei einem Fahrradunfall in London.“"
                            },
                            {
                                "example_id": "d555b0be-2a98-49c0-afdf-3f62177554f3",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "„Zur Zeit ihrer Schauspielausbildung erlitt sie im Alter von 24 Jahren einen schweren Fahrradunfall, von dem Narben im Gesicht zurückblieben.“"
                            },
                            {
                                "example_id": "d4d0ee95-9889-47d5-874c-db5b384145d6",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "„Auch in Papenburg ereignete sich am Samstagabend ein Fahrradunfall. Dort stießen zwei Radfahrer zusammen.“"
                            },
                            {
                                "example_id": "607b75d9-af9d-4f2a-b59c-43c76c7ab413",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "„Weil er einen tödlichen Fahrradunfall verursacht hat, ist ein 27-Jähriger am Dienstag vom Amtsgericht Hannover zu 9.000 Euro Geldstrafe verurteilt worden.“"
                            },
                            {
                                "example_id": "73f3bb5f-be03-4f13-aa7a-7a790cc0ea69",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "„Bei einem Fahrradunfall brach er sich das Schlüsselbein und musste […] operiert werden.“"
                            },
                            {
                                "example_id": "ee071aed-652f-4216-a9c0-059c43123a23",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "Eine häufige Verletzung bei Fahrradunfällen ist der Schlüsselbeinbruch."
                            },
                            {
                                "example_id": "97500cdc-a9fc-4f7a-aeb9-dd7f7508acf6",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "„Laut Allgemeinem Deutschen Fahrradclub (ADFC) kam es 2020 bei knapp 72 Prozent der Fahrradunfälle, die keine Alleinunfälle waren, zu Zusammenstößen mit Autos. Nur 6,6 Prozent der Verletzten bei Fahrradunfällen resultierten aus Kollisionen mit Fußgängern.“"
                            },
                            {
                                "example_id": "41cb40f2-9704-4591-8f1f-6ddd057100ab",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "Helme schützen vor Schädel-Hirn-Traumata bei Fahrradunfällen."
                            },
                            {
                                "example_id": "a085310c-139d-4c58-ac30-f4dc3d5d27ad",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "„In Österreich passieren pro Jahr mehr als 40.000 Fahrradunfälle, bei denen die Lenker verletzt werden.“"
                            },
                            {
                                "example_id": "73bd9505-ff0a-4c59-aebd-37366b61f8f5",
                                "sense_id": "bcc0e064-6aae-3937-8656-e2dd36e753f9",
                                "text": "„Radfahren boomt, ob als Verkehrsmittel, in der Freizeit oder im Urlaub. Doch gleichzeitig sind auch die tödlichen Fahrradunfälle im letzten Jahrzehnt wieder angestiegen. Im Jahr 2023 verunglückten über 94.000 Radfahrer, 444 davon tödlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
