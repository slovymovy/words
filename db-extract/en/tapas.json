                "entry_id": "fbf78e06-d0a2-3bb8-aea7-d7209bd78a18",
                "word": "tapas",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4c05111a-83de-45fb-9726-dae29b551d13",
