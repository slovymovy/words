                        "translation_id": "9e4c1286-3617-472d-8d08-c930bbf5f977",
                        "source_entry_id": "bd17eb43-4bc6-30a1-8792-302d15afcea1",
                        "source_sense_id": "56768976-2918-370e-bd8b-06bd15c986aa",
                        "target_lang_word": "koala",
