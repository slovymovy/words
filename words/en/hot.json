                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "о вкусе пищи"
                            },
                            {
                                "target_lang_word": "пряный",
                                "target_lang_sense_clarification": "о специях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da500e47-0134-34df-b85c-cbfe6cdfa281",
