                        ],
                        "examples": [
                            {
                                "example_id": "3de00ae4-3572-44e3-96aa-3dc8dc664e15",
                                "sense_id": "d179cf69-458a-3f30-bb6c-ce09661119d9",
                                "text": "BALOCE (PRUNE), sf, Espèce de grosse prune fort commune dans nos campagnes. Roquefort mentionne les prunes baloces."
                            },
                            {
                                "example_id": "5850563b-d75b-43e7-84f2-323c7de9b5c9",
                                "sense_id": "d179cf69-458a-3f30-bb6c-ce09661119d9",
                                "text": "M. Chaurand partant de cette double série beloce : « prunelle » et beloche : « prune », indique qu'en Thiérache, les baloces sont des prunes en général ; on y distingue les baloces à cochon, « petites prunes sauvages qui poussent au bord du chemin » ; […]."
                            }
                        ]
                    }
