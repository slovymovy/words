                    }
                ],
                "senses": [
                    {
                        "sense_id": "a36adc5f-0986-3946-b52d-d88df57aa83a",
                        "entry_id": "d41f59f8-7059-3d4f-8148-29f68e410705",
                        "glosses": [
                            "Qui se rapporte au constitutionnalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d65f91b6-5086-4d8b-8c1a-22ad7b9637de",
                                "sense_id": "a36adc5f-0986-3946-b52d-d88df57aa83a",
                                "text": "De fait, une réunion se tenait ce jour-là à la citadelle. Fazel y annonça que les troupes constitutionnalistes avançaient de Rasht vers Téhéran, que le pouvoir en place était sur le point de s’écrouler et qu’il suffisait de peu pour assister à sa chute."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "1dbf340d-26c3-32d8-a2e3-2d787432b88a",
                "word": "constitutionnaliste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bb246449-bffe-4e50-9264-f47213c3eda9",
                        "entry_id": "1dbf340d-26c3-32d8-a2e3-2d787432b88a",
