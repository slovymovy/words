                                    {
                                        "sense_id": "08213c76-e124-32f4-a38b-ddcb28ac59ce",
                                        "entry_id": "d02cc4ac-1ffe-3ca8-b0dd-5f45fc125171",
                                        "glosses": [
                                            "Fußbekleidung, welche zum Sport in Hallen geeignet ist"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc3e3fc6-6f30-47a2-a038-9d42298c4371",
                                                "sense_id": "08213c76-e124-32f4-a38b-ddcb28ac59ce",
                                                "text": "Joschka Fischer wurde in Turnschuhen vereidigt."
                                            },
                                            {
                                                "example_id": "0716bd3f-98a0-437b-a673-f53826bf17c3",
                                                "sense_id": "08213c76-e124-32f4-a38b-ddcb28ac59ce",
                                                "text": "„Anstatt der Turnschuhe trug ich nur noch die hässlichen, aber durchaus luftig-angenehmen Trekkingsandalen an den Füßen.“"
                                            },
                                            {
                                                "example_id": "3f84bcbe-57ad-4ff8-bd26-8dc8bbb84abf",
                                                "sense_id": "08213c76-e124-32f4-a38b-ddcb28ac59ce",
                                                "text": "„Sven stand auf und bohrte eine Weile mit der Spitze seines Turnschuhs im Sand.“"
                                            },
                                            {
                                                "example_id": "8f87e2a1-dacd-43a8-bd74-52ad100cb5f4",
                                                "sense_id": "08213c76-e124-32f4-a38b-ddcb28ac59ce",
                                                "text": "„Die löchrigen Turnschuhe an seinen Füßen kommen mir bekannt vor.“"
                                            },
                                            {
                                                "example_id": "3da15438-8127-473d-91ce-fb54cd0ba234",
                                                "sense_id": "08213c76-e124-32f4-a38b-ddcb28ac59ce",
                                                "text": "„Ich sah die zerschlissenen Turnschuhe der Physiotherapeutin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a22e947d-2841-3863-8529-d57691ae3455",
                                        "entry_id": "d02cc4ac-1ffe-3ca8-b0dd-5f45fc125171",
