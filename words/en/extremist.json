{
    "word_family": [
        "extreme",
        "extremism",
        "extremity",
        "extremely"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f1c42bd-4011-3af1-9dd4-e3a44f412bfb",
                    "sense_definition": "A person who holds extreme views, especially one who advocates such views; a radical or fanatic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extremism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is concerned about the influence of <w>extremists</w> on young people.",
                            "target_lang_translations": {
                                "ru": "Правительство обеспокоено влиянием <w>экстремистов</w> на молодежь."
                            }
                        },
                        {
                            "text": "A political <w>extremist</w> was arrested for inciting violence during the protest.",
                            "target_lang_translations": {
                                "ru": "Политический <w>экстремист</w> был арестован за подстрекательство к насилию во время протеста."
                            }
                        }
                    ],
                    "synonyms": [
                        "jusquaboutist"
                    ],
                    "antonyms": [
                        "moderate"
                    ],
                    "common_phrases": [
                        "political extremist",
                        "religious extremist",
                        "violent extremist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, придерживающийся крайних взглядов и мер, часто радикального или фанатичного характера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экстремист",
                                "target_lang_sense_clarification": "человек с крайними взглядами"
                            },
                            {
                                "target_lang_word": "радикал",
                                "target_lang_sense_clarification": "сторонник решительных мер"
                            },
                            {
                                "target_lang_word": "фанатик",
                                "target_lang_sense_clarification": "человек, страстно преданный идее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c8472215-8e67-392c-ae4f-ab231d021853",
                    "sense_definition": "Holding extreme views, especially on a political or religious subject.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extremism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group is known for its <w>extremist</w> views regarding environmental protection.",
                            "target_lang_translations": {
                                "ru": "Группа известна своими <w>экстремистскими</w> взглядами на защиту окружающей среды."
                            }
                        },
                        {
                            "text": "There are some minor <w>extremist</w> movements that are antiforeigner.",
                            "target_lang_translations": {
                                "ru": "Существуют некоторые мелкие <w>экстремистские</w> движения, направленные против иностранцев."
                            }
                        }
                    ],
                    "antonyms": [
                        "moderate"
                    ],
                    "common_phrases": [
                        "extremist views",
                        "extremist ideology",
                        "extremist group"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придерживающийся крайних взглядов, особенно в политике или религии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экстремистский",
                                "target_lang_sense_clarification": "о взглядах или убеждениях"
                            },
                            {
                                "target_lang_word": "радикальный",
                                "target_lang_sense_clarification": "крайний, решительный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc726906-fe1a-3dca-9e98-9aa0e4d4af98",
                    "sense_definition": "Of or relating to extremism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "extremism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police monitored the <w>extremist</w> rhetoric being spread on social media.",
                            "target_lang_translations": {
                                "ru": "Полиция отслеживала <w>экстремистскую</w> риторику, распространяемую в социальных сетях."
                            }
                        },
                        {
                            "text": "The report analyzed the growth of <w>extremist</w> organizations across the continent.",
                            "target_lang_translations": {
                                "ru": "В докладе анализируется рост <w>экстремистских</w> организаций по всему континенту."
                            }
                        }
                    ],
                    "common_phrases": [
                        "extremist rhetoric",
                        "extremist organization"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к экстремизму или связанный с ним."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экстремистский",
                                "target_lang_sense_clarification": "связанный с деятельностью экстремистов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}