                        "glosses": [
                            "Donner un caractère nodal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "522227a4-4fa2-4d7c-95e4-0cb5c4a0d4e2",
                                "sense_id": "835dc802-0572-3b76-b268-1295d8924440",
                                "text": "Dans l’hypothèse de la suppléance, la quatrième consistance, suppléance à la carence paternelle, vient à nodaliser le symbolique détaché des deux autres, l’imaginaire et le réel."
                            },
                            {
                                "example_id": "6e590cee-6472-4755-bd35-326c636cabcc",
                                "sense_id": "835dc802-0572-3b76-b268-1295d8924440",
                                "text": "Pareille procédure implique réciprocité : l’ob-sujet doit nodaliser de son côté l’objet désiré par le sujet pour que l’échange ait lieu."
                            }
                        ]
                    }
