                ],
                "senses": [
                    {
                        "sense_id": "1d77e2c4-e8b3-38c9-a25a-56f4d7919651",
                        "entry_id": "a3efd937-281b-35a3-ba4c-857e2e08581d",
                        "glosses": [
                            "спец. связанный, соотносящийся по значению с существительным предикат"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48d48074-cc59-4b98-9870-914e41cf679e",
                        "source_entry_id": "a3efd937-281b-35a3-ba4c-857e2e08581d",
                        "source_sense_id": "1d77e2c4-e8b3-38c9-a25a-56f4d7919651",
                        "target_lang_word": "predicative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "predicative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "177fa6c5-42f3-31a6-b480-91cf63558ba5",
                                        "entry_id": "b381aa12-60f5-331f-8b5f-87275c0d2dd6",
                                        "glosses": [
                                            "Modifying a noun from within a predicate. contrasts with attributive."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7dea9db-7626-4f2d-9a1e-abeda3639b43",
                                                "sense_id": "177fa6c5-42f3-31a6-b480-91cf63558ba5",
                                                "text": "In the sentence, ‘This house is big’, ‘big’ is predicative, whereas in ‘This is a big house’, it is attributive."
                                            },
                                            {
                                                "example_id": "1f519401-aad0-4b12-b3a3-dcb0358286d5",
                                                "sense_id": "177fa6c5-42f3-31a6-b480-91cf63558ba5",
                                                "text": "Compound adjectives are typically hyphenated in attributive position (for example, 'a high-quality scan is a must'), whereas in predicative position, many house styles specify open styling (for example, 'this scan is high quality.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "predicative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50d4703f-1724-366c-aef6-56af9e8d14ac",
                                        "entry_id": "c8d16223-36be-336f-94b4-fa540d10ab11",
                                        "glosses": [
                                            "An element of the predicate of a sentence which complements the subject or object by means of the verb. Predicatives may be nominal or adjectival."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "854c4280-97c6-3706-a7aa-a5e6f6d35978",
                                        "entry_id": "c8d16223-36be-336f-94b4-fa540d10ab11",
                                        "glosses": [
                                            "In some languages, a special part of speech used as a predicate and denoting a state of being."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6f1120c-8644-4435-a4b5-207db2a29164",
                                                "sense_id": "854c4280-97c6-3706-a7aa-a5e6f6d35978",
                                                "text": "A predicative in Russian is an uninflected word that regularly constitutes a complete utterance when standing alone, i.e., when preceded and followed by silence."
                                            },
                                            {
                                                "example_id": "12898d92-2854-4624-a2a0-d6111cf22b16",
                                                "sense_id": "854c4280-97c6-3706-a7aa-a5e6f6d35978",
                                                "text": "Traditional grammars usually differentiate between neuter short adjectives and predicatives based on whether there is an overt nominative subject; hence курение вредно ‘smoking (noun) is harmful’ is viewed as a clause with nominative subject, zero copula and neuter short form adjective that agrees with the subject in gender, whereas курить вредно (same meaning, literally ‘to smoke is harmful’) is often viewed as an impersonal clause with predicative."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a86719ae-97e1-4286-9dc4-1e6c4339b737",
                        "source_entry_id": "a3efd937-281b-35a3-ba4c-857e2e08581d",
                        "source_sense_id": "1d77e2c4-e8b3-38c9-a25a-56f4d7919651",
                        "target_lang_word": "predicate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "predicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6a3b061-39f4-3c68-8fc1-44fbb0fa707a",
                                        "entry_id": "9d271071-453f-328c-9a52-def928966bb8",
                                        "glosses": [
                                            "The part of the sentence (or clause) which states a property that a subject has or is characterized by."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf63925a-aa2d-403e-8b3a-27daaa5c99fa",
                                                "sense_id": "e6a3b061-39f4-3c68-8fc1-44fbb0fa707a",
                                                "text": "In the light of this observation, consider Number Agreement in a sentence like:\n (120) They seem to me [_S — to be fools/^✽a fool]\n Here, the Predicate Nominal fools agrees with the italicised NP they, in spite of the fact that (as we argued earlier) the two are contained in different Clauses at S-structure. How can this be? Under the NP MOVEMENT analysis of seem structures, sentences like (120) pose no problem; if we suppose that they originates in the — position as the subordinate Clause Subject, then we can say that the Predicate Nominal agrees with the underlying Subject of its Clause. How does they get from its underlying position as subordinate Clause Subject to its superficial position as main Clause Subject? By NP MOVEMENT, of course!"
                                            },
                                            {
                                                "example_id": "a780b2df-aacd-4ebf-8085-d52d9c24103e",
                                                "sense_id": "e6a3b061-39f4-3c68-8fc1-44fbb0fa707a",
                                                "text": "Thus, in (121) (a) persuade is clearly a three-place Predicate — that is, a Predicate which takes three Arguments: the first of these Arguments is the Subject NP John, the second is the Primary Object NP Mary, and the third is the Secondary Object S-bar [that she should resign]. By contrast, believe in (121) (b) is clearly a two-place Predicate (i.e. a Predicate which has two Arguments): its first Argument is the Subject NP John, and its second Argument is the Object S-bar [that Mary was innocent]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef0d7652-3c93-3e33-8da3-4efb56878d18",
                                        "entry_id": "9d271071-453f-328c-9a52-def928966bb8",
                                        "glosses": [
                                            "A term of a statement, where the statement may be true or false depending on whether the thing referred to by the values of the statement's variables has the property signified by that (predicative) term."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f5e834-20c5-4eeb-a97a-80a22cf65cc0",
                                                "sense_id": "ef0d7652-3c93-3e33-8da3-4efb56878d18",
                                                "text": "A propositional variable may be treated as a nullary predicate."
                                            },
                                            {
                                                "example_id": "259a15cf-3bd1-43f9-9557-54048dfbbf31",
                                                "sense_id": "ef0d7652-3c93-3e33-8da3-4efb56878d18",
                                                "text": "A predicate is either valid, satisfiable, or unsatisfiable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aefcdb0-4cfd-31a2-9f6b-f3323c4ad7d2",
                                        "entry_id": "9d271071-453f-328c-9a52-def928966bb8",
                                        "glosses": [
                                            "An operator or function that returns either true or false."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "predicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "987ecac8-a856-3dd3-9f11-75285f5ec567",
                                        "entry_id": "adb9705d-c7cd-3e8c-bf5a-b2e9d8c8e49b",
                                        "glosses": [
                                            "Of or related to the predicate of a sentence or clause."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1e206ee-1878-30f0-95f8-e9c9e528a75f",
                                        "entry_id": "adb9705d-c7cd-3e8c-bf5a-b2e9d8c8e49b",
                                        "glosses": [
                                            "Predicated, stated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1339ded7-8614-31af-a6b3-f70360eb4cb1",
                                        "entry_id": "adb9705d-c7cd-3e8c-bf5a-b2e9d8c8e49b",
                                        "glosses": [
                                            "Relating to or being any of a series of criminal acts upon which prosecution for racketeering may be predicated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "predicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c253dd8f-361e-3884-af49-bdf6986726d0",
                                        "entry_id": "e6b53773-ad5a-34fb-b38d-3b09b2454742",
                                        "glosses": [
                                            "To announce, assert, or proclaim publicly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07fc1425-20a7-31ff-8a62-061acb387d22",
                                        "entry_id": "e6b53773-ad5a-34fb-b38d-3b09b2454742",
                                        "glosses": [
                                            "To assume or suppose; to infer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd4cfaae-0bcf-4e92-9853-7a0c6e881642",
                                                "sense_id": "07fc1425-20a7-31ff-8a62-061acb387d22",
                                                "text": "There was a character about Madame Defarge, from which one might have predicated that she did not often make mistakes against herself in any of the reckonings over which she presided."
                                            },
                                            {
                                                "example_id": "b4eb58a3-4af4-4853-9948-3f8ef2c81d18",
                                                "sense_id": "07fc1425-20a7-31ff-8a62-061acb387d22",
                                                "text": "Of anyone else it would have been said that she was finding the afternoon rather dreary in the vast halls not of her forefathers: but of Miss Power it was unsafe to predicate so surely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a03b208f-0233-315d-904a-7a1fad227fbf",
                                        "entry_id": "e6b53773-ad5a-34fb-b38d-3b09b2454742",
                                        "glosses": [
                                            "to base (on); to assert on the grounds of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14e47d0c-4213-4a0f-9de0-7e0765912c45",
                                                "sense_id": "a03b208f-0233-315d-904a-7a1fad227fbf",
                                                "text": "The law is what constitutes both desire and the lack on which it is predicated."
