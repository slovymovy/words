                "senses": [
                    {
                        "sense_id": "53a5a198-222d-3688-9ebb-0fb3604ce7a6",
                        "entry_id": "373ec476-5a54-31c4-aa0b-78e105a86a62",
                        "glosses": [
                            "Parlament der Europäischen Union"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6801b99-b5c7-48e1-978a-edf9c5f41707",
                                "sense_id": "53a5a198-222d-3688-9ebb-0fb3604ce7a6",
                                "text": "„Arbeitsorte des Europaparlaments sind neben Straßburg auch Brüssel und Luxemburg. Regelungen zu Organisation und Arbeitsweise enthält die Geschäftsordnung des Europäischen Parlaments.“"
                            },
                            {
                                "example_id": "0843db60-dd27-4772-ab60-56158b4b9549",
                                "sense_id": "53a5a198-222d-3688-9ebb-0fb3604ce7a6",
                                "text": "„Die SPD, die 2004 nur auf 21,5 Prozent und 23 Sitze in Straßburg gekommen war, tritt mit dem Fraktionschef der Sozialisten im Europaparlament, Martin Schulz, als Spitzenkandidat an.“"
                            },
                            {
                                "example_id": "de725b7a-bd9d-4e79-838e-47eae105d0f1",
                                "sense_id": "53a5a198-222d-3688-9ebb-0fb3604ce7a6",
                                "text": "„Sollte es am Montag bis Mitternacht keine Einigung zwischen Europaparlament, Kommission und Mitgliedstaaten geben, muss die EU-Kommission einen neuen Budgetentwurf vorlegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
