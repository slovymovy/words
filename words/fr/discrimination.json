    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea786981-f941-3d96-accc-24a6871026c7",
                    "sense_definition": "Traitement défavorable et inégalitaire infligé à une personne ou à un groupe en raison de critères tels que l'origine, le sexe ou la religion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "injustice_sociale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La loi interdit toute forme de <w>discrimination</w> à l'embauche fondée sur le genre et l'âge."
                        },
                        {
                            "text": "Cette organisation lutte activement contre la <w>discrimination</w> raciale dans les écoles et les entreprises."
                        }
                    ],
                    "synonyms": [
                        "ségrégation",
                        "inégalité"
                    ],
                    "antonyms": [
                        "discrimination positive",
                        "traitement de faveur",
                        "piston"
                    ],
                    "common_phrases": [
                        "discrimination raciale",
                        "lutter contre la discrimination",
                        "victime de discrimination"
                    ]
                },
                {
                    "sense_id": "5095c984-d2c5-364a-a2a3-475994e6d8a3",
                    "sense_definition": "Action de distinguer nettement des choses ou des personnes en observant leurs différences.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'analyste doit opérer une <w>discrimination</w> rigoureuse entre les données fiables et les rumeurs."
                        },
                        {
                            "text": "Il est parfois difficile de faire la <w>discrimination</w> entre deux espèces végétales très proches."
                        }
                    ],
                    "synonyms": [
                        "distinction",
                        "différenciation",
                        "discernement"
                    ],
                    "common_phrases": [
                        "faire la discrimination",
                        "opérer une discrimination"
                    ]
                },
                {
                    "sense_id": "6913a674-2f66-3363-8899-b495f32ca5d5",
                    "sense_definition": "Modulation des prix ou des conditions de vente selon les caractéristiques d'un groupe de clients ou d'un marché.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "economie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette compagnie aérienne pratique une <w>discrimination</w> par les prix selon la date d'achat du billet."
                        },
                        {
                            "text": "Les autorités de régulation surveillent les risques de <w>discrimination</w> tarifaire abusive sur le marché de l'énergie."
                        }
                    ],
                    "synonyms": [
                        "différenciation tarifaire"
                    ],
                    "common_phrases": [
                        "discrimination par les prix",
                        "discrimination tarifaire"
                    ]
                },
                {
                    "sense_id": "26aabb82-09d8-3f7e-a6aa-271494fe4a49",
                    "sense_definition": "Principe de droit militaire imposant de distinguer les cibles militaires des populations et biens civils lors d'une attaque.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit_guerre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le principe de <w>discrimination</w> interdit de viser délibérément des infrastructures civiles durant une offensive."
                        },
                        {
                            "text": "Cette frappe aérienne a violé l'obligation légale de <w>discrimination</w> entre combattants et civils."
                        }
                    ],
                    "common_phrases": [
                        "principe de discrimination"
                    ]
                }
            ]
        }
    ]
