                        "entry_id": "029b480a-7d51-3d46-966c-73d44cfa919c",
                        "glosses": [
                            "ein trennendes oder verbindendes Element zwischen Räumen oder Bereichen aus Kunststoff; Tür aus Kunststoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ee3f77a-2001-4cc4-9cc6-c4181386bedc",
                                "sense_id": "673e0ca6-bcb2-3799-abce-503bc4846477",
                                "text": "„Wie Kunststofffenster sind auch Kunststofftüren nicht nur individuell und fast grenzenlos in Form und Farbe gestaltbar, der Werkstoff Kunststoff ist modern, robust und überzeugt mit besten Wärmeschutzwerten und Langlebigkeit.“"
                            },
                            {
                                "example_id": "a9c38b40-24c0-4e4d-a3a7-30531ad85f6e",
                                "sense_id": "673e0ca6-bcb2-3799-abce-503bc4846477",
                                "text": "„Um eine angenehme Raumtemperatur zu erhalten, ist es nützlich die Türdichtungen für Kunststofftüren aus TPE regelmäßig zu erneuern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
