                        "examples": [
                            {
                                "example_id": "37be60a6-e2e6-46a4-9636-2af9b5fa07c5",
                                "sense_id": "b2262df1-06e7-373f-b067-b263ba22e854",
                                "text": "Ben je vrolijk? Bekijk dan Bal Tabarin van Jan Sluijters. Ben je verdrietig? Loop dan door naar De spitters van Vincent van Gogh. Heb je een kater? Kies dan voor de violist van Chagall."
                            },
                            {
                                "example_id": "dfd5660f-b000-4eb9-9fc3-f7d863612ba2",
                                "sense_id": "b2262df1-06e7-373f-b067-b263ba22e854",
                                "text": "Bij de Rijkslandbouwschool aan de overkant, tegenwoordig een particulier woonhuis, mag je op afspraak naar binnen om de originele glas-in-loodramen te bekijken: vier gestileerde, bijna abstracte landarbeiders, een spitter, een maaier, een zaaier en een rooier. Voor de kozijnen en de deuren van de school zijn secundaire kleuren gebruikt: paars, groen, oranje."
                            }
                        ]
                    }
