                        ],
                        "examples": [
                            {
                                "example_id": "70e3ebbb-d309-432b-aab0-eac5e2bc002d",
                                "sense_id": "bef148b5-4857-3d5c-852a-25d3c7bc3bd6",
                                "text": "Traffic is brisk, and goods consists of rice, gunny (hessian), maize and native implements."
                            },
                            {
                                "example_id": "eef53f34-250a-4a3e-b876-d3f4a7aea752",
                                "sense_id": "bef148b5-4857-3d5c-852a-25d3c7bc3bd6",
                                "text": "Provisions were ferried by camel in stout sacks of gunny with blocks of ice packed round them; a herculean task."
                            }
                        ]
                    },
