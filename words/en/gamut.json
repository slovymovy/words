{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89a70978-77e8-3fc8-99dc-b94dbefcb029",
                    "sense_definition": "A complete range or scope of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "scope_or_range",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her performance in the play ran the <w>gamut</w> of emotions, from sheer joy to utter heartbreak.",
                            "target_lang_translations": {
                                "pl": "Jej występ w sztuce obejmował całą <w>gamę</w> emocji, od czystej radości po całkowite załamanie."
                            }
                        },
                        {
                            "text": "The exhibition covers the whole <w>gamut</w> of twentieth-century modern art movements.",
                            "target_lang_translations": {
                                "pl": "Wystawa obejmuje pełen <w>wachlarz</w> kierunków w sztuce nowoczesnej XX wieku."
                            }
                        }
                    ],
                    "synonyms": [
                        "spectrum",
                        "range",
                        "scope"
                    ],
                    "common_phrases": [
                        "run the gamut",
                        "whole gamut"
                    ],
                    "target_lang_definitions": {
                        "pl": "Cały zakres, pełna skala lub wachlarz czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gama",
                                "target_lang_sense_clarification": "szeroki wachlarz, pełen zakres"
                            },
                            {
                                "target_lang_word": "wachlarz",
                                "target_lang_sense_clarification": "rozpiętość możliwości, emocji"
                            },
                            {
                                "target_lang_word": "spektrum",
                                "target_lang_sense_clarification": "cały zakres zjawisk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2733f0b-d6f6-344d-a0c0-02bffba2671a",
                    "sense_definition": "A complete series of recognized musical notes; the full scale or compass of a voice or instrument.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scope_or_range",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer struggled to reach the lowest notes of the vocal <w>gamut</w>.",
                            "target_lang_translations": {
                                "pl": "Śpiewak miał trudności z osiągnięciem najniższych dźwięków swojej <w>skali</w> głosu."
                            }
                        },
                        {
                            "text": "Medieval musicians studied the traditional <w>gamut</w> to master pitch and notation.",
                            "target_lang_translations": {
                                "pl": "Średniowieczni muzycy studiowali tradycyjną <w>gamę</w>, aby opanować wysokość dźwięków i notację."
                            }
                        }
                    ],
                    "synonyms": [
                        "scale"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pełny szereg dźwięków muzycznych; pełna skala lub rozpiętość głosu lub instrumentu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skala",
                                "target_lang_sense_clarification": "muzyczna, rozpiętość dźwięków"
                            },
                            {
                                "target_lang_word": "gama",
                                "target_lang_sense_clarification": "szereg dźwięków"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8c9518b-8e22-3c8c-b653-419a9808a645",
                    "sense_definition": "The entire range of colors that can be accurately produced or displayed by a device such as a monitor or printer.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scope_or_range",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This professional monitor supports a wide color <w>gamut</w> suitable for graphic design work.",
                            "target_lang_translations": {
                                "pl": "Ten profesjonalny monitor obsługuje szeroki <w>gamut</w> kolorów, odpowiedni do pracy przy projektowaniu graficznym."
                            }
                        },
                        {
                            "text": "Some vibrant greens fall outside the printable <w>gamut</w> of standard ink cartridges.",
                            "target_lang_translations": {
                                "pl": "Niektóre jaskrawe zielenie wykraczają poza możliwą do wydrukowania <w>paletę barw</w> standardowych wkładów atramentowych."
                            }
                        }
                    ],
                    "common_phrases": [
                        "color gamut"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pełen zakres barw możliwy do wyświetlenia lub wydrukowania przez dane urządzenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gamut",
                                "target_lang_sense_clarification": "przestrzeń barw w grafice komputerowej"
                            },
                            {
                                "target_lang_word": "paleta barw",
                                "target_lang_sense_clarification": "zakres dostępnych kolorów"
                            },
                            {
                                "target_lang_word": "przestrzeń barwna",
                                "target_lang_sense_clarification": "zakres reprodukcji barw"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}