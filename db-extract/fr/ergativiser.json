                "senses": [
                    {
                        "sense_id": "223066a1-5fe9-38c7-ba63-f3ec10915028",
                        "entry_id": "fb4b30cc-ddf4-3f6f-a3b9-804a01e6759e",
                        "glosses": [
                            "Donner un caractère ergatif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "652ffc09-4ed7-48ea-b711-30a9b15f2c60",
                                "sense_id": "223066a1-5fe9-38c7-ba63-f3ec10915028",
                                "text": "smeralda Vailati Negrao et Evan Viotti nous montrent avec acuité que le brésilien peut « ergativiser » les verbes généralement transitifs."
                            },
                            {
                                "example_id": "8a0882c7-cd83-465b-8a2b-244a993a3758",
                                "sense_id": "223066a1-5fe9-38c7-ba63-f3ec10915028",
                                "text": "Le tour est intéressant car, si behar permet d’ergativiser l’absol. de la phrase complément, c’est lorsque l’ergatif en est absent (impersonnel)."
                            },
                            {
                                "example_id": "165da91e-c4e3-44fe-b020-0d8bb79ab05d",
                                "sense_id": "223066a1-5fe9-38c7-ba63-f3ec10915028",
                                "text": "Le hindi comme les autres langues de nord de l’Inde offre l’exemple d’une langue qui s’est ergativisée (voir 2.4), et qui est vraisemblablement en voie de désergativation."
                            }
                        ]
                    }
