                    {
                        "translation_id": "a029b0da-d0b8-42c2-9d36-ef4e0eef4125",
                        "source_entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                        "source_sense_description": "of or relating to the Amazons",
                        "target_lang_word": "amazonien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
