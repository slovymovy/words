{
    "word_family": [
        "atilt"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09205bcf-224b-3e33-af94-dd73c2d9a181",
                    "sense_definition": "To slope or incline (something); to slant.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_angle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>tilt</w> her head to read the small print on the label.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>наклонить</w> голову, чтобы прочитать мелкий шрифт на этикетке.",
                                "zh": "她不得不<w>倾斜</w>头部，才能看清标签上的小字。"
                            }
                        },
                        {
                            "text": "If you <w>tilt</w> the table too much, the water will run off the side.",
                            "target_lang_translations": {
                                "ru": "Если слишком сильно <w>наклонить</w> стол, вода стечет через край.",
                                "zh": "如果你把桌子<w>倾斜</w>得太厉害，水就会从边上流走。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slope",
                        "incline",
                        "slant"
                    ],
                    "antonyms": [
                        "straighten"
                    ],
                    "common_phrases": [
                        "tilt the head",
                        "tilt forward",
                        "tilt back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклонять или придавать наклонное положение чему-либо.",
                        "zh": "使某物倾斜或处于倾斜状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклонять",
                                "target_lang_sense_clarification": "изменять положение на наклонное"
                            },
                            {
                                "target_lang_word": "накренять",
                                "target_lang_sense_clarification": "наклонять вбок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾斜",
                                "target_lang_sense_clarification": "使物体偏离垂直或水平位置"
                            },
                            {
                                "target_lang_word": "歪",
                                "target_lang_sense_clarification": "使物体偏斜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8836499c-15b1-31d8-b61c-d07dbfc5976c",
                    "sense_definition": "To enter a state of frustration and worsened performance resulting from a series of losses, especially in gaming.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming_frustration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started to <w>tilt</w> after losing the first round of the tournament.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>тильтовать</w> после проигрыша в первом раунде турнира.",
                                "zh": "在输掉比赛的第一轮后，他开始<w>心态崩了</w>。"
                            }
                        },
                        {
                            "text": "Try not to <w>tilt</w> when the game gets difficult, or you will make more mistakes.",
                            "target_lang_translations": {
                                "ru": "Старайся не <w>тильтовать</w>, когда игра становится сложной, иначе наделаешь еще больше ошибок.",
                                "zh": "当游戏变难时尽量不要<w>上头</w>，否则你会犯更多错误。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in gaming and poker contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Впадать в состояние разочарования и злости из-за проигрышей (обычно в играх).",
                        "zh": "指在游戏或竞技中因连续失败而陷入沮丧、愤怒并导致表现下降的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тильтовать",
                                "target_lang_sense_clarification": "игровой сленг: терять контроль из-за эмоций"
                            },
                            {
                                "target_lang_word": "психовать",
                                "target_lang_sense_clarification": "разговорное: нервничать, злиться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心态崩了",
                                "target_lang_sense_clarification": "游戏俚语：因情绪失控而导致操作变形"
                            },
                            {
                                "target_lang_word": "上头",
                                "target_lang_sense_clarification": "口语：因情绪激动而失去理智"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d0c9790-3619-33de-8343-c634b29e062f",
                    "sense_definition": "To charge at someone with a lance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jousting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, knights would <w>tilt</w> at each other during tournaments.",
                            "target_lang_translations": {
                                "ru": "В Средние века рыцари <w>сражались на копьях</w> друг с другом во время турниров.",
                                "zh": "在中世纪，骑士们会在锦标赛中互相<w>持矛冲锋</w>。"
                            }
                        },
                        {
                            "text": "Critics say the politician is just <w>tilting</w> at windmills with his new proposal.",
                            "target_lang_translations": {
                                "ru": "Критики говорят, что этот политик просто <w>сражается</w> с ветряными мельницами, выдвигая свое новое предложение.",
                                "zh": "批评人士称，这位政客的新提案不过是与风车作战，徒劳无功。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tilt at windmills"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Атаковать противника копьём (в рыцарском поединке).",
                        "zh": "在中世纪骑士比武中，持长矛向对手发起冲锋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сражаться на копьях",
                                "target_lang_sense_clarification": "участвовать в поединке"
                            },
                            {
                                "target_lang_word": "атаковать",
                                "target_lang_sense_clarification": "нападать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "持矛冲锋",
                                "target_lang_sense_clarification": "骑士比武中的攻击动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3c8a453-6c47-33e9-8989-87870d1ef2af",
                    "sense_definition": "A slope or inclination.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_angle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The floor has a slight <w>tilt</w>, so the ball always rolls to the corner.",
                            "target_lang_translations": {
                                "ru": "Пол имеет небольшой <w>наклон</w>, поэтому мяч всегда катится в угол.",
                                "zh": "地板有一点<w>倾斜</w>，所以球总是滚到角落里。"
                            }
                        },
                        {
                            "text": "You can adjust the <w>tilt</w> of the screen to avoid glare from the window.",
                            "target_lang_translations": {
                                "ru": "Вы можете отрегулировать <w>наклон</w> экрана, чтобы избежать бликов от окна.",
                                "zh": "你可以调整屏幕的<w>倾斜</w>角度，以避免窗户的反光。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slope",
                        "incline",
                        "slant"
                    ],
                    "antonyms": [
                        "level"
                    ],
                    "common_phrases": [
                        "on a tilt",
                        "slight tilt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклон или наклонное положение.",
                        "zh": "倾斜的状态或角度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклон",
                                "target_lang_sense_clarification": "положение под углом"
                            },
                            {
                                "target_lang_word": "крен",
                                "target_lang_sense_clarification": "наклон набок (обычно о судне или транспорте)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾斜",
                                "target_lang_sense_clarification": "物体偏离水平或垂直的角度"
                            },
                            {
                                "target_lang_word": "斜度",
                                "target_lang_sense_clarification": "倾斜的程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d43aa884-0323-302d-b594-6648646c6304",
                    "sense_definition": "An attempt at achieving something, such as a competition or public office.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team is preparing for another <w>tilt</w> at the championship title this season.",
                            "target_lang_translations": {
                                "ru": "Команда готовится к очередной <w>попытке</w> завоевать чемпионский титул в этом сезоне.",
                                "zh": "该队正准备在本赛季再次<w>冲击</w>冠军头衔。"
                            }
                        },
                        {
                            "text": "She announced her <w>tilt</w> at the presidency during the press conference.",
                            "target_lang_translations": {
                                "ru": "Она объявила о своей <w>попытке</w> побороться за пост президента во время пресс-конференции.",
                                "zh": "她在新闻发布会上宣布了她对总统职位的<w>冲击</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tilt at the title"
                    ],
                    "target_lang_definitions": {
                        "ru": "Попытка достичь чего-либо (например, победы в соревновании).",
                        "zh": "为达成某事（如赢得比赛或竞选公职）所做的尝试。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попытка",
                                "target_lang_sense_clarification": "стремление добиться чего-либо"
                            },
                            {
                                "target_lang_word": "претензия",
                                "target_lang_sense_clarification": "заявка на успех"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尝试",
                                "target_lang_sense_clarification": "为达成目标而进行的努力"
                            },
                            {
                                "target_lang_word": "冲击",
                                "target_lang_sense_clarification": "指对冠军或职位的竞争"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cc61f6c-8d50-3042-a2bf-60fa46dfcd98",
                    "sense_definition": "A state of frustration and worsened performance resulting from a series of losses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming_frustration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the bad hand, the poker player went on <w>tilt</w> and lost all his chips.",
                            "target_lang_translations": {
                                "ru": "После плохой раздачи игрок в покер впал в <w>тильт</w> и проиграл все свои фишки.",
                                "zh": "在那把烂牌之后，这位扑克玩家陷入了<w>心态失衡</w>，输光了所有筹码。"
                            }
                        },
                        {
                            "text": "Managing <w>tilt</w> is an essential skill for professional gamers to maintain focus.",
                            "target_lang_translations": {
                                "ru": "Управление <w>тильтом</w> — важный навык для профессиональных геймеров, чтобы сохранять концентрацию.",
                                "zh": "对于职业玩家来说，管理<w>心态失衡</w>是保持专注的一项基本技能。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go on tilt"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in gaming and poker contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние злости и ухудшения игры после серии неудач.",
                        "zh": "因连续失败而导致的沮丧和表现失常的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тильт",
                                "target_lang_sense_clarification": "игровой сленг: состояние нервного срыва"
                            },
                            {
                                "target_lang_word": "срыв",
                                "target_lang_sense_clarification": "эмоциональная нестабильность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心态失衡",
                                "target_lang_sense_clarification": "因挫败感导致的情绪不稳定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8ec69cf-24b5-30a3-890c-05c40dfa0156",
                    "sense_definition": "A jousting contest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jousting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval <w>tilt</w> was a dangerous sport enjoyed by royalty and knights.",
                            "target_lang_translations": {
                                "ru": "Средневековый <w>рыцарский турнир</w> был опасным видом спорта, которым увлекались короли и рыцари.",
                                "zh": "中世纪的<w>骑士比武</w>是一项深受皇室和骑士喜爱的危险运动。"
                            }
                        },
                        {
                            "text": "He rode at full <w>tilt</w> towards the castle gates to deliver the message.",
                            "target_lang_translations": {
                                "ru": "Он мчался во весь <w>опор</w> к воротам замка, чтобы доставить послание.",
                                "zh": "他全速冲向城堡大门去传递消息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "full tilt"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рыцарский поединок на копьях.",
                        "zh": "中世纪的骑士比武。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыцарский турнир",
                                "target_lang_sense_clarification": "историческое состязание"
                            },
                            {
                                "target_lang_word": "поединок",
                                "target_lang_sense_clarification": "бой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骑士比武",
                                "target_lang_sense_clarification": "历史上的竞技活动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}