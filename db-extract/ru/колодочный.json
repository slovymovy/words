                                                "example_id": "c685a725-ae48-4804-841b-ae33ba974f11",
                                                "sense_id": "a5dc8720-8351-3361-b98c-f4f7c50fe4c2",
                                                "text": "\"Old Jimmy Harris only shoed her last week, and I'd swear to his make among ten thousand.\""
                                            }
