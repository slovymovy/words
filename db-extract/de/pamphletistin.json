                "senses": [
                    {
                        "sense_id": "2131d4c3-bbf0-3b6b-9c0d-372d58620f64",
                        "entry_id": "4f9fe170-3ebf-3976-9830-992cd415e347",
                        "glosses": [
                            "Verfasserin von Pamphleten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b7c62c2-277f-4b3d-a240-6dd64601b5b3",
                                "sense_id": "2131d4c3-bbf0-3b6b-9c0d-372d58620f64",
                                "text": "„Madame de Staël, berühmte Tochter eines berühmten Vaters, des letzten französischen Finanzministers vor der Revolution, Necker, spielte wie ihr Intimfeind Napoleon, der sie durch einen persönlichen Machtspruch aus Paris verbannte, auf der großen europäischen Bühne: als Literatin, als steinreiche Gesellschaftsdame, als Pamphletistin, als Wortführerin einer politischen Freiheit ohne Terror.“"
                            },
                            {
                                "example_id": "2cb919d7-0bd8-4192-b5c9-914d77bde02c",
                                "sense_id": "2131d4c3-bbf0-3b6b-9c0d-372d58620f64",
                                "text": "„Solche Männer, die die eigene Tradition verleugnen und die hegemonialen Paradigmen des Westens übernehmen, nenne sie ganz einfach afrikanische Kolonialisten, schreibt die Pamphletistin.“"
                            },
                            {
                                "example_id": "9cd8a52a-b136-4924-aba8-6a1a0295493f",
                                "sense_id": "2131d4c3-bbf0-3b6b-9c0d-372d58620f64",
                                "text": "„Wieder einmal gibt der «Corriere della Sera» zwei ganze Seiten seiner Samstagsausgabe her, um die nun 75-jährige Pamphletistin Oriana Fallaci sich selbst darstellen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
