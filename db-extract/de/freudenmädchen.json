                                        "sense_id": "f625efb3-e3dd-3bde-a84d-ac9418bd6bf5",
                                        "entry_id": "f13aa420-2f17-36f1-bdc8-5b80df7cc385",
                                        "glosses": [
                                            "To pimp; to pander."
