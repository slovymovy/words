                "senses": [
                    {
                        "sense_id": "85f9cea2-184b-3a8d-b647-710bd23bc200",
                        "entry_id": "256b1b2d-d5e7-3958-8b2b-85352eda4825",
                        "glosses": [
                            "Gesamtheit der Unternehmen, die Produkte für den Bahnbetrieb herstellen oder Dienstleistungen zur Herstellung dieser anbieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1af2d5fb-0645-44ac-8593-7f324e47dd56",
                                "sense_id": "85f9cea2-184b-3a8d-b647-710bd23bc200",
                                "text": "Die Bahnindustrie ist ein wichtiger Wirtschaftszweig des Landes."
                            },
                            {
                                "example_id": "71de35db-df1d-4ec5-9c48-de9826b329b3",
                                "sense_id": "85f9cea2-184b-3a8d-b647-710bd23bc200",
                                "text": "„Ein Rekord-Auftragspolster stimmt die deutsche Bahnindustrie optimistisch, obwohl ihre Umsätze im vergangenen Jahr erstmals seit 2005 gesunken sind.“"
                            },
                            {
                                "example_id": "7d7ab2b7-ccbf-4976-aab4-82572c7fa631",
                                "sense_id": "85f9cea2-184b-3a8d-b647-710bd23bc200",
                                "text": "„Bundesverkehrsminister Ramsauer spricht aus, was sich Pendler täglich denken: Er fordert mehr Zuverlässigkeit von der deutschen Bahnindustrie.“"
                            },
                            {
                                "example_id": "c183c8ec-b355-4961-a108-c2764293838c",
                                "sense_id": "85f9cea2-184b-3a8d-b647-710bd23bc200",
                                "text": "„Grube: […] Meine große Sorge ist, dass sich die Bahnindustrie vom Standort Deutschland verabschiedet und die Züge lieber im Ausland baut.“"
                            },
                            {
                                "example_id": "f01035eb-98b7-4c36-9722-5332206ce684",
                                "sense_id": "85f9cea2-184b-3a8d-b647-710bd23bc200",
                                "text": "„Wenn die Bahnindustrie bestellte Züge pünktlich und einwandfrei liefere, stünden dann bei Problemen ausreichend Ersatzzüge zur Verfügung.“"
                            },
                            {
                                "example_id": "72844da7-b6b1-416e-a414-a53d0f00f324",
                                "sense_id": "85f9cea2-184b-3a8d-b647-710bd23bc200",
                                "text": "„Wenn die Deutsche Bahn (DB) investiert, dann freuen sich nicht nur die Kunden, sondern auch die Bahnindustrie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
