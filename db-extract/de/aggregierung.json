                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c4a0f4-35a6-4643-9e02-d5720cb8edb0",
                                "sense_id": "573f85b2-a9a3-3684-8a91-4e224c7f0968",
