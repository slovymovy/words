                ],
                "senses": [
                    {
                        "sense_id": "b060d076-b9b0-3eea-987d-a3522f4416b4",
                        "entry_id": "7e6aa125-686c-3951-b60e-4e2077c5f109",
                        "glosses": [
                            "an Steckern und Steckdosen vorhandener zusätzlicher Kontakt zum Schutz vor Stromschlag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e60fa282-3bd5-4dd0-a985-e5e51973f0ee",
                                "sense_id": "b060d076-b9b0-3eea-987d-a3522f4416b4",
                                "text": "„Denn dadurch wurde es ermöglicht, nicht nur mit zweipoligen, sondern auch mit Schukosteckern versehene Geräte an Steckdosen mit Schutzkontakt in der Weise anzuschließen, daß die Schutzfunktion der Erdleitung hinfällig wurde.“"
                            },
                            {
                                "example_id": "0f1bfc5d-e7fd-4e61-be3d-e4aef8fb6a25",
                                "sense_id": "b060d076-b9b0-3eea-987d-a3522f4416b4",
                                "text": "„Für die seltenen Schuko-Stecker in Wohnhäusern sind Adapter erforderlich, da in die Steckdosen nur die in Deutschland gebräuchlichen zweipoligen Stecker ohne Schutzkontakt passen.“"
                            },
                            {
                                "example_id": "233575aa-f093-4768-a0c8-aa90d78cec29",
                                "sense_id": "b060d076-b9b0-3eea-987d-a3522f4416b4",
                                "text": "„Ebenso ist es sinnvoll, mit Schutzkontakt versehene, separate Stromversorgungen für die Messelektronik aus einem gemeinsamen Steckdosenanschluss zu betreiben, um Erdschleifen über Schutzleiter und Gerätegehäuse zu vermeiden.“"
                            },
                            {
                                "example_id": "2a4a7912-5f2b-4d4c-8330-3e45dd1a7651",
                                "sense_id": "b060d076-b9b0-3eea-987d-a3522f4416b4",
                                "text": "„Kontrollieren Sie nun mit dem Ohmmeter, ob die Verbindung zwischen dem Schutzkontakt des Gerätesteckers und dem Metallkörper des elektronischen Gerätes perfekt leitend (und nicht eventuell unterbrochen) ist.“"
                            },
                            {
                                "example_id": "452bfbca-35ae-41ed-a1db-61ddfff219e4",
                                "sense_id": "b060d076-b9b0-3eea-987d-a3522f4416b4",
                                "text": "„Bei Reisen nach Afrika und Asien, teilweise auch ins europäische Ausland werden sie notwendig, um deutsche Netzstecker mit Schutzkontakt an Steckdosen des jeweiligen Landes verwenden zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
