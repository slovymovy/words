        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "93ee45da-66ef-3eb7-a82a-60babd761c4e",
                "word": "derailment",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "58707d1b-d1b1-40e8-8900-e9f74da4c4d2",
                        "entry_id": "93ee45da-66ef-3eb7-a82a-60babd761c4e",
