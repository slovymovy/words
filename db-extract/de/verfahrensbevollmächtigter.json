                ],
                "senses": [
                    {
                        "sense_id": "3c338805-66a7-3c02-93bd-fccd2c83b18d",
                        "entry_id": "875acf9a-bc31-3a7e-9520-fc7662a4f6c3",
                        "glosses": [
                            "mit der Vollmacht zur Vertretung eines Klägers oder Verklagten beauftragte (natürliche oder juristische) Person in einem Zivilprozess"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "338c7ee2-3123-4fc9-a1e0-1d7481880f4b",
                                "sense_id": "3c338805-66a7-3c02-93bd-fccd2c83b18d",
                                "text": "„Zwischendurch zitiert der Verfahrensbevollmächtigte der AfD, Karl Albrecht Schachtschneider, die Demokratietheorie von Jean-Jacques Rousseau.“"
                            },
                            {
                                "example_id": "db76d193-140c-4936-ad62-14b69f310f9b",
                                "sense_id": "3c338805-66a7-3c02-93bd-fccd2c83b18d",
                                "text": "„Der von ihnen beauftragte Verfahrensbevollmächtigte Ogorek hat in seinem 50-seitigen Antrag viele Punkte aufgelistet, die ihre Annahme bestätigen.“"
                            },
                            {
                                "example_id": "09426f62-92cf-4f39-83af-87eba6a83d49",
                                "sense_id": "3c338805-66a7-3c02-93bd-fccd2c83b18d",
                                "text": "„Zuvor hatten der Vorsitzende Richter Fabian Bönsch und die Verfahrensbevollmächtigten der Parteien die Sachlage ausgiebig erörtert.“"
                            },
                            {
                                "example_id": "e4c54aab-691c-407e-b4a8-b9661dbc2274",
                                "sense_id": "3c338805-66a7-3c02-93bd-fccd2c83b18d",
                                "text": "„Der Verfahrensbevollmächtigte von SPD und FDP, Simon Kempny, betonte in der Verhandlung, die vom Gesetzgeber vorgesehene Möglichkeit von Notkrediten beschränke sich auf plötzliche, akute und unvorhergesehene Lagen.“"
                            },
                            {
                                "example_id": "fcbbcce4-6b24-454f-a7a0-f20b4ad5b75b",
                                "sense_id": "3c338805-66a7-3c02-93bd-fccd2c83b18d",
                                "text": "„Ehrenamtliche Richter dürfen nicht vor dem Spruchkörper eines Gerichts, dem sie angehören, als Prozess- oder Verfahrensbevollmächtigte auftreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
