{
    "word_family": [
        "bezwering",
        "bezweerder",
        "gebeuren",
        "zweren"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9326cb45-007e-3b28-8daf-3e9035bab83f",
                    "sense_definition": "een dreiging of gevaar onder controle brengen of afwenden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "controle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De brandweer slaagde erin om het grote brandgevaar te <w>bezweren</w>.",
                            "target_lang_translations": {
                                "en": "The fire department managed to <w>avert</w> the great danger of fire.",
                                "pl": "Straży pożarnej udało się <w>zażegnać</w> ogromne niebezpieczeństwo pożaru."
                            }
                        },
                        {
                            "text": "De crisis werd op het laatste moment door de regering <w>bezworen</w>.",
                            "target_lang_translations": {
                                "en": "The crisis was <w>defused</w> by the government at the last moment.",
                                "pl": "Kryzys został w ostatniej chwili <w>zażegnany</w> przez rząd."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedwingen",
                        "afwenden",
                        "beheersen"
                    ],
                    "antonyms": [
                        "veroorzaken",
                        "ontketenen"
                    ],
                    "common_phrases": [
                        "gevaar bezweren",
                        "crisis bezweren"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring a threat or danger under control or to avert it.",
                        "pl": "opanować zagrożenie, zażegnać kryzys lub niebezpieczeństwo"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to avert",
                                "target_lang_sense_clarification": "preventing a disaster or danger"
                            },
                            {
                                "target_lang_word": "to defuse",
                                "target_lang_sense_clarification": "making a dangerous situation safe"
                            },
                            {
                                "target_lang_word": "to ward off",
                                "target_lang_sense_clarification": "keeping away a threat"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zażegnać",
                                "target_lang_sense_clarification": "o kryzysie lub niebezpieczeństwie"
                            },
                            {
                                "target_lang_word": "odwrócić",
                                "target_lang_sense_clarification": "o zagrożeniu"
                            },
                            {
                                "target_lang_word": "opanować",
                                "target_lang_sense_clarification": "przejąć kontrolę nad niebezpieczną sytuacją"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af6c4d5b-842e-3bc6-b14d-9f929ec26630",
                    "sense_definition": "met grote nadruk of onder ede beloven of verklaren",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "beloven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>bezwoer</w> dat hij de misdaad nooit meer zou begaan.",
                            "target_lang_translations": {
                                "en": "He <w>swore</w> that he would never commit the crime again.",
                                "pl": "<w>Przysiągł</w>, że już nigdy więcej nie popełni tego przestępstwa."
                            }
                        },
                        {
                            "text": "Zij <w>bezwoer</w> haar onschuld voor de rechtbank.",
                            "target_lang_translations": {
                                "en": "She <w>vowed</w> her innocence before the court.",
                                "pl": "<w>Zaklinała się</w> przed sądem, że jest niewinna."
                            }
                        }
                    ],
                    "synonyms": [
                        "betuigen",
                        "verzekeren",
                        "zweren"
                    ],
                    "antonyms": [
                        "ontkennen"
                    ],
                    "common_phrases": [
                        "plechtig bezweren",
                        "onschuld bezweren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in formele of plechtige context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To promise or declare with great emphasis or under oath.",
                        "pl": "przysięgać uroczyście lub oświadczać z wielkim naciskiem"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to swear",
                                "target_lang_sense_clarification": "making a solemn statement or promise"
                            },
                            {
                                "target_lang_word": "to adjure",
                                "target_lang_sense_clarification": "solemnly urging or requesting"
                            },
                            {
                                "target_lang_word": "to vow",
                                "target_lang_sense_clarification": "making a serious promise"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przysięgać",
                                "target_lang_sense_clarification": "składać uroczystą obietnicę lub oświadczenie"
                            },
                            {
                                "target_lang_word": "zaklinać się",
                                "target_lang_sense_clarification": "zapewniać z mocą o czymś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09e6d203-da24-3716-87d4-1a5545c726be",
                    "sense_definition": "door middel van magische woorden of rituelen onder controle proberen te krijgen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sjamaan probeerde de boze geesten te <w>bezweren</w> met gezang.",
                            "target_lang_translations": {
                                "en": "The shaman tried to <w>exorcise</w> the evil spirits with chanting.",
                                "pl": "Szaman próbował <w>odpędzić</w> złe duchy śpiewem."
                            }
                        },
                        {
                            "text": "In het sprookje wist de held de draak te <w>bezweren</w>.",
                            "target_lang_translations": {
                                "en": "In the fairy tale, the hero managed to <w>charm</w> the dragon.",
                                "pl": "W bajce bohater zdołał <w>poskromić</w> smoka."
                            }
                        }
                    ],
                    "synonyms": [
                        "betoveren",
                        "beheksen"
                    ],
                    "common_phrases": [
                        "geesten bezweren",
                        "slangen bezweren"
                    ],
                    "target_lang_definitions": {
                        "en": "To attempt to gain control through magical words or rituals.",
                        "pl": "podporządkowywać sobie lub wypędzać za pomocą magii bądź rytuałów"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to conjure",
                                "target_lang_sense_clarification": "calling upon spirits or magic"
                            },
                            {
                                "target_lang_word": "to exorcise",
                                "target_lang_sense_clarification": "driving out evil spirits"
                            },
                            {
                                "target_lang_word": "to charm",
                                "target_lang_sense_clarification": "controlling through magic, like a snake charmer"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zaklinać",
                                "target_lang_sense_clarification": "o wężach, duchach lub za pomocą magii"
                            },
                            {
                                "target_lang_word": "odczyniać",
                                "target_lang_sense_clarification": "usuwać zły wpływ rytuałem"
                            },
                            {
                                "target_lang_word": "egzorcyzmować",
                                "target_lang_sense_clarification": "wypędzać złe duchy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
