                "senses": [
                    {
                        "sense_id": "732240c6-2a52-325f-a22d-01a1baa6c8b0",
                        "entry_id": "f333e539-be62-3d92-8fb5-661d51ae7e23",
                        "glosses": [
                            "weibliche Person, die Wale in ihrem natürlichen Lebensraum beobachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "974a9439-7182-422b-bb71-d4d7bcc518d0",
                                "sense_id": "732240c6-2a52-325f-a22d-01a1baa6c8b0",
                                "text": "„Dr. Neill hatte sie offiziell zur Walbeobachterin ernannt, und wenn sie nicht mit Dr. Stanley im Boot aufs Meer hinausfuhren, verbrachte sie viel Zeit an dem breiten Fenster, das Messingteleskop auf die Wasseroberfläche gerichtet.“"
                            },
                            {
                                "example_id": "b1a8774a-0523-43f5-a743-95cdf85a97b0",
                                "sense_id": "732240c6-2a52-325f-a22d-01a1baa6c8b0",
                                "text": "„Sogar ich, als leidenschaftliche Walbeobachterin, kann keine Rückenflosse aus der bewegten See herbeizaubern.“"
                            },
                            {
                                "example_id": "ac3f9157-942a-4b6e-9094-d5fd99db8c64",
                                "sense_id": "732240c6-2a52-325f-a22d-01a1baa6c8b0",
                                "text": "„Die New Yorker Walbeobachterin Joy Reidenberg sagte dem Magazin ‚The Atlantic‘ einmal, die Blasen schienen ihr manchmal ‚das Äquivalent eines Ausrufezeichens‘ oder gar des ‚Zeigens des Mittelfingers‘ zu sein.“"
                            },
                            {
                                "example_id": "fb06d3fe-7731-4832-9248-6eae4edfa21d",
                                "sense_id": "732240c6-2a52-325f-a22d-01a1baa6c8b0",
                                "text": "„›Eine Whalewatching-Tour ist kein Menü, bei dem man sich die Wale aussucht‹, erklärt Aurora Crucianelli, Meeresbiologin aus Belgien und Walbeobachterin beim Veranstalter Terra Azul.“"
                            },
                            {
                                "example_id": "203041cc-5e9a-4294-ac7b-c6d45ded0c0e",
                                "sense_id": "732240c6-2a52-325f-a22d-01a1baa6c8b0",
                                "text": "„Es ist eine enge Zusammenarbeit mit der Gruppe der Walbeobachterinnen geplant, um die Ergebnisse der Beobachtungen mit denen der akustischen Untersuchungen vergleichen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
