                "senses": [
                    {
                        "sense_id": "d205b006-7282-3470-90a5-6a7f5e35d1f1",
                        "entry_id": "dd3bca6b-4cad-3c54-badb-d1199a92ab28",
                        "glosses": [
                            "приверженец или представитель марксизма; последователь политико-экономического учения Карла Маркса"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d750494-8f1a-4952-8b59-ca8469df90d2",
                        "source_entry_id": "dd3bca6b-4cad-3c54-badb-d1199a92ab28",
                        "source_sense_id": "d205b006-7282-3470-90a5-6a7f5e35d1f1",
                        "target_lang_word": "Marxist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marxist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c71501da-10cd-373c-a9e9-35fefa3b3c19",
                                        "entry_id": "48fb51d2-df1c-3304-98c1-f755b5b5209a",
                                        "glosses": [
                                            "Following the ideals of Marxism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "920f87f8-daba-4146-b64a-51ca6f6acd27",
                                                "sense_id": "c71501da-10cd-373c-a9e9-35fefa3b3c19",
                                                "text": "Lenin's Marxist tendencies were underscored by his beliefs in state capitalism and the inconsistency of socialist democracy with the rule and dictatorship of one individual."
                                            },
                                            {
                                                "example_id": "3f3ec4be-47cb-4efc-9461-6ecaf44787fb",
                                                "sense_id": "c71501da-10cd-373c-a9e9-35fefa3b3c19",
                                                "text": "Some of the historians working on these projects were influenced in some way or another by Marxist views toward history."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Marxist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2795f29-6344-352a-8080-73157a3be8dd",
                                        "entry_id": "48f2a6c5-82bb-3c25-8e43-c25f6140f52b",
                                        "glosses": [
                                            "One that believes in or follows the ideals of Marxism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2b070a3-49bd-4ff7-b12f-e46a76e76d9c",
                                                "sense_id": "c2795f29-6344-352a-8080-73157a3be8dd",
                                                "text": "What sort of Marxist devotes six years to the perfecting of a novel so remote from the struggle for tomorrow?"
                                            },
                                            {
                                                "example_id": "83ca92ae-ad39-4a62-8884-822c4a8ac8d3",
                                                "sense_id": "c2795f29-6344-352a-8080-73157a3be8dd",
                                                "text": "Of course, no two Marxists and no two Miseseans will ever be exactly alike, so I am not suggesting that a winning political coalition will result from this unlikely arrangement."
                                            },
                                            {
                                                "example_id": "ba827c01-78a9-400d-9b31-6391a3f9bfa4",
                                                "sense_id": "c2795f29-6344-352a-8080-73157a3be8dd",
                                                "text": "2015, Park Si-soo, Leading Economist Dies at 73, The Korea Times\nKorea's leading Marxist economist Kim Soo-haeng, who translated the legendary economic book \"Capital: Critique of Political Economy\" into Korean in 1990, died of a heart attack in the United States, recently."
                                            },
                                            {
                                                "example_id": "e19d1fc3-4f46-4b77-a377-53927bbb02ba",
                                                "sense_id": "c2795f29-6344-352a-8080-73157a3be8dd",
                                                "text": "Like Marxists, wokies are millenarians, working for a magical tomorrow that owes nothing either to past practice or to human frailties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74ead931-dd57-4da0-a2e2-568449f3abbe",
                        "source_entry_id": "dd3bca6b-4cad-3c54-badb-d1199a92ab28",
                        "source_sense_id": "d205b006-7282-3470-90a5-6a7f5e35d1f1",
