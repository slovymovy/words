                        "source_sense_description": "Haltestelle, an der nur auf Wunsch eines Fahrgastes angehalten wird",
                        "target_lang_word": "request stop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "request stop",
