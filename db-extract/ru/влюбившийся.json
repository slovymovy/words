                ],
                "senses": [
                    {
                        "sense_id": "5fe8e22e-d5c8-36cf-a2d9-c7f910b047ba",
                        "entry_id": "55acd917-eb51-3405-aa1e-e69ad5433aab",
                        "glosses": [
                            "действ. прич. прош. вр. от влюбиться"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "90b680b9-ee3e-4221-a90a-531cb4d112ca",
                                "sense_id": "5fe8e22e-d5c8-36cf-a2d9-c7f910b047ba",
                                "text": "Я тосковал, как впервые влюбившийся мальчишка, которого не пускают на rendez-vous."
                            },
                            {
                                "example_id": "ac34912e-8965-42ce-88fb-9d347b85e74c",
                                "sense_id": "5fe8e22e-d5c8-36cf-a2d9-c7f910b047ba",
                                "text": "В шестнадцать лет она посмеялась над влюбившимся в неё сверстником и тот застрелился."
                            },
                            {
                                "example_id": "dc8dd961-d184-4964-a232-ee4dee5adb66",
                                "sense_id": "5fe8e22e-d5c8-36cf-a2d9-c7f910b047ba",
                                "text": "Пожалел бедную девушку, влюбившуюся в женатого и легкомысленного человека."
                            }
                        ]
                    }
                ],
