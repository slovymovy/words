                    {
                        "sense_id": "126d8c4e-fca7-33bd-bff2-94382dc1ccf8",
                        "entry_id": "7a9a116b-bc2a-30bd-a727-61795a897c4a",
                        "glosses": [
                            "wypukła zewnętrzna warstwa gałki ocznej pokryta przezroczystą błoną"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "136a4673-d1c2-41cb-8ab8-6106b8577387",
                                "sense_id": "126d8c4e-fca7-33bd-bff2-94382dc1ccf8",
                                "text": "Soczewkę kontaktową umieszcza się bezpośrednio na rogówce oka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c92b0a38-4d87-36d1-826a-048ca5f5ac84",
                        "entry_id": "7a9a116b-bc2a-30bd-a727-61795a897c4a",
                        "glosses": [
                            "kanapa narożna"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ec3087bb-6101-4ffa-aed7-05ed0385e8be",
                                "sense_id": "c92b0a38-4d87-36d1-826a-048ca5f5ac84",
                                "text": "Mama kupiła nową rogówkę do dużego pokoju."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "e6fab8a3-be51-3083-b92b-a244b0a9b9f7",
                        "entry_id": "7a9a116b-bc2a-30bd-a727-61795a897c4a",
                        "glosses": [
                            "XVIII-wieczna paradna spódnica rozpięta na obręczach szerokiego stelażu powiększającego jej objętość; także sam stelaż"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "42353cdf-4b9b-4a51-94b7-bb149315e25b",
                                "sense_id": "e6fab8a3-be51-3083-b92b-a244b0a9b9f7",
                                "text": "Rogówka pozwalała na zachowanie modnej w epoce rokoka sylwetki."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "4b2a4f63-4e04-3253-85a8-73ae19fb057d",
