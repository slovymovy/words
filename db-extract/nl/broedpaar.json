                        "entry_id": "155bbe40-44db-39e9-a85b-4c2caf9b97da",
                        "glosses": [
                            "twee vogels die samen voor het uitbroeden van eieren zorgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3553c3ee-7ce1-4efc-879e-70eb10585da0",
                                "sense_id": "ebfe2699-cf36-3460-b123-921e5845f720",
                                "text": "Boeren die stukken land opofferen om weidevogels te laten broeden, krijgen in Friesland een vergoeding van duizend euro per broedpaar per jaar. De provincie wil zo het verlies van broedgebied door de verlegging van de A31 compenseren."
                            },
                            {
                                "example_id": "cac9a215-5d99-4693-b25c-4fd0b2e5506a",
                                "sense_id": "ebfe2699-cf36-3460-b123-921e5845f720",
                                "text": "Volgens Koks is dit eerste broedpaar van de steppekiekendief in Nederland groot nieuws in vogelland. Tot nu toe heeft de steppekiekendief in Europa alleen gebroed in Finland."
                            }
                        ]
                    }
