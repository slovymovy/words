                    "sense_id": "2a85aa01-085b-36fe-b028-5b5c84867e05",
                    "sense_definition": "W sposób otwarty, zgodny z prawdą, nie ukrywając swoich myśli ani uczuć.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "honesty_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Powiedz mi <szczerze>, co myślisz o moim nowym pomyśle.",
                            "target_lang_translations": {
                                "ru": "Скажи мне <честно>, что ты думаешь о моей новой идее.",
                                "en": "Tell me <frankly> what you think about my new idea.",
                                "nl": "Vertel me <eerlijk> wat je van mijn nieuwe idee vindt.",
                                "de": "Sag mir <ehrlich>, was du von meiner neuen Idee hältst.",
                                "fr": "Dis-moi <franchement> ce que tu penses de ma nouvelle idée.",
                                "it": "Dimmi <francamente> cosa pensi della mia nuova idea.",
                                "cs": "Řekni mi <upřímně>, co si myslíš o mém novém nápadu.",
                                "tr": "Yeni fikrim hakkında ne düşündüğünü bana <açıkça> söyle.",
                                "es": "Dime <sinceramente> qué piensas de mi nueva idea.",
                                "zh": "请<w>诚实地</w>告诉我，你对我的新想法有什么看法。"
                            }
                        },
                        {
                            "text": "On zawsze <szczerze> odpowiada na zadane mu pytania.",
                            "target_lang_translations": {
                                "ru": "Он всегда <искренне> отвечает на заданные ему вопросы.",
                                "en": "He always answers questions asked of him <sincerely>.",
                                "nl": "Hij antwoordt altijd <eerlijk> op de vragen die hem gesteld worden.",
                                "de": "Er antwortet immer <aufrichtig> auf die ihm gestellten Fragen.",
                                "fr": "Il répond toujours <sincèrement> aux questions qu'on lui pose.",
                                "it": "Lui risponde sempre <sinceramente> alle domande che gli vengono poste.",
                                "cs": "On vždy <upřímně> odpovídá na otázky, které mu byly položeny.",
                                "tr": "Kendisine sorulan sorulara her zaman <içtenlikle> cevap verir.",
                                "es": "Él siempre responde <francamente> a las preguntas que le hacen.",
                                "zh": "他总是<w>坦率地</w>回答别人提出的问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "otwarcie",
                        "jak na spowiedzi",
                        "bez ogródek",
                        "prosto z mostu."
