                "translations": [
                    {
                        "translation_id": "d6c41a6b-5a0e-4ffc-9193-2b25f463b046",
                        "source_entry_id": "831baf25-58e1-3052-8950-86d2fff38660",
                        "source_sense_id": "ae3d01a0-58b9-3a8a-80a2-653f8e0ab2a6",
                        "source_sense_description": "umgangssprachlich: Zahnreihe",
                        "target_lang_word": "dentition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dentition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e94252a-c590-302b-8aad-cc9af43a9efd",
                                        "entry_id": "2b593159-2040-31d5-a9ef-bbe98ac45e7a",
                                        "glosses": [
                                            "Naissance et formation des dents depuis l’enfance jusqu’à l’adolescence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42281d59-53c6-47e3-897b-d517eea2c9bc",
                                                "sense_id": "7e94252a-c590-302b-8aad-cc9af43a9efd",
                                                "text": "Dentition facile, difficile."
                                            },
                                            {
                                                "example_id": "d35cf14d-1cd8-4560-b3b3-8b36133b2374",
                                                "sense_id": "7e94252a-c590-302b-8aad-cc9af43a9efd",
                                                "text": "Le temps de la dentition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea595f38-c7b2-3a85-8395-8fb848420a01",
                                        "entry_id": "2b593159-2040-31d5-a9ef-bbe98ac45e7a",
                                        "glosses": [
                                            "Poussée de dents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37f3291f-e063-467a-90df-3dba3e90fe0f",
                                                "sense_id": "ea595f38-c7b2-3a85-8395-8fb848420a01",
                                                "text": "Alors, du côté de la mer, un âcre appel déchira la nuit : c’était comme la plainte d’un jeune cyclope en dentition — ou le cri de guerre de l’oiseau appelé rock quand il se précipite sur une foule d’éléphants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a52c124c-0c99-37ce-8b5c-dbf8979b6e88",
                                        "entry_id": "2b593159-2040-31d5-a9ef-bbe98ac45e7a",
                                        "glosses": [
                                            "Denture, ensemble des dents."
                                        ],
                                        "tags": [
                                            "Usage critiqué"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27797914-712e-4a64-9c99-ed6db1c61a7d",
                                                "sense_id": "a52c124c-0c99-37ce-8b5c-dbf8979b6e88",
                                                "text": "La dentition de l’enfant comporte 20 dents de lait."
                                            },
                                            {
                                                "example_id": "ef892ef7-96de-4209-b6cb-2a4f645b5fa3",
                                                "sense_id": "a52c124c-0c99-37ce-8b5c-dbf8979b6e88",
                                                "text": "Il a une mauvaise dentition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ab53d93-966f-3fab-8a51-196c81b1b036",
                                        "entry_id": "2b593159-2040-31d5-a9ef-bbe98ac45e7a",
                                        "glosses": [
                                            "Ensemble de pics et de reliefs rappelant une suite de dents."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3be8c57-df89-4933-b8f3-9a4010889e22",
                                                "sense_id": "2ab53d93-966f-3fab-8a51-196c81b1b036",
                                                "text": "L'hiver, couvert de neige, le glacier évoque une pâtisserie avec ses cônes multiples, sa dentition anarchique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a33a0d0f-27b6-4f26-b0ab-005eac0b1884",
                        "source_entry_id": "831baf25-58e1-3052-8950-86d2fff38660",
                        "source_sense_id": "bddffde5-38ce-32c8-a248-a2d59e526421",
                        "source_sense_description": "umgangssprachlich, salopp: Mund",
                        "target_lang_word": "bouche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab554bfc-55e2-3756-bf0c-f3b2e0ab8493",
                                        "entry_id": "a231c601-5d83-3c84-ac24-5e743f2481e7",
                                        "glosses": [
                                            "Organe de l'être humain, composé de deux lèvres horizontales situées au bas du visage, lui servant notamment à ingurgiter de la nourriture et de la boisson, à parler, à embrasser et à faire des expressions faciales."
                                        ],
                                        "tags": [],
                                        "note": "Pour un animal, on dit normalement gueule",
                                        "examples": [
                                            {
                                                "example_id": "6d960533-037e-491e-bd32-c593db38fcce",
                                                "sense_id": "ab554bfc-55e2-3756-bf0c-f3b2e0ab8493",
                                                "text": "Une petite estafilade transversale, semblable à une ouverture de tirelire, enfouie sous une infinité de plis et de poils roides comme des soies de sanglier, représentait tant bien que mal ce que nous appellerons une bouche, faute d’autre terme."
                                            },
                                            {
                                                "example_id": "22510183-6149-46f0-a4d5-43a67a006fb2",
                                                "sense_id": "ab554bfc-55e2-3756-bf0c-f3b2e0ab8493",
                                                "text": "La bouche grasse, les pommettes rouges, les yeux injectés de bourgogne, Guillaume-Adolphe Porcellet célébra la grève, la sainte grève!…"
                                            },
                                            {
                                                "example_id": "1c02ff87-bd76-45fc-a858-01c739346f51",
                                                "sense_id": "ab554bfc-55e2-3756-bf0c-f3b2e0ab8493",
                                                "text": "Sous la moustache blonde du grand gaillard, ses lèvres goulues cherchaient la bouche voluptueuse, cependant que l’autre, sans s’attarder à des bagatelles inutiles et connaissant la valeur du temps, troussait vigoureusement les jupes."
                                            },
                                            {
                                                "example_id": "a2251ab7-47c6-43da-93c1-d015ee458e28",
                                                "sense_id": "ab554bfc-55e2-3756-bf0c-f3b2e0ab8493",
                                                "text": "Et, laissant échapper le rideau, il s’approcha du lit. Flossie continuait de ronfler, la bouche ouverte."
                                            },
                                            {
                                                "example_id": "9a66324c-4cda-4c69-9915-702ca774657d",
                                                "sense_id": "ab554bfc-55e2-3756-bf0c-f3b2e0ab8493",
                                                "text": "C’était bizarre. Jamalou n’éprouvait plus, devant cette face douloureuse dont les yeux révulsés, la bouche aux lèvres tuméfiées, presque noire, révélaient l’atroce agonie, aucune espèce de compassion."
                                            },
                                            {
                                                "example_id": "8cbb271a-d546-4760-bb6c-ccb15ab7d17b",
                                                "sense_id": "ab554bfc-55e2-3756-bf0c-f3b2e0ab8493",
                                                "text": "Héliodore aimait tellement les chevaux que, si quelqu'un s'avisait de dire devant lui « la gueule » au lieu de « la bouche » d'un cheval, c'était comme une injure personnelle qu'on lui eût faite. Il méditait sa vengeance."
                                            },
                                            {
                                                "example_id": "711e57f9-7a54-437b-93bf-ee63172f27ce",
                                                "sense_id": "ab554bfc-55e2-3756-bf0c-f3b2e0ab8493",
                                                "text": "Le feldwebel tourna vers Kerkardec des yeux pétillants et ouvrit la bouche comme un poisson tiré de l'eau."
                                            },
                                            {
                                                "example_id": "9b8b2078-d7c1-4ed2-a406-37f6b3d928e9",
                                                "sense_id": "ab554bfc-55e2-3756-bf0c-f3b2e0ab8493",
                                                "text": "La bouche et ses déclinaisons se multiplient à travers les deux livres; un kaléidoscope où l'on embrasse, on lèche, on parle, on dit ou on se tait."
                                            },
                                            {
                                                "example_id": "058e3b89-d65f-4ebf-8d43-1757010ee51b",
                                                "sense_id": "ab554bfc-55e2-3756-bf0c-f3b2e0ab8493",
                                                "text": "Je l’ai appris de sa propre bouche."
                                            },
                                            {
                                                "example_id": "d6cc9ac9-b2ac-4cce-a23e-6af3c09ab057",
                                                "sense_id": "ab554bfc-55e2-3756-bf0c-f3b2e0ab8493",
                                                "text": "Il n’ouvrit pas la bouche de toute la soirée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "429f2648-4528-3cd9-816c-692ba5d4ac4f",
                                        "entry_id": "a231c601-5d83-3c84-ac24-5e743f2481e7",
                                        "glosses": [
                                            "Étape dans l’analyse sensorielle et la dégustation du vin."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "085c10bd-a4b8-3669-8b33-c2762fd2adda",
                                        "entry_id": "a231c601-5d83-3c84-ac24-5e743f2481e7",
                                        "glosses": [
                                            "Personne, par allusion à la nourriture qu’elle consomme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66df263c-b106-4400-b52a-ade990f42030",
                                                "sense_id": "085c10bd-a4b8-3669-8b33-c2762fd2adda",
                                                "text": "Il a tous les jours dix bouches à nourrir."
                                            },
                                            {
                                                "example_id": "b5e57fa3-d663-4713-8433-48e5446e2304",
                                                "sense_id": "085c10bd-a4b8-3669-8b33-c2762fd2adda",
                                                "text": "Les vivres commençant à manquer, on en fit sortir toutes les bouches inutiles, qui consommaient une partie des vivres sans être capables de contribuer à la défense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60691d32-e75a-3cb1-800d-a7aafcd3b847",
                                        "entry_id": "a231c601-5d83-3c84-ac24-5e743f2481e7",
                                        "glosses": [
                                            "Nourriture."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d41194b-b62a-4d43-9eb7-38a0619258b1",
                                                "sense_id": "60691d32-e75a-3cb1-800d-a7aafcd3b847",
                                                "text": "Faire bonne bouche."
                                            },
                                            {
                                                "example_id": "a104ae78-9c1d-4615-9095-0e7dc0448c83",
                                                "sense_id": "60691d32-e75a-3cb1-800d-a7aafcd3b847",
                                                "text": "Il me traçait le portrait idéal de ma femme.\n« Il faudrait qu’elle sache bien faire la cuisine. C’est par la bouche qu’on retient un homme. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7735da0f-4dbc-3836-aad6-c6ec158ce406",
                                        "entry_id": "a231c601-5d83-3c84-ac24-5e743f2481e7",
                                        "glosses": [
                                            "Service, officier de la bouche du roi : service, officier chargés autrefois de tout ce qui concernait les repas du roi et de sa famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6f51e79-0aac-46e7-a7d8-d11a6eb33047",
                                                "sense_id": "7735da0f-4dbc-3836-aad6-c6ec158ce406",
                                                "text": "Je volai aux cuisines de la reine : quelques-uns des seigneurs de la bouche me dirent qu’elle était morte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40eaa996-7f31-3126-8cda-97a6a7663bee",
                                        "entry_id": "a231c601-5d83-3c84-ac24-5e743f2481e7",
                                        "glosses": [
                                            "Élargissement d’un cours d’eau lorsqu’il se joint à une mer."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "638fae0a-97d0-48e3-b51a-e00090eec44f",
                                                "sense_id": "40eaa996-7f31-3126-8cda-97a6a7663bee",
                                                "text": "Le vent se déclara contre les Espagnols, qui perdirent des navires sur les bas-fonds des bouches de l’Escaut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53059a96-1882-36dd-bd29-128ccdcca2e6",
                                        "entry_id": "a231c601-5d83-3c84-ac24-5e743f2481e7",
                                        "glosses": [
                                            "Détroit."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e99da99-ee10-4898-8366-b621011bdca9",
                                                "sense_id": "53059a96-1882-36dd-bd29-128ccdcca2e6",
                                                "text": "Le traité avait pour objectif de délimiter « les régions sous-marines » du golfe de Paria qui sépare Trinité-et-Tobago, alors colonie britannique, du Venezuela. L’accord fixait ainsi trois segments depuis les bouches du Dragon jusqu’aux bouches du Serpent. Les surfaces délimitées respectaient vaguement ce qu’aurait pu donner une ligne d’équidistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e876d09-d17a-35e4-bd4f-5e6c65f3ae72",
                                        "entry_id": "a231c601-5d83-3c84-ac24-5e743f2481e7",
                                        "glosses": [
                                            "Cavité plus ou moins large servant d’accès pour entrer ou sortir."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "185271bf-9899-3b22-b3aa-b4ff860a7085",
                                        "entry_id": "a231c601-5d83-3c84-ac24-5e743f2481e7",
                                        "glosses": [
                                            "Cavité plus ou moins large servant d’accès pour entrer ou sortir.",
                                            "Ouverture d’une adduction d’eau ou d’air."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ca9c2cb-e0db-4349-9457-5d450a303392",
                                                "sense_id": "185271bf-9899-3b22-b3aa-b4ff860a7085",
                                                "text": "Une bouche d’aération."
                                            },
                                            {
                                                "example_id": "eb488c67-5a5a-4974-b7f7-d1d6bb35776d",
                                                "sense_id": "185271bf-9899-3b22-b3aa-b4ff860a7085",
                                                "text": "– Je n’ai jamais eu de confiance dans les égouts, murmura-t-il en jetant \"Lafcadio\" dans une bouche ; et il ne jeta que deux bouches plus loin \"de Baraglioul\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aab22528-4ce0-3001-bad6-93cf518241ca",
                                        "entry_id": "a231c601-5d83-3c84-ac24-5e743f2481e7",
                                        "glosses": [
                                            "Cavité plus ou moins large servant d’accès pour entrer ou sortir.",
                                            "Ouverture du canon d’une arme à feu."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89b696fc-2e0e-4ad5-9abf-b8bb6efaf428",
                                                "sense_id": "aab22528-4ce0-3001-bad6-93cf518241ca",
                                                "text": "Les fusils s’abaissent simultanément, nous menaçant de leurs bouches noires qui vont cracher du feu et du plomb…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5746a46b-7458-3305-87ca-35676d4484ef",
                                        "entry_id": "a231c601-5d83-3c84-ac24-5e743f2481e7",
                                        "glosses": [
                                            "Cavité plus ou moins large servant d’accès pour entrer ou sortir.",
                                            "Entrée d’une station de métro."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b614570-6fe5-4b82-b365-105029dabbd5",
                                                "sense_id": "5746a46b-7458-3305-87ca-35676d4484ef",
                                                "text": "Une bouche de métro."
                                            }
                                        ]
