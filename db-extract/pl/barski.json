                "senses": [
                    {
                        "sense_id": "fa3c3145-a5e2-3439-a28e-0345b8ac236f",
                        "entry_id": "a26c17c6-ab06-387f-9819-2522711c286b",
                        "glosses": [
                            "związany z Barem, dotyczący Baru (miasta na Ukrainie)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "816812f0-ebab-30e6-8073-6440aae7372c",
                        "entry_id": "a26c17c6-ab06-387f-9819-2522711c286b",
                        "glosses": [
                            "związany z księstwem albo miastem Bari"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa5f9499-15a2-41f0-b343-9a0940e8a99a",
                                "sense_id": "816812f0-ebab-30e6-8073-6440aae7372c",
                                "text": "Piotr Skarga, nawiązując do barskiego synodu, interpretuje prowadzone dyskusje jako w zupełności udane, zakończone zniesieniem schizmy i uznaniem przez «Greków» zwierzchności papieża Urbana II"
                            },
                            {
                                "example_id": "22834ad7-dca7-443c-a947-4481846bbe87",
                                "sense_id": "816812f0-ebab-30e6-8073-6440aae7372c",
                                "text": "Choć sumy neapolitańskie (barskie) weszły do potocznej polszczyzny jako synonim utopijnych mrzonek o wzbogaceniu się, faktycznie stanowiły stały element działania dyplomacji polskiej w Madrycie, absorbując 150 dyplomatów przez ponad 100 lat"
                            },
                            {
                                "example_id": "117f3438-ad2b-4fda-bdfa-cc1049804363",
                                "sense_id": "816812f0-ebab-30e6-8073-6440aae7372c",
                                "text": "Za wpływem Tomickiego poślubił owdowiały król w r. 1518 krewną cesarską, Bonę Sforzę. Księżniczka ta włoska przyniosła mu w posagu majątek (ks. Barskie), leżący we Włoszech, o który nieustannie toczyły się spory"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "548a1e51-de14-4c7c-b4de-c1fd85c5d7f4",
                        "source_entry_id": "a26c17c6-ab06-387f-9819-2522711c286b",
                        "source_sense_id": "fa3c3145-a5e2-3439-a28e-0345b8ac236f",
                        "target_lang_word": "барский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "барский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "816ab651-72e2-33ba-b547-bd0908183c04",
                                        "entry_id": "93bb83e9-0dae-33a0-946e-080f189b713e",
                                        "glosses": [
                                            "истор. связанный, соотносящийся по значению с существительными барин, барыня, принадлежащий им"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdc01b49-093c-4867-a29a-2b59a790a121",
                                                "sense_id": "816ab651-72e2-33ba-b547-bd0908183c04",
                                                "text": "Однажды, проголодав целый день, поплелась я в барские хоромы и просила усильно, чтобы меня к барыне допустили."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4b5da48-eb85-33fd-ad30-a3b8173ad0c8",
                                        "entry_id": "93bb83e9-0dae-33a0-946e-080f189b713e",
                                        "glosses": [
                                            "свойственный барину, барыне; характерный для них"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b86133b8-7832-4aae-bc74-9784b13ae209",
                                                "sense_id": "c4b5da48-eb85-33fd-ad30-a3b8173ad0c8",
                                                "text": "Тот ответил ему небрежным, барским кивком головы и, наклонясь над столом, начал писать."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
