                        "cross_references": [
                            {
                                "target_word": "chatterbox",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e98ebe6-3c83-3c78-987c-6262439d5e09",
                                        "entry_id": "60f81a8a-fd22-324a-bbbf-389a68b20a52",
                                        "glosses": [
                                            "One who chats or talks to excess."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21f8fb86-2e93-40a4-aead-e23f6fb42d60",
                                                "sense_id": "0e98ebe6-3c83-3c78-987c-6262439d5e09",
                                                "text": "[S]he [Edwina, mother of Tennessee Williams] was indeed Amanda [Wingfield, character in Williams' play The Glass Menagerie] in the flesh: a doughty chatterbox from Ohio who adopted the manner of a Southern belle and eschewed both drink and sex to the greatest extent possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ecd2c56-c4c9-3990-9561-bdaa80e9358f",
                                        "entry_id": "60f81a8a-fd22-324a-bbbf-389a68b20a52",
                                        "glosses": [
                                            "Synonym of cootie catcher (“children's fortune-telling device”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e859580a-ed42-315c-8fdf-6906d77dabab",
                                        "entry_id": "60f81a8a-fd22-324a-bbbf-389a68b20a52",
                                        "glosses": [
                                            "Synonym of chatterbot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3933cdbd-13e5-30b4-90dc-ee76deaf065c",
                                        "entry_id": "60f81a8a-fd22-324a-bbbf-389a68b20a52",
                                        "glosses": [
                                            "The orchid Epipactis gigantea."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b542682-6660-455f-aa2f-f9087748367f",
                        "source_entry_id": "1fc12ac9-c301-308b-a151-a6469d23d21d",
                        "source_sense_id": "7f398fe7-0a8e-34e1-9867-5a2325ef1be8",
                        "target_lang_word": "tattler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tattler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89c0cd58-2035-38c8-9d39-1fa734cdc195",
                                        "entry_id": "a18f5d32-d898-3259-b281-292bba53a828",
                                        "glosses": [
                                            "One who tattles (notifies authorities of illicit behavior) or is inclined to do so; a tattletale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eb0dc55-3491-4f87-9ad7-bf2c9300920d",
                                                "sense_id": "89c0cd58-2035-38c8-9d39-1fa734cdc195",
                                                "text": "My sister is a big tattler; she always tells Mommy when I hit her!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "798e5c22-7ae8-33f0-bc0c-905a4a456e1a",
                                        "entry_id": "a18f5d32-d898-3259-b281-292bba53a828",
                                        "glosses": [
                                            "Either of two similar bird species in the shorebird genus Heteroscelus (Tringa in some taxonomies)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f2a0194-f091-31a7-a23c-328b477dbaa2",
                                        "entry_id": "a18f5d32-d898-3259-b281-292bba53a828",
                                        "glosses": [
                                            "A device fitted to a vehicle to measure mileage etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ba962a-c9b8-4bfa-9e04-be9fb774e866",
                                                "sense_id": "6f2a0194-f091-31a7-a23c-328b477dbaa2",
                                                "text": "A few truck drivers griped drowsily about the tattlers in their cabs which graphed the mileage per hour per day."
                                            },
                                            {
                                                "example_id": "0c9b7353-3839-4466-b36d-9499f9dd11b1",
                                                "sense_id": "6f2a0194-f091-31a7-a23c-328b477dbaa2",
                                                "text": "Electronic monitors (black box, tattlers) help to define the actions of the driver during normal and emergent operation of the EMS unit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7756fe6a-f407-462d-9ec6-fd9b35cfe070",
                        "source_entry_id": "1fc12ac9-c301-308b-a151-a6469d23d21d",
                        "source_sense_id": "7f398fe7-0a8e-34e1-9867-5a2325ef1be8",
                        "target_lang_word": "telltale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "telltale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "791727ca-54dd-3a9e-92a1-f34f11fd0d4a",
                                        "entry_id": "d9db0ff7-44ed-37e0-a52a-ac8aeb5fecc7",
                                        "glosses": [
                                            "One who divulges private information with intent to hurt others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cade3dc-f1c8-4d2a-bad8-b633bd646389",
                                                "sense_id": "791727ca-54dd-3a9e-92a1-f34f11fd0d4a",
                                                "text": "Your husband is at hand; I heare his Trumpet, / We are not tell-tales, Madam; feare you not."
                                            },
                                            {
                                                "example_id": "0471879e-93f9-4939-a139-52579bd0b5f6",
                                                "sense_id": "791727ca-54dd-3a9e-92a1-f34f11fd0d4a",
                                                "text": "There were some ill-natured people —tell-tales—it seemed, in Tamai; and hence there was a deal of mystery about getting up the dance."
                                            },
                                            {
                                                "example_id": "e4f12279-6a72-4251-986f-a7bf6d723fb7",
                                                "sense_id": "791727ca-54dd-3a9e-92a1-f34f11fd0d4a",
                                                "text": "Louis tells me that the gossip of the sailors finds its way aft, and that two of the telltales have been badly beaten by their mates."
                                            },
                                            {
                                                "example_id": "bd9f9527-d47f-4d0d-82dd-e1b0e7a8cf46",
                                                "sense_id": "791727ca-54dd-3a9e-92a1-f34f11fd0d4a",
                                                "text": "The Chinese girls who saw me yesterday are telltales. I'd better wait till dark."
                                            },
                                            {
                                                "example_id": "c289d2bf-5ac8-4005-94d7-336080dc2d2c",
                                                "sense_id": "791727ca-54dd-3a9e-92a1-f34f11fd0d4a",
                                                "text": "Try to teach your child that there's a time to intervene and a time to mind your own business. Nobody loves a telltale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e5501a4-ded4-3bbd-8bdb-796c1f3cc4dd",
                                        "entry_id": "d9db0ff7-44ed-37e0-a52a-ac8aeb5fecc7",
                                        "glosses": [
                                            "An indicator, such as a warning light, that serves to warn of a hazard or problem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88546f28-c413-416b-a5f3-cf550637bced",
                                                "sense_id": "7e5501a4-ded4-3bbd-8bdb-796c1f3cc4dd",
                                                "text": "A railroad company, which has properly erected a “telltale,” or signal board, to give warning of the approach of a train to a bridge and which lights the place at night by an electric light, is not responsible for injury caused at night by the “telltale” to a brakeman who had been passing under it at regular intervals for five weeks, though when injured he was standing upon a new car higher than those before used, and though he ad received no warning from the company as to the danger of standing upon such a car while passing under the \"telltale\"."
                                            },
                                            {
                                                "example_id": "65a1785a-cbc7-4278-b2e1-01fd21caafe0",
                                                "sense_id": "7e5501a4-ded4-3bbd-8bdb-796c1f3cc4dd",
                                                "text": "A float telltale to be provided which shall connect with indicator on first floor by a small chain run through 1-2 inch pipe and over pulleys well guarded against the weather."
                                            },
                                            {
                                                "example_id": "7555eebb-0dc9-4f10-a040-5f1e8df409a6",
                                                "sense_id": "7e5501a4-ded4-3bbd-8bdb-796c1f3cc4dd",
                                                "text": "For example, when trailers containing new automobiles were first piggybacked two areas of potential damage became evident: (1) diesel locomotive exhaust left a film of oil on the new autos; and (2) auto windshields could be scarred or cracked by the metal-tipped \"tell-tales\" which warn men atop trains of oncoming bridges or tunnels. Accordingly, automobiles aboard piggyback flats are usually coupled into the train 15 or more cars behind the locomotive; and telltales have been raised."
                                            },
                                            {
                                                "example_id": "d7a40ed6-3bb1-41e1-89c0-c1b29771cbab",
                                                "sense_id": "7e5501a4-ded4-3bbd-8bdb-796c1f3cc4dd",
                                                "text": "Except for informational readout displays, each discrete and distinct telltale shall be of the color shown in column 2 of Table 2."
                                            },
                                            {
                                                "example_id": "e32b9886-ebf6-4519-b942-b9b07643c03f",
                                                "sense_id": "7e5501a4-ded4-3bbd-8bdb-796c1f3cc4dd",
                                                "text": "In order to resolve the discrepancy and permit the use of telltales in informational readout displays, the agency proposed the following requirement: Telltales and gauges incorporated into informational readout displays ( a ) Shall have not less than two levels of light intensity, a higher one for day and a lower one for nighttime conditions. (b) In the case of telltales amd gauges not equipped with a variable light intensity control shall have a light intensity at the higher level […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b11d956a-da0e-355f-aff5-d6cbc7558c55",
                                        "entry_id": "d9db0ff7-44ed-37e0-a52a-ac8aeb5fecc7",
                                        "glosses": [
                                            "Something that serves to reveal something else."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd6228f0-0847-4e0f-91f0-81daf958838e",
                                                "sense_id": "b11d956a-da0e-355f-aff5-d6cbc7558c55",
                                                "text": "The telltale was the lipstick on his shirt collar."
                                            },
                                            {
                                                "example_id": "bf88b62c-a262-40fb-9b0d-8187538d3914",
                                                "sense_id": "b11d956a-da0e-355f-aff5-d6cbc7558c55",
                                                "text": "It supplies many useful links and tell-tales."
                                            },
                                            {
                                                "example_id": "886ba529-5b58-4d7b-a506-80c27327362c",
                                                "sense_id": "b11d956a-da0e-355f-aff5-d6cbc7558c55",
                                                "text": "In most cases the event is shielded by a large mass and only telltales arrive on earth. Such telltales include neutrinos, or even some form of radiation."
                                            },
                                            {
                                                "example_id": "4db910e5-5c58-464f-8cbf-22c3ca9abe62",
                                                "sense_id": "b11d956a-da0e-355f-aff5-d6cbc7558c55",
                                                "text": "It can be claimed that VC-dimension is to PAC-learning what finite telltales are to Inductive inference."
                                            },
                                            {
                                                "example_id": "bbd28f5a-045f-49e5-8cd1-7c4370c77f9c",
                                                "sense_id": "b11d956a-da0e-355f-aff5-d6cbc7558c55",
                                                "text": "Just as small pieces of rock produce telltale directional noon holes, so do large pieces of rock on snow produce telltales: but these telltales are of rather a different kind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a8304c-f12f-336c-a731-f2981b35037d",
                                        "entry_id": "d9db0ff7-44ed-37e0-a52a-ac8aeb5fecc7",
                                        "glosses": [
                                            "A movable piece of ivory, lead, or other material, connected to the bellows of an organ, whose position indicates when the wind is exhausted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31b80812-e309-32e8-adbb-febbcc894cae",
                                        "entry_id": "d9db0ff7-44ed-37e0-a52a-ac8aeb5fecc7",
                                        "glosses": [
                                            "A length of yarn or ribbon attached to a sail or shroud etc to indicate the direction of the flow of the air relative to the boat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6804e3aa-7227-4427-9295-062817336fc5",
                                                "sense_id": "31b80812-e309-32e8-adbb-febbcc894cae",
                                                "text": "The sailmakers mistake can be an excellent way to lose a race as the telltale signals were disturbed and confusing."
                                            },
                                            {
                                                "example_id": "2f220aa1-e4a2-4107-ae5b-25948bead4a0",
                                                "sense_id": "31b80812-e309-32e8-adbb-febbcc894cae",
                                                "text": "If you turn toward the wind, the sail becomes undertrimmed, and the inside, or windward, telltale starts to rise and flutter as the flow is disturbed."
                                            },
                                            {
                                                "example_id": "0fa1cc80-a3b1-4525-b063-f9d7c62faa66",
                                                "sense_id": "31b80812-e309-32e8-adbb-febbcc894cae",
                                                "text": "The telltale shows if wind is flowing across the sail on every point of sail except a run."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e257d8e0-3f33-3ad4-a509-ebcf69d47d74",
                                        "entry_id": "d9db0ff7-44ed-37e0-a52a-ac8aeb5fecc7",
                                        "glosses": [
                                            "A mechanical attachment to the steering wheel, which, in the absence of a tiller, shows the position of the helm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae02a6f1-9511-35f2-821f-712c9dfa3ce0",
                                        "entry_id": "d9db0ff7-44ed-37e0-a52a-ac8aeb5fecc7",
                                        "glosses": [
                                            "A compass in the cabin of a vessel, usually placed where the captain can see it at all hours, and thus inform himself of the vessel's course."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84c00bc6-cbcd-3782-807c-243b53f11e1b",
                                        "entry_id": "d9db0ff7-44ed-37e0-a52a-ac8aeb5fecc7",
                                        "glosses": [
                                            "A machine or contrivance for indicating or recording something, particularly for keeping a check upon employees (factory hands, watchmen, drivers, etc.) by revealing to their employers what they have done or omitted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78b6d6ab-76fd-3790-a6b0-45c2b5427237",
                                        "entry_id": "d9db0ff7-44ed-37e0-a52a-ac8aeb5fecc7",
                                        "glosses": [
                                            "A bird, the tattler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d081da5d-8830-346c-b74c-0a6ccde22784",
                                        "entry_id": "d9db0ff7-44ed-37e0-a52a-ac8aeb5fecc7",
                                        "glosses": [
                                            "A story or fable that has a moral or message."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f864186b-2f6c-4796-bce1-d136c3a249af",
                                                "sense_id": "d081da5d-8830-346c-b74c-0a6ccde22784",
                                                "text": "\"Metamorphoses . . .\" is the title of a book of telltales (or serialised fables) written by Lucius Apulei¡us, a neo-platonist priest in the second century A.D."
                                            },
                                            {
                                                "example_id": "2ba4990a-b59a-4f1e-8c8f-b9117ec6ffd4",
                                                "sense_id": "d081da5d-8830-346c-b74c-0a6ccde22784",
                                                "text": "This telltale is not like the story that you put in the hands of your children, or those narrated by mothers in their children's bedrooms in Western Europe before sleep. This is a telltale that is not welcome but is forbidden to be distributed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "telltale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68428f99-6490-3457-b5b1-bb7873ba089a",
                                        "entry_id": "1b6c6061-578d-3a38-9b9c-5a7392c6585a",
