                        "zh": "商店中用于计算应付金额并存放现金的机器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "касса",
                                "target_lang_sense_clarification": "кассовый аппарат или место оплаты"
