                    },
                    {
                        "sense_id": "9df35da2-35ad-391f-a978-2d650cd6f127",
                        "entry_id": "1ac747ba-206a-3420-a1ba-791d529e1745",
                        "glosses": [
                            "Vortrag (Rede), der auf einen zuvor gehaltenen Vortrag antwortet und ihm in Kernpunkten widerspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59676187-3157-46dc-9825-e77ea63d824b",
                                "sense_id": "9df35da2-35ad-391f-a978-2d650cd6f127",
                                "text": "Rede und Gegenrede bedingen sich wechselseitig, denn jeder Punkt der Rede fordert seine Entsprechung in der Gegenrede."
                            }
                        ],
