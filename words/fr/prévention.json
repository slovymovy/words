    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba60f44a-8914-3bad-a82f-6dde7c244067",
                    "sense_definition": "Ensemble des mesures prises pour empêcher l'apparition, l'aggravation ou la réalisation d'un risque, d'un danger ou d'une maladie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "securite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>prévention</w> des maladies passe avant tout par une alimentation équilibrée et du sport."
                        },
                        {
                            "text": "Cette campagne de <w>prévention</w> routière vise à réduire les accidents chez les jeunes."
                        }
                    ],
                    "synonyms": [
                        "prophylaxie"
                    ],
                    "common_phrases": [
                        "campagne de prévention",
                        "mesure de prévention",
                        "prévention routière"
                    ]
                },
                {
                    "sense_id": "356fd5c7-adbc-3c66-acd0-4c3b82ff5b92",
                    "sense_definition": "Jugement préconçu et sans fondement objectif, généralement défavorable, à l'égard de quelqu'un ou de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a rapidement surmonté sa <w>prévention</w> envers cette nouvelle méthode de travail."
                        },
                        {
                            "text": "Il convient d'examiner chaque dossier avec impartialité et sans aucune <w>prévention</w>."
                        }
                    ],
                    "synonyms": [
                        "a priori",
                        "parti pris",
                        "préjugé"
                    ],
                    "antonyms": [
                        "impartialité",
                        "objectivité"
                    ],
                    "common_phrases": [
                        "avoir une prévention",
                        "sans prévention"
                    ]
                },
                {
                    "sense_id": "19177dbc-8809-3d42-9c18-4b50c199920a",
                    "sense_definition": "État d'incarcération provisoire d'une personne poursuivie en justice avant son jugement définitif.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le suspect a passé trois mois en <w>prévention</w> avant d'être jugé par le tribunal."
                        },
                        {
                            "text": "La durée maximale de la <w>prévention</w> est strictement encadrée par le code de procédure pénale."
                        }
                    ],
                    "synonyms": [
                        "détention préventive",
                        "détention provisoire"
                    ],
                    "antonyms": [
                        "liberté"
                    ],
                    "common_phrases": [
                        "en prévention"
                    ]
                }
            ]
        }
    ]
