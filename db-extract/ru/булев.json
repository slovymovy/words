                "translations": [
                    {
                        "translation_id": "a53815f2-5353-4804-988d-bc20de46ca9d",
                        "source_entry_id": "5282e9df-c898-3c04-808a-da33a5c0bdef",
                        "source_sense_id": "1286d64a-6a3a-3809-934a-348ca76b0051",
                        "target_lang_word": "Boolean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boolean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b90219a-d372-3dd9-9036-8b6a844c00d1",
                                        "entry_id": "944b4913-389b-3327-ad03-47b1b3f601a3",
                                        "glosses": [
                                            "Of or pertaining to the work of George Boole."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b97a44a6-94fd-3831-ae0d-89e8b88e3a77",
                                        "entry_id": "944b4913-389b-3327-ad03-47b1b3f601a3",
                                        "glosses": [
                                            "Pertaining to data items that can have “true” and “false” (or, equivalently, 1 and 0 respectively) as their only possible values and to operations on such values."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2987d689-80aa-4c64-a29c-a5c0a2dfd814",
                                                "sense_id": "b97a44a6-94fd-3831-ae0d-89e8b88e3a77",
                                                "text": "Oh, Boolean operators! \"Blue and ones\"! Good idea!"
                                            },
                                            {
                                                "example_id": "0241caad-7f63-4bd0-afc6-3b8148d91a77",
                                                "sense_id": "b97a44a6-94fd-3831-ae0d-89e8b88e3a77",
                                                "text": "The associativity of OR and AND is not at all obvious. It is tempting to assume that because OR and AND are commutative that they must be associative also. This is not the case, however, and some commutative Boolean operators are not associative. Examples include NAND and NOR."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Boolean",
                                "target_lang_code": "en",
                                "target_senses": [
