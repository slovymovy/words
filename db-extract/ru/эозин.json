                    },
                    {
                        "sense_id": "a7a58d6b-dcee-3577-b79f-8d127a025a52",
                        "entry_id": "ed8302e0-0fae-3c32-a799-060f3dde2739",
                        "glosses": [
                            "спец. название некоторых органических искусственных красок из группы ксантеновых; окрашивают шерсть, шёлк и бумагу в разные оттенки красного цвета"
                        ],
