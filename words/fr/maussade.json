                        "terne",
                        "monotone"
                    ],
                    "common_phrases": [
                        "vie maussade",
                        "existence maussade"
                    ],
                    "target_lang_definitions": {
                        "en": "Causes boredom, weariness or sadness; dull and lacking appeal.",
                        "ru": "О том, что наводит скуку, уныние или тоску; тусклое и неинтересное.",
                        "de": "Beschreibt etwas, das Langeweile, Überdruss oder Traurigkeit auslöst und ohne Reiz ist.",
                        "es": "Que resulta aburrido, cansino o triste, y carece de interés o atractivo.",
                        "zh": "形容令人厌倦、沉闷或悲伤，缺乏吸引力的事物。"
                    },
