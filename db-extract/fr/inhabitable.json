                "senses": [
                    {
                        "sense_id": "4e166864-aef0-3865-a9a9-477684580bad",
                        "entry_id": "5d2b6118-c5fd-3f79-a369-a39b96cdfa0d",
                        "glosses": [
                            "Qui ne peut être habité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9da1169a-497f-4550-8302-ab1488153cf7",
                                "sense_id": "4e166864-aef0-3865-a9a9-477684580bad",
                                "text": "Cinq minutes après, j'étais dans une chambre, qui, toute nue et toute inhabitable qu'elle eût paru à l'homme le moins difficile, était évidemment la plus belle du château."
                            },
                            {
                                "example_id": "efb93da1-ff6d-458a-aa7a-2029f909552a",
                                "sense_id": "4e166864-aef0-3865-a9a9-477684580bad",
                                "text": "Ces tentes, dont le bas est garni de mottes de terre, ont toutes un trou au sommet pour laisser un libre essor à la fumée qui, sans cette précaution, les rendrait inhabitables."
                            },
                            {
                                "example_id": "80ece202-0f3f-4716-8c73-2c40fc0d2df2",
                                "sense_id": "4e166864-aef0-3865-a9a9-477684580bad",
                                "text": "Aux aventureux, l'Islande offre aussi l’attrait de l’inconnu. Le cœur de l’île, inhabité et inhabitable, est encore une terre incognito."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d21c370-b7a2-4acc-9d59-f209768f4048",
                        "source_entry_id": "5d2b6118-c5fd-3f79-a369-a39b96cdfa0d",
                        "source_sense_id": "4e166864-aef0-3865-a9a9-477684580bad",
                        "target_lang_word": "uninhabitable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uninhabitable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "742b6fd8-2c64-39b0-8cb8-133c39b6e834",
                                        "entry_id": "7cb7f8af-bd49-3cec-abeb-97b2a6f89875",
                                        "glosses": [
                                            "Not fit for people (or other living things) to live in; not able to be inhabited."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eeefd10-5d4e-446c-bbe4-c05fe7bb9c1c",
                                                "sense_id": "742b6fd8-2c64-39b0-8cb8-133c39b6e834",
                                                "text": "The earthquake left many homes in the area uninhabitable."
                                            },
                                            {
                                                "example_id": "964c8971-37f9-4805-80d3-39cf93f713f7",
                                                "sense_id": "742b6fd8-2c64-39b0-8cb8-133c39b6e834",
                                                "text": "Though this island seem to be desert,— […]\nUninhabitable and almost inaccessible,—"
                                            },
                                            {
                                                "example_id": "e50e07b8-864f-4b42-8e21-e906f3a1da86",
                                                "sense_id": "742b6fd8-2c64-39b0-8cb8-133c39b6e834",
                                                "text": "Then there is the misery of leaking roofs and oozing walls, which in winter makes some rooms almost uninhabitable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1136192-aa84-4f9f-8bb8-3e65fb76abc1",
                        "source_entry_id": "5d2b6118-c5fd-3f79-a369-a39b96cdfa0d",
