                    {
                        "sense_id": "3cef32bd-0065-3f08-9ff1-5088222bf846",
                        "entry_id": "47088197-edcc-32c4-a77d-e14cdf472593",
                        "glosses": [
                            "Qui est propre à épuiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b879e0-5f32-47a1-bdf2-467ebe6096f3",
                                "sense_id": "3cef32bd-0065-3f08-9ff1-5088222bf846",
                                "text": "Cultures épuisantes, cultures qui épuisent rapidement la terre."
                            },
                            {
                                "example_id": "8f95a15b-a91a-4a33-88c6-db1e8a2d5906",
                                "sense_id": "3cef32bd-0065-3f08-9ff1-5088222bf846",
                                "text": "Si le vent est contraire, rien d'autre à faire que ramer, ce qui exige un effort épuisant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce9283d9-7d12-4717-87ae-1fc49b8fb16a",
                        "source_entry_id": "47088197-edcc-32c4-a77d-e14cdf472593",
                        "source_sense_id": "3cef32bd-0065-3f08-9ff1-5088222bf846",
                        "source_sense_description": "Propre à épuiser",
                        "target_lang_word": "strapaziös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strapaziös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50934ae8-b2e3-3497-9937-f715e9eb8ce1",
                                        "entry_id": "3d1df0c2-40f2-3995-904a-3f2bb1efa7fa",
                                        "glosses": [
                                            "so, dass es körperlich oder geistig anstrengend ist und nach und nach jemanden auslaugt; mit Strapazen verbunden; für jemanden voller Schwierigkeiten seiend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2292482-8108-4358-b267-53dafa2cce6c",
                                                "sense_id": "50934ae8-b2e3-3497-9937-f715e9eb8ce1",
                                                "text": "„Meine Mama ist, seitdem sie alleinerziehend ist, extrem strapaziös.“"
                                            },
                                            {
                                                "example_id": "5a456691-ec0f-4463-a9b2-fb142417ecde",
                                                "sense_id": "50934ae8-b2e3-3497-9937-f715e9eb8ce1",
                                                "text": "„Das Wochenende war dermaßen strapaziös, eigentlich bin ich viel zu kaputt zum Arbeiten.“"
                                            },
                                            {
                                                "example_id": "9d048bed-7bf2-485f-87b1-ccde1c4d2c03",
                                                "sense_id": "50934ae8-b2e3-3497-9937-f715e9eb8ce1",
                                                "text": "„Ein Wochenende mit einem Zehnkampf, bei dem du alles gibst, ist so strapaziös, davon kannst du höchstens zwei im Jahr bestreiten.“"
                                            },
                                            {
                                                "example_id": "4e3bc9ab-f0f3-4ace-a261-2ab50f8e5899",
                                                "sense_id": "50934ae8-b2e3-3497-9937-f715e9eb8ce1",
                                                "text": "Die Arbeitsbedingungen für Filmschaffende sind meist strapaziös."
                                            },
                                            {
                                                "example_id": "4a81a456-c108-46ce-b6e9-53951d08e858",
                                                "sense_id": "50934ae8-b2e3-3497-9937-f715e9eb8ce1",
                                                "text": "Kurz vor der Kommunalwahl ist in Aying bei München eine ungewöhnliche Altersgrenze eingeführt worden: Wer älter ist als 70 Jahre, dem sei das strapaziöse Auszählen nicht mehr zuzumuten. Die abgewiesenen Wahlhelfer sehen das allerdings ganz anders."
                                            },
                                            {
                                                "example_id": "24a68755-8f9a-4669-877b-eeffc9c1638e",
                                                "sense_id": "50934ae8-b2e3-3497-9937-f715e9eb8ce1",
                                                "text": "Kaum eine Bühne der Welt, die 2013 ohne Wagner auskommt. Gute Wagner-Solisten waren schon immer Mangelware, im nächsten Jahr dürfte der Reigen der Aufführungen für die Mitwirkenden besonders strapaziös sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
