                "senses": [
                    {
                        "sense_id": "c5df27dc-db7d-3a4b-bf51-4b96a2cc82d7",
                        "entry_id": "d53b7153-9438-3aa1-9b2e-87a5fae38d75",
                        "glosses": [
                            "сжигать часть предмета"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "827b4b46-669c-3b56-aa61-1d9001c1dc52",
                        "entry_id": "d53b7153-9438-3aa1-9b2e-87a5fae38d75",
                        "glosses": [
                            "спец. подвергать отжигу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "857ad667-e072-4eb4-9cdd-959c13081988",
                                "sense_id": "827b4b46-669c-3b56-aa61-1d9001c1dc52",
                                "text": "При нём происходила доводка золота в полдень и вечером, и он сам отжигал на огне полученную «сортучку», как называют на промыслах соединение ртути с золотом."
                            },
                            {
                                "example_id": "ad1e1ae2-4d62-403e-9305-51b53e3e96f7",
                                "sense_id": "827b4b46-669c-3b56-aa61-1d9001c1dc52",
                                "text": "Пикар устроил специальную томильную печь и там отжигал отлитые трубы, чтобы снять отбел."
                            }
                        ]
                    },
                    {
                        "sense_id": "f299c60c-dacf-3020-9120-d5f52d4ce8c1",
                        "entry_id": "d53b7153-9438-3aa1-9b2e-87a5fae38d75",
                        "glosses": [
                            "перен., сленг делать что-либо из ряда вон выходящее, выходить за рамки обыденности, проявлять экстраординарность или эксцентричность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9c758c9-e587-4053-bb4d-3d11e7459102",
                                "sense_id": "f299c60c-dacf-3020-9120-d5f52d4ce8c1",
                                "text": "По вечерам мы отжигали в клубах, пили абсент, нюхали кокс, жрали кислое…"
                            }
                        ]
                    }
                ],
