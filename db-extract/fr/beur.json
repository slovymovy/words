                        ],
                        "form": "beure"
                    },
                    {
                        "form_id": "a715acd9-a859-4c49-9221-48387bb1795c",
                        "entry_id": "2bf7f4a8-0ffc-3065-a403-50e61dc3c81b",
                        "tags": [
                            "feminine"
                        ],
                        "form": "beurette"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "836dcaa2-575b-3457-865d-6504fc0d47cc",
                        "entry_id": "2bf7f4a8-0ffc-3065-a403-50e61dc3c81b",
                        "glosses": [
                            "Personne d’origine maghrébine."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "f92c1638-ec3a-459e-ad55-d602d50300e6",
                                "sense_id": "836dcaa2-575b-3457-865d-6504fc0d47cc",
                                "text": "L’amitié entre un Français et un beur a été symbolisée par le film Tchao Pantin de Claude Berri, adapté du roman d’Alain Page."
                            },
                            {
                                "example_id": "71b5c945-87ab-4a41-adef-6acb65ef8e32",
                                "sense_id": "836dcaa2-575b-3457-865d-6504fc0d47cc",
                                "text": "Ils avaient reçu un nom collectif qui signifiait tout à la fois leur origine, leur couleur de peau et leur façon de parler : les Beurs. Par dérision on leur attribuait un je parle la France. Ils étaient nombreux, on ne les connaissait pas."
                            },
                            {
                                "example_id": "f8d86c79-1372-4bc1-b42d-cd252b64ddc1",
                                "sense_id": "836dcaa2-575b-3457-865d-6504fc0d47cc",
                                "text": "Et s’il est de bon ton pour un jeune Beur de sortir avec une Céfran hâtivement qualifiée de Gauloise, il tolère mal que sa sœur en fasse autant avec un Souchien, comme ils disent élégamment : […]. Mais si la Beurette susdite sort avec un kahlouche, alors là, pas de quartier ! Touche pas à ma sœur, tu vas la salir. Et toi, tu vas me faire le plaisir de porter un voile, désormais, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bd0dd67-0526-461d-99dd-eae23d9e1b81",
                        "source_entry_id": "2bf7f4a8-0ffc-3065-a403-50e61dc3c81b",
                        "source_sense_id": "836dcaa2-575b-3457-865d-6504fc0d47cc",
                        "target_lang_word": "араб",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "араб",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8cbd7a2f-4939-3c4a-9abb-d929afb6bf99",
                                        "entry_id": "f106664a-b97f-3385-b024-52b40e14c8ff",
                                        "glosses": [
                                            "этногр. представитель одного из семитских народов, издавна населявших Ближний Восток и Северную Африку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8d6782c-c1f5-4be0-a2a2-7541a0607f7b",
                                                "sense_id": "8cbd7a2f-4939-3c4a-9abb-d929afb6bf99",
                                                "text": "Название этого «синтезированного» народа год за годом, медленно, но неуклонно меняло свой смысл. Когда-то арабом называли просто аравийца: была страна, которая звалась Аравией. Однако сути проблемы такая связь не раскрыла. Существовал язык, который называли арабским, и именно он в данном случае является критерием оценки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "30f43d09-abfb-4a91-927d-33eff764a75f",
