                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15ce6f56-6d39-3968-84e4-e36598eece23",
                                        "entry_id": "b935c74f-6d70-39ff-a1cb-d6bf5d17d560",
                                        "glosses": [
                                            "Brioche italienne fourrée de raisins secs, de fruits confits et de zestes d’agrumes qui se mange par tradition à Noël."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97485f7c-834e-4eb0-a411-304db7d08dfc",
                                                "sense_id": "15ce6f56-6d39-3968-84e4-e36598eece23",
                                                "text": "L’homme arrêté était également en possession d’un plat en porcelaine et d’un panettone - gâteau italien typique de Noël - qui seraient le fruit d’autres actes d’extorsion."
                                            },
                                            {
                                                "example_id": "691f831c-e87f-490f-a3dd-3240dffab6ee",
                                                "sense_id": "15ce6f56-6d39-3968-84e4-e36598eece23",
                                                "text": "Dans un décor élégant, sur place ou à emporter, choisissez le meilleur de l’Italie : fromage, charcuteries, prosecco et autre panettone sauront vous faire voyager."
                                            },
                                            {
                                                "example_id": "c70ee8f9-eebc-4010-8dd7-8970a65b6ead",
                                                "sense_id": "15ce6f56-6d39-3968-84e4-e36598eece23",
                                                "text": "« On assiste à une croissance des ventes en hypermarchés et supermarchés de 15 %, entre 2020 et 2022 », explique Claire Luquet, directrice de la marque Casino qui précise que « les panettones classiques représentent 54 % des ventes en volume »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
