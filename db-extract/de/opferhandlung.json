                        "examples": [
                            {
                                "example_id": "121b5f65-9ffe-4085-b5c9-76fb0ac749c9",
                                "sense_id": "fc3fc564-bbec-3f34-9b22-ac2ede9481ac",
                                "text": "„Die dargestellten Personen tragen eindeutig keltische Kleidung, eine Szene stellt wahrscheinlich Opferhandlungen mit einem Priester dar.“"
                            },
                            {
                                "example_id": "ed1b4987-4982-4afb-8273-37004a54875b",
                                "sense_id": "fc3fc564-bbec-3f34-9b22-ac2ede9481ac",
                                "text": "„Noch bis vor etwa 50 Jahren waren kultische Opferhandlungen fast ausschließlich aus diesen Schilderungen antiker Autoren bekannt – und es war nicht ganz sicher, ob man den Berichten über Menschenopfer tatsächlich trauen durfte.“"
                            }
