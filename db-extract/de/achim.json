                    {
                        "sense_id": "18ab363d-1335-3b6b-8f45-e8a56edf69db",
                        "entry_id": "eb5ad8f8-42a1-3b61-9230-bd1b24824da7",
                        "glosses": [
                            "Stadt in Niedersachsen an der Weser (Landkreis Verden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5c4e81c-cef3-423a-a8a5-2e0eb137f64e",
                                "sense_id": "18ab363d-1335-3b6b-8f45-e8a56edf69db",
                                "text": "„Wegen ausströmenden Gases haben rund 250 Menschen in Achim ihre Arbeitsplätze verlassen müssen.“"
                            },
                            {
                                "example_id": "4e858fba-cd13-41e5-9b20-7615cefb8a4d",
                                "sense_id": "18ab363d-1335-3b6b-8f45-e8a56edf69db",
                                "text": "Ich bin in Achim geboren."
                            },
                            {
                                "example_id": "061db2c5-11be-4a71-a068-e8f5dcb566af",
                                "sense_id": "18ab363d-1335-3b6b-8f45-e8a56edf69db",
                                "text": "Ich habe in Achim meinen Urlaub verbracht."
                            },
                            {
                                "example_id": "f97e0f09-faf1-4fb2-a52d-52d199879eb8",
                                "sense_id": "18ab363d-1335-3b6b-8f45-e8a56edf69db",
                                "text": "Nach Achim führen viele Wege."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
