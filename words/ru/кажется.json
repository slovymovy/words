                    "sense_id": "d05a7a6d-da1e-3f16-a1b6-29dc795f198f",
                    "sense_definition": "Вводное слово, выражающее неуверенное предположение или допущение; по-видимому, вероятно.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Кажется</w>, мы заблудились и пошли не в ту сторону.",
                            "target_lang_translations": {
                                "en": "<w>It seems</w> we got lost and went the wrong way.",
                                "nl": "<w>Het lijkt erop dat</w> we verdwaald zijn en de verkeerde kant op zijn gegaan.",
                                "pl": "<w>Chyba</w> zabłądziliśmy i poszliśmy w złą stronę.",
                                "de": "<w>Anscheinend</w> haben wir uns verlaufen und sind in die falsche Richtung gegangen.",
                                "fr": "<w>Il semble que</w> nous nous soyons perdus et que nous ayons pris le mauvais chemin.",
                                "it": "<w>Sembra</w> che ci siamo persi e abbiamo preso la direzione sbagliata.",
                                "cs": "<w>Zdá se</w>, že jsme zabloudili a šli špatným směrem.",
                                "tr": "<w>Galiba</w> kaybolduk ve yanlış yöne gittik.",
                                "es": "<w>Parece que</w> nos hemos perdido y hemos ido en la dirección equivocada.",
                                "zh": "<w>好像</w>我们迷路了，走错了方向。"
                            }
                        },
                        {
                            "text": "Я, <w>кажется</w>, забыл выключить свет на кухне.",
                            "target_lang_translations": {
                                "en": "I <w>think</w> I forgot to turn off the light in the kitchen.",
                                "nl": "Ik ben, <w>denk ik</w>, vergeten het licht in de keuken uit te doen.",
                                "pl": "Ja, <w>chyba</w>, zapomniałem zgasić światło w kuchni.",
                                "de": "Ich habe, <w>glaube</w> ich, vergessen, das Licht in der Küche auszuschalten.",
                                "fr": "J'ai, <w>je crois</w>, oublié d'éteindre la lumière dans la cuisine.",
                                "it": "Mi <w>sembra</w> di aver dimenticato di spegnere la luce in cucina.",
                                "cs": "Já jsem <w>zřejmě</w> zapomněl zhasnout světlo v kuchyni.",
                                "tr": "Mutfaktaki ışığı kapatmayı <w>sanırım</w> unuttum.",
                                "es": "<w>Creo que</w> olvidé apagar la luz de la cocina.",
                                "zh": "我<w>好像</w>忘了关厨房的灯。"
                            }
                        }
