                        "examples": [
                            {
                                "example_id": "5a948c63-d5e8-4502-9f4e-1648b2f2881f",
                                "sense_id": "f0dd1201-e86c-320b-94a1-db67385c0a3a",
                                "text": "Ambulancehulp is niet altijd op tijd: Uit het jaarverslag van Ambulancezorg Oost over 2011 blijkt dat het gemiddelde overschrijdingspercentage van ritten in Twente te hoog lag in 2010 en 2011. Volgens de landelijke norm moeten ambulances bij levensbedreigende situaties in 95 procent van de gevallen binnen een kwartier ter plaatse zijn."
                            },
                            {
                                "example_id": "df3911bb-ae3b-48cc-9a73-c262ee35ec81",
                                "sense_id": "f0dd1201-e86c-320b-94a1-db67385c0a3a",
                                "text": "OVERPELT - De medische hulpdiensten in het Noord-Limburgse Overpelt gaan de komende drie jaar in het kader van een proefproject rond grensoverschrijdende spoedeisende medische hulpverlening samenwerken met de hulpdiensten van het Nederlandse Midden-Limburg en Zuidoost-Brabant. Doel van het proefproject is tot bindende afspraken rond grensoverschrijdende ambulancehulp komen en dit, zo mogelijk, ook in een wet te gieten."
                            }
                        ]
