                "senses": [
                    {
                        "sense_id": "e23b47cd-9698-3e5a-8709-61322536346a",
                        "entry_id": "68cc3816-fb5d-34cd-9e6d-6cef47b1eeb5",
                        "glosses": [
                            "in siedendem Wasser gegarte Teigtasche mit Füllung"
                        ],
                        "tags": [
                            "Austrian German",
                            "South German"
                        ],
                        "examples": [
                            {
                                "example_id": "f780f233-7260-4953-9e73-0539de633aa9",
                                "sense_id": "e23b47cd-9698-3e5a-8709-61322536346a",
                                "text": "„Darin schwimmen mit Kalbfleisch gefüllte Maultascherl.“"
                            },
                            {
                                "example_id": "ee68d6cf-005b-40a7-84d9-474d36899625",
                                "sense_id": "e23b47cd-9698-3e5a-8709-61322536346a",
                                "text": "„Jede Gruppe setzte im Wechsel mit dem Lehrling im 3.Lehrjahr, Gerhard Lorenz, fachgerecht eine Rindssuppe an, die Gruppe bei Werner Heizler steuerte mit Grießnockerln und Maultascherln die Einlage zur Kraftbrühe bei.“"
                            },
                            {
                                "example_id": "3cc51be1-aca7-48d0-a6c4-8e779dc108cc",
                                "sense_id": "e23b47cd-9698-3e5a-8709-61322536346a",
                                "text": "„Nicht schlecht, dieses chinesische Maultascherl, wirklich, und die Brühe war auch schön kräftig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
