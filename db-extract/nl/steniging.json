                                "target_senses": [
                                    {
                                        "sense_id": "ed6ac1f0-df1d-3055-8f2d-025f61180d4f",
                                        "entry_id": "18449bca-dbef-3970-b269-dfd8652f7a37",
                                        "glosses": [
                                            "Bewurf mit Steinen bis zum Tod"
