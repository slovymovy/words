                                "example_id": "aecb397c-31e3-421f-9df3-41db032703d4",
                                "sense_id": "145b0ded-42c3-3149-a094-45699d657591",
                                "text": "Einige Würger jagen auch andere Singvögel."
                            },
                            {
                                "example_id": "64b73c56-403d-4920-b168-42a42b84ac22",
                                "sense_id": "145b0ded-42c3-3149-a094-45699d657591",
                                "text": "„Am Wegesrand pickte ein Würger, der im Volksmund »Herbstvogel« genannt wird, geräuschvoll mit den Flügeln schlagend an den Früchten einer roten Vogelbeere herum.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
