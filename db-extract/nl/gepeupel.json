                        "sense_id": "9b4cbe4d-26b8-36fe-8316-759df715704e",
                        "entry_id": "ba4b742c-ac6a-3ffa-87c2-8f3918525e69",
                        "glosses": [
                            "het gewone volk, de laagste klasse"
