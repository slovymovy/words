                "senses": [
                    {
                        "sense_id": "8f872ece-ab7a-30f6-9167-0eb29acb6c4f",
                        "entry_id": "1edf44a5-647c-37d4-8cba-702bd6c331ff",
                        "glosses": [
                            "Surnom de Jésus. → voir le Galiléen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0435f9e-f8bd-41ae-a237-f5da47868584",
                                "sense_id": "8f872ece-ab7a-30f6-9167-0eb29acb6c4f",
                                "text": "« Ô Galiléen ! tu ne prévaudras point contre moi ! » s’écria Lucien."
                            }
                        ]
                    }
                ],
