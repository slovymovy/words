                "senses": [
                    {
                        "sense_id": "65391a3b-8c52-3f8c-b37a-b2e47f785594",
                        "entry_id": "ed69a75f-59c6-377e-b5e5-4bda4278fe27",
                        "glosses": [
                            "A tight-fitting brief or bikini style swimsuit."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "bb199241-39af-477b-8ea2-bb2315fdbd86",
                                "sense_id": "65391a3b-8c52-3f8c-b37a-b2e47f785594",
                                "text": "She called down from upstairs, \"He'll be out in a minute: he's just putting his Speedos on.\""
                            },
                            {
                                "example_id": "00fff16f-6471-4e80-89bf-b6718c958a6b",
                                "sense_id": "65391a3b-8c52-3f8c-b37a-b2e47f785594",
                                "text": "The women usually wore bikini tops with shorts, swimsuits underneath cover-ups or just swimsuits. Men came in various types of trunks, from traditional boxers, to Speedos, to G-string trunks that showcased their packages."
                            },
                            {
                                "example_id": "a11eb786-8fb9-430d-94d0-87819f979111",
                                "sense_id": "65391a3b-8c52-3f8c-b37a-b2e47f785594",
                                "text": "There were dozens of girls there - girls on the deck in bathing suits, most of them Speedos because they were racing."
                            }
                        ]
                    }
                ],
