                    },
                    {
                        "translation_id": "e05a8b76-1f66-4ce3-9fd9-7cec369a520e",
                        "source_entry_id": "a0f56097-01a2-3ba7-ac5f-8e94d3f814bb",
                        "source_sense_id": "2fff10d1-937c-37ce-a982-d31ed95458cb",
                        "source_sense_description": "A flower part that produces pollen",
                        "target_lang_word": "étamine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étamine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40c7d35c-e367-330f-85dd-c87223a19f30",
                                        "entry_id": "326184b0-ae34-3b4a-9518-52cd281bb161",
                                        "glosses": [
                                            "Organe floral de l’androcée, producteur de pollen, composé d’un filet allongé et d’une anthère renflée."
                                        ],
                                        "tags": [
                                            "Anatomie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1145d26e-07ec-43be-bc7f-446b4390e21e",
                                                "sense_id": "40c7d35c-e367-330f-85dd-c87223a19f30",
                                                "text": "À Bourges, j’ai vu danser sur un vitrail une Salomé vêtue de pourpre ; elle allait, sautant sur les mains, creusant les reins ; et ses jambes pendaient au-dessus de sa tête comme deux étamines issues d’un lis rouge."
                                            },
                                            {
                                                "example_id": "fc3278e1-7418-4a56-8140-05c315696a34",
                                                "sense_id": "40c7d35c-e367-330f-85dd-c87223a19f30",
                                                "text": "M. Dickson dit avoir vu toutes les fleurs d’un Iris pseudacorus ayant un tépale converti en étamine à sommet pétaloïde."
                                            },
                                            {
                                                "example_id": "87227f1c-6801-4f04-8827-27f1dd8c3a80",
                                                "sense_id": "40c7d35c-e367-330f-85dd-c87223a19f30",
                                                "text": "Dés la première floraison, elles deviennent d’immenses lupanars à ciel ouvert où des quantités d’engagés font office d’entremetteurs, titillent le pistil, chatouillent l’étamine, fécondent jusqu’à deux mille fleurs par jour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "étamine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce9f1189-40d6-35c4-b327-673c094a836a",
                                        "entry_id": "bd5215a2-edd9-3f0a-b903-394caca429f7",
                                        "glosses": [
                                            "Étoffe mince, légère et souple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9c3c87a-b8c3-4048-bdde-8cd37bdf0856",
                                                "sense_id": "ce9f1189-40d6-35c4-b327-673c094a836a",
                                                "text": "Le pavillon claquait avec un bruit sec, et son étamine menaçait de se couper et de s’envoler en lambeaux dans le fond de la rade."
                                            },
                                            {
                                                "example_id": "32109e8e-5148-4dcc-8186-ece76ca15c80",
                                                "sense_id": "ce9f1189-40d6-35c4-b327-673c094a836a",
                                                "text": "Sur les vaisseaux, la girouette est une bande de toile légère ou d’étamine, cousue et montée sur l’équinette, ou espèce de bâti en bois, placé à la tête des mâts, et plus généralement au grand mât seulement."
                                            },
                                            {
                                                "example_id": "1e4e91bb-4531-4255-b2a2-80c47b29c28d",
                                                "sense_id": "ce9f1189-40d6-35c4-b327-673c094a836a",
                                                "text": "Encore quelques instants, et sous le souffle de la rafale, qui tordait les flammes comme l’étamine d’un pavillon, la ragged-school ne serait plus qu’une caverne de feu, un tourbillon de vapeurs incandescentes."
                                            },
                                            {
                                                "example_id": "3374c9be-3841-4025-b767-4ad1e66ff97c",
                                                "sense_id": "ce9f1189-40d6-35c4-b327-673c094a836a",
                                                "text": "La porte, à cause de l’excessive chaleur restait ouverte ; un rideau de grosse étamine retenait les mouches et laissait passer l’air, on le soulevait pour entrer."
                                            },
                                            {
                                                "example_id": "ad9439d6-6c1f-40c1-be28-b06a1a78b22e",
                                                "sense_id": "ce9f1189-40d6-35c4-b327-673c094a836a",
                                                "text": "Près d’elle, le premier clerc de l’étude, un géant osseux et ambitieux, comptait ses points sur l’étamine bien tendue d’un tambour."
                                            },
                                            {
                                                "example_id": "c9df27be-1a01-4256-b7f2-010ce34ccc94",
                                                "sense_id": "ce9f1189-40d6-35c4-b327-673c094a836a",
                                                "text": "Une paix profonde règne dans la maison. Avec ses clairs rideaux d’étamine blanche, aux doubles fenêtres, cette salle à manger a l’aspect d’un parloir de couvent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96d2d5ed-10ff-3517-9edc-4fd1c7961a75",
                                        "entry_id": "bd5215a2-edd9-3f0a-b903-394caca429f7",
                                        "glosses": [
                                            "Tissu à fines mailles, qui sert à tamiser des poudres, ou à filtrer des liquides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0069645-13ad-42af-afb4-f8885d9c03c2",
                                                "sense_id": "96d2d5ed-10ff-3517-9edc-4fd1c7961a75",
                                                "text": "Au moment de servir, déballez, débridez et dressez ; passez à l’étamine le jus égoutté, ajoutez-le à une sauce financière demi-liée, et saucez les perdreaux."
                                            },
                                            {
                                                "example_id": "eae2d51d-6c27-4af8-aebd-070d6c24abe9",
                                                "sense_id": "96d2d5ed-10ff-3517-9edc-4fd1c7961a75",
                                                "text": "Passez à l'étamine, couvrez l’anguille de sauce et faites bouillir pendant deux minutes."
                                            },
                                            {
                                                "example_id": "7d0ff526-daf1-4a29-9084-7af09791df60",
                                                "sense_id": "96d2d5ed-10ff-3517-9edc-4fd1c7961a75",
                                                "text": "D’autre part, faire cuire un homard comme pour l’américaine; une fois cuit le décarapacer ; laisser réduire la cuisson ; la monter au beurre d’écrevisse et la passer à l’étamine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
