                                    {
                                        "sense_id": "448f57db-a1e3-3781-b507-5361e3407e42",
                                        "entry_id": "d6e30ad4-7941-3cc5-91c7-abe4c67f8f0e",
                                        "glosses": [
                                            "In a scandalous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b41c39f-6154-495a-9f47-9f09f1176b54",
                                                "sense_id": "448f57db-a1e3-3781-b507-5361e3407e42",
                                                "text": "She was seen running for her life scandalously underclad."
                                            },
                                            {
                                                "example_id": "c6ca24f2-0122-46c6-960a-435931ed58c0",
                                                "sense_id": "448f57db-a1e3-3781-b507-5361e3407e42",
                                                "text": "English is scandalously lacking in politically and linguistically correct antonyms of this sort. The Queen can create the Duchess of Cambridge, so surely I can create the much-needed expressions \"cisgress\" (be a good boy), \"cisvestite\" (bloke wearing trousers), \"cisaction\" (no deal), and \"cisom\" (something that isn't a lintel). Anyone who doesn't disagree is a transsy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26e35d4d-879e-4c01-9dce-4ffffcc29032",
                        "source_entry_id": "9c7201b9-cd79-3f5d-87e3-d9efd62d60af",
                        "source_sense_id": "2735feac-7c48-3005-9ce4-5cd7fdf0e6d8",
                        "target_lang_word": "shockingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shockingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f317341-a8da-3435-98f9-a6613361761d",
                                        "entry_id": "a33da91c-1deb-3a29-9735-588d7724ef91",
                                        "glosses": [
                                            "In a shocking manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "408f8593-6618-45c7-a067-8340e12ccb65",
                                                "sense_id": "3f317341-a8da-3435-98f9-a6613361761d",
                                                "text": "He had thinned shockingly, losing 100 pounds in the last month of his illness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e0f617f-63f7-3226-89f6-9a6cdea2efc5",
                                        "entry_id": "a33da91c-1deb-3a29-9735-588d7724ef91",
                                        "glosses": [
                                            "To a shocking degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "247d6c09-08a2-4f49-b000-25379362a0a3",
                                                "sense_id": "2e0f617f-63f7-3226-89f6-9a6cdea2efc5",
                                                "text": "Their efforts were shockingly slipshod."
                                            },
                                            {
                                                "example_id": "1039d7ed-5c58-4289-9372-15461a0174ed",
                                                "sense_id": "2e0f617f-63f7-3226-89f6-9a6cdea2efc5",
                                                "text": "He’s forced to travel back to 1969 to prevent an evil alien (a shockingly effective, nearly unrecognizable Jemaine Clement of Flight Of The Conchords, playing sort of a psychotic extraterrestrial-biker serial killer) from destroying the world by killing Brolin. Smith is aided in his quest by an elfin, time-jumping alien with psychic powers played by another Coen brothers veteran, A Serious Man star Michael Stuhlbarg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92a2202a-dec0-4a0c-a3e3-291f763270d0",
                        "source_entry_id": "9c7201b9-cd79-3f5d-87e3-d9efd62d60af",
                        "source_sense_id": "2735feac-7c48-3005-9ce4-5cd7fdf0e6d8",
                        "target_lang_word": "outrageously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outrageously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d174904-54da-3d77-ba96-2088f2b21c5b",
                                        "entry_id": "6078fd25-121b-3946-84be-ab553000fc6f",
                                        "glosses": [
                                            "In an outrageous manner; to an outrageous degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b82b4c-f229-4d89-b844-275b7b7ccd67",
                                                "sense_id": "1d174904-54da-3d77-ba96-2088f2b21c5b",
                                                "text": "The hotel was wonderful, but the food was outrageously expensive."
                                            },
                                            {
                                                "example_id": "b2537bdb-c92e-4328-828f-9b8a1d6f8720",
                                                "sense_id": "1d174904-54da-3d77-ba96-2088f2b21c5b",
                                                "text": "[…] John Currin moved from painting yearbookish images of anonymous girls to painting outrageously goofy pictures of women with ridiculously oversize breasts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2610e083-22e7-4463-99f0-d643651622ce",
                        "source_entry_id": "9c7201b9-cd79-3f5d-87e3-d9efd62d60af",
                        "source_sense_id": "2735feac-7c48-3005-9ce4-5cd7fdf0e6d8",
                        "target_lang_word": "scandaleusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scandaleusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85a0cd6b-4324-3937-9d0f-b777cbd5a825",
                                        "entry_id": "8ec1ef65-0af7-3e88-a053-5cb2e7b1b492",
                                        "glosses": [
                                            "D’une manière scandaleuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12ead9e4-533e-4345-8598-1220a3228f71",
                                                "sense_id": "85a0cd6b-4324-3937-9d0f-b777cbd5a825",
                                                "text": "Trahir scandaleusement la grandeur de sa maison,"
                                            },
                                            {
                                                "example_id": "cace407d-b4fe-408d-8a41-0c79537dbc74",
                                                "sense_id": "85a0cd6b-4324-3937-9d0f-b777cbd5a825",
                                                "text": "On continue toujours à blâmer un peu la sagesse des juges, qui a fait tant de bruit [dans l’affaire des poisons], et nommé scandaleusement de si grands noms, pour si peu de chose,"
                                            },
                                            {
                                                "example_id": "533291ce-7fa2-4565-9cd5-37c93dab1c84",
                                                "sense_id": "85a0cd6b-4324-3937-9d0f-b777cbd5a825",
                                                "text": "La fauvette, vive et gaie, n'en est ni moins aimante, ni moins fidèlement attachée ; et la tourterelle, triste et plaintive, n'en est que plus scandaleusement libertine,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
