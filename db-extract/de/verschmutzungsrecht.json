                ],
                "senses": [
                    {
                        "sense_id": "3f42cfec-20f9-3d21-aa1d-e2fa9569d327",
                        "entry_id": "bcfb8388-c461-33ec-90f9-61cee52be421",
                        "glosses": [
                            "handelbares Zertifikat, das es Unternehmen erlaubt, eine bestimmte Menge an Kohlenstoffdioxid auszustoßen"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "ca53107a-6f86-437b-8c8f-de8e3d476fb4",
                                "sense_id": "3f42cfec-20f9-3d21-aa1d-e2fa9569d327",
                                "text": "„Seit 2005 haben viele Industrieunternehmen in Europa Verschmutzungsrechte und können mit diesen handeln.“"
                            },
                            {
                                "example_id": "28b29f2d-ca11-401d-8e9b-26ae75f2a874",
                                "sense_id": "3f42cfec-20f9-3d21-aa1d-e2fa9569d327",
                                "text": "„Über Jahre dümpelte der Preis für die Verschmutzungsrechte in der EU bei fünf Euro je Tonne [Anmerkung: CO₂], im letzten Jahr hat er sich verdreifacht.“"
                            },
                            {
                                "example_id": "c28ecf13-fdf6-44e2-a2cb-183336e649a1",
                                "sense_id": "3f42cfec-20f9-3d21-aa1d-e2fa9569d327",
                                "text": "Durch den Emissionshandel sollte die Industrie dazu gebracht werden, weniger CO₂ auszustoßen, doch die Preise für Verschmutzungsrechte sind zu niedrig."
                            },
                            {
                                "example_id": "7dfbe0b4-2cf5-4314-8c2d-97794c22e54e",
                                "sense_id": "3f42cfec-20f9-3d21-aa1d-e2fa9569d327",
                                "text": "„Bisher müssen nur Kraftwerke und große Industriebetriebe so genannte Verschmutzungsrechte kaufen - das kostet aktuell etwa 25 Euro für eine Tonne CO2.“"
                            },
                            {
                                "example_id": "65d35940-65c6-446c-9c15-56d9b086ce45",
                                "sense_id": "3f42cfec-20f9-3d21-aa1d-e2fa9569d327",
                                "text": "„Deutschland verstößt jetzt gegen EU-Auflagen zum Klimaschutz. Der Verkehr produziert zu viele Klimagase. Vielleicht muss Berlin Verschmutzungsrechte kaufen. In Polen.“"
                            },
                            {
                                "example_id": "200589a2-f2a6-4b62-928c-e5e3d844f008",
                                "sense_id": "3f42cfec-20f9-3d21-aa1d-e2fa9569d327",
                                "text": "„Dieses UN-Luftfahrtabkommen legt […] fest, dass für den CO2-Ausstoß, der über die Höchstgrenze von 2020 hinausgeht, in den Folgejahren Verschmutzungsrechte gekauft werden müssen in Form von Emissions-Zertifikaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
