                "senses": [
                    {
                        "sense_id": "3da1d425-c920-3915-8586-ba4b943c9e90",
                        "entry_id": "1cdfa2a9-88bd-3c0b-b16b-cb3e12b4f3d0",
                        "glosses": [
                            "Resembling or characteristic of a workman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b973260-cf53-4a78-a925-39a184306c77",
                                "sense_id": "3da1d425-c920-3915-8586-ba4b943c9e90",
                                "text": "She was dressed in khaki, khaki slacks and khaki shirt, practical and workmanlike."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff6d488d-b7ad-38c1-8ac1-4af550530900",
                        "entry_id": "1cdfa2a9-88bd-3c0b-b16b-cb3e12b4f3d0",
                        "glosses": [
                            "Done competently but without flair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ae583e3-28c3-45fb-a74a-1f87464a9bac",
                                "sense_id": "ff6d488d-b7ad-38c1-8ac1-4af550530900",
                                "text": "In appearance the new 4-4-0s were magnificent engines for the period in which they were built; the boiler, bulging over the typical Drummond splasher, gave the engine a sturdy, workmanlike look, and the blue livery enhanced a picture of sleek, powerful, efficiency."
                            },
                            {
                                "example_id": "e113e9fb-d15c-4ee3-b0c5-6b8d62c44b95",
                                "sense_id": "ff6d488d-b7ad-38c1-8ac1-4af550530900",
                                "text": "Even his most matter-of-fact, workmanlike paintings are charged with an entirely personal morbidity."
                            },
                            {
                                "example_id": "2ee3bbdd-7c8e-4bf7-a391-d1a6d3bbe3c1",
                                "sense_id": "ff6d488d-b7ad-38c1-8ac1-4af550530900",
                                "text": "2002, Tom Friedman, Germano Celant, Fondazione Prada (Milan, Italy), Mario Perniola, Tom Friedman, Progetto Prada Arte\nThe tandem arrangement does not misuse Close, for he has gotten decades of acclaim for a tedious, workmanlike art."
                            },
                            {
                                "example_id": "87728349-f994-409e-a72d-6efcace3ade7",
                                "sense_id": "ff6d488d-b7ad-38c1-8ac1-4af550530900",
                                "text": "Clear, workmanlike prose will do fine, and polishing up the prose is for the second draft."
                            },
                            {
                                "example_id": "ba7bfd43-62b7-4de5-ae8e-58ae20dc4647",
                                "sense_id": "ff6d488d-b7ad-38c1-8ac1-4af550530900",
                                "text": "Isaacson comes from the “his eyes lit up” school of cliched writing, the rest of his prose workmanlike bordering on AI."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b0aa105-6876-3f4a-bb90-ab8b67dba24c",
                        "entry_id": "1cdfa2a9-88bd-3c0b-b16b-cb3e12b4f3d0",
                        "glosses": [
                            "Performed with the skill of an artisan or craftsman."
                        ],
