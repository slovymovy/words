                },
                {
                    "sense_id": "79b9c6f2-6c3e-39ef-a1c7-c1db903f1c58",
                    "sense_definition": "Menacer d'éclater de façon sourde et continue, en parlant d'un sentiment collectif ou d'une révolte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "menacer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les usines de la région, la colère ouvrière <w>gronde</w> depuis plusieurs semaines.",
                            "target_lang_translations": {
                                "en": "In the region's factories, workers' anger has been <w>simmering</w> for several weeks.",
                                "de": "In den Fabriken der Region <w>brodelt</w> seit mehreren Wochen die Wut der Arbeiter.",
                                "es": "En las fábricas de la región, la indignación obrera <w>fermenta</w> desde hace varias semanas.",
                                "zh": "这个地区的工厂里，工人的怒气已经<w>酝酿</w>了好几个星期。",
                                "ru": "На заводах региона уже несколько недель <w>тлеет</w> гнев рабочих."
                            }
                        },
                        {
                            "text": "Une nouvelle crise politique <w>gronde</w> au sein du parlement après ce vote contesté.",
                            "target_lang_translations": {
                                "en": "A new political crisis is <w>brewing</w> within parliament after this disputed vote.",
                                "de": "Nach dieser umstrittenen Abstimmung <w>schwelt</w> im Parlament eine neue politische Krise.",
                                "es": "Tras esta votación controvertida, <w>se gesta</w> una nueva crisis política en el seno del parlamento.",
                                "zh": "这次备受争议的表决之后，议会内部一场新的政治危机正在<w>酝酿</w>。",
                                "ru": "После этого спорного голосования в парламенте <w>назревает</w> новый политический кризис."
                            }
                        }
                    ],
                    "common_phrases": [
                        "la colère gronde",
                        "la révolte gronde"
                    ],
                    "target_lang_definitions": {
                        "en": "To threaten to erupt quietly and continuously, said of collective feeling or revolt.",
                        "de": "Sich als verborgene Spannung oder Unruhe langsam zusammenbrauen, bevor sie ausbricht.",
                        "es": "Estar a punto de estallar de forma sorda y continua, referido a un sentimiento colectivo o a una revuelta.",
                        "zh": "某种集体情绪或动荡正在暗中逐渐形成，随时可能爆发。",
                        "ru": "Скрыто нарастать и грозить вспыхнуть, о чувстве группы людей или мятеже."
                    },
