                "senses": [
                    {
                        "sense_id": "8d4fdaf9-c2ec-312d-8a84-d5e28b1b85d9",
                        "entry_id": "dc639412-df32-3435-ae6d-8f80e866dace",
                        "glosses": [
                            "weibliche Person mit umfangreichen Kenntnissen hinsichtlich rechtlicher Fragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "991aba08-e390-4c39-b699-727a0ba72da8",
                                "sense_id": "8d4fdaf9-c2ec-312d-8a84-d5e28b1b85d9",
                                "text": "„Die Rechtsexpertin warnt im Interview mit dem ‚Philosophie Magazin‘ davor, unbedacht neue Gesetze in die Welt zu setzen.“"
                            },
                            {
                                "example_id": "f6857c0a-655a-43e7-b401-1001a8ee597d",
                                "sense_id": "8d4fdaf9-c2ec-312d-8a84-d5e28b1b85d9",
                                "text": "„Die stellvertretende Vorsitzende und Rechtsexpertin der SPD-Fraktion im hessischen Landtag, Heike Hofmann, soll im Falle eines SPD-Wahlsiegs Ministerin für Justiz und Gleichstellung werden.“"
                            },
                            {
                                "example_id": "16d8ca91-4b61-4bc6-a64f-5fd8c7607c09",
                                "sense_id": "8d4fdaf9-c2ec-312d-8a84-d5e28b1b85d9",
                                "text": "„Der Brite Robert Mugat geriet im Zuge der Ermittlungen um die verschwundene Maddie McCann ins Kreuzfeuer der Medien. Nun will er gegen Verleumdung klagen. Eine Rechtsexpertin hält zwei Millionen Pfund Schadenersatz für möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
