                    {
                        "sense_id": "26c0fe23-686a-3738-a262-ca42f7b3e131",
                        "entry_id": "47eab674-302c-361f-878e-b92cd785c17e",
                        "glosses": [
                            "Alternative letter-case form of leghorn."
