                    },
                    {
                        "form_id": "da4c4bdf-f42d-42e7-b933-b44fbae7c76e",
                        "entry_id": "b1b083ed-5302-3549-b47a-4b6638bd3212",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Linienschiffe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19b38663-3f73-3316-aed5-e36b55561a77",
                        "entry_id": "b1b083ed-5302-3549-b47a-4b6638bd3212",
                        "glosses": [
                            "Schiff, das im Liniendienst eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bbcbadf-6e58-4a56-afbd-d66dead24fb6",
                                "sense_id": "19b38663-3f73-3316-aed5-e36b55561a77",
                                "text": "„Drüben auf der Mole, wo die Linienschiffe anlegen, sammelten sich Menschen, Einheimische mit Körben und Fahrrädern, aber auch einige Touristen mit Kameras.“"
                            },
                            {
                                "example_id": "7482bb50-f1f3-4665-b839-20602791b58b",
                                "sense_id": "19b38663-3f73-3316-aed5-e36b55561a77",
                                "text": "„Ich schickte es in den Gasthof, nahm Bellino mit mir auf die Reede und ging an Bord eines venezianischen Linienschiffes, das gerade seine Quarantäne beeendet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7efaf7fe-04d3-3643-85c7-c478c005d22f",
                        "entry_id": "b1b083ed-5302-3549-b47a-4b6638bd3212",
                        "glosses": [
                            "Kriegsschiff, das mit anderen in einer Linie (hintereinander) operiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "182ce21b-9eec-4d68-812b-cb7b173fa59e",
                                "sense_id": "7efaf7fe-04d3-3643-85c7-c478c005d22f",
                                "text": "„Das französische Einberufungssystem sah vor, dass jeder Matrose alle vier Jahre zum Dienst in der Kriegsmarine eingezogen werden konnte, daher hatten viele der Besatzungsmitglieder Erfahrungen auf Linienschiffen und Fregatten gesammelt.“"
                            },
                            {
                                "example_id": "568c0e4a-2a00-4a60-a091-83e3b9437ae9",
                                "sense_id": "7efaf7fe-04d3-3643-85c7-c478c005d22f",
                                "text": "„Die Engländer hatten alle Linienschiffe verloren.“"
                            },
                            {
                                "example_id": "92be10b4-1c88-4fa4-8156-1aa19bab84da",
                                "sense_id": "7efaf7fe-04d3-3643-85c7-c478c005d22f",
                                "text": "„Bauer wurde zum kaiserlichen Submarine-Ingenieur ernannt und erhielt den Auftrag, ein untergegangenes Linienschiff zu heben.“"
                            },
                            {
                                "example_id": "9010d34d-2fa8-454d-9ed8-00c4e00e66fb",
                                "sense_id": "7efaf7fe-04d3-3643-85c7-c478c005d22f",
                                "text": "„Als sie auftauchten, sahen sie ein brennendes Linienschiff.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
