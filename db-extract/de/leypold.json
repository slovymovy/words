                ],
                "senses": [
                    {
                        "sense_id": "9956ced7-fe90-31d9-9050-1f796bbbe53c",
                        "entry_id": "dc66559d-9495-3e1f-8075-19838af502b5",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056e30be-adfe-4416-a6ee-2745c4e2788a",
                                "sense_id": "9956ced7-fe90-31d9-9050-1f796bbbe53c",
                                "text": "Frau Leypold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6326aea3-6028-4dba-b7bb-53b5e43c78a8",
                                "sense_id": "9956ced7-fe90-31d9-9050-1f796bbbe53c",
                                "text": "Herr Leypold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "94f4b8f1-bf83-41b1-8e4a-9e22f9418030",
                                "sense_id": "9956ced7-fe90-31d9-9050-1f796bbbe53c",
                                "text": "Die Leypolds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "12f1404d-5448-4104-8949-29a7ccf3c83d",
                                "sense_id": "9956ced7-fe90-31d9-9050-1f796bbbe53c",
                                "text": "Der Leypold trägt nie die Schals, die die Leypold ihm strickt."
                            },
                            {
                                "example_id": "c30ade8f-f908-4015-8af2-cf53d0d8c32b",
                                "sense_id": "9956ced7-fe90-31d9-9050-1f796bbbe53c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Leypold kommt, geht der Herr Leypold.“"
                            },
                            {
                                "example_id": "75b969b8-04c7-453d-a7ac-63c5b7cfcafb",
                                "sense_id": "9956ced7-fe90-31d9-9050-1f796bbbe53c",
                                "text": "Leypold kommt und geht."
                            },
                            {
                                "example_id": "5ae37ce6-c387-42eb-ba8f-3e41b1ecbf44",
                                "sense_id": "9956ced7-fe90-31d9-9050-1f796bbbe53c",
                                "text": "Leypolds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
