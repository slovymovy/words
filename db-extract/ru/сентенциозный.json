                                        "glosses": [
                                            "Using as few words as possible; pithy and concise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d038169c-b4b0-3efa-a5bc-d77946d3bf14",
                                        "entry_id": "539a047a-7ef1-3f07-a041-6beeb5a93fa3",
                                        "glosses": [
                                            "Tending to use aphorisms or maxims; especially, to such an extent as to engage in trite moralizing, even self-righteously so."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b3f9904-fb25-4c42-9fc6-813cbcd86c51",
                                                "sense_id": "d038169c-b4b0-3efa-a5bc-d77946d3bf14",
                                                "text": "His sententious remarks quickly bored the audience."
                                            }
                                        ]
                                    },
                                    {
