                "senses": [
                    {
                        "sense_id": "9cacb766-08b7-33ce-907b-0ab548545d98",
                        "entry_id": "594b7109-403b-3909-bc38-2fb78cbf0454",
                        "glosses": [
                            "Suspendre à titre moratoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7f769da-564d-4ed8-a22d-49fc44b5b9ec",
                                "sense_id": "9cacb766-08b7-33ce-907b-0ab548545d98",
                                "text": "Elle légifère, taxe, et moratoirise à l'infini."
                            },
                            {
                                "example_id": "bd4c88ce-65a9-4995-bd29-a9bcd623200d",
                                "sense_id": "9cacb766-08b7-33ce-907b-0ab548545d98",
                                "text": "On voit au moins bien dans cet article le degré de réflexion et de compréhension qui mène à la décision de \"moratoiriser\" des choses."
                            },
                            {
                                "example_id": "8971ca00-db6e-4746-ae04-c83847b2b014",
                                "sense_id": "9cacb766-08b7-33ce-907b-0ab548545d98",
                                "text": "L'environnement est important pour les boomers. Voilà pourquoi il est primordial de discuter, de débattre et de « moratoiriser » tous les projets pouvant détruire le jardin d’Éden."
                            }
                        ]
                    }
