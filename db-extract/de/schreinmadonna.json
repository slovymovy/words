                        "entry_id": "63c2fdb6-8b1c-3a0f-b5eb-65bac416bace",
                        "glosses": [
                            "plastische Darstellung der Gottesmutter Maria, die sich öffnen lässt und in deren Inneren sich figürliche Darstellungen befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b1da599-0fd8-4b36-9948-6cfa38b47e08",
                                "sense_id": "b5cae242-9ca9-3e8e-9f10-fa338c2a9a05",
                                "text": "„In dem unscheinbaren Kirchenbau (1906) hat sich eine sehenswerte Schreinmadonna (15. Jh.) erhalten, die aus dem Hauptaltar der evangelischen St. Marienkirche in Elbing/Westpreußen stammt.“"
                            },
                            {
                                "example_id": "20062a16-a40e-4ae8-90ae-aaf1216c3b7e",
                                "sense_id": "b5cae242-9ca9-3e8e-9f10-fa338c2a9a05",
                                "text": "„Im Mittelalter waren Schreinmadonnen in ganz Europa verbreitet.“"
                            }
                        ],
