                },
                {
                    "sense_id": "81282959-979f-34c2-80ab-185cd8a49ddf",
                    "sense_definition": "Structure anatomique ou organe réduit qui a perdu son rôle fonctionnel initial au cours de l'évolution.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coccyx chez l'être humain constitue le <w>vestige</w> d'une queue ancestrale disparue."
                        },
                        {
                            "text": "Certains serpents conservent des <w>vestiges</w> minuscules de pattes arrière sous leurs écailles."
