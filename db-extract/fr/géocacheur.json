                "senses": [
                    {
                        "sense_id": "af0915ca-be99-3f9a-b32e-a0453f037c84",
                        "entry_id": "18fce636-6c9a-3d26-8137-bc79f5fbccb5",
                        "glosses": [
                            "Pratiquant du géocaching."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57c0e57a-ceef-4bd0-8970-e8eda325396a",
                                "sense_id": "af0915ca-be99-3f9a-b32e-a0453f037c84",
                                "text": "En gros, ce sont des objets que l'on dépose dans une cache et qu'un autre géocacheur récupère, pour le déposer ensuite dans une autre cache, à proximité où à l'autre bout du monde, où il est récupéré par un autre géocacheur, qui le déposera à son tour dans une autre cache, et ainsi de suite."
                            },
                            {
                                "example_id": "857d0569-34b3-4ff0-856a-1520cb5f24a2",
                                "sense_id": "af0915ca-be99-3f9a-b32e-a0453f037c84",
                                "text": "Mais à la différence des footeux, les geocacheurs s'amusent entre eux et dans l'anonymat le plus complet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4292098d-0a7c-4a35-a7f7-77f1c60255de",
                        "source_entry_id": "18fce636-6c9a-3d26-8137-bc79f5fbccb5",
                        "source_sense_id": "af0915ca-be99-3f9a-b32e-a0453f037c84",
                        "target_lang_word": "geocacher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geocacher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b730d866-4978-313b-bbdf-bc5965deac26",
                                        "entry_id": "3716e225-c129-3364-8acf-34181b6ef279",
                                        "glosses": [
                                            "A person who hides or seeks objects as part of the pastime of geocaching."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a97de569-f50d-4e73-b179-9dc63bd06675",
                                                "sense_id": "b730d866-4978-313b-bbdf-bc5965deac26",
                                                "text": "Couple of geocachers found a floater at Wilson's Pond about an hour ago. Nasty. The perp took her tongue and her face. [...]"
                                            },
                                            {
                                                "example_id": "95dc7685-7d5e-4c86-8ea4-736779c0a925",
                                                "sense_id": "b730d866-4978-313b-bbdf-bc5965deac26",
                                                "text": "Whatever a cache leads to, the process of finding the cache will usually stir the geocacher's curiosity to the point of learning something. As geocachers learn more about the area in which they are caching, they will have a natural tendency to pay attention to the setting and their surroundings."
                                            },
                                            {
                                                "example_id": "9679eb17-0fbf-4233-9c33-6502e729d410",
                                                "sense_id": "b730d866-4978-313b-bbdf-bc5965deac26",
                                                "text": "Like any outdoor activity, geocaching involves some inherent risk, and many geocachers enjoy manageable risks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
