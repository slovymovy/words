    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "736e1e69-e300-39ad-96b2-05a8b8a6554d",
                    "sense_definition": "A person or guest, used especially in the hospitality industry when counting diners or attendees.",
