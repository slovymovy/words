        "fr-extract.jsonl": [
            {
                "entry_id": "1e633495-479d-38df-803e-34f180c601b3",
                "word": "perceptible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e0690a60-79ab-4cec-ae7d-9c308a573c63",
                        "entry_id": "1e633495-479d-38df-803e-34f180c601b3",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "perceptibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9abe314-3ee9-31db-a974-5d5716dacb08",
                        "entry_id": "1e633495-479d-38df-803e-34f180c601b3",
                        "glosses": [
                            "Qui peut être perçu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95f1aee0-24ac-4250-9025-2cec750668a5",
                                "sense_id": "d9abe314-3ee9-31db-a974-5d5716dacb08",
                                "text": "Un impôt perceptible."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fdc54a5-1b93-36a5-b1c1-b68bad916941",
                        "entry_id": "1e633495-479d-38df-803e-34f180c601b3",
                        "glosses": [
                            "Qui peut être perçu par les sens."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5ac5a0b7-f7c7-44c4-b892-3ab3ea86082a",
                                "sense_id": "8fdc54a5-1b93-36a5-b1c1-b68bad916941",
                                "text": "Le mouvement du ballon, son trajet sinueux, ses plongeons et ses remontées, étaient nettement perceptibles, et l’incessante trépidation des moteurs semblait se ralentir et s’accélérer tour à tour."
                            },
                            {
                                "example_id": "ce1fd2f9-d5ff-4a4e-ae43-0b7e3c5a7483",
                                "sense_id": "8fdc54a5-1b93-36a5-b1c1-b68bad916941",
                                "text": "En réalité, au delà de l'octroi, sans interruption perceptible, s'étale une zone de grosses communes industrielles où la population est de 65 000 âmes."
                            },
                            {
                                "example_id": "fd702261-20f1-451b-948e-2fc5de3f1ab6",
                                "sense_id": "8fdc54a5-1b93-36a5-b1c1-b68bad916941",
                                "text": "L'haleine de la mousson d'été s'était faite moins chaude, quoique encore des éclairs lointains fulgurassent et illuminassent la mer, sans coups de tonnerre perceptibles, là-bas, vers la côte d'Asie."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ebc3e63-d355-340b-b8fe-c5bb84000575",
                        "entry_id": "1e633495-479d-38df-803e-34f180c601b3",
                        "glosses": [
                            "Ce qui peut être perçu par l’esprit."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "df4a5967-6c93-44c9-87ee-1f9a50754e20",
                                "sense_id": "1ebc3e63-d355-340b-b8fe-c5bb84000575",
                                "text": "Il y a dans son discours une ironie à peine perceptible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09ffa669-5f50-4d36-9f1b-dff1f95d49c1",
                        "source_entry_id": "1e633495-479d-38df-803e-34f180c601b3",
                        "target_lang_word": "perceptible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perceptible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b5f1945-2e92-3556-944e-e937cf5a0f46",
                                        "entry_id": "074ddd0b-749b-3419-8c7c-405bf8fab72c",
                                        "glosses": [
                                            "Able to be perceived, sensed, or discerned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3924da3f-2ac3-48c2-80bc-3deef2f15b68",
                                                "sense_id": "6b5f1945-2e92-3556-944e-e937cf5a0f46",
                                                "text": "Her voice was barely perceptible over the noise, but her gestures made her meaning clear."
                                            },
                                            {
                                                "example_id": "9f2059cd-e815-47a4-8ff7-0c3e8e556de3",
                                                "sense_id": "6b5f1945-2e92-3556-944e-e937cf5a0f46",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes.[…]But withal there was a perceptible acumen about the man which was puzzling in the extreme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "perceptible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39b29466-bc24-363d-9f62-563b7700d7eb",
                                        "entry_id": "fc23a528-2f92-3d6b-bc05-da79f43034ef",
                                        "glosses": [
                                            "Anything that can be perceived."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d94bfc7-3c12-4c91-9157-ea2c9eaf5eb7",
                        "source_entry_id": "1e633495-479d-38df-803e-34f180c601b3",
                        "target_lang_word": "заметный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "заметный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "64f5acfd-77a3-3bdc-a949-2be1f8616f7e",
                                        "entry_id": "412691b9-99c4-3184-a9e0-3748ad604a74",
                                        "glosses": [
                                            "такой, которого можно заметить, увидеть"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f0c9353-3165-42b4-90dd-5dbd270ff693",
                                                "sense_id": "64f5acfd-77a3-3bdc-a949-2be1f8616f7e",
                                                "text": "Надпись была едва заметна."
                                            },
                                            {
                                                "example_id": "0352e3d4-9a34-4655-a6aa-109115e88824",
                                                "sense_id": "64f5acfd-77a3-3bdc-a949-2be1f8616f7e",
                                                "text": "Она потушила умышленно свет в глазах, но он светился против её воли в чуть заметной улыбке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b55b9f61-d07d-3f73-a48a-17f67d6d68fa",
                                        "entry_id": "412691b9-99c4-3184-a9e0-3748ad604a74",
                                        "glosses": [
                                            "перен. явный, очевидный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f191848-d071-4b63-bdb6-997eea985492",
                                                "sense_id": "b55b9f61-d07d-3f73-a48a-17f67d6d68fa",
                                                "text": "Она говорила с заметным еврейским акцентом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccd73531-c7aa-3bb2-aab4-0591be015e67",
                                        "entry_id": "412691b9-99c4-3184-a9e0-3748ad604a74",
                                        "glosses": [
                                            "перен. выдающийся, известный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "523e2b38-c4fd-4190-bfc2-a80c9ee66542",
                                                "sense_id": "ccd73531-c7aa-3bb2-aab4-0591be015e67",
                                                "text": "Он стал человеком заметным."
                                            },
                                            {
                                                "example_id": "c62e0fb1-3246-4236-aaf1-3c5684b57319",
                                                "sense_id": "ccd73531-c7aa-3bb2-aab4-0591be015e67",
                                                "text": "Он был один из самых заметных артистов театра юного зрителя."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
