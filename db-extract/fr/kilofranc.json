                                                "example_id": "77d74dcc-578f-4493-a2a2-1b886d891c8b",
                                                "sense_id": "4c2cdec1-d149-38b3-bba1-de49e741355d",
                                                "text": "„Wir pumpten uns ein paar Francs von ihm und sausten los.“"
                                            },
