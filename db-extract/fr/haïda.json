                                "target_senses": [
                                    {
                                        "sense_id": "94410e80-d23d-3156-800c-56fb5ccab35f",
                                        "entry_id": "5f386255-0776-305d-af74-af2679a0dd7f",
                                        "glosses": [
                                            "A member of an indigenous people of the Northwest Coast of North America who live primarily in British Columbia and Alaska."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54df1816-ab22-4772-9f6e-7f733ed812d1",
                                                "sense_id": "94410e80-d23d-3156-800c-56fb5ccab35f",
                                                "text": "The first recorded European contact with the Haida was by the Spanish explorer Juan Perez in 1774 at Langara Island in the Queen Charlotte Islands. Soon the Haida were caught up in the lucrative fur trade, and the time they spent hunting sea otters and other marine mammals greatly increased."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Haida",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f7cf5cf-1d5d-31f1-94de-bd8412244d73",
                                        "entry_id": "5a9e2baf-7e7f-3a5b-a6dd-a67f1369108a",
                                        "glosses": [
                                            "The indigenous language of this people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbb2091-ed94-4661-bcff-8d1de3b1b0c7",
                                                "sense_id": "6f7cf5cf-1d5d-31f1-94de-bd8412244d73",
                                                "text": "The Haida language, called Skittagetan by Powell, was anciently spoken only on the Queen Charlotte islands off the coast of British Columbia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
