                {
                    "sense_id": "12995c2b-21a2-38a5-8f6a-15b0bc403782",
                    "sense_definition": "iets afgeven op een officiële plek of bij een persoon die daarvoor verantwoordelijk is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "afgeven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je huiswerk voor vrijdag bij de docent <w>inleveren</w>.",
                            "target_lang_translations": {
                                "en": "You must <w>hand in</w> your homework to the teacher before Friday.",
                                "ru": "Ты должен <w>сдать</w> домашнее задание учителю до пятницы."
                            }
                        },
                        {
                            "text": "Vergeet niet om je sleutels bij de receptie <w>in te leveren</w> voor je vertrekt.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>return</w> your keys at the reception before you leave.",
                                "ru": "Не забудь <w>сдать</w> ключи на ресепшн перед отъездом."
                            }
                        }
                    ],
                    "synonyms": [
                        "afgeven"
                    ],
                    "common_phrases": [
                        "huiswerk inleveren",
                        "sleutels inleveren",
                        "formulier inleveren"
                    ],
                    "target_lang_definitions": {
                        "en": "To hand something over at an official location or to a person responsible for receiving it.",
                        "ru": "Сдать что-либо в официальном месте или лицу, ответственному за прием."
                    },
                    "translations": {
