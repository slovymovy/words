                                        "sense_id": "137b980f-7d65-39aa-8eec-b7b3be3ee4a0",
                                        "entry_id": "71310a86-9e23-3b79-a86a-9978f35d9ca6",
                                        "glosses": [
                                            "With one competitor dominant over the other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182cf9c5-561a-4a5b-9e34-a7490a568d89",
                                                "sense_id": "137b980f-7d65-39aa-8eec-b7b3be3ee4a0",
                                                "text": "It was a swift, one-sided fight, all over in the second round."
                                            },
                                            {
                                                "example_id": "6ada0fd0-a66a-4b32-b1c7-2b69286a8b59",
                                                "sense_id": "137b980f-7d65-39aa-8eec-b7b3be3ee4a0",
                                                "text": "Lovenkrands only just failed to connect with another Enrique cross in what was becoming a one-sided affair at Ewood Park but despite Newcastle dominating, Blackburn held out with the half ending goalless."
                                            },
                                            {
                                                "example_id": "cc2f7a05-8ad3-4eb3-b832-480db93d52fd",
                                                "sense_id": "137b980f-7d65-39aa-8eec-b7b3be3ee4a0",
                                                "text": "The fight is not all one-sided. Lion is taking a savage beating as the two flagships trade body blows almost independent of the furious carronade going on behind them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4f4bd00-f934-36cd-84ad-57567088152b",
                                        "entry_id": "71310a86-9e23-3b79-a86a-9978f35d9ca6",
                                        "glosses": [
                                            "Out of proportion or lopsided."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "660e027d-783e-3fea-bfc4-2c8cb56db9e4",
                                        "entry_id": "71310a86-9e23-3b79-a86a-9978f35d9ca6",
                                        "glosses": [
                                            "Having only one side, like a Möbius strip."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d913434-b833-329e-bf2b-9640dd8de282",
                                        "entry_id": "71310a86-9e23-3b79-a86a-9978f35d9ca6",
                                        "glosses": [
                                            "Turned to one side."
