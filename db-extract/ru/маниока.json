                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3125ddab-9b3c-3db3-ae3f-dea0c722920d",
                                        "entry_id": "84a30a88-8564-3181-b68d-2944e1614113",
                                        "glosses": [
                                            "Tapioca, a starchy pulp made with manioc roots."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a589b8ad-9eee-476c-bcd4-f458e202ac2a",
                                                "sense_id": "3125ddab-9b3c-3db3-ae3f-dea0c722920d",
                                                "text": "Jucca, ſive Yucca Peruana. The root whereof the bread Caſua, or Cazava is made."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a57dd382-da31-4dba-a4a9-dddf770308d7",
                        "source_entry_id": "186a1727-2e0a-3e8a-8281-7822a4cf0e37",
                        "source_sense_id": "8640a73e-13cc-3b05-8e55-a243b900bedf",
                        "target_lang_word": "yuca",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yuca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ceebdda9-8a25-3225-8107-eba2aff500e7",
                                        "entry_id": "783ec378-ff9b-33e7-a919-ea31f9ede812",
                                        "glosses": [
                                            "cassava"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec06784e-d5b1-3f95-ac75-3b989d75f422",
                                        "entry_id": "783ec378-ff9b-33e7-a919-ea31f9ede812",
                                        "glosses": [
                                            "cassava root"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c75798d8-de11-4b9c-881f-573d4f28b7e3",
                                                "sense_id": "ec06784e-d5b1-3f95-ac75-3b989d75f422",
                                                "text": "In the equatorial regions of South America, starch is abundantly prepared from the Yuca (Jatropha manihot), and from several species of palm."
                                            },
                                            {
                                                "example_id": "cdd80d36-ec9d-441e-ade3-5892836f4336",
                                                "sense_id": "ec06784e-d5b1-3f95-ac75-3b989d75f422",
                                                "text": "She spooned out yuca into what I assume was my plate, and chorizo from a red frying pan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57390a73-0b1e-4bc0-ad31-adbd0df69fb1",
                        "source_entry_id": "186a1727-2e0a-3e8a-8281-7822a4cf0e37",
                        "source_sense_id": "8640a73e-13cc-3b05-8e55-a243b900bedf",
                        "target_lang_word": "manioc",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manioc",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11dc3aea-7be5-3dc2-85bd-978b9948d86b",
                                        "entry_id": "35fed2ac-4dff-364a-8af9-2328e60fa994",
                                        "glosses": [
                                            "The tropical plant Manihot esculenta, from which cassava and tapioca are prepared."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bda4a3f4-3c87-4839-a51e-e7eb8962868c",
                                                "sense_id": "11dc3aea-7be5-3dc2-85bd-978b9948d86b",
                                                "text": "1975, William R. Bascom, African Dilemma Tales, Mouton (De Gruyter), page 86,\nThe banana, the most important crop above ground, quarreled with the manioc, the most important underground crop. […] The manioc said that it, the yam, the sweet potato, and others were the ones that fed people and that without them people could not exist."
                                            },
                                            {
                                                "example_id": "604be8b8-efe7-40bf-a123-c6c6baee150d",
                                                "sense_id": "11dc3aea-7be5-3dc2-85bd-978b9948d86b",
                                                "text": "1977, Donald W. Lathrap, Our Father the Cayman, Our Mother the Gourd, Charles A. Reed (editor), Origins of Agriculture, Mouton (De Gruyter), page 741,\nThe selection process leading to the bitter group of maniocs has been in terms of higher starch yield and in terms of starch of a quality more appropriate for making bread ans flour."
                                            },
                                            {
                                                "example_id": "4dde91e8-7ba9-4d80-931a-320c850604fa",
                                                "sense_id": "11dc3aea-7be5-3dc2-85bd-978b9948d86b",
                                                "text": "Manioc, the main subsistence crop of Amazonia, is planted entirely from cuttings, which are inserted into mounds hoed up in the spaces left between the logs and the stumps."
                                            },
                                            {
                                                "example_id": "431633e9-19b8-496a-8255-faa46eff9be5",
                                                "sense_id": "11dc3aea-7be5-3dc2-85bd-978b9948d86b",
                                                "text": "Manioc was first reported being grown on the mainland in 1635 at the Portuguese post at Bissau."
                                            },
                                            {
                                                "example_id": "d4ba2958-d10d-4e60-9ba5-bbf21f4ef39e",
                                                "sense_id": "11dc3aea-7be5-3dc2-85bd-978b9948d86b",
                                                "text": "Manioc gives the highest yield of starch per hectare of any known crop; some 90% of the fabric of the crop can be regarded as potentially fermentable carbohydrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dbbf68e-e536-31cc-b94c-d39e1ccccf38",
                                        "entry_id": "35fed2ac-4dff-364a-8af9-2328e60fa994",
                                        "glosses": [
                                            "Cassava root, eaten as a food."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99d53dec-bd6c-4dc9-8709-3f33bfc53057",
                                                "sense_id": "5dbbf68e-e536-31cc-b94c-d39e1ccccf38",
                                                "text": "In the morning, after a frugal breakfast of coffee and manioc - we had to be economical of our stores - we held a council of war as to the best method of ascending to the plateau above us."
                                            },
                                            {
                                                "example_id": "774625c9-67f7-4221-a4c9-f1f3b7291d9a",
                                                "sense_id": "5dbbf68e-e536-31cc-b94c-d39e1ccccf38",
                                                "text": "Ground manioc (cassava) is mixed with water and pressed through tube woven from palm fibers to remove toxic cyanogenic compounds."
                                            },
                                            {
                                                "example_id": "b50efc01-78e8-41af-8f6b-41c2490bdac1",
                                                "sense_id": "5dbbf68e-e536-31cc-b94c-d39e1ccccf38",
                                                "text": "She made manioc pie, got water, got wild banana leaves and pounded manioc. She made the earth oven and later she opened and took out the manioc pie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5172253c-eff9-3eee-99ce-3c8a9c5cc613",
                                        "entry_id": "35fed2ac-4dff-364a-8af9-2328e60fa994",
                                        "glosses": [
                                            "A food starch prepared from the root."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecebc608-8b31-45ec-90ab-f06f0d77fbb2",
                        "source_entry_id": "186a1727-2e0a-3e8a-8281-7822a4cf0e37",
                        "source_sense_id": "8640a73e-13cc-3b05-8e55-a243b900bedf",
                        "target_lang_word": "Maniok",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maniok",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6ae4c4e-0aa3-3414-a962-3f82867efda0",
                                        "entry_id": "bea3b24a-b6ce-3e7f-bf80-e5e975e9561e",
                                        "glosses": [
                                            "Botanik, Agrikultur:"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0ddf9ee-ced7-3471-ba3c-43dfad6117ad",
                                        "entry_id": "bea3b24a-b6ce-3e7f-bf80-e5e975e9561e",
                                        "glosses": [
                                            "Gattung (Manihot) aus der Familie der Wolfsmilchgewächse (Euphorbiaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7b4b350-ccc3-403a-8745-cc67fc0dfdda",
                                                "sense_id": "b0ddf9ee-ced7-3471-ba3c-43dfad6117ad",
                                                "text": "„In den Lexika von Ruiz de Montoya sind unter anderem ungefähr acht Arten von Maniok erwähnt, sechs Arten von Mais, achtzehn Kartoffelsorten, fünf Sorten der Cará-Knollenfrucht, zehn Bohnenarten, fünf Pfeffersorten, elf Passionsfrucht-Varianten, drei Kürbisarten, sieben Guaven-Sorten sowie unzählige nicht genau bestimmte Wurzeln und Kräuter.“"
                                            },
                                            {
                                                "example_id": "b621d056-d72d-4224-8316-e1be56df1ba4",
                                                "sense_id": "b0ddf9ee-ced7-3471-ba3c-43dfad6117ad",
                                                "text": "„So kultivieren z. B. die Tikúna (Indigene aus dem Amazonasgebiet Kolumbiens) 35 unterschiedliche Arten von Nahrungspflanzen, zusätzlich werden 14 verschiedene Sorten von Maniok angebaut, drei von Bataten und neun von Bananen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4341fb8-cbda-3751-afa1-d7164666a92b",
                                        "entry_id": "bea3b24a-b6ce-3e7f-bf80-e5e975e9561e",
                                        "glosses": [
                                            "Pflanzenart mit stärkehaltigen Wurzelknollen der unter [1] beschriebenen Gattung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97277e52-11a0-4a64-a023-bb6fd4d0bc06",
                                                "sense_id": "e4341fb8-cbda-3751-afa1-d7164666a92b",
                                                "text": "Maniok stammt aus Südamerika und ist nur als Kulturpflanze bekannt."
                                            },
                                            {
                                                "example_id": "95201175-b8fc-42ef-999d-876121f160e3",
                                                "sense_id": "e4341fb8-cbda-3751-afa1-d7164666a92b",
                                                "text": "„Um das Dorf sind kleine Parzellen mit Bananen, Mais, Maniok, Zuckerrohr und Früchten angelegt.“"
                                            },
                                            {
                                                "example_id": "48649b14-79ab-449c-b55b-14dd1f232196",
                                                "sense_id": "e4341fb8-cbda-3751-afa1-d7164666a92b",
                                                "text": "„Maniok ist eine Pflanze der Tropen und Subtropen. […] Maniok ist eehr trockenresistent. Bei größeren Dürren wirft Maniok seine Blätter ab und bildet ohne weitere Verluste neue Blätter, wenn es wieder hinreichend feucht ist. […] Maniok hat aber auch Nachteile: So gehört Maniok zu den Wolfsmilchgewächsen und enthält cyanogene Glycoproteine.“"
                                            },
                                            {
                                                "example_id": "aa6fb065-8df2-4d88-a474-1015e3c3d7f5",
                                                "sense_id": "e4341fb8-cbda-3751-afa1-d7164666a92b",
                                                "text": "„Als die schwarzen Tapiokaperlen dazukamen – diese werden aus der Wurzelknolle des Manioks hergestellt und sind stärkehaltig –, galt «Zhen Zhou Nai Cha» als Armen-Getränk, günstig und doch nahrhaft.“"
                                            },
                                            {
                                                "example_id": "f8ccfba0-60ce-44a1-ba2f-038cd44d602a",
                                                "sense_id": "e4341fb8-cbda-3751-afa1-d7164666a92b",
                                                "text": "„Von der Regierung erhalten sie etwas Sozialhilfe, hinter den Hütten pflanzen sie Maniok an, für die Beete müssen sie Miete an einen Grundbesitzer bezahlen.“"
                                            },
                                            {
                                                "example_id": "10dd79ec-64f0-4ee1-ba83-4c337e7e0dbe",
                                                "sense_id": "e4341fb8-cbda-3751-afa1-d7164666a92b",
                                                "text": "„Der Boden war so karg, dass man allenfalls Maniok anbauen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f5825886-b2a6-3c16-98e6-c2ef683b871d",
                                        "entry_id": "bea3b24a-b6ce-3e7f-bf80-e5e975e9561e",
                                        "glosses": [
                                            "essbare Wurzelknolle der unter [2] beschriebenen Pflanzenart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda64586-2bb1-4eb5-bda8-d5867fa1d248",
                                                "sense_id": "f5825886-b2a6-3c16-98e6-c2ef683b871d",
                                                "text": "Manioks können wie Salzkartoffeln zubereitet oder zu Mehl gemahlen werden."
                                            },
                                            {
                                                "example_id": "77997db4-9ea8-4019-804e-b16ddc1b8443",
                                                "sense_id": "f5825886-b2a6-3c16-98e6-c2ef683b871d",
                                                "text": "„Zu den 15 verschiedenen Sorten Fleisch werden Reis mit schwarzen Bohnen sowie gegrillte Bananen und Manioks gereicht.“"
                                            },
                                            {
                                                "example_id": "48219641-d6c1-4fe0-a1b0-f51565a599a7",
                                                "sense_id": "f5825886-b2a6-3c16-98e6-c2ef683b871d",
                                                "text": "„Die Mahlzeiten wurden mit heimischen Produkten zubereitet: Maniok, Teff und Hirse in Afrika; Reis, Saucen und Hühnchen in Asien; Quinoa und Süsskartoffeln auf den Hochebenen der Anden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
