        "fr-extract.jsonl": [
            {
                "entry_id": "0e15377b-608b-3b67-9748-73cfc8d2418f",
                "word": "fétidité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "84c6f3ae-60a6-4091-be80-cf19908628e8",
                        "entry_id": "0e15377b-608b-3b67-9748-73cfc8d2418f",
                        "tags": [
                            "plural"
                        ],
                        "form": "fétidités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "51f5d515-8ba7-3c14-ac56-63ced35f33df",
                        "entry_id": "0e15377b-608b-3b67-9748-73cfc8d2418f",
                        "glosses": [
                            "Caractère de ce qui est fétide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2acf44dd-48eb-4f6c-8de3-5f690ae8bc42",
                                "sense_id": "51f5d515-8ba7-3c14-ac56-63ced35f33df",
                                "text": "Les soirs humides, lorsque Paris mouillé exhalait une odeur fade de grande alcôve mal tenue, elle savait que ce temps mou, cette fétidité des coins louches enrageaient les hommes."
                            },
                            {
                                "example_id": "002fa455-e929-4c94-827c-f8797b5642e4",
                                "sense_id": "51f5d515-8ba7-3c14-ac56-63ced35f33df",
                                "text": "« Qu’il avoue ! » hurle la brute. Son visage se penche sur le mien, féroce, épouvantable ; je sens la fétidité de son haleine courir sur ma figure sous prétexte de me fouiller, il me secoue, me pousse me bouscule."
                            },
                            {
                                "example_id": "8b793c48-3cb3-4bfd-a222-6654cc4240e6",
                                "sense_id": "51f5d515-8ba7-3c14-ac56-63ced35f33df",
                                "text": "C’est dans la pénombre au fond d’un étroit couloir exhalant des fétidités malsaines, entre des parois que la crasse a noircies, quelque part où l’on se sent muré comme au coeur d’une prison."
                            },
                            {
                                "example_id": "c086534e-af97-47c2-b746-de9bbafad1fd",
                                "sense_id": "51f5d515-8ba7-3c14-ac56-63ced35f33df",
                                "text": "Du côté des femmes m’échut une vieille gâteuse affligée d'une fistule compliquée qui faisait communiquer entre elles toutes les pièces basses de son organisme, par où je devais introduire des filières de mèches au sublimé. Au premier essai, je crus vomir. L'odeur de corruption était épouvantable. On m’avait affirmé : « Vous vous aguerrirez… » Mais pas du tout. C’est là un cliché fort inexact. Je ne me suis jamais aguerri. Il m’arrive encore maintenant de rêver de ce lit, de ces drains, de cette fétidité qui me donnaient envie de m’enfuir."
                            },
                            {
                                "example_id": "94ac05d9-0526-486b-8cbb-90a126a6cdcb",
                                "sense_id": "51f5d515-8ba7-3c14-ac56-63ced35f33df",
                                "text": "La crainte du « noir », la fétidité, la peur des rats, les arrêtaient sur le seuil, et c’est avec répugnance, du bout des doigts, qu’ils tiraient à eux les wassingues et les balais de bouleau."
                            }
                        ]
                    }
