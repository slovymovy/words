                "senses": [
                    {
                        "sense_id": "4f1d7975-ee0e-3d53-bb02-1a36f26f3cac",
                        "entry_id": "d11ee036-033a-3bb6-aa65-65ece350b89f",
                        "glosses": [
                            "Donner un caractère centrafricain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0de10f57-89bb-4913-9226-a315fc296b41",
                                "sense_id": "4f1d7975-ee0e-3d53-bb02-1a36f26f3cac",
                                "text": "Si dans un premier temps, il a été possible de satisfaire les besoins en main d’œuvre qualifiée en faisant appel à la main d’œuvre étrangère, l’accroissement de ces besoins et la volonté d’africaniser, ensuite de centrafricaniser les personnels des entreprises ont imposé, la formation dans le pays, d’une main d’œuvre qualifiée qui ne pouvait plus être importée par suite de coût excessif de son recrutement."
                            },
                            {
                                "example_id": "e9c8c8e4-7165-4cd4-a6c3-28852510d1b8",
                                "sense_id": "4f1d7975-ee0e-3d53-bb02-1a36f26f3cac",
                                "text": "Les animaux, les sauvages, les barbares et les hors la loi peuvent-ils construire un état d'esprit ou plutôt le somaliser ou le centrafricaniser?"
                            },
                            {
                                "example_id": "139e716d-e49f-43c1-8858-8d22cfb5b762",
                                "sense_id": "4f1d7975-ee0e-3d53-bb02-1a36f26f3cac",
                                "text": "oui on veut centrafricaniser le Niger"
                            }
                        ]
                    }
