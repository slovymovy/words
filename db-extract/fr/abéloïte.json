                        "cross_references": [
                            {
                                "target_word": "Abelian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed11f4fe-503d-3dc0-be24-6545bece8fb4",
                                        "entry_id": "d992ae0f-aa41-3951-be00-a553190724bf",
                                        "glosses": [
                                            "Alternative letter-case form of abelian."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b40db83-de4e-4808-818b-976694864ab8",
                                                "sense_id": "ed11f4fe-503d-3dc0-be24-6545bece8fb4",
                                                "text": "Ex. 2. Show by §§ 187, 188 that there can be no transitive Abelian group of prime degree other than the cyclic group, and that there is no irreducible Abelian equation of prime degree other than the cyclic equation."
                                            },
                                            {
                                                "example_id": "c051e735-5e1e-4eb8-bffe-2671f7f9f237",
                                                "sense_id": "ed11f4fe-503d-3dc0-be24-6545bece8fb4",
                                                "text": "All irreducible Abelian equations of the tenth order belong to the cyclical group of order ten,[…]."
                                            },
                                            {
                                                "example_id": "bf4c401a-3fba-435e-a914-2dbe70ae8c90",
                                                "sense_id": "ed11f4fe-503d-3dc0-be24-6545bece8fb4",
                                                "text": "In this chapter \"group\" means torsion free Abelian group. The \"bible\" of Abelian group theory is the two volume work of Fuchs [11]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Abelian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5d63f98-6d50-3d8c-b898-43b879534878",
                                        "entry_id": "48c7cf40-98b8-3965-96c5-96ac0bdc154d",
                                        "glosses": [
                                            "A member of a sect in fourth-century Africa mentioned by St. Augustine, who states that they married but lived in continence after the manner, as they claimed, of Abel."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f6415f-6d87-4fb1-a7ff-44de86cbead4",
                                                "sense_id": "e5d63f98-6d50-3d8c-b898-43b879534878",
                                                "text": "1826, unnamed translator, Pierre Bayle, An Historical and Critical Dictionary [1697, Dictionnaire Historique et Critique; 1709, Historical and Critical Dictionary], Selected and Abridged, Volume 1, page 50,\nThe Abelians were only a moderate sort of Encratites and Novatians, who absolutely condemned matrimony, while the Abelians approved of and retained it."
                                            },
                                            {
                                                "example_id": "60932fc5-b2ee-43cf-a19f-972ab53f033a",
                                                "sense_id": "e5d63f98-6d50-3d8c-b898-43b879534878",
                                                "text": "A difference of opinion existed as to the moral effects of matrimony among the early Christians; the Abelians, for instance, suffered no member of their sect to remain single, while the Novatians condemned marriage under every circumstance."
                                            },
                                            {
                                                "example_id": "ade1625d-b2d7-4ca6-bf39-e9ab4cf4db50",
                                                "sense_id": "e5d63f98-6d50-3d8c-b898-43b879534878",
                                                "text": "If we include heretical sects there is perhaps some similarity to be traced between the syneisaktism of certain Catholic enthusiasts and the customs of the Abelians or Abelonians, who took their name from Abel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
