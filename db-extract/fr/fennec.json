                                "target_word": "Fennek",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88365c8a-01ec-31e8-b3d8-1f2c8a5cc18c",
                                        "entry_id": "3388ed6c-07e3-3e11-8a5d-19bbdcd9a541",
                                        "glosses": [
                                            "Art aus der Gattung der Vulpes, welche sich besonders durch ihre großen Ohren auszeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a0aee94-012e-49f1-9839-aa8f66cc36e5",
                                                "sense_id": "88365c8a-01ec-31e8-b3d8-1f2c8a5cc18c",
                                                "text": "Dieser Fennek ist sehr verspielt."
                                            }
