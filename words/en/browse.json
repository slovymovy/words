{
    "word_family": [
        "browser",
        "browsing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0ed7ae7a-c2e9-32f5-981f-e3e1219e9d6c",
                    "sense_definition": "To scan or casually look through a collection of items, such as books or products, to find something of interest.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "casual looking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to <w>browse</w> through the bookstore while waiting for my friend to arrive.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>просмотреть</w> книги в магазине, пока ждал прихода друга."
                            }
                        },
                        {
                            "text": "Customers are welcome to <w>browse</w> the shelves at their own pace without any pressure to buy.",
                            "target_lang_translations": {
                                "ru": "Покупатели могут спокойно <w>изучать</w> полки в своем темпе, не чувствуя обязательства что-то покупать."
                            }
                        }
                    ],
                    "synonyms": [
                        "scan",
                        "skim",
                        "peruse",
                        "leaf"
                    ],
                    "common_phrases": [
                        "browse the shelves",
                        "browse through books",
                        "just browsing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Просматривать или бегло изучать коллекцию предметов, таких как книги или товары, чтобы найти что-то интересное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просматривать",
                                "target_lang_sense_clarification": "бегло знакомиться с содержимым"
                            },
                            {
                                "target_lang_word": "листать",
                                "target_lang_sense_clarification": "перелистывать страницы книги или журнала"
                            },
                            {
                                "target_lang_word": "присматривать",
                                "target_lang_sense_clarification": "искать что-то подходящее среди товаров"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9c06c66-6f6c-3b8b-9ffe-1444b9ba32d1",
                    "sense_definition": "To navigate through websites or electronic documents using a computer or mobile device.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "digital navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is much easier to <w>browse</w> the web when you have a fast internet connection.",
                            "target_lang_translations": {
                                "ru": "Гораздо проще <w>просматривать</w> веб-страницы, когда у вас быстрое интернет-соединение."
                            }
                        },
                        {
                            "text": "I spent the entire evening trying to <w>browse</w> the internet for new recipe ideas.",
                            "target_lang_translations": {
                                "ru": "Я провел весь вечер, пытаясь <w>найти</w> в интернете идеи новых рецептов."
                            }
                        }
                    ],
                    "synonyms": [
                        "surf",
                        "navigate"
                    ],
                    "common_phrases": [
                        "browse the web",
                        "browse the internet",
                        "browse online"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переходить по веб-сайтам или электронным документам с помощью компьютера или мобильного устройства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просматривать",
                                "target_lang_sense_clarification": "изучать контент в интернете"
                            },
                            {
                                "target_lang_word": "сидеть в интернете",
                                "target_lang_sense_clarification": "проводить время на веб-сайтах"
                            },
                            {
                                "target_lang_word": "искать",
                                "target_lang_sense_clarification": "находить информацию в сети"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "013c8ef1-6eb8-3d05-8208-48c1cad1ea26",
                    "sense_definition": "To feed on the leaves, twigs, or high-growing vegetation of shrubs and trees.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal feeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the winter months, deer often <w>browse</w> on the tender buds of young trees.",
                            "target_lang_translations": {
                                "ru": "В зимние месяцы олени часто <w>объедают</w> нежные почки молодых деревьев."
                            }
                        },
                        {
                            "text": "The goats like to <w>browse</w> on shrubs rather than eating the grass on the ground.",
                            "target_lang_translations": {
                                "ru": "Козы предпочитают <w>пастись</w> на кустарниках, а не есть траву на земле."
                            }
                        }
                    ],
                    "synonyms": [
                        "graze",
                        "feed",
                        "pasture"
                    ],
                    "common_phrases": [
                        "browse on shrubs",
                        "deer browse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Питаться листьями, ветками или высокой растительностью кустарников и деревьев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пастись",
                                "target_lang_sense_clarification": "находиться на подножном корму"
                            },
                            {
                                "target_lang_word": "объедать",
                                "target_lang_sense_clarification": "есть листья или побеги с веток"
                            },
                            {
                                "target_lang_word": "кормиться",
                                "target_lang_sense_clarification": "питаться растительностью"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "afee79c8-fb5f-39ae-a46b-ea7eb55d4cab",
                    "sense_definition": "An instance or period of casually looking through something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "casual looking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a quick <w>browse</w> in the library before my next class started.",
                            "target_lang_translations": {
                                "ru": "Я устроил себе быстрый <w>просмотр</w> книг в библиотеке перед началом следующего занятия."
                            }
                        },
                        {
                            "text": "After a long <w>browse</w> through the catalog, she finally found the perfect gift.",
                            "target_lang_translations": {
                                "ru": "После долгого <w>изучения</w> каталога она наконец нашла идеальный подарок."
                            }
                        }
                    ],
                    "synonyms": [
                        "look",
                        "scan",
                        "search"
                    ],
                    "common_phrases": [
                        "quick browse",
                        "have a browse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай или период беглого просмотра чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просмотр",
                                "target_lang_sense_clarification": "беглое ознакомление"
                            },
                            {
                                "target_lang_word": "изучение",
                                "target_lang_sense_clarification": "рассматривание ассортимента или каталога"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3eb7adb-41e2-347f-a758-d1ba9de79415",
                    "sense_definition": "Vegetation, such as twigs and young shoots, eaten by animals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal feeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest provides plenty of <w>browse</w> for the local elk population during the spring.",
                            "target_lang_translations": {
                                "ru": "Весной лес дает много <w>веточного корма</w> для местной популяции лосей."
                            }
                        },
                        {
                            "text": "Farmers must ensure there is enough winter <w>browse</w> available for their livestock.",
                            "target_lang_translations": {
                                "ru": "Фермеры должны обеспечить наличие достаточного количества зимнего <w>корма</w> для своего скота."
                            }
                        }
                    ],
                    "synonyms": [
                        "fodder",
                        "forage",
                        "feed"
                    ],
                    "common_phrases": [
                        "winter browse",
                        "source of browse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растительность, такая как ветки и молодые побеги, поедаемая животными."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веточный корм",
                                "target_lang_sense_clarification": "побеги и листья для питания животных"
                            },
                            {
                                "target_lang_word": "подножный корм",
                                "target_lang_sense_clarification": "растительность, доступная для поедания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}