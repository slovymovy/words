                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb4506b-afa0-4e79-9161-a00b787edcad",
                                "sense_id": "fa4dd958-929c-32b0-b000-bd55d8b092e5",
                                "text": "Le véhicule devant elle stoppa brutalement, elle faillit l’emboutir, freina sec, le téléphone dégringola sous le siège avant sans cesser de « grillonner »."
                            },
