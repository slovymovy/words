                        ],
                        "examples": [
                            {
                                "example_id": "91dc8c66-5190-4162-b0b1-b65159dbd710",
                                "sense_id": "134f85df-2e18-398b-81c8-e80f470aece0",
                                "text": "„Unbestritten ist die Tatsache, daß die in Rede stehende Künette eine Tiefe von 2,20 m hatte und daher hätte gepölzt werden müssen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
