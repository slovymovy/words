                {
                    "sense_id": "efe424ca-c538-3aa6-962f-4b47acd4f682",
                    "sense_definition": "w dniu, który bezpośrednio poprzedzał dzień dzisiejszy",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "literal_yesterday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wczoraj</w> byłem w kinie z moją siostrą.",
                            "target_lang_translations": {
                                "ru": "<w>Вчера</w> я был в кино с моей сестрой.",
                                "en": "<w>Yesterday</w> I was at the cinema with my sister.",
                                "nl": "<w>Gisteren</w> was ik met mijn zus in de bioscoop.",
                                "de": "<w>Gestern</w> war ich mit meiner Schwester im Kino.",
                                "fr": "<w>Hier</w>, j'étais au cinéma avec ma sœur.",
                                "it": "<w>Ieri</w> sono stato al cinema con mia sorella.",
                                "cs": "<w>Včera</w> jsem byl v kině se svou sestrou.",
                                "tr": "<w>Dün</w> kız kardeşimle sinemadaydım.",
                                "es": "<w>Ayer</w> estuve en el cine con mi hermana.",
                                "zh": "<w>昨天</w>我和我妹妹去了电影院。"
                            }
                        },
                        {
                            "text": "Musiałem wstać bardzo wcześnie <w>wczoraj</w> rano.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось встать очень рано <w>вчера</w> утром.",
                                "en": "I had to get up very early <w>yesterday</w> morning.",
                                "nl": "Ik moest <w>gisterenochtend</w> heel vroeg opstaan.",
                                "de": "Ich musste <w>gestern</w> Morgen sehr früh aufstehen.",
                                "fr": "J'ai dû me lever très tôt <w>hier</w> matin.",
                                "it": "Ho dovuto alzarmi molto presto <w>ieri</w> mattina.",
                                "cs": "Musel jsem <w>včera</w> ráno vstát velmi brzy.",
                                "tr": "<w>Dün</w> sabah çok erken kalkmak zorunda kaldım.",
                                "es": "Tuve que levantarme muy temprano <w>ayer</w> por la mañana.",
                                "zh": "<w>昨天</w>早上我不得不很早起床。"
                            }
                        }
                    ],
                    "antonyms": [
