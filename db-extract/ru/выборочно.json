                                            {
                                                "example_id": "4a609377-736b-4e6b-bb61-943f19eefe0c",
                                                "sense_id": "24c3848d-3687-352b-813d-3e66a154334e",
                                                "text": "Die Rede wurde auszugsweise abgedruckt."
                                            },
                                            {
                                                "example_id": "20bd8f52-6c20-4a2a-95af-f20c83156d25",
                                                "sense_id": "24c3848d-3687-352b-813d-3e66a154334e",
                                                "text": "Sie gab den Roman auszugsweise wieder."
                                            },
                                            {
                                                "example_id": "945796da-2d14-4e1b-8451-d7ff722b0a4d",
                                                "sense_id": "24c3848d-3687-352b-813d-3e66a154334e",
                                                "text": "Das Interview wurde nur auszugsweise veröffentlicht."
                                            }
                                        ],
