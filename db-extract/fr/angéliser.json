                "senses": [
                    {
                        "sense_id": "793954a6-578a-3061-b5be-058bcb288043",
                        "entry_id": "ba7e29e0-255e-306a-bc18-ad31d6d6b12a",
                        "glosses": [
                            "Rendre ou faire apparaître comme angélique, transformer en ange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0b2a561-fe5a-4d83-9333-dd7c48060509",
                                "sense_id": "793954a6-578a-3061-b5be-058bcb288043",
                                "text": "Dès cette époque, elle commençait à tout typiser, individualiser, synthétiser, dramatiser, supérioriser, analyser, poétiser, prosaïser, colossifier, angéliser, néologiser et tragiquer; car il faut violer pour un moment la langue, afin de peindre des travers nouveaux que partagent quelques femmes."
                            },
                            {
                                "example_id": "b89ccf0e-17d0-4790-a6fe-43e99dc64a0d",
                                "sense_id": "793954a6-578a-3061-b5be-058bcb288043",
                                "text": "La chasteté qui a pour but d’angéliser les créatures en fait des monstres trop souvent."
                            },
                            {
                                "example_id": "6ee5d7c5-16fe-4505-843b-18f46a7edb4c",
                                "sense_id": "793954a6-578a-3061-b5be-058bcb288043",
                                "text": "Ce qui précède ne doit pas nous conduire à diaboliser l’amygdale et angéliser les lobes frontaux."
                            }
                        ]
                    }
                ],
