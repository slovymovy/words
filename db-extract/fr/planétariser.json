                "senses": [
                    {
                        "sense_id": "e41372b0-5a36-3c0b-ae08-35e8ffdf2dc2",
                        "entry_id": "3df7f68e-101f-3a5d-bd6c-a17f96155fa7",
                        "glosses": [
                            "Donner un caractère planétaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ce18ce-e255-4482-8bb2-f66c63d925d7",
                                "sense_id": "e41372b0-5a36-3c0b-ae08-35e8ffdf2dc2",
                                "text": "De planétariser la problématique guerrière, la vision cosmographique normalise le colonialisme."
                            },
                            {
                                "example_id": "ce873a8d-3237-4b0d-ac38-d8aaa5ccddef",
                                "sense_id": "e41372b0-5a36-3c0b-ae08-35e8ffdf2dc2",
                                "text": "Mais la conséquence la plus directe de ces techniques n'est-elle pas de planétariser les tensions psychologiques et sociales de telle sorte que les occasions de conflits sont en permanence partout et que le plus localisé d'entre eux risque toujours de dégénérer en conflagration générale ?"
                            }
                        ]
                    }
