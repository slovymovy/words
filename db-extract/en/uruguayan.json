                                        "examples": [
                                            {
                                                "example_id": "6a99f006-ce89-4926-a265-a04f6aae5256",
                                                "sense_id": "ee44c708-df0b-3a50-9c88-1a48774ccdc0",
                                                "text": "Hned po svém nastoupení Solano Lopez zmocnil se ostrova Martin-Garcia na stoku Parany s Uruguayí, aby si zabezpečiI spojení s mořem, a spojil se s uruguayským presidentem Aguirrem proti Brazilii."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a43c496-e1a3-491d-a9ea-027132ede55c",
                        "source_entry_id": "55d0cfe5-903a-3fe7-9399-8cb9d064c05d",
                        "source_sense_id": "d022a2df-887d-3c70-9c00-e2cd5cedfcce",
