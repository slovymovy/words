                "senses": [
                    {
                        "sense_id": "f41e7877-5ca4-3e5f-b5a2-96e606681e4a",
                        "entry_id": "dee5926b-5154-34f4-ac3b-ef9af214d55e",
                        "glosses": [
                            "Zustand, in dem keine Aussicht auf eine positive Entwicklung erkennbar ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8a59f4a-1544-4c3c-8c7d-01d29de385fa",
                                "sense_id": "f41e7877-5ca4-3e5f-b5a2-96e606681e4a",
                                "text": "„Die enorme Auswanderungswelle, die Ende der 1960er, Anfang der 1970er Jahre auch Italien, vor allem den Süden des Landes, erfasst hatte, war eine Folge der katastrophalen Wirtschaftslage und der damit verbundenen Perspektivlosigkeit.“"
                            },
                            {
                                "example_id": "56924782-1d33-4656-9940-532d080a2bf0",
                                "sense_id": "f41e7877-5ca4-3e5f-b5a2-96e606681e4a",
                                "text": "„Die irreguläre Besiedlung des Ortes, der Jahr für Jahr weiter wuchs, weil Menschen den Busch verließen und sich hier ansässig machten, war ein typisches Beispiel für Verwahrlosung, Perspektivlosigkeit und schlechte Verwaltung.“"
                            },
                            {
                                "example_id": "0dfb3968-fbb5-42d6-bd6b-a6c65d5a2c27",
                                "sense_id": "f41e7877-5ca4-3e5f-b5a2-96e606681e4a",
                                "text": "„Die kontinuierliche Abwanderung Tausender Afghanen gen Europa aufgrund der steigenden Perspektivlosigkeit ging unvermindert weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
