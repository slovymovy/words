                        "cross_references": [
                            {
                                "target_word": "pinyin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24cfe46e-f9ed-3404-8a4d-cebb47319425",
                                        "entry_id": "3d2846d8-c9dd-3eef-9a44-6b5140ea69f3",
                                        "glosses": [
                                            "Systèmes de transcription de différentes langues, permettant de romaniser les sons des sinogrammes, et d’indiquer le ton utilisé lors de la prononciation. Le hanyu pinyin sert à la transcription du mandarin standard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "740db820-2285-4031-b71d-4f8b657e1bba",
                                                "sense_id": "24cfe46e-f9ed-3404-8a4d-cebb47319425",
                                                "text": "Shanghaï s’écrit 上海 en sinogrammes, et shànghǎi en hanyu pinyin."
                                            },
                                            {
                                                "example_id": "dc14bc7a-d0eb-44c3-81b8-61c5a8f962e2",
                                                "sense_id": "24cfe46e-f9ed-3404-8a4d-cebb47319425",
                                                "text": "Le pinyin fut développé en République populaire de Chine."
                                            },
                                            {
                                                "example_id": "1a609a3f-7538-49f9-9d1e-5fc418caa304",
                                                "sense_id": "24cfe46e-f9ed-3404-8a4d-cebb47319425",
                                                "text": "La perception qu’on a du pinyin en Chine a changé ces dernières années depuis que celui-ci est utilisé pour la saisie informatique des textes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pinyin",
