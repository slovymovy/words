                "senses": [
                    {
                        "sense_id": "b72b683b-cc5e-3d96-98fd-2aeb16ed2685",
                        "entry_id": "4e02ed99-0720-334e-95f8-9425773186e8",
                        "glosses": [
                            "Arrondir à nouveau."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3993776a-d83b-45d0-94eb-df6c760f0fa9",
                                "sense_id": "b72b683b-cc5e-3d96-98fd-2aeb16ed2685",
                                "text": "et maintenant que les jeunes prêcheurs si saints, si éloquens, qui montraient de si belles dents et un jabot si bien plissé, sont partis sans faire de choix parmi les belles de l'endroit, maintenant qu'ils sont remplacés par une brigade d'ingénieurs topographes qui lèvent le plan d'un canal, qui ont de jolis uniformes, jurent, boivent du mint julep, ne vont pas à l'église, mais aiment à danser, la gaîté renaît, et pour les captiver la foi disparait, les visages se rarrondissent, et les belles reprennent le teint de rose qui leur est naturel."
                            },
                            {
                                "example_id": "aca99265-f158-4f20-8a10-ae2475fa8a1f",
                                "sense_id": "b72b683b-cc5e-3d96-98fd-2aeb16ed2685",
                                "text": "Mais difficile, va falloir dormir, ramollir les fesses, décourber le dos, rarrondir les genoux... car ça va décoiffer.... (rammollircorrigé en ramollir)"
                            }
                        ]
                    }
