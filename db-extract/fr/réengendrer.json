                        "glosses": [
                            "Remettre dans les bonnes grâces."
                        ],
                        "tags": [
                            "familiar",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7b56a6af-922e-4fac-a071-610a9b20a2e9",
                                "sense_id": "8748b809-e422-3872-97c7-5f0a34c91fbe",
                                "text": "Cela me fait voir que, depuis que M. de Chaudebonne m’a réengendré avec Mme ou Mlle de Rambouillet, j’ai pris d’eux un autre esprit, et que j’étais un sot garçon en ce temps où Mlle Duplessis dit que j’étais si joli (VOIT. Lett. 24)"
                            }
                        ]
