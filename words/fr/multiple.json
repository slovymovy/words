                        "à de multiples reprises"
                    ]
                },
                {
                    "sense_id": "0e666f36-0cc6-3b0a-9ab0-f7256335121e",
                    "sense_definition": "Qui est divisible de manière exacte par un nombre entier donné.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quinze est un nombre entier <w>multiple</w> de cinq."
                        },
                        {
                            "text": "Tous les nombres pairs sont nécessairement <w>multiples</w> de deux."
                        }
                    ],
                    "synonyms": [
                        "divisible"
                    ],
                    "common_phrases": [
                        "multiple de"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dde77e79-940d-378f-a9c8-704cca5fa602",
                    "sense_definition": "Nombre entier qui en contient un autre un nombre exact de fois.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Neuf et douze font partie des <w>multiples</w> de trois."
                        },
                        {
                            "text": "Les élèves apprennent à calculer le plus petit commun <w>multiple</w> de deux entiers."
                        }
                    ],
                    "common_phrases": [
