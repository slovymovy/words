{
    "word_family": [
        "armchairing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc899c77-8743-31d1-a383-19b180d747ad",
                    "sense_definition": "A chair with supports for the arms or elbows.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat down in a comfortable <w>armchair</w> by the fireplace to read his book.",
                            "target_lang_translations": {
                                "ru": "Он сел в удобное <w>кресло</w> у камина, чтобы почитать книгу."
                            }
                        },
                        {
                            "text": "The living room has a large sofa and a matching leather <w>armchair</w>.",
                            "target_lang_translations": {
                                "ru": "В гостиной стоит большой диван и подходящее к нему кожаное <w>кресло</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "easy chair"
                    ],
                    "common_phrases": [
                        "comfortable armchair",
                        "leather armchair",
                        "sit in an armchair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стул с опорами для рук или локтей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кресло",
                                "target_lang_sense_clarification": "предмет мебели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75d82dd7-840c-38d9-8ea0-5f37a40182fb",
                    "sense_definition": "A position or perspective removed from direct experience or practical involvement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is easy to judge the situation from the comfort of a linguist's <w>armchair</w>.",
                            "target_lang_translations": {
                                "ru": "Легко судить о ситуации из уютного <w>кабинета</w> лингвиста."
                            }
                        },
                        {
                            "text": "The professor's theories were criticized for being developed from an <w>armchair</w> rather than through fieldwork.",
                            "target_lang_translations": {
                                "ru": "Теории профессора критиковали за то, что они были разработаны <w>умозрительно</w>, а не в ходе полевых исследований."
                            }
                        }
                    ],
                    "synonyms": [
                        "ivory tower"
                    ],
                    "common_phrases": [
                        "from the armchair"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Позиция или точка зрения, оторванная от прямого опыта или практического участия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабинетный",
                                "target_lang_sense_clarification": "оторванный от жизни"
                            },
                            {
                                "target_lang_word": "теоретический",
                                "target_lang_sense_clarification": "без практики"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e78cd54a-6da8-3bf7-bab5-00603b9b5bad",
                    "sense_definition": "Remote from actual involvement; participating in or observing an activity only through books, television, or the internet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remote_involvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>armchair</w> travelers enjoy watching documentaries about remote islands they will never visit.",
                            "target_lang_translations": {
                                "ru": "Многие <w>диванные</w> путешественники любят смотреть документальные фильмы о далеких островах, на которых они никогда не побывают."
                            }
                        },
                        {
                            "text": "The internet has turned many people into <w>armchair</w> activists who sign petitions but never protest.",
                            "target_lang_translations": {
                                "ru": "Интернет превратил многих людей в <w>диванных</w> активистов, которые подписывают петиции, но никогда не выходят на протесты."
                            }
                        }
                    ],
                    "antonyms": [
                        "active",
                        "hands-on"
                    ],
                    "common_phrases": [
                        "armchair traveler",
                        "armchair activist",
                        "armchair detective"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удаленный от реального участия; участвующий в деятельности или наблюдающий за ней только через книги, телевидение или интернет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диванный",
                                "target_lang_sense_clarification": "не имеющий практического опыта"
                            },
                            {
                                "target_lang_word": "кабинетный",
                                "target_lang_sense_clarification": "чисто теоретический"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e26412a0-f7f7-3772-a23b-039df3d521e8",
                    "sense_definition": "Giving advice or opinions on a subject without having any practical experience or professional qualifications in it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unqualified_opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every Monday morning, the office is full of <w>armchair</w> quarterbacks criticizing the coach's decisions.",
                            "target_lang_translations": {
                                "ru": "Каждое утро понедельника офис полон <w>диванных</w> экспертов, критикующих решения тренера."
                            }
                        },
                        {
                            "text": "Don't listen to him; he is just an <w>armchair</w> lawyer who reads a few blogs.",
                            "target_lang_translations": {
                                "ru": "Не слушай его; он просто <w>диванный</w> юрист, начитавшийся блогов."
                            }
                        }
                    ],
                    "synonyms": [
                        "backseat"
                    ],
                    "antonyms": [
                        "professional",
                        "expert"
                    ],
                    "common_phrases": [
                        "armchair quarterback",
                        "armchair critic",
                        "armchair expert"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used pejoratively"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дающий советы или высказывающий мнение по предмету, не имея в нем практического опыта или профессиональной квалификации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диванный",
                                "target_lang_sense_clarification": "иронично о дилетанте"
                            },
                            {
                                "target_lang_word": "мамкин",
                                "target_lang_sense_clarification": "презрительно о самозванном эксперте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cfbcacde-7f4b-30c8-b7eb-80f30fb433a5",
                    "sense_definition": "To create a theory, plan, or conclusion based on general knowledge or speculation rather than on empirical data or field research.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theorizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing strategy was <w>armchaired</w> by executives who had never actually met a customer.",
                            "target_lang_translations": {
                                "ru": "Маркетинговая стратегия была <w>высосана из пальца</w> руководителями, которые никогда не видели живого клиента."
                            }
                        },
                        {
                            "text": "Instead of conducting surveys, the committee simply <w>armchaired</w> the new policy.",
                            "target_lang_translations": {
                                "ru": "Вместо проведения опросов комитет просто <w>составил умозрительный план</w> новой политики."
                            }
                        }
                    ],
                    "synonyms": [
                        "theorize",
                        "speculate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать теорию, план или заключение на основе общих знаний или предположений, а не на эмпирических данных или полевых исследованиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "теоретизировать",
                                "target_lang_sense_clarification": "без опоры на факты"
                            },
                            {
                                "target_lang_word": "строить умозрительные планы",
                                "target_lang_sense_clarification": "оторванно от реальности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b2466cb-06d6-3e95-8769-11018860752b",
                    "sense_definition": "To analyze or reflect upon data that has already been gathered by others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theorizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers <w>armchaired</w> a connection between the two events by reviewing old reports.",
                            "target_lang_translations": {
                                "ru": "Исследователи <w>установили теоретическую</w> связь между двумя событиями, изучив старые отчеты."
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>armchairing</w> the results of the latest census.",
                            "target_lang_translations": {
                                "ru": "Он провел вторую половину дня, <w>анализируя в кабинете</w> результаты последней переписи населения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Анализировать или размышлять над данными, которые уже были собраны другими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "анализировать кабинетным методом",
                                "target_lang_sense_clarification": "работать с готовыми данными"
                            },
                            {
                                "target_lang_word": "интерпретировать",
                                "target_lang_sense_clarification": "чужие результаты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}