                    {
                        "translation_id": "cc012d0e-7bf1-4a4c-964c-bb39b4163636",
                        "source_entry_id": "dbb73e92-1a73-3eaa-b47c-8f80018e6c46",
                        "source_sense_description": "сохранение у взрослых особей признаков строения более древних организмов",
                        "target_lang_word": "rétention",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétention",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb0d8e97-5658-338d-b2ea-ee7ac02305b5",
                                        "entry_id": "746e9b4d-4ab3-306c-9959-bbbc94a5c760",
                                        "glosses": [
                                            "Action de retenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7689cb02-bfc9-403c-9f77-b3ffafe2d99e",
                                                "sense_id": "bb0d8e97-5658-338d-b2ea-ee7ac02305b5",
                                                "text": "La Garonne devenant divagante multiplie, à loisir, les « gaules » ou « gaures », c'est-à-dire ses bras, et les « îles », résultant de l’atterrissement des graviers vite envahis par la végétation spontanée et bientôt exhaussées par la rétention du limon."
                                            },
                                            {
                                                "example_id": "abb04b3c-6ad6-40a5-a40a-c9e880a2a9b0",
                                                "sense_id": "bb0d8e97-5658-338d-b2ea-ee7ac02305b5",
                                                "text": "La mesure de la teneur en humidité d'un sol et la force de rétention de l'eau par celui-ci revêtent une grande importance pour l'aménagement des bassins versants et l'hydrologie."
                                            },
                                            {
                                                "example_id": "aa7f8c62-d099-4221-9bcc-1bb386893fa2",
                                                "sense_id": "bb0d8e97-5658-338d-b2ea-ee7ac02305b5",
                                                "text": "Le 5 avril, des ossements humains et des effets personnels avaient été repêchés dans le bassin de rétention des eaux pluviales qui jouxte l'aire de repos de Crantenoy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6605e3d-91a2-3c42-89f7-7a4bf7bb6387",
                                        "entry_id": "746e9b4d-4ab3-306c-9959-bbbc94a5c760",
                                        "glosses": [
                                            "Réservation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78354d3-f864-48c8-a7fb-7058d370c727",
                                                "sense_id": "a6605e3d-91a2-3c42-89f7-7a4bf7bb6387",
                                                "text": "Clause de rétention sur des revenus. — La rétention des fruits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31303863-281d-393c-bee8-fe0fe6673bd8",
                                        "entry_id": "746e9b4d-4ab3-306c-9959-bbbc94a5c760",
                                        "glosses": [
                                            "Action qui a pour but de retenir, de conserver."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2490ff31-3a98-4aee-8246-13545e9d6070",
                                                "sense_id": "31303863-281d-393c-bee8-fe0fe6673bd8",
                                                "text": "Arrêt de rétention: décision par laquelle une cause est retenue, conservée au rôle et en son rang, pour y être jugée sans aucun délai ni remise."
                                            },
                                            {
                                                "example_id": "f58f4df1-4ed2-4f42-9c97-842bf7c24e09",
                                                "sense_id": "31303863-281d-393c-bee8-fe0fe6673bd8",
                                                "text": "Droit de rétention, faculté accordée à certains créanciers de retenir la chose qui se trouve entre leurs mains, jusqu’au paiement de ce qui leur est dû."
                                            },
                                            {
                                                "example_id": "0dec307b-f094-4327-924c-713c295cb9df",
                                                "sense_id": "31303863-281d-393c-bee8-fe0fe6673bd8",
                                                "text": "Le droit de rétention est donc une sûreté réelle, puisque la chose retenue se trouve affectée à la garantie du créancier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac182b10-6c6a-36cc-8155-1cbf4e36f8e6",
                                        "entry_id": "746e9b4d-4ab3-306c-9959-bbbc94a5c760",
                                        "glosses": [
                                            "Accumulation d’un liquide destiné à être évacué par les conduits excréteurs ou dans le réservoir qui les accumule naturellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30d56a22-d3f0-4790-b49b-00bddcc63da3",
                                                "sense_id": "ac182b10-6c6a-36cc-8155-1cbf4e36f8e6",
                                                "text": "Rétention d’urine"
                                            },
                                            {
                                                "example_id": "2158baf5-ae2b-42ca-9a0a-abdb48a03207",
                                                "sense_id": "ac182b10-6c6a-36cc-8155-1cbf4e36f8e6",
                                                "text": "Rétention, Maladie dans laquelle la vessie ne peut se débarrasser de l’urine qu’elle contient."
                                            },
                                            {
                                                "example_id": "37aaf04b-838d-4f4a-b813-53bb69cf271b",
                                                "sense_id": "ac182b10-6c6a-36cc-8155-1cbf4e36f8e6",
                                                "text": "La rétention d'urine est l'impossibilité d'émettre naturellement par l'urètre partie ou totalité de l'urine contenue dans la vessie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0449e911-8146-3056-ba18-319c35e2b5e5",
                                        "entry_id": "746e9b4d-4ab3-306c-9959-bbbc94a5c760",
                                        "glosses": [
                                            "Fait d’être tourné vers le passé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb346e3d-8e0e-4044-a2ac-ebd2d1f3f92f",
                                                "sense_id": "0449e911-8146-3056-ba18-319c35e2b5e5",
                                                "text": "Le mélancolique, dit-on, est tourné vers le passé, absorbé par lui, sans ouverture à l’avenir. Incapable de protension, il est tout en rétention, indéfiniment retenu dans un passé non dépassé. Le maniaque, au contraire, est tout en protension, incapable de rétention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
