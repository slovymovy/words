                        "entry_id": "d10e5f4e-ebf7-3fea-adf6-8de018a3a305",
                        "glosses": [
                            "Qui aime à donner."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "note": "On l’emploie surtout avec la négation",
                        "examples": [
                            {
                                "example_id": "334308b1-a72a-4630-a7e5-e12df13a4ff7",
                                "sense_id": "1e763ab2-5fee-37a0-9ea2-c4e81c40654f",
                                "text": "Il n’est pas donnant. — La bonne femme n’est guère donnante."
                            },
                            {
                                "example_id": "899cad26-8f64-49fb-90d9-03085b48578a",
                                "sense_id": "1e763ab2-5fee-37a0-9ea2-c4e81c40654f",
                                "text": "Mon maréchal, assez donnant dans ce temps là, tire deux billets de mille francs de son secrétaire."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
