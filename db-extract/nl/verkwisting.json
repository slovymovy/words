                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
                                        "glosses": [
                                            "Excrement or urine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f5bf2b4-21fd-4877-a15f-4bc2719df8ee",
                                                "sense_id": "c01b7c76-8955-396f-9f52-5be152961524",
                                                "text": "The cage was littered with animal waste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6adfda45-4a7c-3c59-a598-a0af085f467e",
                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
                                        "glosses": [
                                            "A wasteland; an uninhabited desolate region; a wilderness or desert."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62da137d-554a-4967-98db-eddd3ea08cf9",
                                                "sense_id": "6adfda45-4a7c-3c59-a598-a0af085f467e",
                                                "text": "We went down accordingly into the waste, and began to make our toilsome and devious travel towards the eastern verge."
                                            },
                                            {
                                                "example_id": "aed4a035-06d9-4100-8c90-5302ef0cacb3",
                                                "sense_id": "6adfda45-4a7c-3c59-a598-a0af085f467e",
                                                "text": "The pampas of Argentina and the chilly wastes of Patagonia, like the prairies and deserts of North America, were largely shunned by Spanish settlers until the 1870s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a39ec9c-3410-32c6-8af7-117441a1ecf0",
                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
                                        "glosses": [
                                            "A place that has been laid waste or destroyed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f22515e0-8393-3afb-8b91-09ab5ae13b65",
                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
                                        "glosses": [
                                            "A large tract of uncultivated land."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3896c166-1852-3a7d-95f1-c501d8496bed",
                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
                                        "glosses": [
                                            "The part of the land of a manor (of whatever size) not used for cultivation or grazing, nowadays treated as common land."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd2f9fc6-78a6-368b-9112-c19799e84afb",
                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
                                        "glosses": [
                                            "A vast expanse of water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02961146-1be2-3158-8249-07e954512576",
                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
                                        "glosses": [
                                            "A disused mine or part of one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33f43750-fdd3-3abd-867b-b211fda6f374",
                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
                                        "glosses": [
                                            "The action or progress of wasting; extravagant consumption or ineffectual use."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f21558a1-bd2d-403d-ab58-ed354c470ae8",
                                                "sense_id": "33f43750-fdd3-3abd-867b-b211fda6f374",
                                                "text": "That was a waste of time!"
                                            },
                                            {
                                                "example_id": "7c4e2958-bf43-4689-a8ec-915bb5b4c8bb",
                                                "sense_id": "33f43750-fdd3-3abd-867b-b211fda6f374",
                                                "text": "Her life seemed a waste."
                                            },
                                            {
                                                "example_id": "9d139e43-a2c6-4e9d-94d8-77d6ded20f05",
                                                "sense_id": "33f43750-fdd3-3abd-867b-b211fda6f374",
                                                "text": "'Rebel railwaymen' at Birmingham New Street refused to wear the new uniforms on the grounds that they were a \"complete waste of public money\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c78aa58-383f-3b15-a4d6-66e45e0bdc18",
                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
                                        "glosses": [
                                            "Large abundance of something, specifically without it being used."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efce6f07-7f8f-3f89-9b86-7c0c30f0b444",
                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
                                        "glosses": [
                                            "Gradual loss or decay."
                                        ],
                                        "tags": [
