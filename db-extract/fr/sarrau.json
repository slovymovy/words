        "fr-extract.jsonl": [
            {
                "entry_id": "10b52e6f-bc7c-32dd-9a0a-99f13e53ab93",
                "word": "sarrau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e219f844-958a-4eff-9888-17c59ff20389",
                        "entry_id": "10b52e6f-bc7c-32dd-9a0a-99f13e53ab93",
                        "tags": [
                            "plural"
                        ],
                        "form": "sarraus"
                    },
                    {
                        "form_id": "be66dd22-1180-4c5c-add8-5be6c6296795",
                        "entry_id": "10b52e6f-bc7c-32dd-9a0a-99f13e53ab93",
                        "tags": [],
                        "form": "sarrot"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0842804-623a-3367-8461-2e327e81600e",
                        "entry_id": "10b52e6f-bc7c-32dd-9a0a-99f13e53ab93",
                        "glosses": [
                            "Sorte de blouse que portent les paysans, les charretiers, etc., par-dessus leurs vêtements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5006507-9abb-442d-802a-a09926265eee",
                                "sense_id": "d0842804-623a-3367-8461-2e327e81600e",
                                "text": "L’étranger entra : il paraissait encore plus vieux et plus misérable que Misère, et n’avait pour se couvrir qu’un sarrau bleu en haillons."
                            },
                            {
                                "example_id": "4615e96e-be37-4b91-9bd9-039e1dd2867a",
                                "sense_id": "d0842804-623a-3367-8461-2e327e81600e",
                                "text": "Elle était vêtue d’un sarrau bleu comme les autres prisonnières."
                            },
                            {
                                "example_id": "781b3353-4800-4384-b594-5c357e6a595f",
                                "sense_id": "d0842804-623a-3367-8461-2e327e81600e",
                                "text": "Ces êtres entrevus dans un rayon de lune, ces adolescents, ces hommes mûrs, ces vieillards brandissant des armes étranges, vêtus des costumes les plus divers, depuis le sarrau du manœuvre jusqu’à la redingote du bourgeois ; cette file interminable de têtes, dont l’heure et la circonstance faisaient des masques inoubliables d’énergie et de ravissement fanatiques, prenaient à la longue devant les yeux de la jeune fille une impétuosité vertigineuse de torrent."
                            },
                            {
                                "example_id": "93d8f2e1-6e35-4248-980e-289a38d44cd3",
                                "sense_id": "d0842804-623a-3367-8461-2e327e81600e",
                                "text": "La petite est déjà bien faite pour ses quinze ans ; ça se remarque sous le sarrau en loques, tendu sur sa gorge naissante."
                            },
                            {
                                "example_id": "0cb6a145-7f01-4f17-9493-46f294487ff0",
                                "sense_id": "d0842804-623a-3367-8461-2e327e81600e",
                                "text": "La petite Rosette changée en femme, ses yeux noirs, ses longs cils, ses grands cheveux et la gorge ronde qui marquait son sarrau souillé de cuisinière."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9950c14-eabb-3c39-928f-980379fe2ecc",
                        "entry_id": "10b52e6f-bc7c-32dd-9a0a-99f13e53ab93",
                        "glosses": [
                            "Survêtement d’intérieur, généralement blanc et à boutons, descendant au-dessus du genou, typiquement associé au personnel de laboratoires et aux médecins en institution."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "521b08ac-ad94-4a7d-81c2-5fb5ea62e661",
                                "sense_id": "e9950c14-eabb-3c39-928f-980379fe2ecc",
                                "text": "Depuis les débuts de la révolution, Cuba a formé des milliers de médecins étrangers sur son territoire, tout en déployant dans une cinquantaine de pays non pas des militaires, mais des brigades de sarraus blancs qui ont guéri des milliers de personnes […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "02910b73-1072-3d8b-9c97-9acc939c16bd",
                        "entry_id": "10b52e6f-bc7c-32dd-9a0a-99f13e53ab93",
                        "glosses": [
                            "Blouse d’écolier, boutonnée dans le dos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6c874f5-6074-4c23-9aa0-83936043375c",
                                "sense_id": "02910b73-1072-3d8b-9c97-9acc939c16bd",
                                "text": "Et je me revois aussi, chétif, en sarrau de lustrine, courir à travers cette tristesse des choses délaissées, me déchirer aux ronces, tourmenter les bêtes dans la basse-cour, ou bien suivre, des journées entières, au potager, Félix, qui nous servait de jardinier, de valet de chambre et de cocher."
                            },
                            {
                                "example_id": "eb735d44-542a-4f6d-944a-cc346a47bae0",
                                "sense_id": "02910b73-1072-3d8b-9c97-9acc939c16bd",
                                "text": "Il arrêta par son sarrau le petit Louis Prion, et sachant que le bébé pleurait quand on l’appelait par d’autres prénoms que le sien, ils le torturèrent de concert."
                            },
                            {
                                "example_id": "b00b6e26-cb80-4c6d-b60c-45f79c4a0602",
                                "sense_id": "02910b73-1072-3d8b-9c97-9acc939c16bd",
                                "text": "Le père Larache l’avait attrapé par son sarrau, entre les épaules, et lui administrait une râclée sur les jambes, à coups de pique-feu."
                            },
                            {
                                "example_id": "9fd9bcfe-f692-48b4-a21e-0c882b3853e0",
                                "sense_id": "02910b73-1072-3d8b-9c97-9acc939c16bd",
                                "text": "Sac au dos, comme un bon soldat\nQui s’en va pour livrer bataille,\nUn sarrau lui prenant la taille\nLe petit écolier s’en va."
                            },
                            {
                                "example_id": "67c3e368-39c9-420c-a746-8b7cb15e61b2",
                                "sense_id": "02910b73-1072-3d8b-9c97-9acc939c16bd",
                                "text": "On se revoit en sarrau noir assis à la table dont le plateau de chêne a été gravé de noms ou d’initiales et taché de coulées d’encre violette, la plume au-dessus de l’encrier de porcelaine."
                            },
                            {
                                "example_id": "2ded26c3-9c37-4d0d-9884-a39fc881f4d8",
                                "sense_id": "02910b73-1072-3d8b-9c97-9acc939c16bd",
                                "text": "Mais à perte de vue, des filles, les grandes du cours complémentaire et les petites comme moi, des blondes, des brunes, des tresses, des couettes, des sabots, des galoches, des sarraus de toutes couleurs – le mien, qui signale l’orpheline, est tout noir."
                            }
                        ]
                    },
                    {
                        "sense_id": "af67069a-dcfe-3898-9747-5bf2885f0e47",
                        "entry_id": "10b52e6f-bc7c-32dd-9a0a-99f13e53ab93",
                        "glosses": [
                            "Personne (travailleur, étudiant, médecin etc.) qui l'endosse."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "70bfbd5c-6cf8-4d88-b7dc-f0db271e1b33",
                                "sense_id": "af67069a-dcfe-3898-9747-5bf2885f0e47",
                                "text": "Cette armée de sarraus blancs — médecins, personnel infirmier, chercheurs et biologistes — mérite tout notre respect."
                            }
                        ]
                    }
                ],
