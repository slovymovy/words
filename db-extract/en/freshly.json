                                "example_id": "70d8c362-2472-45d5-835f-235f80034a72",
                                "sense_id": "fa1e4072-3b32-3667-90b7-ebe87d4a9b3b",
                                "text": "He smelt freshly fried kachoris rescued from the wedding buffet."
