                "forms": [],
                "senses": [
                    {
                        "sense_id": "7c375bbb-02e5-3d8b-89df-4a08b14fc9c7",
                        "entry_id": "43306675-f13d-3655-8eb1-d437f4c610cf",
                        "glosses": [
                            "Ensemble de plusieurs amas de galaxies et groupes de galaxies liés par la gravité. Le Superamas de la Vierge est le superamas dont fait partie le Groupe local (notre groupe de galaxies)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99b45d24-fabb-4170-8937-45077a381ba6",
                                "sense_id": "7c375bbb-02e5-3d8b-89df-4a08b14fc9c7",
                                "text": "On vient ainsi de découvrir un superamas de galaxies grâce à l’empreinte qu’il a laissée sur le rayonnement de fond cosmologique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8356ef51-3b26-4e99-ab32-27b045a50671",
                        "source_entry_id": "43306675-f13d-3655-8eb1-d437f4c610cf",
                        "source_sense_id": "7c375bbb-02e5-3d8b-89df-4a08b14fc9c7",
                        "target_lang_word": "Superhaufen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Superhaufen",
                                "target_lang_code": "de",
