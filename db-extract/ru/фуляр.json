                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86f0794b-622f-4c27-a821-174912cecb3c",
                        "source_entry_id": "b3933c96-1109-36f7-9920-1653460e64da",
                        "target_lang_word": "foulard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foulard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "601b5ea5-9caa-325d-bd1e-ee8696e63cc6",
                                        "entry_id": "affc175f-2c86-3973-802f-cfcec7be923b",
                                        "glosses": [
                                            "Étoffe de soie, de soie et coton ou de fibres artificielles, très légère et dont on fait des mouchoirs, des cravates, des fichus, des robes, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3dc567e-634d-4362-8a73-a23474d31736",
                                                "sense_id": "601b5ea5-9caa-325d-bd1e-ee8696e63cc6",
                                                "text": "Foulard des Indes. — Un mouchoir de foulard. — Une robe de foulard."
                                            },
                                            {
                                                "example_id": "a649f598-b565-4b3a-84c2-113fb8e3f703",
                                                "sense_id": "601b5ea5-9caa-325d-bd1e-ee8696e63cc6",
                                                "text": "Denise ne portait que les quelques mètres de foulard, achetés par madame Desforges."
                                            },
                                            {
                                                "example_id": "25f85c5a-af55-4464-9416-aa69a047f1c6",
                                                "sense_id": "601b5ea5-9caa-325d-bd1e-ee8696e63cc6",
                                                "text": "Une heure après, madame Martin, reposée, fraîche, en déshabillé de foulard et de dentelle, descendit sur la terrasse où l’attendait miss Bell."
                                            },
                                            {
                                                "example_id": "d069b25e-88e5-47c3-a1fd-b43d525d33be",
                                                "sense_id": "601b5ea5-9caa-325d-bd1e-ee8696e63cc6",
                                                "text": "Je vis entrer dans la salle dune belle jeune femme coiffée d’une chapeau de paille et vêtue d’une robe de foulard écru."
                                            },
                                            {
                                                "example_id": "0ea30bda-db9c-4949-bf53-a716a24a3e54",
                                                "sense_id": "601b5ea5-9caa-325d-bd1e-ee8696e63cc6",
                                                "text": "J’aimais la caresse soyeuse de ma robe en foulard bleu ; un ruban de velours noir retenait mes boucles et je portais une capeline de paille bise, fleurie de coquelicots et de bleuets."
                                            },
                                            {
                                                "example_id": "5969ea1b-0f13-4087-9655-8d0939d83ca5",
                                                "sense_id": "601b5ea5-9caa-325d-bd1e-ee8696e63cc6",
                                                "text": "Pat l’attendait devant l’hôtel, en robe de foulard vert bourgeon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc6ee76d-b2d2-3480-a8c2-8251da545140",
                                        "entry_id": "affc175f-2c86-3973-802f-cfcec7be923b",
                                        "glosses": [
                                            "Pièce d’étoffe servant de mouchoir, de cache-col, d’écharpe ou de fichu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "428cf73c-15cb-4620-9f38-9a9b008cf05f",
                                                "sense_id": "cc6ee76d-b2d2-3480-a8c2-8251da545140",
                                                "text": "Mais je m’agace de la stupide et pernicieuse manie des foulards. Il semble, dans le peuple, qu’un foulard dispense de donner à un enfant une coiffure, des chaussures, un vêtement suffisant ; du moment qu’il a un chiffon au cou, il est bien soigné, il n’attrapera pas de mal !"
                                            },
                                            {
                                                "example_id": "10e34544-2c52-4517-8d8e-d192f46342b9",
                                                "sense_id": "cc6ee76d-b2d2-3480-a8c2-8251da545140",
                                                "text": "Deux minutes après, un foulard de coton au cou et son béret « Le Vengeur » planté sur la tignasse épaisse, il attendait dans une posture recueillie et digne les ultimes recommandations paternelles."
                                            },
                                            {
                                                "example_id": "ac0ae988-0ab8-424f-a1c1-efafbb348489",
                                                "sense_id": "cc6ee76d-b2d2-3480-a8c2-8251da545140",
                                                "text": "Ce Binèche, avec sa casquette plate, son costume à carreaux, son foulard et ses chaussures jaunes, représentait le type de la gouape dans toute sa splendeur."
                                            },
                                            {
                                                "example_id": "ed8d7271-094e-4590-be5a-4b0ee0b2e585",
                                                "sense_id": "cc6ee76d-b2d2-3480-a8c2-8251da545140",
                                                "text": "Lorsque je me suis retournée, j’ai aperçu Mina qui se dirigeait vers moi à la vitesse d’une tornade, le foulard bleu pétrole noué autour de son cou se soulevant comme les ailes d’un oiseau."
                                            },
                                            {
                                                "example_id": "212df548-5725-405f-ab8e-9c9577e5c19c",
                                                "sense_id": "cc6ee76d-b2d2-3480-a8c2-8251da545140",
                                                "text": "Le look rappeur, avec ses panoplies fashion, les étiquettes de marques qui dépassent et le cliquetis des bijoux autour du cou, ça fait marcher flouze et bizness. C'est pour ça qu'on préfère les rebeus habillés en dollars aux rebeues fagotées en foulard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fd01fd8-fd9a-3639-aa9e-a8119ef33527",
                                        "entry_id": "affc175f-2c86-3973-802f-cfcec7be923b",
                                        "glosses": [
                                            "Foulard islamique, hidjab, porté sur la tête et couvrant souvent la totalité des cheveux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3250145-d367-4fe7-ad41-606e961e99d7",
                                                "sense_id": "7fd01fd8-fd9a-3639-aa9e-a8119ef33527",
                                                "text": "Au cours de l'automne 1989 éclate « l'affaire du foulard » dans un collège de banlieue parisienne où trois jeunes filles musulmanes, refusant d'enlever leur hidjab en classe, en sont exclues pour vingt jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b218fb56-cf00-3219-8235-02936c3982cb",
                                        "entry_id": "affc175f-2c86-3973-802f-cfcec7be923b",
                                        "glosses": [
                                            "Machine servant à encoller des étoffes avec de l’apprêt ou d’autres substances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cdd24ff-2d91-4603-b50c-c7ac84ab17cc",
                                                "sense_id": "b218fb56-cf00-3219-8235-02936c3982cb",
                                                "text": "Foulard gommeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f262f30f-6c99-3862-84a9-e90fd046a1b4",
                                        "entry_id": "affc175f-2c86-3973-802f-cfcec7be923b",
                                        "glosses": [
                                            "Acalypha, queue de chat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "764cdee1-50fd-45ec-bb42-11ea0af9145c",
                                                "sense_id": "f262f30f-6c99-3862-84a9-e90fd046a1b4",
                                                "text": "Le foulard est aussi appelé cancan ou queue-de-chat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
