                        "entry_id": "63a9fea7-8ab0-3b9b-801a-b61479126ab1",
                        "glosses": [
                            "Qui a un goût de poivre, qui contient du poivre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c587a1c7-cec7-416e-b517-70cfab1e9e7f",
                                "sense_id": "e5de71be-209c-3393-8a2d-c91bd4fa5f67",
                                "text": "La récolte de ces roses au parfum miellé et poivré va se poursuivre jusqu’à la fin du mois."
                            }
                        ]
                    },
                    {
                        "sense_id": "8529e0b1-8401-321d-bef6-3c8d3056f0ff",
