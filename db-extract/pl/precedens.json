                                                "sense_id": "ea2a6522-6240-3546-b7b4-a0458c207481",
                                                "text": "A third argument may be derived from the precedent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb373f1b-96c2-3c57-8323-d750f64f8c9c",
                                        "entry_id": "36d2dae1-2005-3f76-b3e4-da9d7c31ece1",
                                        "glosses": [
                                            "The previous version."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f71d2080-2424-3ace-bc3a-63f81f995e58",
                                        "entry_id": "36d2dae1-2005-3f76-b3e4-da9d7c31ece1",
                                        "glosses": [
                                            "A rough draught of a writing which precedes a finished copy."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80a28292-00e5-402c-885a-93d3c1be4542",
                                                "sense_id": "f71d2080-2424-3ace-bc3a-63f81f995e58",
                                                "text": "My Lord Melun, let this be copied out,\nI did suppose it should be on constraint ;\nAnd keep it safe for our remembrance :\nBut , heaven be thank'd , it is but voluntary ,\nReturn the precedent to these lords again"
                                            }
                                        ]
                                    }
                                ]
