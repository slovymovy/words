                        "glosses": [
                            "bedrijf dat bemiddelt tussen ouders van kinderen en mensen die op hun kinderen kunnen passen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "235acc13-27d1-4690-a7f4-4ac1494af641",
                                "sense_id": "551c6a24-dd4b-3570-bc30-9e16ba534ff3",
                                "text": "Nadia heeft een gastouderbureau en is na een periode van arbeidsongeschiktheid door reuma sinds kort weer parttime aan het werk."
                            },
                            {
                                "example_id": "0c3627c0-8c38-4ecf-bd38-d6b68129d34e",
                                "sense_id": "551c6a24-dd4b-3570-bc30-9e16ba534ff3",
                                "text": "Abdullah H. is veroordeeld tot een celstraf van 20 maanden voor grootschalige fraude met toeslagen en uitkeringen. De 'imam' pleegde de fraude tussen 2006 en 2011 met zijn gastouderbureau Family House in Den Haag."
                            },
                            {
                                "example_id": "f50a5be8-8bff-4ecd-a927-bac1d345d13c",
                                "sense_id": "551c6a24-dd4b-3570-bc30-9e16ba534ff3",
                                "text": "De verdachten exploiteerden op papier tussen 2011 en 2015 een gastouderbureau in Den Haag. Op basis van overeenkomsten met vraagouders en gastouders vroeg het bureau bij de Belastingdienst kinderopvangtoeslag voor de ouders aan. In werkelijkheid was er geen sprake van opvang."
                            }
                        ]
                    }
