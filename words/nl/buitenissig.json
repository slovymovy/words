{
    "word_family": [
        "buitenissigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7708cfc5-34bb-3a65-921c-a0f34a4d2b95",
                    "sense_definition": "Afwijkend van het normale, vaak op een opvallende of vreemde manier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "afwijkend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij draagt altijd <w>buitenissige</w> kleding die de aandacht trekt.",
                            "target_lang_translations": {
                                "en": "He always wears <w>eccentric</w> clothing that attracts attention."
                            }
                        },
                        {
                            "text": "De kunstenaar staat bekend om zijn <w>buitenissige</w> ideeën over architectuur.",
                            "target_lang_translations": {
                                "en": "The artist is known for his <w>unconventional</w> ideas about architecture."
                            }
                        }
                    ],
                    "synonyms": [
                        "vreemd",
                        "raar",
                        "zonderling",
                        "excentriek",
                        "merkwaardig",
                        "excentrisch",
                        "extravagant"
                    ],
                    "common_phrases": [
                        "buitenissig gedrag",
                        "buitenissig uiterlijk"
                    ],
                    "target_lang_definitions": {
                        "en": "Deviating from the normal, often in a striking or strange way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eccentric",
                                "target_lang_sense_clarification": "Describing a person or behavior that is unconventional and slightly strange."
                            },
                            {
                                "target_lang_word": "unconventional",
                                "target_lang_sense_clarification": "Not based on or conforming to what is generally done or believed."
                            },
                            {
                                "target_lang_word": "peculiar",
                                "target_lang_sense_clarification": "Strange or odd; unusual."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "881ccb6b-a44c-37d4-883d-c4c6d125f1bd",
                    "sense_definition": "Overdreven, opzichtig of smakeloos.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "afwijkend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het interieur van de villa was nogal <w>buitenissig</w> en vol met gouden versieringen.",
                            "target_lang_translations": {
                                "en": "The interior of the villa was rather <w>extravagant</w> and full of gold decorations."
                            }
                        },
                        {
                            "text": "Zij hield niet van die <w>buitenissige</w> decoraties in de woonkamer.",
                            "target_lang_translations": {
                                "en": "She did not like those <w>gaudy</w> decorations in the living room."
                            }
                        }
                    ],
                    "synonyms": [
                        "buitensporig"
                    ],
                    "target_lang_definitions": {
                        "en": "Exaggerated, showy, or tasteless."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "extravagant",
                                "target_lang_sense_clarification": "Lacking restraint in style or expenditure; showy."
                            },
                            {
                                "target_lang_word": "gaudy",
                                "target_lang_sense_clarification": "Extravagantly bright or showy, typically so as to be tasteless."
                            },
                            {
                                "target_lang_word": "ostentatious",
                                "target_lang_sense_clarification": "Characterized by vulgar or pretentious display; designed to impress."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b74b7b5c-9645-34b8-b00e-05e2c14b7399",
                    "sense_definition": "Afwijkend van wat gewoon en/of gangbaar is.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "afwijkend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het bos zagen we allerlei <w>buitenissige</w> schepselen die we niet kenden.",
                            "target_lang_translations": {
                                "en": "In the forest, we saw all kinds of <w>bizarre</w> creatures that we didn't know."
                            }
                        },
                        {
                            "text": "Het is een <w>buitenissig</w> plan om midden in de winter te gaan kamperen.",
                            "target_lang_translations": {
                                "en": "It is an <w>odd</w> plan to go camping in the middle of winter."
                            }
                        }
                    ],
                    "synonyms": [
                        "vreemd",
                        "raar",
                        "zonderling"
                    ],
                    "target_lang_definitions": {
                        "en": "Deviating from what is ordinary and/or common."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "extravagant",
                                "target_lang_sense_clarification": "Exceeding the bounds of reason or the ordinary."
                            },
                            {
                                "target_lang_word": "bizarre",
                                "target_lang_sense_clarification": "Very strange or unusual."
                            },
                            {
                                "target_lang_word": "odd",
                                "target_lang_sense_clarification": "Different from what is usual or expected; strange."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}