                        "form": "die Rückflüge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94e51b0a-7e5b-382a-8a1b-1516f6c30dda",
                        "entry_id": "08ed7878-1286-3533-b35c-6fbc1beedf8e",
                        "glosses": [
                            "Flug, der zurück zu dem Ort führt, von dem aus jemand gestartet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5c0d758-0c3a-4f6e-99d3-458a66e549d0",
                                "sense_id": "94e51b0a-7e5b-382a-8a1b-1516f6c30dda",
                                "text": "„Die Telekom Austria hat laut Medienbericht im Jahr 2004 dem damaligen Finanzminister Karl Heinz Grasser sowie Walter Meischberger einen Privatjet für den Rückflug vom Golfen in Spanien bezahlt.“"
                            },
                            {
                                "example_id": "86fca268-f0a9-4356-acce-2605ff6b3d45",
                                "sense_id": "94e51b0a-7e5b-382a-8a1b-1516f6c30dda",
                                "text": "„Hat ein Passagier den Hinflug seiner Reise nicht genutzt, kann er trotzdem den Rückflug antreten, muss allerdings die Differenz zum anwendbaren Oneway-Tarif bezahlen.“"
                            },
                            {
                                "example_id": "4697df36-3fd8-419c-8d94-389cf6371ccb",
                                "sense_id": "94e51b0a-7e5b-382a-8a1b-1516f6c30dda",
                                "text": "„Janosch ließ seinen vermeintlichen Rückflug verfallen - und von da an streifte er nur über die Berge, in Erwartung seines baldigen Endes.“"
                            },
                            {
                                "example_id": "5bdb4b3e-4838-49fc-99c3-c535a8fedebe",
                                "sense_id": "94e51b0a-7e5b-382a-8a1b-1516f6c30dda",
                                "text": "„Noch vor ein paar Jahren hielt ich auf dem Rückflug von Paris vorsichtig eine kleine lindgrüne Schachtel von Ladurée, dem Tempel der Macarons in der französischen Hauptstadt, auf den Knien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
