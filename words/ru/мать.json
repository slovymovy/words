                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ну ты даёшь, <мать>, я от тебя такого не ожидал!",
                            "target_lang_translations": {
                                "en": "You really are something, <mother>, I didn't expect that from you!",
                                "nl": "Nou ja zeg, <moeders>, dat had ik niet van je verwacht!",
                                "zh": "你真行啊，<w>大姐</w>，我真没想到你会这么做！",
                                "pl": "Ale numer, <matka>, nie spodziewałem się tego po tobie!",
                                "de": "Du bist mir eine, <w>Mutter</w>, das hätte ich nicht von dir erwartet!",
                                "fr": "Tu m'en diras tant, <la mère>, je ne m'attendais pas à ça de ta part !",
                                "it": "Ma guarda un po', <madre>, non me lo aspettavo da te!",
                                "cs": "Teda ty jsi číslo, <matko>, to jsem od tebe nečekal!",
                                "tr": "Pes doğrusu <w>abla</w>, senden böyle bir şey beklemiyordum!",
                                "es": "¡Qué cosas tienes, <madre>, no esperaba eso de ti!"
                            }
                        },
                        {
                            "text": "Послушай, <мать>, налей нам ещё чаю.",
                            "target_lang_translations": {
                                "en": "Listen, <mother>, pour us some more tea.",
                                "nl": "Luister eens, <moeder>, schenk ons nog wat thee in.",
                                "zh": "听着，<w>大姐</w>，再给我们倒点茶。",
                                "pl": "Posłuchaj, <matka>, nalej nam jeszcze herbaty.",
                                "de": "Hör mal, <w>Mutter</w>, schenk uns noch etwas Tee ein.",
                                "fr": "Écoute, <la mère>, sers-nous encore un peu de thé.",
                                "it": "Ascolta, <madre>, versaci ancora un po' di tè.",
                                "cs": "Poslouchej, <matko>, nalij nám ještě čaj.",
                                "tr": "Dinle <w>abla</w>, bize biraz daha çay doldur.",
                                "es": "Escucha, <madre>, sírvenos un poco más de té."
