                "senses": [
                    {
                        "sense_id": "4d255ffa-750f-38bd-bce6-b0c2d1b50c06",
                        "entry_id": "22845e04-d1d0-35d4-9362-48dca1ec6137",
                        "glosses": [
                            "jemand, der aufgrund von Krankheit oder Verletzung beim Gehen dauerhaft stark beeinträchtigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f97720e-e142-4d61-bb2f-ccdb135a65e0",
                                "sense_id": "4d255ffa-750f-38bd-bce6-b0c2d1b50c06",
                                "text": "„Wenn ein Gehbehinderter im 100-Meter-Rennen gegen einen durchtrainierten Athleten antreten müsste, hieße es: Ungerecht! Machte man dann für die Niederlage des Gehbehinderten dessen Trainerteam verantwortlich, wäre das: absurd.“"
                            },
                            {
                                "example_id": "9123f313-108c-47c5-a3cd-d22f2596a72a",
                                "sense_id": "4d255ffa-750f-38bd-bce6-b0c2d1b50c06",
                                "text": "„Der Auftrag ist an sich klar: Bis 2024 sollen Gehbehinderte im öffentlichen Verkehr nicht mehr benachteiligt sein.“"
                            },
                            {
                                "example_id": "553efca6-5ae6-4cf5-bfd6-1e5cbec83db9",
                                "sense_id": "4d255ffa-750f-38bd-bce6-b0c2d1b50c06",
                                "text": "„Beim Einsteigen in den Bus müssen Gehbehinderte zunächst auf ihre eigene Sicherheit achten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
