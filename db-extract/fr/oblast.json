                ],
                "senses": [
                    {
                        "sense_id": "4aba5e22-4cad-3333-bc3c-b99908e88e9d",
                        "entry_id": "4aa22f45-37c9-3af0-9bd0-fde7a7a050d2",
                        "glosses": [
                            "Division administrative de la Bulgarie et de plusieurs pays issus de l’éclatement de l’ancienne URSS dont la Russie, la Biélorussie, le Kazakhstan, le Kirghizistan et l’Ukraine."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "c4a40f0f-308a-4790-bd64-fca47839f5bd",
                                "sense_id": "4aba5e22-4cad-3333-bc3c-b99908e88e9d",
                                "text": "L’hiver c’est en roulant sur la glace que l’on rejoint plus au sud le barrage et le reste de l’oblast de l’Amour."
                            },
                            {
                                "example_id": "c2f42d00-4c5c-4e02-8d34-ee1e13e56388",
                                "sense_id": "4aba5e22-4cad-3333-bc3c-b99908e88e9d",
                                "text": "« Notre armée avance franchement, nous passons d’une phase défensive à une contre-offensive », a lâché dimanche Sergiy Khlan, un responsable ukrainien de l’administration régionale, pour qui l’oblast de Kherson sera définitivement libéré d’ici septembre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b4bf2df-d730-4f63-9bc9-f5decff5a16f",
                        "source_entry_id": "4aa22f45-37c9-3af0-9bd0-fde7a7a050d2",
                        "source_sense_id": "4aba5e22-4cad-3333-bc3c-b99908e88e9d",
                        "target_lang_word": "Oblast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oblast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d328029-38da-3dbe-a3e3-c4a80786d592",
                                        "entry_id": "5a05e4c7-f912-3a27-bc4c-03f84b23911b",
                                        "glosses": [
                                            "Verwaltungsgebiet in Bulgarien, Kirgisistan, Russland, der Ukraine und Weißrussland sowie früher im Russischen Reich, in der Sowjetunion und von 1922 bis 1929 in Jugoslawien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28e56e00-9c54-4402-b8bd-df8fc38f7314",
                                                "sense_id": "1d328029-38da-3dbe-a3e3-c4a80786d592",
                                                "text": "Die Oblast Tjumen ist die größte Oblast Russlands."
                                            },
                                            {
                                                "example_id": "6732be9b-1472-490a-b6f1-d10bde052fe4",
                                                "sense_id": "1d328029-38da-3dbe-a3e3-c4a80786d592",
                                                "text": "In Russland gibt es 46 Oblaste."
                                            },
                                            {
                                                "example_id": "2de78b12-b8cc-47cd-8238-e046137bae8a",
                                                "sense_id": "1d328029-38da-3dbe-a3e3-c4a80786d592",
                                                "text": "„Im Herbst werden sie und die beiden Brüder in eines der wenigen russischen Kinderheime der Oblast in der Elchniederung gebracht.“"
                                            },
                                            {
                                                "example_id": "b2105b50-8702-4008-adba-4213ebe0e1ec",
                                                "sense_id": "1d328029-38da-3dbe-a3e3-c4a80786d592",
                                                "text": "Zielgebiet sind die Oblasts Vittebsk und Grodno, im Nordosten bzw. Nordwesten Weißrußlands, wo insgesamt ca. 8000 pflegebedürftige Menschen leben."
                                            },
                                            {
                                                "example_id": "ce3bba30-f541-4ed4-8961-7cec63f17e6d",
                                                "sense_id": "1d328029-38da-3dbe-a3e3-c4a80786d592",
                                                "text": "„Die russische Regierung förderte den Tourismus in der Oblast und lockte Deutsche mit einem Online-Visum an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Oblast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "743bdf39-7372-338b-98a7-c3aad14c28a2",
                                        "entry_id": "94507a13-625a-3259-85de-b2e8d5869192",
                                        "glosses": [
                                            "zusätzliches Frachtgut auf Flößen"
                                        ],
                                        "tags": [
                                            "Last"
                                        ],
                                        "examples": [
