                        "sense_id": "1470f782-7baf-3923-bec6-05c765c348f6",
                        "entry_id": "2bf1daed-6b06-30b9-9674-939d4b1a1059",
                        "glosses": [
                            "zespół cech człowieka stanowiących o chęci i powodzeniu w załatwianiu różnych spraw (bycie przedsiębiorczym)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aca3c0fc-9ab1-4509-85b3-a1339d649f98",
                                "sense_id": "1470f782-7baf-3923-bec6-05c765c348f6",
                                "text": "Przedsiębiorczości nie można mu odmówić, sam podjął się takiego wyzwania i to z jakim skutkiem!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4e115ad2-80d7-3932-b146-bb64d7fd8323",
                        "entry_id": "2bf1daed-6b06-30b9-9674-939d4b1a1059",
                        "glosses": [
                            "nauka lub sztuka podejmowania ryzyka i innowacyjności w budowaniu biznesu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93da5137-1de2-4152-ba0b-62d0910ae787",
                                "sense_id": "4e115ad2-80d7-3932-b146-bb64d7fd8323",
                                "text": "Ludzie w coraz młodszym wieku uczą się przedsiębiorczości."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "73ea19a1-bde4-3da5-b16d-6151e5e937f1",
                        "entry_id": "2bf1daed-6b06-30b9-9674-939d4b1a1059",
                        "glosses": [
                            "ogół przedsiębiorców i przedsiębiorstw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b877eb04-0d06-4d6c-8c95-39a7cf11c59c",
                                "sense_id": "73ea19a1-bde4-3da5-b16d-6151e5e937f1",
                                "text": "Rząd, wprowadzając ustawę, narzucił na drobną przedsiębiorczość kolejne ograniczenia."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
