                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e344761e-35d1-37e1-ba9f-b176076630ba",
                                        "entry_id": "03abeaf0-f075-317a-bdf8-b2dbfecab12b",
                                        "glosses": [
                                            "Celui qui sert de guide ou de conseiller à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa245c52-fca2-4570-82e8-66e5a4d2e8d8",
                                                "sense_id": "e344761e-35d1-37e1-ba9f-b176076630ba",
                                                "text": "Certainement, Jeanne, sous l’aile d’un tel mentor, ne sera plus en butte aux séductions des jeunes gens de votre village."
                                            },
                                            {
                                                "example_id": "d4769902-8ec5-4835-87be-b30dfaaedf43",
                                                "sense_id": "e344761e-35d1-37e1-ba9f-b176076630ba",
                                                "text": "Élève de mathématiques spéciales, il devenait ainsi, aux heures d’études, le mentor de ses camarades de classe. On lui obéissait sans effort ; son caractère simple et sérieux, le sentiment qu’il avait de la dignité individuelle lui rendaient facile l’autorité."
                                            },
                                            {
                                                "example_id": "e9f2bc45-3291-4346-a280-7f7678ec42d0",
                                                "sense_id": "e344761e-35d1-37e1-ba9f-b176076630ba",
                                                "text": "Ce soir-là, Joseph ne dîna pas, et, dès huit heures et demie, sonnait à la porte du professeur de mathématiques qui lui servait de mentor."
                                            },
                                            {
                                                "example_id": "f64d3d2d-b3c8-4a0b-a51d-915058d5bcbb",
                                                "sense_id": "e344761e-35d1-37e1-ba9f-b176076630ba",
                                                "text": "Le rêve de Bouteflika n’a jamais été d’être Boumedienne, son mentor des années 1970. Non, sa fascination va vers Hassan II."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97c8d00f-b516-3d8d-98f3-05a5fd7910f4",
                                        "entry_id": "03abeaf0-f075-317a-bdf8-b2dbfecab12b",
                                        "glosses": [
                                            "Cadre chargé d’améliorer les compétences et la réussite professionnelle d’un individu ou d’une équipe."
                                        ],
                                        "tags": [
                                            "Économie",
                                            "Gestion d’entreprise"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c572e18-6eb7-3a02-9a74-26a93aba3cb9",
                                        "entry_id": "03abeaf0-f075-317a-bdf8-b2dbfecab12b",
                                        "glosses": [
                                            "Personne chargée de conseiller sur le plan artistique et commercial un artiste ou un groupe pour lui permettre d’atteindre une plus grande notoriété."
                                        ],
