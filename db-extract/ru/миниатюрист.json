                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miniaturiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0662b3f8-7145-3508-b25d-8b0ef88859e3",
                                        "entry_id": "c0fb6885-61ca-3feb-a17b-e6e66774b6c1",
                                        "glosses": [
                                            "Qui s’inspire de la miniature, relatif à la miniature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da43dcf8-63c5-469d-b1af-724942b93e57",
                                                "sense_id": "0662b3f8-7145-3508-b25d-8b0ef88859e3",
                                                "text": "Mais chez ceux que tenait Florence et qui ne savaient pas la fuir ou la dompter, le double courant miniaturiste et littéraire déviait la passion native."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "miniaturiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68a3e13e-baf6-3b5e-9828-c644403f99d0",
                                        "entry_id": "3ff4894c-36f0-35e3-a12b-d0f1e1a9165f",
                                        "glosses": [
                                            "Peintre en miniature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3aa970b-144b-4df8-b625-10a7dea493ef",
                                                "sense_id": "68a3e13e-baf6-3b5e-9828-c644403f99d0",
                                                "text": "Je m’interroge sur un portrait commandé par Michel à une miniaturiste disposée à flatter ses modèles, mais qui laisse transparaître quelque chose de cette femme étrange."
                                            },
                                            {
                                                "example_id": "dfc4c93f-ab17-49b7-a982-e351dbe4d87d",
                                                "sense_id": "68a3e13e-baf6-3b5e-9828-c644403f99d0",
                                                "text": "Là le travail a été exécuté d’une main très experte , sans doute celle d’un miniaturiste professionnel."
                                            },
                                            {
                                                "example_id": "59285473-d450-4076-a61a-5ef6e29a4df2",
                                                "sense_id": "68a3e13e-baf6-3b5e-9828-c644403f99d0",
                                                "text": "Une exposition intitulée \"Encre et lumière\" regroupant les œuvres d’une trentaine de calligraphes et de miniaturistes algériens a ouvert ses portes à la galerie d’art \"Ahlem\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
