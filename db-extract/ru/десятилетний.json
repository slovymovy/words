                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zehnjährig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf1973c5-b3ad-3af4-9b85-167db76729f7",
                                        "entry_id": "316c0688-961d-37aa-9a12-9300a900d72b",
                                        "glosses": [
                                            "im Alter von zehn Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04dee756-ee8b-4bfa-bf8e-db5c537b94fa",
                                                "sense_id": "cf1973c5-b3ad-3af4-9b85-167db76729f7",
                                                "text": "„Viele der zehnjährigen Jungen wünschen sich nichts sehnlicher, als endlich als Mitglieder bei den Pimpfen aufgenommen zu werden.“"
                                            },
                                            {
                                                "example_id": "28a0945e-ba91-4019-aa12-de09eddc8032",
                                                "sense_id": "cf1973c5-b3ad-3af4-9b85-167db76729f7",
                                                "text": "„Doch folgte dem Trauma dieses Verlusts für den gerade zehnjährigen Jungen ein noch größeres, als der Vater im selben Jahr die Familie verließ, um in Bulawayo Arbeit zu suchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da09d738-0506-3503-ae70-2efc889129f3",
                                        "entry_id": "316c0688-961d-37aa-9a12-9300a900d72b",
                                        "glosses": [
                                            "zehn Jahre dauernd/bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d2f744-4406-4bbe-be7e-2cf939c60f16",
                                                "sense_id": "da09d738-0506-3503-ae70-2efc889129f3",
                                                "text": "„Im März 1966 erließ das sowjetische Fischereiministerium ein zehnjähriges Verbot des gewerblichen Fangs von Delphinen im Schwarzen und im Asowschen Meer.“"
                                            },
                                            {
                                                "example_id": "870e003e-3547-4c7a-bdd5-696b4968e28d",
                                                "sense_id": "da09d738-0506-3503-ae70-2efc889129f3",
                                                "text": "„Natürlich könnte ein zehnjähriger zermürbender Krieg gegen Troja als Erklärung des Endes der Mykener herangezogen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
