                "senses": [
                    {
                        "sense_id": "9dc7f7d6-d62a-39fd-8c28-ae5c2bb30d14",
                        "entry_id": "043ac1db-2357-3ed3-bb44-04c7636f0a78",
                        "glosses": [
                            "Ventilator, der an der Decke angebracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "334e3ab3-eb53-4b9a-8cf4-989d58875e90",
                                "sense_id": "9dc7f7d6-d62a-39fd-8c28-ae5c2bb30d14",
                                "text": "„Ein Doppelbett mit farbenfrohen Überzügen steht unter zwei messingbeschlagenen Deckenventilatoren.“"
                            },
                            {
                                "example_id": "a4fd3ea1-c245-454d-b3f2-1dd4fabf5a25",
                                "sense_id": "9dc7f7d6-d62a-39fd-8c28-ae5c2bb30d14",
                                "text": "„Über ihnen rührten träge Deckenventilatoren die heiße Luft um, und als das Bier kam, bewässerten sie damit sofort ihre ausgedörrten Kehlen.“"
                            },
                            {
                                "example_id": "075a4afb-6eee-4096-90cf-25efd2ccda01",
                                "sense_id": "9dc7f7d6-d62a-39fd-8c28-ae5c2bb30d14",
                                "text": "„Das Zimmer hatte einen Deckenventilator.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
