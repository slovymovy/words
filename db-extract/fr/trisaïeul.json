                                        "entry_id": "2fd9046e-4d46-3c25-9b1c-e6fcd8e668e9",
                                        "glosses": [
                                            "Vater von Urgroßmutter oder Urgroßvater"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75ddcbd-1063-4571-aa12-2159cdbbb4b0",
                                                "sense_id": "909d291f-9124-3c21-ad71-9c4ce1689741",
                                                "text": "„Johnnys Großvater, Urgroßvater, Ururgroßvater und Urururgroßvater, alle waren Schauspieler, nur sein Vater nicht.“"
                                            },
                                            {
                                                "example_id": "baa0cb75-85b6-46a6-aca2-5cdc055f02b3",
                                                "sense_id": "909d291f-9124-3c21-ad71-9c4ce1689741",
                                                "text": "„Sein Ururgroßvater Nils Tvíbur hatte während der Epidemie und in den Jahren danach einige Charakterzüge gezeigt, die aller Ehren wert waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
