                },
                {
                    "sense_id": "0a8d2730-cd1a-3101-89e7-2ae7dd8a7840",
                    "sense_definition": "Initialism of head of state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "political_titles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protocol for the meeting was strictly defined by the status of each <w>HOS</w> present.",
                            "target_lang_translations": {
                                "ru": "Протокол встречи строго определялся статусом каждого присутствующего <w>главы государства</w>.",
                                "tr": "Toplantının protokolü, katılan her <w>devlet başkanının</w> statüsüne göre kesin olarak belirlenmişti."
                            }
                        },
                        {
                            "text": "Security was tight as the <w>HOS</w> arrived for the international summit.",
                            "target_lang_translations": {
                                "ru": "Меры безопасности были усилены, когда <w>главы государств</w> прибыли на международный саммит.",
                                "tr": "Uluslararası zirve için <w>devlet başkanları</w> geldiğinde güvenlik önlemleri üst düzeydeydi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от «head of state» (глава государства).",
                        "tr": "\"Head of State\" (Devlet Başkanı) tanımının kısaltması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "главы государств",
                                "target_lang_sense_clarification": "официальный статус"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "devlet başkanları",
                                "target_lang_sense_clarification": "resmi unvan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75e3863c-3cf8-3d37-b73e-d9c132e3fe4c",
                    "sense_definition": "Initialism of hours of service.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regulations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Truck drivers must keep a logbook to ensure they do not exceed their <w>HOS</w> limits.",
                            "target_lang_translations": {
                                "ru": "Водители грузовиков должны вести бортовой журнал, чтобы не превышать <w>нормы рабочего времени</w>.",
                                "tr": "Kamyon sürücüleri, yasal <w>çalışma saati</w> sınırlarını aşmadıklarından emin olmak için bir seyir defteri tutmalıdır."
                            }
                        },
                        {
                            "text": "The new <w>HOS</w> regulations were designed to prevent accidents caused by driver fatigue.",
                            "target_lang_translations": {
                                "ru": "Новые правила <w>режима труда и отдыха</w> были разработаны для предотвращения аварий, вызванных усталостью водителей.",
                                "tr": "Yeni <w>çalışma süresi</w> düzenlemeleri, sürücü yorgunluğundan kaynaklanan kazaları önlemek amacıyla tasarlandı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "HOS regulations",
                        "HOS limits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от «hours of service» (нормы рабочего времени, обычно для водителей).",
                        "tr": "\"Hours of Service\" (çalışma/hizmet saatleri) tanımının kısaltması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нормы рабочего времени",
                                "target_lang_sense_clarification": "в контексте логистики"
                            },
                            {
                                "target_lang_word": "режим труда и отдыха",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çalışma saatleri",
                                "target_lang_sense_clarification": "lojistik ve ulaştırma alanında"
                            },
                            {
                                "target_lang_word": "hizmet süreleri",
                                "target_lang_sense_clarification": "yasal düzenlemeler kapsamındaki çalışma süreleri"
                            }
                        ]
                    }
                }
