        "nl-extract.jsonl": [
            {
                "entry_id": "bff6344a-77ef-34bf-9727-8f0d577a3b96",
                "word": "geopend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1217ee1a-c99d-3f73-9f36-19e5204a5422",
                        "entry_id": "bff6344a-77ef-34bf-9727-8f0d577a3b96",
                        "glosses": [
                            "opengemaakt, niet meer gesloten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f98f60f-4cde-4964-979f-32a539a6c012",
                                "sense_id": "1217ee1a-c99d-3f73-9f36-19e5204a5422",
                                "text": "Een geopend pak melk is nog maar beperkt houdbaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "85ee3d12-5735-3c41-93d0-4ac430621698",
                        "entry_id": "bff6344a-77ef-34bf-9727-8f0d577a3b96",
                        "glosses": [
                            "toegankelijk, begonnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a9eccfe-8abf-45bb-9ee2-f11b8902c8b6",
                                "sense_id": "85ee3d12-5735-3c41-93d0-4ac430621698",
                                "text": "Het pas geopende museum trok veel bezoekers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04a64f4a-41ff-45da-b03f-3055f911373a",
                        "source_entry_id": "bff6344a-77ef-34bf-9727-8f0d577a3b96",
                        "target_lang_word": "открытый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "открытый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7a547108-37e0-33b0-896e-20fbb630fb44",
                                        "entry_id": "bbbad170-1555-321b-8666-73c227c3dd06",
                                        "glosses": [
                                            "прич. от открыть: раскрытый, в противоположность закрытому, запечатанному"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51f9d225-c5d8-4552-9644-b56276005bff",
                                                "sense_id": "7a547108-37e0-33b0-896e-20fbb630fb44",
                                                "text": "на столе стоял открытый графин"
                                            },
                                            {
                                                "example_id": "e3487d96-76fb-4389-8771-c04f62748b15",
                                                "sense_id": "7a547108-37e0-33b0-896e-20fbb630fb44",
                                                "text": "Стоит открытый сундук"
                                            },
                                            {
                                                "example_id": "8116e47c-79f9-4c37-aa4b-d80d3c7ce4f7",
                                                "sense_id": "7a547108-37e0-33b0-896e-20fbb630fb44",
                                                "text": "Формалин наливают в открытый сосуд и ставят в камеру под стеллажи с обрабатываемыми изделиями."
                                            },
                                            {
                                                "example_id": "21feaa0b-1fb0-40e6-84b8-9aaa90a0a3d9",
                                                "sense_id": "7a547108-37e0-33b0-896e-20fbb630fb44",
                                                "text": "Бросив открытый автомобиль с работающим двигателем, неизвестный скрылся."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d034f26c-d9f3-3f07-beb3-1359de3a9164",
                                        "entry_id": "bbbad170-1555-321b-8666-73c227c3dd06",
                                        "glosses": [
                                            "обнаруженный, изобретённый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74b0ace3-a6c8-4140-af12-c1d5ff1304d5",
                                                "sense_id": "d034f26c-d9f3-3f07-beb3-1359de3a9164",
                                                "text": "Этим южным континентом является материк, открытый в 1606 году Биллемом Янсзоном и позже названный Австралией."
                                            },
                                            {
                                                "example_id": "f9e871cf-06ac-4bca-82c0-cff882fea65a",
                                                "sense_id": "d034f26c-d9f3-3f07-beb3-1359de3a9164",
                                                "text": "Рутений — первый химический элемент, открытый русским учёным-химиком Карлом Карловичем Клаусом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e03ddd20-2798-3fbc-9af3-1c85b57a3f21",
                                        "entry_id": "bbbad170-1555-321b-8666-73c227c3dd06",
                                        "glosses": [
                                            "доступный; ничем не загороженный, не завешенный, не заставленный и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a503b3e-a9ae-4024-9458-d69591b0d2f5",
                                                "sense_id": "e03ddd20-2798-3fbc-9af3-1c85b57a3f21",
                                                "text": "Открытый проем закрывается воздушной завесой."
                                            },
                                            {
                                                "example_id": "c1f793ad-3338-4cdb-a221-8647a7351836",
                                                "sense_id": "e03ddd20-2798-3fbc-9af3-1c85b57a3f21",
                                                "text": "В открытом мире игрок сам решает, как ему продвигаться по игре, выбирая из всех предложенных гейм-дизайнерами действий."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeb86345-15c9-3e07-9912-ab4c8294e67a",
                                        "entry_id": "bbbad170-1555-321b-8666-73c227c3dd06",
                                        "glosses": [
                                            "автомоб. применительно к кабриолету: без стека (откидного верха, крыши) либо со сложенным стеком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "457f51a4-f15e-42f2-8b8e-288eaa4908ad",
                                                "sense_id": "aeb86345-15c9-3e07-9912-ab4c8294e67a",
                                                "text": "Запомнилось, как однажды по Харитоньевскому переулку ехал старомодно высокий открытый автомобиль и на заднем сиденье среди каких-то полувоенных заметно возвышалась худая фигура Максима Горького, с любопытством посматривавшего вокруг."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa5b2c4e-3eae-343d-bd67-6224e2c1d0a4",
                                        "entry_id": "bbbad170-1555-321b-8666-73c227c3dd06",
                                        "glosses": [
                                            "перен. явный, не скрываемый и не умалчиваемый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c7edfa6-b070-41a1-a6fd-18a19fe0fa74",
                                                "sense_id": "aa5b2c4e-3eae-343d-bd67-6224e2c1d0a4",
                                                "text": "Открытое выступление против властей."
                                            },
                                            {
                                                "example_id": "0530367e-e5cd-449b-82d5-b91dd4c857cd",
                                                "sense_id": "aa5b2c4e-3eae-343d-bd67-6224e2c1d0a4",
                                                "text": "Кто же вас гонит: судьбы ли решение? // Зависть ли тайная? злоба ль открытая?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66975253-6380-3f89-9248-890f7d52bb07",
                                        "entry_id": "bbbad170-1555-321b-8666-73c227c3dd06",
                                        "glosses": [
                                            "перен. не завершённый, не решённый до конца"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aabd2ee-9890-4d8c-bccc-be1bc1f3da22",
                                                "sense_id": "66975253-6380-3f89-9248-890f7d52bb07",
                                                "text": "Открытый вопрос."
                                            },
                                            {
                                                "example_id": "3135be15-604e-44e8-9537-5a6e1099de0f",
                                                "sense_id": "66975253-6380-3f89-9248-890f7d52bb07",
                                                "text": "Открытый интервал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a410534-5886-3c61-bf6e-1288ed12e534",
                                        "entry_id": "bbbad170-1555-321b-8666-73c227c3dd06",
                                        "glosses": [
                                            "перен. прямодушный, искренний, откровенный, бесхитростный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b041703-9a33-4fe6-8eff-ceef96109138",
                                                "sense_id": "5a410534-5886-3c61-bf6e-1288ed12e534",
                                                "text": "Как-никак они засвидетельствуют, что он человек открытый и ни от партии, ни от КГБ ничего не скрывает."
                                            },
                                            {
                                                "example_id": "2ab89b5f-cd04-4aa9-85bf-ea038a7ac912",
                                                "sense_id": "5a410534-5886-3c61-bf6e-1288ed12e534",
                                                "text": "Он посмотрел Штруму в глаза, Виктор Павлович знал этот открытый, честный взгляд, каким смотрят люди, совершая плохие дела."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12da7ce8-2fe0-36b6-9e94-9baa24e1fa5d",
                                        "entry_id": "bbbad170-1555-321b-8666-73c227c3dd06",
                                        "glosses": [
                                            "доступный всем желающим; не предусматривающий ограничений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e900f175-72a4-4698-82c1-b1bc48eccc68",
                                                "sense_id": "12da7ce8-2fe0-36b6-9e94-9baa24e1fa5d",
                                                "text": "А что вы хотите: самая большая авиакомпания мира в самой большой гостинице проводит самый значительный открытый шахматный турнир."
                                            },
                                            {
                                                "example_id": "64e54f6a-9e2e-4a66-b0aa-8a580b702173",
                                                "sense_id": "12da7ce8-2fe0-36b6-9e94-9baa24e1fa5d",
                                                "text": "Открытое программное обеспечение."
                                            },
                                            {
                                                "example_id": "ff9a05b2-f008-4bd5-a802-e2c6d46be37c",
                                                "sense_id": "12da7ce8-2fe0-36b6-9e94-9baa24e1fa5d",
                                                "text": "Открытое акционерное общество"
                                            },
                                            {
                                                "example_id": "08659430-6bc0-4061-b1a2-22bc30849ee2",
                                                "sense_id": "12da7ce8-2fe0-36b6-9e94-9baa24e1fa5d",
                                                "text": "Гражданский кодекс Бразилии 1916 года включает в понятие недвижимости государственные кредитные билеты, обремененные условием об их неотчуждаемости, и право на открытое наследство."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "055feadf-a4a0-3d3e-834b-6bb691b2f3cb",
                                        "entry_id": "bbbad170-1555-321b-8666-73c227c3dd06",
                                        "glosses": [
                                            "мед. внешне заметный, не скрытый, не внутренний"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "278e48b6-1751-408e-883c-f55c3a22b15b",
                                                "sense_id": "055feadf-a4a0-3d3e-834b-6bb691b2f3cb",
                                                "text": "Открытая форма туберкулёза."
                                            },
                                            {
                                                "example_id": "63a0a717-b64d-44a2-a5f1-3a3f34f8dffc",
                                                "sense_id": "055feadf-a4a0-3d3e-834b-6bb691b2f3cb",
                                                "text": "Открытый перелом."
                                            },
                                            {
                                                "example_id": "059b38a9-fa85-4250-b6eb-e74353aba9fb",
                                                "sense_id": "055feadf-a4a0-3d3e-834b-6bb691b2f3cb",
                                                "text": "Открытая рана."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79607886-7a79-3960-baf6-b14a1e03beb3",
                                        "entry_id": "bbbad170-1555-321b-8666-73c227c3dd06",
                                        "glosses": [
                                            "восприимчивый, внимательный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bbbbad-ba84-4742-bb33-4cdd94eed74b",
                                                "sense_id": "79607886-7a79-3960-baf6-b14a1e03beb3",
                                                "text": "Он был необыкновенно хорош когда-то: умный, схватчивый, быстрый, открытый новым идеям и сам великолепно продуцирующий их – работать с ним, наблюдать его в работе, видеть плоды его работы было одно наслаждение."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "fd3b362b-54c9-4d6c-9197-fd5aa49b8e69",
