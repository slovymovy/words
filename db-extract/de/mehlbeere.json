                        "source_sense_id": "9c310723-19fc-3118-836c-f783bb4fc6f5",
                        "source_sense_description": "Botanik, im Singular: ein Vertreter der Mehlbeeren",
                        "target_lang_word": "alisier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alisier",
