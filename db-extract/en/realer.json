                        ],
                        "examples": [
                            {
                                "example_id": "ebb7e8ee-b6ea-457d-87b6-5633e159630e",
                                "sense_id": "8d0462e9-eed6-3cf9-8f9c-6e3cdcc32818",
                                "text": "Even those martyr-women who have stood by him in the long course of his transgressions, and maintained through thick and thin, that he is by all odds the novelist whom they could best trust with the cause of woman in fiction, have liked his anti-heroines more,—I mean, found them realer,—than his heroines."
                            },
                            {
                                "example_id": "5bb3b639-e562-41e9-aec6-78b33244f684",
                                "sense_id": "8d0462e9-eed6-3cf9-8f9c-6e3cdcc32818",
                                "text": "1956, A. B. Guthrie, These Thousand Hills, Mariner Books (1995), →ISBN, page 180,\nThose were the eyes remembered, the eyes of Rising Moon, father of Little Runner, who had prayed for his son in a time realer than this one and had seen the prayer answered and gone on his way, friend out of enemy."
                            },
                            {
                                "example_id": "e1d63cb0-7113-4c82-8c22-3b6c24e2576d",
                                "sense_id": "8d0462e9-eed6-3cf9-8f9c-6e3cdcc32818",
                                "text": "2007, Diane Setterfield, The Thirteenth Tale, Simon and Schuster, →ISBN, page 464,\nWith the future glowing so brightly it seems realer than the present, I put the page from Jane Eyre in the game bag as well, for safekeeping, and a spoon that is on the kitchen table."
                            }
                        ]
                    }
