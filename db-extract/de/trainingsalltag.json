                "senses": [
                    {
                        "sense_id": "d6dc619c-1d72-30ab-ad7d-dffff1af6613",
                        "entry_id": "b692316b-9325-3a4e-bd56-bbc6fa85f7b4",
                        "glosses": [
                            "typischer, üblicher Trainingsablauf (der meistens aus regelmäßigen Trainingsroutinen besteht)"
                        ],
                        "tags": [
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "5decdf55-234a-4faa-8cf3-228b83dc7c33",
                                "sense_id": "d6dc619c-1d72-30ab-ad7d-dffff1af6613",
                                "text": "„Der Trainingsalltag der Nachwuchsspieler bestehe in dieser Zeit generell aus einem Allround-Programm.“"
                            },
                            {
                                "example_id": "595b9c46-6941-4ea6-b69e-245f10022466",
                                "sense_id": "d6dc619c-1d72-30ab-ad7d-dffff1af6613",
                                "text": "„Ich hätte mir gerne mehr Begleitung im Trainingsalltag gewünscht.“"
                            },
                            {
                                "example_id": "451b4783-4303-45f4-a54d-00ab9be701a0",
                                "sense_id": "d6dc619c-1d72-30ab-ad7d-dffff1af6613",
                                "text": "„Nach fünf Monaten Sommerpause ist bei der BG Illertal-Weißenhorn wieder der Trainingsalltag eingekehrt.“"
                            },
                            {
                                "example_id": "e4f6fa2d-410e-4e05-8878-377cf4712512",
                                "sense_id": "d6dc619c-1d72-30ab-ad7d-dffff1af6613",
                                "text": "„Rund 100 Zuschauer und Fans fanden sich am Samstagnachmittag, trotz strahlenden Sonnenscheins, in der Halle West zur Präsentation des Trainingsalltags der ersten Schwelmer Baskets Mannschaft ein.“"
                            },
                            {
                                "example_id": "c94a141e-9098-431f-83db-78e69fe19d63",
                                "sense_id": "d6dc619c-1d72-30ab-ad7d-dffff1af6613",
                                "text": "„Regelmäßige Trainingscamps in den Sportarten Leichtathletik, Badminton, Basketball, Tischtennis sorgen für Abwechslung im Trainingsalltag und fördern das soziale Zusammenleben im Kinder- und Jugendbereich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
