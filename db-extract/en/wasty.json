                            "of produce"
                        ],
                        "examples": [
                            {
                                "example_id": "7a63cbcb-0bce-46ea-9fe3-218ff87f446d",
                                "sense_id": "e7eed481-37d9-3778-8c20-d441f12f5f90",
                                "text": "This fruit was well packed and nicely graded, but unfortunately a wasty condition prevented satisfactory prices being obtained."
                            }
                        ]
                    },
                    {
                        "sense_id": "c928a583-3547-3e96-aa86-bd07affee88d",
                        "entry_id": "3a248cdf-2476-3090-b8c7-929c43aa72c6",
                        "glosses": [
                            "Obese; excessively fat."
                        ],
                        "tags": [
                            "of livestock"
                        ],
                        "examples": [
                            {
                                "example_id": "d4506102-2ab8-4807-9e6d-89fd1bb29a8a",
                                "sense_id": "c928a583-3547-3e96-aa86-bd07affee88d",
                                "text": "."
                            },
                            {
                                "example_id": "104dd1c4-06f1-403a-90fd-70b119642fc0",
                                "sense_id": "c928a583-3547-3e96-aa86-bd07affee88d",
                                "text": "Then, too, the market demand is not so much for the extreme early maturing, excessive fat type, but it is for a trimmer, “less wasty” hog."
                            },
                            {
                                "example_id": "a8170a2e-5855-40fc-802e-5f7893e23229",
                                "sense_id": "c928a583-3547-3e96-aa86-bd07affee88d",
                                "text": "A trim-middled hog will have a higher dressing percentage than a wasty, gutty, paunchy, heavy-middled hog."
                            },
                            {
                                "example_id": "495a4f72-d098-4489-87ff-acd967c0353b",
                                "sense_id": "c928a583-3547-3e96-aa86-bd07affee88d",
                                "text": "Young animals are angular and slightly thin-fleshed; mature animals are slightly thick-fleshed, but irregular in contour. Fat covering varies from thin in young animals to moderately thick in mature animals and may be patchy or wasty."
                            }
                        ]
                    },
