    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a848242c-f8cb-3ded-a9ec-811ec0a8f521",
                    "sense_definition": "Expression du regret que l'on éprouve d'avoir offensé quelqu'un ou de s'être mal comporté.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "regret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vous prie d'accepter toutes mes <w>excuses</w> pour ce retard imprévu."
                        },
                        {
                            "text": "Le directeur a fini par présenter des <w>excuses</w> officielles aux clients mécontents."
                        }
                    ],
                    "common_phrases": [
                        "présenter des excuses",
                        "toutes mes excuses",
                        "faire des excuses"
                    ]
                },
                {
                    "sense_id": "5176519a-9ce9-36a3-af22-f90af81f65b2",
                    "sense_definition": "Raison ou motif que l'on allègue pour tenter d'expliquer ou d'atténuer une faute.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La panne de réveil est une mauvaise <w>excuse</w> pour justifier ton absence répétée."
                        },
                        {
                            "text": "Il invente toujours une <w>excuse</w> pour ne pas assister aux réunions du lundi."
                        }
                    ],
                    "synonyms": [
                        "prétexte"
                    ],
                    "common_phrases": [
                        "mauvaise excuse",
                        "servir d'excuse",
                        "trouver une excuse"
                    ]
                },
                {
                    "sense_id": "0bd9a8ab-a94d-3ade-a93d-9c4b338143b9",
                    "sense_definition": "Au jeu de tarot, carte spéciale faisant partie des trois bouts et servant de joker.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour ne pas sacrifier son roi de cœur, elle a joué l'<w>excuse</w> sur ce pli."
                        },
                        {
                            "text": "Il a posé l'<w>excuse</w> dès la première levée afin de ne pas donner de points."
                        }
                    ],
                    "common_phrases": [
                        "jouer l'excuse"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51c03352-5ab5-3e60-b14a-99468733ea1c",
                    "sense_definition": "Première ou troisième personne du singulier du présent de l'indicatif de <w>excuser</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'<w>excuse</w> chaleureusement auprès de ses invités pour le retard de son train."
                        },
                        {
                            "text": "Rien n'<w>excuse</w> une réaction aussi violente face à une simple remarque polie."
                        }
                    ]
                },
                {
                    "sense_id": "14e791e7-0e20-34d3-83b4-3474e8884233",
                    "sense_definition": "Deuxième personne du singulier du présent de l'impératif de <w>excuser</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "S'il te plaît, <w>excuse</w> ma maladresse lors de notre dernière discussion téléphonique."
                        },
                        {
                            "text": "<w>Excuse</w> mon ami qui est souvent distrait par ses nombreuses occupations."
                        }
                    ]
