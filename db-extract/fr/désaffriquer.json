                "senses": [
                    {
                        "sense_id": "117cf464-f96c-3ed1-b44a-8c7b512f6937",
                        "entry_id": "246acbb9-70a2-3c9c-aa4f-fb7310204863",
                        "glosses": [
                            "Ne plus affriquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5216ca6-a0dd-4770-bce0-36f73a66717d",
                                "sense_id": "117cf464-f96c-3ed1-b44a-8c7b512f6937",
                                "text": "Y a quelques mots que j'devrais ben \"désaffriquer\" pour de bon, peut-être comme ċen ou plaċyn, j'sais pas, j'réfléchis."
                            },
                            {
                                "example_id": "db8c07db-82b4-4712-87fa-098475f7e44a",
                                "sense_id": "117cf464-f96c-3ed1-b44a-8c7b512f6937",
                                "text": "Peut-on, à la lecture, \"désaffriquer\" le Ĝ et le prononcer comme un Ĵ (méthode aneuvienne) ?"
                            },
                            {
                                "example_id": "985744dc-36d3-476d-89d6-92370b7443d7",
                                "sense_id": "117cf464-f96c-3ed1-b44a-8c7b512f6937",
                                "text": "Or, autour du Xe siècle, le premier phonème se désaffrique et collisionne avec le deuxième aboutissant."
                            }
                        ]
                    }
