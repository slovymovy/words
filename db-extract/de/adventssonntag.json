                "senses": [
                    {
                        "sense_id": "bd95f82a-9864-33fa-8c65-d38bcb51aa82",
                        "entry_id": "b2c1c932-ce77-3714-9c06-2d91730a92dd",
                        "glosses": [
                            "einer der vier Sonntage in der Adventszeit, an dem häufig eine Adventskerze angezündet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31d1443-ad6a-47d8-958f-50ec64f09ad2",
                                "sense_id": "bd95f82a-9864-33fa-8c65-d38bcb51aa82",
                                "text": "Am vierten Adventssonntag zündeten wir die vierte und somit letzte Adventskerze auf unserem Adventskranz an."
                            },
                            {
                                "example_id": "0a315baf-8540-4c8c-aa4c-ee00303ef098",
                                "sense_id": "bd95f82a-9864-33fa-8c65-d38bcb51aa82",
                                "text": "„Am zweiten Adventssonntag gab es Spritzgebäck zum Tee und Spekulatiuskekse mit Windmühlenmuster.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
