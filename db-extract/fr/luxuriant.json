                    },
                    {
                        "form_id": "0a0b4eb8-f3df-479e-9e94-c111b5465cfa",
                        "entry_id": "bb4a627a-9a5d-361f-92ce-faf3c3bb6bb8",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "luxuriantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a6112303-351e-3890-9226-854bf73fad34",
                        "entry_id": "bb4a627a-9a5d-361f-92ce-faf3c3bb6bb8",
                        "glosses": [
                            "Qui surabonde, qui est très riche, comble la vue (ou, par extension, l'ouïe)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25f1820b-09fc-4427-95b1-2aa0d020b476",
                                "sense_id": "a6112303-351e-3890-9226-854bf73fad34",
                                "text": "Sa chevelure luxuriante, d’une nuance entre le brun et le blond, était partagée d’une manière gracieuse et élégante en nombreuses boucles où l’art avait assisté la nature."
                            },
                            {
                                "example_id": "bc06b8ae-9a72-4f85-b2e5-545e945c4912",
                                "sense_id": "a6112303-351e-3890-9226-854bf73fad34",
                                "text": "La végétation presque luxuriante de la vallée s’expliquait par la présence de cette eau à une faible profondeur."
                            },
                            {
                                "example_id": "6b2e4057-1ccd-4699-a5f1-d3e1a0112701",
                                "sense_id": "a6112303-351e-3890-9226-854bf73fad34",
                                "text": "Il semblerait donc que le plus grand désordre doive régner dans le tapis végétal. Il en est bien ainsi dans les régions de végétation luxuriante […]."
                            },
                            {
                                "example_id": "81ade025-0382-4b71-bbb8-8922f37aa079",
                                "sense_id": "a6112303-351e-3890-9226-854bf73fad34",
                                "text": "En 1938, l'Anschluss le contraint à quitter l'Autriche et à s'établir à Hollywood, où il compose une série de musiques de film luxuriantes, empoche quelques Oscars, avant d'effectuer un ultime retour vers la musique de concert."
                            },
                            {
                                "example_id": "3df8777c-f949-4f9c-8724-171aa6a09baf",
                                "sense_id": "a6112303-351e-3890-9226-854bf73fad34",
                                "text": "Sa chair épanouie, luxuriante, lui renvoyait une image maternelle, et cela bien que sa propre mère n'eût que la peau sur les os."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67ff57a8-d13f-45be-9562-1ec46e92c483",
                        "source_entry_id": "bb4a627a-9a5d-361f-92ce-faf3c3bb6bb8",
                        "source_sense_id": "a6112303-351e-3890-9226-854bf73fad34",
                        "target_lang_word": "lush",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ce7adbc-de08-3763-9c1b-7809f00f513f",
                                        "entry_id": "450f97f1-38f6-3368-a0db-d3a5bdbd0089",
                                        "glosses": [
                                            "Drunk; inebriated."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d41d0943-662d-42f5-b20b-fd6bac298811",
                                                "sense_id": "3ce7adbc-de08-3763-9c1b-7809f00f513f",
                                                "text": "“’E generally goes down there when ’e’s got ’is skinful, beggin’ your pardon, sir, an’ they do say that the more lush — in-he-briated ’e is, the more fish ’e catches.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e36f33a-c572-3278-b0fa-719240fe0c02",
                                        "entry_id": "a762bded-b88f-3b57-a67f-ad50668b0a70",
                                        "glosses": [
                                            "Juicy, succulent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cec63e1-9fbd-4328-9fd0-6d244934cd59",
                                                "sense_id": "1e36f33a-c572-3278-b0fa-719240fe0c02",
                                                "text": "How luſh and luſty the graſſe lookes ? How greene ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a67ed2fd-ff81-3257-b701-ac5db94843b4",
                                        "entry_id": "a762bded-b88f-3b57-a67f-ad50668b0a70",
                                        "glosses": [
                                            "Mellow; soft; (of ground or soil) easily turned; fertile."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6895d3c9-15f1-3105-963e-48e28e4817e4",
                                        "entry_id": "a762bded-b88f-3b57-a67f-ad50668b0a70",
                                        "glosses": [
                                            "Dense, teeming with life; luxuriant."
                                        ],
                                        "tags": [
                                            "of vegetation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a491acf0-d9ac-4a10-9a04-d9ed1e6909f9",
                                                "sense_id": "6895d3c9-15f1-3105-963e-48e28e4817e4",
                                                "text": "Some of the world’s best rain forest and volcanic hiking can be found within the lush canopied Caribbean trail systems. Chock-full of waterfalls and hot springs, bright-colored birds and howling monkeys, flora-lined trails cut through thick, fragrant forests and up cloud-covered mountains."
                                            },
                                            {
                                                "example_id": "a573d719-516a-4fff-8e4a-761cd3cf5728",
                                                "sense_id": "6895d3c9-15f1-3105-963e-48e28e4817e4",
                                                "text": "Virmire is a lush world located on the frontier of the Attican Traverse. Its vast seas and orbital position on the inner life zone have created a wide equatorial band of humid, tropical terrain."
                                            },
                                            {
                                                "example_id": "dab8623a-3b67-4ce2-b98f-7a8b0747780f",
                                                "sense_id": "6895d3c9-15f1-3105-963e-48e28e4817e4",
                                                "text": "European adventurers found themselves within a watery world, a tapestry of streams, channels, wetlands, lakes and lush riparian meadows enriched by floodwaters from the Mississippi River."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dcc0c88-c628-360b-9b11-5a36d2fa0790",
                                        "entry_id": "a762bded-b88f-3b57-a67f-ad50668b0a70",
                                        "glosses": [
                                            "Savoury, delicious."
                                        ],
                                        "tags": [
                                            "of food"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68736fc8-9e43-4c6f-8e38-d991387d14e1",
                                                "sense_id": "2dcc0c88-c628-360b-9b11-5a36d2fa0790",
                                                "text": "That meal was lush! We have to go to that restaurant again sometime!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ab0dc28-fb31-3199-917e-bd71eae9c478",
                                        "entry_id": "a762bded-b88f-3b57-a67f-ad50668b0a70",
                                        "glosses": [
                                            "Thriving; rife; sumptuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea5410a7-f563-40d6-b60e-26aa40484e7b",
                                                "sense_id": "7ab0dc28-fb31-3199-917e-bd71eae9c478",
                                                "text": "They rolled into Jane's room a wheeled cart lush with cake and cookies and shrimp and crudités and pop and soda water. The staff was giving us a going-away party for our trip to Seattle; it was good to understand their confidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f1ad3a8-b71f-3a93-910b-f791b0f71fde",
                                        "entry_id": "a762bded-b88f-3b57-a67f-ad50668b0a70",
                                        "glosses": [
                                            "Beautiful, sexy."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "065274d8-1d11-40a1-b001-d2f5d77cda40",
                                                "sense_id": "5f1ad3a8-b71f-3a93-910b-f791b0f71fde",
                                                "text": "Boys with long hair are lush!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c862d64a-b0fc-3c38-95c6-63ad1db38ff8",
                                        "entry_id": "a762bded-b88f-3b57-a67f-ad50668b0a70",
                                        "glosses": [
                                            "Amazing, cool, fantastic, wicked."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16ed2a4c-d602-4037-ba3b-d95a793adfca",
                                                "sense_id": "c862d64a-b0fc-3c38-95c6-63ad1db38ff8",
                                                "text": "Your voice is lush, Lucy! I could listen to it all day!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "699b865f-4091-38ff-ac0b-18b0c06f9ecd",
                                        "entry_id": "a762bded-b88f-3b57-a67f-ad50668b0a70",
                                        "glosses": [
                                            "Lax; slack; limp; flexible."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f008a672-1544-35a0-936f-389e942c404a",
                                        "entry_id": "de0dc229-1729-3d40-9abb-a782e122c73f",
                                        "glosses": [
                                            "A drunkard, sot, alcoholic."
                                        ],
                                        "tags": [
                                            "countable",
