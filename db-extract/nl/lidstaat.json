                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f529a47-dbb5-4a48-9bd1-0afba2f58912",
                                                "sense_id": "5a9522e2-08ea-3391-a388-cbec0187f8ff",
                                                "text": "„Mit der Organisation des Turniers beauftragt der ITTF ein Mitgliedsland.“"
                                            },
                                            {
                                                "example_id": "25b992a5-8e50-400e-94d5-832a1e6870ee",
                                                "sense_id": "5a9522e2-08ea-3391-a388-cbec0187f8ff",
                                                "text": "„Heutzutage zählt das CTIF 39 Mitgliedsländer und 46 angeschlossene Mitglieder.“"
                                            },
                                            {
                                                "example_id": "399fc8dd-a497-48a5-98ce-8a790c4c4476",
                                                "sense_id": "5a9522e2-08ea-3391-a388-cbec0187f8ff",
                                                "text": "[… Unternehmen müssten] nach dem Austritt Großbritanniens aus der EU in den Mitgliedsländern der Union pro Jahr etwa 35 Milliarden Euro für Zölle und andere Handelsbarrieren zahlen, wenn sie Waren in das Vereinigte Königreich exportieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68abdec4-0e04-4869-9864-7c66b334a738",
