        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "099d6f77-ef1e-3476-b8a6-1d6ff2418742",
                    "sense_definition": "aanpassen in grootte of schaal, met name vergroten of uitbreiden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf wil de productie snel <w>schalen</w> om aan de vraag te voldoen.",
                            "target_lang_translations": {
                                "en": "The company wants to <w>scale</w> production quickly to meet demand."
                            }
                        },
                        {
                            "text": "We moeten onze diensten efficiënt <w>schalen</w> naar een groter publiek.",
                            "target_lang_translations": {
                                "en": "We need to efficiently <w>scale</w> our services to a larger audience."
                            }
                        }
                    ],
                    "synonyms": [
                        "opschalen"
                    ],
                    "antonyms": [
                        "afschalen"
                    ],
                    "target_lang_definitions": {
                        "en": "to adjust in size or scale, particularly to increase or expand"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scale",
                                "target_lang_sense_clarification": "to grow or expand proportionally"
                            },
                            {
                                "target_lang_word": "scale up",
                                "target_lang_sense_clarification": "to increase size, amount, or production"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24c17ca6-a2d7-3a0a-99b0-2f50b162e39a",
                    "sense_definition": "zich in een bepaalde verhouding of schaal tot iets of iemand anders bevinden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is lastig om te zien hoe deze resultaten <w>schalen</w> met de eerdere metingen.",
                            "target_lang_translations": {
                                "en": "It is difficult to see how these results <w>scale</w> with the previous measurements."
                            }
                        },
                        {
                            "text": "De kosten <w>schalen</w> niet lineair met het aantal gebruikers.",
                            "target_lang_translations": {
                                "en": "The costs do not <w>scale</w> linearly with the number of users."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to relate or correspond in a certain proportion or scale to something or someone else"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scale",
                                "target_lang_sense_clarification": "to change size in proportion to something else"
                            },
                            {
                                "target_lang_word": "correlate",
                                "target_lang_sense_clarification": "to have a mutual relationship or connection in scale"
                            }
                        ]
                    }
                }
            ]
        }
    ]
