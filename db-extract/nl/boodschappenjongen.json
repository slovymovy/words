                        "glosses": [
                            "jongste bediende van de laagste rang die allerhande klusjes voor anderen moet opknappen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e00ad96e-f30b-4bb1-bc37-b592792a6dd6",
                                "sense_id": "765b3b37-74fb-3821-b542-60490e56cc78",
                                "text": "Een pizzakoerier is een boodschappenjongen die pizza's rondbrengt."
                            },
                            {
                                "example_id": "275b85f8-9896-4e6b-b587-9e7fc8c92cb5",
                                "sense_id": "765b3b37-74fb-3821-b542-60490e56cc78",
                                "text": "Trek je er niets van aan dat boodschappenjongens naar de keukeningang worden verwezen, loop naar de hoofdingang en bel één voor één bij elke deur aan, of je bovenin of onderop begint maakt niet uit."
                            }
                        ]
                    },
                    {
