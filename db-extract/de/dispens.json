                "senses": [
                    {
                        "sense_id": "3cbe5f87-98d5-3472-88a7-d74591291e9f",
                        "entry_id": "4caf4d68-90f1-39e9-baff-1ad3a371aa16",
                        "glosses": [
                            "Aufhebung einer allgemeinen Verpflichtung für einen Einzelfall oder bestimmte Fälle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d0e9d24-2c29-410c-a5c2-92e659d29a30",
                                "sense_id": "3cbe5f87-98d5-3472-88a7-d74591291e9f",
                                "text": "„Wurde die Dispens von der römisch-katholischen Trauungsform gewährt, so gilt die Ziviltrauung als Ort des für das gültige Zustandekommen einer Eheschließung erforderlichen Konsens-Austausches.“"
                            },
                            {
                                "example_id": "af801346-90f4-4723-a68d-2673a89d0477",
                                "sense_id": "3cbe5f87-98d5-3472-88a7-d74591291e9f",
                                "text": "„Da durch den Dispens Ausnahmen von den Regelungen der AIFM-Richtlinie gewährt werden, soll ESMA überwachen, ob europaweit eine einheitliche Regelung in Bezug auf bestimmte Vorschriften des jeweiligen Drittstaates gewährleistet ist.“"
                            },
                            {
                                "example_id": "ac3a2c46-7ffd-4595-845b-b5308951017f",
                                "sense_id": "3cbe5f87-98d5-3472-88a7-d74591291e9f",
                                "text": "„Kai hatte sich Dispens ausgebeten.“"
                            },
                            {
                                "example_id": "d76e412f-1464-42bd-959f-8e1f3c5ae3ff",
                                "sense_id": "3cbe5f87-98d5-3472-88a7-d74591291e9f",
                                "text": "„Der Vater annonciert das dem evangelischen Senat, wohl um Dispens von der Schulpflicht vor Ort zu erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1516eb3-010b-4e92-8e91-1462df52e784",
                        "source_entry_id": "4caf4d68-90f1-39e9-baff-1ad3a371aa16",
                        "source_sense_id": "3cbe5f87-98d5-3472-88a7-d74591291e9f",
                        "source_sense_description": "Aufhebung einer allgemeinen Verpflichtung für einen Einzelfall oder bestimmte Fälle",
                        "target_lang_word": "dispensation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dispensation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2aa3ae2a-483b-3994-8cb9-9b7bd45c1324",
                                        "entry_id": "717a051f-f351-38e4-a31b-616952096ca2",
                                        "glosses": [
                                            "The act of dispensing or dealing out; distribution"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81353333-86a3-404f-b07c-243d2286a160",
                                                "sense_id": "2aa3ae2a-483b-3994-8cb9-9b7bd45c1324",
                                                "text": "a fair dispensation of money"
                                            },
                                            {
                                                "example_id": "9d63473d-22e3-4034-84b3-63c6e5276c07",
                                                "sense_id": "2aa3ae2a-483b-3994-8cb9-9b7bd45c1324",
                                                "text": "The public's health is hardly improved by compounding the existing problem with the dispensation of undocumented, partially true or totally false material."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef029fd3-a2ce-3998-8748-f098aaccc925",
                                        "entry_id": "717a051f-f351-38e4-a31b-616952096ca2",
                                        "glosses": [
                                            "The distribution of good and evil by God to man."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abe13323-0711-4d5d-949e-455142f020b7",
                                                "sense_id": "ef029fd3-a2ce-3998-8748-f098aaccc925",
                                                "text": "Shall we not accompt theſe a part of Gods dispenſation, and therefore good in the Fountaine, from whence they flowed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c6db17c-e705-346a-a2e8-a873bd942f52",
                                        "entry_id": "717a051f-f351-38e4-a31b-616952096ca2",
                                        "glosses": [
                                            "That which is dispensed, dealt out, or given; that which is bestowed on someone"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27bfb033-aa21-4a70-9d72-a27f271f4612",
                                                "sense_id": "9c6db17c-e705-346a-a2e8-a873bd942f52",
                                                "text": "Bowman certainly lost no time in travelling south to obtain his dispensation once he had published the sermon"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3eb903e-440c-334b-9bf3-a4da61378965",
                                        "entry_id": "717a051f-f351-38e4-a31b-616952096ca2",
                                        "glosses": [
                                            "A system of principles, promises, and rules ordained and administered; scheme; economy"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b41fa07e-83d7-4d0f-9b7c-b1d2c69985ee",
                                                "sense_id": "e3eb903e-440c-334b-9bf3-a4da61378965",
                                                "text": "the Patriarchal, Mosaic, and Christian dispensations"
                                            },
                                            {
                                                "example_id": "de218859-161d-4fa5-86ec-54973f638d16",
                                                "sense_id": "e3eb903e-440c-334b-9bf3-a4da61378965",
                                                "text": "The sacrificial death of the Lord Jesus Christ introduced the dispensation of pure grace—which means undeserved favor, or God GIVING righteousness, instead of God REQUIRING righteousness, as under Law.[…]\nThe first event in the closing of this dispensation will be the descent of the Lord from Heaven, when sleeping saints will be raised and, together with believers then living, caught up “to meet the Lord in the air: and so shall we ever be with the Lord.” 1 Thess. 4: 16, 17."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc07ffb-48ee-324a-b08c-5d42451e1df1",
                                        "entry_id": "717a051f-f351-38e4-a31b-616952096ca2",
                                        "glosses": [
                                            "The relaxation of a law in a particular case; permission to do something forbidden, or to omit doing something enjoined; exemption."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e53eba4b-4d47-46b5-b271-9c70f7f67a5d",
                                                "sense_id": "9fc07ffb-48ee-324a-b08c-5d42451e1df1",
                                                "text": "Special grounds for giving dispensation to see classified documents include research purposes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13fdad76-2249-3d85-8688-0380b1a75c52",
                                        "entry_id": "717a051f-f351-38e4-a31b-616952096ca2",
                                        "glosses": [
                                            "The relaxation of a law in a particular case; permission to do something forbidden, or to omit doing something enjoined; exemption.",
                                            "In the Roman Catholic Church, an exemption from some ecclesiastical law, or from an obligation to God which a person has incurred of his own free will (oaths, vows, etc.)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0452b4e9-2191-4398-a002-5c7c73ee4f7f",
                                                "sense_id": "13fdad76-2249-3d85-8688-0380b1a75c52",
                                                "text": "[H]e had a dispensation for conforming in outward observances to the Protestant faith."
                                            },
                                            {
                                                "example_id": "598fda10-4b4a-4bf2-8134-9ea1d5b14dd8",
                                                "sense_id": "13fdad76-2249-3d85-8688-0380b1a75c52",
                                                "text": "Why, there has gone already to Rome a messenger to crave a second dispensation from his Popeship, and the King himself hath signed the request, praying that you and I should graciously be permitted to wed!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
