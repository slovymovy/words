                "senses": [
                    {
                        "sense_id": "578152d6-de0e-3934-aaa8-113d88ac613d",
                        "entry_id": "1de98b10-2ca9-3eb6-9399-3d2a0ed556e2",
                        "glosses": [
                            "Behältnis zur Aufbewahrung von Kleidung, das vor Motten schützen soll"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37da3623-2a57-3a2b-974c-fb03a830b747",
                        "entry_id": "1de98b10-2ca9-3eb6-9399-3d2a0ed556e2",
                        "glosses": [
                            "etwas, was als veraltet/antiquiert/überholt gilt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "6940dbeb-2d33-41a3-83ec-7d3ec7afbca2",
                                "sense_id": "37da3623-2a57-3a2b-974c-fb03a830b747",
                                "text": "„Wenn man die beiden Teams an diesem Abend mit Etiketten aus der Mottenkiste des Reportersprechs bedenken wollte, dann spielten die Mexikaner aufopferungsvoll, die Deutschen dagegen eher pomadig.“"
                            },
                            {
                                "example_id": "df36eb2e-3345-4f3d-b1bc-e10d5f882f3a",
                                "sense_id": "37da3623-2a57-3a2b-974c-fb03a830b747",
                                "text": "„Dieser Klassiker unter den Diätweisheiten, die jeden Frühling wieder aus der Mottenkiste kommen, ist auch in Acrylamid-Zeiten Gold wert.“"
                            },
                            {
                                "example_id": "d878cecc-156a-4de4-a74f-ae13d95e6364",
                                "sense_id": "37da3623-2a57-3a2b-974c-fb03a830b747",
                                "text": "Jetzt zieht sie [die Regierung Österreichs] ein neues Thema aus der populistischen Mottenkiste: Das Kopftuch soll in Kindergärten und Grundschulen verboten werden."
                            },
                            {
                                "example_id": "1e10ebfa-2ee5-4093-8a23-e7552ddf20cf",
                                "sense_id": "37da3623-2a57-3a2b-974c-fb03a830b747",
                                "text": "Wenn Karl Marx gerade als letzter Schrei gilt und andererseits die Konservative Revolution aus der Mottenkiste geholt wird, erkundet man gerne dritte Wege."
                            },
                            {
                                "example_id": "f4bd7f33-9820-44df-b799-4c560b762426",
                                "sense_id": "37da3623-2a57-3a2b-974c-fb03a830b747",
                                "text": "[Die Tänzerin Josephine Baker:] \"Schwarze Venus\" ist eines der freundlichen Klischees, das man für sie fand oder erfand. Andere Bezeichnungen stammen aus der damals, in den zwanziger und dreißiger Jahren des 20. Jahrhunderts, noch weit offenen Mottenkiste rassistischer Beleidigungen."
                            },
                            {
                                "example_id": "7adbc123-7bc9-4ac8-a781-4e55688fbb4c",
                                "sense_id": "37da3623-2a57-3a2b-974c-fb03a830b747",
                                "text": "„Herr Trump hat ja, ähnlich wie beim Stahl, dieses Gesetz aus dem Kalten Krieg aus der Mottenkiste herausgezogen von 1962, wo ihm Möglichkeiten des Handelns, basierend auf der nationalen Sicherheit, eröffnet worden sind, und jetzt versucht er ja, einen Zusammenhang zu der Gefährdung der nationalen Sicherheit mit dem Import von Autos in Zusammenhang zu bringen. Das ist natürlich völlig absurd […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
