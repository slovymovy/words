                        "examples": [
                            {
                                "example_id": "42027c70-e613-4810-a8c2-6dd73cf231d8",
                                "sense_id": "9528cca2-c3c6-303d-95f7-4b8ce579036c",
                                "text": "Après Penchard, Lurel et Pau-Langevin, Oudinot se déguadeloupéanise pour se réunionniser !"
