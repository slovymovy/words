{
    "word_family": [
        "начальство",
        "начальница",
        "начальственный",
        "начальствовать"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "292609d5-d5de-3866-8d3d-d04c674f250c",
                    "sense_definition": "Должностное лицо, которое руководит кем-либо или чем-либо и имеет власть над подчинёнными.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой <w>начальник</w> всегда приходит на работу вовремя.",
                            "target_lang_translations": {
                                "en": "My <w>boss</w> always comes to work on time.",
                                "zh": "我的<w>上司</w>总是准时上班。"
                            }
                        },
                        {
                            "text": "Вчера <w>начальник</w> отдела подписал важные документы.",
                            "target_lang_translations": {
                                "en": "Yesterday the <w>head</w> of the department signed important documents.",
                                "zh": "昨天部门<w>主管</w>签署了重要文件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "руководитель",
                        "шеф",
                        "босс",
                        "глава́",
                        "директор",
                        "управляющий"
                    ],
                    "antonyms": [
                        "подчинённый"
                    ],
                    "common_phrases": [
                        "начальник отдела",
                        "непосредственный начальник",
                        "большой начальник",
                        "заместитель начальника"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is in charge of an organization or a department and has authority over other employees.",
                        "zh": "负责管理组织或部门，并对下属拥有权力的领导者。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boss",
                                "target_lang_sense_clarification": "The most common general term for a supervisor or person in charge"
                            },
                            {
                                "target_lang_word": "head",
                                "target_lang_sense_clarification": "Used for the leader of a specific department or unit (e.g., head of sales)"
                            },
                            {
                                "target_lang_word": "chief",
                                "target_lang_sense_clarification": "Often used in official titles (e.g., police chief) or for the leader of a service"
                            },
                            {
                                "target_lang_word": "superior",
                                "target_lang_sense_clarification": "A formal term referring to someone of higher rank"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上司",
                                "target_lang_sense_clarification": "指职场中直接管理你的领导，最通用的称呼。"
                            },
                            {
                                "target_lang_word": "老板",
                                "target_lang_sense_clarification": "指企业主或雇主，口语中也常泛指上级。"
                            },
                            {
                                "target_lang_word": "主管",
                                "target_lang_sense_clarification": "指负责特定部门或业务的负责人。"
                            },
                            {
                                "target_lang_word": "领导",
                                "target_lang_sense_clarification": "正式且通用的称呼，指担任领导职务的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f85f7dc-33df-3913-bca7-9f649c5e6e53",
                    "sense_definition": "Жаргонное обращение к работнику правоохранительных органов или представителю власти.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Гражданин <w>начальник</w>, я не совершал этого преступления.",
                            "target_lang_translations": {
                                "en": "Citizen <w>chief</w>, I didn't commit this crime.",
                                "zh": "<w>警官</w>同志，我没有犯下这起罪行。"
                            }
                        },
                        {
                            "text": "Послушай, <w>начальник</w>, дай мне позвонить адвокату.",
                            "target_lang_translations": {
                                "en": "Listen, <w>chief</w>, let me call my lawyer.",
                                "zh": "听着，<w>长官</w>，让我给律师打个电话。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "гражданин начальник"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "криминальный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A slang term of address used to speak to a police officer, prison guard, or person in authority.",
                        "zh": "对警察、狱警或执法人员的俚语称呼。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chief",
                                "target_lang_sense_clarification": "Common slang address to an authority figure"
                            },
                            {
                                "target_lang_word": "boss",
                                "target_lang_sense_clarification": "Informal address often used to show compliance or respect"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "警官",
                                "target_lang_sense_clarification": "对警察的正式称呼，在俚语语境下带有讽刺或顺从意味。"
                            },
                            {
                                "target_lang_word": "长官",
                                "target_lang_sense_clarification": "对执法人员或军警的称呼，常用于电影或犯罪语境。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}