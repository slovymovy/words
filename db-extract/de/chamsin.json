                "senses": [
                    {
                        "sense_id": "e9ee5801-c869-318e-b33a-6ade6ce67396",
                        "entry_id": "4c4033b4-0ce5-3198-997e-3731c45fa319",
                        "glosses": [
                            "in der ägyptischen Wüste vorkommender trockenheißer Sandwind"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "5b004df2-36cb-4354-8404-c3046d8a1ae6",
                                "sense_id": "e9ee5801-c869-318e-b33a-6ade6ce67396",
                                "text": "„Hier sind Chamsine, wo anders tropisches Klima, Europa voll von Judenhaß, Schweden, Norwegen und solche Länder, die im Augenblick davon noch einigermaßen frei zu sein scheinen, verschlossen.“"
                            },
                            {
                                "example_id": "fc2d3cc7-3148-443c-8da8-fb1a3e059a15",
                                "sense_id": "e9ee5801-c869-318e-b33a-6ade6ce67396",
                                "text": "„Es wird behauptet, dass ein Mann, der nach fünf Tagen unablässig wütenden Chamsins seine Frau umbrachte, im Osmanischen Reich straffrei ausging.“"
                            },
                            {
                                "example_id": "a69200c3-4bfb-4667-9113-b4237082bb62",
                                "sense_id": "e9ee5801-c869-318e-b33a-6ade6ce67396",
                                "text": "„Aber der Chamsin kam gewöhnlich im Frühling, und noch war Winter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "492c53db-26a1-44d6-a0bd-da3fa25d50ef",
                        "source_entry_id": "4c4033b4-0ce5-3198-997e-3731c45fa319",
                        "source_sense_id": "e9ee5801-c869-318e-b33a-6ade6ce67396",
                        "source_sense_description": "fachsprachlich (Geografie, Meteorologie): in der ägyptischen Wüste vorkommender trockenheißer Sandwind",
                        "target_lang_word": "khamsin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "khamsin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d5585b5-8d9f-3b95-acef-550dcd94e3d6",
                                        "entry_id": "5639cc8f-2175-3a6b-a5fe-884304bf77ee",
                                        "glosses": [
                                            "A hot, dry wind, common in Egypt, Sudan and the Levant towards the end of March and April, which blows (for about 50 days each year) from the desert, bringing with it hot weather and sand / sandstorms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f204ac32-a4a4-4f8e-a21d-a49787aab470",
                                                "sense_id": "5d5585b5-8d9f-3b95-acef-550dcd94e3d6",
                                                "text": "That second spring the khamseen was worse than I have ever known it before or since."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95b236b3-b026-41ae-9709-3c86e39976fe",
                        "source_entry_id": "4c4033b4-0ce5-3198-997e-3731c45fa319",
                        "source_sense_id": "e9ee5801-c869-318e-b33a-6ade6ce67396",
                        "source_sense_description": "fachsprachlich (Geografie, Meteorologie): in der ägyptischen Wüste vorkommender trockenheißer Sandwind",
                        "target_lang_word": "chamsin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chamsin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef70d666-b067-3391-bc91-dc9337899330",
                                        "entry_id": "4ba1e414-c40a-37e7-a279-a7a7ba2f3fd1",
                                        "glosses": [
                                            "Vent d’Égypte qui souffle pendant cinquante jours, vingt-cinq jours avant l’équinoxe du printemps et autant après."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b56e9f7-b26d-4cc3-9b2a-406aded74a3d",
                                                "sense_id": "ef70d666-b067-3391-bc91-dc9337899330",
                                                "text": "L'armée de Cambyse et la caravane de 2,000 hommes qui furent, dit-on, engloutis (ce dernier accident est de 1805), périrent peut-être victimes du chamsin ou, de la soif; ensuite le sable recouvrit les cadavres, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "851152c9-f594-4477-9e9c-04f1a21ff551",
                        "source_entry_id": "4c4033b4-0ce5-3198-997e-3731c45fa319",
                        "source_sense_id": "e9ee5801-c869-318e-b33a-6ade6ce67396",
                        "source_sense_description": "fachsprachlich (Geografie, Meteorologie): in der ägyptischen Wüste vorkommender trockenheißer Sandwind",
                        "target_lang_word": "khamsin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "khamsin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4670daf7-6b70-3028-8657-c6d5249046ff",
                                        "entry_id": "9f9a1501-d472-3e80-b454-242b04ef0b2a",
                                        "glosses": [
                                            "Variante de chamsin."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c4f1d26-6982-47b2-9eb7-b42862783a87",
                                                "sense_id": "4670daf7-6b70-3028-8657-c6d5249046ff",
                                                "text": "Parmi les vents qui règnent en Égypte il faut d’abord nommer le khamsin."
                                            },
                                            {
                                                "example_id": "4e6fb95f-4174-4ad1-ba1f-c6e964c666a7",
                                                "sense_id": "4670daf7-6b70-3028-8657-c6d5249046ff",
                                                "text": "Depuis trois jours à peine j'avais quitté le Kaire, lorsque s'éleva un vent violent de khamsin qui nous arrêta net."
                                            },
                                            {
                                                "example_id": "1bf8ce4f-0343-4a84-82de-4764e5bd1e91",
                                                "sense_id": "4670daf7-6b70-3028-8657-c6d5249046ff",
                                                "text": "Malheur à qui rencontre le khamsin, honneur à qui l’affronte, et gloire à qui l’écrase."
                                            },
                                            {
                                                "example_id": "c2f1b636-1f71-41b2-bf3c-129e5ec121ba",
                                                "sense_id": "4670daf7-6b70-3028-8657-c6d5249046ff",
                                                "text": "Il fut soumis aux ouragans, aux aquilons, au mistral glacial, au brûlant khamsin, au tourbillonnant sirocco."
                                            },
                                            {
                                                "example_id": "8b9116dc-2715-4805-a62d-1f3e39c6f134",
                                                "sense_id": "4670daf7-6b70-3028-8657-c6d5249046ff",
                                                "text": "À la demande de Frédéric, la grand-mère se mit à dépeindre Djibouti, le vent suffocant du khamsin, les vols de beaumarquets melba, la cuisson du riz skoudhanis à la bergamote, la route numéro 1 sur laquelle s’enfonçait dans les nuits sans lune la file de camions chargés des mystérieux containers du port, la cabane d’Arthur Rimbaud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
