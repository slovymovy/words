                                        "glosses": [
                                            "Lacking tact or taste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88eb75d-4abf-4b84-b61a-a690af493d45",
                                                "sense_id": "db056d25-12d7-30e2-b3e7-9a4f73a28e80",
                                                "text": "At first, there’s something almost disconcertingly crude about the sasquatch skins."
                                            },
                                            {
                                                "example_id": "2f8d409f-15f5-4726-9f58-c38f5390cf54",
                                                "sense_id": "db056d25-12d7-30e2-b3e7-9a4f73a28e80",
                                                "text": "a crude remark"
                                            },
                                            {
                                                "example_id": "e3e78aff-e97e-4b50-9780-139decb3d559",
                                                "sense_id": "db056d25-12d7-30e2-b3e7-9a4f73a28e80",
                                                "text": "You shouldn't use such crude language when talking to the bank manager."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71582a9b-4e1e-3e0b-bbcf-46816bf77214",
                                        "entry_id": "8894246b-0f68-3cc2-83b9-ecd3c987422c",
