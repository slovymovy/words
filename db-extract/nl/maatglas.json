                "senses": [
                    {
                        "sense_id": "d72ea039-6e98-3842-8227-0d83c1c93f2d",
                        "entry_id": "b8c3cbed-d5c2-382e-8948-a6d99a6768fa",
                        "glosses": [
                            "een glazen vat of beker waarin men een hoeveelheid vloeistof kan afmeten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5458084e-83c5-478e-824f-83a688a41aa8",
                                "sense_id": "d72ea039-6e98-3842-8227-0d83c1c93f2d",
                                "text": "Fluorescerend roze is de vloeistof in het maatglas dat Philips-onderzoeker Sander Langereis omhoog houdt. Minuscule vetbolletjes drijven erin rond, met daarin verpakt het kankermedicijn doxorubicine."
                            },
                            {
                                "example_id": "3ea291fb-937d-4ea4-95fa-85eaac41221a",
                                "sense_id": "d72ea039-6e98-3842-8227-0d83c1c93f2d",
                                "text": "Een van de onderdelen van het programma is een korte cursus in het aflezen van meetinstrumenten. Er verschijnt dan een schuifmaat of een maatglas in beeld dat de leerling moet aflezen."
                            },
                            {
                                "example_id": "0f47cd71-f278-45f0-b680-4c7e7d38f835",
                                "sense_id": "d72ea039-6e98-3842-8227-0d83c1c93f2d",
                                "text": "De enige verwijzing naar het laboratorium is een maatglas dat als vaasje dient voor een roos."
                            }
                        ]
                    }
                ],
