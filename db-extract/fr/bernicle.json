                "senses": [
                    {
                        "sense_id": "7ec46b17-eb0f-3972-ae22-6ecc9d9d3277",
                        "entry_id": "ba0877e9-734a-3592-8a99-7f609ab123ff",
                        "glosses": [
                            "Variante de bernache, bernacle."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "ddaa89b6-56ad-4741-9cc4-0584d4d1b9b1",
                                "sense_id": "7ec46b17-eb0f-3972-ae22-6ecc9d9d3277",
                                "text": "Oh ! monsieur, nous mangeons des galettes de sarrasin et des bernicles que je détache des rochers."
                            },
                            {
                                "example_id": "ff34c5e2-06bd-4285-a1b2-0f0e288f1f17",
                                "sense_id": "7ec46b17-eb0f-3972-ae22-6ecc9d9d3277",
                                "text": "Les appâts qu'on fait avec les coquillages sont en grand nombre; il y a le petaut ou la folade, le bredin ou brelin, ou bernicle, ou lappe. Le petaut, ou la folade tirée de sa coquille, garnit un hameçon : c'est le moin. dre des appâts frais."
                            },
                            {
                                "example_id": "8b1226a0-d0c7-4228-81cc-33b7bb3dd962",
                                "sense_id": "7ec46b17-eb0f-3972-ae22-6ecc9d9d3277",
                                "text": "Il était très grand et très maigre, et j’imaginais que son nombril était collé comme une bernicle sur la face interne de sa colonne vertébrale."
                            }
                        ]
                    }
                ],
