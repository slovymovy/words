        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33a7508a-1c1f-3679-b472-eddf4dab7656",
                    "sense_definition": "Personne réputée pour pratiquer la magie et accomplir des enchantements.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les contes médiévaux, un vieil <w>enchanteur</w> aide souvent les chevaliers perdus."
                        },
                        {
                            "text": "L'<w>enchanteur</w> prépare une potion mystérieuse au fond de sa tour sombre."
                        }
                    ],
                    "synonyms": [
                        "magicien",
                        "sorcier",
                        "mage"
                    ]
                },
                {
                    "sense_id": "20b9e0a6-ec95-3023-8df1-97613680b665",
                    "sense_definition": "Personne qui subjugue ou séduit les autres par son charme, ses manières ou son éloquence.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "seduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet orateur talentueux est un véritable <w>enchanteur</w> capable de captiver n'importe quel public."
                        },
                        {
                            "text": "Elle se comportait en séductrice et agissait comme une <w>enchanteresse</w> avec ses admirateurs."
                        }
                    ],
                    "synonyms": [
                        "charmeur",
                        "séducteur"
                    ]
                },
                {
                    "sense_id": "466b6da3-6ab6-3b0f-ae84-6b15c8e92b5e",
                    "sense_definition": "Personne dotée d'une créativité ou d'une ingéniosité si remarquable qu'elle semble accomplir des miracles.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "talent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet inventeur génial est considéré comme un <w>enchanteur</w> de la technologie moderne."
                        },
                        {
                            "text": "Le peintre travaillait avec une telle virtuosité qu'on le prenait pour un <w>enchanteur</w>."
                        }
                    ],
                    "synonyms": [
                        "virtuose"
                    ]
                }
            ]
        }
