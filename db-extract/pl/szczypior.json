                    {
                        "translation_id": "2e0f0d60-72a8-4edc-8a93-b5709347d980",
                        "source_entry_id": "473df797-2dec-3dc1-a3c1-36a1f1f1e6b7",
                        "source_sense_id": "a525d173-a0cc-3028-9743-0dd275e6c53b",
