                        "sense_id": "584c78aa-ead1-3215-9a62-e039677bef26",
                        "entry_id": "6d454e35-7fcb-3210-ac27-7f59d8646c64",
                        "glosses": [
                            "Jeune fille qui défile en musique, habillée d'un costume de parade, et en manipulant une canne de tambour-major."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc32e33c-c63c-4fad-adc9-0efcb2241d93",
                                "sense_id": "584c78aa-ead1-3215-9a62-e039677bef26",
                                "text": "Les majorettes sont regroupées au sein d'associations, et défilent à l'occasion de fêtes publiques."
                            },
                            {
                                "example_id": "3baf9174-7afe-407f-87f4-1356b909ea9c",
                                "sense_id": "584c78aa-ead1-3215-9a62-e039677bef26",
                                "text": "À la table d’à côté, Rozalie Vandermuch, surnommée « Pom Pom Girl » en souvenir de ses prestations de majorette, il y avait quarante ans et des poussières."
                            }
                        ]
                    }
                ],
