                        "examples": [
                            {
                                "example_id": "a20d2e06-0989-45b5-a3f6-a757492f0a66",
                                "sense_id": "049046e3-e472-3502-9afb-3e73c1e9f684",
                                "text": "Le père n'est pas fréquentable: mieux vaut que les enfants ne le voient plus."
                            },
                            {
                                "example_id": "ea30f01c-7cc4-47c7-a2cf-84fbc75793ef",
                                "sense_id": "049046e3-e472-3502-9afb-3e73c1e9f684",
                                "text": "Mon innocence ainsi établie, je redevins un homme fréquentable."
                            },
                            {
                                "example_id": "3fcf8121-9342-4a92-a84e-63f992ff7077",
                                "sense_id": "049046e3-e472-3502-9afb-3e73c1e9f684",
                                "text": "Mais attention : nietzschéisme fréquentable, nietzschéisme de bon aloi, et tout de marketing bien verni."
                            }
                        ]
                    }
