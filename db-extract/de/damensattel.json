                "senses": [
                    {
                        "sense_id": "f5892d82-fb65-365a-963c-c3b2c4c0bdfe",
                        "entry_id": "1e554394-e772-363d-8849-00f068557a77",
                        "glosses": [
                            "Reitsattel, der speziell für Frauen ausgelegt ist, die im Damensitz reiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51b5c7e8-8a76-459e-9593-ed7eefb9dbb4",
                                "sense_id": "f5892d82-fb65-365a-963c-c3b2c4c0bdfe",
                                "text": "Damensättel sind heute ungebräuchlich, da Frauen zum Reiten ebenfalls Hosen tragen."
                            },
                            {
                                "example_id": "29c18772-231e-4330-881e-755524d12c1f",
                                "sense_id": "f5892d82-fb65-365a-963c-c3b2c4c0bdfe",
                                "text": "„Ein Stalljunge in einer drabfarbenen Velvetjacke hielt zwei von den Pferden, während ein Groom in Zylinder und weißer Lederhose das dritte Pferd, das mit dem Damensattel, andächtig bewachte.“"
                            },
                            {
                                "example_id": "fa71b073-9135-431c-a7e5-cc311b9ba186",
                                "sense_id": "f5892d82-fb65-365a-963c-c3b2c4c0bdfe",
                                "text": "„Jones war indesen ebenfalls aufgestiegen, und Brown schwang sich gerade in den Sattel, als der Mulatte noch zwei andere Pferde, und zwar eins mit einem Damensattel belegt, herausführte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3dece54d-5587-359d-a559-a24ebbdae561",
                        "entry_id": "1e554394-e772-363d-8849-00f068557a77",
                        "glosses": [
                            "speziell auf Frauen ausgelegter Fahrradsattel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf2e617a-9da9-4866-aba2-0ab86bf63dba",
                                "sense_id": "3dece54d-5587-359d-a559-a24ebbdae561",
                                "text": "Damensättel sind in der Regel breiter als Herrensättel."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
