                        "target_lang_word": "Zitronenfalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zitronenfalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd1ae363-dcbc-3b78-b530-e7860cb94acb",
                                        "entry_id": "2d101f9c-f19e-3a89-a8fa-841f4769b881",
                                        "glosses": [
                                            "Schmetterling der Art Gonepteryx rhamni aus der Familie der Weißlinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c00f97e1-ba33-46d7-a28f-0b75681e87c4",
                                                "sense_id": "fd1ae363-dcbc-3b78-b530-e7860cb94acb",
                                                "text": "„Die ersten Zitronenfalter wiegten sich in der warmen Luft“"
                                            },
                                            {
                                                "example_id": "1da86813-8182-4a2d-aca0-c33e8043a178",
                                                "sense_id": "fd1ae363-dcbc-3b78-b530-e7860cb94acb",
                                                "text": "„Sie lebt dann in einer Traumwelt, die nichts mit der Wirklichkeit zu tun hat, und ist leicht und schwerelos, und ich würde mich nicht wundern, wenn die Zitronenfalter, die überall herumspielen, sich ihr auf die Schulter setzten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adab4d3f-9c15-4828-a2b8-903a5514f606",
                        "source_entry_id": "4b2fa983-be14-3ec4-810d-b1da29b900f2",
                        "source_sense_id": "bbac0020-7dd6-374a-8629-22cb492ac087",
                        "source_sense_description": "dagvlinder van de Pieridaefamilie",
                        "target_lang_word": "brimstone butterfly",
