                "senses": [
                    {
                        "sense_id": "54154466-c154-3f7b-a1c3-eb120a68c303",
                        "entry_id": "0f3f4146-55c1-3f1f-b26c-fb96d12a40da",
                        "glosses": [
                            "Culture du café."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "643ec539-fd00-4a72-beda-52ce7eea29f9",
                                "sense_id": "54154466-c154-3f7b-a1c3-eb120a68c303",
                                "text": "La crise du café a étranglé les petits producteurs qui assurent 70 % de la caféiculture dans le monde sur des parcelles de moins de 10 hectares."
                            },
                            {
                                "example_id": "2ac5c9fb-f4c2-4ebf-8083-91cf731faad7",
                                "sense_id": "54154466-c154-3f7b-a1c3-eb120a68c303",
                                "text": "L’expansion de la caféiculture paysanne, confirmée au terme des campagnes de 1933 à 1935, puis brutalement interrompue en 1938, connut donc un nouvel élan après la guerre."
                            },
                            {
                                "example_id": "ca91a017-af46-4566-b9b0-46f5ed9e66ef",
                                "sense_id": "54154466-c154-3f7b-a1c3-eb120a68c303",
                                "text": "L’expansion de la caféiculture, par exemple, stabilise la forêt subsempervirente et bloque son recul."
                            }
                        ]
                    }
                ],
