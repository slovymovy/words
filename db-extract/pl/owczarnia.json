                        ],
                        "examples": [
                            {
                                "example_id": "d39476fb-bab6-49f5-93b8-a96afafa7516",
                                "sense_id": "145eab4b-769e-3151-9285-bb32ca2446da",
                                "text": "Tradycyjnie owczarnia służyła jako miejsce całodobowego pobytu owiec tylko w zimie"
