                ],
                "senses": [
                    {
                        "sense_id": "5d62c238-ad12-38e7-afd4-0dda7a8baf4b",
                        "entry_id": "58b18305-a36c-3eb8-bb85-1922c454b7c1",
                        "glosses": [
                            "flacher größerer Bereich auf der dem Wasser zugewandten Seite eines Deiches (einem Damm an Gewässern zum Schutz vor Sturmfluten und Hochwasser)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b0305ee-482b-45b7-8bfb-0f727556308b",
                                "sense_id": "5d62c238-ad12-38e7-afd4-0dda7a8baf4b",
                                "text": "„Heutiger Küstenschutz an der flachen Nordseeküste besteht aus mehreren Ebenen. Das Deichvorland nimmt dem Meer bereits einiges an Kraft, mit dem es auf den Deich treffen kann.“"
                            },
                            {
                                "example_id": "2c961cdc-f9a3-485f-aa15-8860d06e666b",
                                "sense_id": "5d62c238-ad12-38e7-afd4-0dda7a8baf4b",
                                "text": "„Im Deichvorland einiger stromabwärts gelegener Regionen wurden nach der Hochwasserwelle von 2002 hohe Konzentrationen des „Supergiftes“ Dioxin gemessen, die diese Flächen längerfristig kontaminieren dürften.“"
                            },
                            {
                                "example_id": "416bcbea-befe-4061-8a21-607fbd173dc3",
                                "sense_id": "5d62c238-ad12-38e7-afd4-0dda7a8baf4b",
                                "text": "[Sturmflut an der deutschen Nordseeküste 2006:] „Menschen kamen nicht ums Leben. Nahe Norden wurden Rinder gerade noch rechtzeitig aus dem außendeichs gelegenen Deichvorland evakuiert.“"
                            },
                            {
                                "example_id": "c9a4ce81-1d1f-4d07-9ed7-26a5aa825e9f",
                                "sense_id": "5d62c238-ad12-38e7-afd4-0dda7a8baf4b",
                                "text": "„Per Rettungshubschrauber wurden zwei Menschen bei Westerhever gerettet. Sie waren, nachdem sie im Deichvorland vom Wasser eingeschlossen wurden, von einer Brücke zum Leuchtturm gewatet, wo sie gerettet wurden.“"
                            },
                            {
                                "example_id": "f9a0be3b-247a-4b81-8a04-1cbf1742f2c0",
                                "sense_id": "5d62c238-ad12-38e7-afd4-0dda7a8baf4b",
                                "text": "„Weil Gänse im Winter das Gras im Deichvorland fressen, können Schafe und Lämmer laut dem Landesverband schleswig-holsteinischer Schaf- und Ziegenzüchter an der Westküste aktuell noch nicht auf die Weide. Das Gras ist zu kurz für sie.“"
                            },
                            {
                                "example_id": "dfb01ba7-0da1-4533-8119-7750c08f64e4",
                                "sense_id": "5d62c238-ad12-38e7-afd4-0dda7a8baf4b",
                                "text": "„Bei Aufräumarbeiten im Deichvorland von Hilgenriedersiel (Landkreis Aurich) haben Arbeiter einen Seesack mit 25 Kilogramm Kokain gefunden, wie die Polizei in Aurich am Freitag mitteilte. Die Herkunft ist unklar.“"
                            },
                            {
                                "example_id": "7d737dc3-9f50-4673-96ab-04bb6da3406c",
                                "sense_id": "5d62c238-ad12-38e7-afd4-0dda7a8baf4b",
                                "text": "„Vom Sönke-Nissen-Koog führt der vier Kilometer lange Weg durchs sattgrüne Deichvorland hinaus bis auf die Hamburger Hallig. Die stundenlange Wanderung in der weiten Natur der Salzwiesen lenkt ab von Hektik und Stress und ist ein ganz besonderes Erlebnis.“"
                            },
                            {
                                "example_id": "4717f72a-438c-476a-8bfc-aee15f0abe5c",
                                "sense_id": "5d62c238-ad12-38e7-afd4-0dda7a8baf4b",
                                "text": "[Riesige Containerschiffe] „Steinbefestigungen werden herausgeschwemmt und eigens aufgespülte Wattflächen um bis zu 15 Meter pro Jahr abgetragen, wie Torsten Heitsch vom Hadelner Deich- und Uferbauverband berichtet: »Wenn das so weitergeht, ist das Deichvorland irgendwann weg.«“"
                            },
                            {
                                "example_id": "3198377d-518d-4f37-9eb9-78c173d98219",
                                "sense_id": "5d62c238-ad12-38e7-afd4-0dda7a8baf4b",
                                "text": "„Der Leiter des Hamburger Wasserwirtschaftsamtes, Peter Haake, rechnete in niedersächsischen Elbabschnitten mit großflächigen Überschwemmungen im Deichvorland.“"
                            },
                            {
                                "example_id": "c180c7de-a4a8-4bb4-acd2-578c74f219d1",
                                "sense_id": "5d62c238-ad12-38e7-afd4-0dda7a8baf4b",
                                "text": "„Das Deichvorland zwischen Hahnöfersand und Mojenhörn wurde auf mehr als sechs Kilometern Länge durch einen teilweise vier Meter hohen und mehr als 25 Meter breiten Wall aus Trümmerschutt befestigt. Sozusagen Müllentsorgung und Küstenschutz in einem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
