                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "Many theologians continue to debate the timing and biblical basis of the <w>Rapture</w>."
                        },
                        {
                            "text": "According to this doctrine, the faithful will vanish during the sudden onset of the <w>Rapture</w>."
