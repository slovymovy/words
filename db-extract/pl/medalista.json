                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5007614a-2c9f-346c-8148-79eed3e79820",
                                        "entry_id": "b172d598-0612-366b-bcb0-716560468eb1",
                                        "glosses": [
                                            "An engraver, designer or maker of medals."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0321cc2-ebea-47cf-a2ed-9f751c5d8cad",
                                                "sense_id": "5007614a-2c9f-346c-8148-79eed3e79820",
                                                "text": "[A] skilled medalist and keen student of geography, Theophilus Lewis Barbauld had friends among the European intelligentsia and liberal nobility as well as potential patrons at the British court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8159c5ba-3862-3c05-9e5c-f925b155bc26",
                                        "entry_id": "b172d598-0612-366b-bcb0-716560468eb1",
                                        "glosses": [
                                            "Someone who has received a medal."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d192fc7-80a1-4d89-99f3-2404bc80a034",
                                                "sense_id": "8159c5ba-3862-3c05-9e5c-f925b155bc26",
                                                "text": "Mark Spitz set a record as an Olympic gold medalist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbef98d7-76d2-4f51-904d-de261f0c27b4",
                        "source_entry_id": "a192a23f-3a2b-33b4-afcc-2987f1c0c71a",
                        "source_sense_id": "3b8f6686-cecf-3098-b8af-b8a6f7c01079",
