                        "target_lang_word": "afsnijden door abscissie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "632f34b9-c5b3-48af-9c11-491c079e947a",
                        "source_entry_id": "147ec768-0726-3a56-b5c1-37285ff9250e",
                        "source_sense_description": "botany: shed off",
                        "target_lang_word": "afvallen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afvallen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31d8c3d8-cab7-34f9-99fa-847a82865b87",
                                        "entry_id": "80ee3c51-6bfb-31a5-986b-c02b56cbe578",
                                        "glosses": [
                                            "gewicht verliezen"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78c74fba-c7d1-4767-9c55-d740f0006814",
                                                "sense_id": "31d8c3d8-cab7-34f9-99fa-847a82865b87",
                                                "text": "De dikke man wilde in korte tijd veel afvallen."
                                            },
                                            {
                                                "example_id": "ecc331ec-f07e-4896-be29-a38885a26a6a",
                                                "sense_id": "31d8c3d8-cab7-34f9-99fa-847a82865b87",
                                                "text": "Het wemelde in de reclamewereld van de cocaïnedruppels tegen kiespijn, kruidendrankjes waar je van afviel, crèmes die je mooi maakten, ceintuurs die de geslachtsdrift herstelden, lampen die ervoor zorgden dat iemand verliefd op je werd, elektrische apparaten die hoofdpijn verminderden en batterijen die doofheid genazen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6e78480-7cdf-3c48-8d3d-249caad0cb52",
                                        "entry_id": "80ee3c51-6bfb-31a5-986b-c02b56cbe578",
                                        "glosses": [
                                            "de koers van een schip in de richting van de lijzijde wijzigen"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a14e3020-f557-4d7a-b911-997c8b61056d",
                                                "sense_id": "a6e78480-7cdf-3c48-8d3d-249caad0cb52",
                                                "text": "We gingen veel te scherp aan de wind, dus gaf de schipper bevel tot afvallen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2805a60c-d10b-319c-b3e5-3faa756bcd18",
                                        "entry_id": "80ee3c51-6bfb-31a5-986b-c02b56cbe578",
                                        "glosses": [
                                            "ontrouw worden aan zijn geloof"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43b7e562-f135-41a0-aef0-94dfb50f34a4",
                                                "sense_id": "2805a60c-d10b-319c-b3e5-3faa756bcd18",
                                                "text": "Nadat zijn vrouw was overleden, ondanks alle gebeden die hij gebeden had, is hij van zijn geloof afgevallen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3f50a14-4673-37f7-88cc-c2cc651c1106",
                                        "entry_id": "80ee3c51-6bfb-31a5-986b-c02b56cbe578",
                                        "glosses": [
                                            "vallen vanaf een hoger gelegen plek"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b658c12-97e2-495c-ade9-b2411e086c7a",
                                                "sense_id": "d3f50a14-4673-37f7-88cc-c2cc651c1106",
                                                "text": "Dat is een punt waar de heuvel plotseling ophoudt en steil naar beneden afvalt."
                                            },
                                            {
                                                "example_id": "6c8feaac-e086-4c64-978d-efdabf8fd2e2",
                                                "sense_id": "d3f50a14-4673-37f7-88cc-c2cc651c1106",
                                                "text": "Hij was bang dan zijn kinderen van het muurtje af zouden vallen het diepe ravijn in."
                                            },
                                            {
                                                "example_id": "dd0e3b2d-881f-47a4-8454-d7945277851c",
                                                "sense_id": "d3f50a14-4673-37f7-88cc-c2cc651c1106",
                                                "text": "Haar spieren deden bij elke beweging pijn en haar hoofd kon er elk moment afvallen of exploderen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a61c49c3-a90b-364c-abd7-88aa5aa2876c",
                                        "entry_id": "80ee3c51-6bfb-31a5-986b-c02b56cbe578",
                                        "glosses": [
                                            "niet meer meetellen, niet meer kunnen meedoen"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "385c6c28-c6f7-42af-abdc-0c74ac8ebfe2",
                                                "sense_id": "a61c49c3-a90b-364c-abd7-88aa5aa2876c",
                                                "text": "Vijf van de zes studenten zullen afvallen, want het is nu eenmaal een heel zware studie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96b94ee0-e94d-3c4d-8add-0e4b9726782f",
                                        "entry_id": "80ee3c51-6bfb-31a5-986b-c02b56cbe578",
                                        "glosses": [
                                            "elkaar niet meer steunen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20cc21d1-d138-42bf-a024-f6bd62d5dfea",
                                                "sense_id": "96b94ee0-e94d-3c4d-8add-0e4b9726782f",
                                                "text": "Ik wilde haar vader niet afvallen, ik wilde ons gezin niet veranderen, ik wilde dat alles gewoon zou zijn."
                                            },
                                            {
                                                "example_id": "1970a117-4118-45d6-960c-b5e7b986c3ef",
                                                "sense_id": "96b94ee0-e94d-3c4d-8add-0e4b9726782f",
                                                "text": "Neeltje staat perplex wanneer Jacob haar in zekere zin afvalt en het op een geestelijk probleem gooit."
                                            },
                                            {
                                                "example_id": "debb8482-5965-4517-b778-7bdde2f8b127",
                                                "sense_id": "96b94ee0-e94d-3c4d-8add-0e4b9726782f",
                                                "text": "Vader en moeder zullen elkaar nooit afvallen in tegenwoordigheid van vreemden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aff9c6b-7397-3a87-be33-aba7b25ce39a",
                                        "entry_id": "80ee3c51-6bfb-31a5-986b-c02b56cbe578",
                                        "glosses": [
                                            "verliezen, kwijtraken met name van zorgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df310ca-7b26-4b05-b992-e6181121566c",
                                                "sense_id": "1aff9c6b-7397-3a87-be33-aba7b25ce39a",
                                                "text": "Prachtige vogels lieten in het voorbijgaan hun melodieuze roep horen, en de schoonheid van het tafereel ontroerde me zo diep, dat alle zorgen over wat voor me lag van me afvielen en ik alleen maar kon genieten van die heerlijke morgen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
