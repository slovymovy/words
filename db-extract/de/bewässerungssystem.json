                "senses": [
                    {
                        "sense_id": "73b37811-235f-3061-a8d4-372ee5a24466",
                        "entry_id": "6961388e-d7dc-3341-acc0-e2bc6abcb663",
                        "glosses": [
                            "die Wasserversorgung des Kulturlandes"
                        ],
                        "tags": [
                            "Wasserwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "fa1cffac-55d8-479b-98d0-ac6302ffba03",
                                "sense_id": "73b37811-235f-3061-a8d4-372ee5a24466",
                                "text": "Das Bewässerungssystem ist dringend nötig gewesen, um die Pflanzen zu bewässern."
                            },
                            {
                                "example_id": "a06dac95-36c2-4f96-b487-eafb68f64ad4",
                                "sense_id": "73b37811-235f-3061-a8d4-372ee5a24466",
                                "text": "„Die beschäftigen sich ihr Leben lang mit diesem Bewässerungssystem, den Qanaten.“"
                            },
                            {
                                "example_id": "0ea6aca8-3f80-40e6-aa82-9443c8134af6",
                                "sense_id": "73b37811-235f-3061-a8d4-372ee5a24466",
                                "text": "„Im Punjab, der zum wichtigsten Teil ihrer Kolonie avancierte, erhofften sich die Briten von einem Ausbau des Bewässerungssystems eine hohe Rendite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
