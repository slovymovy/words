                        "glosses": [
                            "Économètre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "019b10bd-99fb-484f-8891-70d1f25998fa",
                                "sense_id": "d03a8498-6d92-3c50-b1e4-9b20e9117539",
                                "text": "Pour présenter une solution, l’économétricien doit faire appel à ses connaissances en économie, en mathématiques et en statistique."
                            },
                            {
                                "example_id": "4fe5a997-aaad-47f1-85e9-40a57025b27b",
                                "sense_id": "d03a8498-6d92-3c50-b1e4-9b20e9117539",
                                "text": "Un économétricien peut bien revêtir d’oripeaux mathématiques n’importe quelle erreur d’observation, il ne transformera pas cette erreur en vérité, même si ses raisonnements sont corrects au point de vue formel."
                            }
                        ]
                    }
                ],
