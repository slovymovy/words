                "senses": [
                    {
                        "sense_id": "f3448869-9229-354c-81b8-bef1b31e39a2",
                        "entry_id": "e9cd5ef1-45ca-368a-a228-897edf21e5b0",
                        "glosses": [
                            "Se traumatiser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3171ea48-2254-40ba-99a5-1ad1a57b1346",
                                "sense_id": "f3448869-9229-354c-81b8-bef1b31e39a2",
                                "text": "À voir pour s'amuser à faire un délire d'analyse ou pour s'auto-traumatiser à vie."
                            },
                            {
                                "example_id": "e21ab6ce-daa2-4c54-9819-2a5570b72ebf",
                                "sense_id": "f3448869-9229-354c-81b8-bef1b31e39a2",
                                "text": "Elle se rend pas compte qu'elle a 95 % de chances de se faire démonter par tout les frustrés du net, de faire le buzz et de s'auto-traumatiser ?"
                            },
                            {
                                "example_id": "95c0a6dc-2f7c-46fd-b84e-d7a42f34805e",
                                "sense_id": "f3448869-9229-354c-81b8-bef1b31e39a2",
                                "text": "Pas qu'ils soient bien hauts mais tout de même, ça serait malheureux de tomber et de s'auto-traumatiser de l'accrobranche pour la vie entière."
                            }
                        ]
                    }
