                "senses": [
                    {
                        "sense_id": "89f7b39f-0570-3696-868b-5eacf506c53c",
                        "entry_id": "c7d7140d-2a38-3fee-90c0-11155bdd98ac",
                        "glosses": [
                            "sportlicher Wettkampf, der in einer (Sport-)Halle ausgetragen wird und bei dem der beste Sportler oder die beste Mannschaft (in einer bestimmten Disziplin) den Meistertitel erhält"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ec279993-6f20-48b5-96e5-c24a4e8ba81b",
                                "sense_id": "89f7b39f-0570-3696-868b-5eacf506c53c",
                                "text": "„Er gewann bei den deutschen Hallenmeisterschaften in Leipzig über 60 Meter die Silbermedaille und erfüllte mit seiner neuen Bestzeit von 6,65 s die Norm für die Halleneuropameisterschaften in Paris.“"
                            },
                            {
                                "example_id": "4b4b8d60-bdb5-4363-bd85-f0b8ca9d703c",
                                "sense_id": "89f7b39f-0570-3696-868b-5eacf506c53c",
                                "text": "„2015 gewann sie mit 8,12 s über 60 Meter Hürden die niederländischen Hallenmeisterschaften.“"
                            },
                            {
                                "example_id": "b94ac7a1-7d7d-4d10-8a4e-b466b404efbc",
                                "sense_id": "89f7b39f-0570-3696-868b-5eacf506c53c",
                                "text": "„Bei den Deutschen Hallenmeisterschaften wurde er Vizemeister.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
