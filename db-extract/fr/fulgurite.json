                                "target_senses": [
                                    {
                                        "sense_id": "1821a54a-3928-3064-ad06-5e6d5fb788b1",
                                        "entry_id": "131a1500-5c8c-314c-b09c-fae91640310b",
                                        "glosses": [
                                            "durch Blitzeinschlag in Gestein oder Sand entstandene Röhre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7038028f-4d9a-466a-8fcc-9293b8861b05",
                                                "sense_id": "1821a54a-3928-3064-ad06-5e6d5fb788b1",
                                                "text": "„Die Tiere, die mit dem Jungen Nachtwache gehalten hatten, waren fort; ringsum waren nur die bizarren korallenförmigen Fulgurite in ihren versengten Furchen aus geschmolzenem Sand zu sehen, dort, wo nachts die Kugelblitze zischend und nach Scwefel stinkend über den Boden gehuscht waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
