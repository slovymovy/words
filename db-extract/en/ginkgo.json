                                        "entry_id": "ae106a6e-082b-3354-8284-f281478af789",
                                        "glosses": [
                                            "Variante de ginkgo."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1ab7382-6e56-4580-b9a9-9c21d277d1f6",
                                                "sense_id": "2a07eeb7-67a1-3d69-a1b8-c65570418e4c",
                                                "text": "Le gingko et les cycas ont des spermatozoïdes à cils vibratiles, comme les fougères."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a039031d-655b-4043-bbb7-f6cdc2bd7792",
                        "source_entry_id": "f07bb583-3e83-32c8-b066-44ac407936d5",
