                                "target_senses": [
                                    {
                                        "sense_id": "598dca9f-0113-35e9-a335-f37a865bc9d6",
                                        "entry_id": "29ab835e-a350-3709-9c76-dd3dbc062d7a",
                                        "glosses": [
                                            "Qui refuse obéissance à une autorité légitime ou établie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa50295c-6890-4aed-8f92-3f3f0f70fb2b",
                                                "sense_id": "598dca9f-0113-35e9-a335-f37a865bc9d6",
                                                "text": "Nous avons cherché à savoir pourquoi un peuple réputé rebelle vote à 64 % pour Jacques Chirac."
                                            },
                                            {
                                                "example_id": "f3b81ded-4542-4076-8ce3-e60d8445ccaa",
                                                "sense_id": "598dca9f-0113-35e9-a335-f37a865bc9d6",
                                                "text": "Pap Ndiaye serait venu seul, sans son aréopage de conseillers collés aux basques, qu’il n’aurait pas été davantage importuné : viennent traditionnellement à l’Ageem des professionnels plus investis que rebelles."
                                            },
                                            {
                                                "example_id": "40200171-2805-4e57-b2fd-28308ce059ed",
                                                "sense_id": "598dca9f-0113-35e9-a335-f37a865bc9d6",
                                                "text": "Vous vous sentez rebelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33200201-bf5a-35ba-9ef7-212afe4ba274",
                                        "entry_id": "29ab835e-a350-3709-9c76-dd3dbc062d7a",
                                        "glosses": [
                                            "Qui résiste à un effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e15698f-1fef-4cd1-b9af-a3b7a3b50ac0",
                                                "sense_id": "33200201-bf5a-35ba-9ef7-212afe4ba274",
                                                "text": "Une mèche de cheveux rebelle."
                                            },
                                            {
                                                "example_id": "b0c36c12-aaf5-4d5c-9e91-8eb757f7f6bf",
                                                "sense_id": "33200201-bf5a-35ba-9ef7-212afe4ba274",
                                                "text": "Une fièvre, une humeur, un ulcère, etc., rebelle aux remèdes, Une fièvre, une humeur, un ulcère, etc., qui ne cède point aux remèdes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "044ec303-d6fa-3a30-87db-f6570f127a72",
                                        "entry_id": "29ab835e-a350-3709-9c76-dd3dbc062d7a",
                                        "glosses": [
                                            "Qui est impropre à une chose, qui n’a pas de dispositions pour une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bbfdfa1-54d7-449a-9889-1879be544e50",
                                                "sense_id": "044ec303-d6fa-3a30-87db-f6570f127a72",
                                                "text": "Esprit rebelle à tout raisonnement."
                                            },
                                            {
                                                "example_id": "8c9d0bf2-d30d-4aaf-8ed4-b98ccb0b2a2c",
                                                "sense_id": "044ec303-d6fa-3a30-87db-f6570f127a72",
                                                "text": "Rebelle à la musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2b82ec-6ba5-367a-8ee0-d31621be6b83",
                                        "entry_id": "29ab835e-a350-3709-9c76-dd3dbc062d7a",
                                        "glosses": [
                                            "Qui ne peut pas se traiter ou ne peut se traiter que fort difficilement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c71f743f-0b7d-4ea2-8bac-e2e40b903fcd",
                                                "sense_id": "ab2b82ec-6ba5-367a-8ee0-d31621be6b83",
                                                "text": "Un sujet, une matière rebelle à la poésie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b261bd89-3230-33bb-b3d4-d4d0f9d4a5bc",
                                        "entry_id": "29ab835e-a350-3709-9c76-dd3dbc062d7a",
                                        "glosses": [
                                            "Qui résiste à toute forme de traitement connu, en parlant d’une maladie ou d’une douleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0d0118-73e1-4907-83db-ff3f1047e56a",
                                                "sense_id": "b261bd89-3230-33bb-b3d4-d4d0f9d4a5bc",
                                                "text": "Une céphalée rebelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fa35d4f-1e66-3d73-a187-5408a27506d3",
