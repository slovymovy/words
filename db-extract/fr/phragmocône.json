                                "example_id": "8d97d768-8741-419f-ad69-b150a55baba2",
                                "sense_id": "0057900f-aef6-3890-b49b-4660606f1e6e",
                                "text": "Le phragmocône se compose d’un cône emboîté dans l’alvéole du rostre."
                            },
                            {
                                "example_id": "607891a3-b742-44f6-bbe5-ee6161b6e892",
                                "sense_id": "0057900f-aef6-3890-b49b-4660606f1e6e",
                                "text": "Le phragmocône se termine par une petite loge (loge initiale ou ovisac) globuleuse."
                            },
                            {
                                "example_id": "7400ccf5-2064-472d-b252-8e97c830b720",
                                "sense_id": "0057900f-aef6-3890-b49b-4660606f1e6e",
                                "text": "Les assises du lias et du système colithique inférieur surtout sont quelquefois criblées de leurs débris ; mais, presque toujours aussi, les parties minces et feuilletées de la plume et même le phragmocône sont absents."
                            }
                        ]
