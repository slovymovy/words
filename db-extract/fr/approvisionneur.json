                                "example_id": "12035be6-7eac-4387-91cf-0cb2d005ad72",
                                "sense_id": "faa2aa99-cfcd-3780-9f40-76a88f9fb787",
                                "text": "Pilletrousse était le boucher de la société ; Heinrich et Frantz, les approvisionneurs, achetaient et tuaient l'animal, quel qu'il fût."
                            },
                            {
                                "example_id": "7ab2df3e-9aad-465f-a6e4-2f433f9d2051",
                                "sense_id": "faa2aa99-cfcd-3780-9f40-76a88f9fb787",
                                "text": "Ce qu’un approvisionneur attend d’une chaîne logistique est avant tout, de la fiabilité, de la réactivité et de la flexibilité."
                            }
                        ]
                    }
