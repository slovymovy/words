                "senses": [
                    {
                        "sense_id": "8d84a292-d2b5-399d-9cab-d5a597d9b50a",
                        "entry_id": "1e13c625-64ee-37f1-8a27-d0792c70ad06",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным жульничество"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a97e2475-1e81-46cb-992a-afe4d3aace9e",
                                "sense_id": "8d84a292-d2b5-399d-9cab-d5a597d9b50a",
                                "text": "Не пора ли оставить эту бессердечную и жульническую игру словами, эту политическую риторику, эти литературные пошлости?"
                            }
                        ]
                    },
                    {
                        "sense_id": "728e3fe5-d813-3be2-9ace-af82a21eed40",
                        "entry_id": "1e13c625-64ee-37f1-8a27-d0792c70ad06",
                        "glosses": [
                            "свойственный жулику, характерный для него; недобросовестный, обманный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4940491b-c84a-4469-870e-0bc865d75e6f",
                                "sense_id": "728e3fe5-d813-3be2-9ace-af82a21eed40",
                                "text": "Не перетолковывай ты мои честные слова на жульнический манер!"
                            },
                            {
                                "example_id": "7b82d869-9509-47a4-8093-dc6d6820bad6",
                                "sense_id": "728e3fe5-d813-3be2-9ace-af82a21eed40",
                                "text": "Одет щеголевато. Лицо жульническое. Выражение на лице: «готовый к услугам»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a0fe3b5-ec1d-4a19-a67c-0260ffd65918",
                        "source_entry_id": "1e13c625-64ee-37f1-8a27-d0792c70ad06",
                        "target_lang_word": "betrügerisch",
                        "target_lang_code": "de",
