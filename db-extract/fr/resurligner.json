                "senses": [
                    {
                        "sense_id": "2c425f67-aaea-3741-a58f-735cd17f06f2",
                        "entry_id": "de76cca3-adff-3b45-a19a-7678b431562a",
                        "glosses": [
                            "Surligner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d99572a-c093-40a9-807e-3e921efa60d7",
                                "sense_id": "2c425f67-aaea-3741-a58f-735cd17f06f2",
                                "text": "Je n'ai pas voté pour elle mais ça me faisait quand mëme chier de voir les médias lui casser les pattes, surligner et resurligner ses lacunes pour la forcer à se remettre en question..."
                            },
                            {
                                "example_id": "289f0ae6-c341-4634-980f-0a6905da6309",
                                "sense_id": "2c425f67-aaea-3741-a58f-735cd17f06f2",
                                "text": "Je suis obligée de resurligner et coloriser manuellement à chaque changement."
                            },
                            {
                                "example_id": "e344c958-950f-4ddb-a7d0-5df3396238cf",
                                "sense_id": "2c425f67-aaea-3741-a58f-735cd17f06f2",
                                "text": "Si vous débordez de votre zone de sélection lorsque vous la peignez en blanc, ce n'est pas grave ; il vous suffira de repeindre en noir ce qui a débordé pour le resurligner en rouge et donc le désélectionner."
                            }
                        ]
                    }
