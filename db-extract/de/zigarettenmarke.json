                        "examples": [
                            {
                                "example_id": "abc866be-061d-4251-a80e-40ecbc18821f",
                                "sense_id": "777f378c-ca25-36a8-932a-4cde0a97664b",
                                "text": "„Leute dieses Schlages, die offenbar das Leben genossen und Vertrauen in die Zukunft hatten, bevölkerten auch eine Anzeigenserie für die nach einer britischen Rennbahn benannte Zigarettenmarke Ascot.“"
                            },
                            {
                                "example_id": "a0b653e1-f837-40de-a967-f0efe844f504",
                                "sense_id": "777f378c-ca25-36a8-932a-4cde0a97664b",
                                "text": "„Brown winkt nur ab und kehrt eine Minute später mit seiner eigenen Zigarettenmarke und einem Softpack Zigarren der Marke Backwoods zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
