                "senses": [
                    {
                        "sense_id": "3bbe08fe-b571-373d-8cdd-219975371b6d",
                        "entry_id": "5d867b92-da39-3bfb-a9a3-635e4e6773c0",
                        "glosses": [
                            "One who enforces."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "358e4803-fca1-334b-b4c7-a29ee6a5d3b9",
                        "entry_id": "5d867b92-da39-3bfb-a9a3-635e4e6773c0",
                        "glosses": [
                            "A hired strongman, especially working for the underworld."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de00b0ff-a0ec-4a43-b7c8-537b052033d9",
                                "sense_id": "358e4803-fca1-334b-b4c7-a29ee6a5d3b9",
                                "text": "At 199 centimetres and a hundred kilos going up, he was scary big and he found work as a bouncer and enforcer[.]"
                            }
                        ]
                    },
                    {
                        "sense_id": "cd367b63-d401-3e92-b82d-6a5b7690fc2d",
                        "entry_id": "5d867b92-da39-3bfb-a9a3-635e4e6773c0",
                        "glosses": [
                            "The member of a group, especially of a gang, charged with keeping dissident members obedient."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7ed830a8-d2cf-34d0-bc83-df9d5b1a5406",
                        "entry_id": "5d867b92-da39-3bfb-a9a3-635e4e6773c0",
                        "glosses": [
                            "A battering ram used by the emergency services for gaining access to locked premises."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dd4f7d48-2c32-3f76-9e0e-de4b886b1a67",
                        "entry_id": "5d867b92-da39-3bfb-a9a3-635e4e6773c0",
                        "glosses": [
                            "A player who physically intimidates or confronts the opposition."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b241940a-d53a-4b35-86b1-d4ee752bad17",
                        "source_entry_id": "5d867b92-da39-3bfb-a9a3-635e4e6773c0",
                        "source_sense_description": "one who enforces",
                        "target_lang_word": "exécuteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exécuteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f0b855e-3cff-33ce-9d51-e6f81a9dfeef",
                                        "entry_id": "756110f6-85b5-3290-9c5b-f25a5cbb88a9",
                                        "glosses": [
                                            "Qui exécute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9372fe2-e8af-4e5e-964e-e95e2db37be1",
                                                "sense_id": "0f0b855e-3cff-33ce-9d51-e6f81a9dfeef",
                                                "text": "La puissance exécutrice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exécuteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e4445c1-9b48-333a-b4b3-883745781fae",
                                        "entry_id": "a5facf4d-8e82-313d-b0ef-af1d7c8fdc36",
                                        "glosses": [
                                            "Celui qui exécute."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ab11a7-a12e-4ad3-bbef-0dfbccebcc71",
                                                "sense_id": "9e4445c1-9b48-333a-b4b3-883745781fae",
                                                "text": "Ainsi le comprenait l’orateur qui flétrissait, il y a trois ans, dans un premier discours, ceux qu'on appelle des vendus, et qui s'annonçait déjà comme l’exécuteur des épurations nécessaires."
                                            },
                                            {
                                                "example_id": "5a9a7abc-d6cb-4eb9-8411-1055e21f6227",
                                                "sense_id": "9e4445c1-9b48-333a-b4b3-883745781fae",
                                                "text": "Je ne veux rien être que le premier gentilhomme du royaume et l'exécuteur de vos désirs."
                                            },
                                            {
                                                "example_id": "2c0b4f15-5e50-464e-9f8f-f06b311cde1e",
                                                "sense_id": "9e4445c1-9b48-333a-b4b3-883745781fae",
                                                "text": "Pour un « niaquoué », S. M. l’Empereur Bao Dai n'est que l’exécutant des volontés françaises, l’exécuteur de nos plus basses œuvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a25edfc-5467-3216-8c14-fb12b41f7e7f",
                                        "entry_id": "a5facf4d-8e82-313d-b0ef-af1d7c8fdc36",
                                        "glosses": [
                                            "Personne qui exécute un condamné à la peine de mort."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7e70cb7-1c81-4f4c-b750-b149e7184388",
                                                "sense_id": "3a25edfc-5467-3216-8c14-fb12b41f7e7f",
                                                "text": "Le peuple poussa un long gémissement, et s’avança contre le bourreau : ce misérable, tout troublé, lui porta un second coup, qui ne fit encore que l’écorcher et l’abattre sur le théâtre, où l’exécuteur se roula sur lui pour l’achever."
                                            },
                                            {
                                                "example_id": "4928fe04-5918-44e3-bac4-415d46cc9a1a",
                                                "sense_id": "3a25edfc-5467-3216-8c14-fb12b41f7e7f",
                                                "text": "En sentant la main de l'exécuteur se poser sur son épaule pour arracher le mouchoir qui couvrait son cou, elle pâlit une seconde fois, …."
                                            },
                                            {
                                                "example_id": "c887a105-9767-4654-b708-622b37f980d9",
                                                "sense_id": "3a25edfc-5467-3216-8c14-fb12b41f7e7f",
                                                "text": "La guillotine avait été disloquée exprès par quelqu’un qui voulait nuire à l’exécuteur des hautes œuvres."
                                            },
                                            {
                                                "example_id": "0d95e973-3113-4487-a4e9-2dec8b8c7999",
                                                "sense_id": "3a25edfc-5467-3216-8c14-fb12b41f7e7f",
                                                "text": "L’un d’eux, d’aspect particulièrement féroce et assez semblable à l’exécuteur dans certains tableaux de la Renaissance qui figurent des supplices, s’avança vers lui d’un air implacable pour lui prendre ses affaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27137ad1-c651-4e0e-a0bf-51bd157b7099",
                        "source_entry_id": "5d867b92-da39-3bfb-a9a3-635e4e6773c0",
                        "source_sense_description": "member of a group charged with keeping dissident members obedient",
                        "target_lang_word": "homme de main",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homme de main",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21afadf0-4ab9-35c5-8bbd-0e8f53162326",
                                        "entry_id": "b3079a0b-b8ff-37c1-a0b2-f0f2c08b7415",
                                        "glosses": [
                                            "Homme d’exécution, homme brave, hardi, chargé d’exécuter les tâches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1652decf-503d-45a0-97cd-1cae146c5b80",
                                                "sense_id": "21afadf0-4ab9-35c5-8bbd-0e8f53162326",
                                                "text": "On sentait qu’il la surveillait comme un dompteur surveille la bête qu’il a dressée, attentif à ce qu’elle lui fasse honneur par sa parfaite obéissance, mais bien plus encore comme auprès d’un prince un garde du corps, auprès d’un chef de bande un homme de main surveille la prostituée qu’il est allé lui chercher dans la rue."
                                            },
                                            {
                                                "example_id": "dd2c2720-1678-4a24-9d15-6e22a0cb544a",
                                                "sense_id": "21afadf0-4ab9-35c5-8bbd-0e8f53162326",
                                                "text": "Même les hommes de main les plus serviles de Trump, le secrétaire d’État Mike Pompeo et le procureur général Bill Barr, ont pris leurs distances de ses insanités."
                                            },
                                            {
                                                "example_id": "33afe607-aeaa-4447-beec-f0ced56ff9ec",
                                                "sense_id": "21afadf0-4ab9-35c5-8bbd-0e8f53162326",
                                                "text": "===== Synonymes =====",
                                                "translation": "sbire"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8a75249-c643-3fdb-b091-4bbf8cbb3d8d",
                                        "entry_id": "b3079a0b-b8ff-37c1-a0b2-f0f2c08b7415",
                                        "glosses": [
                                            "Tueur à gages, exécutant d’un projet criminel décidé par un commanditaire ou un chef de bande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e02efd79-20cc-4434-aea2-dd7a367e2b0f",
                                                "sense_id": "d8a75249-c643-3fdb-b091-4bbf8cbb3d8d",
                                                "text": "Marsaud avait immédiatement décelé chez Brezisky, les attributs du guerrier rompu, de l’homme de main sans état d’âme, capable d’accomplir les plus basses besognes, d’abattre le sale boulot sans rechigner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
