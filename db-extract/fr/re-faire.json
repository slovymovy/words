                    },
                    {
                        "form_id": "df61c5a1-c5e5-4589-a8fc-5fcf849666a4",
                        "entry_id": "90a9dbad-5108-3248-a298-476e45726b47",
                        "tags": [
                            "beaucoup plus courant"
                        ],
                        "form": "refaire"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2b0a1f3-5509-36f2-8d8d-0b4815fe6a64",
                        "entry_id": "90a9dbad-5108-3248-a298-476e45726b47",
                        "glosses": [
                            "Variante orthographique rare de refaire, utilisée pour mettre l’accent à la fois sur les deux parties du mot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57ae3dfc-309a-4f49-8d20-9c6472d5f8db",
                                "sense_id": "b2b0a1f3-5509-36f2-8d8d-0b4815fe6a64",
                                "text": "Nous ne pouvons pas les escamoter, car leur sous-marin, pour éviter d’être repéré, ne re-fera surface qu’à deux heures précises."
                            },
                            {
                                "example_id": "1fa3b7cd-5bcc-44b4-ae64-03a7435cfdaa",
                                "sense_id": "b2b0a1f3-5509-36f2-8d8d-0b4815fe6a64",
                                "text": "« Faire-mieux », c'est souvent « Re-faire », « faire différemment » et non forcément « faire plus »."
                            },
                            {
                                "example_id": "fb1ed3a0-de6c-4c24-9a6c-57bb63bb8502",
                                "sense_id": "b2b0a1f3-5509-36f2-8d8d-0b4815fe6a64",
                                "text": "Il ne reste plus qu’à faire et re-faire, produire et reproduire, créer et recréer, rivaliser et s’imiter."
                            },
                            {
                                "example_id": "8b598c9c-66b1-4a03-bc4f-2ac5a547ea58",
                                "sense_id": "b2b0a1f3-5509-36f2-8d8d-0b4815fe6a64",
                                "text": "Nous laisser faire et re-faire"
                            },
                            {
                                "example_id": "dde4ae31-7579-459e-ac6c-8786b660e420",
                                "sense_id": "b2b0a1f3-5509-36f2-8d8d-0b4815fe6a64",
                                "text": "Et elle me re-fait un sourire."
                            }
                        ]
                    }
                ],
