                                "example_id": "ebf1ce99-3fa6-439a-9101-d7a68573e5dc",
                                "sense_id": "06c1e630-d7f8-36c5-934c-742b1fe70dbc",
                                "text": "— On m’appelait bandit, sapré gredin ! — Sapré pour sacré ; — elle disait aussi, bouffre pour bougre."
                            },
                            {
                                "example_id": "af0cdf00-b6b3-4935-a36d-72e5cc28dd97",
                                "sense_id": "06c1e630-d7f8-36c5-934c-742b1fe70dbc",
                                "text": "Zut... Zut... et Bran!... Peste diable bouffre."
                            },
                            {
                                "example_id": "4cd1d67f-e131-4220-91ed-f28504f43b71",
                                "sense_id": "06c1e630-d7f8-36c5-934c-742b1fe70dbc",
                                "text": "- La haine d'instinct qu'elle portait à ce bouffre de capucin, comme elle disait, pour ne pas dire un autre mot qui lui semblait un gros péché..."
                            }
                        ]
