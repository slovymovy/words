                        "entry_id": "fb629e97-19f2-3f26-814d-47fa7b7e2bd4",
                        "glosses": [
                            "broadcaster, an organisation providing radio and/or television broadcasts",
                            "one of several membership-based non-governmental organizations, originally associated with a specific political and/or religious orientation, providing programming during allotted broadcasting times on national public radio and television channels, in lieu of a single public service broadcaster"
                        ],
                        "tags": [
