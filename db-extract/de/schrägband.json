                        "glosses": [
                            "diagonal zum Fadenverlauf geschnittener Stoffstreifen zum Abschluss zum Beispiel von Tischdecken"
                        ],
                        "tags": [
                            "Schneiderei"
                        ],
                        "examples": [
                            {
                                "example_id": "29f76bf7-d9af-434f-a7a4-fc5460fdc017",
                                "sense_id": "856fe24e-dcbc-33cc-8c3e-e3b9159323c8",
                                "text": "„Anstatt die Schnittkanten zu säumen, können Sie sie auch mit Schrägband dekorativ einfassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5b15cad0-0993-3f2e-b568-ccddfebdf01d",
                        "entry_id": "a2c8fa3e-033b-3eed-b0c3-e7f20711f61a",
                        "glosses": [
                            "Art der einfachen Verzierung in Holz, in der man Kerben nebeneinander setzt, die die Anmutung eines gedrehten Seils ergeben"
                        ],
                        "tags": [
                            "Zimmerei"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "636c9308-e88e-38c8-acab-6a4bd72a8a4c",
                        "entry_id": "a2c8fa3e-033b-3eed-b0c3-e7f20711f61a",
                        "glosses": [
                            "Querverbindung zwischen rechteckig verbundenen Teilen, die ein Verschieben dieser Teile zueinander verhindert, weil es sie fixiert"
                        ],
                        "tags": [
                            "Statik"
                        ],
                        "examples": [
                            {
                                "example_id": "6ce9d040-da4b-46b4-9594-d102c6ece437",
                                "sense_id": "636c9308-e88e-38c8-acab-6a4bd72a8a4c",
                                "text": "„Ist aber die Säule mit dem Rahmen durch ein Schrägband verbunden, so hört das Verschieben auf, weil dann eine Dreiecksverbindung entsteht und diese unverschiebbar ist.“"
                            }
                        ],
