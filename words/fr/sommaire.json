                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le compositeur a mis en forme le <w>sommaire</w> avec un alinéa négatif régulier."
