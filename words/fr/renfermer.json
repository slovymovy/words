                {
                    "sense_id": "6f727f60-cf37-3518-ac62-13428273541d",
                    "sense_definition": "Contenir ou comporter en soi des éléments matériels ou abstraits.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette boîte ancienne <w>renferme</w> de précieux souvenirs de famille."
                        },
                        {
                            "text": "Le sous-sol de cette région <w>renferme</w> d'importants gisements minéraux."
                        }
                    ],
                    "synonyms": [
                        "contenir",
                        "comprendre",
                        "englober",
                        "receler"
                    ],
                    "antonyms": [
                        "exclure"
                    ],
                    "common_phrases": [
