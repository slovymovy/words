                "senses": [
                    {
                        "sense_id": "41adea97-4769-3eeb-99c3-39bd42b0b44b",
                        "entry_id": "ecbb4b3a-3953-3c18-8833-7ec03eceb0fb",
                        "glosses": [
                            "в более низком положении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57919868-4513-4bb5-a939-cc32da4da0f2",
                                "sense_id": "41adea97-4769-3eeb-99c3-39bd42b0b44b",
                                "text": "— Но что ж делать? Что делать? — говорил он жалким голосом, сам не зная, что он говорит, и всё ниже и ниже опуская голову."
                            }
                        ]
                    },
                    {
                        "sense_id": "45e82ab0-fbd2-37f7-80a9-7c1ec045b3df",
                        "entry_id": "ecbb4b3a-3953-3c18-8833-7ec03eceb0fb",
                        "glosses": [
                            "книжн. далее по тексту"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "888dbb32-cbc4-47f9-92fe-d056597d6de7",
                                "sense_id": "45e82ab0-fbd2-37f7-80a9-7c1ec045b3df",
                                "text": "Ниже мы рассмотрим вопрос, кто должен проводить коммерческую проверку чистоты сделки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6b5bb1d-c0cf-42e9-836e-805ea0378735",
                        "source_entry_id": "ecbb4b3a-3953-3c18-8833-7ec03eceb0fb",
                        "target_lang_word": "below",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "below",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6dc836-7a00-391d-a9f9-c74434374bc5",
                                        "entry_id": "a195eb3c-f827-3352-8034-bd03458dece3",
                                        "glosses": [
                                            "Lower in spatial position than."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c9effc-b7e9-47e7-8810-23ee8d54fad9",
                                                "sense_id": "7a6dc836-7a00-391d-a9f9-c74434374bc5",
                                                "text": "One morning I had been driven to the precarious refuge afforded by the steps of the inn, after rejecting offers from the Celebrity to join him in a variety of amusements. But even here I was not free from interruption, for he was seated on a horse-block below me, playing with a fox terrier."
                                            },
                                            {
                                                "example_id": "7e974367-1da9-4414-a6e7-f5c505b7e80e",
                                                "sense_id": "7a6dc836-7a00-391d-a9f9-c74434374bc5",
                                                "text": "The treasure is buried two meters below the surface."
                                            },
                                            {
                                                "example_id": "5bf0f30d-3e61-4cd6-8242-3e2250e60da4",
                                                "sense_id": "7a6dc836-7a00-391d-a9f9-c74434374bc5",
                                                "text": "The marmalade is on the shelf below the bread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf8f39e-1971-34b0-b8f6-288efe3e8e23",
                                        "entry_id": "a195eb3c-f827-3352-8034-bd03458dece3",
                                        "glosses": [
                                            "Lower than in value, price, rank, concentration, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "713cacff-5533-4ec9-a0b0-9e2728e342ce",
                                                "sense_id": "9bf8f39e-1971-34b0-b8f6-288efe3e8e23",
                                                "text": "one degree below kings"
                                            },
                                            {
                                                "example_id": "b5bdf745-df8f-4bd9-809f-c5af6a14a47d",
                                                "sense_id": "9bf8f39e-1971-34b0-b8f6-288efe3e8e23",
                                                "text": "Surprisingly, this analysis revealed that acute exposure to solvent vapors at concentrations below those associated with long-term effects appears to increase the risk of a fatal automobile accident. Furthermore, this increase in risk is comparable to the risk of death from leukemia after long-term exposure to benzene, another solvent, which has the well-known property of causing this type of cancer."
                                            },
                                            {
                                                "example_id": "27877165-8ca9-4c11-966c-db465e92c4c7",
                                                "sense_id": "9bf8f39e-1971-34b0-b8f6-288efe3e8e23",
                                                "text": "The temperature is below zero."
                                            },
                                            {
                                                "example_id": "93b26323-0b2e-461d-b74c-34f6c247b648",
                                                "sense_id": "9bf8f39e-1971-34b0-b8f6-288efe3e8e23",
                                                "text": "Liverpool are below Manchester City in the Premier League."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d6a3d73-d9b9-3d58-8595-4548d6147c05",
                                        "entry_id": "a195eb3c-f827-3352-8034-bd03458dece3",
                                        "glosses": [
                                            "Downstream of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad6934bd-5c5e-4c14-86cb-252225038c8d",
                                                "sense_id": "8d6a3d73-d9b9-3d58-8595-4548d6147c05",
                                                "text": "The River Thames is tidal below Teddington Lock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39959e60-477d-3185-895b-e12c718210ed",
                                        "entry_id": "a195eb3c-f827-3352-8034-bd03458dece3",
                                        "glosses": [
                                            "South of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37898926-09c8-433a-96fc-6361fe7d006f",
                                                "sense_id": "39959e60-477d-3185-895b-e12c718210ed",
                                                "text": "Sudan is below Egypt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cb33c14-16d4-3ef9-8202-ab99fd404353",
                                        "entry_id": "a195eb3c-f827-3352-8034-bd03458dece3",
                                        "glosses": [
                                            "Unsuitable to the rank or dignity of; beneath."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bea595c-92a8-482c-b650-8a45a3cc4a1e",
                                                "sense_id": "2cb33c14-16d4-3ef9-8202-ab99fd404353",
                                                "text": "They beheld, with a just loathing and disdain, […] how below all history the persons and their actions were."
                                            },
                                            {
                                                "example_id": "00cf77c2-3bc7-4e83-94a5-27704ff044b2",
                                                "sense_id": "2cb33c14-16d4-3ef9-8202-ab99fd404353",
                                                "text": "who thinks no fact below his regard"
                                            },
                                            {
                                                "example_id": "5aa93422-6435-4222-b811-a64d965c9453",
                                                "sense_id": "2cb33c14-16d4-3ef9-8202-ab99fd404353",
                                                "text": "Such petty behavior is below me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0033c0e6-77fc-3e2c-bfc2-1aaebf4b5e99",
                                        "entry_id": "a195eb3c-f827-3352-8034-bd03458dece3",
                                        "glosses": [
                                            "Downstage of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fddd252-5791-4f88-851e-abb269a2e4de",
                                                "sense_id": "0033c0e6-77fc-3e2c-bfc2-1aaebf4b5e99",
                                                "text": "Below the sofa is a low, round coffee table."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "below",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e81c23d-3216-3e22-b67a-9c085f9aa2ee",
                                        "entry_id": "06f22599-3bd3-38c0-bbd7-647e08eb4aa5",
                                        "glosses": [
                                            "In or to a lower place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d2c5020-64f5-40e6-b16d-3293cc5babbb",
                                                "sense_id": "8e81c23d-3216-3e22-b67a-9c085f9aa2ee",
                                                "text": "The town is situated on a hillside, with a river running below."
                                            },
                                            {
                                                "example_id": "c0e3704c-c8ab-4b40-8cc9-2391f7bb59d0",
                                                "sense_id": "8e81c23d-3216-3e22-b67a-9c085f9aa2ee",
                                                "text": "He was pulled below by a sea monster."
                                            },
                                            {
                                                "example_id": "e947348d-80f1-49e6-9e92-2da63d3afbba",
                                                "sense_id": "8e81c23d-3216-3e22-b67a-9c085f9aa2ee",
                                                "text": "But then I had the [massive] flintlock by me for protection.\n[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window at the old mare feeding in the meadow below by the brook, and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8828b753-a391-3fb6-a84b-062898dd9b9e",
                                        "entry_id": "06f22599-3bd3-38c0-bbd7-647e08eb4aa5",
                                        "glosses": [
                                            "In or to a lower place.",
                                            "On or to a lower storey."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a935597-400d-45e4-8a8a-37dec3482fb0",
                                                "sense_id": "8828b753-a391-3fb6-a84b-062898dd9b9e",
                                                "text": "She lives below, on the ground floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4875a7da-47da-3b8a-80eb-7155632f37d3",
                                        "entry_id": "06f22599-3bd3-38c0-bbd7-647e08eb4aa5",
                                        "glosses": [
                                            "In or to a lower place.",
                                            "On or to a lower deck, especially as relative to the main deck."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d11e5ae-6362-4c84-be84-65ddbd46a9d5",
                                                "sense_id": "4875a7da-47da-3b8a-80eb-7155632f37d3",
                                                "text": "The captain went below to inspect the engine."
                                            },
                                            {
                                                "example_id": "bd6a394d-6c0d-4a0b-9b3b-a2456be1a50b",
                                                "sense_id": "4875a7da-47da-3b8a-80eb-7155632f37d3",
                                                "text": "the landlubbers lying down below"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a492b1e-afff-357f-8b91-8c44f35f93ea",
                                        "entry_id": "06f22599-3bd3-38c0-bbd7-647e08eb4aa5",
                                        "glosses": [
                                            "Later in the same text."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fb30b29-ae8b-4dce-a2c2-74b846762eb6",
                                                "sense_id": "3a492b1e-afff-357f-8b91-8c44f35f93ea",
                                                "text": "This point is explained below."
                                            },
                                            {
                                                "example_id": "3224acfa-a2a1-4c1e-b58b-4fbc90abbc96",
                                                "sense_id": "3a492b1e-afff-357f-8b91-8c44f35f93ea",
                                                "text": "By their execution hereof, the Parties incur a legal obligation to pass consideration under this Loan Contract as is set forth below."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5865104-f336-3a52-9590-5405d5343f77",
                                        "entry_id": "06f22599-3bd3-38c0-bbd7-647e08eb4aa5",
                                        "glosses": [
                                            "Below zero."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f89599f3-84ab-4d1e-99d5-ce2983924fc0",
                                                "sense_id": "d5865104-f336-3a52-9590-5405d5343f77",
                                                "text": "It was forty degrees below."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
