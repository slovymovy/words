                "senses": [
                    {
                        "sense_id": "32a3cd3a-0a8a-328d-b7b1-bc6427d1abf2",
                        "entry_id": "8037cca9-9300-3310-933f-23921b2240bc",
                        "glosses": [
                            "iemand die verraad pleegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8613bc48-fd8d-47f9-9810-105203e37643",
                                "sense_id": "32a3cd3a-0a8a-328d-b7b1-bc6427d1abf2",
                                "text": "Verrader! Jij zult boeten voor je verraad!"
                            },
                            {
                                "example_id": "c750d92e-279f-49b6-950f-b5fcc9576c0d",
                                "sense_id": "32a3cd3a-0a8a-328d-b7b1-bc6427d1abf2",
                                "text": "Pro-Oekraïense protesten in VS, JD Vance weggehoond in skioord: ‘Vance is een verrader’"
                            },
                            {
                                "example_id": "b99af79b-a7d9-4811-90de-879e0f11b6c6",
                                "sense_id": "32a3cd3a-0a8a-328d-b7b1-bc6427d1abf2",
                                "text": "Dat waren de eerste dagorders van De Gaulle toen hij de macht had overgenomen in het bevrijde Parijs, om alle Franse diplomaten in de hele wereld die aan de kant van de verraders hadden gestaan te ontslaan en daarna alle die aan de kant van het vrije Frankrijk hadden gestaan te bevorderen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66a1d257-55fb-443e-bf32-d32eb819c2e7",
                        "source_entry_id": "8037cca9-9300-3310-933f-23921b2240bc",
                        "source_sense_id": "32a3cd3a-0a8a-328d-b7b1-bc6427d1abf2",
                        "source_sense_description": "iemand die verraad pleegt",
                        "target_lang_word": "Verräter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verräter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41c72571-0ef2-36ad-8f47-f279ce4d70e8",
                                        "entry_id": "88bd96a5-ccad-3364-ab04-495c12660c93",
                                        "glosses": [
                                            "Person, die einen Verrat begangen hat, beziehungsweise immer noch begeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f5cf65d-2dba-4003-af0a-bceb7ea5b63a",
                                                "sense_id": "41c72571-0ef2-36ad-8f47-f279ce4d70e8",
                                                "text": "Der Verräter wurde hingerichtet."
                                            },
                                            {
                                                "example_id": "95b03fbf-d195-4b59-90b0-3083fdc39529",
                                                "sense_id": "41c72571-0ef2-36ad-8f47-f279ce4d70e8",
                                                "text": "„Und dieser feige Verräter spuckte sofort alles aus, was er wußte, ohne die geringste Kleinigkeit auszulassen.“"
                                            },
                                            {
                                                "example_id": "8f8f9723-bb40-434f-8269-e1a1606f7cea",
                                                "sense_id": "41c72571-0ef2-36ad-8f47-f279ce4d70e8",
                                                "text": "„Die Kämpfer attackieren jeden, den sie für einen Verräter halten.“"
                                            },
                                            {
                                                "example_id": "0b18b557-ac16-4cf2-82f3-c24c4edff1b1",
                                                "sense_id": "41c72571-0ef2-36ad-8f47-f279ce4d70e8",
                                                "text": "„Der Geist des Zielka schwebte drohend über ihm und schimpfte ihn einen Verräter.“"
                                            },
                                            {
                                                "example_id": "5182d4e0-dd65-4ef8-b56e-ca3e1ec359d4",
                                                "sense_id": "41c72571-0ef2-36ad-8f47-f279ce4d70e8",
                                                "text": "„Kutusow war ein Verräter, und Fürst Wassilij sagte während der visites de condoléance, die man ihm anlässlich des Todes seiner Tochter machte, von Kutusow, den er doch früher so sehr gerühmt hatte, von diesem blinden, greisen Wüstling habe sich auch nichts anderes erwarten lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "514c4057-e93c-3583-8466-5d75d53fa885",
                                        "entry_id": "88bd96a5-ccad-3364-ab04-495c12660c93",
                                        "glosses": [
                                            "Name eines Kartenspiels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfb7810c-40d4-4ba1-99ab-aad313bdd919",
                                                "sense_id": "514c4057-e93c-3583-8466-5d75d53fa885",
                                                "text": "Am Abend spielten wir gemeinsam Verräter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df276b3c-b937-4096-936c-0d0e975ed576",
                        "source_entry_id": "8037cca9-9300-3310-933f-23921b2240bc",
                        "source_sense_id": "32a3cd3a-0a8a-328d-b7b1-bc6427d1abf2",
                        "source_sense_description": "iemand die verraad pleegt",
                        "target_lang_word": "traitor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traitor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6d09b95-a4b3-3d4c-8e12-5ed75bb47b2c",
                                        "entry_id": "452f9e8f-8564-3b5e-bd4d-a3b528a1871b",
                                        "glosses": [
                                            "Someone who violates an allegiance and betrays their country; someone guilty of treason; one who, in breach of trust, delivers their country to an enemy, or yields up any fort or place entrusted to their defense, or surrenders an army or body of troops to the enemy, unless when vanquished."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48be6787-7e7a-4a5c-bb94-fb2e57af894a",
                                                "sense_id": "f6d09b95-a4b3-3d4c-8e12-5ed75bb47b2c",
                                                "text": "After World War I, the communists and Jews were accused to be traitors by the German right wing (the \"stab-in-the-back myth\"), ultimately culminating in their persecution and massacre."
                                            },
                                            {
                                                "example_id": "2770f87e-c906-4390-a3a4-0f2fee6313f2",
                                                "sense_id": "f6d09b95-a4b3-3d4c-8e12-5ed75bb47b2c",
                                                "text": "My Lord of Hereford here whom you call King, / Is a foule traitour to proud Herefords King, / And if you crowne him let me propheſie, / The bloud of Engliſh ſhall manure the ground, / And future ages groane for this foule act, [...]"
                                            },
                                            {
                                                "example_id": "5ebf2923-0962-4a1b-bfc4-7bddbacbe669",
                                                "sense_id": "f6d09b95-a4b3-3d4c-8e12-5ed75bb47b2c",
                                                "text": "Yes, that was Vice President Spiro Agnew commemorating the \"loyalty\" of literal traitors. But what can you really expect from a man whose name rearranged spells \"grow a penis.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09d188ee-816d-39e3-8de1-dc7c2753ee29",
                                        "entry_id": "452f9e8f-8564-3b5e-bd4d-a3b528a1871b",
                                        "glosses": [
                                            "Someone who takes arms and levies war against their country; or one who aids an enemy in conquering their country."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f50bbb3-bff7-3cc4-acb5-174b4ee12b0a",
                                        "entry_id": "452f9e8f-8564-3b5e-bd4d-a3b528a1871b",
                                        "glosses": [
                                            "One who betrays any confidence or trust."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ca58bad-7814-4707-9373-8db000867d04",
                                                "sense_id": "6f50bbb3-bff7-3cc4-acb5-174b4ee12b0a",
                                                "text": "It's second nature now to think myself a traitor\nTo myself, to all I've ever burdened with my rotting visage\nI can't breathe, the weight of all I've disappointed crushes me\nIf I were happy, it would feel as if I couldn't trust me"
                                            },
                                            {
                                                "example_id": "1b942efe-65f4-49bf-a00f-4ec0579618b2",
                                                "sense_id": "6f50bbb3-bff7-3cc4-acb5-174b4ee12b0a",
                                                "text": "It took you two weeks\nTo go off and date her\nGuess you didn't cheat\nBut you're still, you're still a traitor\nYeah, you're still a traitor"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "traitor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f35d94e1-ece7-372a-9ebe-c6f94ee3d58d",
                                        "entry_id": "0bfab019-3e62-38ba-a90a-8ea7db5fe78f",
                                        "glosses": [
                                            "To act the traitor toward; to betray; to deceive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "traitor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02b1f863-4c16-391d-80e2-eb6f493f48e9",
                                        "entry_id": "dcf561a9-1f07-3bca-acea-a6b53e0be3e0",
                                        "glosses": [
                                            "Traitorous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "747bbfda-7d31-46a6-ab26-a769892baec1",
                                                "sense_id": "02b1f863-4c16-391d-80e2-eb6f493f48e9",
                                                "text": "to find a subject staid and wise\nAlready half turn'd traitor by surprise"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19b2ceed-7ef6-4cea-ab0d-2b2fb1cbd968",
                        "source_entry_id": "8037cca9-9300-3310-933f-23921b2240bc",
                        "source_sense_id": "32a3cd3a-0a8a-328d-b7b1-bc6427d1abf2",
                        "source_sense_description": "iemand die verraad pleegt",
                        "target_lang_word": "traître",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e82197d0-6eef-3061-ac61-b7242cd86d59",
                                        "entry_id": "3024bb07-993f-3eaa-8643-c782d201aee3",
                                        "glosses": [
                                            "Personne qui trahit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6006f2d0-8b96-4753-8b94-1dfbe6acd938",
                                                "sense_id": "e82197d0-6eef-3061-ac61-b7242cd86d59",
                                                "text": "Je n’ai donc contre vous que la haine que j’ai pour tout traître, que le mépris que j’ai pour tout calomniateur."
                                            },
                                            {
                                                "example_id": "5799d184-55e6-40dc-8865-28523c28a998",
                                                "sense_id": "e82197d0-6eef-3061-ac61-b7242cd86d59",
                                                "text": "Hélas ! si tous les héros n’ont pas été récompensés comme ils méritaient de l’être, tous les traîtres n’ont pas été punis."
                                            },
                                            {
                                                "example_id": "d2d94c1b-3d49-433d-ac55-0ddfbb7cc9f1",
                                                "sense_id": "e82197d0-6eef-3061-ac61-b7242cd86d59",
                                                "text": "La beauté dont mon traître adore les attraits."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "traître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "231787b9-fb1a-3135-8c2b-836501d532f5",
                                        "entry_id": "56c51e27-e145-3629-ad32-b680c995f311",
                                        "glosses": [
                                            "Qui trahit, qui est capable de trahison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9d0439f-f5d6-40ae-946f-26a898de1634",
                                                "sense_id": "231787b9-fb1a-3135-8c2b-836501d532f5",
                                                "text": "Cet homme-là est bien traître."
                                            },
                                            {
                                                "example_id": "cca4b290-d754-4499-9d2f-a87d73c8fd13",
                                                "sense_id": "231787b9-fb1a-3135-8c2b-836501d532f5",
                                                "text": "Le cœur le plus traître du monde."
                                            },
                                            {
                                                "example_id": "b1ca69c9-914f-4b36-abb0-53f65f99cc43",
                                                "sense_id": "231787b9-fb1a-3135-8c2b-836501d532f5",
                                                "text": "Une âme traîtresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f69cf0c7-7231-3ccc-841f-2aee61bc6218",
                                        "entry_id": "56c51e27-e145-3629-ad32-b680c995f311",
                                        "glosses": [
                                            "Qualifie quelques animaux, comme des chiens, des chats, des chevaux, qui mordent, qui égratignent, qui ruent lorsqu’on y pense le moins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb55e138-db77-4339-bf18-bf96d2218afc",
                                                "sense_id": "f69cf0c7-7231-3ccc-841f-2aee61bc6218",
                                                "text": "Ce chien est traître."
                                            },
                                            {
                                                "example_id": "53d7fa2e-44a1-4368-bf7d-ec0e6b131136",
                                                "sense_id": "f69cf0c7-7231-3ccc-841f-2aee61bc6218",
                                                "text": "Les chats sont ordinairement traîtres."
                                            },
                                            {
                                                "example_id": "b5a349d4-d8b6-4db2-a3bf-a6f406989cd2",
                                                "sense_id": "f69cf0c7-7231-3ccc-841f-2aee61bc6218",
                                                "text": "Prenez garde à ce cheval, il est traître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "046a2637-1113-3b8f-b286-6f13da5cb181",
                                        "entry_id": "56c51e27-e145-3629-ad32-b680c995f311",
                                        "glosses": [
                                            "Qualifie des actes qui marquent de la trahison, de la perfidie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c980afad-1b77-453f-83eb-b530432693f4",
                                                "sense_id": "046a2637-1113-3b8f-b286-6f13da5cb181",
                                                "text": "C’est un procédé bien traître."
                                            },
                                            {
                                                "example_id": "82ed6015-ed14-435e-9318-2b81b85f88e0",
                                                "sense_id": "046a2637-1113-3b8f-b286-6f13da5cb181",
                                                "text": "Il lui a joué un tour bien traître."
                                            },
                                            {
                                                "example_id": "82e1eb6d-d42b-46b5-82c0-03aeef6c83cb",
                                                "sense_id": "046a2637-1113-3b8f-b286-6f13da5cb181",
                                                "text": "Des faveurs traîtresses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c42bf70-9c74-3a1b-81ed-5591936babb4",
                                        "entry_id": "56c51e27-e145-3629-ad32-b680c995f311",
                                        "glosses": [
                                            "Qualifie certaines choses qui trompent, qui sont plus dangereuses qu’elles ne le paraissent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "974edc93-f76d-438a-8be1-e258180b3b32",
                                                "sense_id": "8c42bf70-9c74-3a1b-81ed-5591936babb4",
                                                "text": "Je m'engageai dans la passe et commençai à louvoyer contre la marée et un fort vent debout. Je devais agir avec prudence, car les pointes traîtresses du corail me guettaient sous la mer."
                                            },
                                            {
                                                "example_id": "ca82561d-2c4b-4bf4-81b6-46554b1eb9f3",
                                                "sense_id": "8c42bf70-9c74-3a1b-81ed-5591936babb4",
                                                "text": "Ahmed Abdou s'effrayait aussitôt, et craignait que la graine dure et traîtresse, cachée sous les fibres, ne blessât la fillette."
                                            },
                                            {
                                                "example_id": "290fcc29-c873-4fb6-a4f3-997fcf3ba286",
                                                "sense_id": "8c42bf70-9c74-3a1b-81ed-5591936babb4",
                                                "text": "Certaines ornières avaient été rempierrées avec des gravats de brique et de plâtre et, plutôt que rendre service, elles se révélaient comme des zones traîtresses pour les pneus usés de la Benelli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0f83614-f9a9-37ab-b783-c730602ee0f7",
                                        "entry_id": "56c51e27-e145-3629-ad32-b680c995f311",
                                        "glosses": [
                                            "Pas un seul, pas le moindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a25dbda3-c7e6-4ede-8aab-64d4a36f929b",
                                                "sense_id": "e0f83614-f9a9-37ab-b783-c730602ee0f7",
                                                "text": "— Monsieur, j’ai bu et mangé respectueusement l’écu que vous m’avez donné ce matin, de sorte qu’il ne me reste pas un traître sou dans le cas où j’aurais froid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
