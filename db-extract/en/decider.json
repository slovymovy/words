    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "371bad41-88bd-3056-a5d2-158b4b0c9479",
                "word": "decider",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c2e58a76-60c2-48ee-8586-dc04ef10fade",
                        "entry_id": "371bad41-88bd-3056-a5d2-158b4b0c9479",
                        "tags": [
                            "plural"
                        ],
                        "form": "deciders"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e529e53b-164a-3106-9cc4-4f05a9ffa06b",
                        "entry_id": "371bad41-88bd-3056-a5d2-158b4b0c9479",
                        "glosses": [
                            "A person, divinity, or authoritative text which decides."
                        ],
                        "tags": [
                            "of a controversy"
                        ],
                        "examples": [
                            {
                                "example_id": "f76320d6-b62e-4936-a635-20e96be13285",
                                "sense_id": "e529e53b-164a-3106-9cc4-4f05a9ffa06b",
                                "text": "This written and revealed will of God I said was the Judge and Decider of all Questions."
                            },
                            {
                                "example_id": "8332ae22-db5b-49f9-80b1-c4d5da35ec43",
                                "sense_id": "e529e53b-164a-3106-9cc4-4f05a9ffa06b",
                                "text": "The Determination of his Majesty, who is the only proper decider of this Matter."
                            },
                            {
                                "example_id": "7e07fe83-3d12-47f2-97b6-8fc55ad0ba48",
                                "sense_id": "e529e53b-164a-3106-9cc4-4f05a9ffa06b",
                                "text": "The god Adar, which, with its two oft-occurring idiographs Bar and Nin-ib, is preferably designated as the \"Decider\" (Entschneider)."
                            },
                            {
                                "example_id": "fdb0b1fd-26e0-4a16-815b-4d7c190d3f5e",
                                "sense_id": "e529e53b-164a-3106-9cc4-4f05a9ffa06b",
                                "text": "Although the decider may know any of the principles in the sequence, he cannot know every such principle."
                            },
                            {
                                "example_id": "5f5efd21-520a-4fa8-b77e-64a98747ec47",
                                "sense_id": "e529e53b-164a-3106-9cc4-4f05a9ffa06b",
                                "text": "I have strong confidence in Don Rumsfeld. I hear the voices. And I read the front page. And I know the speculation. But I'm the decider and I decide what is best."
                            },
                            {
                                "example_id": "29af5d70-c897-4874-9e00-2dc29fa258fe",
                                "sense_id": "e529e53b-164a-3106-9cc4-4f05a9ffa06b",
                                "text": "As noted, the frontal cortex is central to executive function. To quote George W. Bush, within the frontal cortex, it's the PFC that is “the decider.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "2cc96938-fcd2-3fd0-8085-4030e4d5ba36",
                        "entry_id": "371bad41-88bd-3056-a5d2-158b4b0c9479",
                        "glosses": [
                            "An event or action which decides the outcome of a contested matter."
                        ],
                        "tags": [
                            "Australia",
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "cdb73b1a-6a01-4959-81be-8e96e91c6d90",
                                "sense_id": "2cc96938-fcd2-3fd0-8085-4030e4d5ba36",
                                "text": "Four years on, France […] will meet Ireland again in the probable decider for their World Cup pool in September 21 in Paris."
                            },
                            {
                                "example_id": "35dd4c1f-3b06-44da-80cb-61a8f6f6dc37",
                                "sense_id": "2cc96938-fcd2-3fd0-8085-4030e4d5ba36",
                                "text": "[…] when the Welshman laid on the 74th-minute decider."
                            },
                            {
                                "example_id": "27b4562d-4947-4842-b0c9-c2c820f33b75",
                                "sense_id": "2cc96938-fcd2-3fd0-8085-4030e4d5ba36",
                                "text": "Tensions threatened to boil over before the defending champion Gerwyn Price eventually overcame Kim Huybrechts in a sudden-death decider to reach the last 16 of the PDC World Championship."
                            }
                        ]
                    },
                    {
                        "sense_id": "631e8e78-8287-3f42-9d66-305d2ede122f",
                        "entry_id": "371bad41-88bd-3056-a5d2-158b4b0c9479",
                        "glosses": [
                            "A Turing machine that halts regardless of its input."
                        ],
                        "tags": [],
                        "examples": []
                    }
