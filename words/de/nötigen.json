                    "semantic_group_id": "Aufforderung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die freundliche Gastgeberin <w>nötigte</w> ihre Gäste dazu, noch ein zweites Stück Kuchen zu probieren."
