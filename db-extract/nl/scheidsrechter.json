                                "sense_id": "926abf71-f8b2-3b78-a73e-7838285dc817",
                                "text": "Dit doelpunt werd door de scheidsrechter afgekeurd."
                            },
                            {
                                "example_id": "403d202a-d056-4b10-a562-4d575996408e",
                                "sense_id": "926abf71-f8b2-3b78-a73e-7838285dc817",
