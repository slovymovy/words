            "senses": [
                {
                    "sense_id": "d22c1f88-b01d-32ab-bbd8-ec3edf938c81",
                    "sense_definition": "Au plus profond de soi-même, dans son for intérieur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir écouté ses explications, je reste <w>intimement</w> convaincu de sa bonne foi."
                        },
                        {
                            "text": "Elle sentait <w>intimement</w> qu'un grand changement allait bientôt bouleverser son existence."
                        }
                    ],
                    "synonyms": [
                        "profondément",
                        "intérieurement"
                    ],
                    "common_phrases": [
