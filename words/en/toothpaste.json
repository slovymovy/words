                            }
                        },
                        {
                            "text": "Don't forget to buy a tube of <w>toothpaste</w> at the supermarket.",
                            "target_lang_translations": {
                                "es": "No olvides comprar un tubo de <w>pasta dental</w> en el supermercado."
                            }
