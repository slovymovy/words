                        "tags": [
                            "alt-of",
                            "dated",
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "cc11594a-3ebc-46a1-ad08-614e1b60f0d0",
                                "sense_id": "ae0c103f-5ab4-3ae7-9069-7a9c6cb46897",
                                "text": "Die Dichtigkeit eines Körpers K in Hinsicht eines andern Körpers K₀ ist das Verhältnis der betreffenden spezifischen Gewichte.",
                                "translation": "La densité d’un corps K par rapport à un autre corps K₀ est le rapport des deux poids spécifiques respectifs."
