                    {
                        "translation_id": "7dafcb7d-420f-4265-bd03-d6396bfc3318",
                        "source_entry_id": "b528b133-4a9d-3a45-9e61-57d9a5003d46",
                        "source_sense_description": "one thousand watts",
                        "target_lang_word": "kilowatt",
