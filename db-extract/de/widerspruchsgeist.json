                "senses": [
                    {
                        "sense_id": "cd1f8892-a961-396c-a7cf-8652cbd916fb",
                        "entry_id": "b8bd92d2-01bb-38a7-a0ac-d09473741b85",
                        "glosses": [
                            "kein Plural: Eigenschaft/Haltung einer Person, sich gegen Dinge zu wehren, die sie für falsch hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb8acf39-82cb-4d35-a510-07223b470122",
                                "sense_id": "cd1f8892-a961-396c-a7cf-8652cbd916fb",
                                "text": "„Dennoch, der Widerspruchsgeist ihres Vaters ging auf sie über.“"
                            },
                            {
                                "example_id": "e3f03da2-e510-4a03-8901-b50edc6c6290",
                                "sense_id": "cd1f8892-a961-396c-a7cf-8652cbd916fb",
                                "text": "„Andere Ansichten als die seinen duldete er nicht, er versah sie sofort mit dem Odium des Kriminellen, und nun erst begann sich sein zügelloser Widerspruchsgeist voll und entsetzlich auszutoben.“"
                            },
                            {
                                "example_id": "c0207f22-2b5e-4b67-a505-3f1d951aecea",
                                "sense_id": "cd1f8892-a961-396c-a7cf-8652cbd916fb",
                                "text": "„Das hat Ernst Wiecherts Gerechtigkeitsempfinden verletzt, seinen Widerspruchsgeist herausgefordert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c9d41f07-8ca5-3c4e-a3e3-b82414884568",
                        "entry_id": "b8bd92d2-01bb-38a7-a0ac-d09473741b85",
                        "glosses": [
                            "Person mit hoher Bereitschaft, sich zu wehren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30325c35-413d-43bb-bc3f-031f7dae54f2",
                                "sense_id": "c9d41f07-8ca5-3c4e-a3e3-b82414884568",
                                "text": "Er erweist sich immer wieder als Widerspruchsgeist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
