                        "entry_id": "e702c920-7745-34d3-bc30-5d8b66253059",
                        "glosses": [
                            "document waarop de prestaties van een leerling staan vermeld, meestal in de vorm van een lijst met cijfers die aangeven hoe de prestaties per schoolvak zijn geweest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6277cba2-ea48-49c2-bf7a-28cc5fa5a325",
                                "sense_id": "b2526a58-340d-3ff2-87d1-c7419af87355",
                                "text": "Hetty ging zitten en keek de rommelige kamer rond. De papieren zagen eruit als werkboeken voor leerlingen en een schoolrapport. Basisschool."
                            },
                            {
                                "example_id": "8a6553e2-9a38-4b4e-9616-a5482699be4a",
                                "sense_id": "b2526a58-340d-3ff2-87d1-c7419af87355",
                                "text": "Kind krijgt 5 euro voor schoolrapport: Zo'n 60 procent van de kinderen op de basisschool krijgt geld van hun ouders voor een rapport. Het bedrag ligt meestal rond de 5 euro. Veruit de meeste ouders die geld geven, zeggen zich niet te laten beïnvloeden door wat andere ouders hun kinderen geven."
                            }
                        ]
                    }
