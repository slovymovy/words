    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b927f5e4-e0bd-3e35-a624-f637f038a1d2",
                    "sense_definition": "Frightening or intimidating, especially in appearance or power.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "frightening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers faced a <w>fearsome</w> enemy on the battlefield.",
                            "target_lang_translations": {
                                "tr": "Askerler savaş alanında <w>korkunç</w> bir düşmanla karşı karşıya geldi.",
                                "es": "Los soldados se enfrentaron a un enemigo <w>temible</w> en el campo de batalla."
                            }
                        },
                        {
                            "text": "She gave him a <w>fearsome</w> glare that made him stop talking immediately.",
                            "target_lang_translations": {
                                "tr": "Ona, hemen susmasına neden olan <w>ürkütücü</w> bir bakış attı.",
                                "es": "Ella le lanzó una mirada <w>aterradora</w> que lo hizo callar de inmediato."
                            }
                        }
                    ],
                    "synonyms": [
                        "frightening",
                        "intimidating",
                        "formidable",
                        "terrifying"
                    ],
                    "antonyms": [
                        "harmless",
                        "friendly"
                    ],
                    "common_phrases": [
                        "fearsome reputation",
                        "fearsome weapon"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle görünüşü veya gücü bakımından korkutucu veya ürkütücü olan.",
                        "es": "Que infunde miedo o intimidación, especialmente por su aspecto o poder."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "korkunç",
                                "target_lang_sense_clarification": "Genel olarak korku uyandıran, ürkütücü."
                            },
                            {
                                "target_lang_word": "ürkütücü",
                                "target_lang_sense_clarification": "Kişide ürperti veya korku yaratan."
                            },
                            {
                                "target_lang_word": "heybetli",
                                "target_lang_sense_clarification": "Gücü veya büyüklüğü ile korku ve saygı uyandıran."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "temible",
                                "target_lang_sense_clarification": "Que causa o inspira gran temor o respeto"
                            },
                            {
                                "target_lang_word": "aterrador",
                                "target_lang_sense_clarification": "Que produce miedo o terror extremo"
                            },
                            {
                                "target_lang_word": "imponente",
                                "target_lang_sense_clarification": "Que impresiona fuertemente por su presencia o poder"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "797dfb61-06c3-3ece-be36-f08c4060a61c",
                    "sense_definition": "Feeling or showing fear.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "frightened",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fearsome</w> child hid behind his mother during the thunderstorm.",
                            "target_lang_translations": {
                                "tr": "Fırtına sırasında <w>ürkek</w> çocuk annesinin arkasına saklandı.",
                                "es": "El niño <w>temeroso</w> se escondió detrás de su madre durante la tormenta."
                            }
                        },
                        {
                            "text": "He looked <w>fearsome</w> as he stared into the dark, empty hallway.",
                            "target_lang_translations": {
                                "tr": "Karanlık ve boş koridora bakarken <w>korkak</w> görünüyordu.",
                                "es": "Se le veía <w>asustado</w> mientras contemplaba el pasillo oscuro y vacío."
                            }
                        }
                    ],
                    "synonyms": [
                        "fearful",
                        "frightened",
                        "afraid"
                    ],
                    "antonyms": [
                        "brave",
                        "fearless"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Korku duyan veya korku gösteren (eski veya edebi kullanım).",
                        "es": "Que siente o muestra miedo (uso anticuado o literario)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "korkak",
                                "target_lang_sense_clarification": "Korku içinde olan veya kolayca korkan."
                            },
                            {
                                "target_lang_word": "ürkek",
                                "target_lang_sense_clarification": "Çekingen ve korku dolu bir tavır sergileyen."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "miedoso",
                                "target_lang_sense_clarification": "Que siente o manifiesta miedo con facilidad"
                            },
                            {
                                "target_lang_word": "temeroso",
                                "target_lang_sense_clarification": "Lleno de temor o inquietud"
                            },
                            {
                                "target_lang_word": "asustadizo",
                                "target_lang_sense_clarification": "Que se asusta con facilidad"
                            }
                        ]
                    }
                }
            ]
        }
    ]
