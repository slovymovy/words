                ],
                "senses": [
                    {
                        "sense_id": "71d7a90c-7dbf-3bf7-b7e1-378ef2183129",
                        "entry_id": "1e3c59b8-41e4-3956-8160-6b2f631bb216",
                        "glosses": [
                            "Donner un caractère pédiatrique à (quelque chose), par exemple en adaptant aux enfants ou en faisant bénéficier du concours d’un ou de plusieurs pédiatres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75bafa85-752c-4bf3-8c21-acb54df4e228",
                                "sense_id": "71d7a90c-7dbf-3bf7-b7e1-378ef2183129",
                                "text": "1/ 2.5, ou 3, ou 3.5 ou... plein de possibilités, les enfants ne sont pas formatés au niveau de la propreté, même si certaines normes sont pédiatrisées pour un carnet de santé rempli et pratique."
                            },
                            {
                                "example_id": "92fc2e76-f6ae-4abb-a32b-20e9a77ba5ad",
                                "sense_id": "71d7a90c-7dbf-3bf7-b7e1-378ef2183129",
                                "text": "L'idée principale est d'accessoiriser, de « pédiatriser » le masque pour le rendre plus attrayant et/ou de proposer une histoire un scénario pour distraire l'enfant."
                            },
                            {
                                "example_id": "06ebcbb8-270f-4eeb-af5f-c419c69a00f1",
                                "sense_id": "71d7a90c-7dbf-3bf7-b7e1-378ef2183129",
                                "text": "Afin de mieux organiser les transports sanitaires des nouveau-nés, des nourrissons, et des enfants, la circulaire DHOS/O1/2005/67 du 7 février 2005 prévoit trois modalités de prise en charge : SMUR pédiatrique, SMUR « pédiatrisé » ou transport par le SMUR avec protocoles spécifiques à la prise en charge des enfants."
                            }
                        ]
                    }
                ],
