                    },
                    {
                        "form_id": "67669598-1d3e-4a60-a513-1d2e9cd05f69",
                        "entry_id": "daf304d4-c377-379a-aad1-f7568c849014",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Dietmars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3830bef-d410-3c5e-809e-dba977d10454",
                        "entry_id": "daf304d4-c377-379a-aad1-f7568c849014",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c5ddc5d-eff2-4ade-b181-550d4ab64829",
                                "sense_id": "e3830bef-d410-3c5e-809e-dba977d10454",
                                "text": "Frau Dietmar ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "678ce5c2-9fa0-4aeb-bac5-0a44cf75ec23",
                                "sense_id": "e3830bef-d410-3c5e-809e-dba977d10454",
                                "text": "Herr Dietmar wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c7831983-c47d-480f-9bf4-351c1c238101",
                                "sense_id": "e3830bef-d410-3c5e-809e-dba977d10454",
                                "text": "Die Dietmars fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "85c9acc9-e6e6-49fd-94bb-84b0202dda80",
                                "sense_id": "e3830bef-d410-3c5e-809e-dba977d10454",
                                "text": "Der Dietmar trägt nie die Schals, die die Dietmar ihm strickt."
                            },
                            {
                                "example_id": "4f3ef6a0-3a23-486e-9ba5-264dcb695d02",
                                "sense_id": "e3830bef-d410-3c5e-809e-dba977d10454",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dietmar kommt, geht der Herr Dietmar.“"
                            },
                            {
                                "example_id": "b07cc4bd-43bc-404a-a7ef-09c4fdee03fe",
                                "sense_id": "e3830bef-d410-3c5e-809e-dba977d10454",
                                "text": "Dietmar kommt und geht."
                            },
                            {
                                "example_id": "29b47892-674b-4e6f-a529-d76cc71d9bdd",
                                "sense_id": "e3830bef-d410-3c5e-809e-dba977d10454",
                                "text": "Dietmars kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
