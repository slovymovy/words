    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3bf229b3-288e-3484-9ce8-cd7ad3838568",
                "word": "Slavonic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed3a0659-a2e2-38cf-ba12-dfdb30f2ee60",
                        "entry_id": "3bf229b3-288e-3484-9ce8-cd7ad3838568",
                        "glosses": [
                            "Of, denoting, or relating to the people who speak these languages, their languages, or cultures."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c8ac408b-a3d5-4b7d-bbe4-b635bcd82028",
                                "sense_id": "ed3a0659-a2e2-38cf-ba12-dfdb30f2ee60",
                                "text": "Sanskrit, Greek, Slavonic, Germanic, and Celtic names were all of this type, but there are also shorter names formed from the compound ones; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "8701b826-3060-3015-8045-5644267a590e",
                        "entry_id": "3bf229b3-288e-3484-9ce8-cd7ad3838568",
                        "glosses": [
                            "Of, denoting, or relating to Slavonia and its inhabitants."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "664a1003-132e-4ab1-99d5-69492cef4542",
                        "source_entry_id": "3bf229b3-288e-3484-9ce8-cd7ad3838568",
                        "source_sense_description": "related to Slavonia",
                        "target_lang_word": "slavon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slavon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43d1e9fa-bfe6-3a78-9e26-bcbf5bd571b8",
                                        "entry_id": "843ba807-b00c-3410-a48a-5db19d408760",
                                        "glosses": [
                                            "Qui habite ou est originaire de la Slavonie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f8b2f45-2936-4d8e-ac28-21f27b5ebd14",
                                                "sense_id": "43d1e9fa-bfe6-3a78-9e26-bcbf5bd571b8",
                                                "text": "Petit Loup prend la main de Minnhild. Ils s’éloignent sur la pointe des pieds, cueillant au passage l’esclave slavonne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aea3a53-848b-3c4b-9bae-09d2bfe3784e",
                                        "entry_id": "843ba807-b00c-3410-a48a-5db19d408760",
                                        "glosses": [
                                            "Qui concerne le slavon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "slavon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "556cacaa-1141-316c-bca1-80e3c52726f6",
                                        "entry_id": "8b8cd888-269b-3445-a52b-1ed7f42a8b3c",
                                        "glosses": [
                                            "Langue slave la plus ancienne qui soit attestée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "821c2528-9c39-4856-9d27-1ac81a41d9e1",
                                                "sense_id": "556cacaa-1141-316c-bca1-80e3c52726f6",
                                                "text": "En Europe, l’ancien slavon, le tudesque, le gothique, le normannique se retrouvent au-dessous des idiomes slaves et germaniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f7127e-0f5b-35b2-8f5d-56a5b37a9e96",
                                        "entry_id": "8b8cd888-269b-3445-a52b-1ed7f42a8b3c",
                                        "glosses": [
                                            "Langue liturgique de l’orthodoxie orientale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba752433-8d37-4b73-9f3b-586745f6f941",
                                                "sense_id": "09f7127e-0f5b-35b2-8f5d-56a5b37a9e96",
                                                "text": "La directrice se renseigna sur son éducation : une classe et demie de l’école paroissiale, qui lui avait donné tout ce dont il avait besoin, lire la Bible et la Vie des Saints, en russe, « pis aussi », en slavon […]."
                                            },
                                            {
                                                "example_id": "cc5aab48-5c8e-45d7-a39e-082017903a17",
                                                "sense_id": "09f7127e-0f5b-35b2-8f5d-56a5b37a9e96",
                                                "text": "L’église russe de la rue Daru, surtout, où Jeanne et Egon, protestants épris du chant en slavon d’église, ont autrefois conduit Michel."
                                            },
                                            {
                                                "example_id": "c7b10018-76a2-4346-8982-233ccc024481",
                                                "sense_id": "09f7127e-0f5b-35b2-8f5d-56a5b37a9e96",
                                                "text": "Comme Olga, presque tous vont assister à la messe de Noël, célébrée en russe et en slavon, […] ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
