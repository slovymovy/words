                    },
                    {
                        "sense_id": "fa6b185c-0a6c-3190-982b-3cc2a598dac4",
                        "entry_id": "1f0c73b5-089a-3b50-a613-e93b3273e605",
                        "glosses": [
                            "Petit poteau utilisé pour empêcher le stationnement sur un trottoir, on les nomme aussi bites ou bites de stationnement."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "3af1d0d8-6397-4e47-a22a-ac0e6fc4b156",
                                "sense_id": "fa6b185c-0a6c-3190-982b-3cc2a598dac4",
                                "text": "Et encore : même dans ces villes, les potelets pour empêcher les voitures de stationner se trouvent sur le trottoir, et non sur la voirie, y compris lorsque celui ci ne fait plus que 50 cm de large."
                            }
                        ]
                    },
                    {
                        "sense_id": "e55a9920-e06d-3ff4-ac74-5a4416cc41f9",
                        "entry_id": "1f0c73b5-089a-3b50-a613-e93b3273e605",
                        "glosses": [
                            "Petit poteau employé pour la délimitation d’espaces ou la gestion de files d’attente."
