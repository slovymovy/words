                "senses": [
                    {
                        "sense_id": "feaae7bc-3dc0-3754-a96e-63ddad725a92",
                        "entry_id": "6d3e4812-69a0-36b3-a339-55d2c4343539",
                        "glosses": [
                            "Anhänger der philosophischen Lehre des altgriechischen Philosophen Pythagoras von Samos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eff54324-7d1f-4f4f-a4bd-ed3a3e4c8343",
                                "sense_id": "feaae7bc-3dc0-3754-a96e-63ddad725a92",
                                "text": "„Der Begriff Quintessenz stammt von den Pythagoräern, nach denen die klassischen vier Elemente aus einem fünften, eben der Quintessenz (von lat. quinta essentia ‚fünftes Seiendes‘), auch Äther genannt, hervorgegangen seien.“"
                            },
                            {
                                "example_id": "be79c23e-6725-4bdc-b04b-bd3bd0d15afd",
                                "sense_id": "feaae7bc-3dc0-3754-a96e-63ddad725a92",
                                "text": "„Für die Pythagoräer waren Zahlen nicht nur als quantitative Größen von Bedeutung, sondern sie unterschieden auch verschiedene »Qualitäten« von Zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
