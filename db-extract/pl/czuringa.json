                        "glosses": [
                            "płaski kamień ozdobiony rytem lub rysunkiem, obiekt kultu plemion australijskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c753b0df-9e7a-4b3d-a8f4-e70984c96571",
                                "sense_id": "a5688547-5fd9-39db-b812-17c4563cbe63",
                                "text": "Każdemu nowo narodzonemu dziecku przydziela się czuringę odpowiedniego totemu, która wcześniej należała do jakiegoś zmarłego."
                            }
                        ],
