                        "entry_id": "6ad2b561-80a3-386b-98db-033bcd36e166",
                        "glosses": [
                            "zajęcia na uczelni wyższej, podczas których studenci analizują, często w sposób praktyczny, zagadnienia z danego przedmiotu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "777082c3-c2fa-4909-9fd1-baee20a8bfab",
                                "sense_id": "408a26ca-e8be-3a63-8b0d-50424f740ba0",
                                "text": "Rano muszę wcześnie wstać, bo mam ćwiczenia z analizy matematycznej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8b5ad150-26dd-38d3-8d5c-adc1e81ce451",
                        "entry_id": "6ad2b561-80a3-386b-98db-033bcd36e166",
                        "glosses": [
                            "szkolny zeszyt do wykonywania ćwiczeń z gotowymi, drukowanymi zadaniami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c91b6173-a974-4497-a165-9183049029e3",
                                "sense_id": "8b5ad150-26dd-38d3-8d5c-adc1e81ce451",
                                "text": "Jaś odrobił pracę domową, ale zapomniał wziąć ćwiczeń."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "4acd8c4e-1886-3da4-845e-cbd427cbb972",
                        "entry_id": "6ad2b561-80a3-386b-98db-033bcd36e166",
                        "glosses": [
                            "forma praktycznego szkolenia jednostek wojskowych w warunkach zbliżonych do pola walki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8665590f-7037-4bb6-b8e9-af6b64d9c698",
                                "sense_id": "4acd8c4e-1886-3da4-845e-cbd427cbb972",
                                "text": "Nasz pułk jedzie na ćwiczenia przeciwlotnicze do Drawska Pomorskiego."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
