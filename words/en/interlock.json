{
    "word_family": [
        "lock"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "514f2c81-2fc8-358c-bfb7-e1925f1280f8",
                    "sense_definition": "To connect, fit, or clasp together securely so that motion is constrained or coordinated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pieces of the puzzle <w>interlock</w> firmly so that they do not slide apart.",
                            "target_lang_translations": {
                                "es": "Las piezas del rompecabezas <w>encajan</w> firmemente para que no se separen."
                            }
                        },
                        {
                            "text": "The gear teeth <w>interlock</w> to transfer movement smoothly from one wheel to the next.",
                            "target_lang_translations": {
                                "es": "Los dientes del engranaje <w>engranan</w> para transferir el movimiento suavemente de una rueda a la siguiente."
                            }
                        }
                    ],
                    "synonyms": [
                        "mesh",
                        "engage"
                    ],
                    "antonyms": [
                        "disengage",
                        "separate"
                    ],
                    "common_phrases": [
                        "interlock with each other",
                        "designed to interlock"
                    ],
                    "target_lang_definitions": {
                        "es": "Unir, acoplar o encajar piezas de forma firme para que el movimiento quede limitado o coordinado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "encajar",
                                "target_lang_sense_clarification": "acoplarse piezas entre sí"
                            },
                            {
                                "target_lang_word": "engranar",
                                "target_lang_sense_clarification": "dientes de ruedas o mecanismos"
                            },
                            {
                                "target_lang_word": "trabar",
                                "target_lang_sense_clarification": "unir o sujetar firmemente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00eed6e6-298c-34ef-a01b-be5cbcfe3f99",
                    "sense_definition": "To intertwine or cross over one another, such as fingers or branches.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat quietly together and began to <w>interlock</w> their fingers.",
                            "target_lang_translations": {
                                "es": "Se sentaron tranquilamente juntos y comenzaron a <w>entrelazar</w> sus dedos."
                            }
                        },
                        {
                            "text": "Above the path, the thick tree branches <w>interlock</w> to block out the sunlight.",
                            "target_lang_translations": {
                                "es": "Sobre el camino, las gruesas ramas de los árboles se <w>entrelazan</w> bloqueando la luz del sol."
                            }
                        }
                    ],
                    "synonyms": [
                        "intertwine",
                        "interlace",
                        "entwine"
                    ],
                    "antonyms": [
                        "untangle"
                    ],
                    "common_phrases": [
                        "interlock fingers"
                    ],
                    "target_lang_definitions": {
                        "es": "Entrelazar o cruzar cosas entre sí, como los dedos o ramas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "entrelazar",
                                "target_lang_sense_clarification": "cruzar dedos, ramas u objetos alargados"
                            },
                            {
                                "target_lang_word": "entretejer",
                                "target_lang_sense_clarification": "tejer o entrelazar elementos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a9cd283-950e-37fa-825a-0db113c67f1f",
                    "sense_definition": "A mechanism or safety device that prevents an operation unless certain conditions are met.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A built-in <w>interlock</w> prevents the microwave from running while the door remains open.",
                            "target_lang_translations": {
                                "es": "Un <w>enclavamiento</w> integrado impide que el microondas funcione mientras la puerta permanezca abierta."
                            }
                        },
                        {
                            "text": "The technician repaired the safety <w>interlock</w> to ensure the laser would not trigger accidentally.",
                            "target_lang_translations": {
                                "es": "El técnico reparó el <w>bloqueo</w> de seguridad para asegurarse de que el láser no se activara accidentalmente."
                            }
                        }
                    ],
                    "common_phrases": [
                        "safety interlock",
                        "door interlock"
                    ],
                    "target_lang_definitions": {
                        "es": "Mecanismo o dispositivo de seguridad que impide una operación a menos que se cumplan ciertas condiciones."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "enclavamiento",
                                "target_lang_sense_clarification": "sistema o mecanismo de seguridad"
                            },
                            {
                                "target_lang_word": "bloqueo",
                                "target_lang_sense_clarification": "dispositivo que restringe el funcionamiento"
                            },
                            {
                                "target_lang_word": "traba",
                                "target_lang_sense_clarification": "pieza o mecanismo de sujeción e inmovilización"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}