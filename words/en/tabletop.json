    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13c92284-0219-3126-a4f5-fc07cd5cf4ca",
                    "sense_definition": "The flat, horizontal upper surface of a table.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "table_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wiped the wooden <w>tabletop</w> with a damp cloth to remove the dust.",
                            "target_lang_translations": {
                                "es": "Ella limpió el <w>tablero</w> de madera con un paño húmedo para quitar el polvo."
                            }
                        },
                        {
                            "text": "He placed his coffee mug directly on the polished <w>tabletop</w>.",
                            "target_lang_translations": {
                                "es": "Colocó su taza de café directamente sobre la <w>superficie de la mesa</w> pulida."
                            }
                        }
                    ],
                    "synonyms": [
                        "table top"
                    ],
                    "common_phrases": [
                        "wooden tabletop",
                        "glass tabletop"
                    ],
                    "target_lang_definitions": {
                        "es": "La superficie superior plana y horizontal de una mesa."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tablero",
                                "target_lang_sense_clarification": "superficie de la mesa"
                            },
                            {
                                "target_lang_word": "superficie de la mesa",
                                "target_lang_sense_clarification": "parte superior plana"
                            },
                            {
                                "target_lang_word": "encimera",
                                "target_lang_sense_clarification": "en algunos contextos de mesas de cocina o trabajo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "524228fd-b554-3d8a-a9f3-fc3c5369e748",
                    "sense_definition": "A tabletop game, such as a board game, card game, or role-playing game.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tabletop_gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On Friday nights, we usually gather at my house to play various <w>tabletops</w>.",
                            "target_lang_translations": {
                                "es": "Los viernes por la noche, solemos reunirnos en mi casa para jugar a varios <w>juegos de mesa</w>."
                            }
                        },
                        {
                            "text": "He prefers classic <w>tabletops</w> like chess and Settlers of Catan over video games.",
                            "target_lang_translations": {
                                "es": "Prefiere los <w>juegos de mesa</w> clásicos como el ajedrez y Catán en lugar de los videojuegos."
                            }
                        }
                    ],
                    "synonyms": [
                        "board game",
                        "tabletop game"
                    ],
                    "common_phrases": [
                        "play tabletops"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the plural to refer to tabletop games"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Un juego de mesa, como un juego de tablero, de cartas o de rol."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "juego de mesa",
                                "target_lang_sense_clarification": "juego que se juega sobre una mesa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c24de725-a66c-3518-b7a6-03dbfcf9f019",
