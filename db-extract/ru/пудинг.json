                    {
                        "translation_id": "1c19591a-da78-4c41-bd08-45acaa64dcc5",
                        "source_entry_id": "17931ef2-e328-37e0-972f-cadf859ecc9c",
                        "source_sense_id": "0197e69a-0a5c-3003-b15e-2a0bbcefcf6f",
                        "target_lang_word": "pudding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pudding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ae070956-369a-37ce-9a99-727a30a9746b",
                                        "entry_id": "ae01b04d-9ee7-36d0-9353-10402fb3df12",
                                        "glosses": [
                                            "zoet nagerecht uit melk en smaakgevende bestanddelen die gemengd met meel of iets vergelijkbaars om het te binden wordt gekookt en daarna in een vorm stolt, meestal koud geserveerd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f2af96-b032-4b43-963e-4f13a48172fe",
                                                "sense_id": "ae070956-369a-37ce-9a99-727a30a9746b",
                                                "text": "De pudding kwam niet goed uit zijn vorm."
                                            },
                                            {
                                                "example_id": "da61d840-bde8-44d8-9898-3bc3d1f96413",
                                                "sense_id": "ae070956-369a-37ce-9a99-727a30a9746b",
                                                "text": "Maar toen eenmaal de gelatine (1845) en de maïzena (1862) waren uitgevonden, ging het snel. In Engeland, en later ook in ons land, verschenen boeken waarin werd uitgelegd hoe je pudding eenvoudig in allerlei vormen kon modelleren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab80bf27-fe01-3b91-b9a4-9c07b98768d9",
                                        "entry_id": "ae01b04d-9ee7-36d0-9353-10402fb3df12",
                                        "glosses": [
                                            "gerecht bereid uit meel of fijngemaakt brood, niervet en specerijen, aangevuld met gemalen vleesresten in de vorm van een soort worst of aangevuld met melk en eieren tot een beslag dat geperst in een doek of zak wordt gekookt"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db7664fb-6c07-49f5-8155-b5c43aa06eb2",
                                                "sense_id": "ab80bf27-fe01-3b91-b9a4-9c07b98768d9",
                                                "text": "⧖ Dog in alles moet men de middel-maat houden; want alle gebak, als wafels, panne koeken, susters, broeders, poffen, timpjes, witte-brood, engelse kaeks,pudding, en diergelyke van die soort, sijn bequaam om verstoptheden te maken: de kinderen, die veel van dese spyzen eten, krygen wormen en harde buiken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
