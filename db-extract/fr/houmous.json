                "senses": [
                    {
                        "sense_id": "69182df4-447c-3cd8-8096-771ee7c91186",
                        "entry_id": "e4a51fa0-bae2-3b21-a91a-3bfa65a68744",
                        "glosses": [
                            "Préparation culinaire du Moyen-Orient, composée notamment de purée de pois chiches et de tahini (aussi appelé « tahina »)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7adf06cc-0e13-4e68-80e1-0ca0153bff6d",
                                "sense_id": "69182df4-447c-3cd8-8096-771ee7c91186",
                                "text": "Ce café-bar rétro au style décalé mitonne salades, sandwichs, quiches, houmous, assiettes de fromage et de charcuterie et nombreux plats végétariens pour une clientèle tendance."
                            },
                            {
                                "example_id": "73d480f0-3a7a-4fe1-a8d8-94c9cd8df117",
                                "sense_id": "69182df4-447c-3cd8-8096-771ee7c91186",
                                "text": "Je commande toujours la même chose : du houmous allégé avec des graines germées et deux tranches de pain aux flocons d'avoine ([…])."
                            },
                            {
                                "example_id": "adb28d3a-cc70-49bb-a07a-1a1c85e9ad77",
                                "sense_id": "69182df4-447c-3cd8-8096-771ee7c91186",
                                "text": "Le rayon oriental […] alignait tout de même huit variétés différentes de houmous dont l’abugosh premium, le misadot, le zaatar et le rarissime mesabecha."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "267a832f-1fc2-4ca0-82b2-f557bbde29bb",
                        "source_entry_id": "e4a51fa0-bae2-3b21-a91a-3bfa65a68744",
                        "source_sense_id": "69182df4-447c-3cd8-8096-771ee7c91186",
                        "target_lang_word": "Hummus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hummus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                        "entry_id": "0a252941-c573-324b-afe3-47f43de31ff4",
                                        "glosses": [
                                            "Brei aus Kichererbsen mit verschiedenen Gewürzen und Ölen, der traditionell im arabischen Raum und Israel als Vorspeise mit Fladenbrot gegessen wird"
                                        ],
                                        "tags": [
                                            "orientalische Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90633da-ff56-436a-80e3-aa68fcd0c079",
                                                "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                                "text": "„Das Steak in Scheiben schneiden und zusammen mit dem Salat, der Kresse, dem Hummus und der sauren Sahne auf dem Wrap anrichten.“"
                                            },
                                            {
                                                "example_id": "c18ea376-41c5-412e-b04a-7d864e242c44",
                                                "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                                "text": "„Abends saßen alle zusammen bei einem großen Abendessen mit Hammelfleisch, Hummus und Tabouleh und schauten sich den Empfang des sächsischen Ministerpräsidenten beim Bildungsminister von Abu Dhabi an.“"
                                            },
                                            {
                                                "example_id": "1123bd1f-252b-4a7c-9052-aaffdcc2ae54",
                                                "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                                "text": "„Durch den Rauch des Spießbraters lief ich am Hummus-Mann vorüber, er schloß gerade sein Geschäft, denn es war schon Nachmittag, und Hummus ist das arabische Frühstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6f16e37-1346-4d22-913e-e82a76d89102",
                        "source_entry_id": "e4a51fa0-bae2-3b21-a91a-3bfa65a68744",
                        "source_sense_id": "69182df4-447c-3cd8-8096-771ee7c91186",
