                    "frequency": "Middle",
                    "semantic_group_id": "cours d'eau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La Seine <w>arrose</w> la capitale française avant de poursuivre sa course vers la mer."
                        },
                        {
                            "text": "Cette jolie rivière <w>arrose</w> plusieurs villages pittoresques de la vallée."
                        }
                    ],
                    "synonyms": [
