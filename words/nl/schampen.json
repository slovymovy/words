{
    "word_family": [
        "schamp",
        "schamper",
        "schampschot"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e5613f1-2e9e-3b70-aa20-713aad1e1320",
                    "sense_definition": "Een stilstaand of bewegend voorwerp rakelings raken of scheren.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rakelings_raken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een vrachtauto werd op die overweg <w>geschampt</w> door een voorbijrazende trein.",
                            "target_lang_translations": {
                                "en": "A truck was <w>grazed</w> by a speeding train at that level crossing."
                            }
                        },
                        {
                            "text": "De kogel bleek de muur slechts te <w>schampen</w> zonder veel schade aan te richten.",
                            "target_lang_translations": {
                                "en": "The bullet turned out to only <w>graze</w> the wall without causing much damage."
                            }
                        }
                    ],
                    "synonyms": [
                        "scheren",
                        "raken",
                        "schrammen"
                    ],
                    "common_phrases": [
                        "rakelings schampen"
                    ],
                    "target_lang_definitions": {
                        "en": "To touch or scrape a stationary or moving object lightly in passing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "graze",
                                "target_lang_sense_clarification": "to touch or scrape lightly in passing"
                            },
                            {
                                "target_lang_word": "brush against",
                                "target_lang_sense_clarification": "to make light contact with"
                            },
                            {
                                "target_lang_word": "sideswipe",
                                "target_lang_sense_clarification": "to strike along the side in passing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0b72575-55da-3076-b0c6-510532748815",
                    "sense_definition": "Elkaar als tegenliggers of passerende objecten rakelings raken.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rakelings_raken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De beide vrachtwagens <w>schampten</w> elkaar, maar de schade viel wonder boven wonder mee.",
                            "target_lang_translations": {
                                "en": "The two trucks <w>sideswiped</w> each other, but miraculously the damage was not too bad."
                            }
                        },
                        {
                            "text": "In de smalle straat <w>schampten</w> de twee auto's elkaar langs de spiegels.",
                            "target_lang_translations": {
                                "en": "In the narrow street, the two cars <w>grazed</w> each other along the mirrors."
                            }
                        }
                    ],
                    "synonyms": [
                        "elkaar schrammen"
                    ],
                    "common_phrases": [
                        "elkaar schampen"
                    ],
                    "target_lang_definitions": {
                        "en": "To touch or scrape each other lightly when passing from opposite directions or moving past one another."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sideswipe each other",
                                "target_lang_sense_clarification": "to strike each other's sides in passing"
                            },
                            {
                                "target_lang_word": "graze each other",
                                "target_lang_sense_clarification": "to touch each other lightly in passing"
                            },
                            {
                                "target_lang_word": "brush past each other",
                                "target_lang_sense_clarification": "to make light contact while passing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}