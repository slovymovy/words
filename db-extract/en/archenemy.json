                    },
                    {
                        "translation_id": "0cea9d9a-a747-472e-a51b-26011cb5e2a4",
                        "source_entry_id": "f6da5d8e-bb4e-30ff-a0ba-8e0ab453e753",
                        "source_sense_description": "a principal enemy",
                        "target_lang_word": "ennemi juré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ennemi juré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1536009d-0554-33b2-b0a9-84ba34004426",
                                        "entry_id": "7791a279-404f-3a24-9bbc-15dc632afe6a",
                                        "glosses": [
                                            "Pire ennemi, ennemi nourrissant une haine réciproque à l’encontre du sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dff4e99-f738-404c-9ff7-2f7172953de1",
                                                "sense_id": "1536009d-0554-33b2-b0a9-84ba34004426",
                                                "text": "Ami du cher garçon que voici, mais ennemi résolu, ennemi juré, ennemi mortel de son mariage."
                                            },
                                            {
                                                "example_id": "ba400a1f-1bab-42a7-964d-669b7ca4d772",
                                                "sense_id": "1536009d-0554-33b2-b0a9-84ba34004426",
                                                "text": "Abraham trottinait au milieu des autres, mais il n’aimait pas se retrouver là, à prêter main-forte à ses ennemis jurés, les Anglais."
                                            },
                                            {
                                                "example_id": "ce1ccc58-1804-4335-8c9b-0cc84ec9465c",
                                                "sense_id": "1536009d-0554-33b2-b0a9-84ba34004426",
                                                "text": "Ces deux-là sont des ennemis jurés. Ils se détestent mutuellement et sont irréconciliables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44ee97bf-1918-4b74-b1cd-49e79d941d36",
                        "source_entry_id": "f6da5d8e-bb4e-30ff-a0ba-8e0ab453e753",
                        "source_sense_description": "a principal enemy",
                        "target_lang_word": "Erzfeind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzfeind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38f4eec4-1a5b-3108-85ba-86cfea009aa9",
                                        "entry_id": "ba4948c9-d8ad-3a33-a10e-fdc3bbd849fe",
                                        "glosses": [
                                            "schlimmster, langjähriger Feind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb9b0757-75a5-4230-9f75-66abe84bb5fa",
                                                "sense_id": "38f4eec4-1a5b-3108-85ba-86cfea009aa9",
                                                "text": "Prof. Dr. Feinfinger ist Käpt’n Blaubärs Erzfeind und Fernschachgegner."
                                            },
                                            {
                                                "example_id": "f05d91d6-3506-47a5-86b7-d6baa059f6e6",
                                                "sense_id": "38f4eec4-1a5b-3108-85ba-86cfea009aa9",
                                                "text": "„Der Erzfeind des Okzidents hängt an meiner Zimmerwand, und, was soll ich sagen, ich mag ihn.“"
                                            },
                                            {
                                                "example_id": "a98587e2-b09e-4257-8775-942c4621fc34",
                                                "sense_id": "38f4eec4-1a5b-3108-85ba-86cfea009aa9",
                                                "text": "„Die äthiopische Regierung hat das unfruchtbare Land, rund sechzig Kilometer südlich der Grenze zum Erzfeind Eritrea, für die Errichtung eines Flüchtlingslagers ausgewiesen.“"
                                            },
                                            {
                                                "example_id": "1052a0da-afc7-43db-be94-c46aacaf99f0",
                                                "sense_id": "38f4eec4-1a5b-3108-85ba-86cfea009aa9",
                                                "text": "„Irgendwann Anfang der Sechzigerjahre hatten die Magyaren bei den Landtagswahlen in den ungarischen Komitaten einfach alle Erzfeinde der Habsburger Monarchie zu Abgeordneten gewählt, nicht nur den eigenen Revolutionär Kossuth, sondern auch Garribaldi und sogar Napoleon III.“"
                                            },
                                            {
                                                "example_id": "67d4fa81-a6a8-4d7a-8843-3549779fd243",
                                                "sense_id": "38f4eec4-1a5b-3108-85ba-86cfea009aa9",
                                                "text": "„Aurangzeb verlegte nun seine Hauptstadt nach Aurangabad, um seine Erzfeinde aus nächster Nähe bekämpfen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f32d0cd4-e16b-49e6-9bb1-cb5fb2a9978f",
                        "source_entry_id": "f6da5d8e-bb4e-30ff-a0ba-8e0ab453e753",
                        "source_sense_description": "a principal enemy",
                        "target_lang_word": "Erzfeindin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
