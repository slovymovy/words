                                "sense_id": "0e3acb9c-8964-39bc-a90c-80b2c03873ca",
                                "text": "Don't even think about the odds that Bobby Schmautz of Vancouver Canucks would score the winning goal or that Greg Polis of Pittsburgh Penguins would win the car."
                            },
                            {
                                "example_id": "54500419-6798-4a4b-a645-46e0cf3ef5a8",
                                "sense_id": "0e3acb9c-8964-39bc-a90c-80b2c03873ca",
                                "text": "Carol Polis, who figures she's the world's only lady boxing judge, is having the time of her life— but two things bother her a bit."
                            },
                            {
                                "example_id": "352f28d4-192f-479a-9067-c25ba2f402a2",
                                "sense_id": "0e3acb9c-8964-39bc-a90c-80b2c03873ca",
                                "text": "Jared Polis of Boulder is the first openly gay man elected to Congress as a non-incumbent."
                            }
                        ]
                    }
