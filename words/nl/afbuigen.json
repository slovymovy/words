            "senses": [
                {
                    "sense_id": "d9459364-afa6-3206-a8d2-c7e879126f02",
                    "sense_definition": "geleidelijk van richting veranderen of een bocht maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De automobilist merkte dat de weg plotseling naar links <w>afboog</w>.",
                            "target_lang_translations": {
                                "en": "The driver noticed that the road suddenly <w>curved</w> to the left."
                            }
                        },
                        {
                            "text": "De laserstraal werd door het glas een klein stukje <w>afgebogen</w>.",
                            "target_lang_translations": {
                                "en": "The laser beam was slightly <w>deflected</w> by the glass."
                            }
                        }
                    ],
                    "synonyms": [
                        "afslaan",
                        "zwenken"
                    ],
                    "common_phrases": [
                        "naar rechts afbuigen",
                        "naar links afbuigen"
                    ],
                    "target_lang_definitions": {
                        "en": "to gradually change direction, curve, or bend; to deflect"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bend",
                                "target_lang_sense_clarification": "road or path curving"
                            },
                            {
                                "target_lang_word": "curve",
                                "target_lang_sense_clarification": "to follow a curved path"
                            },
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "change direction"
                            },
                            {
                                "target_lang_word": "deflect",
                                "target_lang_sense_clarification": "light, ray, or object changing course"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f85d303-bad1-30eb-80a8-90ce5c434882",
                    "sense_definition": "zich afsplitsen van een hoofdroute of hoofdstroom",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voorbij de brug <w>buigt</w> een smal bospad van de hoofdweg <w>af</w>.",
                            "target_lang_translations": {
                                "en": "Past the bridge, a narrow forest trail <w>branches off</w> from the main road."
                            }
                        },
                        {
                            "text": "De rivier <w>boog</w> hier <w>af</w> in twee kleinere beekjes.",
                            "target_lang_translations": {
                                "en": "The river <w>diverged</w> here into two smaller streams."
                            }
                        }
                    ],
                    "synonyms": [
                        "afsplitsen",
                        "aftakken"
                    ],
                    "common_phrases": [
                        "van de weg afbuigen"
                    ],
                    "target_lang_definitions": {
                        "en": "to branch off or diverge from a main route or flow"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "branch off",
                                "target_lang_sense_clarification": "split from a main route"
                            },
                            {
                                "target_lang_word": "diverge",
                                "target_lang_sense_clarification": "split into separate directions"
                            },
                            {
                                "target_lang_word": "fork",
                                "target_lang_sense_clarification": "separate into branches"
                            }
                        ]
                    }
                }
            ]
        }
    ]
