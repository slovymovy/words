                ],
                "senses": [
                    {
                        "sense_id": "2d75d7ce-2e05-3914-a7a9-1eb0d32cdf92",
                        "entry_id": "6a104950-0b81-3e05-9a0a-670307c06896",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8f5e4ea-601b-44ba-b6c9-d95057347c98",
                                "sense_id": "2d75d7ce-2e05-3914-a7a9-1eb0d32cdf92",
                                "text": "Frau Häßler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cd9f54e3-dd8f-41f1-8fec-210b027adf3e",
                                "sense_id": "2d75d7ce-2e05-3914-a7a9-1eb0d32cdf92",
                                "text": "Herr Häßler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "028acd6d-b1d1-47d7-aa69-f0867371b7db",
                                "sense_id": "2d75d7ce-2e05-3914-a7a9-1eb0d32cdf92",
                                "text": "Die Häßlers fahren heute ins Sauerland."
                            },
                            {
                                "example_id": "4c65ba0f-d598-409b-ada4-e47131b9a102",
                                "sense_id": "2d75d7ce-2e05-3914-a7a9-1eb0d32cdf92",
                                "text": "Der Häßler trägt nie die Schals, die die Häßler ihm strickt."
                            },
                            {
                                "example_id": "daf11b9c-7854-4c60-a7fb-c1674c3524ba",
                                "sense_id": "2d75d7ce-2e05-3914-a7a9-1eb0d32cdf92",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Häßler kommt, geht der Herr Häßler.“"
                            },
                            {
                                "example_id": "27b1e6a0-77f3-449a-910f-df2afa551906",
                                "sense_id": "2d75d7ce-2e05-3914-a7a9-1eb0d32cdf92",
                                "text": "Häßler kommt und geht."
                            },
                            {
                                "example_id": "a63196d9-63a5-4a75-9e8b-7658a343b3e9",
                                "sense_id": "2d75d7ce-2e05-3914-a7a9-1eb0d32cdf92",
                                "text": "Häßlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
