                "senses": [
                    {
                        "sense_id": "ff2f6677-275a-3eab-b47b-55903f381e42",
                        "entry_id": "19dffa39-c6b2-3f9c-84de-f708379fa3a5",
                        "glosses": [
                            "Donner un caractère invulnérable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4ce156a-8b3b-441b-bef5-5ce5870c3c9a",
                                "sense_id": "ff2f6677-275a-3eab-b47b-55903f381e42",
                                "text": "Il faut rendre aux marchés financiers ce qui leur appartient: l'invention du principe de précaution, radical au point d'invulnérabiliser leur propre activité des effets des risques qu’ils engendrent et qu’ils reportent sur d’autres acteurs sociaux."
                            },
                            {
                                "example_id": "0d3b3a06-8ab8-4b9a-8124-b900d8bf03ff",
                                "sense_id": "ff2f6677-275a-3eab-b47b-55903f381e42",
                                "text": "Vos tapeurs devront se relayer pour placer leurs grosses attaques de sorte à ne pas invulnérabiliser le monstre."
                            },
                            {
                                "example_id": "801200eb-41e1-4cfb-bae1-0ad08d5a05de",
                                "sense_id": "ff2f6677-275a-3eab-b47b-55903f381e42",
                                "text": "Puis il vit qu'il n'arrivait plus à invulnérabiliser sa peau contre la magie."
                            }
                        ]
                    }
                ],
