                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De patiënt heeft al weken last van vage <w>klachten</w> in de onderrug.",
                            "target_lang_translations": {
                                "en": "The patient has been suffering from vague <w>complaints</w> in the lower back for weeks."
                            }
                        },
                        {
                            "text": "Bij aanhoudende lichamelijke <w>klachten</w> is het verstandig om een dokter te bezoeken.",
                            "target_lang_translations": {
