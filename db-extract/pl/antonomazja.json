                                    {
                                        "sense_id": "f96d5970-2144-3779-a464-1d21518b14df",
                                        "entry_id": "707f4b6a-c3b0-36b6-b8b0-be5096543c63",
                                        "glosses": [
                                            "Sinécdoque que usa el nombre apelativo en vez del propio o el propio por el apelativo."
                                        ],
                                        "tags": [
                                            "Retórica"
                                        ],
                                        "examples": [
                                            {
