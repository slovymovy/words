                "senses": [
                    {
                        "sense_id": "bb994b06-3567-3f03-8c68-d762b7945457",
                        "entry_id": "dde641a3-5db5-3805-8df2-31e6232188a3",
                        "glosses": [
                            "Person, die in einem Pflegeheim, Krankenhaus oder einer ähnlichen Einrichtung tätig ist und sich dort um pflegebedürftige Menschen kümmert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e9c961-2344-4306-8271-82c18652841b",
                                "sense_id": "bb994b06-3567-3f03-8c68-d762b7945457",
                                "text": "Die Bezahlung der Pflegekräfte ist viel zu niedrig."
                            },
                            {
                                "example_id": "dd1c8972-23bf-46b3-9f2e-57ec13a0d85e",
                                "sense_id": "bb994b06-3567-3f03-8c68-d762b7945457",
                                "text": "Im Pflegeheim trifft man kaum eine Pflegekraft an, die mit ihren Arbeitsbedingungen zufrieden ist."
                            },
                            {
                                "example_id": "346d7ee0-6b8c-4028-b4b4-cf7b6ab6e345",
                                "sense_id": "bb994b06-3567-3f03-8c68-d762b7945457",
                                "text": "Es herrscht ein großer Mangel an Pflegekräften."
                            },
                            {
                                "example_id": "c137e2c0-b7fc-4d83-8364-d6489e392b8a",
                                "sense_id": "bb994b06-3567-3f03-8c68-d762b7945457",
                                "text": "„Am Ende wurde er auch immer paranoider und hatte den Verdacht, dass sie und die Pflegekräfte heimlich planten, ihm umzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
