                ],
                "translations": [
                    {
                        "translation_id": "f2f53685-a561-468a-9348-b81d29a890f9",
                        "source_entry_id": "e67779bb-ee99-31d5-870b-5405ee7e67fd",
                        "source_sense_id": "15150eb3-f657-3864-b652-520178b24534",
                        "source_sense_description": "afloop, resultaat",
                        "target_lang_word": "Ergebnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ergebnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                        "entry_id": "1f409ce0-bbfa-33cd-be2e-f7f7b3a9ed3c",
                                        "glosses": [
                                            "das, was bei einem Vorgang herauskommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4cc74dd-b816-44a8-90d7-4ef57a8ca830",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "Das Ergebnis seiner Bemühungen war gleich null."
                                            },
                                            {
                                                "example_id": "be5d81db-af08-4f14-8f2f-7a0d0dc75574",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "Das Ergebnis der Berechnung lautet 42."
                                            },
                                            {
                                                "example_id": "1cbba5ef-06ca-4151-8d6c-834cc57d2de5",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "„Die Ergebnisse wurden als Empfehlungen an den DAeC weitergeleitet, denn beschließen können die Segelflieger nichts, weil sie bislang – ebenso wie die Motorflieger, Modellflieger, Ballonfahrer und Fallschirmsportler – keine selbständige Sparte innerhalb des DAeC bilden, der den gesamten Luftsport beim Internationalen Luftfahrt-Verband (FAI) vertritt.“"
                                            },
                                            {
                                                "example_id": "2d1d305b-eb18-4fc0-85d4-fd5e0f0a0ea8",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "„Nahe dem Äquator gedeihen Bäume in strahlender Sonne, heftigem Regen und ganzjähriger Wärme. Das Ergebnis ist ein dichter tropischer Regenwald, eines der artenreichsten Gebiete der Erde.“"
                                            },
                                            {
                                                "example_id": "3ecf72dc-b32e-495f-92ce-09b3c6c190e7",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "„Das Hauptgewicht liegt in Deutschland auf dem Fachunterricht, der den praktischen Ausbildungsgang begleitet, ergänzt, die dort gewonnenen Ergebnisse sammelt, ordnet, vertieft und befestigt.“"
                                            },
                                            {
                                                "example_id": "bfa33a89-0b49-49eb-b24a-4cdbd037fb26",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "„Die Ergebnisse der Italien-Reise erlaubten es Leibniz, einen stringenten Plan der Welfengeschichte zu konzipieren, den er nun seinem Herzog mit der Versicherung vorlegte, das Werk in zwei Jahren abschließen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "909b1ad1-d50a-4809-b776-a4ced3affa38",
                        "source_entry_id": "e67779bb-ee99-31d5-870b-5405ee7e67fd",
                        "source_sense_id": "15150eb3-f657-3864-b652-520178b24534",
                        "source_sense_description": "afloop, resultaat",
                        "target_lang_word": "result",
                        "target_lang_code": "en",
