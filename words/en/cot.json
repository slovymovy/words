    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "31dc2cdc-6635-3738-bdbf-ab4ab508c0a6",
                    "sense_definition": "A bed for infants or small children, with high, often slatted, often moveable sides.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby slept peacefully in her wooden <w>cot</w> all night.",
                            "target_lang_translations": {
                                "pl": "Dziecko spało spokojnie w swoim drewnianym <w>łóżeczku</w> przez całą noc.",
                                "zh": "宝宝整夜都安稳地睡在她的木制<w>婴儿床</w>里。"
                            }
                        },
                        {
                            "text": "We need to buy a new <w>baby cot</w> before the newborn arrives.",
                            "target_lang_translations": {
                                "pl": "Musimy kupić nowe <w>łóżeczko dziecięce</w>, zanim pojawi się noworodek.",
                                "zh": "在新生儿出生之前，我们得买一张新的<w>婴儿床</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crib"
                    ],
                    "common_phrases": [
                        "baby cot"
                    ],
                    "target_lang_definitions": {
                        "pl": "Łóżeczko dla niemowląt lub małych dzieci, z wysokimi, często szczebelkowymi i ruchomymi bokami.",
                        "zh": "供婴儿或幼儿睡觉的小床，四周较高，通常有栏杆，且常可移动。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łóżeczko",
                                "target_lang_sense_clarification": "dziecięce"
                            },
                            {
                                "target_lang_word": "łóżeczko dziecięce",
                                "target_lang_sense_clarification": "pełna nazwa"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "婴儿床",
                                "target_lang_sense_clarification": "婴儿或幼儿用的带护栏小床"
                            },
                            {
                                "target_lang_word": "婴儿小床",
                                "target_lang_sense_clarification": "较正式的全称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b77201d6-6626-30b2-a355-0835a8659715",
                    "sense_definition": "A simple bed, especially one for portable or temporary purposes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He slept on a folding <w>cot</w> in the living room during his visit.",
                            "target_lang_translations": {
                                "pl": "Podczas swojej wizyty spał na składanym <w>łóżku polowym</w> w salonie.",
                                "zh": "他来访期间睡在客厅的一张折叠<w>行军床</w>上。"
                            }
                        },
                        {
                            "text": "The soldiers set up a <w>camp cot</w> inside each tent.",
                            "target_lang_translations": {
                                "pl": "Żołnierze rozstawili <w>kanadyjkę</w> w każdym namiocie.",
                                "zh": "士兵们在每顶帐篷里都搭起了一张<w>行军床</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "camp bed"
                    ],
                    "common_phrases": [
                        "camp cot",
                        "folding cot"
                    ],
                    "target_lang_definitions": {
                        "pl": "Proste łóżko, zwłaszcza przenośne lub przeznaczone do użytku tymczasowego.",
                        "zh": "一种简易床，尤指便携式或临时使用的床。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łóżko polowe",
                                "target_lang_sense_clarification": "składane, turystyczne"
                            },
                            {
                                "target_lang_word": "kanadyjka",
                                "target_lang_sense_clarification": "lekkie łóżko polowe"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行军床",
                                "target_lang_sense_clarification": "简易、可折叠、临时使用的床"
                            },
                            {
                                "target_lang_word": "折叠床",
                                "target_lang_sense_clarification": "便携式简易床"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9a86c13-4245-3e12-979d-33f1a7eaea70",
                    "sense_definition": "A cottage or small homestead.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dwellings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet wrote about the peaceful life in a rustic <w>cot</w>.",
                            "target_lang_translations": {
                                "pl": "Poeta pisał o spokojnym życiu w wiejskiej <w>chatce</w>.",
                                "zh": "诗人描写了乡间<w>小屋</w>中的宁静生活。"
                            }
                        },
                        {
                            "text": "They lived in a humble <w>cot</w> near the edge of the forest.",
                            "target_lang_translations": {
                                "pl": "Mieszkali w skromnej <w>chacie</w> na skraju lasu.",
                                "zh": "他们住在森林边缘一间简陋的<w>小屋</w>里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rustic cot"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in poetic or archaic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mała wiejska chatka lub skromne gospodarstwo domowe.",
                        "zh": "小村舍或小型农家住宅。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "chatka",
                                "target_lang_sense_clarification": "skromny wiejski dom"
                            },
                            {
                                "target_lang_word": "chata",
                                "target_lang_sense_clarification": "wiejska"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小屋",
                                "target_lang_sense_clarification": "古旧或诗性用法中的乡间住屋"
                            },
                            {
                                "target_lang_word": "茅舍",
                                "target_lang_sense_clarification": "乡村简陋住处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "146a1014-5bb9-3e49-a8f7-fd027d38477b",
                    "sense_definition": "A pen, coop, or similar shelter for small domestic animals, such as sheep or pigeons.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_shelters",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer kept the sheep safe inside the <w>cot</w> during the storm.",
                            "target_lang_translations": {
                                "pl": "Podczas burzy rolnik trzymał owce bezpieczne w <w>zagrodzie</w>.",
                                "zh": "暴风雨期间，农夫把羊安全地关在<w>羊圈</w>里。"
                            }
                        },
                        {
                            "text": "They built a small <w>cot</w> to protect the animals from predators.",
                            "target_lang_translations": {
                                "pl": "Zbudowali mały <w>kojec</w>, aby chronić zwierzęta przed drapieżnikami.",
                                "zh": "他们建了一个小<w>畜栏</w>来保护动物不受捕食者侵害。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cote"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "often spelled as 'cote'"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zagroda, kurnik lub podobne schronienie dla małych zwierząt domowych, takich jak owce lub gołębie.",
                        "zh": "供羊、鸽子等小型家养动物使用的围栏、棚舍或类似的栖身处。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zagroda",
                                "target_lang_sense_clarification": "dla zwierząt"
                            },
                            {
                                "target_lang_word": "owczarnia",
                                "target_lang_sense_clarification": "dla owiec"
                            },
                            {
                                "target_lang_word": "kurnik",
                                "target_lang_sense_clarification": "dla ptactwa"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "羊圈",
                                "target_lang_sense_clarification": "羊等家畜的围栏或棚舍"
                            },
                            {
                                "target_lang_word": "畜栏",
                                "target_lang_sense_clarification": "小型家畜圈栏的泛称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be284e42-d37d-3b39-ab87-113f502dfd28",
                    "sense_definition": "A cover or sheath; a fingerstall.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "covers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse placed a protective <w>finger cot</w> over his cut.",
                            "target_lang_translations": {
                                "pl": "Pielęgniarka nałożyła ochronną <w>osłonkę na palec</w> na jego skaleczenie.",
                                "zh": "护士在他的伤口外套上了一个保护用的<w>指套</w>。"
                            }
                        },
                        {
                            "text": "He wore a rubber <w>cot</w> to keep the injured finger dry.",
                            "target_lang_translations": {
                                "pl": "Nosił gumowy <w>naparstek</w>, aby utrzymać zraniony palec w suchości.",
                                "zh": "他戴着一个橡胶<w>指套</w>，以保持受伤的手指干燥。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "finger cot"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pokrowiec, osłona lub nakładka ochronna na palec.",
                        "zh": "护套、套罩；尤指套在手指上的保护套。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "naparstek gumowy",
                                "target_lang_sense_clarification": "ochronny na palec"
                            },
                            {
                                "target_lang_word": "osłonka na palec",
                                "target_lang_sense_clarification": "medyczna lub ochronna"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指套",
                                "target_lang_sense_clarification": "套在手指上的保护套，常见于医疗场景"
                            },
                            {
                                "target_lang_word": "护指套",
                                "target_lang_sense_clarification": "较具体地指橡胶或防护用指套"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67d17292-2646-3959-947d-5ae6919118b6",
                    "sense_definition": "A wooden bed frame, slung by its corners from a beam, in which officers slept before the introduction of bunks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer retired to his swinging <w>cot</w> as the ship rolled.",
                            "target_lang_translations": {
                                "pl": "Oficer udał się na spoczynek do swojej kołyszącej się <w>koi wiszącej</w>, gdy statek się kołysał.",
                                "zh": "船身摇晃时，军官回到他的<w>吊床</w>上休息。"
                            }
                        },
                        {
                            "text": "In the old days, a suspended <w>cot</w> was the standard sleeping arrangement at sea.",
                            "target_lang_translations": {
                                "pl": "W dawnych czasach podwieszane <w>łóżko</w> było standardowym miejscem do spania na morzu.",
                                "zh": "过去，海上标准的睡铺是悬挂式<w>吊床</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical naval usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Drewniana rama łóżka, zawieszona za rogi na belce, na której sypiali oficerowie przed wprowadzeniem koi.",
                        "zh": "一种旧时船上使用的木制床架，四角悬挂在横梁上，曾供军官睡卧，流行于固定铺位出现之前。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "koja wisząca",
                                "target_lang_sense_clarification": "historyczne łóżko okrętowe"
                            },
                            {
                                "target_lang_word": "hamak oficerski",
                                "target_lang_sense_clarification": "w formie zawieszonego łóżka"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吊床",
                                "target_lang_sense_clarification": "旧时船上悬挂的睡具"
                            },
                            {
                                "target_lang_word": "悬挂床铺",
                                "target_lang_sense_clarification": "历史上的舰船睡铺"
                            }
                        ]
                    }
