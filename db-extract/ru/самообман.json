                    {
                        "translation_id": "83b536ef-3b60-4025-af64-e69a8cc4e4e5",
                        "source_entry_id": "bb9c7352-893d-3293-b833-0e1333b3c59e",
                        "source_sense_id": "05265cc6-cf2a-3181-90d2-5f932c4e611e",
                        "target_lang_word": "Selbstbetrug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstbetrug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42877b00-2be8-3649-8ecf-6b37b47e1544",
                                        "entry_id": "b4103ace-e70a-3964-9673-87f5e4e7c8fc",
                                        "glosses": [
                                            "Versuch, sich über sich selbst, sein Leben, seine Bedeutung zu täuschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f8c1423-b7c8-4ca7-a1c1-933ee557554d",
                                                "sense_id": "42877b00-2be8-3649-8ecf-6b37b47e1544",
                                                "text": "„Verloren an die Wahrheit gönne ich mir zuweilen einsam eine Prise Selbstbetrug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "446b4e30-2393-4eac-9fb9-ac601f80bbf9",
                        "source_entry_id": "bb9c7352-893d-3293-b833-0e1333b3c59e",
                        "source_sense_id": "05265cc6-cf2a-3181-90d2-5f932c4e611e",
                        "target_lang_word": "Selbsttäuschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbsttäuschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f1256c7-f20e-3bd1-8ca8-804e460c3cac",
                                        "entry_id": "a5e4c53f-c985-344e-a80a-7af619344f15",
                                        "glosses": [
                                            "Mangel/Fehlen an realistischer Einschätzung der eigenen Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f16e1f1-2378-45b0-af70-1d5d023a3806",
                                                "sense_id": "2f1256c7-f20e-3bd1-8ca8-804e460c3cac",
                                                "text": "„Doch zu einem guten Teil entsprang Churchills Urteil über Potsdam auch der Selbsttäuschung oder Selbstüberschätzung.“"
                                            },
                                            {
                                                "example_id": "e17498e5-431b-49e1-9e6d-943e2c7be20e",
                                                "sense_id": "2f1256c7-f20e-3bd1-8ca8-804e460c3cac",
                                                "text": "„Man fragt sich, ob diese pathetischen Auslassungen ernst gemeint sind oder ob Jünger absichtlicher Selbsttäuschung erliegt, um nicht die notwendigen Konsequenzen als Soldat und Mensch ziehen zu müssen.“"
                                            },
                                            {
                                                "example_id": "9c9340a8-d1b6-4b25-8369-eb2ccde52785",
                                                "sense_id": "2f1256c7-f20e-3bd1-8ca8-804e460c3cac",
                                                "text": "„Ich fühlte mich zum ersten Mal halbwegs wohl in dieser Wohnung; es war warm und sauber, und ich dachte, als ich meinen Mantel an den Kleiderhaken hängte und meine Guitarre in die Ecke stellte, darüber nach, ob eine Wohnung vielleicht doch etwas mehr als eine Selbsttäuschung ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e3a3135-974f-4786-a5b5-391e48af2f97",
                        "source_entry_id": "bb9c7352-893d-3293-b833-0e1333b3c59e",
                        "source_sense_id": "05265cc6-cf2a-3181-90d2-5f932c4e611e",
                        "target_lang_word": "auto-illusion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auto-illusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59f89996-b4da-31e4-a06d-4fa263abf28e",
                                        "entry_id": "52119ac5-85c3-32d0-bc1f-834d6bb1bacb",
                                        "glosses": [
                                            "Fausse image que l’on se fait de soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c9987d-3774-4333-9009-d952dd0d6d2d",
                                                "sense_id": "59f89996-b4da-31e4-a06d-4fa263abf28e",
                                                "text": "L’imposture et l’auto-illusion forment donc deux fabrications distinctes dont le point commun réside dans leur intentionnalité. À l'inverse, l’illusion constitue une « défaillance ordinaire » plus ou moins forte du cadre."
                                            },
                                            {
                                                "example_id": "0f12fe86-b438-4f35-a372-593231476ea7",
                                                "sense_id": "59f89996-b4da-31e4-a06d-4fa263abf28e",
                                                "text": "Elle consiste simplement à créer un espace où il est possible de déployer et défaire nos jeux névrotiques, nos auto-illusions, nos peurs et nos espoirs cachés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a52c3d6e-b28e-3024-b10e-953e13e82ca0",
                                        "entry_id": "52119ac5-85c3-32d0-bc1f-834d6bb1bacb",
                                        "glosses": [
                                            "Fausse image, souvent exagérément positive, que l’on se fait soi-même de quelque chose qui suscite l’imagination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "502e1614-fe2e-45aa-81a3-121a30cbe8b8",
                                                "sense_id": "a52c3d6e-b28e-3024-b10e-953e13e82ca0",
                                                "text": "Du roman du réel au roman du fantasme, du novel au romance : c’est là que l’auteur a recours, non seulement à la fiction – cet imaginaire construit à l’usage d’autrui – mais à l’auto-illusion telle que la propose toute fiction dès lors qu’elle met en scène non plus la réalité telle qu’elle est vécue, mais la réalité telle qu’elle est désirée par le sujet, autrement dit fantasmée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
