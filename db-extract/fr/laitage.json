                                "target_senses": [
                                    {
                                        "sense_id": "86a668f9-7937-3b92-b846-355fc3f97b29",
                                        "entry_id": "4fa312a2-1bfb-3ab7-a3f7-c7b64d309781",
                                        "glosses": [
