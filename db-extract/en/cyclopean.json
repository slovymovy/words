                    {
                        "sense_id": "f4d266ad-6f3e-3c7f-bd72-252613d99599",
                        "entry_id": "5ca19357-4951-35fb-938b-a8f1f716e199",
                        "glosses": [
                            "Massive in stature."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "eaa8994f-f69e-4051-9e7c-2835a922bfd0",
                                "sense_id": "f4d266ad-6f3e-3c7f-bd72-252613d99599",
                                "text": "2006, Fernando Pessoa, \"Salutation to Walt Whitman,\" in A Little Larger Than the Entire Universe: Selected Poems, edited and translated by Richard Zenith, Penguin, pp. 198-9,\nYou were cyclopean and muscular, not pretty, / Yet your attitude toward the world was feminine, / And for you each leaf of grass, each stone and each man was the Universe.\nSee also quotation under cyclopian."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f47c952-172f-3038-94cf-f581b93b3b32",
                        "entry_id": "5ca19357-4951-35fb-938b-a8f1f716e199",
                        "glosses": [
                            "Created by combining two images."
                        ],
                        "tags": [
                            "of an image"
                        ],
                        "examples": [
                            {
                                "example_id": "96e4ea12-9efc-4f6f-a379-dc7ed845fc54",
                                "sense_id": "5f47c952-172f-3038-94cf-f581b93b3b32",
                                "text": "When he wrote the word, / the o's were joined / like eyeglass lenses without / a bridge. Cross-eyed, hypnotic, / they threatened to merge, / become Cyclopean. […]"
                            }
                        ]
                    }
                ],
                "translations": [
