        "fr-extract.jsonl": [
            {
                "entry_id": "b2f0117a-c4ef-3eea-9482-82c0e109fd5b",
                "word": "ebendieser",
                "pos": "adj",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5eac7d5-6d5b-3455-81dc-3a7fce3253d4",
                        "entry_id": "b2f0117a-c4ef-3eea-9482-82c0e109fd5b",
                        "glosses": [
                            "Justement ce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72d29ad0-3796-47c9-b78c-75a1641417a0",
                                "sense_id": "a5eac7d5-6d5b-3455-81dc-3a7fce3253d4",
                                "text": "Aus ebendiesem Grund hatte sich Andrew auch mir gegenüber mit einer bloßen Andeutung begnügt.",
                                "translation": "C’est cette même raison qu’Andrew s’était contenté de me donner à demi-mot."
                            },
                            {
                                "example_id": "236d2b2d-ea2b-458b-b183-629e84d45122",
                                "sense_id": "a5eac7d5-6d5b-3455-81dc-3a7fce3253d4",
                                "text": "Er hatte den Alten untersucht und saß jetzt mitten in diesem ärmlichen Esszimmer. Ja, er hatte Angst. Er wusste, dass ihn am nächsten Morgen in ebendieser Vorstadt ein Dutzend über ihren Beulen zusammengekrümmte Kranke erwarten würden.",
                                "translation": "Il avait examiné le vieux et maintenant il était assis au milieu de cette salle à manger misérable. Oui, il avait peur. Il savait que dans le faubourg même une dizaine de malades l’attendraient, le lendemain matin, courbés sur leurs bubons."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
