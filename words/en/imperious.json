{
    "word_family": [
        "imperiously",
        "imperiousness",
        "imperial"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fdaeffca-94b0-38d2-9f08-0a9bdecb8467",
                    "sense_definition": "Behaving in a proud, bossy, or arrogant way as if one is in charge.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "arrogant_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave an <w>imperious</w> wave of her hand to signal that the meeting was over.",
                            "target_lang_translations": {
                                "ru": "Она сделала <w>властный</w> взмах рукой, показывая, что встреча окончена."
                            }
                        },
                        {
                            "text": "The manager had an <w>imperious</w> manner that made all the employees feel uncomfortable.",
                            "target_lang_translations": {
                                "ru": "У руководителя были <w>повелительные</w> замашки, из-за которых все сотрудники чувствовали себя неловко."
                            }
                        }
                    ],
                    "synonyms": [
                        "authoritarian",
                        "bossy",
                        "dictatorial",
                        "domineering",
                        "overbearing"
                    ],
                    "common_phrases": [
                        "imperious tone",
                        "imperious manner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Властный, повелительный, высокомерный в поведении или тоне, словно командующий другими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "властный",
                                "target_lang_sense_clarification": "склонный командовать и подчинять"
                            },
                            {
                                "target_lang_word": "повелительный",
                                "target_lang_sense_clarification": "выражающий приказ или не терпящий возражений"
                            },
                            {
                                "target_lang_word": "начальственный",
                                "target_lang_sense_clarification": "демонстрирующий статус или превосходство начальника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7df4b3d8-ec46-31d0-b25a-db55f2446fef",
                    "sense_definition": "Requiring immediate attention or action; urgent.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "urgency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt an <w>imperious</w> need to leave the room before he lost his temper.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал <w>непреодолимую</w> потребность выйти из комнаты, пока не сорвался."
                            }
                        },
                        {
                            "text": "The <w>imperious</w> demands of the crisis forced the government to act immediately.",
                            "target_lang_translations": {
                                "ru": "<w>Неотложные</w> требования кризиса заставили правительство действовать немедленно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "imperious need",
                        "imperious demand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требующий немедленного внимания или действия; неотложный, настоятельный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоятельный",
                                "target_lang_sense_clarification": "требующий безотлагательного выполнения"
                            },
                            {
                                "target_lang_word": "неотложный",
                                "target_lang_sense_clarification": "срочный, не терпящий отлагательства"
                            },
                            {
                                "target_lang_word": "непреодолимый",
                                "target_lang_sense_clarification": "очень сильный, властно подчиняющий себе (о потребности)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "852d60d2-8552-3d92-b12e-ebab19ca4210",
                    "sense_definition": "Relating to an empire or a ruler; regal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "imperial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The palace was built with an <w>imperious</w> style that reflected the power of the king.",
                            "target_lang_translations": {
                                "ru": "Дворец был построен в <w>величественном имперском</w> стиле, отражавшем могущество короля."
                            }
                        },
                        {
                            "text": "The statue stood in an <w>imperious</w> pose overlooking the entire city square.",
                            "target_lang_translations": {
                                "ru": "Статуя застыла в <w>царственной</w> позе, возвышаясь над всей городской площадью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к империи или правителю; царственный, величественный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "имперский",
                                "target_lang_sense_clarification": "связанный с империей или её величием"
                            },
                            {
                                "target_lang_word": "царственный",
                                "target_lang_sense_clarification": "величественный, подобающий монарху"
                            },
                            {
                                "target_lang_word": "величественный",
                                "target_lang_sense_clarification": "внушительный и исполненный достоинства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}