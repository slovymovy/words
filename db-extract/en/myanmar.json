                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceb78387-7c64-4e07-8dbd-b2a618343bd3",
                                                "sense_id": "31ad6d67-0774-3b6a-b5cf-fbef7939559d",
                                                "text": "Thailand pakt cybercriminaliteit net over de grens in Myanmar keihard aan. Zeshonderd Chinezen die daar tegen hun wil als oplichters opereren, zijn door het Thaise leger bevrijd en vliegen deze week terug naar China."
                                            }
