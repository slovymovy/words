                "senses": [
                    {
                        "sense_id": "ca0b7829-88a8-3d70-a3e8-4d73aed55348",
                        "entry_id": "367c83aa-acbe-3e00-b025-ef05f83c5a79",
                        "glosses": [
                            "Bündel von Schecks (meist in einer Mappe aufbewahrt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3406b7-74d0-4eed-9628-682036b1c4eb",
                                "sense_id": "ca0b7829-88a8-3d70-a3e8-4d73aed55348",
                                "text": "„Mein Scheckbuch liegt immer in einer alten Schachtel in der obersten Schublade meines Sekretärs.“"
                            },
                            {
                                "example_id": "7961a43a-4281-4b35-94ca-0fc3d18876cd",
                                "sense_id": "ca0b7829-88a8-3d70-a3e8-4d73aed55348",
                                "text": "„Schalck zückt sein Scheckbuch.“"
                            },
                            {
                                "example_id": "f62b4dfc-6800-4347-9b7b-27cde152ea51",
                                "sense_id": "ca0b7829-88a8-3d70-a3e8-4d73aed55348",
                                "text": "„Also nehme ich mein Scheckbuch heraus und sehe, dass nur noch ein Scheck übrig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "109e6b4e-5508-4aac-bfef-daa7819d34e4",
                        "source_entry_id": "367c83aa-acbe-3e00-b025-ef05f83c5a79",
                        "source_sense_id": "ca0b7829-88a8-3d70-a3e8-4d73aed55348",
