                                        "examples": [
                                            {
                                                "example_id": "8a6b4b54-2bd9-4310-b20f-76bacaeb6050",
                                                "sense_id": "b86c236f-cfe5-3eec-b5e6-f7e2914fb25f",
                                                "text": "This group includes various degrees of ineffectivity."
                                            },
                                            {
                                                "example_id": "66b4ed38-666a-45bb-a6e7-a68eb2d1fe50",
                                                "sense_id": "b86c236f-cfe5-3eec-b5e6-f7e2914fb25f",
                                                "text": "Nevertheless, the procedure to be described has been useful in beginning the study of problems as varied as those of disease, undesirable conditions, sick or failing communities, inequities in receiving services, or inefficiencies and ineffectivities in the machinery for delivery of services."
                                            },
                                            {
                                                "example_id": "246d5b08-d185-40ff-b2e4-a718edd37230",
                                                "sense_id": "b86c236f-cfe5-3eec-b5e6-f7e2914fb25f",
                                                "text": "To be honest, I have not studied the Linnik-Malyšev proof closely enough to be sure that it does not contain further hidden ineffectivities."
                                            },
                                            {
                                                "example_id": "7ea7c62f-c660-45b6-b60e-d6605a955fae",
                                                "sense_id": "b86c236f-cfe5-3eec-b5e6-f7e2914fb25f",
                                                "text": "Despite the ineffectivities of options 5.1.2.1 and 5.1.2.2, some cases were observed indicating an increasing circadian period with increasing light dark ratio of the test light cycle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
