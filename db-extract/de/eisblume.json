                    {
                        "translation_id": "e2968c27-a95c-45fa-9634-d191e48fd6d7",
                        "source_entry_id": "c9365de7-0cff-3dcd-a70b-523b45670f15",
                        "source_sense_id": "372c7c65-6295-36db-a139-0f1446e1d202",
                        "source_sense_description": "blumenähnliche Gebilde aus Reif auf der Innenseite einfacher Glasscheiben bei starkem Frost",
                        "target_lang_word": "givre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "givre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "721d58da-ab29-30ea-8133-c8f617bee193",
                                        "entry_id": "7bbffe44-0419-348c-90af-e9e064d335da",
                                        "glosses": [
                                            "Légère couche de glace dont se couvrent les arbres, les buissons, etc., quand la température devient assez froide pour congeler l’humidité qui est dans l’air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd5b93b2-0865-485f-81da-7d31d8b254d6",
                                                "sense_id": "721d58da-ab29-30ea-8133-c8f617bee193",
                                                "text": "En quelques jours toutes les feuilles tombèrent, la terre durcit comme de la pierre, et tout se couvrit de givre : les tuiles les pavés et les vitres."
                                            },
                                            {
                                                "example_id": "b77c34c4-f48e-451b-8df5-820cf3c312d3",
                                                "sense_id": "721d58da-ab29-30ea-8133-c8f617bee193",
                                                "text": "Le thermomètre est descendu à -6° ; tout le gréement était couvert de givre et de glace que je dus casser en montant dans la mâture […]"
                                            },
                                            {
                                                "example_id": "bb623165-3155-42f1-832d-d41a7d87ff7a",
                                                "sense_id": "721d58da-ab29-30ea-8133-c8f617bee193",
                                                "text": "Il a fait très frais pendant la nuit, et, ce matin, quand je suis sorti de ma tente, la campagne était étincelante de givre."
                                            },
                                            {
                                                "example_id": "d90d824f-7761-48b1-8c7d-097021867501",
