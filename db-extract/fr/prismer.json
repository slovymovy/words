                "senses": [
                    {
                        "sense_id": "667e65be-b3b6-3419-88ba-5a0acb7dfacf",
                        "entry_id": "af554f4c-eb44-3050-9f04-a0bc37214675",
                        "glosses": [
                            "Traiter (une diplopie) en utilisant un prisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cdbd40a-4b3d-4a4d-ab2c-929bfd462e6a",
                                "sense_id": "667e65be-b3b6-3419-88ba-5a0acb7dfacf",
                                "text": "Il faut prismer à l’angle objectif. À cette condition et en fonction de la déviation, toutes les paralysies peuvent être prismées à l’exception des paralysies du 111 (hors les paralysies partielles)."
                            },
                            {
                                "example_id": "26d78f1d-6eec-4a38-9d2c-9bb2bdbb2c33",
                                "sense_id": "667e65be-b3b6-3419-88ba-5a0acb7dfacf",
                                "text": "Si on essaye de prismer sur l’œil sain, on rencontre la même intolérance."
                            },
                            {
                                "example_id": "a4fcaf2a-45c6-4093-af78-46aa3a1cc838",
                                "sense_id": "667e65be-b3b6-3419-88ba-5a0acb7dfacf",
                                "text": "Il faut toujours essayer de prismer a minima et si possible d’hypo-corriger le sujet dans la mesure où celui-ci supporte cette prismation."
                            },
                            {
                                "example_id": "1a4f63fd-dc01-43ab-be38-13618d5db483",
                                "sense_id": "667e65be-b3b6-3419-88ba-5a0acb7dfacf",
                                "text": "Il faut prendre soin bien entendu de prismer le patient dans l’intervalle."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bb2bdf0-f989-3dbc-9313-1d548f2f7d21",
                        "entry_id": "af554f4c-eb44-3050-9f04-a0bc37214675",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "1fba3d7f-47ba-413a-882c-f101dae8e3d0",
                                "sense_id": "2bb2bdf0-f989-3dbc-9313-1d548f2f7d21",
                                "text": "Pourquoi mon visage se dilate-t-il, se ferme, se forme, se fourne, se déflanque dans les enluminures voraces, se résorbe et se réanime dans les reflets qui se prisment et se déprisment ?"
                            }
                        ]
                    }
