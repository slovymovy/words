                                "target_senses": [
                                    {
                                        "sense_id": "4b5736d5-5786-37d8-b68a-c81cdf3e705a",
                                        "entry_id": "4833b643-b663-3074-8c76-38a2f6da9e11",
                                        "glosses": [
                                            "A fall (an instance of falling over)."
                                        ],
