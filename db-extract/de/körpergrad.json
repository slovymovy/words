                "senses": [
                    {
                        "sense_id": "f35637fd-53f8-3085-b349-8419ab11c97a",
                        "entry_id": "05854c8e-a210-30d1-a35f-e0f10b53e8b6",
                        "glosses": [
                            "Grad/Dimension einer Körpererweiterung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9cedea5-f4be-4a09-a647-7fd6fb3d5ac2",
                                "sense_id": "f35637fd-53f8-3085-b349-8419ab11c97a",
                                "text": "„Unter dem Körpergrad von α₁,…, α₁, über Ω verstehen wir den Relativgrad r des Körpers Ω (α₁, […], α_g) über Ω.“"
                            },
                            {
                                "example_id": "bcb4ec39-3ea9-43d3-a0dd-e2640d39c254",
                                "sense_id": "f35637fd-53f8-3085-b349-8419ab11c97a",
                                "text": "„Wir werden den Körpergrad mit [L:K] und die Charakteristik von K mit % bezeichnen.“"
                            },
                            {
                                "example_id": "a0d7ca31-a947-4b19-87fb-bd968a24272d",
                                "sense_id": "f35637fd-53f8-3085-b349-8419ab11c97a",
                                "text": "„Für festen Körpergrad ist die Komplexität also subexponentiell, aber schlechter als für das Faktorisierungsproblem und das DL-Proplem in GF(p)“.“"
                            },
                            {
                                "example_id": "5598dd0c-c071-45c5-aac7-d2d489c9677d",
                                "sense_id": "f35637fd-53f8-3085-b349-8419ab11c97a",
                                "text": "„Man beachte, daß keinesfalls stets der Körpergrad von Z über K gleich dem Grad der Algebra Z über K ist!“"
                            },
                            {
                                "example_id": "4982e2f8-6b5e-4675-b89c-dee772e295b3",
                                "sense_id": "f35637fd-53f8-3085-b349-8419ab11c97a",
                                "text": "„Als Hauptresultat der vorliegenden Arbeit wird dieser Körpergrad für den Fall = m2 (2), gn = m2 ermittelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
