                                "example_id": "ee5a2902-82ad-44e0-9e98-820a157629b9",
                                "sense_id": "eedcd649-8cf6-33a9-b5e2-6945546a6599",
                                "text": "Podane na gorąco frankfurterki nie cieszyły się dużym wzięciem."
                            },
                            {
                                "example_id": "eabeb839-4d81-4f79-80cd-d174c1f9be58",
                                "sense_id": "eedcd649-8cf6-33a9-b5e2-6945546a6599",
                                "text": "Poproszę kilo tych frankfurterek i czterdzieści deko skrojonej szynki."
                            }
