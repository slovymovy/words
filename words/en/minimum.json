                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最低限度",
                                "target_lang_sense_clarification": "最小的程度"
                            },
                            {
                                "target_lang_word": "最少",
                                "target_lang_sense_clarification": "最小的量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ad33922-b487-3915-bc1b-d5d44fac1066",
                    "sense_definition": "A lower bound of a set or the lowest value of a mathematical function.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The function reaches its global <w>minimum</w> at x equals zero.",
                            "target_lang_translations": {
                                "ru": "Функция достигает своего глобального <w>ми́нимума</w> при x, равном нулю.",
                                "pl": "Funkcja osiąga swoje <w>minimum</w> globalne dla x równego zero.",
                                "zh": "该函数在 x 等于零时达到其全局<w>最小值</w>。"
                            }
                        },
                        {
                            "text": "Students must calculate the absolute <w>minimum</w> of the curve.",
                            "target_lang_translations": {
                                "ru": "Студенты должны вычислить абсолютный <w>ми́нимум</w> кривой.",
                                "pl": "Studenci muszą obliczyć <w>minimum</w> absolutne krzywej.",
                                "zh": "学生必须计算出该曲线的绝对<w>最小值</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "maximum"
