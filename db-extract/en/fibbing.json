                        ],
                        "examples": [
                            {
                                "example_id": "b42cade1-c3b2-4b55-9a11-c22a2cb9f1ca",
                                "sense_id": "61abafff-67e4-3003-a97a-6a65a461ef57",
                                "text": "Of the fibbings, conventional falsehoods, and white lies disfiguring and vitiating social intercourse and common commercial transactions, it is enough to say that they are in jarring discord with […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "3160e44c-1f46-3bc7-9346-15b762397145",
                        "entry_id": "9ee4e847-f782-39fc-9104-fcf449e05a12",
                        "glosses": [
                            "Repeatedly striking an opponent's head while holding them in a headlock; a pummelling; a drubbing; a beating."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "87c95afd-8b03-485d-ac3f-be90bbc90ba7",
                                "sense_id": "3160e44c-1f46-3bc7-9346-15b762397145",
                                "text": "And so did Nick, whom sometimes there would come on / A sort of fear his spouse might knock his head off, / Demolish half his teeth, or drive a rib in, / She shone so much in 'facers' and in 'fibbing.'"
                            },
                            {
                                "example_id": "43889cc9-16cd-4ce2-93d7-b793613d2c00",
                                "sense_id": "3160e44c-1f46-3bc7-9346-15b762397145",
                                "text": "15th round. Chancery. Fibbing. Biggs makes dreadful work with his left. Break away. Rally. Biggs down. Betting still six to four on the gown-boy."
                            }
                        ]
                    }
