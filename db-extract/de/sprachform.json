                        "form": "die Sprachform"
                    },
                    {
                        "form_id": "5134cbe0-7134-44f8-b958-953ca0429c21",
                        "entry_id": "b45e2019-7c33-3211-98a7-2991ca7f5f75",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sprachformen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e43bf90-11c7-358c-946b-8c44cd165cd5",
                        "entry_id": "b45e2019-7c33-3211-98a7-2991ca7f5f75",
                        "glosses": [
                            "Varietät der Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b7f75be-4388-4875-b739-7203235a0cbc",
                                "sense_id": "9e43bf90-11c7-358c-946b-8c44cd165cd5",
                                "text": "„Man kann auch dualistisch argumentieren, das heißt man nimmt an, daß es je eine Grammatik für die geschriebene und die gesprochene Sprachform des Deutschen gibt - mit einem ausgedehnten gemeinsamen Kern.“"
                            },
                            {
                                "example_id": "0a858b8c-a7eb-4f05-851e-08c7c76c973d",
                                "sense_id": "9e43bf90-11c7-358c-946b-8c44cd165cd5",
                                "text": "„Auch heute werden Sprachen und Dialekte noch bewertet - vor allem, wenn es nicht die eigene Sprachform ist.“"
                            },
                            {
                                "example_id": "a8d09928-2463-4162-ab23-112bc3e35f75",
                                "sense_id": "9e43bf90-11c7-358c-946b-8c44cd165cd5",
                                "text": "„Die Sprachform wird benutzt als Argument für die eigene Sache, um die eigene Überlegenheit und die Unterlegenheit der anderen zu beweisen.“"
                            },
                            {
                                "example_id": "063c8d98-0988-4f87-bf5a-f9ddcdd35c72",
                                "sense_id": "9e43bf90-11c7-358c-946b-8c44cd165cd5",
                                "text": "„Aber auch Luthers Sprachbegabung und die Erfindung des Buchdrucks reichten noch nicht aus, damit sich die Sprache der Bibelübersetzung, trotz ihrer weiten Verbreitung, als allgemein anerkannte Sprachform durchsetzen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "361fc37b-1f6b-3828-abd5-551e88d10630",
                        "entry_id": "b45e2019-7c33-3211-98a7-2991ca7f5f75",
                        "glosses": [
                            "Form einer sprachlichen Einheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b0fd430-f6f0-4edc-84e4-a6982da58de2",
                                "sense_id": "361fc37b-1f6b-3828-abd5-551e88d10630",
                                "text": "„Studien ergeben allerdings, dass die männliche Sprachform zu geringem gedanklichen Einbezug von Frauen führt.“"
                            },
                            {
                                "example_id": "e9383433-9c28-4a7b-8358-900fe1a00036",
                                "sense_id": "361fc37b-1f6b-3828-abd5-551e88d10630",
                                "text": "„Im Sinne der besseren Lesbarkeit dieses Berichtes wurde meistens die grammatikalisch männliche Sprachform gewählt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "156c1370-daed-4723-830b-6ef2ec8b639d",
                        "source_entry_id": "b45e2019-7c33-3211-98a7-2991ca7f5f75",
                        "source_sense_id": "9e43bf90-11c7-358c-946b-8c44cd165cd5",
                        "source_sense_description": "Linguistik: Varietät der Sprache",
                        "target_lang_word": "variety",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "variety",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90aa8a56-24ed-3edb-a367-6ae8e7c60637",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "A deviation or difference."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d4fae04-5106-4ded-b39e-014aee0028d5",
                                                "sense_id": "90aa8a56-24ed-3edb-a367-6ae8e7c60637",
                                                "text": "The difference, therefore, in theſe animals, ariſes rather from their habits than their confirmation; and, upon examination, there will be leſs variety found betvween them than between birds that live upon land, and thoſe that ſwim upon the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "584ccb93-b7ff-3aa6-8b47-9986d5305f1e",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "A specific variation of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e700182-02c8-420d-82d0-c7d1da54f000",
                                                "sense_id": "584ccb93-b7ff-3aa6-8b47-9986d5305f1e",
                                                "text": "The ſpirit of that competition burns / With all varieties of ill by turns, / Each vainly magnifies his own ſucceſs, / Reſents his fellows, wiſhes it were leſs, […]"
                                            },
                                            {
                                                "example_id": "62323049-28b4-4605-bf97-90ff1a90e794",
                                                "sense_id": "584ccb93-b7ff-3aa6-8b47-9986d5305f1e",
                                                "text": "Yet the task of composing dramatic varieties, of training players, and deliberating in the theatrical senate, or even of expressing philosophically his opinions on these points, could not wholly occupy such a mind as his."
                                            },
                                            {
                                                "example_id": "bce8cae5-d975-417c-9f58-c74b105edeb7",
                                                "sense_id": "584ccb93-b7ff-3aa6-8b47-9986d5305f1e",
                                                "text": "In some respects he [Edward Hyde, 1st Earl of Clarendon] was well fitted for his great place. […] No man was better acquainted with general maxims of statecraft. No man observed the varieties of character with a more discriminating eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66af6cea-4e7a-38aa-9c26-3c0f4eba6747",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "A specific variation of something.",
                                            "An animal or plant (or a group of such animals or plants) with characteristics causing it to differ from other animals or plants of the same species; a strain or cultivar."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4abc3fd-0269-4223-a3e7-935ec83daab5",
                                                "sense_id": "66af6cea-4e7a-38aa-9c26-3c0f4eba6747",
                                                "text": "Many more ſorts of varieties of theſe kindes [of Aconitum anthora] there are, but theſe onely, as the moſt ſpecious, are nourſed vp in Floriſts Gardens for pleaſure; the other are kept by ſuch as are Catholicke obſeruers of all natures ſtore."
                                            },
                                            {
                                                "example_id": "1d81ef61-a62b-4fd7-b2db-ef3fcf278666",
                                                "sense_id": "66af6cea-4e7a-38aa-9c26-3c0f4eba6747",
                                                "text": "But of all theſe varieties of Roſes, the beſt and moſt eſtemed amongſt the Red, are thoſe called the Roſe of the VVorld, the Red Belgick, the Red Marble, the Roſe vvithout Thorns, and the Red Provence Roſe."
                                            },
                                            {
                                                "example_id": "8cdcc66e-4573-4748-baa9-fadb788b5203",
                                                "sense_id": "66af6cea-4e7a-38aa-9c26-3c0f4eba6747",
                                                "text": "When we look to the individuals of the same variety or sub-variety of our older cultivated plants and animals, one of the first points which strikes us, is, that they generally differ much more from each other, than do the individuals of any one species or variety in a state of nature."
                                            },
                                            {
                                                "example_id": "66016675-f830-46e5-93ce-07b4076b4e88",
                                                "sense_id": "66af6cea-4e7a-38aa-9c26-3c0f4eba6747",
                                                "text": "Jim is a nurseryman, specialising in clematis, and he has built up a business exporting 150 varieties to countries all over the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a386d74-d428-3d79-ba27-31c5de79b627",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "A specific variation of something.",
                                            "An animal or plant (or a group of such animals or plants) with characteristics causing it to differ from other animals or plants of the same species; a strain or cultivar.",
                                            "A rank in a taxonomic classification below species and (if present) subspecies, and above form; hence, an organism of that rank."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe2bee51-7d1d-436b-9396-0ddd2483fdc6",
                                                "sense_id": "1a386d74-d428-3d79-ba27-31c5de79b627",
                                                "text": "Capsicum annuum var. glabriusculum is a variety of Capsicum annuum commonly known as chiltepin or Indian pepper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de3736e6-ff77-318c-ab36-897d6aaf57d2",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "A specific variation of something.",
                                            "A specific form of a language, neutral to whether that form is an accent, dialect, register, etc., and to its prestige level; an isolect or lect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2581fcc6-946f-4809-b2f9-48fbe1282945",
                                                "sense_id": "de3736e6-ff77-318c-ab36-897d6aaf57d2",
                                                "text": "The mere existence of a dictionary of a certain variety of English does not automatically confer acceptance of that variety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83555780-cd16-3071-a292-5adc84297641",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "A specific variation of something.",
                                            "A stamp, or set of stamps, which has one or more characteristics (such as colour, paper, etc.) differing from other stamps in the same issue, especially if such differences are intentionally introduced."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9edc5295-744e-324f-8b96-d1a8a8857d10",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "A collection or number of different things."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "270b2ba1-88c2-4eb2-a39c-c586ffe54ed4",
                                                "sense_id": "9edc5295-744e-324f-8b96-d1a8a8857d10",
                                                "text": "But nether in this maner, nor any other particular procedyng, can we ſufficiently direct yow: but, notyng unto yow the generalitees of our deſyre, referr yow to apply your doings to the varieté and occurrency of thyngs there."
                                            },
                                            {
                                                "example_id": "6d87eede-e82d-45da-9bb7-3e81ac25fcaf",
                                                "sense_id": "9edc5295-744e-324f-8b96-d1a8a8857d10",
                                                "text": "And in this may receiue ſome immediate benefit, if by contemplation, hee behold the varietie of temporary bleſſings, no part in the Vniuerſe exceeding theſe, not vvith-held from Pagan people afforded by Gods al-knovving and guiding Prouidence, vvhich notvvithſtanding being mixt vvith vnthankfulneſſe, damnable Idolatry, and variety of carnall obiects turne to their greater diſtruction, and endleſſe miſeries."
                                            },
                                            {
                                                "example_id": "726ab8b1-41c4-4d09-877c-1080c655b185",
                                                "sense_id": "9edc5295-744e-324f-8b96-d1a8a8857d10",
                                                "text": "In other parts of the ſea are ſeen ſponges of various magnitude, and extraordinary appearances, aſſuming a variety of phantaſtic forms like large muſhrooms, mitres, fonts, and flovver-pots."
                                            },
                                            {
                                                "example_id": "73c39959-5633-4eba-8f4b-476e89738851",
                                                "sense_id": "9edc5295-744e-324f-8b96-d1a8a8857d10",
                                                "text": "One morning I had been driven to the precarious refuge afforded by the steps of the inn, after rejecting offers from the Celebrity to join him in a variety of amusements. But even here I was not free from interruption, for he was seated on a horse-block below me, playing with a fox terrier."
                                            },
                                            {
                                                "example_id": "7a74296e-184d-4334-9747-e0cdb1cd11a6",
                                                "sense_id": "9edc5295-744e-324f-8b96-d1a8a8857d10",
                                                "text": "In his first book since the 2008 essay collection Natural Acts: A Sidelong View of Science and Nature, David Quammen looks at the natural world from yet another angle: the search for the next human pandemic, what epidemiologists call “the next big one.” His quest leads him around the world to study a variety of suspect zoonoses—animal-hosted pathogens that infect humans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d028d4a9-3a36-3c32-a389-e65b74da5e6f",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "A collection or number of different things.",
                                            "In universal algebra: an equational class; the class of all algebraic structures of a given signature, satisfying a given set of identities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "118743b9-de67-33f0-a934-73064c7d9dfa",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "A collection or number of different things.",
                                            "Ellipsis of algebraic variety (“the set of solutions of a given system of polynomial equations over the real or complex numbers; any of certain generalisations of such a set that preserves the geometric intuition implicit in the original definition”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70f8d87a-42fc-3b18-95a6-ddedc38bb284",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "A collection or number of different things.",
                                            "The total number of distinct states of a system; also, the logarithm to the base 2 of the total number of distinct states of a system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e465262-0fad-3732-a1eb-fece17d55ec0",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "Ellipsis of variety performance or variety show (“a type of entertainment featuring a succession of short, unrelated performances by various artistes such as (depending on the medium) acrobats, comedians, dancers, magicians, singers, etc.”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d6b98a8-6ec6-3a5f-b8ea-86161c599b68",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "The quality of being varied; diversity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbd5c36a-23d4-474c-819d-6e12fd5b315d",
                                                "sense_id": "3d6b98a8-6ec6-3a5f-b8ea-86161c599b68",
                                                "text": "Variety is the spice of life."
                                            },
                                            {
                                                "example_id": "201482a0-3969-4ffb-80d7-83a8e2a4c5e6",
                                                "sense_id": "3d6b98a8-6ec6-3a5f-b8ea-86161c599b68",
                                                "text": "Nor is our body made of one parte onely, but of manye and diuerſe. […] The diuers placyng and vſe is not to the member reprochful, but this varietie rather apertayneth to the welth of the whole body."
                                            },
                                            {
                                                "example_id": "965fde46-2983-4a97-a147-75c828586e61",
                                                "sense_id": "3d6b98a8-6ec6-3a5f-b8ea-86161c599b68",
                                                "text": "Age cannot vvither her, nor cuſtome ſtale / Her infinite variety: […]"
                                            },
                                            {
                                                "example_id": "d7d01b44-077e-4ac7-9846-c1519e1758d2",
                                                "sense_id": "3d6b98a8-6ec6-3a5f-b8ea-86161c599b68",
                                                "text": "And ſhe [Nature] affects ſo much to uſe / Variety, in all ſhe does."
                                            },
                                            {
                                                "example_id": "ec961436-623a-41c8-bb41-958e2815d669",
                                                "sense_id": "3d6b98a8-6ec6-3a5f-b8ea-86161c599b68",
                                                "text": "Variety’s the very ſpice of life / That gives it all its flavor."
                                            },
                                            {
                                                "example_id": "24eae3a8-da2f-4f14-b9c1-6132a5df6d67",
                                                "sense_id": "3d6b98a8-6ec6-3a5f-b8ea-86161c599b68",
                                                "text": "I never keep to any thing long; Variety is the mother of Enjoyment."
                                            },
                                            {
                                                "example_id": "d8051eb3-7779-4a89-b32c-ee6a78ffaec5",
                                                "sense_id": "3d6b98a8-6ec6-3a5f-b8ea-86161c599b68",
                                                "text": "The teeth of sharks, for all their variety, share one characteristic, and that is the way in which they are attached. They are not permanent, but are constantly being replaced, not only when one is lost, but as a constant function of growth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99b93356-b8a7-3f88-9051-881736c1a997",
                                        "entry_id": "402f5373-4d38-3634-897b-331b8ac2e8f3",
                                        "glosses": [
                                            "The kind of entertainment given in variety performances or shows; also, the production of, or performance in, variety performances or shows."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
