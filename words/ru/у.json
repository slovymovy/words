                                "target_lang_word": "Wu",
                                "target_lang_sense_clarification": "Chinese language group"
                            },
                            {
                                "target_lang_word": "Wu Chinese",
                                "target_lang_sense_clarification": "Chinese language group"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Wu",
                                "target_lang_sense_clarification": "Chinesische Sprachgruppe."
                            }
                        ]
                    }
                }
            ]
        },
        {
