                            {
                                "example_id": "3a009dab-8d66-4c82-aae8-4c6da3e77e9a",
                                "sense_id": "fff35f49-0b8e-36da-bbd9-4768084844d6",
                                "text": "Die zwart-witte vogel daar is een witte kwikstaart."
                            }
                        ]
                    },
                    {
                        "sense_id": "757eac3d-a605-312f-98e4-cbb09bf90951",
                        "entry_id": "9fc04665-f55e-36dc-af1a-7a8322e496cd",
                        "glosses": [
                            "afgebeeld volgens de oude fotografische technieken die geen kleurenafbeelding toestonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53ea0a6f-21db-46d5-a716-e1478487bc7a",
                                "sense_id": "757eac3d-a605-312f-98e4-cbb09bf90951",
                                "text": "Hoewel die film geheel zwart-wit is, is hij bijzonder fascinerend om naar te kijken."
                            },
                            {
                                "example_id": "65c8300c-10cb-4f39-8f1e-8a8cac044a4b",
                                "sense_id": "757eac3d-a605-312f-98e4-cbb09bf90951",
                                "text": "Een zwart-wit beeld uit de jaren vijftig van de vorige eeuw: regen op het Lodewijk Napoleonplein in Assen, een man met een paraplu laat zijn honden uit, huizen van baksteen onder steile driehoekige daken. Er is maar een verbinding met het beeld van de schamele behuizingen in Tutwiler, Mississippi: de blues."
                            }
                        ]
                    }
