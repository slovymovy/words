        "fr-extract.jsonl": [
            {
                "entry_id": "e6b6752f-4b19-31ed-b45b-1fe781db0885",
                "word": "imaginable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "23603e56-a413-4aaa-9403-a3c4f17be2a6",
                        "entry_id": "e6b6752f-4b19-31ed-b45b-1fe781db0885",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "imaginables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                        "entry_id": "e6b6752f-4b19-31ed-b45b-1fe781db0885",
                        "glosses": [
                            "Qui peut être imaginé ; que l'on peut imaginer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbe96705-be83-4e5f-ab24-410420aacecf",
                                "sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                                "text": "Pour en être convaincu en un moment, il faut remarquer qu'autre chose est dire qu'un Etre tres-parfait, ou qui a toutes les perfections imaginables existe, & dire qu’efectivement il existe un Etre qui a toutes les perfections imaginables, […]."
                            },
                            {
                                "example_id": "fde26895-fd68-4430-8d41-e2cb0d24c56c",
                                "sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                                "text": "Ils se sont donné toutes les peines imaginables; soit pour s'informer du caractère de ceux qui venaient solliciter des secours, soit pour visiter eux-mêmes en personne leurs maisons, afin de se procurer les renseignemens les plus certains sur leurs facultés."
                            },
                            {
                                "example_id": "a6ad3a84-37e8-4e51-8d62-dacffb8bfac4",
                                "sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                                "text": "Voici, pour commencer, ce que j’écrivais, il y a six ans, dans un livre de colère que l’hostilité générale s’efforça d’étouffer par tous les moyens imaginables."
                            },
                            {
                                "example_id": "5cfdedc8-c2fa-4783-8919-e379cd18797d",
                                "sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                                "text": "[…]: Stendhal a montré, dans Lucien Leuwen, qu'en 1835, la monarchie parlementaire et bourgeoise de Louis-Philippe, pratiquait avec un art consommé toutes les turpitudes imaginables : on achetait l'élection d'un député avec cent mille francs, quelques nominations, quelques bureaux de tabac, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d79c376e-f5c9-4647-9d12-d137de63d3bc",
                        "source_entry_id": "e6b6752f-4b19-31ed-b45b-1fe781db0885",
                        "source_sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                        "target_lang_word": "erdenklich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erdenklich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f16c6f6-21c3-36d6-a4e4-bbc6cf352016",
                                        "entry_id": "a4a66ef6-502e-38ab-bd27-d1d0f72d4681",
                                        "glosses": [
                                            "sich ausdenken/ersinnen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c7ce94-14ee-48b5-a439-93f7caa6e9df",
                                                "sense_id": "1f16c6f6-21c3-36d6-a4e4-bbc6cf352016",
                                                "text": "„Die Sprache kennt die Grenzen ihrer Kraft, sie weiß, wie weit ihr allzeit der Gedanke voraus ist, und sie gibt sich alle erdenkliche Mühe, um ihn einzuholen.“"
                                            },
                                            {
                                                "example_id": "7f30c6ff-8e9e-4394-b180-860b970f99f4",
                                                "sense_id": "1f16c6f6-21c3-36d6-a4e4-bbc6cf352016",
                                                "text": "„Der Bootsmann fing zwei Seevögel, stutzte ihnen die Flügel und gab sich tagelang die erdenklichste Mühe, sie zu zähmen, in der Hoffnung, sie dahin zu bringen, soweit es in ihrer Fähigkeit lag, die Arbeit des Hausgeflügels – das Eierlegen – zu besorgen, denn den Mangel an Eiern beklagte Mrs. Aleshine beständig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26da6f20-6135-452d-bc11-de8571cd895e",
                        "source_entry_id": "e6b6752f-4b19-31ed-b45b-1fe781db0885",
                        "source_sense_id": "ab3ad2d3-cbd2-3a94-9000-26c6e9dbca36",
                        "target_lang_word": "imaginable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imaginable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87f04c07-febc-3744-833e-99c897e96f18",
                                        "entry_id": "292e9ebb-331e-3427-abcd-721ebfef4425",
                                        "glosses": [
                                            "Able to be imagined; conceivable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6937a28-93e5-4d96-9d7a-f4183905f9ab",
                                                "sense_id": "87f04c07-febc-3744-833e-99c897e96f18",
                                                "text": "While running, they were exposed to the most hideous bespawling imaginable."
                                            },
                                            {
                                                "example_id": "2d1e449c-1047-4a57-962d-bbf6782ee3dd",
                                                "sense_id": "87f04c07-febc-3744-833e-99c897e96f18",
                                                "text": "By the early 1980s, Gucci was overlicensed, with its logo on every product imaginable from headscarves to key rings to lighters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2d853c3-c4b0-38a9-b0d9-6b1fd252aa74",
                                        "entry_id": "292e9ebb-331e-3427-abcd-721ebfef4425",
                                        "glosses": [
                                            "Able to be imagined; conceivable.",
                                            "Within the realm of consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e480eac8-343d-4988-8362-2f754047bae5",
                                                "sense_id": "b2d853c3-c4b0-38a9-b0d9-6b1fd252aa74",
                                                "text": "Nevertheless, even if these forms do not directly go back to Lat. autumnus, influence of this word is imaginable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
