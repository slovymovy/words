                        "examples": [
                            {
                                "example_id": "9f5f9ef7-00d8-4468-b64a-3acd9b25a572",
                                "sense_id": "b03be7bb-3bc1-365b-bcdf-c91210632330",
                                "text": "За спинами у всех пуховые подушки подложены, а перед ними на круглой дощечке блины просяные, и масло коровье распущено в чашке, и пиво татарское — буза, в кувшинчике."
                            }
                        ]
