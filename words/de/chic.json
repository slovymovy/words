                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie sah gestern Abend auf der großen Feier besonders <w>chic</w> aus.",
                            "target_lang_translations": {
                                "en": "She looked particularly <w>chic</w> at the big party last night.",
                                "ru": "Вчера вечером на большом празднике она выглядела особенно <w>шикарно</w>.",
                                "nl": "Ze zag er gisteravond op het grote feest bijzonder <w>chic</w> uit.",
                                "pl": "Wczoraj wieczorem na wielkiej imprezie wyglądała wyjątkowo <w>szykownie</w>.",
                                "fr": "Hier soir, lors de la grande fête, elle avait l'air particulièrement <w>chic</w>.",
                                "it": "Ieri sera alla grande festa era particolarmente <w>chic</w>.",
                                "cs": "Včera večer na té velké oslavě vypadala obzvlášť <w>šik</w>.",
                                "tr": "Dün akşamki büyük kutlamada özellikle çok <w>şık</w> görünüyordu.",
                                "es": "Ayer por la noche, en la gran fiesta, ella se veía especialmente <w>chic</w>.",
                                "zh": "她昨晚在盛大的派对上看起来格外<w>时髦</w>。"
                            }
                        },
                        {
                            "text": "Das neue Café im Stadtzentrum ist modern und sehr <w>chic</w> eingerichtet.",
                            "target_lang_translations": {
                                "en": "The new café in the city centre is modern and very <w>stylishly</w> furnished.",
                                "ru": "Новое кафе в центре города оформлено современно и очень <w>стильно</w>.",
                                "nl": "Het nieuwe café in het stadscentrum is modern en heel <w>stijlvol</w> ingericht.",
                                "pl": "Nowa kawiarnia w centrum miasta jest nowocześnie i bardzo <w>stylowo</w> urządzona.",
                                "fr": "Le nouveau café du centre-ville est aménagé de manière moderne et très <w>chic</w>.",
                                "it": "Il nuovo caffè in centro è arredato in modo moderno e molto <w>chic</w>.",
                                "cs": "Nová kavárna v centru města je zařízená moderně a velmi <w>stylově</w>.",
                                "tr": "Şehir merkezindeki yeni kafe modern ve çok <w>şık</w> bir şekilde döşenmiş.",
                                "es": "El nuevo café del centro está amueblado de forma moderna y muy <w>elegante</w>.",
                                "zh": "市中心的新咖啡馆装修得现代且非常<w>别致</w>。"
                            }
                        }
