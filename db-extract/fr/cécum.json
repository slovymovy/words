                    {
                        "sense_id": "079b9ade-c249-37ac-b4bb-62cc7750a260",
                        "entry_id": "b3a54125-a4fd-39cf-aeac-c0524f49c6e5",
                        "glosses": [
                            "Partie initiale du gros intestin qui chez l’être humain porte l’appendice vermiculaire (ou iléocécal)."
                        ],
                        "tags": [],
