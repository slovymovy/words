                    {
                        "sense_id": "9ddc7cd8-5073-35d6-b712-312c2cf43e74",
                        "entry_id": "84647cc6-8b00-3cd3-8fe5-173c392d7d76",
                        "glosses": [
                            "gebouw waar het bestuur van een provincie gevestigd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e10d231-6d89-4604-9ba3-cbdde99bada4",
                                "sense_id": "9ddc7cd8-5073-35d6-b712-312c2cf43e74",
                                "text": "Bijna zestig meter hoog is het nieuwe provinciehuis in de Koningin Elisabethlei nu. Daarmee is het hoogste punt van de nieuwbouw bereikt. Dat werd gisteren symbolisch gevierd met het plaatsen van een meiboom op het dak van de bouwwerf, een traditie."
                            },
                            {
                                "example_id": "6cfa2609-7903-4eb1-8034-5c6659349886",
                                "sense_id": "9ddc7cd8-5073-35d6-b712-312c2cf43e74",
                                "text": "Het is dit jaar honderd jaar geleden dat de Nederlandse abstracte kunstbeweging De Stijl werd opgericht, waarbij onder andere de beroemde kunstenaar Piet Mondriaan zich aansloot. Dat wordt in het hele land gevierd, zoals in Utrecht, waar het provinciehuis in stijl is aangekleed."
                            }
                        ]
                    }
