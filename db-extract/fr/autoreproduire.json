                        "glosses": [
                            "Reproduire sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb4a6907-10e1-457c-a8c9-f1a53da6d259",
                                "sense_id": "f8df7417-b56c-39b2-9717-d1c3af3a5137",
                                "text": "Cet examen attentif de la diversité culturelle et sociale des élèves de l’école fait s’effondrer la critique accusant l’ENA d’autoreproduire une caste."
                            },
                            {
                                "example_id": "d01dc4b4-71ff-4d1f-a63a-3721911f60aa",
                                "sense_id": "f8df7417-b56c-39b2-9717-d1c3af3a5137",
                                "text": "Or, selon une découverte réalisée en 1986 par l’Américain Thomas Cech, cet ARN possède un pouvoir extraordinaire : il peut s’autoreproduire."
                            }
                        ]
