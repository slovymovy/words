                            }
                        },
                        {
                            "text": "The committee noticed a <w>troubling</w> trend in the recent economic reports.",
                            "target_lang_translations": {
                                "pl": "Komisja zauważyła <w>niepokojący</w> trend w ostatnich raportach gospodarczych."
                            }
                        }
                    ],
                    "synonyms": [
                        "alarming",
                        "worrisome"
                    ],
                    "antonyms": [
