                "senses": [
                    {
                        "sense_id": "e30698d4-a3c8-3faf-9752-efce6aeb71e1",
                        "entry_id": "eeac30c6-db34-3c3c-a448-e966acfbed9e",
                        "glosses": [
                            "Zimmer, das sich in einer Ecke eines Hauses/Geschosses befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96dccf5e-ea5c-47ba-8f89-a027564474ea",
                                "sense_id": "e30698d4-a3c8-3faf-9752-efce6aeb71e1",
                                "text": "„Aus dem Eckzimmer war nach links nur eine Ecke der Fabrik zu sehen.“"
                            },
                            {
                                "example_id": "a294e084-7c3d-4b9e-a1d2-2deb04121801",
                                "sense_id": "e30698d4-a3c8-3faf-9752-efce6aeb71e1",
                                "text": "„Vom Eckzimmer weiss man sicher, dass es sein Arbeitszimmer gewesen ist.“"
                            },
                            {
                                "example_id": "83857246-8001-4e9e-82e3-6356908410c5",
                                "sense_id": "e30698d4-a3c8-3faf-9752-efce6aeb71e1",
                                "text": "„Der nächste Morgen sah Frau von Carayon und Tochter in demselben Eckzimmer, in dem sie den Abend vorher ihre Freunde bei sich empfangen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
