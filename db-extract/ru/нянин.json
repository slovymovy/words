                "senses": [
                    {
                        "sense_id": "b9ea2c41-ddd8-3bb6-8342-42a3e5fa03e3",
                        "entry_id": "25e1594f-b878-3249-ae73-abb6570a105d",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным няня; свойственный, характерный для него; принадлежащий няне"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c052c02-b0f4-44e2-9665-a58d22e3a854",
                                "sense_id": "b9ea2c41-ddd8-3bb6-8342-42a3e5fa03e3",
                                "text": "Совсем близко, сквозь сон, Коленька слышит нянин голос."
                            },
                            {
                                "example_id": "657ba0ed-599c-409d-9ac3-44ce948f5e71",
                                "sense_id": "b9ea2c41-ddd8-3bb6-8342-42a3e5fa03e3",
                                "text": "Не знаю, на что уж рассчитывал нянин бойфренд, но явно не на прогулку и игру в настольный футбол с пятилетним ребенком."
                            }
                        ]
                    }
