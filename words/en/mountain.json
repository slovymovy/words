{
    "word_family": [
        "mountaineer",
        "mountainous",
        "mountainside",
        "mountaintop"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9266104d-b55d-3dd6-b4b8-8719392ab992",
                    "sense_definition": "A large natural elevation of the earth's surface rising abruptly from the surrounding level.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "landform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everest is the highest <w>mountain</w> in the world.",
                            "target_lang_translations": {
                                "ru": "Эверест — самая высокая <w>гора</w> в мире."
                            }
                        },
                        {
                            "text": "We spent the weekend hiking in the <w>mountains</w>.",
                            "target_lang_translations": {
                                "ru": "Мы провели выходные в походе в <w>горах</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "alp",
                        "mount",
                        "pinnacle",
                        "height",
                        "crest",
                        "ridge"
                    ],
                    "antonyms": [
                        "valley",
                        "plain"
                    ],
                    "common_phrases": [
                        "mountain range",
                        "climb a mountain",
                        "mountain peak",
                        "high mountain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное естественное возвышение земной поверхности, резко поднимающееся над окружающим уровнем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гора",
                                "target_lang_sense_clarification": "крупная возвышенность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ab11fb8-a6fd-39a1-907b-ba605b029dd9",
                    "sense_definition": "A very large amount or quantity of something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is still a <w>mountain</w> of work to do before the deadline.",
                            "target_lang_translations": {
                                "ru": "До дедлайна нужно сделать еще целую <w>гору</w> работы."
                            }
                        },
                        {
                            "text": "He was a real <w>mountain</w> of a man standing seven feet tall.",
                            "target_lang_translations": {
                                "ru": "При росте в семь футов он был настоящим <w>великаном</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mound",
                        "pinnacle",
                        "height"
                    ],
                    "common_phrases": [
                        "mountain of work",
                        "mountain of debt",
                        "mountain of paperwork"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большое количество или объем чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гора",
                                "target_lang_sense_clarification": "огромное количество"
                            },
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "большое количество чего-либо"
                            },
                            {
                                "target_lang_word": "громадина",
                                "target_lang_sense_clarification": "о ком-то очень крупном"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20836297-f0a9-3c4a-a35b-07b30cad119e",
                    "sense_definition": "A difficult task or a significant challenge to overcome.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "challenge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team has a <w>mountain</w> to climb if they want to win the championship.",
                            "target_lang_translations": {
                                "ru": "Команде предстоит свернуть <w>горы</w>, если они хотят выиграть чемпионат."
                            }
                        },
                        {
                            "text": "Facing a <w>mountain</w> of legal issues, the company decided to settle.",
                            "target_lang_translations": {
                                "ru": "Столкнувшись с <w>горой</w> юридических проблем, компания решила пойти на мировое соглашение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mountain to climb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудная задача или серьезное препятствие, которое необходимо преодолеть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гора",
                                "target_lang_sense_clarification": "в контексте трудной задачи"
                            },
                            {
                                "target_lang_word": "непочатый край",
                                "target_lang_sense_clarification": "об огромном объеме работы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "584b8f3e-de1a-36cb-9392-369a0829ee83",
                    "sense_definition": "A steam locomotive with a 4-8-2 wheel arrangement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "locomotive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The railway museum features a restored <w>Mountain</w> type locomotive.",
                            "target_lang_translations": {
                                "ru": "В железнодорожном музее представлен отреставрированный локомотив типа <w>Маунтин</w>."
                            }
                        },
                        {
                            "text": "Western Pacific used secondhand Florida East Coast <w>Mountains</w> for its passenger service.",
                            "target_lang_translations": {
                                "ru": "Western Pacific использовала подержанные паровозы <w>Маунтин</w> с восточного побережья Флориды для пассажирских перевозок."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in rail transport"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Паровоз с осевой формулой 2-4-1 (4-8-2 по американской классификации)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Маунтин",
                                "target_lang_sense_clarification": "тип паровоза"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8097d2cc-3a69-38b7-a18a-3fbb078dc373",
                    "sense_definition": "A type of wine from Malaga made from grapes grown on mountain slopes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They dined on mutton broth and drank <w>mountain</w> and old port moderately.",
                            "target_lang_translations": {
                                "ru": "Они обедали бараньим бульоном и умеренно пили <w>малагу</w> и старый портвейн."
                            }
                        },
                        {
                            "text": "The cellar was stocked with rare bottles of Spanish <w>mountain</w>.",
                            "target_lang_translations": {
                                "ru": "Погреб был заставлен редкими бутылками испанской <w>малаги</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical usage for this specific wine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип вина из Малаги, изготовленного из винограда, выращенного на горных склонах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малага",
                                "target_lang_sense_clarification": "сорт десертного вина"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f4a76258-7f67-3c3f-b3dc-76139e61960d",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Mountain</w> was appointed as the new head of the department.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Маунтин</w> был назначен новым главой отдела."
                            }
                        },
                        {
                            "text": "The author of the book is Sarah <w>Mountain</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — Сара <w>Маунтин</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Маунтин",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bcaafee-ac57-34f9-89c8-48fc3097a00f",
                    "sense_definition": "A place name referring to various towns or municipalities in North America and England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He was born in <w>Mountain</w>, a small city in North Dakota.",
                            "target_lang_translations": {
                                "ru": "Он родился в <w>Маунтине</w>, небольшом городке в Северной Дакоте."
                            }
                        },
                        {
                            "text": "The rural municipality of <w>Mountain</w> is located in western Manitoba.",
                            "target_lang_translations": {
                                "ru": "Сельский муниципалитет <w>Маунтин</w> расположен в западной части Манитобы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название населенных пунктов в Северной Америке и Англии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Маунтин",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29c56acf-8384-3d9d-a82e-6473e15d542b",
                    "sense_definition": "The Montagnard party during the French Revolution.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "history",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "The <w>Mountain</w> sat on the highest benches in the National Convention.",
                            "target_lang_translations": {
                                "ru": "<w>Гора</w> занимала самые верхние скамьи в Национальном конвенте."
                            }
                        },
                        {
                            "text": "Robespierre was a prominent leader of the <w>Mountain</w>.",
                            "target_lang_translations": {
                                "ru": "Робеспьер был видным лидером <w>Горы</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Политическая партия монтаньяров во время Великой французской революции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гора",
                                "target_lang_sense_clarification": "партия монтаньяров"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}