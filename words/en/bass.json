        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00b706ca-09e1-3730-8068-0e6d5902aa81",
                    "sense_definition": "To make a deep, low-pitched sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thunder <w>bassed</w> ominously across the dark valley before the storm hit.",
                            "target_lang_translations": {
                                "ru": "Гром зловеще <w>басил</w> над темной долиной перед началом бури.",
                                "zh": "暴风雨来临前，雷声在黑暗的山谷中<w>发出低音</w>，显得十分阴森。"
                            }
                        },
                        {
                            "text": "His voice <w>bassed</w> with authority as he gave the command.",
                            "target_lang_translations": {
                                "ru": "Его голос <w>басил</w> с авторитетом, когда он отдавал приказ.",
                                "zh": "他下达命令时，嗓音<w>发出低音</w>，显得威严十足。"
                            }
                        }
                    ],
                    "traits": [
