                        "zh": [
                            {
                                "target_lang_word": "全缘",
                                "target_lang_sense_clarification": "植物学专业术语，指叶缘平滑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40877b54-2ca3-3076-a615-1d631d01bd31",
                    "sense_definition": "Not castrated (used mainly for male animals like horses).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The breeder decided to keep the prize-winning horse <w>entire</w>.",
                            "target_lang_translations": {
                                "ru": "Заводчик решил оставить призового коня <w>некастрированным</w>.",
                                "zh": "饲养员决定让这匹获奖的马保持<w>未阉割的</w>状态。"
                            }
                        },
                        {
                            "text": "An <w>entire</w> male dog may exhibit more aggressive behavior than a neutered one.",
                            "target_lang_translations": {
                                "ru": "<w>Некастрированный</w> кобель может проявлять более агрессивное поведение, чем кастрированный.",
                                "zh": "<w>未阉割的</w>雄性犬可能比已绝育的犬表现出更强的攻击性。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "animal husbandry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Некастрированный (используется в основном для самцов животных, например, лошадей).",
                        "zh": "未阉割的（主要用于马等雄性动物）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "некастрированный",
                                "target_lang_sense_clarification": "о животных"
                            },
                            {
                                "target_lang_word": "племенной",
                                "target_lang_sense_clarification": "предназначенный для разведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未阉割的",
                                "target_lang_sense_clarification": "指动物未经过绝育手术"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b626fe7c-7968-398b-a7ed-10af58cc661e",
                    "sense_definition": "Describing a complex function that is differentiable at all points in the complex plane.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Polynomials are simple examples of <w>entire</w> functions in mathematics.",
                            "target_lang_translations": {
                                "ru": "Многочлены — это простые примеры <w>целых</w> функций в математике.",
                                "zh": "多项式是数学中<w>整函数</w>的简单例子。"
                            }
                        },
                        {
                            "text": "The professor explained the properties of an <w>entire</w> function during the lecture.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил свойства <w>целой</w> функции во время лекции.",
                                "zh": "教授在讲座中解释了<w>整函数</w>的性质。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "entire function"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает комплексную функцию, которая дифференцируема во всех точках комплексной плоскости.",
                        "zh": "指在复平面上处处可导的复变函数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целый",
                                "target_lang_sense_clarification": "математический термин (о функции)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整函数",
                                "target_lang_sense_clarification": "数学专业术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f77bf382-e962-39c5-bb11-99003417845d",
                    "sense_definition": "The whole amount or extent of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_whole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the <w>entire</w> of his savings on restoring the old house.",
                            "target_lang_translations": {
                                "ru": "Он потратил <w>всё</w> из своих сбережений на реставрацию старого дома.",
                                "zh": "他把<w>全部</w>积蓄都花在了修复那座老房子上。"
                            }
                        },
                        {
                            "text": "We walked through the <w>entire</w> of the park before sunset.",
                            "target_lang_translations": {
                                "ru": "Мы прошли через <w>весь</w> парк до заката.",
                                "zh": "我们在日落前走遍了<w>整个</w>公园。"
                            }
                        }
