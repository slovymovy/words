                },
                {
                    "sense_id": "50a52a74-11e3-3528-828f-bca7e1ca9e2e",
                    "sense_definition": "niepoddający się kontroli, woli lub trudny do opanowania",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "brak_kontroli",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Od porannego wiatru miała na głowie burzę zupełnie <w>nieposłusznych</w> włosów.",
                            "target_lang_translations": {
                                "ru": "От утреннего ветра у неё на голове была копна совершенно <w>непослушных</w> волос."
                            }
                        },
                        {
                            "text": "Po długim biegu na mrozie jego zmarznięte palce stały się całkowicie <w>nieposłuszne</w>.",
                            "target_lang_translations": {
                                "ru": "После долгой пробежки на морозе его замёрзшие пальцы стали совершенно <w>непослушными</w>."
                            }
                        }
                    ],
                    "synonyms": [
