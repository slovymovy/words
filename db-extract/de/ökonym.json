                "senses": [
                    {
                        "sense_id": "ae841c45-5f15-3d16-9d9a-dcda27ca3897",
                        "entry_id": "fb8b15c9-1f80-3240-8809-f0dacc3743cf",
                        "glosses": [
                            "Sammelbezeichnung für kommerzielle Ergonyme, also für Waren- und Dienstleistungsbezeichnungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ab0fa3d-80b6-4d25-8d32-f24436abd3bc",
                                "sense_id": "ae841c45-5f15-3d16-9d9a-dcda27ca3897",
                                "text": "Drei jedem deutschen Konsumenten bekannte Ökonyme sind Tempo, Milka und Jägermeister."
                            },
                            {
                                "example_id": "3bb5df7c-f395-4a1e-9406-749bd5331320",
                                "sense_id": "ae841c45-5f15-3d16-9d9a-dcda27ca3897",
                                "text": "„Grundsätzlich kann gesagt werden, dass der Begriff Ökonym – aufgrund seiner Möglichkeit des internationalen Gebrauchs – besser geeignet wäre als der Terminus Warenname.“"
                            },
                            {
                                "example_id": "c9cdc1d6-0900-4fe0-b27f-8001c2ae1b6d",
                                "sense_id": "ae841c45-5f15-3d16-9d9a-dcda27ca3897",
                                "text": "„Gleich zu Beginn verriet uns der Vortragende, Prof. em. Dr. Helmut Liebsch, dass Ökonyme sich von Ökonomie (Wirtschaft/Waren) und Onyma (Name) herleite, was unschwer zu erkennen sei, aber die Benennung selber in der Onomastik (der Namenkunde) relativ selten vorkomme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
