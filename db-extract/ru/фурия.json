                        "cross_references": [
                            {
                                "target_word": "virago",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56722e2d-8d10-305f-8224-54e25a77f9a6",
                                        "entry_id": "2f5b4761-8c4e-3baa-a19b-590a64823810",
                                        "glosses": [
                                            "A woman given to undue belligerence or ill manner at the slightest provocation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c46398-02a2-4e13-a400-9509db8df9dd",
                                                "sense_id": "56722e2d-8d10-305f-8224-54e25a77f9a6",
                                                "text": "Not unnaturally, “Auntie” took this communication in bad part. Thus outraged, she showed herself to be a bold as well as a furious virago. Next day she found her way to their lodgings and tried to recover her ward by the hair of the head."
                                            },
                                            {
                                                "example_id": "c39acce6-269e-4887-b08e-2b1241af0c46",
                                                "sense_id": "56722e2d-8d10-305f-8224-54e25a77f9a6",
                                                "text": "Joan was all Arden, grinning there, siding with her virago mother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34fdaa31-3b63-3d0f-88be-d7af2ab2cf89",
                                        "entry_id": "2f5b4761-8c4e-3baa-a19b-590a64823810",
                                        "glosses": [
                                            "A woman who is scolding, domineering, or highly opinionated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fb35863-8b20-3148-a88e-4391eae8f87f",
                                        "entry_id": "2f5b4761-8c4e-3baa-a19b-590a64823810",
                                        "glosses": [
                                            "A woman who is rough, loud, and aggressive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
