                            },
                            {
                                "target_lang_word": "肥胖",
                                "target_lang_sense_clarification": "体型过大的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e942fd57-a957-316e-a0ef-8d3f2be12c9c",
