        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "31ae019b-e542-311d-a437-cef7f4ca2c0e",
                    "sense_definition": "Qui passe très vite et ne dure pas ; passager, éphémère.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "éphémère",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai ressenti un bonheur <w>fugitif</w> en observant ce magnifique coucher de soleil."
                        },
                        {
                            "text": "Une lueur <w>fugitive</w> a traversé le ciel sombre avant de disparaître aussitôt."
                        }
                    ],
                    "antonyms": [
                        "durable",
                        "permanent"
                    ],
                    "common_phrases": [
                        "lueur fugitive",
                        "impression fugitive",
                        "instant fugitif"
                    ]
                },
                {
                    "sense_id": "6dd64b49-64b1-3e82-8f3f-c91972f735e9",
                    "sense_definition": "Qui est en fuite, qui s'échappe pour fuir un danger ou une contrainte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fuite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soldat <w>fugitif</w> marchait prudemment la nuit pour éviter les patrouilles ennemies."
                        },
                        {
                            "text": "Les historiens étudient les routes empruntées par chaque esclave <w>fugitif</w> vers la liberté."
                        }
                    ],
                    "common_phrases": [
                        "esclave fugitif",
                        "soldat fugitif"
                    ]
                }
            ]
        }
