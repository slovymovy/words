                                        "entry_id": "f50a2cf1-d191-3dd7-9abf-32bf4bf2527b",
                                        "glosses": [
                                            "To drop or fall suddenly or heavily, all at once."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c84f3d1-7193-40d6-a117-3ce499395a11",
                                                "sense_id": "2fda0a7e-9236-3463-95b8-c0f15be31e72",
                                                "text": "September 24, 1712, The Spectator No. 492, letter from a prude\nDulcissa plumps into a chair."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b997a78b-396a-3eaa-bb9d-d50eeac61e49",
                                        "entry_id": "646a83a9-9327-3982-9559-b1d91f8ca7bb",
                                        "glosses": [
                                            "Directly; suddenly; perpendicularly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e80cbac4-c063-4c36-b6b2-b479cc386b0c",
                                                "sense_id": "b997a78b-396a-3eaa-bb9d-d50eeac61e49",
                                                "text": "I suppose then, that going plump on a flying whale with your sail set in a foggy squall is the height of a whaleman’s discretion?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f00e9564-3e66-34fe-bf6d-740b575090d6",
                                        "entry_id": "9bf855fe-2207-3161-bba9-0fd6788875fc",
                                        "glosses": [
                                            "The sound of a sudden heavy fall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b5ceea7-4903-46db-8095-29f57a436b7a",
                                                "sense_id": "f00e9564-3e66-34fe-bf6d-740b575090d6",
                                                "text": "As she beheld her, poor Mrs. Mack's heart fluttered up to her mouth, and then dropped with a dreadful plump, into the pit of her stomach."
                                            }
                                        ]
                                    }
                                ]
                            },
