        "fr-extract.jsonl": [
            {
                "entry_id": "bbedd079-37f1-38b6-a859-4c5f18e792cc",
                "word": "enzyme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "822e12c2-0fcd-40f8-9c18-55565d875ec0",
                        "entry_id": "bbedd079-37f1-38b6-a859-4c5f18e792cc",
                        "tags": [
                            "plural"
                        ],
                        "form": "enzymes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a85f9695-189f-3174-bfa0-162b43c24bf0",
                        "entry_id": "bbedd079-37f1-38b6-a859-4c5f18e792cc",
                        "glosses": [
                            "Molécule biologique, généralement une protéine (parfois un ARN, appelé ribozyme), qui catalyse une réaction biochimique spécifique, transformant un ou plusieurs substrats en un ou plusieurs produits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba1c3a25-6aa7-4c61-869d-45f40120513b",
                                "sense_id": "a85f9695-189f-3174-bfa0-162b43c24bf0",
                                "text": "La salive contient abondamment de l’enzyme protéolytique qui attaque les albumines."
                            },
                            {
                                "example_id": "07cfa5d5-d3cb-4c63-ac22-e16d638b1b4d",
                                "sense_id": "a85f9695-189f-3174-bfa0-162b43c24bf0",
                                "text": "La présure ou chymosine ou encore lab-ferment est une enzyme sécrétée par les glandes gastriques des Mammifères jeunes. Extraite de la caillette de veau, la présure, en présence d’ions calcium, coagule la caséine."
                            },
                            {
                                "example_id": "7f5d7491-cbd0-4b5e-92ab-a57df6642199",
                                "sense_id": "a85f9695-189f-3174-bfa0-162b43c24bf0",
                                "text": "La variation d’un seul acide aminé dans le gène qui code pour l’enzyme COMT, un médiateur qui métabolise la dopamine et la noradrénaline, produit une différence suffisamment importante dans cette enzyme pour modifier la résistance à la douleur et de là influer sur le courage d’une personne."
                            },
                            {
                                "example_id": "34b1fdd0-1e0c-4d8b-822c-06091be26936",
                                "sense_id": "a85f9695-189f-3174-bfa0-162b43c24bf0",
                                "text": "L’intolérance au lait est liée à une diminution de l’activité de la lactase, l’enzyme qui permet de digérer le sucre du lait (le lactose)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a714d05-7f14-4f65-b3bb-88a2f816e286",
                        "source_entry_id": "bbedd079-37f1-38b6-a859-4c5f18e792cc",
                        "source_sense_id": "a85f9695-189f-3174-bfa0-162b43c24bf0",
                        "source_sense_description": "Molécule ou ensemble de molécules qui catalyse des réactions chimiques biologiques",
                        "target_lang_word": "Enzym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Enzym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                        "entry_id": "f2db8abd-3814-3fc6-a789-433cde82ddeb",
                                        "glosses": [
                                            "ein Protein, das als Katalysator fungiert, also chemische Reaktionen beschleunigt oder überhaupt erst ermöglicht"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c07065a-d119-48e4-85a3-3978d67c83eb",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "Das Enzym Pepsin ist für die Spaltung von mit der Nahrung aufgenommenen Eiweißen verantwortlich."
                                            },
                                            {
                                                "example_id": "c38256fe-6a7d-415e-99af-4af74c61e484",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "„Hofmeister, obwohl im kleinen Kreis kommunikativ und lieberal im Labor … suchte eher die Einsamkeit und betrachtete die menschliche Gesellschaft skeptisch ja verachtend, nur selten ließ er sich auf Tagungen blicken. So wird sein wissenschaftlicher Beitrag eher unterschätzt, und es ist wohl nicht verfehlt, hier hervorzuheben, daß Hofmeister der erste war, der – im Gegensatz zu Fischer Proteine als verschiedenartige, chemisch genau definierte Substanzen betrachtete und ihre entscheidende Funktion als Enzyme wenigstens ahnte. So prophezeite er, daß alle biochemischen Reaktionen der Zelle durch jeweils für sie spezifische Enzyme kontrolliert würden. “"
                                            },
                                            {
                                                "example_id": "23817135-eb6e-4829-b3c3-cc7431f5d16f",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "„Seit Jahrtausenden nutzen Menschen die Wirkung von Enzymen: Ohne sie gäbe es keinen Joghurt, keinen Wein, kein Bier.“"
                                            },
                                            {
                                                "example_id": "89674ab4-82ec-430b-a89a-6e2918e3775d",
                                                "sense_id": "b691f8c1-a498-34e3-9dae-00c656208e90",
                                                "text": "„Mein Vater extrahierte Enzyme aus Pflanzen, und meine Mutter vergiftete Frösche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
