                "senses": [
                    {
                        "sense_id": "396af2ed-add1-3cd8-ad4c-bae58e8b1ff5",
                        "entry_id": "edbe1060-1b34-367d-880e-9e3b038d2bf4",
                        "glosses": [
                            "jemand, der etwas geschenkt bekommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e86d1acd-e0a6-45ec-8890-4d3780c7e09a",
                                "sense_id": "396af2ed-add1-3cd8-ad4c-bae58e8b1ff5",
                                "text": "„Reicht der Gutscheinwert nicht mehr aus, weil sich die Preise seit dem Kauf verteuert haben, muss der Beschenkte die Differenz drauflegen.“"
                            },
                            {
                                "example_id": "77430909-0ca5-43ff-8025-bd26a636cb97",
                                "sense_id": "396af2ed-add1-3cd8-ad4c-bae58e8b1ff5",
                                "text": "„Werden Gutscheine vom Käufer an Dritte weitergegeben, so gelten für den Beschenkten (nur) die aufgedruckten Bedingungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b38fd6f-23e7-41e5-a8a6-c849c1c024da",
                        "source_entry_id": "edbe1060-1b34-367d-880e-9e3b038d2bf4",
                        "source_sense_id": "396af2ed-add1-3cd8-ad4c-bae58e8b1ff5",
                        "source_sense_description": "jemand, der etwas geschenkt bekommt",
                        "target_lang_word": "donee",
