{
    "word_family": [
        "jolty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2715641b-9efc-3430-a188-9c51e85cf598",
                    "sense_definition": "To move or cause to move with a sudden, rough jerk.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old bus <w>jolted</w> along the bumpy dirt road.",
                            "target_lang_translations": {
                                "ru": "Старый автобус <w>трясся</w> по ухабистой грунтовой дороге.",
                                "zh": "那辆旧公交车在坑坑洼洼的土路上一路<w>颠簸</w>前行。"
                            }
                        },
                        {
                            "text": "The sudden stop <w>jolted</w> the passengers forward in their seats.",
                            "target_lang_translations": {
                                "ru": "Внезапная остановка <w>тряхнула</w> пассажиров вперед на сиденьях.",
                                "zh": "突然刹车使乘客们在座位上猛地<w>往前一冲</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jerk",
                        "shake",
                        "bounce",
                        "lurch"
                    ],
                    "antonyms": [
                        "glide"
                    ],
                    "common_phrases": [
                        "jolt forward",
                        "jolt around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или заставлять двигаться резкими, отрывистыми толчками.",
                        "zh": "突然且猛烈地晃动，或使某物这样晃动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трясти",
                                "target_lang_sense_clarification": "двигаться с тряской, вызывать тряску"
                            },
                            {
                                "target_lang_word": "тряхнуть",
                                "target_lang_sense_clarification": "резко дернуть или толкнуть один раз"
                            },
                            {
                                "target_lang_word": "подбрасывать",
                                "target_lang_sense_clarification": "о транспортном средстве на неровной дороге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "颠簸",
                                "target_lang_sense_clarification": "因颠簸而突然猛烈地晃动；也可指使某物猛地一震"
                            },
                            {
                                "target_lang_word": "猛地一震",
                                "target_lang_sense_clarification": "强调突然的猛动或冲击"
                            },
                            {
                                "target_lang_word": "猛推一下",
                                "target_lang_sense_clarification": "使人或物因突然力量而一冲、一晃"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a12a4c85-a28b-3217-b6d7-a9c0819eb0bb",
                    "sense_definition": "To disturb, shock, or surprise someone abruptly, often prompting a reaction or alertness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_shock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud alarm <w>jolted</w> him awake from a deep sleep.",
                            "target_lang_translations": {
                                "ru": "Громкий сигнал будильника <w>встряхнул</w> его, вырвав из глубокого сна.",
                                "zh": "刺耳的警报声一下子把他从熟睡中<w>惊醒</w>了。"
                            }
                        },
                        {
                            "text": "Her unexpected question <w>jolted</w> me out of my daydream.",
                            "target_lang_translations": {
                                "ru": "Её неожиданный вопрос <w>выдернул</w> меня из задумчивости.",
                                "zh": "她那个出人意料的问题一下把我从白日梦中<w>拉回</w>了现实。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shock",
                        "startle",
                        "stun",
                        "shake up"
                    ],
                    "antonyms": [
                        "soothe",
                        "calm"
                    ],
                    "common_phrases": [
                        "jolt awake",
                        "jolt into action",
                        "jolt into reality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно потревожить, шокировать или удивить кого-либо, часто побуждая к реакции.",
                        "zh": "突然打扰、震惊或惊到某人，常使其立刻作出反应或警觉起来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясать",
                                "target_lang_sense_clarification": "вызывать сильное эмоциональное потрясение"
                            },
                            {
                                "target_lang_word": "встревожить",
                                "target_lang_sense_clarification": "вызвать беспокойство, нарушить покой"
                            },
                            {
                                "target_lang_word": "встряхнуть",
                                "target_lang_sense_clarification": "вывести из состояния покоя или апатии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惊醒",
                                "target_lang_sense_clarification": "突然使人从睡眠、发呆或麻木状态中清醒过来"
                            },
                            {
                                "target_lang_word": "震动",
                                "target_lang_sense_clarification": "突然使人震惊、警觉或作出反应"
                            },
                            {
                                "target_lang_word": "拉回",
                                "target_lang_sense_clarification": "把人一下子从某种状态中拉出来"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9bb57a37-0ad3-3400-b5cd-6eb53b8be65b",
                    "sense_definition": "A sudden, rough jerking movement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train came to a halt with a sudden <w>jolt</w>.",
                            "target_lang_translations": {
                                "ru": "Поезд остановился с резким <w>толчком</w>.",
                                "zh": "火车猛地一<w>震</w>，停了下来。"
                            }
                        },
                        {
                            "text": "He felt a sharp <w>jolt</w> as the car hit the curb.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал резкий <w>толчок</w>, когда машина ударилась о бордюр.",
                                "zh": "汽车撞上路缘时，他感到一阵剧烈的<w>震动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jerk",
                        "lurch",
                        "bump",
                        "shake"
                    ],
                    "common_phrases": [
                        "with a jolt",
                        "sudden jolt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное, резкое дергающее движение.",
                        "zh": "突然的、猛烈的抽动或震动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "резкий удар или движение"
                            },
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое отрывистое движение"
                            },
                            {
                                "target_lang_word": "тряска",
                                "target_lang_sense_clarification": "процесс беспорядочного колебания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "震动",
                                "target_lang_sense_clarification": "突然的猛烈一动或一冲"
                            },
                            {
                                "target_lang_word": "震一下",
                                "target_lang_sense_clarification": "偏口语，指猛地一下的晃动"
                            },
                            {
                                "target_lang_word": "猛震",
                                "target_lang_sense_clarification": "强调短促而突然的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2eb42cc4-b5ee-3587-9994-605b3a5e5159",
                    "sense_definition": "A sudden shock, surprise, or burst of feeling or energy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_shock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bad news gave everyone in the office a nasty <w>jolt</w>.",
                            "target_lang_translations": {
                                "ru": "Плохие новости стали для всех в офисе неприятным <w>потрясением</w>.",
                                "zh": "这个坏消息让办公室里的每个人都受到了一次不小的<w>打击</w>。"
                            }
                        },
                        {
                            "text": "She drank a strong coffee to get a <w>jolt</w> of caffeine.",
                            "target_lang_translations": {
                                "ru": "Она выпила крепкий кофе, чтобы получить <w>заряд</w> кофеина.",
                                "zh": "她喝了一杯浓咖啡，好让自己摄入一点咖啡因来提提神。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shock",
                        "surprise",
                        "start"
                    ],
                    "common_phrases": [
                        "jolt of energy",
                        "jolt of electricity",
                        "nasty jolt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный шок, сюрприз или прилив чувств или энергии.",
                        "zh": "突然的震惊、意外，或情绪、能量的猛然迸发。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясение",
                                "target_lang_sense_clarification": "сильное душевное волнение, шок"
                            },
                            {
                                "target_lang_word": "встряска",
                                "target_lang_sense_clarification": "событие, выводящее из равновесия"
                            },
                            {
                                "target_lang_word": "шок",
                                "target_lang_sense_clarification": "состояние крайнего изумления или испуга"
                            },
                            {
                                "target_lang_word": "заряд",
                                "target_lang_sense_clarification": "прилив энергии или бодрости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打击",
                                "target_lang_sense_clarification": "指坏消息或意外带来的突然心理冲击"
                            },
                            {
                                "target_lang_word": "震惊",
                                "target_lang_sense_clarification": "指突如其来的震惊或惊讶"
                            },
                            {
                                "target_lang_word": "刺激",
                                "target_lang_sense_clarification": "指能量、感觉等的突然一股"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf29df1e-8fe9-3ffc-8f91-34afa61a5544",
                    "sense_definition": "A period of imprisonment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He served a five-year <w>jolt</w> for robbery before being released.",
                            "target_lang_translations": {
                                "ru": "Он отсидел пятилетний <w>срок</w> за ограбление перед освобождением.",
                                "zh": "他因抢劫服了五年<w>刑期</w>后才获释。"
                            }
                        },
                        {
                            "text": "The old thief warned the young man about facing a long <w>jolt</w> inside.",
                            "target_lang_translations": {
                                "ru": "Старый вор предупредил молодого парня, что ему грозит долгий <w>срок</w> за решеткой.",
                                "zh": "那个老贼警告那个年轻人，他进去后可能要面对很长的<w>刑期</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sentence",
                        "term"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "prison slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период тюремного заключения.",
                        "zh": "一段监禁时间；刑期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срок",
                                "target_lang_sense_clarification": "время отбывания наказания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刑期",
                                "target_lang_sense_clarification": "俚语，指坐牢的期限"
                            },
                            {
                                "target_lang_word": "坐牢期",
                                "target_lang_sense_clarification": "口语或泛指服刑时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "350c4ca6-41e6-382c-a8bf-87113c54a713",
                    "sense_definition": "An injection of a narcotic drug.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The addict was desperate for another <w>jolt</w> to stop the withdrawal symptoms.",
                            "target_lang_translations": {
                                "ru": "Наркоман отчаянно нуждался в очередной <w>дозе</w>, чтобы прекратить ломку.",
                                "zh": "为了止住戒断症状，那个瘾君子拼命想再来一针<w>毒品</w>。"
                            }
                        },
                        {
                            "text": "He ruined his health chasing the next <w>jolt</w> of heroin.",
                            "target_lang_translations": {
                                "ru": "Он разрушил свое здоровье в погоне за следующей <w>дозой</w> героина.",
                                "zh": "他为了追求下一针海洛因，毁掉了自己的健康。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shot",
                        "fix",
                        "injection"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Инъекция наркотика.",
                        "zh": "一针麻醉性毒品；毒品注射。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доза",
                                "target_lang_sense_clarification": "порция наркотического вещества"
                            },
                            {
                                "target_lang_word": "укол",
                                "target_lang_sense_clarification": "инъекция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一针毒品",
                                "target_lang_sense_clarification": "俚语，指注射的一针毒品"
                            },
                            {
                                "target_lang_word": "毒品注射",
                                "target_lang_sense_clarification": "强调毒品注射这一行为或一针的量"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}