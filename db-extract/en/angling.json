                        "entry_id": "4ea834f9-ed25-39c1-9e51-4807ada96264",
                        "glosses": [
                            "A form of fishing, with a rod, line and angle (hook) for recreation or sport."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7853004f-a4e8-4828-8f44-822438098d01",
                                "sense_id": "0ca13f63-4390-391f-b54e-f336b8cc4fca",
                                "text": "It is a speciall point to have the sun and moon before you, for the very motion of the rod drives all pleasure from you, either by day or by night; in all your anglings, both with worms and flyes, there must be a great care of that."
                            }
                        ]
                    }
