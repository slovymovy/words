                ],
                "senses": [
                    {
                        "sense_id": "4fbfd000-767c-30a0-be07-102ca3ee34b0",
                        "entry_id": "4290b1e1-0411-307e-a0e0-4202513a3d77",
                        "glosses": [
                            "Donner un caractère correspondant au mode de vie des populations locales à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c614f912-a534-4f14-af8b-088063f1436a",
                                "sense_id": "4fbfd000-767c-30a0-be07-102ca3ee34b0",
                                "text": "Suis tes bouquins et arrête de vouloir enkanaker nos gosses."
                            },
                            {
                                "example_id": "6720025e-cee1-4b24-93a6-1a25b630d531",
                                "sense_id": "4fbfd000-767c-30a0-be07-102ca3ee34b0",
                                "text": "Comme lui ont dit certains, moqueurs, en reprenant un vieux terme péjoratif de l'époque coloniale, il s'est en fait \"enkanaké\"."
                            },
                            {
                                "example_id": "32eab291-d1b6-41bd-a127-025afb16aa43",
                                "sense_id": "4fbfd000-767c-30a0-be07-102ca3ee34b0",
                                "text": "Ce n'est pas en pratiquant une langue ou en étudiant la culture que l'on “s'enkanake”."
                            }
                        ]
                    }
                ],
