                        ],
                        "examples": [
                            {
                                "example_id": "d0fc9fae-100e-4e51-b7e4-0857308062bc",
                                "sense_id": "32be1418-4d54-38ed-913f-9bf598a938b3",
                                "text": "(some) Firefly flans call themselves Browncoats (Remember, the hot movie from Universal is out this September! :)"
                            },
                            {
                                "example_id": "11194b9e-6de0-4d35-92ff-c75351719ecd",
                                "sense_id": "32be1418-4d54-38ed-913f-9bf598a938b3",
                                "text": "For what it's worth, I'm 27 and am a huge Firefly/Serenity flan."
                            },
                            {
                                "example_id": "edb8ea6f-3564-408c-90ad-c14ee96e2f18",
                                "sense_id": "32be1418-4d54-38ed-913f-9bf598a938b3",
                                "text": "I'm glad this wasn't the first flan group I came across or I would never have realised the great nature of the majority of browncoasts.^([sic])"
                            }
                        ]
                    }
