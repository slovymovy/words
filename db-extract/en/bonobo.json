        "de-extract.jsonl": [
            {
                "entry_id": "2de96889-c4d3-3162-aa56-dcf97ffe1828",
                "word": "bonobo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "aa2ac78b-e5f4-3ec1-ae34-21756e733ab9",
                        "entry_id": "2de96889-c4d3-3162-aa56-dcf97ffe1828",
                        "glosses": [
                            "Bonobo, Zwergschimpanse (Pan paniscus)"
                        ],
                        "tags": [],
