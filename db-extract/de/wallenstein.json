                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6bfcf58-f238-3823-85b5-94545be1af30",
                        "entry_id": "cfe9b00a-d99f-3f2b-b933-124fb4b9286b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba1d06af-4366-4a97-8299-562351d36940",
                                "sense_id": "f6bfcf58-f238-3823-85b5-94545be1af30",
                                "text": "Frau Wallenstein ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "85e52d26-3f83-4994-a34b-de812e21abd5",
                                "sense_id": "f6bfcf58-f238-3823-85b5-94545be1af30",
                                "text": "Herr Wallenstein wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8239688a-0043-43c4-b951-f17f4ea55196",
                                "sense_id": "f6bfcf58-f238-3823-85b5-94545be1af30",
                                "text": "Die Wallensteins fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "8337480e-53b8-4ea0-8ede-822ee2ad3508",
                                "sense_id": "f6bfcf58-f238-3823-85b5-94545be1af30",
                                "text": "Der Wallenstein trägt nie die Pullover, die die Wallenstein ihm strickt."
                            },
                            {
                                "example_id": "bada543f-19d0-4e53-98d0-4542a315a1a4",
                                "sense_id": "f6bfcf58-f238-3823-85b5-94545be1af30",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wallenstein kommt, geht der Herr Wallenstein.“"
                            },
                            {
                                "example_id": "dfb09e63-d050-49a1-b647-e7e9c9735be6",
                                "sense_id": "f6bfcf58-f238-3823-85b5-94545be1af30",
                                "text": "Wallenstein kommt und geht."
                            },
                            {
                                "example_id": "3f5205f9-2a07-4344-be91-f036e266c898",
                                "sense_id": "f6bfcf58-f238-3823-85b5-94545be1af30",
                                "text": "Wallensteins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
