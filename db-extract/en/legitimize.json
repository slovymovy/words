                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légitimiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "864377d9-c51a-3026-9699-ea489373f0be",
                                        "entry_id": "04be3aba-a850-304f-822e-9b8b192bd139",
                                        "glosses": [
                                            "Variante (contestée) de légitimer (faire considérer comme légitime)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0d641a-da59-4709-877a-39aef631dfeb",
                                                "sense_id": "864377d9-c51a-3026-9699-ea489373f0be",
                                                "text": "Le sens critique, là où il agit avec la sûreté de l’instinct, agit trop soudainement pour être capable de légitimiser ses impressions."
                                            },
                                            {
                                                "example_id": "7cee0bbd-11d4-431e-8c0e-8296dce9f569",
                                                "sense_id": "864377d9-c51a-3026-9699-ea489373f0be",
                                                "text": "Au contraire, légitimiser la frontière, lui donner corps et unité le légitimise lui, lui permet d’exister, donne un sens à sa vie."
                                            },
                                            {
                                                "example_id": "9ce1436e-8dec-435b-a251-ad398a68adcc",
                                                "sense_id": "864377d9-c51a-3026-9699-ea489373f0be",
                                                "text": "Cependant la pensée humaine est nommée pour la première fois Pensée, parce qu’elle sait s'expliquer et dés lors se légitimiser, comme pensée, par la parole, qu’elle a créée."
                                            },
                                            {
                                                "example_id": "a0742ded-3c75-4a82-93db-2bb8442b1fcb",
                                                "sense_id": "864377d9-c51a-3026-9699-ea489373f0be",
                                                "text": "Tant pis pour la France, qui, au lieu de se Rochefortiser, ferait bien mieux de se légitimiser !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
