                                "sense_id": "82f7e246-b550-32b7-9eab-d3c1625e12ec",
                                "text": "Any senators who vote for this bill must be bought."
                            },
                            {
                                "example_id": "2b1a42d7-88e3-4522-996e-feb8c9043288",
                                "sense_id": "82f7e246-b550-32b7-9eab-d3c1625e12ec",
                                "text": "Don't bother filing a complaint, the regulators are bought."
                            },
                            {
                                "example_id": "92084618-d3d7-466c-9406-69e2d5714051",
                                "sense_id": "82f7e246-b550-32b7-9eab-d3c1625e12ec",
                                "text": "If union leadership is bought, why should we even pay dues?"
                            }
                        ]
                    }
