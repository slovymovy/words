                        "glosses": [
                            "zeer grote bedrijf dat frisdranken produceert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e52cf73-427e-4f92-97f8-c3f398f03b43",
                                "sense_id": "34f1f155-0392-3610-92a7-40978a0ab1b2",
                                "text": "De lijkschouwer vindt dat de frisdrankgigant niet verantwoordelijk gehouden kan worden voor consumenten die veel te veel cola drinken. Hij vindt wel dat op colaflessen gewaarschuwd moet worden voor de risico's van een teveel aan suiker en cafeïne. Coca-Cola heeft daar niet op gereageerd."
                            },
                            {
                                "example_id": "c7f0fbfd-972a-4209-b7f4-b9d08da6dc00",
                                "sense_id": "34f1f155-0392-3610-92a7-40978a0ab1b2",
                                "text": "Af en toe nemen anderen de informatie van De Speld voor waar aan. Op 18 april 2009 nam De Speld Coca-Cola op de korrel. Het bedrijf zou het drankje 'Fitna' willen lanceren, vernoemd naar de omstreden film van PVV-leider Geert Wilders. \"Een nieuwe manier van bubbelen\", luidde de slagzin. Coca-Cola was er niet van gediend en dreigde met een rechtszaak. De Speld veranderde daarop 'Coca-Cola' in 'internationale frisdrankgigant'."
                            }
                        ]
                    }
