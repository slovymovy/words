                ],
                "senses": [
                    {
                        "sense_id": "2726ece2-ee97-322b-a3e5-a2836b47d426",
                        "entry_id": "58c7d538-9ff0-3c2d-b685-f2ea1bc3d12c",
                        "glosses": [
                            "Thema, Person oder ein anderes Merkmal, das den finanziellen Erfolg einer Film- oder Theaterproduktion verhindert"
                        ],
                        "tags": [
                            "Film",
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "27984609-6951-4d92-ba0b-e7430e022073",
                                "sense_id": "2726ece2-ee97-322b-a3e5-a2836b47d426",
                                "text": "Ein Klassikalbum wie „Tragédiennes 2“ hingegen sorgt für Erstaunen: Der Titel muss doch pures Kassengift sein."
                            },
                            {
                                "example_id": "0fb65420-ebb3-452f-8a1a-f45302424dc4",
                                "sense_id": "2726ece2-ee97-322b-a3e5-a2836b47d426",
                                "text": "Er wird, um es in der Sprache der Filmbranche zu formulieren, die Frage beantworten, ob Heike Makatsch ein Publikumsmagnet ist oder Kassengift."
                            },
                            {
                                "example_id": "1a44f509-8044-4f39-a58b-47193d1d574d",
                                "sense_id": "2726ece2-ee97-322b-a3e5-a2836b47d426",
                                "text": "Seine Filme aber gelten (wie sein neuester, Eloge de l’amour) inzwischen als Kassengift und finden nur noch selten einen deutschen Verleih."
                            },
                            {
                                "example_id": "74ee4c47-c126-4658-b091-5a8a21c0912b",
                                "sense_id": "2726ece2-ee97-322b-a3e5-a2836b47d426",
                                "text": "Selbst Superstars (wie etwa Cecilia Bartoli) kommen ohne ein gewisses lepidopterologisches Restinteresse heute nicht aus – und kaprizieren sich bereitwillig auf Kassengifte wie Christoph Willibald Gluck oder Franz Joseph Haydn."
                            },
                            {
                                "example_id": "a004b02d-2ba3-42a2-ba54-7dbe83f540ac",
                                "sense_id": "2726ece2-ee97-322b-a3e5-a2836b47d426",
                                "text": "Nach und nach hat er die Dosis vermeintlicher Kassengifte erhöht, hat immer gewagtere Kombinationen klassischer Publikumslieblinge mit moderneren oder unbekannteren Außenseitern erstellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
