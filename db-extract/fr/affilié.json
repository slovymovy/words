                                                "sense_id": "1b652aeb-d352-313c-8b0e-679f1a83e8f7",
                                                "text": "Is the soul affiliated to God, or is it estranged and in rebellion?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ba1faf2-42c7-3bc0-9f48-daac26826a7b",
                                        "entry_id": "6f1c2534-5841-36a4-870b-3f44b9b51afb",
                                        "glosses": [
                                            "To fix the paternity of"
                                        ],
                                        "tags": [
