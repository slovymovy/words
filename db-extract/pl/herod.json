                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0c463c0-ace7-452a-8643-a77da42e9076",
                                "sense_id": "ae026c27-dd4b-3126-93c4-7d65ab5de6f5",
                                "text": "Jezus urodził się 3–4 lata po śmierci króla Heroda Wielkiego."
