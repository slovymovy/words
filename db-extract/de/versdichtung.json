                "senses": [
                    {
                        "sense_id": "507cca8c-a203-39b6-bb39-08e9f893efb9",
                        "entry_id": "0e1e294f-bebc-3807-be94-b014fbcb01d3",
                        "glosses": [
                            "literarische Werke, die in Versen verfasst sind"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "ded1a20b-d057-4065-aecd-9a91f2515658",
                                "sense_id": "507cca8c-a203-39b6-bb39-08e9f893efb9",
                                "text": "„Christian Weise beschränkte sich in dem zuletzt zitierten Lehrbuch auf die Versdichtung.“"
                            },
                            {
                                "example_id": "550e6706-93d3-43de-9610-fc6d0cd4da90",
                                "sense_id": "507cca8c-a203-39b6-bb39-08e9f893efb9",
                                "text": "„In der Lyrik ist der Vers auch in Freien Rhythmen und Freien Versen selbstverständliche Voraussetzung (…), doch auch die anderen Gattungen können als Versdichtungen von erhöhter Sprachgebung und stimmungssteigernder Kraft erscheinen;…“"
                            },
                            {
                                "example_id": "ee877668-6e0d-4ee7-a84d-a69b8172259c",
                                "sense_id": "507cca8c-a203-39b6-bb39-08e9f893efb9",
                                "text": "„Gefördert werden soll humoristische und satirische Versdichtung im Sinne Wilhelm Buschs.“"
                            },
                            {
                                "example_id": "3af6e912-4240-4461-a4e5-f0f54712aa66",
                                "sense_id": "507cca8c-a203-39b6-bb39-08e9f893efb9",
                                "text": "„Die deutsche Versdichtung des 12.-14. Jahrhunderts ist in einer relativ überschaubaren und heute wohl durchweg bekannten Anzahl vollständig erhaltener Handschriften überliefert. “"
                            },
                            {
                                "example_id": "aee4c05f-7095-4e45-b529-cf9f4dfbfa7d",
                                "sense_id": "507cca8c-a203-39b6-bb39-08e9f893efb9",
                                "text": "„Besonders charakteristisch für die viktorianische Literatur sind die vielgestaltigen Ausformungen dramatisch-monologischer Versdichtung, deren Fortleben auch die Literatur unseres Zeitalters entscheidend beeinflußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
