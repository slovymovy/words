                        "glosses": [
                            "A country in East Africa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "362987c7-8cd8-4221-ba06-4dbc1ebd1e2e",
                                "sense_id": "2bdb3b00-18fc-3a50-a4ea-1ee5db1414c2",
                                "text": "Wheat has been and continues to be one of the most important cereal crops in Ethiopia in terms of both area under cultivation and production."
                            },
                            {
                                "example_id": "379c260b-5bcc-476a-ab11-c44505aa1c9c",
                                "sense_id": "2bdb3b00-18fc-3a50-a4ea-1ee5db1414c2",
                                "text": "The death toll from two landslides in a remote region of southern Ethiopia on Monday has risen to 229, according to local authorities."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9e09750-dc97-3ee2-b310-aece2e08b40e",
                        "entry_id": "1e6baf74-2ee9-32e1-9cad-ae19dc44d62f",
                        "glosses": [
