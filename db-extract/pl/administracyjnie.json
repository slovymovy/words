                                                "text": "Zinsen werden auf längere Zeit niedrig bleiben."
                                            },
                                            {
                                                "example_id": "4513d70e-0df1-457d-a777-9bf90e055963",
                                                "sense_id": "00aea0bf-23ad-3e4b-8f7c-9e0cd36aaa2d",
