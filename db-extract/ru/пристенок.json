                "senses": [
                    {
                        "sense_id": "24d3731e-fd8e-3cc9-8e7d-47885064e0ec",
                        "entry_id": "997976cd-db7d-35b6-b05e-d8dc2c61c724",
                        "glosses": [
                            "место у самой стены, под стенкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e6d0e00-fb31-41f2-8165-7569f498d1e2",
                                "sense_id": "24d3731e-fd8e-3cc9-8e7d-47885064e0ec",
                                "text": "Мамаев (в сторону). Это видно, у пристенка насилу стоит. (Дети дерутся из-за куклы, которую дал им Ванечка.)"
                            }
                        ]
                    },
                    {
                        "sense_id": "3a151be4-f66a-30c9-bd0e-f38075872a90",
                        "entry_id": "997976cd-db7d-35b6-b05e-d8dc2c61c724",
                        "glosses": [
                            "азартная игра с монетками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6816fb37-8083-4eee-acc5-cc5ae7aae6cf",
                                "sense_id": "3a151be4-f66a-30c9-bd0e-f38075872a90",
                                "text": "Тишка. А уж это, чтобы урваться когда из дому, с приятелями в три листика али в пристенок сразиться — и не думай лучше!"
                            },
                            {
                                "example_id": "d8d1594c-ace4-4855-af9e-b1eb6299ac01",
                                "sense_id": "3a151be4-f66a-30c9-bd0e-f38075872a90",
                                "text": "На пустыре играли не только в футбол и в пристенок по двугривенному."
                            }
                        ]
                    },
                    {
                        "sense_id": "af33520c-3db2-3c12-997a-80a4e0021c34",
                        "entry_id": "997976cd-db7d-35b6-b05e-d8dc2c61c724",
                        "glosses": [
                            "особая прямоугольная пристройка к стене"
                        ],
