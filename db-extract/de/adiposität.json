                "senses": [
                    {
                        "sense_id": "177ad7cf-2401-32f0-8a28-cb4ab3354dd4",
                        "entry_id": "44d28cba-60dc-3ff2-bac4-b75c5af5f335",
                        "glosses": [
                            "Krankheit/Zustand, wo in deutlichem Maße Fett im Körper angesammelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4fc79a6-c27d-48d5-8edd-b2a24bfaeda7",
                                "sense_id": "177ad7cf-2401-32f0-8a28-cb4ab3354dd4",
                                "text": "„In einer Zeit, da ein Überangebot an Nahrungsmitteln aus den Regalen quillt und Hunger durch Übergewicht bis hin zur Adiposität abgelöst wurde, avancieren einstige Selbstverständlichkeiten zum Privileg.“"
                            },
                            {
                                "example_id": "95c5a8d4-82be-4442-96ef-1a46a7bc3530",
                                "sense_id": "177ad7cf-2401-32f0-8a28-cb4ab3354dd4",
                                "text": "„In neuerer Zeit sind einige Fälle von allgemeiner Adiposität auf Erkrankungen der Hypophysis bezogen worden.“ (1905)"
                            },
                            {
                                "example_id": "a9595aba-7ac2-45df-876e-d7bb6df549ce",
                                "sense_id": "177ad7cf-2401-32f0-8a28-cb4ab3354dd4",
                                "text": "„Ein 40jähriger Mann, der an einer solchen Adiposität litt, dass er sich nicht über die nahe Umgebung seines Hauses hinaus entfernen konnte, wird vom Verf. von 1821–30 wegen einer Flechte mit einem Heer von Mitteln hehandelt.“ (1841)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
