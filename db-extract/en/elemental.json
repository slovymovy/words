    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0e81e905-634e-34f1-a704-d36626392872",
                "word": "elemental",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4969b8bd-f2f8-376d-8e84-30a11c8d7605",
                        "entry_id": "0e81e905-634e-34f1-a704-d36626392872",
                        "glosses": [
                            "Of, relating to, or being an element (as opposed to a compound)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1beb762b-5a46-3698-9ee5-be9f59015a8c",
                        "entry_id": "0e81e905-634e-34f1-a704-d36626392872",
                        "glosses": [
                            "Basic, fundamental or elementary."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "34d03df3-6fdf-42ed-886f-a6dd944a716a",
                                "sense_id": "1beb762b-5a46-3698-9ee5-be9f59015a8c",
                                "text": "Those who have escaped the dark and terrible aspects of life will find my brutality, my flash of rage in our final tragedy, easy enough to blame; for they know what is wrong as well as any, but not what is possible to tortured men. But those who have been under the shadow, who have gone down at last to elemental things, will have a wider charity."
                            },
                            {
                                "example_id": "f6385fc7-3554-4cf5-91a6-8d25af7b0345",
                                "sense_id": "1beb762b-5a46-3698-9ee5-be9f59015a8c",
                                "text": "The pervasive emptiness and stultifying summer heat were only minor deterrents when compared with the more elemental consideration that all the banking and commercial institutions were based elsewhere, chiefly in Philadelphia and New York."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2bd0a40-158d-3c2d-ae05-c7e2e9864d97",
                        "entry_id": "0e81e905-634e-34f1-a704-d36626392872",
                        "glosses": [
                            "Of the ancient supposed elements of earth, air, fire and water."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4c9528d9-178e-4fac-98d1-553a420d36c3",
                                "sense_id": "c2bd0a40-158d-3c2d-ae05-c7e2e9864d97",
                                "text": "Seth is the embodiment of mother-right, warfare, terror, human sacrifice; he is an elemental deity who deals in the fundamental reality of blood."
                            }
                        ]
                    },
                    {
                        "sense_id": "e855bf1e-d01f-3954-af85-9565b3fd7cd6",
                        "entry_id": "0e81e905-634e-34f1-a704-d36626392872",
                        "glosses": [
                            "Of, or relating to a force of nature, especially to severe atmospheric conditions."
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6958fd12-aab2-3ce6-9874-972defdb2e78",
                "word": "elemental",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9f0142cf-4277-432b-8125-046c8b520f69",
                        "entry_id": "6958fd12-aab2-3ce6-9874-972defdb2e78",
                        "tags": [
                            "plural"
                        ],
                        "form": "elementals"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "535262e6-a476-3ec8-a3a5-cbfbfc617303",
                        "entry_id": "6958fd12-aab2-3ce6-9874-972defdb2e78",
                        "glosses": [
                            "A creature (usually a spirit) that is attuned with, or composed of, one of the classical elements: air, earth, fire and water or variations of them like ice, lightning, etc. They sometimes have unique proper names and sometimes are referred to as Air, Earth, Fire, or Water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f2bd405-ce14-41ce-82b4-73e5300641e0",
                                "sense_id": "535262e6-a476-3ec8-a3a5-cbfbfc617303",
                                "text": "Incidentally, such beings may be said to have an existence of a sort upon the lower astral plane; they are elementals created by man's evil desires and unclean thoughts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "842dd59f-0d59-4a46-8085-bc6783f84349",
                        "source_entry_id": "6958fd12-aab2-3ce6-9874-972defdb2e78",
                        "source_sense_id": "535262e6-a476-3ec8-a3a5-cbfbfc617303",
                        "source_sense_description": "fantastic creature",
                        "target_lang_word": "élémental",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élémental",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87d53861-f38d-332c-b9df-73f708486f08",
                                        "entry_id": "a7677346-1f81-3f24-8831-74dadfb2d1c3",
                                        "glosses": [
                                            "Sorte d’esprit désincarné qui vivrait dans les éléments."
                                        ],
                                        "tags": [
                                            "Fantastique",
                                            "Jeux de rôle",
                                            "Jeux de rôle d’action-aventure"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4372ae08-7778-4fbe-ad2d-0544fc56cb6f",
                                                "sense_id": "87d53861-f38d-332c-b9df-73f708486f08",
                                                "text": "Les occultistes considèrent deux sortes d’élémentals : ceux qui ont une existence propre et ceux qui sont artificiels."
                                            },
                                            {
                                                "example_id": "f12c2528-a230-44bc-b6e8-6f3d03ce25c6",
                                                "sense_id": "87d53861-f38d-332c-b9df-73f708486f08",
                                                "text": "Les êtres psychiques qui peuplent la région dans laquelle agissent les forces physico-chimiques ont reçu le nom d’élémentals ou esprits des éléments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67b82201-8828-4437-8f82-ae5c5776a25b",
                        "source_entry_id": "6958fd12-aab2-3ce6-9874-972defdb2e78",
                        "source_sense_id": "535262e6-a476-3ec8-a3a5-cbfbfc617303",
