                                            {
                                                "example_id": "10a18790-a938-429e-90a2-0e99a8690e24",
                                                "sense_id": "ace2eb6d-c221-3985-9143-228c2e6eece9",
                                                "text": "Once upon a time there was a lad, who went along a road cracking nuts. He happened to find one which was worm-eaten, and shortly afterwards he met the devil."
                                            }
