                "senses": [
                    {
                        "sense_id": "3c1ea4b9-c255-3bc0-9960-d731005ce2a3",
                        "entry_id": "64a584f2-cafc-345b-ac66-1f59709ae048",
                        "glosses": [
                            "разг. самодельная водяная бомбочка в виде воздушного шарика, бумажного пакета и т. п., наполненных жидкостью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "569f8086-4a29-4100-ba4a-b538a076c22e",
                                "sense_id": "3c1ea4b9-c255-3bc0-9960-d731005ce2a3",
                                "text": "〈…〉и, буде тот появится в поле зрения, бросить в упомянутого студента «капитошку» с чернилами. «Капитошка», если кто не в курсе, – это такая бумажная бомбочка, сложенная на манер оригами из тетрадного листа〈…〉"
                            }
                        ]
                    },
                    {
                        "sense_id": "dcab1325-2a13-32b2-8da7-39a018ce505e",
                        "entry_id": "64a584f2-cafc-345b-ac66-1f59709ae048",
                        "glosses": [
                            "разг. антистресс, состоящий из муки или гелиевых шариков, оптянутых воздушным шариком"
                        ],
