                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f5931d3-ec33-35ff-b5b2-bdaba8bcf1e7",
                        "entry_id": "12bbe2f4-bb55-3a18-b113-0a2c0d778fea",
                        "glosses": [
                            "État des corps isomorphes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a8b6cf7e-c73b-3d19-8e59-bdebdc657748",
                        "entry_id": "12bbe2f4-bb55-3a18-b113-0a2c0d778fea",
                        "glosses": [
                            "Morphisme admettant un inverse qui est lui-même un morphisme."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a4200fb3-cf0a-3553-bbdb-d4058a8d66f1",
                        "entry_id": "12bbe2f4-bb55-3a18-b113-0a2c0d778fea",
                        "glosses": [
                            "Relation entre des corps de formes analogues, entre des réalisations de même structure sous-jacente."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "452b693b-623f-4731-9d21-661a07745575",
                                "sense_id": "a4200fb3-cf0a-3553-bbdb-d4058a8d66f1",
                                "text": "La notion d’isomorphisme vient de la constatation qu’un individu tend à reconstruire autour de lui une constellation relationnelle qui reste relativement invariable même quand on le change de milieu."
                            },
                            {
                                "example_id": "472a8eee-281a-4559-943c-4373fa169055",
                                "sense_id": "a4200fb3-cf0a-3553-bbdb-d4058a8d66f1",
                                "text": "Je me propose ici de signaler brièvement un isomorphisme, celui de la pensée thomiste et de la démarche scientifique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "256ddd36-4aae-4747-9df7-9db9c7ddb46c",
                        "source_entry_id": "12bbe2f4-bb55-3a18-b113-0a2c0d778fea",
                        "source_sense_id": "7f5931d3-ec33-35ff-b5b2-bdaba8bcf1e7",
                        "source_sense_description": "chimie",
                        "target_lang_word": "isomorphism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isomorphism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6233519-5d3b-30f9-9c4e-fded733a17e8",
                                        "entry_id": "8ed35c6d-c63c-3056-9dac-8377a18a16d2",
                                        "glosses": [
                                            "Similarity of form"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04a324c2-e863-4674-8ac1-ec8f26929018",
                                                "sense_id": "b6233519-5d3b-30f9-9c4e-fded733a17e8",
                                                "text": "The postulated isomorphism between words and things constitutes the characterizing feature of all philosophically based universal languages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12273ff7-a2af-3586-a1d4-6349507bf779",
                                        "entry_id": "8ed35c6d-c63c-3056-9dac-8377a18a16d2",
                                        "glosses": [
                                            "Similarity of form",
                                            "the similarity in form of organisms, which may be due to convergent evolution or shared genetic background, e.g. an algae species in which the haploid and diploid life stages are indistinguishable based on morphology."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23d1bdaf-401c-3101-a338-324be7f0c65a",
                                        "entry_id": "8ed35c6d-c63c-3056-9dac-8377a18a16d2",
                                        "glosses": [
                                            "Similarity of form",
                                            "the similarity in the crystal structures of similar chemical compounds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b562e12f-e38a-4b6c-80df-f8f9a5e040dc",
                                                "sense_id": "23d1bdaf-401c-3101-a338-324be7f0c65a",
                                                "text": "The isomorphism of compounds does not prove the isomorphism of their respective constituents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a966fa14-ead9-3f98-9ac7-dfa9919f6738",
                                        "entry_id": "8ed35c6d-c63c-3056-9dac-8377a18a16d2",
                                        "glosses": [
                                            "Similarity of form",
                                            "the similarity in the structure or processes of different organizations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ac183ef-6192-3eeb-8429-8bdcdca87d3d",
                                        "entry_id": "8ed35c6d-c63c-3056-9dac-8377a18a16d2",
                                        "glosses": [
                                            "A one-to-one correspondence",
                                            "A bijection f such that both f and its inverse f⁻¹ are homomorphisms, that is, structure-preserving mappings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c2e54d9-0a72-3a26-aa40-0e07e54fbff4",
                                        "entry_id": "8ed35c6d-c63c-3056-9dac-8377a18a16d2",
                                        "glosses": [
                                            "A one-to-one correspondence",
                                            "a one-to-one correspondence between all the elements of two sets, e.g. the instances of two classes, or the records in two datasets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da234a36-26c0-310f-8253-8832747f3a66",
                                        "entry_id": "8ed35c6d-c63c-3056-9dac-8377a18a16d2",
                                        "glosses": [
                                            "A one-to-one correspondence",
                                            "A morphism which has a two-sided inverse; the composition of the morphism and such an inverse yields either one of two identity morphisms (depending on the order of composition)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
