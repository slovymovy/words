                        "zich netjes kleden"
                    ],
                    "target_lang_definitions": {
                        "en": "to provide oneself or someone else with clothing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dress",
                                "target_lang_sense_clarification": "to put clothes on oneself or another"
                            },
                            {
                                "target_lang_word": "clothe",
                                "target_lang_sense_clarification": "to provide with or cover in clothing"
                            }
                        ]
