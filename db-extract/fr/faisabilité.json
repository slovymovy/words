                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6a50907-6c3c-3272-b9e0-ea671c281c63",
                                        "entry_id": "350f4067-aac1-3ade-ba43-c0e6dd248b82",
                                        "glosses": [
                                            "Gegebenheit/Vorhandensein der Möglichkeit zur Verwirklichung eines Planes, Konzeptes oder Vorhabens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc7ef53-a64f-4cc9-a7d2-240c733e80dd",
                                                "sense_id": "b6a50907-6c3c-3272-b9e0-ea671c281c63",
                                                "text": "„Die Verhandlungen in Bremen währten länger, als erwartet, und kamen erst zum Abschluß, als eine nach den friesischen Inseln unternommene Reise die bis dahin bezweifelte Durchführbarkeit des Unternehmens bewiesen hatte.“"
