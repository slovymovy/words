                        "cross_references": [
                            {
                                "target_word": "дождевик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e0fb29-5701-36df-a518-fce90733faaa",
                                        "entry_id": "ce8cff51-573e-3f63-a4fb-80d32ac823db",
                                        "glosses": [
                                            "разг. пальто, плащ или накидка из непромокаемой ткани"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37ea31c3-d61a-4086-a512-82e52d40c0c6",
                                                "sense_id": "b0e0fb29-5701-36df-a518-fce90733faaa",
                                                "text": "На нём был брезентовый дождевик ― такие несгибаемые и несгораемые носят возчики ― и крепкие кирзовые сапоги в цементных брызгах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60c9ab07-bf79-32e9-9354-8959e3d4c651",
                                        "entry_id": "ce8cff51-573e-3f63-a4fb-80d32ac823db",
                                        "glosses": [
                                            "микол. шарообразный гриб с мякотью внутри, превращающейся при высыхании в тёмную пыль (Lycoperdon)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e52b67d2-9cd2-4fdf-ba3a-8c440e43b18e",
                                                "sense_id": "60c9ab07-bf79-32e9-9354-8959e3d4c651",
                                                "text": "Белые шарики дождевиков, дымящие коричневым дымком после созревания, вкусны в молодом возрасте, когда их мякоть снежно-белого цвета."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
