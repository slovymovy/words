                                                "sense_id": "f7900163-3527-32d9-b05a-c913954dbd70",
                                                "text": "„Den Vorwurf der Vetternwirtschaft beim einstigen Dorfclub konnten die Verantwortlichen nicht entkräften.“"
                                            },
                                            {
                                                "example_id": "59ef6197-ae4c-4b1c-92cf-b2a169a131bb",
                                                "sense_id": "f7900163-3527-32d9-b05a-c913954dbd70",
                                                "text": "„Die traurige Geschichte des Bahnhofs kommt zur Sprache - und dass der Verantwortliche und seine Kollegen wiederholt vor einem solchen Unglück gewarnt haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
