                "senses": [
                    {
                        "sense_id": "844cadab-e8a8-348f-85bb-9aead207b1eb",
                        "entry_id": "17bbc4a6-a9f3-30ac-8311-a12cdcc14937",
                        "glosses": [
                            "Eisenbahnwagen zum Transport von Gepäck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "906a77e6-d5a2-44c4-ba55-74519e4f5b4c",
                                "sense_id": "844cadab-e8a8-348f-85bb-9aead207b1eb",
                                "text": "„Der Zug, der um vierzehn Uhr zehn an diesem Sonnabend von Platz nach Ducherow fährt, befördert in einem Nichtraucherabteil dritter Klasse Herrn und Frau Pinneberg, in seinem Packwagen einen »ganz großen« Schließkorb mit Emmas Habe, einen Sack mit Emmas Betten - aber nur ihr Bett, »für sein Bett kann er selber sorgen, wie kommen wir dazu« - und eine Eierkiste mit Emmas Porzellan.“"
                            },
                            {
                                "example_id": "f2768fe7-4b4a-49c1-a1a0-4c64a62014ab",
                                "sense_id": "844cadab-e8a8-348f-85bb-9aead207b1eb",
                                "text": "„Es war der Packwagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0c7a78f-64b4-4a33-9841-c4a1f85e397d",
                        "source_entry_id": "17bbc4a6-a9f3-30ac-8311-a12cdcc14937",
                        "source_sense_id": "844cadab-e8a8-348f-85bb-9aead207b1eb",
                        "source_sense_description": "Eisenbahnwagen zum Transport von Gepäck",
                        "target_lang_word": "fourgon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fourgon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "474eec58-f0a3-3e1e-a314-5b4f0c739e88",
                                        "entry_id": "981b975e-b3e4-3084-9de5-951607c7926f",
                                        "glosses": [
                                            "Tige de fer ou longue perche de bois garnie de fer par le bout et servant à remuer, à arranger le bois et la braise dans le four."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "068f8203-34a8-443b-9680-f8845b2593f6",
                                                "sense_id": "474eec58-f0a3-3e1e-a314-5b4f0c739e88",
                                                "text": "Incontinent la lumière tira de l’ombre tous les objets : les larges pelles de sapin blanches et lisses, l’énorme fourgon emmanché d’une latte démesurée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fourgon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d458be3e-f30d-3d8e-8f9b-4c364f96df54",
                                        "entry_id": "b061a852-210b-33ad-ae2d-c3c1bcdf0b00",
                                        "glosses": [
                                            "Charrette couverte dont on se servait surtout dans les armées."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6afff24-137a-4b02-a067-bf9928cd321e",
                                                "sense_id": "d458be3e-f30d-3d8e-8f9b-4c364f96df54",
                                                "text": "Le roi qu’on nous avait imposé n’était ni un grand homme, ni un homme énergique, ni même un excellent homme ; et il avait laissé quelque chose de sa dignité dans les fourgons de l’ennemi. Mais il est certain qu’en 1817, Louis XVIII aurait mieux aimé descendre du trône, que de laisser aux Russes et aux Prussiens le droit de fusiller légalement ses sujets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba096cd0-7ba2-380a-928c-fff67140294e",
                                        "entry_id": "b061a852-210b-33ad-ae2d-c3c1bcdf0b00",
                                        "glosses": [
                                            "Véhicule utilitaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3d1fe19-ee2e-4ba3-8394-c4617e0412e4",
                                                "sense_id": "ba096cd0-7ba2-380a-928c-fff67140294e",
                                                "text": "La nuit, il réparait son vieux fourgon qui pissait l’huile de partout, puis il partait avant le lever du jour pour Rungis."
                                            },
                                            {
                                                "example_id": "e0c02a1a-b21e-41f5-9c22-3a9516038a36",
                                                "sense_id": "ba096cd0-7ba2-380a-928c-fff67140294e",
                                                "text": "Le fourgon d’incendie, camion de pompier utilisé principalement dans la lutte contre l’incendie."
                                            },
                                            {
                                                "example_id": "1fbe47f4-aa71-465b-8371-4b30f4f08ca5",
                                                "sense_id": "ba096cd0-7ba2-380a-928c-fff67140294e",
                                                "text": "Le fourgon des bagages, wagon destiné aux bagages."
                                            },
                                            {
                                                "example_id": "0b7339d3-697d-4957-ac8d-1801663ee1ca",
                                                "sense_id": "ba096cd0-7ba2-380a-928c-fff67140294e",
                                                "text": "Le fourgon blindé sert pour le transport de fonds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c93c318-44c7-3154-8e67-72d63c82e18a",
                                        "entry_id": "b061a852-210b-33ad-ae2d-c3c1bcdf0b00",
                                        "glosses": [
                                            "Wagon servant au transport de bagages."
                                        ],
