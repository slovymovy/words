                "senses": [
                    {
                        "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                        "entry_id": "68bcac93-027d-3c63-bd1e-c0cc3a72faba",
                        "glosses": [
                            "Ausmaß, in dem sich eine Person, Organisation oder Institution fremdes Geld in Summe geliehen hat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b473cae4-8ed9-49e1-a219-61c21456b68b",
                                "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                                "text": "Seine Verschuldung ist um das Doppelte angestiegen seit dem letzten Jahr, er lebt auf zu großem Fuß."
                            },
                            {
                                "example_id": "912c3c40-2b84-460b-8a84-788028ad5705",
                                "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                                "text": "Die Verschuldung des Staates ist nach der Krise dreimal so hoch wie das Bruttosozialprodukt."
                            },
                            {
                                "example_id": "b878f707-c285-4159-be38-fdeae587009a",
                                "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                                "text": "„Der Thüringer Rechnungshof hatte 2010 angesichts der hohen Verschuldung des Freistaats dringend eine Haushaltskonsolidierung angemahnt.“"
                            },
                            {
                                "example_id": "44ffc6e2-d61f-486c-8b48-de68fc0f9b2e",
                                "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                                "text": "„Vom Beginn der Arbeiten an war die Muskauer Unternehmung ein aufreibender Kampf gegen Verschuldung und wirtschaftlichen Ruin.“"
                            },
                            {
                                "example_id": "04ebb2c2-0cfd-4581-8861-019af9ffa399",
                                "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                                "text": "„Am 9. Juni 1509 stürmte eine aufgebrachte Menge das Erfurter Rathaus und verlangte Rechenschaft über die Verschuldung der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
