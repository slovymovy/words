{
    "word_family": [
        "liberate",
        "liberation",
        "liberator",
        "liberal"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "98830e02-5ee5-33a2-9aca-01fc31b60665",
                    "sense_definition": "Freed from traditional social or sexual constraints and expectations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She feels much more <w>liberated</w> since she started living on her own.",
                            "target_lang_translations": {
                                "de": "Sie fühlt sich viel <w>befreiter</w>, seit sie alleine wohnt."
                            }
                        },
                        {
                            "text": "They lead a <w>liberated</w> lifestyle that ignores many old-fashioned social rules.",
                            "target_lang_translations": {
                                "de": "Sie führen einen <w>befreiten</w> Lebensstil, der viele altmodische soziale Regeln ignoriert."
                            }
                        }
                    ],
                    "synonyms": [
                        "unconstrained",
                        "emancipated",
                        "unrestricted"
                    ],
                    "antonyms": [
                        "repressed",
                        "conservative"
                    ],
                    "common_phrases": [
                        "sexually liberated"
                    ],
                    "target_lang_definitions": {
                        "de": "Von traditionellen sozialen oder sexuellen Zwängen und Erwartungen befreit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "befreit",
                                "target_lang_sense_clarification": "von gesellschaftlichen oder persönlichen Zwängen gelöst"
                            },
                            {
                                "target_lang_word": "emanzipiert",
                                "target_lang_sense_clarification": "sich aus Abhängigkeiten gelöst habend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9838bb5e-c044-376e-9cee-6a1f0573eddb",
                    "sense_definition": "Simple past and past participle of <w>liberate</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers <w>liberated</w> the village from the enemy forces last week.",
                            "target_lang_translations": {
                                "de": "Die Soldaten haben das Dorf letzte Woche von den feindlichen Truppen <w>befreit</w>."
                            }
                        },
                        {
                            "text": "The prisoners were finally <w>liberated</w> after years of captivity.",
                            "target_lang_translations": {
                                "de": "Die Gefangenen wurden nach Jahren der Gefangenschaft endlich <w>befreit</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "freed",
                        "released",
                        "rescued"
                    ],
                    "antonyms": [
                        "captured",
                        "imprisoned"
                    ],
                    "target_lang_definitions": {
                        "de": "Die einfache Vergangenheitsform und das Partizip Perfekt von befreien."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "befreit",
                                "target_lang_sense_clarification": "aus einer Gefangenschaft oder Notlage gerettet"
                            },
                            {
                                "target_lang_word": "erlöst",
                                "target_lang_sense_clarification": "aus einer schwierigen oder leidvollen Situation befreit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}