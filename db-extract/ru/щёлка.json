                        "examples": [
                            {
                                "example_id": "a9a5f263-02f7-435b-b947-9985622e01de",
                                "sense_id": "6337183e-bf88-3eda-9fb8-95b3d8ff8975",
                                "text": "щёлка в двери́",
                                "translation": "门缝"
                            },
                            {
                                "example_id": "f3beb3bf-010c-4ca9-a5b1-eeb94426abda",
                                "sense_id": "6337183e-bf88-3eda-9fb8-95b3d8ff8975",
                                "text": "загляну́ть в щёлку",
                                "translation": "从小缝里窥视"
                            },
                            {
                                "example_id": "48a7e7ec-93d6-4068-a7cb-156a817dd98c",
                                "sense_id": "6337183e-bf88-3eda-9fb8-95b3d8ff8975",
                                "text": "Тако́й свет ли́лся с не́ба, что глаза́ у него́ ста́ли у́зкие, как щёлки.",
                                "translation": "天空的光线照得他把眼睛瞇缝成了一条缝。"
                            }
                        ]
                    }
