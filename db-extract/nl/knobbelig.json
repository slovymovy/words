                "senses": [
                    {
                        "sense_id": "80574054-aaac-3875-b7a7-4997ef342c6c",
                        "entry_id": "33675f24-5ba2-3b75-b42b-015c3d96b3a7",
                        "glosses": [
                            "met veel bulten en knobbels, met halfbolvormige verhevenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c79f375-80ff-482f-afe8-dfb85657e483",
                                "sense_id": "80574054-aaac-3875-b7a7-4997ef342c6c",
                                "text": "Winkelshuis vroeg daarom omdat hij een tijd terug getuige was van een ‘bijna vreselijk ongeluk’ van een mevrouw met een rollater. ‘De kleine voorwieltjes stuiterden over de oneffen en knobbelige straatkeien. Op een gegeven moment stokte een van de kleine voorwielen en sloeg de mevrouw bijna voorover over de kantelende rollator. De mevrouw die naast haar liep kon haar nog net opvangen en zodoende erger voorkomen.’"
                            },
                            {
                                "example_id": "b91a5109-d454-463b-a5b0-490eaacb1e06",
                                "sense_id": "80574054-aaac-3875-b7a7-4997ef342c6c",
                                "text": "Stelt u zich eens voor: uit de keuken komt een kok met een hele spruitenstam: een knobbelige uitgave van Luke Skywalkers Stars Wars-zwaard."
                            }
                        ]
                    }
                ],
