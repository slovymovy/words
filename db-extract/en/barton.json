                "senses": [
                    {
                        "sense_id": "1d7e9355-c001-34a3-a29e-e9f15bebffc2",
                        "entry_id": "9eb95773-4b48-33f5-bb3e-808c4a3bd363",
                        "glosses": [
                            "A farmyard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d157988a-38b7-468b-a04d-669526d5e102",
                                "sense_id": "1d7e9355-c001-34a3-a29e-e9f15bebffc2",
                                "text": "There's the barton rich / With dyke and ditch / And hedge for the thrush to live in [...]."
                            },
                            {
                                "example_id": "0dca8a6d-3dd8-459f-9410-c29a25a43034",
                                "sense_id": "1d7e9355-c001-34a3-a29e-e9f15bebffc2",
                                "text": "So fair a fancy few would weave / In these years! Yet, I feel, / If someone said on Christmas Eve, / “Come; see the oxen kneel, / “In the lonely barton by yonder coomb / Our childhood used to know,” / I should go with him in the gloom, / Hoping it might be so."
                            }
                        ]
                    },
                    {
                        "sense_id": "74399ea5-35ac-315b-bcb5-ba1629f036f9",
                        "entry_id": "9eb95773-4b48-33f5-bb3e-808c4a3bd363",
                        "glosses": [
                            "the lands of a manor reserved for the Lord's use"
                        ],
