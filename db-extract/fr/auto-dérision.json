                        "cross_references": [
                            {
                                "target_word": "zelfspot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b9829ebe-145f-3bad-bfdb-62c5fdf8f65b",
                                        "entry_id": "d7646115-647d-3f66-a1aa-41f4bf0c13c1",
                                        "glosses": [
                                            "jezelf belachelijk maken met humoristische intentie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47abc406-8771-4e94-b5ae-7f9ab3644c31",
                                                "sense_id": "b9829ebe-145f-3bad-bfdb-62c5fdf8f65b",
                                                "text": "Want het is zeer goed mogelijk even fijn uit te spinnen en toch wijs te blijven, wanneer men slechts een tintje van zelf-ironie, een tintje van zelfspot, een greintje gelach over de eigen doordraverij in zijn werk brengt."
                                            },
                                            {
                                                "example_id": "b3c52abd-c8f8-4544-8332-e0ecbdcea50f",
                                                "sense_id": "b9829ebe-145f-3bad-bfdb-62c5fdf8f65b",
                                                "text": "Zelfspot (zelfhumor) is zeer gezond. Zichzelf wat kunnen relativeren is een gezonde reflex in een maatschappij die kreunt onder prestatiedruk. Dat de anderen mijn zelfspot beamen, moet ik er maar bij nemen."
                                            },
                                            {
                                                "example_id": "b251b558-a475-4423-a363-0aa26b36d5ea",
                                                "sense_id": "b9829ebe-145f-3bad-bfdb-62c5fdf8f65b",
                                                "text": "De beroemdste sprekers hebben in elk geval dit met elkaar gemeen: ze hebben een goed ontwikkeld gevoel voor humor en zijn niet bang voor een beetje zelfspot. Door zelfspot wordt de afstand tussen publiek en spreker verkleind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
