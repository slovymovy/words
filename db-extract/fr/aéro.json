                "senses": [
                    {
                        "sense_id": "fec9ccd2-a7c9-3fec-936f-30566f6d3a0f",
                        "entry_id": "2912afdd-0b89-347f-9c48-0b651b1381f0",
                        "glosses": [
                            "Aéroplane."
                        ],
                        "tags": [
                            "dated",
                            "familiar",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e85898ea-0045-40ad-a00a-47713b6f83e0",
                                "sense_id": "fec9ccd2-a7c9-3fec-936f-30566f6d3a0f",
                                "text": "Un aéro, en l'air, se confond avec les cerfs-volants et les oiseaux."
                            },
                            {
                                "example_id": "bdae678f-c290-4a9f-9df0-b513c6a9e35e",
                                "sense_id": "fec9ccd2-a7c9-3fec-936f-30566f6d3a0f",
                                "text": "Un espion allemand a commencé par voler au premier acte, chez M. Aubry, père de Germaine, des documents concernant un aéro de guerre, que ce brave homme a inventé."
                            },
                            {
                                "example_id": "d3489fbf-2459-4436-a427-1377f58f3a6d",
                                "sense_id": "fec9ccd2-a7c9-3fec-936f-30566f6d3a0f",
                                "text": "Dans la nuit du 30 au 31 mai, nous eûmes une visite dont nous nous serions passés volontiers : un aéro boche vint jeter des bombes sur le camp, mais grâce à sa maladresse il n’y eut aucune victime."
                            },
                            {
                                "example_id": "754e0c77-2251-4115-b417-f6b674b90091",
                                "sense_id": "fec9ccd2-a7c9-3fec-936f-30566f6d3a0f",
                                "text": "Le 26 mars, j'ai vu tomber un aéro allemand que le feu a ensuite détruit, alors que pilote et l'observateur s'en sont tirés."
                            }
                        ]
                    }
                ],
