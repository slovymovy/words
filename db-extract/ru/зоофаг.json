                    {
                        "translation_id": "a255cde2-90e6-48b9-a304-7f7263a9e5e5",
                        "source_entry_id": "e8e69c53-c6c3-3d34-aa60-2a4a98a396ec",
                        "source_sense_id": "3e398151-03db-3ffb-9c83-e314cbab6946",
