                    {
                        "sense_id": "b7b3ba14-d3f6-3a9f-a73f-67926079d00f",
                        "entry_id": "8a296384-0c50-372c-b035-fcc5923c5bba",
                        "glosses": [
                            "Aufzeichnungsgerät an Bord von Flugzeugen, welches fortlaufend wichtige Daten wie die Höhe und die Geschwindigkeit des Flugzeuges speichert und Funkverkehr und Geräusche (Stimmenrecorder) aufzeichnet"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "7863cfe0-099a-419a-9182-1ea7845b6f0f",
                                "sense_id": "b7b3ba14-d3f6-3a9f-a73f-67926079d00f",
                                "text": "„Auch aus französischen Ermittlerkreisen hieß es am Freitag, die Auswertung von Stimmrekordern und Flugdatenschreibern \"stütze\" die Vermutung.“"
                            },
                            {
                                "example_id": "fa0bab7b-fe64-44ae-882d-e7bebc4410ff",
                                "sense_id": "b7b3ba14-d3f6-3a9f-a73f-67926079d00f",
                                "text": "„UN-Soldaten in Mali haben den zweiten Flugdatenschreiber des verunglückten Air-Algérie-Flugzeugs entdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
