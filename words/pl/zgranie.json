                },
                {
                    "sense_id": "2a9f7889-5279-310e-a3be-5279c5906dd4",
                    "sense_definition": "rzeczownik odczasownikowy od <w>zgrać</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "czynność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szybkie <w>zgranie</w> wszystkich plików na dysk zewnętrzny zajęło tylko kilka minut.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>копирование</w> всех файлов на внешний диск заняло всего несколько минут."
                            }
                        },
                        {
                            "text": "Przed wyjazdem konieczne było <w>zgranie</w> zdjęć z aparatu do komputera.",
                            "target_lang_translations": {
                                "ru": "Перед поездкой было необходимо <w>сбросить</w> фотографии с камеры на компьютер."
                            }
