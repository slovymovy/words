                "senses": [
                    {
                        "sense_id": "82039101-59df-37e4-b0ab-e297b1d53f05",
                        "entry_id": "e3a2225d-6298-3544-94fd-c55d0d8fe316",
                        "glosses": [
                            "ein Boot mit Vorrichtungen zum Abmähen und Abtransport wuchernder Wasserpflanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b31bf48-8320-42dd-9865-89e8bd8862dd",
                                "sense_id": "82039101-59df-37e4-b0ab-e297b1d53f05",
                                "text": "Um den See für den Wassersport nutzbar zu halten, wird seit 2007 ein Mähboot eingesetzt, das die Wasserpflanzen regelmäßig abmäht."
                            },
                            {
                                "example_id": "f0384da0-40da-4ab2-9e51-b59c59038a00",
                                "sense_id": "82039101-59df-37e4-b0ab-e297b1d53f05",
                                "text": "Der zuständige Ruhrverband reduziert dort die Bestände mittlerweile regelmäßig mit einem eigenen Mähboot."
                            },
                            {
                                "example_id": "41ffb3c8-0e97-4107-b05f-921856f952f4",
                                "sense_id": "82039101-59df-37e4-b0ab-e297b1d53f05",
                                "text": "Die Teichrosen wurden mit einem speziellen Mähboot (Seekuh) abgemäht und anschliessend ans Ufer transportiert (Teichrosenverlad)."
                            },
                            {
                                "example_id": "4f45e7d2-b9bc-4ebf-918a-d57a356e79e5",
                                "sense_id": "82039101-59df-37e4-b0ab-e297b1d53f05",
                                "text": "Für die Entkrautung kommt ein spezielles Mähboot aus Schweden zum Einsatz, welches bereits in den vergangenen Jahren den Autobahnsee von den üppig wachsenden Wasserpflanzen befreite."
                            },
                            {
                                "example_id": "954af99c-ec81-4e9b-af27-010498cf8314",
                                "sense_id": "82039101-59df-37e4-b0ab-e297b1d53f05",
                                "text": "Aber selbst das reichte nicht aus, es wurde ein teures Mähboot angeschafft. Das Mähboot wurde mehrere Male im Jahr eingesetzt, um die störenden Wasserpflanzen um etwa 30 cm abzumähen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
