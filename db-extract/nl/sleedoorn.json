                                    {
                                        "sense_id": "ac562c56-d4a7-3ded-982d-38366789863d",
                                        "entry_id": "8303ea9d-96d1-3add-ac88-3c65929b2a13",
                                        "glosses": [
                                            "Prunier sauvage, arbrisseau qui porte les prunelles, de nom scientifique Prunus spinosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9da6bea-4e73-422b-8f15-06ff8ef657b0",
                                                "sense_id": "ac562c56-d4a7-3ded-982d-38366789863d",
                                                "text": "Les fleurs de prunellier servent à préparer des sirops et à parfumer des apéritifs ou des desserts."
                                            },
                                            {
                                                "example_id": "f694833d-3ece-4f3e-8698-eb373deef381",
                                                "sense_id": "ac562c56-d4a7-3ded-982d-38366789863d",
                                                "text": "La végétation naissante répandait sur les arbres une légère teinte verte mêlée de brun ; les amandiers et les abricotiers du jardin, ainsi que les prunelliers des buissons étaient en fleurs ; une magnifique journée s’éteignait dans un couchant couleur de rose."
                                            },
                                            {
                                                "example_id": "11dd381d-7579-4f9f-bdc6-7d11bcc91e0e",
                                                "sense_id": "ac562c56-d4a7-3ded-982d-38366789863d",
                                                "text": "Je revis Villeneuve avec sa longue ligne de maisons blanches à peine élevées au-dessus du coteau, ses toits fumants, sa campagne assombrie par l’hiver, ses buissons de prunelliers roussis par les gelées et bordant des chemins glacés."
                                            }
                                        ]
                                    }
                                ]
                            }
