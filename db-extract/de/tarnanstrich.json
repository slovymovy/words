                "senses": [
                    {
                        "sense_id": "5b96033d-f7e6-3e27-a23f-6589190731fe",
                        "entry_id": "b760b793-8be0-346a-ac03-fa6713a57d81",
                        "glosses": [
                            "Auftrag von Farbe auf Objekten mit dem Ziel, sie (aus der Ferne) schwerer erkennbar zu machen"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "9ecccc83-daf5-4da8-8a00-e4813909d15d",
                                "sense_id": "5b96033d-f7e6-3e27-a23f-6589190731fe",
                                "text": "„Bisher sind Militärmaschinen im Flug nur durch einen Tarnanstrich dagegen geschützt, entdeckt zu werden.“"
                            },
                            {
                                "example_id": "b9088f17-1929-4ba8-97cc-c6a9e913ff4e",
                                "sense_id": "5b96033d-f7e6-3e27-a23f-6589190731fe",
                                "text": "„Während des Kriegs erhielt die Schule einen Tarnanstrich und überstand die Zeit ohne Bombardierung.“"
                            },
                            {
                                "example_id": "a5b4cc46-6677-4b47-9001-4361fff81e10",
                                "sense_id": "5b96033d-f7e6-3e27-a23f-6589190731fe",
                                "text": "„Die Tarnnetze und der Tarnanstrich sind jetzt noch weniger wert als vorher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
