                                    },
                                    {
                                        "sense_id": "1e54f5ad-ddd5-3b95-bd7b-df2a4466b67e",
                                        "entry_id": "5bbe0907-e31a-3399-95bd-e2534a27435a",
                                        "glosses": [
                                            "The apparent difference in elevation in the surface of a painting or drawing made noticeable by a variation in light or color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee9a720b-a398-3486-9e9f-0c09e9f436c0",
                                        "entry_id": "5bbe0907-e31a-3399-95bd-e2534a27435a",
                                        "glosses": [
                                            "The difference of elevations on a surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acb71e3f-d47f-4111-a08e-97118288020a",
                                                "sense_id": "ee9a720b-a398-3486-9e9f-0c09e9f436c0",
                                                "text": "the relief on that part of the Earth's surface"
                                            },
                                            {
                                                "example_id": "c2510f34-0928-4ce5-b1d7-617e2c337527",
                                                "sense_id": "ee9a720b-a398-3486-9e9f-0c09e9f436c0",
                                                "text": "The approach to Newcastle (Central) Station from the north after a heavy snowfall. The complicated track layout is thrown into clear relief by the snow [referring to dark rails poking through the snow]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93708b59-1ab5-3670-97f4-7e4fa089a95f",
                                        "entry_id": "5bbe0907-e31a-3399-95bd-e2534a27435a",
                                        "glosses": [
                                            "Relative distinctness, perceived difference due to contrast."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "236f6a8c-81f5-4fcb-918e-e4b64356c4d7",
                                                "sense_id": "93708b59-1ab5-3670-97f4-7e4fa089a95f",
                                                "text": "And is it that the haze of grief\n⁠Hath stretch’d my former joy so great?\n⁠The lowness of the present state,\nThat sets the past in this relief?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50acb6a4-5023-31cc-86e4-fc39d08c90c7",
