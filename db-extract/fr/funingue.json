                        "glosses": [
                            "Pigeon de Madagascar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1220d5e8-f99a-476d-8746-f0957929d485",
                                "sense_id": "e1c62e18-ac0c-3dbf-9a36-84a774a085e5",
                                "text": "Le funingue, dit Levaillant, n'arrive dans le Pays des Cafres que vers la fin de février ; il ne hante que les grands bois, se perche sur les arbres les plus hauts et les plus touffus, de sorte qu'il serait très difficile de le découvrir."
                            },
                            {
                                "example_id": "4f6a414b-a224-4200-ad6e-bfef9914b559",
                                "sense_id": "e1c62e18-ac0c-3dbf-9a36-84a774a085e5",
                                "text": "Les pigeons de Madagascar, qui ont du être plus riches en espèces autrefois, sont réduits en cinq genres dont les deux plus remarquables sont le pigeon bleu ou funingue (Alectroenas madagascariensis) et le pigeon vert ou colombar austral."
                            }
                        ]
                    }
