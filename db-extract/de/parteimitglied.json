                        "source_entry_id": "09b2eca2-681a-366b-8317-5b21947cc759",
                        "source_sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
                        "source_sense_description": "Person, die in eine Partei eingetreten ist",
                        "target_lang_word": "partijlid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partijlid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b5dbda5c-918a-3ec8-8079-a14f7a8a5082",
                                        "entry_id": "bba45b2c-7a52-345b-b46b-a50f17cd6e68",
                                        "glosses": [
                                            "iemand die lid is van een bepaalde politieke partij"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e359079-08ba-4b8d-80e1-2d2886bffd64",
                                                "sense_id": "b5dbda5c-918a-3ec8-8079-a14f7a8a5082",
                                                "text": "Ik ben nooit partijlid geweest, want ik heb sympathieën voor meerdere partijen."
                                            },
                                            {
                                                "example_id": "cd22b142-652f-49c8-92c0-6df4f5b0af2d",
                                                "sense_id": "b5dbda5c-918a-3ec8-8079-a14f7a8a5082",
                                                "text": "Onder Mao Zedong, die als student en jong partijlid in Shanghai verbleef, werd de sport verbannen want „decadent en westers”. Mao noemde de sport „groene opium”. Onder zijn pragmatische opvolger Deng Xiaoping mochten er weer golfbanen aangelegd worden om buitenlanders (en hun kapitaal) aan te trekken. Formeel werd Mao’s verbod overigens nooit opgeheven. Sterker nog, er volgde in 2004 een nieuw verbod dat op grote schaal ontdoken werd. In dat jaar beschikte China over 176 clubs, waarvan tien legaal. Zes jaar later waren er meer dan 600 die schuilgingen achter namen als Yangshan Ecologisch Project (op Hainan) of Zhengzhou Private Residences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e1a89bd-4d38-4393-af25-51453d2ba17a",
                        "source_entry_id": "09b2eca2-681a-366b-8317-5b21947cc759",
                        "source_sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
