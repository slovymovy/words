                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a779ef9-60a0-4bff-94c8-b81ba316cd7d",
                                "sense_id": "facebe13-a423-366a-8b1c-16591b38dca3",
                                "text": "Byłoby jednak roztropnie, by poddać ocenie dokonanie egzekucji w trybie doraźnym, tak samo jak kapitan, który stracił jednostkę, zawsze staje przed sądem wojennym"
                            }
                        ],
