                            }
                        },
                        {
                            "text": "Het smalle pad <w>slingerde</w> zich omhoog naar de top van de heuvel.",
                            "target_lang_translations": {
                                "en": "The narrow path <w>twisted</w> its way up to the top of the hill."
                            }
                        }
                    ],
                    "synonyms": [
