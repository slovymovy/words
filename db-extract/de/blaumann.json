                        ],
                        "form": "die Blaumänner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a65b1be4-eb40-3953-ba9a-3b58b542602f",
                        "entry_id": "c4d6bfd5-9835-39f9-a82c-e9626e23993a",
                        "glosses": [
                            "blauer Arbeitsoverall, der meist im Baugewerbe und verschiedenen Handwerksberufen getragen wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c286c8ff-095e-4448-945a-5e91eced487c",
                                "sense_id": "a65b1be4-eb40-3953-ba9a-3b58b542602f",
                                "text": "Für seinen neuen Beruf als Kraftfahrzeugschlosser musste er sich Blaumänner kaufen."
                            },
                            {
                                "example_id": "594fb959-f657-44bf-9d3d-9737395ac75c",
                                "sense_id": "a65b1be4-eb40-3953-ba9a-3b58b542602f",
                                "text": "„Sein Blaumann verströmte den strengen Geruch einer Arbeitswoche.“"
                            },
                            {
                                "example_id": "ba79efdc-3f01-43c6-8369-8f4e66d2102f",
                                "sense_id": "a65b1be4-eb40-3953-ba9a-3b58b542602f",
                                "text": "„Im Blaumann stand er neben der großen Flügeltür, hörte zu und lächelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12204bdb-cff6-45f1-9e75-b678b371f364",
                        "source_entry_id": "c4d6bfd5-9835-39f9-a82c-e9626e23993a",
                        "source_sense_id": "a65b1be4-eb40-3953-ba9a-3b58b542602f",
                        "source_sense_description": "blauer Arbeitsoverall",
                        "target_lang_word": "boiler suit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boiler suit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e7a5db9-2dce-3dfa-ac40-b67bc4bd32b2",
                                        "entry_id": "70c55fe8-84ce-3075-bb3d-e7e9af4b0862",
                                        "glosses": [
                                            "A one-piece suit combining trousers and jacket, worn for heavy or hot manual labour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1cd4aac-5899-4dc2-a8ae-17fed71b9783",
                                                "sense_id": "6e7a5db9-2dce-3dfa-ac40-b67bc4bd32b2",
                                                "text": "Where Babcock has proprietary technologies, they will be preserved and developed, in so far as they help to give the company an edge over its rivals. But make no mistake, if Parker and Salmon have their way, boiler suits are the workwear of yesteryear at Babcock. Graduates, not grease-monkeys, are the typical employees of the future."
                                            },
                                            {
                                                "example_id": "aec31b9c-4b42-427a-9b39-83e746488552",
                                                "sense_id": "6e7a5db9-2dce-3dfa-ac40-b67bc4bd32b2",
                                                "text": "The boiler suit was the kind with stud-fasteners rather than a zip."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f69e2d55-210a-42bc-bbe8-14735d742dff",
                        "source_entry_id": "c4d6bfd5-9835-39f9-a82c-e9626e23993a",
                        "source_sense_id": "a65b1be4-eb40-3953-ba9a-3b58b542602f",
                        "source_sense_description": "blauer Arbeitsoverall",
                        "target_lang_word": "bleu de travail",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bleu de travail",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab064985-49ab-3e3a-871a-0613ef1a7a7c",
                                        "entry_id": "20a44794-b9d3-3d93-ba41-555712b57ce5",
                                        "glosses": [
                                            "Survêtement pour protéger les vêtements lors d’un travail manuel salissant, souvent de couleur bleu foncé, généralement en coton ou en polycoton, rarement en tissus synthétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c87326-bc04-403f-943c-b50152e71505",
                                                "sense_id": "ab064985-49ab-3e3a-871a-0613ef1a7a7c",
                                                "text": "Une fois il trouve son galetas occupé par un chétif avorton qui dort là : il a les cheveux blancs, il est maigre, à peine plus grand qu’un enfant et il porte un bleu de travail rapiécé."
                                            },
                                            {
                                                "example_id": "ea31c29e-907d-42a1-a8a5-038f0e0c1c22",
                                                "sense_id": "ab064985-49ab-3e3a-871a-0613ef1a7a7c",
                                                "text": "Le nom de Soubacq n’a pas été choisi par hasard par Louise Drouhet. Il reprend en effet le patronyme d’une certaine mademoiselle Soubacq, jeune fille de bonne famille et amoureuse d’un ouvrier dont elle ajustera et reprisera son bleu de travail en y brodant son nom tout au long de leur idylle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
