    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "57ca0999-0e78-357e-ae6c-c8202558edd8",
                    "sense_definition": "Polite social behavior or rules of conduct.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should always mind your <w>manners</w> when you are a guest in someone's home.",
                            "target_lang_translations": {
                                "ru": "В гостях всегда нужно следить за своими <w>манерами</w>.",
                                "zh": "在别人家做客时，你一定要注意自己的<w>礼貌</w>。"
                            }
                        },
                        {
                            "text": "His table <w>manners</w> were impeccable during the formal dinner party.",
                            "target_lang_translations": {
                                "ru": "Его <w>манеры</w> за столом во время званого ужина были безупречны.",
                                "zh": "在正式晚宴上，他的餐桌<w>礼仪</w>无可挑剔。"
                            }
                        }
                    ],
                    "synonyms": [
                        "etiquette",
                        "politeness",
                        "decorum",
                        "propriety"
                    ],
                    "antonyms": [
                        "rudeness"
                    ],
                    "common_phrases": [
                        "table manners",
                        "mind your manners",
                        "good manners",
                        "bad manners"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливое поведение в обществе или правила этикета.",
                        "zh": "在社交场合中表现出的礼貌行为或礼仪规范。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манеры",
                                "target_lang_sense_clarification": "поведение"
                            },
                            {
                                "target_lang_word": "правила приличия",
                                "target_lang_sense_clarification": "этикет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "礼貌",
                                "target_lang_sense_clarification": "指人的行为举止"
                            },
                            {
                                "target_lang_word": "礼仪",
                                "target_lang_sense_clarification": "指社交规范"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4d7e428-2087-3734-bb51-2db9fbb77dda",
                    "sense_definition": "Plural of <w>manner</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book describes the customs and <w>manners</w> of the ancient tribes in great detail.",
                            "target_lang_translations": {
                                "ru": "Книга подробно описывает обычаи и <w>нравы</w> древних племен.",
                                "zh": "这本书详细描述了古代部落的习俗和<w>风尚</w>。"
                            }
                        },
                        {
                            "text": "She studied the different <w>manners</w> of speaking found across the region.",
                            "target_lang_translations": {
                                "ru": "Она изучала различные <w>манеры</w> речи, встречающиеся в этом регионе.",
                                "zh": "她研究了该地区各种不同的说话<w>方式</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова manner (обычаи, нравы, способы).",
                        "zh": "指特定群体或地区的习俗、风尚或行为方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нравы",
                                "target_lang_sense_clarification": "уклад жизни"
                            },
                            {
                                "target_lang_word": "обычаи",
                                "target_lang_sense_clarification": "традиции"
                            },
                            {
                                "target_lang_word": "манеры",
                                "target_lang_sense_clarification": "мн. ч. от манера: способы, образ действий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "习俗",
                                "target_lang_sense_clarification": "指社会风尚"
                            },
                            {
                                "target_lang_word": "风尚",
                                "target_lang_sense_clarification": "指行为方式"
                            },
                            {
                                "target_lang_word": "方式",
                                "target_lang_sense_clarification": "manner 的复数：方法、样式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "845670c3-694d-3f92-b050-9489ea0f86cd",
                    "sense_definition": "A surname of Norman origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The estate has been owned by the <w>Manners</w> family for several centuries.",
                            "target_lang_translations": {
                                "ru": "Поместье принадлежало семье <w>Маннерс</w> на протяжении нескольких веков.",
                                "zh": "这座庄园几个世纪以来一直由<w>曼纳斯</w>家族拥有。"
                            }
                        },
                        {
                            "text": "I have an appointment with Mr. <w>Manners</w> regarding the new contract.",
                            "target_lang_translations": {
                                "ru": "У меня назначена встреча с мистером <w>Маннерсом</w> по поводу нового контракта.",
                                "zh": "我和<w>曼纳斯</w>先生约好讨论新合同的事。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "from Norman"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия нормандского происхождения.",
                        "zh": "源自诺曼底的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Маннерс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "曼纳斯",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e5be3f2-2ea9-3719-b269-5a4596ba7ce2",
                    "sense_definition": "Plural of <w>Manner</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are three people named <w>Manners</w> listed in the local directory.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике значатся три человека по фамилии <w>Маннерс</w>.",
                                "zh": "当地名录里列出了三位名叫<w>曼纳斯</w>的人。"
                            }
                        },
                        {
                            "text": "We invited the <w>Mannerses</w> to join us for the holiday celebration.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили <w>Маннерсов</w> присоединиться к нам на празднование.",
                                "zh": "我们邀请了<w>曼纳斯一家</w>来参加我们的节日庆典。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
