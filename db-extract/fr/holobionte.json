                        "target_lang_word": "holobiont",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holobiont",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ea3e3e8-daf4-3360-a49a-03b93b076b84",
                                        "entry_id": "3b1c151b-43ef-341a-997b-28a7237420bd",
                                        "glosses": [
                                            "A host organism plus its associated microorganisms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d819b53-d750-4d21-b70c-8cdb6f39d13e",
                                                "sense_id": "0ea3e3e8-daf4-3360-a49a-03b93b076b84",
                                                "text": "The variables we considered include solar irradiance and turbidity, which are relevant to the symbiont photosynthesis and yearly minimum temperature, representing potential limiting factors for the holobiont."
                                            },
                                            {
                                                "example_id": "544dc8fb-1520-4d84-b07a-f66e693e5a91",
                                                "sense_id": "0ea3e3e8-daf4-3360-a49a-03b93b076b84",
                                                "text": "Some say we should be seen as a holobiont, a term that reflects the intimate, co-dependent relationship humans have with microbes."
                                            },
                                            {
                                                "example_id": "d7b555f9-a4f3-42fa-8ec9-1a518ddb64ea",
                                                "sense_id": "0ea3e3e8-daf4-3360-a49a-03b93b076b84",
                                                "text": "Holobionts are the lichens of this world, the more-than-the-sums of parts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
