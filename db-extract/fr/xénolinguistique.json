                    {
                        "sense_id": "714a4b43-604b-3aac-9347-882bf1953cfc",
                        "entry_id": "fc41b4ba-bfd2-33f5-ba5a-33f462b10c2d",
                        "glosses": [
                            "Étude des langues extraterrestres."
                        ],
                        "tags": [
                            "Science-fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "e45312bf-bcd9-4d5e-98fd-29eaa3a069ca",
                                "sense_id": "714a4b43-604b-3aac-9347-882bf1953cfc",
                                "text": "— Mais on n’a pas de service de xénolinguistique marmmonaije.\n— Les Corcovados parlent parfaitement l’espagnol et l’anglais et même un peu d’allemand maintenant. Ils apprennent vite."
                            },
                            {
                                "example_id": "b874ce9c-67f8-44f3-84e6-5a432adf0360",
                                "sense_id": "714a4b43-604b-3aac-9347-882bf1953cfc",
                                "text": "Comment enseigner un langage que personne ne parle ou n’a même jamais entendu? C’est la première question à laquelle a dû répondre Sheri Wells-Jensen, professeure de linguistique à l’Université d’État de Bowling Green (Ohio), en composant le programme de son cours de xénolinguistique, l’étude des langues extraterrestres."
                            },
                            {
                                "example_id": "c1590eae-5801-42a7-9030-e6ae081ae657",
                                "sense_id": "714a4b43-604b-3aac-9347-882bf1953cfc",
                                "text": "Le film parvient à rendre intéressant le défi de la xénolinguistique."
                            }
                        ]
                    }
