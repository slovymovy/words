                    {
                        "translation_id": "3c6c1188-2d94-47fd-82d6-caa8a9519ce5",
                        "source_entry_id": "60d939f3-3e0d-3cee-9b38-ecc41a66cf37",
                        "source_sense_id": "62d4ba73-5d87-330a-9fb8-c0216fa267c5",
