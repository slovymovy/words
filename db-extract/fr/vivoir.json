                                "target_senses": [
                                    {
                                        "sense_id": "0c5d2838-009c-3867-a552-8891da1e01a9",
                                        "entry_id": "71466dae-f8f0-3439-97dd-eed15b4b77d8",
                                        "glosses": [
                                            "een kamer die primair is ingericht om in te wonen en gasten te ontvangen"
                                        ],
                                        "tags": [
                                            "vertrek",
                                            "wonen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8155c192-0126-4b7b-adfb-4cf69bf7daaf",
                                                "sense_id": "0c5d2838-009c-3867-a552-8891da1e01a9",
                                                "text": "De woonkamer was op het noorden gelegen."
                                            },
                                            {
                                                "example_id": "ae83d10e-93f0-40f7-b34a-c4390c073701",
                                                "sense_id": "0c5d2838-009c-3867-a552-8891da1e01a9",
                                                "text": "Er zaten geen bekende gezichten in de woonkamer dus liep ik richting de lokale brouwerij, waar altijd wel iemand te vinden was."
                                            },
                                            {
                                                "example_id": "8f0bcf3a-4bbc-4918-9132-5bbf6d920427",
                                                "sense_id": "0c5d2838-009c-3867-a552-8891da1e01a9",
                                                "text": "Er kon geen sprake van zijn dat ze haar kleine woonkamer op de benedenverdieping binnen konden gaan, laat staan de keuken, met opluchting stelde hij vast dat het symbolische theedrinken al een gepasseerd station was omdat ze direct naar de slaapkamer boven gingen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
