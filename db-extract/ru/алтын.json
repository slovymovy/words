                                        "entry_id": "2c1f6c0c-8408-380d-a71d-9a657f03ec8c",
                                        "glosses": [
                                            "Ancienne Pièce de monnaie russe, valant 3 kopeks de rouble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f15ae13-efef-4bd5-9a88-d54e1e0546ea",
                                                "sense_id": "fca4c6a7-29e4-31b0-acf3-b2feba95478a",
                                                "text": "Il y eut ainsi des demi-roubles, des altyns, ou pièces de trois copeks, des grocheviki, ou pièces de deux copeks, des copeks et des dengui."
