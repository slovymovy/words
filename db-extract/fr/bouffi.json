                    },
                    {
                        "translation_id": "907d6ef1-6d40-4104-b6fe-09c333d24fb4",
                        "source_entry_id": "b2a4ac31-9432-3a28-8872-7b33c472463d",
                        "target_lang_word": "aufgedunsen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufgedunsen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da1241be-4ec5-3c61-bbfc-2d4f70effc27",
                                        "entry_id": "e928c075-e6f3-37f9-9b61-4adf41083063",
                                        "glosses": [
                                            "in einem geschwollenen, aufgequollenen Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10943bf1-5818-4947-8abd-293ecdeb478e",
                                                "sense_id": "da1241be-4ec5-3c61-bbfc-2d4f70effc27",
                                                "text": "„Sie hatten seine Leiche am Straßenrand gefunden, den Bauch aufgedunsen von rohem Getreide, das der Verzweifelte kurz vor dem Tod in sich hineingestopft hatte.“"
                                            },
                                            {
                                                "example_id": "03b283a6-b45b-4686-bc8c-b9560e53e5fe",
                                                "sense_id": "da1241be-4ec5-3c61-bbfc-2d4f70effc27",
                                                "text": "„Meine Lippen und mein Gesicht waren aufgedunsen. Und mit jeder Minute schien meine Luftröhre stärker zuzuschwellen, schien es schwerer, Luft zu bekommen.“"
                                            },
                                            {
                                                "example_id": "ce3da599-7d02-48cd-95c5-d6a57873f725",
                                                "sense_id": "da1241be-4ec5-3c61-bbfc-2d4f70effc27",
                                                "text": "„Als ich durch Berkeley fuhr, kamen mir die grässlichen Geschichten in den Sinn, die man sich über die Stadt erzählte – über das schuppige, aufgedunsene, krötenhafte Ungeheuer, das in einem Verlies gehalten wurde, und über die Hexe von Berkeley, von deren Sarg sich auf unerklärliche Weise die Ketten lösten, ehe ihr Leichnam herausstieg.“"
                                            },
                                            {
                                                "example_id": "4b5feef9-785b-46a7-a410-01e687f4f613",
                                                "sense_id": "da1241be-4ec5-3c61-bbfc-2d4f70effc27",
                                                "text": "„Seine Augen waren blau und huschten umher – Schweinsäuglein; aus ihren aufgedunsenen Fettpolstern in dem zu runden Babygesicht glotzten sie etwas hervor.“"
                                            },
                                            {
                                                "example_id": "09c878aa-ab38-4973-914a-9d71d7579db8",
                                                "sense_id": "da1241be-4ec5-3c61-bbfc-2d4f70effc27",
                                                "text": "Seine Augen sind rot, sein Bart ist fettig und schmutzig, sein Pansen aufgedunsen, an den Händen hat er Krallen; mit denen packt er die Seelen, reißt ihnen die Haut ab und zerstückelt sie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
