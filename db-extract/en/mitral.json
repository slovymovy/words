                "senses": [
                    {
                        "sense_id": "14fb2c54-2577-3bed-91c1-3fd123d9a80d",
                        "entry_id": "bcd686fd-aeff-307e-85b6-c917bd8228cd",
                        "glosses": [
                            "Pertaining to a mitre; resembling a mitre."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a5cb2eed-d201-485d-8db4-cdb5f05f5be1",
                                "sense_id": "14fb2c54-2577-3bed-91c1-3fd123d9a80d",
                                "text": "The mitral valve was named for a fancied resemblance to a bishop's mitre."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdb0d752-aa60-38df-b8ed-a6f8f205071a",
                        "entry_id": "bcd686fd-aeff-307e-85b6-c917bd8228cd",
                        "glosses": [
                            "Pertaining to the mitral valve."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "745f851b-3daf-491e-8ad2-893e6499a098",
                                "sense_id": "fdb0d752-aa60-38df-b8ed-a6f8f205071a",
                                "text": "Treatments for mitral insufficiency include antihypertensives and valvular surgery; today the latter is often minimally invasive and even totally endoscopic."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19575500-e20b-4dcc-aab6-78e6df2721fd",
                        "source_entry_id": "bcd686fd-aeff-307e-85b6-c917bd8228cd",
                        "source_sense_description": "pertaining to the mitral valve",
                        "target_lang_word": "mitral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09abe555-ab1e-3490-bda3-ff4c798e2e91",
                                        "entry_id": "56c799f1-6c04-349d-8699-3ea8cb65b782",
                                        "glosses": [
                                            "Qualifie une des valvules du cœur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97340985-cc72-4056-8293-da3cbf3e37a0",
                                                "sense_id": "09abe555-ab1e-3490-bda3-ff4c798e2e91",
                                                "text": "Si, chez un malade atteint de sténose mitrale, se montrent inopinément des crachats sanglants, on aura grandement raison de supposer l'existence d'un infractus pulmonaire hémorrhagique."
                                            },
                                            {
                                                "example_id": "cd9ac592-a51f-455d-a507-e0a4dbd4c1b5",
                                                "sense_id": "09abe555-ab1e-3490-bda3-ff4c798e2e91",
                                                "text": "C’est, comme l’insuffisance mitrale, une faiblesse de complexion avec laquelle il faut bien vivre et mourir."
                                            },
                                            {
                                                "example_id": "ad0fbdb6-624a-4dc6-ab73-2faf1e2e8c96",
                                                "sense_id": "09abe555-ab1e-3490-bda3-ff4c798e2e91",
                                                "text": "Ainsi, il paraît logique d’anticoaguler les patients présentant une cardiopathie à haut risque de récidive embolique : prothèses valvulaires mécaniques, valvulopathies mitrales, infarctus du myocarde récent, cardiomyopathies dilatées, anévrysmes ventriculaires, fibrillation auriculaire non rhumatismale associée à un thrombus intracavitaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccdefc7d-8ffb-3498-bb49-b6139fb044a8",
                                        "entry_id": "56c799f1-6c04-349d-8699-3ea8cb65b782",
                                        "glosses": [
                                            "Qui est en forme de mitre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e17bbf3a-fad9-440c-88ca-cdfbbe1c0212",
                        "source_entry_id": "bcd686fd-aeff-307e-85b6-c917bd8228cd",
                        "source_sense_description": "pertaining to the mitral valve",
                        "target_lang_word": "mitral",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitral",
