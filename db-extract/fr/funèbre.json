        "fr-extract.jsonl": [
            {
                "entry_id": "baa450f2-43d8-3c10-8d09-966cc66951b0",
                "word": "funèbre",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "69dad85f-16c1-48dc-8fdd-bdcd52116517",
                        "entry_id": "baa450f2-43d8-3c10-8d09-966cc66951b0",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "funèbres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                        "entry_id": "baa450f2-43d8-3c10-8d09-966cc66951b0",
                        "glosses": [
                            "Qui a rapport aux funérailles."
                        ],
                        "tags": [
                            "Funéraire"
                        ],
                        "examples": [
                            {
                                "example_id": "c79f50a6-fd18-4041-b0ee-609b727ee9d3",
                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                "text": "Les convois funèbres se succédaient, avec leurs escortes de sous-officiers boueux et de rosses efflanquées."
                            },
                            {
                                "example_id": "136b5733-0f6f-45cb-b2d4-bb6bc7df5a4f",
                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                "text": "L'Erèbe les eût pris pour ses coursiers funèbres,\nS'ils pouvaient au servage incliner leur fierté. – Charles Baudelaire [1821-1867], \"Les chats\", in Les Fleurs du mal (1857)."
                            },
                            {
                                "example_id": "330af68a-8614-46b4-8093-2776271dbc4f",
                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                "text": "Sois donc le crieur du devoir\nÔ notre funèbre oiseau noir ! – Arthur Rimbaud [1854-1891], \"Les corbeaux\" (1872)"
                            },
                            {
                                "example_id": "4397997e-0fc2-4472-9ae1-1a04f7335f0d",
                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                "text": "Enfin, sur l’ordre du docteur, on transporta dans la salle de mairie le funèbre colis que deux hommes dévoués dévêtirent et fouillèrent."
                            },
                            {
                                "example_id": "5ceb63f8-93a6-49b5-aa30-9bb19afc4840",
                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                "text": "[…] les convives d'un repas funèbre devant bientôt s'attabler en cette maison, il importe que je prépare consciencieusement la tête de veau dont ils m'ont passé commande."
                            },
                            {
                                "example_id": "a6bbf696-71bb-49ea-aa17-0226ac5f8e09",
                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                "text": "Advienne que pourra, il doit l'assister auprès du défunt, jusqu'à la mise en fosse et monter avec elle la garde funèbre."
                            },
                            {
                                "example_id": "2c32cdc9-ee54-451e-b0d3-0d5946691aaf",
                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                "text": "Il était affreux de songer que le déroulement correct d’une cérémonie funèbre pouvait apporter aux proches du défunt une sorte de soulagement et comme le sentiment d’une réussite mondaine dans le malheur."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb5cfc2c-ea8b-3127-a72e-bc98d2b258f8",
                        "entry_id": "baa450f2-43d8-3c10-8d09-966cc66951b0",
                        "glosses": [
                            "Qui est lugubre ; qui éveille l’idée de la mort."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "037ecf39-4bc7-4506-a2aa-68aaf93dcec2",
                                "sense_id": "fb5cfc2c-ea8b-3127-a72e-bc98d2b258f8",
                                "text": "[…]; tous tenaient à la main droite ou des épées, ou des piques, ou des arquebuses, et quelques-uns, à la main gauche, des flambeaux qui répandaient sur cette scène un jour funèbre et vacillant, […]."
                            },
                            {
                                "example_id": "f3bc22bf-f6f6-4158-9dae-1e173654a3a6",
                                "sense_id": "fb5cfc2c-ea8b-3127-a72e-bc98d2b258f8",
                                "text": "Le bruit, les allées et venues des gens m'alertèrent. J'accourus avec un funèbre pressentiment, sans toutefois penser à un malheur aussi terrible."
                            },
                            {
                                "example_id": "5350b011-f095-49b7-ad73-9ff580fcd8b0",
                                "sense_id": "fb5cfc2c-ea8b-3127-a72e-bc98d2b258f8",
                                "text": "Au bout d'un couloir funèbre et saugrenu dont la disposition avait je ne sais quoi de caligaresque, l'entrée de La Java ne fait guère impression."
                            }
                        ]
                    },
                    {
                        "sense_id": "60663094-22d0-3db3-8250-f0a2a3e4bffc",
                        "entry_id": "baa450f2-43d8-3c10-8d09-966cc66951b0",
                        "glosses": [
                            "Qualifie certains oiseaux nocturnes, dont le cri a quelque chose de sinistre."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "54f89b74-e656-482f-8ec2-47cbc1a9d468",
                                "sense_id": "60663094-22d0-3db3-8250-f0a2a3e4bffc",
                                "text": "Oiseaux funèbres, se dit de certains oiseaux nocturnes. – Dictionnaire de l'Académie française, 9e éd. (1992)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccfc4d30-db95-4a43-80df-2be82635fc77",
                        "source_entry_id": "baa450f2-43d8-3c10-8d09-966cc66951b0",
                        "target_lang_word": "funeral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "funeral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df65c748-87c9-3a2e-b07b-6de657f1bb5d",
                                        "entry_id": "7ade1cfe-49be-36b8-8752-4901b71e3f59",
                                        "glosses": [
                                            "A ceremony to honor and remember a deceased person, often distinguished from a memorial service by the presence of the body of the deceased."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22ccce80-a10c-4019-8f2b-b47136cdb65a",
                                                "sense_id": "df65c748-87c9-3a2e-b07b-6de657f1bb5d",
                                                "text": "Many mourners turned up at the local artist's funeral to pay homage."
                                            },
                                            {
                                                "example_id": "67d4b5b4-971e-4cd9-a192-1335652d2f48",
                                                "sense_id": "df65c748-87c9-3a2e-b07b-6de657f1bb5d",
                                                "text": "The taking Away of Righteous & Merciful Perſons muſt be taken to Heart, APPLIED IN A SERMON AT THE FUNERALLS OF Mʳⁱˢ ANNE-MARY CHILD. Wife of THOMAS CHILD Eſq. of North-wick in the Pariſh of Blockley. Worceſter-ſhire.[…]TO THE Exemplarily Vertuous Gentle-woman, his much honoured friend, Mʳˢ ANNE CHILD, Eldeſt daughter of THOMAS CHILD of Northwicke Eſquire. AS I mean not an exerciſe for your modeſty by a flattering Epiſtle, ſo neither doe I intend the renewing of your ſorrows, by preſenting you with the plaine Sermon preach’t at the funerals of your bleſſed Mother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "272ba5b9-e2ff-3a5c-8387-ee7471d5f11d",
                                        "entry_id": "7ade1cfe-49be-36b8-8752-4901b71e3f59",
                                        "glosses": [
                                            "A funeral sermon."
                                        ],
                                        "tags": [
                                            "dated",
                                            "in-plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "funeral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c07c695-0466-35bf-82ed-a285b8372b3d",
                                        "entry_id": "f093c63b-2704-334c-ac96-57861e1b64b1",
                                        "glosses": [
                                            "Alternative spelling of funereal."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable",
                                            "uncommon",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c96085d9-c6c9-48ac-935b-5754718bd509",
                                                "sense_id": "6c07c695-0466-35bf-82ed-a285b8372b3d",
                                                "text": "All was funeral gloom and hope never whispered its cheering promises there."
                                            },
                                            {
                                                "example_id": "0aa06d08-de3b-4065-a7c9-78fd71443211",
                                                "sense_id": "6c07c695-0466-35bf-82ed-a285b8372b3d",
                                                "text": "Indeed I felt it altogether beautiful; and, as the \"dying day-hymn stole aloft,\" the dim sun-beams fell, through a vista of naked motionless trees, upon the coffin, which was borne with a slower and more funeral pace than before, in a manner that threw a solemn and visionary light upon the whole procession."
                                            },
                                            {
                                                "example_id": "f594f0c3-d855-4c30-a42b-803e08f4cebb",
                                                "sense_id": "6c07c695-0466-35bf-82ed-a285b8372b3d",
                                                "text": "There was something dramatic and theatrical in the very funeral ceremonies with which Demetrius was honored."
                                            },
                                            {
                                                "example_id": "fa36a62a-29fc-41a6-982e-ca33586c6e53",
                                                "sense_id": "6c07c695-0466-35bf-82ed-a285b8372b3d",
                                                "text": "The very funeral pageantry disguised behind-the-scenes struggles for control over Sidney's image."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c46a162-148f-4cb0-84f7-bbdb540f66ce",
                        "source_entry_id": "baa450f2-43d8-3c10-8d09-966cc66951b0",
                        "target_lang_word": "funereal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "funereal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02b5b42d-3c3b-334a-9df3-cf526e88d243",
                                        "entry_id": "64303538-0185-3365-a70f-9bfdc9a92d04",
                                        "glosses": [
                                            "Of or relating to a funeral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272444c3-6f61-4caa-ab7d-710792080064",
                                                "sense_id": "02b5b42d-3c3b-334a-9df3-cf526e88d243",
                                                "text": "From the belfries far and near the funereal deathbell tolled unceasingly while all around the gloomy precincts rolled the ominous warning of a hundred muffled drums punctuated by the hollow booming of pieces of ordnance."
                                            },
                                            {
                                                "example_id": "e97da6ec-48f1-4840-8326-d5530aa23464",
                                                "sense_id": "02b5b42d-3c3b-334a-9df3-cf526e88d243",
                                                "text": "Seven were chosen to push the funereal boat to the water, in honor of the seven faces of god."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac506e6a-7bf6-34f1-85e9-40af2e7ad27c",
                                        "entry_id": "64303538-0185-3365-a70f-9bfdc9a92d04",
                                        "glosses": [
                                            "Similar to or befitting the mood or elements of a funeral: slow; black colors; formal; dignified or solemn."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0db5b12a-91d7-4aa5-a4dd-f006a007bf5e",
                                                "sense_id": "ac506e6a-7bf6-34f1-85e9-40af2e7ad27c",
                                                "text": "A funereal gloom prevailed over the whole ſcene.",
                                                "translation": "Vathek",
                                                "english": "Vathek"
                                            },
                                            {
                                                "example_id": "24b4fa99-9c7c-4690-9294-43c43891d6e9",
                                                "sense_id": "ac506e6a-7bf6-34f1-85e9-40af2e7ad27c",
                                                "text": "\"Sounds curst funereal, Zeb! O my poor nunky! Go fetch 'em, Sergeant, and let me see 'em—'twill distress and pain me I know but—go fetch 'em!\""
                                            },
                                            {
                                                "example_id": "d125a20c-d9ed-48d5-b49c-a293038d617e",
                                                "sense_id": "ac506e6a-7bf6-34f1-85e9-40af2e7ad27c",
                                                "text": "There was something menacing and uncomfortable in the funereal stillness, in the muffled, subtle trickle of distant brooks, and in the crowding green peaks and black-wooded precipices that choked the narrow horizon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0dcb925-a0b2-4eda-83bc-d9004b4dbe6a",
