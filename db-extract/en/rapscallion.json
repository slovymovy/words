                                    {
                                        "sense_id": "c1d569b0-bc5d-313a-8e8e-2c06b87ae929",
                                        "entry_id": "6a6af4cb-d7eb-3d8f-8947-c50d6042daa4",
                                        "glosses": [
                                            "kleiner frecher Junge"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b5971f1-aa25-4621-b42a-36285f898129",
                                                "sense_id": "c1d569b0-bc5d-313a-8e8e-2c06b87ae929",
                                                "text": "Na, ihr kleinen Halunken!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "83a57529-64cd-3f82-a835-904f4281d62c",
                                        "entry_id": "6a6af4cb-d7eb-3d8f-8947-c50d6042daa4",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2be0ea71-980b-4486-9438-cd1f75a2a8ab",
                                                "sense_id": "83a57529-64cd-3f82-a835-904f4281d62c",
                                                "text": "Das sind doch alles Gauner und Halunken."
                                            },
                                            {
                                                "example_id": "7bf05b05-ff0a-4659-9c91-1b4865e4636c",
                                                "sense_id": "83a57529-64cd-3f82-a835-904f4281d62c",
                                                "text": "„Wir befanden uns in Basra völlig in Sicherheit, nachdem wir unsere Halunken von Kameraden fortgescheucht hatten, und brauchten weiter nichts zu tun, als nur zu überlegen, wie wir unseren Schatz in Dinge umwandeln konnten, die geeignet waren, uns als Kaufleute erscheinen zu lassen.“"
                                            },
                                            {
                                                "example_id": "d6590fec-276e-44ac-b949-1d7dee7f7e13",
                                                "sense_id": "83a57529-64cd-3f82-a835-904f4281d62c",
                                                "text": "„Schlump wunderte sich im Traum, daß er so verrücktes Zeug träumte, er wollte gerne munter werden, um diesem schwarzen Halunken zu entgehen.“"
                                            },
                                            {
                                                "example_id": "df4c597b-144d-4d4c-b214-7a45b6580959",
                                                "sense_id": "83a57529-64cd-3f82-a835-904f4281d62c",
                                                "text": "„In Wirklichkeit war er ein von der Polizei gesuchter Halunke und Dieb.“"
                                            },
                                            {
                                                "example_id": "43067ad8-3524-4c61-b99f-43ebf6630be6",
                                                "sense_id": "83a57529-64cd-3f82-a835-904f4281d62c",
                                                "text": "„Diese Schützen waren waschechte Halunken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fafd648-ee00-4257-923b-a685de52f17c",
                        "source_entry_id": "a74d8dce-00a9-3c11-b64c-b71a96d4126b",
                        "source_sense_id": "61c8028c-7b62-33ba-8e14-b69f08963fc0",
                        "source_sense_description": "veraltet: Gauner, Halunke, Tunichtgut",
                        "target_lang_word": "Tunichtgut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tunichtgut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                        "entry_id": "cf3cfa0d-7f11-30d8-a4e4-81517a3cee27",
                                        "glosses": [
                                            "jemand, der allerlei ungehörige und nichtsnutzige Dinge treibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3295f7f-15fe-44ad-ae10-b410878db9a4",
                                                "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                                "text": "Zwei Tunichtgute wurden jüngst dabei ertappt, wie sie Obst aus dem Pfarrgarten stahlen."
                                            },
                                            {
                                                "example_id": "18665be9-3f89-4a34-a7ab-653d6add6afe",
                                                "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                                "text": "„Apollo Robbins war ein ausgemachter Tunichtgut, ganz ähnlich wie seine missratenen Halbbrüder…“"
                                            },
                                            {
                                                "example_id": "e37352f6-f84d-4a6e-9f50-c84a8ba4ca52",
                                                "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                                "text": "„Doch weil er sich, selbst in betrunkenem Zustand, immer noch wenig redselig zeigte, waren die drei Tunichtgute seiner bald überdrüssig geworden, in eine andere Wirtschaft weitergezogen und hatten ihn allein und bald auch elend zurückgelassen.“"
                                            },
                                            {
                                                "example_id": "876df138-2549-4b0a-a2f4-51f66cfce2b9",
                                                "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                                "text": "„Er war ein junger, leichtfertiger, nicht unbegabter Tunichtgut, der sich auf allerlei Schnurren verstand.“"
                                            },
                                            {
                                                "example_id": "f211ebf2-d555-4363-a0bf-fe21361292d4",
                                                "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                                "text": "„Je nachdem, wie das gelingt, kommt der dann gut vorbereitet (wie nicht selten), und die Welt findet nach dem Tod des Vaters mal einen gut instruierten und ernsthaften Nachfolger, mal einen tändelnden Tunichtgut oder etwas dazwischen vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
