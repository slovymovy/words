            {
                "entry_id": "997f59bc-69da-383c-a44a-4db96d71f57a",
                "word": "speedometer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1105bc5f-17c3-48ae-93d8-9ab0a710f8b2",
                        "entry_id": "997f59bc-69da-383c-a44a-4db96d71f57a",
                        "tags": [
                            "plural"
                        ],
                        "form": "speedometers"
