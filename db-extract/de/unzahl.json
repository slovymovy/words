                "senses": [
                    {
                        "sense_id": "f193490d-efda-3bc5-86cc-22f3368f4380",
                        "entry_id": "c1aed7b5-7038-33cd-8f11-af6269b9b811",
                        "glosses": [
                            "als besonders groß empfundene Menge, die sehr viele Elemente aufweist, deren genaue Anzahl nicht bekannt oder nicht ermittelbar ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b1515b2-138b-4c45-947f-5ef5a8b0de1a",
                                "sense_id": "f193490d-efda-3bc5-86cc-22f3368f4380",
                                "text": "„Donatonis Stärke ist das Spiel mit Fäden, mit einer Unzahl farbiger Garne, die zu einer Textur verwoben werden.“"
                            },
                            {
                                "example_id": "108912f0-66d9-4d5d-9404-272fabf979b9",
                                "sense_id": "f193490d-efda-3bc5-86cc-22f3368f4380",
                                "text": "„Natürlich gehört die Unzahl zum Teil höchst unsinniger Steuerbegünstigungen ganz kräftig gelichtet.“"
                            },
                            {
                                "example_id": "19b2632c-2ba8-405b-9d0b-995acbb119bf",
                                "sense_id": "f193490d-efda-3bc5-86cc-22f3368f4380",
                                "text": "„Du weißt, was man sich über Kristmann erzählte, vielfach verheiratet, acht oder neun Mal, und eine Unzahl weiterer Frauengeschichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
