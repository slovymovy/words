                "senses": [
                    {
                        "sense_id": "33cfb004-ec03-37f1-86dd-d1cb5cd566ef",
                        "entry_id": "86e96341-756a-3742-a4b8-007458c8ac44",
                        "glosses": [
                            "Stadt im Osten der Ukraine"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "aae146b3-7b75-4c18-b418-f3b7ff8dd879",
                                "sense_id": "33cfb004-ec03-37f1-86dd-d1cb5cd566ef",
                                "text": "„In Woroschilowgrad stieg die Familie in einen weiteren Flüchtlingstransport, der sie weit über tausend Kilometer nach Nordosten führte, nach Kuibyschew, das heutige Samara am Ostufer der Wolga.“"
                            },
                            {
                                "example_id": "34c136bd-91c7-4a08-b37f-123ffef476ed",
                                "sense_id": "33cfb004-ec03-37f1-86dd-d1cb5cd566ef",
                                "text": "„Die Saiten für die Instrumente hatte ein russischer Offizier gelegentlich bei einer Fahrt nach Woroschilowgrad besorgt, aber mit Nachschub sah es schlecht aus.“"
                            },
                            {
                                "example_id": "fda608be-79c5-4ced-b878-d5f1efbffe7c",
                                "sense_id": "33cfb004-ec03-37f1-86dd-d1cb5cd566ef",
                                "text": "„Er sollte in den Donbass reisen und sich mit der Inbetriebnahme der Schächte und dem Wiederaufbau der Stadt Lugansk, damals hieß es Woroschilowgrad, beschäftigen.“"
                            },
                            {
                                "example_id": "52d664b1-06e2-43eb-8e54-e1fd96dc2a1a",
                                "sense_id": "33cfb004-ec03-37f1-86dd-d1cb5cd566ef",
                                "text": "„Nach verhältnismäßig angenehmer Bahnfahrt, bei welcher wir noch das Glück hatten, Wodka und Zigaretten zu besitzen, gelangten wir nach zweitägiger Fahrt bis Woroschilowgrad*.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "41ceec01-d82d-3eb2-b58b-ff648d079851",
                        "entry_id": "86e96341-756a-3742-a4b8-007458c8ac44",
                        "glosses": [
                            "gleichnamiger Oblast in der östlichen Ukraine"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e1b5c26f-d109-42a6-a07b-ecd1a469c671",
                                "sense_id": "41ceec01-d82d-3eb2-b58b-ff648d079851",
                                "text": "„Im Oblast Woroschilowgrad wurden auf insg. 250 km Flußstrecke 1983 15 besetzte Horste gefunden […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
