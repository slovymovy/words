                        "glosses": [
                            "Organisme dont le but n’est pas de gagner de l’argent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bd31547-4a76-4d44-8442-f63422a82815",
                                "sense_id": "373e9b4f-04f0-36c1-b8f4-00bd709f4f1d",
                                "text": "Les OBNL (anciennement appelé les OSBL) ont été créés pour améliorer le sort collectif et faire du Québec un monde meilleur."
                            },
                            {
                                "example_id": "ce271915-f4fc-413f-add8-08b4485b2410",
                                "sense_id": "373e9b4f-04f0-36c1-b8f4-00bd709f4f1d",
                                "text": "Dans un organisme sans but lucratif (OSBL, aussi appelé OBNL), il y a plusieurs manières d'organiser le travail des différentes personnes impliquées."
                            },
                            {
                                "example_id": "41a06e08-cdaf-4ef9-a05c-7b9b8c81fc89",
                                "sense_id": "373e9b4f-04f0-36c1-b8f4-00bd709f4f1d",
                                "text": "Le monde est en pleine mutation et l'univers des Organismes Sans But Lucratif (OSBL) ne fait pas exception."
                            }
                        ]
                    }
