                "senses": [
                    {
                        "sense_id": "eafe4807-a637-30c4-b14f-67f366ac8549",
                        "entry_id": "2220e0fa-236c-3e45-8ec9-ac0005ed2316",
                        "glosses": [
                            "Plan d’ordonnancement, de déroulement pour une activité, un processus, un projet ou pour le fonctionnement d’une organisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df6d748-2d04-41e2-af71-3eb860bb287e",
                                "sense_id": "eafe4807-a637-30c4-b14f-67f366ac8549",
                                "text": "Das Ergebnis der Ablaufplanung ist der Ablaufplan.",
                                "translation": "Le résultat du processus d’ordonnancement est le plan d’ordonnancement."
                            }
                        ]
                    },
                    {
                        "sense_id": "c563da31-f25d-3d92-9fff-f9be9cfa152a",
                        "entry_id": "2220e0fa-236c-3e45-8ec9-ac0005ed2316",
                        "glosses": [
                            "Organigramme de programmation, logigramme, algorigramme représentant l’exécution d’un l’logiciel."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "abc6f591-9fb9-418f-a795-e92a692b041a",
                                "sense_id": "c563da31-f25d-3d92-9fff-f9be9cfa152a",
                                "text": "Mitunter können Ablaufpläne aus Pseudocode oder aus Quellcode einer bestimmten Programmiersprache automatisch generiert werden, oder es kann umgekehrt aus einem Programmablaufplan der zugehörige Quellcode in einer bestimmten Programmiersprache erstellt werden.",
                                "translation": "Occasionnellement, les logigrammes peuvent être générés automatiquement à partir de pseudo-code ou de code source d’un langage de programmation spécifique, ou inversement, à partir de l’organigramme de programmation, on peut créer le code source associé dans un langage de programmation spécifique."
                            }
                        ]
                    }
