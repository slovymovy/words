                    {
                        "translation_id": "ac90c1f5-11da-4e9d-bb5d-2c876d37e54e",
                        "source_entry_id": "38b9b036-ec94-3598-83f3-0855e9f28e15",
                        "source_sense_description": "removing dust",
                        "target_lang_word": "dépoussiérage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépoussiérage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e55226ce-a9f7-34ed-8929-2c711cc964e1",
                                        "entry_id": "5f849b7a-e42e-38ce-83ba-d28fe5cb1d46",
                                        "glosses": [
                                            "Action de dépoussiérer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779bfd97-fe7b-4341-961b-23002a75c9c5",
                                                "sense_id": "e55226ce-a9f7-34ed-8929-2c711cc964e1",
                                                "text": "Toutefois, il ne faut pas négliger une possibilité intéressante qui consisterait à défilleriser les sables de concassage par lavage ou dépoussiérage."
                                            },
                                            {
                                                "example_id": "212a8170-d5d4-4e59-817b-3c9581040b08",
                                                "sense_id": "e55226ce-a9f7-34ed-8929-2c711cc964e1",
                                                "text": "La seconde tendance est de recourir au dépoussiérage aussi complet que possible et on le limite généralement à la fraction 0-0,5 ou 0-1 mm, tout en utilisant soit des séparateurs à courant d'air, soit des tamis vibrants, […]."
                                            },
                                            {
                                                "example_id": "0815fd7e-85be-4652-999c-12f7dc2dd93a",
                                                "sense_id": "e55226ce-a9f7-34ed-8929-2c711cc964e1",
                                                "text": "Sans doute que la serpillère est humide, car une fois l'opération de dépoussiérage terminée, l'homme la rhabille d'un chiffon blanc immaculé et achève le polissage de l'inox."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c0ed3df-8967-3b93-a02c-bba4454a22ef",
                                        "entry_id": "5f849b7a-e42e-38ce-83ba-d28fe5cb1d46",
                                        "glosses": [
                                            "Action de mettre à jour, de mettre au goût du jour."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5f5387e-3159-44bc-b1a2-4ab87c55c4c3",
                                                "sense_id": "5c0ed3df-8967-3b93-a02c-bba4454a22ef",
                                                "text": "La Nouvelle Cuisine, c'était un espoir, un dépoussiérage pour une gastronomie qui était rétrograde et cependant leader dans le monde."
                                            },
                                            {
                                                "example_id": "1c64da86-87c9-4488-98d0-c18453f11928",
                                                "sense_id": "5c0ed3df-8967-3b93-a02c-bba4454a22ef",
                                                "text": "Cependant, depuis 1929, la position de l'Église n'a changé que dans la forme. Il faut attendre le dépoussiérage du débat conciliaire pour entériner certaines évolutions."
                                            },
                                            {
                                                "example_id": "6e3967d9-90d0-4748-8279-109da2778224",
                                                "sense_id": "5c0ed3df-8967-3b93-a02c-bba4454a22ef",
                                                "text": "Pour Valente Baker, la France mériterait un petit dépoussiérage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19e9985d-bd06-3349-b999-22411d411660",
                                        "entry_id": "5f849b7a-e42e-38ce-83ba-d28fe5cb1d46",
                                        "glosses": [
                                            "Activité de contre-espionnage visant à détecter et retirer les systèmes d’écoutes implantés par des services de renseignement d’un pays tiers au sein d'un bâtiment officiel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
