                                "target_lang_word": "despachar",
                                "target_lang_sense_clarification": "asuntos o tareas, con rapidez"
                            },
                            {
                                "target_lang_word": "chapucear",
                                "target_lang_sense_clarification": "trabajo hecho sin cuidado"
