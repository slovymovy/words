                    {
                        "translation_id": "99d458fc-c694-4523-b6df-c4fa9b835e6b",
                        "source_entry_id": "f07bef82-ef23-331e-8184-f85a4c188a14",
                        "source_sense_id": "efdad7f3-b2ed-3a57-a80a-c0bfb8c87af0",
                        "target_lang_word": "Chauffeur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chauffeur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49b93c14-ed7f-3951-8b61-32cc2195cf09",
                                        "entry_id": "b722d1e1-90ee-38f3-925a-2386f5316d17",
                                        "glosses": [
                                            "jemand, dessen Beruf es ist, Personen zu befördern (vor allem mit dem Auto, aber auch mit dem Bus, Zug und Ähnlichem); früher: Kutscher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c2c878-a6a0-452f-b837-b52e536b41dd",
                                                "sense_id": "49b93c14-ed7f-3951-8b61-32cc2195cf09",
                                                "text": "Ein Chauffeur holte die Gäste am Flughafen ab und brachte sie in ihr Hotel."
                                            },
                                            {
                                                "example_id": "dc5f0c6e-ec33-4249-ac84-9aacbfe7a04e",
                                                "sense_id": "49b93c14-ed7f-3951-8b61-32cc2195cf09",
                                                "text": "„Der Valet de Chambre trug mit dem Chauffeur unser Gepäck in den Lift.“"
                                            },
                                            {
                                                "example_id": "ac5a625b-3584-43eb-8904-2af1ff36d21c",
                                                "sense_id": "49b93c14-ed7f-3951-8b61-32cc2195cf09",
                                                "text": "„Die Chauffeure fuhren die schweren, olivgrünen Wagen um den Teich herum und parkten sie ausgerichtet nebeneinander.“"
                                            },
                                            {
                                                "example_id": "3a074774-dd4d-4183-962d-c4148afa5037",
                                                "sense_id": "49b93c14-ed7f-3951-8b61-32cc2195cf09",
                                                "text": "„Im Fond des Autobusses nahm ich Platz, dos à dos mit dem Chauffeur.“"
                                            },
                                            {
                                                "example_id": "3156d46f-a6cf-45c2-8d30-398000d6d7c1",
                                                "sense_id": "49b93c14-ed7f-3951-8b61-32cc2195cf09",
                                                "text": "„Der letzte Wunsch war der einzig erfüllbare: Der Chauffeur Finger fuhr los, mit dem glänzenden Horch, dem schon wieder vergessenen, neuesten Spielzeug des großen Kindes, die gnädige Frau zu holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
