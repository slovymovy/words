                    {
                        "translation_id": "554fda72-2422-47a5-a1e1-35c2e1909dbc",
                        "source_entry_id": "3e92669f-fbbb-3cba-954e-1164e4105bc8",
                        "source_sense_id": "9798eafe-790e-3541-b717-ab2dd8eb54bc",
                        "target_lang_word": "Ichthyologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ichthyologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc421ce2-6f57-3e61-b2a7-320ea0133dc9",
                                        "entry_id": "1389c307-4b40-36ea-8613-4227a93aff1c",
                                        "glosses": [
                                            "wissenschaftliche Lehre von und die Beschäftigung mit den Fischen; Erforschung der Biologie der Fische unter natürlichen und künstlichen Lebensbedingungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cc6188c-2809-4fef-9dea-ba691cfd9492",
                                                "sense_id": "fc421ce2-6f57-3e61-b2a7-320ea0133dc9",
                                                "text": "„Der Vater der modernen Ichthyologie war jedoch der deutsche Arzt Markus Elieser Bloch.“"
                                            },
                                            {
                                                "example_id": "c9edadb0-548b-4606-b949-b4385c72e342",
                                                "sense_id": "fc421ce2-6f57-3e61-b2a7-320ea0133dc9",
                                                "text": "„Wer in der Ichthyologie, der Fischkunde, nicht so wirklich bewandert ist, wird sich über so manche rare Erscheinungsform wundern dürfen – und wer sich traut, darf sie auch anfassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d114d4a8-7385-4c61-ab95-03f3f0315c1c",
                        "source_entry_id": "3e92669f-fbbb-3cba-954e-1164e4105bc8",
                        "source_sense_id": "9798eafe-790e-3541-b717-ab2dd8eb54bc",
                        "target_lang_word": "Fischkunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fischkunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d71b937-efbf-3264-b3e9-22ab0b70aacf",
                                        "entry_id": "d81babd2-0011-3a22-bfae-8db1a3ab2e37",
                                        "glosses": [
                                            "wissenschaftliche Lehre von und die Beschäftigung mit den Fischen; Erforschung der Biologie der Fische unter natürlichen und künstlichen Lebensbedingungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0360841-1380-4a5b-98c7-4b05367e1308",
                                                "sense_id": "2d71b937-efbf-3264-b3e9-22ab0b70aacf",
                                                "text": "„So wie die Entwicklungen in der nordamerikanischen Fischkunde normalerweise vornehmlich für nordamerikanische Fischkundler von Interesse sind, interessieren sich für die Kunst Südafrikas vornehmlich südafrikanische Künstler.“"
                                            },
                                            {
                                                "example_id": "0b9e4f01-9f0a-44e2-903c-c3074663385e",
                                                "sense_id": "2d71b937-efbf-3264-b3e9-22ab0b70aacf",
                                                "text": "„Als Fachtierarzt für Fischkunde ist er seit 2004 Betreiber des viereinhalb Hektar großen Angelsees, von dem selbst im Winter ein kleiner Teil zugänglich ist, weil es keine Schonzeiten einzuhalten gilt.“"
                                            },
                                            {
                                                "example_id": "87baa592-5f9c-4deb-8dbc-69ebedbb1c7d",
                                                "sense_id": "2d71b937-efbf-3264-b3e9-22ab0b70aacf",
                                                "text": "„Jäckels Thätigkeit auf zoologischem Gebiete umfasst in erster Linie die Vogel-, Säugetier- und Fischkunde seines Heimatlandes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bb3508d-472e-4928-9e14-47e0c9fa1a1d",
                        "source_entry_id": "3e92669f-fbbb-3cba-954e-1164e4105bc8",
                        "source_sense_id": "9798eafe-790e-3541-b717-ab2dd8eb54bc",
