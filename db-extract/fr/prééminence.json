                        "cross_references": [
                            {
                                "target_word": "preeminence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92c4f738-df4a-3971-aaa5-ae455f58ce73",
                                        "entry_id": "ddfca04a-e159-3f7a-96df-a5347a71c4a6",
                                        "glosses": [
                                            "The status of being preeminent, dominant or ascendant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f58a2b78-5fdc-3c9d-8124-f68c1a1bd062",
                                        "entry_id": "ddfca04a-e159-3f7a-96df-a5347a71c4a6",
                                        "glosses": [
                                            "High importance; superiority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f58c8450-c120-4eb0-b87f-81093c6ce8ea",
                                                "sense_id": "f58a2b78-5fdc-3c9d-8124-f68c1a1bd062",
                                                "text": "In an era when political leaders promise deliverance from decline through America’s purported preeminence in scientific research, the news that science is in deep trouble in the United States has been as unwelcome as a diagnosis of leukemia following the loss of health insurance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3863567f-1388-46ba-ae24-1445250c2125",
                        "source_entry_id": "c2112eff-1c83-3f98-b2dc-77eb60bc5a85",
                        "source_sense_id": "2bbd3761-87f5-3471-8350-01f6f43ca985",
                        "target_lang_word": "preëminence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preëminence",
                                "target_lang_code": "en",
