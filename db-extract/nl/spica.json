                                "target_senses": [
                                    {
                                        "sense_id": "af195024-5dcb-3e57-9ca5-db33ca2497b6",
                                        "entry_id": "c5061a58-5936-31f3-ba9a-efbf514bfccf",
                                        "glosses": [
                                            "A binary star in the constellation Virgo; alpha (α) Virginis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5425a2a-138c-4092-9937-a3c4cc66a358",
                                                "sense_id": "af195024-5dcb-3e57-9ca5-db33ca2497b6",
                                                "text": "The constellation Virgo is a Y-shaped group, of which α, the star at the foot, is the well-known Spica, a star of the first magnitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f788bf7b-a207-4fa6-8cc8-ef9b44d3f5ca",
                        "source_entry_id": "45f16138-86ae-37f2-b438-99a2ad29eb4c",
                        "source_sense_id": "0756b403-b2df-303f-a832-210cf07782ab",
                        "source_sense_description": "Spica",
                        "target_lang_word": "épi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a9ba192-3475-36e5-8185-49a3fc233d5f",
                                        "entry_id": "fe59c2a9-90cc-3fc7-811d-b7947c9263cb",
                                        "glosses": [
                                            "Partie du blé et de plusieurs autres plantes graminées, qui est placée au sommet de la tige, et formée par la réunion des graines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3527dee4-caca-4996-9343-6c483e558590",
                                                "sense_id": "1a9ba192-3475-36e5-8185-49a3fc233d5f",
                                                "text": "Le chaume flexible des graminées de nos prairies, dont les épis légers ne s'élèvent que peu au-dessus du sol et que le moindre souffle du zéphyr suffit à bercer mollement , est remplacé dans certaines contrées de l'Asie par les tiges de bambous, riches en nœuds et d'un diamètre si considérable, […]."
                                            },
                                            {
                                                "example_id": "5e704fcc-f917-4a3e-8705-062b9bee96f8",
                                                "sense_id": "1a9ba192-3475-36e5-8185-49a3fc233d5f",
                                                "text": "Vers le soir, il entre dans un champ de blé, de blés hauts et mûrs, dont la brise balance mollement les beaux épis d’or."
                                            },
                                            {
                                                "example_id": "80144972-4e6e-4d79-9766-3f22cd0b6636",
                                                "sense_id": "1a9ba192-3475-36e5-8185-49a3fc233d5f",
                                                "text": "Il soulevait les gerbes et les ameulonnait en dizeaux tous les quarante pas. Les épis cariés, atteints de bruine et de charbon laissaient échapper une poudre noire quand il les secouait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43f2033e-2dbe-3d2a-bac6-cbf0343ac210",
                                        "entry_id": "fe59c2a9-90cc-3fc7-811d-b7947c9263cb",
                                        "glosses": [
                                            "Toute inflorescence dont les fleurs sont disposées autour d'un axe central, sans pédicelle ou avec un pédicelle très court."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6deace07-7665-4bec-a624-147e77973085",
                                                "sense_id": "43f2033e-2dbe-3d2a-bac6-cbf0343ac210",
                                                "text": "La plupart des céréales portent des épis."
                                            },
                                            {
                                                "example_id": "e7c44e26-6183-49dd-b351-0e67bbf9b9ea",
                                                "sense_id": "43f2033e-2dbe-3d2a-bac6-cbf0343ac210",
                                                "text": "Le bouillon blanc a ses fleurs en épi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41570fd7-a902-35e1-8f78-ec25f859b6d0",
                                        "entry_id": "fe59c2a9-90cc-3fc7-811d-b7947c9263cb",
                                        "glosses": [
                                            "Mèche rebelle de cheveux qui se dressent et s’écartent les uns des autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d9a4f5f-7c2b-4074-82ec-ebadaeb29184",
                                                "sense_id": "41570fd7-a902-35e1-8f78-ec25f859b6d0",
                                                "text": "J’en enduisis mes cheveux, que je lissai longuement à la brosse, avec l’espoir de rabattre un épi, qui se redressait obstinément sur le sommet de mon crâne, comme on en voit sur certains perroquets."
                                            },
                                            {
                                                "example_id": "7e9df881-08f3-4edc-a8ea-0c2fe7aea4a6",
                                                "sense_id": "41570fd7-a902-35e1-8f78-ec25f859b6d0",
                                                "text": "Peu à peu, les cicatrices des brûlures subies par le jeune homme s’effacèrent, mais un épi de cheveux sur son front se détacha longtemps tout blanc sur l’épaisse chevelure brune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f12fe3e0-14bd-3078-957b-17473bf783ae",
                                        "entry_id": "fe59c2a9-90cc-3fc7-811d-b7947c9263cb",
                                        "glosses": [
                                            "Sorte de bandage dont les tours représentent en quelque manière un épi d’orge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d409bb0-3f7f-32bb-8c6b-8aba9d49f2ac",
                                        "entry_id": "fe59c2a9-90cc-3fc7-811d-b7947c9263cb",
                                        "glosses": [
                                            "Disposition des briques d’un pavé, posées de chant et diagonalement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da61f5d6-9dd5-3e6d-ae9f-cad2123546bd",
                                        "entry_id": "fe59c2a9-90cc-3fc7-811d-b7947c9263cb",
                                        "glosses": [
                                            "Ouvrage hydraulique ayant pour objet de modifier le mouvement des eaux et de solidifier les berges."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01dda45f-9eb6-3eb0-b664-60ea300f4a75",
                                        "entry_id": "fe59c2a9-90cc-3fc7-811d-b7947c9263cb",
                                        "glosses": [
                                            "Meuble de bibliothèque placé au milieu d’une salle et non le long des murs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae13da73-4db7-34fe-bf4f-f6de424bef83",
                                        "entry_id": "fe59c2a9-90cc-3fc7-811d-b7947c9263cb",
                                        "glosses": [
                                            "Synonyme de épimorphisme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b80a13fc-562a-3161-af53-125ed62f79b2",
                                        "entry_id": "fe59c2a9-90cc-3fc7-811d-b7947c9263cb",
                                        "glosses": [
                                            "Type de stationnement ni parallèle, ni perpendiculaire à la route."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8fb55ba9-16c0-31f6-82ec-3c461cbef08e",
                                        "entry_id": "fe59c2a9-90cc-3fc7-811d-b7947c9263cb",
                                        "glosses": [
                                            "Élément décoratif placé sur le faîtage d'une toiture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae7c203b-9f58-474c-a89a-7030f1354f4b",
                                                "sense_id": "8fb55ba9-16c0-31f6-82ec-3c461cbef08e",
                                                "text": "Elles apercevaient, par-dessus une forêt d’arbres l’extrémité pointue d'une vieille tour accommodée en colombier et surmontée d'un épi de terre cuite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
