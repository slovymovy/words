                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0a5e6929-082e-365e-b293-d85771c28ac4",
                        "entry_id": "3197811e-55c5-3370-aa8a-67d03cc8d21d",
                        "glosses": [
                            "een terugkeer naar een vorige toestand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2777bc7-ed01-4abf-aada-1cfab8a2a6d3",
                                "sense_id": "0a5e6929-082e-365e-b293-d85771c28ac4",
                                "text": "Zijn herstel ging erg snel en hij kon spoedig weer aan het werk."
                            }
                        ]
                    },
                    {
                        "sense_id": "98db355f-a78d-3edc-9fab-d38db3983d98",
                        "entry_id": "3197811e-55c5-3370-aa8a-67d03cc8d21d",
                        "glosses": [
                            "iets weer in een goede toestand terugbrengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5741fa8f-dc34-4983-a595-d55003cbd341",
                                "sense_id": "98db355f-a78d-3edc-9fab-d38db3983d98",
                                "text": "Herstel voor dat voorwerp was niet meer mogelijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "aad23615-2748-39d5-ba41-fe2c43a12348",
                        "entry_id": "3197811e-55c5-3370-aa8a-67d03cc8d21d",
                        "glosses": [
                            "een vergoeding voor leed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b21d4c61-6a65-4622-b089-b7ca7f697554",
                                "sense_id": "aad23615-2748-39d5-ba41-fe2c43a12348",
                                "text": "Wij betalen u volledig herstel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71fbbdb4-8afd-4ff4-a11b-2d623e6cb790",
                        "source_entry_id": "3197811e-55c5-3370-aa8a-67d03cc8d21d",
                        "source_sense_id": "0a5e6929-082e-365e-b293-d85771c28ac4",
                        "source_sense_description": "een terugkeer naar een vorige toestand",
                        "target_lang_word": "Wiederherstellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiederherstellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58a4aafa-fc23-3099-99f2-9ab322ff9ac6",
                                        "entry_id": "82a18aca-331f-32df-925b-e5e614e23027",
                                        "glosses": [
                                            "das in einen wieder funktionierenden Zustand Versetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "542fe0e7-b587-4366-8b48-5b7667bc1b77",
                                                "sense_id": "58a4aafa-fc23-3099-99f2-9ab322ff9ac6",
                                                "text": "Russland habe damals im Gegensatz zu einigen anderen Ländern ausdrücklich dem Willen des deutschen Volkes für eine Einheit zugestimmt. Nun solle der Westen auch die \"Wiederherstellung der Einheit\" in Russland akzeptieren, sagte er. \"Ich bin mir sicher, dass die Deutschen uns unterstützen werden bei der Wiedervereinigung.\""
                                            },
                                            {
                                                "example_id": "9b9fed50-d0c0-4102-bf18-e6c273c0467a",
                                                "sense_id": "58a4aafa-fc23-3099-99f2-9ab322ff9ac6",
                                                "text": "Diese Summe war von dem Investor für die Wiederherstellung des Busbahnhofes in seinem ursprünglichen Aussehen ermittelt worden."
                                            },
                                            {
                                                "example_id": "83504dd6-ab2d-4487-879b-9946d678e331",
                                                "sense_id": "58a4aafa-fc23-3099-99f2-9ab322ff9ac6",
                                                "text": "Grund für die Wiederherstellung einer Datenbank kann ein System- aber auch ein Anwenderfehler sein."
                                            },
                                            {
                                                "example_id": "f59b8360-2d39-4801-8331-0759de88f4ae",
                                                "sense_id": "58a4aafa-fc23-3099-99f2-9ab322ff9ac6",
                                                "text": "Voraussetzungen für die Wiederherstellung der Belastbarkeit des Gelenks ist Training."
                                            },
                                            {
                                                "example_id": "6564a114-aa13-476b-b8e3-1c231338427b",
                                                "sense_id": "58a4aafa-fc23-3099-99f2-9ab322ff9ac6",
                                                "text": "„Damit mochte zusammenhängen, daß man nirgends Anstalten zu einer gründlichen Wiederherstellung traf, sondern mit jedem Notbehelf vorlieb nahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a949b6d7-8ece-3f6a-9418-aaa50eb9ace1",
                                        "entry_id": "82a18aca-331f-32df-925b-e5e614e23027",
                                        "glosses": [
                                            "das Genesen von einer Krankheit oder Verletzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9cb85a2-27a8-4afc-a114-f74652c28a94",
                                                "sense_id": "a949b6d7-8ece-3f6a-9418-aaa50eb9ace1",
                                                "text": "Erst nach fünf Wochen Krankenstand bestätigte der Arzt die Wiederherstellung des Patienten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
