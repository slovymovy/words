                                            {
                                                "example_id": "4c3f42c4-3e6c-42f8-bff4-3730e82a323c",
                                                "sense_id": "5b801556-2a1c-33ba-bbc3-d59485ecaec9",
                                                "text": "Niesporczaki uznawane są za najbardziej odporne na warunki zewnętrzne ze znanych organizmów."
