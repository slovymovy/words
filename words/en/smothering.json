    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf481b52-5f81-3daf-9a92-c36c095e258c",
                    "sense_definition": "present participle and gerund of <w>smother</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighters were <w>smothering</w> the flames with heavy blankets.",
                            "target_lang_translations": {
                                "ru": "Пожарные <w>тушили</w> пламя тяжелыми одеялами."
                            }
                        },
                        {
                            "text": "She felt that her parents were <w>smothering</w> her with too much attention.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что родители <w>душат</w> её своим чрезмерным вниманием."
                            }
                        }
                    ],
                    "synonyms": [
                        "suffocating",
                        "stifling",
                        "choking"
                    ],
                    "common_phrases": [
                        "smothering the flames"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола smother: душить, тушить, окружать чрезмерной заботой или подавлять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душащий",
                                "target_lang_sense_clarification": "лишающий воздуха или пространства"
                            },
                            {
                                "target_lang_word": "тушащий",
                                "target_lang_sense_clarification": "гасящий огонь перекрытием доступа воздуха"
                            },
                            {
                                "target_lang_word": "подавляющий",
                                "target_lang_sense_clarification": "чрезмерно опекающий или угнетающий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b80ad3f5-1bd5-3659-9913-9c226776a498",
                    "sense_definition": "The act of suffocating, extinguishing, or overwhelming someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective investigated two attempted <w>smotherings</w> that occurred in the hospital.",
                            "target_lang_translations": {
                                "ru": "Детектив расследовал две попытки <w>удушения</w>, произошедшие в больнице."
                            }
                        },
                        {
                            "text": "The sudden <w>smothering</w> of the campfire prevented the blaze from spreading.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>тушение</w> костра предотвратило распространение огня."
                            }
                        }
                    ],
                    "synonyms": [
                        "suffocation",
                        "strangulation",
                        "asphyxiation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по удушению, тушению пламени или чрезмерному подавлению кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удушение",
                                "target_lang_sense_clarification": "насильственное лишение дыхания"
                            },
                            {
                                "target_lang_word": "тушение",
                                "target_lang_sense_clarification": "гашение пламени путем перекрытия доступа воздуха"
                            },
                            {
                                "target_lang_word": "подавление",
                                "target_lang_sense_clarification": "чрезмерное ограничение, угнетение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}