                                        "glosses": [
                                            "sich auf Lateinamerika oder die Lateinamerikaner beziehend, von ihnen stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2e00c2-a545-45d9-8a59-65bdb08ddf39",
                                                "sense_id": "632ba229-c0cd-36ba-9a23-1181336e987e",
                                                "text": "Sie spricht lateinamerikanisches Spanisch."
                                            },
                                            {
                                                "example_id": "a7fd3eb5-228f-49c3-bc66-ac032753cedf",
                                                "sense_id": "632ba229-c0cd-36ba-9a23-1181336e987e",
                                                "text": "Er liebt lateinamerikanische Musik."
                                            },
                                            {
                                                "example_id": "d89c25dd-c96e-451f-8c20-3d5931817236",
                                                "sense_id": "632ba229-c0cd-36ba-9a23-1181336e987e",
                                                "text": "„Menschen mit lateinamerikanischen Wurzeln stellen in Amerika mehr als zehn Prozent der Wahlberechtigten. In vielen Bundesstaaten gelten ihre Stimmen als wahlentscheidend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
