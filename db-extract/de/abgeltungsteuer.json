                    {
                        "sense_id": "c4d17395-83af-3007-ab1a-d02708808930",
                        "entry_id": "f34ecc11-029b-3540-ad7c-00b6421f596f",
                        "glosses": [
                            "Quellensteuer, insbesondere auf Kapitalerträge, die eine weitere Veranlagung erübrigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e1a60b4-3a5a-4bdf-8e3d-c926461719c4",
                                "sense_id": "c4d17395-83af-3007-ab1a-d02708808930",
                                "text": "Die Abgeltungsteuer ist unabhängig vom sonstigen Einkommen."
                            },
                            {
                                "example_id": "718bc682-020a-49e2-aafb-8f0bb46a6c8c",
                                "sense_id": "c4d17395-83af-3007-ab1a-d02708808930",
                                "text": "Dividenden, die von Kapitalgesellschaften ausgeschüttet werden, unterliegen in Deutschland der Abgeltungsteuer."
                            },
                            {
                                "example_id": "16927dbe-e5ed-47a0-84bd-6e0e7be002ca",
                                "sense_id": "c4d17395-83af-3007-ab1a-d02708808930",
                                "text": "„Die zusätzlichen Einnahmen, die aus einer Abschaffung der Abgeltungsteuer entstünden, sind schwer zu beziffern.“"
                            }
                        ],
