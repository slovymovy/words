                    {
                        "translation_id": "390a7df9-08eb-4a49-8fcc-6e2d09468f4e",
                        "source_entry_id": "410fbc64-f5ce-389d-b1b4-493e997fc442",
                        "source_sense_id": "d4d7ac4c-08f3-3634-97e8-3f9cd705306f",
                        "target_lang_word": "kno-arts",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kno-arts",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3fe6d8ae-16f2-303b-96df-30d1e75a21a9",
                                        "entry_id": "08c8474b-ca26-35f9-9fa4-63c6817f27f4",
                                        "glosses": [
                                            "een medisch specialist op het gebied van otorinolaryngologie, die zich bezighoudt met onderzoek en behandeling van aandoeningen van keel, neus en oren"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7920b1f1-1666-4cbf-8f8a-d40db0e75a24",
                                                "sense_id": "3fe6d8ae-16f2-303b-96df-30d1e75a21a9",
                                                "text": "Volgens kno-arts Bram Struijs van het Rotterdamse Havenziekenhuis zorgt de drogere 'aircolucht' voor uitdroging van onze slijmvliezen. \"Wanneer je slijmvlies uitdroogt, wordt het afweersysteem minder en krijgen bacteriën en virussen meer kans zich te ontwikkelen. Je bent dus vatbaarder voor ziektes.\""
                                            },
                                            {
                                                "example_id": "fef30de1-f6f5-4cfc-b57e-e24e3ee2515f",
                                                "sense_id": "3fe6d8ae-16f2-303b-96df-30d1e75a21a9",
                                                "text": "KNO-arts Marcel Copper van het St. Antonius Ziekenhuis verwacht dat er landelijk voorlopig nog maar honderd patiënten per jaar in aanmerking komen, bij wie andere behandelingen niet voldoende helpen. Voor deze groep wordt het kostbare apparaat - ruim 25.000 euro - sinds kort wel vergoed vanuit het basispakket."
                                            },
                                            {
                                                "example_id": "60b778a2-16b8-45ba-82c7-f4e4fff586d8",
                                                "sense_id": "3fe6d8ae-16f2-303b-96df-30d1e75a21a9",
                                                "text": "Lekker rustig was het. Kon eigenlijk iedereen prima verstaan, maar de uitslag bij de KNO-arts was overtuigend: hulporen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
