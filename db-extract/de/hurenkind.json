                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb66f831-d25f-3487-92ce-a5b8be4de013",
                        "entry_id": "9c421b0f-5976-3b4a-935f-8cb0924b2920",
                        "glosses": [
                            "Kind einer Prostituierten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8e8198-8c8f-4c02-b95a-afb477ca9de0",
                                "sense_id": "eb66f831-d25f-3487-92ce-a5b8be4de013",
                                "text": "„Liebe gibt es nicht, und Sex nur gegen Geld, das hatte das Hurenkind schon früh begriffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2f1d971b-316f-31c3-b625-5eb8331b57be",
                        "entry_id": "9c421b0f-5976-3b4a-935f-8cb0924b2920",
                        "glosses": [
                            "eine einzelne Zeile eines Absatzes, die auf einer neuen Seite steht, während alle anderen Zeilen noch auf der vorherigen Seite stehen"
                        ],
                        "tags": [
                            "Typographie"
                        ],
                        "examples": [
                            {
                                "example_id": "6e09c604-3bc4-4c8d-a3ac-083954f4d177",
                                "sense_id": "2f1d971b-316f-31c3-b625-5eb8331b57be",
                                "text": "Hurenkinder gelten in der Typografie als schwere handwerkliche Fehler, da sie die Ästhetik des Satzspiegels besonders stark beeinträchtigen."
                            },
                            {
                                "example_id": "9b5b8c61-c6ce-4623-a977-2d9dbb717d9a",
                                "sense_id": "2f1d971b-316f-31c3-b625-5eb8331b57be",
                                "text": "„Mit EDV-Programmen können Hurenkinder durch Veränderung der vorhergehenden Wortzwischenräume vermieden werden.“"
                            },
                            {
                                "example_id": "13af54c4-c530-4015-94a7-7275a08137f1",
                                "sense_id": "2f1d971b-316f-31c3-b625-5eb8331b57be",
                                "text": "„Heute als klassische Druckfehler bekannte Lapsus wie Schusterjungen und Hurenkinder hingegen begegnen zumindest in der deutschen Fassung des »Mechanismus« gar nicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d02d2867-3b9c-4408-8b20-6071a58539d9",
                        "source_entry_id": "9c421b0f-5976-3b4a-935f-8cb0924b2920",
                        "source_sense_id": "2f1d971b-316f-31c3-b625-5eb8331b57be",
                        "source_sense_description": "einzelne Zeile eines Absatzes, die auf einer neuen Seite steht",
                        "target_lang_word": "widow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "widow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2db76842-6a3b-3333-80a7-1bf926b95284",
                                        "entry_id": "a158674f-bf9a-3d31-9270-b96c94594750",
                                        "glosses": [
                                            "A person whose spouse is absent:",
                                            "A person who has lost a spouse and not remarried:",
                                            "A woman whose spouse (traditionally husband) has died (and who has not remarried); a woman in relation to her late spouse; feminine of widower."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "779d2d0e-950b-36af-9d83-951ce78e950d",
                                        "entry_id": "a158674f-bf9a-3d31-9270-b96c94594750",
                                        "glosses": [
                                            "A person whose spouse is absent:",
                                            "A person who has lost a spouse and not remarried:",
                                            "Any person whose spouse has died (and who has not remarried)."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18d098f1-63cc-41f1-a770-53d69050d8cb",
                                                "sense_id": "779d2d0e-950b-36af-9d83-951ce78e950d",
                                                "text": "Now that he is a widow, he tries to win Olivia back through the songs and the music that brought them together all those years ago, leaving Olivia torn between moving forward with Josh or falling into the arms of the man she truly loves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e2fb795-a8fc-39c4-ab87-3fe08241ca3a",
                                        "entry_id": "a158674f-bf9a-3d31-9270-b96c94594750",
                                        "glosses": [
                                            "A person whose spouse is absent:",
                                            "A woman whose husband is often away pursuing a hobby, career, etc."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "humorous",
                                            "in-compounds",
                                            "informal",
                                            "often",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a286ad41-6969-4df0-ab62-5dbd0b51cf88",
                                                "sense_id": "1e2fb795-a8fc-39c4-ab87-3fe08241ca3a",
                                                "text": "My aunt is a football widow in the fall and a basketball widow in the winter and early spring."
                                            },
                                            {
                                                "example_id": "57c43626-415d-4b14-8428-158521cd2804",
                                                "sense_id": "1e2fb795-a8fc-39c4-ab87-3fe08241ca3a",
                                                "text": "I had been feeling like a bowling-alley widow, but knew he loved the game, so I suggested we join a mixed league."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e50cdb2-f179-31e2-9fd4-e6255e95e39b",
                                        "entry_id": "a158674f-bf9a-3d31-9270-b96c94594750",
                                        "glosses": [
                                            "An additional hand of playing cards dealt face-down in some card games, to be used by the highest bidder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
