                                        "sense_id": "70d6673a-c0fb-3c91-b6ab-8697fedce806",
                                        "entry_id": "3bf7956f-5874-3553-97bc-ef0f3308b84c",
                                        "glosses": [
                                            "Un cheval de sport énergique destiné à être monté avec une selle par un cavalier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d99337e-442e-4113-bad1-878602006296",
                                                "sense_id": "70d6673a-c0fb-3c91-b6ab-8697fedce806",
                                                "text": "Le goût de l’équitation, autrefois si prononcé en France, est aujourd’hui en partie perdu où tout le monde préfère monter en voiture ; aussi le cheval de selle est-il presque délaissé."
                                            },
                                            {
                                                "example_id": "872db9ec-7c5a-4dc7-bf16-38f01c1a8efc",
                                                "sense_id": "70d6673a-c0fb-3c91-b6ab-8697fedce806",
                                                "text": "— Non ; je resterai au lit jusqu’à trois heures, et alors je vous demanderai un cheval de selle pour faire une promenade en campagne."
                                            }
                                        ]
                                    }
                                ]
                            }
