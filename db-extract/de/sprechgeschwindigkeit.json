                ],
                "senses": [
                    {
                        "sense_id": "9ebc6992-3738-3d99-abf3-e613f4c4ce98",
                        "entry_id": "c61f7f60-1275-3cb1-a856-4c9132bf4dcc",
                        "glosses": [
                            "Linguistik, Logopädie, Geschwindigkeit, mit der jemand spricht"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "b460c970-0414-4b22-876f-7aec285c1f15",
                                "sense_id": "9ebc6992-3738-3d99-abf3-e613f4c4ce98",
                                "text": "Die Sprechgeschwindigkeit beträgt normalerweise zwischen 4-6 Silben pro Sekunde beziehungsweise um 20 Laute."
                            },
                            {
                                "example_id": "df9d2def-b939-4597-8eb1-c6fd547be63c",
                                "sense_id": "9ebc6992-3738-3d99-abf3-e613f4c4ce98",
                                "text": "„Um jedoch ein treffendes Urteil über die Sprechgeschwindigkeit zu gewinnen, genügt es nicht festzustellen, wieviel Laute der Sprecher in der Zeiteinheit wirklich erreicht hat, sondern auch, wieviel er in der wirklich in Anspruch genommenen Zeit bei deutlichem Sprechen hätte bilden sollen.“"
                            },
                            {
                                "example_id": "b94bf06a-abc1-4392-af2d-414684c3b3a3",
                                "sense_id": "9ebc6992-3738-3d99-abf3-e613f4c4ce98",
                                "text": "„Individuelle Sprecher haben unterschiedliche Sprechgeschwindigkeiten.“"
                            },
                            {
                                "example_id": "d96f61f8-1aeb-4616-bea4-f102a5e3dc30",
                                "sense_id": "9ebc6992-3738-3d99-abf3-e613f4c4ce98",
                                "text": "„Stärker als in vielen anderen germanischen Sprachen - Isländisch und Färöisch einmal ausgenommen - beeinflussen auch Sprechgeschwindigkeit, angestrebte Deutlichkeit, allgemeine Faktoren der Sprechsituation sowie stilistische Faktoren die Aussprache des Dänischen in erheblichem Maße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
