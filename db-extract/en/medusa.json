                    },
                    {
                        "translation_id": "7c6dac66-0692-4efa-9c13-080562ce04cc",
                        "source_entry_id": "38ef3804-4834-30c5-8ffd-67e78917b201",
                        "source_sense_id": "3a6610b2-1c8b-3ddd-a0a6-79d184c6d9d4",
                        "source_sense_description": "one of the Gorgons",
                        "target_lang_word": "Méduse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Méduse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70e1d338-8284-38e7-8ff2-e375837653f0",
                                        "entry_id": "ad314f0a-0f41-374b-9720-fef2718d6d08",
                                        "glosses": [
                                            "Personnage à la chevelure de serpent dont le regard changeait en pierre ceux qui la regardaient, et qui est une des trois Gorgones."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd8a21b6-1681-498f-b7eb-c4b348974e49",
                                                "sense_id": "70e1d338-8284-38e7-8ff2-e375837653f0",
                                                "text": "Le directeur leva la tête quand il fut monté dans le milord, et alors la femme et le mari se retirèrent vivement, comme si la figure du baron eût produit sur eux l’effet mythologique de la tête de Méduse."
                                            },
                                            {
                                                "example_id": "f5c0313a-4095-42cb-a9e0-f21273e4d115",
                                                "sense_id": "70e1d338-8284-38e7-8ff2-e375837653f0",
                                                "text": "Soudain elle fait paraître sur sa face son superbe visage de Méduse que j’aimais tant, tout gonflé de haine, tout tordu, venimeux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4b80e42-abc9-4704-a7a0-3a1b00292a80",
                        "source_entry_id": "38ef3804-4834-30c5-8ffd-67e78917b201",
                        "source_sense_id": "3a6610b2-1c8b-3ddd-a0a6-79d184c6d9d4",
                        "source_sense_description": "one of the Gorgons",
                        "target_lang_word": "Medusa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Medusa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa5e3c8-d2d5-3b4c-b739-6000c545cc7c",
                                        "entry_id": "615037ba-9811-3aaa-9c9c-c8ea0b378f99",
                                        "glosses": [
                                            "schreckenerregende Gestalt mit Schlangenhaaren in der griechischen Sage; eine der drei Gorgonen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c85f81-a95f-4dc1-adc8-9a8b84ef7fd1",
                                                "sense_id": "aaa5e3c8-d2d5-3b4c-b739-6000c545cc7c",
                                                "text": "„Das Blut der Medusa lebt in allen Wesen des Phorkydenstammes fort, aber nach und nach gelingt es den sonnengenährten Gewalten, es seiner giftigen Eigenschaften zu entkleiden und jene Versöhnung einzuleiten, welche die Griechen bei allen derartigen Beschwörungen der Mächte der Finsternis als die Quelle besonderen Segens ansahen.“"
                                            },
                                            {
                                                "example_id": "caa776f3-4995-4ec9-8198-909626359bdd",
                                                "sense_id": "aaa5e3c8-d2d5-3b4c-b739-6000c545cc7c",
                                                "text": "„Perseus, so lautet die griechische Sage, verwandelt den Riesen Atlas, der ihm Aufnahme verweigert, durch Vorzeigung des Hauptes der Medusa in Stein.“"
                                            },
                                            {
                                                "example_id": "6594dd98-da65-42d7-964c-7e29d0ff25cd",
                                                "sense_id": "aaa5e3c8-d2d5-3b4c-b739-6000c545cc7c",
                                                "text": "„Nur würde sie niemand so recht ernst nehmen, denn wer dachte schon an die alte griechische Sage der Medusa?“"
                                            },
                                            {
                                                "example_id": "e6e758a1-7194-4fa5-a6e0-e261f77fa6bc",
                                                "sense_id": "aaa5e3c8-d2d5-3b4c-b739-6000c545cc7c",
                                                "text": "„In einer Nische stand eine bemerkenswert schöne Statue von Perseus, mit Medusas Kopf in der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
