                        "entry_id": "8e7a6729-d253-38c9-9ef9-795413af3fcc",
                        "glosses": [
                            "Lopin de terre communal à usage collectif situé dans ou non loin d’un village."
                        ],
                        "tags": [
                            "Massif central",
                            "Occitanie"
                        ],
                        "examples": [
                            {
                                "example_id": "1287853e-f25f-4284-88e0-224705da2377",
                                "sense_id": "82aaeefa-d3cc-30c6-af4e-44476c9b0d3c",
                                "text": "Le grand-père s’assit sur le lit : — Le couderc… c’est la place publique."
                            },
                            {
                                "example_id": "26c783f4-e02b-43d5-9c62-c19a849238fd",
                                "sense_id": "82aaeefa-d3cc-30c6-af4e-44476c9b0d3c",
                                "text": "Elle n’entra pas. Repartit sans fermer la porte, contourna la maison, descendit par le couderc…"
                            },
                            {
                                "example_id": "aae5292e-5ef9-4f5a-a803-1cb801d05dc4",
                                "sense_id": "82aaeefa-d3cc-30c6-af4e-44476c9b0d3c",
                                "text": "Je mis des détritus et divers objets irrécupérables à brûler sur un petit couderc poussiéreux niché entre l’église et le cimetière."
                            }
                        ]
                    }
