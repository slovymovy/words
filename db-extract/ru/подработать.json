                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb944eb1-09ce-3523-bb1b-b09dc7165498",
                        "entry_id": "add496cb-3918-3d0c-9505-d84f4f4fe932",
                        "glosses": [
                            "разг. заработать деньги вне основного места работы"
                        ],
                        "tags": [],
