                                    {
                                        "sense_id": "87297cce-a618-30c1-83ca-625c86e177de",
                                        "entry_id": "49deaf36-1087-3975-b4b7-59986c430791",
                                        "glosses": [
                                            "A transparent bluish-green, sometimes yellow-green, variety of beryl."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8e24b2-eb1c-46a3-9ea0-c28db537768b",
                                                "sense_id": "87297cce-a618-30c1-83ca-625c86e177de",
                                                "text": "Before we could embark on the details of his mother's health we were joined by a fair, plump woman of indefinite age, who had once been—and at moments still was—very pretty. She wore a simple black silk dress, perhaps in deference to Tilly's death, though the note of mourning was jarred by flamboyant aquamarine ear-rings and too much rouge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dfec65b-80d5-451a-b512-9fc359138190",
                        "source_entry_id": "697b0e99-4e80-334a-8e20-61719dfffb7a",
                        "source_sense_id": "80ff5389-0a46-3ad8-82b7-d4d68f7832bc",
                        "target_lang_word": "aigue-marine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aigue-marine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6328db5-d7fb-3f77-bad1-077ebe420b3e",
                                        "entry_id": "b58cda5b-cd23-3b1a-b1c3-193dc92ba037",
                                        "glosses": [
                                            "Variété de béryl transparente, de couleur bleu clair évoquant l’eau de mer."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a253f201-16f6-4c69-8c9b-1ac2143fb33d",
                                                "sense_id": "a6328db5-d7fb-3f77-bad1-077ebe420b3e",
                                                "text": "Une belle aigue-marine."
                                            },
                                            {
                                                "example_id": "42c492b0-2dc4-4418-a34d-9f7d61a37a40",
                                                "sense_id": "a6328db5-d7fb-3f77-bad1-077ebe420b3e",
                                                "text": "Des aigues-marines."
                                            },
                                            {
                                                "example_id": "69046f85-2fd9-4fe3-bc38-59ebff15860f",
                                                "sense_id": "a6328db5-d7fb-3f77-bad1-077ebe420b3e",
                                                "text": "Mon premier vrai bijou, je l’ai eu pour mes sept ans, c’était une bague avec une aigue-marine."
                                            },
                                            {
                                                "example_id": "5d6b285b-79da-4cb0-9957-1edc79297c6a",
                                                "sense_id": "a6328db5-d7fb-3f77-bad1-077ebe420b3e",
                                                "text": "Le béryl vert est l’émeraude tandis que la variété bleutée est l’aigue-marine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "205ab0b1-56d1-3da9-aab7-a1132dbc2711",
                                        "entry_id": "b58cda5b-cd23-3b1a-b1c3-193dc92ba037",
                                        "glosses": [
                                            "Nom donné par les lapidaires à différentes autres pierres (l’utilisation commerciale de ces noms est interdite en France) :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f4568d4-caba-4d06-83e6-a42fcf6d6ddc",
                                                "sense_id": "205ab0b1-56d1-3da9-aab7-a1132dbc2711",
                                                "text": "Aigue-marine brésilienne : topaze bleue."
                                            },
                                            {
                                                "example_id": "db14d5fb-0141-422d-9ab8-5f55fef35264",
                                                "sense_id": "205ab0b1-56d1-3da9-aab7-a1132dbc2711",
                                                "text": "Aigue-marine orientale : saphir bleu-clair (corindon hyalin vert)."
                                            },
                                            {
                                                "example_id": "e44a5fb1-5ef7-4f55-b0ce-3677deafd4ad",
                                                "sense_id": "205ab0b1-56d1-3da9-aab7-a1132dbc2711",
                                                "text": "Aigue-marine du Siam : zircon bleu."
                                            },
                                            {
                                                "example_id": "45ce4db7-eeb8-4ae7-ad75-79f2cd913ec0",
                                                "sense_id": "205ab0b1-56d1-3da9-aab7-a1132dbc2711",
                                                "text": "Aigue-marine synthétique : spinelle synthétique couleur cyan clair."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aigue-marine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "157c3635-1f16-35be-adaa-d1331aca269b",
                                        "entry_id": "1c4311c9-41d4-3517-83b3-16c4f8637af3",
                                        "glosses": [
                                            "Couleur de la pierre du même nom, cyan très léger : #79F8F8."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60d99e0c-a6b5-46ef-8ef8-d340bbdbfa29",
                                                "sense_id": "157c3635-1f16-35be-adaa-d1331aca269b",
                                                "text": "Je contemplais son petit nez aquilin et ses lèvres sans fard, et ses prunelles d’aigue-marine et la peau de ses bras nus, un peu brunie par les soleils méditerranéens."
                                            },
                                            {
                                                "example_id": "85ca989c-ed36-4d3b-85cd-dd4be9354f7b",
                                                "sense_id": "157c3635-1f16-35be-adaa-d1331aca269b",
                                                "text": "Le métro à l’époque avait une odeur pénétrante de bois brûlé et d’aisselles en sueur, et les faibles néons baignaient les wagons d’une lueur souterraine, aigue-marine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aigue-marine",
                                "target_lang_code": "fr",
