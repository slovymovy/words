                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graphisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de193a42-c09a-38a8-bccc-a51eae4124dc",
                                        "entry_id": "6ec60aad-bc2d-340e-a7a7-ad934ca75105",
                                        "glosses": [
                                            "Manière de dessiner particulière à un artiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe2f8d44-2bdd-4ff4-8a1c-e344c1ff3e49",
                                                "sense_id": "de193a42-c09a-38a8-bccc-a51eae4124dc",
                                                "text": "Séances de graphisme avec des feutres pour que chaque enfant s'entraîne à reproduire toutes les idées (les installations de ronds et les empreintes) et les garde dans son répertoire graphique individuel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "859d2830-62c5-35c3-8b18-de7306c1de54",
                                        "entry_id": "6ec60aad-bc2d-340e-a7a7-ad934ca75105",
                                        "glosses": [
                                            "Façon d’écrire d’une personne."
                                        ],
                                        "tags": [
                                            "Graphologie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3547bbfc-411d-39df-8062-43417b443cc8",
                                        "entry_id": "6ec60aad-bc2d-340e-a7a7-ad934ca75105",
                                        "glosses": [
                                            "Élément graphique apparaissant à l’écran et formant l’esthétique."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37b90db8-ba2e-45fd-8941-2c98b82302bd",
                                                "sense_id": "3547bbfc-411d-39df-8062-43417b443cc8",
                                                "text": "Les graphismes de ce jeu sont très réussis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0249ef74-3371-3ad2-9ba3-8ade63d86221",
                                        "entry_id": "6ec60aad-bc2d-340e-a7a7-ad934ca75105",
                                        "glosses": [
                                            "Design graphique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbb8303d-94df-4854-a256-b7ac1f376d24",
                                                "sense_id": "0249ef74-3371-3ad2-9ba3-8ade63d86221",
                                                "text": "Architectes d’intérieur et designers, attirées par le graphisme, la gastronomie et la photo, Sarah Cisinski et Chloé Roose réunissent leurs passions dans ce projet."
                                            },
                                            {
                                                "example_id": "42ffc4e4-9835-4f4d-bf1c-0b8af1b2aae8",
                                                "sense_id": "0249ef74-3371-3ad2-9ba3-8ade63d86221",
                                                "text": "Le bureau de graphisme Bonbon a été fondé en 2003 par Valeria Bonin et Diego Bontognali à Zurich. Ils conçoivent des livres, des identités visuelles, des affiches et ils enseignent à l'ECAL de Lausanne et à la Schule für Gestaltung de Saint-Gall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffc54b12-af70-3b69-9be1-f3aff1a9e813",
                                        "entry_id": "6ec60aad-bc2d-340e-a7a7-ad934ca75105",
                                        "glosses": [
                                            "Image obtenue sur un support par un procédé quelconque, considérée indépendamment de sa signification éventuelle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ada88825-66d9-48de-862b-e75158be23e7",
                        "source_entry_id": "dcd862a0-3462-356c-94bc-d20e31ef7349",
                        "source_sense_id": "dbc81343-c4cc-3c81-832e-8245a8240d0f",
