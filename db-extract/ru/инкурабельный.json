                                        "sense_id": "659c62c5-d254-31cf-a60c-e4d4890533b3",
                                        "entry_id": "433236b8-edd9-3b0f-a53c-c59d0a8cc155",
                                        "glosses": [
                                            "Of an illness, condition, etc, that is unable to be cured; healless."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af43bffe-0fb9-4fe9-847c-351b29d2421d",
                                                "sense_id": "659c62c5-d254-31cf-a60c-e4d4890533b3",
                                                "text": "They were labouring under a profound, and, as it might have seemed, an almost incurable ignorance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "379ec1f4-8fc2-3caa-b62f-eca6bd040873",
                                        "entry_id": "433236b8-edd9-3b0f-a53c-c59d0a8cc155",
                                        "glosses": [
                                            "Irremediable, incorrigible."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0859dfe9-1d41-48bd-b3c3-dd9b4eb33861",
                                                "sense_id": "379ec1f4-8fc2-3caa-b62f-eca6bd040873",
                                                "text": "an incurable romantic"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incurable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "203c88f2-2eb3-3464-a668-7d7ff631af93",
                                        "entry_id": "125c40a9-a537-36d3-b120-71369f7145f9",
                                        "glosses": [
                                            "One who cannot be cured."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b932a5b1-23cf-4886-8abd-debcca5fc6d8",
                                                "sense_id": "203c88f2-2eb3-3464-a668-7d7ff631af93",
                                                "text": "Heatherlegh, the Doctor, kept, in addition to his regular practice, a hospital on his private account — an arrangement of loose-boxes for Incurables, his friends called it — but it was really a sort of fitting-up shed for craft that had been damaged by stress of weather."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
