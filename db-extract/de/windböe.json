                                "target_senses": [
                                    {
                                        "sense_id": "39321bb1-d21b-3c38-ae55-36c0cea28322",
                                        "entry_id": "3c97bbad-7973-3b72-aced-6c851456fc1e",
                                        "glosses": [
                                            "A strong, abrupt rush of wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a40a6954-c3d8-4877-b5ef-9e954ee9a1c8",
                                                "sense_id": "39321bb1-d21b-3c38-ae55-36c0cea28322",
                                                "text": "The maximum sustained winds recorded at Waglan Island, Tate’s Cairn and Cheung Chau Beach were 113, 101 and 97 kmh (70, 62, 60 mph) respectively, with maximum gusts 135, 154 and 130 kmh (84, 96, 81 mph)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f5044b-91d6-384d-b147-10e02e8aec3f",
                                        "entry_id": "3c97bbad-7973-3b72-aced-6c851456fc1e",
                                        "glosses": [
                                            "Any rush or outburst (of water, emotion, etc.)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9959915-9ee0-402c-8c38-e072f11ba790",
                                                "sense_id": "c0f5044b-91d6-384d-b147-10e02e8aec3f",
                                                "text": "they are merely driven about by every sudden gust and impulse of the mind"
                                            },
                                            {
                                                "example_id": "e2b8ea81-9dbe-4289-84fe-fd78d9cf159d",
                                                "sense_id": "c0f5044b-91d6-384d-b147-10e02e8aec3f",
                                                "text": "The author is not speaking now of actual love-makings, of intrigues and devilish villany, either perpetrated or imagined; but rather of those passing gusts of short-lived and unfounded suspicion to which, as to other accidents, very well-regulated families may occasionally be liable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "362fc05b-e8e9-38db-9168-8dcb5b8edcd8",
                                        "entry_id": "2f60c76d-0d81-3b00-878d-e24441e972d4",
                                        "glosses": [
                                            "To blow in gusts."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e2a022b-6a11-40b0-a15c-578bf2552602",
                                                "sense_id": "362fc05b-e8e9-38db-9168-8dcb5b8edcd8",
                                                "text": "Do the dryers disperse bacteria and viruses through the restroom, like autumn breezes gusting leaves across a lawn?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3a1ac89-345b-3db9-9eb2-bf42c9ba6623",
                                        "entry_id": "b6423ffc-d52e-314f-ad59-8b9e573c89e0",
                                        "glosses": [
                                            "The physiological faculty of taste."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9094f12-e3c1-3882-b509-fc42257c7cb9",
                                        "entry_id": "b6423ffc-d52e-314f-ad59-8b9e573c89e0",
                                        "glosses": [
                                            "Relish, enjoyment, appreciation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf746ee2-476c-430c-9411-cce4bbfcfa4a",
                                                "sense_id": "d9094f12-e3c1-3882-b509-fc42257c7cb9",
                                                "text": ", \"The Spirit of Grace\"\nAn ox will relish the tender flesh of kids with as much gust and appetite."
                                            },
                                            {
                                                "example_id": "81d2ae1a-e45b-4d34-8759-a899a39780b2",
                                                "sense_id": "d9094f12-e3c1-3882-b509-fc42257c7cb9",
                                                "text": "Destroy all creatures for thy sport or gust."
                                            },
                                            {
                                                "example_id": "b6172e9b-55f1-40c5-b63d-29425bb79ce1",
                                                "sense_id": "d9094f12-e3c1-3882-b509-fc42257c7cb9",
                                                "text": "1942: ‘Yes, indeed,’ said Sava with solemn gust. — Rebecca West, Black Lamb and Grey Falcon (Canongate 2006, p. 1050)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "116f9f2d-60d0-3061-93b4-022b6885f194",
                                        "entry_id": "b6423ffc-d52e-314f-ad59-8b9e573c89e0",
                                        "glosses": [
                                            "Intellectual taste; fancy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fa96ae6-6e9d-4c28-a70a-b3010cc3f1b3",
                                                "sense_id": "116f9f2d-60d0-3061-93b4-022b6885f194",
                                                "text": "A choice of it may be made according to the gust and manner of the ancients."
                                            }
                                        ]
                                    }
                                ]
                            },
