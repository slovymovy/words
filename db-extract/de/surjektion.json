                                        "sense_id": "ec498e25-b380-3e6b-a672-5f64865b5d5c",
                                        "entry_id": "a80972a9-4116-3b4b-8ab0-b02bc33c9642",
                                        "glosses": [
                                            "Application d'un ensemble sur un autre qui s'applique au moins une fois sur chaque élément du deuxième ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a659213e-6366-46ae-a5ce-1f7e466176e1",
                                                "sense_id": "ec498e25-b380-3e6b-a672-5f64865b5d5c",
                                                "text": "En d'autres termes, une fonction continue sur [a,b] réalise une surjection du fermé [a,b] sur le fermé [M,m]."
                                            }
