            {
                "entry_id": "4ce81dde-064e-3384-bcbe-fdfde41b2fa3",
                "word": "podcast",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f71d75f4-7333-4fc7-84af-adbc953f704c",
                        "entry_id": "4ce81dde-064e-3384-bcbe-fdfde41b2fa3",
                        "tags": [
                            "plural"
