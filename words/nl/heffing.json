{
    "word_family": [
        "heffen",
        "verheffen",
        "opheffen",
        "belastingheffing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2547d83-0fe7-3865-8028-ea39e73e2c4b",
                    "sense_definition": "het officieel vorderen of innen van een geldbedrag door de overheid, zoals belastingen of accijnzen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "belasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid voert een nieuwe <w>heffing</w> in op het gebruik van plastic verpakkingen.",
                            "target_lang_translations": {
                                "en": "The government is introducing a new <w>levy</w> on the use of plastic packaging.",
                                "ru": "Правительство вводит новый <w>сбор</w> на использование пластиковой упаковки."
                            }
                        },
                        {
                            "text": "De <w>heffing</w> van belastingen is noodzakelijk om publieke voorzieningen te kunnen betalen.",
                            "target_lang_translations": {
                                "en": "The <w>collection</w> of taxes is necessary to pay for public facilities.",
                                "ru": "<w>Взимание</w> налогов необходимо для финансирования общественных услуг."
                            }
                        }
                    ],
                    "synonyms": [
                        "belasting",
                        "taks"
                    ],
                    "common_phrases": [
                        "heffing van belastingen",
                        "een tijdelijke heffing"
                    ],
                    "target_lang_definitions": {
                        "en": "the official demanding or collection of a sum of money by the government, such as taxes or duties",
                        "ru": "официальное требование или сбор денежной суммы государством, например, налогов или пошлин"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "levy",
                                "target_lang_sense_clarification": "the act of imposing or collecting a tax"
                            },
                            {
                                "target_lang_word": "collection",
                                "target_lang_sense_clarification": "the gathering of taxes or fees"
                            },
                            {
                                "target_lang_word": "taxation",
                                "target_lang_sense_clarification": "the process of taxing"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "взимание",
                                "target_lang_sense_clarification": "процесс сбора налогов или пошлин"
                            },
                            {
                                "target_lang_word": "обложение",
                                "target_lang_sense_clarification": "наложение налога или пошлины"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "процесс взимания платежей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60b5b0ab-413b-3efc-9829-61916ae21002",
                    "sense_definition": "het specifieke bedrag dat men verplicht is te betalen als belasting of toeslag",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De totale <w>heffing</w> voor de afvalstoffen bedraagt dit jaar honderd euro per huishouden.",
                            "target_lang_translations": {
                                "en": "The total <w>charge</w> for waste disposal amounts to one hundred euros per household this year.",
                                "ru": "Общий <w>сбор</w> за вывоз мусора в этом году составляет сто евро с семьи."
                            }
                        },
                        {
                            "text": "Veel burgers maken bezwaar tegen de hoge <w>heffing</w> op hun energierekening.",
                            "target_lang_translations": {
                                "en": "Many citizens object to the high <w>levy</w> on their energy bill.",
                                "ru": "Многие граждане возражают против высокого <w>налога</w> в их счетах за электроэнергию."
                            }
                        }
                    ],
                    "synonyms": [
                        "belasting"
                    ],
                    "common_phrases": [
                        "een extra heffing",
                        "de jaarlijkse heffing"
                    ],
                    "target_lang_definitions": {
                        "en": "the specific amount that one is required to pay as a tax, fee, or surcharge",
                        "ru": "конкретная сумма, которую необходимо уплатить в качестве налога, пошлины или сбора"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "levy",
                                "target_lang_sense_clarification": "a specific tax or fee imposed"
                            },
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "an amount of money required as payment"
                            },
                            {
                                "target_lang_word": "fee",
                                "target_lang_sense_clarification": "a payment for a service or privilege"
                            },
                            {
                                "target_lang_word": "assessment",
                                "target_lang_sense_clarification": "an amount determined for taxation"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "конкретный денежный платеж, пошлина"
                            },
                            {
                                "target_lang_word": "пошлина",
                                "target_lang_sense_clarification": "государственный или таможенный сбор"
                            },
                            {
                                "target_lang_word": "налог",
                                "target_lang_sense_clarification": "обязательный платеж в бюджет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcd14655-08a7-3b7c-bcf8-f15d47d0b6c3",
                    "sense_definition": "een lettergreep in een gedicht die de klemtoon of het versaccent krijgt",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "poëzie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit jambische vers volgt de <w>heffing</w> steeds op een onbeklemtoonde lettergreep.",
                            "target_lang_translations": {
                                "en": "In this iambic verse, the <w>stress</w> always follows an unstressed syllable.",
                                "ru": "В этом ямбическом стихе <w>икт</w> всегда следует за безударным слогом."
                            }
                        },
                        {
                            "text": "De dichter speelt met het ritme door de <w>heffing</w> op een onverwachte plek te leggen.",
                            "target_lang_translations": {
                                "en": "The poet plays with the rhythm by placing the <w>accent</w> in an unexpected place.",
                                "ru": "Поэт играет с ритмом, помещая <w>ударение</w> в неожиданное место."
                            }
                        }
                    ],
                    "antonyms": [
                        "daling"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in de literatuurwetenschap"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a syllable in a poem that receives the stress or verse accent",
                        "ru": "слог в стихотворении, на который падает ударение или ритмический акцент"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stress",
                                "target_lang_sense_clarification": "the emphasis on a syllable in verse"
                            },
                            {
                                "target_lang_word": "accent",
                                "target_lang_sense_clarification": "the rhythmic beat in poetry"
                            },
                            {
                                "target_lang_word": "ictus",
                                "target_lang_sense_clarification": "the formal term for a stressed syllable in prosody"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "икт",
                                "target_lang_sense_clarification": "ритмическое ударение в стихе"
                            },
                            {
                                "target_lang_word": "арсис",
                                "target_lang_sense_clarification": "повышение голоса, ударный слог в метрике"
                            },
                            {
                                "target_lang_word": "ударение",
                                "target_lang_sense_clarification": "выделение слога голосом в стихе"
                            }
                        ]
                    }
                }
            ]
        }
