                                        ],
                                        "tags": [
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3ddccd7-75fb-3ece-bba4-66227545140e",
                                        "entry_id": "e2998121-62a4-3a4d-bfcb-2af4e6752714",
                                        "glosses": [
                                            "To violently toss the limbs about."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bed6289-7470-44a0-aaf8-040832828633",
                                                "sense_id": "d3ddccd7-75fb-3ece-bba4-66227545140e",
                                                "text": "The jay fell all lopsidedly and threshing, as though it were having a fit. The ground killed it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4750c365-a013-4206-a954-1bbe0e4cb197",
                        "source_entry_id": "2274a7ae-2843-3cd6-8cb7-092deede85ea",
                        "source_sense_description": "выбивать семена или зёрна из колосьев",
                        "target_lang_word": "dreschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cf55a5f-e14d-3f17-8c9e-8b995b40c1c6",
                                        "entry_id": "e38f2701-ac96-3541-b746-102ee7f3f43e",
                                        "glosses": [
                                            "bei Getreide, Hülsenfrüchten und dergleichen durch Trampeln, Schlagen, Walzen oder mit einer Dreschmaschine die Körner vom Stroh trennen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0f199b-6120-4151-a843-f679270a4ed0",
                                                "sense_id": "4cf55a5f-e14d-3f17-8c9e-8b995b40c1c6",
                                                "text": "Früher wurde mit dem Dreschflegel gedroschen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54a24153-4ddb-3d61-8368-8835f2c187e4",
                                        "entry_id": "e38f2701-ac96-3541-b746-102ee7f3f43e",
                                        "glosses": [
                                            "jemanden prügeln oder auf jemanden oder etwas schlagen, draufhauen, drauftreten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98824920-5e39-49ea-8b93-d12253d10121",
                                                "sense_id": "54a24153-4ddb-3d61-8368-8835f2c187e4",
                                                "text": "Es gelang ihm, den Ball aus kürzester Entfernung über das Tor zu dreschen."
                                            },
                                            {
                                                "example_id": "00cc6ab2-f218-4c57-8a32-311b35796dec",
                                                "sense_id": "54a24153-4ddb-3d61-8368-8835f2c187e4",
                                                "text": "Der Angreifer drosch ihm den Gewehrkolben ins Gesicht."
                                            },
                                            {
                                                "example_id": "66d89b16-2610-40d2-b57d-69890f7d652b",
                                                "sense_id": "54a24153-4ddb-3d61-8368-8835f2c187e4",
                                                "text": "Sie drosch dem Hund eins über."
                                            },
                                            {
                                                "example_id": "921ea4f5-c663-41d2-b50a-70cb99d23a95",
                                                "sense_id": "54a24153-4ddb-3d61-8368-8835f2c187e4",
                                                "text": "Wenn du nicht aufpasst, dresche ich dich windelweich!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7f816bd1-9b2b-31b0-b649-e0b2493caf4a",
                                        "entry_id": "e38f2701-ac96-3541-b746-102ee7f3f43e",
                                        "glosses": [
                                            "grob und gefühllos auf einem Tasteninstrument spielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb1654a-6717-4209-ae40-e2eb8b03b3d7",
                                                "sense_id": "7f816bd1-9b2b-31b0-b649-e0b2493caf4a",
                                                "text": "Torben drischt hemmungslos in die Tasten und hat dabei augenscheinlich einen Mordsspaß."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "60cb3e7f-702d-35da-b52c-81309c98a0fc",
                                        "entry_id": "e38f2701-ac96-3541-b746-102ee7f3f43e",
                                        "glosses": [
                                            "Karten spielen, Skat spielen"
                                        ],
                                        "tags": [
                                            "besonders auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1eb15a3-44e5-428a-a7b0-35e6b1c9a571",
                                                "sense_id": "60cb3e7f-702d-35da-b52c-81309c98a0fc",
                                                "text": "Wollen wir eine Runde Skat dreschen?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8169c256-124e-4f98-a1c4-d9311a86ab43",
                        "source_entry_id": "2274a7ae-2843-3cd6-8cb7-092deede85ea",
