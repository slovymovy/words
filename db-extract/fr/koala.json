                        "source_entry_id": "d2c70b7f-caed-3759-9ceb-9047e5841b4a",
                        "source_sense_id": "aff834e6-3aed-31aa-af71-c66118497d64",
                        "target_lang_word": "коала",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
