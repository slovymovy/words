        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "a76c06b2-8d12-3898-9aa7-b10dc8d65faf",
                "word": "opschalen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "22b7b198-4677-338b-956a-620066a4e97a",
                        "entry_id": "a76c06b2-8d12-3898-9aa7-b10dc8d65faf",
                        "glosses": [
                            "zeer sterk in omvang laten toenemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a5f8c5b-9606-4129-9b88-0fc0a13d1970",
                                "sense_id": "22b7b198-4677-338b-956a-620066a4e97a",
                                "text": "Het Maasstad ziekenhuis in Rotterdam houdt vooralsnog vast aan de normale bezetting. ,,Maar als het nodig is, kunnen we opschalen.\" In de ziekenhuizen zelf leidt de hitte niet tot veel aanpassingen. ,,Het hele jaar door moet het koel zijn en moeten patiënten genoeg drinken. Wat dat betreft is het nu niet veel anders dan normaal.\""
                            },
                            {
                                "example_id": "dc23a85d-d268-40c9-88a4-70a47babf9a8",
                                "sense_id": "22b7b198-4677-338b-956a-620066a4e97a",
                                "text": "Voor DouxMatok ligt de focus nu vooral op het opschalen van de productie. Het is de bedoeling dat het bedrijf in de tweede helft van 2019 het product kan aanbieden aan Europese voedingsproducenten van zoetwaren als chocolade, koekjes, gebak en snoep."
                            },
                            {
                                "example_id": "411854fe-065b-4b26-a6d4-c65fd79d80a4",
                                "sense_id": "22b7b198-4677-338b-956a-620066a4e97a",
                                "text": "Opschalen - ,,Het opschalen van vitaliteit op de werkvloer is een van onze prio’s.”"
                            },
                            {
                                "example_id": "c59f39de-fbf4-4501-8a07-f2d3756dae4c",
                                "sense_id": "22b7b198-4677-338b-956a-620066a4e97a",
                                "text": "De brandweer rukte met twee eenheden uit, circa 18 man. Al snel was duidelijk, volgens woordvoerder Loes Hilbrink, dat verder opschalen niet nodig was en dat het niet opnieuw zo zou escaleren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9374479-5a1a-48cd-89b3-401e0928ccb5",
                        "source_entry_id": "a76c06b2-8d12-3898-9aa7-b10dc8d65faf",
                        "source_sense_id": "22b7b198-4677-338b-956a-620066a4e97a",
                        "target_lang_word": "scale up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scale up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45daca25-2f54-3a81-a90e-6ba6c48d7f08",
                                        "entry_id": "10dae241-17f1-37be-b32f-48580add0ea0",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see scale, up."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e56d3219-9f68-3b69-8bd0-eef3868f2795",
                                        "entry_id": "10dae241-17f1-37be-b32f-48580add0ea0",
                                        "glosses": [
                                            "To increase the size of something whilst maintaining proportion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "605781e4-8810-446f-b1d8-109cb86d3178",
                                                "sense_id": "e56d3219-9f68-3b69-8bd0-eef3868f2795",
                                                "text": "Near-synonym: magnify"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05d84571-da1d-3a73-98a1-51105c28fdf2",
                                        "entry_id": "10dae241-17f1-37be-b32f-48580add0ea0",
                                        "glosses": [
                                            "To change a process in order to allow for greater quantities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66408d78-2307-423e-8e73-c1a17efdf543",
                                                "sense_id": "05d84571-da1d-3a73-98a1-51105c28fdf2",
                                                "text": "Near-synonyms: expand, grow"
                                            },
                                            {
                                                "example_id": "5a7f4070-6f99-4347-a1fe-a674b4f11184",
                                                "sense_id": "05d84571-da1d-3a73-98a1-51105c28fdf2",
                                                "text": "Transects can be taken in localised settings and compared to local visual environments, as in this pilot study. But the technique can be scaled up to larger situations by taking multiple transects from multiple locales and combining the data."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
