                                    }
                                ]
                            },
                            {
                                "target_word": "rhomboïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1114cd71-e19c-3e8b-a101-5bf3a4f50451",
                                        "entry_id": "4f606379-2509-35d2-96f4-65f8c5d95679",
                                        "glosses": [
                                            "Quadrilatère à angles obliques, à côtés opposés parallèles et à côtés adjacents inégaux. On lui préfère maintenant le terme parallélogramme."
                                        ],
                                        "tags": [
