                ],
                "senses": [
                    {
                        "sense_id": "effe4a35-210c-347b-9489-562ba0c6358f",
                        "entry_id": "eee303c7-1788-3d70-ba53-32032f5a4cf8",
                        "glosses": [
                            "äußerst wütend, mit sehr viel Wut, Zorn"
                        ],
                        "tags": [
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7647d355-9654-4ca8-bd69-0aee74e6cd93",
                                "sense_id": "effe4a35-210c-347b-9489-562ba0c6358f",
                                "text": "„Sie hatte auch keine Angst mehr vor der Herausforderung – sie war nur noch stinkwütend.“"
                            },
                            {
                                "example_id": "98b087cb-2925-420a-a308-072f54c81878",
                                "sense_id": "effe4a35-210c-347b-9489-562ba0c6358f",
                                "text": "„Ich muss dich stinkwütend machen, damit du noch härter arbeitest, um zu beweisen, dass ich falsch liege.“"
                            },
                            {
                                "example_id": "2030a08c-d81e-4042-b3f1-78e827ea7b68",
                                "sense_id": "effe4a35-210c-347b-9489-562ba0c6358f",
                                "text": "„Mir wäre lieber, du wärst sauer, so richtig stinkwütend, würdest brüllen, toben, mir Vorwürfe machen, mich beschimpfen, weil ich einfach mein Ding durchgezogen habe, so, als gäbe es dich nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
