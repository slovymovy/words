{
    "word_family": [
        "ответ",
        "ответственность",
        "ответственный",
        "безответственный",
        "ответчик",
        "ответный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a028839-897b-3b53-bcc3-148efd96796a",
                    "sense_definition": "Говорить или делать что-то в ответ на вопрос, обращение или действие другого человека.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ученик встал и начал уверенно <отвечать> на вопросы учителя у доски.",
                            "target_lang_translations": {
                                "en": "The student stood up and began to confidently <answer> the teacher's questions at the blackboard.",
                                "de": "Der Schüler stand auf und begann selbstbewusst an der Tafel die Fragen des Lehrers zu <beantworten>."
                            }
                        },
                        {
                            "text": "Я звонил ему несколько раз, но он почему-то не <отвечает> на телефон.",
                            "target_lang_translations": {
                                "en": "I called him several times, but for some reason he is not <answering> the phone.",
                                "de": "Ich habe ihn mehrmals angerufen, aber aus irgendeinem Grund <geht> er nicht ans <Telefon>."
                            }
                        }
                    ],
                    "synonyms": [
                        "откликаться",
                        "реагировать"
                    ],
                    "common_phrases": [
                        "отвечать на вопрос",
                        "отвечать на письмо",
                        "отвечать отказом",
                        "отвечать улыбкой"
                    ],
                    "target_lang_definitions": {
                        "en": "To say, write, or do something as a reaction to a question, message, or action.",
                        "de": "Auf eine Frage, ein Anliegen oder eine Handlung einer anderen Person etwas sagen oder tun."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "general"
                            },
                            {
                                "target_lang_word": "reply",
                                "target_lang_sense_clarification": "to a message or speech"
                            },
                            {
                                "target_lang_word": "respond",
                                "target_lang_sense_clarification": "formal or general"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "antworten",
                                "target_lang_sense_clarification": "auf eine Frage oder ein Gespräch"
                            },
                            {
                                "target_lang_word": "beantworten",
                                "target_lang_sense_clarification": "eine Frage oder E-Mail (mit Akkusativ)"
                            },
                            {
                                "target_lang_word": "reagieren",
                                "target_lang_sense_clarification": "auf eine Handlung oder ein Signal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f98ec79-471d-33c1-a7e7-fbc3c29c0b43",
                    "sense_definition": "Нести ответственность за кого-либо или что-либо, быть обязанным следить за чем-то.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Родители всегда <отвечают> за безопасность и воспитание своих маленьких детей.",
                            "target_lang_translations": {
                                "en": "Parents are always <responsible> for the safety and upbringing of their young children.",
                                "de": "Eltern <sind> immer für die Sicherheit und Erziehung ihrer kleinen Kinder <verantwortlich>."
                            }
                        },
                        {
                            "text": "На новой работе он будет <отвечать> за организацию важных встреч и переговоров.",
                            "target_lang_translations": {
                                "en": "At his new job, he will <be responsible> for organizing important meetings and negotiations.",
                                "de": "An seiner neuen Arbeitsstelle wird er für die Organisation wichtiger Treffen und Verhandlungen <zuständig sein>."
                            }
                        }
                    ],
                    "synonyms": [
                        "быть ответственным",
                        "нести ответственность"
                    ],
                    "common_phrases": [
                        "отвечать за поступки",
                        "отвечать за качество",
                        "отвечать головой"
                    ],
                    "target_lang_definitions": {
                        "en": "To have the duty of taking care of someone or something.",
                        "de": "Die Verantwortung für jemanden oder etwas tragen; verpflichtet sein, auf etwas zu achten."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be responsible",
                                "target_lang_sense_clarification": "+ for"
                            },
                            {
                                "target_lang_word": "be in charge",
                                "target_lang_sense_clarification": "+ of"
                            },
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "+ for (have a duty)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verantwortlich sein",
                                "target_lang_sense_clarification": "für etwas zuständig sein"
                            },
                            {
                                "target_lang_word": "die Verantwortung tragen",
                                "target_lang_sense_clarification": "für etwas zuständig sein"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e45b1ffd-a37e-3164-bc0c-337d2443a42e",
                    "sense_definition": "Ощущать на себе последствия своих действий, нести наказание за совершённое нарушение.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Преступник должен <отвечать> за своё преступление перед судом по всей строгости закона.",
                            "target_lang_translations": {
                                "en": "The criminal must <answer> for his crime before the court to the full extent of the law.",
                                "de": "Der Verbrecher muss sich für sein Verbrechen vor Gericht mit der ganzen Härte des Gesetzes <verantworten>."
                            }
                        },
                        {
                            "text": "Если ты сломал чужую вещь, тебе придётся за это <отвечать> и возмещать ущерб.",
                            "target_lang_translations": {
                                "en": "If you broke someone else's thing, you will have to <answer> for it and pay damages.",
                                "de": "Wenn du eine fremde Sache kaputt gemacht hast, wirst du dafür <geradestehen> und den Schaden ersetzen müssen."
                            }
                        }
                    ],
                    "synonyms": [
                        "нести ответственность"
                    ],
                    "common_phrases": [
                        "отвечать по закону",
                        "отвечать перед судом"
                    ],
                    "target_lang_definitions": {
                        "en": "To suffer the consequences or be punished for one's actions.",
                        "de": "Die Konsequenzen des eigenen Handelns tragen oder für ein Vergehen bestraft werden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "+ for (a crime or mistake)"
                            },
                            {
                                "target_lang_word": "be held accountable",
                                "target_lang_sense_clarification": "legal or formal"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "geradestehen",
                                "target_lang_sense_clarification": "für die Folgen der eigenen Taten"
                            },
                            {
                                "target_lang_word": "sich verantworten",
                                "target_lang_sense_clarification": "vor Gericht oder einer Instanz"
                            },
                            {
                                "target_lang_word": "die Verantwortung übernehmen",
                                "target_lang_sense_clarification": "für Fehler oder Straftaten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48677110-bde9-336b-a8bf-6897c65cc9d3",
                    "sense_definition": "Соответствовать каким-либо требованиям, нормам, ожиданиям или стандартам.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот новый товар полностью <отвечает> международным стандартам качества и безопасности.",
                            "target_lang_translations": {
                                "en": "This new product fully <meets> international quality and safety standards.",
                                "de": "Dieses neue Produkt <entspricht> vollkommen den internationalen Qualitäts- und Sicherheitsstandards."
                            }
                        },
                        {
                            "text": "Кандидат на эту должность должен <отвечать> целому ряду строгих профессиональных требований.",
                            "target_lang_translations": {
                                "en": "The candidate for this position must <meet> a whole range of strict professional requirements.",
                                "de": "Der Kandidat für diese Stelle muss einer ganzen Reihe strenger beruflicher Anforderungen <entsprechen>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "отвечать требованиям",
                        "отвечать стандартам",
                        "отвечать интересам",
                        "отвечать ожиданиям"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "официальное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To match or satisfy specific requirements, standards, or expectations.",
                        "de": "Bestimmten Anforderungen, Normen, Erwartungen oder Standards entsprechen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "meet",
                                "target_lang_sense_clarification": "requirements or standards"
                            },
                            {
                                "target_lang_word": "correspond",
                                "target_lang_sense_clarification": "+ to"
                            },
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "a purpose or description"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "entsprechen",
                                "target_lang_sense_clarification": "Anforderungen oder Standards genügen"
                            },
                            {
                                "target_lang_word": "erfüllen",
                                "target_lang_sense_clarification": "Kriterien oder Erwartungen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}