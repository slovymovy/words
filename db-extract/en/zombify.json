                    {
                        "sense_id": "5a8ccec8-51a7-3e57-ad64-4980075c2a0b",
                        "entry_id": "38a6f77a-e0f1-317a-8685-cbd10f7298c8",
                        "glosses": [
                            "To turn into a zombie (a member of the living dead or undead)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "392d8189-6ab2-4808-ba73-5fb68dcdec54",
                                "sense_id": "5a8ccec8-51a7-3e57-ad64-4980075c2a0b",
                                "text": "She managed to flee the sorcerer who had attempted to zombify her and enjoyed relative prosperity in Jamaica."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe850bfe-49a3-36a2-a376-1d23742e28d3",
                        "entry_id": "38a6f77a-e0f1-317a-8685-cbd10f7298c8",
                        "glosses": [
                            "To take control of (a computer) in order to use it covertly and illicitly."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "592f289c-5d33-4a7c-944d-464b0fc54209",
                                "sense_id": "fe850bfe-49a3-36a2-a376-1d23742e28d3",
                                "text": "These trojans can zombify your machine."
                            }
                        ]
                    },
                    {
                        "sense_id": "2de51198-e81e-3519-8717-98ac39dab862",
                        "entry_id": "38a6f77a-e0f1-317a-8685-cbd10f7298c8",
                        "glosses": [
                            "To deprive of authenticity or vitality; to render someone brainless or unthinking."
                        ],
                        "tags": [
                            "idiomatic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1bdb4823-27c3-4dbc-adcb-e053378f08de",
                                "sense_id": "2de51198-e81e-3519-8717-98ac39dab862",
                                "text": "Zombified by the lies they said, we’ve become the walking dead."
                            }
                        ]
                    }
                ],
