                        "glosses": [
                            "To deprive of vitality; to make lifeless; to weaken."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "428e242d-0997-4bfb-b007-33f2004839fe",
                                "sense_id": "08f0b05b-c855-3379-ae96-f5ab51f6d0c7",
                                "text": "Near-synonym: deanimate"
                            },
                            {
                                "example_id": "f07040ce-77bb-45d4-bf06-c0db0036d8da",
                                "sense_id": "08f0b05b-c855-3379-ae96-f5ab51f6d0c7",
                                "text": "Noncrushing surgical clamps avoid devitalizing the cells of arterial walls."
                            },
                            {
                                "example_id": "d5fcff6e-66fa-4af7-a061-a1de708518d1",
                                "sense_id": "08f0b05b-c855-3379-ae96-f5ab51f6d0c7",
                                "text": "Economic stress has devitalized some shopping malls in the web era."
                            },
                            {
                                "example_id": "d8951b34-2bdc-45a6-8a39-cad64dcf19d4",
                                "sense_id": "08f0b05b-c855-3379-ae96-f5ab51f6d0c7",
                                "text": "Not so long ago a Scotsman is reported to have exhumed the body of his daughter and burnt her heart, as he thought she was devitalising her remaining brother and sister and making them ill."
                            }
                        ]
                    }
                ],
