                "senses": [
                    {
                        "sense_id": "975e202b-0871-30bb-9bb8-708487003bbb",
                        "entry_id": "04eb6a02-16c7-346c-aac9-482b83a437ef",
                        "glosses": [
                            "Qui supprime ou atténue la douleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7256b7-125b-44b0-8aa6-0f091e70538f",
                                "sense_id": "975e202b-0871-30bb-9bb8-708487003bbb",
                                "text": "Des médicaments antidouleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6cd9d58-ae33-4e92-9200-a047590b032a",
                        "source_entry_id": "04eb6a02-16c7-346c-aac9-482b83a437ef",
                        "source_sense_id": "975e202b-0871-30bb-9bb8-708487003bbb",
                        "target_lang_word": "schmerzstillend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schmerzstillend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "971932f0-14bd-3301-8fc3-d7f2e62c21dd",
                                        "entry_id": "8abe1104-e302-3201-a737-2abe7cf7d076",
                                        "glosses": [
                                            "den Schmerz, das Schmerzgefühl beseitigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53830dbc-c87c-4ef3-9a0b-21b70e4b0bc4",
                                                "sense_id": "971932f0-14bd-3301-8fc3-d7f2e62c21dd",
                                                "text": "Es gibt verschiedene Salben, die eine schmerzstillende Wirkung haben."
                                            },
                                            {
                                                "example_id": "9ebd842a-35ee-42b4-b5ac-6e88996bd4bf",
                                                "sense_id": "971932f0-14bd-3301-8fc3-d7f2e62c21dd",
                                                "text": "Ibuprofen hat eine schmerzstillende, entzündungshemmende und fiebersenkende Wirkung, da es die Produktion von Prostaglandinen (=Botenstoffe) hemmt."
                                            },
                                            {
                                                "example_id": "9ef663d2-b1e5-49b7-9280-68c06053cdf5",
                                                "sense_id": "971932f0-14bd-3301-8fc3-d7f2e62c21dd",
                                                "text": "Kirschen schmecken aber nicht nur: Sie enthalten viele wichtige und gesunde Nährstoffe, die unter anderem auch schmerzstillende Wirkung entfalten können."
                                            },
                                            {
                                                "example_id": "b7912e04-83df-493f-9370-cf5446384f2d",
                                                "sense_id": "971932f0-14bd-3301-8fc3-d7f2e62c21dd",
                                                "text": "Der Wirkstoff Paracetamol besitzt ähnlich schmerzstillende Eigenschaften wie ASS, wirkt jedoch nicht entzündungshemmend oder blutverdünnend."
                                            },
                                            {
                                                "example_id": "bb07d5d7-15fb-4a2c-8014-0a9413b6a576",
                                                "sense_id": "971932f0-14bd-3301-8fc3-d7f2e62c21dd",
                                                "text": "Doch mit Vertrauen überall benüzt als »zertheilendes, lösendes, schmerzstillendes« Pflaster, vom Hühnerauge bis zu Brustkrebs; …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db996590-f578-485a-bb9b-14f8e7a9ff31",
                        "source_entry_id": "04eb6a02-16c7-346c-aac9-482b83a437ef",
                        "source_sense_id": "975e202b-0871-30bb-9bb8-708487003bbb",
