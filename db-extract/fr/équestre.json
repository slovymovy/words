                                                "example_id": "65b4b7c4-65c2-43fd-89ab-0122032ea860",
                                                "sense_id": "3297ce79-50eb-39b9-8a6a-7e6717fe6f1f",
                                                "text": "Конный отряд."
                                            },
                                            {
                                                "example_id": "669d658b-3728-49fa-98f0-265a95710793",
                                                "sense_id": "3297ce79-50eb-39b9-8a6a-7e6717fe6f1f",
                                                "text": "Конная атака."
                                            }
                                        ]
                                    }
                                ]
                            },
