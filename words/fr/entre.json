            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "b2ec2a5f-09c4-39ea-aede-858be3bf0598",
                    "sense_definition": "Au milieu ou dans l'espace qui sépare deux ou plusieurs personnes, objets ou lieux.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La boulangerie se trouve <w>entre</w> la pharmacie et la mairie du village."
                        },
                        {
                            "text": "Il a glissé une feuille de papier <w>entre</w> les pages du livre."
                        }
                    ],
                    "common_phrases": [
