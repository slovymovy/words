                        "translation_id": "8800aff3-850e-4f6c-9e40-3acf8e2b41b6",
                        "source_entry_id": "2a020b81-fc6e-3d28-87b4-861ee92e9877",
                        "source_sense_id": "30895e66-8bfd-326d-afe6-35bc00599602",
                        "target_lang_word": "hairless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hairless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f91de819-1fc9-369d-8038-9b669a3371ac",
                                        "entry_id": "3cbdd707-33b0-36d7-90aa-df566403916e",
                                        "glosses": [
                                            "Destitute of hair."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f940220-4633-394e-9f81-129113d45ad3",
                                        "entry_id": "3cbdd707-33b0-36d7-90aa-df566403916e",
                                        "glosses": [
                                            "Bald."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde7aa47-64a7-4497-b375-696e82728799",
                                                "sense_id": "5f940220-4633-394e-9f81-129113d45ad3",
                                                "text": "There has never been a bald James Bond nor a hairless contestant on Love Island. Growing up, bald men were never the superheroes and always the villains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hairless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50257420-f2aa-3a28-8a4c-961b27ce6856",
                                        "entry_id": "360ed256-9195-3ae3-be43-9ff4fcabd92d",
                                        "glosses": [
                                            "An animal of a hairless breed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa348c2f-5774-445c-a71c-b5d32606b598",
                                                "sense_id": "50257420-f2aa-3a28-8a4c-961b27ce6856",
                                                "text": "Boston terriers and bulldogs, poodles and Pomeranians; there was even a pair of Mexican hairlesses, who looked like they'd had thirty rounds of chemotherapy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e859126-5fe4-4808-b561-0978ee455ae1",
                        "source_entry_id": "2a020b81-fc6e-3d28-87b4-861ee92e9877",
                        "source_sense_id": "30895e66-8bfd-326d-afe6-35bc00599602",
                        "target_lang_word": "haarlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haarlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91b372ae-5ff4-3019-83fb-168ca219ef61",
                                        "entry_id": "f10df5e7-1ad0-3a0f-a289-70d8297f79cd",
                                        "glosses": [
                                            "keinerlei Behaarung aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83250604-f2fb-4090-a309-781df1b6d2b9",
                                                "sense_id": "91b372ae-5ff4-3019-83fb-168ca219ef61",
                                                "text": "„Im Islam ist Enthaarung Teil der Religion, in der westlichen Welt aber ist in den vergangenen Jahrzehnten eine Milliardenindustrie um den haarlosen Körper entstanden, an der nicht nur Hersteller von Rasierern und Rasierschaum verdienen, sondern auch Studios für Waxing und Laser-Haarentfernung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab7eb135-6534-4113-8c04-fee89e5bde23",
                        "source_entry_id": "2a020b81-fc6e-3d28-87b4-861ee92e9877",
                        "source_sense_id": "30895e66-8bfd-326d-afe6-35bc00599602",
                        "target_lang_word": "безволосый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "безволосый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3b38661b-c9bf-358e-b27a-11065f23e5be",
                                        "entry_id": "ed9e9a28-8517-33cc-a225-3220353e8765",
                                        "glosses": [
                                            "не несущий на себе волос или шерсти"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf518b5-67d5-4d0b-a31a-4210b0285b98",
                                                "sense_id": "3b38661b-c9bf-358e-b27a-11065f23e5be",
                                                "text": "Так, они смотрели на бритьё бороды, как на нечто совершенно унизительное, потому что безволосый подбородок придаёт мужчине противоестественный, женоподобный вид."
                                            },
                                            {
                                                "example_id": "e5c1686b-5d20-4c37-92d2-785d768583fa",
                                                "sense_id": "3b38661b-c9bf-358e-b27a-11065f23e5be",
                                                "text": "Сделав такое важное открытие, господин Голядкин вспомнил и о арабских эмирах, у которых, если снять с головы зелёную чалму, которую они носят в знак родства своего с пророком Мухамедом, то останется тоже голая, безволосая голова."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
