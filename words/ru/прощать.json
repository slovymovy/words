{
    "word_family": [
        "прощение",
        "прощание",
        "простительный",
        "непростительный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54e9596c-8d28-3b03-bd32-794a099eddde",
                    "sense_definition": "Переставать винить кого-либо за проступок, обиду или вину; проявлять снисходительность к ошибкам.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она умела искренне <прощать> людям их маленькие слабости.",
                            "target_lang_translations": {
                                "en": "She knew how to sincerely <w>forgive</w> people for their little weaknesses.",
                                "de": "Sie verstand es, den Menschen ihre kleinen Schwächen aufrichtig zu <w>verzeihen</w>."
                            }
                        },
                        {
                            "text": "Мы должны научиться <прощать> друг друга, чтобы сохранить дружбу.",
                            "target_lang_translations": {
                                "en": "We must learn to <w>forgive</w> each other to save the friendship.",
                                "de": "Wir müssen lernen, einander zu <w>vergeben</w>, um die Freundschaft zu bewahren."
                            }
                        }
                    ],
                    "synonyms": [
                        "извинять"
                    ],
                    "antonyms": [
                        "мстить"
                    ],
                    "common_phrases": [
                        "прощать обиды",
                        "прощать ошибки",
                        "уметь прощать"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop blaming someone for a misdeed, offense, or guilt; to show leniency toward mistakes.",
                        "de": "Aufhören, jemandem ein Vergehen, eine Kränkung oder Schuld vorzuwerfen; Nachsicht bei Fehlern zeigen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forgive",
                                "target_lang_sense_clarification": "general"
                            },
                            {
                                "target_lang_word": "pardon",
                                "target_lang_sense_clarification": "formal or legal"
                            },
                            {
                                "target_lang_word": "excuse",
                                "target_lang_sense_clarification": "minor offenses or manners"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verzeihen",
                                "target_lang_sense_clarification": "allgemein, persönliche Kränkungen oder Fehler"
                            },
                            {
                                "target_lang_word": "vergeben",
                                "target_lang_sense_clarification": "tiefere Vergebung, Schuld oder Sünden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df329944-7fdf-3ce2-a5cf-2b504eee9088",
                    "sense_definition": "Произносить слова прощания при расставании (обычно навсегда); используется преимущественно в повелительном наклонении.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Прощай>, мой любимый город, я уезжаю очень надолго.",
                            "target_lang_translations": {
                                "en": "<w>Farewell</w>, my beloved city, I am leaving for a very long time.",
                                "de": "<w>Leb wohl</w>, meine geliebte Stadt, ich reise für sehr lange Zeit ab."
                            }
                        },
                        {
                            "text": "Он махнул рукой и тихо сказал: «<Прощайте>!».",
                            "target_lang_translations": {
                                "en": "He waved his hand and quietly said, \"<w>Farewell</w>!\"",
                                "de": "Er winkte mit der Hand und sagte leise: „<w>Lebt wohl</w>!“"
                            }
                        }
                    ],
                    "common_phrases": [
                        "прощай навсегда"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative only"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To pronounce words of parting when separating (usually forever); used mainly in the imperative mood.",
                        "de": "Worte des Abschieds sprechen (meist für immer); fast ausschließlich im Imperativ verwendet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to bid farewell",
                                "target_lang_sense_clarification": "to say goodbye at parting (esp. forever); usu. imperative прощай"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Lebewohl sagen",
                                "target_lang_sense_clarification": "Abschied nehmen, oft für immer"
                            },
                            {
                                "target_lang_word": "leb wohl",
                                "target_lang_sense_clarification": "Abschiedsgruß im Imperativ (Einzahl)"
                            },
                            {
                                "target_lang_word": "lebt wohl",
                                "target_lang_sense_clarification": "Abschiedsgruß im Imperativ (Mehrzahl / förmlich)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba7cd985-bd6c-3ab1-8bea-4bc5399b1326",
                    "sense_definition": "Освобождать кого-либо от уплаты долга или выполнения обязательства.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Банк не собирается <прощать> ему этот огромный кредит.",
                            "target_lang_translations": {
                                "en": "The bank is not going to <w>forgive</w> him this huge loan.",
                                "de": "Die Bank hat nicht die Absicht, ihm diesen riesigen Kredit zu <w>erlassen</w>."
                            }
                        },
                        {
                            "text": "Добрый хозяин любил <прощать> долги своим бедным арендаторам.",
                            "target_lang_translations": {
                                "en": "The kind landlord loved to <w>forgive</w> debts to his poor tenants.",
                                "de": "Der gütige Gutsherr pflegte seinen armen Pächtern die Schulden zu <w>erlassen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "освобожда́ть",
                        "списывать"
                    ],
                    "antonyms": [
                        "взыскивать"
                    ],
                    "common_phrases": [
                        "прощать долг"
                    ],
                    "target_lang_definitions": {
                        "en": "To release someone from the payment of a debt or the fulfillment of an obligation.",
                        "de": "Jemanden von der Rückzahlung einer Schuld oder der Erfüllung einer Verbindlichkeit befreien."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forgive",
                                "target_lang_sense_clarification": "a debt"
                            },
                            {
                                "target_lang_word": "remit",
                                "target_lang_sense_clarification": "formal/legal"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erlassen",
                                "target_lang_sense_clarification": "Schulden oder Strafen aufheben"
                            },
                            {
                                "target_lang_word": "vergeben",
                                "target_lang_sense_clarification": "eine Schuld tilgen oder nachsehen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}