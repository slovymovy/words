                        "sense_id": "69d5e001-2f5f-32f3-9fb0-bebba7f1d450",
                        "entry_id": "e9fa585e-13d5-3a03-9dcd-07fda9b0feed",
                        "glosses": [
                            "Shortening of carbon nanotube; A carbon molecule, in the shape of a tube, having a fullerene structure and a diameter of about 1 or 2 nanometers."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6717fd31-469f-3d2b-90c9-a975b84ab108",
                        "entry_id": "e9fa585e-13d5-3a03-9dcd-07fda9b0feed",
                        "glosses": [
                            "any nanotech tubular structure with a characteristic diameter measured in a few nanometres, such as titanium nanotubes"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0804e3b0-50d1-424e-98f1-3eb400439499",
                        "source_entry_id": "e9fa585e-13d5-3a03-9dcd-07fda9b0feed",
                        "source_sense_description": "A carbon molecule, in the shape of a tube",
                        "target_lang_word": "nanotube",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanotube",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58ea92e5-53ad-3cbb-9a84-152fd18fee3c",
                                        "entry_id": "cf3a3933-081a-383b-b5f6-15794636b5c9",
                                        "glosses": [
                                            "Nanoobjet tubulaire dont le diamètre est de dimension nanométrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7372935d-5dd5-492d-a0bf-9d15a9a2b1d3",
                                                "sense_id": "58ea92e5-53ad-3cbb-9a84-152fd18fee3c",
                                                "text": "En utilisant des faisceaux de neutrons, un groupe de physiciens vient de découvrir que l’état quantique des protons dans les molécules d’eau n’était pas le même quand ces molécules s’ébattent librement dans un verre et quand elles se trouvent confinées dans un nanotube de carbone de 1,6 nanomètre de diamètre."
                                            },
                                            {
                                                "example_id": "57975478-b833-48c5-8f9b-7eb03e032c63",
                                                "sense_id": "58ea92e5-53ad-3cbb-9a84-152fd18fee3c",
                                                "text": "En fait il existe même alors des oscillations de Aharonov–Bohm affectant la valeur de la résistivité du nanotube de carbone, lesquels avaient été observées des années avants."
                                            },
                                            {
                                                "example_id": "939fb735-6cd6-4d9a-9a44-e55172928c70",
                                                "sense_id": "58ea92e5-53ad-3cbb-9a84-152fd18fee3c",
                                                "text": "Un nanotube de carbone, c'est aussi une usine. Des chercheurs finlandais (université Aalto) ont synthétisé des nanorubans de graphène - autre variété de carbone - à l'intérieur de nanotubes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
