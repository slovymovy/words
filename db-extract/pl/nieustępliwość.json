                "translations": [
                    {
                        "translation_id": "adf05044-dfa7-4684-8da0-4a626bc38bf1",
                        "source_entry_id": "5ec9cccb-52fa-3fbe-9d25-a4cbb285436d",
                        "source_sense_id": "cd8ee774-5dc5-34f3-ad14-1a38ffde23d4",
                        "target_lang_word": "tenacity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenacity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0abe3390-c6fb-324b-b48e-80a76e54f79e",
                                        "entry_id": "9086eeb6-eb8e-3a3d-8fe1-d370ac2f0846",
                                        "glosses": [
                                            "The quality or state of being tenacious, or persistence of purpose; tenaciousness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7125bf56-2475-4607-8916-3b5b30177aa0",
                                                "sense_id": "0abe3390-c6fb-324b-b48e-80a76e54f79e",
                                                "text": "— Our opponents may be younger, faster and less out of shape than we are, but we have something they’ll never have!\n— Tenure?\n— Tenacity!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f66d89ca-ba10-339e-b195-d3405f7dd3b2",
                                        "entry_id": "9086eeb6-eb8e-3a3d-8fe1-d370ac2f0846",
                                        "glosses": [
                                            "The quality of bodies which keeps them from parting without considerable force, as distinguished from brittleness, fragility, mobility, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "313fc5a5-39d8-3f9e-a6c4-fc97d89f38eb",
                                        "entry_id": "9086eeb6-eb8e-3a3d-8fe1-d370ac2f0846",
                                        "glosses": [
                                            "The effect of this attraction, cohesiveness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e61db80-5ecb-3d29-9260-bc1520941b69",
                                        "entry_id": "9086eeb6-eb8e-3a3d-8fe1-d370ac2f0846",
                                        "glosses": [
                                            "The quality of bodies which makes them adhere to other bodies; adhesiveness, viscosity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efa5929c-c757-3eaf-b89d-7be3329cd899",
                                        "entry_id": "9086eeb6-eb8e-3a3d-8fe1-d370ac2f0846",
                                        "glosses": [
                                            "The greatest longitudinal stress a substance can bear without tearing asunder, usually expressed with reference to a unit area of the cross section of the substance, as the number of pounds per square inch, or kilograms per square centimeter, necessary to produce rupture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92f48864-9b61-4721-9167-22d7d5684b67",
                        "source_entry_id": "5ec9cccb-52fa-3fbe-9d25-a4cbb285436d",
                        "source_sense_id": "cd8ee774-5dc5-34f3-ad14-1a38ffde23d4",
                        "target_lang_word": "ténacité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ténacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "126a63bf-094c-3f04-b4bd-79ef06b0130c",
                                        "entry_id": "4a44b7e2-7af8-3630-b42b-fc42f213b4d1",
                                        "glosses": [
                                            "Caractère de ce qui est tenace, de ce qui tient fortement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "467242ab-5ab8-4d01-8e3c-d4db739a47d3",
                                                "sense_id": "126a63bf-094c-3f04-b4bd-79ef06b0130c",
                                                "text": "La ténacité de la poix, de la glu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66cb595e-fc1c-3085-a638-bc36f939d505",
                                        "entry_id": "4a44b7e2-7af8-3630-b42b-fc42f213b4d1",
                                        "glosses": [
                                            "Propriété qu’ont certains corps de soutenir une traction, une pression considérable sans s’allonger, sans se rompre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bccbbd19-e0cd-42fe-8fd2-e9e55c8a9100",
                                                "sense_id": "66cb595e-fc1c-3085-a638-bc36f939d505",
                                                "text": "Deux fils de même ténacité, mais de numéros différents, qui doivent être tendus conséquemment avec la même traction, ne peuvent donc pas, au dévidoir, prendre le même dispositif de tension."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef40306-aeb6-3a62-bf51-e3c70331b294",
                                        "entry_id": "4a44b7e2-7af8-3630-b42b-fc42f213b4d1",
                                        "glosses": [
                                            "Capacité d'un matériau à encaisser l'énergie d'un choc, d'une contrainte, en résistant à la fissuration.(L'inverse se nomme douceur ou faiblesse.)"
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db26380b-69a2-45d9-bdd3-b8014e56cce4",
                                                "sense_id": "fef40306-aeb6-3a62-bf51-e3c70331b294",
                                                "text": "Il apparaît ainsi que les applications nécessitant une très grande ténacité tireront avantage de l'utilisation des aciers rapides, à condition que le niveau des températures locales reste bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98f6fb2c-0a47-3e6d-b6a2-49dce1ee2907",
                                        "entry_id": "4a44b7e2-7af8-3630-b42b-fc42f213b4d1",
                                        "glosses": [
                                            "Attachement invariable à une idée, à un projet, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0376de44-d287-4a17-ab2f-64a1dc9a2815",
                                                "sense_id": "98f6fb2c-0a47-3e6d-b6a2-49dce1ee2907",
                                                "text": "Cet homme a beaucoup de ténacité."
                                            },
                                            {
                                                "example_id": "240d2c6b-ccce-4b8a-85d0-f16d9e8e9dbc",
                                                "sense_id": "98f6fb2c-0a47-3e6d-b6a2-49dce1ee2907",
                                                "text": "Il montre bien de la ténacité pour une chose qui n’en vaut pas la peine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6243a9b-2564-3c81-a1fc-bbdf8d795eae",
                                        "entry_id": "4a44b7e2-7af8-3630-b42b-fc42f213b4d1",
                                        "glosses": [
                                            "Faculté de retenir toujours ou longtemps ce qu’elle a appris, en parlant de la mémoire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe7df761-24a2-431c-afc5-c22ac8111f2b",
                                                "sense_id": "b6243a9b-2564-3c81-a1fc-bbdf8d795eae",
                                                "text": "Sa mémoire est d’une grande ténacité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4306e923-27fd-48e1-9b98-c0957206a5a6",
                        "source_entry_id": "5ec9cccb-52fa-3fbe-9d25-a4cbb285436d",
                        "source_sense_id": "cd8ee774-5dc5-34f3-ad14-1a38ffde23d4",
                        "target_lang_word": "упорство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "упорство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                        "entry_id": "5b093e36-3530-3c82-831e-a87941c9d17b",
                                        "glosses": [
                                            "свойство по значению прилагательного упорный; настойчивое, упорное стремление к чему-либо, к осуществлению чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a085325-cb94-45dd-9d99-79c3495dfd1d",
                                                "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                                "text": "Гордость, дерзость, упорство, восторженность еретика имеют только вид энергии, в сущности они ― немощь, нуждающаяся в благоразумном соболезновании."
                                            },
                                            {
                                                "example_id": "2fe32ad0-1fe0-412b-a6e6-f477af016c26",
                                                "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                                "text": "Конечно, было сопротивление, было мужество и упорство обречённых, были восстания, была самопожертвенность, когда для спасения далёкого, незнакомого человека другой человек рисковал своей жизнью и жизнью своей семьи."
                                            },
                                            {
                                                "example_id": "45eae1e9-907e-4abc-8534-f5a054af273e",
                                                "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                                "text": "Мне кажется, что упорство наше в Сталинграде ― это упорство Ньютона, упорство Эйнштейна, что победа на Волге знаменует торжество идей Эйнштейна, словом, понимаете, вот такое чувство."
                                            },
                                            {
                                                "example_id": "54c56bfe-ea93-4ec4-ae51-732fcc7dfe94",
                                                "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                                "text": "В его беспрерывной развязной болтовне и в глазах, жадных и просящих, была незащищённость, что-то детское, недоразвитое и какое-то упорство, обречённое на провал."
                                            },
                                            {
                                                "example_id": "e759de08-bf57-4371-92af-9d44b6536a67",
                                                "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                                "text": "Знали, что в двух шагах под холодным брезентом торжествуют отвага и удаль. Безграничная нежность южанина и упорство гвардейца… Наутро Рябчук оторвал доски и вышел, шатаясь, бледный и слабый."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec5af911-bab1-4fc5-98f7-dfabd93d0994",
                        "source_entry_id": "5ec9cccb-52fa-3fbe-9d25-a4cbb285436d",
                        "source_sense_id": "cd8ee774-5dc5-34f3-ad14-1a38ffde23d4",
                        "target_lang_word": "настойчивость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "настойчивость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a0824246-cc12-3442-a3fc-04eb544a0fb1",
                                        "entry_id": "0e84fc1b-a808-341e-86bd-1a8f0589ccb1",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного настойчивый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cb4c26a-ed2f-4bcc-a05a-670df83eae63",
                                                "sense_id": "a0824246-cc12-3442-a3fc-04eb544a0fb1",
                                                "text": "Естественно, что с первого раза у вас может не получиться, но если вы проявите настойчивость, то скоро будете вознаграждены: вам удастся простоять на пятках достаточно продолжительное время, не переступая с места на место."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
