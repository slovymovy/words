                                    {
                                        "sense_id": "fd731951-c6a7-31ae-9e9d-937138aeb389",
                                        "entry_id": "6e21dc78-c9dc-3865-936b-676c709c0676",
                                        "glosses": [
                                            "Polyèdre constitué de faces identiques de type cerf-volant, dont la forme est utilisée pour certains types de dés comme le dé à 10 faces."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adcc8be5-3d4a-4872-bd6f-2d42f934cddf",
                                                "sense_id": "fd731951-c6a7-31ae-9e9d-937138aeb389",
                                                "text": "L’ordre de l’antidiamant est égal à celui du polygone de base de l’antiprisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b8daf77-d41f-3f1c-9222-5071f89d164e",
                                        "entry_id": "6e21dc78-c9dc-3865-936b-676c709c0676",
                                        "glosses": [
                                            "Inverse du diamant."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "724c5c19-e913-459a-bc20-8b5585fed8c4",
                                                "sense_id": "0b8daf77-d41f-3f1c-9222-5071f89d164e",
                                                "text": "Avec cette étrange image de la Guerre des étoiles, du héros cryogénisé, je dérive sur fond de ciel noir, cosmonaute enchâssé dans son parallélépipède de C0₂ solidifié, d’un noir d’antidiamant, d’un noir pur et transparent."
                                            },
                                            {
                                                "example_id": "48761a5a-6f25-4717-892d-5c40b6da3afe",
                                                "sense_id": "0b8daf77-d41f-3f1c-9222-5071f89d164e",
                                                "text": "Sa couronne est pleine de piquants qui ne brillent pas du tout et ornée, au lieu de diamants scintillants, d’antidiamants qui absorbent la lumière."
                                            }
                                        ]
                                    }
                                ]
                            }
