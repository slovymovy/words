                    {
                        "sense_id": "f5ebeac5-11b4-3562-bdaf-6ed5df74aa7a",
                        "entry_id": "60c26c10-478e-3220-bd43-de3a64f6ac95",
                        "glosses": [
                            "het buitenste gedeelte van de planeet Aarde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13ef8d5a-5005-472c-8d30-fbd154a866ca",
                                "sense_id": "f5ebeac5-11b4-3562-bdaf-6ed5df74aa7a",
                                "text": "Het land ligt op meerdere breuklijnen in de aardkorst."
                            },
                            {
                                "example_id": "34f83b17-a893-4dcd-ac0f-003432821706",
                                "sense_id": "f5ebeac5-11b4-3562-bdaf-6ed5df74aa7a",
                                "text": "Je wilt met alle geweld weten wat er onder die harde aardkorst zit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96ef0f47-24ce-4cff-a50a-f6400e3db087",
                        "source_entry_id": "60c26c10-478e-3220-bd43-de3a64f6ac95",
                        "source_sense_id": "f5ebeac5-11b4-3562-bdaf-6ed5df74aa7a",
                        "source_sense_description": "het buitenste gedeelte van de planeet Aarde",
                        "target_lang_word": "Erdkruste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdkruste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dbf7143-3571-3380-8c5b-a260714c4d33",
                                        "entry_id": "abc5e86b-c163-32c8-acc7-32ed76b678c5",
                                        "glosses": [
                                            "äußere, feste Schicht des Planeten Erde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2dec21f-00b5-46e3-a559-a9a6eaa780cf",
                                                "sense_id": "0dbf7143-3571-3380-8c5b-a260714c4d33",
                                                "text": "Im Schalenaufbau der Erde bildet die Erdkruste zusammen mit dem lithosphärischen Mantel die Lithosphäre."
                                            },
                                            {
                                                "example_id": "d98b9d54-32fd-4f86-b6da-240cb7ee0df2",
                                                "sense_id": "0dbf7143-3571-3380-8c5b-a260714c4d33",
                                                "text": "Tsunamis seien wegen der stabilen Erdkruste in dieser Region aber unwahrscheinlich."
                                            },
                                            {
                                                "example_id": "678e3453-8034-4bf5-864e-59c05b45ce9a",
                                                "sense_id": "0dbf7143-3571-3380-8c5b-a260714c4d33",
                                                "text": "Mikroben bevölkern die Erdkruste Hunderte Meter unter der Oberfläche - und haben erstaunliche Überlebensstrategien entwickelt."
                                            },
                                            {
                                                "example_id": "027edfa0-8f49-446b-906f-d6cabc97c4de",
                                                "sense_id": "0dbf7143-3571-3380-8c5b-a260714c4d33",
                                                "text": "Immer klarer kristallisiert sich heraus, dass die obersten Kilometer der Erdkruste voller Leben sind."
                                            },
                                            {
                                                "example_id": "e1553634-1f8f-4658-9440-0e2430db4e42",
                                                "sense_id": "0dbf7143-3571-3380-8c5b-a260714c4d33",
                                                "text": "„Die Erdkruste bildete sich vor rund 4,5 Milliarden Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
