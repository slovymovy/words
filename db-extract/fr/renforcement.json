        "fr-extract.jsonl": [
            {
                "entry_id": "02f99498-2216-367a-b7b9-2b6427e88d3c",
                "word": "renforcement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1dc6e11e-080c-4d7e-8f39-725da37fb55a",
                        "entry_id": "02f99498-2216-367a-b7b9-2b6427e88d3c",
                        "tags": [
                            "plural"
                        ],
                        "form": "renforcements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                        "entry_id": "02f99498-2216-367a-b7b9-2b6427e88d3c",
                        "glosses": [
                            "Action de renforcer, résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82d82387-15c5-4665-ae83-717fcd089458",
                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                "text": "Le manche est en bois ; on en colle le talon au bout de la caisse sur le renforcement ou épaulement de la table : il est terminé en volute, et creusé d'un large sillon ou mortaise ; c'est le sommier."
                            },
                            {
                                "example_id": "7bb6157e-8fb9-447c-9eb2-59501f46ef32",
                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                "text": "Et c'est cette politique aussi qui favorisa le renforcement du ritualisme juif, lequel semble avoir été assez modéré jusqu'au XVᵉ siècle."
                            },
                            {
                                "example_id": "5a674259-bfad-4f4b-986f-2ea9c199d115",
                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                "text": "Les résultats de l’étude permettent de savoir comment on peut réduire l’épaisseur d'un renforcement en utilisant des enrobés moins fatigables qui n’ornièreront pas plus pour autant."
                            },
                            {
                                "example_id": "cd6cfbb9-c9a2-46cf-8ebc-4da1fa22825e",
                                "sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                                "text": "Le renforcement des alizés depuis vingt ans y a créé un énorme réservoir de chaleur, « les eaux chaudes y forment une couche plus épaisse », explique Cazenave."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc1575b3-e14e-448a-90b3-772782368a3f",
                        "source_entry_id": "02f99498-2216-367a-b7b9-2b6427e88d3c",
                        "source_sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                        "target_lang_word": "Verstärkung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verstärkung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd9e791f-05f0-363e-89e7-e263529650fb",
                                        "entry_id": "6a4a28b0-0a5d-3f64-9a13-ca32a4861f5f",
                                        "glosses": [
                                            "technische Vorrichtung zur Erhöhung der Stabilität oder Verbesserung der Designeigenschaften zum Beispiel bei Gebäuden, Maschinen, Fahrzeugen und Kleidern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6980f0f-bd65-4707-bcf5-863f494f4507",
                                                "sense_id": "bd9e791f-05f0-363e-89e7-e263529650fb",
                                                "text": "Die Rückbank ließ sich nicht umlegen, da zum Kofferraum hin verkreuzte Streben als Verstärkung verbaut waren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9bbc1e7c-bc67-3918-ada3-7ac137f26698",
                                        "entry_id": "6a4a28b0-0a5d-3f64-9a13-ca32a4861f5f",
                                        "glosses": [
                                            "zusätzliches Personal, das für eine bestimmte Aufgabe bereitgestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38d5edfe-0495-4545-8eb5-0c29843cb976",
                                                "sense_id": "9bbc1e7c-bc67-3918-ada3-7ac137f26698",
                                                "text": "Da die Front bröckelte mussten immer neue Truppen als Verstärkung abgestellt werden."
                                            },
                                            {
                                                "example_id": "705ac011-4cd8-431d-87f5-b831c92fe94a",
                                                "sense_id": "9bbc1e7c-bc67-3918-ada3-7ac137f26698",
                                                "text": "„Durch diesen Korridor kam hin und wieder Verstärkung, aber der Abwehrkampf der Wehrmacht war aussichtslos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5fd3ec68-e051-30b5-b973-3d0574e733c0",
                                        "entry_id": "6a4a28b0-0a5d-3f64-9a13-ca32a4861f5f",
                                        "glosses": [
                                            "Vergrößerung der Amplitude, zum Beispiel Erhöhung der Lautstärke von Geräuschen"
                                        ],
                                        "tags": [
                                            "bezogen auf Wellen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1db16ed4-1f5f-4d7f-abbc-e131e22857ab",
                                                "sense_id": "5fd3ec68-e051-30b5-b973-3d0574e733c0",
                                                "text": "Da die Schwingungen den Passanten einen Gleichschritt aufzwangen kam es zu einer bedrohlichen Verstärkung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "982568d0-e796-37b3-9723-5c936b3f578c",
                                        "entry_id": "6a4a28b0-0a5d-3f64-9a13-ca32a4861f5f",
                                        "glosses": [
                                            "Intensivierung, Zunahme, Verdichtung"
                                        ],
                                        "tags": [
                                            "Verkehr",
                                            "Handel",
                                            "Beziehungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ab3fee3-58ee-4321-842f-1d0f3b996075",
                                                "sense_id": "982568d0-e796-37b3-9723-5c936b3f578c",
                                                "text": "Durch den Abbau von Zöllen kam es zu einer Verstärkung des internationalen Handels."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01e9cda3-dd8a-439c-a03f-9848b9b3fbfa",
                        "source_entry_id": "02f99498-2216-367a-b7b9-2b6427e88d3c",
                        "source_sense_id": "5f4279df-a845-33ad-a378-15fa9ccac0a2",
                        "target_lang_word": "Zunahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zunahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                        "entry_id": "83559532-0d67-31ed-98ce-dbed623e54fa",
                                        "glosses": [
                                            "der Vorgang, bei dem etwas in der Menge oder im Volumen zunimmt, anwächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e86691b-835e-420a-93b1-20313e214c2e",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "Die Lehrer der hiesigen Schule glauben eine Zunahme der Übergriffe von Schülern auf Schüler ausgemacht zu haben."
                                            },
                                            {
                                                "example_id": "42972488-49ec-4430-bd70-f9a01fcb08e5",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "Ein Krebsexperte der chinesischen Akademie der Wissenschaften führte die Zunahme auf \"ungesunden Lebensstil\" zurück - wozu er neben ungesunder Ernährung und wachsendem Stress auch die Umweltverschmutzung zählte."
                                            },
                                            {
                                                "example_id": "f8e17635-55aa-4eec-a1a1-550caf7944cc",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "Die deutlichsten Zunahmen [der Kinderkriminalität] seien in Rheinland-Pfalz (plus 17 Prozent), Bayern (14 Prozent), Baden-Württemberg (neun Prozent) sowie Hessen und Sachsen (je acht Prozent) festzustellen."
                                            },
                                            {
                                                "example_id": "3aab0029-72c7-4de9-93a0-c422c22f99e2",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "„Das Phänomen, eine deutliche Zunahme präfigierter Verben in unserem Sprachgebrauch, läßt sich nicht bestreiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
