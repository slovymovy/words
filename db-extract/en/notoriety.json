                                "target_senses": [
                                    {
                                        "sense_id": "a03e5f02-b4a5-3f5b-b63c-9fad15e1f7c6",
                                        "entry_id": "4eea08c8-669d-3424-aba5-0cb05f817cf9",
                                        "glosses": [
                                            "Infamie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8493b451-1b67-48c4-8f31-6974ed2c3596",
                                                "sense_id": "a03e5f02-b4a5-3f5b-b63c-9fad15e1f7c6",
                                                "text": "Quant est des peintures, ou autres remembrances qu’ils dédient aux saints, que sont-ce, sinon patrons de pompe dissolue, et même d’infâmeté, auxquels si quelqu’un voulait se conformer, il serait digne du fouet ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c1f2db7-161d-45a6-af89-062760c693ba",
                        "source_entry_id": "0cd5e1f2-ea2b-3570-ac38-904dd9a53e17",
                        "source_sense_id": "17f05999-acf4-3950-894e-821d8a550718",
