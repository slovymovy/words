                "senses": [
                    {
                        "sense_id": "7efde887-d2b9-34b2-86e6-3d965c754838",
                        "entry_id": "9f34ece6-db44-367c-a7e3-72b9d8a19822",
                        "glosses": [
                            "bollend overhangen (van kledingstukken)"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "99725e70-97ef-4ee2-92c6-78700422eb37",
                                "sense_id": "7efde887-d2b9-34b2-86e6-3d965c754838",
                                "text": "Die mooie trui is helemaal gaan bloezen!"
                            }
                        ]
                    },
                    {
                        "sense_id": "ea528f3b-5be9-39a8-9522-8cd3255fe897",
                        "entry_id": "9f34ece6-db44-367c-a7e3-72b9d8a19822",
                        "glosses": [
                            "bollend over doen hangen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4a5b63c6-6f93-4262-a236-a22f47483def",
                                "sense_id": "ea528f3b-5be9-39a8-9522-8cd3255fe897",
                                "text": "Het gewaad werd vaak over de gordel gebloesd omdat de lap vaak langer was dan de afstand tussen de schouders en de voeten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84da6483-d823-4c7c-954d-3cc7d073cbc1",
                        "source_entry_id": "9f34ece6-db44-367c-a7e3-72b9d8a19822",
                        "source_sense_id": "7efde887-d2b9-34b2-86e6-3d965c754838",
                        "source_sense_description": "bollend overhangen (van kledingstukken)",
                        "target_lang_word": "bauschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bauschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f85833f-532d-3bb6-bb81-c06af1e8b133",
                                        "entry_id": "46b7a063-0085-31b4-9323-fa877d4f170a",
                                        "glosses": [
                                            "etwas, oft ein Stoff/Tuch, bekommt mehr Volumen, weil Luft darunter kommt und es wölbt"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b1d79b0-53a5-44d3-b9a5-829f6efc191d",
                                                "sense_id": "4f85833f-532d-3bb6-bb81-c06af1e8b133",
                                                "text": "„Eine weiße Gardine bauscht sich leise im Wind.“"
                                            },
                                            {
                                                "example_id": "1415146f-2b83-4d84-93aa-6645e7cc8a55",
                                                "sense_id": "4f85833f-532d-3bb6-bb81-c06af1e8b133",
                                                "text": "„Ich drehte mich seitlich und das grellrote Kleid bauschte sich wie eine überdimensionale Rosenblüte um meine Hüften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71390371-d7ea-3917-9047-b83aac742d3c",
                                        "entry_id": "46b7a063-0085-31b4-9323-fa877d4f170a",
                                        "glosses": [
                                            "etwas, oft ein Stoff/Tuch, mit Wind füllen, so dass es straff gespannt und ausgefüllt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76be4e19-1735-4d5b-98dd-42bc4c49aaf8",
                                                "sense_id": "71390371-d7ea-3917-9047-b83aac742d3c",
                                                "text": "„Der Wind bauschte die Stoffwände ihres Zeltes wie Segel und ließ sie frösteln. Immerhin war der Zeltstoff wasserdicht, die Konstruktion hielt, und Emma wurde nicht nass.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
