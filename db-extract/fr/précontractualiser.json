                "senses": [
                    {
                        "sense_id": "694940e5-2b59-389c-a9db-7061958f4d5d",
                        "entry_id": "2a85f961-322b-3e56-995c-542ec5b0f18b",
                        "glosses": [
                            "Donner un caractère précontractuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "babbda51-9fce-4388-958c-4f2ed6acb580",
                                "sense_id": "694940e5-2b59-389c-a9db-7061958f4d5d",
                                "text": "Il est donc recommandé pour l’une et l’autre des parties, de précontractualiser ses intentions par une lettre d’intention conjointe."
                            },
                            {
                                "example_id": "8f86c5b7-c6e0-4943-8469-cdd66c4210d5",
                                "sense_id": "694940e5-2b59-389c-a9db-7061958f4d5d",
                                "text": "Créer un contrat de travail conventionnel dans lequel les parties peuvent précontractualiser des situations de rupture dans une liste ou des limites fixées par la loi, avec une indemnité spécifique versée en cas de licenciement."
                            }
                        ]
                    }
