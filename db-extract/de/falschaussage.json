                "senses": [
                    {
                        "sense_id": "4d27bb35-f30a-3142-8e23-bcea9f7d8b80",
                        "entry_id": "5514ee42-41d4-3044-bb0a-6b594b0337e8",
                        "glosses": [
                            "Aussage, die nicht der Wahrheit entspricht"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "454c0544-4a4b-4ccd-9a7b-e57a0f9f8a5b",
                                "sense_id": "4d27bb35-f30a-3142-8e23-bcea9f7d8b80",
                                "text": "Durch seine Falschaussage vor Gericht machte er sich mitschuldig."
                            },
                            {
                                "example_id": "00340344-38aa-4579-8b97-d149a9838a95",
                                "sense_id": "4d27bb35-f30a-3142-8e23-bcea9f7d8b80",
                                "text": "„Der Moderator Jake Tapper hielt seiner Gesprächspartnerin immer wieder Falschaussagen der US-Administration vor, die er dann mit Fakten konterkarierte.“"
                            },
                            {
                                "example_id": "f86b54cf-8c14-470c-b61b-fdc29049cddf",
                                "sense_id": "4d27bb35-f30a-3142-8e23-bcea9f7d8b80",
                                "text": "„Seit mehreren Jahren gibt es ein immer wieder aktualisiertes Reiserecht und in der Bevölkerung ein durch Zeitungsartikel und Fernsehsendungen gewachsenes Bewusstsein für weggelassene Informationen über Landschaft, Strand und Hotel, für geschönte Formulierungen, für Fehler und sogar Falschaussagen in Reisekatalogen, so dass immer mehr Touristen die Reiseveranstalter verklagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b944d34-b1a0-402e-b600-307a97c1fd8d",
                        "source_entry_id": "5514ee42-41d4-3044-bb0a-6b594b0337e8",
                        "source_sense_id": "4d27bb35-f30a-3142-8e23-bcea9f7d8b80",
