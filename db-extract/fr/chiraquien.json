                ],
                "senses": [
                    {
                        "sense_id": "ce9c4728-cdaf-3b55-9ec3-72d313065f61",
                        "entry_id": "dc3180e8-6988-3ae8-8a8f-cc19ec532214",
                        "glosses": [
                            "Qui se rapporte à Jacques Chirac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2855f80-a9cd-4fd3-bc79-41804d52a3d9",
                                "sense_id": "ce9c4728-cdaf-3b55-9ec3-72d313065f61",
                                "text": "Actuellement le jeu chiraqien, malgré son ineptie, a le mérite d’empêcher le glissement d’une fraction de l’électorat « autoritaire » vers le PCF."
                            },
                            {
                                "example_id": "f6641ef6-44d2-4498-b766-18d4df23c284",
                                "sense_id": "ce9c4728-cdaf-3b55-9ec3-72d313065f61",
                                "text": "Il le posa sur la pile naissante qui attendrait l’amnistie inaugurale du deuxième septennat chiraquien, et mit le cap sur la rue Popincourt."
                            },
                            {
                                "example_id": "2fe0b763-7658-452f-881d-483e306300ab",
                                "sense_id": "ce9c4728-cdaf-3b55-9ec3-72d313065f61",
                                "text": "L’élan chiraquien, déjà ralenti par les vives réactions d’une partie des gaullistes (Charles Pasqua en tête), est stoppé net lorsque le Conseil d’État, saisi par le premier ministre, Alain Juppé, rend un avis défavorable."
                            }
                        ]
                    },
                    {
                        "sense_id": "18d8a522-41b5-3f35-b5b4-e71ccc32cfb0",
                        "entry_id": "dc3180e8-6988-3ae8-8a8f-cc19ec532214",
                        "glosses": [
                            "Qui se rapporte à un partisan de Jacques Chirac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3379d125-6016-4d72-944e-2dfc2919d00e",
                                "sense_id": "18d8a522-41b5-3f35-b5b4-e71ccc32cfb0",
                                "text": "Les étudiants chiraquiens ont fêté la réélection de leur candidat."
                            }
                        ]
                    }
                ],
