                {
                    "sense_id": "0a750971-77bd-3a2e-8aed-5645f2792d64",
                    "sense_definition": "Weibliche Person, mit der jemand verheiratet ist; Ehefrau",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "weibliche_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein Kollege hat gestern seine <w>Frau</w> vom Flughafen abgeholt."
                        },
                        {
                            "text": "Er beschloss nach fünf gemeinsamen Jahren, seine Freundin zur <w>Frau</w> zu nehmen."
                        }
                    ],
                    "synonyms": [
                        "Ehefrau",
                        "Gattin",
                        "Gemahlin",
                        "Ehegattin",
                        "Ehepartnerin"
                    ],
                    "antonyms": [
