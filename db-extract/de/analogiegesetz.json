                ],
                "senses": [
                    {
                        "sense_id": "900f1977-54e3-3b32-9cd4-31e2800048b0",
                        "entry_id": "1f8cb4bb-983e-3006-9f6d-65afd797e4a6",
                        "glosses": [
                            "gesetzmäßige Anwendung der Analogie bei der Bildung sprachlicher Einheiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "740bc70e-81f4-4141-8b91-34ba7cdcef61",
                                "sense_id": "900f1977-54e3-3b32-9cd4-31e2800048b0",
                                "text": "„Und nun ein Beispiel, das zeigt, wie die Kenntnis der Analogiegesetze auch ein Problem der vergleichenden Grammatik der indogermanischen Sprachen zu lösen vermag.“"
                            },
                            {
                                "example_id": "5e1e9446-c829-4031-9ecd-b5031025427d",
                                "sense_id": "900f1977-54e3-3b32-9cd4-31e2800048b0",
                                "text": "„Die Zusammenfassung der Hypothesen zu vier beziehungsweise fünf Analogiegesetzen wurde nicht mit neuen Statistiken belegt.“"
                            },
                            {
                                "example_id": "03909272-7c3d-4066-a7cd-ca5d27149713",
                                "sense_id": "900f1977-54e3-3b32-9cd4-31e2800048b0",
                                "text": "„Solange es keine exakt formulierten Analogiegesetze gibt, sind allein Lautgesetze aussagekräftig, weil man gegen sie argumentieren kann.“"
                            },
                            {
                                "example_id": "d397f5a3-3809-4ba3-baad-cb6c428ca178",
                                "sense_id": "900f1977-54e3-3b32-9cd4-31e2800048b0",
                                "text": "„Die Erkenntnisse des Komparatismus bleiben zwar weiterhin gültig, aber sie werden jetzt um eine historische Dimension bereichert, unter anderem in der Form von Laut- und Analogiegesetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
