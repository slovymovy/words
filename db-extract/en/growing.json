                                                "sense_id": "7edcafeb-c116-3e86-8d8e-49d8dcdef81b",
                                                "text": "Wir müssen dem Wachstum der versiegelten Flächen Einhalt gebieten."
                                            },
                                            {
                                                "example_id": "8dec2ec6-a9b8-4668-93a0-2030d693a2d4",
                                                "sense_id": "7edcafeb-c116-3e86-8d8e-49d8dcdef81b",
                                                "text": "Für Deutschland wurde ein Wachstum von lediglich einem Prozent prognostiziert."
                                            },
                                            {
                                                "example_id": "26bfb38f-6142-40a1-abe6-05791cfce83c",
                                                "sense_id": "7edcafeb-c116-3e86-8d8e-49d8dcdef81b",
                                                "text": "Das Wachstum der Weltbevölkerung beschleunigt sich weiter."
