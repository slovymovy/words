                ],
                "senses": [
                    {
                        "sense_id": "9e588c72-c845-369a-b650-7b5350f68314",
                        "entry_id": "fb6d8e78-dfa2-3c72-8e3d-a22085597286",
                        "glosses": [
                            "истор. относящийся к Османской империи, османам или к их языку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f65778-d03f-4798-b90a-54de232bba15",
                                "sense_id": "9e588c72-c845-369a-b650-7b5350f68314",
                                "text": "Первый штурм османской твердыни немногочисленными и не объединенными единым знаменем славянскими силами был отбит."
                            },
                            {
                                "example_id": "16b5dbb1-0959-442e-8b9a-2ee209b3bcf6",
                                "sense_id": "9e588c72-c845-369a-b650-7b5350f68314",
                                "text": "Здесь началось освободительное восстание против многовекового османского ига."
                            }
                        ]
                    },
                    {
                        "sense_id": "94a2a62b-df99-388a-a670-49b4058b1a4f",
                        "entry_id": "fb6d8e78-dfa2-3c72-8e3d-a22085597286",
                        "glosses": [
                            "субстантивир. то же, что османский язык"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58bd1aef-e782-4601-917f-74e181001202",
                        "source_entry_id": "fb6d8e78-dfa2-3c72-8e3d-a22085597286",
                        "target_lang_word": "osmanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "osmanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b986c75b-bced-3a2e-87b1-69404a918742",
                                        "entry_id": "e67423c0-42e1-3d37-a909-5e6621b21a34",
                                        "glosses": [
                                            "die Osmanen, das Osmanische Reich betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "316b4748-a758-482e-b4de-3254c855d120",
                                                "sense_id": "b986c75b-bced-3a2e-87b1-69404a918742",
                                                "text": "Mehmed II. war ein osmanischer Sultan."
                                            },
                                            {
                                                "example_id": "a19c81f2-301b-4454-b292-3a7f931e0b87",
                                                "sense_id": "b986c75b-bced-3a2e-87b1-69404a918742",
                                                "text": "„Ich fand, der alte osmanische Titel stand ihm gut.“"
                                            },
                                            {
                                                "example_id": "50e4400e-cc51-452e-b24b-de264b2d8b17",
                                                "sense_id": "b986c75b-bced-3a2e-87b1-69404a918742",
                                                "text": "„Zudem diente ihm der Hafen als Flottenstützpunkt, und auch größere Kaperschiffe aus den unter osmanischer Oberhoheit stehenden Barbaresken in Nordafrika nutzten ihn als Versorgungsstation.“"
                                            },
                                            {
                                                "example_id": "17e112ab-9518-496a-81ef-17ffe9e2c643",
                                                "sense_id": "b986c75b-bced-3a2e-87b1-69404a918742",
                                                "text": "„Alice wohnte in einem alten Steinhaus, das noch aus osmanischer Zeit stammte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
