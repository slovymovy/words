                "senses": [
                    {
                        "sense_id": "1223f3cc-4563-3e2b-99b4-d6d066e806fd",
                        "entry_id": "5d620b54-0a95-3f58-bad7-67debb6a5bbb",
                        "glosses": [
                            "pflanzliches Leitgewebe zum Transport der Assimilate von den Blättern in andere Organe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "286dc148-def3-4646-951e-c28de024f339",
                                "sense_id": "1223f3cc-4563-3e2b-99b4-d6d066e806fd",
                                "text": "Im Phloem werden die Stoffe transportiert, die von der Pflanze bei der Photosynthese assimiliert werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3452868-d143-485a-90d2-f2c539ef541b",
                        "source_entry_id": "5d620b54-0a95-3f58-bad7-67debb6a5bbb",
                        "source_sense_id": "1223f3cc-4563-3e2b-99b4-d6d066e806fd",
                        "source_sense_description": "Biologie: pflanzliches Leitgewebe zum Transport der Assimilate von den Blättern in andere Organe",
                        "target_lang_word": "phloem",
