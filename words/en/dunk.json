{
    "word_family": [
        "dunker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1214e6e3-8733-336a-b007-e4ca5d5debea",
                    "sense_definition": "To submerge something briefly into a liquid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "submerge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I like to <w>dunk</w> my donut in my apple cider.",
                            "target_lang_translations": {
                                "zh": "我喜欢把甜甜圈<w>蘸</w>在苹果酒里吃。"
                            }
                        },
                        {
                            "text": "She decided to <w>dunk</w> the cookie into her warm milk.",
                            "target_lang_translations": {
                                "zh": "她决定把饼干<w>蘸</w>进温牛奶里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dip",
                        "immerse"
                    ],
                    "common_phrases": [
                        "dunk in"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某物短暂地浸入液体中。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蘸",
                                "target_lang_sense_clarification": "指将食物短暂浸入液体中。"
                            },
                            {
                                "target_lang_word": "浸",
                                "target_lang_sense_clarification": "指将物体放入液体中。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8598ca6b-09c1-3fb4-8c62-201746cdc6c7",
                    "sense_definition": "To force a basketball directly downward through the hoop while holding the rim.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "basketball",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The center spun quickly and <w>dunked</w> the ball with authority.",
                            "target_lang_translations": {
                                "zh": "中锋迅速转身，有力地将球<w>扣篮</w>。"
                            }
                        },
                        {
                            "text": "He jumped high to <w>dunk</w> the ball during the final seconds.",
                            "target_lang_translations": {
                                "zh": "他在最后几秒钟高高跃起，完成了一次<w>扣篮</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slam-dunk"
                    ],
                    "common_phrases": [
                        "dunk the ball"
                    ],
                    "target_lang_definitions": {
                        "zh": "在篮球运动中，抓住篮筐将球用力扣入篮中。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扣篮",
                                "target_lang_sense_clarification": "篮球运动中的动作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "216e5001-5d63-3173-9840-08cb80609313",
                    "sense_definition": "To place someone or something down in a careless or abrupt manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parents should not just <w>dunk</w> their kids in front of the TV.",
                            "target_lang_translations": {
                                "zh": "家长不应该只是把孩子<w>扔</w>在电视机前。"
                            }
                        },
                        {
                            "text": "He <w>dunked</w> his heavy bag onto the floor and walked away.",
                            "target_lang_translations": {
                                "zh": "他把沉重的包<w>扔</w>在地板上，然后走开了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dump",
                        "drop"
                    ],
                    "target_lang_definitions": {
                        "zh": "粗鲁或草率地放下某人或某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扔",
                                "target_lang_sense_clarification": "指随意或粗鲁地放置。"
                            },
                            {
                                "target_lang_word": "丢",
                                "target_lang_sense_clarification": "指不经意地放下。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "405d2b68-e3d5-399a-914e-f7cbf1561b3e",
                    "sense_definition": "To criticize or humiliate someone publicly on social media.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "criticize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The celebrity was <w>dunked</w> on by thousands of users after the controversial post.",
                            "target_lang_translations": {
                                "zh": "在那条引发争议的帖子发布后，这位名人遭到了成千上万用户的<w>嘲讽</w>。"
                            }
                        },
                        {
                            "text": "It is common for internet users to <w>dunk</w> on politicians for their mistakes.",
                            "target_lang_translations": {
                                "zh": "网民因政客的错误而对其进行<w>炮轰</w>是很常见的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "roast",
                        "mock"
                    ],
                    "common_phrases": [
                        "dunk on"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in internet and social media contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在社交媒体上公开批评或羞辱某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘲讽",
                                "target_lang_sense_clarification": "指在网上公开批评或嘲笑。"
                            },
                            {
                                "target_lang_word": "炮轰",
                                "target_lang_sense_clarification": "指严厉的公开批评。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9aca8ad8-84a3-35c0-aba1-21b76a1b099d",
                    "sense_definition": "The act of submerging something in liquid or a powerful basketball shot.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "submerge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The point guard made an easy <w>dunk</w> to win the game.",
                            "target_lang_translations": {
                                "zh": "控球后卫完成了一次轻松的<w>扣篮</w>，赢得了比赛。"
                            }
                        },
                        {
                            "text": "She gave the biscuit a quick <w>dunk</w> in her cup of milk.",
                            "target_lang_translations": {
                                "zh": "她把饼干在牛奶杯里快速<w>蘸</w>了一下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dip"
                    ],
                    "target_lang_definitions": {
                        "zh": "浸入液体的动作或强力的扣篮动作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蘸",
                                "target_lang_sense_clarification": "指浸入液体的动作。"
                            },
                            {
                                "target_lang_word": "扣篮",
                                "target_lang_sense_clarification": "指篮球中的扣篮动作。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2caac48b-f295-3a68-bcef-5c4749e56b9e",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical figure George Montagu-<w>Dunk</w> was a British statesman.",
                            "target_lang_translations": {
                                "zh": "历史人物乔治·蒙塔古-<w>邓克</w>是一位英国政治家。"
                            }
                        },
                        {
                            "text": "Many people with the name <w>Dunk</w> live in the United Kingdom.",
                            "target_lang_translations": {
                                "zh": "许多名叫<w>邓克</w>的人居住在英国。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "邓克",
                                "target_lang_sense_clarification": "作为姓氏的音译。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa9453d3-2d74-373b-b3df-133ff9119575",
                    "sense_definition": "A locality in Queensland, Australia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They spent their summer vacation visiting the beautiful region of <w>Dunk</w>.",
                            "target_lang_translations": {
                                "zh": "他们暑假去游览了美丽的<w>邓克</w>地区。"
                            }
                        },
                        {
                            "text": "The island near <w>Dunk</w> is a popular tourist destination.",
                            "target_lang_translations": {
                                "zh": "<w>邓克</w>附近的岛屿是一个热门的旅游目的地。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Refers to a specific location in Australia."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "澳大利亚昆士兰州的一个地区。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "邓克",
                                "target_lang_sense_clarification": "地名音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}