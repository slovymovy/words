                "senses": [
                    {
                        "sense_id": "defec4d0-1a77-37a6-a747-37e536f0c7e1",
                        "entry_id": "c840be11-3281-3798-8dda-27a27cc5b43c",
                        "glosses": [
                            "Griff aus Elfenbein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990987a4-aea2-4326-95bd-c24fced8e3bb",
                                "sense_id": "defec4d0-1a77-37a6-a747-37e536f0c7e1",
                                "text": "„Der alte Hawberk zündete sich, auf seinen Spazierstock mit dem Elfenbeingriff gestützt, eine exquisite Zigarre an, nachdem ich das Gegenstück höflich abgelehnt hatte, und lächelte vor sich hin.“"
                            },
                            {
                                "example_id": "7755f051-3de7-4e99-8b9f-73444b317da7",
                                "sense_id": "defec4d0-1a77-37a6-a747-37e536f0c7e1",
                                "text": "„Die Elfenbeingriffe zweier Dolche ragten deutlich sichtbar aus dem Hosenbund des Mannes.“"
                            },
                            {
                                "example_id": "22bb451e-fe3a-4d1b-8384-aec22edba01d",
                                "sense_id": "defec4d0-1a77-37a6-a747-37e536f0c7e1",
                                "text": "„Ich sehe ein etwa handgroßes Halfter und eine graue metallische Pistole mit Elfenbeingriff und bin plötzlich beruhigt.“"
                            },
                            {
                                "example_id": "009b7667-3bcd-406e-9b40-31628df19588",
                                "sense_id": "defec4d0-1a77-37a6-a747-37e536f0c7e1",
                                "text": "„In der rechten Hand hielt er eine einheimische Kopie eines Colt M1911 mit Silberradierungen und unechtem Elfenbeingriff.“"
                            },
                            {
                                "example_id": "e5283a8b-da58-4905-bc6f-db40e83e568c",
                                "sense_id": "defec4d0-1a77-37a6-a747-37e536f0c7e1",
                                "text": "„Der Pistolengriff hinter dem Abzug war durch einen Elfenbeingriff ersetzt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
