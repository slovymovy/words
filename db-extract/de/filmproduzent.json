                "senses": [
                    {
                        "sense_id": "1717458c-77eb-312a-a262-4d91a304421a",
                        "entry_id": "84cba037-2cc5-3da4-9b19-3d10d73b2634",
                        "glosses": [
                            "jemand, der die Herstellung von cineastischen Produktionen verwaltet und finanziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eafeb2e-3898-4808-b959-59c3d547407d",
                                "sense_id": "1717458c-77eb-312a-a262-4d91a304421a",
                                "text": "„Um das Geheimnis von Antikythera endlich zu lüften, schlossen sich im vergangenen Jahr Wissenschaftler aus aller Welt zum Forschungsprojekt Antikythera-Mechanismus zusammen – darunter […] der Mathematiker und Filmproduzent Tony Freeth […].“"
                            },
                            {
                                "example_id": "abfaaa12-065e-4c9b-bae4-38f661230573",
                                "sense_id": "1717458c-77eb-312a-a262-4d91a304421a",
                                "text": "„Es sind Hemden-, Nähmaschinen- und Autofabrikanten, Filmproduzenten, Fernsehintendanten, Gastwirte, Schauspieler und Kellner, aber auch Polizisten, Soldaten, Politiker, Kaufleute, Hausfrauen, Winzer und Weinhändler.“"
                            },
                            {
                                "example_id": "040655d1-c1f0-4893-b1f5-784dd3b00ca5",
                                "sense_id": "1717458c-77eb-312a-a262-4d91a304421a",
                                "text": "„Ein Filmproduzent belagert mich.“"
                            },
                            {
                                "example_id": "b0b2ad96-dbb4-4dd6-9af4-727f9ae5897e",
                                "sense_id": "1717458c-77eb-312a-a262-4d91a304421a",
                                "text": "„Es gibt zwei österreichische Filmproduzenten mit einigem Talent und Erfahrung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
