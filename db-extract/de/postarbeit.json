                ],
                "senses": [
                    {
                        "sense_id": "47290e8e-ce5a-34bc-a764-d7fb6bfa5a19",
                        "entry_id": "ffef4578-1ca6-3ede-a747-8c4bfd45af32",
                        "glosses": [
                            "dringend zu erledigende Arbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2211cc0f-aaec-4362-bdf9-af0b862e0648",
                                "sense_id": "47290e8e-ce5a-34bc-a764-d7fb6bfa5a19",
                                "text": "„Wenn es nur irgendwie machbar ist, wäre es gut, eine ‚Isolationsstunde‘ einzulegen, also noch vor Arbeitsbeginn anderer Mitarbeiter, die Postarbeit zu erledigen.“"
                            },
                            {
                                "example_id": "5f85cee4-610e-4f2e-a034-7ed54a066961",
                                "sense_id": "47290e8e-ce5a-34bc-a764-d7fb6bfa5a19",
                                "text": "„Postarbeit wird oft um 4 Uhr nachmittags ausgegeben, mit der Weisung, dass sie um 7 Uhr früh geliefert werden muß.“"
                            },
                            {
                                "example_id": "f86c5fc6-4794-497b-8ff5-76ad746a5916",
                                "sense_id": "47290e8e-ce5a-34bc-a764-d7fb6bfa5a19",
                                "text": "„Als Postarbeiten gelten große Arbeiten, welche innerhalb 24 Stunden geliefert werden müssen.“"
                            },
                            {
                                "example_id": "ad1abd1d-402b-4766-b4ce-1980f060c350",
                                "sense_id": "47290e8e-ce5a-34bc-a764-d7fb6bfa5a19",
                                "text": "„Solche Postarbeiten fallen öfter an, wenn etwas ‚gestern fertig sein soll‘, wie er dann sagt.“"
                            },
                            {
                                "example_id": "f5cc8f70-7500-4572-ac8a-011995ed9bed",
                                "sense_id": "47290e8e-ce5a-34bc-a764-d7fb6bfa5a19",
                                "text": "„Die Polizei hat Postarbeit geleistet.“"
                            },
                            {
                                "example_id": "b2dc0055-2578-4b90-a1b6-d9af03d4e137",
                                "sense_id": "47290e8e-ce5a-34bc-a764-d7fb6bfa5a19",
                                "text": "„Das leider vielfach beim Chorgebete eingerissene Unwesen herrschte hier vornämlich — die Schnelligkeit; man nannte ein solches Gebaren früher Postarbeit, jetzt könnte man selbes aber als Dampf- oder Electrizitäts-Musik, Gesangs-, oder Breviergebets-Telegraphen-Arbeit registriren..“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1046a905-4a28-3d10-9d5f-ada7d915d06b",
                        "entry_id": "ffef4578-1ca6-3ede-a747-8c4bfd45af32",
                        "glosses": [
                            "im Zusammenhang mit der Post stehende Arbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ba4811-1889-43f7-9899-7fff1564885a",
                                "sense_id": "1046a905-4a28-3d10-9d5f-ada7d915d06b",
                                "text": "„So entleeren Taxifahrer Briefkästen, transportieren Speditionen Post oder wickeln Einzelhändler Postarbeiten ab.“"
                            },
                            {
                                "example_id": "14c62322-b40e-4b44-9163-2629ee78e5dd",
                                "sense_id": "1046a905-4a28-3d10-9d5f-ada7d915d06b",
                                "text": "„Doch diese böten nur eingeschränkte Leistungen: Die Mitarbeiter würden nur für zwei Stunden Postarbeit am Tag bezahlt, sie seien unzureichend qualifiziert und dürften keine Finanzgeschäfte betreiben.“"
                            },
                            {
                                "example_id": "f6a16714-c121-409b-be77-ad7de2ac1887",
                                "sense_id": "1046a905-4a28-3d10-9d5f-ada7d915d06b",
                                "text": "„Barbara Hauser, Angestellte auf der Gemeinde, muss die Postarbeit in ihren täglichen Beruf integrieren.“"
                            },
                            {
                                "example_id": "768c0132-17a7-4e5a-8f5b-48d18ce819e1",
                                "sense_id": "1046a905-4a28-3d10-9d5f-ada7d915d06b",
                                "text": "„In Folge davon vereinfachte sich allerdings die Postarbeit bedeutend.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
