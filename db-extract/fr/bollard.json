        "fr-extract.jsonl": [
            {
                "entry_id": "222a25e4-39f8-3ce8-9dab-2cd7482d4c2a",
                "word": "bollard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f2139f86-df6f-4f0f-aa7d-17c0d5ed2dd8",
                        "entry_id": "222a25e4-39f8-3ce8-9dab-2cd7482d4c2a",
                        "tags": [
                            "plural"
                        ],
                        "form": "bollards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
                        "entry_id": "222a25e4-39f8-3ce8-9dab-2cd7482d4c2a",
                        "glosses": [
                            "Bitte d’amarrage, élément fixe situé sur le quai pour amarrer un bateau dans les ports."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f358f9-3b9a-4eea-8cb8-e50eb9cc366d",
                                "sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
                                "text": "Le câble peut ensuite être assujetti à un bollard d’amarrage."
                            },
                            {
                                "example_id": "3f04b1ed-2674-4355-bd61-9c609f5d259a",
                                "sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
                                "text": "L’une pilote tandis que l’autre accroche prestement le cordage au bollard qui sert à tenir le bateau pendant l’éclusée."
                            },
                            {
                                "example_id": "c123489b-5338-4551-9bcb-0dda02652e98",
                                "sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
                                "text": "Le sas comporte, dans chacune de ses parois latérales, six rainures verticales pour bollards flottants, servant à l’amarrage des bateaux. Ces bollards sont fixés sur un cylindre métallique qui coulisse à l’intérieur des rainures en suivant le niveau de l’eau dans le sas."
                            },
                            {
                                "example_id": "9444e952-e60b-4373-9a98-677232a5f259",
                                "sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
                                "text": "Elliott coupa le moteur, sauta à terre, un cordage en main qu’il arrima autour du bollard."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e1cdcc3-617a-3c96-a075-d37c7e593179",
                        "entry_id": "222a25e4-39f8-3ce8-9dab-2cd7482d4c2a",
                        "glosses": [
                            "Élément physique marquant la séparation d’une zone piétonnière d'une voie routière. Dans ce sens, on dit aussi borne de protection, borne d’interdiction ou potelet."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42ee388e-8868-41ce-a0fb-1b7509a4de5f",
                        "source_entry_id": "222a25e4-39f8-3ce8-9dab-2cd7482d4c2a",
                        "source_sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
                        "target_lang_word": "Poller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Poller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e7929cf-eab4-3c8f-8fd2-7164314647b3",
                                        "entry_id": "af45ea08-8168-3705-96d1-fa682a433984",
                                        "glosses": [
                                            "kurzer Pfahl zum Festmachen eines Schiffes"
                                        ],
                                        "tags": [
                                            "Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21076fc8-096d-4d6d-a419-be9e99d76da4",
                                                "sense_id": "7e7929cf-eab4-3c8f-8fd2-7164314647b3",
                                                "text": "Der Seemann befestigt das Tauwerk am Poller."
                                            },
                                            {
                                                "example_id": "b96b9351-43c8-4087-b82d-db5eec8a09bc",
                                                "sense_id": "7e7929cf-eab4-3c8f-8fd2-7164314647b3",
                                                "text": "„Er zieht und zerrt, um das jetzt straffere Seil an einem Poller festzumachen.“"
                                            },
                                            {
                                                "example_id": "dfaf6884-75c8-4d7f-adbe-a26098f9a3c4",
                                                "sense_id": "7e7929cf-eab4-3c8f-8fd2-7164314647b3",
                                                "text": "„Um den Nachtclub zu erreichen, mußte sie über dicke, an den Pollern befestigte Taue steigen, an denen sich Kleid un Haare verfingen.“"
                                            },
                                            {
                                                "example_id": "44c480ee-2da4-4e7b-8185-9d54edd84146",
                                                "sense_id": "7e7929cf-eab4-3c8f-8fd2-7164314647b3",
                                                "text": "„Er trat mit dem Tau aufs Dock und warf es über einen Poller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21dddd83-92b9-3c9d-b83f-dc1b23d289fc",
                                        "entry_id": "af45ea08-8168-3705-96d1-fa682a433984",
                                        "glosses": [
                                            "kleiner Pfeiler mit dem Zweck, einen Bereich für den Verkehr zu sperren"
                                        ],
                                        "tags": [
                                            "Straßenverkehr"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba49fabd-30ea-4460-8c80-03afa8cb7838",
                                                "sense_id": "21dddd83-92b9-3c9d-b83f-dc1b23d289fc",
                                                "text": "Der Fahrer übersah den Poller beim Ausparken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "493954b5-9712-4af4-933e-69112397932a",
                        "source_entry_id": "222a25e4-39f8-3ce8-9dab-2cd7482d4c2a",
                        "source_sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
