                        "glosses": [
                            "Petit de la marmotte."
                        ],
                        "tags": [
                            "Glirologie"
                        ],
                        "examples": [
                            {
                                "example_id": "093ede5f-104a-4748-b873-53e7ce85838e",
                                "sense_id": "f873f929-4f32-357a-97f8-2511aafb47d1",
                                "text": "Les marmottons sont plus insouciants que les adultes. De ce fait, ils sont souvent la cible de l’aigle royal qui se nourrit en majorité de ce rongeur pendant l’été."
                            },
                            {
                                "example_id": "672cbddc-0764-4375-9590-090310b979ad",
                                "sense_id": "f873f929-4f32-357a-97f8-2511aafb47d1",
                                "text": "Pourtant Kamir ne toucha pas le marmotton. Il dévia son vol au dernier moment et atterrit un peu brutalement juste à côté. Le marmotton qui n’avait pas vu l’aigle arriver, ni entendu de cri d’alarme, sauta en l’air de surprise et s’enfuit affolé dans le premier trou qu’il trouva."
                            }
                        ]
                    }
