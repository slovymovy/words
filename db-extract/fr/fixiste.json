                            {
                                "example_id": "5d620bbd-e425-41dc-bc70-ed8a308ec98c",
                                "sense_id": "e78ba534-285a-33ac-9734-87a188f511c4",
                                "text": "Cuvier, qui était fixiste, […] introduisit pour la première fois la proposition d'un critérium."
                            },
                            {
                                "example_id": "1e22e68c-8812-43e2-8f4a-8a19caa6cc36",
                                "sense_id": "e78ba534-285a-33ac-9734-87a188f511c4",
                                "text": "En 1968, le géophysicien français Xavier le Pichon, auparavant défenseur des théories fixistes, propose le premier modèle global quantitatif du mouvement des plaques tectoniques."
                            }
