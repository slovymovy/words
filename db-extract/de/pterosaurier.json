                                    {
                                        "sense_id": "b38cd07a-4d64-386e-a807-85795f0f72fd",
                                        "entry_id": "4ae1e25e-8936-37d6-adbf-fa7f3f471348",
                                        "glosses": [
                                            "Any flying reptile, of the extinct order †Pterosauria, including the pterodactyls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91367f16-b6fc-4a58-a4eb-9e56fd39e57b",
                                                "sense_id": "b38cd07a-4d64-386e-a807-85795f0f72fd",
                                                "text": "Batsquatch, pterosaurs and the River Man. She had three weeks in Washington State tracking down the local legends. There was nothing ordinary about her job as the biologist on the television show Cryptid or Hoax?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "559ef734-7be2-4da7-a4df-f144020271ac",
                        "source_entry_id": "d562044f-9267-3a52-b73f-b22513cb67e1",
                        "source_sense_id": "5daed9ac-46f3-30b8-bf1c-cfe74a85eeff",
                        "target_lang_word": "ptérosaure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ptérosaure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "279bd9fe-18c8-3367-92df-3a394215ff50",
                                        "entry_id": "29c40bce-1c00-3e07-bcb1-095ca06c15bb",
                                        "glosses": [
                                            "Ordre de reptiles volants du mésozoïque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23aca90d-cf7e-4395-9b68-e8199af91237",
                                                "sense_id": "279bd9fe-18c8-3367-92df-3a394215ff50",
                                                "text": "Aux côtés des nombreux restes de poissons littoraux, les tétrapodes sont représentés par des chéloniens, crocodiliens, ophidiens, plésiosaures, ptérosaures et dinosaures."
                                            },
                                            {
                                                "example_id": "1edc672a-1977-4f64-9543-c22d84a44623",
                                                "sense_id": "279bd9fe-18c8-3367-92df-3a394215ff50",
                                                "text": "Selon toute vraisemblance, ce ptérosaure disparu voici 65,5 millions d’années passait la plupart de son temps dans les airs, planant gracieusement au gré des ascendances thermiques."
                                            },
                                            {
                                                "example_id": "9c5c81bb-5f1f-487f-9b3f-028daf069b48",
                                                "sense_id": "279bd9fe-18c8-3367-92df-3a394215ff50",
                                                "text": "La clé de l'énigme semble résider dans un assemblage complexe de rayons à l'intérieur de ces vertèbres qui, bien qu'ultralégères, supportaient le poids de la tête et du cou du ptérosaure."
                                            },
                                            {
                                                "example_id": "53e09fd2-6f3d-4d01-8326-5fd8e60a4b85",
                                                "sense_id": "279bd9fe-18c8-3367-92df-3a394215ff50",
                                                "text": "Des ossements fossilisés mis au jour en 2009 dans le désert d’Atacama, dans le nord du Chili, ont été associés à une espèce inconnue de ptérosaures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
