                                "target_lang_sense_clarification": "an injury"
                            },
                            {
                                "target_lang_word": "to gain",
                                "target_lang_sense_clarification": "an impression or feeling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86a60548-880a-357a-8f34-ded41b641d1a",
                    "sense_definition": "naar wens of voldoende zijn (vrijwel altijd in negatieve zin gebruikt om aan te geven dat iets matig of krap is)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kwaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kwaliteit van het eten in dat restaurant <w>houdt niet over</w>.",
                            "target_lang_translations": {
                                "en": "The quality of the food in that restaurant <w>is nothing to write home about</w>."
                            }
                        },
                        {
                            "text": "Zijn resultaten op school <w>houden niet over</w> dit jaar.",
                            "target_lang_translations": {
                                "en": "His results at school <w>are nothing special</w> this year."
                            }
                        }
                    ],
                    "common_phrases": [
                        "niet overhouden"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vrijwel altijd met 'niet'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to be satisfactory or sufficient (almost always used negatively to indicate something is mediocre or tight)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be nothing to write home about",
                                "target_lang_sense_clarification": "mediocre quality"
