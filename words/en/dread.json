{
    "word_family": [
        "dreadful",
        "dreadfully",
        "dreadfulness",
        "dreaded",
        "dreadlocks"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc69e44a-2516-3cc7-b2b4-d6ecd7a7d248",
                    "sense_definition": "To anticipate something with great fear or anxiety.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fearful anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>dreading</w> the results of the medical test because it could change my life.",
                            "target_lang_translations": {
                                "ru": "Я <w>с ужасом жду</w> результатов медицинского теста, потому что они могут изменить мою жизнь."
                            }
                        },
                        {
                            "text": "Many students <w>dread</w> the thought of public speaking in front of a large audience.",
                            "target_lang_translations": {
                                "ru": "Многие студенты <w>страшатся</w> мысли о публичном выступлении перед большой аудиторией."
                            }
                        }
                    ],
                    "synonyms": [
                        "fear",
                        "apprehend"
                    ],
                    "antonyms": [
                        "anticipate",
                        "welcome"
                    ],
                    "common_phrases": [
                        "dread the thought",
                        "dread to think"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ожидать чего-либо с большим страхом или тревогой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страшиться",
                                "target_lang_sense_clarification": "ожидать с сильным страхом"
                            },
                            {
                                "target_lang_word": "с ужасом ждать",
                                "target_lang_sense_clarification": "ожидать с содроганием"
                            },
                            {
                                "target_lang_word": "опасаться",
                                "target_lang_sense_clarification": "испытывать тревогу перед событием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2aeba2d7-df1f-33d8-b5e8-162cf3d67014",
                    "sense_definition": "To fear something or someone greatly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fearful anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors began to <w>dread</w> the storm as the waves grew taller than the ship.",
                            "target_lang_translations": {
                                "ru": "Моряки начали <w>бояться</w> шторма, когда волны стали выше корабля."
                            }
                        },
                        {
                            "text": "He used to <w>dread</w> his boss, but now they have a much better relationship.",
                            "target_lang_translations": {
                                "ru": "Раньше он <w>трепетал</w> перед своим боссом, но теперь у них гораздо лучшие отношения."
                            }
                        }
                    ],
                    "synonyms": [
                        "revere",
                        "terrorize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно бояться чего-либо или кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бояться",
                                "target_lang_sense_clarification": "испытывать страх"
                            },
                            {
                                "target_lang_word": "трепетать",
                                "target_lang_sense_clarification": "сильно бояться, дрожать от страха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45feee9c-ff0a-37c7-9310-dee1aba5f3fa",
                    "sense_definition": "To style hair into dreadlocks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hair styling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>dread</w> her hair after years of keeping it in a natural afro.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>заплести дреды</w> после того, как много лет носила натуральное афро."
                            }
                        },
                        {
                            "text": "It takes several hours to properly <w>dread</w> long hair for the first time.",
                            "target_lang_translations": {
                                "ru": "Требуется несколько часов, чтобы правильно <w>заплести</w> длинные волосы в первый раз."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заплетать волосы в дреды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плести дреды",
                                "target_lang_sense_clarification": "делать прическу"
                            },
                            {
                                "target_lang_word": "заплетать",
                                "target_lang_sense_clarification": "о волосах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e73b8e52-6aa0-3fca-a8ab-040392767267",
                    "sense_definition": "Great fear or anxiety about something that is going to happen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The upcoming exam is filling the entire classroom with a sense of <w>dread</w>.",
                            "target_lang_translations": {
                                "ru": "Предстоящий экзамен наполняет весь класс чувством <w>ужаса</w>."
                            }
                        },
                        {
                            "text": "She felt a cold <w>dread</w> in her chest when she realized she had lost her keys.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала холодный <w>трепет</w> в груди, когда поняла, что потеряла ключи."
                            }
                        }
                    ],
                    "synonyms": [
                        "apprehension",
                        "trepidation",
                        "fear"
                    ],
                    "antonyms": [
                        "confidence",
                        "calm"
                    ],
                    "common_phrases": [
                        "sense of dread",
                        "filled with dread",
                        "cold dread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный страх или тревога по поводу того, что должно произойти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужас",
                                "target_lang_sense_clarification": "сильное чувство страха"
                            },
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "сильное волнение и страх"
                            },
                            {
                                "target_lang_word": "боязнь",
                                "target_lang_sense_clarification": "беспокойство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d98a57a9-aed5-3783-b0c0-83ad4d4c376e",
                    "sense_definition": "A shortened form of the word <w>dreadlock</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years growing out his <w>dreads</w> until they reached his waist.",
                            "target_lang_translations": {
                                "ru": "Он годами отращивал свои <w>дреды</w>, пока они не достигли талии."
                            }
                        },
                        {
                            "text": "She decided to cut off her <w>dreads</w> and try a shorter hairstyle.",
                            "target_lang_translations": {
                                "ru": "Она решила состричь свои <w>дреды</w> и попробовать более короткую прическу."
                            }
                        }
                    ],
                    "synonyms": [
                        "dreadlocks",
                        "locks"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма слова «dreadlock» (дреды)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дреды",
                                "target_lang_sense_clarification": "прическа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b15d4e4-6264-309b-be9b-ef9e016a339a",
                    "sense_definition": "A feeling of deep respect mixed with fear; awe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient people looked upon the volcano with a mixture of <w>dread</w> and wonder.",
                            "target_lang_translations": {
                                "ru": "Древние люди смотрели на вулкан со смесью <w>трепета</w> и изумления."
                            }
                        },
                        {
                            "text": "The king's presence inspired <w>dread</w> among his subjects.",
                            "target_lang_translations": {
                                "ru": "Присутствие короля внушало <w>ужас</w> его подданным."
                            }
                        }
                    ],
                    "synonyms": [
                        "awe",
                        "reverence"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "More common in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство глубокого уважения, смешанное со страхом; благоговейный трепет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "благоговейный страх"
                            },
                            {
                                "target_lang_word": "священный ужас",
                                "target_lang_sense_clarification": "глубокое почтение и страх"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b2f6428-81c0-3dbe-af43-eedab418025a",
                    "sense_definition": "Causing great fear; extremely terrible or dreaded.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers marched in silence down the <w>dread</w> path toward the enemy camp.",
                            "target_lang_translations": {
                                "ru": "Солдаты молча шли по <w>страшному</w> пути к вражескому лагерю."
                            }
                        },
                        {
                            "text": "They spoke in whispers about the <w>dread</w> monster that lived in the cave.",
                            "target_lang_translations": {
                                "ru": "Они шепотом говорили об <w>ужасном</w> монстре, жившем в пещере."
                            }
                        }
                    ],
                    "synonyms": [
                        "terrible",
                        "frightful",
                        "dire"
                    ],
                    "antonyms": [
                        "pleasant",
                        "wonderful"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сильный страх; ужасный или пугающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "вызывающий ужас"
                            },
                            {
                                "target_lang_word": "страшный",
                                "target_lang_sense_clarification": "пугающий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a9fb4d3-9db6-3f6e-9b42-e32db84251cf",
                    "sense_definition": "Inspiring awe or held in fearful respect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document was addressed to their most high and <w>dread</w> sovereign.",
                            "target_lang_translations": {
                                "ru": "Документ был адресован их высочайшему и <w>грозному</w> государю."
                            }
                        },
                        {
                            "text": "He stood before the <w>dread</w> tribunal to answer for his crimes.",
                            "target_lang_translations": {
                                "ru": "Он предстал перед <w>грозным</w> трибуналом, чтобы ответить за свои преступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "venerable",
                        "awesome"
                    ],
                    "common_phrases": [
                        "dread sovereign"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in historical or formal titles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внушающий благоговение или вызывающий почтительный страх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грозный",
                                "target_lang_sense_clarification": "внушающий страх и уважение"
                            },
                            {
                                "target_lang_word": "державный",
                                "target_lang_sense_clarification": "о монархе, внушающем трепет"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}