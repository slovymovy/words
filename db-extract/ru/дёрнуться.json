                        "entry_id": "966d1989-dd67-31da-8abc-fd36071a53ed",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "дёрнувшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4c29b5d-5b95-33ce-bfd5-ded229eafd08",
                        "entry_id": "966d1989-dd67-31da-8abc-fd36071a53ed",
                        "glosses": [
                            "сделать резкое движение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88accc93-7b27-4084-b7d8-007bf44bf4e6",
                                "sense_id": "e4c29b5d-5b95-33ce-bfd5-ded229eafd08",
                                "text": "Славик дёрнулся, как от электроразряда. Заметила ли она ручку?! — Поехали, — сказала Катерина. Саврасов нервно сглотнул и тронулся с места."
                            }
                        ]
                    },
                    {
                        "sense_id": "686a58b3-d89b-314a-b9c2-2b68a2083c31",
                        "entry_id": "966d1989-dd67-31da-8abc-fd36071a53ed",
                        "glosses": [
                            "выказать раздражение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4da322ba-00a6-44b2-a83d-dbedefa7ab81",
                                "sense_id": "686a58b3-d89b-314a-b9c2-2b68a2083c31",
                                "text": "«Что ещё?» — нервно дёрнувшись, спросил Римский"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0087abbd-5c8c-4b62-9624-bdbe01f4bb3b",
                        "source_entry_id": "966d1989-dd67-31da-8abc-fd36071a53ed",
                        "target_lang_word": "twitch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twitch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df1bcd1c-f4e7-3343-9e80-4223b4e47746",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "A brief, small (sometimes involuntary) movement out of place and then back again; a spasm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16089c3d-8869-40f1-aec9-4baf130f8fa4",
                                                "sense_id": "df1bcd1c-f4e7-3343-9e80-4223b4e47746",
                                                "text": "I saw a little twitch in the man's face, and knew he was lying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3db2b1aa-1a0f-3f48-aab4-b3b8336bd24b",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "Action of spotting or seeking out a bird, especially a rare one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa5ab924-81dd-30c2-ab62-a087b5d21529",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "A stick with a hole in one end through which passes a loop, which can be drawn tightly over the upper lip or an ear of a horse and twisted to keep the animal quiet during minor surgery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d75655b-f74b-4af1-ad50-d0b11ef3212f",
                                                "sense_id": "fa5ab924-81dd-30c2-ab62-a087b5d21529",
                                                "text": "THE TWITCH is a short stick of strong ash, about the size of a mopstick, with a hole pierced near the end, through which is passed a piece of strong but small cord, and tied in a loop large enough to admit the open hand freely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcea4e96-4246-3cb7-8e68-add358c0097c",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "A brief, contractile response of a skeletal muscle elicited by a single maximal volley of impulses in the neurons supplying it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5da1e86-88c7-33a3-a8f7-1eb74e8eef40",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "The sudden narrowing almost to nothing of a vein of ore."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5d76b6f-105d-3dce-b133-39374bfde120",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "A trip taken in order to observe a rare bird."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
