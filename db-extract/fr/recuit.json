                        "form": "recuits"
                    },
                    {
                        "form_id": "d1b5d042-2b5e-49ca-aedc-d03053ccc82c",
                        "entry_id": "b352bd9f-c50d-3bcc-9561-89ddd3041cc4",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "recuite"
                    },
                    {
                        "form_id": "44b8aa49-5670-48b8-bbf6-a12ccfd678bf",
                        "entry_id": "b352bd9f-c50d-3bcc-9561-89ddd3041cc4",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "recuites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "935ce565-4452-368a-9dc4-28123ca4d53b",
                        "entry_id": "b352bd9f-c50d-3bcc-9561-89ddd3041cc4",
                        "glosses": [
                            "Qui est extrêmement cuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e6deaf-0789-47d2-95f8-d6dcb8da49d4",
                                "sense_id": "935ce565-4452-368a-9dc4-28123ca4d53b",
                                "text": "Cela est cuit et recuit."
                            }
                        ]
                    },
                    {
                        "sense_id": "1320904c-a28b-3c46-a9e8-0f7af99e2fbb",
                        "entry_id": "b352bd9f-c50d-3bcc-9561-89ddd3041cc4",
                        "glosses": [
                            "Qui a l'apparence de ce qui a été recuit."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "398b9f83-ea30-46a9-b048-b9781c1b1f29",
                                "sense_id": "1320904c-a28b-3c46-a9e8-0f7af99e2fbb",
                                "text": "Il était maigre et de teint jaune, recuit de misère avec des yeux de loup ; des os de sa forte charpente faisaient saillie sous sa capote."
                            },
                            {
                                "example_id": "82151584-ade8-4313-b641-7406ab36e0d3",
                                "sense_id": "1320904c-a28b-3c46-a9e8-0f7af99e2fbb",
                                "text": "Ses doigts noueux étaient encore rouges de terre et lui-même, avec sa culotte de bure, sa chemise brune, sa peau recuite, il semblait à peine détaché d'un lit d'argile ferrugineuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "0dbf624b-882a-3da8-aa60-0f960db00bc1",
                        "entry_id": "b352bd9f-c50d-3bcc-9561-89ddd3041cc4",
                        "glosses": [
                            "Épaissi, échauffé, en parlant des humeurs du corps humain."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c566fca2-8d46-4545-856b-9c681dee2bde",
                                "sense_id": "0dbf624b-882a-3da8-aa60-0f960db00bc1",
                                "text": "Des humeurs recuites."
                            }
                        ]
                    },
                    {
                        "sense_id": "c080be88-d471-3ad7-9e47-221be2f85225",
                        "entry_id": "b352bd9f-c50d-3bcc-9561-89ddd3041cc4",
                        "glosses": [
                            "Qualifie un ressentiment ancien et tenace."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6a6d0426-349e-4bd1-bec8-aaecf83004f2",
                                "sense_id": "c080be88-d471-3ad7-9e47-221be2f85225",
                                "text": "« Le bon vieux drame réclame la permanence, la proximité ; je dirais même une certaine familiarité avec l’ennemi, dans un décor témoin. C’était possible sous Homère, pour des rois qui se disputaient des royaumes grands comme Monaco ; ça ne l’est plus aujourd’hui qu’à la campagne, où les dimensions restent les mêmes. Dans le genre bien recuit, ici nous sommes servis. »"
                            },
                            {
                                "example_id": "e4b48da3-2a40-4447-985f-7d5d397cb57c",
                                "sense_id": "c080be88-d471-3ad7-9e47-221be2f85225",
                                "text": "Certaines haines sont tenaces, recuites, d’autres au contraire varient, changeant en fonction de tel ou tel geste."
                            }
                        ]
                    },
                    {
                        "sense_id": "34f23536-bcb6-3a00-afef-0ea49159d864",
                        "entry_id": "b352bd9f-c50d-3bcc-9561-89ddd3041cc4",
                        "glosses": [
                            "Endurci, dur-à-cuire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee16c040-f171-4a53-8f7d-d3b5cad751d8",
                                "sense_id": "34f23536-bcb6-3a00-afef-0ea49159d864",
                                "text": "Instinctivement, on sentait en lui le soldat noir, à l’âme recuite, sur l’endurance ou la bonhomie duquel il ne fallait pas compter."
                            },
                            {
                                "example_id": "4108ace4-8c9a-4796-b2bf-37e563a68b64",
                                "sense_id": "34f23536-bcb6-3a00-afef-0ea49159d864",
                                "text": "Ils affluèrent, bien sûr, mais d’autres vinrent, et plus inattendus : les alpinistes.\nLes vrais, les purs, les recuits."
                            }
                        ]
                    },
                    {
                        "sense_id": "63b4854b-2503-32ff-aabc-de7e90d789af",
                        "entry_id": "b352bd9f-c50d-3bcc-9561-89ddd3041cc4",
                        "glosses": [
                            "Qui a subi l’opération du recuit."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "f0e28659-4eff-477b-9059-d35746f9eba0",
                                "sense_id": "63b4854b-2503-32ff-aabc-de7e90d789af",
                                "text": "Le fil a été assez mal recuit."
                            }
                        ]
                    },
                    {
                        "sense_id": "d82d06b5-a876-3805-874e-21535e16c8da",
                        "entry_id": "b352bd9f-c50d-3bcc-9561-89ddd3041cc4",
                        "glosses": [
                            "Qui a subi l’opération du recuit.",
                            "Qualifie une catégorie de tuyau de cuivre pouvant être cintré à la main, plus souple que le cuivre écroui qui, lui, n'est pas cintrable tel quel."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "2b388874-9785-4ace-baff-af64c71fe92b",
                                "sense_id": "d82d06b5-a876-3805-874e-21535e16c8da",
                                "text": "Il existe deux types de tuyaux de cuivre : le cuivre recuit : il se présente sous la forme de couronne. Celui- peut être courbé à froid, …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79a04932-4e12-4fa1-b856-2a1d0485ff68",
                        "source_entry_id": "b352bd9f-c50d-3bcc-9561-89ddd3041cc4",
