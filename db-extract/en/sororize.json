                        ]
                    },
                    {
                        "translation_id": "d38fa711-89cb-4dd0-a6a6-a56c7eea5765",
                        "source_entry_id": "ecc305df-8be2-3ef4-9f22-c7f178b2062a",
                        "source_sense_id": "2ae97140-320e-3b40-be88-2680e4a51a9c",
                        "source_sense_description": "To hold fellowship like sisters",
                        "target_lang_word": "sororisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sororisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41394497-382a-3daf-932e-e8877bba4410",
                                        "entry_id": "5a928f01-a898-3db4-ad32-7ee883bfe9fe",
                                        "glosses": [
                                            "(mit jemandem) schwesterlich umgehen, schwesterlich Kontakt pflegen; (mit jemandem) schwesterlich vertraut werden"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c047bad2-2563-4f2d-b4dd-12f05bbe26f5",
                                                "sense_id": "41394497-382a-3daf-932e-e8877bba4410",
                                                "text": "„Die Partikularität dieser miteinander sympathisierenden, sororisierenden Damen ist denn auch von den Anfängen der Bewegung zu Beginn der 50er Jahre[…]“"
                                            },
                                            {
                                                "example_id": "3c1beaab-d7fd-4dda-a6e9-03f4a2f4c281",
                                                "sense_id": "41394497-382a-3daf-932e-e8877bba4410",
                                                "text": "„Denn das ist ja das nächste Problem: Ich will nicht mit jeder Frau, die in meinem beruflichen Alltag auftaucht, wahllos fraternisieren - oder in diesem Kontext sollte ich wohl eher sagen: sororisieren, nur weil sie eine Frau ist.“"
                                            },
                                            {
                                                "example_id": "e0658b14-a02e-4c83-bce4-c01a807a31a3",
                                                "sense_id": "41394497-382a-3daf-932e-e8877bba4410",
                                                "text": "„Fraternisierungstendenzen blocken wir ab, schließlich sind wir ja schon mit euch sororisiert.“"
                                            },
                                            {
                                                "example_id": "58e0094a-8dd9-4150-b756-3f6bb60085bc",
                                                "sense_id": "41394497-382a-3daf-932e-e8877bba4410",
                                                "text": "„Habermas will die Begründung der Solidarität deswegen auf die Gegenseitigkeit der ‚verschwisterten Genossen‘, der sororisierten Genossen also, beschränken, weil für ihn Solidarität sonst mit Gefolgschaft und Disziplin verknüpft wäre, wofür es ja in der Tat in der Geschichte der Arbeiterbewegung und des Staatssozialismus hinreichend historische Belege gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15e88930-5902-4b13-8f63-40e1259a343d",
                        "source_entry_id": "ecc305df-8be2-3ef4-9f22-c7f178b2062a",
                        "source_sense_id": "2ae97140-320e-3b40-be88-2680e4a51a9c",
                        "source_sense_description": "To hold fellowship like sisters",
                        "target_lang_word": "verschwistern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschwistern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "198106c3-3e40-3d18-b3b5-56740b5f13e0",
                                        "entry_id": "7680df38-6e36-3f91-9516-694e6d98dfcc",
                                        "glosses": [
                                            "Geschwister sein"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e4f9899-532a-40ab-a512-9ccfda672fbf",
                                                "sense_id": "198106c3-3e40-3d18-b3b5-56740b5f13e0",
                                                "text": "„Zwei Teilnehmerinnen waren miteinander verschwistert; eine Teilnehmerin war mit ihrer vierjährigen Enkeltochter da, um die sie sich wegen der Berufstätigkeit der Eltern auch sonst kümmert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6388e04e-2738-3dfb-8367-838bb1b828aa",
                                        "entry_id": "7680df38-6e36-3f91-9516-694e6d98dfcc",
                                        "glosses": [
                                            "eng (miteinander) verbinden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd4aa338-4cc9-42d5-b794-e6620fd4f1b6",
                                                "sense_id": "6388e04e-2738-3dfb-8367-838bb1b828aa",
                                                "text": "„Einer Erkenntniss zum Siege verhelfen heisst oft nur: sie so mit der Dummheit verschwistern, dass das Schwergewicht der letzteren auch den Sieg für die erstere erzwingt.“"
                                            },
                                            {
                                                "example_id": "f8c3e224-2b6e-4096-af47-76d639172575",
                                                "sense_id": "6388e04e-2738-3dfb-8367-838bb1b828aa",
                                                "text": "„Der sittliche Reichtum ist nah verschwistert mit dem geldlichen; das war ihm wohlbekannt, und es Iäßt sich leicht erkennen, warum es so ist.“"
                                            },
                                            {
                                                "example_id": "b22f5481-287c-48bc-9e5c-3aa969d3e23f",
                                                "sense_id": "6388e04e-2738-3dfb-8367-838bb1b828aa",
                                                "text": "„Der völlig humorlose Voss wußte nicht, was alle genialen Schöpfer wußten: daß man bei Alltagsschilderungen Humor und Pathos verschwistern müsse.“"
                                            },
                                            {
                                                "example_id": "1948519f-e5de-4228-bf12-a8e6e3074b7f",
                                                "sense_id": "6388e04e-2738-3dfb-8367-838bb1b828aa",
                                                "text": "„Das Vertrauen in die Vernunft, das jahrhundertelang mit den sozialen Utopien verschwistert war, verliert an Kraft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e9a59392-6276-3e17-b05a-e7724e0829d1",
                                        "entry_id": "7680df38-6e36-3f91-9516-694e6d98dfcc",
                                        "glosses": [
                                            "sich als/wie Geschwister verbinden; sich mit etwas eng verbinden"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41e863af-bd37-4e99-a661-32faabc6cfe0",
                                                "sense_id": "e9a59392-6276-3e17-b05a-e7724e0829d1",
                                                "text": "„Rolf verschwistert sich nicht mit der Frau.“"
                                            },
                                            {
                                                "example_id": "166b6ead-a2a7-4898-b721-4325738cd56b",
                                                "sense_id": "e9a59392-6276-3e17-b05a-e7724e0829d1",
                                                "text": "„»Rachbegierde« kann sich nach Kant auch als »Rechtsbegierde« äußern und sich dabei mit der Vernunft verschwistern, und das ist bei Kohlhaas anfangs der Fall, insofern er mehrfach auf legalem Weg versucht, sein Recht zu bekommen, und erst als alles vergeblich ist, zur kriegerischen Fehde und Mordbrennerei übergeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
