        "fr-extract.jsonl": [
            {
                "entry_id": "7a693b80-fa4e-3f1e-9b11-2cb8aa834bf3",
                "word": "involontairement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9e528f08-3dd7-3dd2-9d50-48cf82bd402f",
                        "entry_id": "7a693b80-fa4e-3f1e-9b11-2cb8aa834bf3",
                        "glosses": [
                            "Sans le vouloir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b46d510-27b0-43eb-b7b9-3676a89a8f8e",
                                "sense_id": "9e528f08-3dd7-3dd2-9d50-48cf82bd402f",
                                "text": "Il laissa Rébecca en la société de la vieille femme, à qui elle avait été ainsi involontairement imposée."
                            },
                            {
                                "example_id": "5ca474d6-8842-4342-ad76-5dbf4c3d9306",
                                "sense_id": "9e528f08-3dd7-3dd2-9d50-48cf82bd402f",
                                "text": "Sans doute une des lanternes qui, heurtée involontairement contre la muraille, avait pirouetté sur elle-même et présenté en arrière la vitre lumineuse."
                            },
                            {
                                "example_id": "40df1d1d-1359-45fc-8a64-c3177cdc84db",
                                "sense_id": "9e528f08-3dd7-3dd2-9d50-48cf82bd402f",
                                "text": "Comme la plupart des jeunes femmes réellement innocentes et sans expérience, elle voyait une faute dans un amour involontairement inspiré à un homme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d17c9580-c911-495a-80cf-606977cfe147",
                        "source_entry_id": "7a693b80-fa4e-3f1e-9b11-2cb8aa834bf3",
                        "source_sense_id": "9e528f08-3dd7-3dd2-9d50-48cf82bd402f",
                        "target_lang_word": "instinctively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instinctively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                        "entry_id": "6c9c7bfa-e058-32fc-ac27-b858feb8ffef",
                                        "glosses": [
                                            "Innately; by instinct; without being taught."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1a41bd-7287-46be-b68a-78833a68cc7c",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "Fish instinctively know how to swim; most humans don't."
                                            },
                                            {
                                                "example_id": "bb1c246e-5588-4e3b-b287-2c7ee252ebff",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "She loved him so passionately, and he was so godlike in her eyes; and being, though untrained, instinctively refined, her nature cried for his tutelary guidance."
                                            },
                                            {
                                                "example_id": "6e88c3bd-70a3-42ad-a92e-69393d3081c4",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "'I am, perhaps, overgreedy, but I sense a good cook instinctively.'"
                                            },
                                            {
                                                "example_id": "0fc6fc8b-ddd6-46a4-9ee8-d6e18263dfdb",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "While Conservative and Labour MPs instinctively had deep political differences, they were united in the cold view that at the end of the 1950s, Britain's railways were friendless and almost finished."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf844994-a8e9-43d2-acc4-b5e7ecd407da",
                        "source_entry_id": "7a693b80-fa4e-3f1e-9b11-2cb8aa834bf3",
                        "source_sense_id": "9e528f08-3dd7-3dd2-9d50-48cf82bd402f",
                        "target_lang_word": "involuntarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "involuntarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                        "entry_id": "1315d253-080d-3acb-bf02-852c79a2b310",
                                        "glosses": [
                                            "In an involuntary manner; done without conscious thought."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61a5c59d-651c-446a-a797-4ad0070ff0bf",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "Her leg twitched involuntarily."
                                            },
                                            {
                                                "example_id": "59581903-2382-4bd1-98f8-559a0112b0b8",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "He involuntarily overheard the conversation."
                                            },
                                            {
                                                "example_id": "a5559fe0-e6d3-4289-824a-c0569ed162ad",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "His eyes filled with tears, as he took up the glittering lengths. Their pale gold was lovely as ever; but there was something in the touch from which he involuntarily recoiled."
                                            },
                                            {
                                                "example_id": "0d204e97-0f65-433a-8d57-b5f9f95f53f1",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "Kennedy’s vocal rasp is not caused by an infection or respiratory condition. Instead, he has spasmodic dysphonia, a rare neurological condition in which the muscles that open and close his vocal cords spasm involuntarily, creating a strained or strangled quality to his speech."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7f3ff2b-13d9-4779-ad9d-bc4ff66f7f0c",
                        "source_entry_id": "7a693b80-fa4e-3f1e-9b11-2cb8aa834bf3",
                        "source_sense_id": "9e528f08-3dd7-3dd2-9d50-48cf82bd402f",
                        "target_lang_word": "unintentionally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unintentionally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "289a2ef5-e857-33d6-aa41-7f0747ec2302",
                                        "entry_id": "585a2102-23e1-3dc7-804c-c7fbf7681d14",
                                        "glosses": [
                                            "Without meaning to, in an unintentional manner, not intentionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca6a6d27-2726-48d0-8851-9e40fe37ce8a",
                                                "sense_id": "289a2ef5-e857-33d6-aa41-7f0747ec2302",
                                                "text": "\"Oh, no! Mason will not defy me; nor knowing it, will he hurt me—but, unintentionally, he might in a moment, by one careless word, deprive me, if not of life, yet for ever of happiness.\""
                                            },
                                            {
                                                "example_id": "f5b7c20f-4244-4994-976e-56f71062fddd",
                                                "sense_id": "289a2ef5-e857-33d6-aa41-7f0747ec2302",
                                                "text": "And, even if you do not unintentionally overstore your markets, over-expansion by your competitors will produce similar effects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9059773-e2b6-4e1f-890c-5ceabe24ad6b",
