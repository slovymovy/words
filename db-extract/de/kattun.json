                "senses": [
                    {
                        "sense_id": "6a93308d-43e8-3679-abee-75f048b37aac",
                        "entry_id": "3075a6ad-70a0-3e5e-8839-cf8b1016a358",
                        "glosses": [
                            "calico (kind of cotton fabric)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "8f382adc-202a-4e12-b13e-694a999b671e",
                                "sense_id": "6a93308d-43e8-3679-abee-75f048b37aac",
                                "text": "In ihrem kleinen, reinlichen Zimmer, dessen Möbel mit hellgeblümtem Kattun überzogen waren, erwachte Tony am nächsten Morgen mit dem angeregten und freudigen Gefühl, mit dem man in einer neuen Lebenslage die Augen öffnet."
                            },
                            {
                                "example_id": "115c66c8-c54b-4ed1-9d7b-41a3f01ac923",
                                "sense_id": "6a93308d-43e8-3679-abee-75f048b37aac",
                                "text": "Nicht anders als bei all unseren späteren Begegnungen trug Austerlitz damals in Antwerpen schwere Wanderstiefel, eine Art Arbeitshose aus verschossenem blauen Kattun, sowie ein maßgeschneidertes, aber längst aus der Mode gekommenes Anzugsjackett, […]"
                            }
                        ]
                    }
                ],
