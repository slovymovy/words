                        "tags": [
                            "Fromage"
                        ],
                        "examples": [
                            {
                                "example_id": "e8492347-75b2-4663-b4ab-30ea56e94213",
                                "sense_id": "1a5f8146-67e8-38df-9650-c3a8a084d8dc",
                                "text": "Le Saint-Rémi , qui se fait à l’école d’agriculture de ce nom (Haute-Saône), ne diffère pas sensiblement du Vold, du Trouville et du Pont-l’Évêque."
                            },
                            {
                                "example_id": "f25a7714-01f3-4ca0-aa46-a9689dd657fa",
                                "sense_id": "1a5f8146-67e8-38df-9650-c3a8a084d8dc",
                                "text": "Saint-Rémi , 110 grammes d’extrait sec, 40 % de matière grasse, …."
                            },
                            {
                                "example_id": "27f441c7-f002-4912-8f69-f5805507fa20",
                                "sense_id": "1a5f8146-67e8-38df-9650-c3a8a084d8dc",
                                "text": "Le Livarot , le Maroilles , le Münster , le Saint-Rémi , etc. appartiennent à ce groupe, ils jouissent d’une faveur locale ; mais ils sont de moins en moins recherchés par les consommateurs des grandes villes, dont les préférences vont avec raison aux fromages de Brie de Camembert et de Coulommiers."
                            }
                        ]
