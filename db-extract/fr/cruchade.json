                        "glosses": [
                            "Bouillie de maïs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c8927c6-22a6-4623-8beb-80fb9c0e075e",
                                "sense_id": "0557f380-305d-3441-b519-dc263c6dac6d",
                                "text": "Les gens supporteront de moins en moins de vivre comme des loups dans ces quartiers perdus, nourris de pain noir et de cruchade."
                            },
                            {
                                "example_id": "56941f01-10a2-4cd1-88f0-810bcc71d036",
                                "sense_id": "0557f380-305d-3441-b519-dc263c6dac6d",
                                "text": "Un certain désir de justice sociale me tourmentait aussi. J’obligeai ma mère à mettre bas les maisons de torchis où nos métayers vivaient mal, nourris de cruchade et de pain noir. Pour la première fois, elle essaya de me résister : « Pour la reconnaissance qu’ils t’en auront…»"
                            },
                            {
                                "example_id": "b401d172-cdd9-4663-a0ed-7fe14921c4fe",
                                "sense_id": "0557f380-305d-3441-b519-dc263c6dac6d",
                                "text": "Virginie t’a mitonné une cruchade, que tu as pas dû en manger souvent des pareilles."
                            }
                        ]
                    }
                ],
