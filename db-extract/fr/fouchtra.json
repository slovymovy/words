                        "entry_id": "1b5c47ad-5ebe-3c21-8b9e-341e8ceffed2",
                        "glosses": [
                            "Auvergnat, Auvergnate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824d0dcb-b5a6-4549-89b7-1cd790ae81b3",
                                "sense_id": "6c2fcc31-3943-3f6b-bc10-21e036568d40",
                                "text": "Le Basque à béret, le Fouchtra en blouse […] le rougeaud du Duc de Mayenne, le Breton noiraud à gros boutons d’argent."
                            },
                            {
                                "example_id": "adcd7e6b-9af3-4704-addf-e141429a965f",
                                "sense_id": "6c2fcc31-3943-3f6b-bc10-21e036568d40",
                                "text": "Elle m’apprend qu’elle est auvergnate. Je trouve qu’elle a la peau bien mate et bronzée pour une fouchtra et je le lui dis."
                            }
                        ]
                    }
