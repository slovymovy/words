                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcca6124-71a2-40c9-9e7a-ac549180b3dc",
                        "source_entry_id": "b2886293-6f03-3099-893f-3a9070874184",
                        "source_sense_id": "477a2fd5-247b-33e7-8c99-c244e4fa50ed",
                        "target_lang_word": "μελαγχολία",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "μελαγχολία",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "4da6e660-aaf1-37d8-9208-e68e25649548",
                                        "entry_id": "463d9906-cd0c-37a5-935b-2d13d131f584",
                                        "glosses": [
                                            "η κατάσταση αυτού που μελαγχολεί, που θλίβεται και απαισιοδοξεί"
                                        ],
                                        "tags": [
                                            "ψυχολογία",
                                            "ψυχιατρική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68e8afbf-b0b6-488d-8212-94289356bfc2",
                                                "sense_id": "4da6e660-aaf1-37d8-9208-e68e25649548",
                                                "text": "※ Μέσα στο κλίμα της ρομαντικής μελαγχολίας, ο ήρωας, ο βυρωνικός, ο στοχαστής, ο ποιητής δεν είχε άλλο τρόπο να αποδείξει το υπαρξιακό βάθος και την αγωνία του, την αισθητική και την ευαισθησία του, παρά μόνο με την «αριστοκρατική» μελαγχολία, την απόσταση από τα εγκόσμια, τη ρομαντική ανία (Μίμης Ανδρουλάκης, Μν, γυναικείο αντιμυθιστόρημα, εκδ. Καστανιώτη, 2000, σελ. 160)"
                                            },
                                            {
                                                "example_id": "78a01019-5606-4884-8bf8-7a58caf7db56",
                                                "sense_id": "4da6e660-aaf1-37d8-9208-e68e25649548",
                                                "text": "※ Όταν όμως κυρίευε τη Γιολάντα η μελαγχολία, στις προσωπικές της εξομολογήσεις, το αγοροκόριτσο - πειραχτήρι μεταμορφωνόταν σε ένα μικρό παιδάκι, παρατημένο, ανυπεράσπιστο, ανήμπορο. (Απόστολος Δοξιάδης, Ερασιτέχνης επαναστάτης, Προσωπική μυθιστορία, εκδ. Ίκαρος, 2018)"
                                            },
                                            {
                                                "example_id": "f9025f78-cc52-400a-a45c-9e7a18441fd9",
                                                "sense_id": "4da6e660-aaf1-37d8-9208-e68e25649548",
                                                "text": "※ Εκλεπτυσμένος σαρκασμός, μελαγχολία και ματαίωση, αισθαντικότητα και ηδονοθηρική διάθεση ζυμώνονται στις φράσεις του αθηναίου συγγραφέα, που ενίοτε υπογράφει και ως Απίκιος (sic: του Αθηναίου με μικρό α) (περιοδικό Διαβάζω, τεύχη 459-461, 2006, σελ. 58)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
