                "senses": [
                    {
                        "sense_id": "81db44ca-fb57-39cd-8eff-324473c204b0",
                        "entry_id": "c64fb413-dbd8-3a24-bd2e-e3906dffe5a8",
                        "glosses": [
                            "Zusammenziehung des Herzens, die außerhalb des normalen Herzrhythmus auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebc29e1f-df0f-492a-90d7-3e4332306e91",
                                "sense_id": "81db44ca-fb57-39cd-8eff-324473c204b0",
                                "text": "„Auch wenn Extrasystolen (oft als Herzstolpern spürbar) meist völlig ungefährlich sind, können die Beschwerden so stark werden, dass dennoch eine Behandlung sinnvoll ist.“"
                            },
                            {
                                "example_id": "5f524960-9a78-4aa0-9541-5f778925694f",
                                "sense_id": "81db44ca-fb57-39cd-8eff-324473c204b0",
                                "text": "„Auch wenn das Herzjagen mit unregelmäßiger Schlagfolge verbunden ist oder gelegentlich extra Herzschläge auftreten, die Extrasystolen, dann sind diese Störungen vielleicht lästig aber meist ohne ernsthafte Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
