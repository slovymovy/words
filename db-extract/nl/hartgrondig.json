                                    {
                                        "sense_id": "85b12889-d9d6-3c05-b3b0-67940d1148dd",
                                        "entry_id": "e58a9e39-917e-30d0-8f7b-f5c0448dce58",
                                        "glosses": [
                                            "A liqueur prepared using the infusion process."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d13d50-c891-4096-bd6d-4553f24e154f",
                                                "sense_id": "85b12889-d9d6-3c05-b3b0-67940d1148dd",
                                                "text": "1728, John Gay, The Beggar's Opera, Act III, Scene 1, in 1828, British Theatre, Comprising Tragedies, Comedies, Operas, and Farces, 827,\nLucy. But, miss Polly—in the way of friendship, will you give me leave to propose a glass of cordial to you ?\nPolly. Strong waters are apt to give me the headache.—I hope, madam, you will excuse me?"
                                            },
                                            {
                                                "example_id": "b9961f3d-8624-4e4f-bbc0-4615217aca68",
                                                "sense_id": "85b12889-d9d6-3c05-b3b0-67940d1148dd",
                                                "text": "[Marilla] had put the bottle of raspberry cordial down in the cellar instead of in the closet [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a9b7c32-1f84-3656-86e3-f8ec407ee531",
                                        "entry_id": "e58a9e39-917e-30d0-8f7b-f5c0448dce58",
                                        "glosses": [
                                            "A candy (or bonbon) usually made of milk chocolate, filled with small fruits (often maraschino cherries) and syrup or fondant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc9822f1-8536-3263-afc7-74c9b111bdb0",
                                        "entry_id": "e58a9e39-917e-30d0-8f7b-f5c0448dce58",
                                        "glosses": [
                                            "Anything that revives or comforts, a stimulant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e81ebc62-6d65-45f6-9258-4735ae6dc747",
                                                "sense_id": "bc9822f1-8536-3263-afc7-74c9b111bdb0",
                                                "text": "Never had Fanny more wanted a cordial. Never had she felt such a one as this letter contained."
                                            }
