                "senses": [
                    {
                        "sense_id": "f853a2d6-6aba-3896-9a5e-a0978a45ddfb",
                        "entry_id": "6dd025d5-9efb-399d-852f-630dc5cda619",
                        "glosses": [
                            "устар. маленький ресторан с продажей кофе; кофейня"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc2350b-f6dd-4118-b51b-d995f7c2c3c6",
                                "sense_id": "f853a2d6-6aba-3896-9a5e-a0978a45ddfb",
                                "text": "В кофейных, кондитерских, в магазинах с цветами и костюмами огонь уже не потухает всю ночь."
                            },
                            {
                                "example_id": "d32b03f9-a181-43b7-8d94-7698cd23be6d",
                                "sense_id": "f853a2d6-6aba-3896-9a5e-a0978a45ddfb",
                                "text": "После обеда, которого описывать я не берусь (уже Эней знал, как неприятно припоминать минувшее горе), отправился я в так называемую кофейную, куда каждый вечер собирались ремонтёры, заводчики и другие приезжие."
                            },
                            {
                                "example_id": "fcfaabe3-e82c-4add-bb81-f153a7a6da2a",
                                "sense_id": "f853a2d6-6aba-3896-9a5e-a0978a45ddfb",
                                "text": "Отдаленная от больших улиц кофейная, куда вошли оба господина Голядкина, была в эту минуту совершенно пуста."
                            },
                            {
                                "example_id": "9fae1c00-dc45-4898-960e-4821e64032fc",
                                "sense_id": "f853a2d6-6aba-3896-9a5e-a0978a45ddfb",
                                "text": "В мадритских кофейных видно несравненно более женщин, нежели в кофейных Парижа."
                            }
                        ]
                    }
