            "senses": [
                {
                    "sense_id": "32d16c92-0b1a-346d-9bad-6d97477c61e4",
                    "sense_definition": "Examiner ou contrôler quelque chose afin de s'assurer de sa conformité, de son exactitude ou de son bon état.",
