                        "sense_id": "c09460d5-30ee-36a0-a477-3ba9858e2e86",
                        "entry_id": "a0481131-6058-33bb-ae1e-4269c17da492",
                        "glosses": [
                            "Personne non-binaire qui traduit un texte ou une parole d’une langue en une autre."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "7c39c6e3-e66f-4577-9991-13d29af7f4bf",
                                "sense_id": "c09460d5-30ee-36a0-a477-3ba9858e2e86",
                                "text": "Ne.e en Belgique, traducteurice de profession, Cindy Van Wilder aime relever des défis et explorer de nouveaux horizons littéraires."
                            },
                            {
                                "example_id": "a7b726d0-58a3-4193-9999-1ce705fa58bf",
                                "sense_id": "c09460d5-30ee-36a0-a477-3ba9858e2e86",
                                "text": "Traducteurice dans l'audiovisuel."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d47ae00-df74-337a-aafa-06c9889afede",
                        "entry_id": "a0481131-6058-33bb-ae1e-4269c17da492",
                        "glosses": [
                            "Personne sans détermination de son genre qui traduit un texte ou une parole d’une langue en une autre."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "29f541fa-1609-47de-9d33-85d06c00594f",
                                "sense_id": "3d47ae00-df74-337a-aafa-06c9889afede",
                                "text": "Le métier de traducteurice, entre clichés, formation et outils, par Carmen et Freya"
                            },
                            {
                                "example_id": "50106f60-aac4-4b6a-babd-576366aefd30",
                                "sense_id": "3d47ae00-df74-337a-aafa-06c9889afede",
                                "text": "Il suffit de regarder les livres traduits et de devoir en chercher lea traducteurice pour se rendre compte qu’iel est très rarement en première de couverture ou même en page de titre"
                            }
                        ]
                    }
