                                        "glosses": [
                                            "Of or relating to operations, especially military operations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1db5426-0dac-4526-9427-021d1f07e5e3",
                                                "sense_id": "4856ab99-1810-3810-827b-c575fa8f668d",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "766ab2af-e4f7-3422-bdf7-79627412d787",
                                        "entry_id": "25b3bffd-2f4f-3616-816a-fe1082e30797",
                                        "glosses": [
                                            "Functioning and ready for use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba3b6f3-b20d-44c8-8a71-dc8f6d3d4093",
                                                "sense_id": "766ab2af-e4f7-3422-bdf7-79627412d787",
                                                "text": "Princess Leia, before your execution, you will join me at a ceremony that will make this battle station operational. No star system will dare oppose the Emperor now."
                                            },
                                            {
                                                "example_id": "fb51e351-491f-4372-94d3-e72585b1a1af",
                                                "sense_id": "766ab2af-e4f7-3422-bdf7-79627412d787",
                                                "text": "Despite somewhat faded paintwork, 87017 Iron Duke is clearly very much operational, as confirmed here on September 4."
                                            }
                                        ]
                                    },
