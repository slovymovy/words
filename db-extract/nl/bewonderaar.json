                                "example_id": "dfb581ac-bbe2-42ec-8fe8-da6692e7748e",
                                "sense_id": "40024be7-99fd-32e2-a36a-9b389e41e1eb",
                                "text": "De popster wilde de bewonderaar wel ontmoeten."
                            }
                        ]
