        "nl-extract.jsonl": [
            {
                "entry_id": "2e799148-8606-38ac-9942-d775e39bae92",
                "word": "uitschuren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "366dae2f-95e3-3ab9-8c21-dce17667edf7",
                        "entry_id": "2e799148-8606-38ac-9942-d775e39bae92",
                        "glosses": [
                            "wijder en dieper worden door de schurende werking van water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a568b8d-d99e-4965-bdf5-fc967c4bfcbe",
                                "sense_id": "366dae2f-95e3-3ab9-8c21-dce17667edf7",
                                "text": "Zeven dagen lang bedroeg de rivierafvoer 1.200 kubieke meter per seconde. Onderzoekers maten zaken als stroomsnelheid, waterstand, zand- en slibtransport, het uitschuren van het rivierbed en de waterkwaliteit."
                            },
                            {
                                "example_id": "0fba6eca-14b0-4633-a760-0e65d99c3725",
                                "sense_id": "366dae2f-95e3-3ab9-8c21-dce17667edf7",
                                "text": "Samen met zijn studenten onderzocht Stive de morfologische ontwikkelingen in de Waddenzee, die voortdurend in beweging is. Bij vloed stromen massa's zand en slib de Waddenzee in en bij eb stroomt dit sediment weer grotendeels terug naar de Noordzee. Het zand dat de stromingen uitschuren in de geulen wordt afgezet op de wadplaten. Als de zeespiegel stijgt, stijgen de wadplaten mee."
                            },
                            {
                                "example_id": "6bc5f959-a849-486f-9624-4289c14e44f3",
                                "sense_id": "366dae2f-95e3-3ab9-8c21-dce17667edf7",
                                "text": "Kajakken en kanovaren zal voortaan tussen 15 maart en 1 oktober verboden zijn op de bovenlopen van de Lesse, de Ourthe en de Amblève. Volgens eigen zeggen doet Happart dit om het milieu te beschermen. De boten zouden de bodem van de rivieren, waar visseëitjes liggen, uitschuren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab0fa405-0355-41c5-8b53-3fd16a82b537",
                        "source_entry_id": "2e799148-8606-38ac-9942-d775e39bae92",
                        "source_sense_id": "366dae2f-95e3-3ab9-8c21-dce17667edf7",
                        "target_lang_word": "rub",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9a435d2-118d-3f68-9fdb-ecac32abcaa2",
                                        "entry_id": "c5c13bd2-8b5f-394a-8723-e4e9ead228e1",
                                        "glosses": [
                                            "An act of rubbing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86499eed-4ed5-4460-877d-fdb88a171442",
                                                "sense_id": "f9a435d2-118d-3f68-9fdb-ecac32abcaa2",
                                                "text": "Give that lamp a good rub and see if any genies come out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25f1ced4-1e9e-3a43-97e6-c2526deecb0f",
                                        "entry_id": "c5c13bd2-8b5f-394a-8723-e4e9ead228e1",
                                        "glosses": [
                                            "A difficulty or problem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7b0fdc2-207b-4516-badd-72a5c6a0ca52",
                                                "sense_id": "25f1ced4-1e9e-3a43-97e6-c2526deecb0f",
                                                "text": "To die, to sleep— / To sleep—perchance to dream. Ay, there's the rub! / For in that sleep of death what dreams may come, / When we have shuffled off this mortal coil, / Must give us pause"
                                            },
                                            {
                                                "example_id": "1a1e1f91-4d34-4b02-9183-3186fc2e2c22",
                                                "sense_id": "25f1ced4-1e9e-3a43-97e6-c2526deecb0f",
                                                "text": "[…] the propriety of the cabman's shelter, as it was called, hardly a stonesthrow away near Butt bridge where they might hit upon some drinkables in the shape of a milk and soda or a mineral. But how to get there was the rub."
                                            },
                                            {
                                                "example_id": "9e9220a0-c023-4508-8db9-ec9390a1a61f",
                                                "sense_id": "25f1ced4-1e9e-3a43-97e6-c2526deecb0f",
                                                "text": "'My dear Devereux, I say, you mustn't talk in that wild way. You—you talk like a ruined man!'\n'And I so comfortable!'\n'Why, to be sure, Dick, you have had some little rubs, and, maybe, your follies and your vexations; but, hang it, you are young; you can't get experience—at least, so I've found it—without paying for it. […]'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76551f4f-51a0-38b4-86bb-5809c3fb7400",
                                        "entry_id": "c5c13bd2-8b5f-394a-8723-e4e9ead228e1",
                                        "glosses": [
                                            "A quip or sarcastic remark."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e631a156-186c-3f7d-b129-7778502a4c87",
                                        "entry_id": "c5c13bd2-8b5f-394a-8723-e4e9ead228e1",
                                        "glosses": [
                                            "In the game of crown green bowls, any obstacle by which a bowl is diverted from its normal course."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc77a25f-eef8-33e5-b003-ebe5e6236c82",
                                        "entry_id": "c5c13bd2-8b5f-394a-8723-e4e9ead228e1",
                                        "glosses": [
                                            "Any substance designed to be applied by rubbing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5bec4e2-818c-4a31-afea-9d9b421f2d58",
                                                "sense_id": "cc77a25f-eef8-33e5-b003-ebe5e6236c82",
                                                "text": "a heat rub intended for muscular strains"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "216e4c97-4cc0-39c9-afdd-7d6035bf0b5d",
                                        "entry_id": "c5c13bd2-8b5f-394a-8723-e4e9ead228e1",
                                        "glosses": [
                                            "Any substance designed to be applied by rubbing.",
                                            "A mixture of spices applied to meat before it is barbecued."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc075950-bc3c-3bca-bbae-b0ffd09a9eea",
                                        "entry_id": "c5c13bd2-8b5f-394a-8723-e4e9ead228e1",
                                        "glosses": [
                                            "A loan."
                                        ],
                                        "tags": [
                                            "UK",
