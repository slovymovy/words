                },
                {
                    "sense_id": "dbc6d8ab-9fa4-3122-8ca2-634eaefe1fc6",
                    "sense_definition": "A place where meat is sold or prepared, such as a butcher shop or slaughterhouse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old town, the <w>shambles</w> were located near the river for easy cleaning.",
                            "target_lang_translations": {
                                "nl": "In de oude stad bevonden de <w>slachthuizen</w> zich nabij de rivier voor eenvoudige reiniging."
                            }
                        },
                        {
                            "text": "The historical records mention the city <w>shambles</w> as a central hub for local trade.",
                            "target_lang_translations": {
                                "nl": "De historische archieven vermelden de <w>slagerijen</w> van de stad als een centraal knooppunt voor de lokale handel."
                            }
                        }
                    ],
                    "synonyms": [
                        "butchery",
                        "slaughterhouse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a historical butcher shop or slaughterhouse."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een plek waar vlees wordt verkocht of bereid, zoals een slagerij of slachthuis."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "slachthuis",
                                "target_lang_sense_clarification": "plaats waar dieren worden geslacht"
                            },
                            {
                                "target_lang_word": "slagerij",
                                "target_lang_sense_clarification": "winkel waar vlees wordt verkocht"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da410d48-4431-374a-a3c8-3667aa6a7939",
                    "sense_definition": "Third-person singular simple present indicative of <w>shamble</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man <w>shambles</w> down the street every morning to buy his newspaper.",
