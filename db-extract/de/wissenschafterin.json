                "senses": [
                    {
                        "sense_id": "2ec15c9a-ec1d-3766-b22f-3575e6889ad4",
                        "entry_id": "80180c5e-46bf-34a0-ba6b-be7eaf1f4176",
                        "glosses": [
                            "Österreich, Switzerland and Liechtenstein: Wissenschaftlerin"
                        ],
                        "tags": [
                            "Beruf",
                            "Forschung",
                            "Wissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "817cd6d6-c695-4b03-bcc1-e8b5eff3ea99",
                                "sense_id": "2ec15c9a-ec1d-3766-b22f-3575e6889ad4",
                                "text": "„Die US-amerikanische Wissenschafterin Cheryl Olson, Mitautorin des Buchs «Grand Theft Childhood», spricht sich gegen die Meinung aus, dass Computerspiele Auslöser von gewalttätigem Verhalten seien.“"
                            },
                            {
                                "example_id": "11440342-8fe7-4df0-bb8f-a9ace7c5ec00",
                                "sense_id": "2ec15c9a-ec1d-3766-b22f-3575e6889ad4",
                                "text": "„Die Wissenschafterin argumentiert, dass Social-Networking-Plattformen ohnedies zu einem Großteil dazu benutzt werden, um sich mit Freunden aus dem wirklichen Leben - zum Beispiel aus der Schule oder aus der Nachbarschaft - zu vernetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
