                "senses": [
                    {
                        "sense_id": "1ca7befb-2bdf-3d71-b59a-37ab56f1cd96",
                        "entry_id": "b56f9888-6850-340c-8339-857be8daaa3c",
                        "glosses": [
                            "Gelenk, das die Fuß- und Unterschenkelknochen verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd28d207-b1cc-4fca-8a00-4072c23fcb3a",
                                "sense_id": "1ca7befb-2bdf-3d71-b59a-37ab56f1cd96",
                                "text": "Beim Trampolinspringen habe ich mir das Fußgelenk verstaucht."
                            },
                            {
                                "example_id": "5ed124a4-dc01-49fc-88c3-dd81b1c0b503",
                                "sense_id": "1ca7befb-2bdf-3d71-b59a-37ab56f1cd96",
                                "text": "„Weil ihm ihre Armbänder viel zu leicht von den Handgelenken gerutscht wären, steckte er stattdessen die Füße hindurch und schob sie dann mit Gewalt über die Fußgelenke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08637b7b-c12a-4776-b579-caa43a5489a3",
                        "source_entry_id": "b56f9888-6850-340c-8339-857be8daaa3c",
                        "source_sense_id": "1ca7befb-2bdf-3d71-b59a-37ab56f1cd96",
