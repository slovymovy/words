                "entry_id": "b4d140e2-7754-363e-991d-f104576277bf",
                "word": "letztens",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a3dd9a9b-ea1e-3336-b790-f734dffcf864",
                        "entry_id": "b4d140e2-7754-363e-991d-f104576277bf",
                        "glosses": [
                            "recently; the other day"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4932fa4-5dcc-42c2-9de6-26ea0800118d",
                                "sense_id": "a3dd9a9b-ea1e-3336-b790-f734dffcf864",
                                "text": "Ich war letztens in Köln.",
                                "translation": "I was in Cologne the other day.",
                                "english": "I was in Cologne the other day."
                            },
                            {
                                "example_id": "f7631493-e8d7-4a90-bc65-c55708879415",
                                "sense_id": "a3dd9a9b-ea1e-3336-b790-f734dffcf864",
                                "text": "Und letztens, vor einem Monat, hat er mir erklärt, er würde mir auch nicht mehr mit einem Pfennig aushelfen.",
                                "translation": "And recently, one month ago, he asserted to me that he would not even help me out with one penny anymore.",
                                "english": "And recently, one month ago, he asserted to me that he would not even help me out with one penny anymore."
                            }
                        ]
                    },
                    {
                        "sense_id": "3882aeba-1c65-38a8-90cb-2061c20b1516",
                        "entry_id": "b4d140e2-7754-363e-991d-f104576277bf",
                        "glosses": [
                            "lastly; finally"
                        ],
                        "tags": [
                            "in enumerations"
                        ],
                        "examples": [
                            {
                                "example_id": "0a81184b-d958-45da-b6d3-83db627708a9",
                                "sense_id": "3882aeba-1c65-38a8-90cb-2061c20b1516",
                                "text": "Es kamen die Mutter, der Vater, der Bruder und letztens auch noch die Schwägerin.",
                                "translation": "There entered the mother, the father, the brother, and finally the sister-in-law as well.",
                                "english": "There entered the mother, the father, the brother, and finally the sister-in-law as well."
                            }
                        ]
                    }
                ],
