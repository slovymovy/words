                "translations": [
                    {
                        "translation_id": "337367bd-6ee4-47a1-a5b1-9438d6e1ed59",
                        "source_entry_id": "e9077549-927a-3816-ae4c-e814afea6ab5",
                        "source_sense_id": "577b55bc-068a-3f5b-a720-9325062b7319",
