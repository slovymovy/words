        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d84ffaaf-9674-3899-b4cb-7ab86d5b6b16",
                "word": "legality",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f3bd1a98-20eb-4ada-88eb-429c3a2f3598",
                        "entry_id": "d84ffaaf-9674-3899-b4cb-7ab86d5b6b16",
                        "tags": [
                            "plural"
                        ],
                        "form": "legalities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd10db51-c53c-342b-a0ac-293d1169d279",
                        "entry_id": "d84ffaaf-9674-3899-b4cb-7ab86d5b6b16",
                        "glosses": [
                            "Lawfulness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2782a73e-f692-4b50-9690-b154a53710aa",
                                "sense_id": "dd10db51-c53c-342b-a0ac-293d1169d279",
                                "text": "Brought from all the recesses of the coast in all the legality of time contracts, lost in uncongenial surroundings, fed on unfamiliar food, they sickened, became inefficient, and were then allowed to crawl away and rest."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf6a75b6-c955-3299-bc09-347e45526196",
                        "entry_id": "d84ffaaf-9674-3899-b4cb-7ab86d5b6b16",
                        "glosses": [
                            "A dice game; the same as chuck-a-luck."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "14fad29f-9c72-4214-8e3f-f23e46c692f7",
                                "sense_id": "bf6a75b6-c955-3299-bc09-347e45526196",
                                "text": "There was one game in particular called “legality,” in which the managers of the establishment played against all comers. It was a game in which six numbers were marked upon a board, the players staked upon a number, the keeper of the bank threw against the players, and according to whether they were successful or not in the number they backed, they won or lost."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f6c1fb5-d6f8-4507-b25a-b1c5adb54c90",
                        "source_entry_id": "d84ffaaf-9674-3899-b4cb-7ab86d5b6b16",
                        "source_sense_description": "lawfulness",
                        "target_lang_word": "wettigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wettigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0c05afa0-bc67-3a2c-819a-d9f99f9fbf01",
                                        "entry_id": "87636e25-d9e3-30c7-829c-b3c322e78d12",
                                        "glosses": [
                                            "het in overeenkomst met de wet zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e7b3d2b-8d28-42cb-8a59-aecac78feda4",
                                                "sense_id": "0c05afa0-bc67-3a2c-819a-d9f99f9fbf01",
                                                "text": "De wettigheid van dit optreden is te betwijfelen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41e91eaf-46a9-4e90-a7e8-fd19e6e1f356",
                        "source_entry_id": "d84ffaaf-9674-3899-b4cb-7ab86d5b6b16",
                        "source_sense_description": "lawfulness",
                        "target_lang_word": "légalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85673bc6-c4ff-3bdc-a2dd-0265a9eb7ca0",
                                        "entry_id": "b219e54b-bb2e-31af-9bc8-4b568d86973c",
                                        "glosses": [
                                            "Caractère de ce qui est légal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c61d01b5-f869-48e0-bbe5-22dc7c0168ce",
                                                "sense_id": "85673bc6-c4ff-3bdc-a2dd-0265a9eb7ca0",
                                                "text": "La légalité d’un acte."
                                            },
                                            {
                                                "example_id": "8d340250-d6bb-4de5-8fac-786e554d8bb3",
                                                "sense_id": "85673bc6-c4ff-3bdc-a2dd-0265a9eb7ca0",
                                                "text": "On a contesté la légalité de ces formes, de ces moyens, de ces mesures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc0a55aa-d2b2-38f7-a4ae-dfbfeb08a096",
                                        "entry_id": "b219e54b-bb2e-31af-9bc8-4b568d86973c",
                                        "glosses": [
                                            "La loi, la règle communément admise ou légalement fondée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97036c2b-d06f-4223-9bb1-a6ff0f335bbb",
                                                "sense_id": "dc0a55aa-d2b2-38f7-a4ae-dfbfeb08a096",
                                                "text": "Je savais bien que ces protestations ne servaient à rien et que, dans ces circonstances, en appeler au respect de la légalité devant ces brutes était ridicule […]."
                                            },
                                            {
                                                "example_id": "74c6856c-1c26-40ce-ab24-19b462933337",
                                                "sense_id": "dc0a55aa-d2b2-38f7-a4ae-dfbfeb08a096",
                                                "text": "Respecter la légalité."
                                            },
                                            {
                                                "example_id": "8bf00630-ee23-45f6-8269-0ea9de726ca2",
                                                "sense_id": "dc0a55aa-d2b2-38f7-a4ae-dfbfeb08a096",
                                                "text": "Violer la légalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6e6dea8-bd50-49f5-955c-1885a9ac05b8",
                        "source_entry_id": "d84ffaaf-9674-3899-b4cb-7ab86d5b6b16",
                        "source_sense_description": "lawfulness",
                        "target_lang_word": "Legalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Legalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                        "entry_id": "2908ea0d-d64e-353b-857f-018e52cefe5d",
                                        "glosses": [
                                            "Eigenschaft, den geltenden Gesetzen zu entsprechen und damit gesetzeskonform, rechtmäßig (legal) zu sein"
                                        ],
                                        "tags": [
                                            "singular",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6bb2f7f-0259-4966-8bc5-b240328b87ed",
                                                "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                                "text": "„Bevor auf mögliche Konflikte zwischen Legalität und (moralischer) Legitimität eingegangen wird, ist es erforderlich, das Verhältnis zwischen Recht und Moral zu klären.“"
                                            },
                                            {
                                                "example_id": "784b76c6-5e9c-421a-9e00-a865f932b17d",
                                                "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                                "text": "Es handelt sich hierbei um eine Grauzone am Rande der Legalität."
                                            },
                                            {
                                                "example_id": "531e6ca6-9fbc-484a-af94-2affb2dc4f37",
                                                "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                                "text": "Sie versuchten, dem Geschäft einen Anschein von Legalität zu geben."
                                            },
                                            {
                                                "example_id": "9e55e834-11c4-480d-b3f2-e2f9b5f4d6f3",
                                                "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                                "text": "„Er kannte sich recht gut aus, was die Gesetze in Frankreich anging und wie der Kunsthandel abseits der Legalität so funktionierte.“"
                                            },
                                            {
                                                "example_id": "95404d85-316e-4a06-ad68-4d650ab76bcb",
                                                "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                                "text": "„Hoffmann rührt sich; er protestiert im Namen der Gerechtigkeit und Legalität, weigert sich, sich korrumpieren zu lassen und reicht schließlich seine Demission als Mitglied der Untersuchungskommission ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
