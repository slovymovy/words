                "senses": [
                    {
                        "sense_id": "9a7d3f9d-e332-3411-a430-d354788a3888",
                        "entry_id": "f3133297-e9ca-3215-80e1-0d94d076321b",
                        "glosses": [
                            "Autre orthographe (moins logique et moins utilisée, mais également utilisée de façon notable) de quatre-quarts (type de gâteau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a7cf1ba-9ad1-4ce2-9678-f25b0d567e9a",
                                "sense_id": "9a7d3f9d-e332-3411-a430-d354788a3888",
                                "text": "Il invitait le voyageur las des routes solitaires à entrer et à se réconforter avec du café fumant et des gâteaux chauds, du quatre-quart et de délicieuses tourtes faites avec les produits d'un sol gras; […]."
                            },
                            {
                                "example_id": "03f9eaa8-33d4-4411-94cd-a3ccd4d3de14",
                                "sense_id": "9a7d3f9d-e332-3411-a430-d354788a3888",
                                "text": "A propos, monsieur Vincent, aimez-vous le quatre-quart ? Anne le réussit admirablement."
                            },
                            {
                                "example_id": "c0b0e76a-20bf-41ce-a90b-3f540705dde5",
                                "sense_id": "9a7d3f9d-e332-3411-a430-d354788a3888",
                                "text": "Tu sais c'est un quatre-quart comme tu les aimes, tu y feras honneur, il est bien haut, je l'ai réussi comme jamais."
                            },
                            {
                                "example_id": "c720d4a3-ad38-4793-86ae-24f85bebf729",
                                "sense_id": "9a7d3f9d-e332-3411-a430-d354788a3888",
                                "text": "Un baryton, Monsieur Lavallée, avait apporté une bouteille de porto, et il en proposa à la ronde. Mademoiselle Bidoun, alto, avait confectionné un quatre-quart."
                            }
                        ]
                    }
