                "senses": [
                    {
                        "sense_id": "3508663a-2343-3973-b689-af18bc84141a",
                        "entry_id": "4a0d63c2-5c51-39bd-a9b9-174bb97603c3",
                        "glosses": [
                            "eine Kontrollliste, die alles zu Überprüfende auflistet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2c8ad1-5f74-4490-a667-dc04fdbb76df",
                                "sense_id": "3508663a-2343-3973-b689-af18bc84141a",
                                "text": "Die Checkliste wurde Punkt für Punkt abgearbeitet."
                            },
                            {
                                "example_id": "72f5e180-e96d-44d2-a9c9-fa883cad449a",
                                "sense_id": "3508663a-2343-3973-b689-af18bc84141a",
                                "text": "Damit nicht vergessen wird, werden Checklisten für die nächsten Projekte erstellt."
                            },
                            {
                                "example_id": "62d9cdf9-7a06-48e3-8e5a-f2524fb2194e",
                                "sense_id": "3508663a-2343-3973-b689-af18bc84141a",
                                "text": "„Der KARRIERENStandard hat eine Checkliste für das perfekte Bewerbungsfoto zusammengestellt:“"
                            },
                            {
                                "example_id": "32d074ec-0d37-4d8f-bff1-b5d83864ae7d",
                                "sense_id": "3508663a-2343-3973-b689-af18bc84141a",
                                "text": "„Jährlich wird per Checkliste abgehakt: Gibt es ein unterzeichnetes Protokoll jeder Aufsichtsratssitzung? Ist jeder Spesenbeleg korrekt verbucht? Sind die Umsätze zeitlich richtig abgegrenzt?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b502cd59-ba61-41c7-adc2-c354a86da38c",
                        "source_entry_id": "4a0d63c2-5c51-39bd-a9b9-174bb97603c3",
                        "source_sense_id": "3508663a-2343-3973-b689-af18bc84141a",
