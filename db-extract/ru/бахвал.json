                                                "example_id": "d69b5814-023d-418d-ab15-0fa9bedf413d",
                                                "sense_id": "3b1fca71-0683-3284-9448-d3e836aef1cb",
                                                "text": "„Charisma verhindert, dass aus einem Großmaul ein Schwätzer wird, das war bei Ali genauso.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
