                ],
                "senses": [
                    {
                        "sense_id": "1564f880-f3dc-37b5-9672-deb6577171a5",
                        "entry_id": "df529eb6-ec02-39ee-85c9-ee28da41d3c1",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e29be7-494e-4b36-a853-e85d8fa67b79",
                                "sense_id": "1564f880-f3dc-37b5-9672-deb6577171a5",
                                "text": "Aberlins kamen, sahen und siegten."
                            },
                            {
                                "example_id": "77a5f5a0-7907-4bcb-8541-d0d4a356a73d",
                                "sense_id": "1564f880-f3dc-37b5-9672-deb6577171a5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aberlin kommt, geht der Herr Aberlin.“"
                            },
                            {
                                "example_id": "9edde1cf-ea28-4b28-ae6a-e984e3084c62",
                                "sense_id": "1564f880-f3dc-37b5-9672-deb6577171a5",
                                "text": "Aberlin kommt und geht."
                            },
                            {
                                "example_id": "eecc2575-d287-43e8-93d2-dec2db47972f",
                                "sense_id": "1564f880-f3dc-37b5-9672-deb6577171a5",
                                "text": "Die Aberlins fliegen heute nach Oslo."
                            },
                            {
                                "example_id": "351748ea-93d8-47e9-94d7-56bbf0e3539f",
                                "sense_id": "1564f880-f3dc-37b5-9672-deb6577171a5",
                                "text": "Der Aberlin trägt nie die Pullover, die die Aberlin ihm strickt."
                            },
                            {
                                "example_id": "e7cdef22-d363-4f98-bf5f-676858d4dbd7",
                                "sense_id": "1564f880-f3dc-37b5-9672-deb6577171a5",
                                "text": "Herr Aberlin ist niemals schlecht gelaunt."
                            },
                            {
                                "example_id": "20c619d1-e019-4d7c-9111-40b1f38ab78d",
                                "sense_id": "1564f880-f3dc-37b5-9672-deb6577171a5",
                                "text": "Kommen Aberlins mit ins Theater?"
                            },
                            {
                                "example_id": "dd6c65b6-e31d-40b0-a723-d5fa96cd6f88",
                                "sense_id": "1564f880-f3dc-37b5-9672-deb6577171a5",
                                "text": "Der Aberlin fährt in den Urlaub, die Aberlin muss arbeiten."
                            },
                            {
                                "example_id": "c400d7a4-1a30-46a9-b07d-d14527a0195e",
                                "sense_id": "1564f880-f3dc-37b5-9672-deb6577171a5",
                                "text": "Frau Aberlin ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a0b382af-76bc-4e6d-9675-9b690081b6bb",
                                "sense_id": "1564f880-f3dc-37b5-9672-deb6577171a5",
                                "text": "Herr Aberlin wollte uns kein Interview geben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
