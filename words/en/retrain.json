    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f18b6551-1a40-3738-abb3-726390d01bb5",
                    "sense_definition": "To teach or learn new skills, especially in order to do a different job or adapt to new conditions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "training",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>retrain</w> existing employees rather than hiring new staff from outside.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>переобучить</w> действующих сотрудников, а не нанимать новый персонал со стороны."
                            }
                        },
                        {
                            "text": "After the factory closed down, he chose to <w>retrain</w> as an electrician to secure steady work.",
                            "target_lang_translations": {
                                "ru": "После закрытия завода он решил <w>переквалифицироваться</w> на электрика, чтобы обеспечить себе стабильную работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "reskill"
                    ],
                    "common_phrases": [
                        "retrain as",
                        "retrain workers",
                        "retrain for a job"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обучать или приобретать новые навыки, особенно для получения другой профессии или адаптации к новым условиям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переобучать",
                                "target_lang_sense_clarification": "кого-либо"
                            },
                            {
                                "target_lang_word": "переобучаться",
                                "target_lang_sense_clarification": "самому"
                            },
                            {
                                "target_lang_word": "переквалифицироваться",
                                "target_lang_sense_clarification": "осваивать другую профессию"
                            },
                            {
                                "target_lang_word": "пройти переподготовку",
                                "target_lang_sense_clarification": "завершить процесс обучения новой профессии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "586c6150-6a70-3c5e-85ae-6444315d433b",
                    "sense_definition": "An instance or process of training again.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "training",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineering team scheduled a full model <w>retrain</w> to improve accuracy over the weekend.",
                            "target_lang_translations": {
                                "ru": "Команда инженеров запланировала полное <w>переобучение</w> модели на выходных, чтобы повысить её точность."
                            }
                        },
                        {
                            "text": "They debated whether an expensive <w>retrain</w> was necessary given the minor changes in data.",
                            "target_lang_translations": {
                                "ru": "Они спорили о том, необходимо ли дорогостоящее <w>переобучение</w>, учитывая незначительные изменения в данных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "model retrain"
                    ],
                    "target_lang_definitions": {
