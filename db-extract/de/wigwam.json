                                        "entry_id": "5c1e357f-8994-31db-9a0c-cf2fcf5b82d0",
                                        "glosses": [
                                            "rodzaj nieprzenośnej chaty Indian Ameryki Północnej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cacec68-54b3-4ff8-9668-6df4cc9394ba",
                                                "sense_id": "003b53f5-d0a7-3bed-8ee9-af88e15cd929",
                                                "text": "Wigwamy używane były przez Indian w obszarach leśnych Ameryki Północnej."
                                            },
                                            {
                                                "example_id": "2a446483-ac40-453b-98b9-f435bb2964c8",
                                                "sense_id": "003b53f5-d0a7-3bed-8ee9-af88e15cd929",
                                                "text": "Na pewno nie możemy się przyglądać tej sytuacji, żeby pan Jan nadal pomieszkiwał w ziemiankach, wigwamach, szałasach i w innych miejscach"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
