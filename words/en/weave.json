{
    "word_family": [
        "weaver",
        "interweave",
        "unweave",
        "weaving",
        "interwoven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b2bb3f2-39e0-3060-8ee5-5982c7e19263",
                    "sense_definition": "To make cloth, a carpet, or a basket by crossing threads or strips of material over and under each other.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "textile_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother taught me how to <w>weave</w> wool into warm blankets.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка научила меня <w>ткать</w> тёплые одеяла из шерсти.",
                                "zh": "我祖母教我如何用羊毛<w>织</w>出温暖的毯子。"
                            }
                        },
                        {
                            "text": "The machine <w>weaves</w> cotton threads together to create the fabric.",
                            "target_lang_translations": {
                                "ru": "Машина <w>переплетает</w> хлопковые нити, создавая ткань.",
                                "zh": "机器将棉线<w>织</w>在一起制成布料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "braid",
                        "entwine",
                        "plait",
                        "interlace"
                    ],
                    "antonyms": [
                        "unravel",
                        "unpick"
                    ],
                    "common_phrases": [
                        "weave a basket",
                        "weave a rug",
                        "weave fabric",
                        "hand-woven"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past: wove; Past participle: woven"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изготавливать ткань, ковёр или корзину, переплетая нити или полоски материала.",
                        "zh": "通过交叉穿插线或材料条来制作布料、地毯或篮子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ткать",
                                "target_lang_sense_clarification": "ткань, ковры"
                            },
                            {
                                "target_lang_word": "плести",
                                "target_lang_sense_clarification": "корзины, косы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "织",
                                "target_lang_sense_clarification": "用于布料、地毯等"
                            },
                            {
                                "target_lang_word": "编织",
                                "target_lang_sense_clarification": "用于篮子、草席等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e1eeb7e-776e-391d-a0f9-732403cdab18",
                    "sense_definition": "To move somewhere by turning and changing direction frequently to avoid obstacles.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The motorcycle <w>weaved</w> through the heavy traffic to get ahead.",
                            "target_lang_translations": {
                                "ru": "Мотоцикл <w>петлял</w> в плотном потоке машин, чтобы проехать вперёд.",
                                "zh": "摩托车在拥挤的车流中<w>穿梭</w>以求领先。"
                            }
                        },
                        {
                            "text": "He managed to <w>weave</w> past three defenders and score a goal.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>проскользнуть</w> мимо трёх защитников, петляя, и забить гол.",
                                "zh": "他成功地<w>穿梭</w>过三名防守队员并射门得分。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zigzag",
                        "swerve",
                        "wind",
                        "snake"
                    ],
                    "common_phrases": [
                        "weave through traffic",
                        "weave in and out",
                        "weave one's way"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past and participle: weaved"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться, часто меняя направление, чтобы избежать препятствий.",
                        "zh": "通过频繁改变方向来移动，以避开障碍物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петлять",
                                "target_lang_sense_clarification": "двигаться зигзагами"
                            },
                            {
                                "target_lang_word": "лавировать",
                                "target_lang_sense_clarification": "между препятствиями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穿梭",
                                "target_lang_sense_clarification": "在人群或车流中灵活移动"
                            },
                            {
                                "target_lang_word": "迂回",
                                "target_lang_sense_clarification": "绕过障碍物移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5e4c3cf-c183-323e-a410-3bc057333578",
                    "sense_definition": "To make a web or cocoon by producing threads from the body (used of spiders or insects).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "textile_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spider <w>wove</w> a complex web between the branches of the tree.",
                            "target_lang_translations": {
                                "ru": "Паук <w>сплёл</w> сложную паутину между ветвями дерева.",
                                "zh": "蜘蛛在树枝间<w>结</w>了一张复杂的网。"
                            }
                        },
                        {
                            "text": "Silkworms <w>weave</w> cocoons before they transform into moths.",
                            "target_lang_translations": {
                                "ru": "Шелкопряды <w>вьют</w> коконы перед превращением в мотыльков.",
                                "zh": "蚕在变成蛾之前会<w>吐丝</w>结茧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spin"
                    ],
                    "common_phrases": [
                        "weave a web",
                        "weave a cocoon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать паутину или кокон, выделяя нити из тела (о пауках или насекомых).",
                        "zh": "指蜘蛛或昆虫通过从体内分泌丝线来制造网或茧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плести",
                                "target_lang_sense_clarification": "паутину"
                            },
                            {
                                "target_lang_word": "вить",
                                "target_lang_sense_clarification": "кокон, гнездо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结",
                                "target_lang_sense_clarification": "用于蜘蛛网"
                            },
                            {
                                "target_lang_word": "吐丝",
                                "target_lang_sense_clarification": "用于蚕结茧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e61bf2f7-8937-3407-bc74-139096b65c90",
                    "sense_definition": "To combine different elements or details into a complex story or pattern.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>wove</w> historical facts into the fictional narrative.",
                            "target_lang_translations": {
                                "ru": "Автор <w>вплёл</w> исторические факты в вымышленное повествование.",
                                "zh": "作者将历史事实<w>编织</w>进了虚构的叙事中。"
                            }
                        },
                        {
                            "text": "She knows how to <w>weave</w> a compelling tale of mystery and romance.",
                            "target_lang_translations": {
                                "ru": "Она умеет <w>сплести</w> захватывающую историю из тайны и романтики.",
                                "zh": "她懂得如何<w>编织</w>一个引人入胜的悬疑浪漫故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compose",
                        "fabricate",
                        "construct",
                        "blend"
                    ],
                    "antonyms": [
                        "separate"
                    ],
                    "common_phrases": [
                        "weave a story",
                        "weave a plot",
                        "weave together",
                        "weave magic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединять различные элементы или детали в сложную историю или узор.",
                        "zh": "将不同的元素或细节组合成一个复杂的故事或模式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплетать",
                                "target_lang_sense_clarification": "соединять воедино"
                            },
                            {
                                "target_lang_word": "вплетать",
                                "target_lang_sense_clarification": "добавлять элементы в целое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "编织",
                                "target_lang_sense_clarification": "比喻将素材组织成故事"
                            },
                            {
                                "target_lang_word": "融合",
                                "target_lang_sense_clarification": "将不同元素结合在一起"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10e5b6e4-5abf-3a13-a08a-0aa6c0780b47",
                    "sense_definition": "An artificial hairpiece or extensions attached to natural hair to change its appearance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hair_fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went to the salon to get a new <w>weave</w> for the wedding.",
                            "target_lang_translations": {
                                "ru": "Она пошла в салон, чтобы сделать новые <w>накладные пряди</w> к свадьбе.",
                                "zh": "她去沙龙做了新的<w>接发</w>以参加婚礼。"
                            }
                        },
                        {
                            "text": "Her <w>weave</w> looked so natural that no one realized it wasn't her real hair.",
                            "target_lang_translations": {
                                "ru": "Её <w>накладные волосы</w> выглядели так естественно, что никто не понял, что это не её настоящие волосы.",
                                "zh": "她的<w>接发</w>看起来非常自然，没人发现那不是她自己的头发。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hair extension",
                        "hairpiece"
                    ],
                    "common_phrases": [
                        "wear a weave",
                        "get a weave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусственные пряди или накладка, прикрепляемые к натуральным волосам.",
                        "zh": "为了改变外观而附加在自然头发上的假发或接发。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накладные волосы",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "наращивание",
                                "target_lang_sense_clarification": "процедура или результат"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接发",
                                "target_lang_sense_clarification": "指接发技术或成品"
                            },
                            {
                                "target_lang_word": "假发片",
                                "target_lang_sense_clarification": "指附加的头发部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa39a850-6137-3645-b36b-d254191791fe",
                    "sense_definition": "The pattern or style in which threads are crossed to make fabric.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "textile_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This shirt has a very loose <w>weave</w>, making it breathable for summer.",
                            "target_lang_translations": {
                                "ru": "У этой рубашки очень свободное <w>переплетение</w>, что делает её дышащей для лета.",
                                "zh": "这件衬衫的<w>织法</w>非常疏松，这使它在夏天穿起来很透气。"
                            }
                        },
                        {
                            "text": "You can identify the quality of the rug by looking closely at its <w>weave</w>.",
                            "target_lang_translations": {
                                "ru": "Качество ковра можно определить, внимательно рассмотрев его <w>плетение</w>.",
                                "zh": "你可以通过仔细观察地毯的<w>织法</w>来辨别其质量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "texture",
                        "pattern"
                    ],
                    "common_phrases": [
                        "tight weave",
                        "loose weave",
                        "plain weave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узор или способ переплетения нитей при создании ткани.",
                        "zh": "制作布料时线交叉的图案或风格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переплетение",
                                "target_lang_sense_clarification": "способ соединения нитей"
                            },
                            {
                                "target_lang_word": "плетение",
                                "target_lang_sense_clarification": "структура ткани"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "织法",
                                "target_lang_sense_clarification": "布料的编织方式"
                            },
                            {
                                "target_lang_word": "纹理",
                                "target_lang_sense_clarification": "织物表面的结构感"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}