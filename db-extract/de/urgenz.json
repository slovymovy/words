                "senses": [
                    {
                        "sense_id": "0a979432-9483-3bb5-badb-c2a29af671f4",
                        "entry_id": "f1d541b4-00b0-3291-8ee6-293e6b0d44f0",
                        "glosses": [
                            "Dringlichkeit, Eile"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfbbc70a-00d9-3a47-9e06-c4805ccaf32c",
                        "entry_id": "f1d541b4-00b0-3291-8ee6-293e6b0d44f0",
                        "glosses": [
                            "Drängeln, Mahnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa9dabe9-3130-4965-a197-86a6cb40de7d",
                                "sense_id": "cfbbc70a-00d9-3a47-9e06-c4805ccaf32c",
                                "text": "„Die erstbeklagte Partei lieferte jedoch trotz mehrerer Urgenzen den Doppelschacht nicht nach.“"
                            },
                            {
                                "example_id": "f97bab0a-e654-4288-a607-a0860e2dbe21",
                                "sense_id": "cfbbc70a-00d9-3a47-9e06-c4805ccaf32c",
                                "text": "„Damit scheint die Erstbehörde zu meinen, die genannten Urgenzen verschiedener Erledigungen stellten ‚Ermahnungen‘ des Vorgesetzten gegenüber dem BW dar.“"
                            },
                            {
                                "example_id": "b194b83c-fa23-45ac-9354-706f9b9af428",
                                "sense_id": "cfbbc70a-00d9-3a47-9e06-c4805ccaf32c",
                                "text": "„Leistete aber der Haftpflichtversicherer über Urgenz des klagenden Legalzessionars den auf den Haftungshöchstbetrag fehlenden Differenzbetrag, dann fehlt für die Annahme eines hiedurch zum Ausdruck gebrachten weiterreichenden Verpflichtungswillens jegliche Grundlage.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "ce63789a-4fd7-30db-9ff5-66e902600969",
                        "entry_id": "f1d541b4-00b0-3291-8ee6-293e6b0d44f0",
                        "glosses": [
                            "Harndrang (fachsprachlich)"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09c8f237-4951-4bdc-9c7f-68fa1315b825",
                        "source_entry_id": "f1d541b4-00b0-3291-8ee6-293e6b0d44f0",
                        "source_sense_id": "0a979432-9483-3bb5-badb-c2a29af671f4",
                        "source_sense_description": "Dringlichkeit",
                        "target_lang_word": "urgence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urgence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2e1f7fb-a125-30f8-9bc6-1b12517f20e6",
                                        "entry_id": "202a655c-03ff-3d45-b64c-dec3708b3211",
                                        "glosses": [
                                            "Caractère de ce qui est urgent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f3955d9-7fcd-481c-97cc-1a8088a3586b",
                                                "sense_id": "b2e1f7fb-a125-30f8-9bc6-1b12517f20e6",
                                                "text": "Ainsi, seuls, en médecine d’urgence, les masques permettent une administration d’oxygène efficace : […]."
                                            },
                                            {
                                                "example_id": "7f56c53c-9073-4682-88a4-d16959e16153",
                                                "sense_id": "b2e1f7fb-a125-30f8-9bc6-1b12517f20e6",
                                                "text": "Le génie de la Résistance, c'est d'avoir su conjoindre, face à une même urgence historique, toutes les forces spirituelles de ce pays."
                                            },
                                            {
                                                "example_id": "30e67e53-505d-4111-a49c-95bf57aee5ea",
                                                "sense_id": "b2e1f7fb-a125-30f8-9bc6-1b12517f20e6",
                                                "text": "On a déclaré l’urgence."
                                            },
                                            {
                                                "example_id": "ef0c4150-0476-4c0c-a28d-a8d8f0ca2fd4",
                                                "sense_id": "b2e1f7fb-a125-30f8-9bc6-1b12517f20e6",
                                                "text": "En cas d’urgence."
                                            },
                                            {
                                                "example_id": "adccf523-8305-4148-9937-2159b11dca95",
                                                "sense_id": "b2e1f7fb-a125-30f8-9bc6-1b12517f20e6",
                                                "text": "Il y a urgence."
                                            },
                                            {
                                                "example_id": "28e83c39-ea2b-4111-8524-b5c20017f813",
                                                "sense_id": "b2e1f7fb-a125-30f8-9bc6-1b12517f20e6",
                                                "text": "Et je sens partout une urgence usée, une urgence qui a renoncé à l'urgence. On fuit, à l'allure de cinq kilomètres par jour, des tanks qui progressent, à travers champs, de plus de cent kilomètres, et des avions qui se déplacent à six cents kilomètres-heures. … C'est urgent. Et cela ne l'est plus. C'est suspendu entre l'urgence et l'éternité."
                                            },
                                            {
                                                "example_id": "a333bd05-1680-4682-9cec-714a879bb39c",
                                                "sense_id": "b2e1f7fb-a125-30f8-9bc6-1b12517f20e6",
                                                "text": "Selon la législation en vigueur, les gyrophares à deux tons sont réservés aux policiers en intervention. Ils ne doivent être utilisés que dans de situations dîtes d' urgence. Dans le cas contraire, les policiers sont tenus de respecter le Code de la route, comme les autres usagers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ddf2927-a5ce-3dd0-b20f-e6e74aca95b4",
                                        "entry_id": "202a655c-03ff-3d45-b64c-dec3708b3211",
                                        "glosses": [
                                            "Service hospitalier qui traite les cas les plus urgents."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d2bf2c-19ed-42cc-9b24-421b4080bc27",
                                                "sense_id": "9ddf2927-a5ce-3dd0-b20f-e6e74aca95b4",
                                                "text": "En 2002, 19 % des patients étaient hospitalisés après leur passage aux urgences, contre 20 % en 2014."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "427628c1-b5aa-46e9-ad4d-47775e17db13",
                        "source_entry_id": "f1d541b4-00b0-3291-8ee6-293e6b0d44f0",
