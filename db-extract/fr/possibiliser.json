                ],
                "senses": [
                    {
                        "sense_id": "1d7e91ff-9501-3605-aacf-5997ac9b64ca",
                        "entry_id": "fafa19d4-cb93-3fa6-9c28-b457a82926ec",
                        "glosses": [
                            "Rendre possible."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c422b2ec-586c-4cf0-a1e2-486b189dd6b3",
                                "sense_id": "1d7e91ff-9501-3605-aacf-5997ac9b64ca",
                                "text": "Toutefois, l'esprit possède ce pouvoir de possibiliser le réel en vertu d'une détermination spécifique qui le caractérise entre tous les êtres : la liberté."
                            },
                            {
                                "example_id": "ab874bd8-550e-43e1-b7b3-427c03340963",
                                "sense_id": "1d7e91ff-9501-3605-aacf-5997ac9b64ca",
                                "text": "Le fatigué ne peut plus réaliser, mais l'épuisé ne peut plus possibiliser."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a4f56f7-e26c-38f2-b9bc-541a8812b8f4",
                        "entry_id": "fafa19d4-cb93-3fa6-9c28-b457a82926ec",
                        "glosses": [
                            "Se réaliser, devenir possible."
                        ],
                        "tags": [
                            "pronominal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "de1df851-b461-41eb-a669-f601bea142a1",
                                "sense_id": "3a4f56f7-e26c-38f2-b9bc-541a8812b8f4",
                                "text": "On l’a dit le grand évocateur des Rêves ; a t-on remarqué que ses rêves se peuvent toujours possibiliser ?"
                            }
                        ]
                    }
                ],
