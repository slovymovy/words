                "senses": [
                    {
                        "sense_id": "d7541003-b2c8-3796-9673-8659f99e6022",
                        "entry_id": "f4df8457-ea48-31b6-ab0c-8d46d102ffd4",
                        "glosses": [
                            "het ingaan in woord of gedachte tegen de doctrines van de kerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0879a5c6-765f-457c-b029-30047d458249",
                                "sense_id": "d7541003-b2c8-3796-9673-8659f99e6022",
                                "text": "Het uitbannen van tot ketterij bestempelde opvattingen kreeg vorm in de vervolging van de aanhangers van dergelijke opvattingen door lokale kerken en de wereldlijke macht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ef317ac-a50c-4a73-b25e-5628e63cc57e",
                        "source_entry_id": "f4df8457-ea48-31b6-ab0c-8d46d102ffd4",
                        "source_sense_id": "d7541003-b2c8-3796-9673-8659f99e6022",
                        "source_sense_description": "het ingaan in woord of gedachte tegen de doctrines van de kerk",
                        "target_lang_word": "Ketzerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ketzerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19c5a821-e7e3-3753-a20e-c633c7ae8799",
                                        "entry_id": "bac39a50-b505-3e8b-acb8-d26caca14d2b",
                                        "glosses": [
                                            "Abweichung von der gültigen Lehre"
                                        ],
                                        "tags": [
                                            "meist Christentum, abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b24d4193-faef-4579-851d-9e3d1abe43e2",
                                                "sense_id": "19c5a821-e7e3-3753-a20e-c633c7ae8799",
                                                "text": "„Diesem Verein war es auferlegt, die Ketzerei, mit welchen Mitteln auch immer, zu zerschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "870ac862-9e68-326b-a4b2-63f5c64d0bfd",
                                        "entry_id": "bac39a50-b505-3e8b-acb8-d26caca14d2b",
                                        "glosses": [
                                            "unerhörte Abweichung von der gemeingültigen Meinung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32d9618d-862e-4099-aa8c-5f918980b248",
                                                "sense_id": "870ac862-9e68-326b-a4b2-63f5c64d0bfd",
                                                "text": "„Unser eigentliches Vergehen und Verbrechen ist unsere Ketzerei gegen das Dogma.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f093fd4-c62b-469f-901b-eb4e17bb22a5",
                        "source_entry_id": "f4df8457-ea48-31b6-ab0c-8d46d102ffd4",
                        "source_sense_id": "d7541003-b2c8-3796-9673-8659f99e6022",
                        "source_sense_description": "het ingaan in woord of gedachte tegen de doctrines van de kerk",
                        "target_lang_word": "heresy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heresy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78d56f18-a394-33f3-a087-f12f5e972681",
                                        "entry_id": "925529c6-d269-3e94-b891-08481fe3d5b9",
                                        "glosses": [
                                            "A doctrine held by a member of a religion at variance or conflict with established religious beliefs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d32e8e0-6261-45a7-8ddb-8e06258c26d2",
                                                "sense_id": "78d56f18-a394-33f3-a087-f12f5e972681",
                                                "text": "Heresy meant deliberate departure from the accepted doctrines of the church. It was intellectual and spiritual dissent and concerned the beliefs of Christianity, not the morals of its adherents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08cc1a1a-1ef0-34b8-92f0-d85fee1074da",
                                        "entry_id": "925529c6-d269-3e94-b891-08481fe3d5b9",
                                        "glosses": [
                                            "A controversial or unorthodox opinion held by a member of a group, as in politics, philosophy or science."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0c8493-dce5-41ba-9ffa-15262ff96648",
                                                "sense_id": "08cc1a1a-1ef0-34b8-92f0-d85fee1074da",
                                                "text": "I'm going to declare a heresy for you. All science, if you go back into its roots, saying: 'Why do I believe this?' 'Well, I believe this because of these tests and this proof.' 'Well, why do I believe this?' 'Why did I set up this test?' 'Why did I believe that proof?' All science goes back to something that we believe because we believe it. We believe it because we believe it, and we have no proof for it. It's like a religion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ee55f69-0eb9-4d3c-b368-e595f893bf68",
                        "source_entry_id": "f4df8457-ea48-31b6-ab0c-8d46d102ffd4",
                        "source_sense_id": "d7541003-b2c8-3796-9673-8659f99e6022",
                        "source_sense_description": "het ingaan in woord of gedachte tegen de doctrines van de kerk",
                        "target_lang_word": "hérésie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hérésie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b93b9ec3-2782-360f-a0e3-2684da847e7a",
                                        "entry_id": "aac4f336-71a2-3280-bcc5-7b8fef4cea62",
                                        "glosses": [
                                            "Doctrine religieuse qui diffère du dogme officiel de l’Église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e88e169e-6b4c-4d10-be15-2a634c3223ed",
                                                "sense_id": "b93b9ec3-2782-360f-a0e3-2684da847e7a",
                                                "text": "Hérésie cathare."
                                            },
                                            {
                                                "example_id": "9af590e6-8ebc-4c1a-9a5a-189335d379bd",
                                                "sense_id": "b93b9ec3-2782-360f-a0e3-2684da847e7a",
                                                "text": "L’hérésie méridionale disparut ensuite de l’actualité dans les vingt dernières années du XIIᵉ siècle, jusqu’à l’élection d’Innocent III au pontificat, à l’échec de la quatrième croisade et à l’assassinat du légat Pierre de Castelnau."
                                            },
                                            {
                                                "example_id": "433a94c7-ec21-4558-ad37-eb58d3a1b3a3",
                                                "sense_id": "b93b9ec3-2782-360f-a0e3-2684da847e7a",
                                                "text": "Des prêtres prêchaient que les malheurs du pays étaient la conséquence des hérésies et de la négligence des devoirs religieux."
                                            },
                                            {
                                                "example_id": "ea51bf2d-0f42-4339-99a6-cc53cb7fdcf1",
                                                "sense_id": "b93b9ec3-2782-360f-a0e3-2684da847e7a",
                                                "text": "Il [Jean Calas] était protestant, ainsi que sa femme et tous ses enfants, excepté un, qui avait abjuré l’hérésie, et à qui le père faisait une petite pension."
                                            },
                                            {
                                                "example_id": "eede7b3a-badc-49f0-8aff-e983c2aee5f0",
                                                "sense_id": "b93b9ec3-2782-360f-a0e3-2684da847e7a",
                                                "text": "La source de toutes les hérésies est l’exclusion de quelques-unes de ces vérités. Et la source de toutes les objections que nous font les hérétiques est l’ignorance de quelques-unes de nos vérités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91f58fc4-4c62-3140-a8e9-4f7bf60b6c73",
                                        "entry_id": "aac4f336-71a2-3280-bcc5-7b8fef4cea62",
                                        "glosses": [
                                            "Façon de voir, de penser et d’agir contraire à la doctrine établie, et aux dogmes officiels. Syn. : Dissidence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4004b669-2794-4c90-809b-95b3c4fc6f3d",
                                                "sense_id": "91f58fc4-4c62-3140-a8e9-4f7bf60b6c73",
                                                "text": "Le triumvirat déclenche contre lui de nouvelles polémiques, bientôt frénétiques, dans lesquelles l’argumentation fait place à une scolastique forgée pour les besoins de la cause et oppose sans fin le léninisme au trotskisme, comme la vérité révélée à l’hérésie, le mal au bien, le salut à la perdition."
                                            },
                                            {
                                                "example_id": "f1fc8801-3718-4abb-a235-ab8a2db311f2",
                                                "sense_id": "91f58fc4-4c62-3140-a8e9-4f7bf60b6c73",
                                                "text": "À cette époque, le tergal bon marché faisait socialiste conformiste et les démagogues l’appréciaient même lorsque leur alpaga étincelant frisait l’hérésie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe30ec87-ad51-36a2-80b2-9379955ad1c4",
                                        "entry_id": "aac4f336-71a2-3280-bcc5-7b8fef4cea62",
                                        "glosses": [
                                            "Doctrine, maxime quelconque, lorsqu’elle est en opposition avec les idées reçues."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67d72ff4-1e29-43a7-97b4-3710bdef12bf",
                                                "sense_id": "fe30ec87-ad51-36a2-80b2-9379955ad1c4",
                                                "text": "Tous ces nouveaux principes sont autant d’hérésies (en littérature, en médecine, en art, etc.). Ce que vous dites là est une hérésie, une offense au bon sens, au bon goût."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2ff0772-88df-3189-9ece-f7a47bc2e894",
                                        "entry_id": "aac4f336-71a2-3280-bcc5-7b8fef4cea62",
                                        "glosses": [
                                            "Idée peu reçue, à propos de laquelle on exprime son désaccord, des doutes, son scepticisme."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "751b57be-dbd3-4688-ab61-25a302a1568c",
                                                "sense_id": "d2ff0772-88df-3189-9ece-f7a47bc2e894",
                                                "text": "Quelle hérésie ! Jacques Bonhomme, trahir la cause du sol, abandonner la culture du blé parce que peu rémunératrice."
                                            },
                                            {
                                                "example_id": "97bc2659-993d-4755-8bcd-05873f8386dd",
                                                "sense_id": "d2ff0772-88df-3189-9ece-f7a47bc2e894",
                                                "text": "Curieusement, ces tubes énormes font un coude serré juste avant d’atteindre la salle des machines… Une complète hérésie en termes de dynamique des fluides assumée par les concepteurs de l’époque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01160b6b-afb0-4410-b7da-9426aa31ffd6",
                        "source_entry_id": "f4df8457-ea48-31b6-ab0c-8d46d102ffd4",
                        "source_sense_id": "d7541003-b2c8-3796-9673-8659f99e6022",
                        "source_sense_description": "het ingaan in woord of gedachte tegen de doctrines van de kerk",
                        "target_lang_word": "eresia",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eresia",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec76962-4b1c-39aa-9b2f-b7422b75b622",
                                        "entry_id": "68720142-a433-3a52-92de-d58d88067d57",
                                        "glosses": [
                                            "dottrina del cristianesimo che prende posizioni diverse dal cattolicesimo su questioni teologiche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dac54139-2250-4f9f-874a-1d9bb47d1c39",
                                                "sense_id": "8ec76962-4b1c-39aa-9b2f-b7422b75b622",
                                                "text": "L'arianesimo era un'eresia che sosteneva che il Figlio (Gesù) non foss'altro che creatura del Padre, così come anche lo spirito santo, e che il Dio cristiano avesse dunque una sola natura."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbceb5ef-0f02-3594-8943-f34d6ed25674",
                                        "entry_id": "68720142-a433-3a52-92de-d58d88067d57",
                                        "glosses": [
                                            "setta che si distacca dalle idee della religione più diffusa, la cui cosa è considerata ragione di biasimo da quest'ultima"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1523ac58-c336-4b2d-8aec-cc5981c07109",
                                                "sense_id": "cbceb5ef-0f02-3594-8943-f34d6ed25674",
                                                "text": "Il chassidismo è stato considerato da alcuni rabbini un'eresia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a5e8d24-399e-3b1f-b0b1-23bed00cccce",
                                        "entry_id": "68720142-a433-3a52-92de-d58d88067d57",
                                        "glosses": [
                                            "asserzione contrapposta al modo di pensare comune"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00db7358-75ff-41f8-ac9d-cf407e89f794",
                                                "sense_id": "4a5e8d24-399e-3b1f-b0b1-23bed00cccce",
                                                "text": "Per i buongustai bere un bicchiere di vino rosso con un piatto di pesce fritto è una vera eresia!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
