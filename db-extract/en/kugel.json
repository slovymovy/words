                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23e7e1d3-ea4b-31fa-adcd-f6dc00d310ec",
                                        "entry_id": "88041b97-af82-371e-8640-5b7e48a69b5c",
                                        "glosses": [
                                            "Volumen, das von einem Rand umgeben wird, dessen Punkte alle den gleichen Abstand von einem Punkt (Mittelpunkt) besitzen"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2df29a50-d0b9-4112-a549-64c00222aa1a",
                                                "sense_id": "23e7e1d3-ea4b-31fa-adcd-f6dc00d310ec",
                                                "text": "Die Erde ist keine Kugel, sondern ein Ellipsoid."
                                            },
                                            {
                                                "example_id": "52c10934-6cd9-44bf-bcd4-dd5f1e031d01",
                                                "sense_id": "23e7e1d3-ea4b-31fa-adcd-f6dc00d310ec",
                                                "text": "Für nautische Rechnungen kann die Erde ohne erhebliche Fehler als Kugel betrachtet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba27d385-2366-3ca8-879c-7683c98a19cc",
                                        "entry_id": "88041b97-af82-371e-8640-5b7e48a69b5c",
                                        "glosses": [
                                            "dreidimensionales rundes Objekt, im Gegensatz zum Ball meist hart"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23967908-6250-4345-9547-a6384ef2c1c9",
                                                "sense_id": "ba27d385-2366-3ca8-879c-7683c98a19cc",
                                                "text": "Wir spielen mit unseren eigenen Kugeln."
                                            },
                                            {
                                                "example_id": "36698e55-9326-4690-ad45-ceeb264f817d",
                                                "sense_id": "ba27d385-2366-3ca8-879c-7683c98a19cc",
                                                "text": "Der Baum war mit Kugeln und Lichtern geschmückt."
                                            },
                                            {
                                                "example_id": "e14be81a-a970-4722-b64c-4163148c5bbc",
                                                "sense_id": "ba27d385-2366-3ca8-879c-7683c98a19cc",
                                                "text": "Bitte zwei Kugeln Erdbeer und eine Stracciatella!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c152d579-f678-3915-9f12-eaa14d3f3715",
                                        "entry_id": "88041b97-af82-371e-8640-5b7e48a69b5c",
                                        "glosses": [
                                            "Objekt, das von Schusswaffen abgefeuert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b99ae8-0854-47bf-85df-c74896e6da73",
                                                "sense_id": "c152d579-f678-3915-9f12-eaa14d3f3715",
                                                "text": "Die Kugel traf ihn mitten ins Herz."
                                            },
                                            {
                                                "example_id": "c7099b29-6334-4dbc-92e9-f8a3e43f8d26",
                                                "sense_id": "c152d579-f678-3915-9f12-eaa14d3f3715",
                                                "text": "„Vielleicht hatten sich die feindlichen Heere fürs Erste mit genügend Gewehren, Kugeln und Schießpulver eingedeckt, vielleicht war aber auch Agaja schon zu sehr in die Defensive gedrängt, um sein Heer weiter mit Feuerwaffen versorgen zu können.“"
                                            },
                                            {
                                                "example_id": "0cb02281-07ea-44d5-a11e-7bf646c65e1e",
                                                "sense_id": "c152d579-f678-3915-9f12-eaa14d3f3715",
                                                "text": "„Die Kugel sauste an meinem Ohr vorbei und traf Lewis, der zu Boden fiel.“"
                                            },
                                            {
                                                "example_id": "dfa4e9bf-95ff-4824-b4de-4b6739922a25",
                                                "sense_id": "c152d579-f678-3915-9f12-eaa14d3f3715",
                                                "text": "„Kugeln und Granatsplitter prallen daran ab.“"
                                            },
                                            {
                                                "example_id": "aaff4f8c-8bf4-49ac-afd3-8aba775295b8",
                                                "sense_id": "c152d579-f678-3915-9f12-eaa14d3f3715",
                                                "text": "„Die Kugel ging ihm durch die Nase und kam an seinem Hinterkopf wieder raus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
