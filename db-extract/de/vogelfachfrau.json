                "senses": [
                    {
                        "sense_id": "d4b67adc-c8e5-342b-978e-f40591660190",
                        "entry_id": "5a6c5184-e657-300b-bd78-a8045bf6a81a",
                        "glosses": [
                            "weibliche Person, die sich sehr gut mit dem Thema Vögel auskennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cc5cd9e-5110-4fdb-9325-4f37f10eb841",
                                "sense_id": "d4b67adc-c8e5-342b-978e-f40591660190",
                                "text": "„Auch seine Frau ist siebzig und Vogelfachfrau. Beide wohnen in einer Wohnung, in der die Wände mit Regalen voller Vogelbüchern vollstehen.“"
                            },
                            {
                                "example_id": "ba62025f-4057-4f11-906b-3924663a755b",
                                "sense_id": "d4b67adc-c8e5-342b-978e-f40591660190",
                                "text": "„‚Der kleine Falke mit dem rötlich braunen Gefieder, der im typischen Rüttelflug Mäuse und größere Insekten jagt, nistet gerne in Nischen oder Nistkästen höherer Gebäude, vor allem in Kirchen‘, erzählt die Vogelfachfrau.“"
                            },
                            {
                                "example_id": "06d639ab-80ee-4bb2-9477-9adffea93a8c",
                                "sense_id": "d4b67adc-c8e5-342b-978e-f40591660190",
                                "text": "„‚Ich habe so ein unerwünschtes Verhalten durch ein anderes ersetzt und damit das Problemverhalten abgestellt, denn Jack kann ja nicht gleichzeitig meine Schuhe zerkauen und zu mir bringen‘, beschreibt die Vogelfachfrau.“"
                            },
                            {
                                "example_id": "cd293bd5-c739-4b15-b6f6-9ea6fd0667d6",
                                "sense_id": "d4b67adc-c8e5-342b-978e-f40591660190",
                                "text": "„Die Anrufe häuften sich dermaßen bei Jack und Monica Sandrock, dass der Ortsvorsitzende sich an die betreffende Vogelfachfrau in der Biologischen Station Krickenbecker Seen wandte.“"
                            },
                            {
                                "example_id": "a1ca8544-dd4a-4548-a1b1-1e70dd8f7a67",
                                "sense_id": "d4b67adc-c8e5-342b-978e-f40591660190",
                                "text": "„Und Vogelfachfrau Elisabeth Kehl zeigte dem Team immer wieder kleine Patienten und erklärte, was die Federknäuel für Bedürfnisse haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
