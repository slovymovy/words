                        "entry_id": "8d4c61fe-95ef-3302-a1b3-04c3147de5c3",
                        "glosses": [
                            "widerrufen oder zurückziehen (so etwas gesagt oder getan zu haben ); nie gesagt haben; etwas ungeschehen machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "846c4377-f80b-4fc2-b66c-35522cfae604",
                                "sense_id": "e335e922-b8c7-308e-b458-f390db2c4eb0",
                                "text": "„O God, O God, that it were possible To undo things done, to call back yesterday; That Time could turn up his swift sandy glass To untell the days, and to redeem these hours.“"
                            }
                        ],
