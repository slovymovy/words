                                            {
                                                "example_id": "9e7a36ca-2057-4e4e-9447-b2f79543c885",
                                                "sense_id": "aecb49b0-8518-3577-9002-6532c87eab81",
                                                "text": "De Nederlandse luchthaven Schiphol verwacht donderdag heel wat problemen omwille van de voorspelde stormwind. Luchtvaartmaatschappij KLM heeft alvast 220 Europese vluchten van en naar de luchthaven van Amsterdam geannuleerd. Reizigers die wel kunnen vliegen, moeten rekening houden met vertragingen."
                                            },
                                            {
                                                "example_id": "068bceaa-fb2c-484a-9d2b-1ddfe1182e92",
                                                "sense_id": "aecb49b0-8518-3577-9002-6532c87eab81",
                                                "text": "Er raasde een stevige storm boven de Belgische kust. In Nieuwpoort is één persoon om het leven gekomen nadat een torenkraan omviel door zware stormwind. Er vielen ook drie gewonden."
                                            }
