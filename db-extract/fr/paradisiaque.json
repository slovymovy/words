                    {
                        "translation_id": "5a69d1d0-adb4-4602-a8f2-2c4bf611ef9d",
                        "source_entry_id": "df42fbe7-828c-371a-839f-030381679949",
                        "source_sense_description": "Qui ressemble à ce que l’on s’imagine être le paradis.",
