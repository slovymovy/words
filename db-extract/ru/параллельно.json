                    }
                ],
                "translations": [
                    {
                        "translation_id": "07d4a133-167d-4313-99cc-486684825ad5",
                        "source_entry_id": "92e539a7-345b-34ff-8b5a-1a9f95294f25",
                        "source_sense_description": "одновременно с чем-либо",
                        "target_lang_word": "simultaneously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simultaneously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a040f26a-c0f1-37b9-a2dd-a4158bb637c3",
                                        "entry_id": "b26099f7-7bca-349d-bf9a-940f00c5a855",
                                        "glosses": [
                                            "Occurring at the same time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092abd28-4add-44a0-b23e-4c124b020259",
                                                "sense_id": "a040f26a-c0f1-37b9-a2dd-a4158bb637c3",
                                                "text": "The cradle-rocking and the song would cease simultaneously for a moment, and an exclamation at highest vocal pitch would take the place of the melody."
                                            },
                                            {
                                                "example_id": "62f6208a-1c37-4651-9ed5-e10eb68655fc",
                                                "sense_id": "a040f26a-c0f1-37b9-a2dd-a4158bb637c3",
                                                "text": "Numa was about to charge—there was little time in which to compare various methods or weigh the probable results of any. And then a number of things happened, almost simultaneously—the lion sprang from his ambush toward the retreating black—Tarzan cried out in warning—and the black turned just in time to see Numa halted in mid-flight by a slender strand of grass rope, the noosed end of which had fallen cleanly about his neck."
                                            },
                                            {
                                                "example_id": "7b6c6939-0cd6-4e19-90a5-8603b6c4d382",
                                                "sense_id": "a040f26a-c0f1-37b9-a2dd-a4158bb637c3",
                                                "text": "The hens woke up squawking with terror because they had all dreamed simultaneously of hearing a gun go off in the distance."
                                            },
                                            {
                                                "example_id": "a45f275f-be71-424f-86c5-8cdacda4602b",
                                                "sense_id": "a040f26a-c0f1-37b9-a2dd-a4158bb637c3",
                                                "text": "Hidden behind thickets of acronyms and gorse bushes of detail, a new great game is under way across the globe. Some call it geoeconomics, but it's geopolitics too. The current power play consists of an extraordinary range of countries simultaneously sitting down to negotiate big free trade and investment agreements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ecb1092-daf6-4979-a530-4cdee1b40f68",
                        "source_entry_id": "92e539a7-345b-34ff-8b5a-1a9f95294f25",
                        "source_sense_description": "одновременно с чем-либо",
                        "target_lang_word": "at the same time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at the same time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                        "entry_id": "73bfff3f-ec81-3182-9d3a-f79647229543",
                                        "glosses": [
                                            "At the same instant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8608ac4d-459e-4321-b493-1dec99f23cd7",
                                                "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                                "text": "Their departures were at the same time."
                                            },
                                            {
                                                "example_id": "a7b7000e-ee3d-4ca2-b9fe-798afda0fbbd",
                                                "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                                "text": "They departed at the same time."
                                            },
                                            {
                                                "example_id": "dc26530c-95a2-47f9-8796-0dd73f7729e6",
                                                "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                                "text": "I bid him come towards me and give me his letter, at the same time throwing down, carelessly, a book I had in my hands.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                        "entry_id": "73bfff3f-ec81-3182-9d3a-f79647229543",
                                        "glosses": [
                                            "Overlapping or coinciding in duration."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bab6badd-fad5-4e15-b6f4-981e7eca78b4",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "His service as chairman was at the same time as his board membership"
                                            },
                                            {
                                                "example_id": "b5a99962-f54f-4efd-9f8f-a31ba212df61",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "I'm working. But at the same time, I'm exercising too."
                                            },
                                            {
                                                "example_id": "4a8eed97-83df-40cb-9413-c8406b41a943",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "However, with the dainty volume my quondam friend sprang into fame. At the same time he cast off the chrysalis of a commonplace existence."
                                            },
                                            {
                                                "example_id": "39aa47fe-7058-49cd-b2dd-c5672a051261",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "At the same time, it is pouring money into cleaning up the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2cb6b64-bab6-37aa-85a4-083be4581f2f",
                                        "entry_id": "73bfff3f-ec81-3182-9d3a-f79647229543",
                                        "glosses": [
                                            "On the other hand (introducing an opposing viewpoint)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
