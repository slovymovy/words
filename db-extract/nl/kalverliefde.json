                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c2b683f-350d-4495-a8c0-38dfd0b5ace8",
                                                "sense_id": "6ae0fb38-35be-3dbb-99ed-071d10e1b3d3",
                                                "text": "Obwohl er bereits verheiratet war, begann er eine Affäre mit seiner Jugendliebe."
                                            },
                                            {
                                                "example_id": "1799d121-fb20-43d2-a907-d990120c9a2f",
                                                "sense_id": "6ae0fb38-35be-3dbb-99ed-071d10e1b3d3",
                                                "text": "„Deswegen kam er nach dem Studium wieder zurück, übernahm die einzige Apotheke Amorbachs, heiratete seine Jugendliebe und führt seitdem ein erfülltes, glückliches Leben.“"
                                            },
                                            {
                                                "example_id": "b4b54b60-3ff5-49b3-b095-b1f58eec42ef",
                                                "sense_id": "6ae0fb38-35be-3dbb-99ed-071d10e1b3d3",
                                                "text": "Gerne erinnere ich mich zurück an meine Jugendliebe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8aa53d94-85be-3c3b-a80a-69dca86bf416",
