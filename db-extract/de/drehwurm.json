                ],
                "senses": [
                    {
                        "sense_id": "69c76453-a726-3db8-a07a-d552023468eb",
                        "entry_id": "27cc6e80-498b-3a8a-bd62-59a462be7f5d",
                        "glosses": [
                            "Finne einer Bandwurmart, des Quesenbandwurms, die die Drehkrankheit bei Schafen verursacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d7107f8-5b90-4660-b98e-9d2972c91731",
                                "sense_id": "69c76453-a726-3db8-a07a-d552023468eb",
                                "text": "Eine laienhafte Erklärung für diese Verhaltensauffälligkeit der Schafe war die Annahme, dass sie den sogenannten Drehwurm hatten. In Wirklichkeit wurde dieser zwanghafte Bewegungsdrang, das wusste man, durch die Larven des Hundebandwurms ausgelöst.“"
                            },
                            {
                                "example_id": "84ec4671-bb86-4b48-971d-f17acf60016b",
                                "sense_id": "69c76453-a726-3db8-a07a-d552023468eb",
                                "text": "Der Bandwurm iſt nicht von Bedeutung, deſto wichtiger iſt feine Finne, die als Drehwurm oder Hirnqueſe (Coenurus cerebralis) allgemein bekannt iſt."
                            },
                            {
                                "example_id": "70dafff0-fb9c-4ae2-bf43-ae76d94154d1",
                                "sense_id": "69c76453-a726-3db8-a07a-d552023468eb",
                                "text": "„Während der großen Hitze bekamen fünfundzwanzig Schafe den Drehwurm und krepierten kurz darauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5c3341fe-7730-303b-8293-0abcc16ece56",
                        "entry_id": "27cc6e80-498b-3a8a-bd62-59a462be7f5d",
                        "glosses": [
                            "Verminderung des Gleichgewichtssinns: Schwindelgefühl; verrückt sein, irre sein"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f63cc786-534d-4285-9969-24d7ba8a7e87",
                                "sense_id": "5c3341fe-7730-303b-8293-0abcc16ece56",
                                "text": "Wenn wir uns längere Zeit um uns selbst drehen und dann plötzlich stehenbleiben bekommen wir einen Drehwurm. Der Boden scheint zu schwanken, während sich alles um uns herum weiterdreht."
                            },
                            {
                                "example_id": "9868a77b-c48c-44a5-9d15-c2664156463e",
                                "sense_id": "5c3341fe-7730-303b-8293-0abcc16ece56",
                                "text": "Heute stellen wir euch […] die \"Folia\" vor: Eine Tanzmusik, bei der man garantiert einen Drehwurm bekommt."
                            },
                            {
                                "example_id": "ca02a429-43ea-4045-aa62-334ddf45d70c",
                                "sense_id": "5c3341fe-7730-303b-8293-0abcc16ece56",
                                "text": "Beim Rhönrad lauert der Drehwurm - daher solltest du schwindelfrei sein, bevor du \"einsteigst\" …"
                            },
                            {
                                "example_id": "a406712a-b9d4-4858-9114-51ee643c6748",
                                "sense_id": "5c3341fe-7730-303b-8293-0abcc16ece56",
                                "text": "Mitten im großen Rund aus Publikum und Orchester in der Thormannhalle in Rendsburg auf einem Podest dirigierte Simon Gaudenz mal nach links, dann nach rechts, nach hinten und nach vorn. Einen Drehwurm hat er bis jetzt nicht bekommen. Das sei kein Problem, denn er drehe sich ja immer in dieselbe Richtung, meint der Dirigent."
                            },
                            {
                                "example_id": "430198c9-8b75-4ca2-8b1b-f7adf3d4ce41",
                                "sense_id": "5c3341fe-7730-303b-8293-0abcc16ece56",
                                "text": "Mein zweites Jahr in der Region gibt mir nun die Chance, meinen Tagesrekord von sieben Mass Bier zu überbieten. […] Es machte sich dieses wärmende Gefühl im Körper breit, doch nach vier Mass Bier verwandelte es sich plötzlich zu einem Drehwurm, ich fühlte mich wie ein kopfloses Huhn, wenn es noch herumläuft."
                            },
                            {
                                "example_id": "03f04f62-661c-46eb-a30a-cab2dce2a672",
                                "sense_id": "5c3341fe-7730-303b-8293-0abcc16ece56",
                                "text": "Wenn Nick Hardman-Mountford vor dem Rechner sitzt, kriegt er schnell einen Drehwurm. Der australische Forscher und seine Kollegen haben vermutlich so viele rotierende Meereswirbel untersucht wie noch niemand vor ihnen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
