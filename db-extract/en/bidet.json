            {
                "entry_id": "2985b603-72e3-3e53-9863-7e78be4d69ad",
                "word": "Bidet",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f118da90-59d3-32fa-9466-e5fce27fa5b8",
                        "entry_id": "2985b603-72e3-3e53-9863-7e78be4d69ad",
                        "glosses": [
                            "Joe Biden."
                        ],
                        "tags": [
                            "Internet",
                            "US",
                            "derogatory",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "0ccc7ab5-6f5b-430c-8338-2ee908a1dbe8",
                                "sense_id": "f118da90-59d3-32fa-9466-e5fce27fa5b8",
                                "text": "That's Joe Bidet."
                            },
                            {
                                "example_id": "48ccf801-93f0-4421-8331-abb7a599aa1f",
                                "sense_id": "f118da90-59d3-32fa-9466-e5fce27fa5b8",
                                "text": "Every minute it continues, it makes the aftermath problems more frightening to me,\" said Sen. Joe \"Buckwheat\" Bidet, Democrapic Chairman of the Foreign Relations Committee. Speaking to the Council on Foreign Relations, a leftist group of foreign policy wonks, Bidet said he feels that a little careful bombing might be needed to help protect U.S. Special Forces operations, but it creates a scary problem. Bidet stressed that, like most Democratic weenies, he is afraid to challenge President Bush - but the \"honeymoon' might get rockier soon.\""
                            },
                            {
                                "example_id": "7825ced4-b7c6-4cf8-96b4-952434c5eaf5",
                                "sense_id": "f118da90-59d3-32fa-9466-e5fce27fa5b8",
                                "text": "If Obama chose Joe Robinet Bidet for a running mate, he's not just covering his ass, he's cleaning it!"
                            },
                            {
                                "example_id": "14cbb37d-ee7b-49af-ab90-ce37fda739b1",
                                "sense_id": "f118da90-59d3-32fa-9466-e5fce27fa5b8",
                                "text": "Trump calls Biden (Joe BIDET) 'another low I.Q. individual' after 2020."
                            },
                            {
                                "example_id": "7e7be4d7-883f-4e04-abfb-e710d4fafcbb",
                                "sense_id": "f118da90-59d3-32fa-9466-e5fce27fa5b8",
                                "text": "Kamala Harris became the first woman to be given presidential powers on Friday as Joe Biden briefly transferred authority while he underwent a colonoscopy. Whether he's shitting his pants or farting on royalty, the *fake* president is usually causing a stink. Now they're even shoving cameras up his arse to prove it can talk."
                            }
                        ]
                    }
                ],
