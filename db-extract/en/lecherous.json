                                "target_senses": [
                                    {
                                        "sense_id": "a5ae69db-35e5-32bd-83f9-dce67f0c5ce0",
                                        "entry_id": "df8c8048-b9ba-3171-b173-22bcd2f9fdef",
                                        "glosses": [
                                            "begierig nach etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adc20307-d13f-49db-9d6a-b0cbf7a1e4cb",
                                                "sense_id": "a5ae69db-35e5-32bd-83f9-dce67f0c5ce0",
                                                "text": "„Also: die Frau ist naschhaft, immer lüstern nach Sensationen und zu Sinnlichkeit aufgelegt, der Grausamkeit nicht abgeneigt, hysterisch, begeisterte Lügnerin, eifersüchtig noch auf den Mann, den sie nicht mehr liebt, mäßig begabt im Geiste und für theoretische und zarte Probleme gänzlich ohne Interesse (nur Neulinge langweilen sie damit, Erfahrenere gehen direkt aufs Ziel los), dafür in der Praxis der Liebesangelegenheiten dem Manne weit überlegen usw.“"
                                            },
                                            {
                                                "example_id": "7409082b-e8cc-413e-bad1-d12f23565d2f",
                                                "sense_id": "a5ae69db-35e5-32bd-83f9-dce67f0c5ce0",
                                                "text": "„Lüstern nach Erfolg bei den Frauen und stets geneigt, eine flüchtige Grille wie eine ernste Leidenschaft anzusehen, brauchte er nur in die Hände gewisser Charaktere zu fallen, um zu den äußersten Unbesonnenheiten verlockt zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2db2b96f-e0c1-3ff5-a19a-431a1cb759ab",
                                        "entry_id": "df8c8048-b9ba-3171-b173-22bcd2f9fdef",
                                        "glosses": [
                                            "begierig nach sexuellen Handlungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7757247b-5270-424c-94f0-32ce76f384f5",
                                                "sense_id": "2db2b96f-e0c1-3ff5-a19a-431a1cb759ab",
                                                "text": "Die Frau ist echt lüstern."
                                            },
                                            {
                                                "example_id": "8187e737-bff0-4ad1-9f0d-6614ba8fb420",
                                                "sense_id": "2db2b96f-e0c1-3ff5-a19a-431a1cb759ab",
                                                "text": "„Wie kann man heute noch begeistert sein von einer fast nackten Frau, die auf einem fernen Planeten dem Blick lüsterner Aliens ausgesetzt ist?“"
                                            },
                                            {
                                                "example_id": "187812d2-8e23-4c69-8714-03121892af95",
                                                "sense_id": "2db2b96f-e0c1-3ff5-a19a-431a1cb759ab",
                                                "text": "„Und überhaupt; Signor Capuzzi ist sehr zornig, hat doch dieser Bartputzer seine Marianna gekonterfeit, dass das Porträt des Mädchens von ganz Rom mit gierigen, lüsternen Blicken beleidigt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "lüstern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3833acd7-3f12-33fa-87a7-9b58a454b89f",
                                        "entry_id": "eb95ad7b-7a3d-34c6-984c-3b2782f9fbb1",
                                        "glosses": [
                                            "großes Verlangen nach etwas haben, Lust auf etwas verspüren"
                                        ],
                                        "tags": [
                                            "gehoben",
                                            "impersonal",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10543167-8398-42f7-a5fe-5c9d88086db6",
                                                "sense_id": "3833acd7-3f12-33fa-87a7-9b58a454b89f",
                                                "text": "„Es lüstert mich nach Speis und Trank.“"
                                            },
                                            {
                                                "example_id": "3c06000c-3496-4254-9603-b76982d90683",
                                                "sense_id": "3833acd7-3f12-33fa-87a7-9b58a454b89f",
                                                "text": "„Ihr lüstert nach Sensation?“"
                                            },
                                            {
                                                "example_id": "ebf5b080-d42f-494a-93bd-711d6c6358a2",
                                                "sense_id": "3833acd7-3f12-33fa-87a7-9b58a454b89f",
                                                "text": "„‚Sag mir mal was richtig Dreckiges‘, lüsterte der Alte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
