                "senses": [
                    {
                        "sense_id": "7076a3bb-affe-33f5-897b-780023e072c3",
                        "entry_id": "30621342-7b49-3a46-a671-27a64b89199e",
                        "glosses": [
                            "Relatif à la civilisation née du mélange des civilisations romaine et gauloise, après la conquête de la Gaule par Jules César."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "deede5b6-c8b8-4a2d-993b-73b78d45458e",
                                "sense_id": "7076a3bb-affe-33f5-897b-780023e072c3",
                                "text": "Quant aux citoyens de Tours, ils accueillirent pacifiquement le général gallo-romain, qui prit possession de la place au nom du roi Sighebert."
                            },
                            {
                                "example_id": "aa866eef-a991-4bcb-bfcc-295e41d7ccc4",
                                "sense_id": "7076a3bb-affe-33f5-897b-780023e072c3",
                                "text": "Un aqueduc du IIᵉ siècle, long de 3 km amenait l’eau de la fontaine Bonnet pour alimenter des thermes gallo-romains, situés à un carrefour des voies antiques près de l’actuel presbytère d’Arthon."
                            },
                            {
                                "example_id": "49bce69c-0319-410c-9e6d-f96d99de1152",
                                "sense_id": "7076a3bb-affe-33f5-897b-780023e072c3",
                                "text": "Il est exclu, à l’heure actuelle, de discerner des tendances régionales dans le mobilier gallo-romain trouvé à Jublains et dans les sites proches."
                            },
                            {
                                "example_id": "26ba6b89-386d-47f5-b8e6-af208219be59",
                                "sense_id": "7076a3bb-affe-33f5-897b-780023e072c3",
                                "text": "Par ailleurs, il existe un ferrier gallo-romain à Bonval, un autre dans le village même de Villethierry."
                            }
                        ]
                    }
                ],
