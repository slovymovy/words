                        "examples": [
                            {
                                "example_id": "9c7c215b-02df-4be5-878a-78bef55f2627",
                                "sense_id": "d738f566-e0b9-3825-a9fc-f375d4ae8e05",
                                "text": "„Die Rhombenwanze überwintert als Imago im trockenen Bodenstreu, unter Gehölzen oder in Grashorsten, gelegentlich auch weitab ihrer Wirtspflanzen.“"
                            },
                            {
                                "example_id": "99c2fcd5-382c-4fa6-976e-5ddd5fff6cae",
                                "sense_id": "d738f566-e0b9-3825-a9fc-f375d4ae8e05",
                                "text": "„Ein Problem ist, dass die Queen Mary weitab der Touristenziele liegt: Von Disneyland, Hollywood oder Downtown L.A. braucht man ein bis zwei Stunden.“"
                            },
                            {
                                "example_id": "0cd4653f-c197-4a03-ac14-965ec38d55c6",
                                "sense_id": "d738f566-e0b9-3825-a9fc-f375d4ae8e05",
                                "text": "Weitab der Zivilisation findet man noch unberührte Natur."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
