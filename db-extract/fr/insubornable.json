                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "409527e8-4c57-3bb5-b324-49d18843e5d5",
                                        "entry_id": "5833f345-a3f1-3731-a440-e6b4a77681e0",
                                        "glosses": [
                                            "nicht bestechlich, nicht zu bestechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1383e7a5-a8f5-4ea4-99bb-f12064770a74",
                                                "sense_id": "409527e8-4c57-3bb5-b324-49d18843e5d5",
                                                "text": "„Er geißelte scharf jene Verräter des Volksglückes, die nicht unbestechlich sind, keine reinen Hände haben und ihre Kräfte, welche sie dem Dienste des bedrängten Vaterlandes weihen sollten, an Tändeleien der Liehe vergeuden.“"
                                            },
                                            {
                                                "example_id": "3d35e38f-860c-4f2c-9739-0dd78968e682",
                                                "sense_id": "409527e8-4c57-3bb5-b324-49d18843e5d5",
                                                "text": "„Es war eine schmerzliche Lehre, die ihm das Mädchen damals erteilt hatte; aber böse hatte Doktor Herzfeld ihr doch nicht sein können, als er sich von ihr abwandte. Denn er fühlte, daß jene eben unbestechlich war und um Vorteile nicht ihre Seele verkaufte, ihre junge Seele, die den anderen, den Ihrigen, der Jugend gehörte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
