                "senses": [
                    {
                        "sense_id": "010aa84f-fb82-3ac9-8e66-45ee08c49316",
                        "entry_id": "bfc6359b-7892-341a-892c-f96ffe228d45",
                        "glosses": [
                            "To compute; to count or consider."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7a33a89f-1432-4916-97a1-eb764bca32c9",
                                "sense_id": "010aa84f-fb82-3ac9-8e66-45ee08c49316",
                                "text": "For some were warded in the Pittie-vault, some set caution to remove from the town, after they had compted and reckoned for their tavernry with their mistresses; […]"
                            },
                            {
                                "example_id": "d0fe6973-756c-4c5e-ad12-00fdad841841",
                                "sense_id": "010aa84f-fb82-3ac9-8e66-45ee08c49316",
                                "text": "So shall my ryghteousnes aunswere for me in time to come: for it shal come for my rewarde before thy face. And euery one that is not specked and partie amongst the goates, & blacke amongst the sheepe, let it be compted theft in me."
                            },
                            {
                                "example_id": "f2cb3377-0d62-4c52-920e-c145563de6d7",
                                "sense_id": "010aa84f-fb82-3ac9-8e66-45ee08c49316",
                                "text": "The gyftes of fortune compt the, as borowed ware\nWho so delyteth to prouen and assaye"
                            }
                        ]
                    }
