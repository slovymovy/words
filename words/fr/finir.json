{
    "word_family": [
        "fin",
        "final",
        "finalement",
        "finaliser",
        "finition",
        "infini"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccb911c2-ba2f-3c20-8785-d603208d7fe2",
                    "sense_definition": "Achever, mener à son terme une activité, un travail ou une tâche.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "achever_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants doivent <w>finir</w> leurs devoirs avant de regarder la télévision."
                        },
                        {
                            "text": "J'ai enfin <w>fini</w> la lecture de ce roman passionnant ce matin."
                        }
                    ],
                    "synonyms": [
                        "terminer"
                    ],
                    "antonyms": [
                        "commencer"
                    ],
                    "common_phrases": [
                        "finir ses devoirs",
                        "finir un travail"
                    ]
                },
                {
                    "sense_id": "3270f715-4750-3ec2-a163-05e078f93046",
                    "sense_definition": "Prendre fin, arriver à son terme dans le temps ou dans l'espace.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "prendre_fin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cours de français <w>finit</w> à midi tous les vendredis."
                        },
                        {
                            "text": "Le concert <w>finira</w> probablement très tard dans la soirée."
                        }
                    ],
                    "synonyms": [
                        "terminer"
                    ],
                    "antonyms": [
                        "commencer"
                    ],
                    "common_phrases": [
                        "finir à l'heure",
                        "finir bientôt"
                    ]
                },
                {
                    "sense_id": "e5f23a1f-17c0-3370-a416-de71f35f222e",
                    "sense_definition": "Aboutir finalement à une action après un certain temps ou des hésitations (suivi de la préposition « par »).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "issue_resultat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après de longues discussions, ils ont <w>fini</w> par accepter notre proposition."
                        },
                        {
                            "text": "Elle hésitait beaucoup mais elle a <w>fini</w> par acheter cette robe."
                        }
                    ],
                    "common_phrases": [
                        "finir par accepter",
                        "finir par comprendre"
                    ]
                },
                {
                    "sense_id": "2f92ac1b-0a4b-3165-9bd1-e7ed3131475f",
                    "sense_definition": "Mettre un terme définitif à une situation pénible ou intolérable (principalement dans la tournure « en finir »).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cesser_difficulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est grand temps d'en <w>finir</w> avec cette dispute inutile."
                        },
                        {
                            "text": "Nous devons agir vite pour en <w>finir</w> avec ces retards répétés."
                        }
                    ],
                    "synonyms": [
                        "terminer"
                    ],
                    "common_phrases": [
                        "en finir avec"
                    ]
                },
                {
                    "sense_id": "517636f7-1f11-37d8-a166-70d41fa29b73",
                    "sense_definition": "Arriver au terme de sa vie ; mourir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mourir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux monarque a <w>fini</w> paisiblement dans son lit entouré de ses proches."
                        },
                        {
                            "text": "Le poète maudit a <w>fini</w> dans une grande pauvreté à l'hôpital."
                        }
                    ],
                    "synonyms": [
                        "mourir"
                    ]
                }
            ]
        }
    ]
}