                ],
                "senses": [
                    {
                        "sense_id": "3f6e97cd-2f4f-389a-9326-af9c2adf9843",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "Petit récipient en verre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e13424-decf-489b-a62a-adb36864c2d5",
                                "sense_id": "3f6e97cd-2f4f-389a-9326-af9c2adf9843",
                                "text": "Brutalement il arracha le papier qui enveloppait les pastilles et vite le précieux éclat chatoya au creux de ses paumes. Tremblant de la tête aux pieds, il retira les quatre verrines du coffre et les mit dans son sac."
                            }
                        ]
                    },
                    {
                        "sense_id": "e46b81f8-b9d5-3ec0-a0b2-1d5538dfe693",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "Bocal à confiture."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "746a0b57-139b-3fea-9128-1abd9945c1f1",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "Petit récipient en verre, utilisé pour servir un mets de façon décorative. cf. terrine"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c6cba554-eed5-3fa9-83ba-95260beda743",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "Vérine, lampe de verre suspendue au-dessus du compas, pour éclairer le timonier pendant la nuit.(Variante orthographique : verine.)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "552e5965-8d90-3cbd-8128-79b1c44b64c5",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "Sorte de cloche de verre composée d'une ossature métallique vitrée."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6a57dce0-ba7e-3724-9f3a-0672ce88aace",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "→ voir forte vis."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8a40a3fb-731b-3e1f-a807-a4bd489940b1",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "Synonyme de verrière."
                        ],
                        "tags": [],
                        "note": ": « Ils ont dit aussi verrine pour verrière, dans la signification, l’une et l’autre, d’une fenêtre de verre en général », Bernard de La Monnoye, François Fertiault, Lavigne, 1842, s.v. Vareire",
                        "examples": [
                            {
                                "example_id": "df53caa6-f41f-4e30-aa42-7e0a843d7912",
                                "sense_id": "8a40a3fb-731b-3e1f-a807-a4bd489940b1",
                                "text": "Nous arrivons très-facilement à la chambre à coucher du planteur, intérieurement éclairée par une verrine."
                            }
                        ]
                    },
                    {
                        "sense_id": "055d74c3-23f6-3364-8d49-297ca1bff41e",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "Synonyme de verrière dans le sens de vitre placée devant un tableau pour le protéger."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a92dd49f-2f8a-3229-9743-793b69897960",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "Synonyme de vitrine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "645ee812-543b-4e06-9959-aac634edf6e7",
                                "sense_id": "a92dd49f-2f8a-3229-9743-793b69897960",
                                "text": "La rue de la Platería (de l’orfèvrerie) éblouit les yeux par ses devantures et ses verrines éclatantes de bijoux."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f12195f-7d91-347e-9b01-07a27925cf5e",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "Discours de Cicéron contre Verrès."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f6b4b011-82e1-3a43-8026-a3a5d1584d3e",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "Pièce de verre, de forme variable, qui diffuse la lumière dans une lampe ou un luminaire."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ad0f4db3-9bb0-3280-bfa6-c8581d064e1e",
                        "entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "glosses": [
                            "Boîtier contenant plusieurs avertisseurs lumineux, et indiquant l'état de l'automate d'une machine : en attente, en fonctionnement, alarme…"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "775180b7-a18c-4295-b514-e61c336a9a24",
                        "source_entry_id": "c22f74b2-9854-3450-b41b-61257751b821",
                        "source_sense_description": "Petit récipient en verre",
                        "target_lang_word": "Glas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "064b10cd-2d7a-35df-878a-f54996d16c13",
                                        "entry_id": "be79516a-9362-323e-ae8c-e21c7df39737",
                                        "glosses": [
                                            "durchsichtiger amorpher Feststoff"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc76e151-49c2-455b-ad27-f18947bf0a6b",
                                                "sense_id": "064b10cd-2d7a-35df-878a-f54996d16c13",
                                                "text": "Glas wird in einem Ofen aus verschiedenen chemischen Stoffen durch große Hitze hergestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c0567631-20ff-317c-a33a-7da65de81d38",
                                        "entry_id": "be79516a-9362-323e-ae8c-e21c7df39737",
                                        "glosses": [
                                            "Gegenstand aus [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d464d30-62fa-47f2-9f5d-a4924928c211",
                                                "sense_id": "c0567631-20ff-317c-a33a-7da65de81d38",
                                                "text": "Ich brauche keine dicken Gläser für meine Brille."
                                            },
                                            {
                                                "example_id": "19aed2e1-8cf0-4d05-baa2-4921761fe4f7",
                                                "sense_id": "c0567631-20ff-317c-a33a-7da65de81d38",
                                                "text": "„Aber alle realen Gläser weisen mikroskopische Kerben und Fehlstellen auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "87ad83c5-3b54-34aa-b951-81dfb2624b51",
                                        "entry_id": "be79516a-9362-323e-ae8c-e21c7df39737",
                                        "glosses": [
                                            "Gefäß für Flüssigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d77415a2-a551-4281-a344-b7a8fa26a674",
                                                "sense_id": "87ad83c5-3b54-34aa-b951-81dfb2624b51",
                                                "text": "Beim Abwaschen ging ein Glas kaputt."
                                            },
                                            {
                                                "example_id": "6a2273e5-56f5-4c67-b271-39ecd5bb7706",
                                                "sense_id": "87ad83c5-3b54-34aa-b951-81dfb2624b51",
                                                "text": "„Ich hob mein Glas und trank es aus.“"
                                            },
                                            {
                                                "example_id": "db18ae98-0115-4fae-8c3a-b5bfae136b35",
                                                "sense_id": "87ad83c5-3b54-34aa-b951-81dfb2624b51",
                                                "text": "„Kommt man in Bacharach mit dem Ausflugsdampfer oder der Fähre an, trifft man als Allererstes, mitten an der Promenade, in einem kleinen Landschaftsgarten, auf drei Skulpturen, die zusammen um einen Tisch sitzen, auf dem zwei Gläser und eine Weinflasche stehen.“"
                                            },
                                            {
                                                "example_id": "284d2f04-d546-4fd7-a641-b83680788587",
                                                "sense_id": "87ad83c5-3b54-34aa-b951-81dfb2624b51",
                                                "text": "„Er spült das Glas und stellt es kopfüber neben das Spülbecken.“"
                                            },
                                            {
                                                "example_id": "3895f4bb-3ac1-496e-822b-4b0d630acb29",
                                                "sense_id": "87ad83c5-3b54-34aa-b951-81dfb2624b51",
                                                "text": "„Er nahm die Gläser und goß sie voll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1d7e837c-3a7f-3bf8-9023-bd44a66943f1",
                                        "entry_id": "be79516a-9362-323e-ae8c-e21c7df39737",
                                        "glosses": [
                                            "Behälter für Lebensmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e81b10b3-a5d7-45f3-8c58-d34b991b1152",
                                                "sense_id": "1d7e837c-3a7f-3bf8-9023-bd44a66943f1",
                                                "text": "Sauerkraut kann man im Glas oder in der Metalldose kaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1b621514-a93c-3ed5-9e2b-c17b6debb1e0",
                                        "entry_id": "be79516a-9362-323e-ae8c-e21c7df39737",
                                        "glosses": [
                                            "Menge einer Flüssigkeit, die in [3] passt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b36eeac9-8828-44ab-834b-6aefd76905a8",
                                                "sense_id": "1b621514-a93c-3ed5-9e2b-c17b6debb1e0",
                                                "text": "George hat schon drei Gläser Wein getrunken."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "95974154-713f-39c1-9a53-907e18f54784",
                                        "entry_id": "be79516a-9362-323e-ae8c-e21c7df39737",
                                        "glosses": [
                                            "kurz für Fernglas, Opernglas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ab4c5f1-b900-43f7-ba07-0d7c5f1c70d3",
                                                "sense_id": "95974154-713f-39c1-9a53-907e18f54784",
                                                "text": "„Er richtete sein Glas auf die Diligent, um zu sehen, ob man dort irgendwelche Signalflaggen aufgezogen hatte, die ihn darüber informierten, was für Aktivitäten für diesen Tag vorgesehen waren.“"
                                            },
                                            {
                                                "example_id": "995985ac-26ea-4e9f-b74d-5bad2529e83b",
                                                "sense_id": "95974154-713f-39c1-9a53-907e18f54784",
                                                "text": "„Nur dann, wenn einer sein Glas gegen den Himmel richtet, kommt ein wenig Bewegung in die Gruppe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Glas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09e5bfa2-61e4-3e37-b4a4-f41899b77e3d",
                                        "entry_id": "b46918b0-a862-3a91-bc3e-1019cab48c48",
                                        "glosses": [
                                            "Zeitangabe für eine halbe Stunde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e48b5c72-0222-4aae-ab68-cef91fba86a9",
                                                "sense_id": "09e5bfa2-61e4-3e37-b4a4-f41899b77e3d",
                                                "text": "Drei Glasen der ersten Wacht (Also 1½ Stunden in der ersten Wache)."
                                            },
                                            {
                                                "example_id": "7d6d2aa7-946e-4e10-bf9f-7edea063ef79",
                                                "sense_id": "09e5bfa2-61e4-3e37-b4a4-f41899b77e3d",
                                                "text": "„Ich hörte sieben Glasen schlagen, was bedeutete, daß in einer halben Stunde die Wache abgelöst werden würde.“"
                                            },
                                            {
                                                "example_id": "70dc3335-c636-42b8-878f-1f1919117c61",
                                                "sense_id": "09e5bfa2-61e4-3e37-b4a4-f41899b77e3d",
                                                "text": "„Auf der Kommandobrücke wird auch geläutet, alle halben Stunden: um halb ein Uhr nachts: ein Glas, um eins: zwei Glasen und so fort bis zu den acht Glasen, die für den Offizier, den Rudergänger und mich das Ende des Dienstes bedeuten.“"
                                            },
                                            {
                                                "example_id": "d2dfdc24-5027-4a7d-9580-963198f471ba",
                                                "sense_id": "09e5bfa2-61e4-3e37-b4a4-f41899b77e3d",
                                                "text": "„Oben schlug es vier Glasen, die Wachablösung trampelte durch die Gänge.“"
                                            },
                                            {
                                                "example_id": "b309d13b-d5af-403e-afb1-efdfa6963120",
                                                "sense_id": "09e5bfa2-61e4-3e37-b4a4-f41899b77e3d",
                                                "text": "„Alles, was ich höre, ist eine ferne Schiffsuhr, die Glasen schlägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
