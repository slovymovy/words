                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf48b4a-0e24-40a7-bb6a-80e18aa71285",
                                                "sense_id": "c93efa78-9150-3f30-92f8-b4f098af8885",
                                                "text": "Film and dance theory offer a productive vocabulary for considering the effects of these mutings and deafenings."
