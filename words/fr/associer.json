                    "frequency": "Middle",
                    "semantic_group_id": "partenariat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La directrice a voulu <w>associer</w> son adjoint aux décisions stratégiques du groupe."
                        },
                        {
                            "text": "Ce médecin décide d'<w>associer</w> un jeune confrère à son cabinet médical."
