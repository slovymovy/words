        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed63e9b6-9045-3888-af88-771300d348e2",
                    "sense_definition": "Cultivated land inhabited by sedentary agriculturalists, in contrast to the nomad pastoralists of the steppe or desert.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The empire expanded from the <w>sown</w> into the surrounding arid regions.",
                            "target_lang_translations": {
                                "nl": "Het rijk breidde zich uit vanuit het <w>bouwland</w> naar de omliggende droge gebieden."
                            }
                        },
                        {
                            "text": "Trade flourished between the people of the <w>sown</w> and the desert nomads.",
                            "target_lang_translations": {
                                "nl": "De handel bloeide tussen de mensen van het <w>cultuurland</w> en de woestijnnomaden."
                            }
                        }
                    ],
                    "synonyms": [
                        "farmland",
                        "cultivated land"
                    ],
                    "antonyms": [
                        "wilderness",
                        "desert"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or specialized geographical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Bebouwd land bewoond door landbouwers, vaak gebruikt in historische context als tegenhanger van woestijngebieden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bouwland",
                                "target_lang_sense_clarification": "land dat geschikt is voor landbouw"
                            },
                            {
                                "target_lang_word": "cultuurland",
                                "target_lang_sense_clarification": "door mensen bewerkt en bewoond land"
                            }
                        ]
                    }
                }
            ]
        }
