                ],
                "senses": [
                    {
                        "sense_id": "f4ddb582-fc1d-3cf2-9448-fc37f37f33d2",
                        "entry_id": "f64dc63a-602f-3de4-8102-1bdc452d684f",
                        "glosses": [
                            "to learn, to study; to train for"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5bf9d67a-be87-42d6-8820-dd6dcc7a4c46",
                                "sense_id": "f4ddb582-fc1d-3cf2-9448-fc37f37f33d2",
                                "text": "Она́ хо́чет вы́учиться на до́ктора.",
                                "translation": "She wants to train to be a doctor.",
                                "english": "She wants to train to be a doctor."
                            },
                            {
                                "example_id": "c98484a6-2f71-48fa-81bf-d68cb3c4f219",
                                "sense_id": "f4ddb582-fc1d-3cf2-9448-fc37f37f33d2",
                                "text": "Зна́ешь, ско́лько повара́м ну́жно вре́мени, что́бы вы́учиться э́тому?",
                                "translation": "Do you know how long it takes chefs to learn that?",
                                "english": "Do you know how long it takes chefs to learn that?"
                            },
                            {
                                "example_id": "14d0fe7c-3b7c-49f6-9480-fe23fff8b5bd",
                                "sense_id": "f4ddb582-fc1d-3cf2-9448-fc37f37f33d2",
                                "text": "Ра́зве ты не хоте́л вы́учиться, что́бы помога́ть с де́лами?",
                                "translation": "Didn't you want to study to help with the business?",
                                "english": "Didn't you want to study to help with the business?"
                            },
                            {
                                "example_id": "d4f7ec1a-ef5d-42bd-bb93-a53af539fdc0",
                                "sense_id": "f4ddb582-fc1d-3cf2-9448-fc37f37f33d2",
                                "text": "За пять лет ты так и не вы́учился хоро́шим мане́рам.",
                                "translation": "You've learnt no manners in five years.",
                                "english": "You've learnt no manners in five years."
                            }
                        ]
                    },
