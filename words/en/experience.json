{
    "word_family": [
        "experiential",
        "experiment",
        "experimental",
        "expert",
        "expertise",
        "inexperience",
        "inexperienced"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9ccb86bf-bf65-3f42-9eb6-80c98424c62d",
                    "sense_definition": "The knowledge or skill acquired by a period of practical experience of something, especially in a particular profession.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "knowledge_and_skills",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most employers prefer candidates who have previous work <w>experience</w> in the industry.",
                            "target_lang_translations": {
                                "ru": "Большинство работодателей предпочитают кандидатов, имеющих предыдущий рабочий <w>опыт</w> в данной отрасли."
                            }
                        },
                        {
                            "text": "She gained a lot of <w>experience</w> while working as an intern last summer.",
                            "target_lang_translations": {
                                "ru": "Она получила большой <w>опыт</w>, работая стажером прошлым летом."
                            }
                        }
                    ],
                    "antonyms": [
                        "inexperience"
                    ],
                    "common_phrases": [
                        "work experience",
                        "lack of experience",
                        "years of experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знания или навыки, приобретенные в процессе практической деятельности, особенно в определенной профессии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опыт",
                                "target_lang_sense_clarification": "профессиональный или жизненный"
                            },
                            {
                                "target_lang_word": "стаж",
                                "target_lang_sense_clarification": "продолжительность работы"
                            },
                            {
                                "target_lang_word": "опытность",
                                "target_lang_sense_clarification": "наличие большого опыта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c301d9c6-131d-361d-bf20-ddb07c642b8f",
                    "sense_definition": "An event or occurrence which leaves an impression on someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "event_impression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traveling alone through Asia was a life-changing <w>experience</w> for him.",
                            "target_lang_translations": {
                                "ru": "Одиночное путешествие по Азии стало для него <w>событием</w>, изменившим жизнь."
                            }
                        },
                        {
                            "text": "It was a unique <w>experience</w> that I will never forget.",
                            "target_lang_translations": {
                                "ru": "Это был уникальный <w>опыт</w>, который я никогда не забуду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unique experience",
                        "unforgettable experience",
                        "learning experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие или случай, который оставляет впечатление у человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опыт",
                                "target_lang_sense_clarification": "пережитое событие"
                            },
                            {
                                "target_lang_word": "впечатление",
                                "target_lang_sense_clarification": "след в сознании"
                            },
                            {
                                "target_lang_word": "переживание",
                                "target_lang_sense_clarification": "душевное состояние от события"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ca9439e-db29-3f34-bae3-f9672527342b",
                    "sense_definition": "A value representing a character's progress in a role-playing game, often abbreviated as XP.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to defeat more monsters to earn enough <w>experience</w> to reach the next level.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно победить больше монстров, чтобы заработать достаточно <w>опыта</w> для перехода на следующий уровень."
                            }
                        },
                        {
                            "text": "The player gained <w>experience</w> points after completing the difficult quest.",
                            "target_lang_translations": {
                                "ru": "Игрок получил очки <w>опыта</w> после завершения сложного квеста."
                            }
                        }
                    ],
                    "synonyms": [
                        "experience points"
                    ],
                    "common_phrases": [
                        "earn experience",
                        "gain experience"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in gaming contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Значение, представляющее прогресс персонажа в ролевой игре, часто сокращаемое как XP."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опыт",
                                "target_lang_sense_clarification": "игровые очки"
                            },
                            {
                                "target_lang_word": "экспа",
                                "target_lang_sense_clarification": "игровой сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54a20e8c-6cf6-3ea9-be3e-5c0b93157d82",
                    "sense_definition": "The act of testing or trialing something; an experiment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "trial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old texts, the alchemist sought to make <w>experience</w> of the new metal's properties.",
                            "target_lang_translations": {
                                "ru": "В старинных текстах алхимик стремился провести <w>опыт</w> над свойствами нового металла."
                            }
                        },
                        {
                            "text": "They put the theory to the <w>experience</w> to see if it held true.",
                            "target_lang_translations": {
                                "ru": "Они подвергли теорию <w>испытанию</w>, чтобы проверить, верна ли она."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make experience"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English in this sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт тестирования или испытания чего-либо; эксперимент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опыт",
                                "target_lang_sense_clarification": "научный эксперимент"
                            },
                            {
                                "target_lang_word": "испытание",
                                "target_lang_sense_clarification": "проверка свойств"
                            },
                            {
                                "target_lang_word": "проба",
                                "target_lang_sense_clarification": "попытка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c3be49e-e3fd-3811-a8b0-b0d7c9e5e45c",
                    "sense_definition": "To encounter or undergo an event or occurrence; to feel an emotion or sensation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "undergo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people <w>experience</w> symptoms of anxiety before a major public speaking event.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>испытывают</w> симптомы тревоги перед важным публичным выступлением."
                            }
                        },
                        {
                            "text": "The city is currently <w>experiencing</w> a period of rapid economic growth.",
                            "target_lang_translations": {
                                "ru": "В настоящее время город <w>переживает</w> период бурного экономического роста."
                            }
                        }
                    ],
                    "synonyms": [
                        "undergo",
                        "have"
                    ],
                    "common_phrases": [
                        "experience pain",
                        "experience difficulties",
                        "experience growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Столкнуться с событием или пройти через него; почувствовать эмоцию или ощущение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испытывать",
                                "target_lang_sense_clarification": "чувство или состояние"
                            },
                            {
                                "target_lang_word": "переживать",
                                "target_lang_sense_clarification": "проходить через событие"
                            },
                            {
                                "target_lang_word": "сталкиваться",
                                "target_lang_sense_clarification": "встречать на пути"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}