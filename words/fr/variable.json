                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les astronomes observent attentivement cette étoile <w>variable</w> depuis plusieurs mois."
                        },
                        {
                            "text": "L'éclat d'une étoile <w>variable</w> peut changer en quelques jours seulement."
                        }
                    ],
                    "common_phrases": [
                        "étoile variable"
