                "translations": [
                    {
                        "translation_id": "f29c3ad0-823e-4ac6-93e3-83e362e7cb89",
                        "source_entry_id": "2cddac23-9563-3e65-9f10-3c1619837610",
                        "source_sense_id": "74e12861-9696-3500-9927-b562461368a3",
                        "target_lang_word": "crumble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5c28937-57f9-3e48-92da-cf4979650af1",
                                        "entry_id": "35fdd2e5-9ccb-388e-86a9-a23b1fb3d6f5",
                                        "glosses": [
                                            "To fall apart; to disintegrate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13737aae-b204-4283-a5ff-20e165894256",
                                                "sense_id": "a5c28937-57f9-3e48-92da-cf4979650af1",
                                                "text": "The bread roll crumbled when I tried to slice it; it was too stale."
                                            },
                                            {
                                                "example_id": "37f098bb-793b-4fc9-b0eb-27e943f20d0b",
                                                "sense_id": "a5c28937-57f9-3e48-92da-cf4979650af1",
                                                "text": "The empire crumbled when the ruler's indiscretions came to light."
                                            },
                                            {
                                                "example_id": "439ffc09-9351-42e7-a498-96cce831de29",
                                                "sense_id": "a5c28937-57f9-3e48-92da-cf4979650af1",
                                                "text": "Weren't you the one who tried to hurt me with goodbye? / Did you think I'd crumble? Did you think I'd lay down and die?"
                                            },
                                            {
                                                "example_id": "3aeba476-2805-440e-80af-eb285f3dd997",
                                                "sense_id": "a5c28937-57f9-3e48-92da-cf4979650af1",
                                                "text": "In 1989, as communism was beginning to crumble across Eastern Europe, just a few months before protesters started pecking away at the Berlin Wall, the Japanese game-making giant Nintendo reached across the world to unleash upon America its own version of freedom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a626b780-ded0-344d-888d-f45ced65ad79",
                                        "entry_id": "35fdd2e5-9ccb-388e-86a9-a23b1fb3d6f5",
                                        "glosses": [
                                            "To break into crumbs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78cc1ad4-1494-4acc-8018-490f4386efa7",
                                                "sense_id": "a626b780-ded0-344d-888d-f45ced65ad79",
                                                "text": "We crumbled some bread into the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b17add72-b733-3338-8b3f-37323a1314fa",
                                        "entry_id": "35fdd2e5-9ccb-388e-86a9-a23b1fb3d6f5",
                                        "glosses": [
                                            "To mix (ingredients such as flour and butter) in such a way as to form crumbs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "072ccd72-51f6-4f25-af48-694e30599326",
                                                "sense_id": "b17add72-b733-3338-8b3f-37323a1314fa",
                                                "text": "Using your fingers, crumble the ingredients with the fingertips, lifting in an upward motion, until the mixture is sandy and resembles large breadcrumbs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a3fdc67-9d35-3480-ab9f-69d263002ab5",
                                        "entry_id": "3d65b5d6-a3c6-323b-96e4-630b1ec6542f",
                                        "glosses": [
                                            "A dessert of British origin containing stewed fruit topped with a crumbly mixture of fat, flour, and sugar."
                                        ],
