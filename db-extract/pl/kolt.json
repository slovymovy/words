                                "target_senses": [
                                    {
                                        "sense_id": "3fd7e308-684d-3cb5-9e04-4e86433a1e1b",
                                        "entry_id": "82da77d0-66f2-3dad-9881-1ce312203248",
                                        "glosses": [
                                            "A young male horse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd91eac-7a14-4bbc-9ea1-d66189f376e7",
                                                "sense_id": "3fd7e308-684d-3cb5-9e04-4e86433a1e1b",
                                                "text": "The petty vices of boys are like the innocent kicks of colts, as yet imperfectly broken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00354735-150c-3c77-b8cb-62d9a56c2ff2",
                                        "entry_id": "82da77d0-66f2-3dad-9881-1ce312203248",
                                        "glosses": [
                                            "A young crane (bird)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f72ca593-bfee-3a4d-b211-c2a996ff150e",
                                        "entry_id": "82da77d0-66f2-3dad-9881-1ce312203248",
                                        "glosses": [
                                            "A youthful or inexperienced person; a novice."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92b68857-6895-4dcf-bfa1-dcc0713f7075",
                                                "sense_id": "f72ca593-bfee-3a4d-b211-c2a996ff150e",
                                                "text": "Ay, that's a colt indeed, for he doth nothing but / talk of his horse, and he makes it a great appropriation to / his own good parts that he can shoe him himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "988a4587-db09-3b43-9405-56b4308530e9",
                                        "entry_id": "82da77d0-66f2-3dad-9881-1ce312203248",
                                        "glosses": [
                                            "A youthful or inexperienced person; a novice.",
                                            "A professional cricketer during his first season."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32b7e551-1790-4973-8e26-2c4ccdf45fd0",
                                                "sense_id": "988a4587-db09-3b43-9405-56b4308530e9",
                                                "text": "The bowling is more promising in the colts than in the eleven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2b4db03-61bf-3a42-9f1e-fab3a1b75f41",
                                        "entry_id": "82da77d0-66f2-3dad-9881-1ce312203248",
                                        "glosses": [
                                            "A youthful or inexperienced person; a novice.",
                                            "A person who sits as a juryman for the first time."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4c0076c-c821-3f75-b3de-820ba0d51b8e",
