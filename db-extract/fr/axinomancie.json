                                "target_senses": [
                                    {
                                        "sense_id": "e71543cd-fea7-3677-89aa-3d4f948ac633",
                                        "entry_id": "46ed9261-e325-3594-a49b-77e54f1d0f7d",
                                        "glosses": [
                                            "Divination by saws or axes."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a5e856a-597a-41bf-958b-ee82907ae81d",
                                                "sense_id": "e71543cd-fea7-3677-89aa-3d4f948ac633",
                                                "text": "Diuination generally was done by diuers means […] by hatchets, Axinomancy"
                                            },
                                            {
                                                "example_id": "363d2d5f-a749-496f-826a-176e334131aa",
                                                "sense_id": "e71543cd-fea7-3677-89aa-3d4f948ac633",
                                                "text": "Axinomancy Was performed by balancing an axe on an upright stake, and the names of suspected persons being pronounced, it was supposed to point out the guilty by its motion."
                                            },
                                            {
                                                "example_id": "8be2b574-348e-4edf-92a6-3ca58d93440b",
                                                "sense_id": "e71543cd-fea7-3677-89aa-3d4f948ac633",
                                                "text": "Axinomancy, strictly so called, has varied somewhat in its modus operandi. A hatchet suspended by a cord was used to detect criminals or discover secrets: it twisted and turned in answer to relevant questions."
                                            }
                                        ]
                                    }
                                ]
                            }
