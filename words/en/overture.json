{
    "word_family": [
        "overt"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e777ac6-6e01-3466-bbf2-c6d084820da5",
                    "sense_definition": "A musical introduction to a longer piece of music or a dramatic work.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchestra played a beautiful <w>overture</w> before the opera began.",
                            "target_lang_translations": {
                                "de": "Das Orchester spielte eine wunderschöne <w>Ouvertüre</w>, bevor die Oper begann."
                            }
                        },
                        {
                            "text": "The musical <w>overture</w> set the mood for the entire performance.",
                            "target_lang_translations": {
                                "de": "Die musikalische <w>Ouvertüre</w> stimmte auf die gesamte Aufführung ein."
                            }
                        }
                    ],
                    "antonyms": [
                        "coda"
                    ],
                    "common_phrases": [
                        "musical overture"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein instrumentales Einleitungsstück zu einem längeren Musikwerk oder einer Oper."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ouvertüre",
                                "target_lang_sense_clarification": "Musikalisches Einleitungsstück"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecb75b68-69f7-332f-b5ac-c0fec705a091",
                    "sense_definition": "An approach or proposal made to initiate communication or establish a relationship.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company made an <w>overture</w> of peace to its main competitor.",
                            "target_lang_translations": {
                                "de": "Das Unternehmen machte seinem Hauptkonkurrenten einen <w>Annäherungsversuch</w> in Friedensabsicht."
                            }
                        },
                        {
                            "text": "He rejected every friendly <w>overture</w> made by his new neighbors.",
                            "target_lang_translations": {
                                "de": "Er wies jeden freundlichen <w>Annäherungsversuch</w> seiner neuen Nachbarn zurück."
                            }
                        }
                    ],
                    "synonyms": [
                        "proposal",
                        "approach"
                    ],
                    "common_phrases": [
                        "friendly overture"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Vorstoß oder Vorschlag, um eine Kommunikation zu beginnen oder eine Beziehung aufzubauen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Annäherungsversuch",
                                "target_lang_sense_clarification": "Versuch, Kontakt oder eine Beziehung aufzunehmen"
                            },
                            {
                                "target_lang_word": "Angebot",
                                "target_lang_sense_clarification": "Vorschlag zur Zusammenarbeit oder Einigung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7430bb94-ea88-3947-962c-22ce41d3d36c",
                    "sense_definition": "A medley of themes from a larger work, typically played at the beginning.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The concert featured an <w>overture</w> consisting of the most famous melodies from the show.",
                            "target_lang_translations": {
                                "de": "Das Konzert bot eine <w>Ouvertüre</w>, die aus den berühmtesten Melodien der Show bestand."
                            }
                        },
                        {
                            "text": "The orchestral <w>overture</w> captured the main themes of the entire symphony.",
                            "target_lang_translations": {
                                "de": "Die orchestrale <w>Ouvertüre</w> fing die Hauptthemen der gesamten Sinfonie ein."
                            }
                        }
                    ],
                    "antonyms": [
                        "coda"
                    ],
                    "common_phrases": [
                        "orchestral overture"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Medley aus Themen eines größeren Werkes, das meist zu Beginn gespielt wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ouvertüre",
                                "target_lang_sense_clarification": "Musikalisches Stück, das Themen eines Werkes zusammenfasst"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "863131bd-602e-3fde-85f5-16350f2c5f05",
                    "sense_definition": "The act of disclosing or revealing something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>overture</w> of the secret documents shocked the entire nation.",
                            "target_lang_translations": {
                                "de": "Die <w>Enthüllung</w> der geheimen Dokumente schockierte die ganze Nation."
                            }
                        },
                        {
                            "text": "His sudden <w>overture</w> of the truth changed everything.",
                            "target_lang_translations": {
                                "de": "Seine plötzliche <w>Offenbarung</w> der Wahrheit veränderte alles."
                            }
                        }
                    ],
                    "synonyms": [
                        "disclosure",
                        "revelation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Der Akt des Enthüllens oder Offenbarens von etwas."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Enthüllung",
                                "target_lang_sense_clarification": "Das Bekanntmachen von etwas Geheimen"
                            },
                            {
                                "target_lang_word": "Offenbarung",
                                "target_lang_sense_clarification": "Das Aufdecken einer Wahrheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee1a7f47-dc7c-3155-8371-3e38e2068db3",
                    "sense_definition": "A formal motion or proposal placed before a legislative or church body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee discussed the <w>overture</w> regarding new membership rules.",
                            "target_lang_translations": {
                                "de": "Das Komitee diskutierte den <w>Antrag</w> bezüglich der neuen Mitgliedschaftsregeln."
                            }
                        },
                        {
                            "text": "A formal <w>overture</w> was submitted to the assembly for review.",
                            "target_lang_translations": {
                                "de": "Ein formeller <w>Antrag</w> wurde der Versammlung zur Prüfung vorgelegt."
                            }
                        }
                    ],
                    "synonyms": [
                        "proposal",
                        "motion"
                    ],
                    "common_phrases": [
                        "formal overture"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein formeller Antrag oder Vorschlag, der einem Gremium zur Entscheidung vorgelegt wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Antrag",
                                "target_lang_sense_clarification": "Formeller Vorschlag in einem Gremium"
                            },
                            {
                                "target_lang_word": "Vorschlag",
                                "target_lang_sense_clarification": "Formelle Unterbreitung eines Anliegens"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb560d6f-6804-3f9a-bd3a-f001f2374573",
                    "sense_definition": "An opening, recess, or chamber.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorer discovered a hidden <w>overture</w> deep within the mountain cave.",
                            "target_lang_translations": {
                                "de": "Der Entdecker entdeckte eine verborgene <w>Öffnung</w> tief in der Berghöhle."
                            }
                        },
                        {
                            "text": "Light filtered into the dark <w>overture</w> from a crack in the ceiling.",
                            "target_lang_translations": {
                                "de": "Licht fiel durch einen Riss in der Decke in die dunkle <w>Nische</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "opening",
                        "recess"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is obsolete in common usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Öffnung, Nische oder Kammer."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Öffnung",
                                "target_lang_sense_clarification": "Durchgang oder Spalt"
                            },
                            {
                                "target_lang_word": "Nische",
                                "target_lang_sense_clarification": "Vertiefung in einer Wand oder Struktur"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9bb1291-a6f2-32d6-bef4-99388b8f4620",
                    "sense_definition": "To approach someone with a proposal or suggestion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>overture</w> the potential investors with a new business plan.",
                            "target_lang_translations": {
                                "de": "Das Unternehmen beschloss, die potenziellen Investoren mit einem neuen Geschäftsplan <w>anzusprechen</w>."
                            }
                        },
                        {
                            "text": "They <w>overture</w> the board members to discuss the merger.",
                            "target_lang_translations": {
                                "de": "Sie <w>sprachen</w> die Vorstandsmitglieder an, um die Fusion zu besprechen."
                            }
                        }
                    ],
                    "synonyms": [
                        "approach",
                        "propose"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden mit einem Vorschlag oder einer Anregung ansprechen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ansprechen",
                                "target_lang_sense_clarification": "Jemanden kontaktieren, um ein Anliegen vorzubringen"
                            },
                            {
                                "target_lang_word": "einen Vorschlag unterbreiten",
                                "target_lang_sense_clarification": "Jemandem ein Angebot machen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e64a9400-2254-34d5-9572-4d2fe848f618",
                    "sense_definition": "Disclosed or open, often used in heraldry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms featured a bird with wings <w>overture</w>.",
                            "target_lang_translations": {
                                "de": "Das Wappen zeigte einen Vogel mit <w>offenen</w> Flügeln."
                            }
                        },
                        {
                            "text": "The heraldic <w>overture</w> design represents openness.",
                            "target_lang_translations": {
                                "de": "Das heraldische <w>offene</w> Design steht für Aufgeschlossenheit."
                            }
                        }
                    ],
                    "synonyms": [
                        "open",
                        "disclosed"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in heraldic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Enthüllt oder offen, oft in der Heraldik verwendet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "offen",
                                "target_lang_sense_clarification": "Nicht geschlossen oder verdeckt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}