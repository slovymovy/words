                                        "entry_id": "38e15659-c245-3498-8b33-0b87a93b528f",
                                        "glosses": [
                                            "The conclusive victory in a game of chess that occurs when an opponent's king is threatened with unavoidable capture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f28de7-b27b-47dc-8b85-2bb6306b61ee",
                                                "sense_id": "3c6f9d22-47e6-364f-98a5-c5b995acc5bd",
                                                "text": "This immediately ends the game, provided that the move producing the checkmate position was in accordance with Article 3 and Articles 4.2 – 4.7."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fb8c9f4-fe60-3947-8c36-73d16cbfe726",
                                        "entry_id": "38e15659-c245-3498-8b33-0b87a93b528f",
                                        "glosses": [
                                            "Any losing situation with no escape; utter defeat."
