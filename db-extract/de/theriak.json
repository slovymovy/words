                    {
                        "sense_id": "7c570a73-39c3-36ea-a324-d7a004fc39e6",
                        "entry_id": "b8caeebb-d105-383f-a003-c125e84d64eb",
                        "glosses": [
                            "ein im Mittelalter gegen alle möglichen Krankheiten und Gebrechen verwendetes Universalheilmittel, das heute noch – jedoch mit abgewandelter Rezeptur und Indikation – hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27b21264-4aa6-4005-9b29-6878e30c6fd0",
                                "sense_id": "7c570a73-39c3-36ea-a324-d7a004fc39e6",
                                "text": "Da ich durch Lothringen passierte, ging mir meine War aus, und weilen ich die Garnisonen scheuete, hatte ich keine Gelegenheit andere zuzurichten, derhalben mußte ich wohl was anders anfangen, bis ich wieder Theriak machen könnte. (Hans Jakob Christoffel von Grimmelshausen, Simplicius Simplicissimus, 9. Kapitel, z.n. Projekt Gutenberg)"
                            },
                            {
                                "example_id": "6f579602-e566-4578-b716-8a32c64cb98f",
                                "sense_id": "7c570a73-39c3-36ea-a324-d7a004fc39e6",
                                "text": "Vollends entwaffneten sie ihn,",
                                "translation": "(Gottfried von Straßburg, Tristan und Isolde, XII. Der Drachenkampf, z.n. Projekt Gutenberg)"
                            },
                            {
                                "example_id": "fae8768c-1a4a-4ece-aae2-4583ad796e82",
                                "sense_id": "7c570a73-39c3-36ea-a324-d7a004fc39e6",
                                "text": "Man legt' ihm auf den Teppich hin",
                                "translation": "(Wolfram von Eschenbach: Parzival und Titurel (Kapitel 33), z.n. Projekt Gutenberg)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
