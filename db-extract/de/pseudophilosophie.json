                "senses": [
                    {
                        "sense_id": "86db9bb0-e02f-3633-9c7a-5a9ab952b357",
                        "entry_id": "b7b21ef5-c4cc-37e9-8757-510ed8f27606",
                        "glosses": [
                            "philosophisch anmutende Aussagen ohne wirklichen Inhalt, etwas, das nur dem Anschein nach mit Philosophie zu tun hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e1772f-6274-4a3d-89cc-45ecc8809e6d",
                                "sense_id": "86db9bb0-e02f-3633-9c7a-5a9ab952b357",
                                "text": "„Ich wollte wissen, wie sich jemand vornehmen kann, ein satanischer Messias zu werden. Stundenlang mussten wir uns billige Pseudophilosophie und endloses Geschwafel anhören, aber als wir ihn zu Einzelheiten drängten und versuchten, hinter das wirre Gerede zu blicken, zeichnete sich langsam ein Bild ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c58a871-0e5d-4af7-a03d-54276fd9ab96",
                        "source_entry_id": "b7b21ef5-c4cc-37e9-8757-510ed8f27606",
                        "source_sense_id": "86db9bb0-e02f-3633-9c7a-5a9ab952b357",
                        "source_sense_description": "philosophisch Anmutendes ohne wirklichen Inhalt",
