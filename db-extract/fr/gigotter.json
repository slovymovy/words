                ],
                "senses": [
                    {
                        "sense_id": "6af9e8b7-a64a-318a-8c27-03dfa675bc84",
                        "entry_id": "c0abfb25-5957-3394-adcd-38fe37d1c57d",
                        "glosses": [
                            "ou Remuer continuellement les jambes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "814e0396-3076-4d65-9d64-860d20916d44",
                                "sense_id": "6af9e8b7-a64a-318a-8c27-03dfa675bc84",
                                "text": "J'ai pour compagnon de couchette un affreux ronfleur sur qui les coups de poing n'ont point d'effet, et qui gigotte constamment comme une grenouille."
                            },
                            {
                                "example_id": "2ab7ce93-eece-4ca1-a018-62f975b8b01e",
                                "sense_id": "6af9e8b7-a64a-318a-8c27-03dfa675bc84",
                                "text": "J’ai toujours dit qu’il n’y a pas de justice sur la terre ; sans cela, cet Eselskopf serait depuis longtemps à gigotter au bras de la potence, sur le Galgenberg !"
                            }
                        ]
                    },
                    {
                        "sense_id": "f2f25fb4-8e37-34fb-90c1-d57b0ad09278",
                        "entry_id": "c0abfb25-5957-3394-adcd-38fe37d1c57d",
                        "glosses": [
                            "Danser."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "82d15d74-04a1-449c-86d1-e81bb3dfbe8f",
                                "sense_id": "f2f25fb4-8e37-34fb-90c1-d57b0ad09278",
                                "text": "Il venait y chercher Jean de Mirande et sa suite, car il supposait qu’après un plantureux dîner chez Foyot, la bande avait dû éprouver le besoin d’aller gigotter à la Closerie."
                            }
                        ]
                    }
                ],
