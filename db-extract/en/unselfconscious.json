                                "target_senses": [
                                    {
                                        "sense_id": "aae87055-7f68-3aef-885d-0e009b878d2d",
                                        "entry_id": "5d3c25b2-ccdd-3a7e-9f0f-2b4ee61f401d",
                                        "glosses": [
                                            "ohne Weiteres verständlich, sich aus dem Zusammenhang ergebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2464b052-96fd-4bca-ac1d-2ac7ecdc3c83",
                                                "sense_id": "aae87055-7f68-3aef-885d-0e009b878d2d",
                                                "text": "Dieser Gedanke ist selbstverständlich."
                                            },
                                            {
                                                "example_id": "ebdedf9f-bfd9-459f-9d72-29dd7ec07c73",
                                                "sense_id": "aae87055-7f68-3aef-885d-0e009b878d2d",
                                                "text": "„Bald einmal gehörten die Deltaflieger so selbstverständlich zum Himmel über Vaduz wie die Bussarde und Milane, mit denen sie gemeinsam die Aufwinde nützen.“"
                                            },
                                            {
                                                "example_id": "5a23cfb7-7f63-4c11-9e16-ed3adcc99e04",
                                                "sense_id": "aae87055-7f68-3aef-885d-0e009b878d2d",
                                                "text": "[E-Roller:] „Eigentlich sollte es selbstverständlich sein, die Roller nach Gebrauch so abzustellen, dass sie niemanden behindern oder gar gefährden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de7f9882-0a4f-4659-85b8-00dc327f4c1b",
                        "source_entry_id": "55bb4fd4-4430-3bc2-b8d5-5fd0707feb84",
                        "source_sense_description": "not self-conscious; natural and genuine",
                        "target_lang_word": "natürlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "natürlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d4fb7a2-fe9a-3dd4-b60b-d2d62f2060ca",
                                        "entry_id": "915ff565-2dea-3e95-bde2-254737e245d4",
                                        "glosses": [
                                            "sich auf die Natur beziehend, naturgemäß, in der Natur vorkommend"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d544df5c-a497-4eca-bdc7-008984174a5d",
                                                "sense_id": "0d4fb7a2-fe9a-3dd4-b60b-d2d62f2060ca",
                                                "text": "Die natürlichen Ressourcen sind begrenzt."
                                            },
                                            {
                                                "example_id": "814f3eae-3666-4474-8054-031549590ddb",
                                                "sense_id": "0d4fb7a2-fe9a-3dd4-b60b-d2d62f2060ca",
                                                "text": "Dieser Bergkamm zieht eine natürliche Grenze."
                                            },
                                            {
                                                "example_id": "6b2d93c1-9da6-4e22-84a9-1e478296f236",
                                                "sense_id": "0d4fb7a2-fe9a-3dd4-b60b-d2d62f2060ca",
                                                "text": "„Der Freikletterer bewegt sich in steiler Wand: Er verzichtet auch bei höchsten Schwierigkeitsgraden auf technische Hilfsmittel und setzt sich mit seiner reinen Körperlichkeit, der Kraft und Geschmeidigkeit seiner Muskeln, der Haltefähigkeit seiner Finger und Zehen, dem natürlichen Fels, seinen glatten Wänden, gefurchten Rillen, sperrigen Überhängen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c850aa61-5509-3991-97cd-d6566818be02",
                                        "entry_id": "915ff565-2dea-3e95-bde2-254737e245d4",
                                        "glosses": [
                                            "nicht entfremdet, der Natur von etwas entsprechend, sich auf diese beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2347d810-6569-4576-9771-21aff4357ef8",
                                                "sense_id": "c850aa61-5509-3991-97cd-d6566818be02",
                                                "text": "„Der Freikletterer bewegt sich in steiler Wand: Er verzichtet auch bei höchsten Schwierigkeitsgraden auf technische Hilfsmittel und setzt sich mit seiner reinen Körperlichkeit, der Kraft und Geschmeidigkeit seiner Muskeln, der Haltefähigkeit seiner Finger und Zehen, dem natürlichen Fels, seinen glatten Wänden, gefurchten Rillen, sperrigen Überhängen aus.“"
                                            },
                                            {
                                                "example_id": "cef14b65-22f0-48cd-a37a-9c53d81ca7e0",
                                                "sense_id": "c850aa61-5509-3991-97cd-d6566818be02",
                                                "text": "Sie sieht immer so natürlich aus."
                                            },
                                            {
                                                "example_id": "27aa40a7-404b-4e60-a795-d7805091c14f",
                                                "sense_id": "c850aa61-5509-3991-97cd-d6566818be02",
                                                "text": "Sie ist eine natürliche Schönheit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "31c0bbb8-d4db-3ad8-8a00-165440535015",
                                        "entry_id": "915ff565-2dea-3e95-bde2-254737e245d4",
                                        "glosses": [
                                            "dem Gesetz der Natur entsprechend"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46d57640-49f0-4ecf-9012-e8b2b0734f86",
                                                "sense_id": "31c0bbb8-d4db-3ad8-8a00-165440535015",
                                                "text": "Er starb eines natürlichen Todes."
                                            },
                                            {
                                                "example_id": "81cb0834-50db-4dac-add9-cfa228d4faf0",
                                                "sense_id": "31c0bbb8-d4db-3ad8-8a00-165440535015",
                                                "text": "Das geht hier nicht mit natürlichen Dingen zu."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7aa1da6f-d6e7-3bd2-ad35-8800e85562b7",
                                        "entry_id": "915ff565-2dea-3e95-bde2-254737e245d4",
                                        "glosses": [
                                            "selbstverständlich, klar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9f1cb88-cbc9-4d03-9806-2aaed0a21a2c",
                                                "sense_id": "7aa1da6f-d6e7-3bd2-ad35-8800e85562b7",
                                                "text": "Das ist doch die natürlichste Sache der Welt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d3a1ea04-3721-33b7-b996-da4e21d0c0f3",
                                        "entry_id": "915ff565-2dea-3e95-bde2-254737e245d4",
                                        "glosses": [
                                            "einfach, ungezwungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21eac0f0-3336-44e6-aa29-9624a3e9a57a",
                                                "sense_id": "d3a1ea04-3721-33b7-b996-da4e21d0c0f3",
                                                "text": "Im Interview gab er sich ganz natürlich."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "712cb049-c59c-35ae-91cf-e6e1d027826c",
                                        "entry_id": "915ff565-2dea-3e95-bde2-254737e245d4",
                                        "glosses": [
                                            "unehelich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd6ae52-883f-4a49-9886-36ae7868271b",
                                                "sense_id": "712cb049-c59c-35ae-91cf-e6e1d027826c",
                                                "text": "ein natürlicher Sohn"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "natürlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43d9c135-ad59-31ef-9341-71e64c9f1e76",
                                        "entry_id": "00341506-a9b0-321d-8962-3114b43c2c45",
                                        "glosses": [
                                            "eine Annahme bestätigend; wie erwartet, wie gewöhnlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31b14a85-ab03-440d-b16b-e02b7dea9f7a",
                                                "sense_id": "43d9c135-ad59-31ef-9341-71e64c9f1e76",
                                                "text": "Er hat den Geburtstag natürlich vergessen."
                                            },
                                            {
                                                "example_id": "d881613b-a0de-4500-83a8-13602e46fd32",
                                                "sense_id": "43d9c135-ad59-31ef-9341-71e64c9f1e76",
                                                "text": "Sie hat natürlich Recht, sie hat immer Recht, das solltest du langsam wissen."
                                            },
                                            {
                                                "example_id": "4e588f48-115e-4e26-a230-6883d43a608b",
                                                "sense_id": "43d9c135-ad59-31ef-9341-71e64c9f1e76",
                                                "text": "„Das Misstrauen gegenüber gentechnisch veränderten Lebensmitteln ist zwar groß, allerdings sind »Gene« natürlich in jedem Lebewesen und damit auch in allen Nahrungsmitteln enthalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b161a19-8f8c-300a-a218-a82e4b79c72a",
                                        "entry_id": "00341506-a9b0-321d-8962-3114b43c2c45",
                                        "glosses": [
                                            "eine Frage bejahend; gewiss, selbstverständlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6daffa30-065d-4661-9c6a-9ca70690c7d3",
                                                "sense_id": "5b161a19-8f8c-300a-a218-a82e4b79c72a",
                                                "text": "Natürlich hatte er das Fenster geöffnet! Was hätte er denn sonst tun sollen!"
                                            },
                                            {
                                                "example_id": "7238692e-4351-4c9e-8034-b4e75cc2908e",
                                                "sense_id": "5b161a19-8f8c-300a-a218-a82e4b79c72a",
                                                "text": "„Natürlich weiß Töpfer selbst, dass Merkels Arbeitskreis aus der Not geboren war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fca01c23-13d0-3b80-bb61-56a1903908c7",
                                        "entry_id": "00341506-a9b0-321d-8962-3114b43c2c45",
                                        "glosses": [
                                            "das Selbstverständliche ausdrückend, bevor dazu eine Einschränkung gemacht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e05eef-cc68-418d-8e93-85b591b75eb7",
                                                "sense_id": "fca01c23-13d0-3b80-bb61-56a1903908c7",
                                                "text": "Du kannst das natürlich tun, aber nützen wird es dir nichts."
                                            },
                                            {
                                                "example_id": "e76ee8f6-15d5-40e9-9cab-bbb8a45c00c7",
                                                "sense_id": "fca01c23-13d0-3b80-bb61-56a1903908c7",
                                                "text": "Natürlich ist das viel Geld, aber man bekommt ja auch etwas dafür."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
