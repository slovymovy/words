                        "form": "den Hausherren"
                    },
                    {
                        "form_id": "f698c58b-3ce0-4cdd-9430-d2132fabaf3b",
                        "entry_id": "85171b35-93d9-370a-ad59-d0170814fd32",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hausherren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fbaa1a51-9de8-38e5-bdc6-ef80fa4951c5",
                        "entry_id": "85171b35-93d9-370a-ad59-d0170814fd32",
                        "glosses": [
                            "Person, die in einer Familie die Entscheidungen fällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd6b909-895b-49c3-8797-48ee0090d39d",
                                "sense_id": "fbaa1a51-9de8-38e5-bdc6-ef80fa4951c5",
                                "text": "Wegen des Lärms wollten sie mit dem Hausherrn sprechen."
                            },
                            {
                                "example_id": "7df84e46-3bd4-4a6f-b6ea-6095c1340b3f",
                                "sense_id": "fbaa1a51-9de8-38e5-bdc6-ef80fa4951c5",
                                "text": "„Der Hausherr war untröstlich, daß er ihnen nicht einmal etwas zu trinken oder zu rauchen anbieten konnte.“"
                            },
                            {
                                "example_id": "a186e8c7-57ea-4279-b914-f76924fd641a",
                                "sense_id": "fbaa1a51-9de8-38e5-bdc6-ef80fa4951c5",
                                "text": "„Der Hausherr schweigt verwundert.“"
                            },
                            {
                                "example_id": "942ac95b-4484-41a7-a414-92bbc709b08f",
                                "sense_id": "fbaa1a51-9de8-38e5-bdc6-ef80fa4951c5",
                                "text": "„Animiert wandte sich der Hausherr an den verdatterten Spinatwüstling.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ceb2407-c5f7-32cb-a6ec-6f8ea07da0eb",
                        "entry_id": "85171b35-93d9-370a-ad59-d0170814fd32",
                        "glosses": [
                            "Person, die ein Haus/mehrere Häuser besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10da54e0-bb16-4c1a-afad-f25d5e59ec68",
                                "sense_id": "3ceb2407-c5f7-32cb-a6ec-6f8ea07da0eb",
                                "text": "Der Hausherr entscheidet, welchen Mieter er akzeptiert."
                            },
                            {
                                "example_id": "fe33adfd-251f-4f02-a3c8-a4ab35d5f226",
                                "sense_id": "3ceb2407-c5f7-32cb-a6ec-6f8ea07da0eb",
                                "text": "„Der Hausherr, der das Haus im Jahre 1919 verkaufte und im Jahre 1923 wieder erwarb, ist neuer Eigentümer im Sinne des § 19 Abs 3 MG.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "87d3a3c7-c35a-3a6b-9fa1-fe5e0860b4ba",
                        "entry_id": "85171b35-93d9-370a-ad59-d0170814fd32",
                        "glosses": [
                            "Verein, der auf dem eigenen Platz spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee6db0f-94e1-47d4-b4da-d6648107bdd9",
                                "sense_id": "87d3a3c7-c35a-3a6b-9fa1-fe5e0860b4ba",
                                "text": "Die Hausherren verloren schließlich doch noch das Spiel."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7623052-a9ea-47d9-a903-1eacd8184e9f",
                        "source_entry_id": "85171b35-93d9-370a-ad59-d0170814fd32",
                        "source_sense_id": "fbaa1a51-9de8-38e5-bdc6-ef80fa4951c5",
