                    "sense_id": "2f992aff-38c9-3012-8922-66963376dc41",
                    "sense_definition": "Person, die ein Geschäft, einen Betrieb oder ein Unternehmen besitzt und leitet",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "besitz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Inhaber</w> des Restaurants begrüßte die Gäste persönlich an der Tür."
                        },
                        {
                            "text": "Nach dreißig Jahren übergab der alte <w>Inhaber</w> das Geschäft an seine Tochter."
                        }
                    ],
                    "synonyms": [
                        "Besitzer",
                        "Eigentümer"
                    ],
                    "common_phrases": [
                        "Inhaber des Geschäfts",
                        "neuer Inhaber"
                    ]
                },
                {
                    "sense_id": "7b8e42c6-f4ff-3d70-9280-9383d744f5ee",
                    "sense_definition": "Person, der ein bestimmtes Recht, ein Konto, ein Dokument oder eine Forderung zusteht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nur der rechtmäßige <w>Inhaber</w> des Kontos kann diese Überweisung freigeben."
                        },
                        {
                            "text": "Der <w>Inhaber</w> einer Forderung kann diese an einen Dritten abtreten."
                        }
                    ],
                    "common_phrases": [
                        "Inhaber eines Kontos",
                        "Inhaber der Karte"
                    ]
                },
                {
