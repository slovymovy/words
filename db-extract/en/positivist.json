                                        "entry_id": "b7d9d679-0067-3335-9189-df472d160c50",
                                        "glosses": [
                                            "auf den Positivismus bezogen, nach Art des Positivismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ccab094-465e-4b34-b6fb-976149f75a28",
                                                "sense_id": "5950ef2a-6849-375a-8b6e-30ae3b96b9be",
                                                "text": "„Mit ihrer Zahlenberauschtheit von Daten und Fakten konnte sich die Geographie bald an die Spitze der positivistischen Disziplinen setzen, zumindest was deren kulturelle Ausstrahlung anging.“"
                                            }
                                        ],
