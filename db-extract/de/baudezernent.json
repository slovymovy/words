                "senses": [
                    {
                        "sense_id": "23355ca4-79da-3de5-a6d8-242cf8086ea0",
                        "entry_id": "97ae44da-cee2-3bee-bbfe-1119b39677ca",
                        "glosses": [
                            "Person, als Sachbearbeiter mit Entscheidungsbefugnis oder legitimierter Leiter einer Baubehörde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db658024-0b98-4670-bcd1-3ab94a4daea3",
                                "sense_id": "23355ca4-79da-3de5-a6d8-242cf8086ea0",
                                "text": "„Baudezernent Franz-Josef Höing will das Vorzeigeprojekt jetzt konkret auf den Weg bringen und bis Ende des Jahres einen Beschluss für die Ratspolitiker vorlegen.“"
                            },
                            {
                                "example_id": "cc6ba6ba-3e50-4e0d-9798-316a9b45f977",
                                "sense_id": "23355ca4-79da-3de5-a6d8-242cf8086ea0",
                                "text": "„So fand denn auch die Einladung des neuen Baudezernenten und altgedienten Leiters des Planungsamts, Werner Wingenfeld, eine gute Resonanz bei den Mittelständlern.“"
                            },
                            {
                                "example_id": "dc9bd662-81a0-48c8-9ed6-8616852e4200",
                                "sense_id": "23355ca4-79da-3de5-a6d8-242cf8086ea0",
                                "text": "„Wenn sich alle Gremien richtig entscheiden, bekommt Mönchengladbach einen Baudezernenten, der ein Riesengewinn für die Stadt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
