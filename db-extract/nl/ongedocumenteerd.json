                "senses": [
                    {
                        "sense_id": "e7e4d62d-1173-35de-bfc1-712623656325",
                        "entry_id": "25f01bb1-a06d-324a-889d-dc5b80a33f65",
                        "glosses": [
                            "zonder vastlegging in blijvende vorm, zonder schriftelijk bewijs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2105cbb3-511c-405c-8059-5b2b8832b8c7",
                                "sense_id": "e7e4d62d-1173-35de-bfc1-712623656325",
                                "text": "„Over Schiphol-oost heb ik vrijwel onmiddellijk na mijn aantreden gezegd dat ik daar meer ruimte nodig heb, maar humaner dan op dit moment. We hebben de behoefte bij Justitie mensen aan de grens op te houden. Mensen die volstrekt ongedocumenteerd aan de grens aankomen, die uit zijn op lotsverbetering. Die mensen laten we niet toe."
                            },
                            {
                                "example_id": "14aa46e1-0ecd-4bda-a43a-588173c6349c",
                                "sense_id": "e7e4d62d-1173-35de-bfc1-712623656325",
                                "text": "Misschien hadden de postmodernisten ook een boekje moeten maken met als titel 'Het postmoderne uitgelegd aan onze oudjes', want ook zij worden blootgesteld aan de beeldenstroom van de televisie, en ze zouden weleens heimwee kunnen krijgen naar de tijd toen ze nog jong en ongedocumenteerd waren."
                            }
                        ]
                    },
                    {
                        "sense_id": "802c0158-1610-3bd7-a00c-910aee56e548",
                        "entry_id": "25f01bb1-a06d-324a-889d-dc5b80a33f65",
                        "glosses": [
                            "zijnde illegaal, zonder geldige verblijfsvergunning"
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "5df4d6eb-e361-4a86-a3e5-96c51bcec5fd",
                                "sense_id": "802c0158-1610-3bd7-a00c-910aee56e548",
                                "text": "Ik kan zien of iemand ongedocumenteerd is; dat zie je aan iemands blik.' Dan wijst ze twee mannen aan die met de armen over elkaar en met hun kin naar beneden zitten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
