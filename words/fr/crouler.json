                        "crouler sous les dettes"
                    ]
                },
                {
                    "sense_id": "103dac95-456a-3b04-88c1-4aceb6aefe80",
                    "sense_definition": "Tomber en s'affaissant sous son propre poids ou sous l'effet de la vétusté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effondrement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille grange abandonnée menace de <w>crouler</w> à la moindre tempête hivernale."
