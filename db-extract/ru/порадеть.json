                "senses": [
                    {
                        "sense_id": "00fe1b85-b68b-358b-9f0e-7d1819f3cb22",
                        "entry_id": "1b3f0501-0569-3754-a8e1-002ff9bb65c1",
                        "glosses": [
                            "устар. позаботиться о ком-либо, чём-либо, проявить усердие, старание по отношению к чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59dd3c7f-773e-4c65-9288-e47507cc0b9e",
                                "sense_id": "00fe1b85-b68b-358b-9f0e-7d1819f3cb22",
                                "text": "Вот бы, говорит отец игумен, порадеть вам, труднички молодые, положить ваши труды на спасение всего христианства."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7976c1b5-b4b7-40d9-95d8-89c9001e9a98",
                        "source_entry_id": "1b3f0501-0569-3754-a8e1-002ff9bb65c1",
                        "source_sense_id": "00fe1b85-b68b-358b-9f0e-7d1819f3cb22",
                        "target_lang_word": "take care",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "take care",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec64dd05-2ad7-369b-8469-8899d275fc31",
                                        "entry_id": "da21f3f5-0ec8-34f7-a025-80aee655e180",
                                        "glosses": [
                                            "To be cautious, careful or prudent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "151a79bb-f9f5-44dd-bb6c-6e1f3a6307c6",
                                                "sense_id": "ec64dd05-2ad7-369b-8469-8899d275fc31",
                                                "text": "Take care when you’re crossing the crosswalk."
                                            },
                                            {
                                                "example_id": "63f88c93-ccbc-422d-9742-e2f7b9425824",
                                                "sense_id": "ec64dd05-2ad7-369b-8469-8899d275fc31",
                                                "text": "Take care that you don't fall!"
                                            },
                                            {
                                                "example_id": "f73b4106-336f-4b00-aefb-18efa6d1fb7f",
                                                "sense_id": "ec64dd05-2ad7-369b-8469-8899d275fc31",
                                                "text": "Care should be taken to close it securely."
                                            },
                                            {
                                                "example_id": "dbaf7f9b-c6ba-4731-b39b-3d68ea1e2d1c",
                                                "sense_id": "ec64dd05-2ad7-369b-8469-8899d275fc31",
                                                "text": "Folks with outside contacts are less likely to be singled out by staff for serious abuse. While the staff may have no fear of the inmate, they are more likely to take care if there is any chance that an outside free person might hear about the abuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89581057-6bc6-3de0-a64d-d02df8fac952",
                                        "entry_id": "da21f3f5-0ec8-34f7-a025-80aee655e180",
                                        "glosses": [
                                            "To mind, or be in charge of something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
