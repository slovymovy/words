                "senses": [
                    {
                        "sense_id": "780ea0cf-4016-3e2c-bb86-84aef9c15531",
                        "entry_id": "0da708ee-a4ef-351c-bdae-bb05b839ac71",
                        "glosses": [
                            "устар. течь, брать начало откуда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08676504-fb0d-47ae-8cdb-18dbc43cf981",
                                "sense_id": "780ea0cf-4016-3e2c-bb86-84aef9c15531",
                                "text": "От оной же горы проистекает река Даикс и другие, текущие в реку Яксарт"
                            }
                        ]
                    },
                    {
                        "sense_id": "f00f6383-f32f-339f-b75c-d1436eb7835b",
                        "entry_id": "0da708ee-a4ef-351c-bdae-bb05b839ac71",
                        "glosses": [
                            "перен. быть, являться следствием чего-либо, следовать из чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b8202d9-4790-4cba-b14e-4a8c2e0eeb3e",
                                "sense_id": "f00f6383-f32f-339f-b75c-d1436eb7835b",
                                "text": "Все мои ошибки проистекают из доброты сердечной…"
                            },
                            {
                                "example_id": "09ccc0d3-ac54-474f-a33a-3772d9d72560",
                                "sense_id": "f00f6383-f32f-339f-b75c-d1436eb7835b",
                                "text": "А агрессивность в вас, мой друг, проистекает от страха."
                            }
                        ]
                    }
                ],
