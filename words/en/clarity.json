                                "target_lang_sense_clarification": "формулировок"
                            },
                            {
                                "target_lang_word": "понятность",
                                "target_lang_sense_clarification": "смысла"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "jasność",
                                "target_lang_sense_clarification": "zrozumiałość wypowiedzi lub myśli"
