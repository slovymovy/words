                        "examples": [
                            {
                                "example_id": "daba7fc0-7d07-45d3-a323-270a913a04f1",
                                "sense_id": "02a4dc94-305f-3be9-bc89-49ca53904676",
                                "text": "Prachtige deurgrepen schouwburg verhuizen mee naar Muziekkwartier: Wie ze heeft gemaakt? Joost mag het weten. Maar mooi zijn ze. Acht sets mahoniehouten deurgrepen met prachtig gestyleerde afbeeldingen die op het hout zijn geëmailleerd. Ontelbare bezoekers van voorstellingen in de grote zaal van de Twentse Schouwburg hebben ze in de handen gehad. De sets deurgrepen horen bij elkaar."
                            },
                            {
                                "example_id": "58f39ccb-c7d6-4a8b-8815-7ea7b6d1015c",
                                "sense_id": "02a4dc94-305f-3be9-bc89-49ca53904676",
                                "text": "Zo meldde de Noord-Koreaanse dictator het volk dat hij een nucleaire knop op zijn mahoniehouten bureautje heeft staan."
                            }
                        ]
                    }
