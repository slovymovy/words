                    "sense_id": "bbd5815b-135e-330e-9665-d2d29030709e",
                    "sense_definition": "De voorwerpsvorm van het persoonlijk voornaamwoord <w>hij</w>; verwijst naar een mannelijk persoon of een mannelijk woord.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pronoun_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb <w>hem</w> gisteren nog in de supermarkt gezien.",
                            "target_lang_translations": {
                                "ru": "Я видел <w>его</w> вчера в супермаркете.",
                                "en": "I saw <w>him</w> in the supermarket just yesterday.",
                                "it": "L'ho visto (<w>lui</w>) al supermercato proprio ieri."
                            }
                        },
                        {
                            "text": "Wil je dit boek alsjeblieft aan <w>hem</w> geven?",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, передай эту книгу <w>ему</w>?",
                                "en": "Could you please give this book to <w>him</w>?",
                                "it": "Puoi dare questo libro a <w>lui</w>, per favore?"
                            }
                        }
                    ],
                    "synonyms": [
                        "'m"
                    ],
                    "antonyms": [
                        "haar"
                    ],
                    "common_phrases": [
                        "met hem",
                        "voor hem",
                        "aan hem",
                        "van hem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объектная форма личного местоимения «hij» (он); относится к лицу мужского пола или слову мужского рода.",
                        "en": "The object form of the personal pronoun 'he'; refers to a male person or a masculine noun.",
                        "it": "La forma complemento del pronome personale 'hij' (lui); si riferisce a una persona di sesso maschile o a un sostantivo maschile."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "его",
                                "target_lang_sense_clarification": "личное местоимение (винительный/родительный падеж)"
                            },
                            {
                                "target_lang_word": "ему",
                                "target_lang_sense_clarification": "личное местоимение (дательный падеж)"
                            },
                            {
                                "target_lang_word": "им",
                                "target_lang_sense_clarification": "личное местоимение (творительный падеж)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "him",
                                "target_lang_sense_clarification": "personal pronoun (object form)"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "lo",
                                "target_lang_sense_clarification": "pronome personale complemento oggetto diretto"
                            },
                            {
                                "target_lang_word": "gli",
                                "target_lang_sense_clarification": "pronome personale complemento di termine (a lui)"
                            },
                            {
                                "target_lang_word": "lui",
                                "target_lang_sense_clarification": "pronome personale complemento (dopo preposizioni)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d7e47c9-1aae-3f34-b48f-1165fe30545c",
                    "sense_definition": "De persoon die anderen moet proberen te tikken bij een spelletje tikkertje.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "game_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ren hard weg, want Thomas is <w>hem</w>!",
                            "target_lang_translations": {
                                "ru": "Беги скорее, потому что Томас — <w>вода</w>!",
                                "en": "Run away fast, because Thomas is <w>it</w>!",
                                "it": "Scappa veloce, perché Thomas è <w>chi ce l'ha</w>!"
                            }
                        },
                        {
                            "text": "Tikkie, nu ben jij <w>hem</w> en moet je ons vangen.",
                            "target_lang_translations": {
                                "ru": "Осалил! Теперь ты <w>вода</w> и должен нас ловить.",
                                "en": "Tag, now you are <w>it</w> and you have to catch us.",
                                "it": "Preso! Ora <w>ce l'hai</w> tu e devi prenderci."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jij bent hem",
                        "wie is hem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участник игры (например, в салки), который должен догонять и касаться других.",
                        "en": "The person who has to chase and tag others in a game of tag.",
                        "it": "La persona che deve cercare di prendere gli altri in un gioco come acchiapparella."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вода",
                                "target_lang_sense_clarification": "роль в игре (салки/прятки)"
                            },
                            {
                                "target_lang_word": "водящий",
                                "target_lang_sense_clarification": "роль в игре"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "it",
                                "target_lang_sense_clarification": "role in a game like tag"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "chi ce l'ha",
                                "target_lang_sense_clarification": "ruolo nel gioco dell'acchiapparella"
                            }
                        ]
                    }
                }
            ]
        },
