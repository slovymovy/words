                                        "entry_id": "886c89da-c84b-34b3-992a-c5ae4764da31",
                                        "glosses": [
                                            "symbiotické soužití hub s kořeny vyšších rostlin"
                                        ],
                                        "tags": [
                                            "odborně"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bccfd83a-726c-43ac-8731-8a4b50137226",
                                                "sense_id": "6cbf5fd8-6f79-3643-a489-27a6ab83d9e3",
                                                "text": "V přírodě jsou zdrojem výživy pro mladé orchideje právě houby, které s nimi vytvářejí symbiózu, konkrétně jde o takzvanou orchideoidní mykorhizu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bbfbf13-35b2-4b73-ae8d-f7157e5d58b0",
                        "source_entry_id": "baf654e8-6cc7-38c8-9321-3e5896e717b3",
                        "source_sense_id": "53fcd931-33ff-32d9-9ff6-f84f8d072aff",
