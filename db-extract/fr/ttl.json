                                        "entry_id": "995fdde5-50e3-346d-ae1e-b1f5f87ac586",
                                        "glosses": [
                                            "Initialism of sport utility vehicle; also S.U.V."
                                        ],
                                        "tags": [
                                            "abbreviation",
