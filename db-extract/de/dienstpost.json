                "senses": [
                    {
                        "sense_id": "7a613af9-a281-39cc-90f7-cebd89182302",
                        "entry_id": "d0d9a0f7-f041-3ba0-b749-94bb881f074b",
                        "glosses": [
                            "Post mit dienstlichen Inhalten durch Behörden oder andere öffentliche Institutionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3403dee9-f762-4a71-8c27-a5b5abbc2787",
                                "sense_id": "7a613af9-a281-39cc-90f7-cebd89182302",
                                "text": "„Dienstpost im engeren Sinn wird von Behörden, staatlichen oder kommunalen Einrichtungen versandt, von der staatlichen Post befördert und ist durch Vordrucke oder Stempel gekennzeichnet.“"
                            },
                            {
                                "example_id": "6df9e71e-bc00-4bfd-864c-5a2e14c026c2",
                                "sense_id": "7a613af9-a281-39cc-90f7-cebd89182302",
                                "text": "„Von 1939 bis 1945 bestanden folgende Deutsche Dienstposten, die Sendungen durch besondere Stempel kennzeichneten:…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "416c3397-c847-3394-9c7d-0c38bb523355",
                        "entry_id": "d0d9a0f7-f041-3ba0-b749-94bb881f074b",
                        "glosses": [
                            "Postgut dienstlichen Inhalts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0369247f-bf4e-4d85-be48-019149e6909a",
                                "sense_id": "416c3397-c847-3394-9c7d-0c38bb523355",
                                "text": "„Die Kutscher, die den alten Fürsten gefahren hatten, waren mit Dienstpost und Briefen für den Fürsten Andrej aus der Stadt zurückgekehrt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
