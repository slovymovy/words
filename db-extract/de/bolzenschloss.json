                "senses": [
                    {
                        "sense_id": "b51737c0-4a70-3e50-b8a5-ac71e75fbcfa",
                        "entry_id": "d8e2b148-8c4b-3ff3-9f00-32c9c381a39c",
                        "glosses": [
                            "Vorhängeschloss, bei dem der Bolzen durch einen massiven Gehäuseteil überdeckt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "912ab2f7-e98e-4182-a736-f9c8b33677a4",
                                "sense_id": "b51737c0-4a70-3e50-b8a5-ac71e75fbcfa",
                                "text": "„Es gab außerdem ein Schloss im Türknauf, ein massives Bolzenschloss, einen Querriegel wie in einer mittelalterlichen Burg und eine Eisenstange, die in einem Winkel von fünfundvierzig Grad vom Boden zur Tür reichte.“"
                            },
                            {
                                "example_id": "5515ee80-cc65-404f-aed9-062f300fc4d2",
                                "sense_id": "b51737c0-4a70-3e50-b8a5-ac71e75fbcfa",
                                "text": "„Es ertönt das Quietschen von etwas Metallischem, das hoch- und runtergeklappt wird. Ein Bolzenschloss, vermutet er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
