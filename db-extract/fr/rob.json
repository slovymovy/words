                                        "entry_id": "17e01577-10eb-3149-ada4-72f5eca070f8",
                                        "glosses": [
                                            "In relation to a series of games or matches between two competitors where the overall winner of the series is the competitor which wins a majority of the individual games or matches:",
                                            "An individual match within the series (especially in racquet sports)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8928dcc-9a80-43fe-8388-497621f90cf9",
                                                "sense_id": "1c074477-9f03-35f3-a298-9dde532c6c9c",
                                                "text": "Ladies matches shall consist of 6 rubbers. Each rubber shall consist of best of 3 games to 21 points."
                                            },
                                            {
                                                "example_id": "b831eaa9-21fe-4628-b406-1de8e106e64b",
                                                "sense_id": "1c074477-9f03-35f3-a298-9dde532c6c9c",
                                                "text": "Montreal’s Francoise Abanda lost the first rubber of the tie 6-2, 6-4 to Karolina Pliskova on Saturday"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49ff2c18-e601-348a-b85f-f66d43e291dc",
                                        "entry_id": "17e01577-10eb-3149-ada4-72f5eca070f8",
                                        "glosses": [
                                            "A rubber match; a game or match played to break a tie."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f50b85b8-24cd-3d8d-8414-b1a928fd99d8",
                                        "entry_id": "17e01577-10eb-3149-ada4-72f5eca070f8",
                                        "glosses": [
                                            "The game of rubber bridge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d44734a1-433c-49cd-88f7-0333d77ffd8f",
                                                "sense_id": "f50b85b8-24cd-3d8d-8414-b1a928fd99d8",
                                                "text": "\"Still, I confess that I miss my rubber. It is the first Saturday night for seven-and-twenty years that I have not had my rubber.\" \"I think you will find that you will play for a higher stake to-night than you have ever done yet, and that the play will be more exciting.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rubber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4582bb6-9444-3a57-89bb-7e4d382ca34e",
                                        "entry_id": "2b496b5e-834f-30ac-be19-51ab02a961c1",
                                        "glosses": [
                                            "To eavesdrop on a telephone call"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9d37e62-88c4-4441-b424-430560233480",
                                                "sense_id": "a4582bb6-9444-3a57-89bb-7e4d382ca34e",
                                                "text": "\"There's a lot of nostalgia about the phone and how it was the way to get the local news,\" said Jane Beck of the Vermont Folklife Center in Middlebury. One way was \"rubbering,\" or listening in on a neighbor's conversations ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f86dcdb-fa15-3162-9534-5fa1cc835c66",
                                        "entry_id": "2b496b5e-834f-30ac-be19-51ab02a961c1",
                                        "glosses": [
                                            "To rubberneck; to observe with unseemly curiosity."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af0b4600-65ab-47d0-843c-c8cb7aa78e3c",
                                                "sense_id": "9f86dcdb-fa15-3162-9534-5fa1cc835c66",
                                                "text": "Old Sally didn't talk much, except to rave about the Lunts, because she was busy rubbering and being charming."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
