                                            {
                                                "example_id": "8c4e91e0-4f0a-47ae-a582-54da80b4a732",
                                                "sense_id": "448424ef-be27-3336-b613-4b0381050fc1",
                                                "text": "In deze omstandigheden vertrok Karel in de zomer van 1967 naar Moskou waar hij zich voor de duur van een jaar vestigde als correspondent van Het Parool. (…) Ook rapporteerde hij over het nieuwe fenomeen van de samizdat, de zelfstandige uitgave door auteurs van dissidente geschriften die werden vermenigvuldigd met behulp van schrijfmachines en fototoestellen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "294875f5-c1fc-3359-b550-2ce422833d9b",
                                        "entry_id": "02c3bc45-e4af-315f-8baf-01f7d82ff9f1",
                                        "glosses": [
                                            "clandestien verspreide tekst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "928583b6-52f1-4674-bf74-8d401d5d16ed",
                                                "sense_id": "294875f5-c1fc-3359-b550-2ce422833d9b",
                                                "text": "Was u dan niet bang om met dissidenten om te gaan, om met de samizdat door Moskou te slepen?"
                                            }
                                        ]
