                ],
                "senses": [
                    {
                        "sense_id": "8e861e22-86a4-3f97-b304-f2217cdad498",
                        "entry_id": "20b70366-2028-30d1-9cad-01e7c932e91b",
                        "glosses": [
                            "ein mit dem Laufen oder einem der verschiedenen Aspekte des Laufens verbundenes Thema"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "6a07bdc6-b666-4c75-9871-8dcf7fd3d196",
                                "sense_id": "8e861e22-86a4-3f97-b304-f2217cdad498",
                                "text": "„Außerdem ist die Hamburgerin als Keynote Speaker zu Laufthemen wie ‚Vom Rollstuhl zum IRONMAN‘ oder ‚Der Jakobsweg – ein Weg zu sich selbst‘ und als Laufcoach für Firmen tätig.“"
                            },
                            {
                                "example_id": "f1e1b9c2-0c0e-4630-bd47-2caae3734a90",
                                "sense_id": "8e861e22-86a4-3f97-b304-f2217cdad498",
                                "text": "„In der Laufgruppe des SV Jungingen 1946 e.V. möchten wir beides kombinieren: Digitales Lauferlebnis mit Datenanalyse und Challenges, aber auch Laufen in der Gruppe und regelmäßige Treffen mit Austausch zu Laufthemen.“"
                            },
                            {
                                "example_id": "934607f7-7e7d-4488-b2a3-32096fadfaf4",
                                "sense_id": "8e861e22-86a4-3f97-b304-f2217cdad498",
                                "text": "„Bei GoGirlRun geht es generell um Laufthemen und das Reisen.“"
                            },
                            {
                                "example_id": "b336d02e-141b-4748-9da8-8cc44cbb4589",
                                "sense_id": "8e861e22-86a4-3f97-b304-f2217cdad498",
                                "text": "„Laufpartner motivieren Dich, denn im Team fühlst Du Dich besser, ihr treibt Euch gegenseitig an und könnt Euch (nicht nur) über Laufthemen austauschen.“"
                            },
                            {
                                "example_id": "84086195-7f3d-40a2-bc24-37e332aa0c11",
                                "sense_id": "8e861e22-86a4-3f97-b304-f2217cdad498",
                                "text": "„Drei interessante Zeitschriften für Läuferinnen und Läufer: Runner’s World aus Deutschland (reine Laufzeitschrift), Laufsport Marathon aus Österreich (reine Laufzeitschrift) und Fitforlife aus der Schweiz (Zeitschrift für Ausdauersport mit hohem Anteil an Laufthemen).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
