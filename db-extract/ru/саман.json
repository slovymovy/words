                "senses": [
                    {
                        "sense_id": "bd016259-678a-31f0-b66e-8c1ca689b75e",
                        "entry_id": "045dcaef-cd0d-3c1f-a2d6-945484d90b5c",
                        "glosses": [
                            "adobe (unburnt brick)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfbc37b8-bc59-4313-9f72-6b6f9ca8005d",
                                "sense_id": "bd016259-678a-31f0-b66e-8c1ca689b75e",
                                "text": "по ме́ре затвердевания, сама́н скла́дывали в колонку с зазо́ром, что́бы быстре́е высыха́л",
                                "translation": "as soon as they hardened, the adobes were piled up in independent columns so that they dried faster",
                                "english": "as soon as they hardened, the adobes were piled up in independent columns so that they dried faster"
                            }
                        ]
                    },
                    {
                        "sense_id": "a4016d9d-572a-3a45-9340-e7e32075cc37",
                        "entry_id": "045dcaef-cd0d-3c1f-a2d6-945484d90b5c",
                        "glosses": [
                            "air brick"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baea9b29-48e6-466d-8eba-4c4f45d3a756",
                                "sense_id": "a4016d9d-572a-3a45-9340-e7e32075cc37",
                                "text": "одновременно с прибы́тием посо́льства в сама́н-арки, бы́ли доста́влены в султаниэ импера́торские пода́рки",
                                "translation": "simultaneous to the arrival of the embassy to the air brick archway, gifts were delivered to the imperial sultanate",
                                "english": "simultaneous to the arrival of the embassy to the air brick archway, gifts were delivered to the imperial sultanate"
                            }
                        ]
                    }
