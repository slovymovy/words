                                "target_senses": [
                                    {
                                        "sense_id": "07bc5686-3abd-3db9-bb0f-e37546c27e08",
                                        "entry_id": "d8c44a8d-c159-356a-8063-03f15055a615",
                                        "glosses": [
                                            "To perform by turns, or in succession; to cause to succeed by turns; to interchange regularly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "484ee9ce-5fc6-4f27-b447-61fc654e5992",
                                                "sense_id": "07bc5686-3abd-3db9-bb0f-e37546c27e08",
                                                "text": "The most high God, in all things appertaining unto this life, for sundry wise ends alternates the disposition of good and evil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd481a9-4f9b-357f-91e7-a985d5f77467",
                                        "entry_id": "d8c44a8d-c159-356a-8063-03f15055a615",
                                        "glosses": [
                                            "To happen, succeed, or act by turns; to follow reciprocally in place or time; followed by with."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cb0b756-b9bb-425e-888e-85645d6266cf",
                                                "sense_id": "1dd481a9-4f9b-357f-91e7-a985d5f77467",
                                                "text": "The flood and ebb tides alternate with each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e40d9c1-543c-314d-a122-ca34b049b69f",
                                        "entry_id": "d8c44a8d-c159-356a-8063-03f15055a615",
                                        "glosses": [
                                            "To vary by turns."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81dfacbb-f674-4983-9476-c966e30a94a6",
                                                "sense_id": "4e40d9c1-543c-314d-a122-ca34b049b69f",
                                                "text": "The land alternates between rocky hills and sandy plains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4237e1d-7a78-3047-88db-f1765b8b972d",
                                        "entry_id": "d8c44a8d-c159-356a-8063-03f15055a615",
                                        "glosses": [
                                            "To perform an alternation (removal of alternate vertices) on (a polytope or tessellation); to remove vertices (from a face or edge) as part of an alternation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91cf329b-fdd8-4330-87a3-5421daed0be4",
                                                "sense_id": "a4237e1d-7a78-3047-88db-f1765b8b972d",
                                                "text": "This case suggests that the alternation of a polyhedron should be bounded by actual vertex figures and alternated faces. The case of the cube is in agreement with this notion, since the alternated square is nothing."
                                            }
                                        ]
                                    }
                                ]
                            }
