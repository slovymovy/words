                    },
                    {
                        "translation_id": "befe23ce-a306-4aaa-92dc-e2104f175d40",
                        "source_entry_id": "98fbbc96-6d47-3465-bb06-4c94527b17f9",
                        "target_lang_word": "faire beau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faire beau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cfb1313-b65e-351f-bd7b-9a13cff8fbd1",
                                        "entry_id": "ed85219c-598f-3468-915c-d2999717267a",
                                        "glosses": [
                                            "Embellir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc1a288d-7c40-3a36-adc6-434b106397b8",
                                        "entry_id": "ed85219c-598f-3468-915c-d2999717267a",
                                        "glosses": [
                                            "Décrit une journée ensoleillée."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef5f8a92-e519-493f-b9eb-9b34bc63ae27",
                                                "sense_id": "cc1a288d-7c40-3a36-adc6-434b106397b8",
                                                "text": "Dès qu'il fait beau, la moindre brise soulève une fine poussière basaltique qui noircit tous les objets et pénètre dans les habitations les mieux closes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9391958-b34b-3113-8dd5-9ebcd9a3f55e",
                                        "entry_id": "ed85219c-598f-3468-915c-d2999717267a",
                                        "glosses": [
                                            "(suivi d'un verbe à l'infinitif) Être plaisant."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc6fe4ba-1aaf-4de2-983f-205da02fb2b9",
                                                "sense_id": "b9391958-b34b-3113-8dd5-9ebcd9a3f55e",
                                                "text": "[…] obéir aux parents et recevoir des calottes, il aurait fait beau répondre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cfc89ce-39b0-4ceb-b6d0-adeb96abfd27",
                        "source_entry_id": "98fbbc96-6d47-3465-bb06-4c94527b17f9",
                        "target_lang_word": "attifer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attifer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a22ad3f-7e8e-396e-847e-fad1de20d31b",
                                        "entry_id": "7d9ecbc5-a932-3a32-bbbf-f0dab1d066b9",
                                        "glosses": [
                                            "Orner, parer, enjoliver."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8ef91af-4d7f-4201-857b-5bd9e67cc493",
                                                "sense_id": "0a22ad3f-7e8e-396e-847e-fad1de20d31b",
                                                "text": "Aussitôt les jeunes gens se réunissent sur la place ; aussitôt les jeunes filles sentent un frisson dans leurs veines, et vite, vite, de s’attifer, de se faire belles, avec le bonnet à rubans et la robe des dimanches !"
                                            },
                                            {
                                                "example_id": "3c6de694-bcd2-4b8e-b465-0aaffa5d3c1b",
                                                "sense_id": "0a22ad3f-7e8e-396e-847e-fad1de20d31b",
                                                "text": "Un frisson m’a secouée ; j’ai attrapé mes paperasses, je me suis mise à les feuilleter, à faire un brin de toilette à mes notes ; j’ai attifé des phrases, comme si elles devaient un jour se produire en public."
                                            },
                                            {
                                                "example_id": "813db16e-a172-41d9-9d2b-b70abd571ec6",
                                                "sense_id": "0a22ad3f-7e8e-396e-847e-fad1de20d31b",
                                                "text": "Et, plein les trottoirs, des filles levantines, qui visent à s’attifer comme celles de Paris, mais qui, par erreur, sans doute, ont fait leurs commandes chez quelque habilleuse pour chiens savants."
                                            },
                                            {
                                                "example_id": "a21dc527-3018-4834-a96c-197cb7b0edc3",
                                                "sense_id": "0a22ad3f-7e8e-396e-847e-fad1de20d31b",
                                                "text": "Il déclara que ces meubles, ainsi attifés, valaient au moins cinq fois le prix qu’il les avait payés, et nous fit admirer, une fois de plus, les prodigieuses « affaires » qu’il savait découvrir chez les brocanteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f07707e8-c5ba-3433-ab92-61119b9e9026",
                                        "entry_id": "7d9ecbc5-a932-3a32-bbbf-f0dab1d066b9",
                                        "glosses": [
                                            "Orner, parer avec mauvais goût."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "354827e6-41b0-4d51-b07c-23b5e1fb3b0f",
                                                "sense_id": "f07707e8-c5ba-3433-ab92-61119b9e9026",
                                                "text": "Ils le paraient, ils l’enrubannaient, ils ouataient ses rythmes, ils attifaient sa musique de teintes impressionnistes, de perversités lascives... Pauvre Gluck !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "169c2e31-3be3-3727-a32a-b14bd4be5190",
                                        "entry_id": "7d9ecbc5-a932-3a32-bbbf-f0dab1d066b9",
                                        "glosses": [
                                            "Vêtir de façon bizarre, plus ou moins ridicule."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56d842a8-f913-4b84-bf66-5d93e4c59f86",
                                                "sense_id": "169c2e31-3be3-3727-a32a-b14bd4be5190",
                                                "text": "Mais la bonne examinait la petite, en disant que mademoiselle s'était drôlement attifée."
                                            },
                                            {
                                                "example_id": "a75abb71-6739-43db-829d-596480b44d76",
                                                "sense_id": "169c2e31-3be3-3727-a32a-b14bd4be5190",
                                                "text": "Elle avait dit à Pomme au début : « Tu ne peux pas t’attifer comme ça ; tu ne peux pas rester sans maquillage. »"
                                            },
                                            {
                                                "example_id": "dd82e266-a338-4d84-84dd-910935f50128",
                                                "sense_id": "169c2e31-3be3-3727-a32a-b14bd4be5190",
                                                "text": "Dans la villa des dunes, il accepte d’assister aux charades pour lesquelles la joyeuse baronne Folgers attife ses invités de châles et de portières de velours ; il consent même à y prendre part, ce qui leur donne un brio de plus."
                                            },
                                            {
                                                "example_id": "616e95a0-0001-434a-8757-54a2142c50db",
                                                "sense_id": "169c2e31-3be3-3727-a32a-b14bd4be5190",
                                                "text": "Ce n’est pas parce que je suis une vieille fille que je dois m’attifer n'importe comment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
