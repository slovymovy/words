                                        "entry_id": "499bc478-0d9c-3511-b170-c2a5feb74d4f",
                                        "glosses": [
                                            "ehemalige britische Münze im Wert eines Viertelpenny, die vom 13. Jahrhundert bis 1956 geprägt wurde, seit 1961 aber kein gesetzliches Zahlungsmittel mehr ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9c2e083-beec-4d61-8f2a-7c14b5b86753",
                                                "sense_id": "72d82a6a-b5b1-3b76-a32f-75abde48c43c",
                                                "text": "Sie hatte nur noch einen Farthing in ihrem Retikül."
                                            },
                                            {
                                                "example_id": "9cdc2a32-94b9-4aab-836b-c13a45d166ce",
                                                "sense_id": "72d82a6a-b5b1-3b76-a32f-75abde48c43c",
                                                "text": "Er gab sein letztes Farthing für Süßigkeiten aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
