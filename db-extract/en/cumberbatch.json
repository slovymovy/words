                "senses": [
                    {
                        "sense_id": "0cfb4b8d-c695-31ba-8218-7a50dc63e460",
                        "entry_id": "5703f5e8-7500-3fda-85f1-9d83af8ecce9",
                        "glosses": [
                            "To expose to actor Benedict Cumberbatch and/or his work."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dab887a6-00d6-44b6-a5f1-8cc670f68d02",
                                "sense_id": "0cfb4b8d-c695-31ba-8218-7a50dc63e460",
                                "text": "Add *those* topless pictures of him on the beach that we published in Now last week to the mix, and I think I'm starting to get where all you women who want to be Cumberbatched are coming from..."
                            },
                            {
                                "example_id": "d5a56e03-a9ce-4ce6-895f-34514f07ded8",
                                "sense_id": "0cfb4b8d-c695-31ba-8218-7a50dc63e460",
                                "text": "Let's get the elephant in the room out of the way: If you're a die-hard Sherlock fan, you're probably not going to be enthusiastic about another Sherlock Holmes series. Once you've been Cumberbatched, you don't go back."
                            },
                            {
                                "example_id": "3dbacbea-e0d0-4dd3-b454-0a10ba371889",
                                "sense_id": "0cfb4b8d-c695-31ba-8218-7a50dc63e460",
                                "text": "The Toronto International Film Festival is about to get Cumberbatched."
                            }
                        ]
                    }
                ],
