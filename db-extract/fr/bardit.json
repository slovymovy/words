                "senses": [
                    {
                        "sense_id": "ece9d1dc-140f-3a60-a8e4-8e3dd2d2455b",
                        "entry_id": "7ae13810-13e7-3d29-aafc-38acee943006",
                        "glosses": [
                            "Prétendu chant de guerre des anciens Germains."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "8070c383-7c70-4209-9170-19240b98ef6a",
                                "sense_id": "ece9d1dc-140f-3a60-a8e4-8e3dd2d2455b",
                                "text": "Ils ont aussi de ces chants qu’ils entonnent – c’est ce qu’ils appellent le bardit – pour enflammer leur courage, et dont les accents mêmes leur font augurer l’issue du combat qu’ils vont engager …."
                            },
                            {
                                "example_id": "631a0b07-a0ab-4d15-98ae-5f237adba434",
                                "sense_id": "ece9d1dc-140f-3a60-a8e4-8e3dd2d2455b",
                                "text": "Il a sans doute aussi été influencé par le « bardit » des Francs de Chateaubriand, comme le suggère Francis Favereau."
                            }
                        ]
                    },
                    {
                        "sense_id": "293d90a1-c6e9-391c-9229-828be0d28daf",
                        "entry_id": "7ae13810-13e7-3d29-aafc-38acee943006",
                        "glosses": [
                            "Chant de bardes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1381d7ff-3b11-4566-bb84-57c7b3bbb44d",
                                "sense_id": "293d90a1-c6e9-391c-9229-828be0d28daf",
                                "text": "je songe au vieux bardit que ma mère me chantait pour m’endormir quand j’étais petite."
                            },
                            {
                                "example_id": "df7b8f16-c4b7-48dc-959a-33c3a3088123",
                                "sense_id": "293d90a1-c6e9-391c-9229-828be0d28daf",
                                "text": "Klopslock écrivit alors ce qu’il appela des bardits, c’est-à-dire des drames patriotiques en prose avec des chœurs chantés par les bardes."
                            },
                            {
                                "example_id": "9bee8034-ed5c-4d13-974e-7b524817ac79",
                                "sense_id": "293d90a1-c6e9-391c-9229-828be0d28daf",
                                "text": "Le bardit était sacré ; il était écrit sur un rythme ternaire."
                            }
                        ]
                    }
