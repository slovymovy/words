                "senses": [
                    {
                        "sense_id": "e38e9ef2-9021-3bce-bf0f-253c050cafa2",
                        "entry_id": "c7a5cbcb-d3a1-3389-bf16-bdc34ec2e48a",
                        "glosses": [
                            "Radio, das bei Bauarbeiten eingesetzt wird und meist robust und gegen äußere Einflüsse wie Staub und Dreck geschützt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2e7d25d-cdc1-4229-8ea2-c6a4afcff092",
                                "sense_id": "e38e9ef2-9021-3bce-bf0f-253c050cafa2",
                                "text": "„Am Mittwochnachmittag (09.07.) entwendete ein Dieb in der Ziegeleistraße ein Baustellenradio des Herstellers Makita im Wert von 120 Euro.“"
                            },
                            {
                                "example_id": "d349b2c3-4d0f-4791-bcae-5d8976516d81",
                                "sense_id": "e38e9ef2-9021-3bce-bf0f-253c050cafa2",
                                "text": "„Nach einer Pressemitteilung der Polizei haben der oder die Täter eine Kreissäge, einen Winkelschleifer, eine Stichsäge, ein Baustellenradio, eine Kabeltrommel und zwei Stablampen gestohlen.“"
                            },
                            {
                                "example_id": "4c3ac3b8-ada2-46b9-aeee-6bd0d7c02074",
                                "sense_id": "e38e9ef2-9021-3bce-bf0f-253c050cafa2",
                                "text": "„Laut Polizeiangaben schlugen die Diebe im Gärtnerwinkel die Seitenscheibe eines roten Geländewagens der Marke Isuzu ein und nahmen ein Baustellenradio im Wert von 120 Euro mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
