{
    "word_family": [
        "bow"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "daf5bba8-f721-389a-81a8-22f3b798018d",
                    "sense_definition": "A large, main branch of a tree that grows directly from the trunk.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tree_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A pair of birds settle on the <w>bough</w> above them, murmuring together, ready to roost.",
                            "target_lang_translations": {
                                "pl": "Para ptaków usiadła na <w>konarze</w> nad nimi, świergocząc cicho, gotowa do snu."
                            }
                        },
                        {
                            "text": "She grabbed for a nearby tree branch, but the spindly <w>bough</w> snapped off in her hands.",
                            "target_lang_translations": {
                                "pl": "Chwyciła pobliską gałąź, ale cienki <w>konar</w> złamał się w jej dłoniach."
                            }
                        }
                    ],
                    "synonyms": [
                        "branch"
                    ],
                    "common_phrases": [
                        "tree bough"
                    ],
                    "target_lang_definitions": {
                        "pl": "Duża, główna gałąź drzewa wyrastająca bezpośrednio z pnia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "konar",
                                "target_lang_sense_clarification": "gruba, główna gałąź drzewa"
                            },
                            {
                                "target_lang_word": "gałąź",
                                "target_lang_sense_clarification": "ogólne określenie pędu drzewa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46d96f71-401c-3144-8d0f-2c0b01197c4e",
                    "sense_definition": "A gallows used for hanging people.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old saying was the father to the <w>bough</w> and the son to the plough.",
                            "target_lang_translations": {
                                "pl": "Stare przysłowie mówiło: ojciec na <w>szubienicę</w>, a syn do pługa."
                            }
                        },
                        {
                            "text": "The judge sentenced the criminal to the <w>bough</w> for his terrible crimes.",
                            "target_lang_translations": {
                                "pl": "Sędzia skazał przestępcę na <w>szubienicę</w> za jego straszne zbrodnie."
                            }
                        }
                    ],
                    "synonyms": [
                        "gallows"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the historical practice of hanging from a tree branch."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Historyczne określenie szubienicy lub drzewa używanego do wykonywania wyroków śmierci przez powieszenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szubienica",
                                "target_lang_sense_clarification": "urządzenie do wykonywania kary śmierci"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a716588d-2f47-33ae-8b9a-31275fa98077",
                    "sense_definition": "A family name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian researched the genealogy of the <w>Boughs</w> family.",
                            "target_lang_translations": {
                                "pl": "Historyk badał genealogię rodziny <w>Boughs</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Boughs</w> attended the meeting this morning.",
                            "target_lang_translations": {
                                "pl": "Pan <w>Boughs</w> był obecny na porannym spotkaniu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nazwisko rodowe."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Boughs",
                                "target_lang_sense_clarification": "nazwisko własne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}