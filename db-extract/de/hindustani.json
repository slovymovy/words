                                ]
                            },
                            {
                                "target_word": "Hindustani",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92e487fd-3bfd-3d8d-987f-6992c82ce7ae",
                                        "entry_id": "e72c8ce1-9c12-3dde-a1e5-4814b07e308b",
                                        "glosses": [
                                            "The pluricentric language of Hindi-Urdu, of which Hindi and Urdu are literary standards; the language from which Hindi and Urdu are derived."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3408ad6-6af5-45ec-8deb-b7d4e79888b0",
                                                "sense_id": "92e487fd-3bfd-3d8d-987f-6992c82ce7ae",
                                                "text": "Kim watched the stars as they rose one after another in the still, sticky dark, till he fell asleep at the foot of the altar. That night he dreamed in Hindustani, with never an English word…"
                                            },
                                            {
                                                "example_id": "d2616839-d580-49b7-8141-e2a6a38d8548",
                                                "sense_id": "92e487fd-3bfd-3d8d-987f-6992c82ce7ae",
                                                "text": "Swerg, in the Hinduſtànì language, means Heaven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "818f5a34-dbf7-3993-814a-6e48e9aea212",
                                        "entry_id": "e72c8ce1-9c12-3dde-a1e5-4814b07e308b",
                                        "glosses": [
                                            "The Delhi dialect of that language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf06ec89-cf85-3b32-bd14-122ea56c5807",
                                        "entry_id": "e72c8ce1-9c12-3dde-a1e5-4814b07e308b",
                                        "glosses": [
                                            "The language which is now known as Urdu."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1caf04ce-2594-41da-a49e-7aed8febbe03",
                                                "sense_id": "bf06ec89-cf85-3b32-bd14-122ea56c5807",
                                                "text": "Hindustani, or Urdu (i.e., camp language), is a dialect of Hindi, differing from it in its large admixture of Persian words, and in that it is usually printed in Persian or Arabic characters, while Hindi is commonly printed in Sanskrit letters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafd2fae-1415-3cdd-9d65-67d6842480a4",
                                        "entry_id": "e72c8ce1-9c12-3dde-a1e5-4814b07e308b",
                                        "glosses": [
                                            "The language which is now known as Hindi."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed497eb5-4a6e-4134-b685-f021440fed44",
                                                "sense_id": "dafd2fae-1415-3cdd-9d65-67d6842480a4",
                                                "text": "Of the several languages derived from the Sanskrit, none exercises so general and wide-spread an influence over India as the Hindi, or Sir George's Common Hindustani."
                                            },
                                            {
                                                "example_id": "e1e6250a-fc46-4544-b91e-f48d89b59bab",
                                                "sense_id": "dafd2fae-1415-3cdd-9d65-67d6842480a4",
                                                "text": "But Mr. Lyall, in an article that is all too short, shows that Hindustani, or Hindi (for there is no essential difference between the two) possesses a continuous body of literature which represents intellectual life in Northern India during the past six centuries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
