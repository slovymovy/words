                        "examples": [
                            {
                                "example_id": "74b0c379-c045-45d7-b257-704cfccc8f14",
                                "sense_id": "5ac5162f-b43b-3cf7-8d29-f29b1f4383aa",
                                "text": "Binnen de vakcentrale bestond al langere tijd grote onenigheid door het pensioenakkoord dat voorzitter Agnes Jongerius sloot met het kabinet en de werkgeversorganisaties. Ambtenarenbond Abvakabo en FNV Bondgenoten waren fel tegen het akkoord, maar de stemmen van de andere bonden gaven de doorslag. Abvakabo en FNV Bondgenoten, met de meeste leden binnen FNV, zegden daarop het vertrouwen in Jongerius op."
                            },
                            {
                                "example_id": "5bd82930-aef2-453d-99a6-eaac53544331",
                                "sense_id": "5ac5162f-b43b-3cf7-8d29-f29b1f4383aa",
                                "text": "De douane op Schiphol voert dinsdag actie voor meer loon. Het personeel zal tussen 12.00 en 13.00 uur in de vertrek- en aankomsthal stipt volgens de regels werken, heeft ambtenarenbond Abvakabo FNV bekendgemaakt."
                            }
                        ]
