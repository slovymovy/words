                                    {
                                        "sense_id": "f3ef41b3-d87b-3b2d-8009-ae92fa128d11",
                                        "entry_id": "54cc5dbc-bdb9-3f57-b90e-a40fac9d0abb",
                                        "glosses": [
                                            "uczestnictwo w jakimś wydarzeniu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39565223-07c3-4ec6-99ba-bf24fadd4a6b",
                                                "sense_id": "f3ef41b3-d87b-3b2d-8009-ae92fa128d11",
                                                "text": "\"Antropolodzy mają prawo twierdzić, że przyczynili się do zachowania kulturowego dziedzictwa społeczeństw, które badali, […]. Lecz prawdą jest również, iż mieli oni swój udział, czasem tylko pośredni, w utrzymywaniu struktur władzy reprezentowanych przez system kolonialny\"."
                                            },
                                            {
                                                "example_id": "012be6e2-c3a0-4b71-950b-e72292479d1e",
                                                "sense_id": "f3ef41b3-d87b-3b2d-8009-ae92fa128d11",
                                                "text": "W turnieju brało udział ponad pięćdziesięciu zawodników."
                                            },
                                            {
                                                "example_id": "9ff556f3-b084-4c7f-a37b-483a401c7e3b",
                                                "sense_id": "f3ef41b3-d87b-3b2d-8009-ae92fa128d11",
                                                "text": "O udziale w imprezie decyduje kolejność zgłoszeń."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "d7ce2c30-e75e-33c0-b88b-b65505d9e37f",
                                        "entry_id": "54cc5dbc-bdb9-3f57-b90e-a40fac9d0abb",
                                        "glosses": [
                                            "wkład kapitału do przedsięwzięcia finansowego, dokonany przez jego uczestnika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3fbdba2-5f1f-49dc-81b2-0a14048874fe",
                                                "sense_id": "d7ce2c30-e75e-33c0-b88b-b65505d9e37f",
                                                "text": "Mafia sprzedała swoje udziały niemieckiej korporacji."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "44ea4999-6342-3768-9f75-1d8e81d3b789",
                                        "entry_id": "54cc5dbc-bdb9-3f57-b90e-a40fac9d0abb",
                                        "glosses": [
                                            "dokument potwierdzający udział (1.2)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046c97ca-b440-4866-90a4-76b33336a5db",
                                                "sense_id": "44ea4999-6342-3768-9f75-1d8e81d3b789",
                                                "text": "To jest mój udział w spółce, powiedział pokazując świadectwo udziałowe."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "32a4e216-476f-3c01-a99d-883825ef2e62",
                                        "entry_id": "54cc5dbc-bdb9-3f57-b90e-a40fac9d0abb",
                                        "glosses": [
                                            "zysk z tytułu udziału (1.2)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
