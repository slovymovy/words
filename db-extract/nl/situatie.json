                "senses": [
                    {
                        "sense_id": "d702b3c5-350a-3076-9d5b-741e39d41fa6",
                        "entry_id": "1db78fbc-3326-32fc-8f43-1014a7fa5d56",
                        "glosses": [
                            "hoe de zaken er voorliggen, toestand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51d39d8f-4d51-4382-9e0c-8512cd13713a",
                                "sense_id": "d702b3c5-350a-3076-9d5b-741e39d41fa6",
                                "text": "Na de staatsgreep is de situatie in het land bijzonder verward."
                            },
                            {
                                "example_id": "4b9b7e20-9b1a-4c21-8f48-abfe0a3cf124",
                                "sense_id": "d702b3c5-350a-3076-9d5b-741e39d41fa6",
                                "text": "Voor mijn eigen gezondheid ben ik niet bang, maar dit is een situatie waarover iedereen zich zorgen zou moeten maken."
                            },
                            {
                                "example_id": "dd19b662-e317-4396-a05a-6175fea9c155",
                                "sense_id": "d702b3c5-350a-3076-9d5b-741e39d41fa6",
                                "text": "Als de wind hard van het vaste land afblaast, is het gevaar dat als je op je luchtbed ligt, je te ver afdrijft. Als het goed is hangt in deze situatie ook de oranje windzak uit."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4964ece-99b9-38ff-97ee-1b58eeef45f0",
                        "entry_id": "1db78fbc-3326-32fc-8f43-1014a7fa5d56",
                        "glosses": [
                            "ligging"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0ac5efc-1650-4330-ae69-22e246e0587b",
                        "source_entry_id": "1db78fbc-3326-32fc-8f43-1014a7fa5d56",
                        "source_sense_id": "d702b3c5-350a-3076-9d5b-741e39d41fa6",
                        "source_sense_description": "hoe de zaken er voorliggen",
                        "target_lang_word": "Situation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Situation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc98fc76-809b-3e95-9238-6764b422d57d",
                                        "entry_id": "8a2dd7c4-660d-3e46-9550-8f002bc65a91",
                                        "glosses": [
                                            "die Summe momentaner Umstände, die bestimmend auf das Handeln einwirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c694d25a-a440-4fec-947a-b81e83872868",
                                                "sense_id": "bc98fc76-809b-3e95-9238-6764b422d57d",
                                                "text": "In dieser Situation hätte ich genauso gehandelt."
                                            },
                                            {
                                                "example_id": "ea7fa385-128a-4d79-b597-a17d4900de96",
                                                "sense_id": "bc98fc76-809b-3e95-9238-6764b422d57d",
                                                "text": "Nun bin ich in derselben Situation wie du."
                                            },
                                            {
                                                "example_id": "521cac50-09fa-4177-b924-a67077f42643",
                                                "sense_id": "bc98fc76-809b-3e95-9238-6764b422d57d",
                                                "text": "„Die Tetrarchen mussten immer ihre militärische Befähigung unter Beweis stellen, um sich in kritischen Situationen auf die Loyalität der Soldaten stützen zu können.“"
                                            },
                                            {
                                                "example_id": "9a332c79-6bad-4b27-b404-b3675e4206ae",
                                                "sense_id": "bc98fc76-809b-3e95-9238-6764b422d57d",
                                                "text": "„Der Vorteil einer progressiven Kapitalsteuer liegt darin, mit den unterschiedlichsten Situationen auf flexible, konsistente, vorhersehbare Weise umgehen zu können, […].“"
                                            },
                                            {
                                                "example_id": "6b6764d6-75af-448e-a57e-2c7c73540a8f",
                                                "sense_id": "bc98fc76-809b-3e95-9238-6764b422d57d",
                                                "text": "„Die Situation hatte etwas von einer Audienz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7339c7a2-8dd8-4ccd-b654-d80abd3ec866",
                        "source_entry_id": "1db78fbc-3326-32fc-8f43-1014a7fa5d56",
                        "source_sense_id": "d702b3c5-350a-3076-9d5b-741e39d41fa6",
                        "source_sense_description": "hoe de zaken er voorliggen",
                        "target_lang_word": "situation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "situation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3cd4fb1-5516-39d1-823a-d219d7b63cc4",
                                        "entry_id": "727180a0-7d76-3b96-b595-2b67f0c8c4d8",
                                        "glosses": [
                                            "The combination of circumstances at a given moment; a state of affairs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7732e80c-dbd2-4225-bc72-833e3ea7c2ac",
                                                "sense_id": "a3cd4fb1-5516-39d1-823a-d219d7b63cc4",
                                                "text": "The United States is in an awkward situation with debt default looming."
                                            },
                                            {
                                                "example_id": "4d0e99df-fe9f-4542-b6c6-5ac0f1cf703f",
                                                "sense_id": "a3cd4fb1-5516-39d1-823a-d219d7b63cc4",
                                                "text": "Then we relapsed into a discomfited silence, and wished we were anywhere else. But Miss Thorn relieved the situation by laughing aloud, and with such a hearty enjoyment that instead of getting angry and more mortified we began to laugh ourselves, and instantly felt better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e46d40b-e032-3113-a216-458bb8c98e1c",
                                        "entry_id": "727180a0-7d76-3b96-b595-2b67f0c8c4d8",
                                        "glosses": [
                                            "The way in which something is positioned vis-à-vis its surroundings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e5d7f06-256e-4191-a4e0-ec310d8c7ab2",
                                                "sense_id": "7e46d40b-e032-3113-a216-458bb8c98e1c",
                                                "text": "The Botanical Gardens are in a delightful situation on the river bank."
                                            },
                                            {
                                                "example_id": "d4c32702-09bd-4e86-83e6-f9ce53949978",
                                                "sense_id": "7e46d40b-e032-3113-a216-458bb8c98e1c",
                                                "text": "[…]he being naturally an underground animal by birth and breeding, the situation of Badger's house exactly suited him and made him feel at home; while the Rat, who slept every night in a bedroom the windows of which opened on a breezy river, naturally felt the atmosphere still and oppressive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce44f09-d3cd-3177-b925-d08d0f14a38d",
                                        "entry_id": "727180a0-7d76-3b96-b595-2b67f0c8c4d8",
                                        "glosses": [
                                            "The place in which something is situated; a location."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac583802-d2fb-3778-9231-8985298ebdec",
                                        "entry_id": "727180a0-7d76-3b96-b595-2b67f0c8c4d8",
                                        "glosses": [
                                            "1833, Thomas Hibbert, Robert Buist, The American Flower Garden Directory, page 142"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cbfbf91-c801-3ccd-81f4-8aa602de4e06",
                                        "entry_id": "727180a0-7d76-3b96-b595-2b67f0c8c4d8",
                                        "glosses": [
                                            "1833, Thomas Hibbert, Robert Buist, The American Flower Garden Directory, page 142:\\n[Hibíscus] speciòsus is the most splendid, and deserves a situation in every garden.",
                                            "[Hibíscus] speciòsus is the most splendid, and deserves a situation in every garden."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f70b988b-2cc3-3beb-8642-cb36ad5abd4e",
                                        "entry_id": "727180a0-7d76-3b96-b595-2b67f0c8c4d8",
                                        "glosses": [
                                            "Position or status with regard to conditions and circumstances."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "066bd280-2383-349e-9900-6e2b8833ecca",
                                        "entry_id": "727180a0-7d76-3b96-b595-2b67f0c8c4d8",
                                        "glosses": [
                                            "A position of employment; a post."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f505057-362d-431a-9dd1-f45ae025a1bf",
                                                "sense_id": "066bd280-2383-349e-9900-6e2b8833ecca",
                                                "text": "‘Let me hear another sound from you,’ said Scrooge, ‘and you’ll keep your Christmas by losing your situation!"
                                            },
                                            {
                                                "example_id": "ce420c5d-0219-4aaa-afdc-af3f6ae35d0f",
                                                "sense_id": "066bd280-2383-349e-9900-6e2b8833ecca",
                                                "text": "When he was nineteen, he suddenly left the 'Co-op' office, and got a situation in Nottingham."
                                            },
                                            {
                                                "example_id": "3ff06897-a792-4c59-adca-7d2d1209fd4b",
                                                "sense_id": "066bd280-2383-349e-9900-6e2b8833ecca",
                                                "text": "You take a morning paper from the top of the stack\nAnd read the situations from the front to the back\nThe only job that's open need a man with a knack\nSo put it right back in the rack Jack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "800abc85-1343-3c81-834f-c3c243bf6215",
                                        "entry_id": "727180a0-7d76-3b96-b595-2b67f0c8c4d8",
                                        "glosses": [
                                            "A difficult or unpleasant set of circumstances; a problem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4adaa6d9-9d31-4665-a727-ebc6f0fc7f39",
                                                "sense_id": "800abc85-1343-3c81-834f-c3c243bf6215",
                                                "text": "Boss, we've got a situation here…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "202e429c-e5c7-36cd-92e9-279cf24ddeba",
                                        "entry_id": "727180a0-7d76-3b96-b595-2b67f0c8c4d8",
                                        "glosses": [
                                            "An individual movie theater."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e158d7a9-ac5d-4b4e-8613-4faf390dfdbe",
                                                "sense_id": "202e429c-e5c7-36cd-92e9-279cf24ddeba",
                                                "text": "This survey includes all key situations (including Paramount Gulf Theaters) as well as suburban runs and small-town situations."
                                            },
                                            {
                                                "example_id": "63955a9f-414b-46d1-9573-c877db63bb84",
                                                "sense_id": "202e429c-e5c7-36cd-92e9-279cf24ddeba",
                                                "text": "[…] Craterian theatre, with a full-scale advance campaign and preliminary screenings held for opinion-makers. Results and reactions will be closely studied and, if popular, the idea will be extended to other situations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18b6e501-8099-3930-b936-7fe53494d3ca",
                                        "entry_id": "727180a0-7d76-3b96-b595-2b67f0c8c4d8",
                                        "glosses": [
                                            "An outfit, garment, or look."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d8877c2-142b-47d4-8967-39c6293b6f83",
                                                "sense_id": "18b6e501-8099-3930-b936-7fe53494d3ca",
                                                "text": "She is working some sort of amazing burgundy chiffon situation with gold piping."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7242faf2-ed1f-4d6f-a032-23d1100a1aca",
                        "source_entry_id": "1db78fbc-3326-32fc-8f43-1014a7fa5d56",
                        "source_sense_id": "d702b3c5-350a-3076-9d5b-741e39d41fa6",
                        "source_sense_description": "hoe de zaken er voorliggen",
                        "target_lang_word": "situation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "situation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16d090f0-b6c3-375d-9694-885b2eca8fb3",
                                        "entry_id": "623ec783-2380-3a53-a232-33c629d0b697",
                                        "glosses": [
                                            "Position d’une ville, d’un château, d’une maison, d’un jardin, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c7b674d-c723-4263-8a21-c95aca61db82",
                                                "sense_id": "16d090f0-b6c3-375d-9694-885b2eca8fb3",
                                                "text": "[…] et, sans doute pour éviter que le fugitif ne renseignât les assiégeants sur la situation de la ville, on dût renoncer au projet."
                                            },
                                            {
                                                "example_id": "8b77fa56-2ce8-48c9-9b3e-d590d2d4c3bb",
                                                "sense_id": "16d090f0-b6c3-375d-9694-885b2eca8fb3",
                                                "text": "Situation commode, agréable, pittoresque."
                                            },
                                            {
                                                "example_id": "41b9697a-e37e-48cd-9897-1de767b8631d",
                                                "sense_id": "16d090f0-b6c3-375d-9694-885b2eca8fb3",
                                                "text": "Cette ville est dans une situation favorable au commerce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "582838de-8573-3c23-8adf-238e62f8e560",
                                        "entry_id": "623ec783-2380-3a53-a232-33c629d0b697",
                                        "glosses": [
                                            "État ou position d’une personne ou d’une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91404107-4b52-482e-9bd1-ab3905df353c",
                                                "sense_id": "582838de-8573-3c23-8adf-238e62f8e560",
                                                "text": "La partie repart, les clients sadiques s’approchent, soudain intéressés de voir un froggy en situation délicate, et arrive mon tour."
                                            },
                                            {
                                                "example_id": "466a8140-22a9-4a45-a3c2-6863ca9f95cb",
                                                "sense_id": "582838de-8573-3c23-8adf-238e62f8e560",
                                                "text": "Ces messieurs me catalogueraient définitivement et toute démarche de ma part afin de me justifier ne servirait qu’à aggraver la situation."
                                            },
                                            {
                                                "example_id": "dae8c2f1-345b-4135-9516-422043a9f996",
                                                "sense_id": "582838de-8573-3c23-8adf-238e62f8e560",
                                                "text": "Pendant que les lames attaquaient mon vaillant navire […], je restai allongé sur ma couchette, philosophant sur le manque de confort de ma présente situation."
                                            },
                                            {
                                                "example_id": "dc3594f6-7e9c-4ce9-ab20-c58f894dba2f",
                                                "sense_id": "582838de-8573-3c23-8adf-238e62f8e560",
                                                "text": "Il s’ensuit un prix nettement supérieur au coût de la dernière unité produite, ce qui va permettre de maximiser le profit en situation d’oligopole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e97ca336-a1df-3ef8-8d13-d56b0b4bd163",
                                        "entry_id": "623ec783-2380-3a53-a232-33c629d0b697",
                                        "glosses": [
                                            "État général des affaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94163f80-2c87-445b-a4bc-2513e3893887",
                                                "sense_id": "e97ca336-a1df-3ef8-8d13-d56b0b4bd163",
                                                "text": "De Bilma, par câble, nous apprenons que la situation se trouble là-bas. Les Toubbou menacent nos positions du Tibesti."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7f372d1-d5d5-3041-ae0c-b792219c26db",
                                        "entry_id": "623ec783-2380-3a53-a232-33c629d0b697",
                                        "glosses": [
                                            "Moment critique dans l’action d’un drame, d’un roman, etc."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f305ef98-f7ae-4236-8152-11b321ca1a19",
                                                "sense_id": "e7f372d1-d5d5-3041-ae0c-b792219c26db",
                                                "text": "Ces objectifs sont déterminés par un plan à long terme, pour l'atteinte duquel on ménagera au maximum ses forces tout en cherchant les prises les plus variées qu'offre la situation du moment."
                                            },
                                            {
                                                "example_id": "8cbbedc9-a6de-40b7-821c-91b6fce7116e",
                                                "sense_id": "e7f372d1-d5d5-3041-ae0c-b792219c26db",
                                                "text": "Le drame ivoirien mêle inextricablement ces deux dimensions et a abouti à partir de la tentative d’instauration du concept d’« ivoirité » à une coupure du pays en deux et à une situation de guerre civile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb7bd72b-df2a-35bd-9911-8fce290e854e",
                                        "entry_id": "623ec783-2380-3a53-a232-33c629d0b697",
                                        "glosses": [
                                            "État où se trouve une caisse, un approvisionnement, etc."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75ff1a26-29b2-4f55-a9ee-71fead696f7f",
                                                "sense_id": "fb7bd72b-df2a-35bd-9911-8fce290e854e",
                                                "text": "J’ai examiné la situation de sa caisse, de son magasin; tout était en règle."
                                            },
                                            {
                                                "example_id": "d20731b4-a809-452f-9b08-0e0b444d355f",
                                                "sense_id": "fb7bd72b-df2a-35bd-9911-8fce290e854e",
                                                "text": "État, tableau de situation en argent, en denrées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96322039-2857-3cf0-8a5e-2a216e9935f2",
                                        "entry_id": "623ec783-2380-3a53-a232-33c629d0b697",
                                        "glosses": [
                                            "Position, emploi, place rémunératrice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5a723e6-cf07-453c-88bc-e524b5e2faf7",
                                                "sense_id": "96322039-2857-3cf0-8a5e-2a216e9935f2",
                                                "text": "Une situation brillante, avantageuse."
                                            },
                                            {
                                                "example_id": "73cb1f89-f094-4e86-bc89-f34a42d6cd24",
                                                "sense_id": "96322039-2857-3cf0-8a5e-2a216e9935f2",
                                                "text": "Une situation subalterne."
                                            },
                                            {
                                                "example_id": "22abdb14-b3ec-4129-8062-94c89309fd3c",
                                                "sense_id": "96322039-2857-3cf0-8a5e-2a216e9935f2",
                                                "text": "Ma venue définitive de province à Paris marque une grande phase dans ma vie. J’ai trouvé une situation dans une banque. Mes jours vont changer."
                                            },
                                            {
                                                "example_id": "a0f1e685-1e35-4f8d-ac4c-495fd41b1c06",
                                                "sense_id": "96322039-2857-3cf0-8a5e-2a216e9935f2",
                                                "text": "Ses trois filles prirent ici les trois ou quatre ans qui leur manquaient pour être mariées, se marièrent ; des deux garçons, un mourut au cours d’un voyage qu’il faisait en Autriche ; l’autre occupait une situation à Paris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
