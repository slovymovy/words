                "senses": [
                    {
                        "sense_id": "f8ac3562-9e09-3efe-adf1-76714dca2a5b",
                        "entry_id": "de9a7005-bfd2-3fc8-9761-9062f630e790",
                        "glosses": [
                            "Gestalt/Ausprägung eines Körperteils, zum Beispiel einer Gliedmaße oder eines Organs, die nicht der normalen Ausprägung (Form) entspricht"
                        ],
                        "tags": [
                            "mit Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e92d2d25-9885-4ff6-ae70-bfaa328603b1",
                                "sense_id": "f8ac3562-9e09-3efe-adf1-76714dca2a5b",
                                "text": "„Erblichkeit läßt sich nur bei gewissen Deformitäten feststellen, und auch in diesen Fällen zeigt sich die Erblichkeit meist nur dadurch, daß diese Deformitäten, z. B. die angeborne Hüftverrenkung, in manchen Familien häufiger vorkommen als sonst in der Bevölkerung.“"
                            },
                            {
                                "example_id": "6cbbe276-2737-450a-9934-c01b76379f03",
                                "sense_id": "f8ac3562-9e09-3efe-adf1-76714dca2a5b",
                                "text": "„Diese Deformität ist das Ergebnis einer Verklebung (Anhaftung) zwischen dem Strang und der Haut, besonders im Bereich der distalen Hohlhandfurche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7a2ddbb-7879-32ef-95f0-f6d30d0bada7",
                        "entry_id": "de9a7005-bfd2-3fc8-9761-9062f630e790",
                        "glosses": [
                            "Eigenschaft, fehlgestaltet (deformiert) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a58bbca7-dfbd-4a35-b610-c49df569bf8b",
                                "sense_id": "e7a2ddbb-7879-32ef-95f0-f6d30d0bada7",
                                "text": "„Diese Deformität ist das Ergebnis einer Verklebung (Anhaftung) zwischen dem Strang und der Haut, besonders im Bereich der distalen Hohlhandfurche.“"
                            },
                            {
                                "example_id": "7386fe3f-9922-4ca0-848d-040ab6d16b2f",
                                "sense_id": "e7a2ddbb-7879-32ef-95f0-f6d30d0bada7",
                                "text": "„Eine Wiederherstellung der Handfunktion und des Erscheinungsbildes ist bei dieser schweren und vielschichtigen Deformität kaum möglich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
