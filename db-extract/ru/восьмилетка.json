                        "glosses": [
                            "разг. неполная средняя восьмилетняя общеобразовательная школа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d6763c7-adcb-4148-857e-57324249c795",
                                "sense_id": "3c712509-b09f-30fe-a5a0-4119a9a39da2",
                                "text": "Поступающие к нам после восьмилетки учатся три с половиной года, а окончившие десять классов ― два с половиной."
                            }
                        ]
                    },
