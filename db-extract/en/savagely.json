                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "db5e7796-e821-3613-a978-8527377a3ff9",
                                        "entry_id": "a98bcbd3-e123-3650-9ea8-5c6ab31221bf",
                                        "glosses": [
                                            "mit wenig Selbstbeherrschung, ohne Selbstkontrolle"
