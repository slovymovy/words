                        "examples": [
                            {
                                "example_id": "4de9a7c7-760c-43f2-86ba-24088f2f6e71",
                                "sense_id": "f4a67117-6950-3247-bcad-6f2b5565abcb",
                                "text": "Le second, octogonal à pans, d’après le modèle de Pierre Chabrol (1881-1967), présenté avec sa gouache préparatoire, évoque le rythme syncopé et la polyrythmie du jazz qui fait partie du paysage sonore des Années folles."
                            },
                            {
                                "example_id": "548da28e-0a41-46fe-9df9-8168ec8c4ae3",
                                "sense_id": "f4a67117-6950-3247-bcad-6f2b5565abcb",
                                "text": "Anselme Chabrol prend sa place dans le cantou."
                            },
                            {
                                "example_id": "ef476589-76ca-4a0f-aba7-f09ad38f530d",
                                "sense_id": "f4a67117-6950-3247-bcad-6f2b5565abcb",
                                "text": "Sylvestre-Marcellin Chabrol a mis bien du temps pour se décider."
                            }
                        ]
                    }
                ],
