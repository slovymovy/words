                    {
                        "sense_id": "de937397-761d-330c-85a0-d31c979ab72d",
                        "entry_id": "0f440d49-a21e-354f-a585-f4a6210855df",
                        "glosses": [
                            "Desolate, boring and depressing."
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ddee76d9-439d-4b33-9979-7b8c7d2edd03",
                                "sense_id": "de937397-761d-330c-85a0-d31c979ab72d",
                                "text": "I wanted nothing more than to get out of that godforsaken place without delay."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be8c3593-01f7-464b-992a-13b978354b16",
                        "source_entry_id": "0f440d49-a21e-354f-a585-f4a6210855df",
                        "source_sense_description": "desolate, boring and depressing",
                        "target_lang_word": "godverlaten",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
