                "translations": [
                    {
                        "translation_id": "8536fc0a-08c9-45ac-980f-be781c015fd3",
                        "source_entry_id": "b95cd68e-1e1a-32e8-a887-65c438b52b07",
                        "source_sense_id": "fab0814a-ef24-38f6-a6a0-711de7408cf1",
                        "target_lang_word": "potro",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "potro",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f8afe903-57e7-3962-8f57-9cc95bf17912",
                                        "entry_id": "443ef193-a727-31f5-a351-6be6b9667c08",
                                        "glosses": [
                                            "Cría joven del caballo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8255ba3c-0af2-45b2-8f88-4ab931110867",
                                                "sense_id": "f8afe903-57e7-3962-8f57-9cc95bf17912",
                                                "text": "E otrosy que el pueblo de la puebla de Villafranca del Arçobispo que no paguen alcavala de las cosas que se vendieren en el dicho lugar para su proveymiento salvo del pan en grano que no sean para su proveymiento e de los ganados bivos e de las pieças de paño enteras e de las asemilas e potros e asnos e yeguas e puercos e vacas e bueyes que se vendieran que non sean de su labrança para su mantenimiento que es mi merçed que de lo tal paguen el alcavala dello."
                                            },
                                            {
                                                "example_id": "b93f3360-d46d-4c69-806c-b37b52f7301a",
                                                "sense_id": "f8afe903-57e7-3962-8f57-9cc95bf17912",
                                                "text": "¡Y el jamelgo moribundo vuelve a soñar que es potro, mas nunca pasó de potranco haragán y pendenciero!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c917c865-d005-3a7c-9324-51ec01b8cdcf",
                                        "entry_id": "443ef193-a727-31f5-a351-6be6b9667c08",
                                        "glosses": [
                                            "Jaula o estructura usada para inmovilizar al ganado para herrarlo o tratarlo. Por extensión, encerrado."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a2c0797c-de55-3b7b-9c4e-47ed8b493100",
                                        "entry_id": "443ef193-a727-31f5-a351-6be6b9667c08",
                                        "glosses": [
                                            "Instrumento de tortura, en que una polea tira de los miembros de la víctima para descoyuntarlos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2736b6e-70ca-4262-bb63-96187653cab8",
                                                "sense_id": "a2c0797c-de55-3b7b-9c4e-47ed8b493100",
                                                "text": "los tormentos cruelísimos que pasaron, de agua, y fuego, de hambre y sed, de calor y frio, de pobreza y desnudez, de cárceles, prisiones, cadenas, potros, peines de hierro, de bestias fieras, horcas, ruedas, quebrantamiento de huesos."
                                            },
                                            {
                                                "example_id": "54fdfe3b-4396-4ab9-be52-3d35af02c0ee",
                                                "sense_id": "a2c0797c-de55-3b7b-9c4e-47ed8b493100",
                                                "text": "Ocupava una silla de costillas pálidas, un tiempo ya marfiles, embaraçando un trono de eqúleos, potros y catastas, como presidenta de tormentos donde todos los días son aciagos Martes."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8a5ecbc6-c10e-37f6-a1a3-bd145ee44576",
                                        "entry_id": "443ef193-a727-31f5-a351-6be6b9667c08",
                                        "glosses": [
                                            "Por extensión, cosa molesta o gravosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d42eb08-dd16-4d0e-becf-bed6cc55e730",
                                                "sense_id": "8a5ecbc6-c10e-37f6-a1a3-bd145ee44576",
                                                "text": "A doctores y letrados,\npotros tan inexorables\nque matan cuerpos y pleitos,\na estos, señor, desterraldes."
                                            },
                                            {
                                                "example_id": "6fec2921-4797-42b4-a491-97449919adfb",
                                                "sense_id": "8a5ecbc6-c10e-37f6-a1a3-bd145ee44576",
                                                "text": "El sofá y los dos sillones, que hoy nos parecerían potros de suplicio, eran de lo más selecto."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3c74dd63-2878-3555-b299-c53a76247f12",
                                        "entry_id": "443ef193-a727-31f5-a351-6be6b9667c08",
                                        "glosses": [
                                            "Aparato de gimnasia, a modo de un tablón sobre patas, forrado de material acolchado, sobre el cual el gimnasta realiza los ejercicios."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd435461-25c9-445e-8e91-d748dfc312b5",
                                                "sense_id": "3c74dd63-2878-3555-b299-c53a76247f12",
                                                "text": "La mayor parte de los ejercicios son sin aparatos, exigiendo de estos muy pocos, bastando con una escalera, cuerdas lisas y de nudos, banquetas y potros para los saltos."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "9f8ecfc1-0c12-3420-864f-9a5cc9dbff94",
                                        "entry_id": "443ef193-a727-31f5-a351-6be6b9667c08",
                                        "glosses": [
                                            "Prueba gimnástica realizada sobre este aparato."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "6b27a26e-f629-3f49-9cc7-c391f7137629",
                                        "entry_id": "443ef193-a727-31f5-a351-6be6b9667c08",
                                        "glosses": [
                                            "Sillón con estribos usado para la revisión ginecológica y el parto."
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "063fbe8d-3caf-3580-9987-f216b16fd3d9",
                                        "entry_id": "443ef193-a727-31f5-a351-6be6b9667c08",
                                        "glosses": [
                                            "Hombre físicamente atractivo."
                                        ],
                                        "tags": [
                                            "Río-de-la-Plata"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "187f6ca2-448b-4b92-a3ad-03023d2c5102",
                                                "sense_id": "063fbe8d-3caf-3580-9987-f216b16fd3d9",
                                                "text": "Buen día morocha (me dijo el potro de mi novio)."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
