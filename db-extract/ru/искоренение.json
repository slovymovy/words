                    {
                        "translation_id": "b9762acf-e434-47dd-b557-477e0e58468d",
                        "source_entry_id": "0a40bbe3-48e8-3708-8b13-bccdc3a4cf01",
                        "source_sense_id": "d222c6e1-524e-3184-9867-7539d31c0139",
                        "target_lang_word": "Ausmerzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausmerzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c00eca7-a90a-33ad-965f-fc503b56ed2e",
                                        "entry_id": "68901122-9381-30fa-a466-3d3928b70ae8",
                                        "glosses": [
                                            "restlose Beseitigung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c40fba71-23b5-4fba-b897-4a9973974540",
                                                "sense_id": "5c00eca7-a90a-33ad-965f-fc503b56ed2e",
                                                "text": "„Wir hoffen, dass dieser Preis sein (Obamas) Engagement stärken wird, als Staatschef der mächtigsten Nation der Erde weiter den Frieden und die Ausmerzung der Armut zu propagieren.“"
                                            },
                                            {
                                                "example_id": "5543ba17-e6a7-4215-a39e-1109dfe767aa",
                                                "sense_id": "5c00eca7-a90a-33ad-965f-fc503b56ed2e",
                                                "text": "„Der 1778 geborene Hauslehrer [Anmerkung: Friedrich Ludwig Jahn], uns allen bestens als \"Turnvater\" Jahn bekannt, engagierte sich vehement für die Ausmerzung der – vor allem – französischen Fremdwörter in der deutschen Sprache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a89a2833-6e32-4dca-a472-95220689fd78",
                        "source_entry_id": "0a40bbe3-48e8-3708-8b13-bccdc3a4cf01",
                        "source_sense_id": "d222c6e1-524e-3184-9867-7539d31c0139",
                        "target_lang_word": "Ausrottung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausrottung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                        "entry_id": "dfa9da4d-068a-3adc-a76b-bcf2e6092740",
                                        "glosses": [
                                            "komplette Tötung einer Gruppe oder Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91532438-add6-47d5-b7c7-c44f6960a44d",
                                                "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                                "text": "Überfischung kann zur Ausrottung von Fischarten führen."
                                            },
                                            {
                                                "example_id": "c4b79fa2-3144-42bf-93e3-8797e35f9d58",
                                                "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                                "text": "„Der Trieb zur Ausrottung mochte sich zu allen Zeiten an Gewalt entsprochen haben – monologisierte der Uralte –, aber daß die Menschen hierzu ihre Erfindungen und Konstruktionen einsetzten, berühre ihn absonderlich.“"
                                            },
                                            {
                                                "example_id": "ac9f642c-83d8-4373-8c3a-66322d5f441f",
                                                "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                                "text": "„Seine prägenden Kriegseindrücke gewann er in der Türkei: Er sah, wie die Türken unter dem Deckmantel des Weltkrieges ein internes Problem klammheimlich lösten: die Vertreibung und Ausrottung der Armenier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
