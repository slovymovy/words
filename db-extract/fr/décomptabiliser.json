                ],
                "senses": [
                    {
                        "sense_id": "8428ba1c-5a57-35e8-b263-7cc052f4afca",
                        "entry_id": "9c0ed3f5-214f-37c8-a5f5-27fec68685d7",
                        "glosses": [
                            "Ne plus comptabiliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7af3ade8-1ba1-4f20-abd0-b4d443b2bc77",
                                "sense_id": "8428ba1c-5a57-35e8-b263-7cc052f4afca",
                                "text": "Si, en substance, la quasi-totalité des risques et des avantages ont été transférés, l’actif doit être décomptabilisé."
                            },
                            {
                                "example_id": "df2943a3-8bfa-4bf1-864c-b5aac7016dbd",
                                "sense_id": "8428ba1c-5a57-35e8-b263-7cc052f4afca",
                                "text": "On ne peut pas décomptabiliser une session à choix parmi les sessions existantes, il faut toujours annuler la session concernée et toutes celles qui suivent."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b82896a-7930-3502-9205-d372a8c55585",
                        "entry_id": "9c0ed3f5-214f-37c8-a5f5-27fec68685d7",
                        "glosses": [
                            "Se défaire de son esprit comptable."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "89344012-5540-40df-bf54-e0d0adbfea41",
                                "sense_id": "9b82896a-7930-3502-9205-d372a8c55585",
                                "text": "Vous croisez des gens qui marchent, qui se reposent, qui se font du bien. Ils sont détendus, ils sourient, et vous avez envie de sourire à votre tour. Marcher permet de se décomptabiliser, de faire sortir le comptable de soi."
                            }
                        ]
                    }
                ],
