                                "target_senses": [
                                    {
                                        "sense_id": "1624d973-b5f6-325f-b4ba-0cd7568ffed7",
                                        "entry_id": "36825045-cd4a-3aa5-aeeb-1ce5d9bb8401",
                                        "glosses": [
                                            "Qualité d'un espace métrique complet, ou d'un espace vectoriel normé complet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f64a82bf-1f3d-30ad-add0-5e26a914c517",
                                        "entry_id": "36825045-cd4a-3aa5-aeeb-1ce5d9bb8401",
                                        "glosses": [
                                            "Qualité de ce qui est complet, exhaustif."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc29d075-20d6-4528-a3ba-9f49523e9ddc",
                                                "sense_id": "f64a82bf-1f3d-30ad-add0-5e26a914c517",
                                                "text": "La portée des données du point de vue géographique et ethnique, la qualité des statistiques — c’est-à-dire leur degré de complétude."
                                            },
                                            {
                                                "example_id": "e27d6822-9aba-4e05-accc-bef1e7b28b2d",
                                                "sense_id": "f64a82bf-1f3d-30ad-add0-5e26a914c517",
                                                "text": "Afin d’évaluer le degré de complétude des données sur la mortalité enregistrées dans les pays dotés de registres d’état civil, on a appliqué des techniques […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8ced7aa-64b2-3a9f-92b6-d2551cb485bb",
                                        "entry_id": "36825045-cd4a-3aa5-aeeb-1ce5d9bb8401",
                                        "glosses": [
                                            "Qualité de ce qui est terminé, achevé."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "601c98a0-5968-4f37-90d2-4d25cd862c47",
                                                "sense_id": "f8ced7aa-64b2-3a9f-92b6-d2551cb485bb",
                                                "text": "L'autorité de régulation a mis en ligne vendredi trois décisions « portant mise en demeure » les trois opérateurs « de se conformer à [leurs] obligations en matière de complétude des réseaux en fibre optique jusqu’à l’abonné en dehors des zones très denses »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc87fa6-648b-3e3e-b3f5-e1e5a9c6e8eb",
                                        "entry_id": "36825045-cd4a-3aa5-aeeb-1ce5d9bb8401",
                                        "glosses": [
                                            "Qualité d'un objet auquel on ne peut rien ajouter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
