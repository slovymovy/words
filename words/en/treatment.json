{
    "word_family": [
        "treat",
        "treatable",
        "untreated",
        "mistreatment",
        "maltreatment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                    "sense_definition": "Medical care given to a patient for an illness or injury.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended a new course of <w>treatment</w> for her condition.",
                            "target_lang_translations": {
                                "ru": "Врач порекомендовал новый курс <w>лечения</w> для её состояния.",
                                "zh": "医生为她的病情推荐了一种新的<w>治疗</w>方案。"
                            }
                        },
                        {
                            "text": "Early <w>treatment</w> is essential to prevent the disease from spreading.",
                            "target_lang_translations": {
                                "ru": "Раннее <w>лечение</w> необходимо для предотвращения распространения болезни.",
                                "zh": "及早<w>治疗</w>对于防止疾病扩散至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "course",
                        "therapy",
                        "medical care"
                    ],
                    "common_phrases": [
                        "medical treatment",
                        "receive treatment",
                        "respond to treatment",
                        "cancer treatment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинская помощь, оказываемая пациенту для лечения болезни или травмы.",
                        "zh": "为治疗疾病或伤痛而对病人进行的医疗护理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лечение",
                                "target_lang_sense_clarification": "процесс оказания медицинской помощи"
                            },
                            {
                                "target_lang_word": "терапия",
                                "target_lang_sense_clarification": "метод лечения, часто консервативный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "治疗",
                                "target_lang_sense_clarification": "医疗护理的过程"
                            },
                            {
                                "target_lang_word": "疗法",
                                "target_lang_sense_clarification": "具体的医疗手段或方法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5170d31-c668-3df7-bc4e-f2fa60d4ccce",
                    "sense_definition": "The manner in which someone behaves towards or deals with someone or something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers protested against their unfair <w>treatment</w> by the management.",
                            "target_lang_translations": {
                                "ru": "Рабочие протестовали против несправедливого <w>обращения</w> со стороны руководства.",
                                "zh": "工人们抗议管理层对他们不公正的<w>待遇</w>。"
                            }
                        },
                        {
                            "text": "Every citizen deserves equal <w>treatment</w> under the law.",
                            "target_lang_translations": {
                                "ru": "Каждый гражданин заслуживает равного <w>обращения</w> перед законом.",
                                "zh": "每一位公民在法律面前都应受到平等的<w>对待</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fair treatment",
                        "preferential treatment",
                        "ill treatment",
                        "equal treatment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Манера поведения по отношению к кому-либо или чему-либо.",
                        "zh": "对待某人或某事的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обращение",
                                "target_lang_sense_clarification": "поведение по отношению к кому-либо"
                            },
                            {
                                "target_lang_word": "отношение",
                                "target_lang_sense_clarification": "внутренняя позиция, проявляющаяся в поведении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对待",
                                "target_lang_sense_clarification": "以某种方式处理或看待"
                            },
                            {
                                "target_lang_word": "待遇",
                                "target_lang_sense_clarification": "受到的对待或境遇"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23e052ea-6bfc-3f2e-980d-35dbeeb79dca",
                    "sense_definition": "The use of a chemical, physical, or biological agent to preserve, clean, or alter something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city invested in a modern facility for sewage <w>treatment</w>.",
                            "target_lang_translations": {
                                "ru": "Город инвестировал в современное сооружение для <w>очистки</w> сточных вод.",
                                "zh": "该市投资建设了一座现代化的污水<w>处理</w>设施。"
                            }
                        },
                        {
                            "text": "This wood requires special <w>treatment</w> to withstand outdoor weather conditions.",
                            "target_lang_translations": {
                                "ru": "Эта древесина требует специальной <w>обработки</w>, чтобы выдерживать погодные условия на улице.",
                                "zh": "这种木材需要经过特殊的<w>处理</w>才能抵御户外的天气条件。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "water treatment",
                        "heat treatment",
                        "sewage treatment",
                        "chemical treatment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование химических, физических или биологических средств для сохранения, очистки или изменения чего-либо.",
                        "zh": "使用化学、物理或生物手段来保存、清洁或改变某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обработка",
                                "target_lang_sense_clarification": "технологический процесс воздействия на материал"
                            },
                            {
                                "target_lang_word": "очистка",
                                "target_lang_sense_clarification": "удаление загрязнений (например, воды)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "处理",
                                "target_lang_sense_clarification": "对物质进行加工或处置"
                            },
                            {
                                "target_lang_word": "净化",
                                "target_lang_sense_clarification": "去除杂质或污染物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1b92c1d-f164-3a4e-b3a6-f49c9cc5faaf",
                    "sense_definition": "A discussion or analysis of a subject in writing or speech.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book provides a comprehensive <w>treatment</w> of the history of art.",
                            "target_lang_translations": {
                                "ru": "Книга предлагает всестороннее <w>освещение</w> истории искусства.",
                                "zh": "这本书对艺术史进行了全面的<w>论述</w>。"
                            }
                        },
                        {
                            "text": "Her <w>treatment</w> of the complex topic was clear and insightful.",
                            "target_lang_translations": {
                                "ru": "Её <w>трактовка</w> этой сложной темы была ясной и глубокой.",
                                "zh": "她对这一复杂课题的<w>解读</w>既清晰又深刻。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "comprehensive treatment",
                        "detailed treatment",
                        "full treatment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обсуждение или анализ темы в письменной или устной форме.",
                        "zh": "以书面或口头形式对某一主题进行的讨论或分析。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освещение",
                                "target_lang_sense_clarification": "раскрытие темы в работе"
                            },
                            {
                                "target_lang_word": "трактовка",
                                "target_lang_sense_clarification": "интерпретация или способ подачи материала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "论述",
                                "target_lang_sense_clarification": "对主题的系统性阐述"
                            },
                            {
                                "target_lang_word": "解读",
                                "target_lang_sense_clarification": "对内容的分析或解释"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4a50667-6da3-3037-bcd8-3c3a9950ef02",
                    "sense_definition": "A written summary of a proposed film or television show, used to outline the plot before the script is written.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The screenwriter submitted a ten-page <w>treatment</w> to the studio executives.",
                            "target_lang_translations": {
                                "ru": "Сценарист представил руководителям студии десятистраничную <w>сценарную заявку</w>.",
                                "zh": "编剧向制片厂高管提交了一份十页的<w>故事梗概</w>。"
                            }
                        },
                        {
                            "text": "Before drafting the dialogue, he focused on getting the <w>treatment</w> right.",
                            "target_lang_translations": {
                                "ru": "Перед написанием диалогов он сосредоточился на том, чтобы правильно проработать <w>тритмент</w>.",
                                "zh": "在起草对白之前，他专注于把<w>故事梗概</w>写好。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "film treatment",
                        "write a treatment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменное краткое изложение сюжета фильма или телешоу перед написанием сценария.",
                        "zh": "电影或电视节目的书面梗概，用于在编写剧本前概述情节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сценарная заявка",
                                "target_lang_sense_clarification": "краткое описание замысла фильма"
                            },
                            {
                                "target_lang_word": "тритмент",
                                "target_lang_sense_clarification": "профессиональный термин: расширенная заявка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "故事梗概",
                                "target_lang_sense_clarification": "电影或剧本的初步构思描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40466a1b-4477-329d-b903-3b5ed9164c35",
                    "sense_definition": "Harsh or unpleasant behavior towards someone, often as a form of punishment or exclusion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After their argument, she gave him the silent <w>treatment</w> for a week.",
                            "target_lang_translations": {
                                "ru": "После их ссоры она неделю устраивала ему <w>бойкот</w>.",
                                "zh": "争吵过后，她对他进行了长达一周的<w>冷落</w>。"
                            }
                        },
                        {
                            "text": "He expected a warm welcome but got the cold <w>treatment</w> instead.",
                            "target_lang_translations": {
                                "ru": "Он ожидал теплого приема, но вместо этого получил холодный <w>приём</w>.",
                                "zh": "他本以为会受到热烈欢迎，结果却遭到了<w>冷遇</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "silent treatment",
                        "get the treatment"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in phrases like 'silent treatment'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Суровое или неприятное поведение по отношению к кому-либо, часто как форма наказания или исключения.",
                        "zh": "对某人采取的严厉或不友好的行为，通常作为惩罚或排斥的一种方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бойкот",
                                "target_lang_sense_clarification": "в контексте 'silent treatment'"
                            },
                            {
                                "target_lang_word": "приём",
                                "target_lang_sense_clarification": "встреча или реакция (в контексте 'cold treatment')"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冷落",
                                "target_lang_sense_clarification": "指冷处理或不理睬"
                            },
                            {
                                "target_lang_word": "对待",
                                "target_lang_sense_clarification": "指某种特定的态度或行为方式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}