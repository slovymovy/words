                "forms": [],
                "senses": [
                    {
                        "sense_id": "23d8a817-cdd5-3d14-bdbe-78c4bcb26b3a",
                        "entry_id": "356294e0-8a6c-3783-a821-0f3a385c71d6",
                        "glosses": [
                            "Langue romane parlée dans le Piémont, au nord-ouest de l’Italie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14c47ef8-5f9a-44e9-80ab-c65f114c9c8c",
                                "sense_id": "23d8a817-cdd5-3d14-bdbe-78c4bcb26b3a",
                                "text": "Commençons notre périple en Italie du Nord. Les dialectes dits « gallo-italiques » se subdivisent en cinq groupes : lombard, piémontais, ligure, émilien et romagnol."
                            },
                            {
                                "example_id": "a31f7abd-b41c-4f68-b180-052b1a8c02d5",
                                "sense_id": "23d8a817-cdd5-3d14-bdbe-78c4bcb26b3a",
                                "text": "En 2004, le piémontais a été reconnu comme langue régionale du Piémont par l’assemblée législative régionale."
                            }
                        ]
                    }
