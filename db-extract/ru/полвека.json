                                "target_senses": [
                                    {
                                        "sense_id": "1e0b042e-a72a-37ae-abb7-a94519ed7235",
                                        "entry_id": "8e12e4a2-ce32-3d67-b70f-d7edc709fd8c",
                                        "glosses": [
                                            "Alternative form of half-century."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "singular",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e38c69ee-2c2c-42fc-93b0-206b23263013",
                                                "sense_id": "1e0b042e-a72a-37ae-abb7-a94519ed7235",
                                                "text": "The centre-vestibule \"open\" type of coach, which met with a very lukewarm reception when first introduced over half-a-century ago, is now used in increasing numbers as a non-dining vehicle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf0c1af0-44a0-4150-b675-fdce7411e59f",
                        "source_entry_id": "8aa7d886-52dc-3ebf-975d-5ad6b8d8c243",
                        "source_sense_id": "8c26017a-5dc3-38a1-b841-8c4c98a08e1b",
