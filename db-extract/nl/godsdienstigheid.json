                                "sense_id": "5080c744-8605-3882-8e31-6276fd0e077a",
                                "text": "Zijn godsdienstigheid inspireerde velen om hetzelfde pad te volgen.",
                                "translation": "His religiousness inspired many to follow the same path.",
                                "english": "His religiousness inspired many to follow the same path."
                            },
