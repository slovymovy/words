                                "target_senses": [
                                    {
                                        "sense_id": "b3a9b1b6-fbba-3cc0-b919-dadc5f7e62eb",
                                        "entry_id": "d445299c-62f0-3feb-98f2-eefe06ed7eb6",
                                        "glosses": [
                                            "Technique de peinture à l’eau sur papier, avec des couleurs transparentes, ayant le moins d’épaisseur possible."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac07cd2d-9845-4660-a6cf-4033e7e066ab",
                                                "sense_id": "b3a9b1b6-fbba-3cc0-b919-dadc5f7e62eb",
                                                "text": "L’arrivée du régiment leur avait donné lieu de parler guerre et cheval, les deux seules choses, avec la peinture à l’aquarelle, sur lesquelles la province permette à un bon gentilhomme d’avoir quelque instruction."
                                            },
                                            {
                                                "example_id": "e5512aa6-e042-42b7-8aff-4bf0ab5dea8f",
                                                "sense_id": "b3a9b1b6-fbba-3cc0-b919-dadc5f7e62eb",
                                                "text": "À mesure que nous dressions nos cartes, mademoiselle de Lessay les lavait à l’aquarelle."
                                            },
                                            {
                                                "example_id": "1d5cf96d-5c51-4a80-95e3-3bdbd60333cb",
                                                "sense_id": "b3a9b1b6-fbba-3cc0-b919-dadc5f7e62eb",
                                                "text": "Peindre à l’aquarelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6798cfd3-776c-38d6-8044-ef59c0d87671",
                                        "entry_id": "d445299c-62f0-3feb-98f2-eefe06ed7eb6",
                                        "glosses": [
                                            "Œuvre peinte avec cette technique."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ceb4fe3-1b8e-40f6-9457-04000b223975",
                                                "sense_id": "6798cfd3-776c-38d6-8044-ef59c0d87671",
                                                "text": "Peintre d’aquarelles."
                                            },
                                            {
                                                "example_id": "4290b37f-1bbd-424e-ab61-0de196a77b7f",
                                                "sense_id": "6798cfd3-776c-38d6-8044-ef59c0d87671",
                                                "text": "Une collection d’aquarelles."
                                            }
                                        ]
                                    }
                                ]
