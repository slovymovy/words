{
    "word_family": [
        "flincher",
        "unflinching"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9da6f969-b0a2-3f6d-a0ba-da6c31fc6623",
                    "sense_definition": "To make a sudden, involuntary movement in response to pain, fear, or a sudden surprise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not <w>flinch</w> when the nurse inserted the needle into his arm.",
                            "target_lang_translations": {
                                "tr": "Hemşire iğneyi koluna batırdığında hiç <w>irkilmedi</w>."
                            }
                        },
                        {
                            "text": "She tried not to <w>flinch</w> from the blow, but the sudden movement made her jump.",
                            "target_lang_translations": {
                                "tr": "Darbe karşısında <w>irkilmemeye</w> çalıştı ama ani hareket onu sıçrattı."
                            }
                        }
                    ],
                    "synonyms": [
                        "cower",
                        "recoil"
                    ],
                    "common_phrases": [
                        "flinch from the blow",
                        "not even flinch"
                    ],
                    "target_lang_definitions": {
                        "tr": "Acı, korku veya ani bir şaşkınlık karşısında istemsizce irkilmek veya geri çekilmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "irkilmek",
                                "target_lang_sense_clarification": "Ani bir tepkiyle vücudun sarsılması."
                            },
                            {
                                "target_lang_word": "geri çekilmek",
                                "target_lang_sense_clarification": "Bir tehdit veya acı karşısında bedensel olarak uzaklaşma."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dac89a17-5c5a-3d2c-a752-63b0c0bd8701",
                    "sense_definition": "To shrink from or avoid an unpleasant task, duty, or difficult situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager did not <w>flinch</w> from making the difficult decision to lay off staff.",
                            "target_lang_translations": {
                                "tr": "Müdür, personeli işten çıkarma gibi zor bir kararı almaktan <w>çekinmedi</w>."
                            }
                        },
                        {
                            "text": "We must face our responsibilities and not <w>flinch</w> from duty when things get tough.",
                            "target_lang_translations": {
                                "tr": "Sorumluluklarımızla yüzleşmeli ve işler zorlaştığında görevden <w>kaçınmamalıyız</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flinch from duty",
                        "flinch from responsibility"
                    ],
                    "target_lang_definitions": {
                        "tr": "Zor bir görevden veya sorumluluktan kaçınmak, çekinmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çekinmek",
                                "target_lang_sense_clarification": "Zor bir durumdan kaçınma eğilimi."
                            },
                            {
                                "target_lang_word": "kaçınmak",
                                "target_lang_sense_clarification": "Sorumluluk almaktan imtina etmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dfa9d46-e856-34f8-b189-ba856659aaf1",
                    "sense_definition": "To let the foot slip from a ball when attempting to give a tight croquet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "croquet_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In croquet, if you <w>flinch</w> during a tight stroke, your turn immediately ends.",
                            "target_lang_translations": {
                                "tr": "Krokette, sıkı bir vuruş sırasında <w>ayağınızı kaydırırsanız</w> sıranız hemen biter."
                            }
                        },
                        {
                            "text": "He was careful not to <w>flinch</w> while securing his foot on the ball.",
                            "target_lang_translations": {
                                "tr": "Ayağını topun üzerinde sabitlerken <w>ayağını kaydırmamaya</w> dikkat ediyordu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mainly used in the context of the game of croquet"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kroket oyununda vuruş sırasında ayağın toptan kayması."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ayağı kaydırmak",
                                "target_lang_sense_clarification": "Kroket oyununa özgü teknik bir hata."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c19a03ff-f39a-38f6-a227-be7e18402025",
                    "sense_definition": "Alternative form of <w>flense</w>; to strip the blubber or skin from a whale or seal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "whaling_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whalers began to <w>flinch</w> the carcass alongside the ship.",
                            "target_lang_translations": {
                                "tr": "Balinacılar geminin yanındaki leşi <w>yüzmeye</w> başladılar."
                            }
                        },
                        {
                            "text": "They used specialized knives to <w>flinch</w> the blubber from the seal.",
                            "target_lang_translations": {
                                "tr": "Fokun yağını <w>yüzmek</w> için özel bıçaklar kullandılar."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "historical whaling terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Balina veya fok derisini ya da yağını yüzmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yüzmek",
                                "target_lang_sense_clarification": "Hayvan derisini veya yağını ayırmak."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c5726c5-1895-3c66-81ad-561b5c5d9bc6",
                    "sense_definition": "A sudden, physical, reflexive movement of flinching.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a sudden <w>flinch</w>, he pulled his hand away from the hot stove.",
                            "target_lang_translations": {
                                "tr": "Ani bir <w>irkilmeyle</w> elini sıcak sobadan çekti."
                            }
                        },
                        {
                            "text": "My eye doctor hates the <w>flinch</w> I have every time he tries to get near my eyes.",
                            "target_lang_translations": {
                                "tr": "Göz doktorum, gözlerime her yaklaştığında yaptığım <w>irkilmeden</w> nefret ediyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sudden flinch",
                        "involuntary flinch"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ani, istemsiz irkilme hareketi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "irkilme",
                                "target_lang_sense_clarification": "Refleksif bir hareket."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d12804c-778c-3944-8d27-952fdd40999c",
                    "sense_definition": "The slipping of the foot from a ball when attempting to give a tight croquet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "croquet_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A careless <w>flinch</w> ruined his chances of winning the croquet match.",
                            "target_lang_translations": {
                                "tr": "Dikkatsiz bir <w>ayağın kayması</w> kroket maçını kazanma şansını mahvetti."
                            }
                        },
                        {
                            "text": "The referee called a foul after observing a clear <w>flinch</w> during the shot.",
                            "target_lang_translations": {
                                "tr": "Hakem, vuruş sırasında bariz bir <w>ayağın kaymasını</w> gözlemledikten sonra faul çaldı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mainly used in the context of the game of croquet"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kroket oyununda vuruş sırasında ayağın toptan kayması durumu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ayağın kayması",
                                "target_lang_sense_clarification": "Kroket oyununda bir hata türü."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}