{
    "word_family": [
        "letter",
        "letterer",
        "lettered"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a775fa97-1758-35f5-85b5-b10cf16fa32c",
                    "sense_definition": "Letters or text written, printed, or inscribed on a surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "text_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lettering</w> on the ancient sign was completely worn away by the rain.",
                            "target_lang_translations": {
                                "es": "Las <w>letras</w> del letrero antiguo estaban completamente desgastadas por la lluvia."
                            }
                        },
                        {
                            "text": "Gold <w>lettering</w> decorated the dark spine of the old leather book.",
                            "target_lang_translations": {
                                "es": "Una <w>inscripción</w> dorada decoraba el lomo oscuro del viejo libro de cuero."
                            }
                        }
                    ],
                    "synonyms": [
                        "inscription",
                        "script"
                    ],
                    "common_phrases": [
                        "gold lettering",
                        "bold lettering"
                    ],
                    "target_lang_definitions": {
                        "es": "Letras o texto escritos, impresos o grabados sobre una superficie."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "letras",
                                "target_lang_sense_clarification": "caracteres o texto impreso o escrito"
                            },
                            {
                                "target_lang_word": "inscripción",
                                "target_lang_sense_clarification": "grabado o texto fijado en una superficie"
                            },
                            {
                                "target_lang_word": "rotulación",
                                "target_lang_sense_clarification": "conjunto de letras de un letrero o cartel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f26ed8de-174e-3009-bb34-5eec76f97bce",
                    "sense_definition": "The style, design, or art of drawing or inscribing letters.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "text_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She practiced hand <w>lettering</w> every day to improve her calligraphy skills.",
                            "target_lang_translations": {
                                "es": "Practicaba <w>rotulación</w> a mano todos los días para mejorar sus habilidades caligráficas."
                            }
                        },
                        {
                            "text": "The graphic designer selected clean, modern <w>lettering</w> for the new logo.",
                            "target_lang_translations": {
                                "es": "El diseñador gráfico eligió una <w>tipografía</w> limpia y moderna para el nuevo logotipo."
                            }
                        }
                    ],
                    "synonyms": [
                        "calligraphy",
                        "typography"
                    ],
                    "common_phrases": [
                        "hand lettering"
                    ],
                    "target_lang_definitions": {
                        "es": "Estilo, diseño o arte de dibujar o trazar letras."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "lettering",
                                "target_lang_sense_clarification": "arte o técnica de dibujar letras (anglicismo común)"
                            },
                            {
                                "target_lang_word": "rotulación",
                                "target_lang_sense_clarification": "diseño o estilo de las letras"
                            },
                            {
                                "target_lang_word": "tipografía",
                                "target_lang_sense_clarification": "estilo o diseño visual de las letras"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a346bee2-a2e2-3c39-a96c-861047d1d936",
                    "sense_definition": "Present participle of <w>letter</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist was busy <w>lettering</w> the shop window with white paint.",
                            "target_lang_translations": {
                                "es": "El artista estaba ocupado <w>rotulando</w> el escaparate de la tienda con pintura blanca."
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>lettering</w> the comic book pages before printing.",
                            "target_lang_translations": {
                                "es": "Pasó la tarde <w>rotulando</w> las páginas del cómic antes de imprimir."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Participio de presente del verbo 'letter': rotular, escribir o rotular a mano."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "rotulando",
                                "target_lang_sense_clarification": "dibujando o trazando letras"
                            },
                            {
                                "target_lang_word": "escribiendo",
                                "target_lang_sense_clarification": "poniendo texto con esmero"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}