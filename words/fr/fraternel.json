            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e5578a7-1d41-32a6-86e0-35d800beaeff",
                    "sense_definition": "Qui concerne un frère ou des frères, propre aux frères.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils partagent un lien <w>fraternel</w> très fort depuis leur tendre enfance."
                        },
                        {
                            "text": "Une vive rivalité <w>fraternelle</w> oppose souvent les deux garçons pendant les jeux."
                        }
                    ],
                    "common_phrases": [
                        "amour fraternel",
                        "lien fraternel"
                    ]
                },
                {
                    "sense_id": "83f82174-4b78-349c-a930-fc5224a82ded",
                    "sense_definition": "Qui manifeste une affection, une solidarité ou une bienveillance comparables à celles qui unissent des frères.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "solidarite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bénévole m'a accueilli avec un sourire chaleureux et une poignée de main <w>fraternelle</w>."
                        },
                        {
                            "text": "Les deux délégations ont échangé un salut <w>fraternel</w> avant de commencer les négociations de paix."
                        }
                    ],
                    "common_phrases": [
                        "salut fraternel",
                        "accolade fraternelle"
                    ]
                },
                {
                    "sense_id": "52e45ade-a4a5-3410-9988-db6d4d96a16d",
                    "sense_definition": "Relatif aux relations à l'intérieur d'une fratrie, entre frères et sœurs sans distinction de sexe.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La psychologue étudie l'importance des relations <w>fraternelles</w> dans l'épanouissement des enfants."
                        },
                        {
                            "text": "Les conflits <w>fraternels</w> sont fréquents dans les familles nombreuses mais s'apaisent avec l'âge."
                        }
                    ],
                    "synonyms": [
                        "adelphal",
                        "adelphique"
                    ],
                    "common_phrases": [
                        "relations fraternelles"
                    ]
                }
            ]
        }
