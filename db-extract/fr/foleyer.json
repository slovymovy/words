                        "examples": [
                            {
                                "example_id": "60e43e8c-f8da-4343-8508-1131b37d12fa",
                                "sense_id": "1354b0f8-1484-3232-80e3-879f2210358e",
                                "text": "Depuis, par malheur, quelque mauvais esprit lui a jeté un sort et l’a fait foleyer."
                            },
                            {
                                "example_id": "8d7905d6-e1a5-4365-88d2-bb27703ce46e",
                                "sense_id": "1354b0f8-1484-3232-80e3-879f2210358e",
                                "text": "Jeune homme, on y voit accourir, briller et foleyer dans les infinis de l’espoir la troupe enchantée des beaux jours."
                            }
                        ]
                    }
