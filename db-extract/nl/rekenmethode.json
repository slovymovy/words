                        "entry_id": "13c06385-222a-348e-8e73-23bbef03ab9f",
                        "glosses": [
                            "geheel van onderling afgestemde werkwijzen en leermiddelen voor het maken van sommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0822d6c2-3fb3-4132-94fd-a4356ccf6e73",
                                "sense_id": "6f27ad68-a8fa-33a5-a448-864fb39b2b7a",
                                "text": "In 1995 werd Vuurmans uitgever bij Meulenhoff Educatief (later ThiemeMeulenhoff), waar ze onder meer nog een rekenmethode ontwikkelde, ‘Alles Telt’."
                            },
                            {
                                "example_id": "d99e29d8-bbcb-4d32-8d57-7b2a04c3a8f0",
                                "sense_id": "6f27ad68-a8fa-33a5-a448-864fb39b2b7a",
                                "text": "Tjip de Jong kan de rekenmethoden met „rekenmuur”, „getallenslang”, „tegelvloer” of „rekenrek” niet meer volgen."
                            }
                        ]
