                "senses": [
                    {
                        "sense_id": "805dcd4d-2371-3e30-86a7-cae2d5bd9df9",
                        "entry_id": "ffa348ef-2cc0-3728-ba4f-ca8eadeb9643",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1818eb1f-ef44-439e-94d7-6542b9121f63",
                                "sense_id": "805dcd4d-2371-3e30-86a7-cae2d5bd9df9",
                                "text": "Frau Tscherning ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4d8243e8-c392-4b1c-8452-a2195fc83c7f",
                                "sense_id": "805dcd4d-2371-3e30-86a7-cae2d5bd9df9",
                                "text": "Herr Tscherning wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ba4a83ed-1e95-4a4b-9497-f18b2b5030b1",
                                "sense_id": "805dcd4d-2371-3e30-86a7-cae2d5bd9df9",
                                "text": "Die Tschernings fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "bd77f897-0ba2-4e65-a165-685bfe32a31a",
                                "sense_id": "805dcd4d-2371-3e30-86a7-cae2d5bd9df9",
                                "text": "Der Tscherning trägt nie die Pullover, die die Tscherning ihm strickt."
                            },
                            {
                                "example_id": "36a3a68e-c2cc-4b84-87fd-9d13325cb14a",
                                "sense_id": "805dcd4d-2371-3e30-86a7-cae2d5bd9df9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tscherning kommt, geht der Herr Tscherning.“"
                            },
                            {
                                "example_id": "1c4ecaa6-2502-4a4f-b621-39985ad7267b",
                                "sense_id": "805dcd4d-2371-3e30-86a7-cae2d5bd9df9",
                                "text": "Tscherning kommt und geht."
                            },
                            {
                                "example_id": "194ef46b-0abd-4a5c-83e3-0b7fdc84514b",
                                "sense_id": "805dcd4d-2371-3e30-86a7-cae2d5bd9df9",
                                "text": "Tschernings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
