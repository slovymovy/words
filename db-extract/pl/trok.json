                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0b43e66-6912-313c-ab57-d8070113f491",
                                        "entry_id": "15ce3169-f118-38b5-a051-e91ba8e2cb57",
                                        "glosses": [
                                            "To sharpen by rubbing on a strap; to strop."
                                        ],
