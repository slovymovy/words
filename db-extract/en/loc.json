                                "example_id": "00ff3a6e-04f8-4c92-841b-2990d1cbaa47",
                                "sense_id": "91a42c2b-cc3d-3590-8710-3d65d5593880",
                                "text": "The first contributor of an accepted new item (not a COA) is entitled to a free issue, as are all other Good People who send in locs, cartoons, etc."
                            },
                            {
                                "example_id": "0d9f4a96-ac4a-4da7-9f2a-9f0f024fe8aa",
                                "sense_id": "91a42c2b-cc3d-3590-8710-3d65d5593880",
                                "text": "Available for Trade, LoC, Contribution, goodwill (rarely) or even money."
                            }
