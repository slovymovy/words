                        "form": "die Kaffeekanne"
                    },
                    {
                        "form_id": "ad0d4bb8-b477-47b5-adbb-f38d528c774c",
                        "entry_id": "afd373ce-3051-37e4-ab09-1f089cf89df8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kaffeekannen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                        "entry_id": "afd373ce-3051-37e4-ab09-1f089cf89df8",
                        "glosses": [
                            "Behälter, in dem Kaffee zubereitet, warmgehalten, transportiert und serviert werden kann"
                        ],
                        "tags": [
                            "Geschirr"
                        ],
                        "examples": [
                            {
                                "example_id": "c2449f23-ee6e-4f68-9fac-c2f621082bbd",
                                "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                                "text": "Man sollte eine Kaffeekanne nicht für Tee benutzen."
                            },
                            {
                                "example_id": "568706c7-8454-4423-8665-658e71443432",
                                "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                                "text": "„Die silberne Kaffeekanne ist umgefallen und hat ihren Inhalt über das Tischtuch ergossen und einen Frühstücksteller zerschlagen.“"
                            },
                            {
                                "example_id": "b304e175-38c3-40ee-bbbb-16a6da81da73",
                                "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                                "text": "„Er machte Licht und zündete die Flamme unter der Kaffeekanne an.“"
                            },
                            {
                                "example_id": "91cdd6e6-5983-42a9-adc5-b0ccc6a2fdbb",
                                "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                                "text": "„Ich setzte mich an den gescheuerten Tisch und sah Anna zu, wie sie am Herd den Filter von der Kaffeekanne nahm und ihn zum Austropfen auf eine Tasse stellte.“"
                            },
                            {
                                "example_id": "9da7f293-d2fd-4144-b060-108f490d94d5",
                                "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                                "text": "„Ich sah die zierliche Frau, die unter der Totenliste gesessen hatte, mit einer Kaffeekanne herankommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6723325b-0a1e-4a95-84a8-0a14a4299d11",
                        "source_entry_id": "afd373ce-3051-37e4-ab09-1f089cf89df8",
                        "source_sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                        "source_sense_description": "Behälter, in dem Kaffee zubereitet, warmgehalten, transportiert und serviert werden kann",
                        "target_lang_word": "coffee pot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coffee pot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f69ef79-d2ca-3b50-9703-e06f12ad6ccb",
                                        "entry_id": "766efe3d-e4f2-3aa9-951c-b05344bb0f12",
                                        "glosses": [
                                            "A pot in which coffee is brewed or from which it is served."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a18c42ad-c6aa-4c8d-9644-c6106e70d6ab",
                                                "sense_id": "1f69ef79-d2ca-3b50-9703-e06f12ad6ccb",
                                                "text": "Philander went into the next room[…]and came back with a salt mackerel that dripped brine like a rainstorm. Then he put the coffee pot on the stove and rummaged out a loaf of dry bread and some hardtack."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f49301bb-c5a3-4898-b35e-093cede48cc2",
                        "source_entry_id": "afd373ce-3051-37e4-ab09-1f089cf89df8",
                        "source_sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                        "source_sense_description": "Behälter, in dem Kaffee zubereitet, warmgehalten, transportiert und serviert werden kann",
                        "target_lang_word": "cafetière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cafetière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5de9282-4aef-334b-86fa-3a901bbc7720",
                                        "entry_id": "96e40625-11ce-36af-bf27-103ef182294f",
                                        "glosses": [
                                            "Appareil où l’on prépare l’infusion de café ; machine à café."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0139e37d-3bab-4dbb-af77-3c620bdd6bf1",
                                                "sense_id": "d5de9282-4aef-334b-86fa-3a901bbc7720",
                                                "text": "Depuis qu’il était seul, Jean ne mangeait plus chez lui, et dans la cuisine il n’y avait qu’une cafetière métallique, enrobée dans du marc de café. Jean prenait beaucoup de café, et ne lavait jamais la cafetière."
                                            },
                                            {
                                                "example_id": "d95d0065-40cc-4776-933b-7f0830d1360e",
                                                "sense_id": "d5de9282-4aef-334b-86fa-3a901bbc7720",
                                                "text": "Elle avait mis la bouilloire et la cafetière en route et elle glissait des tranches de pain dans le toaster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bad1655-6835-3777-847c-4e3a65a58b1f",
                                        "entry_id": "96e40625-11ce-36af-bf27-103ef182294f",
                                        "glosses": [
                                            "Récipient où l’on verse cette infusion pour la servir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d77c30d9-9129-4a97-ac8e-43140db8e09f",
                                                "sense_id": "6bad1655-6835-3777-847c-4e3a65a58b1f",
                                                "text": "Il tenta de se servir un café mais cassa également la cafetière car il n’y connaissait rien […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49b6d4f2-7cee-3865-8c6c-f2254af3ff41",
                                        "entry_id": "96e40625-11ce-36af-bf27-103ef182294f",
                                        "glosses": [
                                            "Commerçante qui vend du café tout fait, ainsi que d’autres boissons, chaudes ou froides."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad16fe79-4a4a-49c0-b9ec-e5be69641178",
                                                "sense_id": "49b6d4f2-7cee-3865-8c6c-f2254af3ff41",
                                                "text": "Toute la vallée venait jadis y prendre modèle sur les turbans, les chapeaux à visière, les bonnets en fourrures chinoises de la belle cafetière, au luxe de laquelle contribuaient les gros bonnets de Soulanges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1237aae7-ed61-3645-89d9-e75517ed7f94",
                                        "entry_id": "96e40625-11ce-36af-bf27-103ef182294f",
                                        "glosses": [
                                            "Commerçante qui tient un café."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1bfd678-c537-461d-917a-587fadb0de24",
                                                "sense_id": "1237aae7-ed61-3645-89d9-e75517ed7f94",
                                                "text": "Après cela, il nous conta qu’étant entré dans un café en arrivant à La Haye, après s’y être suffisamment rafraîchi, il voulut payer l’hôtesse et que cette cafetière, qui est une grande et grosse Hollandaise, au lieu de prendre son argent, lui avait serré la main en fermant en même temps la sienne […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43495c11-c428-3720-9882-c8c8130238bc",
                                        "entry_id": "96e40625-11ce-36af-bf27-103ef182294f",
                                        "glosses": [
                                            "Femme qui aime à boire du café."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7af54b9b-2c1d-4635-abd6-a0f07b371ff5",
                                                "sense_id": "43495c11-c428-3720-9882-c8c8130238bc",
                                                "text": "J’offre le café. Je le trouve trop vite bu. J’offre une tournée de digestifs, deux tournées de digestifs. Odile refuse café et digestifs, et cependant, c’est une « cafetière » patentée !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "780f4156-47a4-3455-9667-a73a15348941",
                                        "entry_id": "96e40625-11ce-36af-bf27-103ef182294f",
                                        "glosses": [
                                            "Tête."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "177c561a-f844-4ace-a3c8-620dfe641aa8",
                                                "sense_id": "780f4156-47a4-3455-9667-a73a15348941",
                                                "text": "Son crâne porta sur la pierre\nAvec un beau bruit musical\nProduisant en sa cafetière\nUn bouleversement fatal"
                                            },
                                            {
                                                "example_id": "4d7f4052-c6ad-4bf9-8521-c51a8618ad6f",
                                                "sense_id": "780f4156-47a4-3455-9667-a73a15348941",
                                                "text": "Je rentre dans des rochers qui sont plantés au milieu du chemin, et en même temps quelqu’un saute sur le marchepied et me cogne sur la cafetière avec un truc qui me fait l’effet d’être le mot mexicain pour matraque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4853d7c2-4a8f-37cb-a65c-d29e08c7499e",
                                        "entry_id": "96e40625-11ce-36af-bf27-103ef182294f",
                                        "glosses": [
                                            "Cafard, mouchard, délateur."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd5275dc-4013-4093-891f-975bde1ba9ea",
                                                "sense_id": "4853d7c2-4a8f-37cb-a65c-d29e08c7499e",
                                                "text": "Adam récrimine : « Sale cafard ! » Le mot court : cafard ! cafetière !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c536a597-df18-4c30-9550-fc77291e28eb",
