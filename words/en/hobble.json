                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудная или неловкая ситуация; затруднительное положение.",
                        "tr": "Zor veya utanç verici bir durum; sıkıntılı bir vaziyet."
