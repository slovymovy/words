                "senses": [
                    {
                        "sense_id": "708785e7-8d2f-3d51-a1ab-4174840bb40d",
                        "entry_id": "1eb084d0-dae5-389c-afd5-1b74605e96a2",
                        "glosses": [
                            "офиц. снабжать довольствием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c73de770-cb85-43f0-bfde-b97a8790e877",
                                "sense_id": "708785e7-8d2f-3d51-a1ab-4174840bb40d",
                                "text": "Довольствовать армию хлебом и обмундированием."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd8e6db6-1b2c-4e70-81d2-1a1b326ca099",
                        "source_entry_id": "1eb084d0-dae5-389c-afd5-1b74605e96a2",
                        "source_sense_id": "708785e7-8d2f-3d51-a1ab-4174840bb40d",
                        "target_lang_word": "approvisionner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "approvisionner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09f41ed5-a8de-36bc-b1e4-42d4b993f164",
                                        "entry_id": "3d61a0e9-4038-360e-8f6b-973a76b8575e",
                                        "glosses": [
                                            "Munir de provisions ; rassembler ce qui est nécessaire à la consommation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98f01482-7c32-4651-a3a3-4a33e7a9af87",
                                                "sense_id": "09f41ed5-a8de-36bc-b1e4-42d4b993f164",
                                                "text": "Pendant toute la période des fiançailles, le futur gendre va, pour manifester sa bonne volonté au travail et rendre service à sa belle-mère, régulièrement approvisionner la maison de ses beaux-parents en bois de feu."
                                            },
                                            {
                                                "example_id": "1fb181ae-5696-4907-825c-218897f3e0d6",
                                                "sense_id": "09f41ed5-a8de-36bc-b1e4-42d4b993f164",
                                                "text": "En effet, ces territoires étaient-ils giboyeux? […] Les seules ressources du pays permettraient-elles d'approvisionner une factorerie, au moins pendant la saison d’été?."
                                            },
                                            {
                                                "example_id": "0ad415e4-6ad1-4a62-af84-f1d14d918c64",
                                                "sense_id": "09f41ed5-a8de-36bc-b1e4-42d4b993f164",
                                                "text": "Nos grandes places de guerre, Strasbourg et Metz, les véritables boulevards de notre défense, n’avaient été ni armées, ni approvisionnées."
                                            },
                                            {
                                                "example_id": "b794c098-2d82-456f-8272-c633f41a3130",
                                                "sense_id": "09f41ed5-a8de-36bc-b1e4-42d4b993f164",
                                                "text": "Je lui eusse offert un de ces londrès de choix dont ma sacoche est largement approvisionnée."
                                            },
                                            {
                                                "example_id": "46219060-281b-44d1-8314-4acad0bcf137",
                                                "sense_id": "09f41ed5-a8de-36bc-b1e4-42d4b993f164",
                                                "text": "Ils prirent possession du chalet et elle descendit au village les approvisionner en junk-food à prix d'or : frites au four, nuggets surgelés, glaces, sauces samouraï, ketchup et mayonnaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "250c0aa6-b01e-3b46-ab9d-2319fa55a246",
                                        "entry_id": "3d61a0e9-4038-360e-8f6b-973a76b8575e",
                                        "glosses": [
                                            "Mettre de l'argent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24d14e34-72a8-4b13-8f61-33f07d5627c2",
                                                "sense_id": "250c0aa6-b01e-3b46-ab9d-2319fa55a246",
                                                "text": "Approvisionner un compte bancaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0a877fb-01d2-3d3e-ba6a-af45dd0eef36",
                                        "entry_id": "3d61a0e9-4038-360e-8f6b-973a76b8575e",
                                        "glosses": [
                                            "Charger une arme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83211426-3d01-4df1-9363-709438b01015",
                                                "sense_id": "e0a877fb-01d2-3d3e-ba6a-af45dd0eef36",
                                                "text": "– Rassemblement en ligne sur deux rangs ! Approvisionnez ! Reposez armes ! Repos !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b4ba844-c19b-3098-8bb6-d3dfa61dd421",
                                        "entry_id": "3d61a0e9-4038-360e-8f6b-973a76b8575e",
                                        "glosses": [
                                            "Se fournir en provisions."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb134b8a-c527-4bda-8152-c58f82cec06a",
                                                "sense_id": "1b4ba844-c19b-3098-8bb6-d3dfa61dd421",
                                                "text": "Il ne faut pas négliger, en entrant en Turquie, de s’approvisionner en objets de toute espèce, parce qu’on ne trouve guère devant soi que l’espace et qu’il est souvent impossible de se procurer un morceau de pain, surtout si l’on arrive après le coucher du soleil."
                                            },
                                            {
                                                "example_id": "28fe637f-c8b6-4bd7-a87e-4b5d20ca61fa",
                                                "sense_id": "1b4ba844-c19b-3098-8bb6-d3dfa61dd421",
                                                "text": "Aucun dealeur local ne peut satisfaire la totalité de la nouvelle demande de cannabis et les jeunes les plus téméraires s’aventurent dans les cités des environs pour s’approvisionner, puis consomment et revendent dans les rues de leur quartier."
                                            },
                                            {
                                                "example_id": "90c7ca27-75ee-4821-9e78-27df7e105739",
                                                "sense_id": "1b4ba844-c19b-3098-8bb6-d3dfa61dd421",
                                                "text": "Pour ce faire, nous devons aller, entre autres, nous approvisionner en beurre à la laiterie qui se situe à mi-chemin entre Aumale et Gourchelles, plus précisément à Quincampoix-Fleuzy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "018b2df8-7971-4e31-8580-8c1a8f126a0e",
                        "source_entry_id": "1eb084d0-dae5-389c-afd5-1b74605e96a2",
                        "source_sense_id": "708785e7-8d2f-3d51-a1ab-4174840bb40d",
                        "target_lang_word": "ravitailler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ravitailler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "272004e3-0cf1-3d6e-9fc3-45bf30e1daa5",
                                        "entry_id": "7d1bd3c7-bbd2-3ce2-9511-241daf7c6471",
                                        "glosses": [
                                            "Pourvoir de vivres et de munitions une place, une flotte, une armée, une troupe qui en était démunie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d62ac8f-256f-4257-802e-ec552492edc8",
                                                "sense_id": "272004e3-0cf1-3d6e-9fc3-45bf30e1daa5",
                                                "text": "Sacramoro Visconti, qu’il avait laissé à Milan avec cent hommes d’armes, fit arborer sur les murs les étendards de France, et permit de ravitailler le château, toujours occupé par les Français."
                                            },
                                            {
                                                "example_id": "93e55766-80f2-4a83-a0ef-17d0c870a157",
                                                "sense_id": "272004e3-0cf1-3d6e-9fc3-45bf30e1daa5",
                                                "text": "Par là il entendait la plaine alluviale d’Attigny aussi bien que le grenier à blé situé entre Vouziers et le pied des Monts de Champagne, du côté de Grivy-Loisy qui ravitaillait en grains le marché de Charleville."
                                            },
                                            {
                                                "example_id": "b5c92fca-34af-443d-a52f-876329a98440",
                                                "sense_id": "272004e3-0cf1-3d6e-9fc3-45bf30e1daa5",
                                                "text": "Au fond de la pièce, le barman mélomane refait le plein de son distributeur de cacahuètes et essuie une dernière fois le comptoir, après avoir ravitaillé le présentoir d'œufs durs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56f4d087-bc17-3c4e-a4ea-921fbaae595b",
                                        "entry_id": "7d1bd3c7-bbd2-3ce2-9511-241daf7c6471",
                                        "glosses": [
                                            "D'autre part, Wynmalen a dû s'arrêter à Launois-sur-Vence pour être ravitaillé, puis dut atterrir de nouveau à Montigny sur route, à dix kilomètres de Metz. Il ne repartira que ce matin. — (Le Circuit européen - La première étape : Paris-Liège, dans L'Aurore : littéraire, artistique, sociale, 15ᵉ année, n° 4966 du lundi 19 juin 1911, p. 2)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ebcd975-ab14-38a2-b9c7-dc608aa309ad",
                                        "entry_id": "7d1bd3c7-bbd2-3ce2-9511-241daf7c6471",
                                        "glosses": [
                                            "Faire des emplettes pour pourvoir à ses besoins."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e57969cc-3033-4cbd-848a-f6eaf96c3988",
                                                "sense_id": "2ebcd975-ab14-38a2-b9c7-dc608aa309ad",
                                                "text": "Il a fait des achats pour ravitailler sa maison de campagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d2af11-9dc8-31e2-a694-335d99470661",
                                        "entry_id": "7d1bd3c7-bbd2-3ce2-9511-241daf7c6471",
                                        "glosses": [
                                            "Se pourvoir de vivres, faire ses emplettes."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a840f430-9c88-45dc-9e21-35d0b3a8962d",
                                                "sense_id": "23d2af11-9dc8-31e2-a694-335d99470661",
                                                "text": "À Ténériffe, le brick aborda pour se ravitailler et réparer son gouvernail."
                                            },
                                            {
                                                "example_id": "2b11708b-a3ca-4e1d-be1b-6e7ca96c3ee9",
                                                "sense_id": "23d2af11-9dc8-31e2-a694-335d99470661",
                                                "text": "Les îles Galapagos, autrefois inhabitées, n’étaient alors visitées que par quelques baleiniers qui venaient s’y ravitailler en eau."
                                            },
                                            {
                                                "example_id": "e0090617-c222-4533-af37-c48161c56b92",
                                                "sense_id": "23d2af11-9dc8-31e2-a694-335d99470661",
                                                "text": "On peut se ravitailler facilement à la ville voisine."
                                            },
                                            {
                                                "example_id": "d09b4ece-6c98-4261-83a5-2c7c540ea5d5",
                                                "sense_id": "23d2af11-9dc8-31e2-a694-335d99470661",
                                                "text": "Se ravitailler en arguments, en idées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
