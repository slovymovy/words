                        "examples": [
                            {
                                "example_id": "e64aabbf-1ed8-455f-b821-d084b588dd83",
                                "sense_id": "e97dbc17-00df-3e97-8fbd-617573454ec5",
                                "text": "Na afronding van zijn opleiding aan de Filmacademie richtte Van der Heyde in 1963, samen met onder anderen medestudenten Pim de la Parra en Wim Verstappen, het filmtijdschrift Skoop op. Het magazine, bedoeld om de gevestigde filmwereld op te schudden, was spraakmakend. Films van gevestigde regisseurs als Bert Haanstra werden neergesabeld."
                            },
                            {
                                "example_id": "054d9e35-8a68-4599-b583-d9e21c76fa69",
                                "sense_id": "e97dbc17-00df-3e97-8fbd-617573454ec5",
                                "text": "Eerder had het filmtijdschrift geschreven over het vertrek van actrice Rashida Jones bij Pixar. Zij nam volgens The Hollywood Reporter ontslag naar aanleiding van het gedrag van Lasseter. Jones ontkent dat en zegt dat haar ontslag \"om creatieve en filosofische redenen\" was, maar zegt wel blij te zijn dat er nu wordt gesproken over grensoverschrijdend gedrag."
                            }
                        ]
                    }
