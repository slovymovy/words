                "senses": [
                    {
                        "sense_id": "1f49c0a4-767f-3f71-aa32-6c4902fa580d",
                        "entry_id": "6e404c22-83ba-307d-a90f-64cdd86d2d9a",
                        "glosses": [
                            "Persistance chez l’adulte de certains caractères de l’enfance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43c5c5a8-259b-4bba-8d64-e2be1c5ec556",
                                "sense_id": "1f49c0a4-767f-3f71-aa32-6c4902fa580d",
                                "text": "À l’étude de l’infantilisme on a récemment joint celle du puérilisme, du féminisme, du masculinisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c377d0a-b98e-36c4-9fd5-af6c7f93991a",
                        "entry_id": "6e404c22-83ba-307d-a90f-64cdd86d2d9a",
                        "glosses": [
                            "Nature infantile."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "57283fb4-1792-4e38-a2ad-dcfe2f0a05fc",
                                "sense_id": "3c377d0a-b98e-36c4-9fd5-af6c7f93991a",
                                "text": "Un écrivain de second ordre peut faire un scénariste génial, alors qu'un Bunuel, un Eisenstein ou un Walt Disney, dans la littérature, ne feraient pas illusion une minute : leur infantilisme éclaterait aussitôt."
                            }
                        ]
                    }
                ],
