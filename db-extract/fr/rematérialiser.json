                "senses": [
                    {
                        "sense_id": "86f65099-d76d-313c-9e17-7bd1275accd4",
                        "entry_id": "48c0e7d0-c120-3a44-b8cb-ffae089d602e",
                        "glosses": [
                            "Matérialiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4df61dff-e8a7-4677-928d-91a42670fc1c",
                                "sense_id": "86f65099-d76d-313c-9e17-7bd1275accd4",
                                "text": "Un élancement douloureux lui traversa la tête, puis décrut, l’océan noir se dissipa et la réalité se rematérialisa autour de lui, petit à petit."
                            },
                            {
                                "example_id": "81360f51-48a5-41e5-98e6-f2984a2e5b61",
                                "sense_id": "86f65099-d76d-313c-9e17-7bd1275accd4",
                                "text": "Nous venons de nous rematérialiser très près de la zone où a abouti Kilya, après son dernier transfert."
                            },
                            {
                                "example_id": "7c820b02-c1fc-4eee-a3cd-849eacc53cb8",
                                "sense_id": "86f65099-d76d-313c-9e17-7bd1275accd4",
                                "text": "Il se laissa de nouveau entraîner vers la pièce attenante, et la cloison se rematérialisa derrière eux."
                            },
                            {
                                "example_id": "848344c5-d09e-400f-9469-6895ba84e07f",
                                "sense_id": "86f65099-d76d-313c-9e17-7bd1275accd4",
                                "text": "C’est précisément cet acte \"rematérialisé\" par le Greffe qu’il convient de joindre à l’acte de signification de la déclaration d’appel."
                            }
                        ]
                    }
                ],
