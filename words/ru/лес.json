    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd4dc584-030a-3ffa-8431-5201a756dde9",
                    "sense_definition": "Большая территория, густо заросшая деревьями и кустарниками.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "природа",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы часто ходим гулять в сосновый <w>лес</w> рядом с домом.",
                            "target_lang_translations": {
                                "en": "We often go for a walk in the pine <w>forest</w> near our house."
                            }
                        },
                        {
                            "text": "В этом <w>лесу</w> растёт много грибов и ягод.",
                            "target_lang_translations": {
                                "en": "Many mushrooms and berries grow in this <w>wood</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "густой лес",
                        "хвойный лес",
                        "лиственный лес"
                    ],
                    "target_lang_definitions": {
                        "en": "A large area densely covered with trees and underbrush."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forest",
                                "target_lang_sense_clarification": "large wooded area"
                            },
                            {
                                "target_lang_word": "wood(s)",
                                "target_lang_sense_clarification": "smaller wooded area or trees"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a257460-8808-3afd-9e15-56ee537c6d16",
                    "sense_definition": "Срубленные деревья, используемые как строительный материал или сырье.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "материалы",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для строительства нового дома привезли качественный <w>лес</w>.",
                            "target_lang_translations": {
                                "en": "High-quality <w>timber</w> was brought in for the construction of the new house."
                            }
                        },
                        {
                            "text": "На склад доставили <w>лес</w> для производства мебели.",
                            "target_lang_translations": {
                                "en": "<w>Lumber</w> was delivered to the warehouse for furniture manufacturing."
                            }
                        }
                    ],
                    "synonyms": [
                        "древесина"
                    ],
                    "common_phrases": [
                        "заготовка леса"
                    ],
                    "target_lang_definitions": {
                        "en": "Felled trees used as construction material or raw timber."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "timber",
                                "target_lang_sense_clarification": "wood prepared for building"
                            },
                            {
                                "target_lang_word": "lumber",
                                "target_lang_sense_clarification": "cut logs or planks"
                            },
                            {
                                "target_lang_word": "wood",
                                "target_lang_sense_clarification": "tree material"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "204eab09-3789-396e-a201-2168918870d9",
                    "sense_definition": "Множество высоких, вертикально стоящих предметов, напоминающих деревья.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "метафора",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После вопроса учителя в классе поднялся целый <w>лес</w> рук.",
                            "target_lang_translations": {
                                "en": "After the teacher's question, a whole <w>forest</w> of hands went up in the classroom."
                            }
                        },
                        {
                            "text": "На горизонте виднелся <w>лес</w> заводских труб.",
                            "target_lang_translations": {
                                "en": "A <w>forest</w> of factory chimneys was visible on the horizon."
                            }
                        }
                    ],
                    "common_phrases": [
                        "лес рук",
                        "лес мачт"
                    ],
                    "target_lang_definitions": {
                        "en": "A dense collection of tall, vertical objects resembling trees."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forest",
                                "target_lang_sense_clarification": "metaphorical dense collection"
                            },
                            {
                                "target_lang_word": "sea",
                                "target_lang_sense_clarification": "multitude or expanse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "680b3dd1-9503-3599-989d-b44e3410bc72",
                    "sense_definition": "Временная конструкция из досок или труб для работы на высоте (обычно во множественном числе).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "строительство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рабочие установили <w>леса</w> вокруг фасада здания для ремонта.",
                            "target_lang_translations": {
                                "en": "The workers erected <w>scaffolding</w> around the building's facade for repairs."
                            }
                        },
                        {
                            "text": "Строительные <w>леса</w> были убраны после завершения покраски стен.",
                            "target_lang_translations": {
                                "en": "The <w>scaffolding</w> was dismantled after the wall painting was finished."
                            }
                        }
                    ],
                    "common_phrases": [
                        "строительные леса"
                    ],
                    "target_lang_definitions": {
                        "en": "A temporary structure of planks and poles for working at heights (usually plural)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scaffolding",
                                "target_lang_sense_clarification": "temporary construction platform"
                            },
                            {
                                "target_lang_word": "scaffold",
                                "target_lang_sense_clarification": "construction framework"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}