                ],
                "senses": [
                    {
                        "sense_id": "5ae80d3a-20df-343e-ac0e-6bab9c03eb55",
                        "entry_id": "9d1f3c40-4698-3871-817b-bddfc38ff029",
                        "glosses": [
                            "спец. связанный, соотносящийся по значению с существительным фаут; дефектный (о древесине, деревьях)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32d7ee6d-522c-485a-bcb4-d8477bbdc7b4",
                                "sense_id": "5ae80d3a-20df-343e-ac0e-6bab9c03eb55",
                                "text": "Деревьев с отмершими верхушками в лесу тоже не мало, но ещё больше здесь фаутных деревьев."
                            },
                            {
                                "example_id": "73bf699c-7838-444d-8633-81b726f9f446",
                                "sense_id": "5ae80d3a-20df-343e-ac0e-6bab9c03eb55",
                                "text": "Очищая насаждения от старых и фаутных деревьев, он никогда не противопоставлял друг другу лесоруба и лесничего."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "528649c4-684a-4e67-b2b1-39089bbc4e5f",
                        "source_entry_id": "9d1f3c40-4698-3871-817b-bddfc38ff029",
