                                "target_senses": [
                                    {
                                        "sense_id": "ceac37ed-ab77-380e-9389-96fd0cceec56",
                                        "entry_id": "4d0191f3-a7f8-35ca-a3d4-b5ec434c3c03",
                                        "glosses": [
                                            "podmiot prowadzący działalność gospodarczą w interesie swoich członków"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dae85c54-cbfd-468a-b06e-a00204d0c9dd",
                                                "sense_id": "ceac37ed-ab77-380e-9389-96fd0cceec56",
                                                "text": "Obecnie domy wielorodzinne są zarządzane przeważnie przez wspólnoty mieszkaniowe albo spółdzielnie mieszkaniowe."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "1162741c-7416-3da5-9829-8b19b0ecc5cc",
                                        "entry_id": "4d0191f3-a7f8-35ca-a3d4-b5ec434c3c03",
                                        "glosses": [
                                            "siedziba spółdzielni (1.1) lub miejsce prowadzenia przez nią działalności"
                                        ],
