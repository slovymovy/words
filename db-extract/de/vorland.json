                "senses": [
                    {
                        "sense_id": "56f2b002-b687-3397-a26d-966338c9a4bc",
                        "entry_id": "9085e610-795c-3065-af87-6d0c50879519",
                        "glosses": [
                            "Bereich vor einem Gebirge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07a24496-d025-4450-8fe8-9f7f0f2eeeea",
                                "sense_id": "56f2b002-b687-3397-a26d-966338c9a4bc",
                                "text": "„Er ließ seine Soldaten bis ins Vorland des Kaukasusgebirges marschieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ecdb38c0-47f7-3c89-b5c5-3d8d76226a06",
