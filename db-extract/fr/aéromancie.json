                                "target_senses": [
                                    {
                                        "sense_id": "1ecc6594-5538-31d8-8380-0014015407d5",
                                        "entry_id": "8400b38b-04ba-3dab-b004-20969a9d0d64",
                                        "glosses": [
                                            "Divination by use of atmospheric conditions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "373c6aa1-e280-47d1-a33e-8042774f4030",
                                                "sense_id": "1ecc6594-5538-31d8-8380-0014015407d5",
                                                "text": "\"If these apparitions are in the Ayre, then it is called Aeromancie.\" -- Astrologaster, J. Melton, 1620"
                                            },
                                            {
                                                "example_id": "6c0208c6-0700-4b60-b1dd-a2e115505184",
                                                "sense_id": "1ecc6594-5538-31d8-8380-0014015407d5",
                                                "text": "\"Have you a mind, quoth Her Trippa, to have the truth of the matter yet more fully and amply disclosed unto you by..aeromancy, whereof Aristophanes in his Clouds maketh great estimation..?\" -- Works of Rabelais III, 1951"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
