                    },
                    {
                        "translation_id": "81184cc8-c379-44b3-aa32-3730d41e57fc",
                        "source_entry_id": "a2e058b3-ff01-3495-bcd9-dd0a4ad614d0",
                        "source_sense_id": "ed1336fb-347d-3dea-b51a-43041b2f7010",
                        "target_lang_word": "Bank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba7f456-1514-3c75-8b18-9edc21b5e9e9",
                                        "entry_id": "918c8cc9-6949-34ed-b44a-76b4ec3112f7",
                                        "glosses": [
                                            "Sitz- oder Ablagegelegenheit für mehrere Personen oder Dinge nebeneinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed38d04f-a778-4471-8338-84b2f3e82251",
                                                "sense_id": "1ba7f456-1514-3c75-8b18-9edc21b5e9e9",
                                                "text": "Sollen wir uns auf diese Bank setzen?"
                                            },
                                            {
                                                "example_id": "dbdca521-9d19-4cf1-a0ab-62694b78c0a3",
                                                "sense_id": "1ba7f456-1514-3c75-8b18-9edc21b5e9e9",
                                                "text": "„Nach dem Abendessen gingen Sung und Hideo auf eine Runde in den Park und saßen dann lange schweigend auf einer Bank am Teich.“"
                                            },
                                            {
                                                "example_id": "ec7b75ec-2e78-4db8-b7b4-554d82416595",
                                                "sense_id": "1ba7f456-1514-3c75-8b18-9edc21b5e9e9",
                                                "text": "„Smoaks setzte sich auf die gegenüberliegende Bank und sah ihn an.“"
                                            },
                                            {
                                                "example_id": "ee053a39-3a6e-4ba1-8543-5d76428a26f4",
                                                "sense_id": "1ba7f456-1514-3c75-8b18-9edc21b5e9e9",
                                                "text": "„Die kleine Bank mit den zwei Kissen war fortgeräumt, und statt ihrer stand eine Chaiselongue da, darauf die Kranke ruhte, den Oberkörper mit einem Schal, die Füße mit einer Reisedecke zugedeckt, in die das Wappen der St. Arnauds oder vielleicht auch das der Woronesch von Zacha eingestickt war.“"
                                            },
                                            {
                                                "example_id": "e6075fce-c722-4a87-bc8b-e905dd57266e",
                                                "sense_id": "1ba7f456-1514-3c75-8b18-9edc21b5e9e9",
                                                "text": "„Darüber wurde der Fußboden eingezogen, und an den Wänden stellte man Bänke auf, die gleichzeitig als Truhen dienten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a418b432-0031-39c7-903d-3f38e46b6059",
                                        "entry_id": "918c8cc9-6949-34ed-b44a-76b4ec3112f7",
                                        "glosses": [
                                            "geologische Formation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fddcae1b-8a69-45c4-8fe7-50bcac3aff76",
                                                "sense_id": "a418b432-0031-39c7-903d-3f38e46b6059",
                                                "text": "„Eine Bank oder die Lage (lat. stratum, engl. bed, layer, abgekürzt Bk. oder Lg.) ist im Sprachgebrauch der Geologie, Geotechnik und Stratigraphie eine vom umliegenden Gestein deutlich in Struktur, Farbe oder Material gesonderte, zusammenhängende Gesteinsschicht.“"
                                            },
                                            {
                                                "example_id": "b3db0970-3792-4c63-a3db-f822d8c99c59",
                                                "sense_id": "a418b432-0031-39c7-903d-3f38e46b6059",
                                                "text": "Diese kalkhaltige Bank wurde von Steinsuchern in den letzten Jahrzehnten weitgehend abgebaut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cbef16e0-d889-3cdf-8a4d-b72f4fb73992",
                                        "entry_id": "918c8cc9-6949-34ed-b44a-76b4ec3112f7",
                                        "glosses": [
                                            "Ablagerung von Material in einem Gewässer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa5e0ff8-9489-414a-9b24-75515e1c9e1e",
                                                "sense_id": "cbef16e0-d889-3cdf-8a4d-b72f4fb73992",
                                                "text": "In dieser Flussschlinge hat die Strömung eine schöne Bank gebildet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2f7c03f9-6d38-3d78-9bc0-6315d98d9f33",
                                        "entry_id": "918c8cc9-6949-34ed-b44a-76b4ec3112f7",
                                        "glosses": [
                                            "Anhäufung biologischer Rückstände auf dem Meeresgrund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ceec3af-43e7-44d6-8d9f-91ce81614e5e",
                                                "sense_id": "2f7c03f9-6d38-3d78-9bc0-6315d98d9f33",
                                                "text": "Eine besondere Art von Bank ist das Korallenriff."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2ad07ea0-b714-311e-9bba-9982b3ab5be3",
                                        "entry_id": "918c8cc9-6949-34ed-b44a-76b4ec3112f7",
                                        "glosses": [
                                            "Verkaufstisch oder Ladentisch für Käse, Fleisch, Fisch, Salat oder Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f9a5e4d-c5ed-4359-877d-b8e673f946b6",
                                                "sense_id": "2ad07ea0-b714-311e-9bba-9982b3ab5be3",
                                                "text": "Vor der Bank des Konsumvereins waren Frauen, Kinder und Männer zu sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "cbba4127-f3e1-3ea2-92c6-051df8e62ca1",
                                        "entry_id": "918c8cc9-6949-34ed-b44a-76b4ec3112f7",
                                        "glosses": [
                                            "Auswechselbank, Ersatzbank"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b30cae84-a8d0-443b-8923-26e52b8fd24f",
                                                "sense_id": "cbba4127-f3e1-3ea2-92c6-051df8e62ca1",
                                                "text": "„Der Nationalspieler hatte sein Zwicken im Muskel aus der Vorwoche zwar auskuriert, er blieb aber wie so oft zunächst auf der Bank.“"
                                            },
                                            {
                                                "example_id": "dfe7a1ac-5efd-49a1-9e28-9dbe5c03d197",
                                                "sense_id": "cbba4127-f3e1-3ea2-92c6-051df8e62ca1",
                                                "text": "„Die vorgenommenen Wechsel (durchschnittlich 4,23 pro Spiel) zeigten oft Wirkung: Sieben Scorerpunkte - vier Tore und drei Assists - kamen bei den Hamburgern bislang von der Bank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e696bba-b8f3-3be1-a086-1efcf27035cc",
                                        "entry_id": "0542ecb6-5bd0-3aa7-818f-e266eb009d7f",
                                        "glosses": [
                                            "Geldinstitut für Finanzdienstleistungen"
                                        ],
                                        "tags": [
                                            "finance"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291e0369-3147-40cb-ab42-d7f90602bd2f",
                                                "sense_id": "9e696bba-b8f3-3be1-a086-1efcf27035cc",
                                                "text": "Diese Bank wäre bei dem Großbrand gestern fast abgebrannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ae15dab-988b-30aa-8f9d-10e8bc4603de",
                                        "entry_id": "0542ecb6-5bd0-3aa7-818f-e266eb009d7f",
                                        "glosses": [
                                            "Glücksspiellokal; auch eine der Spielparteien kann als Bank bezeichnet werden (beim Roulette gewinnt die Bank, wenn keine der gesetzten Kombinationen fällt), oder auch ein zentraler Vorrat, der selbst nicht am Wettstreit teilnimmt, kann so bezeichnet werden (beispielsweise der Vorrat an Straßen, Häusern und Hotels, die beim Monopoly bisher noch von keinem Mitspieler gekauft wurden)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d41dfe03-377c-4bcf-87fc-c08eca860d9d",
                                                "sense_id": "9ae15dab-988b-30aa-8f9d-10e8bc4603de",
                                                "text": "Keiner hat richtig gesetzt, die Einsätze gehen an die Bank."
                                            },
                                            {
                                                "example_id": "9c421a57-aa0a-437f-851b-32e7da86a20a",
                                                "sense_id": "9ae15dab-988b-30aa-8f9d-10e8bc4603de",
                                                "text": "„Ein sehr ehrenwerter Patrizier hatte mich mit einem Viertel an seiner Bank beteiligt und übergab mir in den ersten Tagen der Fastenzeit eine ziemlich bedeutende Summe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
