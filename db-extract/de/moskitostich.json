                "senses": [
                    {
                        "sense_id": "9dea1367-6220-335f-b313-ca3a120a0142",
                        "entry_id": "5721f120-db02-3562-ad96-e59fe7192143",
                        "glosses": [
                            "Insektenstich von einem Moskito"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d047413b-3ab5-473c-8ca6-8d6e8e7939f2",
                                "sense_id": "9dea1367-6220-335f-b313-ca3a120a0142",
                                "text": "„Ich hatte kein Verlangen nach der Authentizität eines dörflichen Lebens mit meinen gehässigen Cousins, Cousinen und ungnädigen Tanten oder der rustikalen Realität, mir beim Klogang durch einen Moskitostich die Malaria einzufangen, was einigen der vietnamesischen Komparsen durchaus zustoßen könnte.“"
                            },
                            {
                                "example_id": "58f64e2f-a12a-4b23-a885-782c85a7cca1",
                                "sense_id": "9dea1367-6220-335f-b313-ca3a120a0142",
                                "text": "„Nach einigem Suchen wurde er in einem Geräteschuppen entdeckt, übersät von Moskitostichen.“"
                            },
                            {
                                "example_id": "69e1879f-ead8-4c35-affe-ccc3ba24f7ca",
                                "sense_id": "9dea1367-6220-335f-b313-ca3a120a0142",
                                "text": "„Jenseits der Moskitostiche und Pickel stehen Branch Bacardi und Cord Cuervo, sie stecken die Köpfe zusammen und reden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
