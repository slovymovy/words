                        "glosses": [
                            "muur die dient om iets te beschermen tegen invloeden van buitenaf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dc31c5e-0b3b-412a-a507-2491209d6873",
                                "sense_id": "217950dc-b839-3aca-92ea-fcbb71c6f4cc",
                                "text": "Het Leninmuseum zelf is opgetrokken rondom het houten huis waarin Lenin werd geboren, als een eeuwig wakende betonnen beschermingswal."
                            },
                            {
                                "example_id": "224c6e9f-18d3-45ea-841a-5f3a19d4bc9b",
                                "sense_id": "217950dc-b839-3aca-92ea-fcbb71c6f4cc",
                                "text": "Het onschadelijk maken van de bom gaat zeker vijf uur duren. Het is de bedoeling dat het karwei vandaag wordt afgerond. Uit voorzorg is rond de vliegtuigbom een beschermingswal neergezet van zakken met stenen. Mocht de bom exploderen, dan moet de wal helpen de schade te beperken."
                            }
                        ]
                    },
                    {
                        "sense_id": "79c12538-e661-305a-a8c0-d9de62668019",
                        "entry_id": "b4c9da92-6c04-38eb-a6bf-4e266bd08992",
                        "glosses": [
                            "methode om een vijandige overname van een bedrijf te voorkomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee06d873-ba02-472c-bd85-76c69cdba4ae",
                                "sense_id": "79c12538-e661-305a-a8c0-d9de62668019",
                                "text": "Een eenmalige, tijdelijke beschermingswal kan nuttig zijn om het bestuur van een bedrijf de tijd te geven goed te reageren, maar die moet het bedrijf zelf optuigen, schrijft Eumedion in een verklaring."
                            }
                        ]
