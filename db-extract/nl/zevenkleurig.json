                        "examples": [
                            {
                                "example_id": "54b223a8-752b-48ba-a96e-6197137b767f",
                                "sense_id": "03f42f59-f600-36b0-807e-9a143b82f902",
                                "text": "Na een siësta en een viscurry op het oogverblindende strand van Le Morne rijden we naar de zevenkleurige heuvels van Chamarel. Bruin, rood, groen, blauw, oker, violet en purper; de golvende duinen kleuren de hele dag, maar zijn het mooist bij zonsondergang."
                            },
                            {
                                "example_id": "a17750fe-d332-43a6-bce9-3ef35f08e2f1",
                                "sense_id": "03f42f59-f600-36b0-807e-9a143b82f902",
                                "text": "Er zijn bergen in het binnenland en bezoek bijvoorbeeld het prachtige Black River George National Park met de 'seven coloured earth'. De zevenkleurige aarde dankt zijn kleuren aan het oxidatieproces van vulkanische as. Adembenemend en het mooiste als de zon schijnt!"
                            }
                        ]
