                        ],
                        "form": "die Konfessionen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0c9c6bc-fb0c-34c6-a6f0-b26e851e9a45",
                        "entry_id": "f934991e-eabe-3df5-b9a7-8868e8562088",
                        "glosses": [
                            "Bekenntnis/Zugehörigkeit zu einer bestimmten Religion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a402b20b-3975-4736-9daa-69a85a0cc31c",
                                "sense_id": "c0c9c6bc-fb0c-34c6-a6f0-b26e851e9a45",
                                "text": "„Jürgen Baur ist römisch-katholischer Konfession, verheiratet, hat eine Tochter und einen Sohn.“"
                            },
                            {
                                "example_id": "d6e10861-d674-4a73-9dfb-564e6ae0f7f2",
                                "sense_id": "c0c9c6bc-fb0c-34c6-a6f0-b26e851e9a45",
                                "text": "„Die Freundschaft zwischen einer katholischen und einer protestantischen Familie war ungewöhnlich zu einer Zeit, in der sich die Konfessionen noch verständnislos gegenüberstanden.“"
                            },
                            {
                                "example_id": "8ae35d9c-d8d4-431f-b74b-834c754cfb7a",
                                "sense_id": "c0c9c6bc-fb0c-34c6-a6f0-b26e851e9a45",
                                "text": "„In Biberach wurden Rats- und Gerichtsstellen und städtische Ämter gleichberechtigt und zahlenmäßig gleich auf beide Konfessionen verteilt, es gab keine herrschende Religion, es galten die Feiertage beider Konfessionen, die Kirche wurde bikonfessionell genutzt, desgleichen das Hospital.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b109f5f7-c2c6-4f59-ac1c-aa4ec75dcca4",
                        "source_entry_id": "f934991e-eabe-3df5-b9a7-8868e8562088",
                        "source_sense_id": "c0c9c6bc-fb0c-34c6-a6f0-b26e851e9a45",
                        "source_sense_description": "Bekenntnis/Zugehörigkeit zu einer bestimmten Religion",
                        "target_lang_word": "denomination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denomination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2ff37bc-12ba-3dfb-a2b0-2579d3fbf5a0",
                                        "entry_id": "f5566d40-7c3a-3bc7-bc76-7afbc3ab6b46",
                                        "glosses": [
                                            "The act of naming or designating."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a735f6c5-6f20-3b85-971d-d4bb6e16e317",
                                        "entry_id": "f5566d40-7c3a-3bc7-bc76-7afbc3ab6b46",
                                        "glosses": [
                                            "That by which anything is denominated or styled; an epithet; a name, designation, or title; especially, a general name indicating a class of like individuals."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fd8557a-0506-4c7a-bfbf-35bc0ed1b1b2",
                                                "sense_id": "a735f6c5-6f20-3b85-971d-d4bb6e16e317",
                                                "text": "\"Will you allow me to present Sir George Evelyn to you?—the most accomplished coquet that ever 'Dealt destruction round the land On all he judged a foe;' under which denomination he ranks all women.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb12125-9736-3e70-ae85-9bd7cffc4da4",
                                        "entry_id": "f5566d40-7c3a-3bc7-bc76-7afbc3ab6b46",
                                        "glosses": [
                                            "A class, or society of individuals, called by the same name; a subdivision of a religion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7234a082-4e70-4b2e-9b18-4f5e4d51a1ba",
                                                "sense_id": "dcb12125-9736-3e70-ae85-9bd7cffc4da4",
                                                "text": "She follows the Ahmadiyya denomination of Islam."
                                            },
                                            {
                                                "example_id": "6bd80225-f014-49b0-a9aa-195a99481fa4",
                                                "sense_id": "dcb12125-9736-3e70-ae85-9bd7cffc4da4",
                                                "text": "Denomination does more than create space in which to discern, however. It also provides a means for living out differing forms of a faithful Christian life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfaf9ded-6069-38fe-987e-a57fe55082c9",
                                        "entry_id": "f5566d40-7c3a-3bc7-bc76-7afbc3ab6b46",
                                        "glosses": [
                                            "A unit in a series of units of weight, money, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4ca7a10-9489-4cd2-92a6-477b049ee8f8",
                                                "sense_id": "bfaf9ded-6069-38fe-987e-a57fe55082c9",
                                                "text": "What denomination is that money? They are all 50 euro notes."
                                            },
                                            {
                                                "example_id": "cca60b63-bfb2-4bcd-be45-a220e59d0a32",
                                                "sense_id": "bfaf9ded-6069-38fe-987e-a57fe55082c9",
                                                "text": "In 1823, a further issue of treasury notes was ordered to the amount of $100,000, in denominations of five to seventy-five cents, receivable for dues to the State."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1546874f-7f48-4f88-92e0-126ca98589d3",
                        "source_entry_id": "f934991e-eabe-3df5-b9a7-8868e8562088",
                        "source_sense_id": "c0c9c6bc-fb0c-34c6-a6f0-b26e851e9a45",
                        "source_sense_description": "Bekenntnis/Zugehörigkeit zu einer bestimmten Religion",
                        "target_lang_word": "confession",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confession",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9ead7e9-fe92-3692-9e1b-4a7396ff4b19",
                                        "entry_id": "eb8a3a3b-010d-3a6f-be0a-00d990ee2728",
                                        "glosses": [
                                            "Aveu, déclaration que l’on fait de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f279d810-7aed-45d1-820f-c25e954b8ac3",
                                                "sense_id": "d9ead7e9-fe92-3692-9e1b-4a7396ff4b19",
                                                "text": "Confession sincère, franche, ingénue."
                                            },
                                            {
                                                "example_id": "7f6512a1-08ae-4608-be3b-9f4344cfebb7",
                                                "sense_id": "d9ead7e9-fe92-3692-9e1b-4a7396ff4b19",
                                                "text": "confession forcée, extorquée."
                                            },
                                            {
                                                "example_id": "a5804b14-353b-425e-9ab1-882bed398cbc",
                                                "sense_id": "d9ead7e9-fe92-3692-9e1b-4a7396ff4b19",
                                                "text": "Désirez-vous une plus ample confession ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccfe54b1-d9b8-3df6-89bc-a1ebc38bbdee",
                                        "entry_id": "eb8a3a3b-010d-3a6f-be0a-00d990ee2728",
                                        "glosses": [
                                            "Confession de foi."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a212529-d0bf-4582-9463-8c095832e006",
                                                "sense_id": "ccfe54b1-d9b8-3df6-89bc-a1ebc38bbdee",
                                                "text": "La confession des églises réformées. — La confession d’Augsbourg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "712170b2-0230-336e-8aab-48251fc6ced1",
                                        "entry_id": "eb8a3a3b-010d-3a6f-be0a-00d990ee2728",
                                        "glosses": [
                                            "Appartenance à une secte ou croyance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e74429c-2dd6-4390-a56c-463bcd32114b",
                                                "sense_id": "712170b2-0230-336e-8aab-48251fc6ced1",
                                                "text": "Voltaire avait raison : l’illusion religieuse est indéracinable, il est donc préférable qu’elle s’exprime par une multitude de confessions."
                                            },
                                            {
                                                "example_id": "bfe4aab0-e956-4d44-ac85-ab3734acda4d",
                                                "sense_id": "712170b2-0230-336e-8aab-48251fc6ced1",
                                                "text": "Raymond Kamil et Teguh Sugiharto, deux Indonésiens sans confession religieuse, avaient demandé à ne pas être affiliés à une quelconque religion sur leur carte d’identité. Mais la Cour constitutionnelle du pays a rejeté leur demande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a975596f-0b14-3a14-846c-66dda7281b1f",
                                        "entry_id": "eb8a3a3b-010d-3a6f-be0a-00d990ee2728",
                                        "glosses": [
                                            "Mémoires ; autobiographie."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c6bb0ef-a749-4dda-a377-e357b6d1c14e",
                                                "sense_id": "a975596f-0b14-3a14-846c-66dda7281b1f",
                                                "text": "Si je me laissais aller à une confession voilée, à une sorte de journal intime, je choirais dans un magma psychologique bien éloigné de mon propos."
                                            },
                                            {
                                                "example_id": "ff5de90f-52da-4434-bee6-8037972d9a4a",
                                                "sense_id": "a975596f-0b14-3a14-846c-66dda7281b1f",
                                                "text": "Les confessions de saint Augustin. — Les confessions de J.-J.Rousseau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9932412-f9bf-3cb0-844a-9a753e4baa33",
                                        "entry_id": "eb8a3a3b-010d-3a6f-be0a-00d990ee2728",
                                        "glosses": [
                                            "Action d’avouer ses péchés à un prêtre, dans l’église catholique, pour obtenir le pardon de Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc94c5b-ace5-40db-9a8e-66614b4f0a1e",
                                                "sense_id": "c9932412-f9bf-3cb0-844a-9a753e4baa33",
                                                "text": "Dans un moment comme celui-là, il ne s’amuse pas à cacher un seul de ses péchés, cela est évident. — Au surplus, cacherait-il la moindre peccadille, cela ne lui servirait qu’à transformer sa confession en sacrilège, et alors, patatras ! dans l’enfer! c’est-à-dire messes inutiles."
                                            },
                                            {
                                                "example_id": "1ded83dd-6492-4112-a135-cfa41a1d99a9",
                                                "sense_id": "c9932412-f9bf-3cb0-844a-9a753e4baa33",
                                                "text": "Henri Heine prétend que le catholicisme d’une épouse est chose très salutaire pour le mari parce que la femme ne reste pas sous le poids de ses fautes ; après la confession, elle se met « de nou­veau à gazouiller et à rire ». De plus, elle n’est pas exposée à raconter sa faute. (L’Allemagne, tome II. p. 322.)"
                                            },
                                            {
                                                "example_id": "c03e8141-62ef-4176-b647-149d03855c3f",
                                                "sense_id": "c9932412-f9bf-3cb0-844a-9a753e4baa33",
                                                "text": "Depuis longtemps déjà il soupçonnait la chose, car de l’apprendre en confession il n’y fallait guère compter ; à partir de quinze ou seize ans tous s’émancipaient et se dispensaient de cette corvée ennuyeuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a40859f-f344-39f6-9785-6b36c1e90979",
                                        "entry_id": "eb8a3a3b-010d-3a6f-be0a-00d990ee2728",
                                        "glosses": [
                                            "Dans certaines églises, petite crypte au dessus de laquelle se trouve l’autel, et renfermant les reliques d’un saint ou d’un martyr."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1642b3e0-b5b3-4e70-b768-821a2d047dbc",
                                                "sense_id": "4a40859f-f344-39f6-9785-6b36c1e90979",
                                                "text": "Elle se compose d’une confession ou martyrium , précédant la crypte proprement dite qui comprend trois nefs symboliquement de trois travées et une abside circulaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
