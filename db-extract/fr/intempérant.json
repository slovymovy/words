                    },
                    {
                        "translation_id": "4d9bcd4d-2eea-46f4-8d2a-cef2895c145c",
                        "source_entry_id": "c30104c3-2823-3023-819a-3bee6da27d17",
                        "target_lang_word": "buitensporig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buitensporig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "10c1fe61-4889-32eb-84dd-d5d9a2749a80",
                                        "entry_id": "6ddb0ca3-f126-38d0-a52a-973a2810eea3",
                                        "glosses": [
                                            "buiten alle maten, enorm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d94b0649-109c-4706-9aee-be9635561d29",
                                                "sense_id": "10c1fe61-4889-32eb-84dd-d5d9a2749a80",
                                                "text": "Die buitensporige reactie werd hem erg kwalijk genomen."
                                            },
                                            {
                                                "example_id": "73e7cf91-b800-4ecc-8ffd-425708f07a76",
                                                "sense_id": "10c1fe61-4889-32eb-84dd-d5d9a2749a80",
                                                "text": "Daarbij wordt er buitensporig geweld gebruikt en onnodig veel schade toegebracht. Kinderen zien hun ouders op brute wijze en zonder toelichting van bed worden gelicht. Acties die zelden leiden tot verder strafrechtelijk onderzoek op verdenking van terrorisme."
                                            },
                                            {
                                                "example_id": "dbabd6b5-10fe-45a2-a4aa-361776c093df",
                                                "sense_id": "10c1fe61-4889-32eb-84dd-d5d9a2749a80",
                                                "text": "Het was moeilijk om een beleefde manier te vinden om haar woordenvloed te stuiten, ze was buitensporig ambitieus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2391b3ad-de40-47a8-8cce-afaa65f796ff",
                        "source_entry_id": "c30104c3-2823-3023-819a-3bee6da27d17",
                        "target_lang_word": "overmatig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overmatig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3c8d619f-52ac-3d20-8c2a-31dff47df52c",
                                        "entry_id": "a99c8ab4-aab6-3d60-9d6d-58594016a733",
                                        "glosses": [
                                            "buitensporig, ongezond veel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a77452-b8b0-4a76-af71-bdf15233c764",
                                                "sense_id": "3c8d619f-52ac-3d20-8c2a-31dff47df52c",
                                                "text": "Overmatig gebruik van alcohol leidt tot gezondheidsproblemen."
                                            },
                                            {
                                                "example_id": "6b70eaca-7896-4ca4-895c-272cc9a87947",
                                                "sense_id": "3c8d619f-52ac-3d20-8c2a-31dff47df52c",
                                                "text": "Ik liep door een betoverende witte wereld, maar realiseerde me dat ik de grens twee weken later niet meer had kunnen halen vanwege de overmatige sneeuwval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb04454d-6d16-3e2e-bfd7-c98c9e7b887f",
                                        "entry_id": "a99c8ab4-aab6-3d60-9d6d-58594016a733",
                                        "glosses": [
                                            "een halve toon groter dan een rein of groot interval"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d6fb73e-4c4e-4ddb-a829-28c2b12ff238",
                                                "sense_id": "cb04454d-6d16-3e2e-bfd7-c98c9e7b887f",
                                                "text": "Is dit een verminderde kwint of een overmatige kwart?."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
