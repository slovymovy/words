                "senses": [
                    {
                        "sense_id": "49919130-3a57-326b-9b65-7b59759db1b4",
                        "entry_id": "1a0a1dea-314d-3061-8b55-401cf1fd1bce",
                        "glosses": [
                            "разг. уменьш.-ласк. к мать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4cc22ae-d07f-4395-971c-3db38aba817d",
                                "sense_id": "49919130-3a57-326b-9b65-7b59759db1b4",
                                "text": "Но сами вы знаете, маточка, подходит зима; вечера будут длинные; грустно будет, так вот бы и почитать."
                            }
                        ]
                    },
                    {
