                "senses": [
                    {
                        "sense_id": "7ba95ec5-6cb7-3464-bb4e-ceb4b280164a",
                        "entry_id": "73c90002-fefa-3c76-ae8e-185e1a45076a",
                        "glosses": [
                            "Faire ressembler à un patchwork."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15ff0e48-0156-47dd-8a28-a65bd62eaf77",
                                "sense_id": "7ba95ec5-6cb7-3464-bb4e-ceb4b280164a",
                                "text": "Pour soutenir l'émancipation de toutes, le mouvement des femmes doit se démocratiser, se « patchworkiser »."
                            },
                            {
                                "example_id": "9a033bb6-d5d1-4590-8527-c1fdaeaf5480",
                                "sense_id": "7ba95ec5-6cb7-3464-bb4e-ceb4b280164a",
                                "text": "Maroc monarchisé, Algérie « bouteflikée », Libye tribalisée, Tunisie démocratisée, Égypte militarisée, Syrie éclatée et djihadisée, Irak patchworkisé et « califatisé », Golfe tétanisé face à un Iran prénucléarisé…"
                            }
                        ]
                    },
                    {
                        "sense_id": "02937379-07aa-319d-ae56-a28101ed1c37",
                        "entry_id": "73c90002-fefa-3c76-ae8e-185e1a45076a",
                        "glosses": [
                            "Utiliser comme dans un patchwork."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5aad94a-7c6f-40f0-821f-68d6632afb15",
                                "sense_id": "02937379-07aa-319d-ae56-a28101ed1c37",
                                "text": "Leurs mots ont inspiré une musique et ensuite j'ai pu patchworkiser leur apport et finalement construire une chanson qui me ressemblait."
                            }
                        ]
                    }
                ],
