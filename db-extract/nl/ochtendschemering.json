                            {
                                "example_id": "86b304f8-24d3-4702-9a4d-c476e5c821ec",
                                "sense_id": "a498b5bf-d5ca-3aa0-a242-98be8892f7c5",
                                "text": "Tijdens de ochtendschemering heb je de beste kans reeën te zien."
                            },
                            {
                                "example_id": "2efeec0b-a123-4505-b495-202a704879c1",
                                "sense_id": "a498b5bf-d5ca-3aa0-a242-98be8892f7c5",
                                "text": "Ochtendschemering boven Minneapolis/St. Paul. Het zou weleens een mooie dag kunnen worden, zo te zien, nog geen wolkje aan de lucht."
                            },
                            {
                                "example_id": "8983f6fa-d2a4-42b1-b403-cfce3c69035a",
                                "sense_id": "a498b5bf-d5ca-3aa0-a242-98be8892f7c5",
                                "text": "Ze losten op in de mistige ochtendschemering toen ze wegliepen om de ossen in te spannen."
                            }
                        ]
                    }
