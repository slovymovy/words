                                        ]
                                    },
                                    {
                                        "sense_id": "adffd010-9524-3f0f-9622-e390e8e586bc",
                                        "entry_id": "3cd4a9fb-9659-3815-8a93-a27eed2b1527",
                                        "glosses": [
                                            "A short time for relaxing and doing something else."
