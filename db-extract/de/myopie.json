                        "source_sense_id": "b38d3973-b272-37d9-bb46-7cf4ae62790e",
                        "source_sense_description": "Medizin: Kurzsichtigkeit; Verschiebung des Brennpunkts der Linse vor die Netzhaut",
                        "target_lang_word": "myopia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myopia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcc0803d-bc94-31fa-aaa4-8f847b25e107",
                                        "entry_id": "708a1db5-51b9-388d-b9ce-e3ed94c10a01",
                                        "glosses": [
                                            "A disorder of the vision where distant objects appear blurred because the eye focuses their images in front of the retina instead of on it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "691d5e84-a8b4-469a-b71e-b01f587d1266",
                                                "sense_id": "fcc0803d-bc94-31fa-aaa4-8f847b25e107",
                                                "text": "The modern rise in myopia mirrored a trend for children in many countries to spend more time engaged in reading, studying or — more recently — glued to computer and smartphone screens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c49264d8-22c2-320f-bd7b-a796f7570bef",
                                        "entry_id": "708a1db5-51b9-388d-b9ce-e3ed94c10a01",
                                        "glosses": [
                                            "A lack of imagination, discernment or long-range perspective in thinking or planning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c27290c-7fd0-4657-bc85-3fda90bae537",
                        "source_entry_id": "f2c22786-c751-38c4-a731-3c1002bb5323",
                        "source_sense_id": "b38d3973-b272-37d9-bb46-7cf4ae62790e",
                        "source_sense_description": "Medizin: Kurzsichtigkeit; Verschiebung des Brennpunkts der Linse vor die Netzhaut",
                        "target_lang_word": "myopie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myopie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e9a0d57-7d6e-32cf-8470-42586cccde21",
                                        "entry_id": "cbc1c287-2979-3fc9-8a71-7f9913fd8f3d",
                                        "glosses": [
                                            "État de ceux qui sont myopes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc857db6-f874-410a-afcd-a6f8e61f0711",
                                                "sense_id": "5e9a0d57-7d6e-32cf-8470-42586cccde21",
                                                "text": "La connexion qui existe entre la myopie binoculaire et le strabisme divergent n'a pas non plus passé inaperçue autrefois."
                                            },
                                            {
                                                "example_id": "120b33a1-d559-4e68-bfb9-1096a38dc065",
                                                "sense_id": "5e9a0d57-7d6e-32cf-8470-42586cccde21",
                                                "text": "Ferdinand trottait derrière nous, avec cet air un peu égaré que lui donnait, que lui donne toujours sa myopie."
                                            },
                                            {
                                                "example_id": "8b71fa79-0931-4560-bd9a-2e05436f3220",
                                                "sense_id": "5e9a0d57-7d6e-32cf-8470-42586cccde21",
                                                "text": "Ma myopie renforçait encore l’impression d’irréel, de cauchemar que je ressentais et contre laquelle je m’efforçais de lutter, dans la crainte de voir se briser ma volonté."
                                            },
                                            {
                                                "example_id": "defb0e4c-9665-4f9c-b191-969a65da09fc",
                                                "sense_id": "5e9a0d57-7d6e-32cf-8470-42586cccde21",
                                                "text": "En fait il conduisait sa voiture avec beaucoup de prudence, à cause d’une légère myopie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9ed64c2-b379-39b6-8496-0cd479197de9",
                                        "entry_id": "cbc1c287-2979-3fc9-8a71-7f9913fd8f3d",
                                        "glosses": [
                                            "Incapacité de bien distinguer une situation, un problème, une perspective."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30c941e8-daaa-42b1-ac64-02952e9aa2ec",
                                                "sense_id": "e9ed64c2-b379-39b6-8496-0cd479197de9",
                                                "text": "Une voix implacable et sérieuse penche à votre oreille pour vous dire que nos passions sont des menteuses, que c’est notre myopie qui fait les beaux visages et notre ignorance les belles âmes, et qu’il vient nécessairement un jour où l’idole, pour le regard plus clairvoyant, n’est plus qu’un objet, non pas de haine, mais de mépris et d’étonnement !"
                                            },
                                            {
                                                "example_id": "0bbcce67-3aef-4c00-8b41-73823c2b79c3",
                                                "sense_id": "e9ed64c2-b379-39b6-8496-0cd479197de9",
                                                "text": "Pourquoi cette myopie sur soi au nom de la lucidité sur l’autre que soi ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75582823-5330-3820-adfe-91e3908dc3ec",
                                        "entry_id": "cbc1c287-2979-3fc9-8a71-7f9913fd8f3d",
                                        "glosses": [
                                            "Incapacité de voir à long terme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa9dc0ab-661a-4a84-93d7-73028a6fffb2",
                                                "sense_id": "75582823-5330-3820-adfe-91e3908dc3ec",
                                                "text": "Dans l’imaginaire collectif américain, l’idée de séparation, de sécession, est associée à celles de régression, de tragédie, de myopie politique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
