                "senses": [
                    {
                        "sense_id": "cd1fe719-31a7-3013-9f66-670d6f3a3597",
                        "entry_id": "b7096a98-abec-3a2e-9d7f-f98b34e09f59",
                        "glosses": [
                            "die chemische Verbindung Cadmiumsulfit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c22e826-7316-4bfb-9552-dc01c56c8f78",
                                "sense_id": "cd1fe719-31a7-3013-9f66-670d6f3a3597",
                                "text": "„Da Kadmiumkarbonat, wie auf Zusatz, von Alkalikarbonaten zu Kadmiumsalzlösungen gefällt wird, normal¹ oder doch nahezu normal² ist, so war anzunehmen, daß bei der analogen Reaktion CdSO₄ + Na₂SO₃ = CdSO₃ + Na₂SO₄ das normale Kadmiumsulfit gebildet wird.“"
                            },
                            {
                                "example_id": "3c4e09a7-15ed-4e55-9e5a-cc30eaa65bad",
                                "sense_id": "cd1fe719-31a7-3013-9f66-670d6f3a3597",
                                "text": "„Kadmiumsulfit, CdSO₃ + 3 H₂O, wird aus dem Kadmiumnitrat wie das Mangansulfit erhalten, bei Kochhitze dagegen ein wasserfreies Salz.“"
                            },
                            {
                                "example_id": "dbba5e9a-e8b5-4802-b25e-344a8c7f3b99",
                                "sense_id": "cd1fe719-31a7-3013-9f66-670d6f3a3597",
                                "text": "„Das gebildete Kadmiumsulfit wurde bei saurer Reaktion mit Kaliumjodat-Kaliumjodid titriert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
