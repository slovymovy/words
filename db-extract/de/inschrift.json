                        "form": "die Inschrift"
                    },
                    {
                        "form_id": "6aa10410-fa80-40c2-a48e-f45473ff7bcb",
                        "entry_id": "7d956809-c07d-304a-b557-811f34a70b86",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Inschriften"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a741a394-9e49-3cad-aab5-741d17ec066e",
                        "entry_id": "7d956809-c07d-304a-b557-811f34a70b86",
                        "glosses": [
                            "(oft relativ kurzer) Text, exponiert angebracht auf einer Unterlage wie etwa einem Gedenkstein oder einer Hauswand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1489dc0-41ac-40ef-9d14-20e1b24ca706",
                                "sense_id": "a741a394-9e49-3cad-aab5-741d17ec066e",
                                "text": "„In den Ruinen der kretischen Stadt Knossos entdeckt man seit der Mitte des 19. Jahrhunderts immer mehr Fragmente mit Inschriften.“"
                            },
                            {
                                "example_id": "7bb5a61a-88dc-4ef4-af83-750139e1e113",
                                "sense_id": "a741a394-9e49-3cad-aab5-741d17ec066e",
                                "text": "„Pierius also kannte die Übersetzung der Inschrift von Plutarch nicht und mußte sie allein mit Hilfe der allgemeinen Symbolerläuterungen Plutarchs übertragen, die im erhaltenen Text stehen.“"
                            },
                            {
                                "example_id": "cd0d51b8-4a2e-4c8f-92e7-23b0fcd49aad",
                                "sense_id": "a741a394-9e49-3cad-aab5-741d17ec066e",
                                "text": "„Wohl fielen die Inschriften auf den Denkmälern den Arabern auf; allein deren Deutungsversuche kamen über sinnlose Phantastereien nicht hinaus.“"
                            },
                            {
                                "example_id": "38f78d7a-d63a-42b2-9d5e-92bbd40834ba",
                                "sense_id": "a741a394-9e49-3cad-aab5-741d17ec066e",
                                "text": "„Das etruskische Alphabet wurde alsbald auch von den Venetern übernommen und an die Bedürfnisse der eigenen Sprache angepasst, wie die zahlreichen venetischen Inschriften zeigen.“"
                            },
                            {
                                "example_id": "15237b3e-6a0f-49ee-9a32-864f8b0bcfa6",
                                "sense_id": "a741a394-9e49-3cad-aab5-741d17ec066e",
                                "text": "„Ich spazierte zum Friedhof und verbrachte die Zeit damit, die Inschriften auf den Grabsteinen zu lesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a97cbfee-1f65-4a57-93fe-5fa93f9f633d",
                        "source_entry_id": "7d956809-c07d-304a-b557-811f34a70b86",
                        "source_sense_id": "a741a394-9e49-3cad-aab5-741d17ec066e",
                        "target_lang_word": "inscription",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inscription",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b651d83-bc71-331c-b733-8dcf754c9442",
                                        "entry_id": "e375a549-0d8c-3114-8009-152b61a9a918",
                                        "glosses": [
                                            "The act of inscribing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f924826-0edd-4e2b-aa4a-2e6692b9fa39",
                                                "sense_id": "9b651d83-bc71-331c-b733-8dcf754c9442",
                                                "text": "The inscription of the Temple of Preah Vihear on the World Heritage list shall be without prejudice to the rights of the Kingdom of Cambodia and the Kingdom of Thailand on the demarcation works of the Joint Commission for Land Boundary (JBC) of the two countries;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccd01673-b60c-3212-8f10-3d472b37d30f",
                                        "entry_id": "e375a549-0d8c-3114-8009-152b61a9a918",
                                        "glosses": [
                                            "Text carved on a wall or plaque, such as a memorial or gravestone, or on some other item."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eeee4ed-65cb-4539-a1e9-c3043df0fac5",
                                                "sense_id": "ccd01673-b60c-3212-8f10-3d472b37d30f",
                                                "text": "He had battled like a man, and gotten a man's reward — no silver tea-pots or salvers, with flowery inscriptions setting forth his virtues and the appreciation of a genteel parish; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e2dea9-9e03-3935-b69e-d77550b0875f",
                                        "entry_id": "e375a549-0d8c-3114-8009-152b61a9a918",
                                        "glosses": [
                                            "The text on a coin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f39c7ec-2a16-43d4-8543-0bd93214059f",
                                                "sense_id": "10e2dea9-9e03-3935-b69e-d77550b0875f",
                                                "text": "The coin bears an inscription in Latin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3af850de-b9f2-3836-a1be-c5164d513486",
                                        "entry_id": "e375a549-0d8c-3114-8009-152b61a9a918",
                                        "glosses": [
                                            "Words written in the front of a book as a dedication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "113a5896-bbec-463e-bb99-e455f00ba469",
                        "source_entry_id": "7d956809-c07d-304a-b557-811f34a70b86",
                        "source_sense_id": "a741a394-9e49-3cad-aab5-741d17ec066e",
