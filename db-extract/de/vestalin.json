                "senses": [
                    {
                        "sense_id": "a31ed0a1-b213-3283-b685-8d5b5ab504df",
                        "entry_id": "cff29e5c-127e-3a7a-aab7-8dd70303b1f5",
                        "glosses": [
                            "jungfräuliche römische Priesterin der Göttin Vesta"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "712b614a-ad68-42b3-a83a-7d9a1729b770",
                                "sense_id": "a31ed0a1-b213-3283-b685-8d5b5ab504df",
                                "text": "„Anders als fast alle männlichen Priester befanden sich die Vestalinnen ununterbrochen im Gottesdienst.“"
                            },
                            {
                                "example_id": "dc298c83-08e3-4d07-917d-2ca31ec4fb2c",
                                "sense_id": "a31ed0a1-b213-3283-b685-8d5b5ab504df",
                                "text": "„Meine neue Eroberung war von vornehmer Herkunft, war schön und geistvoll; aber zu diesen tatsächlichen Vorzügen kam noch ein eingebildeter hinzu, der nur mein Glück beinahe unfaßbar machte: ich hatte mit einer Vestalin zu tun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13528b1c-48ef-49d9-a494-8ceda8be1d6f",
                        "source_entry_id": "cff29e5c-127e-3a7a-aab7-8dd70303b1f5",
                        "source_sense_id": "a31ed0a1-b213-3283-b685-8d5b5ab504df",
                        "source_sense_description": "historisch: jungfräuliche römische Priesterin der Göttin Vesta",
                        "target_lang_word": "vestal virgin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
