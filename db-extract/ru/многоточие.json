                                        "glosses": [
                                            "drei aufeinanderfolgende Punkte in einem Text, womit die Auslassung eines Teils der ursprünglichen Aussage angezeigt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
