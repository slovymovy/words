                                        "glosses": [
                                            "The action of the verb to wash"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f10e13c-6fa3-49be-805a-343ce618cc3d",
                                                "sense_id": "f0b14f01-eea1-3d96-be05-fe6d538e7e7d",
                                                "text": "I then took a piece of dry stone, ground it fine in a mortar, and placed the powder in water, the sand particles sunk rapidly to the bottom, while the clay remained suspended, and by several washings and decantings the sand and clay could be approximately separated […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaf12156-4612-39b7-8796-ba7a04dec956",
                                        "entry_id": "483485d4-6a1f-3ced-be00-7ae35036631c",
                                        "glosses": [
                                            "Clothing, bedlinen or soft furnishings that have been, are currently being, or are to be washed; laundry."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "New-Zealand",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db290826-1a74-4c42-8676-19e9396e7df2",
                                                "sense_id": "eaf12156-4612-39b7-8796-ba7a04dec956",
                                                "text": "My mother used to do the washing on a Monday"
                                            },
                                            {
                                                "example_id": "7a63e7e3-246b-48c3-91de-61dc01f00489",
                                                "sense_id": "eaf12156-4612-39b7-8796-ba7a04dec956",
                                                "text": "[…] Hazel telling about how she liked a good woodpile, especially when she used to take in washing to earn a little extra. She needed a goodly pile to fuel her washtubs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c13260dd-b583-3611-8ec4-848e7e0c81ce",
                                        "entry_id": "483485d4-6a1f-3ced-be00-7ae35036631c",
                                        "glosses": [
                                            "The residue after an ore, etc, has been washed"
                                        ],
                                        "tags": [
                                            "countable",
