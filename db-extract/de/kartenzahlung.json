                "senses": [
                    {
                        "sense_id": "f2557566-b39b-3e08-8ead-5eec33765eb2",
                        "entry_id": "e18895b5-a03e-32c3-b473-d1a4422a3a6c",
                        "glosses": [
                            "die Bezahlung einer Ware oder einer Dienstleistung mit einer Geld- oder Kreditkarte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f244bf78-19ba-4173-bbdb-dfd3f34d5d10",
                                "sense_id": "f2557566-b39b-3e08-8ead-5eec33765eb2",
                                "text": "Die Kartenzahlung ist sehr bequem."
                            },
                            {
                                "example_id": "988190c3-3fae-42c1-95d0-579f21675fec",
                                "sense_id": "f2557566-b39b-3e08-8ead-5eec33765eb2",
                                "text": "„Eine Bargeldzahlung kostet pro Euro Umsatz im Schnitt 2,6 Cent, eine Kartenzahlung hingegen 0,8 Cent.“"
                            },
                            {
                                "example_id": "f5c9ce97-fb07-437d-8845-f8f3b71aac5d",
                                "sense_id": "f2557566-b39b-3e08-8ead-5eec33765eb2",
                                "text": "„Bereits in den vergangenen zehn Jahren hat laut Tojner ein Transformationsprozess beim Payment eingesetzt. Von der reinen Kartenzahlung über kontaktloses und mobiles Bezahlen bis zu Wearables (etwa Ringe oder Armbänder mit eingebauten Chips), die bei den Konsumenten mittlerweile angekommen seien – aber was kommt danach?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
