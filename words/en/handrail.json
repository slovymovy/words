{
    "word_family": [
        "rail",
        "railing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93d42ad6-cfb3-3037-be8c-09733ac07969",
                    "sense_definition": "A rail designed to be grasped by the hand for support or safety, such as along a staircase or walkway.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "support_rail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please hold the <w>handrail</w> as you walk down the steep stairs.",
                            "target_lang_translations": {
                                "zh": "走下陡峭的楼梯时，请抓好<w>扶手</w>。"
                            }
                        },
                        {
                            "text": "The workers installed a wooden <w>handrail</w> along the hallway to help elderly residents.",
                            "target_lang_translations": {
                                "zh": "工人们沿着走廊安装了木质<w>扶手</w>，以方便老年居民。"
                            }
                        }
                    ],
                    "synonyms": [
                        "banister",
                        "railing"
                    ],
                    "common_phrases": [
                        "hold the handrail",
                        "staircase handrail"
                    ],
                    "target_lang_definitions": {
                        "zh": "（楼梯、走廊等处的）扶手，栏杆，供人抓握以获得支撑或确保安全。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扶手",
                                "target_lang_sense_clarification": "楼梯或走道边供手扶的横木或栏杆"
                            },
                            {
                                "target_lang_word": "栏杆扶手",
                                "target_lang_sense_clarification": "栏杆上方的抓握部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b6ac639-a6e8-3b17-8dac-fa207b19e4fb",
                    "sense_definition": "A moving continuous belt on either side of an escalator or moving walkway that passengers can hold onto.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "support_rail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Signs near the escalator reminded shoppers to hold onto the moving <w>handrail</w>.",
                            "target_lang_translations": {
                                "zh": "自动扶梯旁的指示牌提醒顾客握紧移动的<w>扶手带</w>。"
                            }
                        },
                        {
                            "text": "The station cleaners regularly disinfect the escalator <w>handrail</w> to keep passengers safe.",
                            "target_lang_translations": {
                                "zh": "车站保洁人员定期对自动扶梯的<w>扶手</w>进行消毒，以保障乘客的安全。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "escalator handrail",
                        "moving handrail"
                    ],
                    "target_lang_definitions": {
                        "zh": "（自动扶梯或自动人行道两侧的）移动扶手带。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扶手带",
                                "target_lang_sense_clarification": "自动扶梯等两侧随之同步移动的循环胶带"
                            },
                            {
                                "target_lang_word": "扶手",
                                "target_lang_sense_clarification": "自动扶梯两侧供乘客抓握的装置"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}