                                    {
                                        "sense_id": "6946a376-e358-3937-878a-d933dce48621",
                                        "entry_id": "b67edc2f-148b-3557-9238-20c7871f36d7",
                                        "glosses": [
                                            "Having a cross placed on it, or (with respect to the arms of a cross) having a bar placed crosswise over (an existing bar) so as to form a cross."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd358b96-b019-4a70-aef5-29e77b2875d3",
                                                "sense_id": "6946a376-e358-3937-878a-d933dce48621",
                                                "text": "In certain popular heraldic works the crest assigned to the surname \"Archer,\" in Ireland, is \"a mound azure banded and crossed or,\" whereas there is no instance of the Archers of Kilkenny - probably the earliest of the name […]"
                                            },
                                            {
                                                "example_id": "b718af0c-3e0d-4c76-9a34-e6893c05b4f4",
                                                "sense_id": "6946a376-e358-3937-878a-d933dce48621",
                                                "text": "Quarterly gu. and az. a royal orb arg. banded and crossed or. Sweden; granted 1751. Gilbert UNIVERSAL, Bishop of London 1128-34."
                                            },
                                            {
                                                "example_id": "31254e0b-83b5-4b24-8bba-7aac077d071c",
                                                "sense_id": "6946a376-e358-3937-878a-d933dce48621",
                                                "text": "Gules, a cross potent crossed or. CHADERTON, Chester 1579; Lincoln 1595."
                                            }
