                "senses": [
                    {
                        "sense_id": "c39f3295-aa6f-3eb1-b0cf-9fe59a7c6f50",
                        "entry_id": "628d0025-5cfd-3dc3-820d-022b1b32feb6",
                        "glosses": [
                            "Faculté de prévoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3eeded5-e372-48f4-bbca-624a773e153e",
                                "sense_id": "c39f3295-aa6f-3eb1-b0cf-9fe59a7c6f50",
                                "text": "L'expédition du Mexique détruit notre effectif, anéantit le matériel de notre marine, dilapide nos finances, […]. Cette expédition, qui nous coûte tant, ne nous apprend rien, pas même la prudence et la prévoyance."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e1586b2-d789-3485-bc2a-672ab29c6fe3",
                        "entry_id": "628d0025-5cfd-3dc3-820d-022b1b32feb6",
                        "glosses": [
                            "Action de prévoir et de prendre des précautions pour l’avenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fe4d3ac-948f-4714-a612-d828cc17c3dd",
                                "sense_id": "1e1586b2-d789-3485-bc2a-672ab29c6fe3",
                                "text": "La patience est la principale vertu réclamée à l'explorateur polaire, dit Nansen, mais la prévoyance est la seconde."
                            },
                            {
                                "example_id": "ea205550-13f3-40d6-8132-ae06d75557e9",
                                "sense_id": "1e1586b2-d789-3485-bc2a-672ab29c6fe3",
                                "text": "La réputation de ce grand homme reposait principalement sur l’autorité avec laquelle il démontrait que l’éternument était une prévoyance de la nature, au moyen de laquelle les penseurs trop profonds pouvaient chasser par le nez le superflu de leurs idées ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da4ef50d-f353-4cb7-8607-8713fa7865a8",
                        "source_entry_id": "628d0025-5cfd-3dc3-820d-022b1b32feb6",
                        "target_lang_word": "Weitsicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weitsicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3fd7bcfc-24a1-3360-a0ec-37759fc7621e",
                                        "entry_id": "15ceff5c-3bb6-3f5a-965e-d3d92167dfd3",
                                        "glosses": [
                                            "freier Blick auf große Entfernung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae4fc89-3fe2-46a0-b6f1-0800e5ab5ae7",
                                                "sense_id": "3fd7bcfc-24a1-3360-a0ec-37759fc7621e",
                                                "text": "Von diesem Standort aus hat man eine hervorragende Weitsicht in die Landschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ad2e49d-3969-3981-8ef6-1b4fa9140cc3",
                                        "entry_id": "15ceff5c-3bb6-3f5a-965e-d3d92167dfd3",
                                        "glosses": [
                                            "Vorausschau, vorausschauende Wahrnehmung oder Planung über längere Zeiträume"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
