                ],
                "senses": [
                    {
                        "sense_id": "cecb1cf1-fdab-3486-8065-67c84a789a75",
                        "entry_id": "e0ede190-7e47-3a8e-9432-6f0da21a19ac",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a725bb14-2d80-4bcb-8349-4b495b9f08c0",
                                "sense_id": "cecb1cf1-fdab-3486-8065-67c84a789a75",
                                "text": "Frau Wager ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8b9bb984-9b6a-446d-88a7-b75205b4cde1",
                                "sense_id": "cecb1cf1-fdab-3486-8065-67c84a789a75",
                                "text": "Herr Wager wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "83634328-e88c-4733-9d10-0d5eef76dc21",
                                "sense_id": "cecb1cf1-fdab-3486-8065-67c84a789a75",
                                "text": "Die Wagers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "60633004-427f-43f2-9a45-98b77aeb4bfa",
                                "sense_id": "cecb1cf1-fdab-3486-8065-67c84a789a75",
                                "text": "Der Wager trägt nie die Schals, die die Wager ihm strickt."
                            },
                            {
                                "example_id": "15c2fb67-390c-45cc-9df5-ab5c55027cd5",
                                "sense_id": "cecb1cf1-fdab-3486-8065-67c84a789a75",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wager kommt, geht der Herr Wager.“"
                            },
                            {
                                "example_id": "2472139f-07c3-4d08-b17d-1e352eed1f87",
                                "sense_id": "cecb1cf1-fdab-3486-8065-67c84a789a75",
                                "text": "Wager kommt und geht."
                            },
                            {
                                "example_id": "cc5d6b35-9c9a-423b-8f88-7e8262872ee2",
                                "sense_id": "cecb1cf1-fdab-3486-8065-67c84a789a75",
                                "text": "Wagers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
