                        "cross_references": [
                            {
                                "target_word": "Schlangenbeschwörer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e74b527-e496-3ddf-b827-e3a590ecc464",
                                        "entry_id": "83a8ca2d-0c1f-3fdb-8893-400fd675d03f",
                                        "glosses": [
                                            "Person, die mittels Musik und Bewegungen Schlangen zum Tanzen bringt und dieses bei öffentlichen Auftritten vorführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d63f7055-a0d9-4a37-98b8-86e947c2e5f8",
                                                "sense_id": "7e74b527-e496-3ddf-b827-e3a590ecc464",
                                                "text": "„Sie sind aus dem wahren Amerika geflohen, dem Amerika von Atombomben, Skalpieren, Hip-Hop, Chaostheorie, Überschuhen aus Beton, Schlangenbeschwörern, Massenmördern, Weltraumspaziergängen, Autoschaltern, Cruise Missiles, Sherman’s March, Motorradbanden und Bungeejumping.“"
                                            },
                                            {
                                                "example_id": "5ccbce0b-6dfd-4159-a224-2463d6567a70",
                                                "sense_id": "7e74b527-e496-3ddf-b827-e3a590ecc464",
                                                "text": "„In seiner Brieftasche steckte eine Karte, auf die er den Ratschlag hatte drucken lassen, den ihm sein erster Station Chief in Damaskus mit auf den Weg gegeben hatte: ‹Vergessen Sie nie, dass Sie ein Schlangenbändiger sind, kein Schlangenbeschwörer.›“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
