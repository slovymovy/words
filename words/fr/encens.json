    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04cbd970-db3e-3780-bd1c-aa3533404652",
                    "sense_definition": "Résine aromatique qui dégage une odeur pénétrante lorsqu'on la fait brûler, traditionnellement employée dans les cérémonies religieuses.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "parfum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une odeur d'<w>encens</w> flottait dans la cathédrale pendant la cérémonie du matin."
                        },
                        {
                            "text": "Le prêtre a déposé de l'<w>encens</w> sur les braises afin de purifier le lieu sacré."
                        }
                    ],
                    "common_phrases": [
                        "brûler de l'encens",
                        "odeur d'encens",
                        "fumée d'encens"
                    ]
                },
                {
                    "sense_id": "43b07e21-a2f2-3abb-b284-0a6f4c6f3ddb",
                    "sense_definition": "Bâtonnet ou cône constitué de substances parfumées que l'on allume pour purifier ou parfumer une pièce.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "parfum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle allume souvent un bâtonnet d'<w>encens</w> dans sa chambre pour créer une atmosphère apaisante."
                        },
                        {
                            "text": "Nous avons acheté plusieurs boîtes d'<w>encens</w> au bois de santal au marché artisanal."
                        }
                    ],
                    "common_phrases": [
                        "bâtonnet d'encens",
                        "cône d'encens"
                    ]
                },
                {
                    "sense_id": "e03beccf-0de3-36eb-aab9-9cfc6e200d27",
                    "sense_definition": "Hommage flatteur, louange excessive accordée à une personne en signe d'admiration ou de déférence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Habitué aux louanges permanentes, ce dirigeant ne supporte plus rien d'autre que l'<w>encens</w> de ses partisans."
                        },
                        {
                            "text": "Les poètes de la cour rivalisaient d'imagination pour offrir leur <w>encens</w> au souverain."
                        }
                    ],
                    "synonyms": [
                        "louange",
                        "flatterie",
                        "adulation"
                    ],
                    "common_phrases": [
                        "brûler son encens",
                        "offrir de l'encens"
                    ]
                }
            ]
        }
    ]
