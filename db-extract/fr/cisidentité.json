                        "form": "cis-identité"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d9d51ea-6d35-3690-a6d2-72a1547a89cc",
                        "entry_id": "6c7f3411-4f62-33a3-8d79-b4d3e679bf4c",
                        "glosses": [
                            "État d’une personne qui s’identifie du même genre que celui déterminé à la naissance."
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "d9c9cef9-5f83-4454-a0bb-8bed14b8b034",
                                "sense_id": "0d9d51ea-6d35-3690-a6d2-72a1547a89cc",
                                "text": "La cisidentité est un néologisme désignant un type d’identité de genre où le genre ressenti d’une personne correspond au genre assigné à sa naissance, la personne est alors cisgenre (abrégé en cis). Le mot est construit par opposition à celui de transgenre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5aa151f3-485a-4e47-bbc2-c02b3a7b3cb9",
                        "source_entry_id": "6c7f3411-4f62-33a3-8d79-b4d3e679bf4c",
                        "source_sense_id": "0d9d51ea-6d35-3690-a6d2-72a1547a89cc",
