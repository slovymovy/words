                "senses": [
                    {
                        "sense_id": "85b44b02-42d9-3fae-8985-0a5119bbbf48",
                        "entry_id": "6b6c35c0-ce4e-3310-aaee-42cb1cda5449",
                        "glosses": [
                            "Zusatzplural von Nebenmann (Personen, die sich seitlich von jemandem befinden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4be7d652-c6f2-4bab-b0b2-4a3d148c6817",
                                "sense_id": "85b44b02-42d9-3fae-8985-0a5119bbbf48",
                                "text": "„Die Individuen verhalten sich zwar wie Vögel in einem Schwarm oder die Verkehrsteilnehmer einer Ameisenstraße: Es reicht, wenn jeder auf seine ein, zwei Nebenleute achtet, dann organisiert sich das Radl-Gewimmel.“"
                            },
                            {
                                "example_id": "86fdeaf7-4538-45c7-8c61-1a8cb5be99e1",
                                "sense_id": "85b44b02-42d9-3fae-8985-0a5119bbbf48",
                                "text": "„Wann war es zuletzt am Ende des Abspanns so still im Kinosaal? Nur die Atemgeräusche der Nebenleute sind zu hören, dann bricht von irgendwo ein leises ‘Wow‘ den Bann.“"
                            },
                            {
                                "example_id": "fe2ed442-4861-4013-84fb-88b15cb1bf38",
                                "sense_id": "85b44b02-42d9-3fae-8985-0a5119bbbf48",
                                "text": "„Van der Vaart tauchte auf dem Rasen ab, spielte ebenso leidenschafts- und glücklos wie seine Nebenleute.“"
                            },
                            {
                                "example_id": "2e3eb198-7260-437a-ac3f-9a5a172b9c7a",
                                "sense_id": "85b44b02-42d9-3fae-8985-0a5119bbbf48",
                                "text": "„Die Mitspieler stellen sich auf eine Kreislinie, merken sich ihre Nebenleute und bewegen sich dann frei durch den Raum.“"
                            },
                            {
                                "example_id": "5b0e7b01-5707-4164-990e-5b2d727375db",
                                "sense_id": "85b44b02-42d9-3fae-8985-0a5119bbbf48",
                                "text": "„Wir müssen unseren Betrieb sehen, müssen uns mit den Problemen in diesem Betrieb befassen, wir müssen uns um die Umwelt und ihre Bedingungen kümmern und uns nach Möglichkeiten umsehen, wie wir mit unseren Mitmenschen und Nebenleuten besser und gerechter auskommen …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
