                        "cross_references": [
                            {
                                "target_word": "Misogynie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "015ccfe2-7af9-3efa-b5f7-1c7cf2ba613f",
                                        "entry_id": "ac0c9c2a-7b3c-30dd-b1b7-53493770c846",
                                        "glosses": [
                                            "Frauenhass, „krankhafte“ Scheu vor Frauen, oft gleichgesetzt mit Frauenfeindlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0ab5c9-e5a6-45d2-8db2-8ec8e7603487",
                                                "sense_id": "015ccfe2-7af9-3efa-b5f7-1c7cf2ba613f",
                                                "text": "Sie tat ihr Bestes, um ihn von seiner Misogynie zu kurieren."
                                            },
                                            {
                                                "example_id": "d170faaf-0c1f-49be-97f2-b96f0836ca36",
                                                "sense_id": "015ccfe2-7af9-3efa-b5f7-1c7cf2ba613f",
                                                "text": "„Ich bin im vulgären Unterbau der Sprachen und fand da, nicht im Deutschen, aber in den anderen Sprachen, eine sexualisierte Männerwelt und in dieser kaum verkappte oder offene Frauenfeindschaft, Misogynie.“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
