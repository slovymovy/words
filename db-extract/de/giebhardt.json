                ],
                "senses": [
                    {
                        "sense_id": "0cac6c34-dfa2-3c4c-ba38-455d7b8f5773",
                        "entry_id": "5f7cd7f9-19be-3fe3-ba85-0d3394ff370b",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635f31c4-dde0-4e7f-8c06-dd5052f1d688",
                                "sense_id": "0cac6c34-dfa2-3c4c-ba38-455d7b8f5773",
                                "text": "Frau Giebhardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6468ce57-18a8-473d-9936-620de9ee058d",
                                "sense_id": "0cac6c34-dfa2-3c4c-ba38-455d7b8f5773",
                                "text": "Herr Giebhardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8c995cf8-8f20-4b1d-8444-607144e76e82",
                                "sense_id": "0cac6c34-dfa2-3c4c-ba38-455d7b8f5773",
                                "text": "Die Giebhardts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1deb3f75-179d-4320-9338-31b651f76085",
                                "sense_id": "0cac6c34-dfa2-3c4c-ba38-455d7b8f5773",
                                "text": "Der Giebhardt trägt nie die Schals, die die Giebhardt ihm strickt."
                            },
                            {
                                "example_id": "1ccfd4e0-7e48-4b74-80e9-b96acb187128",
                                "sense_id": "0cac6c34-dfa2-3c4c-ba38-455d7b8f5773",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Giebhardt kommt, geht der Herr Giebhardt.“"
                            },
                            {
                                "example_id": "4a5607ca-a8d3-47b2-8e0b-adef07ee51d3",
                                "sense_id": "0cac6c34-dfa2-3c4c-ba38-455d7b8f5773",
                                "text": "Giebhardt kommt und geht."
                            },
                            {
                                "example_id": "7d2dc305-5fa1-4b30-a9fe-4a2e72f57c50",
                                "sense_id": "0cac6c34-dfa2-3c4c-ba38-455d7b8f5773",
                                "text": "Giebhardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
