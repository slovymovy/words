                "senses": [
                    {
                        "sense_id": "014aa17c-d850-31d4-8376-7e0f7ce921a0",
                        "entry_id": "c45f10c3-081c-37ab-b3a8-296bc4108fe0",
                        "glosses": [
                            "o koniu: czystej krwi, szlachetnej rasy i żywego temperamentu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8174d53a-d38b-43ab-aea3-db93a241a7d2",
                                "sense_id": "014aa17c-d850-31d4-8376-7e0f7ce921a0",
                                "text": "Koń czystej krwi arabskiej to jedna z podstawowych ras koni gorącokrwistych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f68e07d3-0890-3312-aeb1-fb9a3c0c2727",
                        "entry_id": "c45f10c3-081c-37ab-b3a8-296bc4108fe0",
                        "glosses": [
                            "o człowieku: o wybuchowym temperamencie, namiętny"
                        ],
                        "tags": [],
