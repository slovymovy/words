                ],
                "senses": [
                    {
                        "sense_id": "96647453-42bb-3f71-97c5-264018859e37",
                        "entry_id": "0d755c4e-e0c6-337d-bcb8-422f267c49b7",
                        "glosses": [
                            "To call a bet after another player has already called"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7ee2489-f9e3-4d86-9580-559c808e1cb7",
                                "sense_id": "96647453-42bb-3f71-97c5-264018859e37",
                                "text": "Jill bet, Tommy called, and Julie overcalled."
                            }
                        ]
                    },
                    {
                        "sense_id": "93c97b96-61cb-32b2-b456-3b75b0e2c4ff",
                        "entry_id": "0d755c4e-e0c6-337d-bcb8-422f267c49b7",
                        "glosses": [
                            "To diagnose a condition that does not, in fact, exist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0db25ef2-03c7-4b97-89d9-6f2f40e8d466",
                                "sense_id": "93c97b96-61cb-32b2-b456-3b75b0e2c4ff",
                                "text": "Knowledge of the ultrasound findings is important, and appreciating the fetal ultrasound may often undercall or (more often) overcall anomalies."
                            },
                            {
                                "example_id": "cca10ed3-d162-4063-b4f9-7c9bdd980340",
                                "sense_id": "93c97b96-61cb-32b2-b456-3b75b0e2c4ff",
                                "text": "It's also possible to overcall PSC when motion artifact on the long respiratory-triggered acquisitions leads to the appearance of pseudo-strictures."
                            },
                            {
                                "example_id": "9bba2265-5115-473c-96be-edb63ee78d30",
                                "sense_id": "93c97b96-61cb-32b2-b456-3b75b0e2c4ff",
                                "text": "Because these lesions often spontaneously regress, care must be taken to not overcall these lesions on FNA."
                            }
                        ]
                    }
                ],
