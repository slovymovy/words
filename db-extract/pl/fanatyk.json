                                    },
                                    {
                                        "sense_id": "49d66033-a60a-3159-86a5-bf18c74b3134",
                                        "entry_id": "8978de22-6a45-369c-99e8-6904a46cb9a3",
                                        "glosses": [
                                            "El preocupado o entusiasmado por alguna cosa."
                                        ],
