                                        "entry_id": "63f37ef3-4ff8-3b77-94c5-14d811bb5f10",
                                        "glosses": [
                                            "Actual or threatened force for the purpose of compelling action by another person; the act of coercing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "058ceade-114c-4fad-9069-93addec4ec50",
                                                "sense_id": "103441dd-7749-3e1e-b3f3-adcbbeeccdd0",
                                                "text": "One of the primary objectives of the foreign policy of the United States is the creation of conditions in which we and other nations will be able to work out a way of life free from coercion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2530bf59-4913-3bdb-9d1f-d48f7fd41b24",
                                        "entry_id": "63f37ef3-4ff8-3b77-94c5-14d811bb5f10",
                                        "glosses": [
                                            "Use of physical or moral force to compel a person to do something, or to abstain from doing something, thereby depriving that person of the exercise of free will."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71455978-88a0-3d87-a25b-abe4bdba3c36",
                                        "entry_id": "63f37ef3-4ff8-3b77-94c5-14d811bb5f10",
                                        "glosses": [
                                            "A specific instance of coercing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2e653c1-67f6-39a4-a656-12fd4b1a8cb7",
                                        "entry_id": "63f37ef3-4ff8-3b77-94c5-14d811bb5f10",
                                        "glosses": [
                                            "Conversion of a value of one data type to a value of another data type."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7b63a83-fb73-331d-8f65-eb02b6f35cb0",
                                        "entry_id": "63f37ef3-4ff8-3b77-94c5-14d811bb5f10",
                                        "glosses": [
                                            "The process by which the meaning of a word or other linguistic element is reinterpreted to match the grammatical context."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd556a8a-5929-4a2c-aa65-651e58378b54",
                                                "sense_id": "f7b63a83-fb73-331d-8f65-eb02b6f35cb0",
                                                "text": "But often the pieces of information do not fit together and have to be shifted in meaning to confirm with the rest of the sentence. These shifts are called coercion"
                                            },
                                            {
                                                "example_id": "22decf0f-4546-4485-81c9-2d2249d44af1",
                                                "sense_id": "f7b63a83-fb73-331d-8f65-eb02b6f35cb0",
                                                "text": "...a conversion of mass nouns into count readings according to sorter and portion coercion is only possible if the denotation of a mass noun already comprises minimal parts into which the noun can be subdivided."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0d84286-5ff4-3355-9c1a-2c6ea84fad27",
                                        "entry_id": "63f37ef3-4ff8-3b77-94c5-14d811bb5f10",
                                        "glosses": [
                                            "The initiation or threat of conflict; aggression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
