                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da5200bf-6e9d-48d0-a9d0-34f0a2ba8657",
                                                "sense_id": "223019e9-405f-300b-b5f4-5a86365fc2a9",
                                                "text": "Die Schaukel befand sich im Abschwung, als das Kind herunter fiel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09086876-7b8c-3ed6-b673-f0724ae6cd49",
                                        "entry_id": "328359c3-2016-3bff-b93f-882e63cb13b2",
                                        "glosses": [
                                            "Phase negativen Wirtschaftswachstums oder schrumpfenden Bruttoinlandsprodukts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db201b7-97fc-4851-b8f4-fd2011212e71",
                                                "sense_id": "09086876-7b8c-3ed6-b673-f0724ae6cd49",
                                                "text": "„Ist das der Auftakt eines Abschwungs oder nur eine vorübergehende Schwächephase?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5f619cad-870d-377c-b6b2-bee3ce601092",
                                        "entry_id": "328359c3-2016-3bff-b93f-882e63cb13b2",
                                        "glosses": [
                                            "Fahrtrichtungsänderung auf Skiern"
                                        ],
                                        "tags": [
                                            "Skifahren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b07550b-406d-47af-b1ea-01ce4fc8a587",
                                                "sense_id": "5f619cad-870d-377c-b6b2-bee3ce601092",
                                                "text": "„Der Deutsche war gegen 9 Uhr talwärts unterwegs, als er beim Abschwung einen Ski verlor und über den Pistenrand hinaus geriet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b06976b-86e4-4f98-9783-9fb4ba496d8e",
                        "source_entry_id": "c0e32f16-be09-3a12-b770-52f7a9b479c6",
                        "source_sense_id": "12a5d7c9-da14-3b94-8ec0-d065afc6db0c",
                        "source_sense_description": "a downward trend, or the beginnings of one",
                        "target_lang_word": "Rückgang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückgang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb6c01b-94a6-3a4a-a913-4d0cbe436a92",
                                        "entry_id": "de49ee83-6319-3b08-af1f-9c4ee2d4ba64",
                                        "glosses": [
                                            "das Kleinerwerden oder Geringerwerden von etwas, Verringerung, Abnahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fa5708-b21a-4def-b09f-54864d01b766",
                                                "sense_id": "bbb6c01b-94a6-3a4a-a913-4d0cbe436a92",
                                                "text": "Mit solch einem starken Rückgang der Aufträge hätte kaum jemand in der Wirtschaft gerechnet."
                                            },
                                            {
                                                "example_id": "b7a06f08-979b-4afc-9e3e-3bcbdb4ee38d",
                                                "sense_id": "bbb6c01b-94a6-3a4a-a913-4d0cbe436a92",
                                                "text": "Insgesamt dürfte die Einwohnerzahl Deutschlands auch 2007 wieder gesunken sein. Von Ende 2006 bis Ende 2007 wird mit einem Rückgang von etwa 100.000 Personen auf 82,21 Millionen gerechnet."
                                            },
                                            {
                                                "example_id": "94f09f29-f8a6-4146-a20e-97fcdf213613",
                                                "sense_id": "bbb6c01b-94a6-3a4a-a913-4d0cbe436a92",
                                                "text": "„Offenbar führte der Klimawandel zu einem dramatischen Rückgang der nomadisch lebenden Populationen.“"
                                            },
                                            {
                                                "example_id": "77cd9470-4ec6-45b3-bde6-6a9daf3d7046",
                                                "sense_id": "bbb6c01b-94a6-3a4a-a913-4d0cbe436a92",
                                                "text": "„Mit der stärkeren Orientierung Ungarns Richtung Westen sei auch ein Rückgang des Russischen als Pflichtsprache und eine Stärkung des Deutschen und Englischen einhergegangen.“"
                                            },
                                            {
                                                "example_id": "73ace8b2-b2bd-4184-a05c-090ea6f3dbb5",
                                                "sense_id": "bbb6c01b-94a6-3a4a-a913-4d0cbe436a92",
                                                "text": "„In Kontinentaleuropa und besonders in Frankreich betrachtet man die ersten Nachkriegsjahrzehnte, die von starken staatlichen Eingriffen geprägt waren, als eine segensreiche Zeit des Wachstums und macht häufig die um 1980 eingeleitete wirtschaftliche Liberalisierung für seinen Rückgang verantwortlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
