                ],
                "senses": [
                    {
                        "sense_id": "35401b68-4fb1-3fd1-88f2-5c3b0662c384",
                        "entry_id": "d061a66d-fbcc-3699-90f3-d8d27cd55678",
                        "glosses": [
                            "тот, кто в какой-либо местности поселился одним из первых"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a23b14e-9409-4df6-8b1e-2885c771c78e",
                                "sense_id": "35401b68-4fb1-3fd1-88f2-5c3b0662c384",
                                "text": "Но ветхое сооружение сарайного вида, воздвигнутое под парикмахерскую на скорую руку ещё первопоселенцами, сдавало под напором заполярных стихий."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9bde8be-1a71-4a0c-a25e-cd6981502635",
                        "source_entry_id": "d061a66d-fbcc-3699-90f3-d8d27cd55678",
                        "source_sense_id": "35401b68-4fb1-3fd1-88f2-5c3b0662c384",
                        "target_lang_word": "pioneer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pioneer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e1d81f4-a269-3f51-b4d4-85580c5c7992",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "One who goes before, as into the wilderness, preparing the way for others to follow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "420cf265-6ed8-3b7b-a174-f35348d9bfcb",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "A person or other entity who is first or among the earliest in any field of inquiry, enterprise, or progress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "714320cd-ab8a-4eec-ae8d-bb477bf94bce",
                                                "sense_id": "420cf265-6ed8-3b7b-a174-f35348d9bfcb",
                                                "text": "Some people will consider their national heroes to be pioneers of civilization."
                                            },
                                            {
                                                "example_id": "0c2fbb80-e19c-4232-b529-af87c6882259",
                                                "sense_id": "420cf265-6ed8-3b7b-a174-f35348d9bfcb",
                                                "text": "Certain politicians can be considered as pioneers of reform."
                                            },
                                            {
                                                "example_id": "6cbc6460-fbba-4b55-bee5-59eb9371e2e6",
                                                "sense_id": "420cf265-6ed8-3b7b-a174-f35348d9bfcb",
                                                "text": "As towns continue to grow, replanting vegetation has become a form of urban utopia and green roofs are spreading fast. Last year 1m square metres of plant-covered roofing was built in France, as much as in the US, and 10 times more than in Germany, the pioneer in this field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5f61775-651f-341f-9fb6-3a6aee4b854d",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "A soldier detailed or employed to form roads, dig trenches, and make bridges, as an army advances; a sapper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fefdae6b-46f6-4a28-8fb4-926617524156",
                                                "sense_id": "d5f61775-651f-341f-9fb6-3a6aee4b854d",
                                                "text": "[King of] Fess. What thinks your greatnes beſt to be atchieu’d\nIn purſuit of the Cities ouerthrow?\nBai[azeth]. I wil the captiue Pioners of Argier,\nCut off the water, that by leaden pipes\nRuns to the citie from the mountain Carnon, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8273d2d9-21ed-3847-a7b3-97aea594ce4f",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "A member of any of several European organizations advocating abstinence from alcohol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "102290f7-6bb5-320c-9a90-06574fc0a286",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "A member of a children’s organization operated by the Communist Party, typically in the second of three stages toward becoming a member of the Party itself."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06596dcd-5d70-3056-b4c7-b150958186b7",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "Alternative letter-case form of Pioneer (“A Singaporean born on or before 31 December 1949, who is entitled to various healthcare and social support schemes.”)."
                                        ],
                                        "tags": [
                                            "Singapore",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa55c2aa-337f-48cf-9d66-4c28443a515f",
                                                "sense_id": "06596dcd-5d70-3056-b4c7-b150958186b7",
                                                "text": "Perhaps the pioneer generation, having experienced unity in solidarity, will show the rest of Singapore the way."
                                            },
                                            {
                                                "example_id": "dcb394ed-44a4-4920-a7e7-b7e1c5c2353a",
                                                "sense_id": "06596dcd-5d70-3056-b4c7-b150958186b7",
                                                "text": "A fenceless open-air museum […] that captures the spirit and struggles of Singapore's pioneer generation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pioneer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9337949d-0845-3e37-af48-0300e0c5c748",
                                        "entry_id": "2c11f706-db73-3c67-acc3-527b4cb18f92",
                                        "glosses": [
                                            "To be the first to do or achieve (something), preparing the way for others to follow."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cc4f5f0-c064-4ca5-a0af-5703efc99650",
                                                "sense_id": "9337949d-0845-3e37-af48-0300e0c5c748",
                                                "text": "The young doctor pioneered a new life-saving surgical technique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c21943b4-4a6b-4e1f-ade5-964087c94bf9",
                        "source_entry_id": "d061a66d-fbcc-3699-90f3-d8d27cd55678",
                        "source_sense_id": "35401b68-4fb1-3fd1-88f2-5c3b0662c384",
                        "target_lang_word": "settler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "settler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "Someone who settles in a new location, especially one who takes up residence in a previously uninhabited place; a colonist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7939f95-5ddf-4655-821d-910db909bc84",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "the first settlers of New England"
                                            },
                                            {
                                                "example_id": "52579e07-6333-46ef-88dd-f34be51f8b08",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "The law, which let settlers stay on private land if they had built there without knowing the property belonged to Palestinians or had done so at the state’s direction, was backed by Israel’s most right-wing governing coalition to date."
                                            },
                                            {
                                                "example_id": "a96ceb0e-4704-4f57-a394-17ba58908b57",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "It was the racist, settler colonialism that created whiteness, that created blackness, half-caste, quarter-caste, octoroon, that saw mixed-race people as a third race. […] This belief was one of the drivers of the ‘protection’ laws that led to the settler government’s theft of children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f6dfcc-cc19-3cd8-a353-b98529b3dcca",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "Someone who decides or settles something, such as a dispute."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5146319-0904-3f07-bdc9-7d0926625dec",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "That which settles or finishes, such as a blow that decides a contest."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec4ceef8-d623-33f8-a7a0-24115af212b1",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "The person in a betting shop who calculates the winnings."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8e27349-eddc-3829-84a6-6e18640aa36f",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "A drink which settles the stomach, especially a bitter drink, often a nightcap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "525268af-54b3-4f76-b911-29805489aefe",
                                                "sense_id": "d8e27349-eddc-3829-84a6-6e18640aa36f",
                                                "text": "[H]aving got out the rum bottle for a quiet “settler” just as the victim of his fascinations glided through the carefully adjusted door, he had been persuaded to go on drinking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa0f0776-e6e7-3884-8d04-0ddfcd8e147a",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "A vessel, such as a tub, in which something, such as pulverized ore suspended in a liquid, is allowed to settle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b2a9f2-7664-466b-962d-12e5514cfbac",
                                                "sense_id": "aa0f0776-e6e7-3884-8d04-0ddfcd8e147a",
                                                "text": "First, there will be little reaction in the settler so that the concentrations of soluble constituents in the recycle stream are the same as those in the bioreactor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
