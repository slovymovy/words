                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Я не смогу прийти на встречу. — <w>Ясно</w>, тогда перенесём.",
                            "target_lang_translations": {
                                "en": "— I won't be able to come to the meeting. — <w>I see</w>, then we'll reschedule.",
                                "es": "— No podré ir a la reunión. — <w>Entendido</w>, entonces la cambiamos de fecha.",
                                "fr": "— Je ne pourrai pas venir à la réunion. — <w>D'accord</w>, on la décalera.",
