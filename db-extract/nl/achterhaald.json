                    {
                        "sense_id": "1f1999e2-70bd-35c4-8c2a-6ee3489472de",
                        "entry_id": "8ed0a4bd-ff0f-3bf1-8b3a-0c6d8be3eb87",
                        "glosses": [
                            "niet langer van toepassing, niet langer als nuttig erkend (en dus fout)"
                        ],
