                                                "example_id": "65e6b2fb-f656-4471-ba4c-71b35ba66e1a",
                                                "sense_id": "23371be9-d36f-367c-935d-d57d59cf4f47",
                                                "text": "Now have client take slower, normal breaths through the nose and notice how the abdomen moves slightly outward with each inhale and then deflates with each exhale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27b3a3cc-47e4-4d02-9c80-1e98ede2f8ee",
                        "source_entry_id": "db436b86-280e-3798-a553-8d4e4cb85937",
                        "target_lang_word": "expirer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expirer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f8d25e9-03cc-3db5-880e-75294801a7f3",
                                        "entry_id": "eef8b41c-7d43-316a-b558-524c68b703ed",
                                        "glosses": [
                                            "Rendre le dernier soupir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0bd5ce2-1195-40ba-b654-bcf0545f6795",
                                                "sense_id": "8f8d25e9-03cc-3db5-880e-75294801a7f3",
                                                "text": "[…], elle se trouva mal en rentrant dans sa maison : on s'efforça vainement de la secourir, de la ranimer; elle expira sans avoir repris ses sens, ni laissé apercevoir aucune marque de connaissance."
                                            },
                                            {
                                                "example_id": "be59081c-ff91-403b-ba38-9891131d90ba",
                                                "sense_id": "8f8d25e9-03cc-3db5-880e-75294801a7f3",
                                                "text": "Cette apnée peut durer de quelques secondes à une, deux minutes et plus. On peut croire que l'enfant est expiré, puis une inspiration reparaît suivie d'autres de plus en plus rapprochées, et les alternatives d’apnée et de respiration fréquente se répètent à plusieurs reprises jusqu'à la mort."
                                            },
                                            {
                                                "example_id": "d40b1a41-b4aa-459b-a56e-4a1cc5f68c04",
                                                "sense_id": "8f8d25e9-03cc-3db5-880e-75294801a7f3",
                                                "text": "Bien que sur le point d’expirer le Bouddha se sent encore la force de recevoir une foule d’arhats les uns après les autres et de leur adresser des exhortations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9bc5938-5dd4-3684-9d26-bb79510a482f",
                                        "entry_id": "eef8b41c-7d43-316a-b558-524c68b703ed",
                                        "glosses": [
                                            "Prendre fin, cesser d’être, en parlant de certaines choses physiques ou morales."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "788683dc-be06-41b7-a7c0-162d9113e44a",
                                                "sense_id": "c9bc5938-5dd4-3684-9d26-bb79510a482f",
                                                "text": "Ma police d’assurance pour mon habitation était expirée depuis le jour précédent, et […] il avait été convenu qu’à six heures je me présenterais devant le conseil des directeurs de la compagnie pour arrêter les termes d’un renouvellement."
                                            },
                                            {
                                                "example_id": "2bc41f3d-95a4-4bd6-abff-8ec56a48dc4c",
                                                "sense_id": "c9bc5938-5dd4-3684-9d26-bb79510a482f",
                                                "text": "Le bail de la caserne de gendarmerie de Saint-Nicolas-du-Pélem expire le 31 décembre 1880, celui de Mûr le 30 avril 1881, et ceux de Bégard et Quintin le 30 septembre 1881.\nM. de Boisboissel, propriétaire de la caserne actuelle de Saint-Nicolas-du-Pélem, consent à renouveler le bail, mais moyennant une augmentation de 600 fr., ce qui élèverait le prix du loyer de 600 fr. à 1,200 fr."
                                            },
                                            {
                                                "example_id": "d515dd33-c6f4-4351-a626-635121426e81",
                                                "sense_id": "c9bc5938-5dd4-3684-9d26-bb79510a482f",
                                                "text": "La vague vient expirer au pied de cette falaise."
                                            },
                                            {
                                                "example_id": "aeb65372-3fd8-4f70-ab4a-8ab11a6de972",
                                                "sense_id": "c9bc5938-5dd4-3684-9d26-bb79510a482f",
                                                "text": "Les sons expirèrent lentement."
                                            },
                                            {
                                                "example_id": "9ee53008-4fef-44de-a223-29f53ed305bc",
                                                "sense_id": "c9bc5938-5dd4-3684-9d26-bb79510a482f",
                                                "text": "À sa vue, le reproche expira sur mes lèvres."
                                            },
                                            {
                                                "example_id": "18344919-c3af-4941-960a-f2287f62d815",
                                                "sense_id": "c9bc5938-5dd4-3684-9d26-bb79510a482f",
                                                "text": "La puissance de cet empire était près d’expirer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "expirer",
                                "target_lang_code": "fr",
