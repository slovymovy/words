{
    "word_family": [
        "flanker",
        "outflank"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bcd52f5e-4cd8-327b-bf3c-6b9d2bb6b2c5",
                    "sense_definition": "The side of something, in general senses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "side",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cautiously I approached the <w>flank</w> of the cliffs, where they terminated in an abrupt escarpment.",
                            "target_lang_translations": {
                                "ru": "Осторожно я приблизился к <w>склону</w> скал, где они обрывались крутым утесом."
                            }
                        },
                        {
                            "text": "The hikers walked slowly along the steep <w>flank</w> of the mountain.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы медленно шли по крутому <w>склону</w> горы."
                            }
                        }
                    ],
                    "synonyms": [
                        "side"
                    ],
                    "common_phrases": [
                        "mountain flank",
                        "flank of the hill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Боковая сторона или склон чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склон",
                                "target_lang_sense_clarification": "горы или холма"
                            },
                            {
                                "target_lang_word": "бок",
                                "target_lang_sense_clarification": "боковая сторона предмета"
                            },
                            {
                                "target_lang_word": "сторона",
                                "target_lang_sense_clarification": "боковая часть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52447207-bfe0-3a83-a6b5-47832681355d",
                    "sense_definition": "The extreme left or right edge of a military formation, army, or fleet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_and_sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general ordered a surprise attack on the enemy's left <w>flank</w>.",
                            "target_lang_translations": {
                                "ru": "Генерал приказал нанести внезапный удар по левому <w>флангу</w> противника."
                            }
                        },
                        {
                            "text": "Soldiers were deployed to protect the vulnerable <w>flank</w> of the army.",
                            "target_lang_translations": {
                                "ru": "Солдаты были развернуты для защиты уязвимого <w>фланга</w> армии."
                            }
                        }
                    ],
                    "synonyms": [
                        "wing",
                        "side"
                    ],
                    "common_phrases": [
                        "left flank",
                        "right flank",
                        "protect the flank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайняя левая или правая оконечность военного расположения, армии или флота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фланг",
                                "target_lang_sense_clarification": "военный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb39c743-132a-3d26-b802-61d07aa7e5b3",
                    "sense_definition": "The lateral flesh between the last rib and the hip of an animal or human.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse had a small white patch on its left <w>flank</w>.",
                            "target_lang_translations": {
                                "ru": "У лошади было небольшое белое пятно на левом <w>боку</w>."
                            }
                        },
                        {
                            "text": "He patted the dog gently on its warm <w>flank</w>.",
                            "target_lang_translations": {
                                "ru": "Он ласково похлопал собаку по теплому <w>боку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "side"
                    ],
                    "common_phrases": [
                        "animal flank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Боковая часть туловища животного или человека между последним ребром и бедром."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бок",
                                "target_lang_sense_clarification": "часть туловища"
                            },
                            {
                                "target_lang_word": "бочок",
                                "target_lang_sense_clarification": "уменьшительное от бок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "242f3e9d-f232-3fe7-bb7c-aa02f17d237b",
                    "sense_definition": "The wing or side of the pitch in sports.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "military_and_sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winger made a brilliant run down the left <w>flank</w> to cross the ball.",
                            "target_lang_translations": {
                                "ru": "Фланговый нападающий совершил блестящий прорыв по левому <w>флангу</w>, чтобы сделать навес."
                            }
                        },
                        {
                            "text": "They focused their attack down the right <w>flank</w> to exploit the defender's weakness.",
                            "target_lang_translations": {
                                "ru": "Они сосредоточили свою атаку на правом <w>фланге</w>, чтобы использовать слабость защитника."
                            }
                        }
                    ],
                    "synonyms": [
                        "wing"
                    ],
                    "common_phrases": [
                        "down the flank",
                        "left flank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Край или боковая часть игрового поля в спорте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фланг",
                                "target_lang_sense_clarification": "в спорте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50fdb66e-9a99-3fa9-af9f-f12614e694c8",
                    "sense_definition": "A cut of meat from the flank of an animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a fresh <w>flank</w> steak to marinate for the weekend barbecue.",
                            "target_lang_translations": {
                                "ru": "Мы купили свежий стейк из <w>пашины</w>, чтобы замариновать его для барбекю на выходных."
                            }
                        },
                        {
                            "text": "The chef recommended slow-cooking the beef <w>flank</w> to make it tender.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар рекомендовал медленно тушить говяжью <w>пашину</w>, чтобы она стала нежной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flank steak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок мяса, вырезанный из пашины (боковой части туши животного)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пашина",
                                "target_lang_sense_clarification": "часть мясной туши"
                            },
                            {
                                "target_lang_word": "бочок",
                                "target_lang_sense_clarification": "мясной отруб"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ef64771-e6fd-33ea-804c-8ab4882309d3",
                    "sense_definition": "An ideological faction within a political party.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president faced strong opposition from the progressive <w>flank</w> of his own party.",
                            "target_lang_translations": {
                                "ru": "Президент столкнулся с сильной оппозицией со стороны прогрессивного <w>крыла</w> своей собственной партии."
                            }
                        },
                        {
                            "text": "To win the election, she had to appeal to the party's conservative <w>flank</w>.",
                            "target_lang_translations": {
                                "ru": "Чтобы победить на выборах, ей пришлось апеллировать к консервативному <w>крылу</w> партии."
                            }
                        }
                    ],
                    "synonyms": [
                        "wing"
                    ],
                    "common_phrases": [
                        "right flank",
                        "left flank",
                        "political flank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идеологическая группировка или крыло внутри политической партии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крыло",
                                "target_lang_sense_clarification": "политическая фракция"
                            },
                            {
                                "target_lang_word": "фланг",
                                "target_lang_sense_clarification": "политическая группировка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7cbac0e-ded9-39e5-b9e4-c0a39757c4f1",
                    "sense_definition": "The sides of a bastion perpendicular to the wall from which the bastion projects.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defenders positioned cannons along the <w>flank</w> of the bastion to cover the main wall.",
                            "target_lang_translations": {
                                "ru": "Обороняющиеся разместили пушки вдоль <w>фланка</w> бастиона, чтобы прикрыть главную стену."
                            }
                        },
                        {
                            "text": "Architects designed the fortress so that each <w>flank</w> could protect the adjacent curtain wall.",
                            "target_lang_translations": {
                                "ru": "Архитекторы спроектировали крепость так, чтобы каждый <w>фланк</w> мог защищать прилегающую куртину."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in fortification"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Боковая сторона бастиона, перпендикулярная крепостной стене."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фланк",
                                "target_lang_sense_clarification": "фортификационный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7d6612d-e0df-3d89-b4f4-36fec8a66cdd",
                    "sense_definition": "Either of the two pockets located on the seat of a pair of pants.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I took the quarter I found and hid it in my right <w>flank</w>.",
                            "target_lang_translations": {
                                "ru": "Я взял найденную четверть доллара и спрятал ее в свой правый <w>карман</w>."
                            }
                        },
                        {
                            "text": "He reached into his trousers' <w>flank</w> to pull out his keys.",
                            "target_lang_translations": {
                                "ru": "Он залез в <w>карман</w> брюк, чтобы вытащить ключи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "rare or regional slang for pockets"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из двух карманов, расположенных сзади или сбоку на брюках."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карман",
                                "target_lang_sense_clarification": "брючный карман"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8ecaa3a-187d-3895-95b9-56a2bb6dac22",
                    "sense_definition": "The outermost strip of a road.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "road",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The broken-down car was parked safely on the grassy <w>flank</w> of the highway.",
                            "target_lang_translations": {
                                "ru": "Сломавшийся автомобиль был безопасно припаркован на поросшей травой <w>обочине</w> шоссе."
                            }
                        },
                        {
                            "text": "Cyclists are advised to ride on the outer <w>flank</w> of the road.",
                            "target_lang_translations": {
                                "ru": "Велосипедистам рекомендуется ехать по самому внешнему <w>краю</w> дороги."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайняя полоса или обочина дороги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обочина",
                                "target_lang_sense_clarification": "край дороги"
                            },
                            {
                                "target_lang_word": "край",
                                "target_lang_sense_clarification": "край дороги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a81eacf6-b376-3cab-9c34-ba050d28c058",
                    "sense_definition": "That part of the acting surface of a gear wheel tooth that lies within the pitch line.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excessive wear on the tooth <w>flank</w> can cause the gears to slip.",
                            "target_lang_translations": {
                                "ru": "Чрезмерный износ <w>ножки</w> зуба шестерни может привести к проскальзыванию передач."
                            }
                        },
                        {
                            "text": "The engineer inspected the <w>flank</w> of each gear tooth for microscopic cracks.",
                            "target_lang_translations": {
                                "ru": "Инженер осмотрел <w>боковую поверхность</w> каждого зубца шестерни на наличие микротрещин."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tooth flank"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical engineering term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть рабочей поверхности зуба шестерни, лежащая внутри делительной окружности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ножка зуба",
                                "target_lang_sense_clarification": "в машиностроении"
                            },
                            {
                                "target_lang_word": "фланк зуба",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a771d42e-8502-371d-9a39-35845362cbf9",
                    "sense_definition": "To be placed to the side(s) of something (usually in terms of two objects, one on each side).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two tall stone pillars <w>flank</w> the entrance to the ancient estate.",
                            "target_lang_translations": {
                                "ru": "Два высоких каменных столба <w>обрамляют</w> вход в старинное поместье."
                            }
                        },
                        {
                            "text": "Beautiful rose bushes <w>flank</w> the garden path on both sides.",
                            "target_lang_translations": {
                                "ru": "Красивые розовые кусты <w>растут по обеим сторонам</w> садовой дорожки."
                            }
                        }
                    ],
                    "synonyms": [
                        "straddle"
                    ],
                    "common_phrases": [
                        "flank the entrance",
                        "flank the sides"
                    ],
                    "target_lang_definitions": {
                        "ru": "Располагаться по бокам или с обеих сторон чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрамлять",
                                "target_lang_sense_clarification": "находиться по бокам"
                            },
                            {
                                "target_lang_word": "фланкировать",
                                "target_lang_sense_clarification": "располагаться по сторонам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14889803-3f7a-36fb-9c42-139aeb693fe2",
                    "sense_definition": "To place to the side(s) of.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designers decided to <w>flank</w> the main doorway with decorative trees.",
                            "target_lang_translations": {
                                "ru": "Дизайнеры решили <w>украсить по бокам</w> главный вход декоративными деревьями."
                            }
                        },
                        {
                            "text": "They <w>flanked</w> the central stage with large video screens for the concert.",
                            "target_lang_translations": {
                                "ru": "Для концерта они <w>установили по бокам</w> от центральной сцены большие видеоэкраны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flank with trees"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размещать объекты по бокам или с обеих сторон от чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружать с боков",
                                "target_lang_sense_clarification": "размещать по сторонам"
                            },
                            {
                                "target_lang_word": "фланкировать",
                                "target_lang_sense_clarification": "архитектурное размещение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5aee5b8-e66f-3960-9526-214eb7a78b7f",
                    "sense_definition": "To attack the flank(s) of.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cavalry managed to <w>flank</w> the enemy forces and disrupt their retreat.",
                            "target_lang_translations": {
                                "ru": "Кавалерии удалось <w>обойти с фланга</w> силы противника и сорвать их отступление."
                            }
                        },
                        {
                            "text": "Our strategy was to <w>flank</w> the opposing army rather than launch a frontal assault.",
                            "target_lang_translations": {
                                "ru": "Наша стратегия заключалась в том, чтобы <w>атаковать во фланг</w> противостоящую армию, а не идти на фронтальный штурм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flank the enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Атаковать противника с фланга или обойти его с флангов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обойти с фланга",
                                "target_lang_sense_clarification": "военное действие"
                            },
                            {
                                "target_lang_word": "атаковать во фланг",
                                "target_lang_sense_clarification": "военный маневр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7ca72ae-9619-35c7-8f91-360f93e6cf7d",
                    "sense_definition": "To defend the flank(s) of.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "military_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A secondary unit was sent to <w>flank</w> the main battalion during the advance.",
                            "target_lang_translations": {
                                "ru": "Вспомогательное подразделение было отправлено, чтобы <w>прикрывать фланги</w> основного батальона во время наступления."
                            }
                        },
                        {
                            "text": "We must position our troops carefully to <w>flank</w> our vulnerable supply lines.",
                            "target_lang_translations": {
                                "ru": "Мы должны тщательно расположить наши войска, чтобы <w>обезопасить с флангов</w> наши уязвимые линии снабжения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикрывать или защищать фланги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фланкировать",
                                "target_lang_sense_clarification": "защищать продольным огнем"
                            },
                            {
                                "target_lang_word": "прикрывать фланг",
                                "target_lang_sense_clarification": "оборонять сбоку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4977e208-d75a-3430-97b3-edd2065b891f",
                    "sense_definition": "Maximum speed. Historically faster than full speed (the most a vessel can sustain without excessive engine wear), now frequently used interchangeably. Typically used in an emergency.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain ordered the crew to go at <w>flank</w> speed to escape the storm.",
                            "target_lang_translations": {
                                "ru": "Капитан приказал команде идти на <w>самом полном</w> ходу, чтобы уйти от шторма."
                            }
                        },
                        {
