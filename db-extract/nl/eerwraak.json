                ],
                "senses": [
                    {
                        "sense_id": "26a2b81f-adb8-3b07-ae24-ef33c95b963c",
                        "entry_id": "f25df534-d1ff-3378-8830-06d7fb12c2de",
                        "glosses": [
                            "uit het gewoonterecht voortvloeiend recht en (gevoeld) plicht om de familie-eer te zuiveren door moord op de schender of degene die schuldig bevonden wordt aan het eerverlies van diens familie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573fb6f3-9326-47b8-9980-f6e2052507c6",
                                "sense_id": "26a2b81f-adb8-3b07-ae24-ef33c95b963c",
                                "text": "De rechtbank in Den Haag heeft gisteren de 20-jarige Turk H.T. uit Leiden, die met als motief eerwraak op 28 februari van dit jaar zijn landgenoot Mernis Tank (35) in Leiden neerschoot, veroordeeld tot zes jaar gevangenisstraf."
                            },
                            {
                                "example_id": "09a71d9e-dfa3-4740-97cc-3283c3c12fe2",
                                "sense_id": "26a2b81f-adb8-3b07-ae24-ef33c95b963c",
                                "text": "de verkrachte vrouw werd om redenen van eerwraak door haar echtgenoot vermoord"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d02f469-64f9-4a13-8c26-d388bf8e225d",
                        "source_entry_id": "f25df534-d1ff-3378-8830-06d7fb12c2de",
                        "source_sense_id": "26a2b81f-adb8-3b07-ae24-ef33c95b963c",
                        "target_lang_word": "Ehrenmord",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ehrenmord",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                                        "entry_id": "07cc9b5e-cb5d-39e1-9c16-f34c83e3167e",
                                        "glosses": [
                                            "vorsätzliche Tötung bzw. Ermordung eines Menschen, durch die – aus der Sicht des Täters – die Ehre einer bestimmten Person oder einer Personengruppe oder des Getöteten vermeintlich wieder hergestellt werden soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb35866-1874-48e7-ade8-09227fbcf930",
                                                "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                                                "text": "Die sogenannten Ehrenmorde schockieren jedesmal die Öffentlichkeit."
                                            },
                                            {
                                                "example_id": "be280f36-5a93-4896-be78-74bdf808ac84",
                                                "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                                                "text": "„In all diesen Religionsgemeinschaften kommt es immer wieder zu Ehrenmorden, auch unter Christen.“"
                                            },
                                            {
                                                "example_id": "931f875c-b756-4d07-89ee-487ba918a730",
                                                "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                                                "text": "„Die Ehre wird eben im Zweifel bis zum Ehrenmord verteidigt.“"
                                            },
                                            {
                                                "example_id": "7ac09b93-9200-4e69-a80a-080d2ac33030",
                                                "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                                                "text": "„Ehrenmord ist das fatale Produkt falsch verstandener Traditionen.“"
                                            },
                                            {
                                                "example_id": "ceb35da9-cd28-47a5-b8f6-497fe9553b6e",
                                                "sense_id": "368bfbd1-93b1-31c1-9535-34d27c6ec742",
                                                "text": "„2011 wurden offiziell 943 Fälle von Ehrenmorden an Frauen registriert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
