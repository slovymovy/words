                    {
                        "sense_id": "5fd93e8f-fabe-3522-86af-9edcef3c6841",
                        "entry_id": "21a01c00-e9de-3919-8f5f-f121fab07faa",
                        "glosses": [
                            "kraftvolles Tätigwerden, manchmal zwei oder mehr Hierarchie-Ebenen tiefer ohne Beteiligung der Zwischenebenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97682e37-483f-4ff8-939e-802be48d17ed",
                                "sense_id": "5fd93e8f-fabe-3522-86af-9edcef3c6841",
                                "text": "„Der schnelle und harte Durchgriff von ganz oben hilft dabei, den politischen Schaden zu begrenzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e34906f2-a7b5-34a2-bedc-cea4967d185c",
                        "entry_id": "21a01c00-e9de-3919-8f5f-f121fab07faa",
                        "glosses": [
                            "Betrag der Gitterspannung geteilt durch die Anodenspannung"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "a6f95c38-8773-40da-8967-a2badd95d7ab",
                                "sense_id": "e34906f2-a7b5-34a2-bedc-cea4967d185c",
                                "text": "„Die nach ihm [Barkhausen] benannte Röhrenformel (1919-21) sagt aus, dass bei Verstärkerröhren das Produkt aus Steilheit, Durchgriff und innerem Widerstand gleich 1 ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6bb29cd5-6605-381b-8eac-1e1509443225",
                        "entry_id": "21a01c00-e9de-3919-8f5f-f121fab07faa",
                        "glosses": [
                            "Durchsetzung einer Forderung gegen eine Firma bei deren haftenden Personen"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "484a58e6-f220-49a8-8135-25f9f7053173",
                                "sense_id": "6bb29cd5-6605-381b-8eac-1e1509443225",
                                "text": "„Die Durchgriffshaftung besitzt keine gesetzliche Regelung und entstand in der Rechtsprechung und Fachliteratur.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "bf350ed0-9157-3a0e-bf7d-2d3535cb07d9",
                        "entry_id": "21a01c00-e9de-3919-8f5f-f121fab07faa",
                        "glosses": [
                            "unmittelbare Wirkung der Eingangszustände eines dynamischen Systems auf die Ausgangszustände"
                        ],
                        "tags": [
                            "Systemdarstellung"
                        ],
                        "examples": [
                            {
