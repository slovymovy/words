                                                "example_id": "6a7e9508-bf1f-40f1-9871-600877dca04d",
                                                "sense_id": "ed67e8b0-5631-36d0-8d5e-1091ffcd28ac",
                                                "text": "Podaliśmy sobie ręce."
                                            },
                                            {
                                                "example_id": "bcd5e252-6334-4713-8e0d-905d4b022959",
                                                "sense_id": "ed67e8b0-5631-36d0-8d5e-1091ffcd28ac",
                                                "text": "Mały wąsik pod kulfoniastym nosem poruszył się na boki, a ręka poprawiła błyskawicznie monokl i wygładziła siwiejące baki. Szczupaczyńska dostrzegła, że łysinę zasłaniała pożyczka, finezyjna wprawdzie, lecz dalece niewystarczająca."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "70f3400e-0bb4-3e12-a228-6a534df2c198",
                                        "entry_id": "064ad311-db0b-3587-8b87-853a9445ab57",
                                        "glosses": [
                                            "cała kończyna górna człowieka lub małpy człekokształtnej od barku po palce"
                                        ],
                                        "tags": [
