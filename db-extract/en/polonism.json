                                        "sense_id": "a5e9913d-8d41-35ef-a0da-0481f27b6bf9",
                                        "entry_id": "2f33b16e-b738-3182-96dd-4a89986ead65",
                                        "glosses": [
                                            "ein stark ausgeprägtes Bewusstsein für die polnische Sprache und Kultur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4b78624-76d8-4d59-983c-d7541111ef33",
                                                "sense_id": "a5e9913d-8d41-35ef-a0da-0481f27b6bf9",
                                                "text": "„Wer dies tut, verkörpert im Gegenteil die Problematik, die ein unkritischer Polonismus birgt, nämlich eine große Megalomanie, die Überhöhung von sich selbst, von uns als dem auserwählten Volk.“"
                                            },
                                            {
                                                "example_id": "d85d4572-c7c8-4a6d-979c-88abd948b713",
                                                "sense_id": "a5e9913d-8d41-35ef-a0da-0481f27b6bf9",
                                                "text": "„Noch ungleich günstiger für eine nahe Verwirklichung dieser Pläne als in Galizien, wo der Polonismus doch wieder einmal in ein Stadium der Besinnung eingetreten zu sein scheint, stehen die Dinge in Ungarn.“"
                                            },
                                            {
                                                "example_id": "7a8ecd50-f8e3-4374-937f-ba03069110ee",
                                                "sense_id": "a5e9913d-8d41-35ef-a0da-0481f27b6bf9",
                                                "text": "„Da kam der Polonismus mit seinem finstern Katholizismus, brach die Spitzen Deutscher Civilisations-Anfänge und überlieferte diese Provinzen der Barbarei und Knechtschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
