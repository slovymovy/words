                ],
                "senses": [
                    {
                        "sense_id": "e1b7647f-10a7-30e7-a18d-dce3659cf247",
                        "entry_id": "539be329-a38a-399e-bf51-a15d494afe60",
                        "glosses": [
                            "einer der Bräuche, mit denen der Tod von Jemandem bekannt gemacht („angesagt“) wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c18399c-44f9-4332-969a-4f56096c8709",
                                "sense_id": "e1b7647f-10a7-30e7-a18d-dce3659cf247",
                                "text": "„So erzählte mir der Bauer beim Leichenschmaus, dass er selbst noch als Kind beim Tod seines Großvaters das Todansagen erlebt habe. Dazu wurden die Gegenstände in Haus und Scheune umgeräumt und die Tiere im Stall aufgescheucht: Menschen, Tieren und Dingen - allen und allem wurde der Tod angesagt.“"
                            },
                            {
                                "example_id": "3a781f54-73ce-40e5-8c33-117a54bf6704",
                                "sense_id": "e1b7647f-10a7-30e7-a18d-dce3659cf247",
                                "text": "„Neben dem mündlichen Todansagen gab es auch die Möglichkeit, diesen durch das Läuten der Totenglocke zu verkünden.“"
                            },
                            {
                                "example_id": "8bd481a0-6b1c-41df-8ea1-e7d874e7a96c",
                                "sense_id": "e1b7647f-10a7-30e7-a18d-dce3659cf247",
                                "text": "„Unklar ist noch, ob der Bruderschaftsbote bei den jeweiligen Todansagen besondere Kleidung trug.“"
                            },
                            {
                                "example_id": "84ae2d58-05a1-4c68-b41d-1acfa2288a6e",
                                "sense_id": "e1b7647f-10a7-30e7-a18d-dce3659cf247",
                                "text": "„Mit lauter Stimme verkündete sie das Todansagen.“"
                            },
                            {
                                "example_id": "c1ca9b7f-6a3f-4bce-8a8b-809d8d0dfa30",
                                "sense_id": "e1b7647f-10a7-30e7-a18d-dce3659cf247",
                                "text": "„Man nennt diesen Brauch das Todansagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
