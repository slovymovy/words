                        "entry_id": "abe82671-63a2-39af-ac5e-f743872a49d2",
                        "glosses": [
                            "The solidification of droplets of molten material falling against an upward stream of air; used especially to agglomerate ammonium nitrate and urea for use as a fertilizer."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4eeb7a49-e9b8-496d-9be3-ac1801f29b13",
                                "sense_id": "b73186f4-f69f-30a3-945b-9ece3092876a",
                                "text": "In air prilling, molten sulphur is sprayed from the top of a tower against an upward flow of air. As the sulphur falls, the sulphur droplets break into small droplets and cools into prills."
                            }
                        ]
                    }
