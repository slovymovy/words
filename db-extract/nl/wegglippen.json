                                        "entry_id": "bfa81456-1ced-372b-9b62-ca1f3fac4b76",
                                        "glosses": [
                                            "A cheat; a con artist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d8c275-459e-4fc0-9151-86d3ea261c43",
                                                "sense_id": "0be194b9-139a-35bd-a555-a281b06bbf26",
