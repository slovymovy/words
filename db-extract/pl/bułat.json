                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e135ad3e-d93e-3dc9-93da-4cc2009c208f",
                                        "entry_id": "950bc2d9-4471-3d4d-bd54-7ed90259a114",
                                        "glosses": [
                                            "истор. старинная узорчатая сталь особой прочности, обычно использовавшаяся для изготовления холодного оружия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d3d72d-4047-4dcd-b674-dd4496e20d58",
                                                "sense_id": "e135ad3e-d93e-3dc9-93da-4cc2009c208f",
                                                "text": "Корабельщики в ответ: — Мы объехали весь свет; // Торговали мы булатом, // Чистым серебром и златом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e3cedd4-80e9-3ee3-b41b-2ae342791b6b",
                                        "entry_id": "950bc2d9-4471-3d4d-bd54-7ed90259a114",
                                        "glosses": [
                                            "трад.-поэт. меч, клинок, кинжал и т. п. из такой стали"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f02ded8e-e657-42d2-bd6b-58d49dd1e3ff",
                                                "sense_id": "5e3cedd4-80e9-3ee3-b41b-2ae342791b6b",
                                                "text": "Снаряжу коня, // Наточу булат."
                                            },
                                            {
                                                "example_id": "988cc653-5c37-4f92-9264-3068222d0a73",
                                                "sense_id": "5e3cedd4-80e9-3ee3-b41b-2ae342791b6b",
                                                "text": "Да, жаль его: сражен булатом, // Он спит в земле сырой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
