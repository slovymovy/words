    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da74d09d-72d5-34ad-bbff-02c97daa085f",
                    "sense_definition": "To make a liquid thinner or less concentrated by adding more solvent, such as water.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "make_weaker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>dilute</w> the juice with water before serving it to the children."
                        },
                        {
                            "text": "Always <w>dilute</w> the cleaning solution according to the instructions on the bottle."
                        }
                    ],
                    "synonyms": [
                        "thin",
                        "water down"
                    ],
                    "antonyms": [
                        "concentrate"
                    ],
                    "common_phrases": [
                        "dilute with water"
                    ]
                },
                {
                    "sense_id": "e343d9da-3977-3878-9ce6-2f4175edfbe6",
                    "sense_definition": "To weaken or reduce the intensity or effectiveness of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "make_weaker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations will <w>dilute</w> the power of the local council."
                        },
                        {
                            "text": "Constant interruptions <w>dilute</w> the quality of his creative work."
                        }
                    ],
                    "synonyms": [
                        "weaken",
                        "diminish",
                        "attenuate"
                    ]
                },
                {
                    "sense_id": "7ff9dc92-f5fa-3b35-aa24-f7943598aba8",
                    "sense_definition": "To reduce the value of existing shares by issuing a larger number of new shares.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to issue more stock, which will <w>dilute</w> the value of current holdings."
                        },
                        {
                            "text": "Investors were worried that the merger would <w>dilute</w> their ownership stake."
                        }
                    ]
                },
                {
                    "sense_id": "566a426b-25e5-3f21-84f8-1e1c00291bd0",
                    "sense_definition": "To become thinner, weaker, or less intense.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "make_weaker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The impact of the news began to <w>dilute</w> as time passed."
