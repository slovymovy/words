                        "entry_id": "6312e25d-cf40-339d-86c1-47ab637002b3",
                        "glosses": [
                            "weiches, tuchartig geschmeidiges Leder, das mit Walfischtran oder anderen oxidierenden Fetten gegerbt ist"
                        ],
                        "tags": [
                            "Gerberei"
                        ],
                        "examples": [
                            {
                                "example_id": "77cc6f0a-dce1-4d6d-9484-4554945dfb20",
                                "sense_id": "fce95b4b-e40b-3b27-9f8d-8ec1a0957335",
                                "text": "Sämischleder wird für die Herstellung von Lederhosen verwendet."
                            },
                            {
                                "example_id": "e6275cee-55aa-4e68-92c7-fa111141dcc1",
                                "sense_id": "fce95b4b-e40b-3b27-9f8d-8ec1a0957335",
                                "text": "„Eine Verfeinerung der Lederhosen für Herren waren elegante naturfarbene Hosen aus Sämischleder, die Ende des 18. Jahrhunderts zum Frack kombiniert wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
