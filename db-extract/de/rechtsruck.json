                "senses": [
                    {
                        "sense_id": "91f6392a-3403-3776-82dc-80bc469cb3fc",
                        "entry_id": "64ee1f82-e7ce-310b-a7d4-660cd585d06c",
                        "glosses": [
                            "shift to the right, swing to the right"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "d778561d-97b7-4e1e-8f95-7bf0c57b396b",
                                "sense_id": "91f6392a-3403-3776-82dc-80bc469cb3fc",
                                "text": "Wer glaubt, der völkisch-radikale Flügel der AfD gebe sich nach dem Bundesparteitag in Riesa zufrieden mit dem erreichten Rechtsruck, dürfte irren."
                            },
                            {
                                "example_id": "feff90d7-c8ac-4e2c-b72f-ed7ed9a0c6b1",
                                "sense_id": "91f6392a-3403-3776-82dc-80bc469cb3fc",
                                "text": "Und Richtung AfD sagt sie: „Weltoffenheit ist der wichtigste Standortfaktor für Berlin“, ein Rechtsruck schwäche Wachstum und Wohlstand."
                            }
                        ]
                    }
                ],
