                "senses": [
                    {
                        "sense_id": "004e3be3-e15d-3c71-846b-ff70d6089303",
                        "entry_id": "bf75e6cf-a869-3475-8c6c-016fe1877d17",
                        "glosses": [
                            "die Suche nach einem (freien) Parkplatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4a1bafd-83c0-4544-80f6-a41a6fb702cf",
                                "sense_id": "004e3be3-e15d-3c71-846b-ff70d6089303",
                                "text": "Durch die neue Beschilderung soll der Zeitaufwand für die Parkplatzsuche deutlich verringert werden."
                            },
                            {
                                "example_id": "4ed37dac-6304-4ef8-8f32-ee5665db58f4",
                                "sense_id": "004e3be3-e15d-3c71-846b-ff70d6089303",
                                "text": "„Er glaubt, dass bessere Informationen den Menschen helfen, bessere Entscheidungen zu treffen, \"basierend auf Vorhersagen, wie viel Zeit man für die Parkplatzsuche verschwenden dürfte.\" “"
                            },
                            {
                                "example_id": "40578a16-1cd0-46b5-b904-da5ae323cba7",
                                "sense_id": "004e3be3-e15d-3c71-846b-ff70d6089303",
                                "text": "„Zu wenig kostenlose Parkplätze (49 Prozent) und hohe Parkgebühren (46 Prozent) gehören zu den Hauptärgernissen bei der Parkplatzsuche in den Landeshauptstädten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
