                    },
                    {
                        "form_id": "7d55ba41-bd75-49be-a03e-70b0d7c2399e",
                        "entry_id": "a957c50f-4a19-3f99-bc44-5a5deba196a5",
                        "tags": [
                            "la créature masculine"
                        ],
                        "form": "elfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f544a0a-a0fc-31d3-8f73-b2d5e44aef35",
                        "entry_id": "a957c50f-4a19-3f99-bc44-5a5deba196a5",
                        "glosses": [
                            "Elfe de genre féminin."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "39472203-acf2-4152-b66a-ee8402be259c",
                                "sense_id": "1f544a0a-a0fc-31d3-8f73-b2d5e44aef35",
                                "text": "Les hommes au corps lourd, sanguin, d’une courte durée et soumis à la mort, tandis que nous elves, et autres êtres habitants des bois, des prairies et des eaux nous avions un corps léger et immortel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "283177b4-ddbe-4d0d-9a41-b880122499ff",
                        "source_entry_id": "a957c50f-4a19-3f99-bc44-5a5deba196a5",
                        "source_sense_id": "1f544a0a-a0fc-31d3-8f73-b2d5e44aef35",
                        "target_lang_word": "elfess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elfess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d48a74a4-018a-3489-b2cf-c2b48286a6b4",
                                        "entry_id": "40483961-ed84-3bf1-96a5-a8875fb3a944",
                                        "glosses": [
                                            "A female elf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f25edc17-6dd8-4f2a-8820-81361733b4af",
                                                "sense_id": "d48a74a4-018a-3489-b2cf-c2b48286a6b4",
                                                "text": "Her case was heard, but no sentence pronounced; for each elf was dying of anxiety to claim her as his elfess."
                                            },
                                            {
                                                "example_id": "29a0a863-d8ef-4d53-b0d3-4c5d5d3a0024",
                                                "sense_id": "d48a74a4-018a-3489-b2cf-c2b48286a6b4",
                                                "text": "They were not mermaids, but almost like them. These water elfesses wore skirts of seaweed woven so that it looked like beautiful green cloth, and this covered their bodies, so that when they came ut^([sic]) of the water and sat on the shore their bodies did not show and no one saw they were like mermaids."
                                            },
                                            {
                                                "example_id": "56bdfaa3-14b0-4160-92c6-2d0b58c5d9be",
                                                "sense_id": "d48a74a4-018a-3489-b2cf-c2b48286a6b4",
                                                "text": "“What prophecy?” I asked, somewhat aggrieved because I remembered the one made by the old elfess that I was to be doomed by a cruel lie."
                                            },
                                            {
                                                "example_id": "f60a3420-af7e-4b35-a975-f06c9e9ac466",
                                                "sense_id": "d48a74a4-018a-3489-b2cf-c2b48286a6b4",
                                                "text": "“No! I mean their fathers were men, and their mothers were elfesses!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9e5542f-1d01-48a5-910d-7c800f6f9346",
                        "source_entry_id": "a957c50f-4a19-3f99-bc44-5a5deba196a5",
                        "source_sense_id": "1f544a0a-a0fc-31d3-8f73-b2d5e44aef35",
                        "target_lang_word": "elfette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elfette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69aeeb5b-82d2-39be-9cbe-3242fe16476d",
                                        "entry_id": "fa5f712c-b0d2-3321-920b-2a66180a225d",
                                        "glosses": [
                                            "A female elf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e900cf1a-f351-49b6-b7c0-6ea5ef7f8bd7",
                                                "sense_id": "69aeeb5b-82d2-39be-9cbe-3242fe16476d",
                                                "text": "For as the girls pass by in this very pure phase of their lives, flamingo-limbed with that articulation of the true elfette, I most sadly recall the fact that in every interview I've read every allu- meuse without exception has wanted one thing more than any other in life"
                                            },
                                            {
                                                "example_id": "f59d8dcd-77c0-41f2-9f72-1aeb3ddf5320",
                                                "sense_id": "69aeeb5b-82d2-39be-9cbe-3242fe16476d",
                                                "text": "At forty, after a bad illness, the Secretary of the Bank entangles himself with a girl - decidedly - of thirty-seven, half courted, half parried by him in letters of the most glucose baby talk. She is an elfette, an elfin art-adorer, who had been a little girl"
                                            },
                                            {
                                                "example_id": "019ea9f1-84c7-47aa-a526-a84046bab136",
                                                "sense_id": "69aeeb5b-82d2-39be-9cbe-3242fe16476d",
                                                "text": "An elfette wearing thigh garters and a derby and not much else took my order. People were packing into the place for the designer hamburgers and avant-garde soups and an array of purported Mexican food."
                                            },
                                            {
                                                "example_id": "4396dfbb-ff36-4818-b763-2903bc68defc",
                                                "sense_id": "69aeeb5b-82d2-39be-9cbe-3242fe16476d",
                                                "text": "I'd like to look in my stocking and find a shapely elfette eager to scrub me under a hot shower."
                                            },
                                            {
                                                "example_id": "34549a61-bb59-425c-9fb9-265df6864450",
                                                "sense_id": "69aeeb5b-82d2-39be-9cbe-3242fe16476d",
                                                "text": "I hardly wanted my elfette laid up for the rest of her stay."
                                            },
                                            {
                                                "example_id": "ade11b33-ba95-4675-9f4b-9beb0d911de6",
                                                "sense_id": "69aeeb5b-82d2-39be-9cbe-3242fe16476d",
                                                "text": "He reached for something generic and the elfette gave a little gasp"
                                            },
                                            {
                                                "example_id": "4e5f4973-7ee8-41f3-b674-0885fa85bc66",
                                                "sense_id": "69aeeb5b-82d2-39be-9cbe-3242fe16476d",
                                                "text": "Before I know it, my time with Santa is over, and the diminutive, green, elfette lady is lifting me down off Santa's expansive knees."
                                            },
                                            {
                                                "example_id": "06610bd9-9db3-43b4-a5b9-5f6e77f3b672",
                                                "sense_id": "69aeeb5b-82d2-39be-9cbe-3242fe16476d",
                                                "text": "Curator Rosemary Wells, Ph.D., of the Northwestern University Dental School, has collected over 500 tooth fairy figurines and portraits along with a library of books about the ethereal elfette."
                                            },
                                            {
                                                "example_id": "33f6a404-3227-4266-afa6-7fac43724bab",
                                                "sense_id": "69aeeb5b-82d2-39be-9cbe-3242fe16476d",
                                                "text": "Mom dropped me off at Liz's house for the final fitting of the elf costume and the make-up job. Liz told me that the costumes would be green because her elfette costume was really a pregnant leprechauness outfit that her older sister had used in a school play."
                                            },
                                            {
                                                "example_id": "f3ad9089-1e3a-452d-9afc-ad88a3544c1d",
                                                "sense_id": "69aeeb5b-82d2-39be-9cbe-3242fe16476d",
                                                "text": "the Elf who was now starting to resemble recently getting out of the shower elfette, and not clean and dry elfette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
