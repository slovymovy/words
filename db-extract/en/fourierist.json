                                "target_senses": [
                                    {
                                        "sense_id": "6e4f3a13-b7bd-3648-8441-cf86861ed753",
                                        "entry_id": "f08782cf-2e9c-3921-9184-2e319011dcce",
                                        "glosses": [
                                            "Relatif au fouriérisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab7b6048-4f66-4f69-95c5-0f0ae7193517",
                                                "sense_id": "6e4f3a13-b7bd-3648-8441-cf86861ed753",
                                                "text": "Aujourd’hui, on trouve des traces de l’utopie fouriériste dans le mouvement des SCOP (sociétés coopératives et participatives) comme dans le modèle du kibboutz en Israël ou les expériences locales qui surgissent ici ou là."
                                            },
                                            {
                                                "example_id": "e0954303-109f-442e-8070-1be0b6493911",
                                                "sense_id": "6e4f3a13-b7bd-3648-8441-cf86861ed753",
                                                "text": "Alix Payen est née Louise Alix Milliet, au Mans, le 18 mai 1842, dans une famille bourgeoise, républicaine et fouriériste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fouriériste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27e305a1-527d-3223-be95-0787644c3103",
                                        "entry_id": "6cbf00f1-fd56-39b2-9785-40fa6e9ae03e",
                                        "glosses": [
                                            "Partisan du fouriérisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee8becf6-ce6a-4e1e-80c3-2bc82bd43f27",
                                                "sense_id": "27e305a1-527d-3223-be95-0787644c3103",
                                                "text": "À un fouriériste ardennais qui constate une lutte des classes inéluctable, il répond : pas d'antagonisme sous le régime de la liberté économique, il y a intérêt pour les deux parties à se rencontrer pour discuter des salaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
