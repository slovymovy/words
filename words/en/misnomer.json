            "senses": [
                {
                    "sense_id": "cab0746c-ad52-3847-b195-894ed97c8ea1",
                    "sense_definition": "A wrong, unsuitable, or misleading name or term applied to someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Calling that tiny creature a killer whale is something of a <w>misnomer</w>."
                        },
                        {
                            "text": "The term funny bone is a <w>misnomer</w> because it is actually a nerve."
                        }
                    ],
                    "antonyms": [
                        "aptronym"
                    ],
                    "common_phrases": [
                        "bit of a misnomer",
                        "something of a misnomer",
                        "complete misnomer"
                    ]
                },
                {
                    "sense_id": "7fea01a1-d1ed-3acc-84c7-e53d97720554",
                    "sense_definition": "A formal mistake in naming or identifying a person or place, especially in legal documents.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court corrected the <w>misnomer</w> in the initial summons without dismissing the case."
                        },
                        {
                            "text": "A simple <w>misnomer</w> on the deed caused significant delays in completing the property transfer."
                        }
                    ]
                },
                {
                    "sense_id": "578746c2-6380-3947-8d4e-b2f5749c09b9",
                    "sense_definition": "A mistaken idea, misconception, or false belief.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a common <w>misnomer</w> that cold weather directly causes the flu."
                        },
                        {
                            "text": "She was quick to dispel the <w>misnomer</w> that introverts do not enjoy socializing."
                        }
                    ],
                    "common_phrases": [
                        "common misnomer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often considered an error for misconception or myth"
                        }
                    ]
                }
            ]
        },
        {
