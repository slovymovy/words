{
    "word_family": [
        "wurm",
        "gewurm",
        "wurmpje"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "63f0df7a-99cb-3d7e-84b7-ae653d7401ea",
                    "sense_definition": "Zich met moeite door een smalle opening of een menigte heen wringen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wringen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De reizigers moesten zich door de menigte <w>wurmen</w> om het perron te bereiken.",
                            "target_lang_translations": {
                                "en": "The travelers had to <w>squeeze</w> through the crowd to reach the platform."
                            }
                        },
                        {
                            "text": "Hij probeerde zich door de smalle opening te <w>wurmen</w>.",
                            "target_lang_translations": {
                                "en": "He tried to <w>wriggle</w> through the narrow opening."
                            }
                        }
                    ],
                    "synonyms": [
                        "wringen",
                        "wurmen",
                        "drringen",
                        "persen"
                    ],
                    "common_phrases": [
                        "zich door de menigte wurmen",
                        "zich door een opening wurmen"
                    ],
                    "target_lang_definitions": {
                        "en": "To squeeze or force oneself with difficulty through a narrow opening or a crowd."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squeeze",
                                "target_lang_sense_clarification": "through a crowd or narrow space"
                            },
                            {
                                "target_lang_word": "wriggle",
                                "target_lang_sense_clarification": "through a tight space"
                            },
                            {
                                "target_lang_word": "worm",
                                "target_lang_sense_clarification": "one's way through"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca9ad876-56e6-31f9-9d0a-1e74a6915663",
                    "sense_definition": "Zich voortbewegen met kronkelende, wormachtige bewegingen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kruipen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het insect bleef onrustig over de natte grond <w>wurmen</w>.",
                            "target_lang_translations": {
                                "en": "The insect kept <w>wriggling</w> restlessly across the wet ground."
                            }
                        },
                        {
                            "text": "De kleuter lag op de grond te <w>wurmen</w> om onder de bank te kijken.",
                            "target_lang_translations": {
                                "en": "The toddler was <w>squirming</w> on the floor to look under the couch."
                            }
                        }
                    ],
                    "synonyms": [
                        "kronkelen",
                        "kruipen"
                    ],
                    "common_phrases": [
                        "over de grond wurmen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move forward with wriggling, worm-like movements."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wriggle",
                                "target_lang_sense_clarification": "move with twisting motions"
                            },
                            {
                                "target_lang_word": "squirm",
                                "target_lang_sense_clarification": "move with writhing movements"
                            },
                            {
                                "target_lang_word": "crawl",
                                "target_lang_sense_clarification": "by wriggling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a195bfac-f5aa-3dd1-8085-28fa592c8daa",
                    "sense_definition": "Zich door kronkelende bewegingen uit een benarde positie of greep bevrijden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bevrijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gevangen kat wist zich uiteindelijk uit de greep te <w>wurmen</w>.",
                            "target_lang_translations": {
                                "en": "The trapped cat eventually managed to <w>wriggle out</w> of the grip."
                            }
                        },
                        {
                            "text": "Het lukte hem om zich uit de knellende touwen te <w>wurmen</w>.",
                            "target_lang_translations": {
                                "en": "He succeeded in <w>extricating himself</w> from the tight ropes."
                            }
                        }
                    ],
                    "synonyms": [
                        "loswringen",
                        "ontsnappen"
                    ],
                    "common_phrases": [
                        "zich uit de greep wurmen"
                    ],
                    "target_lang_definitions": {
                        "en": "To free oneself from a tight grip or difficult position through twisting and wriggling movements."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wriggle out",
                                "target_lang_sense_clarification": "of a grip or tight spot"
                            },
                            {
                                "target_lang_word": "extricate oneself",
                                "target_lang_sense_clarification": "by twisting and turning"
                            },
                            {
                                "target_lang_word": "squirm out",
                                "target_lang_sense_clarification": "of a physical hold"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dce232bb-76af-3ed0-a32c-de0eb03960b4",
                    "sense_definition": "Het meervoud van het zelfstandig naamwoord <w>wurm</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de zware regenval kropen er tientallen <w>wurmen</w> over het tuinpad.",
                            "target_lang_translations": {
                                "en": "After the heavy rainfall, dozens of <w>worms</w> crawled across the garden path."
                            }
                        },
                        {
                            "text": "De vogels zochten in het gras naar dikke <w>wurmen</w>.",
                            "target_lang_translations": {
                                "en": "The birds were looking for fat <w>worms</w> in the grass."
                            }
                        }
                    ],
                    "synonyms": [
                        "wormen"
                    ],
                    "target_lang_definitions": {
                        "en": "The plural form of the noun 'wurm' (worm, or a pitiful person/child)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "worms",
                                "target_lang_sense_clarification": "plural of worm"
                            },
                            {
                                "target_lang_word": "poor souls",
                                "target_lang_sense_clarification": "plural of wurm as a pitiful person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}