                        "form": "arabisante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2491a10e-808a-365c-8190-a727c3bb0cc0",
                        "entry_id": "2a65b061-3445-32ba-aa4f-40b11e527a7f",
                        "glosses": [
                            "Celui qui étudie la langue, l’histoire, la culture arabes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "468349cc-8b48-48ee-a9bf-73f0cf011001",
                                "sense_id": "2491a10e-808a-365c-8190-a727c3bb0cc0",
                                "text": "Ces monographies sont d'une grande valeur, et il serait à désirer que les arabisants compulsassent les riches matériaux qu'ils ont à leur disposition pour reconstituer, traitant chaque sujet à part, l'histoire de la culture orientale."
                            },
                            {
                                "example_id": "ed1c1f3d-6c4f-4864-a52c-70c0238787b9",
                                "sense_id": "2491a10e-808a-365c-8190-a727c3bb0cc0",
                                "text": "Sans être le moins du monde un arabisant, j’ai eu la bonne fortune de bénéficier pendant sept ans de l’enseignement de Philippe Marçais qui était, lui, un arabisant et un islamisant du premier ordre, et, ce qui ne gâtait rien, un ancien soldat et un bon ornithologue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec62291f-ddbd-43f1-b942-72fe61a71e93",
                        "source_entry_id": "2a65b061-3445-32ba-aa4f-40b11e527a7f",
                        "source_sense_id": "2491a10e-808a-365c-8190-a727c3bb0cc0",
                        "target_lang_word": "арабист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "арабист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9510891e-4018-33bf-b7bc-ba8b1d572940",
                                        "entry_id": "2aed0ccd-98a5-3312-96ef-0e9057975874",
                                        "glosses": [
                                            "учёный, специалист в области арабистики; тот, кто изучает язык, письменность, культуру и (или) историю арабов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "421bc023-9fee-4c5a-b558-e0992053bce1",
                                                "sense_id": "9510891e-4018-33bf-b7bc-ba8b1d572940",
                                                "text": "Помимо аккадского и ― с третьего курса ― шумерского, для ассириологов и арабистов был обязателен древнееврейский."
                                            },
                                            {
                                                "example_id": "2d820339-805d-4609-bf2e-1dcc60fa4db6",
                                                "sense_id": "9510891e-4018-33bf-b7bc-ba8b1d572940",
                                                "text": "По специальности он был арабист, и я хотел посоветоваться с ним, как лучше сделать перевод."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
