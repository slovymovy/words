{
    "word_family": [
        "knickknack"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "779c753b-c2f1-3e65-be9b-d8992c60901e",
                    "sense_definition": "A natural skill or talent for doing something easily and well.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a remarkable <w>knack</w> for remembering people's names after meeting them only once.",
                            "target_lang_translations": {
                                "ru": "У нее поразительный <w>дар</w> запоминать имена людей, встретив их всего один раз.",
                                "es": "Ella tiene un <w>don</w> extraordinario para recordar los nombres de las personas tras verlas solo una vez."
                            }
                        },
                        {
                            "text": "He has the <w>knack</w> of being in the right place at the right time during every game.",
                            "target_lang_translations": {
                                "ru": "У него есть <w>способность</w> оказываться в нужном месте в нужное время в каждой игре.",
                                "es": "Tiene la <w>gracia</w> de estar en el lugar adecuado en el momento oportuno en cada partido."
                            }
                        }
                    ],
                    "synonyms": [
                        "skill",
                        "facility",
                        "dexterity"
                    ],
                    "antonyms": [
                        "inability",
                        "clumsiness"
                    ],
                    "common_phrases": [
                        "knack of being",
                        "have a knack",
                        "knack for something"
                    ],
                    "target_lang_definitions": {
                        "ru": "Природное умение или талант делать что-либо легко и хорошо.",
                        "es": "Habilidad o talento natural para hacer algo de manera fácil y acertada."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дар",
                                "target_lang_sense_clarification": "природная способность"
                            },
                            {
                                "target_lang_word": "талант",
                                "target_lang_sense_clarification": "особая одаренность"
                            },
                            {
                                "target_lang_word": "способность",
                                "target_lang_sense_clarification": "умение что-то делать"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "don",
                                "target_lang_sense_clarification": "talento o habilidad innata"
                            },
                            {
                                "target_lang_word": "aptitud",
                                "target_lang_sense_clarification": "capacidad natural para hacer algo"
                            },
                            {
                                "target_lang_word": "gracia",
                                "target_lang_sense_clarification": "facilidad o soltura particular"
                            },
                            {
                                "target_lang_word": "mano",
                                "target_lang_sense_clarification": "habilidad o tacto para algo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01c543ca-efe9-38b0-a7fe-4fe6922b3f97",
                    "sense_definition": "A clever trick or a specific way of doing something that requires practice or dexterity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Opening this old jar is easy once you learn the <w>knack</w> of twisting it while pushing down.",
                            "target_lang_translations": {
                                "ru": "Открыть эту старую банку легко, как только вы освоите <w>сноровку</w>: нужно крутить ее, одновременно нажимая вниз.",
                                "es": "Abrir este frasco viejo es fácil una vez que le coges el <w>truco</w> de girarlo mientras presionas hacia abajo."
                            }
                        },
                        {
                            "text": "There is a certain <w>knack</w> to getting the engine started on cold winter mornings.",
                            "target_lang_translations": {
                                "ru": "Нужно определенное <w>умение</w>, чтобы завести двигатель холодным зимним утром.",
                                "es": "Hay que tener cierta <w>maña</w> para arrancar el motor en las mañanas frías de invierno."
                            }
                        }
                    ],
                    "synonyms": [
                        "trick",
                        "device"
                    ],
                    "common_phrases": [
                        "learn the knack",
                        "get the knack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умный прием или особый способ выполнения чего-либо, требующий практики или ловкости.",
                        "es": "Truco ingenioso o técnica específica para hacer algo que requiere práctica o destreza."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сноровка",
                                "target_lang_sense_clarification": "навык, приобретенный опытом"
                            },
                            {
                                "target_lang_word": "умение",
                                "target_lang_sense_clarification": "навык в деле"
                            },
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "особый прием"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "truco",
                                "target_lang_sense_clarification": "manera práctica o técnica de hacer algo"
                            },
                            {
                                "target_lang_word": "maña",
                                "target_lang_sense_clarification": "habilidad práctica o destreza aprendida"
                            },
                            {
                                "target_lang_word": "toque",
                                "target_lang_sense_clarification": "forma o punto clave para lograr algo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c10bc239-add3-3c44-8bab-ce3cb5088981",
                    "sense_definition": "A small, inexpensive ornament or a toy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shelf was cluttered with every little <w>knack</w> and souvenir she had collected over the years.",
                            "target_lang_translations": {
                                "ru": "Полка была завалена всякими мелкими <w>безделушками</w> и сувенирами, которые она собирала годами.",
                                "es": "La estantería estaba llena de cada pequeña <w>baratija</w> y recuerdo que había reunido a lo largo de los años."
                            }
                        },
                        {
                            "text": "He brought home a cheap <w>knack</w> from the fair to entertain the children for an hour.",
                            "target_lang_translations": {
                                "ru": "Он принес домой с ярмарки дешевую <w>игрушку</w>, чтобы развлечь детей на час.",
                                "es": "Trajo de la feria una <w>chuchería</w> barata a casa para entretener a los niños durante una hora."
                            }
                        }
                    ],
                    "synonyms": [
                        "plaything",
                        "knickknack",
                        "toy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English in this sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое недорогое украшение или игрушка.",
                        "es": "Adorno pequeño y poco costoso, o juguete de escaso valor."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безделушка",
                                "target_lang_sense_clarification": "мелкое украшение"
                            },
                            {
                                "target_lang_word": "пустяк",
                                "target_lang_sense_clarification": "незначительная вещь"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "baratija",
                                "target_lang_sense_clarification": "adorno u objeto de poco valor"
                            },
                            {
                                "target_lang_word": "chuchería",
                                "target_lang_sense_clarification": "objeto pequeño y de escasa importancia"
                            },
                            {
                                "target_lang_word": "chisme",
                                "target_lang_sense_clarification": "objeto menudo o trasto"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "88997dac-629d-37e0-bd21-ce06d2585025",
                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory listed several families with the last name <w>Knack</w> living in the valley.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике было указано несколько семей с фамилией <w>Кнак</w>, живущих в долине.",
                                "es": "La guía local enumeraba a varias familias con el apellido <w>Knack</w> que vivían en el valle."
                            }
                        },
                        {
                            "text": "Professor <w>Knack</w> published a groundbreaking study on historical linguistics last year.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Кнак</w> опубликовал в прошлом году новаторское исследование по исторической лингвистике.",
                                "es": "El profesor <w>Knack</w> publicó el año pasado un estudio pionero sobre lingüística histórica."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "es": "Apellido."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кнак",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Knack",
                                "target_lang_sense_clarification": "apellido"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e92c826-8c5b-3eca-af58-ebc193852dd1",
                    "sense_definition": "To make a sharp, cracking, or snapping sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry twigs would <w>knack</w> loudly under the weight of anyone walking through the woods.",
                            "target_lang_translations": {
                                "ru": "Сухие ветки громко <w>трещали</w> бы под тяжестью любого, кто идет через лес.",
                                "es": "Las ramas secas <w>crujían</w> con fuerza bajo el peso de cualquiera que caminara por el bosque."
                            }
                        },
                        {
                            "text": "If the wooden beads <w>knack</w> against each other, the sound echoes through the quiet hall.",
                            "target_lang_translations": {
                                "ru": "Если деревянные бусины <w>щелкают</w> друг о друга, звук эхом разносится по тихому залу.",
                                "es": "Si las cuentas de madera <w>chasquean</w> entre sí, el sonido resuena por toda la sala silenciosa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать резкий, трескающий или щелкающий звук.",
                        "es": "Hacer un sonido seco, parecido a un crujido o chasquido."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трещать",
                                "target_lang_sense_clarification": "издавать треск"
                            },
                            {
                                "target_lang_word": "щелкать",
                                "target_lang_sense_clarification": "издавать щелчок"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "crujir",
                                "target_lang_sense_clarification": "hacer un ruido seco al quebrarse o rozar"
                            },
                            {
                                "target_lang_word": "chasquear",
                                "target_lang_sense_clarification": "hacer un chasquido"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7383943f-2885-3ab9-b14b-6f65c19d2216",
                    "sense_definition": "To speak in an affected or overly formal manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>knack</w> his words in an attempt to sound more sophisticated than he actually was.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>манерничать</w>, пытаясь казаться более утонченным, чем был на самом деле.",
                                "es": "Empezó a <w>afectar</w> sus palabras en un intento de parecer más refinado de lo que realmente era."
                            }
                        },
                        {
                            "text": "The actor had to <w>knack</w> his speech to portray the pompous aristocrat in the play.",
                            "target_lang_translations": {
                                "ru": "Актеру пришлось <w>коверкать</w> свою речь, чтобы изобразить напыщенного аристократа в пьесе.",
                                "es": "El actor tuvo que <w>remilgar</w> su forma de hablar para representar al pomposo aristócrata en la obra."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "used in specific regional dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить манерно или чрезмерно официально.",
                        "es": "Hablar de forma afectada o excesivamente formal."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жеманиться",
                                "target_lang_sense_clarification": "говорить неестественно"
                            },
                            {
                                "target_lang_word": "манерничать",
                                "target_lang_sense_clarification": "в речи"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "afectar",
                                "target_lang_sense_clarification": "hablar con afectación o fingimiento"
                            },
                            {
                                "target_lang_word": "remilgarse",
                                "target_lang_sense_clarification": "mostrarse excesivamente delicado al hablar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}