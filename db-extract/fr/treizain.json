                "forms": [
                    {
                        "form_id": "02af861c-03e3-4009-b139-7888eca8cbda",
                        "entry_id": "f6fe1204-0bf8-33a0-b3d0-a16db117f262",
                        "tags": [
                            "plural"
                        ],
                        "form": "treizains"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d245b6f3-e5be-396b-820d-bfb876e6bee4",
                        "entry_id": "f6fe1204-0bf8-33a0-b3d0-a16db117f262",
                        "glosses": [
                            "Ensemble de treize (13) pièces de monnaie qui sont remises par le fiancé à sa fiancée lors de la cérémonie de mariage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "349b82f7-72d3-4ed8-8c67-47b609300bc5",
                                "sense_id": "d245b6f3-e5be-396b-820d-bfb876e6bee4",
                                "text": "À l’offrande, Germain mit, selon l’usage, le treizain, c’est-à-dire treize pièces d’argent, dans la main de sa fiancée."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b22ca53-7d16-3cf0-8912-3b99c75d75ba",
                        "entry_id": "f6fe1204-0bf8-33a0-b3d0-a16db117f262",
                        "glosses": [
                            "Ancienne monnaie du moyen âge qui valait 1/13^(ème) de livre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e3a59ba-c14c-4b4b-9bca-31c03375e093",
                                "sense_id": "1b22ca53-7d16-3cf0-8912-3b99c75d75ba",
                                "text": "… moyennant le payement d'un treizain tous les vingt ans, d'une cense annuelle d'un écu d'or, de trente sols tournois et de six chapons."
                            }
                        ]
                    },
                    {
                        "sense_id": "1785b01e-8469-33ca-94de-358fcbb15d25",
                        "entry_id": "f6fe1204-0bf8-33a0-b3d0-a16db117f262",
                        "glosses": [
                            "Poésie ou partie de poésie de treize vers. Cette forme de versification fixe, aurait été inventée par Catulle Mendès."
                        ],
                        "tags": [
                            "Versification"
                        ],
                        "examples": [
                            {
                                "example_id": "e7a8bf8d-87f6-4080-b3da-130ccbc0df3e",
                                "sense_id": "1785b01e-8469-33ca-94de-358fcbb15d25",
                                "text": "Dans la poésie de M. D.-V., nous relevons encore un treizain, sur la formule ( ababcdcdeefff ) composée de 6 rimes - deux quatrains croisés et deux rimes plates dont l'une est redoublée…."
                            }
                        ]
                    },
                    {
                        "sense_id": "20879a68-36d3-3ac2-90d2-b714823c1f34",
                        "entry_id": "f6fe1204-0bf8-33a0-b3d0-a16db117f262",
                        "glosses": [
                            "Chapelet de treize grains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "803c9d04-5208-4f5f-bf50-d6ca703efb62",
                                "sense_id": "20879a68-36d3-3ac2-90d2-b714823c1f34",
                                "text": "Sur un pilastre, bordant à gauche l'entrée d'un jardin à murs crénelés, a été sculpté un très curieux chapelet droit, terminé par une houppe et composé de treize grains, ce qui constitue un treizain ; les grains sont séparés par une marque suivant le style des inventaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d2e4717-5c9c-339a-a635-b25925290d8d",
                        "entry_id": "f6fe1204-0bf8-33a0-b3d0-a16db117f262",
                        "glosses": [
                            "Taxe, droit ancien prélevé sur diverses marchandises et qui représentait 1/13^(ème) de la valeur des marchandises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4af8ab27-a555-48c5-85bc-ef651e961291",
                                "sense_id": "2d2e4717-5c9c-339a-a635-b25925290d8d",
                                "text": "Dans ce cas, un treizain ou le treizième denier pouvait être levé sur les bois, pierres, chaux, roux et écorce ainsi vendus, et sur les mêmes objets amenés du dehors ; …."
                            },
                            {
                                "example_id": "c28f94b6-eca3-4089-b19d-aac914d1f691",
                                "sense_id": "2d2e4717-5c9c-339a-a635-b25925290d8d",
                                "text": "…mais comme elle ne scaurait sic) trouver un fonds pour leur entretien, aultre (sic) que celui d'un treizain qui se prend sur le vin que débitent les hôtes et cabaretiers dans la ville, …."
                            }
                        ]
                    }
                ],
