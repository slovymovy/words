                        "glosses": [
                            "water dat boven de grondwaterspiegel in de grond zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6714bf83-b9e8-4657-9f26-1706dad0aac5",
                                "sense_id": "81c4e705-b0eb-3f05-88b3-7c56f3df379a",
                                "text": "Behalve verontreiniging van het bodemwater is er onder meer risico op het achterlaten van chemicaliën in de bodem, aardbevingen en het vrijkomen van methaan, weet Vitens."
                            },
                            {
                                "example_id": "4a23b6b6-6fb5-4bd1-98c2-4b1a5e5b07dd",
                                "sense_id": "81c4e705-b0eb-3f05-88b3-7c56f3df379a",
                                "text": "Omdat alleen naar het oppervlaktewater is gekeken, kan volgens de zegsvrouw nog niks worden gezegd over mogelijke vervuiling van het grond- of bodemwater. Dat is volgens haar een zaak van de gemeente."
                            }
                        ]
