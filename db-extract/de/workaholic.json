                        "glosses": [
                            "Person, die übermäßig viel arbeitet; jemand, der an Arbeitssucht leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a89f54a3-205d-4c7f-b8bc-1528641f293a",
                                "sense_id": "2344baad-1565-3e1c-aba9-2a853e964bbc",
                                "text": "Udo ist ein richtiger Workaholic. Er arbeitet auch am Wochenende oft bis in die Nacht hinein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
