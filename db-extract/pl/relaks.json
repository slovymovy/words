                                        "glosses": [
                                            "Remission of attention or application."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ce0c6ce-9f7b-4a4e-ad88-a7c04dc26e7b",
                                                "sense_id": "d8d71763-9820-3046-b91c-9d96af5d3830",
                                                "text": "relaxation of efforts"
                                            },
                                            {
                                                "example_id": "bb4cff01-ee0e-4f48-a17a-eca25abc2838",
                                                "sense_id": "d8d71763-9820-3046-b91c-9d96af5d3830",
                                                "text": "It may seem as though the safer sex message gets overplayed, stressed too much; it may have even become tired. Nonetheless, it has become evident that to abandon that message now would create complacency among people at risk for HIV infection. The end result would be a relaxation of life-saving techniques. We would be faced with a new generation of individuals testing antibody positive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acc5e1b4-aa44-35b2-969c-25dca2658333",
                                        "entry_id": "f475c173-7bf1-35b7-b7e2-1f9f387405f8",
                                        "glosses": [
                                            "Unbending; recreation; a state or occupation intended to give mental or bodily relief after effort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1443df5c-c588-30a3-9d36-1ecf92959f84",
                                        "entry_id": "f475c173-7bf1-35b7-b7e2-1f9f387405f8",
                                        "glosses": [
                                            "The transition of a nucleus, atom or molecule from a higher energy level to a lower one; the opposite of excitation"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
