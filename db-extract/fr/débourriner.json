                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69177146-56c2-434e-94a2-c4b362e88e90",
                                "sense_id": "164eda9d-9a5e-3cf3-8a32-3fe9e3786342",
                                "text": "Je vais tâcher de faire une recharge de gaz avant de débourriner la moitié de mon TBD !"
                            },
                            {
                                "example_id": "5f9aa1ce-8f40-4b74-b625-89f0b6b3a697",
                                "sense_id": "164eda9d-9a5e-3cf3-8a32-3fe9e3786342",
                                "text": "une fois que la mayonnaise a pris on commence à débourriner, ce qui risque d'être nécessaire pour quand il y aura beaucoup de monde à se partager les ressources électriques, et va prendre un peu de temps"
                            },
                            {
                                "example_id": "ef7659a0-d561-4217-8e2d-3d54a81b3c63",
                                "sense_id": "164eda9d-9a5e-3cf3-8a32-3fe9e3786342",
                                "text": "Apporter de la finesse, de la précision dans sa pratique martiale, « débourriner », tout en restant simple et pragmatique... une belle idée !"
                            },
                            {
                                "example_id": "b5a77fb3-62a6-4c0e-8d92-afa33d4773bc",
                                "sense_id": "164eda9d-9a5e-3cf3-8a32-3fe9e3786342",
                                "text": "Je vais installer de l'extra light sur la sèche pour me débourriner les doigts et du 10 / quelque chose sur la LP."
                            }
                        ]
