                                "example_id": "1a79e2ae-b318-4c8c-8491-0344c35ae21c",
                                "sense_id": "8a6c18e2-b01c-3e2d-b477-91f544fab1de",
                                "text": "„Die USA verstärken ihre Militärpräsenz am Persischen Golf und ziehen Diplomaten aus dem Irak ab.“"
                            },
