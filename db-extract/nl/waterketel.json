                                "target_senses": [
                                    {
                                        "sense_id": "8bf312f6-3b24-3fae-99c2-eb010468fd74",
                                        "entry_id": "bdc416a9-8d1e-3dba-8b2c-f581c3be0e13",
                                        "glosses": [
                                            "To contain demonstrators in a confined area."
                                        ],
                                        "tags": [
                                            "of the police"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d68d3a7-19a7-46c6-b25e-08434ba23531",
                                                "sense_id": "8bf312f6-3b24-3fae-99c2-eb010468fd74",
                                                "text": "Life for senior officers has been made much easier by the use of counter-terrorism powers, which enable them to contain demonstrators for hours in a confined spot. This tactic, known as kettling, is seen by some as an attempt to prevent people lawfully demonstrating."
                                            },
                                            {
                                                "example_id": "edca5169-43ef-4bc4-8332-e83a5d71b820",
                                                "sense_id": "8bf312f6-3b24-3fae-99c2-eb010468fd74",
                                                "text": "A couple of the initial pepper spray incidents went viral on YouTube, one showing very young women screaming hysterically while penned—or is the term for this ‘kettled’?—by bright orange police mesh."
                                            }
                                        ]
                                    },
