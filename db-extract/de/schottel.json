                "senses": [
                    {
                        "sense_id": "b80dfed7-9c9a-3795-ac1e-4b5867f08e97",
                        "entry_id": "b2eb2be6-9858-35bb-9f0b-923af5f70d0e",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5c4d4b6-93c1-4961-9ba1-6e4ebf6429c8",
                                "sense_id": "b80dfed7-9c9a-3795-ac1e-4b5867f08e97",
                                "text": "Frau Schottel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8998321a-b0f9-4450-9f67-29aba3d9c7b6",
                                "sense_id": "b80dfed7-9c9a-3795-ac1e-4b5867f08e97",
                                "text": "Herr Schottel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "75380dcc-6400-4adc-a82d-9fb0759e6d10",
                                "sense_id": "b80dfed7-9c9a-3795-ac1e-4b5867f08e97",
                                "text": "Die Schottels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "85f0b67c-5a43-49e3-bc8f-6e850b4c3674",
                                "sense_id": "b80dfed7-9c9a-3795-ac1e-4b5867f08e97",
                                "text": "Der Schottel trägt nie die Schals, die die Schottel ihm strickt."
                            },
                            {
                                "example_id": "fdf8eb6b-a147-41c1-b577-5855aa1d558d",
                                "sense_id": "b80dfed7-9c9a-3795-ac1e-4b5867f08e97",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schottel kommt, geht der Herr Schottel.“"
                            },
                            {
                                "example_id": "c33fd2b3-519e-43ad-b0c5-0fbf17cf7ebf",
                                "sense_id": "b80dfed7-9c9a-3795-ac1e-4b5867f08e97",
                                "text": "Schottel kommt und geht."
                            },
                            {
                                "example_id": "1269a313-aaa1-4db0-9ab2-85caeb087b49",
                                "sense_id": "b80dfed7-9c9a-3795-ac1e-4b5867f08e97",
                                "text": "Schottels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
