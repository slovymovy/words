                        "entry_id": "310653fc-1369-306b-878d-b155172f90bd",
                        "glosses": [
                            "Ustensile permettant de prélever le zeste d’un agrume."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7082f3f-8d2a-4a0c-9e86-9609ebe2d72a",
                                "sense_id": "68cef259-a40b-3217-be3f-3acb1109efc7",
                                "text": "Économe, zesteur, épluche-pomme… il existe aujourd'hui sur le marché mille et un accessoires utiles (et parfois moins utiles !) pour récupérer facilement ces précieuses épluchures."
                            },
                            {
                                "example_id": "d006476f-2a2f-498c-b5d5-2a559320f350",
                                "sense_id": "68cef259-a40b-3217-be3f-3acb1109efc7",
                                "text": "Prélevez le zeste du citron avec une micro-râpe ou un zesteur."
                            }
                        ]
                    }
