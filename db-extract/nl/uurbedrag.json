                "senses": [
                    {
                        "sense_id": "f920e244-c968-3f2e-9fc1-6a4dece323f5",
                        "entry_id": "674f9d57-eb11-3a94-be64-c77f6a3ec64d",
                        "glosses": [
                            "een hoeveelheid geld die je per uur betaalt (voor werk of gebruik van iets)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee2b702d-709b-4415-828e-62fea8b8fb39",
                                "sense_id": "f920e244-c968-3f2e-9fc1-6a4dece323f5",
                                "text": "„Laat de kandidaat zijn eigen reïntegratie verdienen door tijdelijk te werken met behoud van uitkering. De werkgever betaalt ons een vriendelijk uurbedrag, waarmee we kandidaten en werkgevers begeleiden, scholen en coachen. De kandidaat moet zich kunnen ontwikkelen tot een volwaardige arbeidskracht die z’n eigen salaris kan verdienen.”"
                            },
                            {
                                "example_id": "2e25c790-8058-4802-a464-ce6d421b555f",
                                "sense_id": "f920e244-c968-3f2e-9fc1-6a4dece323f5",
                                "text": "De meeste ouders zullen iets meer kinderopvangtoeslag ontvangen omdat de uurbedragen zijn gecorrigeerd voor inflatie. Voor dagopvang krijg je toeslag op basis van een maximaal uurtarief van €6,84, bij buitenschoolse opvang is dit €6,38 en voor gastouderopvang €5,48. Ben je per uur meer kwijt, dan krijg je daarvoor geen toeslag."
                            },
                            {
                                "example_id": "862dceab-bac0-4e03-a179-0d85940a1d1a",
                                "sense_id": "f920e244-c968-3f2e-9fc1-6a4dece323f5",
                                "text": "In het geding eiste het Zelhemse bedrijf Globe ongeveer 40.000 euro van Melchers. Na de ontvoering van zijn dochter Claudia op 12 september vroeg Melchers Globe om beveiliging van zijn familie. Beide partijen spraken een uurbedrag af. Een factuur kwam op verzoek van Melchers’ advocaat pas op 1 december."
                            },
                            {
                                "example_id": "94cf2841-5e94-4ee3-8007-361d40c80648",
                                "sense_id": "f920e244-c968-3f2e-9fc1-6a4dece323f5",
                                "text": "De Centrale Ondernemingsraad Amsterdam (COR) schreef onlangs in een brief aan de gemeenteraad dat er te veel „externe adviseurs met hoge uurbedragen” worden ingezet."
                            }
                        ]
                    }
