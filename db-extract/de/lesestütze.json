                "senses": [
                    {
                        "sense_id": "6d4a4dd3-dd3a-371a-9150-d0034e143901",
                        "entry_id": "6fb3814e-0ea7-3871-8b6d-960cb8b48657",
                        "glosses": [
                            "Auflage, um ein Buch oder eine Zeitschrift beim Lesen offen zu halten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90fd42dc-1ce9-4b29-94eb-8357c4872bc9",
                                "sense_id": "6d4a4dd3-dd3a-371a-9150-d0034e143901",
                                "text": "Die Lesestütze neben dem PC half ihr dabei, das Manuskript an einem einzigen Abend in Reinschrift zu überführen."
                            },
                            {
                                "example_id": "858dbe86-8817-4cb1-b5db-eeca29a7c77a",
                                "sense_id": "6d4a4dd3-dd3a-371a-9150-d0034e143901",
                                "text": "„Der Mann auf dem Kupferstich schreibt druckreif mit der Hand. Nach links geht sein Blick auf einen geöffneten Band, schräg gestellt mit der Lesestütze.“"
                            },
                            {
                                "example_id": "698936b8-ff4c-4061-86fa-c39a067fd3b4",
                                "sense_id": "6d4a4dd3-dd3a-371a-9150-d0034e143901",
                                "text": "„Der Verlag hätte gleich eine Lesestütze mitliefern sollen. Denn der Wälzer biblischen Ausmaßes – immerhin 1.320 Seiten – liest sich nunmal nicht in einigen Tagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
