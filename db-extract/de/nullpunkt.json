                    },
                    {
                        "form_id": "31153e7c-7669-4063-b1be-8c4ecde0731a",
                        "entry_id": "4976f7f8-f69c-3a5e-ad1b-b3defca76d22",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nullpunkte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c266ef64-cd26-33b1-adc5-03980f0b87be",
                        "entry_id": "4976f7f8-f69c-3a5e-ad1b-b3defca76d22",
                        "glosses": [
                            "die Stelle auf einer Skale, die den Wert Null darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dc4ae43-964b-4926-84b9-e4d9f6fe2beb",
                                "sense_id": "c266ef64-cd26-33b1-adc5-03980f0b87be",
                                "text": "„Der Schmelzpunkt des Eises, 273,15 K, ist der Nullpunkt der Celsius-Temperaturskale.“"
                            },
                            {
                                "example_id": "989fcde8-c88d-4eb2-9658-3abd945d3035",
                                "sense_id": "c266ef64-cd26-33b1-adc5-03980f0b87be",
                                "text": "„Die dort agierenden Quantenbits, die ‚Qubits‘ genannt wurden, agierten bei einer Temperatur von rund -273 Grad Celsius, also nahe dem absoluten Nullpunkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b73b04a7-0b89-3ddc-a46a-95ea7309aed2",
                        "entry_id": "4976f7f8-f69c-3a5e-ad1b-b3defca76d22",
                        "glosses": [
                            "Tiefpunkt einer Entwicklung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0c6023e-0940-454a-897c-b79f7db8d8a9",
                                "sense_id": "b73b04a7-0b89-3ddc-a46a-95ea7309aed2",
                                "text": "„Mein Leben war also an einem Nullpunkt angekommen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "565f0fb2-3fbe-3bdd-86ad-31c237d28ec8",
                        "entry_id": "4976f7f8-f69c-3a5e-ad1b-b3defca76d22",
                        "glosses": [
                            "Anfangspunkt, von dem aus gemessen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8e12ae2-5793-4015-8191-78cf050f3281",
                                "sense_id": "565f0fb2-3fbe-3bdd-86ad-31c237d28ec8",
                                "text": "„Die Säule ist der Nullpunkt der Kilometer-Zählung der von München ausgehenden Straßen.“"
                            },
                            {
                                "example_id": "80f1ec1c-4799-4f40-9c6c-2727cbd4b65e",
                                "sense_id": "565f0fb2-3fbe-3bdd-86ad-31c237d28ec8",
                                "text": "„Die Bezugnahme auf zwei durch die Angabe der Entfernung vom Nullpunkt der Forststraße in Hektometer (hm) genau bestimmte und in dem im Akt erliegenden Plan eingezeichnete Punkte der Straße stellt eine ausreichende örtliche Präzisierung dar […].“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "df5cd635-d5f5-360f-8778-20ffb426471a",
                        "entry_id": "4976f7f8-f69c-3a5e-ad1b-b3defca76d22",
                        "glosses": [
                            "Ursprung eines Koordinatensystems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e24ac18-0db3-4cc2-a81e-32a5947009ff",
                                "sense_id": "df5cd635-d5f5-360f-8778-20ffb426471a",
                                "text": "„Den Schnittpunkt der beiden Achsen nennt man Koordinatenursprung oder Nullpunkt.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
