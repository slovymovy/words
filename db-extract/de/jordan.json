                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f566435-416a-4c85-bcf7-0ed7f19b7069",
                                                "sense_id": "5c61921e-4e2b-39cf-b1f3-bff17893c6c4",
                                                "text": "Early the next morning I met with King Hussein of Jordan and then drove to the airport with the shah. All three of us agreed that we ought to give Sadat our support, and on the basis for a Middle East peace."
                                            },
                                            {
                                                "example_id": "75a1d2ab-60e4-4070-8eb1-1481e6fa5c56",
                                                "sense_id": "5c61921e-4e2b-39cf-b1f3-bff17893c6c4",
                                                "text": "Ghamr and Baqura became part of Jordan after the country gained independence from Britain in 1946. The areas were later seized by Israel but eventually incorporated into a peace treaty between the two countries in 1994. The treaty included a long-term lease that would allow Israeli farmers to cultivate the land."
                                            }
                                        ]
