                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db128b5-dff3-4c33-975a-e0136aed7626",
                                "sense_id": "f363da59-45e3-336e-825a-ef6bbf6fd20b",
                                "text": "Elle aura une vision globale et prendra conscience d’elle en tant que « force cosmique », pensée vivante capable de s’autostructurer."
                            },
                            {
                                "example_id": "72edf297-94ed-4b01-9833-eef5bdb0ba48",
                                "sense_id": "f363da59-45e3-336e-825a-ef6bbf6fd20b",
                                "text": "On peut également dire que la matière a tendance à s’autostructurer en réponse à une sollicitation externe, les avalanches de grains, lorsque le tas grandit."
                            }
