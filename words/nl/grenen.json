{
    "word_family": [
        "grenenhout"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "df2f6336-3754-3ecd-8aaa-fa24e7b0880a",
                    "sense_definition": "gemaakt van het hout van de grove den of andere pinussoorten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "materiaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de woonkamer staat een grote <w>grenen</w> eettafel die al jaren in de familie is.",
                            "target_lang_translations": {
                                "en": "In the living room stands a large <w>pine</w> dining table that has been in the family for years."
                            }
                        },
                        {
                            "text": "Zij hebben gekozen voor een <w>grenen</w> kast omdat dat hout een warme uitstraling heeft.",
                            "target_lang_translations": {
                                "en": "They chose a <w>pine</w> cabinet because that wood has a warm appearance."
                            }
                        }
                    ],
                    "synonyms": [
                        "grenenhouten",
                        "dennenhouten",
                        "pijnboomhouten"
                    ],
                    "common_phrases": [
                        "grenen meubels",
                        "grenen tafel",
                        "massief grenen"
                    ],
                    "target_lang_definitions": {
                        "en": "made from the wood of the Scots pine or other pine species"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pine",
                                "target_lang_sense_clarification": "referring to the material/wood"
                            },
                            {
                                "target_lang_word": "made of pine",
                                "target_lang_sense_clarification": "describing furniture or objects"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8a19e3d-8274-358c-8011-f6af8274b7a2",
                    "sense_definition": "meervoud van <w>green</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plantkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit bos staan verschillende soorten <w>grenen</w> die al heel oud zijn.",
                            "target_lang_translations": {
                                "en": "In this forest, there are various types of <w>pines</w> that are already very old."
                            }
                        },
                        {
                            "text": "De boswachter wees naar de <w>grenen</w> en legde uit hoe ze groeien.",
                            "target_lang_translations": {
                                "en": "The forest ranger pointed to the <w>pines</w> and explained how they grow."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of 'green' (Scots pine tree)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pines",
                                "target_lang_sense_clarification": "plural of the tree species"
                            },
                            {
                                "target_lang_word": "Scots pines",
                                "target_lang_sense_clarification": "specific tree species"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f092f06-ed8f-358f-95db-5a26043f7f8e",
                    "sense_definition": "meervoud verleden tijd van <w>grijnen</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen <w>grenen</w> van plezier toen ze het goede nieuws hoorden.",
                            "target_lang_translations": {
                                "en": "The children <w>grinned</w> with pleasure when they heard the good news."
                            }
                        },
                        {
                            "text": "Zij <w>grenen</w> breeduit naar de camera tijdens het maken van de groepsfoto.",
                            "target_lang_translations": {
                                "en": "They <w>grinned</w> broadly at the camera while taking the group photo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural past tense of 'grijnen' (to grin or sneer)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grinned",
                                "target_lang_sense_clarification": "past tense of smiling broadly"
                            },
                            {
                                "target_lang_word": "sneered",
                                "target_lang_sense_clarification": "past tense of a mocking smile"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}