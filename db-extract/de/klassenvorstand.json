                "senses": [
                    {
                        "sense_id": "d50b8e9c-973a-35fd-806c-6694b5b34e12",
                        "entry_id": "bc26b41e-75f9-3a36-b5f3-59bc182d65d3",
                        "glosses": [
                            "Klassenleiter in Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f20039-79f0-40d4-bdd9-591c16d2ddbf",
                                "sense_id": "d50b8e9c-973a-35fd-806c-6694b5b34e12",
                                "text": "„In dem angeschlossenen Bericht legt Herr K dar, dass er Klassenvorstand einer reinen Bubenklasse sei, in der sich zwei sehr problematische Schüler befänden.“"
                            },
                            {
                                "example_id": "52ebc2bd-af16-4f73-a14e-78214dd24413",
                                "sense_id": "d50b8e9c-973a-35fd-806c-6694b5b34e12",
                                "text": "„Danach wirkte er am Melker Stiftgymnasium (1815 Klassenvorstand von Eligius Joseph Reichsfreiherr von Münch-Bellinghausen [Friedrich Halm]).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
