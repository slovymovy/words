                ],
                "senses": [
                    {
                        "sense_id": "1923817b-5046-3a16-97c4-71a0df9b7c1d",
                        "entry_id": "eb9dad1f-867f-320a-a2e5-7d3e0348e581",
                        "glosses": [
                            "Organisator eines Marathonlaufs; Institution/Organisation beziehungsweise Einzelperson, die einen Marathon plant, organisiert und durchführt"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "92843894-f177-476f-94c3-78be9f84a861",
                                "sense_id": "1923817b-5046-3a16-97c4-71a0df9b7c1d",
                                "text": "„Wegen fehlender Umweltfreundlichkeit, oder dringlicher: Menschenfreundlichkeit, musste sich bis vor Kurzem kein Marathonausrichter erklären.“"
                            },
                            {
                                "example_id": "3fdc17b0-2c65-4805-8ced-7343bf3f83df",
                                "sense_id": "1923817b-5046-3a16-97c4-71a0df9b7c1d",
                                "text": "„Sein Arbeitgeber und Marathonausrichter, die Deutsche Post, spendete für jeden von Schawels gelaufenen Kilometern 100 Euro, die dem Bonner Sport zugutekommen sollen.“"
                            },
                            {
                                "example_id": "a07bcaa4-bb6e-451c-acd7-9c61a80a7a37",
                                "sense_id": "1923817b-5046-3a16-97c4-71a0df9b7c1d",
                                "text": "„\"Dass Marathonausrichter deshalb ihre internationalen Veranstaltungen in ein Stadion verlegen, ist unwahrscheinlich\", ätzt Gradwohl.“"
                            },
                            {
                                "example_id": "4d3aa603-544e-4a5b-852a-e52f574a0529",
                                "sense_id": "1923817b-5046-3a16-97c4-71a0df9b7c1d",
                                "text": "„Dazu bin ich auch noch in der glücklichen Situation, dass wir hier im Umkreis von 20-60km vier Marathonausrichter/sammler haben, die zusammengezählt quasi jedes Woche etwas anbieten.“"
                            },
                            {
                                "example_id": "7743d5d4-b6f1-46c5-a65f-900d470fe72d",
                                "sense_id": "1923817b-5046-3a16-97c4-71a0df9b7c1d",
                                "text": "„Unterstützt wird die VHS durch die Marathon-Ausrichter der Leichtathletik-Abteilung des VfB 1910 Salzkotten, das Gesundheitsnetzwerk Praenet, die Lauftherapie Salzkotten sowie die Stadtbibliothek, um die Teilnehmenden zu gesundem Laufen zu befähigen und den Spaß zu fördern.“"
                            },
                            {
                                "example_id": "8c17b04f-b2b0-4a28-ab57-6a368fdbc120",
                                "sense_id": "1923817b-5046-3a16-97c4-71a0df9b7c1d",
                                "text": "„Zudem ist bekannt geworden, dass vertraglich mit dem Marathon-Ausrichter verbundene Reiseveranstalter die begehrten Startplätze mit einem Aufschlag verkaufen wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
