                        "examples": [
                            {
                                "example_id": "698e7057-a8e6-47a5-964c-5be0f4d11f61",
                                "sense_id": "09083187-4178-3bb7-a105-60b4d2329b46",
                                "text": "Elle s’est éclipsée ; elle est revenue, tiède et savonneuse ; puis, toute fraîche, la figure rosissante, essuyant des gouttelettes d’eau."
                            },
                            {
                                "example_id": "75bdd93b-f865-40b9-a067-132b37ddb035",
                                "sense_id": "09083187-4178-3bb7-a105-60b4d2329b46",
                                "text": "J’ai pourchassé les feux. Et pensé à ce que pensent les goélands de mer dans le ciel rosissant."
                            }
                        ]
                    }
