                "forms": [],
                "senses": [
                    {
                        "sense_id": "e7ef9e83-000b-3732-b47b-5b6b7c08808d",
                        "entry_id": "33586c17-c547-319c-bdaf-988c7cf0b7af",
                        "glosses": [
                            "een vloeistof die bij dieren door de nieren wordt geproduceerd en periodiek wordt geloosd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb148a64-4f45-4e99-9734-010a16658bb5",
                                "sense_id": "e7ef9e83-000b-3732-b47b-5b6b7c08808d",
                                "text": "De geur van urine is duidelijk herkenbaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98b40b94-5e5c-4606-9eb4-601717118907",
                        "source_entry_id": "33586c17-c547-319c-bdaf-988c7cf0b7af",
                        "source_sense_id": "e7ef9e83-000b-3732-b47b-5b6b7c08808d",
                        "source_sense_description": "een vloeistof die bij dieren door de nieren wordt geproduceerd en periodiek wordt geloosd",
                        "target_lang_word": "Urin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89ca4690-bf10-3b1c-8311-e8cb28509939",
                                        "entry_id": "d78aeec8-c1c5-35c8-a73a-7baab96ffe16",
                                        "glosses": [
                                            "flüssige Ausscheidung der Blase beziehungsweise der Nieren bei Menschen und verwandten Säugetieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3837b3-24bd-4b9c-9e0c-2852649b5641",
                                                "sense_id": "89ca4690-bf10-3b1c-8311-e8cb28509939",
                                                "text": "Die Gewinnung von Arzneien aus menschlichem Urin unterliegt strengen Vorschriften."
                                            },
                                            {
                                                "example_id": "09e94e19-1dfa-409e-9583-3b8a51dedd12",
                                                "sense_id": "89ca4690-bf10-3b1c-8311-e8cb28509939",
                                                "text": "„Die gemeinen und niedrigen Sprecharten haben eine Menge anderer Ausdrücke, den Urin und das Lassen desselben zu bezeichnen, die ich hier nicht anführen mag.“"
                                            },
                                            {
                                                "example_id": "88f7ce61-054b-4b4a-856f-2cb93cc09ccc",
                                                "sense_id": "89ca4690-bf10-3b1c-8311-e8cb28509939",
                                                "text": "„Mit einem Mal roch es nach Urin, und ein nasser Fleck zeigte sich auf der Hose des Jungen.“"
                                            },
                                            {
                                                "example_id": "3405d2cf-fb77-4545-ab94-e9a59a21f89d",
                                                "sense_id": "89ca4690-bf10-3b1c-8311-e8cb28509939",
                                                "text": "„Die Eisentore vor den langen feuchten Gassen, die nach Urin riechen, sind verschlossen.“"
                                            },
                                            {
                                                "example_id": "c38bf0ac-8d2f-4bdd-8459-3b713d65aede",
                                                "sense_id": "89ca4690-bf10-3b1c-8311-e8cb28509939",
                                                "text": "„Starr vor Angst blieb er die ganze Nacht über in seinem Urin liegen, wusste ja, was einem Bettnässer passierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7eadac99-acd9-4cad-b4d6-ad45b775e773",
                        "source_entry_id": "33586c17-c547-319c-bdaf-988c7cf0b7af",
                        "source_sense_id": "e7ef9e83-000b-3732-b47b-5b6b7c08808d",
                        "source_sense_description": "een vloeistof die bij dieren door de nieren wordt geproduceerd en periodiek wordt geloosd",
                        "target_lang_word": "urine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "133ed1ab-0754-325d-8ad8-6fd8d79ea674",
                                        "entry_id": "1b1c337d-dcf2-3e32-ad33-96bbb95fa585",
                                        "glosses": [
                                            "Liquid waste consisting of water, salts, and urea, which is made in the kidneys, stored in the bladder, then released through the urethra."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36702806-4a98-476b-8457-86c940a6bdcf",
                                                "sense_id": "133ed1ab-0754-325d-8ad8-6fd8d79ea674",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "urine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84e624a5-d5d8-38ed-a713-8f7ccee248d3",
                                        "entry_id": "47b5eac8-73c9-3c1d-86ae-9209f6cc0d0f",
                                        "glosses": [
                                            "To urinate."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e734bcc-a244-4f9b-a4e8-76632371d859",
                                                "sense_id": "84e624a5-d5d8-38ed-a713-8f7ccee248d3",
                                                "text": "He got out of bed every time he urined, or tried to urine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "000c0d42-0c71-413c-9d70-53111ebe637c",
                        "source_entry_id": "33586c17-c547-319c-bdaf-988c7cf0b7af",
                        "source_sense_id": "e7ef9e83-000b-3732-b47b-5b6b7c08808d",
                        "source_sense_description": "een vloeistof die bij dieren door de nieren wordt geproduceerd en periodiek wordt geloosd",
                        "target_lang_word": "urine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec052b18-6c6c-3cfa-b9bf-6b0cd80bbbb4",
                                        "entry_id": "e028cbb0-84d6-371e-9515-41a571609624",
                                        "glosses": [
                                            "Liquide dû à la filtration du sang par les reins et conduit par les uretères dans la vessie, puis évacué par le canal de l’urètre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fa32b59-b8de-4097-bccd-bb3513adaec7",
                                                "sense_id": "ec052b18-6c6c-3cfa-b9bf-6b0cd80bbbb4",
                                                "text": "Il leur suffisait […] de passer la main sur le dos d’une vache pour que le lait tournât en urine."
                                            },
                                            {
                                                "example_id": "512f0436-07c0-4037-bebb-d4f88134206d",
                                                "sense_id": "ec052b18-6c6c-3cfa-b9bf-6b0cd80bbbb4",
                                                "text": "La sérine du sang ressemble beaucoup à l’albumine de l’œuf; elle constitue également l’albumine pathologique des urines."
                                            },
                                            {
                                                "example_id": "6bd29e33-edfc-430a-b837-1836ff181fa4",
                                                "sense_id": "ec052b18-6c6c-3cfa-b9bf-6b0cd80bbbb4",
                                                "text": "La belle chambre sent l’écurie. Michel-Charles s’est laissé dire par son cocher que l’urine de cheval était un remède souverain contre les rhumatismes. Il a fait mettre sous son lit un grand bassin plein de ce liquide ammoniaqué, et de temps en temps, presque subrepticement, y trempe son bras droit douloureux et ankylosé."
                                            },
                                            {
                                                "example_id": "82af3054-2f6e-427f-983f-c1e4992357a9",
                                                "sense_id": "ec052b18-6c6c-3cfa-b9bf-6b0cd80bbbb4",
                                                "text": "Ces substances (substances toxiques du sang et urée), additionnées d’eau et filtrées, constituent l’urine […] L’urine, en plus de l’urée, contient d’autres substances chimiques, comme le sel par exemple… Les volailles n’émettent pas d’urine. L’urine secrétée par les reins est mélangée à la fiente et émise en même temps que celle-ci."
                                            },
                                            {
                                                "example_id": "bb364467-dffd-41a6-8129-777afaefa1dd",
                                                "sense_id": "ec052b18-6c6c-3cfa-b9bf-6b0cd80bbbb4",
                                                "text": "Arrosant d’un grand jet d’urine […] tous les feux qui passaient à sa portée, le philosophe à l’amphore fustigea une fois encore la dimension prométhéenne à l’œuvre dans le réel."
                                            }
                                        ]
                                    }
                                ]
                            },
