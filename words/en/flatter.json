{
    "word_family": [
        "flattery",
        "flatterer",
        "flattering",
        "unflattering",
        "flatteringly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4539c2f8-33a3-382f-818a-6889e8a5dfd2",
                    "sense_definition": "to praise someone excessively or insincerely, often to gain an advantage or win favor",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>flatter</w> his boss by constantly complimenting her new ideas during the meeting.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>льстить</w> своей начальнице, постоянно хваля её новые идеи во время собрания."
                            }
                        },
                        {
                            "text": "You are just trying to <w>flatter</w> me because you want to borrow my car this weekend.",
                            "target_lang_translations": {
                                "ru": "Ты просто пытаешься мне <w>польстить</w>, потому что хочешь одолжить мою машину на эти выходные."
                            }
                        }
                    ],
                    "synonyms": [
                        "stroke someone's ego"
                    ],
                    "antonyms": [
                        "insult",
                        "criticize"
                    ],
                    "common_phrases": [
                        "flatter someone to get"
                    ],
                    "target_lang_definitions": {
                        "ru": "чрезмерно или неискренне хвалить кого-либо, часто с целью получения выгоды или расположения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "льстить",
                                "target_lang_sense_clarification": "хвалить из корыстных побуждений"
                            },
                            {
                                "target_lang_word": "польстить",
                                "target_lang_sense_clarification": "сделать комплимент, чтобы угодить"
                            },
                            {
                                "target_lang_word": "подлизываться",
                                "target_lang_sense_clarification": "заискивать перед кем-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b58e2019-7306-3346-b140-75813b5f5e15",
                    "sense_definition": "to represent or portray someone in a way that makes them look more attractive than they really are",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That professional photograph really does <w>flatter</w> her, as she looks much younger in it.",
                            "target_lang_translations": {
                                "ru": "Эта профессиональная фотография действительно <w>льстит</w> ей, так как на ней она выглядит гораздо моложе."
                            }
                        },
                        {
                            "text": "The soft lighting in the restaurant was designed to <w>flatter</w> the guests' complexions.",
                            "target_lang_translations": {
                                "ru": "Мягкое освещение в ресторане было продумано так, чтобы <w>украшать</w> цвет лица гостей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flatter the figure"
                    ],
                    "target_lang_definitions": {
                        "ru": "представлять или изображать кого-либо в более привлекательном виде, чем на самом деле"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "льстить",
                                "target_lang_sense_clarification": "об изображении или одежде"
                            },
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "делать более красивым"
                            },
                            {
                                "target_lang_word": "представлять в выгодном свете",
                                "target_lang_sense_clarification": "подчеркивать достоинства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7015f879-c24f-343b-a85b-95e3920698be",
                    "sense_definition": "to believe something pleasant about oneself, even if it might not be entirely true",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "self-perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>flatter</w> myself that I am a good cook, but my family rarely asks for seconds.",
                            "target_lang_translations": {
                                "ru": "Я <w>льщу себе</w> тем, что я хороший повар, но моя семья редко просит добавки."
                            }
                        },
                        {
                            "text": "He liked to <w>flatter</w> himself that he was the most popular person in the office.",
                            "target_lang_translations": {
                                "ru": "Ему нравилось <w>тешить себя мыслью</w>, что он самый популярный человек в офисе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flatter oneself that"
                    ],
                    "target_lang_definitions": {
                        "ru": "тешить себя приятной мыслью, которая может не вполне соответствовать действительности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "льстить себе",
                                "target_lang_sense_clarification": "быть о себе высокого мнения"
                            },
                            {
                                "target_lang_word": "обольщаться",
                                "target_lang_sense_clarification": "питать иллюзии"
                            },
                            {
                                "target_lang_word": "тешить себя надеждой",
                                "target_lang_sense_clarification": "успокаивать себя мыслями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1da82b2-f8ce-3248-b8c1-7cf2287ab4e7",
                    "sense_definition": "to give someone false hope or to encourage them with unrealistic expectations",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor did not want to <w>flatter</w> the patient with false hopes of a quick recovery.",
                            "target_lang_translations": {
                                "ru": "Врач не хотел <w>обнадеживать</w> пациента ложными надеждами на быстрое выздоровление."
                            }
                        },
                        {
                            "text": "Do not <w>flatter</w> him into thinking the project will be finished by tomorrow.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>обольщать</w> его мыслями о том, что проект будет закончен к завтрашнему дню."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flatter into vain hopes"
                    ],
                    "target_lang_definitions": {
                        "ru": "давать кому-либо ложную надежду или поощрять нереалистичные ожидания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обольщать",
                                "target_lang_sense_clarification": "внушать ложные надежды"
                            },
                            {
                                "target_lang_word": "обнадеживать",
                                "target_lang_sense_clarification": "давать пустые обещания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9db53c88-8e59-33d8-9f3d-2c105b790dc4",
                    "sense_definition": "the comparative form of <w>flat</w>; more flat",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This part of the country is much <w>flatter</w> than the mountainous region we just left.",
                            "target_lang_translations": {
                                "ru": "Эта часть страны гораздо <w>более плоская</w>, чем горный регион, который мы только что покинули."
                            }
                        },
                        {
                            "text": "You need a <w>flatter</w> surface if you want to build a stable tower with those blocks.",
                            "target_lang_translations": {
                                "ru": "Тебе нужна <w>более ровная</w> поверхность, если ты хочешь построить устойчивую башню из этих блоков."
                            }
                        }
                    ],
                    "antonyms": [
                        "bumpier",
                        "steeper"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative degree of the adjective flat"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сравнительная степень прилагательного flat; более плоский или ровный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более плоский",
                                "target_lang_sense_clarification": "о поверхности"
                            },
                            {
                                "target_lang_word": "более ровный",
                                "target_lang_sense_clarification": "о ландшафте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cdac1008-6efa-3e60-bcfb-8dd151313806",
                    "sense_definition": "a person or thing that flattens something",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The industrial <w>flatter</w> was used to press the metal sheets into thin foils.",
                            "target_lang_translations": {
                                "ru": "Промышленный <w>расплющиватель</w> использовался для прессования металлических листов в тонкую фольгу."
                            }
                        },
                        {
                            "text": "As a dough <w>flatter</w> in the bakery, his job was to prepare the pizza bases.",
                            "target_lang_translations": {
                                "ru": "Работая <w>раскатчиком</w> теста в пекарне, он должен был готовить основы для пиццы."
                            }
                        }
                    ],
                    "synonyms": [],
                    "target_lang_definitions": {
                        "ru": "человек или устройство, которое делает что-либо плоским"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расплющиватель",
                                "target_lang_sense_clarification": "инструмент или механизм"
                            },
                            {
                                "target_lang_word": "гладилка",
                                "target_lang_sense_clarification": "приспособление для выравнивания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc6d06b3-d135-323b-909f-18dd2ee450f5",
                    "sense_definition": "a specialized blacksmithing tool used to create a smooth, flat surface on metal",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith struck the <w>flatter</w> with a heavy hammer to even out the glowing iron bar.",
                            "target_lang_translations": {
                                "ru": "Кузнец ударил по <w>гладилке</w> тяжелым молотом, чтобы выровнять раскаленный железный брусок."
                            }
                        },
                        {
                            "text": "Every traditional forge should have a high-quality <w>flatter</w> for finishing work.",
                            "target_lang_translations": {
                                "ru": "В каждой традиционной кузнице должна быть качественная <w>обжимка</w> для чистовой отделки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical terminology in blacksmithing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "специализированный кузнечный инструмент для создания гладкой плоской поверхности на металле"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гладилка",
                                "target_lang_sense_clarification": "кузнечный инструмент"
                            },
                            {
                                "target_lang_word": "обжимка",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
