                "senses": [
                    {
                        "sense_id": "127465b1-a230-3028-b4d2-ced7b3d500c1",
                        "entry_id": "350f5af4-1469-3e72-becb-6b338de645db",
                        "glosses": [
                            "производить обследование чего-либо с какой-либо специальной целью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44f9e69e-a5b0-42b5-b0d3-1d820fc45a66",
                                "sense_id": "127465b1-a230-3028-b4d2-ced7b3d500c1",
                                "text": "Мы будем строить корабли, полярные станции и, главное, разведывать запасы нефти, газа, металлов."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bac9cfd-ec7a-3056-8192-f403b9683784",
                        "entry_id": "350f5af4-1469-3e72-becb-6b338de645db",
                        "glosses": [
                            "выведывать, разузнавать, расспрашивая, наблюдая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c2c4f27-25a9-4a2b-a75a-2af500052550",
                                "sense_id": "3bac9cfd-ec7a-3056-8192-f403b9683784",
                                "text": "Она клялась мне безмерною любовью, а меня принуждала обещать хранить тайну и никак не разведывать, кто она такая!"
                            }
                        ]
                    }
                ],
