                    {
                        "sense_id": "c3fc5b93-c45f-3c4a-98af-1024ae7677b8",
                        "entry_id": "cd8660dd-b72e-33f8-a824-31ba7c9d47ff",
                        "glosses": [
                            "auf eine klassischgewordene Weise"
