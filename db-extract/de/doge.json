                ],
                "senses": [
                    {
                        "sense_id": "956a4187-37fa-34ff-a0c0-72b18d02aa16",
                        "entry_id": "5b8b0b3b-dd82-3baf-b0da-be9d7586a6a5",
                        "glosses": [
                            "Titel des Staatsoberhaupts (unter anderem) der ehemaligen Republiken Venedig und Genua"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f00f655a-69cf-3b28-8bf8-a2976951fb82",
                        "entry_id": "5b8b0b3b-dd82-3baf-b0da-be9d7586a6a5",
                        "glosses": [
                            "Staatsoberhaupt dieser ehemaligen Republiken, Träger des Titels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ceddb1c-ac43-4432-9f3d-1ebd79325395",
                                "sense_id": "f00f655a-69cf-3b28-8bf8-a2976951fb82",
                                "text": "„Die Worte des Dogen reizten den Thronräüber [sic!] zum wildesten Haß gegen den jungen Alerius.“"
                            },
                            {
                                "example_id": "6030a222-41cf-4e4e-93a2-2e1470440ad4",
                                "sense_id": "f00f655a-69cf-3b28-8bf8-a2976951fb82",
                                "text": "„In diese Klasse hast du dich gestellt;",
                                "translation": "Drum wirf dich vor dem Dogen auf die Knie.“"
                            },
                            {
                                "example_id": "00309cb9-2251-4851-a6ab-cdf7ca8adbaa",
                                "sense_id": "f00f655a-69cf-3b28-8bf8-a2976951fb82",
                                "text": "„Dieses Kloster unterstand der Gerichtsbarkeit des Dogen von Venedig, den die Nonnen Padre Serenissimo nannten; alle waren Damen aus den ersten venezianischen Familien.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a27308c3-15d6-411d-9f23-f6c474b8c89f",
                        "source_entry_id": "5b8b0b3b-dd82-3baf-b0da-be9d7586a6a5",
                        "source_sense_id": "956a4187-37fa-34ff-a0c0-72b18d02aa16",
                        "source_sense_description": "Titel des Staatsoberhaupts (unter anderem) der ehemaligen Republiken Venedig und Genua",
                        "target_lang_word": "doge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c764a301-e792-37de-8e39-360859c3dfdc",
                                        "entry_id": "b5bbc416-fef9-3530-bbf5-4bf46c600c89",
                                        "glosses": [
                                            "The chief magistrate in the republics of Venice and Genoa."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cc7d395-be02-432c-8916-a375499b0be1",
                                                "sense_id": "c764a301-e792-37de-8e39-360859c3dfdc",
                                                "text": "In the thirteenth century, a new method of appointing the doge, by the famous ballot of Venice, a complicated mixture of choice and chance, was adopted."
                                            },
                                            {
                                                "example_id": "e412b5dd-2a5a-4f0a-b791-87254e6f0de6",
                                                "sense_id": "c764a301-e792-37de-8e39-360859c3dfdc",
                                                "text": "This reply was one of the first important pronouncements to be made by Antonio Grimani, who on 6 July had been elected seventy-fourth Doge of Venice in succession to Leonardo Loredan."
                                            },
                                            {
                                                "example_id": "fdc93134-c87e-4de6-85ee-74c2fe8e5e80",
                                                "sense_id": "c764a301-e792-37de-8e39-360859c3dfdc",
                                                "text": "The doge and the Venetian Senate might still be the servants (douloi) of the emperor, but nonetheless they were able to fix the price of their naval aid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d46f2e4-1621-3b24-8c8f-7813013826ed",
                                        "entry_id": "7d00151e-75a3-3a60-90e1-160537819ce4",
                                        "glosses": [
                                            "Deliberate misspelling of doggy."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "alt-of",
                                            "deliberate",
                                            "humorous",
                                            "misspelling"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a2ac3d2-bc25-3e80-aca0-b5763dd4f43b",
                                        "entry_id": "7d00151e-75a3-3a60-90e1-160537819ce4",
                                        "glosses": [
                                            "Specifically, a Shiba Inu, as in the doge meme."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "910e1a40-2ae5-4f9a-ae3e-4ab56605b222",
                                                "sense_id": "9a2ac3d2-bc25-3e80-aca0-b5763dd4f43b",
                                                "text": "Bobsled wasn't the only Dogecoin-backed sporting success. Fans of Nascar will recognise the car driven by Josh Wise, emblazoned, as it is, with the adorable little doge on its bonnet (pictured above)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90b579db-f2d6-3879-90cc-1639f19aa4d5",
                                        "entry_id": "991db900-4df9-39f0-8951-c028233f034b",
                                        "glosses": [
                                            "Alternative letter-case form of DOGE."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8832d589-00ba-4b0c-9681-5315518b61e2",
                                                "sense_id": "90b579db-f2d6-3879-90cc-1639f19aa4d5",
                                                "text": "Since the lab has been \"doged,\" a petition posted to Change.org by Evgeny Stambulchik asked for signatures to oppose the layoff of the NIST Atomic Spectroscopy Group and has garnered 2,500 signatures as of reporting time. There is also a campaign website."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30ae3e92-59f7-407e-9904-7d7767de5cd5",
                        "source_entry_id": "5b8b0b3b-dd82-3baf-b0da-be9d7586a6a5",
                        "source_sense_id": "956a4187-37fa-34ff-a0c0-72b18d02aa16",
                        "source_sense_description": "Titel des Staatsoberhaupts (unter anderem) der ehemaligen Republiken Venedig und Genua",
                        "target_lang_word": "doge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doge",
