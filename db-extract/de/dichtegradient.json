                        "glosses": [
                            "Veränderung der Dichte eines Stoffes in einem bestimmten Gebiet"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "7dde0b78-7c44-48af-904d-346d01764c89",
                                "sense_id": "7a530222-da03-3833-92f1-218ab6044900",
                                "text": "Ist in der Messstrecke ein Dichtegradient vorhanden, werden die durch die Messstrecke laufenden Strahlen gebrochen und interferieren mit den ungestörten Strahlen, worauf auf der Mattscheibe dunkle Bereiche gleichen Gangunterschiedes also gleicher Dichte erscheinen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6da39751-a29e-3887-a639-a7408793d8c0",
                        "entry_id": "b733cb66-1570-346a-a85d-fa4c79ae273d",
                        "glosses": [
                            "Flüssigkeit, in die aufgebrochene Zellen gegeben werden und die in einen rotierenden Apparat gegeben wird, wo sich die Zellbestandteile entsprechend ihrer Dichte in Schichten in der Flüssigkeit lagern"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "abd00013-4c7c-4842-957c-ce7e7b700812",
                                "sense_id": "6da39751-a29e-3887-a639-a7408793d8c0",
                                "text": "Bei der Dichtegradientenzentrifugation wird das Homogenat auf die Oberfläche eines Dichtegradienten aufgetragen und anschließend zentrifugiert."
                            }
                        ],
                        "sense_index_json": "\"2\""
