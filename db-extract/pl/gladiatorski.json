                                        "glosses": [
                                            "Relatif aux gladiateurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "554bbd1a-7ea6-4f05-9514-5988dccc7764",
                                                "sense_id": "60456588-2205-3a67-86c8-e7e888aec878",
                                                "text": "Quelques balles de frondes, d’humbles figulines, des tessères gladiatoriales."
