                        "cross_references": [
                            {
                                "target_word": "Prior",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9215d7d-4da5-3f30-b000-e958ad7238da",
                                        "entry_id": "4d555371-c29f-3f10-9b39-0116eca21602",
                                        "glosses": [
                                            "der Vorsteher eines Klosters, als Generalprior auch eines Ordens"
                                        ],
                                        "tags": [
                                            "Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd65a43b-85d6-429e-a607-4f90961300bf",
                                                "sense_id": "c9215d7d-4da5-3f30-b000-e958ad7238da",
                                                "text": "„1314 war es nämlich, als der Habsburgische Herzog hungernd durch den Wienerwald irrte und danach die Kartause Mauerbach errichten ließ – ein Kloster für einen Prior und zwölf Mönche, die hier in der Abgeschiedenheit ihr Schweigegelübde lebten.“"
                                            },
                                            {
                                                "example_id": "010e040e-ad18-43f1-8ca1-c54b0ac2dbf0",
                                                "sense_id": "c9215d7d-4da5-3f30-b000-e958ad7238da",
                                                "text": "„Am Morgen kam der Prior und erklärte uns für frei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "632a56c0-b522-4302-a853-e6d268edd1f9",
                        "source_entry_id": "000c6925-b211-327b-8e13-7f39c24f9d03",
