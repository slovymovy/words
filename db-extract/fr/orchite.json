                "senses": [
                    {
                        "sense_id": "89b5c898-9d74-31c4-8c8f-b0aab46e7389",
                        "entry_id": "52626631-155b-37f1-9aff-87fb7c836b96",
                        "glosses": [
                            "Inflammation aiguë ou chronique du testicule."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ab1f69c5-3245-48f1-819c-484709f54dff",
                                "sense_id": "89b5c898-9d74-31c4-8c8f-b0aab46e7389",
                                "text": "Les mâles géniteurs présentent parfois une orchite —une inflammation des testicules, au cours de laquelle ces derniers deviennent chauds, douloureux et, parfois, enflés. Si, dans les cas graves, ces manifestations sont visibles, elles peuvent n’être détectables qu’à la palpation à cause de la peau du scrotum qui enveloppe et protège les testicules."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cf2d6c5-406e-45fa-81b1-97cc27649428",
                        "source_entry_id": "52626631-155b-37f1-9aff-87fb7c836b96",
                        "source_sense_id": "89b5c898-9d74-31c4-8c8f-b0aab46e7389",
                        "target_lang_word": "orchitis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orchitis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8634832d-6e55-3b84-8d27-d3fdea2e3450",
                                        "entry_id": "8cb56651-da6c-380e-ab78-29cace769a89",
                                        "glosses": [
                                            "A painful inflammation of one or both testes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9da56b6b-d0e4-4c9d-b992-3af12c98f9a3",
                                                "sense_id": "8634832d-6e55-3b84-8d27-d3fdea2e3450",
                                                "text": "It has been well studied, however, and helps to understand the evolution of other orchitises (197)."
                                            },
                                            {
                                                "example_id": "e93b4c24-22e0-4dc1-ab65-ccb750578623",
                                                "sense_id": "8634832d-6e55-3b84-8d27-d3fdea2e3450",
                                                "text": "Avoid corticosteroids for mumps orchitis as they can reduce testosterone concentrations and increase testicular atrophy."
                                            },
                                            {
                                                "example_id": "a4b12563-d47f-4060-b286-71160f7d7b22",
                                                "sense_id": "8634832d-6e55-3b84-8d27-d3fdea2e3450",
                                                "text": "This condition is encountered in Klinefelter's Syndrome, in primary hypogonadism, following orchitides, and during chronic hemodialysis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
