                "senses": [
                    {
                        "sense_id": "ec9d3b19-8d64-353f-a4d3-c55e84a52a59",
                        "entry_id": "3352c480-d132-3972-b0f3-91af2908fcc9",
                        "glosses": [
                            "Graffiter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71bdf64c-c65e-48f9-973f-54107e7a2c1c",
                                "sense_id": "ec9d3b19-8d64-353f-a4d3-c55e84a52a59",
                                "text": "Le dessinateur était interprété par un acteur allemand pour qui j'avais réalisé de fausses dédicaces qu'il n'avait plus qu'à regraffiter par dessus et signer de son 'nom'."
                            },
                            {
                                "example_id": "f8394185-779d-4d61-bbb6-b834385ae606",
                                "sense_id": "ec9d3b19-8d64-353f-a4d3-c55e84a52a59",
                                "text": "Cela lui laisse du temps pour décaper, « regraffiter » les meubles industriels, nettoyer les tôles métallisées qui font l'apanage de sa brocante."
                            }
                        ]
                    }
