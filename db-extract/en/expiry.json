                                "target_senses": [
                                    {
                                        "sense_id": "db90a1d9-db4c-37c9-b891-a61884265c1b",
                                        "entry_id": "be297ac5-e126-30dc-a96c-113ce339d230",
                                        "glosses": [
                                            "Exhalation, action d’expirer ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14fe9300-22c4-4466-b58a-500a612030d8",
                                                "sense_id": "db90a1d9-db4c-37c9-b891-a61884265c1b",
                                                "text": "La vie ne peut se soutenir sans l’inspiration et l’expiration."
                                            },
                                            {
                                                "example_id": "7a367d57-3a1e-44bd-89f4-790bc6002d1d",
                                                "sense_id": "db90a1d9-db4c-37c9-b891-a61884265c1b",
                                                "text": "Ces rythmes s’actualisent dans l’expiration, le repos et l’inspiration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6547d31f-5e5a-327d-b24c-2a202c05370d",
                                        "entry_id": "be297ac5-e126-30dc-a96c-113ce339d230",
                                        "glosses": [
                                            "Exhalation, action d’expirer ou résultat de cette action.",
                                            "Action par laquelle les végétaux éliminent et restituent à l’air certains éléments en échange des éléments gazeux qu’ils lui ont empruntés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54f866cc-157e-3549-b1f3-27fe173a9000",
                                        "entry_id": "be297ac5-e126-30dc-a96c-113ce339d230",
                                        "glosses": [
                                            "Échéance d’un terme."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ef34559-c7bc-4414-9da9-14c801f7e9dc",
                                                "sense_id": "54f866cc-157e-3549-b1f3-27fe173a9000",
                                                "text": "Il n’a plus que six mois jusqu’à l’expiration de son bail."
                                            },
                                            {
                                                "example_id": "bb5c6dd5-d901-4786-9b4b-e7c862edf3bc",
                                                "sense_id": "54f866cc-157e-3549-b1f3-27fe173a9000",
                                                "text": "À l’expiration de son mandat de député."
                                            },
                                            {
                                                "example_id": "b478eb86-5704-4675-bd77-9b4b11bd5d4f",
                                                "sense_id": "54f866cc-157e-3549-b1f3-27fe173a9000",
                                                "text": "L’expiration de ce brevet, de ce traité aura lieu à telle date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9b4b75e-7c0c-36af-8284-db2c0bf7fea9",
                                        "entry_id": "be297ac5-e126-30dc-a96c-113ce339d230",
                                        "glosses": [
                                            "Fin d’une certaine période de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd3bd1cc-2174-4ed9-aa4a-36e73e762f1b",
                                                "sense_id": "b9b4b75e-7c0c-36af-8284-db2c0bf7fea9",
                                                "text": "À l’expiration de l’année, du trimestre."
                                            },
                                            {
                                                "example_id": "f1c00942-9723-417a-bd93-3a981df42565",
                                                "sense_id": "b9b4b75e-7c0c-36af-8284-db2c0bf7fea9",
                                                "text": "Expiration d’un armistice, d’un ultimatum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
