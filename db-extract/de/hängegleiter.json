                                "target_senses": [
                                    {
                                        "sense_id": "513e3551-0c37-3eb7-b3c2-505b93143219",
                                        "entry_id": "6258a3e8-fb8b-3bc2-851a-9774756ec527",
                                        "glosses": [
                                            "Aéronef à armature rigide de vol libre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c551cb-e7c9-43e7-8549-ae53ec8aaeb5",
                                                "sense_id": "513e3551-0c37-3eb7-b3c2-505b93143219",
                                                "text": "Oh regarde : un deltaplane au-dessus de nous !"
                                            },
                                            {
                                                "example_id": "9daeae3d-a8c7-4308-af48-3002fe1e10dd",
                                                "sense_id": "513e3551-0c37-3eb7-b3c2-505b93143219",
                                                "text": "On a parfois présenté l’ULM comme le résultat d’un mariage entre un moteur de tondeuse à gazon et un deltaplane, c’est-à-dire une aile volante individuelle servant à planer dans les courants d’air ascendants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb27cd30-d624-3b81-bef3-1653dddeec42",
                                        "entry_id": "6258a3e8-fb8b-3bc2-851a-9774756ec527",
                                        "glosses": [
                                            "Pratique sportive aérienne avec cet aéronef."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c28bda76-b983-466c-8268-11da4fa739b4",
                                                "sense_id": "bb27cd30-d624-3b81-bef3-1653dddeec42",
                                                "text": "Je fais du deltaplane tous les samedis, en été."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3825aab0-4bb0-4418-82b7-2fc52bdd2934",
                        "source_entry_id": "6ac80cb1-ba1a-3203-a43e-66d2b5107615",
                        "source_sense_id": "21d81175-6366-379e-b5ab-870d814119eb",
