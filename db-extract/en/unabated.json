                                "target_senses": [
                                    {
                                        "sense_id": "b4a9c95d-aef1-3548-81b9-c5005424f706",
                                        "entry_id": "c73b8fee-eddc-36ee-9a09-f93b271767b9",
                                        "glosses": [
                                            "nog even groot, niet minder geworden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12327dad-1745-4c2a-90ec-63c7a6bc5a5c",
                                                "sense_id": "b4a9c95d-aef1-3548-81b9-c5005424f706",
                                                "text": "Ook toen het moeilijk werd, bleef zijn enthousiasme onverminderd."
                                            },
                                            {
                                                "example_id": "2e21c343-9b37-43e7-8853-06e72df700ee",
                                                "sense_id": "b4a9c95d-aef1-3548-81b9-c5005424f706",
                                                "text": "Natuurlijk zijn ze in Assen onverminderd trots op 'hun' Harry. Gastconservator Albert Haar noemt hem graag een icoon voor Drenthe, een voorbeeld voor de provinciale jeugd. Maar Muskee was natuurlijk meer dan dat. Met zijn muziek en zijn dwarsheid was hij een exponent van de anarchie van de jaren zestig. Die levenshouding bracht hem fans in heel Nederland."
                                            },
                                            {
                                                "example_id": "ad410ec9-0473-4b49-a2f1-abfc59284039",
                                                "sense_id": "b4a9c95d-aef1-3548-81b9-c5005424f706",
                                                "text": "Ondertussen woedde de storm onverminderd voort."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "onverminderd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "466b0ec3-4aeb-342c-97a5-850b5e02aa9d",
                                        "entry_id": "b259d795-2362-3051-a5ba-d9e17d5d8a9d",
                                        "glosses": [
                                            "zonder af te doen aan"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a309aaf-b217-4d83-b852-5b31c6829785",
                                                "sense_id": "466b0ec3-4aeb-342c-97a5-850b5e02aa9d",
                                                "text": "U heeft toestemming voor dit feest onverminderd de bepalingen over tegengaan van geluidhinder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
