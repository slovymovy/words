                "senses": [
                    {
                        "sense_id": "734e178f-f8ef-3581-bcd3-6db078f48906",
                        "entry_id": "015e8377-c7a8-3da3-8a3f-83b1bdc06be9",
                        "glosses": [
                            "Câblodiffuser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cba3a59-0d42-4d86-8925-f13c060cf405",
                                "sense_id": "734e178f-f8ef-3581-bcd3-6db078f48906",
                                "text": "Ayant récemment dit adieu à la soucoupe satellite, je me suis fait câblodistribuer par Cogeco."
                            },
                            {
                                "example_id": "149655b0-96d9-44aa-a90a-a84a90f12ae6",
                                "sense_id": "734e178f-f8ef-3581-bcd3-6db078f48906",
                                "text": "Il n'appartient pas aux pouvoirs publics de décider ni de la câblodistribution, ni du nombre de chaînes à câblodistribuer, ni de permettre à un organe juridictionnel ou administratif de fixer le prix de la câblodistribution."
                            }
                        ]
                    }
