                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "77648c27-0ce2-37a0-8c8b-f37444636df8",
                        "entry_id": "44e20388-c0b3-3d74-a262-6677744c4a28",
                        "glosses": [
                            "Glücksspielmöglichkeit im Rahmen eines Restaurations- und Variétébetriebs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3488d54b-d2d4-420e-85af-4fa4be4335a0",
                                "sense_id": "77648c27-0ce2-37a0-8c8b-f37444636df8",
                                "text": "„Das Casino ist düster und abschreckend, seine grünen Stühle verlassen, die Vorhänge zugezogen.“"
                            },
                            {
                                "example_id": "fcda947a-99df-41ec-9cd2-314d01136ea2",
                                "sense_id": "77648c27-0ce2-37a0-8c8b-f37444636df8",
                                "text": "„Doch nicht alle sehen die Casinos als Erfolgsgeschichte.“"
                            }
                        ],
