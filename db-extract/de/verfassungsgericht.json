                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9407e558-bd36-4328-a198-e5d9fbb75e84",
                        "source_entry_id": "f68eb607-aa29-3885-824d-6238ef98ba96",
                        "source_sense_id": "7e417991-6249-32cc-9525-d28f4488aa1a",
                        "source_sense_description": "Gericht, das die Vereinbarkeit von Hoheitsakten mit der Verfassung überprüfen kann",
                        "target_lang_word": "cour constitutionnelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cour constitutionnelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef8b108f-7479-382a-b22b-fb4767d9dce8",
                                        "entry_id": "6886836b-6506-3793-b259-3d855fe6f602",
                                        "glosses": [
                                            "Cour supérieure dont le rôle est de contrôler la constitutionnalité des lois et de l’action des autorités."
                                        ],
                                        "tags": [
                                            "Droit constitutionnel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "522aabf8-e701-491f-a76f-ffd0d2b58ac5",
                                                "sense_id": "ef8b108f-7479-382a-b22b-fb4767d9dce8",
                                                "text": "Les sept cours sont ainsi appelées à se prononcer sur des questions de constitutionnalité; il n'y a pas une cour constitutionnelle spécifique."
                                            },
                                            {
                                                "example_id": "d2962d6b-93af-4e3d-ac2e-7e6dbd7d7852",
                                                "sense_id": "ef8b108f-7479-382a-b22b-fb4767d9dce8",
                                                "text": "Plusieurs cantons ont institué, à leur niveau, une cour constitutionnelle disposant de la compétence de procéder au contrôle abstrait de la constitutionnalité des normes locales."
                                            },
                                            {
                                                "example_id": "600c3883-ada5-4dcb-981d-855a14a6696d",
                                                "sense_id": "ef8b108f-7479-382a-b22b-fb4767d9dce8",
                                                "text": "La Cour constitutionnelle contrôle, sur requête, la conformité des lois, décrets et règlements, cantonaux ou communaux, au droit supérieur. Elle connaît également, sur recours, des litiges en matière d'exercice des droits politiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
