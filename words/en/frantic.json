{
    "word_family": [
        "frantically",
        "franticness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "370d73ff-c750-367a-8879-321759fa9d61",
                    "sense_definition": "Feeling or showing extreme worry, fear, or panic.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotion_panic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>frantic</w> parents searched the entire park for their missing child.",
                            "target_lang_translations": {
                                "ru": "<w>Обезумевшие</w> родители обыскали весь парк в поисках пропавшего ребенка.",
                                "de": "Die <w>verzweifelten</w> Eltern suchten den gesamten Park nach ihrem vermissten Kind ab."
                            }
                        },
                        {
                            "text": "She made a <w>frantic</w> call to the police when she realized her car was stolen.",
                            "target_lang_translations": {
                                "ru": "Она в <w>панике</w> позвонила в полицию, когда поняла, что её машину угнали.",
                                "de": "Sie rief <w>panisch</w> die Polizei an, als ihr klar wurde, dass ihr Auto gestohlen worden war."
                            }
                        }
                    ],
                    "synonyms": [
                        "frenzied",
                        "desperate",
                        "panicky",
                        "distraught"
                    ],
                    "antonyms": [
                        "calm"
                    ],
                    "common_phrases": [
                        "frantic search",
                        "frantic call",
                        "frantic effort",
                        "frantic attempt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий или проявляющий крайнее беспокойство, страх или панику.",
                        "de": "Äußerste Sorge, Furcht oder Panik empfindend oder zeigend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезумевший",
                                "target_lang_sense_clarification": "от страха или волнения"
                            },
                            {
                                "target_lang_word": "лихорадочный",
                                "target_lang_sense_clarification": "о действиях, поисках или попытках"
                            },
                            {
                                "target_lang_word": "вне себя",
                                "target_lang_sense_clarification": "в состоянии крайнего возбуждения или тревоги"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "außer sich",
                                "target_lang_sense_clarification": "vor Sorge, Angst oder Panik"
                            },
                            {
                                "target_lang_word": "verzweifelt",
                                "target_lang_sense_clarification": "von Panik und Sorge getrieben"
                            },
                            {
                                "target_lang_word": "panisch",
                                "target_lang_sense_clarification": "von plötzlicher Angst erfasst"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8990a069-84f8-3754-a6ad-5cdf4ad51300",
                    "sense_definition": "Extremely active, hurried, and energetic, often in a chaotic way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "activity_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team worked at a <w>frantic</w> pace to finish the project before the deadline.",
                            "target_lang_translations": {
                                "ru": "Команда работала в <w>бешеном</w> темпе, чтобы закончить проект до дедлайна.",
                                "de": "Das Team arbeitete in einem <w>hektischen</w> Tempo, um das Projekt vor der Frist fertigzustellen."
                            }
                        },
                        {
                            "text": "After a <w>frantic</w> day at the office, I just wanted to go home and relax.",
                            "target_lang_translations": {
                                "ru": "После <w>сумасшедшего</w> дня в офисе я просто хотел пойти домой и расслабиться.",
                                "de": "Nach einem <w>hektischen</w> Tag im Büro wollte ich einfach nur nach Hause und mich entspannen."
                            }
                        }
                    ],
                    "synonyms": [
                        "frenetic"
                    ],
                    "common_phrases": [
                        "frantic pace",
                        "frantic activity",
                        "frantic rush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно активный, торопливый и энергичный, часто хаотичный.",
                        "de": "Extrem aktiv, eilig und energiegeladen, oft auf chaotische Weise."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бешеный",
                                "target_lang_sense_clarification": "о темпе или скорости"
                            },
                            {
                                "target_lang_word": "сумасшедший",
                                "target_lang_sense_clarification": "о времени, ритме жизни"
                            },
                            {
                                "target_lang_word": "неистовый",
                                "target_lang_sense_clarification": "об усилиях или активности"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hektisch",
                                "target_lang_sense_clarification": "von nervöser Betriebsamkeit geprägt"
                            },
                            {
                                "target_lang_word": "fieberhaft",
                                "target_lang_sense_clarification": "überaus eilig und intensiv"
                            },
                            {
                                "target_lang_word": "rasend",
                                "target_lang_sense_clarification": "in Bezug auf Tempo oder Aktivität"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebed27fe-f20e-358b-ba96-82b578969c47",
                    "sense_definition": "Mentally unstable or insane.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the ancient tragedy, the king becomes <w>frantic</w> with grief and wanders into the storm.",
                            "target_lang_translations": {
                                "ru": "В древней трагедии король становится <w>безумным</w> от горя и уходит в бурю.",
                                "de": "In der antiken Tragödie wird der König vor Kummer <w>wahnsinnig</w> und irrt in den Sturm hinaus."
                            }
                        },
                        {
                            "text": "The old medical texts described the patient as <w>frantic</w> and unable to reason.",
                            "target_lang_translations": {
                                "ru": "Старые медицинские тексты описывали пациента как <w>помешанного</w> и неспособного рассуждать.",
                                "de": "Die alten medizinischen Texte beschrieben den Patienten als <w>irrsinnig</w> und unfähig, vernünftig zu denken."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Modern usage prefers terms like 'insane' or 'mentally unstable'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Психически неуравновешенный или безумный.",
                        "de": "Geistig verwirrt, unzurechnungsfähig oder dem Wahnsinn nahe (veraltet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безумный",
                                "target_lang_sense_clarification": "устаревшее значение"
                            },
                            {
                                "target_lang_word": "помешанный",
                                "target_lang_sense_clarification": "лишенный рассудка"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wahnsinnig",
                                "target_lang_sense_clarification": "des Verstandes beraubt (oft bildungssprachlich/veraltet)"
                            },
                            {
                                "target_lang_word": "verrückt",
                                "target_lang_sense_clarification": "geistig nicht bei Sinnen"
                            },
                            {
                                "target_lang_word": "irrsinnig",
                                "target_lang_sense_clarification": "von Sinnen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "441682ca-ef44-30ac-889d-aa80ddb9e33d",
                    "sense_definition": "A person who is mentally unstable or insane.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers were afraid of the poor <w>frantic</w> who lived in the woods.",
                            "target_lang_translations": {
                                "ru": "Деревенские жители боялись несчастного <w>безумца</w>, который жил в лесу.",
                                "de": "Die Dorfbewohner hatten Angst vor dem armen <w>Wahnsinnigen</w>, der im Wald lebte."
                            }
                        },
                        {
                            "text": "He shouted like a <w>frantic</w>, making no sense to anyone around him.",
                            "target_lang_translations": {
                                "ru": "Он кричал как <w>сумасшедший</w>, не говоря ничего осмысленного для окружающих.",
                                "de": "Er schrie wie ein <w>Verrückter</w>, ohne dass irgendjemand um ihn herum ihn verstehen konnte."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage as a noun is no longer common in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который психически неуравновешен или безумен.",
                        "de": "Eine Person, die geistig verwirrt oder dem Wahnsinn verfallen ist (veraltet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безумец",
                                "target_lang_sense_clarification": "сумасшедший человек"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Wahnsinnige",
                                "target_lang_sense_clarification": "substantiviertes Adjektiv"
                            },
                            {
                                "target_lang_word": "Irre",
                                "target_lang_sense_clarification": "substantiviertes Adjektiv"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}