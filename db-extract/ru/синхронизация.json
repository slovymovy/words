                "senses": [
                    {
                        "sense_id": "1c453756-e630-39dd-83ba-9b4382faf594",
                        "entry_id": "db9f0d5e-3f1b-3432-bbc3-37650e01c4b8",
                        "glosses": [
                            "процесс приведения к одному значению одного или нескольких параметров разных объектов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e26f0c6d-63a1-49d3-a587-c73799e6fa89",
                                "sense_id": "1c453756-e630-39dd-83ba-9b4382faf594",
                                "text": "В таком виде сигнал подается к схеме цикловой синхронизации, где распознается цикловый синхросигнал, используемый для синхронизации входного сигнала с внутренним сигналом установки цикла АТС."
                            }
                        ]
                    },
                    {
                        "sense_id": "7014cf51-ab60-3a80-85cb-1a3caa12dfb8",
                        "entry_id": "db9f0d5e-3f1b-3432-bbc3-37650e01c4b8",
                        "glosses": [
                            "состояние синхронности"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd91ba46-8dc4-4888-bbed-0a3592e49698",
                        "source_entry_id": "db9f0d5e-3f1b-3432-bbc3-37650e01c4b8",
                        "target_lang_word": "synchronization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synchronization",
