                "senses": [
                    {
                        "sense_id": "1f387ff2-c673-300f-83cb-55024b904875",
                        "entry_id": "ff71e75f-0229-308b-8170-705bd6a2af7f",
                        "glosses": [
                            "stuk in een periodieke publicatie over een persoon of gebeurtenis wanneer er een aanleiding is die weer in herinnering te brengen"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "7e6fb069-d033-4a04-a7bf-d8794add30f4",
                                "sense_id": "1f387ff2-c673-300f-83cb-55024b904875",
                                "text": "Heeft Robert Mitchum echt bestaan? De 100ste geboortedag van de legendarische filmacteur ging dit jaar betrekkelijk onopgemerkt voorbij. (…) Hier en daar verscheen een herdenkingsartikel."
                            },
                            {
                                "example_id": "40ab042c-1a9f-447d-9e37-f5aff409d5a8",
                                "sense_id": "1f387ff2-c673-300f-83cb-55024b904875",
                                "text": "In alle herdenkingsartikelen stond dat hij zelf nooit op de platen van Boney M. had gezongen; de diepe basstem was van de Duitse producer Frank Farian die de groep had gecreëerd – en er, als enige, rijk van werd."
                            },
                            {
                                "example_id": "72f31d29-2340-49e6-84a1-9b015e1e695a",
                                "sense_id": "1f387ff2-c673-300f-83cb-55024b904875",
                                "text": "Negen afzonderlijke geschriften, groot of klein van omvang, heeft het Streuvels-herdenkingsjaar 1971 opgebracht. Voeg daarbij de tientallen herdenkingsartikels in de pers en het tijdschriftenwezen, en de optelsom vertegenwoordigt een piek van literatuur over Streuvels zoals er wel nooit een is geweest."
                            }
                        ]
                    },
                    {
                        "sense_id": "4dc50ab2-0202-3469-9c30-6f742e36e026",
                        "entry_id": "ff71e75f-0229-308b-8170-705bd6a2af7f",
                        "glosses": [
                            "voorwerp dat speciaal gemaakt is als herinnering aan een bepaalde persoon of gebeurtenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04686651-1395-4525-b427-1de2e19437c4",
                                "sense_id": "4dc50ab2-0202-3469-9c30-6f742e36e026",
                                "text": "Door deze combinatie van kleuren krijgt de bokaal een robuuste en bijzondere uitstraling en is dit herdenkingsartikel een sieraad in elke (woon)kamer."
                            },
                            {
                                "example_id": "30fdf77e-a5dd-4f18-88de-8b25fd5ff6b9",
                                "sense_id": "4dc50ab2-0202-3469-9c30-6f742e36e026",
                                "text": "Maar op het whiteboard achter hem hangt zijn ontwerp dat op tienduizenden borden, mokken en sleutelhangers komt die Toppoint gaat produceren. Tijdens de brainstorm woensdag is bedacht om zwaar in te zetten op herdenkingsartikelen."
                            }
                        ]
                    }
