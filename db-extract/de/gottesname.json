                            {
                                "example_id": "0107c0ee-c37c-453e-b300-d662d5803bda",
                                "sense_id": "c042b13e-bca7-3764-97e6-ec847f062ace",
                                "text": "„Juden ist es nicht erlaubt, Texte zu vernichten, die den vierbuchstabigen Gottesnamen (Tetragramm) enthalten.“"
