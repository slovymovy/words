                        ],
                        "examples": [
                            {
                                "example_id": "780dae35-d5a2-4724-9abd-1adcb9c48515",
                                "sense_id": "cb5b9933-6445-3fe3-a7fb-914634e13516",
                                "text": "„Das an der Garonne liegende Toulouse ist mit fast 1,3 Millionen Einwohnern in der Metropolenregion die viertgrößte Stadt Frankreichs.“"
                            },
                            {
                                "example_id": "6b3eb85a-0cc2-452c-980c-5badb725d04e",
                                "sense_id": "cb5b9933-6445-3fe3-a7fb-914634e13516",
                                "text": "„Wir fuhren in einem großen sinnlosen Bogen, bald in Asylen übernachtend, bald auf Waggons, nirgends auf eine Bleibe stoßend, geschweige denn auf ein Arbeitsangebot, in einem großen Bogen immer tiefer dem Süden zu, über die Loire, über die Garonne, bis zur Rhone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
