                        "entry_id": "ffc2b1ae-e634-3d9b-8a6e-349e54d822f5",
                        "glosses": [
                            "Communard, partisan de la Commune de Paris pendant l’insurrection de 1871."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f6e8aa6c-967e-442b-9cfd-6466453cae72",
                                "sense_id": "6218d161-f05d-3363-a865-6f600d289671",
                                "text": "On affectait de le considérer comme un communeux, échappé de Paris !"
                            },
                            {
                                "example_id": "71d74d54-5b4f-4d2f-b612-3715da6b41d3",
                                "sense_id": "6218d161-f05d-3363-a865-6f600d289671",
                                "text": "Ces abominables Communeux ont brûlé solennellement la guillotine l’autre jour. Ils sont superbes d’entrain, de conviction, tous ces bataillons. Quelle leçon pour Trochu!"
                            }
                        ]
                    },
