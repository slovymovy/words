                        "poster une lettre"
                    ]
                },
                {
                    "sense_id": "18e79e99-342d-3de7-b17a-5f491032593b",
                    "sense_definition": "Placer une personne ou s'installer à un endroit précis pour surveiller, guetter ou attendre.",
