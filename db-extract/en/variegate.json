                                "target_senses": [
                                    {
                                        "sense_id": "3726421f-2da7-3109-8ef7-12bc6b695905",
                                        "entry_id": "decf551d-0f74-3dd4-9797-7a77e21a03c3",
                                        "glosses": [
                                            "etwas teilweise ändern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "808ab73a-6719-4a29-a12d-bbf727692579",
                                                "sense_id": "3726421f-2da7-3109-8ef7-12bc6b695905",
                                                "text": "Lasst uns das Konzept mal ein bisschen variieren: Vielleicht klappt es dann besser."
                                            },
                                            {
                                                "example_id": "341cdba9-fdbf-4f74-a2a5-261be2328250",
                                                "sense_id": "3726421f-2da7-3109-8ef7-12bc6b695905",
                                                "text": "Es ist nicht Sache des OGH, mögliche Fallgruppen zu variieren und rechtlich zu beurteilen."
                                            }
