                                "example_id": "854a7387-6ad4-4cb6-b1d3-9d98291fe7f6",
                                "sense_id": "ae7286a4-486f-3ab1-93c8-088cedcec69a",
                                "text": "Borstkanker is de meest voorkomende kwaadaardige nieuwvorming bij vrouwen."
                            }
                        ]
                    },
                    {
                        "sense_id": "3dde27cd-83cb-38eb-a31e-c3139dec53ab",
