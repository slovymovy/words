                    },
                    {
                        "translation_id": "34c04e19-50b4-4a3d-b3a9-f328680d50d5",
                        "source_entry_id": "dd958447-f14f-3034-80eb-adc323ee282e",
                        "target_lang_word": "Katharsis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katharsis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "507d1559-e865-3d37-95ce-baa9a186d9d2",
                                        "entry_id": "41570dd1-f197-3fc7-bb84-effdd79a526d",
                                        "glosses": [
                                            "die Befreiung von psychischen/seelischen Konflikten durch eine emotionale Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0655116b-367e-4796-8c0d-bdd847f97d8d",
                                                "sense_id": "507d1559-e865-3d37-95ce-baa9a186d9d2",
                                                "text": "Schafft der Fußball soziale Katharsis?"
                                            },
                                            {
                                                "example_id": "6967f6ed-3bb8-4dd4-a806-133d68ca7e8b",
                                                "sense_id": "507d1559-e865-3d37-95ce-baa9a186d9d2",
                                                "text": "„Das Plakat von Karl Kraus, das um diese Zeit angeschlagen wurde, hatte die Wirkung einer Katharsis und erlöste mich von dieser Lähmung.“"
                                            },
                                            {
                                                "example_id": "8e34d948-9da7-484c-940c-266f53fbf91b",
                                                "sense_id": "507d1559-e865-3d37-95ce-baa9a186d9d2",
                                                "text": "„Diese Formen kollektiven Vergnügens üben die Funktion einer gesellschaftlichen Katharsis gegen negative Emotionen aus.“"
                                            },
                                            {
                                                "example_id": "bb35ed3e-620d-4ac2-9542-3b9d00fcadff",
                                                "sense_id": "507d1559-e865-3d37-95ce-baa9a186d9d2",
                                                "text": "„Der Protest der Studenten sei, wie er sagte, eine kollektive Katharsis gewesen, um ihre Selbstachtung nicht zu verlieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "de7b999c-7845-3010-96eb-4304a4dea053",
                                        "entry_id": "41570dd1-f197-3fc7-bb84-effdd79a526d",
                                        "glosses": [
                                            "in der aristotelischen Poetik (psychische) Reinigung als Effekt der Tragödie"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71282105-37b9-43e5-93ec-f245126ec139",
                                                "sense_id": "de7b999c-7845-3010-96eb-4304a4dea053",
                                                "text": "„Die zweite Abhandlung schließt sich weit mehr an Lessing als an Kant an, erklärt den Affect des Mitleids und aus ihm die Tragödie in selbständiger Weise, die von Lessing abweicht und der Bernaysischen Theorie der Katharsis nahe kommt; Aristoteles selbst hat S. erst später (1797) gelesen.“"
                                            },
                                            {
                                                "example_id": "6dead03c-3ed4-4815-8725-667cf2ecd587",
                                                "sense_id": "de7b999c-7845-3010-96eb-4304a4dea053",
                                                "text": "„Und die Möglichkeit, diese Befreiung in einer dichterischen Arbeit, durch die Katharsis der Tragödie zu versuchen, war mir noch nicht erschienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
