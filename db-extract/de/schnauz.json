                "senses": [
                    {
                        "sense_id": "b8c3c145-1d30-31ba-bb3a-dad83733273e",
                        "entry_id": "9a050dd2-1f74-32da-9c0e-174e6333ca6b",
                        "glosses": [
                            "großer Schnurrbart"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "634a423b-71cc-43d1-9df5-6fca80334287",
                                "sense_id": "b8c3c145-1d30-31ba-bb3a-dad83733273e",
                                "text": "„Beim Waren streicht er sich den breiten Schnauz gerade, den Direktor begrüsst er mit kühlem Händedruck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "858196dc-7b5f-4a54-88b2-8a00cd2473f5",
                        "source_entry_id": "9a050dd2-1f74-32da-9c0e-174e6333ca6b",
                        "source_sense_id": "b8c3c145-1d30-31ba-bb3a-dad83733273e",
                        "source_sense_description": "Schweiz: großer Schnurrbart",
                        "target_lang_word": "moustache",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moustache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd807c53-5767-3a4b-b92f-33b23e573db7",
                                        "entry_id": "2ffa5502-069e-348b-9493-98ac7e913073",
                                        "glosses": [
                                            "Poils qui poussent au-dessus de la lèvre supérieure."
                                        ],
                                        "tags": [
                                            "Barbe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0b565e2-3148-4949-93db-994c81d29a9e",
                                                "sense_id": "cd807c53-5767-3a4b-b92f-33b23e573db7",
                                                "text": "— Faudra voir ! faudra voir ! — murmura tout bas Agénor en frisant sa moustache droite."
                                            },
                                            {
                                                "example_id": "8cd37b69-1ff5-4a2d-8383-a64467747042",
                                                "sense_id": "cd807c53-5767-3a4b-b92f-33b23e573db7",
                                                "text": "Ce commandant, un homme fort, haut, avec des moustaches et une barbiches grises, […], nous reçut avec bonhomie et amabilité."
                                            },
                                            {
                                                "example_id": "ba113ef5-8155-4b6f-aa30-a77bbacfa454",
                                                "sense_id": "cd807c53-5767-3a4b-b92f-33b23e573db7",
                                                "text": "Les effigies qu’on publia de lui soulignaient d’abord une immense moustache noire et, en second lieu, derrière la moustache, un air farouchement irascible."
                                            },
                                            {
                                                "example_id": "7ba89250-88ba-4f62-a148-9dad450ec659",
                                                "sense_id": "cd807c53-5767-3a4b-b92f-33b23e573db7",
                                                "text": "Sous la moustache blonde du grand gaillard, ses lèvres goulues cherchaient la bouche voluptueuse."
                                            },
                                            {
                                                "example_id": "4bced7ea-2f39-407b-a87b-827b7fd28100",
                                                "sense_id": "cd807c53-5767-3a4b-b92f-33b23e573db7",
                                                "text": "Il était travesti en Charlot et tenait à la main une petite moustache noire qu'il enduisait de colle."
                                            },
                                            {
                                                "example_id": "8086ef15-88ae-4b93-89ab-206e10a9f47e",
                                                "sense_id": "cd807c53-5767-3a4b-b92f-33b23e573db7",
                                                "text": "Un baiser sans moustache, disait-on alors, c’est comme un œuf sans sel ; j’ajoute : et comme le Bien sans Mal, comme ma vie entre 1905 et 1914."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b60fdf-e594-3939-95ea-e611f8ce6291",
                                        "entry_id": "2ffa5502-069e-348b-9493-98ac7e913073",
                                        "glosses": [
                                            "Vibrisse, longs poils que les chats, les lions et d’autres animaux ont autour de la gueule."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "common"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "105419cb-3137-3362-9598-00d6e1873920",
                                        "entry_id": "2ffa5502-069e-348b-9493-98ac7e913073",
                                        "glosses": [
                                            "Masse des longs poils qui recouvrent les pieds de certains chevaux."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b2b407-80a9-4261-92f6-2ddadd2bde0b",
                                                "sense_id": "105419cb-3137-3362-9598-00d6e1873920",
                                                "text": "Les tendons sont soigneusement débarrassés des crins qui les recouvrent, quand on a affaire à un cheval de distinction ; mais tout le poil est laissé, ce que l’on appelle la moustache dans les chevaux de gros trait, comme beauté, ou, bien souvent, pour masquer une forme."
                                            },
                                            {
                                                "example_id": "206c3ea2-384c-43f7-9eaa-4172617ed811",
                                                "sense_id": "105419cb-3137-3362-9598-00d6e1873920",
                                                "text": "La nécessité des guenilles, des cadenettes et de la moustache aux talons n’est certainement pas démontrée d’une manière très-rigoureuse; mais l’éleveur de mules repousserait le baudet qui ne les porterait pas."
                                            }
                                        ]
                                    }
                                ]
                            },
