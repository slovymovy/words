                        "target_lang_word": "Zypresse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zypresse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa78c6d1-1e7f-3963-a2aa-9e4caa5eb09d",
                                        "entry_id": "bdb9d2d7-f360-3e2e-9454-234dbf8fa640",
                                        "glosses": [
                                            "Nadelbaum der Gattung Cupressus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a7dcad6-825e-4470-9bab-cde89e845fc7",
                                                "sense_id": "fa78c6d1-1e7f-3963-a2aa-9e4caa5eb09d",
                                                "text": "Die Zypresse in unserem Garten muss gefällt werden."
                                            },
                                            {
                                                "example_id": "2d49c54b-1a6d-4ca5-a77e-741569cba5af",
                                                "sense_id": "fa78c6d1-1e7f-3963-a2aa-9e4caa5eb09d",
                                                "text": "„Zypressen umgaben das Grundstück, und die Morgensonne tauchte das ansehnliche Wohngebäude, den großen Stall und die Pferdekoppel in ein romantisches Licht.“"
                                            },
                                            {
                                                "example_id": "4f53b519-9acc-4071-8345-034494ab365b",
                                                "sense_id": "fa78c6d1-1e7f-3963-a2aa-9e4caa5eb09d",
                                                "text": "„Daß er die Taufsonntage so liebt, liegt nicht allein am heiteren goldgrünen Morgenlicht, das durch die Zweige der Zypressen und Eichen sickert.“"
                                            },
                                            {
                                                "example_id": "f74f7394-5202-48f1-97da-b00917aeee88",
                                                "sense_id": "fa78c6d1-1e7f-3963-a2aa-9e4caa5eb09d",
                                                "text": "„Diese Zypresse ist Isoldes Baum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
