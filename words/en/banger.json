            "senses": [
                {
                    "sense_id": "dfdf510b-17e8-3099-af37-bad3fb34f621",
                    "sense_definition": "A sausage, especially as traditionally prepared and served in Britain.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered traditional <w>bangers</w> and mash at the local pub.",
                            "target_lang_translations": {
                                "ru": "Мы заказали традиционные <w>сосиски</w> с пюре в местном пабе.",
                                "it": "Abbiamo ordinato le tradizionali <w>salsicce</w> con purè al pub locale."
                            }
                        },
                        {
                            "text": "He fried a couple of pork <w>bangers</w> for breakfast.",
                            "target_lang_translations": {
                                "ru": "Он поджарил пару свиных <w>сосисок</w> на завтрак.",
                                "it": "Ha fritto un paio di <w>salsicce</w> di maiale per colazione."
                            }
                        }
                    ],
                    "synonyms": [
                        "snag"
                    ],
                    "common_phrases": [
                        "bangers and mash"
                    ],
                    "traits": [
