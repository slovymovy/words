                                "example_id": "0bf56e44-46b3-47fd-ba2b-2d20ae12c86f",
                                "sense_id": "42435d04-6494-3d65-a782-d9f81f35b56b",
                                "text": "Pieszy ruch graniczny jest źródłem sporego importu towarów na ścianie wschodniej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
