                "senses": [
                    {
                        "sense_id": "d2ec3c72-56ee-3a56-9061-ad54a00a2931",
                        "entry_id": "56844beb-c52a-3463-b986-2939792759bc",
                        "glosses": [
                            "Gerät oder eine Vorrichtung, mit dem ein technischer Gegenstand auf seine Eigenschaften reproduzierbar geprüft werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75b238ec-48eb-4dfc-b74f-d99503c0c4f0",
                                "sense_id": "d2ec3c72-56ee-3a56-9061-ad54a00a2931",
                                "text": "„Im vergangenen Jahr aber wurde bekannt, dass VW ausgerechnet in den bei Deutsche See eingesetzten und als besonders \"umweltverträglich und abgasarm\" beworbenen Autos, eine Software eingesetzt hat, die die niedrigen Schadstoffwerte nur auf dem Prüfstand vorgaukelte.“"
                            },
                            {
                                "example_id": "ce70cd95-2f43-48eb-b83a-e1d45149a7dc",
                                "sense_id": "d2ec3c72-56ee-3a56-9061-ad54a00a2931",
                                "text": "bildlich: „Aus diesem Grund muss alles, woran weiße Amerikaner zu glauben meinen, erneut auf den Prüfstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
