                ],
                "senses": [
                    {
                        "sense_id": "ab868b48-2c0f-3db8-8286-f0907a99957a",
                        "entry_id": "77adad6f-6a04-324c-a419-0109a236b91c",
                        "glosses": [
                            "falsch eingestanztes oder fehlendes Loch in einem Lochstreifen"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "0bc86b53-4661-48ed-9aa5-3533b5e3dffe",
                                "sense_id": "ab868b48-2c0f-3db8-8286-f0907a99957a",
                                "text": "„Aufgrund eines Lochfehlers wurde die Kapitelüberschrift nicht als Titel erkannt.“"
                            },
                            {
                                "example_id": "970cec5a-b222-4ef0-af61-be8465f7348c",
                                "sense_id": "ab868b48-2c0f-3db8-8286-f0907a99957a",
                                "text": "„Die Lochkarten von 19 Fragebögen sind beim Einlesen in den Computer wegen formaler Lochfehler zurückgewiesen worden.“"
                            },
                            {
                                "example_id": "4c44e4a5-0da6-4729-b097-d40e75c2f700",
                                "sense_id": "ab868b48-2c0f-3db8-8286-f0907a99957a",
                                "text": "„Sodann können Lesefehler auftreten, es können trotz richtiger Ablesung Lochfehler geschehen.“"
                            },
                            {
                                "example_id": "42a9a422-9392-4be7-aedc-4c13dbc1a53e",
                                "sense_id": "ab868b48-2c0f-3db8-8286-f0907a99957a",
                                "text": "„Die elektrische Prüfung machte es möglich, alle überhaupt denkbaren Lochfehler einer Karte aufzufinden.“"
                            },
                            {
                                "example_id": "ab081840-1d4a-4d0a-8f0e-4ac43f9796cb",
                                "sense_id": "ab868b48-2c0f-3db8-8286-f0907a99957a",
                                "text": "„Sämtliche Daten wurden auf unmögliche Werte, die durch falsche Übertragung oder Lochfehler entstanden waren, überprüft.“"
                            },
                            {
                                "example_id": "96dd149e-4a6f-41a9-9996-9713d62751d5",
                                "sense_id": "ab868b48-2c0f-3db8-8286-f0907a99957a",
                                "text": "„Dann liegen Additionsfehler bei der Datenaufbereitung oder Lochfehler vor, die nur der Leiter der Systemgruppe berichtigen lassen kann.“"
                            },
                            {
                                "example_id": "1f1cef67-63e8-4c5f-8c4f-a8d6f9d6bf0b",
                                "sense_id": "ab868b48-2c0f-3db8-8286-f0907a99957a",
                                "text": "„Auch das manuelle Lochen ist um einen zweiten Arbeitsgang, das Prüflochen, zu ergänzen, um Lochfehler zu verringern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e0e0b85e-b8a9-33be-a4d4-4711ad359951",
                        "entry_id": "77adad6f-6a04-324c-a419-0109a236b91c",
                        "glosses": [
                            "falsch eingelochter Ball"
                        ],
                        "tags": [
                            "Billard",
                            "Snooker"
                        ],
                        "examples": [
                            {
                                "example_id": "d03d3374-7751-480b-921b-376a7345656b",
                                "sense_id": "e0e0b85e-b8a9-33be-a4d4-4711ad359951",
                                "text": "„Dabei hatte Allen, der in Cheltenham an Nummer eins gesetzt ist, dank Breaks von 69 und 87 Punkten die ersten beiden Frames schnell gewonnen. Plötzlich aber häuften sich bei ihm die Lochfehler, so dass er Wilson ins Spiel kommen ließ.“"
                            },
                            {
                                "example_id": "3579e3bf-6f9e-4e83-acac-104913f61af5",
                                "sense_id": "e0e0b85e-b8a9-33be-a4d4-4711ad359951",
                                "text": "„Im ersten Viertelfinale kam John Higgins gegen Allister Carter mit 0:5 unter die Räder. Der Schotte konnte nicht an seine Leistungen im Achtelfinale anknüpfen und machte eine Reihe von Lochfehlern, die Carter sofort bestrafte.“"
                            },
                            {
                                "example_id": "19d40b2a-81cf-486c-a0d3-b446db9b170e",
                                "sense_id": "e0e0b85e-b8a9-33be-a4d4-4711ad359951",
                                "text": "„Ein Lochfehler bei der vorletzten Kugel kostete letztendlich den vierten Satz und damit auch das Spiel, dass wieder mit 2:3 Sätzen verloren wurde.“"
                            },
                            {
                                "example_id": "2c6a4512-694d-4797-9717-b6ee7f1f951b",
                                "sense_id": "e0e0b85e-b8a9-33be-a4d4-4711ad359951",
                                "text": "„Die entscheidende Session ging der Schotte offensiv an. Zwar verlor [er] den ersten Frame nach einem Lochfehler, die nächsten drei Frames entschied er aber für sich und schaffte damit nach dem 3:3 erstmal wieder einen ausgeglichenen Spielstand.“"
                            },
                            {
                                "example_id": "5b3cf02a-e132-40e6-affc-32f4248e85f8",
                                "sense_id": "e0e0b85e-b8a9-33be-a4d4-4711ad359951",
                                "text": "„Neil Robertson und Ali Carter konnten beide nicht an ihre Leistungen aus den Runden zuvor anknüpfen. Immer wieder schlichen sich einfache und ungewöhnliche Lochfehler in das Spiel beider ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
