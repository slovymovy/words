                        "entry_id": "09d24c43-4b2d-3ba4-a218-188d9b77b836",
                        "glosses": [
                            "The bicyclic aromatic compound 1,2-benzopyrone or any of its derivatives."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "68ee22c2-8fde-447e-9f4f-57623deef985",
                                "sense_id": "1a6f5aa3-1fbe-3c4f-864d-2146eb2b79f4",
                                "text": "The postulated mechanism for the reaction of coumarin 4 as an antioxidant, as indicated in Fig 3, relies on the mercapto hydrogen atom (bold), which is under the influence of resonance and inductive effects."
                            },
                            {
                                "example_id": "6b9f7a24-e767-4f8f-9a19-68ae236010fc",
                                "sense_id": "1a6f5aa3-1fbe-3c4f-864d-2146eb2b79f4",
                                "text": "Coumarin's spicy, balsamic, and sweet vanilla scent is valued by perfume and flavor industries, but it may also add a hint of tobacco to a perfume blend or enhance lavender in a scent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ea99da5-977e-401f-8777-b2e6826421aa",
                        "source_entry_id": "09d24c43-4b2d-3ba4-a218-188d9b77b836",
                        "source_sense_id": "1a6f5aa3-1fbe-3c4f-864d-2146eb2b79f4",
                        "source_sense_description": "aromatic compound",
                        "target_lang_word": "coumarine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coumarine",
