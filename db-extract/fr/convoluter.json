                "senses": [
                    {
                        "sense_id": "f5bfbc5e-ff9f-321f-a0e2-6587cfb5570d",
                        "entry_id": "2c3bbf79-69ba-3fc5-9c83-774c8a231992",
                        "glosses": [
                            "Enrouler ensemble depuis un sommet, en papillote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "801cafa7-7f47-4b75-88b5-d78f4ddb34ff",
                                "sense_id": "f5bfbc5e-ff9f-321f-a0e2-6587cfb5570d",
                                "text": "Les deux bords se rapprochent et s'unissent au sommet sans pour ainsi dire se convoluter."
                            },
                            {
                                "example_id": "ab70aa7c-35a1-41c7-adb0-3e28294ceb1b",
                                "sense_id": "f5bfbc5e-ff9f-321f-a0e2-6587cfb5570d",
                                "text": "Les spermatozoïdes, au lieu de se convoluter en papillotes, s'enroulent plusieurs ensemble circulairement, et superposent leurs divers tours de spire, de manière à figurer un anneau, ou mieux un court cylindre creux de cordes enroulées."
                            }
                        ]
                    }
