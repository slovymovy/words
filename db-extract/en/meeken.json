                        "glosses": [
                            "To make or become meek or submissive."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2ca9d16b-33b1-409c-86c2-8bd9317adf03",
                                "sense_id": "94acad4b-de75-36b3-9d62-d93544952be4",
                                "text": "Tear each other's flesh no more,\nBut kindly think and speak the same;\nAll express the meekening power\nAnd spirit Of the Lamb!"
                            },
                            {
                                "example_id": "b8812117-b064-43ea-8a9d-8d43ec04751f",
                                "sense_id": "94acad4b-de75-36b3-9d62-d93544952be4",
                                "text": "\"Whenever Helen sleeps, her fevered rest meekens her; hence, she re-emerges enfeebled -- her strength, expended; her reserves, depleted.\""
                            }
                        ]
                    }
