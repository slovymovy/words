                        "sense_id": "e7b6442c-af5d-359d-946a-f269fb65c5ff",
                        "entry_id": "a860d875-0e91-38bb-894f-6e290c452231",
                        "glosses": [
                            "plek van enorm verdriet, in christelijke opvatting: het aardse bestaan in tegenstelling tot het hemelse"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2fd82ca8-1ca0-33a4-becb-5ddacd78b517",
                        "entry_id": "a860d875-0e91-38bb-894f-6e290c452231",
