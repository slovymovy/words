                    "frequency": "VeryLow",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The solo violin seemed to <w>yearn</w> with an almost unbearable sadness."
                        },
                        {
                            "text": "Every line of the poem <w>yearns</w> with romantic melancholy."
