                    "sense_id": "c4820f06-4b60-3fd7-9f4d-f7ed05b6ee1f",
                    "sense_definition": "Kledingstukken of schoeisel van het lichaam verwijderen.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "kleding_uitdoen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet je schoenen <w>uit</w> te <w>doen</w> als je binnenkomt.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>take off</w> your shoes when you come inside."
                            }
                        },
                        {
                            "text": "Hij <w>deed</w> zijn warme jas <w>uit</w> omdat het binnen erg warm was.",
                            "target_lang_translations": {
                                "en": "He <w>took off</w> his warm coat because it was very warm inside."
                            }
                        }
                    ],
                    "synonyms": [
                        "uittrekken"
                    ],
                    "antonyms": [
                        "aandoen",
                        "aantrekken"
                    ],
                    "common_phrases": [
                        "je schoenen uitdoen",
                        "je jas uitdoen"
                    ],
                    "target_lang_definitions": {
                        "en": "To remove clothing or footwear from the body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take off",
                                "target_lang_sense_clarification": "clothing or shoes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0578a81-8d43-3584-9284-f88dbd7b5077",
                    "sense_definition": "Een apparaat, lamp of vuur uitschakelen of doven.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "uitschakelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wil je het licht <w>uitdoen</w> als je de kamer verlaat?",
                            "target_lang_translations": {
                                "en": "Would you mind <w>turning off</w> the light when you leave the room?"
                            }
                        },
                        {
                            "text": "Hij <w>deed</w> de televisie <w>uit</w> en ging meteen naar bed.",
                            "target_lang_translations": {
                                "en": "He <w>turned off</w> the television and went straight to bed."
                            }
                        }
                    ],
                    "antonyms": [
                        "aandoen"
                    ],
                    "common_phrases": [
                        "het licht uitdoen",
                        "de televisie uitdoen"
                    ],
                    "target_lang_definitions": {
                        "en": "To turn off or extinguish a device, light, or fire."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "switch off",
                                "target_lang_sense_clarification": "appliances or lights"
                            },
