                "senses": [
                    {
                        "sense_id": "dc3b016b-9a9b-38b8-b507-e8733dd7e5f8",
                        "entry_id": "6544e224-6e09-3564-aaee-23e3eaf49e4c",
                        "glosses": [
                            "weibliche Person, die eine Bildungseinrichtung verlässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbfc2af8-3e59-4102-a04f-4265926b692d",
                                "sense_id": "dc3b016b-9a9b-38b8-b507-e8733dd7e5f8",
                                "text": "„Auf dem Nerv hatte Schatzkanzler Gordon Brown herumgebohrt, als er Oxford des \"Elitismus\" bezichtigte - die medizinische Fakultät des Magdalen College hatte die Abgängerin einer staatlichen Schule trotz lauter Einser im Abitur nicht zum Studium zugelassen.“"
                            },
                            {
                                "example_id": "4dc840de-38ca-4aeb-bf65-2a6d522e08db",
                                "sense_id": "dc3b016b-9a9b-38b8-b507-e8733dd7e5f8",
                                "text": "„So gibt es zum Beispiel verschiedene Untersuchungen, die zeigen, dass Abgängerinnen und Abgänger von Mädchen- beziehungsweise Bubenschulen bessere Noten haben als ihre Kollegen von gemischten Schulen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
