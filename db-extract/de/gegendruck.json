                ],
                "senses": [
                    {
                        "sense_id": "138d83a6-7c14-33a3-9d44-77c1a837f1b9",
                        "entry_id": "c1b5a8d9-63f6-3a8a-8e98-4e6179096c12",
                        "glosses": [
                            "Gegenteil der Kraft (Druck), die auf etwas einwirkt; Kraft, die sich widersetzt"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "19a12fe9-f6b4-4226-8803-63fb0c1dd4fb",
                                "sense_id": "138d83a6-7c14-33a3-9d44-77c1a837f1b9",
                                "text": "„Wird der Druck in der Kammer größer als der Gegendruck der Verschlußklappe, so wird letztere kurz geöffnet, wobei der gekräuselte Inhalt herausschnellt.“"
                            },
                            {
                                "example_id": "f1d8cd85-6563-4138-a8f5-cf3f1383211e",
                                "sense_id": "138d83a6-7c14-33a3-9d44-77c1a837f1b9",
                                "text": "„Die Hand ist fleischig, ohne Gegendruck, die Gesichtshaut bleich, seine Züge wirken intelligent, und die Bewegungen drücken selbstsichere Überlegenheit aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0934d90b-8cf7-3d26-8abb-7e78b87c21f9",
                        "entry_id": "c1b5a8d9-63f6-3a8a-8e98-4e6179096c12",
                        "glosses": [
                            "Bestreben, sich gegen etwas zur Wehr zu setzen, aktiver Widerstand"
                        ],
                        "tags": [
                            "figurative",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "29bd6aec-ecf2-44f5-a0f3-344d297e9f27",
                                "sense_id": "0934d90b-8cf7-3d26-8abb-7e78b87c21f9",
                                "text": "„Und das bedeute wohl eine weitere Eskalation: ‚Unser Druck wird Gegendruck erzeugen.‘“"
                            },
                            {
                                "example_id": "870a9a2a-fe83-4407-bf35-e44f492d3db4",
                                "sense_id": "0934d90b-8cf7-3d26-8abb-7e78b87c21f9",
                                "text": "„Der Druck und der Gegendruck der Gruppeninteressen führten insgesamt zu ausgewogenen und angemessenen Ergebnissen. Drohe ein wichtiges Interesse zu kurz zu kommen, bilde sich eine Gegenmacht, die die Dinge wieder ins Lot bringe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
