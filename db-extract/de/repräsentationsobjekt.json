                ],
                "senses": [
                    {
                        "sense_id": "355b99c9-c075-36e6-b1ed-1d59ddc3b345",
                        "entry_id": "f58ee10f-9627-3125-884f-9398a2d71ad1",
                        "glosses": [
                            "der Repräsentation dienendes Objekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7bc1f35-c316-47b2-914e-7e24fe5934cd",
                                "sense_id": "355b99c9-c075-36e6-b1ed-1d59ddc3b345",
                                "text": "„Der Besitzer Patrick Stoffel könnte sich auch vorstellen, die Liegenschaft an die Gemeinde Steinach oder an den Kanton (als Repräsentationsobjekt) zu verkaufen.“"
                            },
                            {
                                "example_id": "653c8e31-8809-4517-b5af-8a5f0109278f",
                                "sense_id": "355b99c9-c075-36e6-b1ed-1d59ddc3b345",
                                "text": "„Es gab triftige Gründe dafür, daß das deutsche TV-Porträt des britischen Stararchitekten Norman Foster ziemlich umfänglich ausgefallen ist: Foster hat in der Bundesrepublik viele repräsentative Gebäude verwirklicht und betreut außerdem das Repräsentationsobjekt schlechthin, die Neugestaltung des Berliner Reichstages.“"
                            },
                            {
                                "example_id": "42d6a642-4142-448f-8426-4ea070122d66",
                                "sense_id": "355b99c9-c075-36e6-b1ed-1d59ddc3b345",
                                "text": "„An der in Bonn geht der Preisverfall für Repräsentationsobjekte nicht spurlos vorbei: Das einst etwa 28 Millionen Mark teure Schmuckstück wird als \"Schnäppchen\" für 13,5 Millionen Mark angeboten.“"
                            },
                            {
                                "example_id": "9bf4d090-1e04-4294-b80c-e104d2ec6edb",
                                "sense_id": "355b99c9-c075-36e6-b1ed-1d59ddc3b345",
                                "text": "„Der St. Galler Globus ist in erster Linie ein Repräsentationsobjekt, wie es sich Fürsten gern leisteten, um ihre Affinität zur Wissenschaft zu unterstreichen.“"
                            },
                            {
                                "example_id": "b285b467-daa7-400c-a61e-e1413d1eed0a",
                                "sense_id": "355b99c9-c075-36e6-b1ed-1d59ddc3b345",
                                "text": "„Ursprünglich stammt der Stuhl vom Thron ab, der sich von der Antike bis ins 19. Jahrhundert vom Ehrensitz hin zum bürgerlichen Repräsentationsobjekt wandelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
