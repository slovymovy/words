                        "sense_id": "36af89f6-13b9-3e4d-8853-65bcd0179595",
                        "entry_id": "e96e34db-ffe1-3cdd-9861-fe5e1953dd25",
                        "glosses": [
                            "Commune de la province d’Anvers de la région flamande de Belgique."
