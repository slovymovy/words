                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Levite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8d676cd-5e75-3131-9280-3332b7802373",
                                        "entry_id": "398a7f21-192e-36bf-af19-de4a665c1c72",
                                        "glosses": [
                                            "A member of the Hebrew tribe of Levi, particularly in its role as a priestly caste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e36388d-4af0-4178-8bb9-4f7daf570a2c",
                                                "sense_id": "a8d676cd-5e75-3131-9280-3332b7802373",
                                                "text": "And there was a young man out of Bethlehemjudah of the family of Judah, who was a Levite, and he sojourned there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bd2abea-470c-313d-aefc-d1bbb6cfab5f",
                                        "entry_id": "398a7f21-192e-36bf-af19-de4a665c1c72",
                                        "glosses": [
                                            "A clergyman."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "068e6760-c205-33e8-9fab-6002569f7122",
                                        "entry_id": "398a7f21-192e-36bf-af19-de4a665c1c72",
                                        "glosses": [
                                            "A type of loose dress."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c1e0bce-5cdd-4e71-a25b-eff0d4ebd377",
                                                "sense_id": "068e6760-c205-33e8-9fab-6002569f7122",
                                                "text": "A habit-maker […] is gone stark in love with Lady Ossory, on fitting her with the new dress, I think they call it a Levite, and says he never saw so glorious a figure […] ."
                                            },
                                            {
                                                "example_id": "feeb71b6-0e08-4362-8600-2d232ff083a9",
                                                "sense_id": "068e6760-c205-33e8-9fab-6002569f7122",
                                                "text": "Gainsborough shows her wearing a blue and white striped silk wrapping gown, known as a levite: a clever and subtle choice of costume, vaguely ‘oriental’ in mood, deriving its name from the theatre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Levite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "778aedc9-00c1-3a97-93b5-bf790caaddd8",
                                        "entry_id": "a2d066ef-cf3b-36ec-acfe-2dddf9f0e8d2",
                                        "glosses": [
                                            "Of or related to Levi, the Levites, or their priestly role."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dd1e701-a90b-4b74-9da4-d9ba6a0f16ba",
                        "source_entry_id": "df3dec2a-f0ef-3c24-95dc-609a686e26c5",
                        "source_sense_id": "b656598d-92d8-397f-8d5f-f5e47c30f278",
