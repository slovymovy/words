                "entry_id": "49afe978-d716-3a43-9962-f55b2161151a",
                "word": "aphorist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "92411665-4596-41ea-b8ae-981ef8e41d85",
