            "senses": [
                {
                    "sense_id": "fbc68f4c-0c6f-36dc-88c6-e74ca3872a32",
                    "sense_definition": "A flat piece of baked clay, stone, or other material used for covering roofs, floors, or walls.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "construction_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to replace a broken <w>tile</w> on the roof before it rains.",
                            "target_lang_translations": {
                                "ru": "Нам нужно заменить сломанную <w>черепицу</w> на крыше, пока не пошел дождь.",
                                "tr": "Yağmur yağmadan önce çatıdaki kırık bir <w>kiremiti</w> değiştirmemiz gerekiyor.",
                                "zh": "下雨前我们需要更换屋顶上一块破损的<w>瓦片</w>。",
                                "es": "Necesitamos reemplazar una <w>teja</w> rota en el techo antes de que llueva."
                            }
                        },
                        {
                            "text": "She chose blue ceramic <w>tiles</w> for the bathroom walls.",
                            "target_lang_translations": {
                                "ru": "Она выбрала голубую керамическую <w>плитку</w> для стен ванной.",
                                "tr": "Banyo duvarları için mavi seramik <w>fayanslar</w> seçti.",
                                "zh": "她为浴室墙壁选了蓝色的陶瓷<w>瓷砖</w>。",
                                "es": "Ella eligió <w>azulejos</w> de cerámica azul para las paredes del baño."
                            }
                        }
                    ],
                    "common_phrases": [
                        "floor tiles",
                        "roof tiles",
                        "bathroom tiles",
                        "ceramic tiles",
                        "carpet tiles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоский кусок обожженной глины, камня или другого материала, используемый для покрытия крыш, полов или стен.",
                        "tr": "Çatı, zemin veya duvarları kaplamak için kullanılan pişmiş kil, taş veya diğer malzemelerden yapılmış düz levha.",
                        "zh": "一种用于覆盖屋顶、地板或墙壁的扁平烧制粘土、石材或其他材料。",
                        "es": "Pieza plana de arcilla cocida, piedra u otro material, utilizada para cubrir techos, suelos o paredes."
                    },
                    "translations": {
