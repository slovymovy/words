                        "glosses": [
                            "Vogel aus der Familie Otididae, welche zur Ordnung der Kranichvögel gezählt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0115151d-9bcf-43c8-b5a4-8d1cfc04b879",
                                "sense_id": "9a259275-310e-34e2-9db3-71d02811b409",
