                "senses": [
                    {
                        "sense_id": "b0237fc5-6f6d-3377-85ee-e97408b46d2d",
                        "entry_id": "8383a90e-41d1-3707-bb8c-9f7130ea85a3",
                        "glosses": [
                            "техн. устройство для проигрывания аудио и видео записей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c30f19-50bc-407e-8fd2-3d3a6e8d5c4e",
                                "sense_id": "b0237fc5-6f6d-3377-85ee-e97408b46d2d",
                                "text": "Проигрывателя у нас не было, вязанием бабушка не занималась, а чтобы пить вино и пользоваться посудой, нужны были гости, которые к нам никогда не ходили."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3661f41c-22b5-4084-a2fb-8a426be66e16",
                        "source_entry_id": "8383a90e-41d1-3707-bb8c-9f7130ea85a3",
                        "source_sense_id": "b0237fc5-6f6d-3377-85ee-e97408b46d2d",
                        "target_lang_word": "player",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "player",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fa9aeb0-ac20-3409-be6e-f12af275461b",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "One that plays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03180ddd-2c12-451a-a728-043b8d29e8cc",
                                                "sense_id": "1fa9aeb0-ac20-3409-be6e-f12af275461b",
                                                "text": "He is an avid Minecraft player."
                                            },
                                            {
                                                "example_id": "268873f7-5e37-4b11-b4c2-5b50ae653b68",
                                                "sense_id": "1fa9aeb0-ac20-3409-be6e-f12af275461b",
                                                "text": "The player is free to create their own narrative within a much larger set of possible designed narrative options, or, given the geographic and dialogical openness of Morrowind, to refuse the creation of any narrative but their own and wander aimlessly through the game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdcb9867-a849-34fe-a0d2-30a964e924f8",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "One that plays.",
                                            "One who plays any game or sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06d22a90-402d-4437-81f7-acb2e8694c46",
                                                "sense_id": "bdcb9867-a849-34fe-a0d2-30a964e924f8",
                                                "text": "He is a player for the Australian team."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6beb90f8-707f-32cc-9865-cfaa57a5ed06",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "One that plays.",
                                            "An actor in a dramatic play."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50fdd150-93ea-4653-9e37-4f521b0b0ad3",
                                                "sense_id": "6beb90f8-707f-32cc-9865-cfaa57a5ed06",
                                                "text": "All the world's a ſtage, / And all the men and women, merely Players"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "141bed61-d5d8-35d4-ac89-18e7946250de",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "One that plays.",
                                            "One who plays on a musical instrument."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "983d70ef-ac67-3e8f-ac36-47b4f104dd3d",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "One that plays.",
                                            "A gamer; a person of video games or similar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfbb9710-0369-308e-a127-3ba50eefccab",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "One that plays.",
                                            "A gambler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "080c6e1d-005e-3206-81b8-b1192b794569",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "One that plays.",
                                            "A mechanism that actuates a player piano or other automatic musical instrument."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60ccc574-759f-47b2-95b9-91013dec2b77",
                                                "sense_id": "080c6e1d-005e-3206-81b8-b1192b794569",
                                                "text": "But up to this time the application of the player mechanism had been confined to reed instruments, the piano manufacturers having successfully resisted the introduction of the player mechanism into the piano; but, in the meantime, the manufacturers of players had grown strong and the manufacturers were beginning to properly interpret the handwriting on the wall"
                                            },
                                            {
                                                "example_id": "52e63797-dedc-416f-a831-f14ff737b1e7",
                                                "sense_id": "080c6e1d-005e-3206-81b8-b1192b794569",
                                                "text": "A Technical Treatise on Piano Player Mechanism\" contains detailed description of the various types of interior and exterior players, embracing manual, pneumatic, automatic, mechanical and electric"
                                            },
                                            {
                                                "example_id": "92c51ae5-58da-43d3-8e7d-28b7c2ee19b9",
                                                "sense_id": "080c6e1d-005e-3206-81b8-b1192b794569",
                                                "text": "Electric players used either a four-lobe rotary pump belt-driven by an electric motor or a self-contained electric motor and ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c453275f-86ae-32c6-af2a-ac33923d2dec",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "One that plays.",
                                            "An electronic device that plays audio or video media."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b9e516-ef9d-43ee-a904-c50a582ed175",
                                                "sense_id": "c453275f-86ae-32c6-af2a-ac33923d2dec",
                                                "text": "Is your CD player broken, or is this one disc damaged?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22dd57dd-b10e-36b3-b6df-f34a87b90bf7",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "One that plays.",
                                            "A software application that plays audio or video media, such as a media player."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cafd8cf3-e9da-36cd-974f-da22260259f5",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "One who is playful; one without serious aims; an idler; a trifler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35c1520a-901f-303e-91cd-8513a7f53813",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "A participant; one involved in something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c56a84a-9e0a-4e8f-ac0d-5d6b78a73311",
                                                "sense_id": "35c1520a-901f-303e-91cd-8513a7f53813",
                                                "text": "He thought he could become a player, at least at the state level."
                                            },
                                            {
                                                "example_id": "c0a1ddbe-e916-4f48-a773-6c0285e82e79",
                                                "sense_id": "35c1520a-901f-303e-91cd-8513a7f53813",
                                                "text": "Decision realities research recognizes the occupational tribalism identified in occupational realities research, but goes further by paying attention to all the players – patients and lay caregivers included – who participate in negotiating care."
                                            },
                                            {
                                                "example_id": "257e6647-f796-45b7-a4f1-a88b36f9e5cb",
                                                "sense_id": "35c1520a-901f-303e-91cd-8513a7f53813",
                                                "text": "Another Bush — George W.’s brother Jeb — is likely to be a big player in the Republican Party’s future."
                                            },
                                            {
                                                "example_id": "d175b7dc-79ab-49e0-88ab-6e0ca73a0741",
                                                "sense_id": "35c1520a-901f-303e-91cd-8513a7f53813",
                                                "text": "As the biggest rail player, Network Rail was usually held accountable for failings, but had no authority to change anything to solve the problems. The DfT had been given that authority in 2004 - but consistently ducked accountability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f26d8de-3507-3de2-84a6-fe93251d22be",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "A participant; one involved in something.",
                                            "One who participates in a particular type of sexual play."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd5f91b3-f9c6-4dc1-98cc-6f12e14f81d4",
                                                "sense_id": "4f26d8de-3507-3de2-84a6-fe93251d22be",
                                                "text": "In this space we explored lesbian sadomasochism, met other S/M women who were serious players, had access to safe equipment and, through watching other women, learned new techniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7e26be3-6ded-3023-bf2f-428f8d2be068",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "A person who plays the field rather than having a long-term sexual relationship."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bccf4ed2-53d1-4093-b847-9323808b2aa1",
                                                "sense_id": "d7e26be3-6ded-3023-bf2f-428f8d2be068",
                                                "text": "Thunder only happens when it’s rainin’ / Players only love you when they’re playin’ / Say women, they will come and they will go / When the rain washes you clean, you’ll know"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5234bf9-cfe1-4373-9e0c-e228d5f6f07e",
                        "source_entry_id": "8383a90e-41d1-3707-bb8c-9f7130ea85a3",
                        "source_sense_id": "b0237fc5-6f6d-3377-85ee-e97408b46d2d",
                        "target_lang_word": "Spieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70c2648e-8a52-389b-a7a8-3facd1504bb1",
                                        "entry_id": "425ca196-556f-3e82-a4f9-afeafd48c9ba",
                                        "glosses": [
                                            "jemand, der in einem Ballsport gegen einen anderen oder eine andere Mannschaft antritt; des Weiteren jemand, der an einem Brett-, Würfel-, Kartenspiel oder einem ähnlichen Gesellschaftsspiel teilnimmt"
                                        ],
                                        "tags": [
                                            "Ballsport",
                                            "Gesellschaftsspiel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c7debf1-7fc0-4c96-90ce-9f1f18ff5ddb",
                                                "sense_id": "70c2648e-8a52-389b-a7a8-3facd1504bb1",
                                                "text": "Eine Fußballmannschaft hat elf Spieler."
                                            },
                                            {
                                                "example_id": "63dcd10e-6e54-4882-b0ed-8137a244856f",
                                                "sense_id": "70c2648e-8a52-389b-a7a8-3facd1504bb1",
                                                "text": "Die jungen Spieler wollen alles geben."
                                            },
                                            {
                                                "example_id": "30183c49-723b-45a3-9e0a-9806e62d7a62",
                                                "sense_id": "70c2648e-8a52-389b-a7a8-3facd1504bb1",
                                                "text": "Die Spieler nahmen am Tisch Platz und wurden sogleich mit Salzstangen und Bier versorgt."
                                            },
                                            {
                                                "example_id": "9bbb3c5b-d314-4978-a6ad-42ddc219a3ff",
                                                "sense_id": "70c2648e-8a52-389b-a7a8-3facd1504bb1",
                                                "text": "„Drei der Spieler wechselten mit anderen ab; der vierte spielte ohne Ablösung durch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f3e0537-43d9-3bb0-bf7a-b6489102613b",
                                        "entry_id": "425ca196-556f-3e82-a4f9-afeafd48c9ba",
                                        "glosses": [
                                            "jemand, der an einem Glücksspiel teilnimmt; jemand, der leidenschaftlich um Geld spielt"
                                        ],
                                        "tags": [
                                            "Glücksspiel",
                                            "im engeren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28023417-580d-4fac-a85a-b8bbabe6f76e",
                                                "sense_id": "6f3e0537-43d9-3bb0-bf7a-b6489102613b",
                                                "text": "Der Spieler verlor Haus und Hof."
                                            },
                                            {
                                                "example_id": "65a35cd9-7442-41f5-ab15-0a9d46649408",
                                                "sense_id": "6f3e0537-43d9-3bb0-bf7a-b6489102613b",
                                                "text": "Er ist und bleibt ein Spieler und wird sich niemals ändern."
                                            },
                                            {
                                                "example_id": "5468b23a-cf63-450c-8ef0-54e72ac52db8",
                                                "sense_id": "6f3e0537-43d9-3bb0-bf7a-b6489102613b",
                                                "text": "„Im Augenblick schienen ihre Liebesängste und -begierden denen eines Süchtigen zu gleichen, eines Alkoholikers, eines Spielers.“"
                                            },
                                            {
                                                "example_id": "bffa9f56-5c44-44ed-86d5-b3e53522b4ee",
                                                "sense_id": "6f3e0537-43d9-3bb0-bf7a-b6489102613b",
                                                "text": "„Roger Militon war aber auch ein Spieler geblieben.“"
                                            },
                                            {
                                                "example_id": "0bffc701-49a3-4535-9d73-bec160f3f80f",
                                                "sense_id": "6f3e0537-43d9-3bb0-bf7a-b6489102613b",
                                                "text": "„Der kühne Spieler wohnte in einem netten, geschmackvoll eingerichteten Haus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "73768d2e-7e16-36c8-9d06-63284a72c659",
                                        "entry_id": "425ca196-556f-3e82-a4f9-afeafd48c9ba",
                                        "glosses": [
                                            "jemand, der ein Musikinstrument oder Theater spielt"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13b2abd9-bd4c-4358-8f74-01ca3a3eef8d",
                                                "sense_id": "73768d2e-7e16-36c8-9d06-63284a72c659",
                                                "text": "In einem ersten Experiment erhielten die Musiker je eine neue und eine alte Geige - was die Spieler aber nicht wussten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
