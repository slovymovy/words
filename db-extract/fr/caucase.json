        "fr-extract.jsonl": [
            {
                "entry_id": "718f7192-c846-388e-8c5e-31bbcd7cd063",
                "word": "Caucase",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bff803a0-796b-3015-9f04-8c8d56a072df",
                        "entry_id": "718f7192-c846-388e-8c5e-31bbcd7cd063",
                        "glosses": [
                            "Chaîne de montagnes qui s’allonge sur 1 200 km, du détroit de Kertch sur la mer Noire à la presqu’île d’Apchéron sur la mer Caspienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e7de507-0201-4f89-b20d-ca13c4f8b8db",
                                "sense_id": "bff803a0-796b-3015-9f04-8c8d56a072df",
                                "text": "Le général nous donna des détails très intéressants sur les langues qui se parlent dans le Caucase, et dont les unes sont aryennes et les autres touraniennes, bien qu'entre les différentes peuplades il y ait une remarquable conformité de mœurs et de coutumes."
                            },
                            {
                                "example_id": "b5517c5b-13b0-40f1-a7d4-3501664c7df8",
                                "sense_id": "bff803a0-796b-3015-9f04-8c8d56a072df",
                                "text": "Après un long et intéressant trajet à travers les provinces de la Russie méridionale, j’avais franchi le Caucase et je comptais bien me reposer dans la capitale de la Transcaucasie…"
                            },
                            {
                                "example_id": "6bd0f229-f098-4f1a-964f-8ea02b214045",
                                "sense_id": "bff803a0-796b-3015-9f04-8c8d56a072df",
                                "text": "Le Roi des Rois est enfin revenu dans sa capitale. Il a conquis le monde jusqu’aux rives de la mer Rouge, jusqu’aux monts arides du Caucase, jusqu’aux terres inviolées où la neige tombe même en été."
                            },
                            {
                                "example_id": "654b0bee-fc03-4083-be52-2ec59af1e7fc",
                                "sense_id": "bff803a0-796b-3015-9f04-8c8d56a072df",
                                "text": "En 1223, première alerte. Du Caucase dévale une nuée de cavaliers. Ce n’est plus une horde : c’est une armée structurée, disciplinée d’un immense empire […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd9a060f-9c6a-4672-9329-d2762e78f629",
                        "source_entry_id": "718f7192-c846-388e-8c5e-31bbcd7cd063",
                        "source_sense_id": "bff803a0-796b-3015-9f04-8c8d56a072df",
                        "target_lang_word": "Kaukasus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaukasus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "291af1e6-4457-3895-a51e-1000441e8d0b",
                                        "entry_id": "372cfba8-363d-3392-8fcc-ef96bdf78cce",
                                        "glosses": [
                                            "Hochgebirge zwischen Schwarzem Meer und Kaspischem Meer an der Grenze zwischen Europa und Asien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dcc20c0-34dd-417e-b09e-6a5e6e07747f",
                                                "sense_id": "291af1e6-4457-3895-a51e-1000441e8d0b",
                                                "text": "Georgien liegt größtenteils im Kaukasus."
                                            },
                                            {
                                                "example_id": "f91409a7-74a0-458d-9a7c-16319acab273",
                                                "sense_id": "291af1e6-4457-3895-a51e-1000441e8d0b",
                                                "text": "„Im Kaukasus angekommen, gehen wir immer sofort zur Post.“"
                                            },
                                            {
                                                "example_id": "4121c97c-83b3-4d21-a044-e842f5f85368",
                                                "sense_id": "291af1e6-4457-3895-a51e-1000441e8d0b",
                                                "text": "„Eine Gruppe Menschen zog damals aus dem nördlichen Kaukasus quer durch Zentralasien in das Gebiet des heutigen Jakutiens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8593859-0400-4b65-b0d1-676aa8ea2ecd",
                        "source_entry_id": "718f7192-c846-388e-8c5e-31bbcd7cd063",
                        "source_sense_id": "bff803a0-796b-3015-9f04-8c8d56a072df",
                        "target_lang_word": "Caucasus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Caucasus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                        "entry_id": "bce24e08-b003-357a-9fa6-dbd2b8f17df7",
                                        "glosses": [
                                            "A mountain range in Eastern Europe between the Black Sea and the Caspian Sea, on territory of Russia, Georgia, Armenia and Azerbaijan, which includes the ranges of Greater Caucasus and Lesser Caucasus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65c993bf-7a32-4c4a-95a4-4af707b82173",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "Oh who can hold a fire in his hand / By thinking on the froſtie Caucaſus? / Or cloy the hungry edge of appetite, / by bare imagination of a Feaſt?"
                                            },
                                            {
                                                "example_id": "b74f08f7-7969-4c4f-84f3-4479ffb3007b",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "[…] from the long and rugged ravines of the Caucasus, […]"
                                            },
                                            {
                                                "example_id": "f4e5c499-0503-4d56-8812-2afad6ae7c13",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "Driven with that weak blast which Winter leaves, / Closing his palace gates on Caucasus, / […]"
                                            },
                                            {
                                                "example_id": "09c49ae9-6d64-4ce0-b255-f77724707bbe",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "Germany, Italy, Spain and Belgium writhed in the throes of Anarchy, while Russia, watching from the Caucasus, stooped and bound them one by one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd53359d-cbac-3ce2-8292-57062a060a52",
                                        "entry_id": "bce24e08-b003-357a-9fa6-dbd2b8f17df7",
                                        "glosses": [
                                            "A geopolitical region in Eastern Europe and Western Asia, deriving its name from the aforementioned mountains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
