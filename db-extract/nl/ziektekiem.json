                                "target_senses": [
                                    {
                                        "sense_id": "57912419-378e-346c-b3a0-fa1a69fc275f",
                                        "entry_id": "4cd6aaf4-65b8-3594-8b5e-eb2d462e1581",
                                        "glosses": [
                                            "The small mass of cells from which a new organism develops; a seed, bud, spore, or zygote.",
                                            "The embryo of a seed, especially of a seed used as a cereal or grain. See Wikipedia article on cereal germ."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb47e04a-c454-3f7f-9432-e07fc1def9c5",
                                        "entry_id": "4cd6aaf4-65b8-3594-8b5e-eb2d462e1581",
                                        "glosses": [
                                            "The small mass of cells from which a new organism develops; a seed, bud, spore, or zygote.",
                                            "The small mass of cells from which a part of an organism develops, or a macroscopic but immature form of that part; a bud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb249b72-d902-441c-9c92-16c23f8cfe6a",
                                                "sense_id": "eb47e04a-c454-3f7f-9432-e07fc1def9c5",
                                                "text": "surgical removal of germs of wisdom teeth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "585a81de-d0e3-38e0-8e84-6043cc33f59b",
                                        "entry_id": "4cd6aaf4-65b8-3594-8b5e-eb2d462e1581",
                                        "glosses": [
                                            "A pathogen: a pathogenic microorganism, such as a bacterium or virus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1693c7e9-adf1-44a6-a99e-1681ada8d917",
                                                "sense_id": "585a81de-d0e3-38e0-8e84-6043cc33f59b",
                                                "text": "'This again,' said the Bacteriologist, slipping a glass slide under the microscope, 'is a preparation of the celebrated Bacillus of cholera - the cholera germ.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82d820ee-11fe-3b4c-8e0c-55e164987614",
                                        "entry_id": "4cd6aaf4-65b8-3594-8b5e-eb2d462e1581",
                                        "glosses": [
                                            "The origin or earliest version of an idea or project."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a085d7ea-872f-4dd1-b56f-dcb8ff65dc4b",
                                                "sense_id": "82d820ee-11fe-3b4c-8e0c-55e164987614",
                                                "text": "the germ of civil liberty"
                                            },
                                            {
                                                "example_id": "c4ffd26f-972f-4f1d-bbc6-a8b210c1559a",
                                                "sense_id": "82d820ee-11fe-3b4c-8e0c-55e164987614",
                                                "text": "Now all his ponderings, however excursive, wheeled round Isabel as their center; and back to her they came again from every excursion; and again derived some new, small germs for wonderment."
                                            },
                                            {
                                                "example_id": "d6aec55b-e8a1-4f30-bfd3-396e3f44558f",
                                                "sense_id": "82d820ee-11fe-3b4c-8e0c-55e164987614",
                                                "text": "What greatness had not floated on the ebb of that river into the mystery of an unknown earth? - the dreams of men, the seed of commonwealths, the germs of empires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72c5b061-c413-3f2b-a169-f95abe5a5e8e",
                                        "entry_id": "4cd6aaf4-65b8-3594-8b5e-eb2d462e1581",
                                        "glosses": [
                                            "An equivalence class that includes a specified function defined in an open neighborhood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "germ",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73e7155d-6579-3be0-9eb8-4574a2d4417f",
                                        "entry_id": "854ce0b1-1f41-3e53-b680-cd8d698e9ce4",
                                        "glosses": [
                                            "To germinate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56582c36-c35e-448b-b206-851b11142102",
                                                "sense_id": "73e7155d-6579-3be0-9eb8-4574a2d4417f",
                                                "text": "Thus tempted, the lust to avenge me / Germed inly and grew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0cc8b4b-f8ee-3d9b-a884-02d117873054",
                                        "entry_id": "854ce0b1-1f41-3e53-b680-cd8d698e9ce4",
                                        "glosses": [
                                            "To grow, as if parasitic."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50b8d9dc-ea99-4729-b873-e47c7664fc19",
                                                "sense_id": "b0cc8b4b-f8ee-3d9b-a884-02d117873054",
                                                "text": "I’m addicted, want to germ inside your love"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08bc7488-f21a-4025-b333-5a9581742068",
                        "source_entry_id": "c963b901-5998-33f0-b442-eda1d18577a0",
                        "source_sense_id": "6ae499d2-e2dc-312e-a45f-bb097952fafd",
                        "source_sense_description": "een micro-organisme dat ziekte veroorzaakt",
                        "target_lang_word": "microbe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microbe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fa70bcc-65c4-3891-8ed2-a3dae3edc094",
                                        "entry_id": "8ba2487c-f6d4-3372-a1ee-6a59bc3a643f",
                                        "glosses": [
                                            "Organisme vivant qui ne peut être vu qu’en utilisant un microscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da115474-9c8d-49e0-acc5-6999a4df35b5",
                                                "sense_id": "4fa70bcc-65c4-3891-8ed2-a3dae3edc094",
                                                "text": "Et l’air, mon Claudin, l’air reniflable, risquais-je avec rusticité? — Tu renifles ? Et les microbes ! Prends garde !"
                                            },
                                            {
                                                "example_id": "882ecd83-93fc-418f-8490-f714f8c9c5c0",
                                                "sense_id": "4fa70bcc-65c4-3891-8ed2-a3dae3edc094",
                                                "text": "On sait que le microbe de la peste est un cocco-bacille appartenant au genre Pasteurella, dont les différentes espèces produisent les septicémies hémorragiques des animaux."
                                            },
                                            {
                                                "example_id": "8a9dc4f8-f7f3-4f99-847b-9991b072a693",
                                                "sense_id": "4fa70bcc-65c4-3891-8ed2-a3dae3edc094",
                                                "text": "La pellicule … est composée de nanoparticules de céramique. Ce produit était déjà utilisé depuis une dizaine d’années dans la fabrication d’instruments chirurgicaux. Il a la caractéristique de détruire les microbes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cbccdf4-7443-34e6-81e1-433b93d645c1",
                                        "entry_id": "8ba2487c-f6d4-3372-a1ee-6a59bc3a643f",
                                        "glosses": [
                                            "Avorton, nain, personne de petite taille."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d2b7a2e-b557-4383-8345-d1688d9cda1f",
                                                "sense_id": "3cbccdf4-7443-34e6-81e1-433b93d645c1",
                                                "text": "Ça m’aurait étonné que tu ne sois pas là, microbe ! dit M. Heaume en me cueillant le poignet."
                                            },
                                            {
                                                "example_id": "554ff138-77d7-4a98-a48b-cba45b0cffa4",
                                                "sense_id": "3cbccdf4-7443-34e6-81e1-433b93d645c1",
                                                "text": "Holà, microbe! Tache^([sic]) de filer en vitesse sinon..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01f19b63-d68b-3205-a65b-f7db7f1783b2",
                                        "entry_id": "8ba2487c-f6d4-3372-a1ee-6a59bc3a643f",
                                        "glosses": [
                                            "Tout agent pathogène, vecteur de transmission invisible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b67cbf4-0672-4626-89d6-f3c75fba4f2f",
                                                "sense_id": "01f19b63-d68b-3205-a65b-f7db7f1783b2",
                                                "text": "Il doit y avoir un microbe du rire."
                                            },
                                            {
                                                "example_id": "7543b427-ab7b-4d13-904e-f7971d12af8d",
                                                "sense_id": "01f19b63-d68b-3205-a65b-f7db7f1783b2",
                                                "text": "La tristesse […] C’est un poison, un microbe qu’on a tort de cultiver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f828792-1729-39af-b971-35a8a433d3f2",
                                        "entry_id": "8ba2487c-f6d4-3372-a1ee-6a59bc3a643f",
                                        "glosses": [
                                            "Personne méprisable, malfaisante, qui répand le mal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3742a9f-1b83-41e4-b793-d01d2f1b9b45",
                                                "sense_id": "6f828792-1729-39af-b971-35a8a433d3f2",
                                                "text": "La délégation des gauches ! Ce seul nom évoque des palabres […] toute une faune de couloirs en marge de la vraie vie, une agitation de microbes au dedans d’un grand corps qu’ils n’ont pas conscience de détruire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5067e869-1d58-3fd3-a2d7-6332b5ea2831",
                                        "entry_id": "8ba2487c-f6d4-3372-a1ee-6a59bc3a643f",
                                        "glosses": [
                                            "Enfant criminel, souvent issu de la rue."
                                        ],
                                        "tags": [
                                            "Côte d’Ivoire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
