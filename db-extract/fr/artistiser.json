                "senses": [
                    {
                        "sense_id": "db9d6373-5e49-3d41-9f9b-5b9ddcb69f9e",
                        "entry_id": "58c06471-d6fa-3253-aa4b-f7e9f386acf2",
                        "glosses": [
                            "Donner un caractère artistique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ae5af7-56e4-4a79-acfc-65096a1337e3",
                                "sense_id": "db9d6373-5e49-3d41-9f9b-5b9ddcb69f9e",
                                "text": "En retour, certaines contraintes deviendront éventuellement des éléments importants sur lesquels l’acte de composition s’appuiera, soit pour les élaborer, les « artistiser », soit pour les contrarier."
                            },
                            {
                                "example_id": "bd7dcba6-5157-4402-8cc0-5a1628247781",
                                "sense_id": "db9d6373-5e49-3d41-9f9b-5b9ddcb69f9e",
                                "text": "On cherchait à « artistiser » l’école, le logement ouvrier, les jardins publics, la poterie modeste, aussi bien que la bijouterie ou l’architecture de villas et d'hôtels, en estimant que tous les progrès seraient parallèles et solidaires."
                            }
                        ]
                    }
