                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f6c45cb-a3de-4e21-a364-ffdc55104252",
                                                "sense_id": "3aff0006-5768-3c92-99e4-e6a5feeb2a27",
                                                "text": "Dad went into orbit when I told him that I'd crashed the car."
                                            },
