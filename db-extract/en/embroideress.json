                                    {
                                        "sense_id": "1f10b5e9-a4b9-39d2-97f8-5d7e34199356",
                                        "entry_id": "014e85db-6210-3561-ac85-f27fb0436313",
                                        "glosses": [
                                            "Celle qui brode."
                                        ],
                                        "tags": [
                                            "Broderie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18896127-4e50-4cad-bd2c-cd80e06c8421",
                                                "sense_id": "1f10b5e9-a4b9-39d2-97f8-5d7e34199356",
                                                "text": "Ne te moque pas de moi ; je sais très bien broder, d’ailleurs ; et n’y a-t-il pas une ville quelque part par là où il faille des brodeuses ?"
                                            },
                                            {
                                                "example_id": "8786fe4f-8644-4dcc-b37e-750314a44a37",
                                                "sense_id": "1f10b5e9-a4b9-39d2-97f8-5d7e34199356",
                                                "text": "Et voici son unique héritage : sous la boîte fragile, cette soie emmêlée comme les écheveaux des brodeuses aux doigts lisses, qui chantent en travaillant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10f26df1-a6d3-3ab2-b37f-b02ef2571bf2",
                                        "entry_id": "014e85db-6210-3561-ac85-f27fb0436313",
                                        "glosses": [
                                            "Celle qui brode en parlant, qui embellit ce qu’elle raconte."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f0bfad9-00c2-3e41-be99-5f019533b5ae",
                                        "entry_id": "014e85db-6210-3561-ac85-f27fb0436313",
                                        "glosses": [
                                            "Machine qui permet de broder."
                                        ],
                                        "tags": [
                                            "Broderie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "169b40a2-f445-402c-8a94-02a7cd542cc1",
                        "source_entry_id": "33cff21f-5837-3f81-aca3-ba9a236cfe71",
                        "source_sense_id": "90690033-1d2e-3a2b-8966-4561894f1b47",
                        "source_sense_description": "female embroiderer",
                        "target_lang_word": "Stickerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stickerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "335bebe9-3fbc-389d-8e29-49c8ffb50722",
                                        "entry_id": "05ad126d-cb91-3584-ac91-c77fe53b3cb3",
                                        "glosses": [
                                            "weibliche Person, die mit Nadel und Faden/Stickgarn Gewebe verziert, indem sie Zierstiche setzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eaf9f33-e20d-49fb-97f7-c985b38d97a9",
                                                "sense_id": "335bebe9-3fbc-389d-8e29-49c8ffb50722",
                                                "text": "Sie war eine Künstlerin am Stickrahmen, ein Ausnahmetalent unter den Stickerinnen des Viertels."
                                            },
                                            {
                                                "example_id": "fc203517-88d2-43cc-a09b-6451a15c6320",
                                                "sense_id": "335bebe9-3fbc-389d-8e29-49c8ffb50722",
                                                "text": "Die Tochter verdiente ihr Geld als Stickerin von Monogrammen, die sie in Heimarbeit für ein Wäschegeschäft anfertigte."
                                            },
                                            {
                                                "example_id": "bc5b69d6-0736-4608-b52f-5800dae492fe",
                                                "sense_id": "335bebe9-3fbc-389d-8e29-49c8ffb50722",
                                                "text": "„Das traf mich wie ein Blitz aus heiterem Himmel; aber ich nahm seinen Verweis kaltblütig hin und sagte, ich würde die Zeit, die ich bisher bei der Stickerin verbracht hätte, fortan anderswo zubringen.“"
                                            },
                                            {
                                                "example_id": "f1432f9d-c91c-4366-af98-b14543a8f9f8",
                                                "sense_id": "335bebe9-3fbc-389d-8e29-49c8ffb50722",
                                                "text": "„Das galt nicht nur für Stickerinnen, sondern auch für Knopfgießer, Hutmacher, Schuhmacher, Goldschmiede und Strickerinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
