                        "sense_id": "c09f119c-7496-3284-9d50-ce08fb3050cb",
                        "entry_id": "69d3dcd3-3fc9-37ff-b74d-652ed43f8387",
                        "glosses": [
                            "aggressive Rhetorik, bei der direkt oder indirekt mit Krieg gedroht wird"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "bac8bce2-4bc5-4005-8975-d6010cccd495",
                                "sense_id": "c09f119c-7496-3284-9d50-ce08fb3050cb",
                                "text": "„Die Drohungen und die Kriegsrhetorik der USA haben Nordkorea erfolgreich Angst eingejagt – und nun glaubt das Regime, der einzige Weg des Selbstschutzes bestehe darin, atomar aufzurüsten.“"
                            },
                            {
                                "example_id": "2470f483-50ae-4076-a637-909668672435",
                                "sense_id": "c09f119c-7496-3284-9d50-ce08fb3050cb",
                                "text": "„Ein zweiter Aspekt der Radikalisierung des Antisemitismus im öffentlichen Diskurs waren die nationalistischen Kriegsrhetoriken in der Abgeordnetenkammer und in der konservativen Presse.“"
                            }
                        ],
