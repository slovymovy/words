                        ],
                        "form": "overwintering"
                    },
                    {
                        "form_id": "2225ea8c-5b41-407a-802c-00d927d17914",
                        "entry_id": "532925c8-2312-33b1-a0c6-790ce9ea8fa0",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "overwintered"
                    },
                    {
                        "form_id": "10628ee1-0541-4e89-a5ce-a5689ffdeb8d",
                        "entry_id": "532925c8-2312-33b1-a0c6-790ce9ea8fa0",
                        "tags": [
                            "past"
                        ],
                        "form": "overwintered"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8456554-3b9d-32df-b589-92932c191111",
                        "entry_id": "532925c8-2312-33b1-a0c6-790ce9ea8fa0",
                        "glosses": [
                            "To keep or preserve for the winter."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7ecc9bfa-7406-40f4-aa8b-50c92912b2b5",
                                "sense_id": "b8456554-3b9d-32df-b589-92932c191111",
                                "text": "It is best to overwinter tender plants indoors."
                            },
                            {
                                "example_id": "568db9f1-c4b7-412e-9afb-7b97b68a5a78",
                                "sense_id": "b8456554-3b9d-32df-b589-92932c191111",
                                "text": "Well, if you're fortunate, you'll be able to overwinter your bees and keep them alive during the winter months."
                            },
                            {
                                "example_id": "8ba14a56-17fd-451a-ba09-eb4fcefb7710",
                                "sense_id": "b8456554-3b9d-32df-b589-92932c191111",
                                "text": "We overwinter our blueberry bushes in an unheated greenhouse, but when re-tubbed this year they will be too big to move. What are their chances of surviving winter outside?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b76b3ebf-bfeb-3bfc-977f-3fed94265928",
                        "entry_id": "532925c8-2312-33b1-a0c6-790ce9ea8fa0",
                        "glosses": [
                            "To spend the winter (in a particular place)."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "26664976-e497-448c-baf3-828e3c7fbf08",
                                "sense_id": "b76b3ebf-bfeb-3bfc-977f-3fed94265928",
                                "text": "Insects may overwinter in fallen fruit if it is not removed."
                            },
                            {
                                "example_id": "206edbfb-99eb-42db-a28c-c32b27eed36a",
                                "sense_id": "b76b3ebf-bfeb-3bfc-977f-3fed94265928",
                                "text": "Fish only overwinter in streams having a sufficient source of groundwater."
                            },
                            {
                                "example_id": "5e163fbd-4bee-444c-b6e4-e80afe28e28d",
                                "sense_id": "b76b3ebf-bfeb-3bfc-977f-3fed94265928",
                                "text": "Different insects also differ in the way in which they overwinter. Most insects overwinter as eggs or pupae, but others overwinter as larvae or nymphs, whilst quite a few hibernate in the adult phase."
                            },
                            {
                                "example_id": "82859769-353b-4dbb-906d-5a1ebd777a33",
                                "sense_id": "b76b3ebf-bfeb-3bfc-977f-3fed94265928",
                                "text": "'Early Purple Sprouting' broccoli is so hardy you can let it overwinter and it rewards you with—yes, you guessed it—early purple sprouts that are tender and delicious."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6e12e91-c2ae-43a0-b162-052527936ecd",
                        "source_entry_id": "532925c8-2312-33b1-a0c6-790ce9ea8fa0",
                        "source_sense_description": "to keep or preserve for the winter",
                        "target_lang_word": "přezimovat",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "přezimovat",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d5d069db-738b-30fc-a196-c22218b95bda",
                                        "entry_id": "4ff7f86f-e71e-30c3-b30c-31f666c3fa28",
                                        "glosses": [
                                            "přečkat / přečkávat zimu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb787fdf-77bf-4690-95b6-78b8713e0b42",
                                                "sense_id": "d5d069db-738b-30fc-a196-c22218b95bda",
                                                "text": "V Blatné již potřetí přezimoval pár čápů bílých, samec dokonce počtvrté."
                                            },
                                            {
                                                "example_id": "35bfb657-5ba9-4d86-93e2-9bfbbd6d48dd",
                                                "sense_id": "d5d069db-738b-30fc-a196-c22218b95bda",
                                                "text": "Během zimy chraňte svůj nábytek před deštěm a mrazem. Nejlepší je nechat jej přezimovat v garáži, ve sklepě nebo v přístřešku se zabezpečeným prouděním vzduchu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f457cd1-0913-4928-953d-50c68817efe0",
                        "source_entry_id": "532925c8-2312-33b1-a0c6-790ce9ea8fa0",
