                            {
                                "example_id": "35468b40-ef1d-4e5d-8e45-8714df121ac5",
                                "sense_id": "9265b3c7-eb6c-3e03-8919-f1f655527150",
                                "text": "A man shambled from between two buildings, holding out a bottle in his left hand. He kept his right hand close to his body. \"Have a drinkie with me, girls!\" he called. \"Drinkie, drinkie!\""
                            },
                            {
                                "example_id": "59087163-ff6c-427c-bb66-3010e1a7a63d",
                                "sense_id": "9265b3c7-eb6c-3e03-8919-f1f655527150",
                                "text": "\"Buy me drinkie. Buy me drinkie. Buy me drinkie.\" If you were sober, you'd usually have the sense to make the girls scram the second they descended on you. But if you were beyond a drunken haze, the girls could get increasingly better looking, and \"Buy me drinkie\" you might."
                            }
                        ]
