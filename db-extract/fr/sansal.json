                        "glosses": [
                            "Courtier, agent de change, agent de banque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a44da1-1555-4a5f-8ac0-5f96ca18ac3e",
                                "sense_id": "d09d13a1-8706-3fa8-9eef-c30376a90c65",
                                "text": "Les banquiers et les négociants qui remettent les lettres de change aux sansaux pour les négocier, les signent en blanc avec le jour de la remise ; les sansaux les donnent de même à ceux qui les prennent, sans leur être d'aucune garantie, à moins de convention expresse ; en ce cas le sansal remplit l'ordre en sa faveur, et passe le sien à celui à qui il remet la lettre ou le billet."
                            }
                        ]
                    }
