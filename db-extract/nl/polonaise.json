                        "entry_id": "ae2ee1e6-88f9-3abf-9c20-505f0368a46b",
                        "glosses": [
                            "een oorspronkelijk Poolse dans waarbij men achter elkaar loopt met de handen op de schouders van de voorgaande persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e09feb2-f07d-4009-8669-8adc73c16bcc",
                                "sense_id": "3f89fb6f-81a5-39c1-b1da-8b7259682e32",
                                "text": "De polonaise wordt onder andere gedanst op bruiloften en tijdens carnaval. Ook tijdens discofeesten wordt de polonaise veel gedanst."
                            },
                            {
                                "example_id": "a5d21bdd-e1f3-4e6d-b3bf-dbb65a4701c2",
                                "sense_id": "3f89fb6f-81a5-39c1-b1da-8b7259682e32",
                                "text": "Op een vrijdagmiddag speelde ik een polonaise van Chopin. Nog voor ik bij de laatste akkoordenpassage aankwam, greep ik de partituur en scheurde de bladzijden over de lengte doormidden. Ik greep het papier en perste het laatste leven uit mijn werkweek."
                            }
                        ]
                    }
