                ],
                "senses": [
                    {
                        "sense_id": "b14a8048-e7a7-3b78-a1b3-067985c5c32a",
                        "entry_id": "1ca9b30b-70fe-3e5d-ba65-92a79c08a109",
                        "glosses": [
                            "Rendre vil et méprisable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8754e54-b516-419a-b8a3-e701cefa6743",
                                "sense_id": "b14a8048-e7a7-3b78-a1b3-067985c5c32a",
                                "text": "Une si étrange dépravation qui nous fait voir d’un côté combien notre orgueil nous enfle, et de l’autre combien notre sensualité nous ravilit…"
                            },
                            {
                                "example_id": "03f25c6a-c59a-49c1-ab26-b902b645717c",
                                "sense_id": "b14a8048-e7a7-3b78-a1b3-067985c5c32a",
                                "text": "Ô qu’il était éloigné de ces prédicateurs infidèles qui ravilissent leur dignité jusqu’à faire servir au désir de plaire le ministère d’instruire !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e35cfc5f-526c-3508-aec4-56131c321ec5",
                        "entry_id": "1ca9b30b-70fe-3e5d-ba65-92a79c08a109",
                        "glosses": [
                            "Devenir vil et méprisable."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "ff676b62-4046-42d3-8f63-fbb95ede323d",
                                "sense_id": "e35cfc5f-526c-3508-aec4-56131c321ec5",
                                "text": "Ce que Jésus-Christ est venu chercher du ciel en terre, ce qu’il a cru pouvoir, sans se ravilir, racheter de son sang, n’est-ce qu’un rien ?"
                            },
                            {
                                "example_id": "6f99ead8-ade8-4fa9-9e02-8e313b7431fe",
                                "sense_id": "e35cfc5f-526c-3508-aec4-56131c321ec5",
                                "text": "Il ravilit entièrement l'autorité des Conciles, prétendant qu'ils n'ont pouvoir que de consulter & d'exécuter."
                            }
                        ]
                    }
                ],
