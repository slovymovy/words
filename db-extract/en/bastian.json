                                            {
                                                "example_id": "d9c7f1dc-c62b-4954-b3ce-6849c2fb742a",
                                                "sense_id": "fabd2083-2b72-3e11-a083-8801ea7a005d",
                                                "text": "Bastien lui possède un superposé qui appartenait à son grand-père dont je ne connais la marque et lui non plus d’ailleurs."
                                            },
                                            {
                                                "example_id": "eee9eef5-a9ca-4343-a848-5c51742d3cb3",
                                                "sense_id": "fabd2083-2b72-3e11-a083-8801ea7a005d",
                                                "text": "Le troisième ligne de Pau Jordan Joseph a dû déclarer forfait pour la tournée d’automne avec l’équipe de France. C’est un autre débutant, Bastien Vergnes-Taillefer, de l’Union Bordeaux-Bègles, qui le remplace dans la liste des 42 joueurs retenus par Fabien Galthié."
                                            },
                                            {
                                                "example_id": "b61977bf-9200-434a-863b-2c64a70940c0",
                                                "sense_id": "fabd2083-2b72-3e11-a083-8801ea7a005d",
                                                "text": "Ce premier film est très librement inspiré d’Une sœur, bande dessinée de Bastien Vivès, parue chez Casterman."
                                            }
                                        ]
                                    }
                                ]
