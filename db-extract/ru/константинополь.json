                                        "sense_id": "769c8795-61aa-306a-be59-e1f823ce74d7",
                                        "entry_id": "d36287ef-5362-3c84-9167-e0a0e0c925ec",
                                        "glosses": [
                                            "città dell'Europa sudorientale, fondata dall'imperatore romano Costantino nel 330 in luogo dell'antica Bisanzio, capitale dell'impero bizantino fino al 1453 e poi conquistata dai Turchi e ribattezzata Istanbul"
                                        ],
