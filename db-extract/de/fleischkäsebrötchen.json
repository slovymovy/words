                "senses": [
                    {
                        "sense_id": "8ad7d5cb-5fa7-37fb-ba0f-e004fb3c944c",
                        "entry_id": "12ce6659-2e72-3186-9d55-30d3ecca0aaa",
                        "glosses": [
                            "mit Fleischkäse belegtes Brötchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f31dd111-cfae-4dfb-82eb-0cf7ba4a50c5",
                                "sense_id": "8ad7d5cb-5fa7-37fb-ba0f-e004fb3c944c",
                                "text": "„Neben verschiedenen hausgemachten Kuchen und Torten gab es auch Fleischkäsebrötchen.“"
                            },
                            {
                                "example_id": "ee747cb0-21a1-49e9-9037-8c706bee2a70",
                                "sense_id": "8ad7d5cb-5fa7-37fb-ba0f-e004fb3c944c",
                                "text": "„Ich gebe es zu, all dies schmerzt mich, denn selbst Fleischkäsebrötchen können einem ans Herz wachsen, fast wie ein Lieblingsparfüm, das plötzlich vom Markt verschwindet.“"
                            },
                            {
                                "example_id": "cdc686c7-3abe-41b4-baa9-82fe9bbe376c",
                                "sense_id": "8ad7d5cb-5fa7-37fb-ba0f-e004fb3c944c",
                                "text": "„Ich hatte eine Freistunde, bin zum Bäcker und habe mir ein Fleischkäsebrötchen geholt.“"
                            },
                            {
                                "example_id": "7dae9a2e-4151-4243-8938-2dc34dad3895",
                                "sense_id": "8ad7d5cb-5fa7-37fb-ba0f-e004fb3c944c",
                                "text": "„Seit den Ferien gibt es nun in der Mensa auch Schnitzel-, Frikadellen- und Fleischkäsebrötchen zu kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
