                                    {
                                        "sense_id": "9cbdae43-7e2c-3c89-a193-0ac3acb53b43",
                                        "entry_id": "9b55ecaf-52a2-3d21-9126-dc354ee4279e",
                                        "glosses": [
                                            "Qui joue des farces."
