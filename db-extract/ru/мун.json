                "senses": [
                    {
                        "sense_id": "c5b5eb62-828e-3cf9-8478-6b5327206ad6",
                        "entry_id": "57901b69-d17a-3ebc-8756-983e4b63cf4d",
                        "glosses": [
                            "корейская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75e41aa9-b885-414d-81dd-00ded30f6601",
                                "sense_id": "c5b5eb62-828e-3cf9-8478-6b5327206ad6",
                                "text": "Кстати, недавно скончавшийся Мун Сон Мен, основатель пресловутой Церкви Объединения, в самой Корее известен мало и воспринимается скорее как фигура одиозная и одновременно курьезная."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d03589c8-43f2-4703-9258-52698fc1f54d",
                        "source_entry_id": "57901b69-d17a-3ebc-8756-983e4b63cf4d",
                        "source_sense_id": "c5b5eb62-828e-3cf9-8478-6b5327206ad6",
                        "target_lang_word": "Moon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6afe11e4-bf3d-33a6-a553-774b60fb9930",
                                        "entry_id": "aa30fb8c-ae8c-3727-b4f0-7cdbdfdd449e",
                                        "glosses": [
                                            "The Earth's moon; the sole natural satellite of the Earth, represented in astronomy and astrology by ☾."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eb16d4a-a336-4df0-81fd-51401587d066",
                                                "sense_id": "6afe11e4-bf3d-33a6-a553-774b60fb9930",
                                                "text": "I kind of have two Moons up there. I look at the Moon just like everybody else who's never been there. But every once in a while I do think of the second Moon, the one that I recall from up close and, yeah, it is kind of hard to believe that I was actually up there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "769e87e4-1d86-3200-8cb4-8c22f9cd5683",
                                        "entry_id": "aa30fb8c-ae8c-3727-b4f0-7cdbdfdd449e",
                                        "glosses": [
                                            "A personification of the moon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a21f3b8-efc6-4e04-8fdd-f18e82c95dc2",
                                                "sense_id": "769e87e4-1d86-3200-8cb4-8c22f9cd5683",
                                                "text": "Women's rhythm of life, her monthly renewal with her patroness the Moon, is the most important thing in her existence."
                                            },
                                            {
                                                "example_id": "867c81b8-e054-44c3-8227-acb2e777ab53",
                                                "sense_id": "769e87e4-1d86-3200-8cb4-8c22f9cd5683",
                                                "text": "Moon, the companion of Night, waxes and wanes, and we call this time a month."
                                            },
                                            {
                                                "example_id": "b340f7f1-5972-4530-bfae-b535b1c64ec7",
                                                "sense_id": "769e87e4-1d86-3200-8cb4-8c22f9cd5683",
                                                "text": "Moon's Day."
                                            },
                                            {
                                                "example_id": "77f75a08-63a6-41f2-b3bd-0f953ae0b78b",
                                                "sense_id": "769e87e4-1d86-3200-8cb4-8c22f9cd5683",
                                                "text": "Sun come, Moon come, Seed time, dry time, fog and rain, Sowing, growing, reaping, resting, Sun come, Moon come, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24c39737-09c8-317d-8264-598740c2cfd8",
                                        "entry_id": "aa30fb8c-ae8c-3727-b4f0-7cdbdfdd449e",
                                        "glosses": [
                                            "The 54th sura (chapter) of the Qur'an."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
