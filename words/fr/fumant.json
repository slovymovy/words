                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serveur a apporté une tasse de café bien <w>fumante</w> sur la table.",
                            "target_lang_translations": {
                                "en": "The waiter brought a cup of coffee, <w>steaming</w> hot, to the table.",
                                "ru": "Официант принёс на стол чашку горячего кофе, ещё <w>дымящуюся</w>.",
                                "de": "Der Kellner brachte eine richtig <w>dampfende</w> Tasse Kaffee an den Tisch.",
                                "es": "El camarero llevó a la mesa una taza de café bien <w>humeante</w>.",
                                "zh": "服务员把一杯<w>热气腾腾</w>的咖啡端到了桌上。"
                            }
                        },
                        {
                            "text": "Les pompiers inspectaient attentivement les décombres encore <w>fumants</w> de la vieille grange.",
                            "target_lang_translations": {
                                "en": "The firefighters carefully inspected the still <w>smoking</w> debris of the old barn.",
                                "ru": "Пожарные тщательно осматривали ещё <w>дымящиеся</w> развалины старого амбара.",
                                "de": "Die Feuerwehrleute untersuchten sorgfältig die noch <w>rauchenden</w> Trümmer der alten Scheune.",
                                "es": "Los bomberos inspeccionaban con atención los escombros todavía <w>humeantes</w> del viejo granero.",
                                "zh": "消防员仔细检查着老谷仓那些还<w>冒烟的</w>废墟。"
                            }
                        }
                    ],
                    "antonyms": [
                        "froid",
                        "éteint"
                    ],
                    "common_phrases": [
