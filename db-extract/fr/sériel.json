                    {
                        "sense_id": "afb183c2-762e-3103-b5ff-676d13ce33ba",
                        "entry_id": "aaec249a-b72b-3375-8867-624e6d044111",
                        "glosses": [
                            "Relatif à la série, aux séries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a59ff52b-3a0a-45c0-b3b9-02eeaa206b8e",
                                "sense_id": "afb183c2-762e-3103-b5ff-676d13ce33ba",
                                "text": "Un menteur sériel comme lui est pathologiquement incapable de faire la différence entre la vérité et le mensonge."
                            },
                            {
                                "example_id": "1884e369-820d-45de-a7ab-462bb83b0f35",
                                "sense_id": "afb183c2-762e-3103-b5ff-676d13ce33ba",
                                "text": "Il faut qu'elles portent «sur des faits extrêmement graves comme les viols sériels, les disparitions d'enfants, les assassinats...», souligne le procureur."
                            },
                            {
                                "example_id": "77932d18-7ace-4753-acf8-1eed458fd9f5",
                                "sense_id": "afb183c2-762e-3103-b5ff-676d13ce33ba",
                                "text": "Résultat : D’argent et de sang est certainement la meilleure proposition sérielle française depuis Le Bureau des légendes."
                            }
                        ]
                    }
                ],
