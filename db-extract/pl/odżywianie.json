                    },
                    {
                        "translation_id": "c3e5effc-70f5-4eb2-b51d-18185da37654",
                        "source_entry_id": "92acf972-151d-3ee6-a5d0-956ab0b178b4",
                        "source_sense_id": "f92c5fd2-8955-36cc-9e50-c0f42c16b7ce",
                        "target_lang_word": "Ernährung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ernährung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                        "entry_id": "828f1cd3-6948-3041-bd76-433260e6bc85",
                                        "glosses": [
                                            "die Zufuhr von Nahrung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16eb78c6-002e-41f9-ae02-dd30b75772e2",
                                                "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                                "text": "Bei der Ernährung der Babys ist die Unterstützung der Mütter notwendig."
                                            },
                                            {
                                                "example_id": "20c000a9-2501-45a4-8d54-50409db9c515",
                                                "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                                "text": "„Die Ernährung von Großvieh war schwierig und teuer, insbesondere in der Trockenzeit im Sommer.“"
                                            },
                                            {
                                                "example_id": "a27c661f-b79c-410b-8ad1-ae4645847a0b",
                                                "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                                "text": "„Das Leben im Ruhestand wird unter dem Gesichtspunkt der Sinnfindung, möglicher neuer Aufgaben, der körperlichen Bewegung, des Reisens, der angemessenen Ernährung beschrieben.“"
                                            },
                                            {
                                                "example_id": "ea40b3d3-0889-4b7b-b9f2-d9b0a10bba0b",
                                                "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                                "text": "„Eine Stunde, bevor das Abendessen serviert wurde, kam eine Ernährungsberaterin und legte mir nahe, in Zukunft meine Ernährung zu ändern und den von mir auf Nachfrage gebeichteten horrenden Süßigkeitenkonsum drastisch einzuschränken.“"
                                            },
                                            {
                                                "example_id": "d409549d-9c80-412a-8421-ae4d579b81b8",
                                                "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                                "text": "„Das war schon seit Gründung der Schule so: Niemand schritt ein, als im frühen 20. Jahrhundert fast die Hälfte der Kinder an der Schule starb – vor allem an Tuberkulose, die sich in den vollen Schlafsälen und bei schlechter Ernährung rasch verbreitete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "01050b58-0c61-3423-b656-bb68bf3bf91d",
                                        "entry_id": "828f1cd3-6948-3041-bd76-433260e6bc85",
                                        "glosses": [
                                            "die Nahrung selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c64111-0510-42d1-acc4-b5ac69cdacab",
                                                "sense_id": "01050b58-0c61-3423-b656-bb68bf3bf91d",
                                                "text": "Obst ist gut als Ernährung für zwischendurch."
                                            },
                                            {
                                                "example_id": "f3fcf17f-810f-4384-87bb-25cdd30ba0c7",
                                                "sense_id": "01050b58-0c61-3423-b656-bb68bf3bf91d",
                                                "text": "„Rudolph erkundet aber auch, wie Ernährung den Altersprozess beeinflusst.“"
                                            },
