                "senses": [
                    {
                        "sense_id": "640b5442-e92c-3ea9-bc85-6b562c6f8305",
                        "entry_id": "260e8764-1c22-3be9-a159-c4da1595e801",
                        "glosses": [
                            "feitelijk, dus zonder een waardeoordeel te vellen over een zaak of persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a604f6a-dd4e-4427-ab77-bfc6f0607284",
                                "sense_id": "640b5442-e92c-3ea9-bc85-6b562c6f8305",
                                "text": "Maar dat hij op de loonlijst van GroenLinks stond en bevriend was met Klaver gaf de doorslag. 'Dan heb je de schijn tegen, en kun je niet verder. Het spreekwoord is ten slotte: wiens brood men eet, wiens woord men spreekt. Dat past niet bij een waardevrij, objectief journalistiek product.'"
                            },
                            {
                                "example_id": "f7ad010c-6435-4321-b839-755c18e59681",
                                "sense_id": "640b5442-e92c-3ea9-bc85-6b562c6f8305",
                                "text": "Overigens zet het Rijksmuseum met Goede Hoop een nieuwe stap om, zoals de vorige directeur Wim Pijbes al voorzag, uit te groeien tot het nationale museum - en nu dus, onder diens opvolger Taco Dibbits, ook het nationale geweten. Volgende halte: de grote Slavernij-tentoonstelling in 2020. Het Rijksmuseum als een waardevrije kunstinstelling kan weleens zijn beste tijd hebben gehad."
                            }
                        ]
                    }
