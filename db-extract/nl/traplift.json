                ],
                "senses": [
                    {
                        "sense_id": "b733cd43-77da-38d8-86d1-aa6bb855220d",
                        "entry_id": "34f42156-1c2e-3b14-840d-afeea136e55c",
                        "glosses": [
                            "stoel die wordt voortbewogen door een elektromotor over een rail die is bevestigd op een trap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bcaf741-629f-4745-a172-1149f3b8d768",
                                "sense_id": "b733cd43-77da-38d8-86d1-aa6bb855220d",
                                "text": "Het gaat om kosten voor bijvoorbeeld bouwkundige aanpassingen aan de woning, of voor technologische snufjes die het makkelijker maken zelfstandig te functioneren, ook als mensen bijvoorbeeld op latere leeftijd moeilijk ter been zijn. Te denken valt aan traplift of maatregelen die bijvoorbeeld valpartijen in de badkamer kunnen voorkomen."
                            },
                            {
                                "example_id": "a12cbba1-3c5c-45b6-be2d-2e56276deb95",
                                "sense_id": "b733cd43-77da-38d8-86d1-aa6bb855220d",
                                "text": "De adviseurs inspecteren samen met de bewoners de vertrekken van de woning en geven hen praktische tips om het huis te verbeteren. De adviseurs kijken naar de toegankelijkheid van het huis. Drempels kunnen lager of zelfs helemaal worden verwijderd en wellicht moet er een traplift komen."
                            },
                            {
                                "example_id": "b3605656-4843-4266-a62c-a468f39b5a2c",
                                "sense_id": "b733cd43-77da-38d8-86d1-aa6bb855220d",
                                "text": "Dan pakken ze de loopfiets. Voor een afstand van meer dan een kilometer, staat de rolstoel klaar. In huis is een traplift. \"Als ik bij vriendinnetjes ga spelen, helpen die meisjes mij de trap op. Dan gaat hun mama altijd achter me lopen\", vertelt Mara."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b9a698a-9f4b-4c0e-8d11-34a690287e23",
                        "source_entry_id": "34f42156-1c2e-3b14-840d-afeea136e55c",
                        "source_sense_id": "b733cd43-77da-38d8-86d1-aa6bb855220d",
                        "target_lang_word": "Treppenlift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treppenlift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f3b616e-dd71-3143-92d8-3a4d60eeba40",
                                        "entry_id": "2206b074-dde3-35f3-ac19-9b1e9196b617",
                                        "glosses": [
                                            "Gerät in Form eines auf einer Schiene montierten Sitzes, das eine Person eine Treppe hinauf- und hinunterbefördern kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a79c6b61-4b30-4a93-ab44-c60fa568e427",
                                                "sense_id": "9f3b616e-dd71-3143-92d8-3a4d60eeba40",
                                                "text": "Gehbehinderte Personen können sich durch einen Treppenlift ein gewisses Maß an Eigenständigkeit bewahren."
                                            },
                                            {
                                                "example_id": "4dce79e7-f869-4696-8bf7-1da5253bd9ef",
                                                "sense_id": "9f3b616e-dd71-3143-92d8-3a4d60eeba40",
                                                "text": "„An dem hölzernen Geländer, das sich in den ersten Stock windet, ist ein Treppenlift befestigt.“"
                                            },
                                            {
                                                "example_id": "8f973edc-f696-42f7-af06-54c826037d3e",
                                                "sense_id": "9f3b616e-dd71-3143-92d8-3a4d60eeba40",
                                                "text": "„Sie hatte sich einen Treppenlift bis in den obersten Stock bauen lassen, wo sie wohnte, auf diese Weise konnte sie weiterhin ein und aus gehen, obwohl ihre Beine nicht mehr wollten, langsam kam sie das Geländer entlanggeschwebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
