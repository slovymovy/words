                ],
                "senses": [
                    {
                        "sense_id": "01f68ad8-db36-3e9e-a7ed-9a08583096ca",
                        "entry_id": "5c76a953-f374-3a39-a0df-a342c40bd8b8",
                        "glosses": [
                            "Manière de parler et d’agir contraire au bon sens, à la bienséance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72d36b82-ba13-4fb6-b785-b96d40378ade",
                                "sense_id": "01f68ad8-db36-3e9e-a7ed-9a08583096ca",
                                "text": "Conduite pleine d’incongruités."
                            },
                            {
                                "example_id": "571080ab-1812-4371-a81d-7670acecb10b",
                                "sense_id": "01f68ad8-db36-3e9e-a7ed-9a08583096ca",
                                "text": "Le seul sourire de l’abbé eût déjà fait comprendre à la comtesse l’incongruité de sa question."
                            },
                            {
                                "example_id": "1627d711-3f1c-494c-974e-f8fbb8c2a0fc",
                                "sense_id": "01f68ad8-db36-3e9e-a7ed-9a08583096ca",
                                "text": "J’ai rougi comme si j’avais commis une incongruité."
                            }
                        ]
                    },
                    {
                        "sense_id": "64a69a09-ac36-3011-b764-fa48936c2b9d",
                        "entry_id": "5c76a953-f374-3a39-a0df-a342c40bd8b8",
                        "glosses": [
                            "Extranéité à une règle de syntaxe décrite dans une grammaire prescrite."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c9f4c26b-51cc-49e0-8a7e-a9ae72fac93f",
                                "sense_id": "64a69a09-ac36-3011-b764-fa48936c2b9d",
                                "text": "Vous n’avez pas ici un repas fort savant, et vous y trouverez des incongruités de bonne chère et des barbarismes de bon goût."
                            }
                        ]
                    },
                    {
                        "sense_id": "28a1f49a-d598-33fc-b07c-060d3402f52f",
                        "entry_id": "5c76a953-f374-3a39-a0df-a342c40bd8b8",
                        "glosses": [
                            "Chose jugée comme sale qu’on n’oserait pas faire, ni même nommer en société, c’est-à-dire, selon Littré, une « flatuosité bruyante »."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d5318161-d73d-469f-8ace-90ad1b2981be",
                                "sense_id": "28a1f49a-d598-33fc-b07c-060d3402f52f",
                                "text": "Il a fait une incongruité."
                            },
                            {
                                "example_id": "4addf457-058c-46f4-9477-1f4f0fb47433",
                                "sense_id": "28a1f49a-d598-33fc-b07c-060d3402f52f",
                                "text": "... l'oncle Joseph, (...) véritable patriarche paysan, à qui cependant il arrivait de se soulever légèrement au cours du repas pour lâcher une sonore incongruité dont il s'excusait courtoisement devant les reproches résignés de sa femme."
                            }
                        ]
                    }
                ],
                "translations": [
