                                        "entry_id": "e33c470d-f086-3ecb-8ce6-1be70609fa2e",
                                        "glosses": [
                                            "iemand die aangesteld is in een door de overheid beheerde dienst"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4274f026-ddd9-41d7-a374-8276d0fed623",
                                                "sense_id": "f492c3b3-e1de-393a-abed-8a1abba091f9",
                                                "text": "Er is morgen een vergadering van alle ambtenaren."
                                            },
                                            {
                                                "example_id": "1d11a05b-384e-47ff-841f-d634f3b385b5",
                                                "sense_id": "f492c3b3-e1de-393a-abed-8a1abba091f9",
                                                "text": "Dan maakte zijn vader van de gelegenheid gebruik om zijn zoon, zijn enige, ten overstaan van de ongeïnteresseerde ambtenaar te prijzen."
                                            },
                                            {
                                                "example_id": "6d91eb20-4fdd-44e4-84d1-dd7ad1d8fc9a",
                                                "sense_id": "f492c3b3-e1de-393a-abed-8a1abba091f9",
                                                "text": "Maar de politici of ambtenaren, of allebei aangezien ze toch een en dezelfde waren, verzekerden dat deze huurregeling, die vorig jaar was ingevoerd, een tijdelijke maatregel was om de problemen van de gewone mensen in de crisistijd waarin ze nu leefden tegen te gaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
