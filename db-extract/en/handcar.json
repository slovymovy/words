                        "entry_id": "556f1332-e4ba-3270-88a8-138c5f679cc9",
                        "glosses": [
                            "A light railroad car propelled by a hand-operated pumping mechanism"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bff5e881-046f-4e90-a25c-b95a6851b9ca",
                                "sense_id": "ae1e3d85-8900-34b0-9dad-3582b72dadac",
                                "text": "Yours goes up and mine goes down / and then we do it the other way around. / Don't you give me that sigh, cause if we can't see eye-to-eye / then our missions will be always filled with strife, / cause a handcar is a metaphor for life."
                            },
                            {
                                "example_id": "012621fb-cfb7-4e75-8e1c-e4eee16a15c2",
                                "sense_id": "ae1e3d85-8900-34b0-9dad-3582b72dadac",
                                "text": "A small handcar rested on the tracks, its iron pump waiting for a human touch to animate it."
                            }
                        ]
                    }
                ],
