                                            {
                                                "example_id": "7e36abdb-d3fe-4264-9bc1-2f08ce8eb8c2",
                                                "sense_id": "33f5dac7-729c-36e3-b0fd-eefe210e2a94",
                                                "text": "Cäsar fährt gern mit der Kutsche durch den Wald."
                                            },
                                            {
                                                "example_id": "a371baeb-caf9-429c-a71c-995a4002d389",
                                                "sense_id": "33f5dac7-729c-36e3-b0fd-eefe210e2a94",
                                                "text": "Die Scharfzüngigkeit Cäsars ist berüchtigt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Cäsar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b02ab52-653f-30d7-bf8d-1e0d3e16d051",
                                        "entry_id": "3f58c7fc-6725-3807-a063-191b5ff0bf13",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8861f185-9383-40da-aac4-36c16f950175",
                                                "sense_id": "0b02ab52-653f-30d7-bf8d-1e0d3e16d051",
                                                "text": "In Frau Doktor Cäsars Tierarztpraxis werden Hunde von Obdachlosen kostenlos behandelt."
                                            },
                                            {
                                                "example_id": "7e4e8ffa-bd6e-4200-a5bf-0d5f257a8f02",
                                                "sense_id": "0b02ab52-653f-30d7-bf8d-1e0d3e16d051",
                                                "text": "Dies ist das Büro, in dem Herr Cäsar ab morgen arbeiten wird."
                                            },
                                            {
                                                "example_id": "d80d64af-dbd8-4f0c-9340-517dd74789d5",
                                                "sense_id": "0b02ab52-653f-30d7-bf8d-1e0d3e16d051",
                                                "text": "Cäsar senior ist im Wellnessurlaub."
                                            },
                                            {
                                                "example_id": "befb6ed0-2b59-437f-9fb9-280212191b75",
                                                "sense_id": "0b02ab52-653f-30d7-bf8d-1e0d3e16d051",
                                                "text": "Die kleine Cäsar hilft ihren Tanten beim Zimmern des Dachstuhls."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Cäsar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32d2cae0-bd1f-312c-b118-80067fa37746",
                                        "entry_id": "372dace3-77ba-3d02-b818-4b938d035a01",
                                        "glosses": [
                                            "Titel für den römischen Kaiser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cde0c72-c957-401c-bc79-da9fa21a5a38",
                                                "sense_id": "32d2cae0-bd1f-312c-b118-80067fa37746",
                                                "text": "Warum ist das Rom der Cäsaren untergegangen? Woher sein Sittenzerfall? Ein englischer Historiker bietet eine neue Erklärung an."
                                            },
                                            {
                                                "example_id": "0761029d-e6fe-4b96-9a19-f61b69fdfd88",
                                                "sense_id": "32d2cae0-bd1f-312c-b118-80067fa37746",
                                                "text": "„Dass er sich gern als Strichjunge verkleidet in Tavernen herumtrieb und Kamelfersen aß, mag man dem Cäsaren verzeihen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7c99595-6230-436e-9cef-b159be32537d",
                        "source_entry_id": "1b7b1ad0-aad4-35d5-b90e-652341d86f57",
                        "source_sense_id": "e5c6d3b1-89f4-3221-9c82-1765e7470b1a",
