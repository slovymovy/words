                        "examples": [
                            {
                                "example_id": "2daf9020-9289-4583-9194-27959c2745bd",
                                "sense_id": "ba600213-8f68-35ce-8174-bd91a487dcf5",
                                "text": "„Im Zeitraum vom 4. November 1971 bis zum 18. Juni 1973 fungierte Leopold Gratz als Geschäftsführender Klubobmann des Klubs der Sozialistischen Abgeordneten und Bundesräte, bis er als Nachfolger des wegen einer nicht wunschgemäß ausgegangenen Volksbefragung über die Verbauung des Sternwarteparks zurückgetretenen Felix Slavik zum neuen Wiener Bürgermeister gewählt wurde.“"
                            },
                            {
                                "example_id": "4d1ab642-aead-4351-802b-c2f64cd445c8",
                                "sense_id": "ba600213-8f68-35ce-8174-bd91a487dcf5",
                                "text": "„Die gegen massive Kritik von der Regierungsmehrheit durchgedrückten unverbindlichen Volksbefragungen verstoßen gegen die Bayerische Verfassung.“"
                            }
                        ],
