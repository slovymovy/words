                "senses": [
                    {
                        "sense_id": "38bc9686-ac5e-3807-bf3e-883be2a98ddd",
                        "entry_id": "3eea8b34-e6b9-30f0-bf5b-cfa630ac37c8",
                        "glosses": [
                            "Unterbrechung einer Tätigkeit, um sich auszuruhen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c758dc9-9da1-47b6-baef-14d430f3ffe4",
                                "sense_id": "38bc9686-ac5e-3807-bf3e-883be2a98ddd",
                                "text": "„Die Kapelle machte eine Erholungspause.“"
                            },
                            {
                                "example_id": "a3951e27-ea71-429d-874c-37b02a463c49",
                                "sense_id": "38bc9686-ac5e-3807-bf3e-883be2a98ddd",
                                "text": "„In der Erholungspause betrachteten mich meine Kameraden aus dem Schlafsaal, die alle mindestens in der Philosophieklasse waren, voll Geringschätzung, und während sie untereinander ihre hochgeistigen Thesen besprachen, machten sie sich über mich lustig, weil ich aufmerksam ihrer Diskussion zuhörte, die für mich unverständlich sein mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
