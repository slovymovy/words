                ],
                "senses": [
                    {
                        "sense_id": "f8469d7a-6040-301f-83b9-ee2441a2b4ed",
                        "entry_id": "4ee87fc6-1d72-32db-9511-06009f75a2ac",
                        "glosses": [
                            "Donner un caractère confucéen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9844bf2-b72d-49e5-9b1f-cda17c61f7b9",
                                "sense_id": "f8469d7a-6040-301f-83b9-ee2441a2b4ed",
                                "text": "De nombreux rites et cérémonies autochtones furent sinisés et « confucéanisés.»"
                            },
                            {
                                "example_id": "6b324d07-4718-4190-8428-c5a879a6e9f1",
                                "sense_id": "f8469d7a-6040-301f-83b9-ee2441a2b4ed",
                                "text": "Le travail que je me propose de vous exposer est donc littéraire, à la charnière du discours social confucéanisé et des phénomènes textualisés."
                            },
                            {
                                "example_id": "ae734d72-9785-45ef-a106-62df15856ea6",
                                "sense_id": "f8469d7a-6040-301f-83b9-ee2441a2b4ed",
                                "text": "Le Viêt Nam communiste offre en effet la particularité d'être né d'une guerre nationale prolongée et non d'une révolution sociale, au sein d'une société agraire faiblement urbanisée et fortement confucéanisée."
                            }
                        ]
                    }
