                    {
                        "translation_id": "674217e8-fab7-44c1-9be5-5e03f9cc53d5",
                        "source_entry_id": "c826a24a-dae9-3323-915d-caf71926f1c4",
                        "source_sense_id": "506e13ed-4916-3ae9-ad9c-7eb5b4895f9f",
                        "source_sense_description": "glänzend, strahlend",
                        "target_lang_word": "strahlend",
