                    {
                        "sense_id": "cce7e5d8-ddc8-3820-88fb-5b111a220cff",
                        "entry_id": "ebfaf6eb-fe88-3f11-b84c-c09fbcb2030a",
                        "glosses": [
                            "jedno z powtórzeń działania, algorytmu lub procesu, jeden z etapów powtarzalnego cyklu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce301713-8e13-43f9-9c43-854ab235ffb3",
                                "sense_id": "cce7e5d8-ddc8-3820-88fb-5b111a220cff",
                                "text": "Z każdą kolejną iteracją produkt jest coraz bardziej zanieczyszczony. W iteracji piątej pojawiła się nawet kontaminacja biologiczna."
                            }
                        ],
