                "forms": [],
                "senses": [
                    {
                        "sense_id": "fd44018b-4944-3390-a153-11a57309fa6a",
                        "entry_id": "9b889be1-4a0f-3aa8-80a0-7d2009a3eaa3",
                        "glosses": [
                            "angst om te falen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a2b800c-45fe-4056-a71a-c36edcdd38ad",
                                "sense_id": "fd44018b-4944-3390-a153-11a57309fa6a",
                                "text": "Vaak verhindert faalangst dat mensen iets ondernemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67176ec4-7438-4731-a600-84ae1876c797",
                        "source_entry_id": "9b889be1-4a0f-3aa8-80a0-7d2009a3eaa3",
                        "source_sense_id": "fd44018b-4944-3390-a153-11a57309fa6a",
                        "source_sense_description": "angst om te falen",
                        "target_lang_word": "Angst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80d2b89b-3218-3641-af40-c893d6fc742a",
                                        "entry_id": "403a7979-7e6b-3fe0-a055-0af438532690",
                                        "glosses": [
                                            "Gefühl der (existentiellen) Furcht oder Sorge, etwa bei einer Bedrohung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610cf7b5-041c-4364-b0ee-88461fc96b58",
                                                "sense_id": "80d2b89b-3218-3641-af40-c893d6fc742a",
                                                "text": "Ich habe Angst vor großen Hunden."
                                            },
                                            {
                                                "example_id": "721c3a9f-3397-4eb4-befe-eda242be255a",
                                                "sense_id": "80d2b89b-3218-3641-af40-c893d6fc742a",
                                                "text": "Er hatte Angst um sein Leben."
                                            },
                                            {
                                                "example_id": "7eed0f6a-7b7d-487b-a525-0b16aacf203c",
                                                "sense_id": "80d2b89b-3218-3641-af40-c893d6fc742a",
                                                "text": "„Er wurde in dieser Zeit noch einsamer und er wurde immer aggressiver, denn seine Angst wuchs.“"
                                            },
                                            {
                                                "example_id": "b79a592a-8c0f-4159-966e-ae7f8ea1ff41",
                                                "sense_id": "80d2b89b-3218-3641-af40-c893d6fc742a",
                                                "text": "Er [der US-Bürger Walter Wagner] hat Angst, dass die Inbetriebnahme eines Teilchenbeschleunigers in Genf im Herbst den Weltuntergang auslöst."
                                            },
                                            {
                                                "example_id": "edb8c0c7-0ae9-43ca-942c-dfe8c1be5e2f",
                                                "sense_id": "80d2b89b-3218-3641-af40-c893d6fc742a",
                                                "text": "„Meine Eltern waren aus Angst vor dem Ku Klux Klan nach Birmingham gezogen. In der Stadt fühlten sie sich sicherer als auf dem Land.“"
                                            },
                                            {
                                                "example_id": "5ed9d124-2888-44fe-ac88-a896acc5fdab",
                                                "sense_id": "80d2b89b-3218-3641-af40-c893d6fc742a",
                                                "text": "Aber sie [die Partei CSU] setzt beim Thema Zuwanderung […] auf reine Begrenzung, auf eine Politik der Zahlen, immer getrieben von der Angst, weitere Wähler an die AfD zu verlieren."
                                            },
                                            {
                                                "example_id": "0bcce56c-3d83-4bdb-bfa4-54eb14d713d4",
                                                "sense_id": "80d2b89b-3218-3641-af40-c893d6fc742a",
                                                "text": "[…] die Kirchen könnten […] gegen die Regierung [des Kongo] auftreten. Und das macht der Regierung Angst, und ihre Rhetorik gegenüber der katholischen Kirche wird immer schärfer."
                                            },
                                            {
                                                "example_id": "125fe534-3303-4a98-8fd8-044cf5cfb7d6",
                                                "sense_id": "80d2b89b-3218-3641-af40-c893d6fc742a",
                                                "text": "„»Meine Großeltern haben große Angst, dass sie aus Deutschland abgeschoben werden.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59c2fdd1-10cb-45ab-8077-54c3964234d9",
                        "source_entry_id": "9b889be1-4a0f-3aa8-80a0-7d2009a3eaa3",
