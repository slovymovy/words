                                        "sense_id": "08ba92f6-7041-34df-9e10-30c1f33d90a8",
                                        "entry_id": "93289bb0-c6bc-3350-a911-44f2a48cb04d",
                                        "glosses": [
                                            "To remove (unwanted elements) from a group."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c014ce-77f8-4068-8177-e567aa451dd6",
                                                "sense_id": "08ba92f6-7041-34df-9e10-30c1f33d90a8",
                                                "text": "To weed out problem users, watch new people's behavior."
                                            },
                                            {
                                                "example_id": "abe3d2e5-905b-44e0-8d6c-444af9deb49c",
                                                "sense_id": "08ba92f6-7041-34df-9e10-30c1f33d90a8",
                                                "text": "In May get a weed-hook, a crotch and a glove,\nAnd weed out such weeds, as the corn doth not love"
                                            },
                                            {
                                                "example_id": "b49e0da7-54fd-4e61-8872-a09956629c2c",
                                                "sense_id": "08ba92f6-7041-34df-9e10-30c1f33d90a8",
                                                "text": "“I like the question, ‘Where can I take you/where will you take me on our first date?’ because that’s the point of the app and you’re already both attracted to each other. It weeds out people who aren’t actually interested in meeting up and are using the app passively,” Hoggard Wagley says."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
