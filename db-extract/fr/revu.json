                "forms": [],
                "senses": [
                    {
                        "sense_id": "49337d5b-2805-36ee-9457-6ac06df2f1d4",
                        "entry_id": "cb30d781-852c-3793-908b-1003e863549a",
                        "glosses": [
                            "Participe passé du verbe revoir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "ebbb205a-0abb-4abc-960d-c418022a5bd6",
                                "sense_id": "49337d5b-2805-36ee-9457-6ac06df2f1d4",
                                "text": "Dans ses rêves, il a revu Paris puis la France tout entière engloutie sous des tonnes de papier, avec en fond sonore la voix étouffée de Louis Hémon penché sur lui, un Hémon enquébécisé jusque dans la moelle de sa parlure."
                            },
                            {
                                "example_id": "ee4114a8-d82a-4fe8-a781-599f327d76e8",
                                "sense_id": "49337d5b-2805-36ee-9457-6ac06df2f1d4",
                                "text": "“On ne pouvait pas dire non. Quinze personnes ont été emmenées pour creuser la poubelle.” Ces quinze personnes n’ont jamais été revues."
                            }
                        ]
                    }
                ],
