                                        "glosses": [
                                            "In the International System of Units, the derived unit of force; the force required to accelerate a mass of one kilogram by one metre per second per second."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813d8ae6-bbc1-467c-90dc-a088cdc43ff7",
                                                "sense_id": "5f994bb0-6ca9-3029-877b-24d2d9e02447",
                                                "text": "Holonyms: kilonewton < meganewton < giganewton < teranewton < petanewton < exanewton < zettanewton < yottanewton"
                                            },
                                            {
                                                "example_id": "65836c1f-652c-4cad-a002-af3d91a07d19",
                                                "sense_id": "5f994bb0-6ca9-3029-877b-24d2d9e02447",
                                                "text": "Meronyms: piconewton < nanonewton < micronewton < millinewton"
                                            }
                                        ]
                                    }
                                ]
                            },
