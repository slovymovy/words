                "senses": [
                    {
                        "sense_id": "6104ed33-1484-3aa1-a492-1610b97aa92f",
                        "entry_id": "8a04980a-4d4d-3cf8-a93a-0ddf844e8bd5",
                        "glosses": [
                            "The alignment (and cutting) of a wheel (especially a grinding wheel) such that its surface is concentric with its axis."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f60e877e-97b0-4fb9-9655-8d4e0f2d3475",
                                "sense_id": "6104ed33-1484-3aa1-a492-1610b97aa92f",
                                "text": "The wheel slides are purposely slightly under-compensated, causing the work to approach an oversize condition after several truings."
                            },
                            {
                                "example_id": "449bcf20-b66b-47e5-b0a3-9778c41eae51",
                                "sense_id": "6104ed33-1484-3aa1-a492-1610b97aa92f",
                                "text": "As many as twenty titanium alloy test specimens can be ground between truings."
                            },
                            {
                                "example_id": "366fab9c-9fff-4366-ad65-2cc5d0aa2dc9",
                                "sense_id": "6104ed33-1484-3aa1-a492-1610b97aa92f",
                                "text": "CBN^([cubic boron nitride (abrasive)]) wheel roundness to within .0001 inches (.0025mm) is considered satisfactory; however, roundess^([sic]) to 1 micron (.000040 inches) or less will extend the number of parts between truings."
                            }
                        ]
                    }
                ],
