                "senses": [
                    {
                        "sense_id": "d955fd8a-495d-3ac4-b750-7b1d0bf9d415",
                        "entry_id": "7bf1bc3b-86d0-35f0-ac2e-bbba438c97f4",
                        "glosses": [
                            "etwas strömend (vom Anfang bis zum Ende, von einer Seite zur anderen) durchqueren"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b7961044-b36b-462e-94df-e503a1c8661a",
                                "sense_id": "d955fd8a-495d-3ac4-b750-7b1d0bf9d415",
                                "text": "„Mehrere Brücken über die Unstrut mussten gesperrt werden, da das Wasser nicht mehr unter ihnen hindurchfließen kann.“"
                            },
                            {
                                "example_id": "b5ce07af-3267-41d0-afbf-d2085e8c4d7a",
                                "sense_id": "d955fd8a-495d-3ac4-b750-7b1d0bf9d415",
                                "text": "„Sind die Arterien weitgestellt, kann ohne viel Mühe viel Blut durch sie hindurchfließen.“"
                            },
                            {
                                "example_id": "4c3e582a-2f25-415d-9fa1-0421e62f47d8",
                                "sense_id": "d955fd8a-495d-3ac4-b750-7b1d0bf9d415",
                                "text": "„Elektrolyse heißt die Gesamtheit der chemischen Veränderungen (Oxidation, Reduktion, Zersetzung) einer Substanz beim Hindurchfließen eines elektrischen Gleichstroms.“"
                            },
                            {
                                "example_id": "5ad0e3a8-9620-4db5-aec6-110c76d9cfe4",
                                "sense_id": "d955fd8a-495d-3ac4-b750-7b1d0bf9d415",
                                "text": "„Ich fließe hindurch, durchdringe, verdichte oder löse mich auf, je nach Wunsch.“"
                            },
                            {
                                "example_id": "c67ab73d-cca9-4ea0-adde-8a6c8d83843a",
                                "sense_id": "d955fd8a-495d-3ac4-b750-7b1d0bf9d415",
                                "text": "„Aber ich floss hindurch und entkam durch eine Wasserader.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
