                                    {
                                        "sense_id": "a563fe94-bfe4-3845-bd34-d191c14258fc",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "A plant of certain species of the genus Brassica, or of related genera (especially Sinapis alba, in the family Brassicaceae, with yellow flowers, and linear seed pods)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4ad15cc-bf84-36a8-8eb1-69e188185d40",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "Powder or paste made from seeds of the mustard plant, and used as a condiment or a spice."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b751f8-b06d-4e18-ab51-153ccab8fc52",
                                                "sense_id": "d4ad15cc-bf84-36a8-8eb1-69e188185d40",
                                                "text": "When the waitress brought the food, I asked whether she had any Dijon mustard."
                                            },
                                            {
                                                "example_id": "ab64acbf-9007-472c-a0f8-78b366582466",
                                                "sense_id": "d4ad15cc-bf84-36a8-8eb1-69e188185d40",
                                                "text": "He loved having mustard and toast for breakfast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef36922f-c5f5-3a8f-8999-ec335433156b",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "The leaves of the mustard plant, used as a salad."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3f8b69-d487-4a13-b340-6eb3ab8fd498",
                                                "sense_id": "ef36922f-c5f5-3a8f-8999-ec335433156b",
                                                "text": "Mustard and cress sandwiches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "690fab03-3355-387d-b72b-46f03d882d79",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "Dark yellow colour, the colour of mustard."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c71bafe-5aa9-33e0-97c1-6d6d3095cd1d",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "One of a family of vesicants containing one or more 2-chloroethyl (C₂H₄Cl) groups, commonly used in chemical warfare and cancer chemotherapy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "429e203d-32b8-3549-af6b-15b3354ee8ef",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
