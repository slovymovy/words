                        "entry_id": "7a196a45-6a25-3511-b0d2-a2477213816a",
                        "glosses": [
                            "Militaire (sous-officière) ou civile (sapeuse-pompière) qui porte le grade de caporal."
                        ],
                        "tags": [
                            "Lutte contre l’incendie"
                        ],
                        "examples": [
