                "senses": [
                    {
                        "sense_id": "e9dfbba9-f021-3a72-9ce7-93f2ab4d50b7",
                        "entry_id": "4a24e22a-1b15-362a-be52-af65ecd5c5b4",
                        "glosses": [
                            "Wasserquelle"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "51f85782-3c72-436d-8f6b-9bc1bce08ff7",
                                "sense_id": "e9dfbba9-f021-3a72-9ce7-93f2ab4d50b7",
                                "text": "„Und Gott öffnete ihre Augen und sie sah einen Wasserborn und ging hin und füllte den Schlauch mit Wasser und gab dem Knaben zu trinken.“"
                            },
                            {
                                "example_id": "9bb4de0c-fc1c-4962-8a4a-ca109f47b1c6",
                                "sense_id": "e9dfbba9-f021-3a72-9ce7-93f2ab4d50b7",
                                "text": "„Da habe man unter dem Rathhaus einen hellen Wasserborn springen lassen zu anmuehiger Kühlung.“"
                            },
                            {
                                "example_id": "5e4b8488-5dc9-4220-837f-58f4bf22056a",
                                "sense_id": "e9dfbba9-f021-3a72-9ce7-93f2ab4d50b7",
                                "text": "„Eigentlich sind die Milchkühe im Sommer täglich 3, und im Winter 2mal zu melken, gleich unmittelbar darauf muß die Milch in Keller oder ins Milchgewölbe gebracht, und die Näpfe aus einen kalten steinernen Boden, oder in einen Wasserborn schwimmend gestellt werden, wo immer Zu- und Abfluß ist.“"
                            },
                            {
                                "example_id": "29f5feca-c152-42b8-b3b0-ff7b994d9c36",
                                "sense_id": "e9dfbba9-f021-3a72-9ce7-93f2ab4d50b7",
                                "text": "„In dem Grindelwalde, so schreibt Scheuchzer in der Naturgesch. des Schweizerlandes Th. II. S. 282, nicht weit von dem unterm Gletscher war noch vor wenigen Jahren ein periodischer Wasserborn, der Lügibach, der zuweilen plötzlich und mit Ungestüm hervorbrach, und eben so plötzlich zurücktrat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e9a52b9-18cc-46a5-be21-0ba9291b74ed",
                        "source_entry_id": "4a24e22a-1b15-362a-be52-af65ecd5c5b4",
                        "source_sense_id": "e9dfbba9-f021-3a72-9ce7-93f2ab4d50b7",
                        "source_sense_description": "veraltet: Wasserquelle",
                        "target_lang_word": "source",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "source",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6dfd55f5-47b1-3824-bc84-7c1a1d746d64",
                                        "entry_id": "4e73143e-15f8-3a5c-a45d-8b9561d4e35b",
                                        "glosses": [
                                            "Point d’émergence naturelle d’eau, généralement souterraine, à la surface du sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3d2335f-10da-4f7e-9fe3-a947b383d474",
                                                "sense_id": "6dfd55f5-47b1-3824-bc84-7c1a1d746d64",
                                                "text": "En vain, j’avais cherché un ru […] ou bien une source […] une petite source qui dort dans sa niche de terre moussue, pareille aux niches où nichent les saints campagnards."
                                            },
                                            {
                                                "example_id": "77a6a9c2-4263-4e70-b3fd-a03eb6f06026",
                                                "sense_id": "6dfd55f5-47b1-3824-bc84-7c1a1d746d64",
                                                "text": "C’est un pays très isolé qu’il n’est pas facile d’atteindre. […] Il s’agit d’une vallée qui dépend de la Sèvre Nantaise, dont la source est d’ailleurs assez proche […]"
                                            },
                                            {
                                                "example_id": "fdb5ff6a-ec11-4b58-9dad-146041f58f3d",
                                                "sense_id": "6dfd55f5-47b1-3824-bc84-7c1a1d746d64",
                                                "text": "Pour procéder méthodiquement, il commença par se rendre chez le maire et s’enquit de l’état des sources alimentant la commune."
                                            },
                                            {
                                                "example_id": "8fcce36a-9c8f-4068-af20-896f6ae3f0d9",
                                                "sense_id": "6dfd55f5-47b1-3824-bc84-7c1a1d746d64",
                                                "text": "Après huit heures de marche en terrain souvent difficile, par un sirocco étouffant et une température qui doit dépasser 60° au soleil, nous atteignons Ras El-Ma, la source de l’oued Fez, à douze kilomètres de la capitale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082e5ef0-a631-3e11-947f-3ef1ff0e1fc7",
                                        "entry_id": "4e73143e-15f8-3a5c-a45d-8b9561d4e35b",
                                        "glosses": [
                                            "Point d’où s’écoule un liquide ou un gaz naturel."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50ae3410-47d2-4d51-b3dc-4a1da37d585c",
                                                "sense_id": "082e5ef0-a631-3e11-947f-3ef1ff0e1fc7",
                                                "text": "Ce bouillonnement provenait d’une source sous-marine de naphte, et il a suffi de ce fragment de cigare pour l’enflammer."
                                            },
                                            {
                                                "example_id": "206b68d3-b1ef-4e7c-9017-934e47cd65d5",
                                                "sense_id": "082e5ef0-a631-3e11-947f-3ef1ff0e1fc7",
                                                "text": "La zone tropicale agit aujourd’hui comme source de CO₂ à la fois parce que l’on brûle la majeure partie de la matière végétale coupée lors du défrichement et parce que la dénudation des sols intensifie l’oxydation de la matière organique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ca99ce8-5358-3bee-b263-da0ee2702eb0",
                                        "entry_id": "4e73143e-15f8-3a5c-a45d-8b9561d4e35b",
                                        "glosses": [
                                            "Point ou objet à l’origine d’un rayonnement lumineux, thermique ou d’une émission sonore."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c0c0389-17a3-3cd2-84a8-222135087623",
                                        "entry_id": "4e73143e-15f8-3a5c-a45d-8b9561d4e35b",
                                        "glosses": [
                                            "Zone ou phénomène à l’origine d’un apport particulier (chaleur, humidité, pollution)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d22f8dd-28c2-3c98-85b9-da25a83e914f",
                                        "entry_id": "4e73143e-15f8-3a5c-a45d-8b9561d4e35b",
                                        "glosses": [
                                            "Origine, cause, principe ou point de départ d’un phénomène, d’une action ou d’une idée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b11f2d2-8d82-4d16-9753-e2312020fe5a",
                                                "sense_id": "1d22f8dd-28c2-3c98-85b9-da25a83e914f",
                                                "text": "Il jugea que l’enquête rigoureuse et sévère qui s’imposait devait lui faire découvrir la source occulte de cette extraordinaire épidémie."
                                            },
                                            {
                                                "example_id": "1e53b35e-1217-41e0-b599-8c25f3833da0",
                                                "sense_id": "1d22f8dd-28c2-3c98-85b9-da25a83e914f",
                                                "text": "Dans beaucoup de cas, les artisans, obligés de se rendre aux nouvelles sources de labeur, se sont déracinés et sont devenus, loin de leur contrée natale, des sans-foyer…"
                                            },
                                            {
                                                "example_id": "737e5910-ded5-4817-9b4b-64ae8652dfbe",
                                                "sense_id": "1d22f8dd-28c2-3c98-85b9-da25a83e914f",
                                                "text": "La poésie du Divan et la poésie populaire, issues de classes sociales différentes, ont su parfois puiser aux mêmes sources d’inspiration : mais ce qui forme entre elles cloison étanche, c’est la forme de la langue […]"
                                            },
                                            {
                                                "example_id": "f6f82020-89ec-4571-b114-3c96e09efee8",
                                                "sense_id": "1d22f8dd-28c2-3c98-85b9-da25a83e914f",
                                                "text": "Tea-room d'Oxford, fumoir d'évêque anglican, comptoir d'assurances maritimes, banque de Londres, chemiserie de luxe, telles étaient les différentes sources d'inspiration auxquelles Monsieur Mac Mannox s'était abreuvé."
                                            },
                                            {
                                                "example_id": "f593bd75-fd6b-4b86-be56-3f494b68fb24",
                                                "sense_id": "1d22f8dd-28c2-3c98-85b9-da25a83e914f",
                                                "text": "De toute façon, l’État d’Europe occidentale, en tant qu’expression de la réalité politique et source impersonnelle du droit public, est une institution relativement récente."
                                            },
                                            {
                                                "example_id": "2dcc830b-aaef-4049-b4ae-a71091a94d78",
                                                "sense_id": "1d22f8dd-28c2-3c98-85b9-da25a83e914f",
                                                "text": "Si elles sont voraces, les araignées sont aussi une source de nourriture très importante, dont dépendent quelque 8.000 espèces d’oiseaux, de parasites et d’autres prédateurs."
                                            },
                                            {
                                                "example_id": "74fe9304-2c0c-4fcc-922e-9e40169b24be",
                                                "sense_id": "1d22f8dd-28c2-3c98-85b9-da25a83e914f",
                                                "text": "Le Têt exprime l’esprit « Quand vous buvez de l’eau, rappelez-vous la source » du peuple vietnamien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2242e5e4-f4e9-3b02-bfe3-3ddc08c7161e",
                                        "entry_id": "4e73143e-15f8-3a5c-a45d-8b9561d4e35b",
                                        "glosses": [
                                            "Matière, appareil ou installation émettant des rayonnements ionisants ou contenant des substances radioactives."
                                        ],
                                        "tags": [
                                            "Nucléaire"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7da9bc8d-d514-3c25-9036-82fe729d7f44",
                                        "entry_id": "4e73143e-15f8-3a5c-a45d-8b9561d4e35b",
                                        "glosses": [
                                            "Référence ou indication de l’origine d’une information ou d’une citation."
                                        ],
                                        "tags": [
                                            "Documentation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80d37ad6-1ac6-453d-b9ce-d7331b2861af",
                                                "sense_id": "7da9bc8d-d514-3c25-9036-82fe729d7f44",
                                                "text": "Les sources auxquelles j’ai puisé pour mon travail sont malheureusement loin d’être abondantes. On sait que les commentaires de Sylla ont péri, ainsi que les livres de Tite-Live qui racontaient la guerre sociale."
                                            },
                                            {
                                                "example_id": "a471817d-5993-461a-882b-034f797a1fb5",
                                                "sense_id": "7da9bc8d-d514-3c25-9036-82fe729d7f44",
                                                "text": "Un système continu de notes met le lecteur à même de vérifier d’après les sources toutes les propositions du texte. Dans ces notes, on s’est borné strictement aux citations de première main, je veux dire à l’indication des passages originaux sur lesquels chaque assertion ou chaque conjecture s’appuie."
                                            },
                                            {
                                                "example_id": "85ba3c2c-723f-4a07-a21f-64b0edb8e3b3",
                                                "sense_id": "7da9bc8d-d514-3c25-9036-82fe729d7f44",
                                                "text": "L’indication des sources est un gage de sérieux. - « La Judée l’attirait comme par un charme ; il voulut tenter un dernier effort pour gagner la ville rebelle, et sembla prendre à tâche de justifier le proverbe qu’un prophète ne doit point mourir hors de Jérusalem [939]\n939 - On ignore à quel livre est empruntée cette citation. »"
                                            },
                                            {
                                                "example_id": "33f95a91-82fe-43a5-8b55-a339702d468d",
                                                "sense_id": "7da9bc8d-d514-3c25-9036-82fe729d7f44",
                                                "text": "Une longue fréquentation des ouvrages ésotériques m’a souvent fait croiser des ouvrages bourrés d’affirmations non vérifiées et […] garnis de citations introuvables, car les sources n’étaient pas fournies […]"
                                            },
                                            {
                                                "example_id": "f36c5a75-096a-4aab-9190-1add6e50d42b",
                                                "sense_id": "7da9bc8d-d514-3c25-9036-82fe729d7f44",
                                                "text": "Certains médias canadiens de langue chinoise auraient même repris des articles de médias d’État chinois sans en mentionner la source, soulignant ainsi les liens étroits avec le Parti communiste chinois"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c07deee2-d9d8-35fc-a825-bc4e3858540f",
                                        "entry_id": "4e73143e-15f8-3a5c-a45d-8b9561d4e35b",
                                        "glosses": [
                                            "Ensemble des documents représentés sur la carte et éventuellement des autres informations portées sur elle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4442d57-cfb4-35d2-b69c-9265d16d1818",
                                        "entry_id": "4e73143e-15f8-3a5c-a45d-8b9561d4e35b",
                                        "glosses": [
                                            "Code source ou donnée d’origine utilisée par un programme ou un système."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f345000b-1cfe-3361-8d70-1b390a6ddc7a",
                                        "entry_id": "4e73143e-15f8-3a5c-a45d-8b9561d4e35b",
                                        "glosses": [
                                            "Fasce ondée (bande horizontale formant des vagues) traversant en un nombre défini de fois la surface d’une fontaine héraldique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "729e991e-f5d6-4a79-810c-f088e50417c0",
                                                "sense_id": "f345000b-1cfe-3361-8d70-1b390a6ddc7a",
                                                "text": "Coupé de gueules à la grappe de raisin feuillée accostée à dextre d’une croix ancrée et à senestre d’un vase le tout d’or ; et d’azur à la fontaine héraldique d’or remplie d’azur, traversé par une source d’argent, qui est de la commune de Sommelonne de la Meuse → voir illustration « Fontaine héraldique avec une source »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c1042bb-333d-32e4-b8fb-42022e5da05f",
                                        "entry_id": "4e73143e-15f8-3a5c-a45d-8b9561d4e35b",
                                        "glosses": [
                                            "Dans un graphe orienté, sommet dont le degré entrant est nul."
                                        ],
                                        "tags": [
                                            "Théorie des graphes"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
