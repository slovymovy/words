                        "examples": [
                            {
                                "example_id": "546fa07e-bdf9-4d08-80a2-d4246259b4f6",
                                "sense_id": "e334da28-e126-3189-8bd4-44985034b0c9",
                                "text": "Ротище губастый, мокрый, рожа хрящеватая, и нос… такой-то хрящ, сине-красный!"
                            },
                            {
                                "example_id": "6763618b-4d87-419f-bc74-7d797fae935e",
                                "sense_id": "e334da28-e126-3189-8bd4-44985034b0c9",
                                "text": "Гляди: я высунул язык, и он свой ротище раззявил и язык выкатил!"
                            }
                        ]
                    }
