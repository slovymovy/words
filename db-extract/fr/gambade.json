        "fr-extract.jsonl": [
            {
                "entry_id": "f6a6d027-a63e-3396-a476-acdebc9a3f7b",
                "word": "gambade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "93224b72-b958-4712-a583-febda9263d27",
                        "entry_id": "f6a6d027-a63e-3396-a476-acdebc9a3f7b",
                        "tags": [
                            "plural"
                        ],
                        "form": "gambades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "832c077d-0f09-3a73-8784-2f0ddacfb464",
                        "entry_id": "f6a6d027-a63e-3396-a476-acdebc9a3f7b",
                        "glosses": [
                            "Saut vif et sans règle qui dénote de la gaieté, de l’entrain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1a017d4-4652-45a4-b419-dd2faf11fdbf",
                                "sense_id": "832c077d-0f09-3a73-8784-2f0ddacfb464",
                                "text": "Après avoir fait gambades sur gambades, exécuté des voltiges hardies autour de sœur Rose très émue, fait niches sur niches et mille agaceries aux militaires qui jouaient à la drogue et dont les pinces en bois posées sur le nez des perdants me faisaient toujours rire, j'étais, on le pense, très animé, très emporté."
                            },
                            {
                                "example_id": "f2aa6aa9-2c36-457f-ad02-e9820658ac3c",
                                "sense_id": "832c077d-0f09-3a73-8784-2f0ddacfb464",
                                "text": "Et, en dessous, une ligne qui aurait voulu être horizontale, mais qui délirait en hauteur, s'élevait comme une gambade."
                            },
                            {
                                "example_id": "baf7d61c-ef9a-498e-9a7d-b56804c7c8ed",
                                "sense_id": "832c077d-0f09-3a73-8784-2f0ddacfb464",
                                "text": "Puis arriva une troupe de jeunes chrétiennes très peu vêtues, qui dansèrent et firent toutes sortes de gambades."
                            },
                            {
                                "example_id": "fd1e39b0-61d9-4e56-be03-21ccec3873e9",
                                "sense_id": "832c077d-0f09-3a73-8784-2f0ddacfb464",
                                "text": "J’ai graissé la patte au berger\nPour lui faire jouer une aubade\nLors, ma mie, sans croire au danger\nFaisons mille et une gambades."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09f76e03-bfdc-47a5-b7e6-257be57d4296",
                        "source_entry_id": "f6a6d027-a63e-3396-a476-acdebc9a3f7b",
                        "source_sense_id": "832c077d-0f09-3a73-8784-2f0ddacfb464",
                        "target_lang_word": "gambol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gambol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "025a3c78-bb85-3bdc-b375-de67dff7bf72",
                                        "entry_id": "8a2080a6-7b6d-3da6-86c2-491a7966cfb5",
                                        "glosses": [
                                            "To move about playfully; to frolic."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e134bbd2-db98-46d9-b69e-7c47e96d572c",
                                                "sense_id": "025a3c78-bb85-3bdc-b375-de67dff7bf72",
                                                "text": "The lawn spread freely onward, as of old, over which, in sweet company, he had once gambolled."
                                            },
                                            {
                                                "example_id": "a38ee313-322d-467e-93b8-0c243872cb0c",
                                                "sense_id": "025a3c78-bb85-3bdc-b375-de67dff7bf72",
                                                "text": "At our old pastimes in the hall\n⁠We gambol’d, making vain pretence\n⁠Of gladness, with an awful sense\nOf one mute Shadow watching all."
                                            },
                                            {
                                                "example_id": "05483e16-043f-4376-9df2-858b675f46e7",
                                                "sense_id": "025a3c78-bb85-3bdc-b375-de67dff7bf72",
                                                "text": "[…] she remains near him to suckle him and teach him to choose the delicious grasses of the meadow, in which he gambols until he is grown."
                                            },
                                            {
                                                "example_id": "af861c64-43e7-4397-b69e-469084ed228e",
                                                "sense_id": "025a3c78-bb85-3bdc-b375-de67dff7bf72",
                                                "text": "And, in very truth, run and leap he did, gambolling wildly down the stretch of lawn outside the long window."
                                            },
                                            {
                                                "example_id": "a9caa722-bb34-400c-92a6-ada1ed3c9b35",
                                                "sense_id": "025a3c78-bb85-3bdc-b375-de67dff7bf72",
                                                "text": "In the ecstasy of that thought they gambolled round and round, they hurled themselves into great leaps of excitement."
                                            },
                                            {
                                                "example_id": "0c46896c-e63a-4ce9-9e1d-b86a337d7918",
                                                "sense_id": "025a3c78-bb85-3bdc-b375-de67dff7bf72",
                                                "text": "[The whales] quite enjoyed themselves gamboling freely among the waves in the sunshine."
                                            },
                                            {
                                                "example_id": "e46b8ec1-1760-46c4-99de-4704c5d5d670",
                                                "sense_id": "025a3c78-bb85-3bdc-b375-de67dff7bf72",
                                                "text": "Three girls moved across the billiard-table lawn of a great manor house, circling and swarming about a common center of gravity like gamboling sparrows."
                                            },
                                            {
                                                "example_id": "75efde72-52c4-4680-ad0c-7f77002ac55e",
                                                "sense_id": "025a3c78-bb85-3bdc-b375-de67dff7bf72",
                                                "text": "They were in the white wood / Gamboling out to picnic"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e07cab2-2835-310e-ae8a-41a30fa7a81a",
                                        "entry_id": "8a2080a6-7b6d-3da6-86c2-491a7966cfb5",
                                        "glosses": [
                                            "To do a forward roll."
                                        ],
                                        "tags": [
                                            "British",
                                            "West-Midlands"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gambol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec5bcea6-07a5-3dfe-a305-6e375447f7d8",
                                        "entry_id": "8b0644f0-fc8f-303d-8e85-ecf2cdb513ac",
                                        "glosses": [
                                            "An instance of running or skipping about playfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d33f10a-697b-4c0f-aa5a-69fa2d5b9654",
                                                "sense_id": "ec5bcea6-07a5-3dfe-a305-6e375447f7d8",
                                                "text": "Heere hung those lipps, that I haue kist I know not how oft. VVhere be your Iibes now? Your Gambals? Your Songs? Your flashes of Merriment that were wont to set the Table on a Rore?"
                                            },
                                            {
                                                "example_id": "3c454560-2b4a-4dbf-9ef2-a836405ce22c",
                                                "sense_id": "ec5bcea6-07a5-3dfe-a305-6e375447f7d8",
                                                "text": "When his gambols were over, I looked at the paper, and, to speak the truth, found myself not a little puzzled at what my friend had depicted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c332f34c-f233-35bc-8b6a-b16b57df6f2a",
                                        "entry_id": "8b0644f0-fc8f-303d-8e85-ecf2cdb513ac",
                                        "glosses": [
                                            "An instance of more general frisking or frolicking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16618456-6cba-4cee-bd4b-29176e240822",
                                                "sense_id": "c332f34c-f233-35bc-8b6a-b16b57df6f2a",
                                                "text": "There was a delicious sensation of mingled security and awe with which I looked down, from my giddy height, on the monsters of the deep at their uncouth gambols."
                                            },
                                            {
                                                "example_id": "3910e672-5742-4e9f-bc5e-b7fec4e04a3e",
                                                "sense_id": "c332f34c-f233-35bc-8b6a-b16b57df6f2a",
                                                "text": "The season of salad days has been rightly called a season of folly—rightly, because nature wisely intended salad days for folly, and we are wise to regard them as a time for folly. But are we wise when, halting upon the crutches age finds convenient after the gambols of youth have lost their attractions, we condemn this season of harmless folly to perpetual reprobation?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bcf0678-9c8b-4232-bb63-3eeb42d68c2d",
                        "source_entry_id": "f6a6d027-a63e-3396-a476-acdebc9a3f7b",
                        "source_sense_id": "832c077d-0f09-3a73-8784-2f0ddacfb464",
                        "target_lang_word": "frolic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frolic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0be8ab81-7681-3b15-855d-44a370e50c99",
                                        "entry_id": "62334816-53ca-3ae8-845c-584e27e24b29",
                                        "glosses": [
                                            "Merry, joyous, full of mirth; later especially, frolicsome, sportive, full of playful mischief."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b45a1966-96f4-452f-a3f7-297a67722692",
                                                "sense_id": "0be8ab81-7681-3b15-855d-44a370e50c99",
                                                "text": "The frolick wind that breathes the Spring,\nZephyr with Aurora playing,\nAs he met her once a Maying\nThere on Beds of Violets blew,"
                                            },
                                            {
                                                "example_id": "31791c87-8351-407d-8eeb-a2c33f2663a8",
                                                "sense_id": "0be8ab81-7681-3b15-855d-44a370e50c99",
                                                "text": "For women, born to be controul’d,\nStoop to the forward and the bold,\nAffect the haughty and the proud,\nThe gay, the frollick, and the loud."
                                            },
                                            {
                                                "example_id": "a9f49b89-8815-433f-bbb0-e0786ad3f18d",
                                                "sense_id": "0be8ab81-7681-3b15-855d-44a370e50c99",
                                                "text": "You meet him at the tables and conversations of the wise, the impertinent, the grave, the frolic, and the witty; [...]"
                                            },
                                            {
                                                "example_id": "711aeb69-0f97-4c81-aeba-b757126027e9",
                                                "sense_id": "0be8ab81-7681-3b15-855d-44a370e50c99",
                                                "text": "Beale, under this frolic menace, took nothing back at all; he was indeed apparently on the point of repeating his extravagence, but Miss Overmore instructed her little charge that she was not to listen to his bad jokes [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4b77bf2-767d-3c03-9eb0-b7623e4b0ed4",
                                        "entry_id": "62334816-53ca-3ae8-845c-584e27e24b29",
                                        "glosses": [
                                            "Free; liberal; bountiful; generous."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "frolic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "503b9ad0-8329-3bc7-8bc4-ebe7625f7e6b",
                                        "entry_id": "6a8d4356-4ba3-3be7-b23c-8ede9e822d25",
                                        "glosses": [
                                            "To make merry; to have fun; to romp; to behave playfully and uninhibitedly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c43e717e-36bf-4bbe-97b7-7396cf8627ce",
                                                "sense_id": "503b9ad0-8329-3bc7-8bc4-ebe7625f7e6b",
                                                "text": "We saw the lambs frolicking in the meadow."
                                            },
                                            {
                                                "example_id": "78b2d9fc-11b2-4860-8e65-8e0a324adae5",
                                                "sense_id": "503b9ad0-8329-3bc7-8bc4-ebe7625f7e6b",
                                                "text": "Fools on parade frolic and fuck about to make her gaze\nTurn to a scribble on a page by a picture that holds her absence\nBut you're daft to think she'd care"
                                            },
                                            {
                                                "example_id": "c1e56481-7cef-429c-ae03-b69347a1d10e",
                                                "sense_id": "503b9ad0-8329-3bc7-8bc4-ebe7625f7e6b",
                                                "text": "“So, so beautiful. I'm gonna do one last roly-poly before we go. [snorting, squealing] At least I had one moment of joy in a life of drudgery. Where will the truffle hunt take us next?” “Nowhere. You're free, Jamebone. I'm releasing you from nose jail.” “Really? I can stay here in this paradise and prance and frolic?” “Just stick to frolicking.” “[emotional] Thank you, Mr. Bender. You're the kindest person I've ever met.” “Really? [crying] That's horrible.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e9477a5-46ad-3158-bdf6-94e3646237c8",
                                        "entry_id": "6a8d4356-4ba3-3be7-b23c-8ede9e822d25",
                                        "glosses": [
                                            "To cause to be merry."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "frolic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8af6d0dd-dc38-3841-9bec-9fac05033154",
                                        "entry_id": "49bcb1dd-d35e-3a33-b553-b2d02124d8f0",
                                        "glosses": [
                                            "Gaiety; merriment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644afcd2-246b-486e-97c7-7049ed0f64d3",
                                                "sense_id": "8af6d0dd-dc38-3841-9bec-9fac05033154",
                                                "text": "the annual jubilee […] filled the souls of old and young with visions of splendour, frolic and fun."
                                            },
                                            {
                                                "example_id": "a1753113-755f-4bd3-88c3-653ab0128227",
                                                "sense_id": "8af6d0dd-dc38-3841-9bec-9fac05033154",
                                                "text": "By the old-fashioned magnificence of this procession, it might worthily have included his Holiness in person, with a suite of attendant Cardinals, if those sacred dignitaries would kindly have lent their aid to heighten the frolic of the Carnival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f74e9e7-5e6a-3327-b110-7e905b0d59ce",
                                        "entry_id": "49bcb1dd-d35e-3a33-b553-b2d02124d8f0",
                                        "glosses": [
                                            "A playful antic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17bc6d97-9093-4a46-9fd8-305c88c53bcb",
                                                "sense_id": "4f74e9e7-5e6a-3327-b110-7e905b0d59ce",
                                                "text": "He would be at his frolic once again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64f9d7ca-abc6-3273-afdf-a20c4ed0b547",
                                        "entry_id": "49bcb1dd-d35e-3a33-b553-b2d02124d8f0",
                                        "glosses": [
                                            "A social gathering."
                                        ],
                                        "tags": [
                                            "US",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60b903f1-7c1b-4a63-9f3e-894f44987ae7",
                                                "sense_id": "64f9d7ca-abc6-3273-afdf-a20c4ed0b547",
                                                "text": "He came clattering up to the school door with an invitation to Ichabod to attend a merry-making or “quilting frolic,” to be held that evening at Mynheer Van Tassel’s"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
