                        "examples": [
                            {
                                "example_id": "f67cad23-771c-4263-bea3-9be899db1c97",
                                "sense_id": "7401b631-35e0-38bc-afad-c75b7662130c",
                                "text": "Waldemar Fornalik's side had phenomenal backing from their raucous, beery, fire-cracking supporters."
                            }
                        ]
