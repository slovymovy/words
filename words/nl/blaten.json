{
    "word_family": [
        "geblaat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b5ba7f41-b708-3794-aa6d-727494338bf6",
                    "sense_definition": "Het geluid van een schaap of geit maken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid_van_dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schaap stond in de wei luid te <w>blaten</w> naar haar lammetje.",
                            "target_lang_translations": {
                                "en": "The sheep stood in the meadow, loudly <w>bleating</w> to her lamb."
                            }
                        },
                        {
                            "text": "In de verte hoorden we de geiten onrustig <w>blaten</w>.",
                            "target_lang_translations": {
                                "en": "In the distance, we heard the goats <w>bleating</w> restlessly."
                            }
                        }
                    ],
                    "synonyms": [
                        "blèren",
                        "mekkeren"
                    ],
                    "common_phrases": [
                        "staan te blaten",
                        "luid blaten"
                    ],
                    "target_lang_definitions": {
                        "en": "To make the sound of a sheep or goat."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bleat",
                                "target_lang_sense_clarification": "of a sheep or goat"
                            },
                            {
                                "target_lang_word": "baa",
                                "target_lang_sense_clarification": "of a sheep"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7b11760-4f0b-32b2-b52e-663f61e417df",
                    "sense_definition": "Op een irritante, luidruchtige of inhoudsloze manier praten of zeuren.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "onzin_praten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hou op met <w>blaten</w> over je brommer, dat interesseert me geen reet.",
                            "target_lang_translations": {
                                "en": "Stop <w>bleating</w> about your moped, I don't give a damn."
                            }
                        },
                        {
                            "text": "Hij zat de hele avond onzin te <w>blaten</w> aan de bar.",
                            "target_lang_translations": {
                                "en": "He sat at the bar all evening <w>babbling</w> nonsense."
                            }
                        }
                    ],
                    "synonyms": [
                        "blèren",
                        "mekkeren"
                    ],
                    "common_phrases": [
                        "onzin blaten",
                        "lopen te blaten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe annoying or pointless talk."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To talk or complain in an annoying, loud, or meaningless way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bleat",
                                "target_lang_sense_clarification": "to complain or talk about trivial things"
                            },
                            {
                                "target_lang_word": "babble",
                                "target_lang_sense_clarification": "to talk foolishly or mindlessly"
                            },
                            {
                                "target_lang_word": "drone on",
                                "target_lang_sense_clarification": "to talk boringly and at length"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}