    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "28050f01-9f4a-3083-a4c3-723a2cb4af26",
                "word": "financially",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2030321b-d95f-3135-a93f-525a7b8855d9",
                        "entry_id": "28050f01-9f4a-3083-a4c3-723a2cb4af26",
                        "glosses": [
                            "In terms of finance or money."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "839545f0-7a1e-48b9-bff0-33dc114468b1",
                                "sense_id": "2030321b-d95f-3135-a93f-525a7b8855d9",
                                "text": "He helped his daughter out financially, paying her rent and utilities, until she recovered from the accident."
                            },
                            {
                                "example_id": "791a397e-c664-4922-8e6e-aa113fffbaf0",
                                "sense_id": "2030321b-d95f-3135-a93f-525a7b8855d9",
                                "text": "As it looked to him, another six months at sea should turn the trick financially. At least it would give him a good interest in the plantation."
                            },
                            {
                                "example_id": "65183f3b-cb12-4497-a6b1-928dcc9f9ce1",
                                "sense_id": "2030321b-d95f-3135-a93f-525a7b8855d9",
                                "text": "For many investors using $3,000 in losses to offset regular income taxes can be more financially beneficial than offsetting gains, said Indiana-based CFP Russ Ford, because their income tax rates are higher than their long-term capital gains rate, which is 15% for most investors."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87fb6e42-02fe-4dce-bd9f-711e42e801fb",
                        "source_entry_id": "28050f01-9f4a-3083-a4c3-723a2cb4af26",
                        "source_sense_id": "2030321b-d95f-3135-a93f-525a7b8855d9",
                        "source_sense_description": "in terms of finance or money",
                        "target_lang_word": "financièrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "financièrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbd5943b-3ce0-3ce7-ad1b-b8ecd16d7a86",
                                        "entry_id": "5737fc99-f602-3ae0-b44d-583732ed6a85",
                                        "glosses": [
                                            "En matière de finances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bafb67d-0d67-46ec-ab6b-1ff14dfa9d1a",
                                                "sense_id": "fbd5943b-3ce0-3ce7-ad1b-b8ecd16d7a86",
                                                "text": "Pierre Bergé propose, par l'intermédiaire d'une fondation, de soutenir financièrement les actionnaires de référence du Monde pour qu'ils conservent une forme de minorité de blocage."
                                            },
                                            {
                                                "example_id": "c293056d-5bb3-4684-a436-0d8c4dd82395",
                                                "sense_id": "fbd5943b-3ce0-3ce7-ad1b-b8ecd16d7a86",
                                                "text": "En 2020, à la suite de violences intrafamiliales et d’un placement judiciaire des enfants, je me suis finalement retrouvée seule avec eux à devoir tout assumer financièrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d59146c-a500-3283-98d3-1f77b7e7a2b3",
                                        "entry_id": "5737fc99-f602-3ae0-b44d-583732ed6a85",
                                        "glosses": [
                                            "À la manière des financiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae1442d-dbc5-4847-9c9f-8f8353a2f7db",
                                                "sense_id": "5d59146c-a500-3283-98d3-1f77b7e7a2b3",
                                                "text": "Ce projet n'est pas viable financièrement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dce140f1-ea34-4852-b522-4a94abc18d71",
                        "source_entry_id": "28050f01-9f4a-3083-a4c3-723a2cb4af26",
                        "source_sense_id": "2030321b-d95f-3135-a93f-525a7b8855d9",
                        "source_sense_description": "in terms of finance or money",
                        "target_lang_word": "pécuniairement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pécuniairement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bed5a07b-ee80-3711-9d60-8618a55ca79b",
                                        "entry_id": "91bbe5fc-04cc-3281-a883-ed5b1b8c5efb",
                                        "glosses": [
                                            "D’une manière pécuniaire ; par rapport à l’argent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d99bfb92-3e22-4f82-b45f-974c941ad02c",
                                                "sense_id": "bed5a07b-ee80-3711-9d60-8618a55ca79b",
                                                "text": "Il est certains dommages ou délits dont on est pécuniairement responsable."
                                            },
                                            {
                                                "example_id": "238f4dd7-d41d-4d47-b1d8-2c39e5d6e67b",
                                                "sense_id": "bed5a07b-ee80-3711-9d60-8618a55ca79b",
                                                "text": "Dédommager pécuniairement."
                                            },
                                            {
                                                "example_id": "c16659fa-0822-422a-9d6e-04dc20fef44e",
                                                "sense_id": "bed5a07b-ee80-3711-9d60-8618a55ca79b",
                                                "text": "Mais s’il y perdit pécuniairement parlant, il y gagna moralement une bonne leçon, et, plus tard, il en recueillit les fruits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e93ffd6f-f6db-4735-933b-9bb514cb82c5",
                        "source_entry_id": "28050f01-9f4a-3083-a4c3-723a2cb4af26",
                        "source_sense_id": "2030321b-d95f-3135-a93f-525a7b8855d9",
                        "source_sense_description": "in terms of finance or money",
                        "target_lang_word": "finanziell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finanziell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                        "entry_id": "1f30828a-dc5e-33e6-9cdc-d612be612a09",
                                        "glosses": [
                                            "die Finanzen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a60f7b21-3c52-4669-b02b-a26aa97f7609",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "Mein Hunger hat ganz eindeutig eine finanzielle Ursache."
                                            },
                                            {
                                                "example_id": "3397d238-bdea-48ba-9394-88fb5218a864",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "Die Begriffe Stipendien (\"scholarships\") und finanzielle Förderung (\"financial aid\") werden oft im selben Sinne verwendet, aber eigentlich ist ein Stipendium eine auf Leistungen basierende finanzielle Auszeichnung, einschliesslich ausgezeichneter akademischer Leistungen, besonderer Talente […]."
                                            },
                                            {
                                                "example_id": "f1203d2e-c85e-4efc-aa82-e5ff9e8ad2a8",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "„Dem Freiherrn selber jedoch war die Popularität als Lügenbaron eher peinlich, zudem erwies sich sein zweifelhafter Ruf bei einem späteren Scheidungsprozess, der ihn finanziell ruinierte, als wenig vorteilhaft.“"
                                            },
                                            {
                                                "example_id": "e82ce59c-6d43-46d8-8b32-ce534d663f48",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "„Am 17. April 1374 traf sich der Braunschweiger Stadtrat in der Brüdernkirche mit den Gildemeistern, um unter anderem über die finanziellen Probleme der Stadt zu beraten.“"
                                            },
                                            {
                                                "example_id": "4b730a08-fb53-4093-aa8d-48982f439a44",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "„Für eine Weile bringt ihn die Welt wieder mit Spitzensport in Verbindung und nicht mit finanziellen Sorgen.“"
                                            },
                                            {
                                                "example_id": "6078a0d5-fec2-4c18-8c01-bbf28b2b0fc9",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "„Ein Teil von uns ist finanziell nicht auf-, sondern abgestiegen.“"
                                            },
                                            {
                                                "example_id": "9ec521c8-8b07-4eb3-89cf-4f842bfd66d4",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "„Nur die, denen es finanziell gut geht, gehen in ein Restaurant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
