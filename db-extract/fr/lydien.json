                "senses": [
                    {
                        "sense_id": "1ff402c2-2869-3949-bd29-33eed835b58c",
                        "entry_id": "178008e4-e98a-3967-8491-c92e949a90d5",
                        "glosses": [
                            "Langue indoeuropéenne, de la famille des langues anatoliennes parlée en Lydie dans l’Antiquité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60cce483-f885-463a-9857-389859f60076",
                                "sense_id": "1ff402c2-2869-3949-bd29-33eed835b58c",
                                "text": "La plupart des alphabets d’Asie mineure, en utilisation entre -800 et -300, pour écrire des langues comme le lydien ou le phrygien sont des alphabets grecs modifiés de manière mineure."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fcb1b11-1283-3c10-b7ca-4af804ab27ed",
                        "entry_id": "178008e4-e98a-3967-8491-c92e949a90d5",
                        "glosses": [
                            "Mode lydien."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "b8f98f20-adce-4d2b-9548-14882fd03bc1",
                                "sense_id": "5fcb1b11-1283-3c10-b7ca-4af804ab27ed",
                                "text": "Chez les Grecs, les modes avaient des dénominations ethniques rappelant clairement leur origine : …le lydien, d’ut à ut, et son plagal l’hypolydien, de fa à fa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "230edcee-4a58-4abb-be6d-8f9ff013f7f6",
                        "source_entry_id": "178008e4-e98a-3967-8491-c92e949a90d5",
                        "source_sense_description": "langue parlée en Lydie",
                        "target_lang_word": "Lydisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lydisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc3cb5c1-668a-3011-b0a6-262d2993bccb",
                                        "entry_id": "e9eb3349-6778-381d-beee-b604c907c771",
                                        "glosses": [
                                            "ausgestorbene Sprache, die in Anatolien vom Volk der Lyder gesprochen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aed87c32-b16d-4ffb-895c-5056b95004a9",
                                                "sense_id": "bc3cb5c1-668a-3011-b0a6-262d2993bccb",
                                                "text": "„Zur Schreibung des Lydischen wurde eine Schriftart verwendet, die einem ostgriechischen Alphabet sehr ähnlich ist.“"
                                            },
                                            {
                                                "example_id": "0fefe048-43c8-4611-81b8-f117ec7f8acd",
                                                "sense_id": "bc3cb5c1-668a-3011-b0a6-262d2993bccb",
                                                "text": "„Offenbar haben die Perser nicht gut Lydisch gesprochen, jedenfalls schien in den persischen Schulen der altsprachliche Zweig wenig gefragt[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
