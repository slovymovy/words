                ],
                "senses": [
                    {
                        "sense_id": "39a858c2-06ad-3623-8aed-3785a40c57e3",
                        "entry_id": "b9300b53-f20c-3760-8375-3883b4cf1991",
                        "glosses": [
                            "Jouer légèrement, sans gravité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f61d4615-9f44-43c2-ab64-16963c729d80",
                                "sense_id": "39a858c2-06ad-3623-8aed-3785a40c57e3",
                                "text": "“Neaw, owd lad,” said he, as he screwed, first one peg, then another, and tweedled over little fits of wailing prelude, to get the tones he wanted."
                            },
                            {
                                "example_id": "dbb40d5d-55c9-4728-a4e0-eb10326fd342",
                                "sense_id": "39a858c2-06ad-3623-8aed-3785a40c57e3",
                                "text": "Hark, —his tortured catgut squals\nHe tickles every string, to every note\nHe bends his pliant neck.—\nThe fond yielding Maid Is tweedled into Love."
                            }
                        ]
