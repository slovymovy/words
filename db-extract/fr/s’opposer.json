                ],
                "senses": [
                    {
                        "sense_id": "fac5f049-a6fd-3d4e-a50e-f41141197424",
                        "entry_id": "45fc7b8c-3a3f-3d56-9572-33b8071e2506",
                        "glosses": [
                            "Se mettre en opposition face à quelque chose ou à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7017d7a-c212-4bff-8733-1519c9d43b56",
                                "sense_id": "fac5f049-a6fd-3d4e-a50e-f41141197424",
                                "text": "Il y avait d'ailleurs, sur la côte, des postes de douaniers qui se seraient opposés au débarquement, si le navire leur avait paru suspect."
                            },
                            {
                                "example_id": "d2d0aeaa-a589-41f0-9d33-cecdd31d7863",
                                "sense_id": "fac5f049-a6fd-3d4e-a50e-f41141197424",
                                "text": "S'opposer aussi. S'opposer d'abord. S'opposer sans donner le sentiment – comme nous le faisons trop souvent – d'avoir toujours besoin de nous justifier de notre rejet radical de la politique impulsée par la majorité actuelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2e854e2-3c35-3c9f-bc17-c68a1614cf25",
                        "entry_id": "45fc7b8c-3a3f-3d56-9572-33b8071e2506",
                        "glosses": [
                            "Déclarer suivant les formes judiciaires qu’on met empêchement à l’exécution de quelque acte, de quelque arrêt, de quelque formalité de justice."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "831ff5e9-7b42-4fb8-9fe1-da338022072e",
                                "sense_id": "b2e854e2-3c35-3c9f-bc17-c68a1614cf25",
                                "text": "S’opposer à la levée des scellés, à un paiement, à un mariage."
                            }
                        ]
                    }
                ],
