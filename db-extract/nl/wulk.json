                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfc32914-2301-39dd-a376-e2226c23a760",
                                        "entry_id": "5ca1cba4-0e48-3fd0-9bbb-6c79ed0f8e07",
                                        "glosses": [
                                            "Un des noms vernaculaires des différents représentants de la famille des Buccinidae utilisé entre autre sur les côtes picardes, normandes ainsi que sur les côtes charentaises"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f84e9b61-809d-4ead-9187-016bc96ae54e",
                                                "sense_id": "bfc32914-2301-39dd-a376-e2226c23a760",
                                                "text": "Nos marins avaient eu la bonne fortune de trouver sur les bancs un coquillage désigné sous le nom de bulot, pouvant remplacer la boëtte."
                                            },
                                            {
                                                "example_id": "eff0dfc3-c9f0-42ac-b888-afc515aea0b6",
                                                "sense_id": "bfc32914-2301-39dd-a376-e2226c23a760",
                                                "text": "Il me semble qu’à chaque fois j’ai pris des bulots mayonnaise et un homard Thermidor, et qu’à chaque fois j’ai trouvé ça bon, je n’ai jamais éprouvé le besoin, ni même le désir d’explorer le reste de la carte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e839ff01-f85b-3e7c-8cf1-a5731cd03176",
                                        "entry_id": "5ca1cba4-0e48-3fd0-9bbb-6c79ed0f8e07",
                                        "glosses": [
                                            "Imbécile, idiot."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a90f3c4-7fd0-4957-8d7d-867c88a70620",
                                                "sense_id": "e839ff01-f85b-3e7c-8cf1-a5731cd03176",
                                                "text": "Je suis montée dans l’ascenseur avec M. Ozu et il est resté bloqué entre le deuxième et le troisième pendant dix minutes parce qu’un bulot avait mal refermé la grille avant de renoncer à le prendre et de descendre par l’escalier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
