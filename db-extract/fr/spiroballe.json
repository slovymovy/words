                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a86f5241-e110-49a1-bb1f-b201db1870fe",
                        "entry_id": "72b93ac5-4515-338e-823c-7bd38cf992a5",
                        "tags": [
                            "plural"
