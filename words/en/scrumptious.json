{
    "word_family": [
        "scrumptiously",
        "scrumptiousness",
        "scrummy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "929ab596-1331-3b83-9835-0bf0ff89cefa",
                    "sense_definition": "Extremely pleasing to the sense of taste; delicious or delectable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baker prepared a <w>scrumptious</w> chocolate cake for the birthday party.",
                            "target_lang_translations": {
                                "ru": "Пекарь приготовил <w>восхитительный</w> шоколадный торт для вечеринки в честь дня рождения.",
                                "es": "El pastelero preparó un <w>delicioso</w> pastel de chocolate para la fiesta de cumpleaños."
                            }
                        },
                        {
                            "text": "After a long hike, we enjoyed a <w>scrumptious</w> meal at the local tavern.",
                            "target_lang_translations": {
                                "ru": "После долгого похода мы насладились <w>вкуснейшим</w> обедом в местной таверне.",
                                "es": "Tras una larga caminata, disfrutamos de una comida <w>riquísima</w> en la taberna local."
                            }
                        }
                    ],
                    "synonyms": [
                        "delicious",
                        "tasty",
                        "yummy",
                        "mouthwatering",
                        "delectable"
                    ],
                    "common_phrases": [
                        "scrumptious meal",
                        "scrumptious dessert",
                        "scrumptious treat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно приятный на вкус; очень вкусный или восхитительный.",
                        "es": "Extremadamente agradable al sentido del gusto; delicioso o para chuparse los dedos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восхитительный",
                                "target_lang_sense_clarification": "о еде"
                            },
                            {
                                "target_lang_word": "вкуснейший",
                                "target_lang_sense_clarification": "очень вкусный"
                            },
                            {
                                "target_lang_word": "пальчики оближешь",
                                "target_lang_sense_clarification": "разговорное о еде"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "delicioso",
                                "target_lang_sense_clarification": "muy sabroso, referido a comida"
                            },
                            {
                                "target_lang_word": "riquísimo",
                                "target_lang_sense_clarification": "de excelente sabor"
                            },
                            {
                                "target_lang_word": "exquisito",
                                "target_lang_sense_clarification": "de sabor extraordinario y refinado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12559822-76fe-326c-a1b1-c1a65d540b5f",
                    "sense_definition": "Very attractive, excellent, or wonderful in appearance or quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked absolutely <w>scrumptious</w> in her new silk evening gown.",
                            "target_lang_translations": {
                                "ru": "Она выглядела просто <w>потрясающе</w> в своем новом шелковом вечернем платье.",
                                "es": "Ella se veía absolutamente <w>espléndida</w> con su nuevo vestido de noche de seda."
                            }
                        },
                        {
                            "text": "The boutique was filled with a <w>scrumptious</w> collection of handmade jewelry.",
                            "target_lang_translations": {
                                "ru": "Бутик был наполнен <w>великолепной</w> коллекцией украшений ручной работы.",
                                "es": "La boutique estaba llena de una <w>maravillosa</w> colección de joyas hechas a mano."
                            }
                        }
                    ],
                    "synonyms": [
                        "exquisite",
                        "wonderful",
                        "attractive",
                        "splendid"
                    ],
                    "common_phrases": [
                        "scrumptious collection",
                        "look scrumptious"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe people or things as highly attractive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень привлекательный, превосходный или замечательный по внешнему виду или качеству.",
                        "es": "Muy atractivo, excelente o maravilloso en apariencia o calidad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "великолепный",
                                "target_lang_sense_clarification": "о внешнем виде или качестве"
                            },
                            {
                                "target_lang_word": "изысканный",
                                "target_lang_sense_clarification": "о вещах или стиле"
                            },
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "о внешности"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "espléndido",
                                "target_lang_sense_clarification": "magnífico o admirable en apariencia"
                            },
                            {
                                "target_lang_word": "maravilloso",
                                "target_lang_sense_clarification": "excelente o fantástico"
                            },
                            {
                                "target_lang_word": "atractivo",
                                "target_lang_sense_clarification": "que llama la atención positivamente por su aspecto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "375cbcc5-ea41-342e-a7ae-bfb9455cb969",
                    "sense_definition": "Being overly particular or fastidious; picky.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known to be quite <w>scrumptious</w> about the exact placement of his books.",
                            "target_lang_translations": {
                                "ru": "Он был известен тем, что был весьма <w>привередлив</w> в вопросе точного расположения своих книг.",
                                "es": "Era conocido por ser bastante <w>quisquilloso</w> con la ubicación exacta de sus libros."
                            }
                        },
                        {
                            "text": "The <w>scrumptious</w> critic refused to eat at any restaurant without three stars.",
                            "target_lang_translations": {
                                "ru": "<w>Разборчивый</w> критик отказывался есть в любом ресторане, у которого не было трех звезд.",
                                "es": "El <w>exigente</w> crítico se negaba a comer en cualquier restaurante que no tuviera tres estrellas."
                            }
                        }
                    ],
                    "synonyms": [
                        "fastidious",
                        "picky",
                        "fussy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "rare or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно требовательный или привередливый; разборчивый.",
                        "es": "Excesivamente exigente, minucioso o difícil de complacer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привередливый",
                                "target_lang_sense_clarification": "о характере"
                            },
                            {
                                "target_lang_word": "разборчивый",
                                "target_lang_sense_clarification": "о требованиях"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "quisquilloso",
                                "target_lang_sense_clarification": "excesivamente meticuloso o difícil de complacer"
                            },
                            {
                                "target_lang_word": "tiquismiquis",
                                "target_lang_sense_clarification": "coloquial, muy detallista o escrupuloso"
                            },
                            {
                                "target_lang_word": "exigente",
                                "target_lang_sense_clarification": "con estándares muy altos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f72b122-a024-3bff-88cd-827d542b41cf",
                    "sense_definition": "Extremely small in size; tiny.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dollhouse was decorated with <w>scrumptious</w> little pieces of furniture.",
                            "target_lang_translations": {
                                "ru": "Кукольный домик был обставлен <w>крошечными</w> предметами мебели.",
                                "es": "La casa de muñecas estaba decorada con <w>diminutos</w> muebles pequeños."
                            }
                        },
                        {
                            "text": "She found a <w>scrumptious</w> fragment of ancient pottery in the garden.",
                            "target_lang_translations": {
                                "ru": "Она нашла в саду <w>малюсенький</w> фрагмент древней керамики.",
                                "es": "Ella encontró un <w>minúsculo</w> fragmento de cerámica antigua en el jardín."
                            }
                        }
                    ],
                    "synonyms": [
                        "tiny",
                        "minute",
                        "small"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "rare or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно маленький по размеру; крошечный.",
                        "es": "Extremadamente pequeño de tamaño; diminuto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крошечный",
                                "target_lang_sense_clarification": "о размере"
                            },
                            {
                                "target_lang_word": "малюсенький",
                                "target_lang_sense_clarification": "разговорное о размере"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "diminuto",
                                "target_lang_sense_clarification": "sumamente pequeño"
                            },
                            {
                                "target_lang_word": "minúsculo",
                                "target_lang_sense_clarification": "de tamaño insignificante o muy reducido"
                            }
                        ]
                    }
                }
            ]
        }
