{
    "word_family": [
        "salvageable",
        "salvager",
        "salvageability"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9df03b8d-fa57-3e51-9b9e-08d7fcc32469",
                    "sense_definition": "To rescue or save something from potential loss, destruction, or failure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rescue_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team managed to <w>salvage</w> a draw in the final minutes of the match.",
                            "target_lang_translations": {
                                "ru": "Команде удалось <w>вырвать</w> ничью на последних минутах матча."
                            }
                        },
                        {
                            "text": "He tried to <w>salvage</w> his reputation after the scandal became public.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>спасти</w> свою репутацию после того, как скандал стал достоянием общественности."
                            }
                        }
                    ],
                    "synonyms": [
                        "rescue",
                        "save",
                        "retrieve",
                        "recover"
                    ],
                    "antonyms": [
                        "abandon",
                        "lose",
                        "discard"
                    ],
                    "common_phrases": [
                        "salvage a draw",
                        "salvage a reputation",
                        "salvage the situation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спасти или уберечь что-либо от потенциальной потери, разрушения или неудачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасать",
                                "target_lang_sense_clarification": "выручать из беды или сохранять ситуацию"
                            },
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "удерживать от окончательной потери"
                            },
                            {
                                "target_lang_word": "исправлять",
                                "target_lang_sense_clarification": "улучшать положение дел"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20fe7c6c-bba3-392b-a8a8-8115fa26d89d",
                    "sense_definition": "To collect and put discarded or damaged materials to good use, often for recycling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recycling_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were able to <w>salvage</w> scrap metal from the old factory to assist the war effort.",
                            "target_lang_translations": {
                                "ru": "Они смогли <w>собрать</w> металлолом на старом заводе, чтобы помочь военным усилиям."
                            }
                        },
                        {
                            "text": "We can <w>salvage</w> parts from the broken computer to fix the other one.",
                            "target_lang_translations": {
                                "ru": "Мы можем <w>использовать</w> детали от сломанного компьютера, чтобы починить другой."
                            }
                        }
                    ],
                    "synonyms": [
                        "recycle",
                        "reclaim",
                        "repurpose"
                    ],
                    "antonyms": [
                        "waste",
                        "scrap"
                    ],
                    "common_phrases": [
                        "salvage scrap metal",
                        "salvage usable parts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать и использовать выброшенные или поврежденные материалы, часто для переработки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утилизировать",
                                "target_lang_sense_clarification": "использовать отходы повторно"
                            },
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "извлекать полезные детали из лома"
                            },
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "возвращать в использование старые вещи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfc6696a-7ea3-3792-85de-3e0e6634db82",
                    "sense_definition": "To apprehend and execute a suspected criminal without a trial.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "extrajudicial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The paramilitary group was known to <w>salvage</w> those they accused of being informants.",
                            "target_lang_translations": {
                                "ru": "Военизированная группировка была известна тем, что <w>казнила без суда</w> тех, кого обвиняла в осведомительстве."
                            }
                        },
                        {
                            "text": "Human rights groups condemned the practice to <w>salvage</w> suspects without due process.",
                            "target_lang_translations": {
                                "ru": "Правозащитные группы осудили практику <w>расправы</w> над подозреваемыми без надлежащего судебного разбирательства."
                            }
                        }
                    ],
                    "synonyms": [
                        "execute",
                        "lynch"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Philippines"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Задержать и казнить подозреваемого преступника без суда и следствия (региональное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "линчевать",
                                "target_lang_sense_clarification": "внесудебная расправа"
                            },
                            {
                                "target_lang_word": "казнить",
                                "target_lang_sense_clarification": "без законного разбирательства"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3129de26-35cb-3537-b7f9-8ceb2d7d169b",
                    "sense_definition": "The act of rescuing a ship, its cargo, or its crew from a dangerous situation at sea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rescue_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>salvage</w> operation was delayed due to the heavy storms in the Atlantic.",
                            "target_lang_translations": {
                                "ru": "Операция по <w>спасению</w> была отложена из-за сильных штормов в Атлантике."
                            }
                        },
                        {
                            "text": "Specialized divers were hired to assist with the <w>salvage</w> of the sunken vessel.",
                            "target_lang_translations": {
                                "ru": "Для помощи в <w>подъеме</w> затонувшего судна были наняты специализированные водолазы."
                            }
                        }
                    ],
                    "synonyms": [
                        "recovery",
                        "rescue",
                        "retrieval"
                    ],
                    "antonyms": [
                        "abandonment"
                    ],
                    "common_phrases": [
                        "salvage operation",
                        "marine salvage",
                        "salvage crew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт спасения судна, его груза или экипажа из опасной ситуации на море."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасение",
                                "target_lang_sense_clarification": "имущества или судна на море"
                            },
                            {
                                "target_lang_word": "спасание",
                                "target_lang_sense_clarification": "технический термин для спасательных работ"
                            },
                            {
                                "target_lang_word": "подъем",
                                "target_lang_sense_clarification": "затонувших судов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b1b32ac-2cf1-3c87-bef8-af3970f4c13d",
                    "sense_definition": "Materials or goods that have been saved from destruction or waste to be reused.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist creates beautiful sculptures using only <w>salvage</w> from local junkyards.",
                            "target_lang_translations": {
                                "ru": "Художник создает прекрасные скульптуры, используя только <w>утиль</w> с местных свалок."
                            }
                        },
                        {
                            "text": "They bought a car at a <w>salvage</w> yard to use for spare parts.",
                            "target_lang_translations": {
                                "ru": "Они купили машину на <w>разборке</w>, чтобы использовать её на запчасти."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrap",
                        "waste",
                        "junk"
                    ],
                    "common_phrases": [
                        "salvage yard",
                        "salvage value",
                        "salvage rights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материалы или товары, спасенные от уничтожения для повторного использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утиль",
                                "target_lang_sense_clarification": "вторичное сырье"
                            },
                            {
                                "target_lang_word": "лом",
                                "target_lang_sense_clarification": "металлические отходы для переработки"
                            },
                            {
                                "target_lang_word": "спасенное имущество",
                                "target_lang_sense_clarification": "вещи, уцелевшие после аварии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56db3a1b-e0d5-30ea-8d20-0c57ea60a804",
                    "sense_definition": "The financial compensation paid to those who successfully rescue a ship or its cargo.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court awarded a significant amount of <w>salvage</w> to the tugboat company.",
                            "target_lang_translations": {
                                "ru": "Суд присудил компании, владеющей буксиром, значительную сумму <w>вознаграждения за спасение</w>."
                            }
                        },
                        {
                            "text": "Under maritime law, the rescuers are entitled to claim <w>salvage</w> for their efforts.",
                            "target_lang_translations": {
                                "ru": "Согласно морскому праву, спасатели имеют право требовать <w>выплату за спасение</w> за свои усилия."
                            }
                        }
                    ],
                    "synonyms": [
                        "compensation",
                        "reward"
                    ],
                    "common_phrases": [
                        "claim salvage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Денежное вознаграждение, выплачиваемое тем, кто успешно спас судно или его груз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вознаграждение за спасение",
                                "target_lang_sense_clarification": "юридический термин в морском праве"
                            },
                            {
                                "target_lang_word": "спасательная премия",
                                "target_lang_sense_clarification": "выплата спасателям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6728895a-f70a-3af1-bab3-dca69f489690",
                    "sense_definition": "An <w>obsolete</w> spelling of <w>savage</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "obsolete_spelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old manuscript, the explorer described the <w>salvage</w> tribes of the island.",
                            "target_lang_translations": {
                                "ru": "В старинной рукописи исследователь описывал <w>дикие</w> племена острова."
                            }
                        },
                        {
                            "text": "The poet used the word <w>salvage</w> to refer to the wild berries of the wood.",
                            "target_lang_translations": {
                                "ru": "Поэт использовал слово «salvage», имея в виду <w>дикорастущие</w> лесные ягоды."
                            }
                        }
                    ],
                    "synonyms": [
                        "savage"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "spelling of savage"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова «savage» (дикий)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "устаревшее значение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f52eedd8-dfe7-3454-9b21-84cd1b87f541",
                    "sense_definition": "A small town located in Newfoundland and Labrador, Canada.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The historic community of <w>Salvage</w> is one of the oldest settlements in the province.",
                            "target_lang_translations": {
                                "ru": "Историческая община <w>Салвидж</w> является одним из старейших поселений в провинции."
                            }
                        },
                        {
                            "text": "Tourists often visit <w>Salvage</w> for its rugged coastal scenery and hiking trails.",
                            "target_lang_translations": {
                                "ru": "Туристы часто посещают <w>Салвидж</w> ради его суровых прибрежных пейзажей и пешеходных троп."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой город, расположенный в Ньюфаундленде и Лабрадоре, Канада."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Салвидж",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}