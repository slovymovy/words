                "senses": [
                    {
                        "sense_id": "0917d3f0-5cef-3905-a3fa-166d95b5e4fa",
                        "entry_id": "2cb12b97-15f6-36a5-a128-0d2f974e6e38",
                        "glosses": [
                            "Mathematik, Mengenlehre: Menge, die alle Elemente einer anderen Menge umfasst und vielleicht noch mehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e69a1c5-33b1-4daf-bf41-636af84e03ef",
                                "sense_id": "0917d3f0-5cef-3905-a3fa-166d95b5e4fa",
                                "text": "Jede Menge ist Obermenge der leeren Menge, also auch sie selbst."
                            },
                            {
                                "example_id": "9d8f950a-bc8b-41b7-8289-fa6fa1004bbc",
                                "sense_id": "0917d3f0-5cef-3905-a3fa-166d95b5e4fa",
                                "text": "Eine Obermenge heißt echt, wenn sie zusätzliche Elemente besitzt, sonst unecht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf888135-7d61-4c47-9c47-8f9e2b751ef5",
                        "source_entry_id": "2cb12b97-15f6-36a5-a128-0d2f974e6e38",
                        "source_sense_id": "0917d3f0-5cef-3905-a3fa-166d95b5e4fa",
                        "source_sense_description": "Mathematik, Mengenlehre: Menge, die alle Elemente einer anderen Menge umfasst und vielleicht noch mehr",
                        "target_lang_word": "superset",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2f3a0ca-d942-3f42-83e7-786ce34c3b5c",
                                        "entry_id": "4fe529aa-5183-3951-9047-0d06009fb2b5",
                                        "glosses": [
                                            "(symbol: ⊇) With respect to another set, a set such that each of the elements of the other set is also an element of the set."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7145cb3a-3007-4040-8c7d-70d32d495148",
                                                "sense_id": "e2f3a0ca-d942-3f42-83e7-786ce34c3b5c",
                                                "text": "The set of human beings is a superset of the set of human children."
                                            },
                                            {
                                                "example_id": "c5967817-e62d-4a5f-9133-57cf6d60de66",
                                                "sense_id": "e2f3a0ca-d942-3f42-83e7-786ce34c3b5c",
                                                "text": "The set of characters \"LBPG\" is a superset of the set of characters \"PG\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cf304be-dcaf-3039-b396-a34fb00167f7",
                                        "entry_id": "4fe529aa-5183-3951-9047-0d06009fb2b5",
                                        "glosses": [
                                            "Two or more different physical exercises performed back to back (i.e., without a period of rest between them). The exercises may employ the same muscle group, or opposing muscle groups."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a269a599-e44f-4b2e-ba59-425eaa98729d",
                                                "sense_id": "9cf304be-dcaf-3039-b396-a34fb00167f7",
                                                "text": "While some lifters insist that supersets must consist of consecutive exercises for the same bodypart, others would bet their weight belts that supersets involve opposing bodyparts."
                                            },
                                            {
                                                "example_id": "f3dbfa97-a7e0-4792-9475-0544051bcf05",
                                                "sense_id": "9cf304be-dcaf-3039-b396-a34fb00167f7",
                                                "text": "A superset is a combination of two or three different exercises back to back. For example, you start with bodyweight press up and switch to TRX chest press with few seconds to no rest in between."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "superset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aec6cdc3-14fb-3637-b0c6-ccb1d08e6bbc",
                                        "entry_id": "9f0d29a7-30c0-3221-9836-bb9ab04066f1",
                                        "glosses": [
                                            "To perform (different physical exercises) back to back, without a period of rest between them."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb66a4c1-ae36-4a00-8686-2e917ebe9d39",
                                                "sense_id": "aec6cdc3-14fb-3637-b0c6-ccb1d08e6bbc",
                                                "text": "An example would be cable curls supersetted with tricep pushdowns, or leg extensions supersetted with leg curls."
                                            },
                                            {
                                                "example_id": "b9e45ce8-7cc2-412c-a7a2-7eca56870bb5",
                                                "sense_id": "aec6cdc3-14fb-3637-b0c6-ccb1d08e6bbc",
                                                "text": "“If you’re using more than one piece of equipment, make sure you’re close to them at all times,” says fitness coach JC Deen of JCD Fitness. Walk away for more than 15 to 30 seconds, and most people will assume you’re done, Deen says. “Supersetting is a luxury, not a necessity,” adds strength coach and author Bret Contreras. Bottom line: “If the gym is busy, don’t superset!”"
                                            },
                                            {
                                                "example_id": "986b3a00-943d-4b50-916d-021df488cf7f",
                                                "sense_id": "aec6cdc3-14fb-3637-b0c6-ccb1d08e6bbc",
                                                "text": "Antagonist supersets involve supersetting opposite motions or muscle groups."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b91827dd-bc16-47c8-99db-5bc2dbdf0338",
                        "source_entry_id": "2cb12b97-15f6-36a5-a128-0d2f974e6e38",
                        "source_sense_id": "0917d3f0-5cef-3905-a3fa-166d95b5e4fa",
                        "source_sense_description": "Mathematik, Mengenlehre: Menge, die alle Elemente einer anderen Menge umfasst und vielleicht noch mehr",
                        "target_lang_word": "sur-ensemble",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sur-ensemble",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f1e95c3-2341-3285-af00-974ad608cc2e",
                                        "entry_id": "80115a81-4e85-3b03-ad04-ddcefa22038d",
                                        "glosses": [
                                            "Partie qui englobe un ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd1a05c7-8a8f-4ea8-b968-508c9cc5eaad",
                                                "sense_id": "1f1e95c3-2341-3285-af00-974ad608cc2e",
                                                "text": "L’objet est toujours un sur-ensemble de l’objet connu."
                                            },
                                            {
                                                "example_id": "d3c28e06-036d-4f23-974e-911b854fc226",
                                                "sense_id": "1f1e95c3-2341-3285-af00-974ad608cc2e",
                                                "text": "En mathématiques, un ensemble A est un sous-ensemble ou une partie d’un ensemble B, ou encore B est un sur-ensemble de A, si tout élément du sous-ensemble A est aussi élément du sur-ensemble B."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b9eec83-aba4-39af-8dd1-70ce26f96f5d",
                                        "entry_id": "80115a81-4e85-3b03-ad04-ddcefa22038d",
                                        "glosses": [
                                            "Langage de programmation basé sur un autre langage qu'il enrichit de fonctionnalités supplémentaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf7357f-8a52-4c57-a025-dee2949b245c",
                                                "sense_id": "4b9eec83-aba4-39af-8dd1-70ce26f96f5d",
                                                "text": "La version 2.0 du framework Angular JS, conçu pour le développement d’applications web et maintenu par Google, sera construite sur TypeScript, le sur-ensemble à JavaScript que Microsoft a introduit pour la première fois il y a trois ans."
                                            },
                                            {
                                                "example_id": "90add8d0-d13a-451e-9240-e0a53b52d1cc",
                                                "sense_id": "4b9eec83-aba4-39af-8dd1-70ce26f96f5d",
                                                "text": "Simula est un sur-ensemble d’Algol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
