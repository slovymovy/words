                        "source_sense_id": "4fdc3fbe-a69f-37b3-9a83-3cd7b3a0eb67",
                        "source_sense_description": "Schild, auf dem ein Verkehrszeichen abgebildet ist",
                        "target_lang_word": "verkeersbord",
                        "target_lang_code": "nl",
