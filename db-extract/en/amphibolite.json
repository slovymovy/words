                        "cross_references": [
                            {
                                "target_word": "αμφιβολίτης",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "bdf4c44e-2df3-37b1-bdac-e58cfc15f4a9",
                                        "entry_id": "fc130549-a04d-38d7-a6ea-d214a79ab880",
                                        "glosses": [
                                            "είδος μεταμορφωμένου πετρώματος"
                                        ],
                                        "tags": [
                                            "ορυκτολογία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "866235b6-1bf0-4384-ba11-0e7c74033c9b",
                                                "sense_id": "bdf4c44e-2df3-37b1-bdac-e58cfc15f4a9",
                                                "text": "※ O αμφιβολίτης είναι ένα μεταμορφωμένο πέτρωμα, το οποίο αποτελείται κυρίως από ορυκτά της ομάδας των αμφιβόλων (κεροστίλβη, ακτινόλιθος) και Ca-Na-ούχο άστριο (πλαγιόκλαστο). Εμφανίζεται με βαθυπράσινο χρώμα και χαρακτηρίζεται από ασθενή έως καθόλου σχιστότητα. Ο αμφιβολίτης εμφανίζεται σε αρκετές περιοχές στην Ελλάδα, σε πεδία με μεταμορφωμένα πετρώματα.",
                                                "translation": "Αμφιβολίτης, @orykta.gr, ημερομηνία ανάκτησης: 25-04-2024."
                                            },
                                            {
                                                "example_id": "7b43f7f4-73a9-4f2b-aa96-ff8554067938",
                                                "sense_id": "bdf4c44e-2df3-37b1-bdac-e58cfc15f4a9",
                                                "text": "※ O αμφιβολίτης έχει ως ουσιώδη ορυκτολογικά συστατικά κεροστίλβη και πλαγιόκλαστα. Προκύπτει από μέσου βαθμού μεταμόρφωση γαββρικών πετρωμάτων και ασβεστομαγνησιούχων αργιλικών ιζημάτων.",
                                                "translation": "Μεταμορφωμένα πετρώματα, @geo.auth.gr, ημερομηνία ανάκτησης: 25-04-2024."
                                            },
                                            {
                                                "example_id": "baa140e0-c744-40b2-a611-180de6cd53de",
                                                "sense_id": "bdf4c44e-2df3-37b1-bdac-e58cfc15f4a9",
                                                "text": "※ Οι πρασινοσχιστόλιθοι μαζί με τους αμφιβολίτες αποτελούν μεταμορφωμένα πετρώματα, συνήθη στην Νοτιοδυτική περιοχή της Σερίφου. Με μείωση του βαθμού μεταμόρφωσης ο αμφιβολίτης μετατρέπεται σε πρασινοσχιστόλιθο.",
                                                "translation": "Πράσιος χαλαζίας Σερίφου: Αισθητική ομορφιά αλλά και θωπεία της θλίψης, 19-09-2020, συντάκτης: Πέτρος Τζεφέρης, @huffingtonpost.gr, ημερομηνία ανάκτησης: 25-04-2024."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
