                                    {
                                        "sense_id": "28eca21f-0aa6-3265-abcf-15b9bfdc8624",
                                        "entry_id": "0fa19141-a74e-325c-800e-99dddf6b8352",
                                        "glosses": [
                                            "一種起源於古代中國、廣泛用於東亞、東南亞的餐具；通常兩支一對，用於將食物夾起並送入口中，或用於攪拌液體"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ee897e-cb0a-4f19-86cf-a8b7660d3282",
                                                "sense_id": "28eca21f-0aa6-3265-abcf-15b9bfdc8624",
                                                "text": "用筷子吃飯"
                                            },
                                            {
                                                "example_id": "8cec5746-1495-4484-9cdf-e50ca2591439",
                                                "sense_id": "28eca21f-0aa6-3265-abcf-15b9bfdc8624",
                                                "text": "用筷子吃饭"
                                            },
                                            {
                                                "example_id": "2d40db60-0674-499a-ab1a-16588518401c",
                                                "sense_id": "28eca21f-0aa6-3265-abcf-15b9bfdc8624",
                                                "text": "一次性筷子"
                                            },
                                            {
                                                "example_id": "5bee5e1b-82d1-44d0-9647-58e480c86bf4",
                                                "sense_id": "28eca21f-0aa6-3265-abcf-15b9bfdc8624",
                                                "text": "原是鳳姐和鴛鴦商議定了，單拿一雙老年四楞象牙鑲金的筷子與劉姥姥。"
                                            },
                                            {
                                                "example_id": "fc6415f3-2f9f-4d27-bc5b-cd7e9598b8b6",
                                                "sense_id": "28eca21f-0aa6-3265-abcf-15b9bfdc8624",
                                                "text": "原是凤姐和鸳鸯商议定了，单拿一双老年四楞象牙镶金的筷子与刘姥姥。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
