                        ],
                        "ru": [
                            {
                                "target_lang_word": "застёжка",
                                "target_lang_sense_clarification": "книжная"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "fermoir",
                                "target_lang_sense_clarification": "pièce métallique pour fermer un livre ou reluire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e615f9b1-fe98-3126-aca8-55dd5ad39a3e",
                    "sense_definition": "Een draaibare sluiting (wervel) op een deur of raam.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Draai de <w>krap</w> om zodat het raam niet openwaait.",
                            "target_lang_translations": {
                                "en": "Turn the <w>latch</w> so the window doesn't blow open.",
                                "ru": "Поверни <w>завёртку</w>, чтобы окно не распахнулось.",
                                "fr": "Tourne le <w>tourniquet</w> pour que la fenêtre ne s'ouvre pas avec le vent."
                            }
                        },
                        {
                            "text": "De houten <w>krap</w> op de schuurdeur was versleten.",
                            "target_lang_translations": {
                                "en": "The wooden <w>turnbuckle</w> on the barn door was worn out.",
                                "ru": "Деревянная <w>щеколда</w> на двери сарая износилась.",
                                "fr": "Le <w>loquet</w> en bois sur la porte de la grange était usé."
                            }
                        }
