                "translations": [
                    {
                        "translation_id": "55b97213-d82f-458a-9574-729b31fa36f0",
                        "source_entry_id": "b2a6ff68-7f7e-3e96-9e54-e379a835b24f",
                        "source_sense_id": "c9357336-bc37-3884-a26b-c0a8a763f752",
                        "target_lang_word": "isatin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isatin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21b54203-491d-39e3-9d06-b997d24c2fa4",
                                        "entry_id": "67c6d088-f30b-3616-9fa9-de2f52bad1cd",
                                        "glosses": [
                                            "The indole derivative 1H-indole-2,3-dione, used in the synthesis of dyes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d57cde28-4b2f-47a9-a97c-efbf96beb556",
                                                "sense_id": "21b54203-491d-39e3-9d06-b997d24c2fa4",
                                                "text": "This finding suggests that the gut flora (absent, of course, in germ free animals) are responsible for the generation of most urinary isatin, but that the tissue material derives from a different source."
                                            },
                                            {
                                                "example_id": "976b79ee-140c-4c01-b882-5d618252cc18",
                                                "sense_id": "21b54203-491d-39e3-9d06-b997d24c2fa4",
                                                "text": "One problem in large scale denim dyeing processes using biologically produced indigo is the undesirable red cast caused by indirubin, which is a structural isomer of indigo formed from indoxyl and isatin, a byproduct of the spontaneous oxidation reaction that converts indoxyl to indigo."
                                            },
                                            {
                                                "example_id": "3e955759-18ea-4fe4-a33d-9c8f818c7fbb",
                                                "sense_id": "21b54203-491d-39e3-9d06-b997d24c2fa4",
                                                "text": "Isatin reacts with formaldehyde and a variety of amines in the Mannich reaction to give their respective bases (10), in the absence of an amine, isatin and substituted isatin with formaldehyde give hydroxymethyl isatins (11)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
