                "senses": [
                    {
                        "sense_id": "631dfa72-81e2-37ce-8fd5-3c56aa17b187",
                        "entry_id": "ffa3bfe1-2238-37de-bc8a-7c915f95fae7",
                        "glosses": [
                            "Agente chargée par un gouvernement de protéger les intérêts privés et commerciaux des nationaux résidant à l’étranger, d’exercer à leur égard diverses attributions de l’État et, dans certains pays, une juridiction, etc."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "215273b0-1660-4ad0-914f-5f002e4009c3",
                                "sense_id": "631dfa72-81e2-37ce-8fd5-3c56aa17b187",
                                "text": "et alors elle songeait à l’éternelle inanition de ceux que le Juge damne et elle implorait, à genoux, l’Avocate de la terre, la Consule du ciel"
                            },
                            {
                                "example_id": "6e9c65dd-4d63-4016-a322-cbb7a4a12cc8",
                                "sense_id": "631dfa72-81e2-37ce-8fd5-3c56aa17b187",
                                "text": "C'est ce que la consule, rejointe au dixième trou du Kigali Golf Club, avait ordonné à Lamarre."
                            },
                            {
                                "example_id": "a6633595-f6cf-4307-ab2a-1de1057a5d39",
                                "sense_id": "631dfa72-81e2-37ce-8fd5-3c56aa17b187",
                                "text": "La consule générale."
                            }
                        ]
                    }
                ],
