                    ],
                    "target_lang_definitions": {
                        "ru": "Струнный щипковый инструмент с длинной шейкой и корпусом в форме восьмёрки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тар",
                                "target_lang_sense_clarification": "восточный струнный щипковый инструмент"
                            }
