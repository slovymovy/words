        "fr-extract.jsonl": [
            {
                "entry_id": "1d1f5d65-7c87-39f3-b142-813325164345",
                "word": "Garonne",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7a96f84e-cd7c-319e-9a96-3f8431678f9b",
                        "entry_id": "1d1f5d65-7c87-39f3-b142-813325164345",
                        "glosses": [
                            "Fleuve dont une partie se situe en Espagne et l’autre en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3adc1b3a-1384-4acc-a4e6-f545cc414889",
                                "sense_id": "7a96f84e-cd7c-319e-9a96-3f8431678f9b",
                                "text": "La charrette s'arrêtait au bord de la gaure. C'était un petit bras de la Garonne, fermé d'un bout, comblé par la vase au temps de la sécheresse estivale, et communiquant, de l'autre, avec le fleuve dont les derniers remous, largement étalés, venaient mourir là, dans la tranquillité de l'eau morte."
                            },
                            {
                                "example_id": "5627a6e7-f8cb-4504-b210-52388828a8fa",
                                "sense_id": "7a96f84e-cd7c-319e-9a96-3f8431678f9b",
                                "text": "Pour donner , en effet, un digne apanage à son frère, Louis XI joignit au pays de Guyenne les judicatures du pays toulousain qui se trouvaient sur la rive gauche de la Garonne."
                            },
                            {
                                "example_id": "c6a5d587-45e5-4ae5-8a67-792e5d2f75bd",
                                "sense_id": "7a96f84e-cd7c-319e-9a96-3f8431678f9b",
                                "text": "La Garonne devenant divagante multiplie, à loisir, les « gaules » ou « gaures », c'est-à-dire ses bras, et les « îles », résultant de l’atterrissement des graviers vite envahis par la végétation spontanée et bientôt exhaussées par la rétention du limon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64f30384-8c47-4010-89bd-7d928d479cbf",
                        "source_entry_id": "1d1f5d65-7c87-39f3-b142-813325164345",
                        "source_sense_id": "7a96f84e-cd7c-319e-9a96-3f8431678f9b",
                        "target_lang_word": "Garonne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Garonne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb5b9933-6445-3fe3-a7fb-914634e13516",
                                        "entry_id": "5feb2985-cf05-389b-99ba-a6837c3b09f6",
                                        "glosses": [
                                            "südwestfranzösischer Fluss"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "780dae35-d5a2-4724-9abd-1adcb9c48515",
                                                "sense_id": "cb5b9933-6445-3fe3-a7fb-914634e13516",
                                                "text": "„Das an der Garonne liegende Toulouse ist mit fast 1,3 Millionen Einwohnern in der Metropolenregion die viertgrößte Stadt Frankreichs.“"
                                            },
                                            {
                                                "example_id": "6b3eb85a-0cc2-452c-980c-5badb725d04e",
                                                "sense_id": "cb5b9933-6445-3fe3-a7fb-914634e13516",
                                                "text": "„Wir fuhren in einem großen sinnlosen Bogen, bald in Asylen übernachtend, bald auf Waggons, nirgends auf eine Bleibe stoßend, geschweige denn auf ein Arbeitsangebot, in einem großen Bogen immer tiefer dem Süden zu, über die Loire, über die Garonne, bis zur Rhone.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
