                ],
                "senses": [
                    {
                        "sense_id": "8bf96d46-1d5a-344c-be35-c40affb06b11",
                        "entry_id": "fb767920-08cc-30ce-99e3-424e2a8df678",
                        "glosses": [
                            "Kufe an einem Schlitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17bc05a5-84c1-4030-9e22-d6168cf257e9",
                                "sense_id": "8bf96d46-1d5a-344c-be35-c40affb06b11",
                                "text": "„Die Pumpenschwengel zogen schiefe Querstriche über den Himmel, und kalt war es, so kalt, daß der Schnee unter den Hufen des Pferdes und den Schlittenkufen knirschte und krachte, so kalt, daß selbst die Sterne zu frieren schienen;“"
                            },
                            {
                                "example_id": "933658ee-d496-452c-8703-2cbb7d4a2f00",
                                "sense_id": "8bf96d46-1d5a-344c-be35-c40affb06b11",
                                "text": "„Will man links fahren, so schlägt man den Stab rechts auf den Schnee oder klopft leise an die vordere rechte Schlittenkufe, und ebenso umgekehrt, wenn man nach rechts fahren will.“"
                            },
                            {
                                "example_id": "43dfdd56-31b5-4f58-a128-5d49cca6ca8f",
                                "sense_id": "8bf96d46-1d5a-344c-be35-c40affb06b11",
                                "text": "„Der einseitig angelegte Hemmschuh bewirkte, daß die stillstehenden Wagenräder wie eine Schlittenkufe rutschten.“"
                            },
                            {
                                "example_id": "b12df3b0-bb81-4108-ba6d-748f3d551221",
                                "sense_id": "8bf96d46-1d5a-344c-be35-c40affb06b11",
                                "text": "„…; er ergriff ihre Arme, sie schüttelte sich kräftig, auf der glatten Spur der Schlittenkufe glitt er aus, er griff um sich, aber er fiel in den lockeren Schnee; …“"
                            },
                            {
                                "example_id": "4ade93d8-2066-4dce-984b-3959c535fa54",
                                "sense_id": "8bf96d46-1d5a-344c-be35-c40affb06b11",
                                "text": "„Der Frost schien noch stärker als in der Nacht. Von oben schneite es nicht mehr, doch der heftige trockene Wind wirbelte noch immer den Schneestaub im Felde empor, besonders aber unter den Hufen der Pferde und den Schlittenkufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
