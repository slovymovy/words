                                    {
                                        "sense_id": "2d035eca-f4d4-352d-b85b-6d8f37ef73fc",
                                        "entry_id": "b8ee541f-eb8b-3b5e-94a3-ae3be9cd443b",
                                        "glosses": [
                                            "To work or perform as a partner."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10c01a32-d337-48f9-94ff-ede6203fd687",
                                                "sense_id": "2d035eca-f4d4-352d-b85b-6d8f37ef73fc",
                                                "text": "“In the current period, when people are embedded in social and informational bubbles with like-minded friends and relatives,” he says, “the idea of partnering with someone from a different bubble is understandably daunting. At a minimum it’s awkward and complicated.”"
                                            },
                                            {
                                                "example_id": "5117d77e-9e61-4fe9-929e-f1b1d2931e3c",
                                                "sense_id": "2d035eca-f4d4-352d-b85b-6d8f37ef73fc",
                                                "text": "Tesco has partnered with Direct Rail Services (DRS) to launch a new refrigerated rail freight service from Tilbury to Coatbridge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
