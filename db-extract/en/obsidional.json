                        "cross_references": [
                            {
                                "target_word": "obsidional",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5961f4ec-0708-3327-ae83-a6584c64c4d8",
                                        "entry_id": "aa1860d3-0d1b-3fcb-96c1-0fde0ed83e1a",
                                        "glosses": [
                                            "Qui concerne le siège d’une ville."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78686790-92ce-47bd-af1d-eab3e00c3d2a",
                                                "sense_id": "5961f4ec-0708-3327-ae83-a6584c64c4d8",
                                                "text": "En période obsidionale, les femmes s'occupent essentiellement de la logistique, du moral et de la \"défense passive\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fd590bd-db5e-3f7b-8cc9-334451f927c3",
                                        "entry_id": "aa1860d3-0d1b-3fcb-96c1-0fde0ed83e1a",
                                        "glosses": [
                                            "Qui concerne la pathologie d’une personne qui se croit assiégée ou persécutée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9678aaa-3522-4a95-a313-5e84232ee7da",
                                                "sense_id": "0fd590bd-db5e-3f7b-8cc9-334451f927c3",
                                                "text": "C'est ainsi que s'était développée une fièvre obsidionale ..."
                                            },
                                            {
                                                "example_id": "fcf5b1fe-a8f6-4b33-a2f8-6dd5ee2ef9a8",
                                                "sense_id": "0fd590bd-db5e-3f7b-8cc9-334451f927c3",
                                                "text": "Cette poignée d'hommes défiant la montée des vagues me rappelle nos ivresses obsidionales d'enfants tenant le coup jusqu'à la fin, sur ces mêmes plages, sous ce même ciel gris, dans nos forts de sable insidieusement envahis par l'eau."
                                            },
                                            {
                                                "example_id": "94cd3e75-7549-4121-a99f-f42eb857255d",
                                                "sense_id": "0fd590bd-db5e-3f7b-8cc9-334451f927c3",
                                                "text": "(...) la France obsidionale qui perçoit tout nouveau venu comme un envahisseur (...)"
                                            },
                                            {
                                                "example_id": "1039fe14-501e-409f-b79f-3c4d8888b3ca",
                                                "sense_id": "0fd590bd-db5e-3f7b-8cc9-334451f927c3",
                                                "text": "[…] Les protestations et les condamnations peuvent même servir la Corée du Nord. Son délire obsidional trouvera en effet, dans cette posture « seule contre tous » de quoi s'alimenter …"
                                            },
                                            {
                                                "example_id": "d7b3701a-838b-45cf-919a-acfed2746cfb",
                                                "sense_id": "0fd590bd-db5e-3f7b-8cc9-334451f927c3",
                                                "text": "Il savait, dans sa chair, que la France véritable est celle qui accueille, qui ne se racornit pas dans la peur obsidionale mais continue de vivre dans l'hospitalité et la transmission aux nouveaux venus, dont il n'a jamais oublié qu'il avait fait partie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ce594ef-743f-3a9e-9a98-b65ab7c578eb",
                                        "entry_id": "aa1860d3-0d1b-3fcb-96c1-0fde0ed83e1a",
                                        "glosses": [
                                            "Qualifie une espèce introduite accidentellement par une armée."
                                        ],
                                        "tags": [
                                            "Ethnobiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cdc6e28-839d-4ea6-8a76-a639c4a56c9c",
                                                "sense_id": "1ce594ef-743f-3a9e-9a98-b65ab7c578eb",
                                                "text": "Sur les deux rives de la Seine, au Champ de Mars dans tous les campements et les environs des forts, à Buzenval, sur le mont Valérien, à Neuilly, à Fontenay-aux-Roses, à Sèvre, à Meudon les herborisations ont été particulièrement riches en plantes obsidionales."
                                            },
                                            {
                                                "example_id": "6b404e4c-0822-48c0-bdf8-01df9dba95da",
                                                "sense_id": "1ce594ef-743f-3a9e-9a98-b65ab7c578eb",
                                                "text": "Cette espèce appartenant à la famille des Poacées est remarquable en raison de sa rareté à l’échelle du territoire national […] mais aussi parce qu’il s’agit d’une espèce présumée obsidionale […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
