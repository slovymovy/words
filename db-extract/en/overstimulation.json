                        "entry_id": "d86eef9d-fa69-33d8-8c9a-bf0e9e155b76",
                        "glosses": [
                            "Excessive stimulation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c13f5366-98a6-4adb-a2cd-08997d842644",
                                "sense_id": "6450b956-5701-3afd-9a70-9fe26da97c24",
                                "text": "Something has to change\nUndeniable dilemma\nBoredom's not a burden anyone should bear\nConstant over-stimulation numbs me\nBut I would not want you any other way"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ff62b8e-4819-425c-8d80-af773acf1a3a",
                        "source_entry_id": "d86eef9d-fa69-33d8-8c9a-bf0e9e155b76",
                        "source_sense_id": "6450b956-5701-3afd-9a70-9fe26da97c24",
                        "source_sense_description": "excessive stimulation",
                        "target_lang_word": "surstimulation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surstimulation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87156063-3e41-3ab8-9ad9-06b8273530cb",
                                        "entry_id": "fbb41e33-864f-329e-a968-f4750527e519",
                                        "glosses": [
                                            "Fait d’être surstimulé, d’être stimulé de manière excessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c16e7a9-e651-4d90-96fe-57f0114d063a",
                                                "sense_id": "87156063-3e41-3ab8-9ad9-06b8273530cb",
                                                "text": "«Elle tire sa séduction du fait qu’elle se présente comme la clé de l’épanouissement personnel», écrit Lacroix, qui croit que nous cultivons le romantisme de l’émotion jusqu’à la surstimulation sensorielle et l’overdose."
                                            },
                                            {
                                                "example_id": "12fdc916-3583-4fc0-b7a9-32da525d03ac",
                                                "sense_id": "87156063-3e41-3ab8-9ad9-06b8273530cb",
                                                "text": "Il faut en tout cas tout faire pour que le patient reste dans le coup, sans pour autant le mettre en situation d’échec par une surstimulation."
                                            },
                                            {
                                                "example_id": "6d4a8c80-2c64-4694-b706-e982231b2b53",
                                                "sense_id": "87156063-3e41-3ab8-9ad9-06b8273530cb",
                                                "text": "Y aurait-il des avantages à la distraction et à la « surstimulation » découlant de la technologie et qui causent une « crise de l’attention » chez les jeunes?"
                                            },
                                            {
                                                "example_id": "62405b76-28e9-4f31-8a17-c2b0c58a258a",
                                                "sense_id": "87156063-3e41-3ab8-9ad9-06b8273530cb",
                                                "text": "Les surstimulations décisionnelles touchent avant tout les P.D.G., les médecins de services d’urgence et les gens à haute responsabilité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
