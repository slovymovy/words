                                        "entry_id": "c56d0fdc-7849-367c-9434-22badd310a9b",
                                        "glosses": [
                                            "nicht bereit nachzugeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b02edaa-e220-4b96-96a5-458d3095d6d0",
                                                "sense_id": "8c52c381-9107-3320-a2b0-38e40f507704",
                                                "text": "Das Geheimdienstministerium hatte am Donnerstag weiter mit einem unnachgiebigen Vorgehen gegen die Anführer der Protestbewegung gedroht."
                                            },
                                            {
                                                "example_id": "2ef16fe4-cf57-4265-af22-04e213c224bd",
                                                "sense_id": "8c52c381-9107-3320-a2b0-38e40f507704",
                                                "text": "Außerdem wird zunehmend Kritik an der unnachgiebigen Haltung der PAD gegenüber jedem gewählten Ministerpräsidenten laut, der dieses Amt nach dem Sturz Thaksins ausübte."
                                            },
                                            {
                                                "example_id": "94f7fcb6-b94b-42e3-a7cf-c11a2adaf386",
                                                "sense_id": "8c52c381-9107-3320-a2b0-38e40f507704",
                                                "text": "Beide Verhandlungspartner zeigten sich unnachgiebig."
                                            },
                                            {
                                                "example_id": "17b0a858-ff76-433b-8345-624991277fa0",
                                                "sense_id": "8c52c381-9107-3320-a2b0-38e40f507704",
                                                "text": "Der Präsident gibt sich trotz der verzweifelten Friedensbemühungen Kofi Annans unnachgiebig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
