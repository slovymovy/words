                "senses": [
                    {
                        "sense_id": "f72e6fcc-1406-3544-90f9-0a7b660bbb16",
                        "entry_id": "851d4c3f-d698-38e9-a2ad-c0408bbd6f72",
                        "glosses": [
                            "Flûte sans aucun trou à jouer, traditionnelle en Ukraine, en Moldavie et en Roumanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76f54867-a802-42d1-a506-8454f99d2ac5",
                                "sense_id": "f72e6fcc-1406-3544-90f9-0a7b660bbb16",
                                "text": "La tilinca est une flûte oblique roumaine dont la particularité est de ne posséder aucun trou de notes. Elle peut tout de même produire une gamme de sons assez variée grâce à une technique de souffle combinée à l’obturation alternative du tuyau par un doigt de l’instrumentiste."
                            },
                            {
                                "example_id": "c6ba9ca3-d1e3-4ea7-993a-62fc67382647",
                                "sense_id": "f72e6fcc-1406-3544-90f9-0a7b660bbb16",
                                "text": "Samuel Freiburghaus, virtuose de son instrument, en profite pour nous faire entendre aussi d’autres vents comme les cor de basset, tilinca, flula et clarinette."
                            },
                            {
                                "example_id": "c62e20fe-4f90-40c7-be88-943e98008590",
                                "sense_id": "f72e6fcc-1406-3544-90f9-0a7b660bbb16",
                                "text": "Les instruments à vent seront plus présents que jamais, avec l’orgue bien sûr, mais aussi trompette, voix, flûtes, clarinettes, taragot, frula, tilinca… instruments traditionnels des Balkans."
                            }
                        ]
                    }
