                                        "sense_id": "56fc5168-5b80-3819-91cf-ab6801914bd0",
                                        "entry_id": "699ddf3c-f69d-3112-922f-a5e20fd15865",
                                        "glosses": [
                                            "A practitioner of graphology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf4346d-a90c-40fe-ac35-f61a8eb73216",
                                                "sense_id": "56fc5168-5b80-3819-91cf-ab6801914bd0",
                                                "text": "While one can find lots of individual astrologers and graphologists, as well as an occasional palmist, psycho metrist or those astute in the reading of tarot cards or I Ching—Psychic Dimensions, Inc., has got it all together."
                                            },
                                            {
                                                "example_id": "34e0081e-db0f-4d19-9b13-a379c2f7a335",
                                                "sense_id": "56fc5168-5b80-3819-91cf-ab6801914bd0",
                                                "text": "Dorothy Sara, a graphologist, author, former editor and faculty member for many years of the Henry George School of Social Science, died Tuesday in Columbus Hospital in New York City after a heart attack."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "886da984-f7ed-4195-b9d1-ff5567afda2f",
                        "source_entry_id": "7a04d463-8ef6-3b79-98cd-90684fd11dc6",
                        "source_sense_id": "6e55b4a6-3bc9-36e1-93e0-8b62b62b9a45",
                        "source_sense_description": "Person, die in der Grafologie ausgebildet und bewandert ist",
                        "target_lang_word": "graphologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
