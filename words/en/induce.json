{
    "word_family": [
        "induction",
        "inductive",
        "inducer",
        "inducement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f9692d8-eb1b-3fc3-82b3-134eb94f8832",
                    "sense_definition": "To cause, bring about, or lead to a specific state or condition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that certain medications can <w>induce</w> sleep in patients with insomnia.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что некоторые лекарства могут <w>вызывать</w> сон у пациентов с бессонницей."
                            }
                        },
                        {
                            "text": "High levels of stress can <w>induce</w> panic attacks in some individuals.",
                            "target_lang_translations": {
                                "ru": "Высокий уровень стресса может <w>провоцировать</w> панические атаки у некоторых людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "bring about",
                        "engender",
                        "evoke",
                        "provoke"
                    ],
                    "common_phrases": [
                        "induce sleep",
                        "induce panic",
                        "induce vomiting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать, провоцировать или приводить к определенному состоянию или условию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "быть причиной состояния"
                            },
                            {
                                "target_lang_word": "провоцировать",
                                "target_lang_sense_clarification": "способствовать возникновению"
                            },
                            {
                                "target_lang_word": "стимулировать",
                                "target_lang_sense_clarification": "активировать процесс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e9c691c-a89d-3246-8c6a-39a39744f527",
                    "sense_definition": "To succeed in persuading or influencing someone to do something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "persuade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman tried to <w>induce</w> the customer to buy the more expensive model.",
                            "target_lang_translations": {
                                "ru": "Продавец пытался <w>склонить</w> покупателя к покупке более дорогой модели."
                            }
                        },
                        {
                            "text": "Nothing could <w>induce</w> her to leave her home after the incident.",
                            "target_lang_translations": {
                                "ru": "Ничто не могло <w>побудить</w> её покинуть свой дом после случившегося."
                            }
                        }
                    ],
                    "synonyms": [
                        "persuade",
                        "incite",
                        "tempt",
                        "urge"
                    ],
                    "common_phrases": [
                        "induce someone to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно убеждать или влиять на кого-либо, чтобы он совершил какое-либо действие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побуждать",
                                "target_lang_sense_clarification": "склонять к действию"
                            },
                            {
                                "target_lang_word": "склонять",
                                "target_lang_sense_clarification": "убеждать сделать что-либо"
                            },
                            {
                                "target_lang_word": "убеждать",
                                "target_lang_sense_clarification": "заставлять поверить или согласиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "366489c5-9c66-379d-96f4-e811ffd4dbff",
                    "sense_definition": "To use medical means to start the process of childbirth.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctors decided to <w>induce</w> labor because the baby was two weeks overdue.",
                            "target_lang_translations": {
                                "ru": "Врачи решили <w>стимулировать</w> роды, так как ребенок был переношен на две недели."
                            }
                        },
                        {
                            "text": "She was <w>induced</w> at thirty-nine weeks for medical reasons.",
                            "target_lang_translations": {
                                "ru": "Ей <w>вызвали</w> роды на тридцать девятой неделе по медицинским показаниям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "induce labor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать медицинские средства для искусственного начала процесса родов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стимулировать",
                                "target_lang_sense_clarification": "вызывать роды искусственно"
                            },
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "инициировать родовую деятельность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c85501b-103c-36b4-aebf-79a4e69ba0c0",
                    "sense_definition": "To produce an electric current or magnetic state through the process of induction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A changing magnetic field will <w>induce</w> an electric current in a nearby wire.",
                            "target_lang_translations": {
                                "ru": "Меняющееся магнитное поле будет <w>наводить</w> электрический ток в соседнем проводе."
                            }
                        },
                        {
                            "text": "The experiment showed how currents were <w>induced</w> in the copper lines.",
                            "target_lang_translations": {
                                "ru": "Эксперимент показал, как в медных линиях <w>индуцировались</w> токи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "induce a current"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать электрический ток или магнитное состояние посредством индукции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индуцировать",
                                "target_lang_sense_clarification": "создавать ток или поле"
                            },
                            {
                                "target_lang_word": "наводить",
                                "target_lang_sense_clarification": "создавать ток в проводнике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f58e9495-9f5e-357b-ac07-7d76d9f7f919",
                    "sense_definition": "To reach a general conclusion by using the process of <w>induction</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From these specific observations, we can <w>induce</w> a general principle of behavior.",
                            "target_lang_translations": {
                                "ru": "На основе этих конкретных наблюдений мы можем <w>вывести</w> общий принцип поведения."
                            }
                        },
                        {
                            "text": "Scientists often <w>induce</w> theories based on patterns found in experimental data.",
                            "target_lang_translations": {
                                "ru": "Ученые часто <w>формулируют</w> теории на основе закономерностей, найденных в экспериментальных данных."
                            }
                        }
                    ],
                    "antonyms": [
                        "deduce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приходить к общему выводу, используя метод индукции (от частного к общему)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выводить",
                                "target_lang_sense_clarification": "делать логический вывод"
                            },
                            {
                                "target_lang_word": "индуцировать",
                                "target_lang_sense_clarification": "приходить к заключению методом индукции"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}