                "senses": [
                    {
                        "sense_id": "cbf24998-f706-3354-bdea-b7d568b93198",
                        "entry_id": "b6d39e8b-6472-3270-ba17-bf4884e1f4f4",
                        "glosses": [
                            "Bewegung mit den Beinen"
                        ],
                        "tags": [
                            "no-plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ed1428d0-fa29-4deb-afd2-5280cca4a3a3",
                                "sense_id": "cbf24998-f706-3354-bdea-b7d568b93198",
                                "text": "„Tatsächlich erscheint Djokovic momentan wie ein Fremder im eigenen Körper. […] Die Beinarbeit hat wenig mit der gemein, die ihn noch vor zwei Jahren zum besten Spieler der Welt gemacht hatte.“"
                            },
                            {
                                "example_id": "5b15e5c8-bd53-403a-8543-6bb400e5cbc8",
                                "sense_id": "cbf24998-f706-3354-bdea-b7d568b93198",
                                "text": "„Der Ukrainer demonstrierte eindrucksvoll, worauf es im Faustkampf ankommt. Eben nicht nur auf pure Gewalt, Schlagkraft, Härte und das viel zitierte Herz - also die Dinge, die Huck seit Jahren auszeichnen - sondern auf Taktik, Technik, gute Beinarbeit, schnelle Hände und ein großes Schlagrepertoire.“"
                            },
                            {
                                "example_id": "491c8a85-e29b-4972-add2-6caa2055c706",
                                "sense_id": "cbf24998-f706-3354-bdea-b7d568b93198",
                                "text": "„Gegen Ende des Kampfs lässt der Brite sogar demonstrativ die Fäuste fallen und tänzelt den deutlichen älteren Kontrahenten nur noch mit seiner Beinarbeit aus.“"
                            },
                            {
                                "example_id": "fa035d7b-84d9-4fe1-a38d-b94cfc1afa7a",
                                "sense_id": "cbf24998-f706-3354-bdea-b7d568b93198",
                                "text": "„Er erklärte mir, er könne es nicht riskieren, Larrys phantastische Beinarbeit zu verderben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aae86fa9-771c-3856-8e31-a230f4c6d0a5",
                        "entry_id": "b6d39e8b-6472-3270-ba17-bf4884e1f4f4",
                        "glosses": [
                            "aus Elfenbein oder Knochen hergestellter Gegenstand"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5a9a8927-8fc5-420d-86ea-0239034a0906",
                                "sense_id": "aae86fa9-771c-3856-8e31-a230f4c6d0a5",
                                "text": "„Die zu färbenden Beinarbeiten legt man 15-20 Minuten lang in sehr verdünnte nicht erwärmte Salpetersäure von der Stärke eines guten Essigs […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
