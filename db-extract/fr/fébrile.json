                                        "examples": [
                                            {
                                                "example_id": "c95719f9-faee-4e06-8f65-0c385059a367",
                                                "sense_id": "812796e3-58fc-3448-9188-884b9fcd40c9",
                                                "text": "a feverish desire to see her again"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fda8763e-e707-402a-ae0e-2766ab4e05d5",
                        "source_entry_id": "ece4e60d-b1ae-30f7-bab5-9a6f61b0dba9",
                        "target_lang_word": "febrile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
