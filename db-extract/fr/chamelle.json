                        ],
                        "form": "chamelles"
                    },
                    {
                        "form_id": "dd65ea90-de97-4922-a94a-77e1f88a57ee",
                        "entry_id": "e1717f12-aeea-3e05-af39-4a9db2484383",
                        "tags": [
                            "masculine"
                        ],
                        "form": "chameau"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8340ea6-d72d-37cb-898e-a60400f51b19",
                        "entry_id": "e1717f12-aeea-3e05-af39-4a9db2484383",
                        "glosses": [
                            "Femelle du chameau."
                        ],
                        "tags": [
                            "Camélologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3bd87f7d-9167-4659-b0b8-1544e2ca0989",
                                "sense_id": "a8340ea6-d72d-37cb-898e-a60400f51b19",
                                "text": "Je me rendis avec les chefs militaires aux tentes de Si Saïd, où on nous servit une collation de dattes et de lait de chamelle, une vieille tradition nomade sans doute."
                            },
                            {
                                "example_id": "1805c705-99ff-4b62-bcd1-8b0a374bbb6d",
                                "sense_id": "a8340ea6-d72d-37cb-898e-a60400f51b19",
                                "text": "Mohamed Hammadi […] est intarissable sur les vertus du lait de chamelle, qui se vend cinq fois plus cher que le lait de vache, qui se conserve bien à la chaleur et dont on peut extraire des principes antidiabétiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "50281ca8-32a6-3f6f-9727-f0bf3825e462",
                        "entry_id": "e1717f12-aeea-3e05-af39-4a9db2484383",
                        "glosses": [
                            "Personne méchante et désagréable."
                        ],
                        "tags": [
                            "colloquial",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "45a6e596-c969-4442-92ce-c25a0db50548",
                                "sense_id": "50281ca8-32a6-3f6f-9727-f0bf3825e462",
                                "text": "Les vociférations crapuleuses de cette chamelle en délire emplissaient maintenant la rue, inondaient la place voisine, montaient jusqu’aux toits, faisaient tressaillir profondément le populo."
                            },
                            {
                                "example_id": "e3255651-55ba-41cd-9b43-d260a395c680",
                                "sense_id": "50281ca8-32a6-3f6f-9727-f0bf3825e462",
                                "text": "C’est à la station Réaumur-Sébastopol qu’il descendait, Jean-Pierre, après sa journée à tanner poliment le cuir aux chamelles du salon de coiffure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e63e0bd7-f6ac-421e-801c-af22d23e3537",
                        "source_entry_id": "e1717f12-aeea-3e05-af39-4a9db2484383",
                        "target_lang_word": "Kamelstute",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kamelstute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fb11199-a73c-31bd-bed6-7236efb32cc8",
                                        "entry_id": "b04ad28f-3d28-366f-85e0-13e2ea0b590c",
                                        "glosses": [
                                            "weibliches Kamel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
