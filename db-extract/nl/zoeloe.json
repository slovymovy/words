                                                "sense_id": "7425dfbd-1202-3168-9f9b-49b46484b4c8",
                                                "text": "Die meisten Zulu leben in der südafrikanischen Provinz KwaZulu-Natal."
                                            },
                                            {
                                                "example_id": "5b4e1d80-9bcc-48ec-a999-f11f7b84aa95",
                                                "sense_id": "7425dfbd-1202-3168-9f9b-49b46484b4c8",
                                                "text": "„Häufig wählen die Unternehmer für diese bei den Arbeitern verhasste Funktion Männer vom Volk der Zulu aus – und machen sich so die Rivalitäten der Stämme untereinander zunutze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zulu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30187430-1163-3702-8f62-00ea599464b0",
