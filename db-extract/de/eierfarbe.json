                ],
                "senses": [
                    {
                        "sense_id": "a42eaedb-a8ec-3fc0-bf9a-af54d5af2fd5",
                        "entry_id": "01a0dbb6-b21d-30e4-ace5-ba98bdb0a159",
                        "glosses": [
                            "Farbe der Eierschale"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a562a3c-08c5-4e7b-9e6b-a1958064e11b",
                                "sense_id": "a42eaedb-a8ec-3fc0-bf9a-af54d5af2fd5",
                                "text": "„So scheinen sämtliche natürlichen Eierfarben auf gerade einmal zwei Pigmenten zu basieren: dem blau-grünen Biliverdin und dem rostbraunen Protoporphyrin.“"
                            },
                            {
                                "example_id": "e2ec01b7-1381-4e8d-bd2a-53f5a5d33181",
                                "sense_id": "a42eaedb-a8ec-3fc0-bf9a-af54d5af2fd5",
                                "text": "„Dabei gibt weniger das Gefieder als vielmehr die Farbe der Ohrscheibe einen Hinweis auf die Eierfarbe.“"
                            },
                            {
                                "example_id": "a3f1836f-3b34-43e7-bd9d-0f27190196ac",
                                "sense_id": "a42eaedb-a8ec-3fc0-bf9a-af54d5af2fd5",
                                "text": "„Sonst lässt die Ohrscheibe keine Rückschlüsse auf die Eierfarbe zu.“"
                            },
                            {
                                "example_id": "6c0c6293-785c-43ba-ac8c-daf4e5bff15e",
                                "sense_id": "a42eaedb-a8ec-3fc0-bf9a-af54d5af2fd5",
                                "text": "„Streng genommen lässt die Farbe des Gefieders von Hennen ohnehin keinen zuverlässigen Rückschluss auf die Eierfarbe zu.“"
                            },
                            {
                                "example_id": "698337bf-b93c-44a8-aa88-4b32bf123980",
                                "sense_id": "a42eaedb-a8ec-3fc0-bf9a-af54d5af2fd5",
                                "text": "„Die Olivleger können dann mit Hühnern verpaart werden, die eine andere Farbe legen, um andere Eierfarben, wie hellblau oder hellgrün, zu bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d8be01a6-23fb-3b63-8d21-49b7c0ba0362",
                        "entry_id": "01a0dbb6-b21d-30e4-ace5-ba98bdb0a159",
                        "glosses": [
                            "spezielle Farbe zum Färben von Ostereiern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afb029d2-9a18-4355-8dc5-aa10eb9c598f",
                                "sense_id": "d8be01a6-23fb-3b63-8d21-49b7c0ba0362",
                                "text": "„Bei manchen chemischen Eierfarben gilt es, bedachtsam zu sein.“"
                            },
                            {
                                "example_id": "35cf734a-7a5d-4ffe-91bf-6e139f634820",
                                "sense_id": "d8be01a6-23fb-3b63-8d21-49b7c0ba0362",
                                "text": "„Grundsätzlich rät Randak, die Eierfarben in Essigwasser aufzulösen.“"
                            },
                            {
                                "example_id": "cad775c0-b1ae-4569-a915-a561c224fb9c",
                                "sense_id": "d8be01a6-23fb-3b63-8d21-49b7c0ba0362",
                                "text": "„Bei Eierfarben zum Selberfärben gibt es allerdings eine gesetzliche Ausnahmeregelung.“"
                            },
                            {
                                "example_id": "2649e768-509f-444d-95bf-215690694e4b",
                                "sense_id": "d8be01a6-23fb-3b63-8d21-49b7c0ba0362",
                                "text": "„Künstliche Eierfarben sind kennzeichnungspflichtig.“"
                            },
                            {
                                "example_id": "aa2cf295-8cb4-47ee-b84c-ffbce973d700",
                                "sense_id": "d8be01a6-23fb-3b63-8d21-49b7c0ba0362",
                                "text": "„Spezielle Eierfarben aus dem Handel wie Brausetabletten, bunte Stifte oder Malkästen sind Verbraucherschützern zufolge meist unbedenklich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
