                },
                {
                    "sense_id": "c44b1cab-3bf1-307d-b77b-8ff2af3d107c",
                    "sense_definition": "Taki, który jest dokładnie taki jak trzeba, najlepiej pasujący do danej sytuacji lub celu.",
