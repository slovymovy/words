                ],
                "senses": [
                    {
                        "sense_id": "279c6dbb-c4c2-3712-8f80-664dc96a0c75",
                        "entry_id": "f76b23f8-1f64-33cc-984b-49a2d140bf98",
                        "glosses": [
                            "Angle apparent, mesuré en degrés, qui sépare deux objets sur la sphère céleste. Presque toujours employé pour décrire la séparation, vu depuis la Terre, entre une planète du système solaire et le Soleil."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4f4f8381-d7dc-37a3-aa91-7f2c28ea01e5",
                        "entry_id": "f76b23f8-1f64-33cc-984b-49a2d140bf98",
                        "glosses": [
                            "Élongation cellulaire, état de plasticité ou d’élasticité de la membrane primaire d’une cellule."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "b37e2f46-0072-4d95-8ee9-becd6de71455",
                                "sense_id": "4f4f8381-d7dc-37a3-aa91-7f2c28ea01e5",
                                "text": "L’élongation cellulaire est un processus complexe qui fait intervenir une absorption d’eau, l’extension de la paroi sous l’effet de la turgescence, et l’incorporation de nouveaux composés entre les mailles de fibrilles de cellulose ainsi distendues."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c4e1dd4-517a-3645-8860-5a4b21a4903a",
                        "entry_id": "f76b23f8-1f64-33cc-984b-49a2d140bf98",
                        "glosses": [
                            "Addition successive d’acides aminés liés par des liaisons peptidiques, au cours de la synthèse naturelle des protéines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c6cc1ab-9a26-4c0c-8725-60d8599f21be",
                                "sense_id": "9c4e1dd4-517a-3645-8860-5a4b21a4903a",
                                "text": "L’élongation va faire intervenir une translocation du ribosome, c’est à dire un décalage correspondant, exactement, à un triplet de nucléotides."
                            }
                        ]
                    },
                    {
                        "sense_id": "afe389ef-463f-3b4a-892d-87efc72250b4",
                        "entry_id": "f76b23f8-1f64-33cc-984b-49a2d140bf98",
                        "glosses": [
                            "Élongation musculaire, endommagement d’un muscle lorsqu’il est étiré au-delà d’un maximum."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0c1552f3-3c46-32ac-bf2c-731b6be52721",
                        "entry_id": "f76b23f8-1f64-33cc-984b-49a2d140bf98",
                        "glosses": [
                            "(Mathématique) Abscisse, à un instant donné, d'un point animé d'un mouvement vibratoire. (Sa valeur maximale est l'amplitude)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9166c3d7-9233-3f6c-88f0-d634181d72fb",
                        "entry_id": "f76b23f8-1f64-33cc-984b-49a2d140bf98",
                        "glosses": [
                            "(Physique) Déplacement d'un mobile par rapport à sa position d'équilibre."
                        ],
                        "tags": [],
                        "examples": []
                    }
