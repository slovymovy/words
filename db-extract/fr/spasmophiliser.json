                "senses": [
                    {
                        "sense_id": "70ea84ae-f851-3f8d-98e4-fe78ee4402fc",
                        "entry_id": "c8395297-ba74-37ad-9cbf-a8334929dfe7",
                        "glosses": [
                            "Prendre un caractère spasmophile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9cf7380-a9e4-4534-af6c-cdeb319bf098",
                                "sense_id": "70ea84ae-f851-3f8d-98e4-fe78ee4402fc",
                                "text": "J'ai peur, je crève de trouille à en mouiller mon froc, je ventile, je fébrile, je tachycardise, je spasmophilise."
                            },
                            {
                                "example_id": "eda8a00d-7e99-4263-8372-c231b0c4b91e",
                                "sense_id": "70ea84ae-f851-3f8d-98e4-fe78ee4402fc",
                                "text": "Le voici soudain au saxophone, ce saxe qui hulule, hoquette, spasmophilise, sans rien enlever pourtant aux superbes mélodies juives de l'Acoustic Masada, surtout lorsqu'on a à ses côtés un trompettiste aussi légendaire que Dave Douglas..."
                            },
                            {
                                "example_id": "85f872e3-8070-418a-b89b-f9f088df13f1",
                                "sense_id": "70ea84ae-f851-3f8d-98e4-fe78ee4402fc",
                                "text": "Alina, venue dans la Cité des Papes par le souffle de l’équinoxe et accrochée au dos aillé de l’Archange Gabriel, en mission sur Avignon, décida de suivre de près Effessora, femme seule et maigre, pour s’assurer qu’elle n’allait pas se spasmophiliser ou s’envoler dans les airs avec les prospectus de son caddie publicitaire."
                            }
                        ]
                    }
                ],
