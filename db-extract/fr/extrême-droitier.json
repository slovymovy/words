                                    {
                                        "sense_id": "3a4b473b-a3ac-30fb-b713-8763596610ef",
                                        "entry_id": "4e757807-027a-3c7f-8b0b-a4f43b39c1ea",
                                        "glosses": [
                                            "radikalen, dem Rechtsextremismus anhängenden Ideen folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7584c01d-0842-45d3-807a-64e170a0330d",
                                                "sense_id": "3a4b473b-a3ac-30fb-b713-8763596610ef",
                                                "text": "\"Er ist befreundet mit bekennenden, gewaltbereiten Neonazis und bayerischen NPD-Politikern wie Karl Richter und Manfred Waldukat oder mit Jörg Uckermann, einst bei der rechtsextremen Bürgerbewegung pro NRW aktiv.\""
                                            },
                                            {
                                                "example_id": "6f9da1ba-8fec-450b-88b1-9528f55b27fd",
                                                "sense_id": "3a4b473b-a3ac-30fb-b713-8763596610ef",
                                                "text": "Am Wochenende fand eine rechtsextreme Demonstration statt."
                                            },
                                            {
                                                "example_id": "9651002e-6c82-4736-a936-421834207661",
                                                "sense_id": "3a4b473b-a3ac-30fb-b713-8763596610ef",
                                                "text": "„Seit der Wiedervereinigung 1990 werden Opfer rechtsextremer Gewalt in Deutschland erfasst. Die Behörden zählten seitdem 94 Todesopfer.“"
                                            },
                                            {
                                                "example_id": "64710ec9-431d-4790-b001-e399de05cfb2",
                                                "sense_id": "3a4b473b-a3ac-30fb-b713-8763596610ef",
                                                "text": "„Als Grund für die deutlichen Zunahme [Anmerkung: der Zahl von Rechtsextremisten in Deutschland] nannte der \"Tagesspiegel\", dass die Verfassungsschützer erstmals die Mitglieder der AfD-Vereinigungen \"Flügel\" und der AfD-Jugendorganisation \"Junge Alternative (JA)\" dem rechtsextremen Spektrum zurechnen. Beim \"Flügel\" stuften die Behörden demnach 7000 Mitglieder als rechtsextrem ein, bei der JA mehr als 1000.“"
                                            },
                                            {
                                                "example_id": "a1ab99da-e45b-4525-a322-3ef48a6c171c",
                                                "sense_id": "3a4b473b-a3ac-30fb-b713-8763596610ef",
                                                "text": "„Trotz aller gegenteiligen Bekundungen gibt es in der AfD rechtsextreme Strömungen. Der Verfassungsschutz beobachtet das.“"
                                            },
                                            {
                                                "example_id": "b5fa37e5-1bc0-4fb9-a3b7-145d5ee8ed52",
                                                "sense_id": "3a4b473b-a3ac-30fb-b713-8763596610ef",
                                                "text": "„Der Präsident des Jüdischen Weltkongresses fordert von Deutschland, rechtsextreme Parteien zu verbieten.“"
                                            },
                                            {
                                                "example_id": "4a090332-175e-45dc-a74b-4b3379ff2fd1",
                                                "sense_id": "3a4b473b-a3ac-30fb-b713-8763596610ef",
                                                "text": "„Darüber ist man sich weitgehend einig: Die FPÖ ist rechts beziehungsweise rechtsextrem, zumindest aber rechtspopulistisch.“"
                                            },
                                            {
                                                "example_id": "dd125ff3-84b6-49ad-93ca-2af5f82e1fdb",
                                                "sense_id": "3a4b473b-a3ac-30fb-b713-8763596610ef",
                                                "text": "„Später flog die rechtsextreme Terrorgruppe \"Revolution Chemnitz\" auf. Der Prozess gegen die acht mutmaßlichen Mitglieder beginnt am 23. September.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
