                        "glosses": [
                            "materiał ceramiczny wytwarzany z zanieczyszczonego kaolinu, podobny nieco do porcelany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e330d85-3396-4e49-81de-d1aaf919cb09",
                                "sense_id": "5a574fb6-1f31-3f23-9cce-21e3e840887b",
                                "text": "Wystawiłem na aukcji internetowej świecznik z fajansu."
