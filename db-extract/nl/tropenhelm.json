                    },
                    {
                        "translation_id": "46caf0eb-d511-481a-878b-84951efea596",
                        "source_entry_id": "972d40b5-620f-3333-b7d4-afdf5a08653a",
                        "source_sense_id": "cd97d0f4-26fb-3755-bc63-ea731bd6f4a0",
