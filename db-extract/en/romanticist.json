                                    {
                                        "sense_id": "ed6b8920-f505-3acf-8213-3e38f46b7ef7",
                                        "entry_id": "38477fb6-97e0-3ade-b28d-d0893b145339",
                                        "glosses": [
                                            "Que pertenece o concierne al amor erótico o de pareja."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbc2e16f-2ab7-4417-a299-afd48f304f29",
                                                "sense_id": "ed6b8920-f505-3acf-8213-3e38f46b7ef7",
                                                "text": "«Los poemas románticos son los más hermosos que alguien puede dedicarle a su pareja»."
                                            },
                                            {
                                                "example_id": "cf63fc3c-598b-48ad-b3c4-f9e25071c08a",
                                                "sense_id": "ed6b8920-f505-3acf-8213-3e38f46b7ef7",
                                                "text": "«Los índices de relaciones románticas tóxicas y abusivas han ido disminuyendo en los últimos años»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f6159bc-76ec-375a-ac6a-81ff87cbc199",
                                        "entry_id": "38477fb6-97e0-3ade-b28d-d0893b145339",
                                        "glosses": [
                                            "Que valora, expresa o evoca los sentimientos, los sueños, los afectos y los ideales."
                                        ],
