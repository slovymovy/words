                                        "entry_id": "22917d06-3758-328b-8096-c4b96a3e7436",
                                        "glosses": [
                                            "Person, die um Asyl bittet oder ein Recht auf Asyl zuerkannt bekommen hat"
                                        ],
                                        "tags": [
                                            "gelegentlich pejorativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d4f5237-1d26-48df-b7a4-a53fe2f571b7",
                                                "sense_id": "f6d23338-377f-380c-a0fd-92e14788782d",
                                                "text": "In Deutschland gibt es viele Asylanten aus Nahost."
                                            },
                                            {
                                                "example_id": "bf5e8aca-c126-4e83-a605-07a11bc96503",
                                                "sense_id": "f6d23338-377f-380c-a0fd-92e14788782d",
                                                "text": "Im Sprechen über Flüchtlinge lässt sich die demagogische Macht von Sprache immer wieder nachweisen. Gerade in diesem Themenfeld gibt es viele Wörter, die mehr über den aussagen, der sie verwendet, als über den Menschen, den sie bezeichnen. Neger ist so ein Wort. Und Zigeuner. Oder Asylant."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12952d23-4046-4b5d-b268-fa615892b80f",
