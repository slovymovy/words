                    {
                        "form_id": "49c5000d-e10a-4af6-a4a6-35e64d1ad062",
                        "entry_id": "782bddb0-62e5-3185-9a3f-60b8d75fb319",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Weinflaschen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                        "entry_id": "782bddb0-62e5-3185-9a3f-60b8d75fb319",
                        "glosses": [
                            "eine Flasche, in der Wein aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e46047-491c-4e4a-9f91-a2de98b9fc3f",
                                "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                                "text": "Beim nächtlichen Einbruch im Nachbarhaus verrieten sich die Eindringlinge dadurch, dass zahllose Weinflaschen zu Bruch gingen."
                            },
                            {
                                "example_id": "df41a152-b62d-4c92-8fa5-ef0efcdb4cc3",
                                "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                                "text": "„An einer der Wände der kleinen Trattoria sind die Weinflaschen bis unter die Decke gestapelt.“"
                            },
                            {
                                "example_id": "b0a24120-8c1b-4bfd-b14d-bcbcf805e980",
                                "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                                "text": "„Im kühlen Weinkeller zeigte er uns als Zeichen seines Vertrauens sehr alte und überaus wertvolle Weinflaschen, die nur bei Hochzeiten oder Taufen angeboten wurden.“"
                            },
                            {
                                "example_id": "61fe9f0e-f2ae-4e75-b605-47e98b78fdc7",
                                "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                                "text": "„Im Keller roch es nach Kartoffeln und ausgetrunkenen Weinflaschen.“"
                            },
                            {
                                "example_id": "41f69971-47ec-4a7a-ae93-48eb80e76558",
                                "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                                "text": "„Vor mir stehen vier Weinflaschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
