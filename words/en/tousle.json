{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a8bfb27-afdd-3972-8c71-482977b52b03",
                    "sense_definition": "To make something untidy or messy, especially someone's hair.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The playful wind managed to <w>tousle</w> her hair as soon as she stepped outside.",
                            "target_lang_translations": {
                                "ru": "Игривый ветер успел <w>растрепать</w> её волосы, как только она вышла на улицу."
                            }
                        },
                        {
                            "text": "He reached out affectionately to <w>tousle</w> his younger brother's curls.",
                            "target_lang_translations": {
                                "ru": "Он с нежностью протянул руку, чтобы <w>взъерошить</w> кудри младшего брата."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruffle",
                        "muss",
                        "dishevel"
                    ],
                    "common_phrases": [
                        "tousle someone's hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить что-либо в беспорядок, делать неопрятным, особенно волосы; взъерошивать или трепать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взъерошивать",
                                "target_lang_sense_clarification": "волосы, шерсть"
                            },
                            {
                                "target_lang_word": "трепать",
                                "target_lang_sense_clarification": "волосы, кудри"
                            },
                            {
                                "target_lang_word": "растрепать",
                                "target_lang_sense_clarification": "сделать волосы или прическу неопрятной"
                            },
                            {
                                "target_lang_word": "лосмать",
                                "target_lang_sense_clarification": "разговорное, делать косматым"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f24f4c4-bd13-36c4-9014-a11c97a1df7f",
                    "sense_definition": "An act of making someone's hair untidy or ruffled, usually affectionately.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cassie reached over and gave Sammy's dark hair an affectionate <w>tousle</w>.",
                            "target_lang_translations": {
                                "ru": "Кэсси потянулась и нежно <w>потрепала</w> тёмные волосы Сэмми."
                            }
                        },
                        {
                            "text": "With a quick <w>tousle</w> of his son's curls, he smiled and said goodbye.",
                            "target_lang_translations": {
                                "ru": "Быстро <w>взъерошив</w> кудри сына, он улыбнулся и попрощался."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruffle"
                    ],
                    "common_phrases": [
                        "give a tousle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по взъерошиванию или легкому трепанию чьих-либо волос, обычно ласковое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взъерошивание",
                                "target_lang_sense_clarification": "действие по значению глагола"
                            },
                            {
                                "target_lang_word": "потрепывание",
                                "target_lang_sense_clarification": "ласковое движение рукой по волосам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}