{
    "word_family": [
        "вежливость",
        "вежливо"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d7c107fe-508b-349d-98d9-ef6c94008f24",
                    "sense_definition": "Соблюдающий правила приличия, учтивый и обходительный в общении с другими людьми.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "politeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он всегда очень <w>вежливый</w> человек и здоровается с соседями.",
                            "target_lang_translations": {
                                "en": "He is always a very <w>polite</w> person and says hello to his neighbors."
                            }
                        },
                        {
                            "text": "Будь <w>вежливым</w> с гостями, даже если они тебе не нравятся.",
                            "target_lang_translations": {
                                "en": "Be <w>polite</w> to the guests, even if you don't like them."
                            }
                        }
                    ],
                    "synonyms": [
                        "учтивый",
                        "воспитанный",
                        "тактичный"
                    ],
                    "antonyms": [
                        "невежливый",
                        "хамоватый",
                        "невоспитанный"
                    ],
                    "common_phrases": [
                        "вежливый человек",
                        "вежливый тон"
                    ],
                    "target_lang_definitions": {
                        "en": "Observing the rules of etiquette, courteous and obliging in communication with other people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "polite",
                                "target_lang_sense_clarification": "General term for being well-mannered and civilized."
                            },
                            {
                                "target_lang_word": "courteous",
                                "target_lang_sense_clarification": "Showing regard or thought for others; displaying good manners."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12dd342a-66ee-31df-a905-a1f9ed4130c1",
                    "sense_definition": "Хорошо обученный, знающий правила поведения в обществе.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "politeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дети в этой семье очень <w>вежливые</w> и всегда уступают место старшим.",
                            "target_lang_translations": {
                                "en": "The children in this family are very <w>well-mannered</w> and always give up their seats to the elderly."
                            }
                        },
                        {
                            "text": "Нужно быть <w>вежливым</w> в общественном транспорте.",
                            "target_lang_translations": {
                                "en": "You need to be <w>civil</w> when using public transport."
                            }
                        }
                    ],
                    "synonyms": [
                        "воспитанный"
                    ],
                    "antonyms": [
                        "невоспитанный"
                    ],
                    "target_lang_definitions": {
                        "en": "Well-trained, knowing the rules of behavior in society."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "well-mannered",
                                "target_lang_sense_clarification": "Having good manners and knowing how to behave in public."
                            },
                            {
                                "target_lang_word": "civil",
                                "target_lang_sense_clarification": "Behaving in a reasonable or polite manner, especially in public."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d291a26-3fc3-3e05-ae9a-25da59a96f0b",
                    "sense_definition": "Выражающий учтивость, исполненный формальной предупредительности.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он ответил мне с <w>вежливой</w> улыбкой, но в его глазах не было искренности.",
                            "target_lang_translations": {
                                "en": "He answered me with a <w>polite</w> smile, but there was no sincerity in his eyes."
                            }
                        },
                        {
                            "text": "После короткого <w>вежливого</w> разговора он сразу ушел по своим делам.",
                            "target_lang_translations": {
                                "en": "After a short <w>polite</w> conversation, he immediately left to attend to his business."
                            }
                        }
                    ],
                    "synonyms": [
                        "светский"
                    ],
                    "antonyms": [
                        "хамский"
                    ],
                    "common_phrases": [
                        "вежливая улыбка"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing courtesy, filled with formal consideration."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "polite",
                                "target_lang_sense_clarification": "Can refer to formal or superficial displays of good manners."
                            },
                            {
                                "target_lang_word": "formal",
                                "target_lang_sense_clarification": "Relating to behavior that follows strict social conventions."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}