                        "examples": [
                            {
                                "example_id": "f8b38809-6098-4ddd-9cb9-5964f31c6fcb",
                                "sense_id": "e574ae45-1a33-30bd-9652-26e055cb9a44",
                                "text": "Les doriotistes sont deux, un ouvrier du bois et un métallo, que rejoint en 1938 un autre métallo, ancien militant communiste de la région parisienne."
                            },
                            {
                                "example_id": "bba7cb55-5a5f-45a7-879d-a070ac01fcb7",
                                "sense_id": "e574ae45-1a33-30bd-9652-26e055cb9a44",
                                "text": "... explique Isabelle Bertola, directrice du théâtre Mouffetard à Paris qui coproduit l'événement avec la ville de Pantin et en partenariat avec la Maison des métallos."
                            },
                            {
                                "example_id": "8aae94cf-70c9-41d6-9145-d5f3387c5817",
                                "sense_id": "e574ae45-1a33-30bd-9652-26e055cb9a44",
                                "text": "Les métallos, je les voyais le matin qui faisaient leur mine sombre en montant dans leurs automobiles..."
                            }
                        ]
