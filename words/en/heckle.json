{
    "word_family": [
        "heckler",
        "heckling",
        "hackle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2fabbd46-59d3-3f5e-a552-0d9f696af209",
                    "sense_definition": "To interrupt a public speaker or performer with derisive or aggressive comments or abuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbal_interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian had to stop his routine because several people in the front row started to <w>heckle</w> him loudly.",
                            "target_lang_translations": {
                                "ru": "Комику пришлось прервать свое выступление, потому что несколько человек в первом ряду начали громко его <w>перебивать</w>."
                            }
                        },
                        {
                            "text": "It is considered very rude to <w>heckle</w> a speaker during a formal presentation, even if you disagree with them.",
                            "target_lang_translations": {
                                "ru": "Считается очень грубым <w>засыпать вопросами</w> и выкриками оратора во время официальной презентации, даже если вы с ним не согласны."
                            }
                        }
                    ],
                    "synonyms": [
                        "jeer",
                        "taunt",
                        "badger",
                        "interrupt"
                    ],
                    "antonyms": [
                        "cheer",
                        "applaud"
                    ],
                    "common_phrases": [
                        "heckle a speaker",
                        "heckle from the crowd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прерывать публичного оратора или исполнителя насмешливыми или агрессивными комментариями или оскорблениями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перебивать",
                                "target_lang_sense_clarification": "выкриками из зала"
                            },
                            {
                                "target_lang_word": "засыпать вопросами",
                                "target_lang_sense_clarification": "враждебными или насмешливыми"
                            },
                            {
                                "target_lang_word": "освистывать",
                                "target_lang_sense_clarification": "выражать неодобрение криками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53fcfff4-d4c4-3c8c-8335-09e32bac21e3",
                    "sense_definition": "To question someone harshly or persistently in an attempt to find weaknesses in their argument.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbal_interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Journalists began to <w>heckle</w> the politician about the inconsistencies in his recent financial report.",
                            "target_lang_translations": {
                                "ru": "Журналисты начали <w>донимать</w> политика вопросами о несоответствиях в его недавнем финансовом отчете."
                            }
                        },
                        {
                            "text": "The defense attorney continued to <w>heckle</w> the witness until the judge called for order in the court.",
                            "target_lang_translations": {
                                "ru": "Адвокат защиты продолжал <w>изводить</w> свидетеля вопросами, пока судья не призвал к порядку в зале суда."
                            }
                        }
                    ],
                    "synonyms": [
                        "interrogate",
                        "cross-examine"
                    ],
                    "common_phrases": [
                        "heckle with questions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко или настойчиво расспрашивать кого-либо, пытаясь найти слабые места в его аргументации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засыпать вопросами",
                                "target_lang_sense_clarification": "с целью сбить с толку"
                            },
                            {
                                "target_lang_word": "донимать",
                                "target_lang_sense_clarification": "настойчивыми расспросами"
                            },
                            {
                                "target_lang_word": "экзаменовать",
                                "target_lang_sense_clarification": "пристрастно допрашивать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29278a32-a2b9-38f9-9250-1f4a5884196e",
                    "sense_definition": "To comb or dress flax or hemp with a <w>hackle</w> to prepare it for spinning.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textile_processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the traditional workshop, workers would <w>heckle</w> the raw fibers by hand before they were sent to the spinning wheel.",
                            "target_lang_translations": {
                                "ru": "В традиционной мастерской рабочие вручную <w>чесали</w> сырые волокна перед тем, как отправить их на прялку."
                            }
                        },
                        {
                            "text": "The process to <w>heckle</w> flax is labor-intensive and requires a steady hand to avoid damaging the fibers.",
                            "target_lang_translations": {
                                "ru": "Процесс <w>чесания</w> льна трудоемок и требует твердой руки, чтобы не повредить волокна."
                            }
                        }
                    ],
                    "synonyms": [
                        "hackle",
                        "comb"
                    ],
                    "common_phrases": [
                        "heckle flax"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in textile history"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расчесывать или обрабатывать лен или коноплю с помощью гребня для подготовки к прядению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чесать",
                                "target_lang_sense_clarification": "лен или коноплю"
                            },
                            {
                                "target_lang_word": "очесывать",
                                "target_lang_sense_clarification": "волокна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c53e2e9-4157-3b49-b403-2c691b6b4365",
                    "sense_definition": "A rude or aggressive interruption or shout directed at a performer or speaker.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbal_interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stand-up dealt well with the <w>heckle</w> from the crowd, replying with raucous banter to raise plenty of laughs.",
                            "target_lang_translations": {
                                "ru": "Стендап-комик хорошо справился с <w>выкриком</w> из толпы, ответив грубоватой шуткой, вызвавшей взрыв смеха."
                            }
                        },
                        {
                            "text": "A single loud <w>heckle</w> from the back of the room ruined the silence of the dramatic performance.",
                            "target_lang_translations": {
                                "ru": "Один громкий <w>выкрик</w> из глубины зала нарушил тишину драматического спектакля."
                            }
                        }
                    ],
                    "synonyms": [
                        "jeer",
                        "taunt",
                        "shout"
                    ],
                    "common_phrases": [
                        "deal with a heckle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубое или агрессивное прерывание или выкрик, адресованный исполнителю или оратору."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкрик",
                                "target_lang_sense_clarification": "из зала, мешающий выступлению"
                            },
                            {
                                "target_lang_word": "насмешка",
                                "target_lang_sense_clarification": "публичное оскорбление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "867edd91-605a-3316-ba0a-a062afe3f2c5",
                    "sense_definition": "One of the long, slender, often brightly colored feathers on the neck of a bird, especially a domestic cock.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "feathers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rooster displayed a magnificent <w>heckle</w> that shimmered with green and gold in the morning sun.",
                            "target_lang_translations": {
                                "ru": "Петух демонстрировал великолепное <w>шейное оперение</w>, которое переливалось зеленым и золотым в лучах утреннего солнца."
                            }
                        },
                        {
                            "text": "Fly-fishers often use a <w>heckle</w> from a bird to create realistic lures for trout.",
                            "target_lang_translations": {
                                "ru": "Рыболовы-нахлыстовики часто используют <w>перо</w> птицы для создания реалистичных приманок на форель."
                            }
                        }
                    ],
                    "synonyms": [
                        "hackle"
                    ],
                    "common_phrases": [
                        "cock's heckle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одно из длинных, тонких, часто ярко окрашенных перьев на шее птицы, особенно домашнего петуха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перо на загривке",
                                "target_lang_sense_clarification": "у птиц"
                            },
                            {
                                "target_lang_word": "шейное перо",
                                "target_lang_sense_clarification": "петушиное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28fcfa2f-148e-3b49-985e-bb0e710aa8e4",
                    "sense_definition": "A tool consisting of a board with steel pins, used for dressing flax or hemp; a <w>hackle</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textile_processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum display included an antique <w>heckle</w> used by 18th-century weavers to prepare their materials.",
                            "target_lang_translations": {
                                "ru": "В музейной экспозиции был представлен старинный <w>гребень</w>, который ткачи XVIII века использовали для подготовки материалов."
                            }
                        },
                        {
                            "text": "Be careful when handling the <w>heckle</w> as the metal pins are extremely sharp.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны при обращении с <w>чесалкой</w>, так как металлические штыри очень острые."
                            }
                        }
                    ],
                    "synonyms": [
                        "hackle",
                        "comb"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of hackle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент, состоящий из доски со стальными штырями, используемый для обработки льна или конопли; чесалка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гребень",
                                "target_lang_sense_clarification": "для чесания льна"
                            },
                            {
                                "target_lang_word": "чесалка",
                                "target_lang_sense_clarification": "инструмент для волокон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3cc5097-f5d0-3435-a8a8-ebb6935e64ab",
                    "sense_definition": "A feather ornament worn in the bonnets of certain Highland regiments in the British Army.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feathers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier adjusted the red <w>heckle</w> on his bonnet before the start of the military parade.",
                            "target_lang_translations": {
                                "ru": "Солдат поправил красный <w>плюмаж</w> на своем берете перед началом военного парада."
                            }
                        },
                        {
                            "text": "Each regiment is distinguished by the specific color of the <w>heckle</w> they wear on their headgear.",
                            "target_lang_translations": {
                                "ru": "Каждый полк отличается особым цветом <w>султана</w>, который они носят на головных уборах."
                            }
                        }
                    ],
                    "synonyms": [
                        "plume"
                    ],
                    "common_phrases": [
                        "regimental heckle"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scottish military context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перьевое украшение, которое носят на головных уборах (боннетах) некоторых шотландских полков британской армии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плюмаж",
                                "target_lang_sense_clarification": "на военном головном уборе"
                            },
                            {
                                "target_lang_word": "султан",
                                "target_lang_sense_clarification": "украшение из перьев"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}