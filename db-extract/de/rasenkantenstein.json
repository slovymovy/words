                "senses": [
                    {
                        "sense_id": "ba8dbe8d-a5d9-3801-8f21-7e7c90f858c5",
                        "entry_id": "d50ac7ca-5621-379b-9772-49e3ceff763b",
                        "glosses": [
                            "Begrenzung für Grünflächen aus Stein oder Beton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e82719d4-8069-44f4-98e5-6190c920a40c",
                                "sense_id": "ba8dbe8d-a5d9-3801-8f21-7e7c90f858c5",
                                "text": "„Die Rasenkantensteine, Mähkanten oder Palisaden werden nach dem Verlegen eingeschlämmt, damit sie in der gewünschten Position stehen bleiben.“"
                            },
                            {
                                "example_id": "c89a4d47-e47b-4139-8ffb-185252155625",
                                "sense_id": "ba8dbe8d-a5d9-3801-8f21-7e7c90f858c5",
                                "text": "„Sie können sich die Pflege der Rasenkante im Garten wesentlich erleichtern, wenn Sie Ihren Rasen mit einer Steinkante einfassen. Für diesen Zweck sind spezielle Rasenkantensteine aus Beton erhältlich, die auch Mähkanten genannt werden.“"
                            },
                            {
                                "example_id": "49410145-81bc-40cc-a226-20f7d5d711c9",
                                "sense_id": "ba8dbe8d-a5d9-3801-8f21-7e7c90f858c5",
                                "text": "„Während die Frau auf der Couch saß, um die Kontobewegungen ihres Mannes am Handy zu prüfen, nachdem sie ihn mit den Überziehungen konfrontiert hatte, soll er in den Garten gegangen sein und einen mehrere Kilo schweren Rasenkantenstein geholt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
