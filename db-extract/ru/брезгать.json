                "senses": [
                    {
                        "sense_id": "3b555a6e-121b-3f32-8608-cdceb95feac9",
                        "entry_id": "90216dc9-856e-3166-a95c-2cf9b6b41f68",
                        "glosses": [
                            "to be fastidious/squeamish (about)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5325400-fb9a-4fce-be13-8645c40a133c",
                                "sense_id": "3b555a6e-121b-3f32-8608-cdceb95feac9",
                                "text": "Он бре́згает пить из чужо́го стака́на.",
                                "translation": "He is squeamish about drinking out of someone else's glass. / It disgusts him to drink out of someone else's glass.",
                                "english": "He is squeamish about drinking out of someone else's glass. / It disgusts him to drink out of someone else's glass."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2becea0-20af-3977-abd2-c4fdd7ca6c00",
                        "entry_id": "90216dc9-856e-3166-a95c-2cf9b6b41f68",
                        "glosses": [
                            "to disdain, to shrink (from) (usually negative)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6036cddf-5f25-4b28-9d70-762260c48332",
                                "sense_id": "a2becea0-20af-3977-abd2-c4fdd7ca6c00",
                                "text": "Он не бре́згает никаки́ми сре́дствами.",
                                "translation": "He does not scruple/disdain to use any means; he is not squeamish/fastidious about any means he uses.",
                                "english": "He does not scruple/disdain to use any means; he is not squeamish/fastidious about any means he uses."
                            }
                        ]
                    }
                ],
