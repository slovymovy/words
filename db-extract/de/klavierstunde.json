                ],
                "senses": [
                    {
                        "sense_id": "d2413127-bbfc-30fb-9bb2-6e86fdd57173",
                        "entry_id": "3d15718b-720b-33c4-97d1-44b55acd9175",
                        "glosses": [
                            "eine Unterrichtsstunde im Klavier spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed2235f-8e39-4acd-952c-551ca86ce98c",
                                "sense_id": "d2413127-bbfc-30fb-9bb2-6e86fdd57173",
                                "text": "Die Klavierstunde war für den Schüler wieder sehr anstrengend."
                            },
                            {
                                "example_id": "fc9774ca-37d4-44ac-af73-76635ae1d8ee",
                                "sense_id": "d2413127-bbfc-30fb-9bb2-6e86fdd57173",
                                "text": "„Ich hatte nur als Kind ein paar Klavierstunden bekommen, und bevor ich mir vor fünf Jahren eine Lehrerin suchte, war ich im Grunde ein Autodidakt.“"
                            },
                            {
                                "example_id": "ad118cc6-3974-455e-9834-ec8511aa6c69",
                                "sense_id": "d2413127-bbfc-30fb-9bb2-6e86fdd57173",
                                "text": "„Ich war froh darüber, keine Klavierstunden mehr zu haben, aber noch jahrelang dachte ich an das Mädchen, wenn ich in meinem Zimmer lag und mir vorstellte, dass ihre Hände über meinen Körper wanderten.“"
                            },
                            {
                                "example_id": "38a0fc9d-a474-4a76-96ab-170fbac427a0",
                                "sense_id": "d2413127-bbfc-30fb-9bb2-6e86fdd57173",
                                "text": "„Dann radelte sie früh am Morgen nach Friedland, um mit ihren Schulfreundinnen Tennis zu spielen und eine Klavierstunde zu nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
