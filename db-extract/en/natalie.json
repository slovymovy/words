    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "77e4ebc9-f9ac-36d0-99cb-da74a3d63f12",
                "word": "Natalie",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6b4879a1-5407-3723-8ca4-292e67ae0a9e",
                        "entry_id": "77e4ebc9-f9ac-36d0-99cb-da74a3d63f12",
                        "glosses": [
                            "A female given name from Latin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be8fced1-cab6-4134-991e-f070512e0dd2",
                                "sense_id": "6b4879a1-5407-3723-8ca4-292e67ae0a9e",
                                "text": "[…] often I have listened to my dear brother, as he told me the pretty story of the sad gentleman whom he met, when I was but an infant, and how he spoke to me so tenderly, and sighed for his own Natalie. I had no other name then but Sea-flower, and I have been called by that name ever since; yet after that day, my Christian name was Natalie."
                            },
                            {
                                "example_id": "904d7fb4-6db2-47ef-b6a5-729cb83a359b",
                                "sense_id": "6b4879a1-5407-3723-8ca4-292e67ae0a9e",
                                "text": "I was ashamed of my very name, Natalie. Nobody else in town had the name Natalie. I wanted to have a name like Frances or Elizabeth, as two of the most popular little girls were named. When old ladies at church would say to me kindly enough,\"What's your name, little girl?\" I would answer \"Natalie,\" and they would say, \"Madaline, Mattie, what did you say?\""
                            },
                            {
                                "example_id": "03af9c20-ae94-41e1-b29b-a1c85490b48d",
                                "sense_id": "6b4879a1-5407-3723-8ca4-292e67ae0a9e",
                                "text": "ELSTON. Natalie is a beautiful name.\nNATALIE. Well, yes. It is. Thank you.\nELSTON. A real spy name. My wife Natasha has a spy name and I'm forever telling her […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6e479c7-b643-4f16-964a-512e7416d3f3",
