{
    "word_family": [
        "provoke",
        "provocative",
        "provocatively",
        "provoker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d6f1d89-165b-3af3-ae99-c0a986ea7d53",
                    "sense_definition": "An action, statement, or event that is intended to provoke, anger, or incite a reaction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "provocation_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military exercises near the border were seen as a direct <w>provocation</w>.",
                            "target_lang_translations": {
                                "ru": "Военные учения вблизи границы были расценены как прямая <w>провокация</w>."
                            }
                        },
                        {
                            "text": "He reacted with anger to what he perceived as a deliberate <w>provocation</w>.",
                            "target_lang_translations": {
                                "ru": "Он гневно отреагировал на то, что счел преднамеренной <w>провокацией</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "incitement",
                        "affront",
                        "insult"
                    ],
                    "antonyms": [
                        "pacification",
                        "appeasement"
                    ],
                    "common_phrases": [
                        "deliberate provocation",
                        "direct provocation",
                        "without provocation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заявление или событие, направленное на то, чтобы вызвать гнев, раздражение или ответную реакцию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провокация",
                                "target_lang_sense_clarification": "действие, направленное на вызов ответной реакции"
                            },
                            {
                                "target_lang_word": "вызов",
                                "target_lang_sense_clarification": "действие, побуждающее к противоборству"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2a5b692-7f08-38a5-8157-1085724e4d41",
                    "sense_definition": "The act of provoking, inciting, or annoying someone into doing something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "provocation_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense argued that the defendant acted under extreme <w>provocation</w>.",
                            "target_lang_translations": {
                                "ru": "Защита утверждала, что подсудимый действовал в состоянии крайней <w>провокации</w>."
                            }
                        },
                        {
                            "text": "She remained calm and refused to respond to their constant <w>provocation</w>.",
                            "target_lang_translations": {
                                "ru": "Она сохраняла спокойствие и отказывалась реагировать на их постоянные <w>провокации</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "instigation",
                        "goading",
                        "vexation"
                    ],
                    "antonyms": [
                        "conciliation"
                    ],
                    "common_phrases": [
                        "under provocation",
                        "act of provocation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт подстрекательства, раздражения или побуждения кого-либо к совершению какого-либо действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провокация",
                                "target_lang_sense_clarification": "подстрекательство или раздражение кого-либо"
                            },
                            {
                                "target_lang_word": "провоцирование",
                                "target_lang_sense_clarification": "процесс вызывания определенной реакции"
                            },
                            {
                                "target_lang_word": "подстрекательство",
                                "target_lang_sense_clarification": "побуждение к нежелательным действиям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6feb1939-5926-3031-b9cf-d20a87de99ec",
                    "sense_definition": "In medical assessment, the step of investigating what factors make a patient's symptoms or pain better or worse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When it's time to check for <w>provocation</w>, ask the patient about what makes their chief complaint better or worse.",
                            "target_lang_translations": {
                                "ru": "Когда придет время проверить <w>провоцирующие факторы</w>, спросите пациента о том, что облегчает или усугубляет его основную жалобу."
                            }
                        },
                        {
                            "text": "The paramedic documented the palliation and <w>provocation</w> factors of the chest pain.",
                            "target_lang_translations": {
                                "ru": "Фельдшер задокументировал облегчающие и <w>провоцирующие</w> факторы боли в груди."
                            }
                        }
                    ],
                    "common_phrases": [
                        "check for provocation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical medical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В медицинской оценке: этап исследования факторов, которые облегчают или усугубляют симптомы или боль пациента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провокация",
                                "target_lang_sense_clarification": "искусственное вызывание или усиление симптомов болезни"
                            },
                            {
                                "target_lang_word": "провоцирующие факторы",
                                "target_lang_sense_clarification": "факторы, вызывающие или усиливающие боль"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}