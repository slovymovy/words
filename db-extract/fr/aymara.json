                ],
                "senses": [
                    {
                        "sense_id": "562a760d-57fa-3bc2-ad12-448be8512e87",
                        "entry_id": "c16e3017-b665-30b8-845a-3062b2553890",
                        "glosses": [
                            "Langue amérindienne parlée à la frontière entre la Bolivie, le Pérou et le Chili."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb7be97f-937f-4272-82a1-1502cad4feed",
                                "sense_id": "562a760d-57fa-3bc2-ad12-448be8512e87",
                                "text": "Selon Rodolfo Cerrón-Palomino, un des principaux spécialistes de ces deux langues, ce n'est pas le quechua, mais bien l'aymara qui était la langue officielle de l’empire inca, contrairement à une opinion répandue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "938a6b79-eb57-461b-b971-3190412231a3",
                        "source_entry_id": "c16e3017-b665-30b8-845a-3062b2553890",
                        "source_sense_id": "562a760d-57fa-3bc2-ad12-448be8512e87",
                        "target_lang_word": "Aymara",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aymara",
