                        "glosses": [
                            "Propre ou relatif à Julien Gracq et à son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34eca209-606f-4f97-a0c0-7893c5a0262b",
                                "sense_id": "6da49ee8-3d8d-37e1-92e6-491e48a3d476",
                                "text": "Le vocabulaire gracquien résonne toujours, si formidable aux oreilles averties du lecteur initié, rompu aux parcours de mystères et d’ombres qui peuplent son œuvre."
                            },
                            {
                                "example_id": "dbb84c39-92c2-456a-9b81-c5e54abd9be1",
                                "sense_id": "6da49ee8-3d8d-37e1-92e6-491e48a3d476",
                                "text": "Elle développe ainsi une réflexion sur la manière dont la crise du récit se joue, pour l'écriture gracquienne, dans une prédominance de la fonction poétique sur la fonction référentielle."
                            },
                            {
                                "example_id": "0c7ada99-8436-4de2-be4f-fbc3f7c55345",
                                "sense_id": "6da49ee8-3d8d-37e1-92e6-491e48a3d476",
                                "text": "La poésie gracquienne est particulièrement sensible à cet « engagement »."
                            }
                        ]
                    }
