                "senses": [
                    {
                        "sense_id": "3146558a-f6d6-3969-b370-9ea26011cd58",
                        "entry_id": "4a86966b-b884-3f0b-a8fa-33a1b532e35f",
                        "glosses": [
                            "состоящий из четырёх частей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e5664a6-a97a-4769-a6fd-964100f05986",
                                "sense_id": "3146558a-f6d6-3969-b370-9ea26011cd58",
                                "text": "Несмотря на контрастность ее частей, обычную для каждого большого, четырехчастного произведения, вся симфония отмечена большим единством мысли и совершенством формы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88a19326-c65b-4655-b3f9-61c5a50dac27",
                        "source_entry_id": "4a86966b-b884-3f0b-a8fa-33a1b532e35f",
                        "source_sense_id": "3146558a-f6d6-3969-b370-9ea26011cd58",
                        "target_lang_word": "fourfold",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fourfold",
