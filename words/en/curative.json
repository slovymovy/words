{
    "word_family": [
        "cure",
        "curability",
        "curable",
        "incurable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e7b77de1-c0c4-34d7-b1e1-11c7eb82b462",
                    "sense_definition": "Possessing the ability to heal or treat an illness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "healing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>curative</w> power of the new medicine was truly remarkable for the patients.",
                            "target_lang_translations": {
                                "ru": "<w>Лечебная</w> сила нового лекарства была поистине удивительной для пациентов."
                            }
                        },
                        {
                            "text": "Doctors often focus on preventive care rather than just <w>curative</w> measures.",
                            "target_lang_translations": {
                                "ru": "Врачи часто сосредотачиваются на профилактике, а не только на <w>лечебных</w> мерах."
                            }
                        }
                    ],
                    "synonyms": [
                        "healing",
                        "remedial",
                        "therapeutic"
                    ],
                    "common_phrases": [
                        "curative power",
                        "curative measure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий способностью исцелять или лечить болезнь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лечебный",
                                "target_lang_sense_clarification": "относящийся к процессу лечения"
                            },
                            {
                                "target_lang_word": "целебный",
                                "target_lang_sense_clarification": "обладающий свойством исцелять"
                            },
                            {
                                "target_lang_word": "терапевтический",
                                "target_lang_sense_clarification": "используемый в медицине для лечения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5bd5bff-673f-3d0a-b0c7-97701fd11279",
                    "sense_definition": "Serving to correct or remedy a mistake or negative situation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge issued a <w>curative</w> instruction to the jury to ignore the improper evidence.",
                            "target_lang_translations": {
                                "ru": "Судья дал присяжным <w>исправительную</w> инструкцию игнорировать недопустимые доказательства."
                            }
                        },
                        {
                            "text": "The company took <w>curative</w> action to fix the error in the financial report.",
                            "target_lang_translations": {
                                "ru": "Компания предприняла <w>корректирующие</w> действия, чтобы исправить ошибку в финансовом отчете."
                            }
                        }
                    ],
                    "synonyms": [
                        "remedial",
                        "corrective"
                    ],
                    "common_phrases": [
                        "curative action",
                        "curative instruction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий для исправления ошибки или негативной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправительный",
                                "target_lang_sense_clarification": "направленный на устранение недостатков"
                            },
                            {
                                "target_lang_word": "корректирующий",
                                "target_lang_sense_clarification": "вносящий поправки для исправления ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e260d14-5d25-3087-9e6d-c0ca33dac430",
                    "sense_definition": "Relating to a verb that indicates an agent causes a patient to perform an action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some languages, the <w>curative</w> form of the verb is used to show causation.",
                            "target_lang_translations": {
                                "ru": "В некоторых языках <w>каузативная</w> форма глагола используется для выражения побуждения."
                            }
                        },
                        {
                            "text": "Linguists study the <w>curative</w> properties of certain causative verb structures.",
                            "target_lang_translations": {
                                "ru": "Лингвисты изучают <w>побудительные</w> свойства определенных каузативных глагольных структур."
                            }
                        }
                    ],
                    "synonyms": [
                        "causative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к глаголу, который указывает, что субъект побуждает объект к действию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каузативный",
                                "target_lang_sense_clarification": "лингвистический термин для обозначения побудительного значения"
                            },
                            {
                                "target_lang_word": "побудительный",
                                "target_lang_sense_clarification": "выражающий принуждение или побуждение к действию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "495f3fd4-08f8-3b37-9757-a66de925b2d2",
                    "sense_definition": "A substance or treatment that acts as a cure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "healing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The herbal tea was considered a natural <w>curative</w> for his persistent cough.",
                            "target_lang_translations": {
                                "ru": "Травяной чай считался натуральным <w>лекарством</w> от его затяжного кашля."
                            }
                        },
                        {
                            "text": "Scientists are searching for a new <w>curative</w> to combat the rare disease.",
                            "target_lang_translations": {
                                "ru": "Ученые ищут новое <w>целебное средство</w> для борьбы с редким заболеванием."
                            }
                        }
                    ],
                    "synonyms": [
                        "remedy",
                        "cure",
                        "treatment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество или метод лечения, действующие как лекарство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лекарство",
                                "target_lang_sense_clarification": "средство для лечения болезни"
                            },
                            {
                                "target_lang_word": "целебное средство",
                                "target_lang_sense_clarification": "вещество, обладающее исцеляющими свойствами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}