                        "cross_references": [
                            {
                                "target_word": "postern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e2f360-bc5e-3d5e-82e8-19d5a38d8101",
                                        "entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                                        "glosses": [
                                            "A back gate, back door, side entrance, or other gateway distinct from the main entrance, especially in a city wall or fortification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bbb1242-a736-491a-bc1e-e0068577ec40",
                                                "sense_id": "a1e2f360-bc5e-3d5e-82e8-19d5a38d8101",
                                                "text": "And as they cam hurlyng vnder the Castel where as sir launcelot lay in wyndowe / & sawe how two knyghtes layd vpon syr Blyaunt with their swerdes /[…]/ And thenne sir launcelot brake the chaynes fro his legges and of his armes /[…]/ & so sir launcelot ran out at a posterne / and there he mett with the two knyȝtes that chaced sir Blyaunt"
                                            },
                                            {
                                                "example_id": "15acd2f9-788a-4c56-a757-1ffd733a13cb",
                                                "sense_id": "a1e2f360-bc5e-3d5e-82e8-19d5a38d8101",
                                                "text": "He by a privy postern took his flight."
                                            },
                                            {
                                                "example_id": "c5afdf22-5a35-4e86-b336-fc80668a631d",
                                                "sense_id": "a1e2f360-bc5e-3d5e-82e8-19d5a38d8101",
                                                "text": "Out at the postern, by the abbey wall."
                                            },
                                            {
                                                "example_id": "e58afed6-1c1a-4efb-9cf5-4d289d353d5d",
                                                "sense_id": "a1e2f360-bc5e-3d5e-82e8-19d5a38d8101",
                                                "text": "The Duke of Argyle led the way in silence to the small postern by which they had been admitted into Richmond Park, so long the favourite residence of Queen Caroline. It was opened by the same half-seen janitor, and they found themselves beyond the precincts of the royal demesne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "671bd819-e79c-36b6-9ed8-b4b35bba7096",
                                        "entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                                        "glosses": [
                                            "A separate or hidden way in or out of a place, situation etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc863afc-f459-3afd-8abb-a0145b2bd2a7",
                                        "entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                                        "glosses": [
                                            "A subterranean passage communicating between the parade and the main ditch, or between the ditches and the interior of the outworks."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7712b815-aef8-46ca-911c-b5a43bd0e8b7",
                                                "sense_id": "fc863afc-f459-3afd-8abb-a0145b2bd2a7",
                                                "text": "The postern of the enceinte leads through the middle of the curtain, descending from the plane of sight to the ditch"
                                            }
                                        ]
                                    }
                                ]
                            },
