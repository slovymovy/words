                                "target_senses": [
                                    {
                                        "sense_id": "3410d853-f7a4-3e47-a52d-8701410b2d42",
                                        "entry_id": "723de02a-de9c-3a25-b6ee-cde8e96d22d7",
                                        "glosses": [
                                            "Eigenschaft, bedeutsam, wichtig zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9814a7a2-aaf3-464c-a01e-c57a0ad6159e",
                                                "sense_id": "3410d853-f7a4-3e47-a52d-8701410b2d42",
                                                "text": "Eine Aufgabe von solcher Wichtigkeit kann ich nur dir zusprechen."
                                            },
                                            {
                                                "example_id": "559c5c38-4f58-45da-931d-904ee7a73167",
                                                "sense_id": "3410d853-f7a4-3e47-a52d-8701410b2d42",
                                                "text": "„Was andere die objektive Wichtigkeit der Kunst nennen, ist mir schnuppe, aber wo es gar keine Aufsichtsräte gibt, über Aufsichtsräte zu spotten, das würde mir gemein vorkommen.“"
                                            },
                                            {
                                                "example_id": "48a090e5-80f8-4632-9980-4788a14b40bd",
                                                "sense_id": "3410d853-f7a4-3e47-a52d-8701410b2d42",
                                                "text": "„Da wurde zum Beispiel nach der Wichtigkit einer Titelanrede für Priester gefragt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "d8a5bf65-24d3-3e42-81ee-9ae6e771e7c8",
                                        "entry_id": "723de02a-de9c-3a25-b6ee-cde8e96d22d7",
                                        "glosses": [
                                            "Eigenschaft, notwendig zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0833c515-8e5d-406c-a670-e11ec19934ab",
                                                "sense_id": "d8a5bf65-24d3-3e42-81ee-9ae6e771e7c8",
                                                "text": "Die Wichtigkeit dieses Schrittes hat er leider zu spät erkannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "b580aedc-4ac8-3bb9-b36c-99483dc80ad7",
                                        "entry_id": "723de02a-de9c-3a25-b6ee-cde8e96d22d7",
                                        "glosses": [
