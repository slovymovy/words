                            {
                                "target_word": "Wende",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "038cc7f4-85f9-3f08-a387-09170749f790",
                                        "entry_id": "c37e5564-55a7-3b2d-a726-8c6f5730512d",
                                        "glosses": [
                                            "einschneidende Veränderung, Umbruch"
                                        ],
                                        "tags": [
                                            "Gesellschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28642b59-13a7-46be-9373-3ada40cad147",
                                                "sense_id": "038cc7f4-85f9-3f08-a387-09170749f790",
                                                "text": "Die konstantinische Wende machte aus der staatlich diskriminierten und phasenweise blutig verfolgten orthodox-katholischen Kirche eine zunächst geduldete, dann rechtlich privilegierte Institution und zuletzt unter Theodosius I. eine Reichskirche."
                                            },
                                            {
                                                "example_id": "2407b44b-ba0b-46c8-b641-0c9bb1559860",
                                                "sense_id": "038cc7f4-85f9-3f08-a387-09170749f790",
                                                "text": "„Mit der Gründung des Gestüts in Lipizza durch Karl von Innerösterreich (1580) kam es zu einer entscheidenden Wende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "17168e86-96be-3277-adaa-0fb73a4474d3",
                                        "entry_id": "c37e5564-55a7-3b2d-a726-8c6f5730512d",
                                        "glosses": [
                                            "friedliche Revolution 1989 in mehreren Ostblock-Ländern, insbesondere die Wende in der DDR"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10cbad1f-56be-491b-a543-05f706122708",
                                                "sense_id": "17168e86-96be-3277-adaa-0fb73a4474d3",
                                                "text": "Voraussetzung für die Ereignisse der Wende war der Machtwechsel in der Sowjetunion seit 1985 und die veränderte Politik der sowjetischen Führung unter Michail Gorbatschow."
                                            },
                                            {
                                                "example_id": "cdac7472-1a24-4ef8-8837-6f380d57c193",
                                                "sense_id": "17168e86-96be-3277-adaa-0fb73a4474d3",
                                                "text": "„Während Ost-Deutschland, zwanzig Jahre nach der Wende, geschmackvoll gefliest und picobello asphaltiert ist und die Zinsen stabil bei 1,5 Prozent liegen, gibt es in Polen noch Basisarbeit zu leisten: Bahnhöfe zu bauen, Flüsse auszubaggern und Fertighausfirmen zu gründen.“"
                                            },
                                            {
                                                "example_id": "994bdaea-ed93-4cd5-9592-c43375306c97",
                                                "sense_id": "17168e86-96be-3277-adaa-0fb73a4474d3",
                                                "text": "„Hektische Aufbruchsstimmung herrscht dort im Jahre eins nach der Wende.“"
                                            },
                                            {
                                                "example_id": "0e617bc5-a8e8-4f9c-ad58-80d46304c799",
                                                "sense_id": "17168e86-96be-3277-adaa-0fb73a4474d3",
                                                "text": "„Auch nach der Wende pochte der Eichsfelder auf sein Recht, lieber aus der Bibel, als aus dem Kommunistischen Manifest zu zitieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3050c5e-26a9-3398-9294-9a74e848b56a",
                                        "entry_id": "c37e5564-55a7-3b2d-a726-8c6f5730512d",
                                        "glosses": [
                                            "historische Veränderung zu einem neuen Abschnitt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60be10eb-8314-4be8-9208-f8016f0a4c6f",
                                                "sense_id": "e3050c5e-26a9-3398-9294-9a74e848b56a",
                                                "text": "Die Wende vom 19. ins 20. Jahrhundert ging mit großen sozialen und politischen Änderungen einher."
                                            },
                                            {
                                                "example_id": "22648cf5-4dce-416b-ac2a-88b80bdae34a",
                                                "sense_id": "e3050c5e-26a9-3398-9294-9a74e848b56a",
                                                "text": "„Ich kann mir gut vorstellen, dass die Anti-Atomprotestler in den 80ern oft frustriert waren, dass ihre Demos keine unmittelbare Wende in der Atompolitik herbeiführten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7c1708ca-e723-34a8-bb41-c339b9246117",
                                        "entry_id": "c37e5564-55a7-3b2d-a726-8c6f5730512d",
                                        "glosses": [
                                            "Technik des Richtungswechsels am Ende des Schwimmbeckens"
                                        ],
                                        "tags": [
                                            "Schwimmen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "939f3654-790b-498b-9975-03dff806a60b",
                                                "sense_id": "7c1708ca-e723-34a8-bb41-c339b9246117",
                                                "text": "Beim Wasserball wird eine Wende benötigt, um schnell von Angriff in Verteidigung zu wechseln."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ec59452c-7d10-3ff7-8933-9185f2aeed72",
                                        "entry_id": "c37e5564-55a7-3b2d-a726-8c6f5730512d",
                                        "glosses": [
                                            "Sprung, bei dem die Vorderseite des Körpers dem Gerät zugewandt ist"
                                        ],
                                        "tags": [
                                            "Turnen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28054626-1d23-48a6-9136-967a64a66db0",
                                                "sense_id": "ec59452c-7d10-3ff7-8933-9185f2aeed72",
                                                "text": "Ich sollte die Wende am Barren noch häufiger üben."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "6b82c3b3-9ba3-3d30-ac2e-20d3fb40b205",
                                        "entry_id": "c37e5564-55a7-3b2d-a726-8c6f5730512d",
                                        "glosses": [
                                            "Figur, bei der ein Bogen auf der gleichen Kante vorwärts und rückwärts ausgeführt wird"
                                        ],
                                        "tags": [
                                            "Eiskunstlauf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c6b387d-5f81-4a7a-adaf-79bf2f729b7f",
                                                "sense_id": "6b82c3b3-9ba3-3d30-ac2e-20d3fb40b205",
                                                "text": "Beim Training für den Eiskunstlauf übten sie die Wende."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "2bfde321-a5b3-32ab-8571-821dea4f7adb",
                                        "entry_id": "c37e5564-55a7-3b2d-a726-8c6f5730512d",
                                        "glosses": [
                                            "Segelmanöver zur Richtungsänderung"
                                        ],
                                        "tags": [
                                            "Segeln"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ce254f9-a827-48a5-8e58-35af14cf0101",
                                                "sense_id": "2bfde321-a5b3-32ab-8571-821dea4f7adb",
                                                "text": "Das Manöver wird mit dem Kommando „Klar zur Wende“ eingeleitet."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wende",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebb862d5-9e24-397a-95e5-652e0b043bbe",
                                        "entry_id": "5907c673-9250-3763-b5fc-f1da315f5be0",
                                        "glosses": [
                                            "Angehöriger eines westslawischen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ea34af-539b-4e26-8b30-155d7fa68ae9",
                                                "sense_id": "ebb862d5-9e24-397a-95e5-652e0b043bbe",
                                                "text": "Im 9. Jahrhundert wurde das heutige Wendland von den Wenden, einer slawischen Volksgruppe, besiedelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
