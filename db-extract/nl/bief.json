                                                "example_id": "1067cf65-3b34-4643-bb73-f3cbfcdf3c5e",
                                                "sense_id": "af12841b-06da-325b-beb8-9f937f41cdc7",
                                                "text": "boneless lean beef trimmings"
                                            },
                                            {
                                                "example_id": "75079cd7-ce53-4ac0-9790-433ac1566642",
                                                "sense_id": "af12841b-06da-325b-beb8-9f937f41cdc7",
                                                "text": "McDonald’s has been vocal about adding more chicken to its menu, which is generally cheaper than beef. CEO Chris Kempczinski said in its most recent earnings call that it’s focused on adding “growth drivers like chicken” in an attempt to reverse slumping sales. Chicken is now on par with beef sales at its restaurants, he added."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c085892-cba1-3c9f-86ba-13380368458d",
                                        "entry_id": "402a129e-d01a-37a2-a27e-209621e32625",
                                        "glosses": [
                                            "The meat from cattle or other bovines.",
                                            "Muscle or musculature; size, strength or potency."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d44f76d0-3f01-4ed0-a11f-8ff3b78e4ea3",
                                                "sense_id": "5c085892-cba1-3c9f-86ba-13380368458d",
                                                "text": "Put some beef into it! We've got to get the car over the bump."
                                            },
                                            {
                                                "example_id": "4c6015e9-e9a7-4680-9847-12b7ce818c08",
                                                "sense_id": "5c085892-cba1-3c9f-86ba-13380368458d",
                                                "text": "We've got to get some beef into the enforcement provisions of that law."
                                            }
                                        ]
                                    },
                                    {
