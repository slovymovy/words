                "senses": [
                    {
                        "sense_id": "7b2044ae-1727-3d5d-a8c9-83cec9abc0a3",
                        "entry_id": "b9591e2c-a14e-32c6-8e5b-52772a7ed4d9",
                        "glosses": [
                            "oberer Teil einer Flugzeugkabine"
