                    {
                        "translation_id": "9e199ba8-c862-4cd8-9d12-fba3e2b18451",
                        "source_entry_id": "3a7ac57d-7d13-39bb-9c2f-63836089227f",
                        "source_sense_id": "b092ed60-9480-3ce1-a7a3-b215738759cb",
