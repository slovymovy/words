                "senses": [
                    {
                        "sense_id": "67258149-0e92-3b20-a1c4-9b8c0bf334df",
                        "entry_id": "cb961ab2-f547-3c65-b569-4389076dedd9",
                        "glosses": [
                            "vergrijp aan iets heiligs, ontheiliging"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b159d569-8ad7-4b9b-babe-df592138ff36",
                        "source_entry_id": "cb961ab2-f547-3c65-b569-4389076dedd9",
                        "source_sense_id": "67258149-0e92-3b20-a1c4-9b8c0bf334df",
                        "source_sense_description": "vergrijp aan iets heiligs",
                        "target_lang_word": "Sakrileg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sakrileg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "326ce9b4-7ed0-3c70-b01f-f3c2248c8f0d",
                                        "entry_id": "b471e203-73b9-3258-b6e3-da02f1f6f4aa",
                                        "glosses": [
                                            "Vergehen gegen Heiliges, zum Beispiel die Entweihung heiligen Bodens oder Sachen durch Raub, Schändung oder auch Missbrauch, aber auch Angriffe gegen geweihte Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2f75745-1918-41b1-b1ac-be53b73de045",
                                                "sense_id": "326ce9b4-7ed0-3c70-b01f-f3c2248c8f0d",
                                                "text": "Das ist ein Sakrileg!"
                                            },
                                            {
                                                "example_id": "ec1f2dec-dfcd-43ce-a5fb-646f1ec1e141",
                                                "sense_id": "326ce9b4-7ed0-3c70-b01f-f3c2248c8f0d",
                                                "text": "„Und diese Empfindung war, paradoxerweise, durchsetzt mit einer Gleichgültigkeit, die einem Sakrileg gleichkam, weil sie die gesamte akademische Welt in Frage stellte.“"
                                            },
                                            {
                                                "example_id": "393ba3db-65c1-4912-b3e7-e02e23108265",
                                                "sense_id": "326ce9b4-7ed0-3c70-b01f-f3c2248c8f0d",
                                                "text": "„Wer ihre experimentierende Verwendung als Sakrileg kritisiert, übersieht, dass sie selbst Sakrilegien ihre Existenz verdankten […].“"
                                            },
                                            {
                                                "example_id": "4d0c062a-462a-4459-8e39-bbe29cda6d45",
                                                "sense_id": "326ce9b4-7ed0-3c70-b01f-f3c2248c8f0d",
                                                "text": "„Theokratie, von Gott eingesetzte Gewalt, das Sakrileg aller Sakrilegien.“"
                                            },
                                            {
                                                "example_id": "d8bb4c8a-782f-417d-ab37-f9691d94adae",
                                                "sense_id": "326ce9b4-7ed0-3c70-b01f-f3c2248c8f0d",
                                                "text": "„Die große Bandbreite der Vergehen, die unter dem Rechtsbegriff des Sakrilegs gefasst werden, mache es unmöglich, sie hier aufzuzählen. Schon in der Spätantike definieren Theologen wie Augustinus Vergehen gegen Gott als Sakrileg, […]. Da die Sakrilegien in die Kategorie des crimen publicum fallen, unterliegen sie der herrscherlichen Sanktionsgewalt, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8da08e6-6c6f-4590-abb1-b70fd29fc0f5",
                        "source_entry_id": "cb961ab2-f547-3c65-b569-4389076dedd9",
                        "source_sense_id": "67258149-0e92-3b20-a1c4-9b8c0bf334df",
                        "source_sense_description": "vergrijp aan iets heiligs",
                        "target_lang_word": "sacrilege",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacrilege",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27f8b213-313a-3b6d-b24e-c4def2f3d326",
                                        "entry_id": "9f0acd0c-0674-38cf-869b-654efe05e466",
                                        "glosses": [
                                            "Desecration, profanation, misuse or violation of something regarded as sacred."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ed7b0b5-6a61-4c18-b611-05345765d620",
                                                "sense_id": "27f8b213-313a-3b6d-b24e-c4def2f3d326",
                                                "text": "I recall the height of comfort attained by the green-cushioned \"first\" with starched white antimacassars and a pretentious grey floor mat on which it seemed a sacrilege to stand, as it was embellished with the North Western conception of Britannia, complete with trident."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2e2a0c0-3479-432c-a813-1fdf812627cb",
                        "source_entry_id": "cb961ab2-f547-3c65-b569-4389076dedd9",
                        "source_sense_id": "67258149-0e92-3b20-a1c4-9b8c0bf334df",
                        "source_sense_description": "vergrijp aan iets heiligs",
                        "target_lang_word": "sacrilège",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacrilège",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e22bd1a-4c84-3dc2-8c1a-b58b5674cbfc",
                                        "entry_id": "303a0c90-ee1e-3027-9da6-c54967295636",
                                        "glosses": [
                                            "Qui commet une profanation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6ac9e8-8e9f-4682-ad14-d2e65b1ce21b",
                                                "sense_id": "5e22bd1a-4c84-3dc2-8c1a-b58b5674cbfc",
                                                "text": "Il se trouva ainsi, d’après les lois de l’église, coupable d’un double sacrilège, comme bigame, et comme mari d’une femme qui avait reçu le voile de religieuse."
                                            },
                                            {
                                                "example_id": "c2739fd6-f177-48d0-8f4a-349aee0691cd",
                                                "sense_id": "5e22bd1a-4c84-3dc2-8c1a-b58b5674cbfc",
                                                "text": "L’indifférence en matière de foi était devenue de règle, car d’hostilité on n’en sentait point trop encore ; à peine sourdait-elle, peut-être, dans quelques propos sacrilèges que les mauvaises langues : […], s’essayaient malicieusement dans l’ombre à propager."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e3620a4-b7ea-3ca4-afe0-0370522bff59",
                                        "entry_id": "303a0c90-ee1e-3027-9da6-c54967295636",
                                        "glosses": [
                                            "Qui relève de la profanation, de la violation du sacré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a1dbe67-1e43-48e9-9a98-1d420246f25b",
                                                "sense_id": "1e3620a4-b7ea-3ca4-afe0-0370522bff59",
                                                "text": "Il est évident que ces réformes sont fort louables, mais elles sont loin d’être acceptées avec enthousiasme : […]; et les lettrés les considèrent comme un attentat sacrilège contre les traditions koraniques."
                                            },
                                            {
                                                "example_id": "92a04ca3-06d9-4190-a87c-24d7001ec395",
                                                "sense_id": "1e3620a4-b7ea-3ca4-afe0-0370522bff59",
                                                "text": "Mais chut, en dire plus serait sacrilège."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sacrilège",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de078313-04da-3c46-a8c7-3b6b0a45c47d",
                                        "entry_id": "bc50df90-110c-3042-b4b4-1e95f21c6118",
                                        "glosses": [
                                            "Profanation d’une chose sacrée ; outrage à une personne digne de vénération ou d’égards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1d5b90-1556-45f9-9d44-8065bb4c923c",
                                                "sense_id": "de078313-04da-3c46-a8c7-3b6b0a45c47d",
                                                "text": "Le vol des choses consacrées à Dieu était un sacrilège, parce que ce vol renfermait une profanation de choses saintes : tel était le vol des calices, ciboires, reliques, images et même des troncs d’église."
                                            },
                                            {
                                                "example_id": "43cc4e0a-7f62-4c12-894d-d9504e60a48d",
                                                "sense_id": "de078313-04da-3c46-a8c7-3b6b0a45c47d",
                                                "text": "Dans un moment comme celui-là, il ne s'amuse pas à cacher un seul de ses péchés, cela est évident. — Au surplus, cacherait-il la moindre peccadille, cela ne lui servirait qu'à transformer sa confession en sacrilège, et alors, patatras ! dans l'enfer! c'est-à-dire messes inutiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4732130-0724-3cb4-bed8-0b7d7a0405de",
                                        "entry_id": "bc50df90-110c-3042-b4b4-1e95f21c6118",
                                        "glosses": [
                                            "Action qui s’apparente à la violation de quelque chose de sacré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88ca7445-7b65-47c7-90ed-465215afee67",
                                                "sense_id": "a4732130-0724-3cb4-bed8-0b7d7a0405de",
                                                "text": "Ce serait un sacrilège de retoucher à ce tableau."
                                            },
                                            {
                                                "example_id": "1b95e95e-ecce-420a-853d-9ed590c3a0d0",
                                                "sense_id": "a4732130-0724-3cb4-bed8-0b7d7a0405de",
                                                "text": "De son côté, Moscou compte encore une fois protester à Samara contre le déplacement d’un monument soviétique en Estonie, sacrilège qui n’a pas été suffisamment condamné par l’UE, estime le ministère russe des Affaires étrangères."
                                            },
                                            {
                                                "example_id": "60bce56b-b964-45a0-8595-6508b422c4ee",
                                                "sense_id": "a4732130-0724-3cb4-bed8-0b7d7a0405de",
                                                "text": "Ensuite, un thé vert de qualité servi ébouillanté, sacrilège sans nom pour quiconque s’intéresse le moindrement à ce breuvage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84130a52-c3fc-361b-91ee-8f8636fc470e",
                                        "entry_id": "bc50df90-110c-3042-b4b4-1e95f21c6118",
                                        "glosses": [
                                            "Personne commettant un tel méfait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4dc65de-28e9-4b7a-984b-ccfe217612ed",
                                                "sense_id": "84130a52-c3fc-361b-91ee-8f8636fc470e",
                                                "text": "C’est toute la différence entre un sacrilège, comme Don Juan, et un désacralisateur, comme Nietzsche. Le libertin n’est pas un briseur d’idoles, puisque la sacralité et la morale religieuse sont les conditions mêmes de son art de la transgression."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sacrilège",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50a7c6b1-16e9-3bfe-acdb-8f18384fdbd9",
                                        "entry_id": "ddd630c1-d5e0-3e7d-9334-3ba688d0d770",
                                        "glosses": [
                                            "Exclamation servant à dénoncer un acte considéré comme sacrilège."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f9e8c0a-b5d9-42c5-8490-3950bae08363",
                                                "sense_id": "50a7c6b1-16e9-3bfe-acdb-8f18384fdbd9",
                                                "text": "Il a craché sur le totem ! Sacrilège !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f60b869f-fd84-3e98-9798-7eb9c89fdc12",
                                        "entry_id": "ddd630c1-d5e0-3e7d-9334-3ba688d0d770",
                                        "glosses": [
                                            "ou Exclamation servant à dénoncer un acte qu’un autre groupe ou une autre personne considérerait comme sacrilège."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7e82db1-c61c-4791-af68-ca70d85c48cf",
                                                "sense_id": "f60b869f-fd84-3e98-9798-7eb9c89fdc12",
                                                "text": "Selon la tradition Porsche, les modifications esthétiques sont mineures, mais les Porschistes vous diront le contraire; c’est que la 997 renoue avec les traditionnels phares ronds, qui avaient été délaissés — sacrilège! — sur la 996, au profit de phares identiques à ceux de la Boxster. Il n’en fallait pas plus pour déclencher une véritable tempête…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
