                    {
                        "translation_id": "b19c1d02-d6b7-472d-8367-49b057a14d9f",
                        "source_entry_id": "50f76216-cbe6-36c1-92a8-e4640d3662c3",
                        "source_sense_id": "8d8618a4-cc27-387e-843b-b8410aa6e501",
