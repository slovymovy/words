                                "target_senses": [
                                    {
                                        "sense_id": "ef824531-8302-3478-9f2a-d7fa7d10829e",
                                        "entry_id": "fc12425e-6ae7-32d1-906b-5bc95f99452a",
                                        "glosses": [
                                            "Énoncer une à une les parties d’un tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "701eafc6-9980-444a-8895-2e59447a2bf6",
                                                "sense_id": "ef824531-8302-3478-9f2a-d7fa7d10829e",
                                                "text": "Durant ces quelques minutes de préparation, le maquignon a le soin d’énumérer toutes ses qualités : son ardeur, si l’on veut une bête fringante ; sa docilité, si l’on désire un cheval de dame ou de famille."
                                            },
                                            {
                                                "example_id": "066671b2-b9bc-4d11-8e50-18fb3b43582b",
                                                "sense_id": "ef824531-8302-3478-9f2a-d7fa7d10829e",
                                                "text": "Je ne m'aventurerai pas à énumérer les pantagruéliques quantités de légumes de toute sorte tirées de cette terre chargée de goémon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fcedcc9-b580-4c04-983a-4a830a839104",
                        "source_entry_id": "fc3c8a98-fea7-3636-897d-df5eb2ff7a3e",
