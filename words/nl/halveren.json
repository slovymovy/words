{
    "word_family": [
        "half",
        "helft",
        "halvering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44cbb199-8232-3cde-bdf3-852450c4eae8",
                    "sense_definition": "tot de helft terugbrengen in aantal, waarde of omvang",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vermindering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechtbank <w>halveert</w> de geëiste straf na het horen van de getuigen.",
                            "target_lang_translations": {
                                "en": "The court <w>halves</w> the demanded sentence after hearing the witnesses."
                            }
                        },
                        {
                            "text": "De supermarkt besloot de prijs van de appels te <w>halveren</w> om de verkoop te stimuleren.",
                            "target_lang_translations": {
                                "en": "The supermarket decided to <w>halve</w> the price of the apples to stimulate sales."
                            }
                        }
                    ],
                    "synonyms": [
                        "verminderen",
                        "reduceren"
                    ],
                    "antonyms": [
                        "verdubbelen"
                    ],
                    "common_phrases": [
                        "de prijs halveren",
                        "de straf halveren",
                        "de uitstoot halveren"
                    ],
                    "target_lang_definitions": {
                        "en": "to reduce something to half its original number, value, or size"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "halve",
                                "target_lang_sense_clarification": "to reduce by 50%"
                            },
                            {
                                "target_lang_word": "cut in half",
                                "target_lang_sense_clarification": "to reduce a quantity or value by half"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8d30fbf-0595-30ac-a73c-9e246fba4c3c",
                    "sense_definition": "iets in twee gelijke delen verdelen, vaak door te snijden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de appel eerst <w>halveren</w> voordat je de pitjes eruit haalt.",
                            "target_lang_translations": {
                                "en": "You must first <w>halve</w> the apple before removing the seeds."
                            }
                        },
                        {
                            "text": "Kun je deze cake voor mij <w>halveren</w> zodat we allebei een stuk hebben?",
                            "target_lang_translations": {
                                "en": "Can you <w>cut</w> this cake <w>in half</w> for me so we both have a piece?"
                            }
                        }
                    ],
                    "synonyms": [
                        "doorsnijden",
                        "verdelen"
                    ],
                    "common_phrases": [
                        "een appel halveren",
                        "in de lengte halveren"
                    ],
                    "target_lang_definitions": {
                        "en": "to divide something into two equal parts, often by cutting"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "halve",
                                "target_lang_sense_clarification": "to divide into two equal parts"
                            },
                            {
                                "target_lang_word": "cut in half",
                                "target_lang_sense_clarification": "to physically split into two pieces"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}