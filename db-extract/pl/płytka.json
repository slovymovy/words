                        ]
                    },
                    {
                        "translation_id": "d49e56f1-e6b1-4fe6-af58-afcf0c9c78a8",
                        "source_entry_id": "f66646ae-4758-3b58-8234-20748005b775",
                        "source_sense_id": "e1633fe2-6a1f-3d9b-b2e8-8e5cd33ca082",
