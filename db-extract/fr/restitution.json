                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49712317-e5c6-4870-8f48-581db489e5b8",
                                                "sense_id": "b57e22e4-5df7-3306-beeb-54d5ef29b8ea",
                                                "text": "Der Hamelner Torwart fing die Rückgabe sicher."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1758f320-8631-3e21-a236-1b2319477f0e",
