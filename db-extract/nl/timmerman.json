                "senses": [
                    {
                        "sense_id": "1fe7b5d6-18d1-32eb-8e59-1d2aaa8702fe",
                        "entry_id": "a001ff8f-4cdf-3cc3-ae0a-da62233aaef1",
                        "glosses": [
                            "iemand die zich beroepsmatig vooral met houtbewerking bezighoudt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "6c8c468a-4e7e-4131-9f2f-54204d873fae",
                                "sense_id": "1fe7b5d6-18d1-32eb-8e59-1d2aaa8702fe",
                                "text": "De timmerman ging na veertig jaar met pensioen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "888dee66-3a64-4a40-817b-618d42cfe068",
                        "source_entry_id": "a001ff8f-4cdf-3cc3-ae0a-da62233aaef1",
                        "source_sense_id": "1fe7b5d6-18d1-32eb-8e59-1d2aaa8702fe",
                        "source_sense_description": "iemand die zich beroepsmatig vooral met houtbewerking bezighoudt",
                        "target_lang_word": "Zimmermann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zimmermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d8b1e9-e2b0-3176-ba82-69d49f2e8cf2",
                                        "entry_id": "ce515992-31c6-3d9d-9149-a35863c97ac7",
                                        "glosses": [
                                            "Bauhandwerker, der mit Holz arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2a78173-75c5-4348-aa05-b09c9f4983c0",
                                                "sense_id": "a6d8b1e9-e2b0-3176-ba82-69d49f2e8cf2",
                                                "text": "„Die Vorstellung von Jesus als Zimmermann hat sich erst in unseren Breiten durchgesetzt.“"
                                            },
                                            {
                                                "example_id": "35d3d729-a1e0-4aab-8b65-4fc4de49ae6e",
                                                "sense_id": "a6d8b1e9-e2b0-3176-ba82-69d49f2e8cf2",
                                                "text": "„Dachdecker, Zimmermänner und alle sonstigen Berufsgruppen, die sich auf Baustellen herumtummeln, sollten sich mit den Fachbegriffen rund ums Dach auskennen.“"
                                            },
                                            {
                                                "example_id": "f25eff56-6493-4321-9f54-a66c59e8d8aa",
                                                "sense_id": "a6d8b1e9-e2b0-3176-ba82-69d49f2e8cf2",
                                                "text": "„Er half den Zimmermännern, Balken zu sägen und viereckig mit der Axt zurechtzuhauen, oder den Maurern, die Steine zu zerschlagen, den Putz vorzubereiten, und Gerüste zu bauen.“"
                                            },
                                            {
                                                "example_id": "99a93e70-0b4e-448c-9072-7655013e1b91",
                                                "sense_id": "a6d8b1e9-e2b0-3176-ba82-69d49f2e8cf2",
                                                "text": "„Zimmerplatz ist eine Stelle, an der Zimmermänner Holz für den Hausbau bearbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zimmermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0dd17ad-14f3-34c7-903c-0ed90ced5eba",
                                        "entry_id": "11284fb0-ba22-3d87-8973-1e7594f989be",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31e4f795-9a10-4a28-b64c-38022b5de39a",
                                                "sense_id": "b0dd17ad-14f3-34c7-903c-0ed90ced5eba",
                                                "text": "Frau Zimmermann ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "3db0f29e-ef53-4034-9d98-6d222c872468",
                                                "sense_id": "b0dd17ad-14f3-34c7-903c-0ed90ced5eba",
                                                "text": "Herr Zimmermann wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "529323ca-6c12-4a5c-8c66-883c581fb0a5",
                                                "sense_id": "b0dd17ad-14f3-34c7-903c-0ed90ced5eba",
                                                "text": "Die Zimmermanns fliegen heute nach Liverpool."
                                            },
                                            {
                                                "example_id": "d63024cd-76c1-46a5-9e0b-1529725764ad",
                                                "sense_id": "b0dd17ad-14f3-34c7-903c-0ed90ced5eba",
                                                "text": "Der Zimmermann trägt nie die Pullover, die die Zimmermann ihm strickt."
                                            },
                                            {
                                                "example_id": "d1f28b71-bf58-4dbc-8af0-e4a1d1a12f8e",
                                                "sense_id": "b0dd17ad-14f3-34c7-903c-0ed90ced5eba",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zimmermann kommt, geht der Herr Zimmermann.“"
                                            },
                                            {
                                                "example_id": "5b5b3198-5088-405a-89ff-b0d22bdae6e0",
                                                "sense_id": "b0dd17ad-14f3-34c7-903c-0ed90ced5eba",
                                                "text": "Zimmermann kommt und geht."
                                            },
                                            {
                                                "example_id": "83103a8f-c5f0-46c8-84ee-449c92393086",
                                                "sense_id": "b0dd17ad-14f3-34c7-903c-0ed90ced5eba",
                                                "text": "Zimmermanns kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8470caf9-535a-4a7b-9698-ca98ad59a98e",
                        "source_entry_id": "a001ff8f-4cdf-3cc3-ae0a-da62233aaef1",
