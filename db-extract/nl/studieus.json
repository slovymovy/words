                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5083823-da6f-4b9e-909c-429a037d8ec8",
                                "sense_id": "2b676360-b180-320e-af5c-299389ee6411",
                                "text": "Er werden pillen van biografieën aangeleverd die mooi en studieus waren, en gewetensvol in bronnenonderzoek, maar die in de opbouw en stijl echt niet literair genoemd konden worden."
                            },
                            {
                                "example_id": "76df9685-0f83-4365-b466-9bc517e62220",
                                "sense_id": "2b676360-b180-320e-af5c-299389ee6411",
                                "text": "Evenals Hans Wansink overigens, die er studieus als hij is, wel een doorwrochte dissertatie aan gewijd heeft."
                            },
                            {
                                "example_id": "c512b190-5cca-4566-a342-820921056567",
                                "sense_id": "2b676360-b180-320e-af5c-299389ee6411",
                                "text": "„De lezer kreeg (in de voorgaande hoofdstukken) een vloed van details over zich uitgestort, want alleen op die manier kon aan een studieus leven met al zijn twijfels, vijandschappen en idealen reliëf gegeven worden.”"
                            }
                        ]
                    },
