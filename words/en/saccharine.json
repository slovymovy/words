                            }
                        },
                        {
                            "text": "He avoided <w>saccharine</w> drinks to maintain a healthier diet.",
                            "target_lang_translations": {
                                "ru": "Он избегал <w>сладких</w> напитков, чтобы придерживаться более здорового питания."
                            }
                        }
                    ],
