                        "entry_id": "0a1b39e6-8947-3823-b1c5-2f316e608ba8",
                        "glosses": [
                            "short for öffentliches Verkehrsmittel (“public means of transportation”)"
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
