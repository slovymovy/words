                "translations": [
                    {
                        "translation_id": "b994bec0-c071-494e-b33f-1a80a9b83430",
                        "source_entry_id": "e3808c2f-a506-3e5a-9a63-1e67a13da0d4",
                        "source_sense_id": "59c2c4f3-e9f7-3b83-a34d-7e5a9f7c87fa",
                        "source_sense_description": "Zoologie: Albatros",
                        "target_lang_word": "Albatros",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Albatros",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb2968c5-05dc-3794-b8a4-b71c880821ff",
                                        "entry_id": "5e0f5713-800b-31df-87de-93701adb1235",
                                        "glosses": [
                                            "Vogel aus der Familie Diomedeidae (Albatrosse)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67ee5fd5-2f0e-431e-a9b3-2abaff214afd",
                                                "sense_id": "fb2968c5-05dc-3794-b8a4-b71c880821ff",
                                                "text": "Der Albatros ist der König der Küsten und Meere, und sein eleganter Flugstil ist beeindruckend."
                                            },
                                            {
                                                "example_id": "dc623631-c10e-47a2-808f-f9a32ac67e4b",
                                                "sense_id": "fb2968c5-05dc-3794-b8a4-b71c880821ff",
                                                "text": "„Schon das tierische ‚Begrüßungskomitee‘ wird Darwin verwundert haben: Albatrosse werden am 15. September 1835 wohl die Ersten gewesen sein, die die nahende ‚HMS Beagle‘ inspizierten. Höchst ungewöhnlich, denn Albatrosse halten sich von den Tropen eigentlich fern – in warmen Gewässern finden sie nicht genug zu fressen.“"
                                            },
                                            {
                                                "example_id": "56b9004d-7cde-4e4d-832f-a07428b97b0a",
                                                "sense_id": "fb2968c5-05dc-3794-b8a4-b71c880821ff",
                                                "text": "„Der Albatros ist ein besonders schönes und ja romantisches Beispiel für die Vogelliebe, weil da beide Partner eigentlich die ganze Zeit alleine über die Weiten des Ozeans schweben, aber sich dann doch immer wieder auf einer kleinen Insel, in dem Fall der Wanderalbatrosse im tiefsten Südatlantik, treffen, um sich zu paaren und ihre Jungen aufzuziehen.“"
                                            },
                                            {
                                                "example_id": "e46fb5ba-847f-466d-8d2c-7c50915e5c70",
                                                "sense_id": "fb2968c5-05dc-3794-b8a4-b71c880821ff",
                                                "text": "„Cook drehte nach Westen ab und hielt diesen Kurs ungefähr einen Monat lang, wobei außer Seehunden und Albatrossen wenig gesichtet wurde.“"
                                            },
                                            {
                                                "example_id": "16187d5c-2c89-41ea-b206-5d2eb6c8038d",
                                                "sense_id": "fb2968c5-05dc-3794-b8a4-b71c880821ff",
                                                "text": "„Einige Wildenten, Albatrosse und Möwen flogen über die Köpfe der Spaziergänger hinweg, aber im Flug traf sie kein Pfeil, und der Seemann begann wieder um Gewehre zu betteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6d1f2084-5417-37ad-9bbe-0917f010336b",
                                        "entry_id": "5e0f5713-800b-31df-87de-93701adb1235",
                                        "glosses": [
                                            "drei Schläge weniger als das Par an einem Loch"
                                        ],
                                        "tags": [
                                            "Golf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecb8febb-a10c-462f-a434-5c386c478a19",
                                                "sense_id": "6d1f2084-5417-37ad-9bbe-0917f010336b",
                                                "text": "Fast hätte er einen Albatros geschlagen!"
                                            },
                                            {
                                                "example_id": "4b2041de-17d6-4a0d-8343-995ed5e4288e",
                                                "sense_id": "6d1f2084-5417-37ad-9bbe-0917f010336b",
                                                "text": "„Dem Australier gelang am 6. Loch der Schlag des Tages, als er das 341 Meter lange Par 5 mit einem Albatros (3 Schläge unter Par) bewältigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Albatros",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9be1be29-af61-37bb-a1e9-865b36535516",
                                        "entry_id": "4e3922b2-0777-38c3-8994-7d2be65137c9",
                                        "glosses": [
