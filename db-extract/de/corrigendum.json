                "senses": [
                    {
                        "sense_id": "5ca5851f-5703-3dc8-8536-3e4f75694fec",
                        "entry_id": "4318ae41-d631-3977-a18e-13cf48afa1c6",
                        "glosses": [
                            "Druckfehlerverzeichnis oder Korrekturverzeichnis in wissenschaftlichen Veröffentlichungen, etwas zu Verbesserndes"
                        ],
                        "tags": [
                            "literally",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "2f237e66-e674-43cf-b3da-0aed42d0b641",
                                "sense_id": "5ca5851f-5703-3dc8-8536-3e4f75694fec",
                                "text": "„Er befindet sich in der Abstimmungsphase (Committee Draft for final voting CDV) und wird voraussichtlich in IEC 1131-3 veröffentlicht. Corrigendum ‚Proposed Technical Corrigendum to IEC 1131-3‘: Das Corrigendum verbessert Fehler der Norm, die nach deren Verabschiedung festgestellt wurden (verabschiedet).“"
                            },
                            {
                                "example_id": "1f30cfb1-3665-4aca-a976-4c4814147996",
                                "sense_id": "5ca5851f-5703-3dc8-8536-3e4f75694fec",
                                "text": "„Heinz Scheibles diesbezügliches Corrigendum zu seinem erwähnten Aufsatz von 1968, der 1996 nachgedruckt wurde, ist ihm entgangen.“"
                            },
                            {
                                "example_id": "cfdb0351-af86-4213-9d61-05250b8b59d0",
                                "sense_id": "5ca5851f-5703-3dc8-8536-3e4f75694fec",
                                "text": "„Das Corrigendum im Klaggesang ist auch sogleich berichtigt worden.“"
                            },
                            {
                                "example_id": "42293df9-4086-453f-8a62-975f14961f09",
                                "sense_id": "5ca5851f-5703-3dc8-8536-3e4f75694fec",
                                "text": "„Sie können auch in der Datenbank ‚Finanzierungen‘ suchen, die Aufrufe zur Vorschlagseinreichung und Ausschreibungen enthält, sowie weiterführende Informationen zu Ausschreibungen und deren Corrigenda.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
