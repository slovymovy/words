                        "examples": [
                            {
                                "example_id": "8021c9de-156d-4075-aa76-4ec8ce70a4ca",
                                "sense_id": "289c44c7-d978-3257-b235-0259a5b9195a",
                                "text": "Des vélocipédistes ont quitté Paris dimanche matin pour se rendre à Trouville et en sont revenus hier dans la journée. A Saint-Germain, leur surprise a été grande en voyant venir à leur rencontre une vélocewoman, mademoiselle Régina Ressient. Cette jeune fille, jusqu’à Paris, a fait escorte aux bicyclistes retour de Trouville. Elle se propose de prendre part à la prochaine course importante."
                            }
                        ]
