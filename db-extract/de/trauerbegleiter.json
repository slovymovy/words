                    {
                        "sense_id": "8245657f-830c-3859-8a19-6e8da6a56777",
                        "entry_id": "0b501e96-4f70-39f8-8b60-1640ee82e95c",
                        "glosses": [
                            "jemand, der Personen, die um einen verstorbenen Mitmenschen trauern, beisteht und seelisch unterstützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e5de870-8a1c-4a0a-8254-04b66c866f86",
                                "sense_id": "8245657f-830c-3859-8a19-6e8da6a56777",
                                "text": "„Pastor Michael Geisler ist als Trauerredner und Trauerbegleiter seit mehr als 35 Jahren tätig.“"
                            },
                            {
                                "example_id": "4eb17211-03f5-4ca0-8580-312ce93a3708",
                                "sense_id": "8245657f-830c-3859-8a19-6e8da6a56777",
                                "text": "„Manche Trauerbegleiter bieten dieses Erstgespräch übrigens kostenlos an oder zu einem reduzierten Kostensatz.“"
                            },
                            {
                                "example_id": "f652f093-8528-42fc-9ed3-e1dc30ed0835",
                                "sense_id": "8245657f-830c-3859-8a19-6e8da6a56777",
                                "text": "„Dennoch unterscheidet sich die Herangehensweise von Männern, mit ihrer Trauer umzugehen und den Schmerz zu bewältigen, deutlich von der weiblichen, so der erfahrene Trauerbegleiter Thomas Achenbach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
