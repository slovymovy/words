                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2337ffee-e803-4c59-804c-c462f2b4bd59",
                                "sense_id": "0bf212e7-2995-3435-ae5b-10833d476ea9",
                                "text": "„Dann war der Trompeter allein zu einer Europatournee aufgebrochen, und als er zurückkam, war ihm sofort klar, dass Trane noch immer an der Nadel hing.“"
                            },
                            {
                                "example_id": "c95e347b-cdcf-45c6-9635-bb5a70db967e",
                                "sense_id": "0bf212e7-2995-3435-ae5b-10833d476ea9",
                                "text": "„Der amerikanische Sänger und Songwriter Randy Newman (74) hat seine Europatournee wegen Knieproblemen abgesagt.“"
                            },
                            {
                                "example_id": "5eb4448d-c1bf-4420-be1b-a2153cd066aa",
                                "sense_id": "0bf212e7-2995-3435-ae5b-10833d476ea9",
                                "text": "„Muhammad Ali, der alle überragende und überstrahlende Ausnahmeboxer, war seit zwei Jahren Weltmeister und auf Europatournee.“"
                            }
                        ],
