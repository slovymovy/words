                        "sense_id": "bdc0241a-ffdb-36c2-bd6f-c7cc6008c9a4",
                        "entry_id": "65cbcd3c-a818-3436-89c4-654225a75c09",
                        "glosses": [
                            "Stamm von Beduinen"
