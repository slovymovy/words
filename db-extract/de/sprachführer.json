                                        "entry_id": "dff65dbc-dd6e-3a19-b971-13cb87a9e135",
                                        "glosses": [
                                            "A usually pocket-sized book consisting of everyday expressions and vocabulary in two languages and intended for travellers who wish to communicate with locals while in other countries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2a81959-d30f-4dd2-a316-b0eb981de072",
                                                "sense_id": "423f4c5f-23e1-31dc-aed2-8e4c0b6b5107",
                                                "text": "He knows, ‘Hello’ in eighteen languages / ‘I love you’ in only one / By the time he's got his phrasebook / The chance is usually gone"
                                            }
                                        ]
                                    }
