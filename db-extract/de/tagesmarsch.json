                ],
                "senses": [
                    {
                        "sense_id": "629330a2-cb40-3427-8703-71968931c598",
                        "entry_id": "c1b54019-f682-3f11-8603-baef3524032d",
                        "glosses": [
                            "Marsch, der einen Tag dauert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6e80029-e943-4ec1-b7eb-b2b136104eb0",
                                "sense_id": "629330a2-cb40-3427-8703-71968931c598",
                                "text": "„Dann führte Cäsar seine Legionen in sieben Tagesmärschen ins Elsass.“"
                            },
                            {
                                "example_id": "e1ca6a9b-2d80-4525-86c5-cbf045ea081c",
                                "sense_id": "629330a2-cb40-3427-8703-71968931c598",
                                "text": "„Wir marschierten immer als ständige Nachhut eines Tagesmarsch vor den uns folgenden Feinden.“"
                            },
                            {
                                "example_id": "e3e04250-7073-47e9-9a04-b0d0145a319a",
                                "sense_id": "629330a2-cb40-3427-8703-71968931c598",
                                "text": "„Noch viele Männer verbluten, und viele Babys sterben im Gras, bis der Trupp nach zehn Tagesmärschen den großen Fluss Kongo erreicht.“"
                            },
                            {
                                "example_id": "016a7fae-09bd-492e-833a-f3d146009eab",
                                "sense_id": "629330a2-cb40-3427-8703-71968931c598",
                                "text": "„An diesem Abend erreichen wir Zackenzin, noch einen Tagesmarsch von der vielleicht rettenden Seenenge entfernt.“"
                            }
                        ],
