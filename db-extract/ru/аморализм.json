                "senses": [
                    {
                        "sense_id": "0e3afc6c-348a-3a6c-8dbf-ca273e6b7aae",
                        "entry_id": "2180f962-4851-3b2e-8ebd-9d54f7868bc6",
                        "glosses": [
                            "книжн. отрицание морали, возведение безнравственности в принцип"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cd5de29-c748-4457-8dd8-26ef0b9a8175",
                        "source_entry_id": "2180f962-4851-3b2e-8ebd-9d54f7868bc6",
                        "source_sense_id": "0e3afc6c-348a-3a6c-8dbf-ca273e6b7aae",
                        "target_lang_word": "amoralismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "64df4b94-f704-4fd5-ac74-a875db9de887",
                        "source_entry_id": "2180f962-4851-3b2e-8ebd-9d54f7868bc6",
                        "source_sense_id": "0e3afc6c-348a-3a6c-8dbf-ca273e6b7aae",
                        "target_lang_word": "amoralisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amoralisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d2bd984-e046-3d3e-98d9-d85aaa34dd9f",
                                        "entry_id": "85a6d500-0fef-36d4-8829-2a54a8d68849",
                                        "glosses": [
                                            "Ignorance (volontaire ou non) de la morale en vigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "434c0816-26e1-4016-9745-d7485e3c9cde",
                                                "sense_id": "2d2bd984-e046-3d3e-98d9-d85aaa34dd9f",
                                                "text": "Son amoralisme dans les affaires de l’amour et du pouvoir —inextricablement enchevêtrées au long de sa carrière— ne l’empêchait pas d’avoir, à la différence de plusieurs de ses rivaux, une conception sérieuse et personnelle des tâches politiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c59cdbe8-e4f6-30d5-bc4f-807e4b951a60",
                                        "entry_id": "85a6d500-0fef-36d4-8829-2a54a8d68849",
                                        "glosses": [
                                            "Doctrine selon laquelle il n’existe pas de morale immanente, sinon à titre de croyance, sans fondement objectif et universel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6653b6d6-11a2-4744-ae68-6d9db490a4be",
                                                "sense_id": "c59cdbe8-e4f6-30d5-bc4f-807e4b951a60",
                                                "text": "[…] l’amoralisme, accusant la vertu, sécrète le même pharisaïsme que la vertu accusant le vice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4efd24bd-3fee-4d85-bf9e-37f1cae6d943",
                        "source_entry_id": "2180f962-4851-3b2e-8ebd-9d54f7868bc6",
                        "source_sense_id": "0e3afc6c-348a-3a6c-8dbf-ca273e6b7aae",
                        "target_lang_word": "immoralisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immoralisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35df8d15-b828-3b28-b42c-529beb1cd418",
                                        "entry_id": "238e2927-a3da-3b8b-8db2-3f709d9e5d49",
                                        "glosses": [
                                            "Morale différente ou inverse de la morale courante, et particulièrement de la morale chrétienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6895ea25-b7b8-43ce-a64f-0762066aeebf",
                                                "sense_id": "35df8d15-b828-3b28-b42c-529beb1cd418",
                                                "text": "Nietzsche et l’immoralisme."
                                            },
                                            {
                                                "example_id": "dc27f533-9bf1-473e-a7a9-acc1e558aa03",
                                                "sense_id": "35df8d15-b828-3b28-b42c-529beb1cd418",
                                                "text": "L’immoralisme, le matérialisme scientifique et l'athéisme remplaçant définitivement l'antithéisme des anciens révoltés, ont fait corps, sous l'influence paradoxale de Hegel, avec un mouvement révolutionnaire qui, jusqu'à lui, ne s'était jamais séparé réellement de ses origines morales, évangéliques et idéalistes."
                                            },
                                            {
                                                "example_id": "ab34ebef-4a8b-430a-8c8c-b893640aeeeb",
                                                "sense_id": "35df8d15-b828-3b28-b42c-529beb1cd418",
                                                "text": "L’œuvre la plus célèbre de Barbey d’Aureville est son recueil de nouvelles Les Diaboliques, paru en 1874, dans lesquelles l’insolite et la transgression, plongeant le lecteur dans un univers ambigu, ont valu à leur auteur d’être accusé d’immoralisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bdfbf00-9590-3e59-8c42-2a406292c57a",
                                        "entry_id": "238e2927-a3da-3b8b-8db2-3f709d9e5d49",
                                        "glosses": [
                                            "Remise en cause, mépris de la morale établie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b75285-463a-4564-b676-4627818dc789",
                                                "sense_id": "8bdfbf00-9590-3e59-8c42-2a406292c57a",
                                                "text": "L’immoralisme de Gide."
                                            },
                                            {
                                                "example_id": "ddfa36dc-52f1-4e4c-95b7-4b60cff1705e",
                                                "sense_id": "8bdfbf00-9590-3e59-8c42-2a406292c57a",
                                                "text": "La vie amoureuse de Brentano exprime toute la complexité de cette âme faite de hardiesse et de crainte, d’immoralisme et de scrupule, de faiblesse et de brusque décision."
                                            },
                                            {
                                                "example_id": "2ff5c376-b749-40c6-a431-a008a4c795cd",
                                                "sense_id": "8bdfbf00-9590-3e59-8c42-2a406292c57a",
                                                "text": "Et toutes les théories de la liberté, de Gide à Sartre, ne sont que des immoralismes conçus par des célibataires irresponsables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e8da7e2-feee-32ab-a6c4-be1f7e6a1642",
                                        "entry_id": "238e2927-a3da-3b8b-8db2-3f709d9e5d49",
                                        "glosses": [
                                            "Scepticisme quant à l’influence de la morale sur le comportement des individus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
