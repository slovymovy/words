                                        "sense_id": "efb1e2c1-f3a9-3bd5-b92b-1a3b4689d2c0",
                                        "entry_id": "0112df76-3e82-3a75-930f-41603956e08e",
                                        "glosses": [
                                            "Obvious; blatant."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ae3284-1c72-4087-bddc-5dc53da83f76",
                                                "sense_id": "efb1e2c1-f3a9-3bd5-b92b-1a3b4689d2c0",
                                                "text": "I've been at home all day / Cloning £50 notes, this is sick / But it's a bit bait / Cause all the serial numbers are the same / So I can't spend them in the same place"
                                            }
