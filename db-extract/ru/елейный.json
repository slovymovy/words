                        "form": "еле́йна"
                    },
                    {
                        "form_id": "2832e75d-2ff5-4565-adf0-d4bd6aa0f3e8",
                        "entry_id": "ce62cb5e-24a2-3a7b-9f44-142fa71be4ad",
