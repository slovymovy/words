                        "glosses": [
                            "Dépenser en prenant sur son épargne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef1024e6-632f-4cd6-bcb2-55842cbed64f",
                                "sense_id": "caec4d84-a287-3d2c-bc41-9975651f563d",
                                "text": "Ils seront donc obligés de désépargner (l’épargne est « négative ») pour compléter leur revenu disponible."
                            },
                            {
                                "example_id": "c1bae79a-ebcf-4864-9ee4-e9a769eddc57",
                                "sense_id": "caec4d84-a287-3d2c-bc41-9975651f563d",
                                "text": "Or, si les déposants atteignent une plus grande satisfaction en ayant une consommation relativement stable au cours du temps, ils doivent désépargner."
                            }
                        ]
                    }
