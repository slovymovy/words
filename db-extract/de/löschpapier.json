                        "source_sense_id": "a7f98249-88c5-33f5-a979-c6b33278166b",
                        "source_sense_description": "ungeleimtes Papier zum Aufsaugen überschüssiger Tinte oder anderer Flüssigkeiten",
                        "target_lang_word": "papier buvard",
                        "target_lang_code": "fr",
