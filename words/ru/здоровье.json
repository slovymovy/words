{
    "word_family": [
        "здоровый",
        "здороветь",
        "оздоровить",
        "оздоровление",
        "здравие"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff4cfe2d-f1e2-3f51-a551-d609d94de2d9",
                    "sense_definition": "Состояние живого организма, при котором правильно функционируют все его органы; отсутствие болезни.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "физическое состояние",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Правильное питание очень важно для <w>здоровья</w> человека.",
                            "target_lang_translations": {
                                "en": "Proper nutrition is very important for human <w>health</w>."
                            }
                        },
                        {
                            "text": "Вредные привычки сильно портят <w>здоровье</w>.",
                            "target_lang_translations": {
                                "en": "Bad habits severely damage one's <w>health</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "здравие"
                    ],
                    "antonyms": [
                        "нездоровье",
                        "недомогание"
                    ],
                    "common_phrases": [
                        "крепкое здоровье",
                        "поправить здоровье"
                    ],
                    "target_lang_definitions": {
                        "en": "The state of a living organism in which all its organs function correctly; the absence of disease."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "health",
                                "target_lang_sense_clarification": "The general state of being free from illness or injury."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d861fdf-2453-3a06-8a97-247078e631f8",
                    "sense_definition": "Общее самочувствие человека.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "физическое состояние",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач спросил меня про моё <w>здоровье</w>.",
                            "target_lang_translations": {
                                "en": "The doctor asked me about my <w>health</w>."
                            }
                        },
                        {
                            "text": "После отпуска моё <w>здоровье</w> заметно улучшилось.",
                            "target_lang_translations": {
                                "en": "After the vacation, my <w>health</w> improved noticeably."
                            }
                        }
                    ],
                    "antonyms": [
                        "недомогание"
                    ],
                    "target_lang_definitions": {
                        "en": "A person's general physical or mental condition."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "health",
                                "target_lang_sense_clarification": "Refers to one's current physical condition or well-being."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d04a9d38-8d56-3068-8c44-69533324511d",
                    "sense_definition": "Пожелание благополучия при употреблении напитков или в качестве вежливого ответа.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "этикет",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все подняли бокалы за <w>здоровье</w> именинника.",
                            "target_lang_translations": {
                                "en": "Everyone raised their glasses to the <w>health</w> of the birthday person."
                            }
                        },
                        {
                            "text": "Спасибо за помощь, на <w>здоровье</w>!",
                            "target_lang_translations": {
                                "en": "Thanks for the help, <w>you're welcome</w>!"
                            }
                        }
                    ],
                    "synonyms": [
                        "здравие"
                    ],
                    "common_phrases": [
                        "за ваше здоровье",
                        "на здоровье"
                    ],
                    "target_lang_definitions": {
                        "en": "A wish for well-being when drinking or as a polite response."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "health",
                                "target_lang_sense_clarification": "Used in toasts (e.g., 'to your health')."
                            },
                            {
                                "target_lang_word": "you're welcome",
                                "target_lang_sense_clarification": "Used as a polite response to 'thank you' (idiomatic equivalent of 'на здоровье')."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6841e1c-49c8-3ed2-8a88-870438032bd4",
                    "sense_definition": "Духовное или социальное благополучие, отсутствие внутренней порчи.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Общественное <w>здоровье</w> зависит от моральных ценностей граждан.",
                            "target_lang_translations": {
                                "en": "Public <w>health</w> depends on the moral values of the citizens."
                            }
                        },
                        {
                            "text": "Важно поддерживать <w>здоровье</w> нашей культуры.",
                            "target_lang_translations": {
                                "en": "It is important to maintain the <w>health</w> of our culture."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Spiritual or social well-being, the absence of internal corruption."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "health",
                                "target_lang_sense_clarification": "Used metaphorically to describe the stability or well-being of a system or society."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4baefb3-1033-389c-91fc-076ad56ab5f6",
                    "sense_definition": "Пожелания здоровья, произносимые во время застолья.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "этикет",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Гости по очереди произносили торжественные <w>здоровья</w> в честь хозяина дома.",
                            "target_lang_translations": {
                                "en": "The guests took turns making formal <w>toasts</w> in honor of the host."
                            }
                        },
                        {
                            "text": "Старинные <w>здоровья</w> часто звучали очень витиевато и длинно.",
                            "target_lang_translations": {
                                "en": "Old-fashioned <w>toasts</w> often sounded very flowery and long."
                            }
                        }
                    ],
                    "synonyms": [
                        "здравие"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Устаревшее употребление во множественном числе."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Wishes of health spoken during a feast or celebration."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "toasts",
                                "target_lang_sense_clarification": "Formal expressions of good wishes made while drinking."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}