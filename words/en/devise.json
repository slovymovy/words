{
    "word_family": [
        "device",
        "deviser",
        "devisable",
        "devisal"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "019affc5-1110-35d5-9d8e-735054a198a6",
                    "sense_definition": "To plan or invent a complex system, process, or machine by using creative thought.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers had to <w>devise</w> a new method to cool the engine more efficiently.",
                            "target_lang_translations": {
                                "ru": "Инженерам пришлось <w>разработать</w> новый метод более эффективного охлаждения двигателя.",
                                "cs": "Inženýři museli <w>navrhnout</w> novou metodu, jak efektivněji chladit motor."
                            }
                        },
                        {
                            "text": "They managed to <w>devise</w> a scheme that allowed them to bypass the security system.",
                            "target_lang_translations": {
                                "ru": "Им удалось <w>придумать</w> схему, которая позволила обойти систему безопасности.",
                                "cs": "Podařilo se jim <w>vymyslet</w> plán, který jim umožnil obejít bezpečnostní systém."
                            }
                        }
                    ],
                    "common_phrases": [
                        "devise a scheme",
                        "devise a strategy",
                        "devise a plan",
                        "devise a method"
                    ],
                    "target_lang_definitions": {
                        "ru": "Планировать или изобретать сложную систему, процесс или механизм, используя творческое мышление.",
                        "cs": "Naplánovat nebo vynalézt složitý systém, proces nebo stroj pomocí kreativního myšlení."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разработать",
                                "target_lang_sense_clarification": "создать детальный план или проект"
                            },
                            {
                                "target_lang_word": "придумать",
                                "target_lang_sense_clarification": "изобрести что-то новое"
                            },
                            {
                                "target_lang_word": "изобрести",
                                "target_lang_sense_clarification": "создать техническое решение"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vymyslet",
                                "target_lang_sense_clarification": "vytvořit něco nového myšlením"
                            },
                            {
                                "target_lang_word": "navrhnout",
                                "target_lang_sense_clarification": "vytvořit technický nebo systémový design"
                            },
                            {
                                "target_lang_word": "vynalézt",
                                "target_lang_sense_clarification": "přijít s novým technickým řešením"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0cb7a1e-08d3-3db5-b346-77458dd17a92",
                    "sense_definition": "To carefully think out or contrive a way to achieve a specific goal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee will <w>devise</w> a solution to the ongoing budget crisis.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>выработает</w> решение текущего бюджетного кризиса.",
                                "cs": "Výbor <w>navrhne</w> řešení probíhající rozpočtové krize."
                            }
                        },
                        {
                            "text": "It is difficult to <w>devise</w> a way to please everyone in the group.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>найти</w> способ угодить всем в группе.",
                                "cs": "Je těžké <w>vymyslet</w> způsob, jak vyhovět všem ve skupině."
                            }
                        }
                    ],
                    "synonyms": [
                        "lay"
                    ],
                    "common_phrases": [
                        "devise a way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно продумать или найти способ достижения конкретной цели.",
                        "cs": "Pečlivě promyslet nebo najít způsob, jak dosáhnout konkrétního cíle."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выработать",
                                "target_lang_sense_clarification": "найти решение или стратегию"
                            },
                            {
                                "target_lang_word": "замыслить",
                                "target_lang_sense_clarification": "задумать план действий"
                            },
                            {
                                "target_lang_word": "продумать",
                                "target_lang_sense_clarification": "детально спланировать"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vymyslet",
                                "target_lang_sense_clarification": "přijít na řešení problému"
                            },
                            {
                                "target_lang_word": "naplánovat",
                                "target_lang_sense_clarification": "připravit postup k dosažení cíle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68f982a7-896f-3c43-b4a4-7e1f53dad3c6",
                    "sense_definition": "To give or transmit real estate or property to someone through a will.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his final testament, he chose to <w>devise</w> the family estate to his eldest daughter.",
                            "target_lang_translations": {
                                "ru": "В своем последнем завещании он решил <w>завещать</w> семейное поместье своей старшей дочери.",
                                "cs": "Ve své poslední vůli se rozhodl <w>odkázat</w> rodinné sídlo své nejstarší dceři."
                            }
                        },
                        {
                            "text": "The lawyer explained how the owner could <w>devise</w> his lands to a charitable trust.",
                            "target_lang_translations": {
                                "ru": "Адвокат объяснил, как владелец может <w>отписать</w> свои земли благотворительному фонду.",
                                "cs": "Právník vysvětlil, jak může majitel <w>odkázat</w> své pozemky charitativnímu fondu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "devise property",
                        "devise by will"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать недвижимость или имущество кому-либо по завещанию.",
                        "cs": "Odkázat nemovitost nebo majetek někomu v závěti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завещать",
                                "target_lang_sense_clarification": "оставить по наследству"
                            },
                            {
                                "target_lang_word": "отписать",
                                "target_lang_sense_clarification": "передать имущество в завещании"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "odkázat",
                                "target_lang_sense_clarification": "přenechat majetek v závěti"
                            },
                            {
                                "target_lang_word": "zanechat",
                                "target_lang_sense_clarification": "přenechat dědictví"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4e7f69c-0e17-3dfb-b397-c43321c36943",
                    "sense_definition": "To imagine, suppose, or guess something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mental_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love you more than you can possibly <w>devise</w> or understand.",
                            "target_lang_translations": {
                                "ru": "Я люблю тебя больше, чем ты можешь <w>вообразить</w> или понять.",
                                "cs": "Miluji tě víc, než si dokážeš <w>představit</w> nebo pochopit."
                            }
                        },
                        {
                            "text": "The poet asked the reader to <w>devise</w> the hidden meaning behind the verses.",
                            "target_lang_translations": {
                                "ru": "Поэт просил читателя <w>постичь</w> скрытый смысл стихов.",
                                "cs": "Básník požádal čtenáře, aby <w>domyslel</w> skrytý význam veršů."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Воображать, предполагать или догадываться о чем-либо (устар.).",
                        "cs": "Představovat si, předpokládat nebo hádat něco (zastarale)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вообразить",
                                "target_lang_sense_clarification": "представить себе"
                            },
                            {
                                "target_lang_word": "постичь",
                                "target_lang_sense_clarification": "понять или догадаться"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "představit si",
                                "target_lang_sense_clarification": "vytvořit si v mysli obraz"
                            },
                            {
                                "target_lang_word": "domyslet",
                                "target_lang_sense_clarification": "doplnit si v mysli"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2496134-4683-3bf8-b314-7af6cc4fdb79",
                    "sense_definition": "A will, or a specific clause within a will, that disposes of real property.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The validity of the <w>devise</w> was challenged in court by the distant relatives.",
                            "target_lang_translations": {
                                "ru": "Законность этого <w>завещательного распоряжения</w> была оспорена в суде дальними родственниками.",
                                "cs": "Platnost tohoto <w>odkazu</w> byla vzdálenými příbuznými napadena u soudu."
                            }
                        },
                        {
                            "text": "According to the terms of the <w>devise</w>, the land was to remain in the family.",
                            "target_lang_translations": {
                                "ru": "Согласно условиям <w>завещания</w>, земля должна была остаться в семье.",
                                "cs": "Podle podmínek <w>odkazu</w> měla půda zůstat v rodině."
                            }
                        }
                    ],
                    "common_phrases": [
                        "executory devise"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Завещание или конкретный пункт в завещании, распоряжающийся недвижимым имуществом.",
                        "cs": "Závěť nebo konkrétní ustanovení v závěti, které nakládá s nemovitým majetkem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завещательный отказ",
                                "target_lang_sense_clarification": "юридическое распоряжение недвижимостью"
                            },
                            {
                                "target_lang_word": "завещание",
                                "target_lang_sense_clarification": "документ о наследовании"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "odkaz",
                                "target_lang_sense_clarification": "majetek určený v závěti"
                            },
                            {
                                "target_lang_word": "závěť",
                                "target_lang_sense_clarification": "právní dokument o dědictví"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bc430f5-b88f-3803-95d9-729816790538",
                    "sense_definition": "The actual real estate or property that is left to someone in a will.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She inherited a substantial <w>devise</w> consisting of several acres of farmland.",
                            "target_lang_translations": {
                                "ru": "Она получила значительное <w>наследство</w>, состоящее из нескольких акров сельскохозяйственных угодий.",
                                "cs": "Zdědila značný <w>majetek</w> sestávající z několika akrů zemědělské půdy."
                            }
                        },
                        {
                            "text": "The <w>devise</w> was subject to several taxes before it could be transferred.",
                            "target_lang_translations": {
                                "ru": "Это <w>завещанное имущество</w> облагалось несколькими налогами перед передачей.",
                                "cs": "Tento <w>odkaz</w> podléhal několika daním, než mohl být převeden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Недвижимость или имущество, оставленное кому-либо по завещанию.",
                        "cs": "Samotná nemovitost nebo majetek, který je někomu odkázán v závěti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследство",
                                "target_lang_sense_clarification": "переданное имущество"
                            },
                            {
                                "target_lang_word": "объект завещания",
                                "target_lang_sense_clarification": "конкретное имущество в завещании"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "dědictví",
                                "target_lang_sense_clarification": "majetek získaný po smrti zůstavitele"
                            },
                            {
                                "target_lang_word": "odkaz",
                                "target_lang_sense_clarification": "konkrétní věc určená v závěti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4661a7e-e5ad-3bd3-a8f5-94371eae445d",
                    "sense_definition": "The act of designing or the result of a particular design or plan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt trapped in a situation of his own <w>devise</w> and could see no way out.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя в ловушке ситуации, созданной по его собственному <w>замыслу</w>, и не видел выхода.",
                                "cs": "Cítil se v pasti situace, kterou si sám <w>vymyslel</w>, a neviděl žádné východisko."
                            }
                        },
                        {
                            "text": "The intricate <w>devise</w> of the trap ensured that no one could escape.",
                            "target_lang_translations": {
                                "ru": "Сложная <w>конструкция</w> ловушки гарантировала, что никто не сможет сбежать.",
                                "cs": "Složitá <w>konstrukce</w> pasti zajistila, že nikdo nemohl uniknout."
                            }
                        }
                    ],
                    "common_phrases": [
                        "of one's own devise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт проектирования или результат конкретного дизайна или плана.",
                        "cs": "Akt navrhování nebo výsledek konkrétního návrhu či plánu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замысел",
                                "target_lang_sense_clarification": "план или идея"
                            },
                            {
                                "target_lang_word": "проект",
                                "target_lang_sense_clarification": "результат проектирования"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "záměr",
                                "target_lang_sense_clarification": "plán nebo úmysl"
                            },
                            {
                                "target_lang_word": "návrh",
                                "target_lang_sense_clarification": "výsledek projektování"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}