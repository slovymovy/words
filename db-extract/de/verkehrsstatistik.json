                ],
                "senses": [
                    {
                        "sense_id": "7fb32a37-d916-3a40-91c3-c1846b6982cc",
                        "entry_id": "5e04770a-b902-3659-b40e-3f9b33c3b898",
                        "glosses": [
                            "systematisches zahlenmäßiges Erfassen von Daten und Vorkommnissen im Verkehrsbereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22569249-5741-4c70-9c2d-0455dfcd0a80",
                                "sense_id": "7fb32a37-d916-3a40-91c3-c1846b6982cc",
                                "text": "„Zu den wichtigsten und […] in ihrer Bedeutung ständig wachsenden Aufgaben der Verkehrsstatistik gehört die Beschaffung geeigneter Unterlagen für die Vorbereitung und laufende Überprüfung verkehrspolitischer Maßnahmen.“"
                            },
                            {
                                "example_id": "b4570968-ecf0-4ef4-9be5-b60a292e2b09",
                                "sense_id": "7fb32a37-d916-3a40-91c3-c1846b6982cc",
                                "text": "„Da Kinder im Verkehr, wie die Verkehrsstatistik zeigt, sowohl für sich selbst als auch für die übrigen Verkehrsteilnehmer ein überdurchschnittliches Sicherheitsrisiko darstellen, erhalten die Gefahreneinweisung und das Sicherheitstraining in der Verkehrsausbildung der ersten Jahre einen hohen Rang.“"
                            },
                            {
                                "example_id": "482543f1-e020-4661-8886-4ac8d95cccde",
                                "sense_id": "7fb32a37-d916-3a40-91c3-c1846b6982cc",
                                "text": "„Verkehr in Zahlen, seit mehr als vierzig Jahren das Standardwerk zur Verkehrsstatistik in Deutschland, steht mit der aktuellen Ausgabe 2014/2015 erstmalig zum kostenlosen Download bereit.“"
                            },
                            {
                                "example_id": "d090d6a1-e83e-4ae0-aa3b-473c79f1094b",
                                "sense_id": "7fb32a37-d916-3a40-91c3-c1846b6982cc",
                                "text": "„Die vorliegende fünfte Ausgabe des Glossars für die Verkehrsstatistik ist das Ergebnis einer erfolgreichen Zusammenarbeit von Eurostat, UNECE (United Nations Economic Commission for Europe) und ITF (Internationales Transport Forum), die um die Harmonisierung der Verkehrsstatistik auf europäischer und internationaler Ebene bemüht sind.“"
                            },
                            {
                                "example_id": "01c30ec1-2bc0-4e49-931b-41face0a6b4c",
                                "sense_id": "7fb32a37-d916-3a40-91c3-c1846b6982cc",
                                "text": "„Für Berlin gilt, dass der Anteil der Fußgänger und Radfahrer bei den Unfalltoten unverhältnismäßig hoch ist, so nannte es mit Blick auf die Verkehrsstatistik von 2010 die Prüforganisation Dekra.“"
                            },
                            {
                                "example_id": "2906a431-13ea-42c5-b28e-e4fd317767ac",
                                "sense_id": "7fb32a37-d916-3a40-91c3-c1846b6982cc",
                                "text": "„Aber die Verkehrsstatistik ist ein Kapitel für sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
