                },
                {
                    "sense_id": "f0dc1785-9458-3a81-8328-ab58c1e19f6e",
                    "sense_definition": "Avec franchise, sans détour ni ambiguïté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a refusé <w>nettement</w> sa proposition dès le début de la discussion.",
                            "target_lang_translations": {
                                "en": "She <w>flatly</w> rejected the proposal from the very start of the discussion.",
                                "ru": "С самого начала обсуждения она <w>прямо</w> отвергла предложение.",
                                "de": "Sie hat ihren Vorschlag gleich zu Beginn der Diskussion <w>glatt</w> abgelehnt.",
                                "es": "Ella rechazó <w>rotundamente</w> su propuesta desde el principio de la discusión.",
                                "zh": "她从讨论一开始就<w>断然</w>拒绝了对方的提议。"
                            }
                        },
                        {
                            "text": "Il vaut mieux poser <w>nettement</w> la question pour éviter tout malentendu.",
                            "target_lang_translations": {
                                "en": "It is better to put the question <w>plainly</w> to avoid any misunderstanding.",
                                "ru": "Лучше задать вопрос <w>прямо</w>, чтобы избежать любого недоразумения.",
                                "de": "Es ist besser, die Frage <w>unumwunden</w> zu stellen, um jedes Missverständnis zu vermeiden.",
                                "es": "Es mejor formular la pregunta <w>sin rodeos</w> para evitar cualquier malentendido.",
                                "zh": "最好<w>明确</w>地提出这个问题，以免产生误解。"
                            }
                        }
                    ],
                    "synonyms": [
