                "senses": [
                    {
                        "sense_id": "806ccdf5-dc91-3399-88a8-4a40fe74c657",
                        "entry_id": "93bb1c71-1f59-3e53-ac38-b3af63439c28",
                        "glosses": [
                            "zwykle drużyna sportowa, niekiedy inny zespół"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c617de78-a1de-419f-b526-d82bdacda719",
                                "sense_id": "806ccdf5-dc91-3399-88a8-4a40fe74c657",
                                "text": "Szef działu wyścigowego Kawasaki Motors Europe zapowiedział, że team będzie chciał ponownie walczyć o tytuł mistrzowski"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4696e0aa-b416-4e81-bef2-b151e347dc41",
                        "source_entry_id": "93bb1c71-1f59-3e53-ac38-b3af63439c28",
                        "source_sense_id": "806ccdf5-dc91-3399-88a8-4a40fe74c657",
                        "target_lang_word": "team",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "team",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dea4bca4-f7a2-36b1-9f57-91dad360c00e",
                                        "entry_id": "35bd1382-dec1-3355-b8ee-e51e65beb1c2",
                                        "glosses": [
                                            "A set of draught animals, such as two horses in front of a carriage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bffb3036-1a31-444c-94fc-36470a6e5f1c",
                                                "sense_id": "dea4bca4-f7a2-36b1-9f57-91dad360c00e",
                                                "text": "It happened almost every day that coaches stuck fast, until a team of cattle could be procured from some neighbouring farm to tug them out of the slough."
                                            },
                                            {
                                                "example_id": "7ecff6e3-df6e-4d57-938e-6524da4eaa0c",
                                                "sense_id": "dea4bca4-f7a2-36b1-9f57-91dad360c00e",
                                                "text": "The adjacent alleys were choked with tethered wagons, the teams reversed and nuzzling gnawed corn-ears over the tail-boards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e3c2b9f-7d80-3c4d-9b4f-0a66d2d8ae92",
                                        "entry_id": "35bd1382-dec1-3355-b8ee-e51e65beb1c2",
                                        "glosses": [
                                            "Any group of people involved in the same activity, especially sports or work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7483da72-67f1-44a5-a100-046a78eb1f6f",
                                                "sense_id": "6e3c2b9f-7d80-3c4d-9b4f-0a66d2d8ae92",
                                                "text": "We need more volunteers for the netball team."
                                            },
                                            {
                                                "example_id": "87192b95-8fc5-46f4-b702-3cecebb81f11",
                                                "sense_id": "6e3c2b9f-7d80-3c4d-9b4f-0a66d2d8ae92",
                                                "text": "The IT manager leads a team of three software developers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a36e10f1-6444-3c86-82be-0e51a82cc5bb",
                                        "entry_id": "35bd1382-dec1-3355-b8ee-e51e65beb1c2",
                                        "glosses": [
                                            "A group of animals moving together, especially young ducks."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a68918a5-045d-4cbf-a80d-5f80dc5f99fa",
                                                "sense_id": "a36e10f1-6444-3c86-82be-0e51a82cc5bb",
                                                "text": "she will wonder to have a teeme of ducklings about her"
                                            },
                                            {
                                                "example_id": "3d612b24-2256-45fe-95bd-28a86d4ac657",
                                                "sense_id": "a36e10f1-6444-3c86-82be-0e51a82cc5bb",
                                                "text": "a long team of snowy swans on high"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "901b27c4-a74d-3e07-9909-19d81163c619",
                                        "entry_id": "35bd1382-dec1-3355-b8ee-e51e65beb1c2",
                                        "glosses": [
                                            "A royalty or privilege granted by royal charter to a lord of a manor, of having, keeping, and judging in his court, his bondmen, neifes, and villains, and their offspring, or suit, that is, goods and chattels, and appurtenances thereto."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77a9e767-17e8-4778-b819-daba0958a034",
                                                "sense_id": "901b27c4-a74d-3e07-9909-19d81163c619",
                                                "text": "TEAM, Theam, Tem, Them. Sax. [from tyman, to propagate, to teem.] In old English law. Literally, an offspring, race or generation. A royalty or privilege granted by royal charter to a lord of a manor, of having, keeping and judging in his court, his bondmen, neifes and villeins, and their offspring or suit. They who had a jurisdiction of this kind, were said to have a court of Theme... constantly used in the old books in connection with toll, in the expression Toll & Team."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c637e7-70ec-3706-b153-e4e86241e12e",
                                        "entry_id": "35bd1382-dec1-3355-b8ee-e51e65beb1c2",
                                        "glosses": [
                                            "A group of people who favor one side of a binary debate that is divided and lacks a well-established clear consensus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f074d77c-6f5c-4f83-bf89-cb9a1143c2c8",
                                                "sense_id": "52c637e7-70ec-3706-b153-e4e86241e12e",
                                                "text": "As Jan. 1, 2020, approaches, it turns out there is a Team Zero and a Team 1 – those who believe the new decade will begin after midnight on the upcoming New Year's Eve and those who believe the burgeoning celebrations of a new decade (and all the \"last decade\" retrospectives) are in fact a year early."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "team",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bce7f5f-96c8-3ace-a66c-803117699855",
