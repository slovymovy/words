                "senses": [
                    {
                        "sense_id": "6c846dda-1715-3f5b-87b1-321e39905ff7",
                        "entry_id": "f7193d1a-71a6-364b-9dce-f5ef23be7c1f",
                        "glosses": [
                            "Donner un caractère globulaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "740d47ce-2ac1-4ad3-92e7-ef9ec0468645",
                                "sense_id": "6c846dda-1715-3f5b-87b1-321e39905ff7",
                                "text": "Ils ont aussi parfois pour but de coalescer et de globulariser des précipités apparus de façon involontaire (dans les aciers inoxydables, il s'agit généralement de carbures de chrome)."
                            },
                            {
                                "example_id": "e0662e8c-f188-47a4-a2e9-86cdb5e81a52",
                                "sense_id": "6c846dda-1715-3f5b-87b1-321e39905ff7",
                                "text": "Des traitements thermiques de revenu qui permettent de globulariser la perlite sont également favorables."
                            },
                            {
                                "example_id": "36d93459-ea2c-42a1-aa7a-c19637aef4dc",
                                "sense_id": "6c846dda-1715-3f5b-87b1-321e39905ff7",
                                "text": "En homogénéisant à plus haute température plus longtemps, on va globulariser les mauvaises particules, augmentant ainsi notre ductilité (…)"
                            }
                        ]
                    }
