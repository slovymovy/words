                        "examples": [
                            {
                                "example_id": "bafa65ff-4bed-4cbd-a8c4-771b823d8ac6",
                                "sense_id": "dad832e4-f220-3edf-a2a4-7715c5f08d5d",
                                "text": "В э́той шко́ле воспи́танникам воспреща́лось ду́мать о жи́зни до поступле́ния в шко́лу, вспомина́ть ра́ннее де́тство, роди́телей и задава́ть вопро́сы, каса́ющиеся их про́шлого и бу́дущего.",
                                "translation": "Alexander Belyaev",
                                "english": "Alexander Belyaev"
                            }
                        ]
                    }
