                                "text": "Ik brak."
                            },
                            {
                                "example_id": "ae34c06d-fc22-497e-a744-3e8bc0e52373",
                                "sense_id": "5e318347-ce3a-3154-9d1f-fc205babe473",
                                "text": "Jij brak."
