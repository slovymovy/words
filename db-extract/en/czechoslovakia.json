                        "target_lang_word": "Tchécoslovaquie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tchécoslovaquie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15c5e5a4-0285-3619-bf1d-e72d9cf9a0c8",
                                        "entry_id": "cbebce0b-a90b-371d-be94-0e4e547bc385",
                                        "glosses": [
                                            "Ancien pays européen (1918–1939 et 1945–1992), maintenant divisé en deux (République tchèque et Slovaquie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f785b9-862a-467d-a77a-7a4e1bba582f",
                                                "sense_id": "15c5e5a4-0285-3619-bf1d-e72d9cf9a0c8",
                                                "text": "En laissant Hitler démembrer la Tchécoslovaquie, annexer la Bohème, la Moravie et la Silésie, nous ne lui avons rien montré d’autre qu’une certaine faiblesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e494866-4ce7-44dc-abc9-5dbe8f490f9f",
                        "source_entry_id": "cb1fc959-a385-33ce-ab87-68d274b2ae81",
                        "source_sense_id": "db078670-4f53-3b13-aa6d-16a4b2c32840",
                        "source_sense_description": "former country in Central Europe",
                        "target_lang_word": "Tschechoslowakei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tschechoslowakei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ca55b51-12f9-319e-85c5-bf0ebbd22e31",
                                        "entry_id": "2e3f974c-d1d4-3b0f-a9ef-057786aa89ce",
                                        "glosses": [
                                            "Staat auf dem heutigen tschechischen und slowakischen Gebiet, der 1993 in die beiden selbstständigen Staaten Tschechien und die Slowakei geteilt wurde"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65e5655d-7722-4142-b110-4a40d7078651",
                                                "sense_id": "1ca55b51-12f9-319e-85c5-bf0ebbd22e31",
                                                "text": "„Von 1945 bis 1949 errichtete die Sowjetunion dann in allen Ländern ihres Einflussbereiches sozialistische Staaten wie in der DDR beziehungsweise förderte die Machtübernahme der einheimischen kommunistischen Kräfte wie in Polen und der Tschechoslowakei.“"
                                            },
                                            {
                                                "example_id": "c5c2982b-8a7a-44cd-b125-66455cc964cf",
                                                "sense_id": "1ca55b51-12f9-319e-85c5-bf0ebbd22e31",
                                                "text": "„Neun von zehn kamen aus dem Osten, aus Gebieten Europas, die heute in Rußland, Polen, Bulgarien, Ungarn oder der Tschechoslowakei liegen.“"
                                            },
                                            {
                                                "example_id": "a504b856-e8fb-410c-a615-357ff0b28c6b",
                                                "sense_id": "1ca55b51-12f9-319e-85c5-bf0ebbd22e31",
                                                "text": "„Sie kehrt nach Hause zurück, in die neu gegründete, unruhige Republik namens Tschechoslowakei, in der Böhmen deutscher Zunge, immerhin ein Viertel der Bewohner, Bürger minderen Ansehens sind.“"
                                            },
                                            {
                                                "example_id": "c3945961-9c3e-49e3-8b97-df722d7c7e08",
                                                "sense_id": "1ca55b51-12f9-319e-85c5-bf0ebbd22e31",
                                                "text": "„Für ein paar Tage wolle sie die Stube zumachen und in die Tschechoslowakei.“"
                                            },
                                            {
                                                "example_id": "8b0450e3-7538-45ad-b410-b96efe3c0ccc",
                                                "sense_id": "1ca55b51-12f9-319e-85c5-bf0ebbd22e31",
                                                "text": "„Neben Beschränkungen der Sportarten selbst beispielweise war das im Westen, aber auch in Polen und der Tschechoslowakei sehr populäre Drachenfliegen in der DDR verboten, wurden manche der stadtnahen Flugplätze wie Saarmund und Eggersdorf willkürlich wegen Fluchtgefahr geschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
