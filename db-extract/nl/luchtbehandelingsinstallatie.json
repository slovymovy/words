                    {
                        "sense_id": "57db3507-a907-34d8-b94d-530dc8de31f7",
                        "entry_id": "81a365aa-23c8-372f-b1dd-b9611ccb04a3",
                        "glosses": [
                            "apparaat dat zorgt voor een optimale samenstelling van de atmosfeer in een gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4578be0f-5b4e-42cc-b6c9-8f91ae2df56a",
                                "sense_id": "57db3507-a907-34d8-b94d-530dc8de31f7",
                                "text": "Het beoogde filmtheater kreeg een nieuw ontwerp omdat gedurende de bouw bleek dat er onvoldoende rekening was gehouden met een luchtbehandelingsinstallatie. Volgens de gemeente was er maar één oplossing mogelijk: het systeem moet op het dak, waarmee ook de gevel aan de zijde van de IJssel omhoog moet worden getrokken."
                            },
                            {
                                "example_id": "5e02a089-8f76-482a-b2fa-8f0085415f74",
                                "sense_id": "57db3507-a907-34d8-b94d-530dc8de31f7",
                                "text": "Aan de Dwarsweg zijn de drie groeiplaatsen ondergebracht in de twee karakteristieke donkerbruine houten schuren op het erf van de boerderij. Wie naar binnen stapt ziet nog niets: de kwekerijen zijn in enkele afgetimmerde houten ruimtes ondergebracht. Deze ruimtes zijn goed geïsoleerd en voorzien van een uitgebreide elektrische- en luchtbehandelingsinstallatie."
                            }
                        ]
                    }
