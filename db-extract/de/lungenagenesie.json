                "senses": [
                    {
                        "sense_id": "88424d5b-a0a0-3e06-9e82-c808c614cf3f",
                        "entry_id": "254c7177-103f-38be-819e-8b42ddeac5a5",
                        "glosses": [
                            "angeborene Fehlbildung der Lunge, bei der die Lunge ein- oder beidseitig fehlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea5d82d-9405-4e59-9e78-3131c3ad6f1d",
                                "sense_id": "88424d5b-a0a0-3e06-9e82-c808c614cf3f",
                                "text": "„Die Lungenagenesie ist eine angeborene Fehlbildung der Lunge.“"
                            },
                            {
                                "example_id": "6ef2da7b-c24c-4b38-bda9-4b897adaf76a",
                                "sense_id": "88424d5b-a0a0-3e06-9e82-c808c614cf3f",
                                "text": "„Bei der Lungenagenesie können drei Typen unterschieden werden.“"
                            },
                            {
                                "example_id": "cb9fe39d-a968-4634-bbbc-284373feca11",
                                "sense_id": "88424d5b-a0a0-3e06-9e82-c808c614cf3f",
                                "text": "„Lungenagenesien und hochgradigere Lungenhypoplasien sind sehr selten, etwa 40 Fälle sind bisher beschrieben.“"
                            },
                            {
                                "example_id": "ed0754f9-d2db-47b9-8a81-f901fc215f7c",
                                "sense_id": "88424d5b-a0a0-3e06-9e82-c808c614cf3f",
                                "text": "„Bei der unilateralen Lungenagenesie handelt es sich um eine sehr seltene Hemmungsmissbildung, bei der der ipsilaterale Bronchus völlig fehlt oder nur als rudimentärer Stumpf vorhanden ist. Die etwas häufigere linksseitige Lungenagenesie ist manchmal mit angeborenen Herzfehlern wie der Fallot’schen Tetralogie vergesellschaftet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
