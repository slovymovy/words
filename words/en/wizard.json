{
    "word_family": [
        "wizardry",
        "wizardly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5a244ed-983f-3aed-8029-fcd8192143f3",
                    "sense_definition": "A person, often in fairy tales or fantasy stories, who has magical powers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "magic_user",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>wizard</w> used his staff to cast a powerful spell.",
                            "target_lang_translations": {
                                "ru": "Старый <w>волшебник</w> использовал свой посох, чтобы наложить мощное заклинание.",
                                "tr": "Yaşlı <w>büyücü</w>, güçlü bir büyü yapmak için asasını kullandı."
                            }
                        },
                        {
                            "text": "In the story, the young hero must defeat an evil <w>wizard</w> to save the kingdom.",
                            "target_lang_translations": {
                                "ru": "По сюжету юный герой должен победить злого <w>колдуна</w>, чтобы спасти королевство.",
                                "tr": "Hikayede, genç kahraman krallığı kurtarmak için kötü bir <w>büyücüyü</w> yenmek zorundadır."
                            }
                        }
                    ],
                    "synonyms": [
                        "magician",
                        "sorcerer",
                        "mage",
                        "warlock",
                        "witch",
                        "conjurer",
                        "mystic"
                    ],
                    "common_phrases": [
                        "evil wizard",
                        "powerful wizard",
                        "grand wizard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, часто встречающийся в сказках или фэнтези, обладающий магическими способностями.",
                        "tr": "Genellikle masallarda veya fantastik hikayelerde yer alan, sihirli güçleri olan kişi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волшебник",
                                "target_lang_sense_clarification": "самый общий термин для обладателя магии"
                            },
                            {
                                "target_lang_word": "колдун",
                                "target_lang_sense_clarification": "часто подразумевает темную или народную магию"
                            },
                            {
                                "target_lang_word": "маг",
                                "target_lang_sense_clarification": "профессиональный или книжный термин"
                            },
                            {
                                "target_lang_word": "чародей",
                                "target_lang_sense_clarification": "тот, кто накладывает чары; книжный стиль"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "büyücü",
                                "target_lang_sense_clarification": "büyü yapan, sihirli güçleri olan kimse"
                            },
                            {
                                "target_lang_word": "sihirbaz",
                                "target_lang_sense_clarification": "sihir veya illüzyon yapan kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2489e501-273e-3c2f-b6e0-b8c6a15b367f",
                    "sense_definition": "A person who is extremely skillful or clever at a particular activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expert",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a financial <w>wizard</w> who knows exactly where to invest money.",
                            "target_lang_translations": {
                                "ru": "Он финансовый <w>гений</w>, который точно знает, куда вкладывать деньги.",
                                "tr": "O, parayı tam olarak nereye yatıracağını bilen bir finans <w>dahisidir</w>."
                            }
                        },
                        {
                            "text": "My brother is a computer <w>wizard</w> and can fix any technical problem.",
                            "target_lang_translations": {
                                "ru": "Мой брат — компьютерный <w>мастер</w>, он может решить любую техническую проблему.",
                                "tr": "Erkek kardeşim bir bilgisayar <w>ustasıdır</w> ve her türlü teknik sorunu çözebilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "expert",
                        "genius",
                        "prodigy",
                        "skilled person"
                    ],
                    "common_phrases": [
                        "computer wizard",
                        "financial wizard",
                        "math wizard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который чрезвычайно искусен или умен в определенной деятельности.",
                        "tr": "Belirli bir alanda veya faaliyette son derece yetenekli ya da zeki olan kimse."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гений",
                                "target_lang_sense_clarification": "об очень талантливом человеке"
                            },
                            {
                                "target_lang_word": "мастер",
                                "target_lang_sense_clarification": "умелец, специалист высокого класса"
                            },
                            {
                                "target_lang_word": "виртуоз",
                                "target_lang_sense_clarification": "человек, в совершенстве владеющий техникой дела"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dahi",
                                "target_lang_sense_clarification": "olağanüstü yetenekli kimse"
                            },
                            {
                                "target_lang_word": "üstat",
                                "target_lang_sense_clarification": "bir işin uzmanı, ustası"
                            },
                            {
                                "target_lang_word": "sihirbaz",
                                "target_lang_sense_clarification": "mecazi anlamda, bir işi mucizevi şekilde çok iyi yapan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b43d913-2956-38ff-a864-55a9710140df",
                    "sense_definition": "A computer tool that guides a user through a complex process step-by-step.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "software",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Follow the instructions in the setup <w>wizard</w> to install the new software.",
                            "target_lang_translations": {
                                "ru": "Следуйте инструкциям в <w>мастере</w> установки, чтобы установить новое программное обеспечение.",
                                "tr": "Yeni yazılımı yüklemek için kurulum <w>sihirbazındaki</w> talimatları izleyin."
                            }
                        },
                        {
                            "text": "The installation <w>wizard</w> makes it easy to configure your network settings.",
                            "target_lang_translations": {
                                "ru": "<w>Мастер</w> установки позволяет легко настроить параметры сети.",
                                "tr": "Kurulum <w>sihirbazı</w>, ağ ayarlarınızı yapılandırmanızı kolaylaştırır."
                            }
                        }
                    ],
                    "synonyms": [
                        "assistant"
                    ],
                    "common_phrases": [
                        "setup wizard",
                        "installation wizard"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютерная утилита, которая пошагово помогает пользователю выполнить сложный процесс.",
                        "tr": "Kullanıcıyı karmaşık bir işlem boyunca adım adım yönlendiren bilgisayar aracı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мастер",
                                "target_lang_sense_clarification": "стандартный термин в интерфейсах (напр. Мастер установки)"
                            },
                            {
                                "target_lang_word": "помощник",
                                "target_lang_sense_clarification": "программа-ассистент"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sihirbaz",
                                "target_lang_sense_clarification": "yazılım kurulumlarında adım adım yönlendiren yardımcı program"
                            },
                            {
                                "target_lang_word": "kurulum asistanı",
                                "target_lang_sense_clarification": "yol gösterici bilgisayar aracı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a0c5b99-9ec4-3d56-89e4-4b2c3a1bad09",
                    "sense_definition": "A wise man or sage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wise_man",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>wizard</w> offered counsel to the king in times of trouble.",
                            "target_lang_translations": {
                                "ru": "Древний <w>мудрец</w> давал советы королю в смутные времена.",
                                "tr": "Kadim <w>bilge</w>, sıkıntılı zamanlarda krala tavsiyelerde bulundu."
                            }
                        },
                        {
                            "text": "Travelers sought the <w>wizard</w> for his vast knowledge of history and philosophy.",
                            "target_lang_translations": {
                                "ru": "Путешественники искали <w>мудреца</w> ради его обширных познаний в истории и философии.",
                                "tr": "Gezginler, tarih ve felsefe konusundaki engin bilgisi nedeniyle o <w>bilgeyi</w> aradılar."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мудрец или провидец.",
                        "tr": "Bilge kişi veya pir."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мудрец",
                                "target_lang_sense_clarification": "человек, обладающий высшим знанием"
                            },
                            {
                                "target_lang_word": "провидец",
                                "target_lang_sense_clarification": "тот, кто видит будущее или скрытое"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bilge",
                                "target_lang_sense_clarification": "derin bilgiye ve deneyime sahip kimse"
                            },
                            {
                                "target_lang_word": "pir",
                                "target_lang_sense_clarification": "tecrübeli ve saygın yaşlı kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07ee6a62-f0ea-3134-a3c9-5be00185d449",
                    "sense_definition": "An administrator in a multi-user dungeon (MUD) game.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wizard</w> banned the player for breaking the rules of the game world.",
                            "target_lang_translations": {
                                "ru": "<w>Администратор</w> забанил игрока за нарушение правил игрового мира.",
                                "tr": "<w>Yönetici</w>, oyun dünyasının kurallarını ihlal ettiği için oyuncuyu engelledi."
                            }
                        },
                        {
                            "text": "Only a <w>wizard</w> has the authority to modify the game environment.",
                            "target_lang_translations": {
                                "ru": "Только <w>визард</w> имеет право изменять игровую среду.",
                                "tr": "Oyun ortamını değiştirme yetkisine yalnızca bir <w>yönetici</w> sahiptir."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Администратор в многопользовательской игре (MUD).",
                        "tr": "Çok kullanıcılı bir zindan (MUD) oyunundaki yönetici."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "администратор",
                                "target_lang_sense_clarification": "управляющий игрой"
                            },
                            {
                                "target_lang_word": "визард",
                                "target_lang_sense_clarification": "сленговое название администратора в MUD"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yönetici",
                                "target_lang_sense_clarification": "oyun dünyasını yöneten yetkili kişi"
                            },
                            {
                                "target_lang_word": "admin",
                                "target_lang_sense_clarification": "oyun veya sistem yöneticisi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e4908a4-7c3e-3a17-bb9f-385076925c26",
                    "sense_definition": "A virgin over the age of 30 (internet slang).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He jokingly referred to himself as a <w>wizard</w> on the internet forum.",
                            "target_lang_translations": {
                                "ru": "Он в шутку назвал себя <w>волшебником</w> на интернет-форуме.",
                                "tr": "İnternet forumunda şaka yollu kendisinden bir <w>büyücü</w> olarak bahsetti."
                            }
                        },
                        {
                            "text": "The term <w>wizard</w> is used in some online communities to describe older virgins.",
                            "target_lang_translations": {
                                "ru": "Термин \"<w>волшебник</w>\" используется в некоторых интернет-сообществах для описания возрастных девственников.",
                                "tr": "<w>Büyücü</w> terimi, bazı çevrimiçi topluluklarda yaşça büyük bakirleri tanımlamak için kullanılır."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Девственник старше 30 лет (интернет-сленг).",
                        "tr": "30 yaşın üzerinde olan bakir kişi (internet argosu)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волшебник",
                                "target_lang_sense_clarification": "ироничное сленговое обозначение"
                            },
                            {
                                "target_lang_word": "маг",
                                "target_lang_sense_clarification": "вариация сленгового термина"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "büyücü",
                                "target_lang_sense_clarification": "internet forumlarında yaşça büyük bakirler için kullanılan şakayla karışık argo terim"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "094e2932-a3a5-3d15-8401-6fd8e7dee0d8",
                    "sense_definition": "Excellent, fine, or superb.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "superb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>wizard</w> time at the party last night.",
                            "target_lang_translations": {
                                "ru": "Мы <w>волшебно</w> провели время на вечеринке вчера вечером.",
                                "tr": "Dün gece partide <w>harika</w> vakit geçirdik."
                            }
                        },
                        {
                            "text": "That is a absolutely <w>wizard</w> idea for the new project.",
                            "target_lang_translations": {
                                "ru": "Это совершенно <w>потрясающая</w> идея для нового проекта.",
                                "tr": "Bu, yeni proje için kesinlikle <w>müthiş</w> bir fikir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wizard show",
                        "wizard time"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "originally RAF slang"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, превосходный или замечательный.",
                        "tr": "Mükemmel, harika veya fevkalade."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блестящий",
                                "target_lang_sense_clarification": "превосходный"
                            },
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "вызывающий восхищение"
                            },
                            {
                                "target_lang_word": "волшебный",
                                "target_lang_sense_clarification": "чудесный, очень хороший"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "harika",
                                "target_lang_sense_clarification": "çok güzel, mükemmel"
                            },
                            {
                                "target_lang_word": "şahane",
                                "target_lang_sense_clarification": "kusursuz, çok beğenilen"
                            },
                            {
                                "target_lang_word": "müthiş",
                                "target_lang_sense_clarification": "şaşkınlık verecek kadar güzel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c10e803-a835-3731-b741-01962ffbf9c3",
                    "sense_definition": "To conjure or produce something as if by magic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conjure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>wizard</w> up a meal from the few ingredients left in the fridge.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>наколдовать</w> еду из нескольких ингредиентов, оставшихся в холодильнике.",
                                "tr": "Dolapta kalan birkaç malzemeden bir yemek <w>yaratmayı</w> başardı."
                            }
                        },
                        {
                            "text": "The team tried to <w>wizard</w> a solution before the deadline.",
                            "target_lang_translations": {
                                "ru": "Команда пыталась <w>сотворить</w> решение до истечения срока.",
                                "tr": "Ekip, son teslim tarihinden önce bir çözüm <w>kondurmaya</w> çalıştı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наколдовать или создать что-то, словно по волшебству.",
                        "tr": "Sanki sihirle yapıyormuş gibi bir şeyi yoktan var etmek veya ortaya çıkarmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наколдовать",
                                "target_lang_sense_clarification": "создать магией или чудесным образом"
                            },
                            {
                                "target_lang_word": "сотворить",
                                "target_lang_sense_clarification": "сделать что-то необычное или сложное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yaratmak",
                                "target_lang_sense_clarification": "yoktan var etmek, hızlıca ortaya çıkarmak"
                            },
                            {
                                "target_lang_word": "kondurmak",
                                "target_lang_sense_clarification": "sihirli bir şekilde hemen hazırlayıvermek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}