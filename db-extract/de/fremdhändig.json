                "senses": [
                    {
                        "sense_id": "53e19ef7-0224-33c9-bc1b-c480d1e2b81d",
                        "entry_id": "88034ca1-cf98-359c-9e01-18e49e57e820",
                        "glosses": [
                            "mit/von fremder Hand"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "1635d43b-5caf-4144-9df7-e249397d94f1",
                                "sense_id": "53e19ef7-0224-33c9-bc1b-c480d1e2b81d",
                                "text": "Das Testament wurde immer fremdhändig geschrieben."
                            },
                            {
                                "example_id": "7b86b155-36ce-440d-bee9-93efcd936fe2",
                                "sense_id": "53e19ef7-0224-33c9-bc1b-c480d1e2b81d",
                                "text": "Es handelt sich um eine fremdhändige Verfügung."
                            },
                            {
                                "example_id": "cefce874-294e-4968-a205-fd30e70d92d0",
                                "sense_id": "53e19ef7-0224-33c9-bc1b-c480d1e2b81d",
                                "text": "„Droht aus Sicht des letztwillig Verfügenden unmittelbar die begründete Gefahr, dass er stirbt oder die Testierfähigkeit verliert, bevor er seinen letzten Willen auf andere Weise zu erklären vermag, so kann er seinen letzten Willen in Gegenwart von zwei Zeugen fremdhändig (§ 579) oder mündlich erklären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
