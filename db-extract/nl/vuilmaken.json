                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a64f1bf-afc6-4648-981a-9b0ca1c49ea4",
                                                "sense_id": "bfe5a801-e370-3341-9b5e-ed243c9d0630",
                                                "text": "The lights from the stadium polluted the night sky, and we couldn't see the stars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ded9b7ad-eb96-3cdf-93ed-055a06a723c4",
                                        "entry_id": "9f0b0306-566d-303a-95c7-a0e08d00990e",
                                        "glosses": [
                                            "To corrupt or profane"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6a32bde-6ef6-4604-bd76-6ac7b06b8b57",
                                                "sense_id": "ded9b7ad-eb96-3cdf-93ed-055a06a723c4",
                                                "text": "But as for the cowardly, the faithless, the polluted, as for murderers, fornicators, sorcerers, idolaters, and all liars, their lot shall be in the lake that burns with fire and sulphur, which is the second death."
                                            }
