                        "form": "den Cyborg"
                    },
                    {
                        "form_id": "faade250-65bb-4145-9685-df77ace2ee29",
                        "entry_id": "b3541b91-b267-33b1-8349-ee5ffe34bbeb",
                        "tags": [
