                    "sense_id": "df80eeb7-abd6-376d-9a5b-478b2b06bc0b",
                    "sense_definition": "w sposób pogodny, radosny lub pełen optymizmu",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pogoda_i_nastroj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci <w>słonecznie</w> uśmiechały się do przechodniów na ulicy.",
                            "target_lang_translations": {
                                "en": "The children were smiling <w>radiantly</w> at passersby on the street.",
                                "ru": "Дети <w>лучезарно</w> улыбались прохожим на улице.",
                                "nl": "De kinderen glimlachten <w>stralend</w> naar de voorbijgangers op straat.",
                                "de": "Die Kinder lächelten den Passanten auf der Straße <w>strahlend</w> zu.",
                                "fr": "Les enfants souriaient <w>radieusement</w> aux passants dans la rue.",
                                "it": "I bambini sorridevano <w>radiosamente</w> ai passanti per strada.",
                                "cs": "Děti se na kolemjdoucí na ulici <w>zářivě</w> usmívaly.",
                                "tr": "Çocuklar sokaktaki gelip geçenlere <w>ışıl ışıl</w> gülümsüyordu.",
                                "es": "Los niños sonreían <w>radiantemente</w> a los transeúntes en la calle.",
                                "zh": "孩子们对街上的路人<w>灿烂地</w>微笑。"
                            }
                        },
                        {
                            "text": "Mimo trudności starała się patrzeć na świat <w>słonecznie</w>.",
                            "target_lang_translations": {
                                "en": "Despite the difficulties, she tried to look at the world <w>sunnily</w>.",
                                "ru": "Несмотря на трудности, она старалась смотреть на мир <w>солнечно</w> и с оптимизмом.",
                                "nl": "Ondanks de moeilijkheden probeerde ze de wereld <w>zonnig</w> te bekijken.",
                                "de": "Trotz der Schwierigkeiten versuchte sie, <w>heiter</w> auf die Welt zu blicken.",
                                "fr": "Malgré les difficultés, elle s'efforçait de voir le monde <w>avec optimisme</w>.",
                                "it": "Nonostante le difficoltà, cercava di guardare il mondo in modo <w>solare</w>.",
                                "cs": "Navzdory potížím se snažila dívat na svět <w>optimisticky</w>.",
                                "tr": "Zorluklara rağmen dünyaya <w>iyimserce</w> bakmaya çalışıyordu.",
                                "es": "A pesar de las dificultades, intentaba mirar el mundo <w>con optimismo</w>.",
                                "zh": "尽管面临种种困难，她依然努力<w>乐观地</w>看待世界。"
                            }
                        }
                    ],
