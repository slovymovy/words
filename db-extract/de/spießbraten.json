                        "glosses": [
                            "an einem Spieß über offenem Feuer gebratenes Fleisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a8b7e62-79d0-49eb-bfd1-8d60ab615c33",
                                "sense_id": "6ee80363-b507-332d-8896-0b8c8f6470c7",
                                "text": "„Renate war schon wieder Spießbraten essen, in einem Ort namens Rhens.“"
                            }
