    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f09a4723-65a8-326c-ac93-f1c34a276216",
                    "sense_definition": "Een steil naar beneden gerichte vliegbeweging, vaak gemaakt door vogels of vliegtuigen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vliegbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De roofvogel maakte een snelle <w>duikvlucht</w> om zijn prooi in het gras te vangen.",
                            "target_lang_translations": {
                                "en": "The bird of prey made a rapid <w>dive</w> to catch its prey in the grass."
                            }
                        },
                        {
                            "text": "Het gevechtsvliegtuig zette plotseling een spectaculaire <w>duikvlucht</w> in tijdens de vliegshow.",
                            "target_lang_translations": {
                                "en": "The fighter jet suddenly went into a spectacular <w>nosedive</w> during the airshow."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een duikvlucht inzetten",
                        "snelle duikvlucht"
                    ],
                    "target_lang_definitions": {
                        "en": "A steep downward flight movement, often made by birds or aircraft."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dive",
                                "target_lang_sense_clarification": "of a bird or aircraft"
                            },
                            {
                                "target_lang_word": "nosedive",
                                "target_lang_sense_clarification": "steep downward flight"
                            },
                            {
                                "target_lang_word": "swoop",
                                "target_lang_sense_clarification": "rapid downward flight of a bird"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62b3468a-2b34-30e9-a4e5-fb96743eb26f",
                    "sense_definition": "Een snelle en sterke daling of achteruitgang, bijvoorbeeld van prijzen, koersen of populariteit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijke daling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het slechte nieuws raakte de waarde van het aandeel in een vrije <w>duikvlucht</w>.",
                            "target_lang_translations": {
                                "en": "After the bad news, the value of the share went into a free <w>nosedive</w>."
                            }
                        },
                        {
                            "text": "Met de roebel in <w>duikvlucht</w> stonden drie Russische banken in Europa op omvallen.",
                            "target_lang_translations": {
                                "en": "With the ruble in a <w>nosedive</w>, three Russian banks in Europe were on the verge of collapse."
                            }
                        }
                    ],
                    "synonyms": [
                        "val",
                        "keldering",
                        "storting"
                    ],
                    "antonyms": [
                        "opmars",
                        "stijging"
                    ],
                    "common_phrases": [
                        "in duikvlucht raken",
                        "vrije duikvlucht"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak figuurlijk gebruikt in economische of journalistieke context."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A rapid and sharp decline or drop, for example of prices, exchange rates, or popularity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nosedive",
                                "target_lang_sense_clarification": "figurative, sharp decline"
                            },
                            {
                                "target_lang_word": "plunge",
                                "target_lang_sense_clarification": "sudden drop in value or status"
                            },
                            {
                                "target_lang_word": "freefall",
                                "target_lang_sense_clarification": "uncontrolled rapid decline"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}