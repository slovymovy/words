                "senses": [
                    {
                        "sense_id": "a2d120c7-a647-3745-b6fc-4f7b0a5a6d49",
                        "entry_id": "9d6e1bd0-25d9-305c-b5a2-e9225ec8fc92",
                        "glosses": [
                            "Publikum, das mit einer Botschaft erreicht werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa71b9e-29cc-4f8b-8545-d66b66732464",
                                "sense_id": "a2d120c7-a647-3745-b6fc-4f7b0a5a6d49",
                                "text": "„Dabei versteht es sich, dass solche Tendenzen nicht nur Boschs künstlerischer Entwicklung geschuldet sind, sondern auch den verschiedenen Bildaufgaben, den Auftragskontexten und dem Anspruchsniveau des Zielpublikums.“"
                            },
                            {
                                "example_id": "6d1894ab-e0c1-4734-ab4f-d8b17c7a54ce",
                                "sense_id": "a2d120c7-a647-3745-b6fc-4f7b0a5a6d49",
                                "text": "„Tatsache ist: Das Zielpublikum dieser Industrie besteht aus nichts als Schwachsinnigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
