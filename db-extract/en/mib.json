            {
                "entry_id": "77590ba3-b0d1-3a3c-b38c-1b93579850da",
                "word": "mib",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9bc83f25-fd79-456f-b1ac-1e885a641ec1",
                        "entry_id": "77590ba3-b0d1-3a3c-b38c-1b93579850da",
                        "tags": [
                            "plural"
                        ],
                        "form": "mibs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65bad615-e30d-3362-9905-6ee2f60997fc",
                        "entry_id": "77590ba3-b0d1-3a3c-b38c-1b93579850da",
                        "glosses": [
                            "A marble (glass ball used in games), especially one used as a target."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9776e436-fc3a-4a5a-bfb9-0e6bb95509bb",
                                "sense_id": "65bad615-e30d-3362-9905-6ee2f60997fc",
                                "text": "On my first shot of the last game, I hit two mibs, my shooter and one marble exiting the ring, but leaving a snooger, which is a “commie rat” target marble near the rim of the ring."
                            },
                            {
                                "example_id": "60de913e-f9dd-426d-ae9c-852062ab716c",
                                "sense_id": "65bad615-e30d-3362-9905-6ee2f60997fc",
                                "text": "Thirteen five-eighths-inch marbles (“mibs”) are set in a cross in the center. Each mib should be three inches from its neighboring mib. Each player shoots with a “shooter,” a marble that's one-half to three-quarter inches in diameter."
                            },
                            {
                                "example_id": "a85418a7-b640-4684-b780-ed8cfcf8a8e8",
                                "sense_id": "65bad615-e30d-3362-9905-6ee2f60997fc",
                                "text": "He focused on the mib on the edge of the group inside the circle. The blue one was his favourite and he had it right where he wanted it."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
