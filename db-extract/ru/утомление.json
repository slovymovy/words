                ],
                "senses": [
                    {
                        "sense_id": "9f93f8d5-0126-3605-9725-b75bb22c13f9",
                        "entry_id": "11ef24fb-a474-36f8-a8a4-a278679303bd",
                        "glosses": [
                            "действие по значению гл. утомлять, утомляться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41a0ba27-b434-4916-a142-1c4e270422f1",
                                "sense_id": "9f93f8d5-0126-3605-9725-b75bb22c13f9",
                                "text": "Плавать нужно в таком темпе, чтобы не наступило быстрое утомление мышц, а также переохлаждение."
                            }
                        ]
                    },
                    {
                        "sense_id": "f849586f-3095-3184-8584-29ff2852dcea",
                        "entry_id": "11ef24fb-a474-36f8-a8a4-a278679303bd",
                        "glosses": [
                            "результат такого действия; усталость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f23a79c3-620c-416d-b4f0-94b43c2eb833",
                                "sense_id": "f849586f-3095-3184-8584-29ff2852dcea",
                                "text": "Худое лицо его еще больше осунулось, появился на нем какой-то тусклый налет безмерного утомления и огромной слабости."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2c18796-7d44-4e46-a7b0-99365aba4b8d",
                        "source_entry_id": "11ef24fb-a474-36f8-a8a4-a278679303bd",
                        "target_lang_word": "fatigue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fatigue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69f7c57d-6459-3310-a365-4aacf0c46344",
                                        "entry_id": "df41b4bb-e0c3-3cd3-ba8b-3a09fa611ee9",
                                        "glosses": [
                                            "A weariness caused by exertion; exhaustion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53fed010-4246-4065-a8d0-9efe4f9ce97e",
                                                "sense_id": "69f7c57d-6459-3310-a365-4aacf0c46344",
                                                "text": "My husband stayed for some days with the magistrate at Cardwell, recruiting his health and recovering from his fatigues, for the passage between Cape York and Cardwell had proved the most tedious and anxious part of the voyage."
                                            },
                                            {
                                                "example_id": "d7e71785-17bb-45b0-ad85-0d99eb9652ed",
                                                "sense_id": "69f7c57d-6459-3310-a365-4aacf0c46344",
                                                "text": "Alan Pardew finished by far the most frustrated man at the Emirates, blaming fatigue for the fact that Arsenal were able to kill his team off in the dying minutes."
                                            },
                                            {
                                                "example_id": "101ebc85-acee-43a7-b969-fc166ac8dc0f",
                                                "sense_id": "69f7c57d-6459-3310-a365-4aacf0c46344",
                                                "text": "For some, the constant deluge that has peaked in the past year is starting to add up to a new (and previously unthinkable) feeling: Taylor Swift fatigue."
                                            },
                                            {
                                                "example_id": "b33cec90-e7d3-4e2c-8506-b8ad936760fd",
                                                "sense_id": "69f7c57d-6459-3310-a365-4aacf0c46344",
                                                "text": "We found that a comprehensive fatigue management program can reduce fatigue-related crash risk and improve safety by, for example, educating drivers; had Triton had such a program, the driver may not have been operating the truck while fatigued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "208f8b5a-d7bd-3a5b-81d1-0c33a01c2a68",
                                        "entry_id": "df41b4bb-e0c3-3cd3-ba8b-3a09fa611ee9",
                                        "glosses": [
                                            "A menial task or tasks, especially in the military."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d1da7f-1ff7-4eeb-bb61-6c5e38c46f8f",
                                                "sense_id": "208f8b5a-d7bd-3a5b-81d1-0c33a01c2a68",
                                                "text": "Moreover, the habits of business are the most enduring of any; and Lord Norbourne's most positive enjoyment was in what are called the fatigues of office."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c585ae1-965b-3961-8b70-c6760e67ecab",
                                        "entry_id": "df41b4bb-e0c3-3cd3-ba8b-3a09fa611ee9",
                                        "glosses": [
                                            "Weakening and eventual failure of material, typically by cracking leading to complete separation, caused by repeated application of mechanical stress to the material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fff9180f-a316-4f71-a6b1-172941c15b39",
                                                "sense_id": "1c585ae1-965b-3961-8b70-c6760e67ecab",
                                                "text": "Mechanical failures due to fatigue have been the subject of engineering efforts for more than 150 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e6b099-65a1-3f2e-9cdf-2edeed872451",
                                        "entry_id": "df41b4bb-e0c3-3cd3-ba8b-3a09fa611ee9",
                                        "glosses": [
                                            "Attributive form of fatigues (“military clothing worn when doing menial tasks”)."
                                        ],
                                        "tags": [
                                            "US",
                                            "attributive",
                                            "countable",
                                            "form-of",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d4bbcf1-9e00-4655-9e81-3a5781645dca",
                                                "sense_id": "62e6b099-65a1-3f2e-9cdf-2edeed872451",
                                                "text": "He was slouched in the chair behind the duty officer’s desk, cigarette dangling from his lips, hands thrust deep into his fatigue pockets, making a display of his disrespect. The acting clerk, cowering behind his own desk, was either afraid to insist he assume a more military posture, or else didn’t care."
                                            },
                                            {
                                                "example_id": "4bfbee5e-26a0-4fcf-81a2-642aee563888",
                                                "sense_id": "62e6b099-65a1-3f2e-9cdf-2edeed872451",
                                                "text": "He reluctantly took the map from his camouflage fatigue pocket."
                                            },
                                            {
                                                "example_id": "e557985c-0a64-45b5-a837-275507a42bbb",
                                                "sense_id": "62e6b099-65a1-3f2e-9cdf-2edeed872451",
                                                "text": "Chino took a laminated map out of one of his fatigue pockets and gave it to Harper."
                                            },
                                            {
                                                "example_id": "c185c97c-4cff-49d0-8076-7f25894980bc",
                                                "sense_id": "62e6b099-65a1-3f2e-9cdf-2edeed872451",
                                                "text": "Spencer came with all the soft-skill attributes of a desk officer. Double chin, bulging belly testing the tensile strength of the lower two buttons of his fatigue top, and wired-rimmed glasses that sat atop a pointed nose with mismatched nostrils."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fatigue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "690967d8-ca12-366a-a74c-c82d1e015528",
                                        "entry_id": "c373e141-b8be-394c-91be-bd2dccd31734",
                                        "glosses": [
                                            "To tire or make weary by physical or mental exertion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3df16b1-0dff-3a9e-ade0-a9a27ceddca5",
                                        "entry_id": "c373e141-b8be-394c-91be-bd2dccd31734",
                                        "glosses": [
                                            "To wilt a salad by dressing or tossing it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043e3616-ee80-4258-a3fc-76559c3718cf",
                                                "sense_id": "c3df16b1-0dff-3a9e-ade0-a9a27ceddca5",
                                                "text": "The handsome, silver-haired proprietor was absorbed in fatiguing a salad for a family party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db7e11e5-df08-357d-bd0b-a47ff643b39c",
                                        "entry_id": "c373e141-b8be-394c-91be-bd2dccd31734",
                                        "glosses": [
                                            "To lose so much strength or energy that one becomes tired, weary, feeble or exhausted."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e14466d-65ec-3b66-97c0-1f9afca37e7f",
                                        "entry_id": "c373e141-b8be-394c-91be-bd2dccd31734",
                                        "glosses": [
                                            "To undergo the process of fatigue; to fail as a result of fatigue."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd41d152-421e-3dbf-9b53-14eae46cd36d",
                                        "entry_id": "c373e141-b8be-394c-91be-bd2dccd31734",
                                        "glosses": [
                                            "To cause to undergo the process of fatigue."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "965f7fa8-981c-40a3-8c69-0df766e19a45",
                                                "sense_id": "dd41d152-421e-3dbf-9b53-14eae46cd36d",
                                                "text": "The repeated pressurization cycles fatigued the airplane's metal skin until it eventually broke up in flight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
