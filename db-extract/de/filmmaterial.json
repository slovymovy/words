                        "form": "die Filmmaterialien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52051658-9c5b-34d6-a773-a46e04251c9d",
                        "entry_id": "fa063b5b-9ca8-364d-8c48-e8c0ba328512",
                        "glosses": [
                            "physischer Träger (Filmstreifen) fotografischer Aufnahmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "131bff31-5f29-4912-ae37-08626b7a3d18",
                                "sense_id": "52051658-9c5b-34d6-a773-a46e04251c9d",
                                "text": "Zelluloid wird beispielsweise als Filmmaterial verwendet."
                            },
                            {
                                "example_id": "5575acb6-73b5-4b6c-8345-a788e1bae6d9",
                                "sense_id": "52051658-9c5b-34d6-a773-a46e04251c9d",
                                "text": "„Filmmaterial bezeichnet den physischen Träger des Mediums Film, also einen fotografischen Filmstreifen in einem definierten Aufnahmeformat.“"
                            },
                            {
                                "example_id": "8a00639e-f39f-408b-a15c-44b72d24c1a3",
                                "sense_id": "52051658-9c5b-34d6-a773-a46e04251c9d",
                                "text": "„Er umfasst den Zeitraum Februar bis August 1945, erst in Berlin, dann in Mayrhofen in Tirol, wohin er und eine Gruppe von Filmleuten sich zurückgezogen hatten, um einen Film zu drehen, offiziell im Auftrag des Propagandaministeriums, in Wahrheit, um den Bomben auf Berlin zu entgehen – ein riskantes Unternehmen, denn Filmmaterial gab es nicht, die Kameras waren leer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "426aac4c-5fcd-3396-875c-1caf48f1f805",
                        "entry_id": "fa063b5b-9ca8-364d-8c48-e8c0ba328512",
                        "glosses": [
                            "Gesamtheit aller Einzelbilder auf [1], die als Abfolge bewegte Szenen darstellen; Sammelbegriff für Videoaufnahmen"
                        ],
                        "tags": [
                            "in der Digitaltechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "f72cb2b1-173a-4289-a5bd-67814814e920",
                                "sense_id": "426aac4c-5fcd-3396-875c-1caf48f1f805",
                                "text": "„‚[…] Zehn Jahre lang hat Lutz Hachmeister an seinem Film gearbeitet, der nur aus historischem Filmmaterial und Zitaten aus Goebbels‘ Tagebüchern besteht.“"
                            },
                            {
                                "example_id": "9bd7ae8c-874c-4e3c-aa23-03767f002f0f",
                                "sense_id": "426aac4c-5fcd-3396-875c-1caf48f1f805",
                                "text": "„Das Zweite Deutsche Fernsehen (ZDF) hat bislang unentdecktes Filmmaterial über die Fußball-Weltmeisterschaft 1954 in der Schweiz gefunden.“"
                            },
                            {
                                "example_id": "ced460f7-8056-400b-bf37-a8d1bc97a9c9",
                                "sense_id": "426aac4c-5fcd-3396-875c-1caf48f1f805",
                                "text": "„Das Filmmaterial mit der vulgären Aussage Johnsons sollte eigentlich in einer Dokumentation der BBC gezeigt werden.“"
                            },
                            {
                                "example_id": "768f8d7e-2063-42b0-bb1d-da1284b25b31",
                                "sense_id": "426aac4c-5fcd-3396-875c-1caf48f1f805",
                                "text": "„Michael Kloft, der große Kenner des historischen Filmmaterials, hat mit ihm das Drehbuch geschrieben.“"
                            },
                            {
                                "example_id": "6a1cf8f5-5f45-40f7-aab9-6e05fc6e0b7d",
                                "sense_id": "426aac4c-5fcd-3396-875c-1caf48f1f805",
                                "text": "„Dazu simulierten er und sein Kameramann James Laxton die farbliche Tongebung unterschiedlicher Filmmaterialien, was den einzelnen Teilen eine je eigene Anmutung gibt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "434c36bd-e553-4b9d-a144-e7436f8137b1",
                        "source_entry_id": "fa063b5b-9ca8-364d-8c48-e8c0ba328512",
                        "source_sense_id": "52051658-9c5b-34d6-a773-a46e04251c9d",
                        "source_sense_description": "physischer Träger (Filmstreifen) fotografischer Aufnahmen",
                        "target_lang_word": "footage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "footage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "268dd23c-ef16-37fb-ac13-c96254fbdb01",
                                        "entry_id": "322ebb61-4dac-3da0-ad96-5bd8c421931c",
                                        "glosses": [
                                            "An amount of film or tape that has been used to record something."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3092027-fe40-411f-96a5-2a2fd9cab136",
                                                "sense_id": "268dd23c-ef16-37fb-ac13-c96254fbdb01",
                                                "text": "The footage we shot at the riot yesterday got ruined."
                                            },
                                            {
                                                "example_id": "724d3802-dc97-4bd0-8329-7c42707e2a73",
                                                "sense_id": "268dd23c-ef16-37fb-ac13-c96254fbdb01",
                                                "text": "The footage of this scene has been re-used in several later films where a good, convincing train smash was required, notably in \"Seven Sinners\" (1937)."
                                            },
                                            {
                                                "example_id": "3ba69a32-53c9-499e-8f0b-32dbd24ae31c",
                                                "sense_id": "268dd23c-ef16-37fb-ac13-c96254fbdb01",
                                                "text": "The weaponry at their disposal was said and shown in numerous video footages to be mainly small arms and anti-tank rocket launchers, etc.—the 'classical' arms of the guerrilla."
                                            },
                                            {
                                                "example_id": "46d6de4a-8293-44cc-ac1c-08381c46388f",
                                                "sense_id": "268dd23c-ef16-37fb-ac13-c96254fbdb01",
                                                "text": "“The footages were sick and sickening – portraying adults engaging in sexual acts with each other and performing sexual acts on infants and children, in addition to physically abusing them,” the lawsuit said, adding that Zoom admitted the hacker was a “known serial offender” who had been reported “multiple times to the authorities.”"
                                            },
                                            {
                                                "example_id": "43fc4173-64aa-49fe-8e13-36f4300cadae",
                                                "sense_id": "268dd23c-ef16-37fb-ac13-c96254fbdb01",
                                                "text": "The sheriff’s office released a compilation of bodycam footage Friday from deputies at the scene that shows them handcuffing Earl and pinning him down for more than 20 minutes as he struggles and repeatedly shouts for help."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50aca43f-77f9-39ce-9cac-8d69ed8fba37",
                                        "entry_id": "322ebb61-4dac-3da0-ad96-5bd8c421931c",
                                        "glosses": [
                                            "A measurement in feet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8dc7560-1bf5-4d5d-ae13-1870375beb72",
                                                "sense_id": "50aca43f-77f9-39ce-9cac-8d69ed8fba37",
                                                "text": "[…]more and more contractors are buying Southern pine in greater footages per order."
                                            },
                                            {
                                                "example_id": "b875f10a-124c-474f-96cb-115b0d758474",
                                                "sense_id": "50aca43f-77f9-39ce-9cac-8d69ed8fba37",
                                                "text": "Starting footages should go above the line at the start of the sound and finishing footages beneath the line at the end of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
