                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6ca5118f-b14f-4adb-9c80-7eaf8a32a6b5",
                        "source_entry_id": "c9ec3a3d-051a-3f67-9937-998c4bfa1e96",
                        "source_sense_id": "3f30597b-b5e5-3174-aad9-ab842fec720d",
                        "source_sense_description": "Islamic fasting",
                        "target_lang_word": "Saum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d6e1f92-0522-39e8-8cf7-bf531258d348",
                                        "entry_id": "9c993b9d-ebed-32b5-a455-982c61f0fc16",
                                        "glosses": [
                                            "Einfassung eines Stoffstücks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bceccb5d-371b-4a08-8262-02022ae6c766",
                                                "sense_id": "6d6e1f92-0522-39e8-8cf7-bf531258d348",
                                                "text": "Zum Schluss versah er das Tischtuch noch mit einem Saum aus Samt."
                                            },
                                            {
                                                "example_id": "b9b00a5a-8725-411c-95ac-0b514c5b35ce",
                                                "sense_id": "6d6e1f92-0522-39e8-8cf7-bf531258d348",
                                                "text": "„Sie trug nichts darunter, und ihre Brustwarzen stießen spitz durch den leichten Stoff und ließen ihn in zwei schmalen, abstehenden Falten bis zum Saum fallen.“"
                                            },
                                            {
                                                "example_id": "49ca5b26-d8f7-4652-849f-fd1e7c532a5f",
                                                "sense_id": "6d6e1f92-0522-39e8-8cf7-bf531258d348",
                                                "text": "„Ich setzte mich neben sie auf die Holzbank und spielte mit den Fingern am Saum meines Hemdes.“"
                                            },
                                            {
                                                "example_id": "e0a2bbd2-2dcf-4931-891e-93be0b38f2b4",
                                                "sense_id": "6d6e1f92-0522-39e8-8cf7-bf531258d348",
                                                "text": "„Sólveig zupfte am Saum ihrer Jacke und fuhr dann fort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9ab38a0-6dc9-3f91-b5ea-866279f7b145",
                                        "entry_id": "9c993b9d-ebed-32b5-a455-982c61f0fc16",
                                        "glosses": [
                                            "Rand eines Geländes oder einer Wasserfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b6e914d-a00b-489f-a995-e38c3f3bf8b7",
                                                "sense_id": "b9ab38a0-6dc9-3f91-b5ea-866279f7b145",
                                                "text": "Der Saum eines Waldes ist für die Tierwelt besonders wichtig."
                                            },
                                            {
                                                "example_id": "859e57c0-ddde-4f6e-be67-7c285ae13b5e",
                                                "sense_id": "b9ab38a0-6dc9-3f91-b5ea-866279f7b145",
                                                "text": "„Die ungeheure Bergkette um sich herum empfand er wie einen dunkleren Saum am Nachthimmel.“"
                                            },
                                            {
                                                "example_id": "0d61ca3d-42e5-4689-9763-f6c6d430711f",
                                                "sense_id": "b9ab38a0-6dc9-3f91-b5ea-866279f7b145",
                                                "text": "„Die Säume der Wolken glühten golden, und im Osten zog es schwarz herauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "773e1359-0a0f-4f98-8451-2f5afd83bda8",
                        "source_entry_id": "c9ec3a3d-051a-3f67-9937-998c4bfa1e96",
