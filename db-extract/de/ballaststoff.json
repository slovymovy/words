                    {
                        "sense_id": "3399685e-36f5-3b1e-abe4-4961af4638a1",
                        "entry_id": "67c2552d-fd74-3bd2-bef8-075222170662",
                        "glosses": [
                            "für den menschlichen Organismus nicht verwertbare, längerkettige Kohlenhydrate, die vorwiegend in pflanzlichen Lebensmitteln vorkommen"
                        ],
                        "tags": [
                            "Ernährung"
                        ],
                        "examples": [
                            {
                                "example_id": "1ab71f41-eaf1-4ab3-8971-999fc1554669",
                                "sense_id": "3399685e-36f5-3b1e-abe4-4961af4638a1",
                                "text": "Ballaststoffe sind gesund und förderlich für die gute Verdauung."
                            },
                            {
                                "example_id": "81706a22-1cdd-426e-9043-e0a25f4e1897",
                                "sense_id": "3399685e-36f5-3b1e-abe4-4961af4638a1",
                                "text": "Ballaststoffe machen einen wichtigen Bestandteil der menschlichen Nahrung aus."
                            },
                            {
                                "example_id": "69b84b89-abb6-4e9f-8a87-c7b9a26b5b83",
                                "sense_id": "3399685e-36f5-3b1e-abe4-4961af4638a1",
                                "text": "„Der Begriff Ballaststoff stammt noch aus einer Zeit, in der man diese Nahrungsbestandteile als überflüssigen Ballast angesehen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
