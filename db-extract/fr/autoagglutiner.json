                        "glosses": [
                            "S’agglutiner sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f5cffb0-2cc8-4c5d-b66a-be46b0de8dea",
                                "sense_id": "e78128e5-1dfa-37c3-9ca5-f3b5d1430bf9",
                                "text": "Certains FR, notamment lgG, peuvent s'autoagglutiner en formant des polymères."
                            },
                            {
                                "example_id": "46b8af57-e3b4-4223-add7-9c2bd69a59b1",
                                "sense_id": "e78128e5-1dfa-37c3-9ca5-f3b5d1430bf9",
                                "text": "Il faut également s'assurer que les microbes n'autoagglutinent pas dans la sérosité même, comme cela se produit parfois pour le B. œdpmatiens, le B. fallax, etc."
                            }
