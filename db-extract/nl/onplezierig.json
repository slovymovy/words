                                                "sense_id": "8857ddb0-2053-3bf3-98a7-feafb33ecff7",
                                                "text": "Processed foods are full of aspartame and other nasties."
                                            },
                                            {
                                                "example_id": "24386e15-63d7-48b4-aaac-9a2f11cf3277",
                                                "sense_id": "8857ddb0-2053-3bf3-98a7-feafb33ecff7",
                                                "text": "This video game involves flying through a maze zapping various nasties."
                                            },
                                            {
