                        "glosses": [
                            "geld dat ouders van kinderen moeten betalen voor een bepaalde dienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37b40abf-d567-4a99-9ad7-114aceb6d399",
                                "sense_id": "ad4ef62d-8c45-317e-9f39-fc80c3eaa21b",
                                "text": "\"Ik weet niet wat ik hier mee kan\", zegt ze. \"Het is allemaal zo vaag. Veel is zwart gemaakt en op andere plaatsen zie ik namen staan die ik juist niet zou moeten lezen. Ik zie de ouderbijdrage van een andere vrouw staan en haar naam staat er gewoon bij. Dat kan toch niet?\""
                            }
                        ]
