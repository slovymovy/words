                ],
                "senses": [
                    {
                        "sense_id": "bfa2ecca-0b12-3e98-9f68-dd3a3f7ba399",
                        "entry_id": "0d1e69dd-6e3b-32cc-9ddd-3aa7774e1112",
                        "glosses": [
                            "Vertrag, der für einen Vertragspartner sehr nachteilig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76011306-8af8-43a1-b851-b4fb1338cc54",
                                "sense_id": "bfa2ecca-0b12-3e98-9f68-dd3a3f7ba399",
                                "text": "„Die Modelverträge werden von Fachleuten als Knebelverträge bezeichnet, welche sogar aufgrund der Sittenwidrigkeit als unwirksam anzusehen sind.“"
                            },
                            {
                                "example_id": "b08df1dc-159f-4a77-af9b-386f6c4ad1bc",
                                "sense_id": "bfa2ecca-0b12-3e98-9f68-dd3a3f7ba399",
                                "text": "„[Die Ukraine] hat […] einen Knebelvertrag mit Russland, der hohe Importpreise für Gas determiniert, das heißt, man muss sehr, sehr viel an Russland zahlen.“"
                            },
                            {
                                "example_id": "b1cc8118-7b5a-4a07-9422-300d6a895594",
                                "sense_id": "bfa2ecca-0b12-3e98-9f68-dd3a3f7ba399",
                                "text": "„Ein weiteres Problem bei Tierversicherungen sind die Knebelverträge: Animalia zum Beispiel, die Haustierversicherung der Vaudoise, bindet im Kleingedruckten den Versicherungsnehmer fünf Jahre an sich.“"
                            },
                            {
                                "example_id": "6e8be8c3-06e2-4f07-896f-4e496e6aed3a",
                                "sense_id": "bfa2ecca-0b12-3e98-9f68-dd3a3f7ba399",
                                "text": "„Die Windkraftklausel besagte, dass die BVVG viel Geld oder sogar die Grundstücke zurück verlangen kann, falls die Landwirte Windkrafträder aufstellen. Die obersten Richter in Karlsruhe bezeichneten die Regelungen als Knebelverträge.“"
                            },
                            {
                                "example_id": "acb3af4e-87e6-4bfb-bfa9-452f75796b7d",
                                "sense_id": "bfa2ecca-0b12-3e98-9f68-dd3a3f7ba399",
                                "text": "Zu Vorsicht rät [Anne Hausmann von der Verbraucherzentrale] auch bei Ratenzahlungsangeboten. In der Regel müssten die Kunden Knebelverträge akzeptieren, beispielsweise Lohnabtretungen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
