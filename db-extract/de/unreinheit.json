                    {
                        "form_id": "4e3e9e44-3e5c-4a38-a824-4f8d2c2bd9e5",
                        "entry_id": "34d69862-7c37-3f0e-9f1d-eba7a7689d6c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Unreinheiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "83aac55f-44a7-3715-81d4-7d0d37a219d3",
                        "entry_id": "34d69862-7c37-3f0e-9f1d-eba7a7689d6c",
                        "glosses": [
                            "Eigenschaft, nicht rein, sauber, also in gewisser Weise verunreinigt zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebccaa22-ef94-48ce-8068-60a46562b9e7",
                                "sense_id": "83aac55f-44a7-3715-81d4-7d0d37a219d3",
                                "text": "„Wegen angeblicher Unreinheit verbietet Rußland Wein-Importe aus Moldau und Georgien.“"
                            },
                            {
                                "example_id": "f6251f07-ada1-4701-99fb-f60e29f38272",
                                "sense_id": "83aac55f-44a7-3715-81d4-7d0d37a219d3",
                                "text": "„In der arabischen Welt gibt es wohl kein anderes Kleidungsstück, mit dem sich mehr Verachtung ausdrücken ließe: Der Schuh gilt als Inbegriff von Unreinheit und Schmutz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c4b570d7-5808-3a25-bbf4-8928aed633ce",
                        "entry_id": "34d69862-7c37-3f0e-9f1d-eba7a7689d6c",
                        "glosses": [
                            "etwas, was [1] ausmacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c33ffe6e-7927-4c4a-9e7d-b2743944e3d6",
                                "sense_id": "c4b570d7-5808-3a25-bbf4-8928aed633ce",
                                "text": "„Eine übermäßige Talgproduktion der Haut kann zu fettiger Haut führen und Unreinheiten begünstigen.“"
                            },
                            {
                                "example_id": "af6568d5-4c49-49d1-8acd-321818f485f6",
                                "sense_id": "c4b570d7-5808-3a25-bbf4-8928aed633ce",
                                "text": "„Falten, Unreinheiten, Pigmentflecken sowie ein fahler Teint lassen sich demnach nicht nur auf schädliche UV-Strahlen zurückführen, sondern angeblich auch auf Feinstaub aus Autoabgasen, Industrie-Emissionen, Smog und Rauch.“"
                            },
                            {
                                "example_id": "672c8db9-bfc2-4c15-8ba3-92dbca4ea71a",
                                "sense_id": "c4b570d7-5808-3a25-bbf4-8928aed633ce",
                                "text": "„Die Deckkraft kann sich sehen lassen: Rötungen und Unreinheiten sind komplett verschwunden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a3017d1-6719-4af1-abd2-aecb629cbff4",
                        "source_entry_id": "34d69862-7c37-3f0e-9f1d-eba7a7689d6c",
                        "source_sense_id": "83aac55f-44a7-3715-81d4-7d0d37a219d3",
                        "source_sense_description": "Eigenschaft, nicht rein, sauber, also in gewisser Weise verunreinigt zu sein",
                        "target_lang_word": "impureté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impureté",
