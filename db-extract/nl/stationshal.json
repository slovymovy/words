                    {
                        "sense_id": "70101a86-e581-358c-83d5-660f7420aafb",
                        "entry_id": "3e4217d5-74b2-3507-8a7a-129bcc07a2c1",
                        "glosses": [
                            "de centrale hal van een station met de in- en uitgang van dat station"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b23c80b9-fccb-40be-a37f-85a4431870f2",
                                "sense_id": "70101a86-e581-358c-83d5-660f7420aafb",
                                "text": "Ze maakten buiten een ommetje onder het reusachtige afdak van de vooringang en kwamen alleen nu en dan vanuit de stationshal kijken of het nog geen tijd was om zich bij de ouderen te voegen."
                            },
                            {
                                "example_id": "60018914-3bf2-4350-80b6-087490433e65",
                                "sense_id": "70101a86-e581-358c-83d5-660f7420aafb",
                                "text": "Met regelmaat stond Kox voor de rechter. Boze winkeliers hadden last van zijn forse stemgeluid en probeerden dat in 2008 via de rechtbank te stoppen. Maar ze vingen bot: de stadsprediker werd vrijgesproken. Ook een poging van de NS om hem te dwingen niet meer te roepen in de stationshal strandde in de rechtszaal."
                            }
                        ]
                    }
