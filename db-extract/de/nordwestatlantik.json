                "senses": [
                    {
                        "sense_id": "383e3c83-0072-336c-9b88-e9b3efeae493",
                        "entry_id": "584706f2-da01-3ad7-ad50-b301f439f90a",
                        "glosses": [
                            "nicht genau definierter nordwestlicher Teil des Atlantischen Ozeans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba776ac-8e9f-4054-8ac1-5eb9151dbbbe",
                                "sense_id": "383e3c83-0072-336c-9b88-e9b3efeae493",
                                "text": "„Auch die Ausdehnung der Hoheitsgewässer auf 12 Seemeilen durch Island 1958 trug dazu bei, dass die Fangplätze im Nordwestatlantik höher frequentiert wurden.“"
                            },
                            {
                                "example_id": "579b7743-f8d6-4173-adbc-7ff5d87ee441",
                                "sense_id": "383e3c83-0072-336c-9b88-e9b3efeae493",
                                "text": "„Der Nordwestatlantik ist eines der ältesten kommerziellen Fischfanggebiete der Welt.“"
                            },
                            {
                                "example_id": "b480e31d-cb5c-4bd4-8ec9-f55963844291",
                                "sense_id": "383e3c83-0072-336c-9b88-e9b3efeae493",
                                "text": "„Wir segelten im Nordwestatlantik, wo wir uns auf einer Insel reichlich mit frischen Früchten und Gemüsen eingedeckt hatten.“"
                            },
                            {
                                "example_id": "8a6f6775-2a04-497c-85b5-de8d4fc6c494",
                                "sense_id": "383e3c83-0072-336c-9b88-e9b3efeae493",
                                "text": "„Der Schwerpunkt liegt heute im Nordwestatlantik zwischen Grönland und Neufundland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
