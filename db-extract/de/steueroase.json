                    {
                        "form_id": "d8483c19-902b-414f-b0f5-99482730c856",
                        "entry_id": "952f8c6a-0361-3622-a0a6-d512134534fb",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Steueroase"
                    },
                    {
                        "form_id": "22f06a7d-0292-4dc6-aa2f-58d0acfa95f9",
                        "entry_id": "952f8c6a-0361-3622-a0a6-d512134534fb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Steueroasen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a67a437-33bf-34d5-b5a0-4a576bf8f66e",
                        "entry_id": "952f8c6a-0361-3622-a0a6-d512134534fb",
                        "glosses": [
                            "Staaten oder Gebiete, die besonders niedrige Steuern erheben und dadurch Personen oder Unternehmen aus sog. Hochsteuerstaaten zum Wohnsitz- oder Betriebssitzwechsel in die Steueroase veranlassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79be9aae-3aba-495b-ab4c-5fee19d7b78a",
                                "sense_id": "7a67a437-33bf-34d5-b5a0-4a576bf8f66e",
                                "text": "Manche Millionäre ziehen in eine Steueroase um hohe Steuern zu umgehen."
                            },
                            {
                                "example_id": "3519c8a8-395e-4139-8422-4046ff134c53",
                                "sense_id": "7a67a437-33bf-34d5-b5a0-4a576bf8f66e",
                                "text": "Wer viel Geld verdient, aber möglichst wenig Steuern bezahlen möchte, der weicht in eine Steueroase aus: zum Beispiel Deutschland, wo die Behörden ein großes Herz haben für Leute, die ihre Steuern kreativ gestalten."
                            },
                            {
                                "example_id": "e264b824-df48-4a7f-9d00-c744beec4eb3",
                                "sense_id": "7a67a437-33bf-34d5-b5a0-4a576bf8f66e",
                                "text": "Die Drohung mit einer weiteren \"schwarzen\" OECD-Liste unkooperativer Staaten brachte europäische, als Steueroasen verschriene Länder wie Lichtenstein, Andorra oder Monaco dazu, ihr striktes Bankgeheimnis zumindest zu lockern."
                            },
                            {
                                "example_id": "20c68c7a-cf0f-4cd1-8608-f0bf2fe8b571",
                                "sense_id": "7a67a437-33bf-34d5-b5a0-4a576bf8f66e",
                                "text": "[Niederlande:] Das Land an der Nordsee ist für ausländische Firmen und Superreiche eine beliebte Steueroase."
                            },
                            {
                                "example_id": "55e52661-221e-4af6-9f9a-1d473a5f1564",
                                "sense_id": "7a67a437-33bf-34d5-b5a0-4a576bf8f66e",
                                "text": "Wer Steueroase hört, denkt gewöhnlich an Inseln mit weitem Sandstrand, Palmen, Yachthäfen und vielen Briefkästen. Unser westliches Nachbarland [Niederlande] hat in diesem Zusammenhang kaum jemand auf dem Plan."
                            },
                            {
                                "example_id": "85f4ed8a-e98d-4799-8350-a8615c127871",
                                "sense_id": "7a67a437-33bf-34d5-b5a0-4a576bf8f66e",
                                "text": "„Die Schweiz ist von Haus aus als Steueroase bekannt, seit dem Ersten Weltkrieg.“"
                            },
                            {
                                "example_id": "55faa579-1497-4711-b0d3-524264fca676",
                                "sense_id": "7a67a437-33bf-34d5-b5a0-4a576bf8f66e",
                                "text": "„Steuerbehörden der Hochsteuerländer kämpfen lieber gegen andere Hochsteuerländer statt gegen Steueroasen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3edf9fcb-b104-4132-a2fb-cc7467bb449d",
                        "source_entry_id": "952f8c6a-0361-3622-a0a6-d512134534fb",
                        "source_sense_id": "7a67a437-33bf-34d5-b5a0-4a576bf8f66e",
                        "target_lang_word": "tax haven",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tax haven",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc5cf4a9-c5dc-355e-b057-c7bf3dd69e4e",
                                        "entry_id": "51447507-fad6-3222-b459-ebf080d22d2b",
                                        "glosses": [
                                            "A jurisdiction that levies low tax rates on certain economic activities, especially to attract wealthy individuals and foreign businesses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94c7b08-a978-4775-b883-3225e48974f8",
                                                "sense_id": "cc5cf4a9-c5dc-355e-b057-c7bf3dd69e4e",
                                                "text": "Such colonies claim to be \"more British than the British\", except that they pay no UK tax and act as tax havens for funds from Britain. Gibraltar has made a particular specialism of internet gambling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a5dc55b-0811-42c8-80c0-9a8c805c2a9e",
                        "source_entry_id": "952f8c6a-0361-3622-a0a6-d512134534fb",
                        "source_sense_id": "7a67a437-33bf-34d5-b5a0-4a576bf8f66e",
                        "target_lang_word": "paradis fiscal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paradis fiscal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8935ec1e-09ac-3899-b511-9bb2d1f1e6b1",
                                        "entry_id": "ebef9831-f4ee-3c64-b8ea-b7cc3fe4369b",
                                        "glosses": [
                                            "Territoire où la fiscalité très faible et l’opacité de la législation favorisent l’évasion fiscale ou l’optimisation fiscale, et qui limite ou refuse l’échange d’informations avec d’autres juridictions."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "020ebf9a-1a3c-4dff-b002-d9f8e4d7de1d",
                                                "sense_id": "8935ec1e-09ac-3899-b511-9bb2d1f1e6b1",
                                                "text": "Enfin, ces deux procédés peuvent être combinés, par exemple en interposant une société écran située dans un paradis fiscal."
                                            },
                                            {
                                                "example_id": "6940cace-7937-44cf-b028-9b8f78a00114",
                                                "sense_id": "8935ec1e-09ac-3899-b511-9bb2d1f1e6b1",
                                                "text": "Où l’on est bien, là est la patrie, est un thème qui ne pourra guère être contredit que par la suppression des « paradis fiscaux »."
                                            },
                                            {
                                                "example_id": "318cf7a3-6e3e-4286-8b1c-57cca73bbd8b",
                                                "sense_id": "8935ec1e-09ac-3899-b511-9bb2d1f1e6b1",
                                                "text": "J’ai intrigué beaucoup de mes amis en venant vivre en Suisse. Le gens qui me connaissent peu ont spontanément conclu que, gagnant quelque argent, je m’étais réfugié dans un « paradis fiscal »."
                                            },
                                            {
                                                "example_id": "64100b20-9f71-41c3-a289-28bc5c43f5f8",
                                                "sense_id": "8935ec1e-09ac-3899-b511-9bb2d1f1e6b1",
                                                "text": "Ainsi, pour le ministre des Finances, « bien que la Suisse veille à maintenir un système fiscal attrayant avec une charge fiscale compétitive sur le plan international, elle n’est pas un paradis fiscal »."
                                            },
                                            {
                                                "example_id": "b2690636-f89f-4124-988d-2ccdfcb6c976",
                                                "sense_id": "8935ec1e-09ac-3899-b511-9bb2d1f1e6b1",
                                                "text": "Tout passait par les banques anglo-saxonnes. … les sociétés écrans se trouvaient à Hong Kong, aux îles Caïman et dans d’autres paradis fiscaux des Caraïbes et d’ailleurs."
                                            },
                                            {
                                                "example_id": "73fff371-78eb-4a0a-9f75-fb0a767442fe",
                                                "sense_id": "8935ec1e-09ac-3899-b511-9bb2d1f1e6b1",
                                                "text": "Des « Panama Papers » aux « Paradise Papers », les citoyens sidérés découvrent les montants astronomiques que les États, de connivence avec la finance mafieuse, les multinationales et les grandes fortunes, ont laissé fuir et se cacher dans les paradis fiscaux : pas moins et sûrement plus de 20 000 milliards d’euros."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1558ab59-87a0-42ed-aa9a-945d155ef89c",
                        "source_entry_id": "952f8c6a-0361-3622-a0a6-d512134534fb",
