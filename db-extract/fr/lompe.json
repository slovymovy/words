                                        "entry_id": "993d366b-0d1e-38b3-84d7-97e7acf26f54",
                                        "glosses": [
                                            "60 cm langer, plumper, schuppenloser Fisch (Cyclópterus lúmpus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
