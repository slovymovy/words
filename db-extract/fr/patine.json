        "fr-extract.jsonl": [
            {
                "entry_id": "ac609605-648f-33e3-8cba-b22d61a1c0d7",
                "word": "patine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d59190c8-5813-4d03-b64e-29f169f6e8d8",
                        "entry_id": "ac609605-648f-33e3-8cba-b22d61a1c0d7",
                        "tags": [
                            "plural"
                        ],
                        "form": "patines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "48186e58-f2fb-3b09-b787-574db822c8ad",
                        "entry_id": "ac609605-648f-33e3-8cba-b22d61a1c0d7",
                        "glosses": [
                            "Vert-de-gris se formant sur les objets en cuivre ou en bronze."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a50b595-a018-4e09-94f5-b2211450e55a",
                                "sense_id": "48186e58-f2fb-3b09-b787-574db822c8ad",
                                "text": "La patine des statues et des médailles antiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "5af3e784-d8ad-3cda-8ee7-ad06027db13e",
                        "entry_id": "ac609605-648f-33e3-8cba-b22d61a1c0d7",
                        "glosses": [
                            "Teinte que le temps ou l’action humaine donne aux objets anciens, statues, peintures, ivoires, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "640042ab-e604-4aae-823e-1aa3d4b9bffe",
                                "sense_id": "5af3e784-d8ad-3cda-8ee7-ad06027db13e",
                                "text": "Ici, cependant, la merde est un objet de culte. La patine n'est pas autre chose qu'une cochonnerie que le temps accumule sur les immeubles, sur les objets, sur les meubles, etc."
                            },
                            {
                                "example_id": "e69a7fec-0df6-4629-8949-8c45a7a4e182",
                                "sense_id": "5af3e784-d8ad-3cda-8ee7-ad06027db13e",
                                "text": "La patine de l’ancien se vend bien, elle contribue au « chic » français et notre patrimoine n’est-il pas, aux côtés de nos beaux paysages, notre atout majeur…"
                            },
                            {
                                "example_id": "e990d1fc-9e1f-4632-81c8-2bcbd27ce0c4",
                                "sense_id": "5af3e784-d8ad-3cda-8ee7-ad06027db13e",
                                "text": "De telles figures offrent généralement une patine totale, certaines sont dépatinées."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d4bc3d6-bd73-36d7-96d6-aed57326f3b2",
                        "entry_id": "ac609605-648f-33e3-8cba-b22d61a1c0d7",
                        "glosses": [
                            "Belle teinte, couleur agréable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc69cef-9ff4-46d2-ae8f-fe9929eb5d2a",
                                "sense_id": "6d4bc3d6-bd73-36d7-96d6-aed57326f3b2",
                                "text": "Sur son église [Marcouville], moitié neuve, moitié restaurée, le soleil déclinant étendait sa patine aussi belle que celle des siècles."
                            }
                        ]
                    },
                    {
                        "sense_id": "834dc8f9-186b-3474-9976-f21e54d5a8eb",
                        "entry_id": "ac609605-648f-33e3-8cba-b22d61a1c0d7",
                        "glosses": [
                            "Altérations physiques et chimiques de la surface d’une roche par l’action des éléments climatiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51d68d7e-ccb3-4d6a-b7c4-daf27ef4e3a2",
                                "sense_id": "834dc8f9-186b-3474-9976-f21e54d5a8eb",
                                "text": "La couleur d’un même type de roche est très variable selon la patine qu’elle prend au cours des âges géologiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2318b42-3749-3d10-948d-b124337c9f47",
                        "entry_id": "ac609605-648f-33e3-8cba-b22d61a1c0d7",
                        "glosses": [
                            "Technique de coloration et décoloration du cuir par l'application de teintures et de solvants, utilisée en botterie et maroquinerie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ddab8900-a562-32db-9be5-23a4e7826549",
                        "entry_id": "ac609605-648f-33e3-8cba-b22d61a1c0d7",
                        "glosses": [
                            "Changement dû au temps."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "76fdedd0-a20b-4335-bd7a-48c1d6d20466",
                                "sense_id": "ddab8900-a562-32db-9be5-23a4e7826549",
                                "text": "Simplement, le droit et les habitudes réagissent toujours avec un temps de retard, ce qui leur donne parfois cette patine vieillotte qu’on appelle « archaïsme »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91d620ee-fd5f-4eaf-ba70-3effd3d55b85",
                        "source_entry_id": "ac609605-648f-33e3-8cba-b22d61a1c0d7",
                        "source_sense_description": "teinte prise par un métal oxydé, par un objet vieilli",
                        "target_lang_word": "Patina",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patina",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86ba7016-24ed-3019-9439-54235cce174f",
                                        "entry_id": "46b0402b-7141-33f9-8888-18e4d91ea760",
                                        "glosses": [
                                            "bei der Alterung entstehende Veränderung von Oberflächen in Struktur und Farbe, vor allem bei kupferhaltigen Metallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e13348e-2bbc-46de-8d40-631773d43c8a",
                                                "sense_id": "86ba7016-24ed-3019-9439-54235cce174f",
                                                "text": "„Das Kupfer hat durch die Bildung von Patina eine grüne Farbe angenommen.“"
                                            },
                                            {
                                                "example_id": "7a729f25-70e1-42e0-8d2d-7a13d36229de",
                                                "sense_id": "86ba7016-24ed-3019-9439-54235cce174f",
                                                "text": "„Doch konnte ihm zugleich nicht entgehen, dass die würdevolle Oberfläche bereits Patina angesetzt hatte.“"
                                            },
                                            {
                                                "example_id": "a637488f-2971-4fde-bcb3-fa5c1a3b7560",
                                                "sense_id": "86ba7016-24ed-3019-9439-54235cce174f",
                                                "text": "„Blickt Gerdelmann weiter nach rechts, schimmert dort die hellgrüne Patina des Kupferdachs eines Turms.“"
                                            },
                                            {
                                                "example_id": "459e6be6-ebbd-4456-926f-e1711dcce1cc",
                                                "sense_id": "86ba7016-24ed-3019-9439-54235cce174f",
                                                "text": "„Auf die Decken des neuen Berliner Hotels Adlon wurden winzige Risse gemalt, um Patina vorzutäuschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
