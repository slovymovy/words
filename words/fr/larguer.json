    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d3c7e3f-1f99-3baf-a7db-b9992a7a5509",
                    "sense_definition": "Rompre une relation amoureuse avec quelqu'un ou l'abandonner brusquement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relation_amoureuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de le <w>larguer</w> après avoir découvert ses nombreux mensonges."
                        },
                        {
                            "text": "Mon meilleur ami vient de se faire <w>larguer</w> par sa petite amie hier soir."
                        }
                    ],
                    "synonyms": [
                        "plaquer",
                        "quitter",
                        "abandonner"
                    ],
                    "common_phrases": [
                        "larguer son copain",
                        "se faire larguer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "90cf6e25-319f-3a62-af04-450bf6aaf47a",
                    "sense_definition": "Faire tomber ou lâcher dans les airs du matériel, une charge ou des personnes depuis un aéronef.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lacher_aerien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avion humanitaire va <w>larguer</w> des vivres et des médicaments aux populations isolées."
                        },
                        {
                            "text": "Les forces aériennes ont <w>largué</w> les parachutistes au-dessus de la zone désignée."
                        }
                    ],
                    "synonyms": [
                        "lâcher",
                        "parachuter"
                    ],
                    "common_phrases": [
                        "larguer des vivres",
                        "larguer des bombes"
                    ]
                },
                {
                    "sense_id": "954223ae-c871-3964-b3b1-500cdafeb45b",
                    "sense_definition": "Semer ou distancer facilement un adversaire lors d'une course ou d'une compétition.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "competition_vitesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coureur a accéléré dans la dernière montée et a rapidement <w>largué</w> ses poursuivants."
                        },
                        {
                            "text": "Avec sa foulée rapide, elle <w>largue</w> tous les autres concurrents dès le début de la course."
                        }
                    ],
                    "synonyms": [
                        "distancer",
                        "semer"
                    ],
                    "common_phrases": [
                        "larguer le peloton",
                        "larguer ses poursuivants"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "49d625f8-3437-3d52-af1f-8122a4d04258",
                    "sense_definition": "Détacher, délier ou laisser filer un cordage, une voile ou une amarre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "navigation_maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine a ordonné à tout l'équipage de <w>larguer</w> les amarres avant la marée haute."
                        },
                        {
                            "text": "Le marin s'est empressé de <w>larguer</w> l'écoute pour éviter que le voilier ne se renverse."
                        }
                    ],
                    "synonyms": [
                        "lâcher",
                        "détacher"
                    ],
                    "antonyms": [
                        "amarrer"
                    ],
                    "common_phrases": [
                        "larguer les amarres",
                        "larguer l'écoute"
                    ]
                }
            ]
        }
    ]
