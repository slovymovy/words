                                        "sense_id": "45f8d4cb-1edb-30c7-a9a3-994b73a345be",
                                        "entry_id": "fec8184f-5dbf-3a5b-b2eb-1cf92171c7b6",
                                        "glosses": [
                                            "Regarding emotions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "145595d7-477c-4616-9ca2-8e5b2c58379b",
                                                "sense_id": "45f8d4cb-1edb-30c7-a9a3-994b73a345be",
                                                "text": "Physically, it was easy, but emotionally it was the hardest thing I've ever done."
                                            }
