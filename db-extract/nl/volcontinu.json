                    {
                        "sense_id": "1676d8b5-78fe-3099-9ccf-dab44ff03b2f",
                        "entry_id": "80487385-2f8a-3a0b-9bc2-08dca54b9018",
                        "glosses": [
                            "zonder onderbreking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26085af9-e20d-42de-8e45-9168d95e9e36",
                                "sense_id": "1676d8b5-78fe-3099-9ccf-dab44ff03b2f",
                                "text": "Hij en ik waren immers de enigen die volcontinu in het atelier werkten."
                            },
                            {
                                "example_id": "07ca8b8f-7fb4-4cf7-8505-1fcc1c49fd10",
                                "sense_id": "1676d8b5-78fe-3099-9ccf-dab44ff03b2f",
                                "text": "Rendac verwerkt ook slachtafval en dode huisdieren. Hoelang het precies duurt om de driehonderd ton vlees van Offerman te verwerken, durft het bedrijf niet te zeggen. \"Als het bij ons is, kunnen wij het vrij snel verwerken: het is een volcontinu proces, de machines waarin het onder meer wordt gesteriliseerd, werken 24/7 door.\""
                            },
                            {
                                "example_id": "5de6d68a-6f27-4215-b966-93973c1d34ea",
                                "sense_id": "1676d8b5-78fe-3099-9ccf-dab44ff03b2f",
                                "text": "Volgens de leiding van de Doel-kerncentrale waren er de afgelopen tijd echter geen noemenswaardige problemen meer. \"We hebben 365 dagen na elkaar volcontinu gedraaid\", zegt directeur Peter Moens tegen de VRT. \"Heel weinig centrales in de wereld doen ons dat na.\""
                            }
                        ]
                    }
                ],
