    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e37f8f52-468d-3eae-8f65-9a21acbf942d",
                    "sense_definition": "Période qui s'écoule entre le coucher et le lever du soleil, durant laquelle il fait sombre.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il aime lire un livre dans son lit avant de dormir toute la <w>nuit</w>."
                        },
                        {
                            "text": "Je vous souhaite une très bonne <w>nuit</w> et de beaux rêves."
                        }
                    ],
                    "antonyms": [
                        "jour"
                    ],
                    "common_phrases": [
                        "bonne nuit",
                        "toute la nuit",
                        "en pleine nuit",
                        "de nuit"
                    ]
                },
                {
                    "sense_id": "20864145-9ba6-3f53-9a26-cedb09a8f101",
                    "sense_definition": "Obscurité ou ténèbres causées par l'absence totale de lumière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obscurite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La lampe s'est éteinte et nous nous sommes retrouvés dans une <w>nuit</w> noire."
                        },
                        {
                            "text": "Les étoiles brillaient avec éclat au milieu de cette <w>nuit</w> profonde."
                        }
                    ],
                    "common_phrases": [
                        "nuit noire",
                        "nuit profonde"
                    ]
                },
                {
                    "sense_id": "d8eae6d2-fffe-3bcf-9bec-d586f805b36a",
                    "sense_definition": "État d'obscurité morale, de mort, d'oubli ou de néant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "obscurite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain évoque la <w>nuit</w> de l'âme après cette lourde perte."
                        },
                        {
                            "text": "Son esprit semblait s'enfoncer lentement dans une <w>nuit</w> éternelle."
                        }
                    ],
                    "common_phrases": [
                        "nuit éternelle"
                    ]
                }
            ]
        },
