                    {
                        "translation_id": "c828bfce-5aba-4330-a8da-673535a18c8f",
                        "source_entry_id": "c4df872c-539d-34f6-8b3e-0dca87651995",
                        "source_sense_id": "15a87b03-c272-3f96-a62a-3db92aaf6061",
                        "source_sense_description": "weapon similar to a rifle but much shorter in length",
                        "target_lang_word": "Karabiner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karabiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8683da76-32c4-344c-860d-61c699ca243a",
                                        "entry_id": "526c48bf-ccac-3d0c-b6fe-855fbcf0d988",
                                        "glosses": [
                                            "leichtes Militär-Gewehr mit verkürztem Lauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d91d6d39-206f-473a-bc6f-d571a012615b",
                                                "sense_id": "8683da76-32c4-344c-860d-61c699ca243a",
                                                "text": "„Der M4A1 Karabiner wird von der US-Armee und in bestimmten taktischen Situationen auch von verschiedenen zivilen polizeilichen Einheiten wie FBI oder SWAT verwendet.“"
                                            },
                                            {
                                                "example_id": "4e70be57-7f10-4367-9e1e-90eb64e0b905",
                                                "sense_id": "8683da76-32c4-344c-860d-61c699ca243a",
                                                "text": "„Sie hängten sich die Karabiner um, schulterten die Panzerfäuste, nahmen die Kisten mit Munition und Handgranaten auf und bewegten sich in der einzigen Gangart, die das Gewicht der Waffen erlaubte…“"
                                            },
                                            {
                                                "example_id": "7bf7fd0e-151d-4d41-a96e-9e17a1907a63",
                                                "sense_id": "8683da76-32c4-344c-860d-61c699ca243a",
                                                "text": "„Sie mußten zur Seite springen, sich an eine Häuserwand drängen, denn die ganze Straße wurde von einer Schwadron roter Husaren eingenommen, die in so schnellem Trab in Kriegsausrüstung vorbeizogen, daß die Karabiner auf ihren Rücken hin und her hüpften.“"
                                            },
                                            {
                                                "example_id": "74b5f964-0079-4828-950c-e6773a397152",
                                                "sense_id": "8683da76-32c4-344c-860d-61c699ca243a",
                                                "text": "„Stoßtrupps mit Karabinern im Anschlag hielten Radfahrer an.“"
                                            },
                                            {
                                                "example_id": "80de44b4-155f-446c-819b-3c314a7941cc",
                                                "sense_id": "8683da76-32c4-344c-860d-61c699ca243a",
                                                "text": "„Jewgeij stolperte über seinen Karabiner und bekam deshalb die ausgestreckten Hände seiner Kameraden nicht zu fassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98fba030-1f6d-3119-affb-faa3e7a5dc5b",
                                        "entry_id": "526c48bf-ccac-3d0c-b6fe-855fbcf0d988",
                                        "glosses": [
                                            "Karabinerhaken"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be2eee65-a834-4dfb-a8bc-fd1a732be35a",
                                                "sense_id": "98fba030-1f6d-3119-affb-faa3e7a5dc5b",
                                                "text": "„Nur für Experten - der Hinweis soll ahnungslose Wanderer bremsen, denn die scheinbar endlose Wandquerung verlangt Kondition, eine solide Klettersteigerfahrung und vor allem die volle Ausrüstung mit Klettergurt, Seilstück, Karabiner und Helm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
