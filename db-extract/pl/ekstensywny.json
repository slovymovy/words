                    }
                ],
                "translations": [
                    {
                        "translation_id": "ede75350-d583-4351-9ed8-c9d4cb51b272",
                        "source_entry_id": "754b7bec-9a65-3cec-bbd3-5beb278eef4f",
                        "source_sense_id": "27edda34-eef1-3432-a3a0-44e31c26f6db",
                        "target_lang_word": "extensive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00ea8aae-7539-366d-a94d-3206e4d3adeb",
                                        "entry_id": "402e5021-de21-3fca-a7e5-372816cf313b",
                                        "glosses": [
                                            "Having a great extent; covering a large area; vast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b759c0e-c6e6-4454-81c3-3859779ad70c",
                                                "sense_id": "00ea8aae-7539-366d-a94d-3206e4d3adeb",
                                                "text": "In the second century of the Christian era, the Empire of Rome comprehended the fairest part of the earth, and the most civilised portion of mankind. The frontiers of that extensive monarchy were guarded by ancient renown and disciplined valour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b093ec7-25e5-32d9-b5bd-98ddad78341c",
                                        "entry_id": "402e5021-de21-3fca-a7e5-372816cf313b",
                                        "glosses": [
                                            "Considerable in amount."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d98eae79-c35a-4473-9229-60e44e5121dd",
                                                "sense_id": "8b093ec7-25e5-32d9-b5bd-98ddad78341c",
                                                "text": "I have done extensive research on the subject."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc4d6802-d564-3be6-a89a-2b1f4b86f90a",
                                        "entry_id": "402e5021-de21-3fca-a7e5-372816cf313b",
                                        "glosses": [
                                            "Serving to extend or lengthen; characterized by extension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55b4084a-8600-49e7-9616-cc40d00255ec",
                                                "sense_id": "cc4d6802-d564-3be6-a89a-2b1f4b86f90a",
                                                "text": "For station is properly no rest, but one kind of motion, relating unto that which physicians (from Galen) do name extensive or tonical; that is, an extension of the muscles and organs of motion, maintaining the body at length, or in its proper figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a87b82-4855-3beb-be15-e8b093955f96",
                                        "entry_id": "402e5021-de21-3fca-a7e5-372816cf313b",
                                        "glosses": [
                                            "Having a combined system entropy that equals the sum of the entropies of the independent systems."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b2bd2ad-3f6a-4962-bb86-58b7c57ec118",
                                                "sense_id": "b1a87b82-4855-3beb-be15-e8b093955f96",
                                                "text": "According to Tsallis (1988), the entropy was extensive for T = 1, superextensive for t < 1 and subextensive for t > 1."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b70e1660-0070-4373-affc-31daff88d28c",
                        "source_entry_id": "754b7bec-9a65-3cec-bbd3-5beb278eef4f",
                        "source_sense_id": "27edda34-eef1-3432-a3a0-44e31c26f6db",
                        "target_lang_word": "extensif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extensif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbdeaba5-459a-32aa-81ff-ef7f24cb6445",
                                        "entry_id": "b9037f5b-4430-35a1-9657-5edd91e53190",
                                        "glosses": [
                                            "Qui étend, qui fait effort pour étendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ced7c7-98c5-4e50-ab60-af30f492ee58",
                                                "sense_id": "dbdeaba5-459a-32aa-81ff-ef7f24cb6445",
                                                "text": "Force, puissance extensive."
                                            },
                                            {
                                                "example_id": "60603f4f-79a9-4361-a231-aa7cadafb291",
                                                "sense_id": "dbdeaba5-459a-32aa-81ff-ef7f24cb6445",
                                                "text": "Bien entendu, l’élevage extensif nécessite de vastes espaces : jusqu'à 10 hectares par tête de gros bétail. La zone sahélienne est peu peuplée. Entre Dakar et le Darfour, les habitants de ce « biome » ne dépassent pas vingt millions d'habitants, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b732cb6-3f28-307f-971b-ea2fd26b534e",
                                        "entry_id": "b9037f5b-4430-35a1-9657-5edd91e53190",
                                        "glosses": [
                                            "Se dit d'une grandeur physique qui dépend de la quantité de matière présente dans l'échantillon, et mathématiquement représentée par une variable quantitative."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77b9d1c7-2d6e-43a9-b0a2-75e1497d6124",
                                                "sense_id": "8b732cb6-3f28-307f-971b-ea2fd26b534e",
                                                "text": "Par exemple la masse et le volume sont des propriétés extensives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd2c4195-e778-37a8-8378-61115ca2712f",
                                        "entry_id": "b9037f5b-4430-35a1-9657-5edd91e53190",
                                        "glosses": [
                                            "Qui couvre tous les cas, en parlant du genre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f6a0bc2-4588-4103-ba14-f922607cc694",
                                                "sense_id": "dd2c4195-e778-37a8-8378-61115ca2712f",
                                                "text": "On dit que le genre de base (le masculin) est le genre non marqué (extensif). Le féminin est le genre marqué (intensif) car on marque volontairement la différence par rapport au masculin"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "062e93e7-85cc-4f19-8eb5-e62ab474477b",
                        "source_entry_id": "754b7bec-9a65-3cec-bbd3-5beb278eef4f",
                        "source_sense_id": "27edda34-eef1-3432-a3a0-44e31c26f6db",
                        "target_lang_word": "extensiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extensiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73db6e14-de0c-31b1-bab6-8115d2289d24",
                                        "entry_id": "c1eff679-0ac4-3bb0-9e4f-1540d7cd76d3",
                                        "glosses": [
                                            "ausgedehnt, umfassend, mit großer Breiten- und geringer Tiefenwirkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca3df28-10fc-4973-95d1-706c8b753ec5",
                                                "sense_id": "73db6e14-de0c-31b1-bab6-8115d2289d24",
                                                "text": "Gerade in den Wintermonaten wird durch viel extensives Training die Grundlagenausdauer entwickelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fff4a429-7960-3123-9a2f-3898122ea412",
                                        "entry_id": "c1eff679-0ac4-3bb0-9e4f-1540d7cd76d3",
                                        "glosses": [
                                            "große Flächen mit vergleichsweise wenig Aufwand bewirtschaftend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d329c2-1e12-4c1d-af9f-bb93987173b1",
                                                "sense_id": "fff4a429-7960-3123-9a2f-3898122ea412",
                                                "text": "Unter extensiver Bewirtschaftung wird der vollständige Verzicht auf den Einsatz von Herbiziden und Insektiziden, der weitestgehende Verzicht auf Fungizide sowie die Reduktion von Düngung und Bodenbearbeitung verstanden."
                                            },
                                            {
                                                "example_id": "c0d4b6c2-2fd6-4957-a49e-02a7eda3c0a6",
                                                "sense_id": "fff4a429-7960-3123-9a2f-3898122ea412",
                                                "text": "Eine extensive Landwirtschaft ist eine landwirtschaftliche Bewirtschaftung, die nicht den höchstmöglichen Ertrag erzielt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3460f833-9ca3-36f9-ba3e-a84ef75c9129",
                                        "entry_id": "c1eff679-0ac4-3bb0-9e4f-1540d7cd76d3",
                                        "glosses": [
                                            "sich proportional zur Größe des Systems ändernd (Eigenschaft einer Zustandsgröße)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a930166-9595-4597-8741-dc030a05a7f0",
                                                "sense_id": "3460f833-9ca3-36f9-ba3e-a84ef75c9129",
                                                "text": "Wie sich ergab, gelten für die Addition und Subtraktion extensiver Größen dieselben Verknüpfungsgesetze wie für die gewöhnliche arithmetische Addition und Subtraktion."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "39997994-2bf9-3700-a07b-b106174197db",
                                        "entry_id": "c1eff679-0ac4-3bb0-9e4f-1540d7cd76d3",
                                        "glosses": [
                                            "ausgedehnt, erweiternd (beim Auslegen von Gesetzen)"
                                        ],
                                        "tags": [
                                            "Rechtswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a58128f9-b52b-47a9-aeba-facd4d268228",
                                                "sense_id": "39997994-2bf9-3700-a07b-b106174197db",
                                                "text": "Der Bereich, in dem unerwünschten Formen der Steuervermeidung durch eine extensive Auslegung der steuerlichen Normen begegnet wird, wird üblicherweise nicht als Steuerumgehung bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
