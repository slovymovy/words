                        "examples": [
                            {
                                "example_id": "b7552671-5dca-44a9-8ba6-09d6be9d69ab",
                                "sense_id": "3a8043a1-5f9e-35c9-9c04-8ac1f2b41fd6",
                                "text": "„Der nächste Künstler war Colin, der die Zuschauer mit Bodenakrobatik und einem sehr biegsamen Körper erfreute […].“"
                            },
                            {
                                "example_id": "5b8f46cd-4127-4fbf-8138-efd1b2ece63e",
                                "sense_id": "3a8043a1-5f9e-35c9-9c04-8ac1f2b41fd6",
                                "text": "„Doch die anstrengende artistische Arbeit – die Seiltänzerin trat auch mit Bodenakrobatik und am Trapez und in der Pyramide auf – erzeugte eine sehr schlanke Figur.“"
                            },
                            {
                                "example_id": "42585c51-ab56-41f1-ad9c-4e3300179b72",
                                "sense_id": "3a8043a1-5f9e-35c9-9c04-8ac1f2b41fd6",
                                "text": "„Hannahs Eltern kamen ursprünglich aus Oberösterreich und waren Trapezartisten, meine Eltern waren in Wien geboren und hatten eine Nummer mit lustiger Bodenakrobatik.“"
                            }
                        ],
