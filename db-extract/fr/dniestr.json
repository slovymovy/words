                        "cross_references": [
                            {
                                "target_word": "Dniestr",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "48b740d0-eb92-39b9-88a0-025dc2af2841",
                                        "entry_id": "f33f514e-0aa1-3fe4-a403-d327a8972aa5",
                                        "glosses": [
                                            "rzeka wypływająca z Karpat Wschodnich, uchodząca do Morza Czarnego, a przepływająca przez Ukrainę i Mołdawię"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "231c4451-73cd-4861-b7a8-678c5a62a2c5",
                                                "sense_id": "48b740d0-eb92-39b9-88a0-025dc2af2841",
                                                "text": "Podole położone jest nad północnymi dopływami środkowego Dniestru."
                                            },
                                            {
                                                "example_id": "cd9fab2f-e109-4e9e-bfae-693e10fbfb31",
                                                "sense_id": "48b740d0-eb92-39b9-88a0-025dc2af2841",
                                                "text": "Tatarzy krymscy przekraczali Dniestr poniżej Tehinii i z Budziaku podążali pomiędzy Prutem i Dniestrem przez Mołdawię"
                                            },
                                            {
                                                "example_id": "852ce1f5-b22d-433e-af02-160a0be2ced9",
                                                "sense_id": "48b740d0-eb92-39b9-88a0-025dc2af2841",
                                                "text": "Sieć rzeczna jest dobrze rozwinięta, a główne rzeki to Dniestr z dopływami: Reut, Ikiel, Botna i Byk oraz Prut, należące do zlewiska Morza Czarnego."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da9358e3-2d65-413f-9d8a-2d2a8c7f2238",
                        "source_entry_id": "dc97f6ad-89bd-3d68-8182-b0f63ba404c3",
                        "source_sense_id": "fe791bef-0062-3dbf-a9fb-89365a679b67",
                        "target_lang_word": "Днестр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Днестр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d9b5cd7c-b50d-3166-9b5b-177aef90f6e6",
                                        "entry_id": "476eb0e8-0823-31aa-b053-5713c802825e",
                                        "glosses": [
                                            "река в Восточной Европе, протекающая по территории Украины, Молдавии, а также непризнанной Приднестровской Молдавской Республики, и впадающая в Чёрное море"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e02253c6-19c4-4de6-8313-12c260154f31",
                                                "sense_id": "d9b5cd7c-b50d-3166-9b5b-177aef90f6e6",
                                                "text": "Чёрное море, в которое спадает мною больших рек, каковы суть, например, Дунай, Днестр, Днепр и Дон имеет весьма сильную струю чрез упомянутые проливы."
                                            },
                                            {
                                                "example_id": "1b445825-0901-4492-b2ae-2830c5c6cba3",
                                                "sense_id": "d9b5cd7c-b50d-3166-9b5b-177aef90f6e6",
                                                "text": "Самая страна, занимаемая этими староствами, названа «Украиной»; название это переходит на все пространство до Днестра, именно на землю древних угличей и тиверцев, а потом, по мере расширения казачества, распространяется и на киевскую землю и на левый берег Днепра."
                                            },
                                            {
                                                "example_id": "1be43787-33e7-43fa-891c-2499ca1deda3",
                                                "sense_id": "d9b5cd7c-b50d-3166-9b5b-177aef90f6e6",
                                                "text": "Мы дошагали до середины реки, и стало видно, как Днестр уходит сияющей полосой вниз и вдаль к морю."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
