                    }
                ],
                "senses": [
                    {
                        "sense_id": "2587b9b6-3384-3354-b192-0f2384e36065",
                        "entry_id": "851332dc-8ec8-38aa-a4f9-dddd9aa4eaab",
                        "glosses": [
                            "iets wat heel aantrekkelijk is, maar verkeerd en zondig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c410c737-eec6-411f-bf1b-6cb26880499f",
                                "sense_id": "2587b9b6-3384-3354-b192-0f2384e36065",
                                "text": "Extra pijnlijk moment voor Yuri van Gelder. In zijn interview dit jaar in de Verhoorwagen van Bureau Rio doet de van de Spelen verbannen turner een opmerkelijke belofte. Namelijk dat hij niet uit de band zal springen in Rio, de stad met 1001 verlokkingen."
                            },
                            {
                                "example_id": "c84446a5-5d57-46b9-8053-4195b5e64c75",
                                "sense_id": "2587b9b6-3384-3354-b192-0f2384e36065",
                                "text": "Niemand blijkt ongevoelig voor de verlokkingen van roem, ja ja."
                            },
                            {
                                "example_id": "a92c9963-3e13-4aba-a96a-f63fcc1eea18",
                                "sense_id": "2587b9b6-3384-3354-b192-0f2384e36065",
                                "text": "Er volgt een lange stilte. „Ik doorzag de valse verlokking van mijn suïcidale gedachten. Ik realiseerde me dat ik niet depressief was, maar een depressie had - een wezenlijk verschil.” Die ‘nuance’ probeert hij ook aan zijn patiënten over te brengen: vereenzelvig je niet met je huidige toestand. Dat is niet wat je bent.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "d8aee12e-0c24-3bf5-b321-6c54f7844df4",
                        "entry_id": "851332dc-8ec8-38aa-a4f9-dddd9aa4eaab",
                        "glosses": [
                            "iets wat veel aantrekkingskracht uitoefent en wat goed is"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01c42ed1-dca3-4bda-9a0c-302514ae5e79",
                        "source_entry_id": "851332dc-8ec8-38aa-a4f9-dddd9aa4eaab",
                        "source_sense_id": "2587b9b6-3384-3354-b192-0f2384e36065",
                        "source_sense_description": "iets wat heel aantrekkelijk is, maar verkeerd en zondig is",
                        "target_lang_word": "temptation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "temptation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc7cd720-84eb-3fca-944e-94bb25ef6648",
                                        "entry_id": "2b805883-4e8b-381a-9da0-ce0bdb1abe84",
                                        "glosses": [
                                            "The act of tempting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e659a65e-2cba-37f4-9d33-92aaca615c28",
                                        "entry_id": "2b805883-4e8b-381a-9da0-ce0bdb1abe84",
                                        "glosses": [
                                            "The condition of being tempted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e81961d-d8a3-3c0f-96dd-9c66620cd3b7",
                                        "entry_id": "2b805883-4e8b-381a-9da0-ce0bdb1abe84",
                                        "glosses": [
                                            "Something attractive, tempting or seductive; an inducement, seducement, or enticement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee28dd62-ea30-4fb5-9c8a-1a07869323b7",
                                                "sense_id": "1e81961d-d8a3-3c0f-96dd-9c66620cd3b7",
                                                "text": "At length, one night, when the company by ſome accident broke up much ſooner than ordinary, ſo that the candles were not half burnt out, ſhe was not able to reſiſt the temptation, but reſolved to have them ſome way or other. Accordingly, as ſoon as the hurry was over, and the ſervants, as ſhe thought, all gone to ſleep, ſhe ſtole out of her bed, and went down ſtairs, naked to her ſhift as ſhe was, with a deſign to ſteal them […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f95ca07-5726-3d8b-b82b-cd116bd422e7",
                                        "entry_id": "2b805883-4e8b-381a-9da0-ce0bdb1abe84",
                                        "glosses": [
                                            "Pressure applied to one's thinking designed to create wrong emotions which will eventually lead to wrong actions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c64cd31-edc9-48db-ad2e-e5805255ff96",
                        "source_entry_id": "851332dc-8ec8-38aa-a4f9-dddd9aa4eaab",
                        "source_sense_id": "2587b9b6-3384-3354-b192-0f2384e36065",
                        "source_sense_description": "iets wat heel aantrekkelijk is, maar verkeerd en zondig is",
                        "target_lang_word": "lure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "030f42eb-a859-3c3a-88b9-8c8e9370f4fc",
                                        "entry_id": "abd2b03c-a306-3299-81e0-9efcc5bb58e3",
                                        "glosses": [
                                            "Something that tempts or attracts, especially one with a promise of reward or pleasure."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aaf7629-17f7-458f-9fc3-7c1e733f8dd6",
                                                "sense_id": "030f42eb-a859-3c3a-88b9-8c8e9370f4fc",
                                                "text": "How many have with a smile made small account\nOf Beauty and her lures"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66bd009f-f8fe-31f7-81d7-f4d61fb5a65b",
                                        "entry_id": "abd2b03c-a306-3299-81e0-9efcc5bb58e3",
                                        "glosses": [
                                            "An artificial bait attached to a fishing line to attract fish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a97b51a0-6582-36c8-a918-fa43b593306a",
                                        "entry_id": "abd2b03c-a306-3299-81e0-9efcc5bb58e3",
                                        "glosses": [
                                            "A bunch of feathers attached to a line, used in falconry to recall the hawk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebcf22c-2569-432d-a585-4a811a71f2f0",
                                                "sense_id": "a97b51a0-6582-36c8-a918-fa43b593306a",
                                                "text": "My Faulcon now is ſharpe and paſſing emptie, / And til ſhe ſtoope ſhe muſt not be full gorg'd, / For then ſhe never lookes upon her lure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4ee769-9595-3c95-b1ce-92733cd48f58",
                                        "entry_id": "abd2b03c-a306-3299-81e0-9efcc5bb58e3",
                                        "glosses": [
                                            "A velvet smoothing brush."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45c15d89-56f2-3230-abe2-ec9b1ed543bc",
                                        "entry_id": "60dbcd39-38f0-3123-baae-8f4fd7583f85",
                                        "glosses": [
                                            "To attract by temptation, appeal, or guile."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea61239d-c684-491b-a184-4812bb520835",
                                                "sense_id": "45c15d89-56f2-3230-abe2-ec9b1ed543bc",
                                                "text": "It had been sixteen years since the BBC’s Grace Wyndham Goldie wrote her internal memo about luring him back to make sociological/scientific TV programmes. Now a second note had circulated, from the science department, proposing that he should present the Corporation’s next educative megaseries."
                                            },
                                            {
                                                "example_id": "667b9043-c425-4a89-b608-db8878f040c7",
                                                "sense_id": "45c15d89-56f2-3230-abe2-ec9b1ed543bc",
                                                "text": "Professor is what you become after teaching for twenty to thirty years. Research Professor is what you then want to become, so you can finally stop worrying about students and do the research that lured you into academia in the first place!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43cd0476-6712-327f-956f-5ee1b3fc67db",
                                        "entry_id": "60dbcd39-38f0-3123-baae-8f4fd7583f85",
                                        "glosses": [
                                            "To attract fish with a lure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53620031-fbf0-31f8-8bfa-3298710f0f2f",
                                        "entry_id": "60dbcd39-38f0-3123-baae-8f4fd7583f85",
                                        "glosses": [
                                            "To recall a hawk with a lure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d107f5f-7349-3131-afb4-9dd38a192a78",
                                        "entry_id": "11af2324-3e97-3a01-84ea-72babef457e0",
