                                    {
                                        "sense_id": "49646b25-1124-3223-aee1-958923eea32e",
                                        "entry_id": "fd814fee-dcd1-383e-820f-06fefa6a98d7",
                                        "glosses": [
                                            "sich verstellen, etwas vortäuschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3478a40-74af-41b5-82b6-cb0185b15742",
                                                "sense_id": "49646b25-1124-3223-aee1-958923eea32e",
                                                "text": "Ich simuliere einen Herzinfarkt."
                                            },
                                            {
                                                "example_id": "61cafec1-6790-4fe1-af72-32afd1ce5010",
                                                "sense_id": "49646b25-1124-3223-aee1-958923eea32e",
                                                "text": "Er simuliert nur."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b4e19d1-6a68-3416-950c-2c8cb49f713a",
                                        "entry_id": "fd814fee-dcd1-383e-820f-06fefa6a98d7",
                                        "glosses": [
                                            "bestimmte Vorgänge nachahmen, nachbilden"
                                        ],
                                        "tags": [
                                            "formal",
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6be94bb0-730c-4e65-be0b-c501a2f5fb06",
                                                "sense_id": "1b4e19d1-6a68-3416-950c-2c8cb49f713a",
                                                "text": "Wir simulieren in dieser Halle Monsterwellen, um mehr über sie herauszufinden."
                                            },
                                            {
                                                "example_id": "fe934d3e-d954-4be7-ba66-f6cf984b38ad",
                                                "sense_id": "1b4e19d1-6a68-3416-950c-2c8cb49f713a",
                                                "text": "„Wir beginnen in einem konventionellen Krankenhaus in Wiesbaden, wo der willige Chefarzt mit seinen Assistenten mehrmals Visite simuliert, und wo wir, anläßlich der Reportage über die Laperoskopie, als Voyeure die krebsige Leber eines ruhiggestellten Patienten in Augenschein nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4b5b9dd9-3c00-305f-ab76-712777de0148",
                                        "entry_id": "fd814fee-dcd1-383e-820f-06fefa6a98d7",
                                        "glosses": [
                                            "über etwas nachsinnen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad90fdb5-1313-4621-910d-88f248cd95b4",
                                                "sense_id": "4b5b9dd9-3c00-305f-ab76-712777de0148",
                                                "text": "„‚Als ich noch Inspektor in Grambow war‘, begann er, ‚da saß ich eines Sonntags nachmittags auf der Bank vor der Thür, rauchte meine kurze Pfeife und simulierte über die Wirtschaft. […]‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
