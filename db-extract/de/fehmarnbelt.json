                ],
                "senses": [
                    {
                        "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                        "entry_id": "98a69e39-d837-3176-af1d-105afc81deeb",
                        "glosses": [
                            "Meerenge zwischen der schleswig-holsteinischen Insel Fehmarn und der dänischen Insel Lolland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3954919-688f-466c-bf0e-73225589f1dc",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "Der Fehmarnbelt ist viel breiter, als der Fehmarnsund."
                            },
                            {
                                "example_id": "e3a32a68-24ff-40be-ab20-f41367b6b501",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "Die Entfernung zwischen Dänemark und Deutschland an der schmalsten Stelle des Fehmarnbelts beträgt etwa 10 sm."
                            },
                            {
                                "example_id": "4e2bd8a3-61ce-4ab0-9f14-c1ab330e28d5",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "„Bereits ab 1940, nach der Besetzung Dänemarks im Zweiten Weltkrieg, wurden im Auftrag des Hamburger Gauleiters Kaufmann von dem Architekten Heinrich Bartmann Pläne erarbeitet, sowohl den Fehmarnsund als auch den Fehmarnbelt mit Brücken für Eisenbahn und Autobahn zu überqueren.“"
                            },
                            {
                                "example_id": "04bb1ef6-f454-44f2-ad8f-693b86d22981",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "„Bis heute fahren über den Fehmarnbelt nur Fähren.“"
                            },
                            {
                                "example_id": "03c90097-03c6-4dc0-99d0-3bfa7c903b84",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "Die Fähren für den Eisenbahn- und Straßenverkehr überqueren den Fehmarnbelt im 30-Minuten-Takt."
                            },
                            {
                                "example_id": "9d0a1da1-2df9-4785-a9f9-022160550a44",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "Eine Überfahrt über den Fehmarnbelt dauert ca. 45 Minuten zzgl. Roll-on-/Roll-off-Zeit."
                            },
                            {
                                "example_id": "ccd713fa-b1f2-4edc-a29d-487775d0f86c",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "„Die derzeitige 45-minütige Reisezeit zur Überquerung des Fehmarnbelts mittels Fähre würde sich laut Angaben der Planer durch die unterirdische und wetterunabhängige Passage auf etwa zehn Minuten reine Fahrzeit reduzieren.“"
                            },
                            {
                                "example_id": "f351c234-ca59-4d09-9205-cc8c3fad99c1",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "„Dem späteren Entschluss, an der Stelle einen Tunnel zu bauen, gingen Jahrzehnte der Planung und der Diskussion darüber voraus, ob und in welcher Weise der Fehmarnbelt eine feste Querung erhalten solle.“"
                            },
                            {
                                "example_id": "1ba4f1e9-74fc-480c-97f9-bd614349da73",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "„Es soll der längste sogenannte Absenktunnel der Welt werden – der geplante Tunnel unter dem Fehmarnbelt zwischen Deutschland und Dänemark.“"
                            },
                            {
                                "example_id": "ca578c3d-6acd-4655-94b3-7c91d5bc88d1",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "„Ein 18 Kilometer langer Tunnel durch das Meer soll Deutschland und Dänemark verbinden – geplant sind eine vierspurige Autobahn und eine Zugstrecke. Es ist eines der größten und teuersten Infrastruktur-Projekte Europas, das durch den Fehmarnbelt führt.“"
                            },
                            {
                                "example_id": "ec7b362e-fb19-4457-b973-d12c569d7fe7",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "„Im Fehmarnbelt vor Lolland fand am 13. Oktober 1644 eine Seeschlacht zwischen der dänischen und einer schwedisch-holländischen Flotte statt, bei der viele dänische Schiffe verloren gingen.“"
                            },
                            {
                                "example_id": "697ea23f-ecfa-4ea9-8c75-a74476385884",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "„Der Extremsportler Christof Wandratsch hat den Bodensee ohne Pause und ohne Neoprenanzug durchschwommen.“ […] „Wandratsch hatte zuvor bereits den Ärmelkanal, den Fehmarnbelt und die Straße von Gibraltar durchquert.“"
                            },
                            {
                                "example_id": "aa90c89b-1677-480f-b732-93acd1f3dbaa",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "[Schweinswale:] „Im Herbst und Winter 2019 wurden sie an der Ostseeküste Schleswig-Holsteins tot aufgefunden, in der Eckernförder, Kieler und der Lübecker Bucht. Kurz zuvor hatte ein Manöververband der Bundesmarine nahe dem Meeresschutzgebiet Fehmarnbelt 42 britische Fliegerbomben aus dem Zweiten Weltkrieg gesprengt – ohne Schallschutzmaßnahmen und Hinzuziehung der Naturschutzbehörden.“"
                            },
                            {
                                "example_id": "8ea02cf4-515b-4b69-8a03-fe0ec6a62c21",
                                "sense_id": "3a52be29-d230-362b-b792-80081dbae409",
                                "text": "[Schweinswale:] „Die Marine hat mit der Sprengung von 39 alten Seekriegsminen im Ostsee-Naturschutzgebiet Fehmarnbelt Kritik auf sich gezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
