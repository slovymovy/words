                ],
                "senses": [
                    {
                        "sense_id": "c7b99dfe-1f30-364e-bf78-1cb26ff2ec92",
                        "entry_id": "11ac3883-8aae-3c69-a4b0-96cbc2598eab",
                        "glosses": [
                            "gemeinsames, festliches Mahl mit Gästen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e83f3f57-2bfe-4b01-aedb-fe1916018062",
                                "sense_id": "c7b99dfe-1f30-364e-bf78-1cb26ff2ec92",
                                "text": "„Glaubt man den antiken Autoren, spielten Gastmähler und Gelage eine wichtige Rolle in der keltischen Gesellschaft.“"
                            },
                            {
                                "example_id": "a658738b-cd20-49d2-a89e-fab5f678ba82",
                                "sense_id": "c7b99dfe-1f30-364e-bf78-1cb26ff2ec92",
                                "text": "„Skral wollte einen Wagen mieten, ich sagte, das lohne sich nicht so sehr, denn da, wo wir hinwollten, nach Valle Gran Grey, ins Tal des großen Königs, wo wir unser Gastmahl halten würden, da bräuchten wir kein Auto.“"
                            },
                            {
                                "example_id": "8846fbfc-ab00-4571-8ffc-ab2815117a18",
                                "sense_id": "c7b99dfe-1f30-364e-bf78-1cb26ff2ec92",
                                "text": "„Um die Zeit der ersten Nachtwache kehrte er von dem Gastmahle beim Richter Sja heim.“"
                            },
                            {
                                "example_id": "a452e885-3d48-4594-808d-16f2322d5aa2",
                                "sense_id": "c7b99dfe-1f30-364e-bf78-1cb26ff2ec92",
                                "text": "„Die Königin hat zu Ehren ihres Gemahls, des Königs, ihrer Mutter, der deutschen Prinzessin, und ihres Bruders, des Herzogs von Hannover, ein Gastmahl veranstaltet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bfa06da-d9ab-4fbc-b787-9c7e0902a7f1",
                        "source_entry_id": "11ac3883-8aae-3c69-a4b0-96cbc2598eab",
                        "source_sense_id": "c7b99dfe-1f30-364e-bf78-1cb26ff2ec92",
                        "source_sense_description": "gemeinsames, festliches Mahl mit Gästen",
                        "target_lang_word": "banquet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d6cd9ee-f2a4-348a-a868-20dcbdf9e9eb",
                                        "entry_id": "9c33a4aa-2183-3d4d-9a6c-195cacf35e2e",
                                        "glosses": [
                                            "Festin, repas d’apparat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2afae89-7b05-4590-9db7-65ebc9ac94e2",
                                                "sense_id": "0d6cd9ee-f2a4-348a-a868-20dcbdf9e9eb",
                                                "text": "Marc, au banquet, avait aperçu à la table d'honneur Caribe, sa femme et Le Garrec, faufilés en cette agape comme dans tous les autres spectacles gratis."
                                            },
                                            {
                                                "example_id": "476efff2-35d1-46a6-8bba-2352fe1465f8",
                                                "sense_id": "0d6cd9ee-f2a4-348a-a868-20dcbdf9e9eb",
                                                "text": "Avec six autres membres, en effet, Bosch paie sa quote-part pour assister au banquet traditionnel de la Confrérie de Notre-Dame organisé en l'honneur de frères nouvellement assermentés […]."
                                            },
                                            {
                                                "example_id": "d56c8bc3-e72e-42df-b408-76f451eb8369",
                                                "sense_id": "0d6cd9ee-f2a4-348a-a868-20dcbdf9e9eb",
                                                "text": "Banquet royal, repas où le roi mangeait en public avec toute sa famille et tous les princes et princesses du sang."
                                            },
                                            {
                                                "example_id": "1dd71ec3-c847-467f-9fc0-90cd23ada69f",
                                                "sense_id": "0d6cd9ee-f2a4-348a-a868-20dcbdf9e9eb",
                                                "text": "Le banquet des élus, le banquet de l’Agneau, la joie de la béatitude céleste."
                                            },
                                            {
                                                "example_id": "2ac2432d-2424-4718-a376-61cfd3aa0c4f",
                                                "sense_id": "0d6cd9ee-f2a4-348a-a868-20dcbdf9e9eb",
                                                "text": "Le sacré banquet, la sainte communion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
