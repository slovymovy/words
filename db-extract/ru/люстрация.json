                                                "text": "he prescribes a Purge or a Vomit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a03c0a7-f656-3735-87d9-cccd75e33e7a",
                                        "entry_id": "c6d2c629-ab01-3c8a-b992-642b1adff4a8",
                                        "glosses": [
                                            "A forcible removal of people, for example, from political activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215bf5f8-7875-40ce-b9b5-ad534c2df81d",
                                                "sense_id": "3a03c0a7-f656-3735-87d9-cccd75e33e7a",
                                                "text": "Stalin liked to ensure that his purges were not reversible."
                                            },
                                            {
