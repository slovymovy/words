                ],
                "senses": [
                    {
                        "sense_id": "d812bcb2-d1bc-34ec-bf72-93bb7a896f11",
                        "entry_id": "259db4eb-5016-3cf7-a682-8420319282f1",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94790766-932c-4127-a5b2-9c4b90e827c6",
                                "sense_id": "d812bcb2-d1bc-34ec-bf72-93bb7a896f11",
                                "text": "Frau Silhanek ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7c1c1563-8d41-4837-9259-0448ca8fb66d",
                                "sense_id": "d812bcb2-d1bc-34ec-bf72-93bb7a896f11",
                                "text": "Herr Silhanek wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5dc13023-58b9-4119-a847-880d7e03c4db",
                                "sense_id": "d812bcb2-d1bc-34ec-bf72-93bb7a896f11",
                                "text": "Die Silhaneks fahren heute in den Odenwald."
                            },
                            {
                                "example_id": "5abc9939-fe58-4f32-b16f-cd5c37997628",
                                "sense_id": "d812bcb2-d1bc-34ec-bf72-93bb7a896f11",
                                "text": "Der Silhanek trägt nie die Schals, die die Silhanek ihm strickt."
                            },
                            {
                                "example_id": "3d4f5152-7503-4d74-b418-7b5f6e0a7c31",
                                "sense_id": "d812bcb2-d1bc-34ec-bf72-93bb7a896f11",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Silhanek kommt, geht der Herr Silhanek.“"
                            },
                            {
                                "example_id": "fed2e861-f1c4-4008-a3b8-1dff4755582c",
                                "sense_id": "d812bcb2-d1bc-34ec-bf72-93bb7a896f11",
                                "text": "Silhanek kommt und geht."
                            },
                            {
                                "example_id": "72884b73-5615-4cd4-8ff2-f0557d52af5c",
                                "sense_id": "d812bcb2-d1bc-34ec-bf72-93bb7a896f11",
                                "text": "Silhaneks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
