                "senses": [
                    {
                        "sense_id": "fc853fb7-f247-32ba-ad35-783a8e36cbdd",
                        "entry_id": "19f6b5c3-8d64-3f88-979a-9d2516f588f3",
                        "glosses": [
                            "Person, die das Leben und alle Probleme harmonisch angeht"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "ba8a91ad-746b-432e-800c-4436250e634f",
                                "sense_id": "fc853fb7-f247-32ba-ad35-783a8e36cbdd",
                                "text": "„Selten giftig kommentiert der Harmonist Genscher das weder mit der FDP und damit den westlichen Alliierten und schon gar nicht mit Gorbatschow abgestimmte 10-Punkte-Programm Kohls, mit dem der Bundeskanzler - zumindest nach Genscher-Version - die Deutschland-Initiative an sich reißen wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dae51069-36c0-3524-ac78-bf43eaf3c703",
                        "entry_id": "19f6b5c3-8d64-3f88-979a-9d2516f588f3",
                        "glosses": [
                            "Musiker, die die Harmonie in der Musik in den Vordergrund stellen"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "bf1e3aed-f388-4fb1-a6cb-2083f8765595",
                                "sense_id": "dae51069-36c0-3524-ac78-bf43eaf3c703",
                                "text": "„Bach findet in Cramers Schriften als »größter Harmonist aller Zeiten und Völker« […] mehrfach Erwähnung.“"
                            },
                            {
                                "example_id": "47041057-57f1-4913-a863-b84774f3e4bb",
                                "sense_id": "dae51069-36c0-3524-ac78-bf43eaf3c703",
                                "text": "„45 der 72 Chorjahre haben viele Harmonisten gemeinsam mit ihm erlebt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "761c8883-1039-39fc-a446-f6c89ab0d03b",
                        "entry_id": "19f6b5c3-8d64-3f88-979a-9d2516f588f3",
                        "glosses": [
                            "Virtuose auf dem Harmoniums"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "a4b83560-b0d8-409a-92c4-e742a946d211",
                                "sense_id": "761c8883-1039-39fc-a446-f6c89ab0d03b",
                                "text": "„Karg-Elert war es auch, der in seiner Harmoniumschule, op. 99, den Begriff Harmonist für Virtuosen auf dem Harmonium einführte.“"
                            },
                            {
                                "example_id": "82acd6ab-ebfa-4875-94cf-ebd6842f5b80",
                                "sense_id": "761c8883-1039-39fc-a446-f6c89ab0d03b",
                                "text": "„Matthias Müller (* 1966 in Sanderbusch) ist ein deutscher Organist, Pianist und Harmonist.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
