                "senses": [
                    {
                        "sense_id": "26cd5850-51a6-3263-a88b-d847ca31404f",
                        "entry_id": "78c3d728-14c9-396b-9ffb-17f2a98133fd",
                        "glosses": [
                            "Not adept; unskilled."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afb73aab-f8d2-4366-81bd-daa72248e5a4",
                                "sense_id": "26cd5850-51a6-3263-a88b-d847ca31404f",
                                "text": "One of the things that has bugged me a long time about strips—and it hasn't been solved yet—is that the comic artists seem to be totally nonadept at dealing with cultural diversity."
                            },
                            {
                                "example_id": "16e47bea-ad02-4d7f-8d7a-82a8ee19dd00",
                                "sense_id": "26cd5850-51a6-3263-a88b-d847ca31404f",
                                "text": "The dialogs have a disorienting effect, stranding the nonadept Western reader somewhere between Sleeman's experienced poise and a touristic vertigo."
                            },
                            {
                                "example_id": "c7fad706-a245-4ef9-b0c6-98f875ad9ce4",
                                "sense_id": "26cd5850-51a6-3263-a88b-d847ca31404f",
                                "text": "At the same time, individuals trapped within institutional structures become increasingly nonadept at navigating extrainstitutional locations."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "318faa9f-658a-3cda-83a9-50b5a0756bb6",
                "word": "nonadept",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b0a40f99-55a5-4af4-87a7-79768350a36c",
                        "entry_id": "318faa9f-658a-3cda-83a9-50b5a0756bb6",
                        "tags": [
                            "plural"
