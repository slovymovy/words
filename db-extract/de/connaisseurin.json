                "senses": [
                    {
                        "sense_id": "4e6dcbe1-1057-3a38-acaa-85a2c6929945",
                        "entry_id": "4eb2e05d-2118-38b7-94b3-7a613a9883f3",
                        "glosses": [
                            "weiblicher Genussmensch, Kennerin der guten Dinge"
                        ],
                        "tags": [
                            "veraltend; bezogen auf die Lebensart"
                        ],
                        "examples": [
                            {
                                "example_id": "bc571c00-7e5c-45b2-a6b5-0a2be541bf43",
                                "sense_id": "4e6dcbe1-1057-3a38-acaa-85a2c6929945",
                                "text": "„Ich nehme an, Danner ist eine echte Connaisseurin.“"
                            },
                            {
                                "example_id": "d25f712a-5578-4470-a246-08e7cd94542f",
                                "sense_id": "4e6dcbe1-1057-3a38-acaa-85a2c6929945",
                                "text": "„Als sie jetzt in Bens Kopf schaute, suchte sie nach der panischen Angst. Sie genoss sie, eine Connaisseurin der Schmerzen.“"
                            },
                            {
                                "example_id": "fb1b3dfc-b813-4a8f-8fe2-30c6171b28a6",
                                "sense_id": "4e6dcbe1-1057-3a38-acaa-85a2c6929945",
                                "text": "„Ich bin eine Connaisseurin meiner Sinne, die sich wie Samt und Seide um meine Seele legen.“"
                            },
                            {
                                "example_id": "07cb7cd9-0503-4104-8ffa-5d0fce024721",
                                "sense_id": "4e6dcbe1-1057-3a38-acaa-85a2c6929945",
                                "text": "„Monatelang hatte ich mich weniger als Followerin Joys gesehen denn als Connaisseurin, ihr Content versetzte mich in Aufregung, ich kam mir fähig vor, spürte ein emotionales Wachstum.“"
                            },
                            {
                                "example_id": "79bcf546-103f-4c28-82eb-e5b3daf1c755",
                                "sense_id": "4e6dcbe1-1057-3a38-acaa-85a2c6929945",
                                "text": "„Sind Sie eine Connaisseurin, eine Kaffeespezialistin vielleicht?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
