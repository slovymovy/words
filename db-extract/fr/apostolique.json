        "fr-extract.jsonl": [
            {
                "entry_id": "5da39834-c9be-3aa3-95b8-434b006f0438",
                "word": "apostolique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "386f209d-bb23-4c6f-bfc3-b4815a48ac07",
                        "entry_id": "5da39834-c9be-3aa3-95b8-434b006f0438",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "apostoliques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74c62e2b-dfff-31b3-9945-7c97f5a40b2b",
                        "entry_id": "5da39834-c9be-3aa3-95b8-434b006f0438",
                        "glosses": [
                            "Qui vient, qui procède des apôtres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6ac4069-b2db-4ccc-a23e-47667e65e97f",
                                "sense_id": "74c62e2b-dfff-31b3-9945-7c97f5a40b2b",
                                "text": "[…] et, sa suite étant venue le rejoindre, il se mit en route avec beaucoup moins de pompe et dans un état bien plus apostolique, quant aux dehors mondains, que lorsqu’il était arrivé."
                            },
                            {
                                "example_id": "e2e1f78a-4756-4c18-a10a-233c126463e1",
                                "sense_id": "74c62e2b-dfff-31b3-9945-7c97f5a40b2b",
                                "text": "En sorte que la morale de ces catholiques actuels qui vous offusquent, ressemble beaucoup à la vôtre et diffère au contraire excessivement de celle d’un catholique du temps de la Ligue. Je ne parle pas des chrétiens des âges apostoliques, qui, vus de près par monsieur de Terremondre, lui sembleraient des êtres bien extraordinaires."
                            },
                            {
                                "example_id": "b0b45e8e-7735-429b-8e7b-e27ffb458a1b",
                                "sense_id": "74c62e2b-dfff-31b3-9945-7c97f5a40b2b",
                                "text": "Qu’on nous permette d’exposer ici quelques observations que nous avons eu occasion de faire dans nos courses apostoliques."
                            }
                        ]
                    },
                    {
                        "sense_id": "757d34bb-70bc-36ab-8a75-d78702613d21",
                        "entry_id": "5da39834-c9be-3aa3-95b8-434b006f0438",
                        "glosses": [
                            "Ce qui concerne le Saint-Siège, de ce qui en émane."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d28e8a13-c6a4-42f2-ab6b-eb119fcc9b96",
                                "sense_id": "757d34bb-70bc-36ab-8a75-d78702613d21",
                                "text": "Il faut convenir que voilà un cercle républicain qui a tout l’air d’une sacristie ! Ne pas être catholique pratiquant, apostolique convaincu et romain de derrière les fagots, suffirait-il, en l’an de grâce 1881, pour se voir fermer les portes d’un cercle républicain ?"
                            },
                            {
                                "example_id": "533be684-ecf1-4f2d-8d7a-482d2691692d",
                                "sense_id": "757d34bb-70bc-36ab-8a75-d78702613d21",
                                "text": "Les polémiques naissent habituellement dans ces circonstances-là, fis-je remarquer judicieusement, mais je crois pourtant bien me souvenir que, dans le cas qui vous préoccupe, les contradicteurs devaient être tous deux catholiques, apostoliques et romains, […]."
                            },
                            {
                                "example_id": "7b829c2c-274d-4577-9d8a-2359cd578219",
                                "sense_id": "757d34bb-70bc-36ab-8a75-d78702613d21",
                                "text": "Le Père Jules Douvry fut confirmé administrateur apostolique du Cameroun durante bello le 3 février 1917. C'est à lui qu'incombait la responsabilité immédiate de remettre en état de fonctionnement dans la zone française les Missions catholiques fondées par les Allemands."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a819c507-28ef-404e-a0da-82003df140be",
                        "source_entry_id": "5da39834-c9be-3aa3-95b8-434b006f0438",
                        "target_lang_word": "apostolisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apostolisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b09cad6-afe6-3eec-8555-224e5afac75b",
                                        "entry_id": "d8403335-b5bf-38ec-90b7-ccdbbc3aaf8b",
                                        "glosses": [
                                            "alles, was unmittelbar oder mittelbar auf die Apostel zurückgeht"
                                        ],
                                        "tags": [
                                            "Christliche Religion"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8a7ff3c8-a0eb-3fb1-9ff9-a6998c600666",
                                        "entry_id": "d8403335-b5bf-38ec-90b7-ccdbbc3aaf8b",
                                        "glosses": [
                                            "päpstlich"
                                        ],
                                        "tags": [
                                            "Katholische Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c62f6f9-7f5b-4567-956f-b684a6281edf",
                                                "sense_id": "8a7ff3c8-a0eb-3fb1-9ff9-a6998c600666",
                                                "text": "„Papst Franziskus hat Bedürftigen im vergangenen Jahr Hilfen in Höhe von 1,5 Millionen Euro gewährt. Das sei ein Anstieg um 25 Prozent binnen eines Jahres, teilte ein Vertreter der Apostolischen Almosenverwaltung im Vatikan am Donnerstag mit. Empfänger waren demnach karitative Verbände, die das Geld an Bedürftige verteilten, darunter Obdachlose, Flüchtlinge, Gefangene oder Kranke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e3e9aba-061a-4fc6-af7e-cf49263bb0bd",
                        "source_entry_id": "5da39834-c9be-3aa3-95b8-434b006f0438",
                        "target_lang_word": "apostolic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apostolic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "526cf6f6-5e95-339c-8da3-8ae762581e1b",
                                        "entry_id": "ff85ecfe-5179-3eda-884c-2607f6e90f23",
                                        "glosses": [
                                            "Pertaining to apostles or their practice or teaching; pertaining to the apostles (of early Christianity) or their teachings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb332c4-5585-4997-b6fa-26670caa21ef",
                                                "sense_id": "526cf6f6-5e95-339c-8da3-8ae762581e1b",
                                                "text": "an apostolic mission"
                                            },
                                            {
                                                "example_id": "90622117-4083-4dd9-98ab-c1140a8445c4",
                                                "sense_id": "526cf6f6-5e95-339c-8da3-8ae762581e1b",
                                                "text": "Amply shall I deem myself remunerated if either by the holy Charm, the good Spell of Leighton's Words, than which few if any since the Apostolic age better deserve the name of Evangelical, or by my own notes and interpolations, the reflecting Reader should be enabled to apprehend—for we may rightly apprehend what no finite mind can fully comprehend—and attach a distinct meaning to, the Mysteries into which his Baptism is the initiation; and thus to feel and know, that Christian Faith is the perfection of Human Reason."
                                            },
                                            {
                                                "example_id": "22a5957a-a82e-4846-ae69-65ce462711bd",
                                                "sense_id": "526cf6f6-5e95-339c-8da3-8ae762581e1b",
                                                "text": "Chapter 3 demonstrated that high churchmen perceived the Church of England to be a visible society and a member of the one holy catholic and apostolic church, though they particularly emphasized the apostolicity of the church."
                                            },
                                            {
                                                "example_id": "fee1b70a-c84a-49cd-b17e-e8b231dbb733",
                                                "sense_id": "526cf6f6-5e95-339c-8da3-8ae762581e1b",
                                                "text": "That was the story of The Salvation Army repeated in many places, at least partly because a small group of people touched the power of the apostolic anointing.[…]In this true story about William Booth, we have an example of what is meant to happen under apostolic grace."
                                            },
                                            {
                                                "example_id": "1a57deca-c5c9-420f-8475-8e256d37b5fd",
                                                "sense_id": "526cf6f6-5e95-339c-8da3-8ae762581e1b",
                                                "text": "I would like to give this dissertation on the apostolic world of thought in early Christian iconography the subtitle of 'In the land of the blessed' —'Μακάρων ἐνἱ χώρῳ'."
                                            },
                                            {
                                                "example_id": "daffbb9b-7be8-4b14-8b28-6bd0fc2611f6",
                                                "sense_id": "526cf6f6-5e95-339c-8da3-8ae762581e1b",
                                                "text": "2008, Jonas Clark, Advanced Apostolic Studies, Spirit of Life Publishing, page 60,\nApostolic churches break out of the four walls of the sanctuary onto the streets and into the homes to preach the Gospel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a0d4784-267e-384b-96e7-a1f2ea30439a",
                                        "entry_id": "ff85ecfe-5179-3eda-884c-2607f6e90f23",
                                        "glosses": [
                                            "According to the doctrines of the apostles; delivered or taught by the apostles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bf9aa46-3342-4342-9f06-1f423d1e24cc",
                                                "sense_id": "6a0d4784-267e-384b-96e7-a1f2ea30439a",
                                                "text": "apostolic faith or practice"
                                            }
                                        ]
                                    },
