                "senses": [
                    {
                        "sense_id": "fc8cac33-561d-3c65-bb1d-e072a3e07645",
                        "entry_id": "6e87d8fb-f1fe-3868-b598-c5a8e6c6d05f",
                        "glosses": [
                            "Bus, mit dem eine Mannschaft zu Wettkämpfen fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e50bbe6-2635-4b24-b17f-798c302d3253",
                                "sense_id": "fc8cac33-561d-3c65-bb1d-e072a3e07645",
                                "text": "„Weil der Mannschaftsbus der Gäste im Stau steckte, begann das Spiel mit einer halben Stunde Verspätung.“"
                            },
                            {
                                "example_id": "a62268cb-037b-420b-8ac5-705d7d74d105",
                                "sense_id": "fc8cac33-561d-3c65-bb1d-e072a3e07645",
                                "text": "„Bei der WM in Südafrika vor zwei Jahren lief Holger Badstuber immer mit einem Riesenkopfhörer durch die Stadien, mit seinem strähnigen Haar und dem milchigen Gesicht dachten viele, da habe sich der unsportliche Neffe von Arne Friedrich in den Mannschaftsbus verlaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
