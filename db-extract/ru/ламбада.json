                                "target_senses": [
                                    {
                                        "sense_id": "37278b6c-db01-356b-aa02-4784536dac6b",
                                        "entry_id": "0c294cc7-9176-371c-acf6-48fc12ad5ffe",
                                        "glosses": [
                                            "Danse et un genre musical du Brésil, mélangeant carimbo, reggae, salsa et merengue, dansée en couple, corps contre corps, en ondulant des hanches et des épaules et plaçant de temps en temps un genou entre les jambes de son ou sa partenaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4efa3c40-1f9b-45f7-bafe-0c737718b1db",
                                                "sense_id": "37278b6c-db01-356b-aa02-4784536dac6b",
                                                "text": "Pour lui, « la lambada est alors perçue comme une ouverture aux valeurs de l’Occident », pas moins."
                                            },
                                            {
                                                "example_id": "904dd395-447b-4dd0-832c-4d5af5c7868d",
                                                "sense_id": "37278b6c-db01-356b-aa02-4784536dac6b",
                                                "text": "C’est brésilien, c’est torride et ça rapporte. La lambada fait danser les couples et valser les millions."
                                            },
                                            {
                                                "example_id": "2b7a1383-677b-448b-9894-867699d86838",
                                                "sense_id": "37278b6c-db01-356b-aa02-4784536dac6b",
                                                "text": "On entendait sans arrêt une danse exotique, murmurée par une femme à la voix étranglée, la lambada."
                                            }
                                        ]
                                    }
                                ]
