            "senses": [
                {
                    "sense_id": "e533f961-efb3-3e1a-94d8-1b5f9c2898b4",
                    "sense_definition": "Effrayer un animal ou une personne au point de la faire fuir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "peur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut marcher doucement dans la forêt pour ne pas <w>effaroucher</w> les oiseaux qui nichent."
                        },
                        {
                            "text": "Le bruit soudain du moteur a <w>effarouché</w> le troupeau de biches près du chemin."
                        }
                    ],
                    "synonyms": [
                        "effrayer",
                        "apeurer",
                        "épouvanter"
                    ],
                    "antonyms": [
                        "apprivoiser",
                        "attirer",
                        "rassurer"
                    ],
                    "common_phrases": [
                        "effaroucher le gibier",
                        "effaroucher les oiseaux"
                    ]
                },
                {
                    "sense_id": "2a8947fb-4d77-3655-9c83-37565bfa0ed4",
                    "sense_definition": "Choquer, rebuter ou indisposer quelqu'un en heurtant sa pudeur, sa sensibilité ou ses principes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scandale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses propos provocateurs risquent d'<w>effaroucher</w> un public peu habitué à tant d'audace."
                        },
                        {
                            "text": "L'auteur a préféré adoucir certains passages de sa pièce de peur d'<w>effaroucher</w> la censure."
                        }
                    ],
                    "synonyms": [
                        "choquer",
                        "scandaliser",
                        "rebuter",
                        "offusquer"
                    ],
                    "antonyms": [
                        "amadouer",
                        "séduire"
                    ],
                    "common_phrases": [
                        "effaroucher la pudeur"
                    ]
                },
                {
                    "sense_id": "adf1e4eb-4e45-3fe6-897e-c9f7bbbc2e90",
                    "sense_definition": "Dérober ou faire disparaître habilement quelque chose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le complice a profité de la cohue pour <w>effaroucher</w> discrètement le contenu de la caisse."
                        },
                        {
                            "text": "On soupçonne le valet d'avoir <w>effarouché</w> les économies de son maître avant de fuir."
                        }
                    ],
                    "synonyms": [
                        "dérober",
                        "subtiliser",
                        "chiper",
                        "voler"
                    ],
