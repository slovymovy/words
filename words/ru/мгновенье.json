    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62678368-820b-3130-8890-5cbd7a34c92a",
                    "sense_definition": "Очень короткий промежуток времени; момент, миг.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "время",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он замер на <w>мгновенье</w>, услышав странный звук за дверью.",
                            "target_lang_translations": {
                                "en": "He froze for a <w>moment</w> upon hearing a strange sound behind the door."
                            }
                        },
                        {
                            "text": "Счастье длилось лишь одно <w>мгновенье</w>, но запомнилось на всю жизнь.",
                            "target_lang_translations": {
                                "en": "Happiness lasted only for a single <w>moment</w>, but it was remembered for a lifetime."
                            }
                        }
                    ],
                    "synonyms": [
                        "мгновение",
                        "миг"
                    ],
                    "antonyms": [
                        "вечность"
                    ],
                    "common_phrases": [
                        "на мгновенье"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный вариант"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A very short period of time; a moment or an instant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moment",
                                "target_lang_sense_clarification": "a brief period of time"
                            },
                            {
                                "target_lang_word": "instant",
                                "target_lang_sense_clarification": "a very short space of time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6a627e5-2932-3ee2-9cc7-57b0134374b9",
                    "sense_definition": "Вариант написания слова <w>мгновение</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "время",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В эти светлые <w>мгновенья</w> он чувствовал себя по-настоящему счастливым.",
                            "target_lang_translations": {
                                "en": "In those bright <w>moments</w>, he felt truly happy."
                            }
                        },
                        {
                            "text": "Все <w>мгновенья</w> радости быстро пролетели незаметно для нас.",
                            "target_lang_translations": {
                                "en": "All the <w>moments</w> of joy flew by quickly and unnoticed by us."
                            }
                        }
                    ],
                    "synonyms": [
                        "мгновение",
                        "миг"
                    ],
