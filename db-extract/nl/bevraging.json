                "senses": [
                    {
                        "sense_id": "41588a3e-a8b8-3293-a172-e63aa9d841e1",
                        "entry_id": "45e05d14-3051-3648-ba8c-30ca626722a3",
                        "glosses": [
                            "het stellen van vragen aan meerdere personen als deel van een (wetenschappelijk) onderzoek naar o.a. meningen en gedragingen van groepen mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b360c5ff-aece-44c9-aade-924a542c91d9",
                                "sense_id": "41588a3e-a8b8-3293-a172-e63aa9d841e1",
                                "text": "Pascal De Decker: ‘Vergeet het. De cijfers leren dat slechts een op de drie ouderen weleens bij de buren over de vloer komt. Dat bleek ook in onze bevraging. En de kinderen wonen soms ver weg of in het buitenland. De vermaatschappelijking van de zorg, waar het beleid op aanstuurt, werkt nu al niet voor velen.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "660ae70d-c086-3229-82a4-e9d6433b6f4d",
                        "entry_id": "45e05d14-3051-3648-ba8c-30ca626722a3",
                        "glosses": [
                            "het stellen van vragen aan personen als deel van een politieonderzoek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65bd2c33-9840-4129-a200-523042019903",
                                "sense_id": "660ae70d-c086-3229-82a4-e9d6433b6f4d",
                                "text": "Volgens het OM zijn er „geen aanwijzingen” dat deze verhoren suggestief verliepen. Het OM wijst erop dat er speciale procedures gelden voor een dergelijke bevraging. De politie heeft zich aan deze procedures gehouden, zegt het OM."
                            },
                            {
                                "example_id": "e60d101e-d99f-4d6c-82e4-d2c31bd43c67",
                                "sense_id": "660ae70d-c086-3229-82a4-e9d6433b6f4d",
                                "text": "Zeventig procent vindt dat de kwaliteit van de infrastructuur voor de fietser in stads- en dorpskernen moet verbeteren.\nDat blijkt uit een bevraging bij meer dan 1.000 Vlamingen door Fietsberaad, het Vlaamse kenniscentrum voor fietsbeleid."
                            }
                        ]
                    }
