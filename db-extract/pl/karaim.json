                    {
                        "translation_id": "c112b82d-f641-4660-8379-59c287c6eedf",
                        "source_entry_id": "190c20c3-e1dd-34fa-89fb-1ad89b0237cd",
                        "source_sense_id": "d49d5dc2-99b8-3900-a523-9e6c827fbf71",
                        "target_lang_word": "караим",
