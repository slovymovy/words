                ],
                "senses": [
                    {
                        "sense_id": "3a25e36f-3432-3cde-8c76-810515c47f3a",
                        "entry_id": "097cc2fb-76fd-3b13-9cc4-11c38ef3ce0e",
                        "glosses": [
                            "eine baulich verschieden ausgestaltete Öffnung in einem Kapellenbau, deren hauptsächliche Funktion darin besteht, in das Bauwerk eintreten zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ba2aa0c-3937-4ac0-8d89-dcc95188395f",
                                "sense_id": "3a25e36f-3432-3cde-8c76-810515c47f3a",
                                "text": "„Wenn man aus der Kapellentür hinausschaut, sieht man in die Sankt-Helena-Straße.“"
                            },
                            {
                                "example_id": "8211b8ca-c368-4a50-97b4-9c35d52824b5",
                                "sense_id": "3a25e36f-3432-3cde-8c76-810515c47f3a",
                                "text": "„Inzwischen hat er das Amt zwar abgegeben, aber für uns öffnete er noch einmal höchstpersönlich die Kapellentür.“"
                            },
                            {
                                "example_id": "b079473a-33e2-4a09-b0a1-bb59c1ac04c3",
                                "sense_id": "3a25e36f-3432-3cde-8c76-810515c47f3a",
                                "text": "„Wenn orkanartige Regenböen über die Bergkuppe des Leielchens in der Nähe der Obernautalsperre peitschten, dann drang das Wasser sowohl beim Öffnen der drei Zentner schweren Kapellentür als auch durch die Ritzen unterhalb der Tür in das Innere des Gotteshauses.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5b91c4d-6a3f-3021-9151-28b41b3b8996",
                        "entry_id": "097cc2fb-76fd-3b13-9cc4-11c38ef3ce0e",
                        "glosses": [
                            "ein bewegliches trennendes oder verbindendes Element zu Kapellräumen und/oder Kapellbereichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69b60b39-cb09-46f3-95d1-e37c5a8071c9",
                                "sense_id": "c5b91c4d-6a3f-3021-9151-28b41b3b8996",
                                "text": "„Um Abhilfe zu schaffen, ging Pfarrer Wolfgang Laaber auf die vor zirca einem Jahr neu gegründete Oberministrantenrunde der Seelsorgeeinheit St. Anna mit der Anfrage zu, ob man der Kapellentüre einen frischen Anstrich verpassen könnte.“"
                            },
                            {
                                "example_id": "b061bffc-dfa9-46bd-bc71-e0fed115b361",
                                "sense_id": "c5b91c4d-6a3f-3021-9151-28b41b3b8996",
                                "text": "„Diese Kapellentür wie auch die daneben in einer Vitrine stehende „Madonna mit Kind“ gelten als beeindruckende Zeugnisse Mataréscher Kunst und als unvergleichlicher Ausdruck des tiefen religiösen Empfindens dieses bedeutenden Künstlers.“"
                            },
                            {
                                "example_id": "7fc90f3c-450a-44ca-adcd-bc1220ddc388",
                                "sense_id": "c5b91c4d-6a3f-3021-9151-28b41b3b8996",
                                "text": "„Bei Andachten gewährt die weit geöffnete Kapellentür den Blick auf die Grotte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
