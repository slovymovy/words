            {
                "entry_id": "f57842db-cb7e-30dc-9c86-06629063512a",
                "word": "pamphlétaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "de034a47-4dd7-3e51-b099-242acf2f6b3c",
                        "entry_id": "f57842db-cb7e-30dc-9c86-06629063512a",
                        "glosses": [
                            "Relatif au pamphlet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca086a78-ade9-4192-9a4e-3cb186367cd7",
                                "sense_id": "de034a47-4dd7-3e51-b099-242acf2f6b3c",
                                "text": "Sur le plan des idées comme sur celui de la technique, le côté satirique et pamphlétaire de Candide n’est que le masque d’une recherche authentique où l’homme, liquidant illusions et chimères, parvient tant bien que mal à se réinventer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84eb7f4a-e95b-4421-b6d5-1bfce1200062",
                        "source_entry_id": "f57842db-cb7e-30dc-9c86-06629063512a",
                        "source_sense_id": "de034a47-4dd7-3e51-b099-242acf2f6b3c",
                        "target_lang_word": "pamphleteer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pamphleteer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78b022c3-2846-30cc-a482-2714d3e9a4c5",
                                        "entry_id": "66824244-41be-395b-8d97-c6eb0fee8e48",
                                        "glosses": [
                                            "A writer, publisher, or distributer of pamphlets, a second-rate journalist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bfbcd0d-0e54-46e5-a8a4-1150c7e8f8dd",
                                                "sense_id": "78b022c3-2846-30cc-a482-2714d3e9a4c5",
                                                "text": "The Commons are very slow in bringing in their Bill to limit the press, and the pamphleteers make good use of their time; for there come out three or four every day."
                                            },
                                            {
                                                "example_id": "7e8794ba-ec6b-4289-9f85-fd5e20ecb3be",
                                                "sense_id": "78b022c3-2846-30cc-a482-2714d3e9a4c5",
                                                "text": "but Charles Reade, an artist, a scholar, a man with a true sense of beauty, raging and roaring over the abuses of contemporary life like a common pamphleteer or a sensational journalist, is really a sight for the angels to weep over."
                                            },
                                            {
                                                "example_id": "4d62511f-91ab-418e-933d-f940e76aac3b",
                                                "sense_id": "78b022c3-2846-30cc-a482-2714d3e9a4c5",
                                                "text": "\"It's kind of unfortunate that it depends on spectacular violence by somebody, or whoever it is, to get it into print,\" said that man, John Zerzan, a leading pamphleteer and self-described anarchist and technophobe who has become a guru of sorts for anti-technology leftists."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pamphleteer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89044af6-8e6a-357c-9a68-d000c5e4a51d",
                                        "entry_id": "e6bb5eb9-a4e5-3da3-b19f-81aecb30d49f",
                                        "glosses": [
                                            "To publish and distribute pamphlets as a form of propaganda."
