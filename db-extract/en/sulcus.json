                        "sense_id": "cb8ec739-43a6-39c7-91f4-1e43eaff408a",
                        "entry_id": "3fda33f8-adb0-344b-9da7-a54a08fb5b10",
                        "glosses": [
                            "A region of subparallel grooves or ditches formed by a geological process."
                        ],
                        "tags": [],
                        "examples": []
