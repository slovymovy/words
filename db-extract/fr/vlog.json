                        "entry_id": "9b1799f6-4627-33da-b7ff-465b2c532ceb",
                        "glosses": [
                            "Blogue qui utilise la vidéo comme support principal de son contenu."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b01779e-c64f-45bd-92c7-72ab38bbd29d",
                        "source_entry_id": "9b1799f6-4627-33da-b7ff-465b2c532ceb",
                        "source_sense_id": "6391f743-3537-37ca-bf42-aae4dc19a2b6",
