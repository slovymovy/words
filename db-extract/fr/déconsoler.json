                "senses": [
                    {
                        "sense_id": "6801f27e-9ca9-3237-aab5-6623ff24beeb",
                        "entry_id": "d471ed8c-6697-32ad-ad85-4128ead21a6f",
                        "glosses": [
                            "Faire perdre sa consolation à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd95fc2c-1c0e-4bbf-9fc1-317798f37f13",
                                "sense_id": "6801f27e-9ca9-3237-aab5-6623ff24beeb",
                                "text": "je ne veux pas te déconsoler"
                            },
                            {
                                "example_id": "5eda6871-d73d-4c3e-87b5-8fbf29df6ed1",
                                "sense_id": "6801f27e-9ca9-3237-aab5-6623ff24beeb",
                                "text": "Pour me décondamner, pour se décontrarier, pour me déconsoler, pour se défenestrer."
                            },
                            {
                                "example_id": "4fd84097-93ee-419b-8e1f-9746e6f6ef25",
                                "sense_id": "6801f27e-9ca9-3237-aab5-6623ff24beeb",
                                "text": "Mais combien de tels revers semblent petits, mesquins et négligeables, au regard du désastre qui déconsole aujourd'hui le monde civilisé…"
                            },
                            {
                                "example_id": "2e3b8570-a491-4551-8b5f-419fd3bd98b4",
                                "sense_id": "6801f27e-9ca9-3237-aab5-6623ff24beeb",
                                "text": "Quand la vie me déconsole, les mots me consolent."
                            }
                        ]
                    }
                ],
