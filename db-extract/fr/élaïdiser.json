                        "tags": [],
                        "examples": [
                            {
                                "example_id": "072cf030-a84b-4db8-bbd8-4b3bbe869f11",
                                "sense_id": "709d98e5-b328-358b-af70-4e2f1da8dd1d",
                                "text": "Dans un premier temps, on administre à deux porcs en croissance un régime équilibré additionné de 15% d'huile d'arachide soit raffinée soit élaïdisée après…"
                            },
                            {
                                "example_id": "68ce324d-3a05-4c80-bf27-13ea9c7182bd",
                                "sense_id": "709d98e5-b328-358b-af70-4e2f1da8dd1d",
                                "text": "…doivent pas représenter une seule espèce chimique, mais on ignore encore la raison pour laquelle l'acide oléique des huiles siccatives ne s'élaïdise pas."
                            }
                        ]
                    }
