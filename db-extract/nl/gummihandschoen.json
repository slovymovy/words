                        "examples": [
                            {
                                "example_id": "77bb662b-c06e-4d6e-ba7d-24a0a928a4de",
                                "sense_id": "286f1d52-c54b-3d3b-af87-4b2f49a5f502",
                                "text": "Even na zessen arriveerde, met een gezicht doorgroefd van slaap, de vroedvrouw. Ze trok een gummihandschoen over haar rechterhand, en verzocht mij buiten de slaapkamer te wachten."
                            },
                            {
                                "example_id": "d8b8573b-b197-4606-a83e-7cfe76088dc2",
                                "sense_id": "286f1d52-c54b-3d3b-af87-4b2f49a5f502",
                                "text": "Het doek verhuist voortdurend van de grond naar de ezel en andersom. Mulders’ gummihandschoenen glimmen van de verf. Hij duwt en veegt. Plenst er water overheen en dept het weer op met een doek."
                            }
                        ]
