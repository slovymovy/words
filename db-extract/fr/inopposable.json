                "senses": [
                    {
                        "sense_id": "f312d8bb-9c6b-3f09-9f57-eb92ffaec32a",
                        "entry_id": "c285ea2c-1d25-309d-ad29-7951480acd2a",
                        "glosses": [
                            "Que l’on ne peut opposer l’un à l’autre."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "498dbf9e-325f-4e9f-8296-acebb879baa3",
                                "sense_id": "f312d8bb-9c6b-3f09-9f57-eb92ffaec32a",
                                "text": "Le but du socialisme, c’est la recherche du progrès et la concrétisation de l’aspiration égalitaire dont les composantes - égalité juridique, égalité politique et égalité sociale - sont indissociables et inopposables."
                            }
                        ]
                    },
                    {
                        "sense_id": "da11189b-6926-3c3e-b8e9-1d60a9560cc8",
                        "entry_id": "c285ea2c-1d25-309d-ad29-7951480acd2a",
                        "glosses": [
                            "Qui ne peut être opposé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8ff2218-c2bb-43ed-9433-5dc623831ded",
                                "sense_id": "da11189b-6926-3c3e-b8e9-1d60a9560cc8",
                                "text": "L'absence de transcription sur les registres de l'état civil en France d'un mariage contracté à l'étranger par un Français, n'a pas pour effet de rendre ce mariage inopposable aux tiers."
                            },
                            {
                                "example_id": "9fd215b5-80b5-4188-8e52-ffa2920ea408",
                                "sense_id": "da11189b-6926-3c3e-b8e9-1d60a9560cc8",
                                "text": "La fin de non-recevoir est particulièrement inopposable à l'époux qui, lors du premier procès [en séparation], a ignoré les faits dont il fait usage à l'appui de sa nouvelle action."
                            }
                        ]
                    }
                ],
