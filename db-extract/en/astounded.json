                        "sense_id": "b75e4a13-4383-35b8-86fd-f67701fd0eb4",
                        "entry_id": "b66f3b9b-9618-3fa1-951e-4e8cd37b91a0",
                        "glosses": [
                            "Surprised, amazed, astonished or bewildered."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "791242ca-7e73-45a7-8d9b-4d982c2cfef1",
                                "sense_id": "b75e4a13-4383-35b8-86fd-f67701fd0eb4",
                                "text": "[…] now they lye\nGroveling and prostrate on yon Lake of Fire,\nAs we erewhile, astounded and amaz’d,\nNo wonder, fall’n such a pernicious highth."
                            },
                            {
                                "example_id": "1430e4e6-f93c-48ba-954d-6b5e3bb00b9e",
                                "sense_id": "b75e4a13-4383-35b8-86fd-f67701fd0eb4",
                                "text": "[…] wrapt in Suspense\nAnd Fear I stood, yet knew not what I fear’d;\nWhen straight to my appall’d, astounded Sense\nA Man of noble Port and Mien appear’d."
                            },
                            {
                                "example_id": "475ea0e2-2a67-4766-80db-6cd46894579a",
                                "sense_id": "b75e4a13-4383-35b8-86fd-f67701fd0eb4",
                                "text": "1844, Edgar Allan Poe, “The Spectacles” in The Works of Edgar Allan Poe, New York: W.J. Widdleton, Volume 2, p. 327,\nHad a thunderbolt fallen at my feet I could not have been more thoroughly astounded […]"
                            },
                            {
                                "example_id": "8477c35a-0b00-494b-ba4e-7d46426c321d",
                                "sense_id": "b75e4a13-4383-35b8-86fd-f67701fd0eb4",
                                "text": "The housewife was to take a sip of the real juice, watch the interviewer mix the Instant right before her astounded eyes, and then try the result, impressed, possibly, by its quickness and ease […]"
                            }
                        ]
                    }
