                    {
                        "translation_id": "15ad46bf-20de-4b39-84fb-8ed33685fb04",
                        "source_entry_id": "ea3b3c7d-addc-380e-ab57-2c493edfcf0b",
                        "target_lang_word": "uitspraak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitspraak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d3b1347c-80f6-3948-bc65-b18e16b0c4a0",
                                        "entry_id": "44e2eadf-2e96-3913-b4f4-947632ad4baf",
                                        "glosses": [
                                            "manier waarop iemand een woord, zin of taal ten gehore brengt of zou moeten brengen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "071266b4-fe11-445f-8700-a1571a6d6c70",
                                                "sense_id": "d3b1347c-80f6-3948-bc65-b18e16b0c4a0",
                                                "text": "Je heet, je moet me de uitspraak niet kwalijk nemen, ging hij verder, nog steeds met diezelfde vreemde blik, je heet Eric Henri Oscar Lauritz Letang. En je bent Frans staatsburger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "971c112f-cf31-30b2-8a89-fbf9ffe22b4a",
                                        "entry_id": "44e2eadf-2e96-3913-b4f4-947632ad4baf",
                                        "glosses": [
                                            "een woord of zin door iemand uitgesproken waarin een mening wordt geuit, bewering"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2387e00-fbea-402f-bdde-468a95e29ad5",
                                                "sense_id": "971c112f-cf31-30b2-8a89-fbf9ffe22b4a",
                                                "text": "De wens van de coalitiepartners zal ongetwijfeld weer leiden tot een stevig gesprek. Dat gebeurde vorige week ook naar aanleiding van de uitspraken van Dijkhoff. Toen zei CU-voorman Segers na afloop: „We gaan vol goede moed verder, maar dit soort dingen moet niet te vaak gebeuren.”"
                                            },
                                            {
                                                "example_id": "350cc054-a9ef-47c0-a082-b83c7fc6f4b6",
                                                "sense_id": "971c112f-cf31-30b2-8a89-fbf9ffe22b4a",
                                                "text": "\"Absoluut nodig\", noemde parlementslid Augusta Montaruli van Meloni's partij het voorstel in een interview met persbureau Reuters. \"Als iemand hoopt te profiteren van juridische onduidelijkheid, dan kan dat niet met ons.\" Op een verzoek van de NOS om die uitspraak te specificeren, wilde Montaruli niet ingaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e0553d9-5af2-3c70-80f5-175b2496667c",
                                        "entry_id": "44e2eadf-2e96-3913-b4f4-947632ad4baf",
                                        "glosses": [
                                            "het uiten, bekendmaken van een oordeel in een rechtbank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be7204de-6394-461a-9784-ed2f3f200a1a",
                                                "sense_id": "9e0553d9-5af2-3c70-80f5-175b2496667c",
                                                "text": "De uitspraak toonde volgens sommige analisten aan dat wie geld genoeg had om de beste advocaten in te huren, ongestraft een moord kon plegen"
                                            },
                                            {
                                                "example_id": "9b82b214-f626-45fc-b04e-de4a77be1ebc",
                                                "sense_id": "9e0553d9-5af2-3c70-80f5-175b2496667c",
                                                "text": "De gemeente Den Haag is tevreden. Wethouder Robert Barker (Partij voor de Dieren) noemt de uitspraak een duurzame mijlpaal. \"Deze uitspraak laat zien dat gemeenten niet machteloos zijn, maar wel degelijk instrumenten hebben om de klimaatcrisis aan te pakken.\""
                                            },
                                            {
                                                "example_id": "6f05c235-78a6-4d3d-aba6-218f5b1a8a1e",
                                                "sense_id": "9e0553d9-5af2-3c70-80f5-175b2496667c",
                                                "text": "Daarmee schuift het hof het oordeel over het werk van de inspectie door naar de bestuursrechter in Amsterdam, die op 20 januari uitspraak doet over de rechtmatigheid van het optreden van onderwijsminister Arie Slob in de Haga-zaak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
