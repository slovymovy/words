                            {
                                "example_id": "1e6e98fd-d602-4515-80f5-232196382faa",
                                "sense_id": "88e2af77-c6d7-34e3-9391-c51d2db34463",
                                "text": "Herr Bausch ist als Kaninchenzüchter erfolgreich."
                            },
                            {
                                "example_id": "261d36c2-288a-494e-9534-1f5adc0d67ac",
                                "sense_id": "88e2af77-c6d7-34e3-9391-c51d2db34463",
                                "text": "Herr Bausch heiratet im September auf Hawaii."
                            },
                            {
                                "example_id": "709e9b51-44fd-40f1-a46e-d9ae9e1ebc0e",
                                "sense_id": "88e2af77-c6d7-34e3-9391-c51d2db34463",
                                "text": "Frau Bausch liebt es, an Weihnachten Plätzchen zu backen."
                            },
                            {
                                "example_id": "579bdde8-df0c-4afb-ac5b-329ad41ee410",
                                "sense_id": "88e2af77-c6d7-34e3-9391-c51d2db34463",
                                "text": "Die Bauschs lieben die Natur und die Tiere."
                            }
                        ],
