                    {
                        "translation_id": "19e717be-e8c5-4be2-88e4-e0984ee12de9",
                        "source_entry_id": "958bd03a-be64-3926-993d-2e742acb7dff",
                        "source_sense_description": "anything shaped like a goose's neck",
                        "target_lang_word": "Schwanenhals",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwanenhals",
