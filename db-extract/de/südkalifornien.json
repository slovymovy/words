                "senses": [
                    {
                        "sense_id": "49714bba-99c2-35e0-b104-126bfcbca4a3",
                        "entry_id": "a21e84af-251f-3afa-8d05-86e447b8518d",
                        "glosses": [
                            "südlicher Teil von Kalifornien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b63b49d-e745-47e8-8a85-b90dc34e5582",
                                "sense_id": "49714bba-99c2-35e0-b104-126bfcbca4a3",
                                "text": "„Dort, in der verträumten, sonnenbenebelten Welt Südkaliforniens, verbrachte ich in den Sechzigern sechs idyllische Jahre.“"
                            },
                            {
                                "example_id": "7724f370-61f5-4227-84c4-eb97d8fe84a6",
                                "sense_id": "49714bba-99c2-35e0-b104-126bfcbca4a3",
                                "text": "„In ganz Südkalifornien wurde darüber berichtet.“"
                            },
                            {
                                "example_id": "cb542f42-4680-4c86-9873-06d46872bef0",
                                "sense_id": "49714bba-99c2-35e0-b104-126bfcbca4a3",
                                "text": "„In der Wirklichkeit ist er irgendwo in Südkalifornien.“"
                            },
                            {
                                "example_id": "706f40e2-518c-458e-85e0-ce5f203c057e",
                                "sense_id": "49714bba-99c2-35e0-b104-126bfcbca4a3",
                                "text": "„Sein Leben in Südkalifornien hatte ihm einen Hass auf Drogen und Drogendealer beschert, und er wurde hauptsächlich undercover in verschiedenen Teilen der Welt eingesetzt.“"
                            },
                            {
                                "example_id": "45042f23-db3d-4fe8-a786-1702b21f12d9",
                                "sense_id": "49714bba-99c2-35e0-b104-126bfcbca4a3",
                                "text": "„Ein weiteres Kennzeichen Kaliforniens, dachte Pope. Südkaliforniens auf jeden Fall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
