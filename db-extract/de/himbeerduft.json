                        "examples": [
                            {
                                "example_id": "3c660775-ff1d-4bb2-bbad-0835770351bc",
                                "sense_id": "9d146bc9-ba68-3bfb-b130-22eca97a04a3",
                                "text": "„Als sie die Wohnungstür aufschloss, zog sie der Himbeerduft zuerst in die Küche.“"
                            },
                            {
                                "example_id": "65d94c65-746a-4376-b0ee-1498d0b9bcca",
                                "sense_id": "9d146bc9-ba68-3bfb-b130-22eca97a04a3",
                                "text": "„Der \"Lavantaler Bananenapfel\" duftet leicht nach Banane, der Geruch der \"Credes Quittenrenette\" erinnert an Quitten, dem \"Weißen Winterkalvill\" wird Himbeerduft nachgesagt.“"
                            }
                        ],
