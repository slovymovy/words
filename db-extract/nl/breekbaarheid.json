                "forms": [],
                "senses": [
                    {
                        "sense_id": "104177a4-9700-32d5-af31-f48ff94f58cb",
                        "entry_id": "5711a00f-0e9f-3ef5-9519-d78445fa8d94",
                        "glosses": [
                            "het makkelijk kunnen breken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af830297-1ca8-444c-a64b-fa9dcde11b5e",
                                "sense_id": "104177a4-9700-32d5-af31-f48ff94f58cb",
                                "text": "Die rozige breekbaarheid, compleet met permanent, maakte dat je even vaak de behoefte voelde hem licht te beschadigen, een beetje te knakken, als hem bezorgd in een wattendoosje op te bergen."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc77b758-e312-37a8-806e-055635250e05",
                        "entry_id": "5711a00f-0e9f-3ef5-9519-d78445fa8d94",
                        "glosses": [
                            "gevoelig en teer voorkomen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "142ceb82-8377-4de8-94a2-370f450c1860",
                                "sense_id": "dc77b758-e312-37a8-806e-055635250e05",
                                "text": "Zodra hij op de bok stond, verdween zijn breekbaarheid en veranderde hij in de soevereine meester die wist wat hij wilde en die anderen in zijn greep had, niet met driftige en theatrale gebaren, maar juist met minimale bewegingen."
                            }
                        ]
                    }
                ],
