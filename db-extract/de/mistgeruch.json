                ],
                "senses": [
                    {
                        "sense_id": "1f87c8d6-3e9a-3118-8751-99ab669c319e",
                        "entry_id": "a5e3de09-b134-3ec4-8632-c2740d7ba2ec",
                        "glosses": [
                            "Wahrnehmung von Geruch in der Luft, der von einem Misthaufen stammt; verbale Zuordnung der Geruchsemission"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1cb7d1d-beff-4453-b5cf-35c5bf033141",
                                "sense_id": "1f87c8d6-3e9a-3118-8751-99ab669c319e",
                                "text": "„Der Mistgeruch sei nicht schlimm, viel penetranter aber der Mist von den Hühnern.“"
                            },
                            {
                                "example_id": "d86d5b56-31c6-4d7e-8ca9-c344fccfc89f",
                                "sense_id": "1f87c8d6-3e9a-3118-8751-99ab669c319e",
                                "text": "„Die Vorsitzernasen der Regierungsparteien im Leineschloss beklagen nun lauthals den Mistgeruch, der ihrem Sagen nach von denen ausgeht, die das Teufelstun in den Puten KZ’s ans Licht bringen.“"
                            },
                            {
                                "example_id": "a3f351ce-deb3-497c-9649-74fd09bb49ca",
                                "sense_id": "1f87c8d6-3e9a-3118-8751-99ab669c319e",
                                "text": "„Der mitten in den umgenutzten Gebäuden hie und da wahrzunehmende Mistgeruch gehört dazu.“"
                            },
                            {
                                "example_id": "5f54c55e-4b8c-4a00-ab8e-699c76a68215",
                                "sense_id": "1f87c8d6-3e9a-3118-8751-99ab669c319e",
                                "text": "„Der beißende Mistgeruch und die umherlaufenden Kühe machen ihr schon lange nichts mehr aus, sagt sie, als sie schon wieder im Auto sitzt und den nächsten Hof ansteuert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
