                        "source_entry_id": "149802b3-7e19-308b-8ef9-df3d643503d2",
                        "source_sense_id": "4a979008-a0ff-3c35-bbfc-52aa64dec01b",
                        "source_sense_description": "veraltet: in Wirklichkeit; aktual, wirklich, tatsächlich",
                        "target_lang_word": "wirklich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wirklich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fc1fe92-661e-393c-a778-b7045e683c23",
                                        "entry_id": "2cb4e7ff-7320-3fde-824d-0f92aa79bccf",
                                        "glosses": [
                                            "tatsächlich existierend und nicht nur in der Einbildung vorhanden seiend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610ab9a0-3e5a-4e07-a5b4-ce6e9a47d1ed",
                                                "sense_id": "6fc1fe92-661e-393c-a778-b7045e683c23",
                                                "text": "Peter hatte sich die Geschichte nicht ausgedacht. Sie war wirklich passiert."
                                            },
                                            {
                                                "example_id": "09f49354-b90f-45c6-b717-4f275e6ba9e0",
                                                "sense_id": "6fc1fe92-661e-393c-a778-b7045e683c23",
                                                "text": "Am wirklichsten wirkt so eine Behauptung natürlich, wenn sie von einem echten Junkie kommt."
                                            },
                                            {
                                                "example_id": "bd5cc72e-0256-4acf-8e68-6023a5756827",
                                                "sense_id": "6fc1fe92-661e-393c-a778-b7045e683c23",
                                                "text": "Im wirklichen Leben ist sie Verkäuferin."
                                            },
                                            {
                                                "example_id": "2ebfb9f9-866f-4e5e-9cfd-6c8f6d4503e2",
                                                "sense_id": "6fc1fe92-661e-393c-a778-b7045e683c23",
                                                "text": "Wirklich?"
                                            },
                                            {
                                                "example_id": "38cb2b84-1b73-4580-b85c-00e4527300b6",
                                                "sense_id": "6fc1fe92-661e-393c-a778-b7045e683c23",
                                                "text": "Wirklich? Du hast sie eben noch am Bahnhof gesehen?"
                                            },
                                            {
                                                "example_id": "1e788b41-9e08-4c59-a9ff-113d55346a3d",
                                                "sense_id": "6fc1fe92-661e-393c-a778-b7045e683c23",
                                                "text": "„Die wirkliche Bahn des Mondes ist außerordentlich kompliziert, da er sich mit der Erde um die Sonne bewegt und auch unser Sonnensystem als Ganzes nicht ruht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a2b2e2da-8e83-3e3e-a92a-6f319338021a",
                                        "entry_id": "2cb4e7ff-7320-3fde-824d-0f92aa79bccf",
                                        "glosses": [
                                            "den Erwartungen und Wertvorstellungen entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "239c2238-bb58-4299-b439-89e2633daddb",
                                                "sense_id": "a2b2e2da-8e83-3e3e-a92a-6f319338021a",
                                                "text": "Wirkliche Kenner meiden diesen Wein."
                                            },
                                            {
                                                "example_id": "c7530850-d1e0-4443-add4-47b1ddd0de9f",
                                                "sense_id": "a2b2e2da-8e83-3e3e-a92a-6f319338021a",
                                                "text": "Ja, sie ist eine wirkliche Freundin, wir gehen durch dick und dünn."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ce4c9523-3f15-357a-9a15-e957a7d69040",
                                        "entry_id": "2cb4e7ff-7320-3fde-824d-0f92aa79bccf",
                                        "glosses": [
                                            "wahrhaftig, echt, ganz"
                                        ],
                                        "tags": [
                                            "Verstärkungswort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ee38498-ade2-4fe6-8ff3-06884f5b1617",
                                                "sense_id": "ce4c9523-3f15-357a-9a15-e957a7d69040",
                                                "text": "Ja, sie ist eine wirklich echte Freundin, wir gehen durch dick und dünn."
                                            },
                                            {
                                                "example_id": "384b9819-1406-4c10-83f5-cca4f4117495",
                                                "sense_id": "ce4c9523-3f15-357a-9a15-e957a7d69040",
                                                "text": "Dann werde ich älter und fange an, die Dinge durcheinander zu bringen, ohne wirklich einen Einfluss darauf zu haben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "wirklich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e8cd3a5-b6b0-39d4-b028-46d0933ecbea",
                                        "entry_id": "195bfe38-1558-337a-9b7d-9e6c2bf78aa5",
                                        "glosses": [
                                            "verstärkt oder betont die Satzaussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b766d7ab-8a04-4152-b868-1595aa96fb29",
                                                "sense_id": "5e8cd3a5-b6b0-39d4-b028-46d0933ecbea",
                                                "text": "Das ist ein wirklich guter Kaffee."
                                            },
                                            {
                                                "example_id": "aac45250-799d-41c8-a6a3-80ac8834f4ff",
                                                "sense_id": "5e8cd3a5-b6b0-39d4-b028-46d0933ecbea",
                                                "text": "Darauf kommt es wirklich nicht an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6954a1e6-abb8-4cda-92d0-efe94ea08c9d",
                        "source_entry_id": "149802b3-7e19-308b-8ef9-df3d643503d2",
                        "source_sense_id": "4a979008-a0ff-3c35-bbfc-52aa64dec01b",
                        "source_sense_description": "veraltet: in Wirklichkeit; aktual, wirklich, tatsächlich",
                        "target_lang_word": "tatsächlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tatsächlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                        "entry_id": "418c6704-8a1f-3b8a-8ac8-f22d926425f4",
                                        "glosses": [
                                            "(manchmal auch wider Erwarten) wahrheitsgemäß, wirklich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63edba5d-01d5-42a3-937c-6f923a5eba67",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "Der Dozent ist tatsächlich netter, als ich gedacht hatte."
                                            },
                                            {
                                                "example_id": "23a85b9a-954e-4785-9035-b8e5f7b2b941",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "„Tatsächlich ordnet sich der gegen Philipp V. ausgebrochene 2. Römisch-Makedonische Krieg in eine lange Reihe imperialistischer Übergriffe ein, die so alt waren wie die Errichtung der römischen Hegemonie über Italien.“"
                                            },
                                            {
                                                "example_id": "2aa8eebb-2ffd-4e99-8665-fb660a346f6f",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "„Penibel ausgearbeitete Pläne für Internierungslager und Listen mit Namen der zur Internierung vorgesehenen Systemkritiker lagen tatsächlich längst vor.“"
                                            },
                                            {
                                                "example_id": "63223d4c-359f-4340-907a-d26d6bbfedab",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "Den Einwand verstehe ich nicht, es hat doch eine tatsächliche Veränderung stattgefunden, oder nicht?"
                                            },
                                            {
                                                "example_id": "bea08c6f-2874-4137-867b-d721ae326511",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "„Eine tatsächliche Verständigung bleibt auch dann wirksam, wenn von den Beteiligten nicht vorhergesehene Besteuerungsfolgen eintreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "617923be-f670-4876-b3c0-85122403d0d0",
                        "source_entry_id": "149802b3-7e19-308b-8ef9-df3d643503d2",
                        "source_sense_id": "ee8aeae7-ec37-32f3-ba6d-379a4e8034fb",
                        "source_sense_description": "zur jetzigen Zeit; aktuell, jetzt, gegenwärtig, zurzeit, momentan",
                        "target_lang_word": "aktuell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aktuell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4305fefa-0b94-3780-987c-576ccf9fe0c6",
                                        "entry_id": "41e155d2-205a-3da0-b700-16cb2c53a2a0",
                                        "glosses": [
                                            "jetzt, in dieser Zeit, in diesem Moment"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66df3fc-1fbe-4e85-88a7-2ee003306b1f",
                                                "sense_id": "4305fefa-0b94-3780-987c-576ccf9fe0c6",
                                                "text": "Aktuell herrschen Temperaturen bis 12° C."
                                            },
                                            {
                                                "example_id": "a3bd96d2-4181-4134-b1b8-7129977f2450",
                                                "sense_id": "4305fefa-0b94-3780-987c-576ccf9fe0c6",
                                                "text": "„Auch wenn die Schätzungen zu Hebungen in Afrika sehr weit auseinandergehen, gibt es doch Hinweise darauf, dass zum Beispiel das Gebirgsgebiet Namibias, welches aktuell bis über 2000 Meter hoch aufragt, in den letzten 10 Millionen Jahren um etwa 1000 Meter angehoben wurde.“"
                                            },
                                            {
                                                "example_id": "140c95ab-93df-4142-b1f7-f660a7ea727e",
                                                "sense_id": "4305fefa-0b94-3780-987c-576ccf9fe0c6",
                                                "text": "„Alex Honnold, der wohl beste Freikletterer der aktuellen Kletterer-Generation hat sich im Sommer 2017 geistig und körperlich auf die Begehung der 975 Meter hohen Route ‚Freerider’ am El Capitan allein und ohne jegliche Hilfsmittel vorbereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e001a877-47d2-336e-bd4d-a209ff5ce915",
                                        "entry_id": "41e155d2-205a-3da0-b700-16cb2c53a2a0",
                                        "glosses": [
                                            "auf dem neuesten Stand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ebf204e-c5ec-4337-8ef9-59b4a1aecd5b",
                                                "sense_id": "e001a877-47d2-336e-bd4d-a209ff5ce915",
                                                "text": "„Alex Honnold, der wohl beste Freikletterer der aktuellen Kletterer-Generation hat sich im Sommer 2017 geistig und körperlich auf die Begehung der 975 Meter hohen Route ‚Freerider’ am El Capitan allein und ohne jegliche Hilfsmittel vorbereitet.“"
                                            },
                                            {
                                                "example_id": "a881fd17-7d29-40dd-8cc9-bfc5d2f355ef",
                                                "sense_id": "e001a877-47d2-336e-bd4d-a209ff5ce915",
                                                "text": "Unsere Computer sind auf dem aktuellen Stand."
                                            },
                                            {
                                                "example_id": "8f8f8729-80f2-4255-bcd6-cf32765c95d3",
                                                "sense_id": "e001a877-47d2-336e-bd4d-a209ff5ce915",
                                                "text": "„Das Buch ist heute aktueller als vor 40 Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d2ac5118-81c1-377d-9847-1ac9ac01e740",
                                        "entry_id": "41e155d2-205a-3da0-b700-16cb2c53a2a0",
                                        "glosses": [
                                            "bedeutsam für die Gegenwart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c77add3-4a19-4204-9467-c89bc4a45dc7",
                                                "sense_id": "d2ac5118-81c1-377d-9847-1ac9ac01e740",
                                                "text": "„Die aktuellste Diskussion konnte ich zwischen einem syrischen Vater und seinem Kind verfolgen.“"
                                            },
                                            {
                                                "example_id": "dc89e377-aa1a-4827-93f8-e64e1a021b23",
                                                "sense_id": "d2ac5118-81c1-377d-9847-1ac9ac01e740",
                                                "text": "Das ist der aktuelle Trend."
                                            },
                                            {
                                                "example_id": "f7d39767-7583-4f52-946e-a2e4629173aa",
                                                "sense_id": "d2ac5118-81c1-377d-9847-1ac9ac01e740",
                                                "text": "„Und auch das aktuellste Wahnsinns-Spiel darf freilich nicht fehlen in dieser Sammlung: In der Geschichte der deutschen Nationalmannschaft hat es das noch nicht gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
