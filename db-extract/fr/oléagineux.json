                                        "entry_id": "62ecf2ba-26b0-3d89-b520-30e4f8ad0c1e",
                                        "glosses": [
                                            "The seed of any of several plants which are used commercially as a source of vegetable oil."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b955d5d1-9c2b-4c88-8dc2-7c443d799bb5",
                                                "sense_id": "45e8169f-9d7f-3b72-8108-ff1b8122a86c",
                                                "text": "Ukraine’s exports of grain and oilseeds have mostly stopped and Russia’s are threatened."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7be6f7e6-da32-3dc8-be68-6a1d2554c0ab",
                                        "entry_id": "62ecf2ba-26b0-3d89-b520-30e4f8ad0c1e",
                                        "glosses": [
                                            "The plant that yields such seed."
                                        ],
