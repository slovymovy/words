                                "target_lang_sense_clarification": "внутренний запал, драйв"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "530be377-b3bd-3c41-abec-c6bac19a70d6",
                    "sense_definition": "Sex appeal or sexual energy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "charisma",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor still radiated plenty of <w>mojo</w> even well into his seventies.",
