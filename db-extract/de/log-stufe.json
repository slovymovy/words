                "senses": [
                    {
                        "sense_id": "2e269d4b-21f7-33d8-8075-0b3e34289c38",
                        "entry_id": "35eb98f6-8ab1-37bb-9033-6371bbfd1c16",
                        "glosses": [
                            "Zehnerpotenz, Faktor 10"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df274b63-8455-4dd0-9546-caa2b3bfa9ea",
                                "sense_id": "2e269d4b-21f7-33d8-8075-0b3e34289c38",
                                "text": "„Die Reduktion der Keime wird in der Regel in Log-Stufen angegeben. Dabei beschreibt eine Log-Stufe jeweils die Reduktion um eine Zehnerpotenz. Somit bedeutet die Logstufe 1 eine Reduktion der Keime um 90 %.“"
                            },
                            {
                                "example_id": "ae264809-de13-4321-8bd1-5bc1358f7992",
                                "sense_id": "2e269d4b-21f7-33d8-8075-0b3e34289c38",
                                "text": "Eine Minderung der Bakterienanzahl um 2 Log-Stufen bedeutet, dass 99% der Bakterien abgetötet wurden."
                            },
                            {
                                "example_id": "52ed6de7-8d16-44da-b904-45fe33df4d84",
                                "sense_id": "2e269d4b-21f7-33d8-8075-0b3e34289c38",
                                "text": "„Die Zeit, in der eine Log-Stufe abgetötet wird, ist der so definierte D-Wert.“"
                            },
                            {
                                "example_id": "833d1ae5-8005-472d-a0d2-11fa8d4fb1ef",
                                "sense_id": "2e269d4b-21f7-33d8-8075-0b3e34289c38",
                                "text": "Erst wenn sich die Viruslasten um mindestens eine halbe Log-Stufe unterscheiden, kann das relevant und eine Untersuchung wert sein. Alles darunter ist zu ähnlich, um signifikant zu sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
