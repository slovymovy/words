                    }
                ],
                "translations": [
                    {
                        "translation_id": "541353a7-4353-4e24-ac4f-156b41ede5cb",
                        "source_entry_id": "ed49b14c-de75-32b4-ade4-e4e34c141276",
                        "source_sense_id": "3a2a2136-5a79-3859-8d30-ca2d6dd7d057",
                        "target_lang_word": "civic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "civic",
