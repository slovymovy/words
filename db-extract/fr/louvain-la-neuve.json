                                        "glosses": [
                                            "Planstadt in der belgischen Provinz Wallonisch-Brabant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74af7338-2732-4531-bd32-82ea15e28ad8",
                                                "sense_id": "b8cbacfd-9eb1-3b33-a709-b6c5fa15181b",
                                                "text": "„In Neu-Löwen ist eine Studentin bei einem Sturz von einem Balkon schwer verletzt worden.“"
                                            },
                                            {
                                                "example_id": "7ed7c1f0-2e70-430f-80d9-89204b6c2857",
                                                "sense_id": "b8cbacfd-9eb1-3b33-a709-b6c5fa15181b",
                                                "text": "„Der ostbelgische Ökonom war an verschiedenen Universitäten tätig, sei es u.a. in Amsterdam, Neu-Löwen oder auch in Maastricht, wo er eines der Gründungsmitglieder der Wirtschaftsfakultät war.“"
                                            },
                                            {
                                                "example_id": "56f1b41c-7c42-42ce-a3df-bb0f8befb3e1",
                                                "sense_id": "b8cbacfd-9eb1-3b33-a709-b6c5fa15181b",
                                                "text": "„Es gibt Anlass, eine Umweltverträglichkeitsprüfung über den Vorentwurf zur Revision des Sektorenplans Wavre-Jodoigne-Perwez zwecks Förderung der Verwendung des ‚RER‘ (regionales Nahverkehrsnetz) in der Umgebung des RER-Bahnhofes von Neu-Löwen durchführen zu lassen.“"
                                            }
                                        ],
