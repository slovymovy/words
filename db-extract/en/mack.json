                    {
                        "sense_id": "3f5f17b5-79cc-3598-9c10-2666fec3f3ea",
                        "entry_id": "317ae73c-9ad4-3ec5-8cb0-ec4c8f92ed3c",
                        "glosses": [
                            "weites Kleidungsstück mit Ärmeln, das mindestens bis zu den Knien reicht und wasserdicht ist"
                        ],
                        "tags": [
                            "British",
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ed36fc5-cea3-4f31-840a-063338fe0f13",
                        "source_entry_id": "317ae73c-9ad4-3ec5-8cb0-ec4c8f92ed3c",
                        "source_sense_id": "3f5f17b5-79cc-3598-9c10-2666fec3f3ea",
                        "source_sense_description": "weites Kleidungsstück mit Ärmeln, das mindestens bis zu den Knien reicht und wasserdicht ist",
                        "target_lang_word": "Regenmantel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenmantel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                                        "entry_id": "8ca8b9dc-164e-33b2-aea7-b2535c945672",
                                        "glosses": [
                                            "wasserabweisendes, langes Kleidungsstück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b5d33d-6285-4d1f-890c-7776f34f6bc9",
                                                "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                                                "text": "Er trug einen gelben Regenmantel."
                                            },
                                            {
                                                "example_id": "2e3cbd90-95f5-4c42-a786-5cab7e36ec5e",
                                                "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                                                "text": "„Erst dann zog er seine Gummistiefel und seinen Regenmantel an.“"
                                            },
                                            {
                                                "example_id": "2eb43e95-d063-4313-9f87-3acd311991c5",
                                                "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                                                "text": "„Der für ihn bestimmte Regenmantel wurde zu groß gekauft, saß daher schlecht, sollte aber länger halten – bis er hineingewachsen sein würde.“"
                                            },
                                            {
                                                "example_id": "c7d162fa-0675-4af7-b400-ebee759f91e9",
                                                "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                                                "text": "„Dann stand ich auf und packte den Kerl am Kragen seines verdreckten Regenmantels.“"
                                            },
                                            {
                                                "example_id": "1dd944a9-82e5-4f18-8080-e4af201ff0c9",
                                                "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                                                "text": "„Als ich aussteige, steigt ein dicker Mann mit Regenmantel ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Regenmantel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c915bde7-12e8-3feb-8293-1422a4ce8d6f",
                                        "entry_id": "c12ec8e4-a5da-33d5-90d9-c2529c01fd95",
                                        "glosses": [
                                            "Ortsteil in der Gemeinde Falkenhagen (Mark)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac45c8d-1f95-4348-9cfd-97e4dcf437de",
                                                "sense_id": "c915bde7-12e8-3feb-8293-1422a4ce8d6f",
                                                "text": "„Nach Ende des Zweiten Weltkrieges wurden in Regenmantel viele Umsiedler sesshaft, die hier nach der Bodenreform Grund und Boden erhielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
