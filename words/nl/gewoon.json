                                "de": "Er ist ein ganz <w>gewöhnlicher</w> Junge ohne Allüren.",
                                "fr": "C'est un garçon tout à fait <w>ordinaire</w> sans prétention.",
                                "it": "È un ragazzo molto <w>normale</w> senza arie.",
                                "cs": "Je to úplně <w>obyčejný</w> kluk bez namyšlenosti.",
                                "tr": "O, hiç kaprisi olmayan çok <w>sıradan</w> bir çocuk.",
                                "es": "Es un chico muy <w>normal</w> sin aires de grandeza."
                            }
                        },
                        {
                            "text": "Dit is maar een <gewone> postzegel en niets bijzonders.",
                            "target_lang_translations": {
                                "en": "This is just an <w>ordinary</w> stamp and nothing special.",
                                "ru": "Это всего лишь <обычная> марка, ничего особенного.",
                                "pl": "To tylko <w>zwykły</w> znaczek pocztowy i nic wyjątkowego.",
                                "de": "Das ist nur eine <w>ganz normale</w> Briefmarke und nichts Besonderes.",
                                "fr": "Ce n'est qu'un timbre <w>ordinaire</w> et rien de spécial.",
                                "it": "Questo è solo un <w>comune</w> francobollo e niente di speciale.",
                                "cs": "Tohle je jen <w>obyčejná</w> poštovní známka a nic zvláštního.",
                                "tr": "Bu sadece <w>sıradan</w> bir posta pulu, özel bir şey değil.",
                                "es": "Esto es solo un sello <w>corriente</w> y nada especial."
                            }
                        },
                        {
                            "text": "Doe maar <gewoon>, dan doe je al gek genoeg.",
                            "target_lang_translations": {
                                "en": "Just act <w>normal</w>, that's crazy enough already.",
                                "ru": "Веди себя <нормально>, этого и так достаточно.",
                                "pl": "Zachowuj się <w>normalnie</w>, to już i tak wystarczająco szalone.",
                                "de": "Verhalte dich einfach <w>normal</w>, das ist schon verrückt genug.",
                                "fr": "Comporte-toi <w>normalement</w>, c'est déjà bien assez fou comme ça.",
                                "it": "Comportati in modo <w>normale</w>, che è già abbastanza pazzesco.",
                                "cs": "Chovej se <w>normálně</w>, i tak je to dost šílené.",
                                "tr": "<w>Normal</w> davran, bu zaten yeterince çılgınca.",
                                "es": "Pórtate con <w>normalidad</w>, que ya es bastante locura."
                            }
                        }
