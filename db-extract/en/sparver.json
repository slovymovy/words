                        "glosses": [
                            "A canopy for a bed."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f92c807c-7365-42d4-995e-1fd701c25504",
                                "sense_id": "af1c0a53-de48-3e25-ac72-1b8cb697e081",
                                "text": "And ſo then every of them ſticke up the aungell about the bedde and to lette downe the corteyns of the ſayd bedde or ſparuer."
                            },
                            {
                                "example_id": "ad0106bb-8468-4f5b-9edd-734a78278be1",
                                "sense_id": "af1c0a53-de48-3e25-ac72-1b8cb697e081",
                                "text": "And I geue vnto the ſame Elizabeth my wif the ſparuers and hangings of the ſame twoo beddes vſuallye occupied, and hanging ouer and about the ſame twoo beddes[…]"
                            },
                            {
                                "example_id": "f96a2b21-2d94-43a1-8079-ccbbba021c9a",
                                "sense_id": "af1c0a53-de48-3e25-ac72-1b8cb697e081",
                                "text": "[…]a happie woman is ſeene in a white apron as often as in an embrodred kirtle, and hath as quiet ſleeps and as contented wakings in a bed of cloth as under a ſparver of tiſſue."
                            }
                        ]
                    }
