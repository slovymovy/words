{
    "word_family": [
        "knocker",
        "knockout"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c00f700d-b633-3d7f-b930-5fb471950cb2",
                    "sense_definition": "To hit a door or other surface firmly with the knuckles to make a noise, usually to attract attention or ask for permission to enter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rapping_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>knock</w> on the door before you enter the room.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>постучите</w> в дверь, прежде чем войти в комнату.",
                                "zh": "进房间前请先<w>敲门</w>。"
                            }
                        },
                        {
                            "text": "I heard someone <w>knock</w> three times late at night.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как кто-то трижды <w>постучал</w> поздно ночью.",
                                "zh": "深夜我听到有人<w>敲</w>了三下门。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rap",
                        "tap",
                        "bang"
                    ],
                    "common_phrases": [
                        "knock on the door",
                        "knock and enter",
                        "knock on wood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударять костяшками пальцев по двери или другой поверхности, чтобы произвести шум, обычно для привлечения внимания или просьбы войти.",
                        "zh": "用指关节用力敲击门或其他表面以发出声音，通常是为了引起注意或请求进入。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стучать",
                                "target_lang_sense_clarification": "производить шум ударами"
                            },
                            {
                                "target_lang_word": "постучать",
                                "target_lang_sense_clarification": "совершенный вид, сделать несколько ударов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敲",
                                "target_lang_sense_clarification": "发出声音的击打动作"
                            },
                            {
                                "target_lang_word": "敲门",
                                "target_lang_sense_clarification": "特指敲击门"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dde37456-4c45-33bc-90ed-4ec1c19b4df3",
                    "sense_definition": "To hit, strike, or collide with something or someone, often accidentally or with force, causing movement or damage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "impact_collision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She accidentally <w>knocked</w> the vase off the table with her elbow.",
                            "target_lang_translations": {
                                "ru": "Она случайно <w>сбила</w> вазу со стола локтем.",
                                "zh": "她不小心用手肘把花瓶<w>碰</w>下了桌子。"
                            }
                        },
                        {
                            "text": "The strong wind might <w>knock</w> the old fence down.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер может <w>свалить</w> старый забор.",
                                "zh": "大风可能会把旧栅栏<w>吹倒</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bump",
                        "strike",
                        "hit",
                        "collide",
                        "bang",
                        "bash"
                    ],
                    "common_phrases": [
                        "knock over",
                        "knock down",
                        "knock against"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударять, бить или сталкиваться с чем-то или кем-то, часто случайно или с силой, вызывая движение или повреждение.",
                        "zh": "撞击、打击或与某人或某物发生碰撞，通常是意外或用力过猛，导致物体移动或损坏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбить",
                                "target_lang_sense_clarification": "ударом заставить упасть или сдвинуться"
                            },
                            {
                                "target_lang_word": "ударить",
                                "target_lang_sense_clarification": "нанести удар"
                            },
                            {
                                "target_lang_word": "толкнуть",
                                "target_lang_sense_clarification": "резко задеть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撞",
                                "target_lang_sense_clarification": "碰撞或冲击"
                            },
                            {
                                "target_lang_word": "碰倒",
                                "target_lang_sense_clarification": "因碰撞而使物体倒下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9e24be7-e103-31d4-8aa7-97a2884e6d76",
                    "sense_definition": "To criticize or speak negatively about something or someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not <w>knock</w> it until you have tried it yourself.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>хаять</w> это, пока сам не попробуешь.",
                                "zh": "你自己试过之前，不应该<w>批评</w>它。"
                            }
                        },
                        {
                            "text": "People often <w>knock</w> his methods, but he always gets good results.",
                            "target_lang_translations": {
                                "ru": "Люди часто <w>критикуют</w> его методы, но он всегда добивается хороших результатов.",
                                "zh": "人们经常<w>贬低</w>他的方法，但他总能取得好成绩。"
                            }
                        }
                    ],
                    "synonyms": [
                        "criticize",
                        "disparage",
                        "fault"
                    ],
                    "antonyms": [
                        "praise"
                    ],
                    "common_phrases": [
                        "don't knock it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Критиковать или негативно отзываться о ком-то или чем-то.",
                        "zh": "批评或负面地谈论某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критиковать",
                                "target_lang_sense_clarification": "высказывать неодобрение"
                            },
                            {
                                "target_lang_word": "хаять",
                                "target_lang_sense_clarification": "разг. ругать, очернять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批评",
                                "target_lang_sense_clarification": "指出缺点或错误"
                            },
                            {
                                "target_lang_word": "贬低",
                                "target_lang_sense_clarification": "降低对某人或某事的评价"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c685ea6c-ff14-305c-b911-354cb03851ba",
                    "sense_definition": "A short, abrupt sound made by hitting a hard surface.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rapping_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a loud <w>knock</w> at the door that woke everyone up.",
                            "target_lang_translations": {
                                "ru": "Громкий <w>стук</w> в дверь разбудил всех.",
                                "zh": "门外传来一阵巨大的<w>敲门声</w>，把大家都吵醒了。"
                            }
                        },
                        {
                            "text": "I heard a strange <w>knock</w> coming from the car engine.",
                            "target_lang_translations": {
                                "ru": "Я услышал странный <w>стук</w> в двигателе машины.",
                                "zh": "我听到汽车引擎里传出奇怪的<w>敲击声</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rap",
                        "tap",
                        "thud",
                        "bang"
                    ],
                    "common_phrases": [
                        "knock at the door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий, отрывистый звук, возникающий при ударе о твердую поверхность.",
                        "zh": "敲击坚硬表面时发出的短促而突兀的声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стук",
                                "target_lang_sense_clarification": "звук удара"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敲门声",
                                "target_lang_sense_clarification": "门上的敲击声"
                            },
                            {
                                "target_lang_word": "敲击声",
                                "target_lang_sense_clarification": "一般性的撞击声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67276905-f2a0-3877-9891-7bb3e6a6bf8e",
                    "sense_definition": "A physical blow, collision, or impact.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "impact_collision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a nasty <w>knock</w> to the head during the football match.",
                            "target_lang_translations": {
                                "ru": "Он получил сильный <w>удар</w> по голове во время футбольного матча.",
                                "zh": "他在足球比赛中头部受到了严重的<w>撞击</w>。"
                            }
                        },
                        {
                            "text": "The old table has a few scratches and <w>knocks</w> from years of use.",
                            "target_lang_translations": {
                                "ru": "На старом столе есть несколько царапин и <w>вмятин</w> от многолетнего использования.",
                                "zh": "这张旧桌子因为多年使用，上面有一些划痕和<w>磕碰</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blow",
                        "hit",
                        "bump",
                        "thud",
                        "impact"
                    ],
                    "common_phrases": [
                        "take a knock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический удар, столкновение или воздействие.",
                        "zh": "身体上的打击、碰撞或冲击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "физическое воздействие"
                            },
                            {
                                "target_lang_word": "ушиб",
                                "target_lang_sense_clarification": "повреждение от удара"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撞击",
                                "target_lang_sense_clarification": "物理上的碰撞"
                            },
                            {
                                "target_lang_word": "磕碰",
                                "target_lang_sense_clarification": "轻微的碰撞或损伤"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7efaab12-3124-33a2-8b0c-69d7216a001a",
                    "sense_definition": "A difficult experience, misfortune, or setback.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Losing his job was a terrible <w>knock</w> to his confidence.",
                            "target_lang_translations": {
                                "ru": "Потеря работы стала страшным <w>ударом</w> по его уверенности.",
                                "zh": "失业对他自信心是一个沉重的<w>打击</w>。"
                            }
                        },
                        {
                            "text": "She has learned a lot from the school of hard <w>knocks</w>.",
                            "target_lang_translations": {
                                "ru": "Она многому научилась в школе суровых <w>ударов</w> судьбы.",
                                "zh": "她从生活的<w>挫折</w>中学会了很多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "setback",
                        "blow",
                        "misfortune"
                    ],
                    "antonyms": [
                        "boost"
                    ],
                    "common_phrases": [
                        "hard knocks",
                        "take a knock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелое испытание, несчастье или неудача.",
                        "zh": "困难的经历、不幸或挫折。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "перен. потрясение, беда"
                            },
                            {
                                "target_lang_word": "неудача",
                                "target_lang_sense_clarification": "провал, невезение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打击",
                                "target_lang_sense_clarification": "精神或事业上的挫折"
                            },
                            {
                                "target_lang_word": "挫折",
                                "target_lang_sense_clarification": "遭遇的不顺心之事"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7a6a1fc2-c705-337e-9849-bea67fa5a968",
                    "sense_definition": "A village in County Mayo, Ireland, famous for its religious shrine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Thousands of pilgrims visit <w>Knock</w> every year.",
                            "target_lang_translations": {
                                "ru": "Тысячи паломников посещают <w>Нок</w> каждый год.",
                                "zh": "每年有成千上万的朝圣者访问<w>诺克</w>。"
                            }
                        },
                        {
                            "text": "We drove through the small town of <w>Knock</w> on our tour of Ireland.",
                            "target_lang_translations": {
                                "ru": "Мы проехали через маленький городок <w>Нок</w> во время нашего тура по Ирландии.",
                                "zh": "我们在爱尔兰旅行时开车经过了<w>诺克</w>小镇。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в графстве Мейо, Ирландия, известная своей религиозной святыней.",
                        "zh": "爱尔兰梅奥郡的一个村庄，以其宗教圣地而闻名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Нок",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诺克",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9ebae38-9aae-3f30-9c51-d8a8b811f7aa",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Knock</w> was the first to arrive at the meeting.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Нок</w> прибыл на собрание первым.",
                                "zh": "<w>诺克</w>先生是第一个到达会议现场的。"
                            }
                        },
                        {
                            "text": "I went to school with a girl whose last name was <w>Knock</w>.",
                            "target_lang_translations": {
                                "ru": "Я учился в школе с девочкой, чья фамилия была <w>Нок</w>.",
                                "zh": "我上学时有个同学姓<w>诺克</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Нок",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诺克",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}