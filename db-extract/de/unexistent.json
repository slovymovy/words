                    },
                    {
                        "translation_id": "43bd1662-6998-4865-9381-1093387e9a42",
                        "source_entry_id": "f50015ca-4283-3647-80db-6d399f1c4f5c",
                        "source_sense_id": "7c5f6c24-5f5e-3493-9e3b-ce25f5f60ca8",
                        "source_sense_description": "nicht vorhanden, nicht da, nicht existent",
                        "target_lang_word": "nonexistent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonexistent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "639f7a12-222a-35ee-9a71-12a451a7769f",
                                        "entry_id": "d991610b-fe77-3e0c-9d10-349435865b36",
                                        "glosses": [
                                            "Not existent or existing; not real."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b98bf38-6552-4de3-84c3-3dd66f4b7015",
                                                "sense_id": "639f7a12-222a-35ee-9a71-12a451a7769f",
                                                "text": "\"Hrunk\" is a nonexistent word."
                                            },
                                            {
                                                "example_id": "18371a5d-01e9-4e1a-a10d-2ff20aa63e7a",
                                                "sense_id": "639f7a12-222a-35ee-9a71-12a451a7769f",
                                                "text": "His social skills are nonexistent: he chewed with his mouth open all through dinner."
                                            },
                                            {
                                                "example_id": "a894acf0-1295-4f00-992a-296fed2db2b4",
                                                "sense_id": "639f7a12-222a-35ee-9a71-12a451a7769f",
                                                "text": "In the 1995 Test Census, the Bureau plans to test the use of Postal Service letter carriers to identify vacant and nonexistent units when it mails census questionnaires."
                                            },
                                            {
                                                "example_id": "c44af59f-9cdb-4ba0-aeac-f048db0782d3",
                                                "sense_id": "639f7a12-222a-35ee-9a71-12a451a7769f",
                                                "text": "If there is anything of philosophical significance to be taken at face value in ordinary thought and language it is the reference and attribution of properties to existent and nonexistent objects."
                                            },
                                            {
                                                "example_id": "97744376-13f7-4d98-9744-d971358424c3",
                                                "sense_id": "639f7a12-222a-35ee-9a71-12a451a7769f",
                                                "text": "Conversely, to return to the point at hand, nonexistent entities can be known, even by a Buddha, without being, thereby, substantial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02db6801-15d8-3e17-9c66-9a8f94cae8a2",
                                        "entry_id": "d991610b-fe77-3e0c-9d10-349435865b36",
                                        "glosses": [
                                            "Not present or occurring."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0fb452-86fd-4a65-a708-3d4dd22246eb",
                                                "sense_id": "02db6801-15d8-3e17-9c66-9a8f94cae8a2",
                                                "text": "Large cranes were virtually non-existent in the areas I worked with this truck, so we jacked everything on and off[.]"
                                            },
                                            {
                                                "example_id": "ed38da9a-218e-4d83-a0f6-ce724b496bbb",
                                                "sense_id": "02db6801-15d8-3e17-9c66-9a8f94cae8a2",
                                                "text": "The opposite issue emerges in the summer when students face scorching temperatures with unreliable or nonexistent air conditioning."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nonexistent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc4b3af3-7803-3129-9ff7-8801e67fc625",
                                        "entry_id": "78fc14e5-3c69-355b-9b10-070f3d03d642",
                                        "glosses": [
                                            "Something that does not exist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab3ab6ed-9d77-476f-a2e7-7437435d6c22",
                                                "sense_id": "dc4b3af3-7803-3129-9ff7-8801e67fc625",
                                                "text": "By showing that no true statements were about nonexistents, he dismissed any facts or knowledge about the so-called beingless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36cddad9-0ed7-4084-92ae-3b4edc3f7707",
