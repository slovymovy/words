                                    {
                                        "sense_id": "6769f978-ebf5-3d16-872c-4ff43f9b7364",
                                        "entry_id": "c04562bd-b971-3884-9ccd-e863e8814fba",
                                        "glosses": [
                                            "A high-ranking officer in the household of a medieval prince or lord, who was originally in charge of the cavalry and later the military forces in general."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fabc0d7-c56f-3956-915d-a555e2a9aac5",
                                        "entry_id": "c04562bd-b971-3884-9ccd-e863e8814fba",
                                        "glosses": [
                                            "A military officer of the highest rank in several countries, including France and the former Soviet Union; equivalent to a general of the army in the United States. See also field marshal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7013b8da-6906-4728-a766-206970498829",
                                                "sense_id": "6fabc0d7-c56f-3956-915d-a555e2a9aac5",
                                                "text": "Where stands Marshal Chiang Kai-shek in this conflict of opinion concerning the tactics which China should adopt towards the aggressor? Chiang Kai-shek, according to officials who know his mind with whom I have talked, is all for resistance- as soon as he thinks he can win!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b0ccb6a-ccee-3897-bd81-cd759993f551",
                                        "entry_id": "c04562bd-b971-3884-9ccd-e863e8814fba",
                                        "glosses": [
                                            "A person in charge of the ceremonial arrangement and management of a gathering."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c6e3605-196d-3233-a314-161caa42eae9",
                                        "entry_id": "c04562bd-b971-3884-9ccd-e863e8814fba",
                                        "glosses": [
                                            "A federal lawman."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0dfd57b-90c9-34f2-8b3a-eba1d836e634",
                                        "entry_id": "c04562bd-b971-3884-9ccd-e863e8814fba",
                                        "glosses": [
                                            "An official responsible for signalling track conditions to drivers (through use of flags), extinguishing fires, removing damaged cars from the track, and sometimes providing emergency first aid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "marshal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57231d97-1fd3-36cd-9738-eec4b8dbd569",
                                        "entry_id": "76efcbb1-b893-37bd-8226-1ec72359a30d",
                                        "glosses": [
                                            "To arrange (troops, etc.) in line for inspection or a parade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcc2761c-c847-4a7a-a0c4-92b8215f8836",
                                                "sense_id": "57231d97-1fd3-36cd-9738-eec4b8dbd569",
                                                "text": "Nothing could be more business-like than the construction of the stout dams, and nothing more gently rural than the limpid lakes, with the grand old forest trees marshalled round their margins like a veteran army that had marched down to drink, only to be stricken motionless at the water’s edge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92c75d70-3d55-39a7-8ae7-487ad701aa58",
                                        "entry_id": "76efcbb1-b893-37bd-8226-1ec72359a30d",
                                        "glosses": [
                                            "To arrange (facts, etc.) in some methodical order."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0df8c31-db9c-459a-903d-58fbd47d6170",
                                                "sense_id": "92c75d70-3d55-39a7-8ae7-487ad701aa58",
                                                "text": "Within a blue garter inscribed \"Great Northern Railway Ireland\" is a shield, on which are marshalled the arms of the principal towns in the company's area. The shield is divided quarterly with the arms of Dublin in the first quarter, Londonderry in the second quarter, Enniskillen in the third, and Belfast in the fourth; and overall is a gold inescutcheon (a small shield placed in the centre of the large shield) charged with the red left hand of Ulster."
                                            },
                                            {
                                                "example_id": "303bc441-082a-4687-8c3d-3207018729e7",
                                                "sense_id": "92c75d70-3d55-39a7-8ae7-487ad701aa58",
                                                "text": "This train is formed only of \"Blue Spot\" wagons for London; vans for Mac Fisheries Finsbury Park depot are marshalled at the rear to be detached at Finsbury Park."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fab59ce6-02fe-3122-aa80-ba23e3960066",
                                        "entry_id": "76efcbb1-b893-37bd-8226-1ec72359a30d",
                                        "glosses": [
                                            "To ceremoniously guide, conduct or usher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e8d56e7-aa31-4f70-8fcb-59cdfee194ef",
                                                "sense_id": "fab59ce6-02fe-3122-aa80-ba23e3960066",
                                                "text": "Our conquering ſwords ſhal marſhal vs the way\nUUe vſe to martch vpon the ſlaughtered foe:\nTrampling their bowels with our horſes hoofes: […]"
                                            }
                                        ]
                                    },
