                ],
                "senses": [
                    {
                        "sense_id": "52b7dd65-97af-3dda-89d0-5bd9c9eb39a5",
                        "entry_id": "8941df80-ae5b-39f8-b34a-cf7570262ab7",
                        "glosses": [
                            "pozbawiony konsekwencji (np. w działaniu, planach); sprzeczny, nielogiczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fea6ad30-5e26-4850-9c1a-fbb325dc9616",
                                "sense_id": "52b7dd65-97af-3dda-89d0-5bd9c9eb39a5",
                                "text": "Stałym zmianom podlegał natomiast stosunek do ars amandi, miłości, wstydu, prywatności, intymności, kategorii czasu. Pewnym - aczkolwiek niekonsekwentnym - zmianom ulegał stosunek do pracy i tzw. próżnowania"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01f1db2d-fe85-41ef-a894-93ca8dd16e8b",
                        "source_entry_id": "8941df80-ae5b-39f8-b34a-cf7570262ab7",
                        "source_sense_id": "52b7dd65-97af-3dda-89d0-5bd9c9eb39a5",
                        "target_lang_word": "inconsequent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsequent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a0bfd60-127d-3f9f-a5f2-5464081db665",
                                        "entry_id": "fa455d8e-ee6c-3e59-ae12-b8758c113cb4",
                                        "glosses": [
                                            "Alternative form of inconsequential."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d0c541d-e950-4ff9-ac98-ad86a8ee2a27",
                                                "sense_id": "6a0bfd60-127d-3f9f-a5f2-5464081db665",
                                                "text": "—Don’t mope over it all day, he said. I’m inconsequent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "264ecbb4-0b74-3217-9723-29a76acee454",
                                        "entry_id": "fa455d8e-ee6c-3e59-ae12-b8758c113cb4",
                                        "glosses": [
                                            "illogical; not following from the premises"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debb26c1-49a4-481b-81d4-4b4146619abb",
                                                "sense_id": "264ecbb4-0b74-3217-9723-29a76acee454",
                                                "text": "She looked at him a minute, and it came to him as he met it an inconsequent sense that her eyes, when one got their full clearness, were still as beautiful as they had been in youth, only beautiful with a strange, cold light - a light that somehow was a part of the effect, if it wasn't rather a part of the cause, of the pale, hard sweetness of the season and the hour."
                                            },
                                            {
                                                "example_id": "bc8d613d-4293-4e9d-9e9e-96c1523653b6",
                                                "sense_id": "264ecbb4-0b74-3217-9723-29a76acee454",
                                                "text": "That possibility was now ever so much further from sight than on the eve of his arrival, and he perfectly felt that, should it come at all, it would have to be at best inconsequent and violent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ebeb8ca-d6d4-4fc6-84e4-0fc482550058",
                        "source_entry_id": "8941df80-ae5b-39f8-b34a-cf7570262ab7",
                        "source_sense_id": "52b7dd65-97af-3dda-89d0-5bd9c9eb39a5",
                        "target_lang_word": "inconsequential",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsequential",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b8ab168-a3f3-352a-a74b-20579180e0e3",
                                        "entry_id": "2b01842e-354e-3910-b2f8-94b595981748",
                                        "glosses": [
                                            "Something unimportant; something that does not matter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "inconsequential",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f1c46a5-c5bf-3b4b-9040-d3258ab4be8b",
                                        "entry_id": "a5496d87-2f89-39db-b0ec-d8a4e134e3a8",
                                        "glosses": [
                                            "Having no consequence; not consequential; of little importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e096e503-61dc-4b05-b693-bd16b1259c83",
                                                "sense_id": "4f1c46a5-c5bf-3b4b-9040-d3258ab4be8b",
                                                "text": "You will never know the exact atomic time when you started reading this phrase; of course, that's inconsequential."
                                            },
                                            {
                                                "example_id": "d4ffa109-2b8d-4702-bfe3-261af29b22de",
                                                "sense_id": "4f1c46a5-c5bf-3b4b-9040-d3258ab4be8b",
                                                "text": "“[…]Because desire just cheats you. It's like a sunbeam skipping here and there about a room. It stops and gilds some inconsequential object, and we poor fools try to grasp it—but when we do the sunbeam moves on to something else, and you've got the inconsequential part, but the glitter that made you want it is gone—” He broke off uneasily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cda5896-e0c7-347d-8896-e8e9c533a459",
                                        "entry_id": "a5496d87-2f89-39db-b0ec-d8a4e134e3a8",
                                        "glosses": [
                                            "Not logically following from the premises."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41432c45-a7fd-4acb-8f2d-ea54699534ff",
                        "source_entry_id": "8941df80-ae5b-39f8-b34a-cf7570262ab7",
                        "source_sense_id": "52b7dd65-97af-3dda-89d0-5bd9c9eb39a5",
                        "target_lang_word": "inconsistent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsistent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc15a936-a1a6-3dde-b822-da414cf6eef5",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Not compatible (with another thing); incompatible, discrepant, at odds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd955f6-055f-43c2-adfd-47a929f3be83",
                                                "sense_id": "fc15a936-a1a6-3dde-b822-da414cf6eef5",
                                                "text": "His account of the evening was inconsistent with the security-camera footage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "151d6f9f-745c-3dbb-8531-1b56d67bd525",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Lacking internal consistency; self-contradicting; not compatible with itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68288e3-2718-4293-831b-9d794488dfb2",
                                                "sense_id": "151d6f9f-745c-3dbb-8531-1b56d67bd525",
                                                "text": "He gave an inconsistent account of the evening, saying he called her before eight, but later that he had not talked to her until after nine."
                                            },
                                            {
                                                "example_id": "a82d5d89-c95d-435b-a52f-f80ae0041149",
                                                "sense_id": "151d6f9f-745c-3dbb-8531-1b56d67bd525",
                                                "text": "He was one of those men of inconsistent politics, governed at once by prejudice and sympathies, whose 'attitude' it is impossible to foretell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb863a4e-d9af-3b19-8ef1-1fa6d325180b",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Not consistent or coherent in thought or behavior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a57db2e6-84a7-41be-9523-6577263c28f2",
                                                "sense_id": "fb863a4e-d9af-3b19-8ef1-1fa6d325180b",
                                                "text": "“Take him for better or worse,” added Mr. Lee, “and I think he is the strangest and most inconsistent man I ever saw.”\n“Inconsistent!” resumed Mr. Jones. “He is worse than inconsistent. Inconsistencies may be pardoned as constitutional defects [...]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd1c154f-537b-3dd9-91cc-ff4e98fb6f5e",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Having the property that a contradiction can be derived."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
