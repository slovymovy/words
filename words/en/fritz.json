                            }
                        },
                        {
                            "text": "My grandfather <w>Fritz</w> always tells the best stories about his childhood.",
                            "target_lang_translations": {
                                "cs": "Můj dědeček <w>Fritz</w> vždy vypráví ty nejlepší historky ze svého dětství."
                            }
