                                        "entry_id": "1915f588-a28e-37d1-8a99-8123bae67a7d",
                                        "glosses": [
                                            "cura dei disturbi mentali e delle malattie psicosomatiche che si poggia sull'uso di tecniche psicologiche, quali la psicanalisi e l'ipnosi, e si avvale dell'interazione tra paziente ed analista"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "942cc3d0-af89-4b97-919a-987a09700d72",
                                                "sense_id": "2c0eb90a-8297-39de-abf1-574a0d72f991",
                                                "text": "fare un trattamento intensivo di psicoterapia"
                                            },
                                            {
                                                "example_id": "96c3c407-76e5-4e06-8ed2-354953c8e713",
                                                "sense_id": "2c0eb90a-8297-39de-abf1-574a0d72f991",
                                                "text": "come invece la terapia psichiatrica, la psicoterapia non è sempre necessariamente farmacologica"
                                            }
                                        ]
