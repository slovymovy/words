                "senses": [
                    {
                        "sense_id": "25b79ef0-f6af-327b-aea2-b660549b8e85",
                        "entry_id": "b21fc037-51f4-3e4f-b4c3-88c307527a68",
                        "glosses": [
                            "obywatel Iraku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8840d02-903f-4282-a3d2-c2cc911c9c3d",
                                "sense_id": "25b79ef0-f6af-327b-aea2-b660549b8e85",
                                "text": "Większość Irakijczyków to muzułmanie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e64a597f-51ca-4351-8c6b-3d49c55b0977",
                        "source_entry_id": "b21fc037-51f4-3e4f-b4c3-88c307527a68",
                        "source_sense_id": "25b79ef0-f6af-327b-aea2-b660549b8e85",
                        "target_lang_word": "Iraqi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iraqi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f926c75d-2368-33ca-955b-b2852c5781ab",
                                        "entry_id": "730c7324-de73-3b0e-9b1c-bbf8a0095017",
                                        "glosses": [
                                            "A person from Iraq or of Iraqi descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b6b0b47-b235-4889-a07b-818afa11e611",
                                                "sense_id": "f926c75d-2368-33ca-955b-b2852c5781ab",
                                                "text": "The order, which effectively halts the display of the flag virtually anywhere in Iraq, except the United States Embassy, said that flying the flag on buildings in Iraq would only reenforce the anti-American message that the military was \"here to oppress the Iraqis.\""
                                            },
                                            {
                                                "example_id": "2205adef-b459-40ff-83d0-2b9a35435e8d",
                                                "sense_id": "f926c75d-2368-33ca-955b-b2852c5781ab",
                                                "text": "They had to choose between properly equipping the Iraqis and risk seeing arms fall into the hands of insurgents or providing inferior weapons that would make it harder to fight them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Iraqi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a72e6f3-2e29-3503-b439-45a03c118b05",
                                        "entry_id": "b7a8e87e-c5cd-3269-9828-0ab50d470e16",
                                        "glosses": [
                                            "Of, from, or pertaining to Persian Iraq."
                                        ],
                                        "tags": [
                                            "historical",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a9ff7a7-0549-34d9-96dd-6ac2e774943b",
                                        "entry_id": "b7a8e87e-c5cd-3269-9828-0ab50d470e16",
                                        "glosses": [
                                            "Of, from, or pertaining to Iraq, or the Iraqi people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4edca4c3-a1e7-488c-9dc6-71afb004a710",
                                                "sense_id": "5a9ff7a7-0549-34d9-96dd-6ac2e774943b",
                                                "text": "The United States and other allied forces have helped Iraqi forces carry out more than 250 counterterrorism missions since last October, according to a senior U.S. military official."
                                            },
                                            {
                                                "example_id": "213942fa-0645-430e-b0d2-f2355ee70786",
                                                "sense_id": "5a9ff7a7-0549-34d9-96dd-6ac2e774943b",
                                                "text": "Under an urgent need to arm Iraqi forces, weapons had been supplied by coalition members and Iraqi procurements, and captured weapons had also been used, Dempsey said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
