                ],
                "senses": [
                    {
                        "sense_id": "ba464627-c585-3b67-8f9f-6b8a861001ea",
                        "entry_id": "15281f87-01d6-3f2f-81db-c8ead13cdce8",
                        "glosses": [
                            "von 1945 bis 1975 dauernder bewaffneter Konflikt in Vietnam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8837818e-aeb7-49b7-b2f2-ba4b049de15c",
                                "sense_id": "ba464627-c585-3b67-8f9f-6b8a861001ea",
                                "text": "Es wird geschätzt, dass zwei bis vier Millionen Vietnamesen durch den Vietnamkrieg ums Leben gekommen sind."
                            },
                            {
                                "example_id": "cdd6f478-4787-44e3-9302-ff3acba90714",
                                "sense_id": "ba464627-c585-3b67-8f9f-6b8a861001ea",
                                "text": "„Sie entschuldigten sich später damit, dass viele Zivilisten ohne Uniform gekämpft hätten, ein Argument, das auch im Vietnamkrieg wieder aufgegriffen wurde.“"
                            },
                            {
                                "example_id": "00458ba4-239a-4b4f-83da-bef4583fce33",
                                "sense_id": "ba464627-c585-3b67-8f9f-6b8a861001ea",
                                "text": "„Demos gegen den Vietnamkrieg gab es wie im Jahr zuvor.“"
                            },
                            {
                                "example_id": "4d5d2aee-8962-405d-83f6-87ddf5a28465",
                                "sense_id": "ba464627-c585-3b67-8f9f-6b8a861001ea",
                                "text": "„Powells Weg zu höchsten Ämtern führte über den Vietnamkrieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9b35166-6094-47bb-a3c5-bb8e17a065a1",
                        "source_entry_id": "15281f87-01d6-3f2f-81db-c8ead13cdce8",
                        "source_sense_id": "ba464627-c585-3b67-8f9f-6b8a861001ea",
                        "target_lang_word": "Vietnam War",
