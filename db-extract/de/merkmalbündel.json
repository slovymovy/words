                        "entry_id": "90340dc2-f2bf-367f-864c-7919d560432a",
                        "glosses": [
                            "Menge der Merkmale einer sprachlichen Einheit; vor allem Laute oder Phoneme und die Bedeutung von Wörtern werden als „Merkmalbündel“ bestimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf3ddce1-d1f8-4d34-b74c-f6181fff5cd5",
                                "sense_id": "ce0da7c1-8b3b-3ae9-89f3-00acff983a9a",
                                "text": "Die Menge der artikulatorischen oder phonologischen Merkmale eines Lautes oder Phonems bilden ein Merkmalbündel."
                            },
                            {
                                "example_id": "86eee6c3-1470-4aeb-917d-2af283d3778b",
                                "sense_id": "ce0da7c1-8b3b-3ae9-89f3-00acff983a9a",
                                "text": "Auch das Semem ist ein Merkmalbündel: es ist das Bündel semantischer Merkmale (Seme) eines Morphems."
                            }
                        ],
