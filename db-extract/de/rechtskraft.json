                        ],
                        "form": "die Rechtskraft"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb1d7175-737c-3044-ba3d-0022b74daf02",
                        "entry_id": "228a09ff-71aa-31a1-8285-efee8bfaec2e",
                        "glosses": [
                            "Unanfechtbarkeit einer Gerichtsentscheidung wegen Ablaufs der Rechtsmittelfrist, wegen wirksamen Rechtsmittelverzichts oder wegen Fehlens von Rechtsmitteln"
                        ],
                        "tags": [
                            "deutsches Prozessrecht",
                            "formelle Rechtskraft"
                        ],
                        "examples": [
                            {
                                "example_id": "e0cac3ae-18c1-450d-b2d1-610806b1881d",
                                "sense_id": "fb1d7175-737c-3044-ba3d-0022b74daf02",
                                "text": "Ein Prozessurteil ist nur der formellen Rechtskraft fähig."
                            },
                            {
                                "example_id": "5224438c-7e60-44b6-900e-9d67ce535734",
                                "sense_id": "fb1d7175-737c-3044-ba3d-0022b74daf02",
                                "text": "„Wenn ein Versäumungsurteil formell richtig zugestellt und innerhalb der Rechtsmittelfrist kein Rechtsmittel erhoben worden ist, ist das Urteil in Rechtskraft erwachsen.“"
                            },
                            {
                                "example_id": "28969bd8-45a3-434a-948c-f16c1f34ce28",
                                "sense_id": "fb1d7175-737c-3044-ba3d-0022b74daf02",
                                "text": "„Am 11. September erhält dieses Urteil Rechtskraft, wird am Tage darauf in effigie vollzogen und ein dementsprechendes Protokoll angefertigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "59e61733-bda4-3e83-98d6-1164054a719b",
                        "entry_id": "228a09ff-71aa-31a1-8285-efee8bfaec2e",
                        "glosses": [
                            "Verbindlichkeit einer Gerichtsentscheidung, die zur Folge hat, dass deren konkreter Inhalt auch über den entschiedenen Rechtsstreit hinaus etwa in nachfolgenden Prozessen maßgeblich ist"
                        ],
                        "tags": [
                            "deutsches Prozessrecht",
                            "materielle Rechtskraft"
                        ],
                        "examples": [
                            {
                                "example_id": "0a3e6e09-82c6-4eca-be24-d2e838f0b7fa",
                                "sense_id": "59e61733-bda4-3e83-98d6-1164054a719b",
                                "text": "„Ob und inwieweit in Arrest- und Verfügungsverfahren ergangene Entscheidungen (§§ 936, 922 ZPO) in materielle Rechtskraft erwachsen, ist umstritten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
