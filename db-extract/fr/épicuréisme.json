                        "examples": [
                            {
                                "example_id": "b3615f7e-6bdf-4ac4-8ab8-03b7fd2ec92c",
                                "sense_id": "2081d5aa-a7ac-3328-beaf-53a9b18b607b",
                                "text": "Enfin, avez-vous jamais réfléchi au sens général des mœurs anglaises ? N’est-ce pas la divinisation de la matière, un épicuréisme défini, médité, savamment appliqué ?"
                            },
                            {
                                "example_id": "5df22481-d507-4df7-afa0-4f67b6aca9be",
                                "sense_id": "2081d5aa-a7ac-3328-beaf-53a9b18b607b",
                                "text": "Le stoïcisme et lʼépicuréisme ont pu être, comme le dit Montaigne de lʼépicuréisme du doute, un oreiller doux et suffisant à quelques uns, car lʼorgueil calme du stoïcien a aussi sa douceur."
                            },
                            {
                                "example_id": "1d1c5974-fadc-46fd-b783-ff044115a63c",
                                "sense_id": "2081d5aa-a7ac-3328-beaf-53a9b18b607b",
                                "text": "Lucrèce chanta l’épicuréisme, Celse le professa sous Adrien, Pline le naturaliste sous Tibère."
                            }
                        ]
                    }
