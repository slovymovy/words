{
    "word_family": [
        "profound",
        "profundity"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d4c6a173-c3e2-3236-b604-f781eb7414cc",
                    "sense_definition": "To a great or intense degree; very strongly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was <w>profoundly</w> affected by the news of his recovery.",
                            "target_lang_translations": {
                                "tr": "Hasta, iyileştiği haberinden <w>derinden</w> etkilendi."
                            }
                        },
                        {
                            "text": "She was <w>profoundly</w> <w>troubled</w> by the events of the past week.",
                            "target_lang_translations": {
                                "tr": "Geçen haftaki olaylardan <w>derinden</w> sarsılmıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "deeply",
                        "extremely",
                        "intensely"
                    ],
                    "antonyms": [
                        "slightly",
                        "superficially"
                    ],
                    "common_phrases": [
                        "profoundly troubled",
                        "profoundly affected",
                        "profoundly negative"
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok yüksek veya yoğun bir derecede; oldukça güçlü bir şekilde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "derinden",
                                "target_lang_sense_clarification": "Duygusal veya fiziksel olarak yoğun bir şekilde etkilenme durumlarında kullanılır."
                            },
                            {
                                "target_lang_word": "son derece",
                                "target_lang_sense_clarification": "Bir durumun yoğunluğunu vurgulamak için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b5f10d7-1f21-337e-8fc1-9b082f179a31",
                    "sense_definition": "In a way that shows great knowledge, insight, or intellectual depth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intellectual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher spoke <w>profoundly</w> about the nature of human existence.",
                            "target_lang_translations": {
                                "tr": "Filozof, insan varoluşunun doğası hakkında <w>derinlemesine</w> konuştu."
                            }
                        },
                        {
                            "text": "He <w>thought</w> <w>profoundly</w> before answering the difficult question.",
                            "target_lang_translations": {
                                "tr": "Zor soruyu cevaplamadan önce <w>derinlemesine</w> düşündü."
                            }
                        }
                    ],
                    "synonyms": [
                        "insightfully",
                        "thoughtfully"
                    ],
                    "common_phrases": [
                        "thought profoundly"
                    ],
                    "target_lang_definitions": {
                        "tr": "Büyük bir bilgi, içgörü veya entelektüel derinlik gösterecek şekilde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "derinlemesine",
                                "target_lang_sense_clarification": "Bir konuyu veya düşünceyi detaylı ve kapsamlı bir şekilde ele alırken kullanılır."
                            },
                            {
                                "target_lang_word": "derin bir şekilde",
                                "target_lang_sense_clarification": "Felsefi veya entelektüel bir derinlik içeren ifadeler için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7d794ee-07e0-3415-874b-f7fe6b5f9a5f",
                    "sense_definition": "In a way that has a significant or fundamental impact.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "significance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law <w>profoundly</w> <w>changed</w> the way the company operates.",
                            "target_lang_translations": {
                                "tr": "Yeni yasa, şirketin işleyişini <w>köklü bir şekilde</w> değiştirdi."
                            }
                        },
                        {
                            "text": "More <w>profoundly</w>, the discovery challenged our basic understanding of physics.",
                            "target_lang_translations": {
                                "tr": "Daha da <w>köklü bir şekilde</w>, bu keşif temel fizik anlayışımıza meydan okudu."
                            }
                        }
                    ],
                    "synonyms": [
                        "significantly",
                        "fundamentally"
                    ],
                    "common_phrases": [
                        "profoundly changed",
                        "profoundly impacted"
                    ],
                    "target_lang_definitions": {
                        "tr": "Önemli veya temel bir etkiye sahip olacak şekilde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "köklü bir şekilde",
                                "target_lang_sense_clarification": "Temel bir değişikliği veya etkiyi ifade ederken kullanılır."
                            },
                            {
                                "target_lang_word": "önemli ölçüde",
                                "target_lang_sense_clarification": "Bir durumun üzerinde yarattığı büyük etkiyi belirtmek için kullanılır."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}