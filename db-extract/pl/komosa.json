                                        "examples": [
                                            {
                                                "example_id": "0e7b7db9-cc7d-4176-90fe-f8e310dba414",
                                                "sense_id": "999c375d-9d69-3f82-9618-0ba39079c422",
                                                "text": "Auf dem Wege lag ein abgeschossener Gänsefuß."
                                            },
                                            {
                                                "example_id": "07607db9-0dee-4a0e-ac37-156c6293e9d6",
                                                "sense_id": "999c375d-9d69-3f82-9618-0ba39079c422",
                                                "text": "„Guillemets sehen im Gegensatz zu Gänsefüßchen wie Gänsefüße aus und sind nach einem gewissen Guillaume benannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
