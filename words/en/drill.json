                                "target_lang_word": "учения",
                                "target_lang_sense_clarification": "военные или аварийные мероприятия"
                            },
                            {
                                "target_lang_word": "строевая подготовка",
                                "target_lang_sense_clarification": "военная маршировка"
                            },
                            {
                                "target_lang_word": "муштра",
                                "target_lang_sense_clarification": "суровая дисциплинарная подготовка"
