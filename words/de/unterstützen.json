    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d679825f-f0f4-3824-9562-2dc92883e7c4",
                    "sense_definition": "Jemandem bei einer Tätigkeit helfen oder finanziellen Beistand leisten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hilfe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meine Eltern <w>unterstützen</w> mich während des gesamten Studiums finanziell."
                        },
                        {
                            "text": "Die Kollegen <w>unterstützen</w> den neuen Mitarbeiter tatkräftig bei seinen Aufgaben."
                        }
                    ],
                    "synonyms": [
                        "helfen",
                        "beistehen",
                        "fördern"
                    ],
                    "antonyms": [
                        "behindern",
                        "erschweren"
                    ],
                    "common_phrases": [
                        "finanziell unterstützen",
                        "tatkräftig unterstützen",
                        "gegenseitig unterstützen"
                    ]
                },
                {
                    "sense_id": "47f1336e-9861-3ec0-a8ef-179564d02272",
                    "sense_definition": "Einen Plan, eine Meinung oder eine Person befürworten und sich dafür einsetzen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hilfe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Bürger <w>unterstützen</w> den neuen Vorschlag zur Verbesserung des Nahverkehrs."
                        },
                        {
                            "text": "Wir <w>unterstützen</w> diese wichtige Initiative voll und ganz."
                        }
                    ],
                    "synonyms": [
                        "befürworten",
                        "gutheißen"
                    ],
                    "antonyms": [
                        "ablehnen",
                        "bekämpfen"
                    ],
                    "common_phrases": [
                        "einen Vorschlag unterstützen",
                        "ein Projekt unterstützen"
                    ]
                },
                {
                    "sense_id": "44389018-a695-345b-b689-4f98d4406a93",
                    "sense_definition": "In der Technik oder Informatik: mit einem bestimmten System, Programm oder Standard kompatibel sein.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Diese moderne Software <w>unterstützt</w> alle gängigen Betriebssysteme und Geräte."
                        },
                        {
                            "text": "Der ältere Webbrowser <w>unterstützt</w> diese neue Funktion leider nicht mehr."
                        }
                    ],
                    "common_phrases": [
                        "ein Format unterstützen",
                        "eine Funktion unterstützen"
                    ]
                },
                {
                    "sense_id": "44c1df61-4e4e-3f81-9803-c1d238075044",
                    "sense_definition": "Einen Gegenstand von unten her mit einer Stütze versehen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Zimmermann <w>stützte</w> den baufälligen Holzbalken vorsichtig mit einem Pfeiler <w>unter</w>."
                        },
                        {
                            "text": "Um ein Einstürzen der Decke zu verhindern, <w>stützten</w> die Arbeiter sie provisorisch <w>unter</w>."
                        }
                    ],
                    "synonyms": [
                        "abstützen",
                        "unterbauen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "in dieser trennbaren Bedeutung veraltet"
                        }
                    ]
                }
            ]
        },
