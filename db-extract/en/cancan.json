    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5f75b7bd-e3ae-3776-8758-80e232f68445",
                "word": "cancan",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b5bf8560-f668-40f5-a2de-fc073fea5dd1",
                        "entry_id": "5f75b7bd-e3ae-3776-8758-80e232f68445",
                        "tags": [
                            "plural"
                        ],
                        "form": "cancans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82bed2ef-4dd3-30dc-9129-a430e0c24fe6",
                        "entry_id": "5f75b7bd-e3ae-3776-8758-80e232f68445",
                        "glosses": [
                            "A high-kicking chorus line dance originating in France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b644441-56b8-4c37-aa2a-fe0c4143adff",
                                "sense_id": "82bed2ef-4dd3-30dc-9129-a430e0c24fe6",
                                "text": "They formed up, in perfect silence, in two lines, facing each other between us and the fire, and then the dance - a sort of infernal and fiendish cancan - began."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fdc174c-2b03-3c5c-9fdc-42e18d3cac5f",
                        "entry_id": "5f75b7bd-e3ae-3776-8758-80e232f68445",
                        "glosses": [
                            "A trick where one leg is brought over the seat, so that both legs are on one side."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd387860-b082-4a4b-af68-c72df459aec2",
                        "source_entry_id": "5f75b7bd-e3ae-3776-8758-80e232f68445",
                        "source_sense_description": "dance",
                        "target_lang_word": "kankán",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "64a1a731-7288-44d1-ae97-b5f672adce67",
                        "source_entry_id": "5f75b7bd-e3ae-3776-8758-80e232f68445",
                        "source_sense_description": "dance",
                        "target_lang_word": "cancan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cancan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06e01a40-98d1-33e8-92bb-7d05afd22a83",
                                        "entry_id": "625822c7-722e-3f20-a406-bdc98f126c48",
                                        "glosses": [
                                            "Grand bruit fait autour d'une chose qui n'en vaut pas la peine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d9358d9-2264-415f-bff1-45f8b30e4414",
                                                "sense_id": "06e01a40-98d1-33e8-92bb-7d05afd22a83",
                                                "text": "Faire un grand cancan de pas grand chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0649ad18-13ca-396d-b66b-7d25b3979353",
                                        "entry_id": "625822c7-722e-3f20-a406-bdc98f126c48",
                                        "glosses": [
                                            "Bavardage souvent médisant ou péjoratif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bec19efd-b7b9-4d9e-8e2c-04bb8eb847db",
                                                "sense_id": "0649ad18-13ca-396d-b66b-7d25b3979353",
                                                "text": "Cette nouvelle n'est pas sûre, c'est un simple cancan."
                                            },
                                            {
                                                "example_id": "03865690-a848-40e2-8c9a-fec7105ef058",
                                                "sense_id": "0649ad18-13ca-396d-b66b-7d25b3979353",
                                                "text": "Mon Dieu ! j’ai bien tort de vous faire ces cancans-là, reprit Lisbeth en paraissant éprouver un remords."
                                            },
                                            {
                                                "example_id": "11ec7462-00ab-45a0-a3fe-d1e6ac6dc058",
                                                "sense_id": "0649ad18-13ca-396d-b66b-7d25b3979353",
                                                "text": "Gobenheim pouvait analyser devant eux les affaires épineuses, les soumettre aux consultations gratuites du notaire, et réduire les cancans de la place à leur juste valeur."
                                            },
                                            {
                                                "example_id": "8a104ded-d564-4d25-b810-6dbc6f4c943b",
                                                "sense_id": "0649ad18-13ca-396d-b66b-7d25b3979353",
                                                "text": "Il est certaines situations dont bénéficient seuls les gens tarés. Ils fondent leur fortune là où des hommes mieux posés et plus influents n’auraient point osé risquer la leur. Certes, Roudier, Granoux et les autres, par leur position d’hommes riches et respectés, semblaient devoir être mille fois préférés à Pierre comme chefs actifs du parti conservateur. Mais aucun d’eux n’aurait consenti à faire de son salon un centre politique ; leurs convictions n’allaient pas jusqu’à se compromettre ouvertement ; en somme, ce n’étaient que des braillards, des commères de province, qui voulaient bien cancaner chez un voisin contre la République, du moment où le voisin endossait la responsabilité de leurs cancans."
                                            },
                                            {
                                                "example_id": "a5b019bb-a64b-4e57-bdfb-cc0fd647db34",
                                                "sense_id": "0649ad18-13ca-396d-b66b-7d25b3979353",
                                                "text": "Tous les cancans partent de là. Les menus faits y sont grossis, allongés, puis colportés de quaroye en quaroye."
                                            },
                                            {
                                                "example_id": "c2e1beaf-5629-4e94-84ac-9694ab3a9093",
                                                "sense_id": "0649ad18-13ca-396d-b66b-7d25b3979353",
                                                "text": "Il accueillit d’un air enjoué et d’une âme égale l’annonce câlinement faite par la Julie d’une paternité future et les sourires des voisins, les cancans des commères et jusqu’aux plaisanteries égrillardes du maire."
                                            },
                                            {
                                                "example_id": "e0a27314-2557-4fd2-95b3-304b521e32ac",
                                                "sense_id": "0649ad18-13ca-396d-b66b-7d25b3979353",
                                                "text": "Ce coin perdu de Jan-Mayen n'est pas à l'abri des cancans, des mystères, des intrigues et même des complications diplomatiques."
                                            },
                                            {
                                                "example_id": "567c69c4-3cb5-43f1-a78a-0186f3529078",
                                                "sense_id": "0649ad18-13ca-396d-b66b-7d25b3979353",
                                                "text": "Et ce petit univers grouille de cancans, d'intrigues, de projets, d'ambitions, qui dépassent rarement le cadre de la sous-préfecture. Vous croyez que la Chine existe, vous ? Comment peut-on être Chinois ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93cc557d-fc5c-357f-b966-09e710c48aeb",
                                        "entry_id": "625822c7-722e-3f20-a406-bdc98f126c48",
                                        "glosses": [
                                            "Journal."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90a280ae-40ed-4aa5-a890-c9147c11c44d",
                                                "sense_id": "93cc557d-fc5c-357f-b966-09e710c48aeb",
                                                "text": "Je peux plus ouvrir un cancan, sans retrouver leurs traces de bave…"
                                            },
                                            {
                                                "example_id": "37ff2974-8a16-44a8-808e-739770f9fedd",
                                                "sense_id": "93cc557d-fc5c-357f-b966-09e710c48aeb",
                                                "text": "Le Grand a pas chiqué pour poser des photos, et sa tronche, montée-force, le montre dans presque tous les cancans, un sourire ambigu aux lèvres, tandis qu’il tend vers l’objectif, en gros plan, le 38, ratatineur de vilains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cancan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a88a73a6-3e32-3d23-9e98-0365a2f67126",
                                        "entry_id": "478e6322-0725-3f9e-b351-c883547bde33",
                                        "glosses": [
                                            "Danse excentrique et tapageuse (quadrille), à la mode vers 1830 dans les bals publics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "350a3acc-40b0-43e8-ae91-a13c43f1a4d2",
                                                "sense_id": "a88a73a6-3e32-3d23-9e98-0365a2f67126",
                                                "text": "Autrefois, la muse, prêtresse\nDu crime, reine du boucan,\nLivrant au vent sa folle tresse,\nLes seins nus, dansait le cancan,\nRetroussait sa robe crottée\nEt roulait comme une effrontée\nSes yeux lascifs, méchants et doux."
                                            },
                                            {
                                                "example_id": "e18d4c1d-8847-4bbb-bc7c-5d3a4414d054",
                                                "sense_id": "a88a73a6-3e32-3d23-9e98-0365a2f67126",
                                                "text": "Le directeur et organisateur de ce cancan, majestueux dans un habit noir fatigué, promenait en tous sens sa tête ravagée de vieux marchand de plaisirs publics à bon marché."
                                            },
                                            {
                                                "example_id": "6ccb5882-d658-4598-a64d-4af74c93e21a",
                                                "sense_id": "a88a73a6-3e32-3d23-9e98-0365a2f67126",
                                                "text": "Au milieu du bastringue, plusieurs couples dansaient le cancan à en décrocher les lustres."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cancan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5bd8a03-0a13-3b74-8d89-4d64600006c8",
                                        "entry_id": "24d93f58-7527-338b-aa49-3b1166e53f84",
                                        "glosses": [
                                            "Arbrisseau de la famille des Euphorbiacées, à feuilles persistantes de couleur pourpre, présentant des fleurs en longs épis pendants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b21066a-0fd8-4682-a599-5f2da4543113",
                                                "sense_id": "d5bd8a03-0a13-3b74-8d89-4d64600006c8",
                                                "text": "Le cancan est aussi appelé foulard ou queue-de-chat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
