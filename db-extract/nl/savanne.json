                        "target_lang_word": "Savanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Savanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26a2a38d-49b0-3cd6-88ec-0316d12e2881",
                                        "entry_id": "ce53b9d5-a587-301f-8f18-ec59f25c4a56",
                                        "glosses": [
                                            "tropisches Grasland mit vereinzeltem Gehölz und Gebüsch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d747d055-a74d-42ff-9642-cc4e62ccfb9c",
                                                "sense_id": "26a2a38d-49b0-3cd6-88ec-0316d12e2881",
                                                "text": "Die Tierwelt der afrikanischen Savannen ist beeindruckend."
                                            },
                                            {
                                                "example_id": "8e065fbe-e5d3-4f73-b4fb-34e6c3c1538a",
                                                "sense_id": "26a2a38d-49b0-3cd6-88ec-0316d12e2881",
                                                "text": "„Kurz nach Mittag lockerte sich der Wald auf, und wir traten hinaus in eine halboffene Savanne, wo das Sonnenlicht in den Augen schmerzte.“"
                                            },
                                            {
                                                "example_id": "ebf50a6f-e461-4304-ad81-7bd4838217ea",
                                                "sense_id": "26a2a38d-49b0-3cd6-88ec-0316d12e2881",
                                                "text": "„Wir fuhren in der Savanne des sonnenverbrannten Hinterlands an dösenden Kühen vorbei, und Tony bat mich, den Pynchon-Büchern gegenüber gnädiger zu sein.“"
                                            },
                                            {
                                                "example_id": "0c84be50-8bce-4927-bf2e-a49885f1a33e",
                                                "sense_id": "26a2a38d-49b0-3cd6-88ec-0316d12e2881",
                                                "text": "„Die Löwenfamilie liegt meist träge und satt in der Savanne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83e806f7-bf4c-433c-a91a-9b52f3acd68e",
                        "source_entry_id": "9e4bfd09-5caa-36a8-9ff3-b60432a08de8",
