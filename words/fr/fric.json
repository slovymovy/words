                        {
                            "text": "Il travaille dur toute la semaine pour se faire un peu de <w>fric</w>.",
                            "target_lang_translations": {
                                "en": "He works hard all week to make a bit of <w>money</w>.",
                                "ru": "Он вкалывает всю неделю, чтобы заработать немного <w>бабла</w>.",
                                "nl": "Hij werkt de hele week hard om wat <w>poen</w> te verdienen.",
                                "de": "Er arbeitet die ganze Woche hart, um sich ein bisschen <w>Kohle</w> zu verdienen.",
                                "pl": "Pracuje ciężko przez cały tydzień, żeby zarobić trochę <w>kasy</w>.",
                                "it": "Lavora sodo tutta la settimana per farsi un po' di <w>soldi</w>.",
                                "cs": "Celý týden tvrdě pracuje, aby si přivydělal trochu <w>prachů</w>.",
                                "tr": "Haftanın her günü çok çalışıyor ki biraz <w>para</w> kazanabilsin.",
                                "es": "Trabaja duro toda la semana para ganarse un poco de <w>pasta</w>.",
                                "zh": "他整个星期都拼命工作，就为了赚点<w>钱</w>。"
                            }
                        },
                        {
                            "text": "Elle a dépensé tout son <w>fric</w> pendant les vacances d'été.",
                            "target_lang_translations": {
                                "en": "She spent all her <w>money</w> during the summer holidays.",
                                "ru": "Она за летние каникулы спустила все свои <w>бабки</w>.",
                                "nl": "Ze heeft al haar <w>poen</w> uitgegeven tijdens de zomervakantie.",
                                "de": "Sie hat in den Sommerferien ihre ganze <w>Kohle</w> verprasst.",
                                "pl": "Wydała całą swoją <w>kasę</w> podczas letnich wakacji.",
                                "it": "Ha speso tutti i suoi <w>soldi</w> durante le vacanze estive.",
                                "cs": "Všechny své <w>prachy</w> utratila o letních prázdninách.",
                                "tr": "Yaz tatilinde bütün <w>parasını</w> harcadı.",
                                "es": "Ella gastó todo su <w>dinero</w> durante las vacaciones de verano.",
                                "zh": "她暑假期间把所有的<w>钱</w>都花光了。"
                            }
