                "senses": [
                    {
                        "sense_id": "15c1b61e-d6bf-31b1-81c2-1f005b8ae7e9",
                        "entry_id": "be21f8f0-8c12-3de9-b805-9b41faf89e3c",
                        "glosses": [
                            "zur Ablage dienendes Brett in einem Regal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69311008-1b79-4064-8420-38e31752a92c",
                                "sense_id": "15c1b61e-d6bf-31b1-81c2-1f005b8ae7e9",
                                "text": "„Das Weibchen nimmt ihre Messer vom angrenzenden Regalboden und reicht mir eines davon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da5d2673-3b4a-45e2-b42a-4b63b8320b38",
                        "source_entry_id": "be21f8f0-8c12-3de9-b805-9b41faf89e3c",
                        "source_sense_id": "15c1b61e-d6bf-31b1-81c2-1f005b8ae7e9",
                        "source_sense_description": "zur Ablage dienendes Brett in einem Regal",
                        "target_lang_word": "étagère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étagère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f633da3-7e0d-3b2f-a973-e28268b9f6f2",
                                        "entry_id": "b0916f0f-a32d-30b5-a8e2-3638d7e67298",
                                        "glosses": [
                                            "Planche fixée horizontalement et destinée au rangement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2925affb-7d31-3266-a888-8b10e4d3aa66",
                                        "entry_id": "b0916f0f-a32d-30b5-a8e2-3638d7e67298",
                                        "glosses": [
                                            "Meuble constitué de planches superposées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f0dc3a-ada4-46ec-ac1f-bc670424191b",
                                                "sense_id": "2925affb-7d31-3266-a888-8b10e4d3aa66",
                                                "text": "Elle faisait face à l’étagère où étaient regroupés mes vinyles."
                                            },
                                            {
                                                "example_id": "e72f949b-fa95-4563-a6bb-b4f27a05ab68",
                                                "sense_id": "2925affb-7d31-3266-a888-8b10e4d3aa66",
                                                "text": "J’ai laissé mes yeux traîner sur les étagères. Crèmes de jour, de nuit, masques hydratants, purifiants, gommages, sérums antifatigue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3e61450-9e2b-3e3a-a14a-7ca78d68c116",
                                        "entry_id": "b0916f0f-a32d-30b5-a8e2-3638d7e67298",
                                        "glosses": [
                                            "Oreille"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5754ae3-a7c2-4d0b-bf66-1bc2df0ae125",
                                                "sense_id": "d3e61450-9e2b-3e3a-a14a-7ca78d68c116",
                                                "text": "C’est pas parce qu’un vieux moisi vient nous baver dans les étagères que ça vaut forcément que’que chose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5c066f7-1d21-48eb-bf73-8707f4ed88d4",
                        "source_entry_id": "be21f8f0-8c12-3de9-b805-9b41faf89e3c",
                        "source_sense_id": "15c1b61e-d6bf-31b1-81c2-1f005b8ae7e9",
                        "source_sense_description": "zur Ablage dienendes Brett in einem Regal",
                        "target_lang_word": "tablette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tablette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "caa9a270-29f7-3606-9879-b5a69be58bbc",
                                        "entry_id": "df4bfb35-2609-3961-9f47-4f2327c0b07f",
                                        "glosses": [
                                            "Plaque de petite dimension présentant une surface plane et une faible épaisseur, sur laquelle on peut tracer ou graver des signes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b8faac2-6cb0-46c3-b1d7-2994c15a166e",
                                                "sense_id": "caa9a270-29f7-3606-9879-b5a69be58bbc",
                                                "text": "Le Louvre conserve une tablette votive sumérienne, venant de l’embouchure de l’Euphrate et datant de 2850 avant J.C., faite d’un mélange artificiel de bitume et d’argile."
                                            },
                                            {
                                                "example_id": "58dba4bb-3df5-497e-bcc4-42fcd782d67a",
                                                "sense_id": "caa9a270-29f7-3606-9879-b5a69be58bbc",
                                                "text": "Avant l'invention du papyrus ou du papier, on utilisait pour écrire des tablettes de cire, de terre crue ou de bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc0edeb7-3511-348d-b255-c2ea10a0975e",
                                        "entry_id": "df4bfb35-2609-3961-9f47-4f2327c0b07f",
                                        "glosses": [
                                            "Agenda."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bece3f4-95d1-4f27-8634-1046ef995714",
                                                "sense_id": "fc0edeb7-3511-348d-b255-c2ea10a0975e",
                                                "text": "Un diner avec X mercredi? Je note ça sur mes tablettes!"
                                            },
                                            {
                                                "example_id": "50437e8a-842c-406a-99b0-2c144c313e69",
                                                "sense_id": "fc0edeb7-3511-348d-b255-c2ea10a0975e",
                                                "text": "Marque sur tes tablettes cet événement sensationnel. Hier soir, à neuf heures quarante-cinq, j’ai fait mon entrée dans le bocal des dames aux chapeaux verts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80e19f03-624c-3afc-83df-efcb8848f4e4",
                                        "entry_id": "df4bfb35-2609-3961-9f47-4f2327c0b07f",
                                        "glosses": [
                                            "Écritoire."
                                        ],
                                        "tags": [
                                            "Parfois"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "893fdd85-da03-40de-b2e2-07bbb11384c5",
                                                "sense_id": "80e19f03-624c-3afc-83df-efcb8848f4e4",
                                                "text": "Si tes saints scrupules peuvent condescendre à l’emploi des tablettes du juif, je me charge de trouver la plume, dit le yeoman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ebee6a5-e11c-3da6-931f-4af8d97f3264",
                                        "entry_id": "df4bfb35-2609-3961-9f47-4f2327c0b07f",
                                        "glosses": [
                                            "Plaque découpée dans divers matériaux et destinée à offrir une surface plane sur laquelle on peut poser des objets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55e21693-c9e7-4409-a7a6-b582f17bdf76",
                                                "sense_id": "9ebee6a5-e11c-3da6-931f-4af8d97f3264",
                                                "text": "Mais tous ses soins furent pour le salon. Elle réussit presque à en faire un lieu habitable. Il était garni d’un meuble de velours jaunâtre, à fleurs satinées. Au milieu se trouvait un guéridon à tablette de marbre ; des consoles, surmontées de glaces, s’appuyaient aux deux bouts de la pièce."
                                            },
                                            {
                                                "example_id": "3eae0ecf-4201-407e-86b4-f61e7ebbf36c",
                                                "sense_id": "9ebee6a5-e11c-3da6-931f-4af8d97f3264",
                                                "text": "Tandis que nous nous entretenions amicalement avec ces bonnes gens, j’observais l’heureuse disposition du dressoir, de l’évier, des tablettes, où étaient rangés les pots et les assiettes."
                                            },
                                            {
                                                "example_id": "8ad91d1b-7d2f-47bf-96d0-32b0c5a84832",
                                                "sense_id": "9ebee6a5-e11c-3da6-931f-4af8d97f3264",
                                                "text": "Une glace munie d'une tablette en bois blanc se trouvait fixée contre un des murs et éclairée par deux ampoules sans abat-jour."
                                            },
                                            {
                                                "example_id": "671cc2c4-76f8-4e23-a46e-4b82efa0e289",
                                                "sense_id": "9ebee6a5-e11c-3da6-931f-4af8d97f3264",
                                                "text": "Le libraire avait les bras chargés de quatre lourds in-octavo qu'il déposa sur une tablette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "899b29eb-9f84-3758-8c3a-84b23bc1612f",
                                        "entry_id": "df4bfb35-2609-3961-9f47-4f2327c0b07f",
                                        "glosses": [
                                            "Formule de présentation de produits alimentaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3fa53d2-4bb5-4ceb-9857-d64b1cd87298",
                                                "sense_id": "899b29eb-9f84-3758-8c3a-84b23bc1612f",
                                                "text": "La théerie Sinagar, de Java, a préparé des tablettes de thé à destination du marché russe ; cette fabrication est maintenant abandonnée à Java."
                                            },
                                            {
                                                "example_id": "25b9d322-c959-4037-9605-64f3eafb81bc",
                                                "sense_id": "899b29eb-9f84-3758-8c3a-84b23bc1612f",
                                                "text": "Tablette de chocolat. - Tablette de bouillon. - Tablette de chewing-gum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "395d0790-6e0d-3957-97e9-26551e73a3f7",
                                        "entry_id": "df4bfb35-2609-3961-9f47-4f2327c0b07f",
                                        "glosses": [
                                            "Abrégé de tablette tactile (ou tablette électronique, ou tablette numérique, on dit aussi ardoise électronique) : ordinateur portable et ultraplat, qui se présente comme un écran tactile et permet notamment d'accéder à des contenus multimédias."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad224bf-fa1c-4d6f-8834-283ded084b1e",
                                                "sense_id": "395d0790-6e0d-3957-97e9-26551e73a3f7",
                                                "text": "L’univers des tablettes tactiles se divise en deux : l’iPad et les autres. Quelques élèves, comme Motorola ou Samsung, peuvent toutefois prétendre rivaliser avec le maître. Mais ces tablettes présentent-elles de l’intérêt pour les consommateurs ?"
                                            },
                                            {
                                                "example_id": "5b8ec458-8f85-44c9-b299-79bba8a38321",
                                                "sense_id": "395d0790-6e0d-3957-97e9-26551e73a3f7",
                                                "text": "« Aujourd’hui, renchérit Frédéric Bordage, on consulte de plus en plus de vidéos sur un smartphone ou une tablette. Or se connecter en réseau 4G consomme vingt fois plus d’énergie que de chez soi en ADSL. »"
                                            },
                                            {
                                                "example_id": "2d50e0bd-3c86-4214-9177-1cec1da5b77c",
                                                "sense_id": "395d0790-6e0d-3957-97e9-26551e73a3f7",
                                                "text": "Comme elle, des milliers de personnes se sont retrouvées en difficulté face au numérique pendant les confinements. En particulier les familles ne disposant pas d’un ordinateur ou d’une tablette à la maison."
                                            },
                                            {
                                                "example_id": "fe1bdbae-a1c0-4b09-a433-dc4ed5007456",
                                                "sense_id": "395d0790-6e0d-3957-97e9-26551e73a3f7",
                                                "text": "Alstom a essayé son tout premier train autonome, téléguidé par une tablette avec des passagers à bord. Franceinfo a pu assister à cet essai grandeur nature."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tablette",
                                "target_lang_code": "fr",
