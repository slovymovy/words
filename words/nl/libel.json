{
    "word_family": [
        "waterpas"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1b49b7f-6f9d-3743-950a-c0e0937120cb",
                    "sense_definition": "Een insect met een lang, slank lichaam en vier grote, doorzichtige vleugels, behorend tot de orde Odonata.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Boven het water van de vijver vloog een prachtige, blauwe <w>libel</w>.",
                            "target_lang_translations": {
                                "en": "A beautiful, blue <w>dragonfly</w> flew over the water of the pond."
                            }
                        },
                        {
                            "text": "De boswachter wees ons op een zeldzame <w>libel</w> die op een rietstengel zat.",
                            "target_lang_translations": {
                                "en": "The forest ranger pointed out a rare <w>dragonfly</w> sitting on a reed."
                            }
                        }
                    ],
                    "synonyms": [
                        "libelle"
                    ],
                    "common_phrases": [
                        "een vliegende libel"
                    ],
                    "target_lang_definitions": {
                        "en": "An insect with a long, slender body and four large, transparent wings, belonging to the order Odonata."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dragonfly",
                                "target_lang_sense_clarification": "the insect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8871b00d-0aed-3480-bf8b-cd1bbd1329d4",
                    "sense_definition": "Een met vloeistof gevuld buisje met een luchtbel in een waterpas, gebruikt om te controleren of iets horizontaal staat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "meetinstrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als de luchtbel precies in het midden van de <w>libel</w> staat, is de plank waterpas.",
                            "target_lang_translations": {
                                "en": "If the air bubble is exactly in the middle of the <w>vial</w>, the plank is level."
                            }
                        },
                        {
                            "text": "Hij controleerde de stand van de tafel door naar de <w>libel</w> van zijn waterpas te kijken.",
                            "target_lang_translations": {
                                "en": "He checked the position of the table by looking at the <w>vial</w> of his spirit level."
                            }
                        }
                    ],
                    "synonyms": [
                        "libelle"
                    ],
                    "common_phrases": [
                        "de libel van een waterpas"
                    ],
                    "target_lang_definitions": {
                        "en": "A liquid-filled tube containing an air bubble in a spirit level, used to check if a surface is horizontal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vial",
                                "target_lang_sense_clarification": "of a spirit level"
                            },
                            {
                                "target_lang_word": "bubble",
                                "target_lang_sense_clarification": "spirit level indicator"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d7cd034-defe-31e1-bcf9-bf13ed33dccb",
                    "sense_definition": "Een geschrift of publicatie waarin iemand op spottende of beledigende wijze wordt bekritiseerd.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geschrift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de achttiende eeuw werd er een anoniem <w>libel</w> verspreid om de koning belachelijk te maken.",
                            "target_lang_translations": {
                                "en": "In the eighteenth century, an anonymous <w>lampoon</w> was distributed to ridicule the king."
                            }
                        },
                        {
                            "text": "De auteur werd beschuldigd van smaad vanwege het schrijven van een hatelijk <w>libel</w>.",
                            "target_lang_translations": {
                                "en": "The author was accused of defamation for writing a hateful <w>libel</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schotschrift",
                        "smaadschrift",
                        "pamflet",
                        "vlugschrift",
                        "libelle"
                    ],
                    "common_phrases": [
                        "een scherp libel"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Voornamelijk in historische of formele context gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A piece of writing or publication in which someone is criticized in a mocking or insulting manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lampoon",
                                "target_lang_sense_clarification": "scathing satirical writing"
                            },
                            {
                                "target_lang_word": "libel",
                                "target_lang_sense_clarification": "defamatory pamphlet or writing"
                            },
                            {
                                "target_lang_word": "pasquinade",
                                "target_lang_sense_clarification": "satirical writing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}