                "senses": [
                    {
                        "sense_id": "9707f086-acc3-356d-bf72-f9604d5e26b3",
                        "entry_id": "29d6b5a8-7d98-340a-acc6-da200c70763b",
                        "glosses": [
                            "Krankheit oder Störung des Fettstoffwechsels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b12da9b-eeb7-4bd6-9bf5-4cba4728f420",
                                "sense_id": "9707f086-acc3-356d-bf72-f9604d5e26b3",
                                "text": "„Für viele Männer kann die Ersatztherapie sogar gefährlich sein: Zahlreiche Studien haben Hinweise darauf geliefert, dass Testosteron das Wachstum eines Prostatatumors beschleunigt ähnlich wie Östrogen beim Brustkrebs. Da jeder fünfte Mann irgendwann eine solche Veränderung an der Prostata entwickelt, ist der Einsatz des Hormons mit höchster Vorsicht zu genießen. Aufpassen müssen auch Männer, die Probleme mit der Leber, Durchblutungs- oder Fettstoffwechselstörungen oder ein sogenanntes Schlafapnoesyndrom haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
