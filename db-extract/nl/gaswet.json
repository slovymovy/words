                        "examples": [
                            {
                                "example_id": "bac21604-1639-4cab-af84-46e55ffc7380",
                                "sense_id": "3ac4416d-d386-3c10-bc4a-2e26720b49cd",
                                "text": "\"Minister Kamp wilde zijn oude wet vernieuwen\", zegt Marijke Vos in het NOS Radio 1 Journaal. Volgens Vos gebeurt dat wel vaker en ging het in dit geval om een oude Elektriciteits- en Gaswet, waar nieuwe artikelen aan zijn toegevoegd. \"Had hij dat maar niet gedaan. Had hij maar een aparte wet voor windenergie op zee gemaakt. Dan was er geen probleem geweest.\" Volgens Vos was de wet dan met een grote meerderheid aangenomen in de Eerste Kamer."
                            },
                            {
                                "example_id": "1dfb71db-60de-4e63-bc79-ed09fde2e70e",
                                "sense_id": "3ac4416d-d386-3c10-bc4a-2e26720b49cd",
                                "text": "Gisteravond strandde de nieuwe elektriciteits- en gaswet van minister Kamp met één stem verschil in de Eerste Kamer. De oppositiepartijen zijn het niet eens met de verplichte splitsing van energiebedrijven. Een symbolische tegenstem die het opwekken van duurzame energie kan vertragen, zegt Bert Tieben van onderzoeksinstituut SEO Economisch Onderzoek."
                            }
                        ]
                    }
