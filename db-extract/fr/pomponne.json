                    {
                        "sense_id": "9a51c2da-ed94-3c64-8b47-32909e859e3e",
                        "entry_id": "3e6a6ebc-7001-330c-beae-2079880475e7",
                        "glosses": [
                            "Commune française, située dans le département de Seine-et-Marne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0fb1d78-55b6-473c-b1bf-be199e13b795",
                                "sense_id": "9a51c2da-ed94-3c64-8b47-32909e859e3e",
                                "text": "À Pomponne, en Seine-et-Marne, Wipelec a stoppé en 2012 l’exploitation d’un site, après quatorze années passées sans le nettoyer."
                            }
                        ]
                    }
