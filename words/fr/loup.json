                    "frequency": "High",
                    "semantic_group_id": "mammifere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le randonneur a aperçu un <w>loup</w> solitaire au loin dans la montagne enneigée."
                        },
                        {
                            "text": "La nuit, on entend parfois hurler les <w>loups</w> dans cette vallée isolée."
                        }
                    ],
                    "common_phrases": [
                        "faim de loup",
                        "gueule du loup",
                        "marcher à pas de loup",
                        "entre chien et loup",
                        "jeune loup"
