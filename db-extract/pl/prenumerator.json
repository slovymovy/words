                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8556823-6f26-4059-a0e3-9ab478ad5466",
                                "sense_id": "07160b1a-3642-37de-b0da-df75354032f5",
                                "text": "Gdyby ciągle istniał „Świat Młodych”, byłbym jego prenumeratorem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39556297-f4b8-4aaf-869b-169447e03511",
                        "source_entry_id": "3bd1da0d-b617-3c24-b2db-1b10e438c74e",
                        "source_sense_id": "07160b1a-3642-37de-b0da-df75354032f5",
                        "target_lang_word": "subscriber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subscriber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b23d137-08c8-390e-957a-86c1c7e53c2c",
                                        "entry_id": "3c28b4e3-58d0-3916-9a20-486221e6a7c7",
                                        "glosses": [
                                            "A person who subscribes to a publication or a service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c864b42-4d14-47eb-b042-01aae853e48b",
                                                "sense_id": "3b23d137-08c8-390e-957a-86c1c7e53c2c",
                                                "text": "Our magazine has over ten thousand subscribers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b274dc8c-48d3-315d-87b1-aaa0dd428f5a",
                                        "entry_id": "3c28b4e3-58d0-3916-9a20-486221e6a7c7",
                                        "glosses": [
                                            "A system or component that subscribes to something, such as an event, made available by a publisher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce97097-90b8-403a-8669-23828dfaf486",
                                                "sense_id": "b274dc8c-48d3-315d-87b1-aaa0dd428f5a",
                                                "text": "An event aggregator facilitates a fire-and-forget model of communication. The object triggering the event doesn't care if there are any subscribers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2441618-496b-41a8-be7e-21f7b2b3abda",
                        "source_entry_id": "3bd1da0d-b617-3c24-b2db-1b10e438c74e",
                        "source_sense_id": "07160b1a-3642-37de-b0da-df75354032f5",
                        "target_lang_word": "abonné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "526a7437-2e44-339b-a792-d6448b97eba8",
                                        "entry_id": "823adf0d-4e13-3281-a41c-123db3551256",
                                        "glosses": [
                                            "Personne qui a contracté un abonnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e55e1ec7-6cf0-4349-89dd-a592d6286ec9",
                                                "sense_id": "526a7437-2e44-339b-a792-d6448b97eba8",
                                                "text": "Que le rural soit plus confiant et qu’il utilise, de plus en plus, l’électricité dans l’exécution de ses travaux, alors les inconvénients que représente la dispersion des abonnés disparaîtront […]."
                                            },
                                            {
                                                "example_id": "80e0a890-6d46-4f21-91c5-a2d35d29da9c",
                                                "sense_id": "526a7437-2e44-339b-a792-d6448b97eba8",
                                                "text": "D’ailleurs, à coup d’annonces, à force de voyageurs, en offrant des avantages illusoires aux abonnés, on en avait raccolé deux mille."
                                            },
                                            {
                                                "example_id": "eca507fe-2e79-460d-844d-eea5c5b58b7a",
                                                "sense_id": "526a7437-2e44-339b-a792-d6448b97eba8",
                                                "text": "Parmi les dix pages qui étaient les plus suivies, on trouve essentiellement des communautés qui diffusaient des contenus sensationnalistes ou « piège à clics », comme Le Petit Buzz, qui réunissait près de 5 millions d’abonnés avant d’être supprimée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2934274-6ce4-31ea-9dfb-fe6e53c1f24d",
                                        "entry_id": "fc3020b3-fea8-31d8-862f-c12d8788ff19",
                                        "glosses": [
                                            "Qui a contracté un abonnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acb28b20-adea-4766-81db-aaa5a3495edd",
                                                "sense_id": "b2934274-6ce4-31ea-9dfb-fe6e53c1f24d",
                                                "text": "Il est abonné à toutes les revues scientifiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6defc956-b560-3a40-a9f3-5dbca69f4a86",
                                        "entry_id": "fc3020b3-fea8-31d8-862f-c12d8788ff19",
                                        "glosses": [
                                            "Qui vit une situation répétitive et remarquable."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6914b08-923a-4329-8146-f14c7d805c99",
                                                "sense_id": "6defc956-b560-3a40-a9f3-5dbca69f4a86",
                                                "text": "Décidément, il est abonné aux emmerdes !"
                                            },
                                            {
                                                "example_id": "c2943ca7-4bd6-46c9-9017-ad4395fdaa6e",
                                                "sense_id": "6defc956-b560-3a40-a9f3-5dbca69f4a86",
                                                "text": "Raymond Poulidor était abonné à la deuxième place."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb7abe57-a6ce-3af3-83ba-4853067bec7d",
                                        "entry_id": "2302ee20-c307-3575-9ffc-0c665f120f31",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe abonner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2840ec96-afdf-4537-bfc1-b86cb764178e",
                                                "sense_id": "eb7abe57-a6ce-3af3-83ba-4853067bec7d",
                                                "text": "Il m’a encouragé pour les exams, initié au cinéma, m’a abonné au Monde, offert une deuch pour mes vingt et un ans."
                                            },
                                            {
                                                "example_id": "5743537d-f8c4-491f-a18d-155ed41a47af",
                                                "sense_id": "eb7abe57-a6ce-3af3-83ba-4853067bec7d",
                                                "text": "Mon ché, depuis ta dernière venue, je me suis abonné au Journal officiel ; d’après ce que j’y ai lu, tu n’es pas le seul, au Palais du Luxembourg, à avoir besoin de bois-bander ; tu partageras avec tes collègues !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aee7fc48-d15a-441f-9684-23ecf0a94cc6",
                        "source_entry_id": "3bd1da0d-b617-3c24-b2db-1b10e438c74e",
                        "source_sense_id": "07160b1a-3642-37de-b0da-df75354032f5",
                        "target_lang_word": "Abonnent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abonnent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c41e30c1-892d-3cd6-b14e-985340ac7660",
                                        "entry_id": "ee0ff9b6-48a1-3b02-81be-920750154c78",
                                        "glosses": [
                                            "Person, welche ein meist durch Vorauszahlung gesichertes Anrecht auf (meist) regelmäßige Inanspruchnahme bestimmter Leistungen oder Waren in Anspruch nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b9e029-5914-4ea0-b3e3-06ba013d15b6",
                                                "sense_id": "c41e30c1-892d-3cd6-b14e-985340ac7660",
                                                "text": "Ich bin Abonnent einer der größten Zeitungen Europas."
                                            },
                                            {
                                                "example_id": "addf20fd-9617-4b9e-b76a-7085987b6e3b",
                                                "sense_id": "c41e30c1-892d-3cd6-b14e-985340ac7660",
                                                "text": "„1774 hatte der »Merkur« rund 2000 Abonnenten, die Zahl der Leserinnen und Leser war wohl weit größer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5297a258-d579-4ff5-86c3-2e22bb8f7414",
                        "source_entry_id": "3bd1da0d-b617-3c24-b2db-1b10e438c74e",
