                ],
                "senses": [
                    {
                        "sense_id": "42391bc7-e1d3-3a08-a7d3-31bba790c012",
                        "entry_id": "accd166e-26f9-3066-be93-50e1563ee2de",
                        "glosses": [
                            "wśród niektórych ludów azjatyckich, np. u Eskimosów i Indian, człowiek uważany za pośrednika między duchami, bóstwami, demonami a ludźmi, osoba o nadprzyrodzonej mocy, czarodziej i znachor pierwotnej religii szamanizmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d4f5377-4a37-42ea-9565-00b95290a510",
                                "sense_id": "42391bc7-e1d3-3a08-a7d3-31bba790c012",
                                "text": "(…) w momencie ograniczenia lub wyeliminowania tradycyjnych działań miejscowych uzdrowicieli i szamanów i wprowadzenia na ich miejsce klasycznej medycyny zachodniej, stan zdrowotny ludności uległ pogorszeniu. Poprawę przyniosło dopiero połączenie obydwu podejść medycznych: nowoczesnego i tradycyjnego."
                            },
                            {
                                "example_id": "3a614f89-6691-4024-b068-78a25464f6ca",
                                "sense_id": "42391bc7-e1d3-3a08-a7d3-31bba790c012",
                                "text": "Czcigodny Oya wysłuchał nas! Niech będzie błogosławiona siostra, która zaniosła nasze prośby przed jego oblicze! Faustino, szaman voodoo, wypowiada te słowa stojąc po kostki w błocie, w strugach tropikalnego deszczu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78f69f1c-18f7-4c52-b71d-ae79aa1b0a66",
                        "source_entry_id": "accd166e-26f9-3066-be93-50e1563ee2de",
                        "source_sense_id": "42391bc7-e1d3-3a08-a7d3-31bba790c012",
                        "target_lang_word": "shaman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shaman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2364e5d-485d-3a8b-a0b7-64fad64d7fd7",
                                        "entry_id": "a9029346-a9d4-37ba-bd8f-6cd239367b2a",
                                        "glosses": [
                                            "A traditional faith healer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b58cc14f-5baf-3023-ab6f-f37b490eb2fb",
                                        "entry_id": "a9029346-a9d4-37ba-bd8f-6cd239367b2a",
                                        "glosses": [
                                            "A member of certain tribal societies who acts as a spiritual or religious medium between the concrete and spirit worlds; sometimes also a healer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d06ec57-5a96-4a04-9523-fe09f6d637e1",
                                                "sense_id": "b58cc14f-5baf-3023-ab6f-f37b490eb2fb",
                                                "text": "Near-synonyms: medicine man, medicine woman, priest-doctor, witch doctor"
                                            },
                                            {
                                                "example_id": "fcde3479-987f-4251-b2e2-f49cdec14875",
                                                "sense_id": "b58cc14f-5baf-3023-ab6f-f37b490eb2fb",
                                                "text": "Shepard: What rites did you go through to become chief shaman?\nShaman: Becoming the shaman is excruciating. I passed through rites that made me wish to die. I carry the scars on my soul.\nShaman: I must perform rites each dawn and dusk to keep me bound into our krogan nature. Our spirit is one of violence and death. I must be attuned to that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
