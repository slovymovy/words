                        "entry_id": "151527b9-5244-366f-9eac-43019f0f8ee0",
                        "glosses": [
                            "Espèce de champignons en forme d’oreille, jaune orangé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f43c5c00-47cc-47ab-9d18-d1d3c5324e07",
                                "sense_id": "92f1febe-5e97-3c03-827b-e8d4bdf69f99",
                                "text": "L’ oreille-de-lièvre est un comestible médiocre, bien cuit."
