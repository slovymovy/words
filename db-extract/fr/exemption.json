                "senses": [
                    {
                        "sense_id": "2ed46854-af60-3220-8d3b-c5a252f4b327",
                        "entry_id": "c10913f7-da8c-3143-933b-5055f0694797",
                        "glosses": [
                            "Droit, grâce, privilège qui exempte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ade9489-1082-49f7-a083-705a71760171",
                                "sense_id": "2ed46854-af60-3220-8d3b-c5a252f4b327",
                                "text": "Exemption d’impôts, de service."
                            },
                            {
                                "example_id": "5eaf33b7-e8a9-4e75-9c25-adca5410f4f0",
                                "sense_id": "2ed46854-af60-3220-8d3b-c5a252f4b327",
                                "text": "L’exemption de toutes charges publiques."
                            },
                            {
                                "example_id": "2f599a50-dc84-432c-98ef-6a9c052742e8",
                                "sense_id": "2ed46854-af60-3220-8d3b-c5a252f4b327",
                                "text": "Autrefois on accordait, en certains cas, des lettres d’exemption."
                            },
                            {
                                "example_id": "8dd3a006-65d8-4780-87d0-0daee9b068ba",
                                "sense_id": "2ed46854-af60-3220-8d3b-c5a252f4b327",
                                "text": "Exemption du droit à l'image"
                            }
                        ]
                    },
                    {
                        "sense_id": "7cf5ae89-285a-3896-a040-bd4c86293d38",
                        "entry_id": "c10913f7-da8c-3143-933b-5055f0694797",
                        "glosses": [
                            "Dispense."
                        ],
                        "tags": [
                            "Simplement"
                        ],
                        "examples": [
                            {
                                "example_id": "dd200f0b-2e35-4a77-b2cf-6b2acfd11bf3",
                                "sense_id": "7cf5ae89-285a-3896-a040-bd4c86293d38",
                                "text": "Il obtint une exemption du service militaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "95745d97-1d2d-30da-90fa-25dfbe01b5a2",
                        "entry_id": "c10913f7-da8c-3143-933b-5055f0694797",
                        "glosses": [
                            "État où l’on n’est pas sujet ou soumis à quelque chose, où l’on est délivré de quelque chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3ca250aa-affa-4bf2-93ed-f24cac059c05",
                                "sense_id": "95745d97-1d2d-30da-90fa-25dfbe01b5a2",
                                "text": "Et c’est aussi un vide de parole qui constitue l’écriture ; c’est de ce vide que partent les traits dont le Zen, dans l’exemption de tout sens, écrit les jardins, les gestes, les maisons, les bouquets, les visages, la violence."
                            }
                        ]
                    },
                    {
                        "sense_id": "95b7988c-8249-3e1a-9c32-b4112d71e607",
                        "entry_id": "c10913f7-da8c-3143-933b-5055f0694797",
                        "glosses": [
                            "Billet de satisfaction qui était donné à un élève et qui pouvait lui servir de dispense en cas de punition."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1714883f-8675-4a5c-87eb-fec63e4c8695",
                                "sense_id": "95b7988c-8249-3e1a-9c32-b4112d71e607",
                                "text": "On donnait au collège de Saint-Étienne, comme partout, des exemptions. Mon père avait le droit d’en distribuer ailleurs que dans sa classe, parce qu’il faisait tous les quinze jours une surveillance dans quelque étude ; il allait dans chacune à tour de rôle, et il pouvait infliger des punitions ou délivrer des récompenses."
                            }
                        ]
                    },
                    {
                        "sense_id": "603d60a9-a2f9-3554-ba39-51f7f87c3b9d",
                        "entry_id": "c10913f7-da8c-3143-933b-5055f0694797",
                        "glosses": [
                            "Enclave territoriale d’un évêché dans un autre évêché."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a23bd109-8015-441b-9fa1-ab37d7fc6dea",
                                "sense_id": "603d60a9-a2f9-3554-ba39-51f7f87c3b9d",
                                "text": "L’Exemption de Saint-Samson."
                            }
                        ]
                    }
                ],
