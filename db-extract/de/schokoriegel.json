                "senses": [
                    {
                        "sense_id": "0f948fc5-81f4-3161-99b5-af7080492086",
                        "entry_id": "2d5ffc9e-22e7-34c5-9cbd-76f3aae7765b",
                        "glosses": [
                            "eine Süßware in Form eines Riegels, deren Füllung je nach Sorte aus Creme, Karamell, Marzipan, Nuss und Anderem zusammengesetzt ist"
                        ],
                        "tags": [
                            "Nahrung"
                        ],
                        "examples": [
                            {
                                "example_id": "57176d92-e72f-47ff-a6a4-9649fa3a41bc",
                                "sense_id": "0f948fc5-81f4-3161-99b5-af7080492086",
                                "text": "Der Schokoriegel schmeckt wunderbar cremig."
                            },
                            {
                                "example_id": "61cf4596-4eea-4d60-8950-452fb4b8b76a",
                                "sense_id": "0f948fc5-81f4-3161-99b5-af7080492086",
                                "text": "„Er warf einem der Hunde den halben Schokoriegel hin.“"
                            },
                            {
                                "example_id": "509708da-db23-4380-aa4e-b851b8d1d85a",
                                "sense_id": "0f948fc5-81f4-3161-99b5-af7080492086",
                                "text": "„An einer Raststätte in Südtirol wollte er einen Schokoriegel kaufen und heiratete im Jahr darauf die Tochter der Tankwartin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a5da9a4-afbb-4d36-8b78-6ac7aa99b6a3",
                        "source_entry_id": "2d5ffc9e-22e7-34c5-9cbd-76f3aae7765b",
                        "source_sense_id": "0f948fc5-81f4-3161-99b5-af7080492086",
