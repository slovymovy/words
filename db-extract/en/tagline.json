                    },
                    {
                        "sense_id": "2e736295-4f29-385e-aad7-6bc2d5e04779",
                        "entry_id": "c3a3bf3f-5ed8-351a-a02c-bba7db8a795b",
                        "glosses": [
                            "An advertising slogan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef619e0-8d33-4cfc-83bf-1b220fee05fd",
                                "sense_id": "2e736295-4f29-385e-aad7-6bc2d5e04779",
                                "text": "Microsoft, Pfizer and JP Morgan Chase have set up offices in the country, a streamlined visa program has incentivized thousands of digital nomads to relocate to Athens, and a relentless tourism push — “You will want to stay forever!” runs the tagline — has lured a record number of Americans to the Aegean this summer."
                            }
                        ]
                    },
                    {
                        "sense_id": "6faf0035-e457-3acb-b2c3-5eebe1cbf100",
                        "entry_id": "c3a3bf3f-5ed8-351a-a02c-bba7db8a795b",
                        "glosses": [
                            "A pithy quotation habitually appended to a signature in email, newsgroups, etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a8bad79-f20d-3f23-b4d4-c394381df327",
                        "entry_id": "c3a3bf3f-5ed8-351a-a02c-bba7db8a795b",
                        "glosses": [
                            "A line attached to a draft of cargo or a container to provide control and minimize pendulation of cargo during lifting operations."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "37d8ec2c-3f2d-313b-b405-bddaaa125b13",
                        "entry_id": "c3a3bf3f-5ed8-351a-a02c-bba7db8a795b",
                        "glosses": [
                            "A light rope attached to an object being hoisted by a crane, used to guide it while lifting or lowering."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f277fccd-8884-388f-a6e7-4b281c6336ee",
