                ],
                "senses": [
                    {
                        "sense_id": "9f281d6e-79bf-3373-9e48-588a7ab6c994",
                        "entry_id": "e2f88acc-e62c-3d28-8ed5-d1583d6ef18a",
                        "glosses": [
                            "ausreichend große Fläche für bestimmte Arbeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca070557-c94b-4a57-92ed-e0d51c168709",
                                "sense_id": "9f281d6e-79bf-3373-9e48-588a7ab6c994",
                                "text": "Das Mehl auf die Arbeitsfläche oder in eine Schüssel geben und in die Mitte eine große Mulde drücken."
                            },
                            {
                                "example_id": "b999f0af-df5c-49ce-bced-b42e9ed689ae",
                                "sense_id": "9f281d6e-79bf-3373-9e48-588a7ab6c994",
                                "text": "Wenn alles vermischt ist, wird der Teig auf der Arbeitsfläche fünf Minuten lang geknetet, bis er glatt und elastisch ist."
                            },
                            {
                                "example_id": "062d5ff9-50f9-4cb1-8061-379620a56b18",
                                "sense_id": "9f281d6e-79bf-3373-9e48-588a7ab6c994",
                                "text": "Vergegenwärtigen wir uns einmal im Geiste, wie genau wir ein Glas greifen und es zum Befüllen vor uns auf einer Arbeitsfläche abstellen – was für ein erstaunlich komplexer Prozess!"
                            },
                            {
                                "example_id": "e12aaf5f-8f4c-4f7a-a79a-0883481301d3",
                                "sense_id": "9f281d6e-79bf-3373-9e48-588a7ab6c994",
                                "text": "„Ich seufzte und legte das alte Buch vorsichtig auf meine Arbeitsfläche, zog die Handschuhe aus und machte mich auf den Weg zur Haustür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "59b7882c-ab04-37d3-9688-fc4de0a60cb5",
                        "entry_id": "e2f88acc-e62c-3d28-8ed5-d1583d6ef18a",
                        "glosses": [
                            "grafische Oberfläche eines Betriebssystems oder einer Anwendersoftware"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "e1450814-52c5-4bf5-912d-9cddd05c6840",
                                "sense_id": "59b7882c-ab04-37d3-9688-fc4de0a60cb5",
                                "text": "Auf der Arbeitsfläche von Audiotool verkabelt man virtuelle Instrumente und Effekte zu einer musikalischen Arbeitsumgebung."
                            },
                            {
                                "example_id": "42e7f65d-0844-47a8-a5e7-cb56db26ade7",
                                "sense_id": "59b7882c-ab04-37d3-9688-fc4de0a60cb5",
                                "text": "Im zweiten Schritt kann eine SmartArt-Grafik in ihre einzelnen Bestandteile zerlegt werden, um diese frei auf der Arbeitsfläche zu positionieren."
                            },
                            {
                                "example_id": "925c71ce-3d57-4f7c-a7a3-3f74f95cfdce",
                                "sense_id": "59b7882c-ab04-37d3-9688-fc4de0a60cb5",
                                "text": "Sie finden Remmina über den Dash-Schnellstart, wenn Sie dort nach dem Programmnamen oder Zugriff auf entfernte Arbeitsflächen suchen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
