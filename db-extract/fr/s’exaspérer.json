                "senses": [
                    {
                        "sense_id": "c3f6ab81-f579-34eb-a20e-1e526793a248",
                        "entry_id": "9a6e2bc3-2379-32a6-997d-52c6fb32da1a",
                        "glosses": [
                            "Augmenter, s’accroître, s’aviver, s’exacerber."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf340b2-4080-44d8-b664-11b6a68d62ed",
                                "sense_id": "c3f6ab81-f579-34eb-a20e-1e526793a248",
                                "text": "Le soir, ses douleurs s’exaspèrent et l’empêchent de s’endormir."
                            },
                            {
                                "example_id": "11c984a8-879a-4800-ac31-b58452080885",
                                "sense_id": "c3f6ab81-f579-34eb-a20e-1e526793a248",
                                "text": "Le conflit qui couvait entre nous s’exaspéra."
                            }
                        ]
                    },
                    {
                        "sense_id": "b347ca54-53f7-3dc4-b122-0ed9d2859491",
                        "entry_id": "9a6e2bc3-2379-32a6-997d-52c6fb32da1a",
                        "glosses": [
                            "S’irriter, s’énerver excessivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0b60adf-0c70-4483-9896-da2fe9dfdb3c",
                                "sense_id": "b347ca54-53f7-3dc4-b122-0ed9d2859491",
                                "text": "Elle l’attige et lui s’exaspère, ils sont faits pour s’entendre !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85647486-cac2-436b-aeee-7cc61f0117b9",
