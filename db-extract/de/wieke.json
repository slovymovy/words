                "senses": [
                    {
                        "sense_id": "d2002a8a-f64d-327b-bab2-0e0d2d695763",
                        "entry_id": "d063696e-532c-34e0-816d-9a81eb6ae503",
                        "glosses": [
                            "Kanal in einer Fehnkolonie zum Zwecke der Entwässerung und Schifffahrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f82119f-3ab3-4ac9-8aae-fece107f2b21",
                                "sense_id": "d2002a8a-f64d-327b-bab2-0e0d2d695763",
                                "text": "„Mit den zweyten 30 Ruthen der Wieke, verfahre ich in diesem Jahre, wie im vorigen Jahre mit den ersten 30 Ruthen.“"
                            },
                            {
                                "example_id": "0037eaf9-dd4a-4be3-b1bc-8f3b9292427b",
                                "sense_id": "d2002a8a-f64d-327b-bab2-0e0d2d695763",
                                "text": "„Früher war hier in der Tat ein großes Moor, das die Ostfriesen ab 1633 abtorften, indem sie Kanäle und Wieken in das Moor gruben, um Brennmaterial zu gewinnen.“"
                            },
                            {
                                "example_id": "0ca8572a-2a9a-43aa-83b7-821429ac2206",
                                "sense_id": "d2002a8a-f64d-327b-bab2-0e0d2d695763",
                                "text": "„Mit bloßen Händen und Schaufeln gruben die Siedler sogenannte ‚Wieken‘, kilometerlange, schnurgerade, rechtwinklig vom Zentrum wegführende Gräben, um das Gebiet zu entwässern und dann Torf abzubauen.“"
                            },
                            {
                                "example_id": "cb51bf91-ea62-4ecc-b076-0ec78dd09af2",
                                "sense_id": "d2002a8a-f64d-327b-bab2-0e0d2d695763",
                                "text": "„In der Ostrhauderfehner Schifferstraße setzte er mit seinem Wagen rückwärts aus einer Grundstücksausfahrt und fuhr in eine dahinter liegende Wieke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
