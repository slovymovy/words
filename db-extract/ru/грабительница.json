                                        "entry_id": "dc87da2a-9a2e-380b-84b5-3d0eb420c4e2",
                                        "glosses": [
                                            "weibliche Person, die einer anderen Person rechtswidrig und unter Androhung oder auch Anwendung von Gewalt etwas wegnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f619b311-288c-4a71-9a72-18db916eb581",
                                                "sense_id": "b319c8f5-d79b-365e-abf1-be6ea452d978",
                                                "text": "„Ein Dienstmädchen und eine Räuberin hatte man in Chelmsford ergriffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
