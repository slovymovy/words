                "senses": [
                    {
                        "sense_id": "7ecf311d-9569-3725-a419-d517372a33a0",
                        "entry_id": "120a8b86-edac-3cfa-9166-8d0c216717e4",
                        "glosses": [
                            "Wörterbuch, das den Wortschatz eines Autors auflistet und erklärt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffb42616-51c6-4246-b009-4306d3660ad9",
                                "sense_id": "7ecf311d-9569-3725-a419-d517372a33a0",
                                "text": "Ein besonders umfangreiches deutsches Autorenwörterbuch ist ein dreibändiges Goethe-Wörterbuch."
                            },
                            {
                                "example_id": "2fd509a2-2dd9-4aa3-b853-8dd0693fa3f6",
                                "sense_id": "7ecf311d-9569-3725-a419-d517372a33a0",
                                "text": "„Prädeterminierend für den Differenzierungsgrad bei der Erfassung lexikalischer Bedeutung, um die es im Autorenwörterbuch geht, ist die Bestimmung dessen, was unter Individual- bzw. Autorensprache verstanden wird.“"
                            },
                            {
                                "example_id": "8f569b6b-9e29-4f4b-b208-656a521dcef4",
                                "sense_id": "7ecf311d-9569-3725-a419-d517372a33a0",
                                "text": "„Das Autorenwörterbuch hingegen greift, indem es das Textkorpus eines einzelnen Autors erfaßt, einerseits enger und andererseits weiter…“"
                            },
                            {
                                "example_id": "dede280b-7134-441c-8118-534062e04ec8",
                                "sense_id": "7ecf311d-9569-3725-a419-d517372a33a0",
                                "text": "„Es ist als alphabetisch geordnetes semasiologisches Autorenwörterbuch angelegt.“"
                            },
                            {
                                "example_id": "e2180608-817c-4456-9e18-1e4c3617536d",
                                "sense_id": "7ecf311d-9569-3725-a419-d517372a33a0",
                                "text": "„Hierzu zählen Autorenwörterbücher, die den Wortschatz aus den zentralen Werken Kants aufführen und erläutern…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
