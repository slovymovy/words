                "senses": [
                    {
                        "sense_id": "28bfdf3d-168b-364e-aa6e-94e083ae6167",
                        "entry_id": "b88b7cd1-8734-3dae-824a-45a97818db47",
                        "glosses": [
                            "das rundliche Ende eines Fingers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8330bac4-5c95-4e07-9b3c-b8ff776b9b72",
                                "sense_id": "28bfdf3d-168b-364e-aa6e-94e083ae6167",
                                "text": "„Ich spiele Nylonsaiten. Nach einer Tournee hab ich links an den Fingerkuppen so dicke Hornhaut, daß ich damit auf glühendes Eisen tippen kann.“"
                            },
                            {
                                "example_id": "d0fea663-4ca2-47fb-bff9-1d98757bfd89",
                                "sense_id": "28bfdf3d-168b-364e-aa6e-94e083ae6167",
                                "text": "„Beim Spielen mit Feuerwerkskörpern ist Montagmorgen einem Elfjährigen eine Fingerkuppe abgerissen worden.“"
                            },
                            {
                                "example_id": "2a927d1e-f14f-458c-af1a-a908dcecb43c",
                                "sense_id": "28bfdf3d-168b-364e-aa6e-94e083ae6167",
                                "text": "„Schon länger wusste man, dass die Papillarlinien an den Fingerkuppen jedes Menschen einzigartig waren.“"
                            },
                            {
                                "example_id": "6fbc2fa9-edc1-4270-ad40-028303004c53",
                                "sense_id": "28bfdf3d-168b-364e-aa6e-94e083ae6167",
                                "text": "„Die Lehrerin strich mit den Fingerkuppen über das Holz, das überraschend hell und leicht war und schwach duftete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
