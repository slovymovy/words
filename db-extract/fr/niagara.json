                    {
                        "sense_id": "c9ef79d6-d078-3e21-a271-fafec4e9c862",
                        "entry_id": "e8181c59-4d74-38cc-80c3-53bee9531d72",
                        "glosses": [
                            "Rivière coulant entre les lacs Érié et Ontario, longue de 58 km, formant une frontière entre le Canada et les États-Unis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c469df7-945e-4030-b7a8-f8dc58397132",
                                "sense_id": "c9ef79d6-d078-3e21-a271-fafec4e9c862",
                                "text": "Les petits navires du lac, qui naviguaient sous le pavillon de la Grande-Bretagne, s’étaient retirés d’Youngstown, et on les voyait mouillés au milieu de la Niagara, à l’endroit où passe la ligne de démarcation entre les deux états."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb33f1cf-3cd2-3413-b86e-54b0809e0fce",
                        "entry_id": "e8181c59-4d74-38cc-80c3-53bee9531d72",
                        "glosses": [
                            "Ensemble de trois chutes d’eau situées sur cette rivière."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
