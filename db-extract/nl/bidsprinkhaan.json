                    {
                        "translation_id": "08003e89-fcd0-434f-bf65-764c36913130",
                        "source_entry_id": "72923fe5-a9d6-3e05-be9e-c3cd13601b26",
                        "source_sense_id": "00fe099a-a149-3fe4-8398-3400a7a63071",
                        "source_sense_description": "benaming voor insecten uit de orde Mantodea",
                        "target_lang_word": "louva-a-deus",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "louva-a-deus",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "bda76c7b-eeda-3630-b4fc-7ba6c246ea80",
                                        "entry_id": "b2f06552-c110-3622-a159-180a397504e5",
                                        "glosses": [
                                            "designação comum à ordem de insetos Mantodea com mais de 2.400 espécies em cerca de 430 gêneros, distribuição mundial em habitats temperados e tropicais, são predadores de emboscada mantendo na fase adulta postura ereta com os antebraços dobrados, assemelhando-se a uma postura de oração (donde seu nome), patas dianteiras muito grandes e adaptadas para capturar e agarrar contendo espinhos que rapidamente prendem suas presas que não os percebem por suas cores camufladas, têm cabeças triangulares com dois olhos compostos bulbosos e salientes (dispostos lateralmente na cabeça, o que lhes confere visão binocular a longo alcance, sendo que sua visão estereoscópica é mais precisa a curta distância, cada um com cerca de 10 000 omatídeos), três pequenos olhos simples e um par de antenas, articulação do pescoço notavelmente flexível (algumas espécies podem girar a cabeça quase 180°), corpos alongados que podem ou não ter asas (que são por vezes coloridas e exibidas como defesa ou na corte), as fêmeas às vezes praticam canibalismo sexual, comendo seus parceiros após a cópula, ovos dispostos em ooteca com cápsulas rígidas e ciclo de vida de aproximadamente um ano"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdfadb99-f022-4ff4-987a-2428a6df4efc",
                                                "sense_id": "bda76c7b-eeda-3630-b4fc-7ba6c246ea80",
                                                "text": "Predador astuto e voraz, o louva-a-deus se alimenta de pequenos insetos e, às vezes, até de bichos maiores, como sapos ou passarinhos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef641cc4-97db-36f2-931d-e7498c4d3dc5",
                                        "entry_id": "b2f06552-c110-3622-a159-180a397504e5",
                                        "glosses": [
                                            "dois estilos de arte marcial (kung fu) baseados nas estratégias e movimentos do inseto, surgidas de modo separado no norte e sul da China"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0857ce94-142f-4377-82ea-1e9c1da50a85",
                                                "sense_id": "ef641cc4-97db-36f2-931d-e7498c4d3dc5",
                                                "text": "Além de apresentações de tai chi chuan e danças dragão e do leão, há exibições de artes marciais, como kung fu louva-a-deus e choy lay fut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "150e1646-6c6f-30c5-b3a7-792aa1aad53e",
                                        "entry_id": "b2f06552-c110-3622-a159-180a397504e5",
                                        "glosses": [
                                            "nome comum a tipo de pássaro endêmico da Ilha da Madeira"
                                        ],
                                        "tags": [
                                            "Portugal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
