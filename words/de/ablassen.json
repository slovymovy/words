                        "das Ablassen von Frust"
                    ]
                },
                {
                    "sense_id": "b037707e-b8a0-3cad-978c-6834a5ec34cb",
                    "sense_definition": "Das Aufhören mit einer Handlung oder das Abstandnehmen von einem Vorhaben.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "substantivierung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sein plötzliches <w>Ablassen</w> von der Klage überraschte alle Beteiligten vor Gericht."
                        },
                        {
                            "text": "Das freiwillige <w>Ablassen</w> von diesem riskanten Plan verhinderte einen großen Schaden."
                        }
                    ]
                },
                {
                    "sense_id": "e9434f6d-f8ad-3890-bbca-b12a4b4b5cb3",
                    "sense_definition": "Das kontrollierte Herablassen einer kletternden Person am Seil zum Boden.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "klettern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim <w>Ablassen</w> muss der Sichernde stets beide Hände am Bremsseil behalten."
                        },
                        {
                            "text": "Das gleichmäßige <w>Ablassen</w> des Kletterpartners erfordert Konzentration und Übung."
                        }
                    ]
                }
            ]
        }
    ]
