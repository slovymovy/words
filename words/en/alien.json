        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76de0969-0618-38b4-949c-85df7323bdf9",
                    "sense_definition": "To transfer the ownership of property or rights to another person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "transfer_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract forbids the tenant to <w>alien</w> the property without permission.",
                            "target_lang_translations": {
                                "ru": "Договор запрещает арендатору <w>отчуждать</w> имущество без разрешения.",
                                "zh": "合同禁止租户未经许可<w>转让</w>该房产。"
                            }
                        },
                        {
                            "text": "He sought to <w>alien</w> his lands before the debt collectors arrived.",
                            "target_lang_translations": {
                                "ru": "Он стремился <w>отчудить</w> свои земли до прихода коллекторов.",
                                "zh": "他在收债人到达之前试图<w>让渡</w>他的土地。"
                            }
                        }
