                "senses": [
                    {
                        "sense_id": "3fd39a18-b702-329a-8c51-72a27a61f33d",
                        "entry_id": "8d723e19-cafd-3493-bf6d-ee3e4d16f354",
                        "glosses": [
                            "In a systematic manner; organizedly or methodically."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19284359-0d11-47fd-b90d-4f70a92debc1",
                                "sense_id": "3fd39a18-b702-329a-8c51-72a27a61f33d",
                                "text": "Taxonomy seeks to systematically name all living organisms; each species has one name and everyone can figure out what that name is."
                            },
                            {
                                "example_id": "e0a6bbcc-817d-44a7-9e89-72b05b3c11c6",
                                "sense_id": "3fd39a18-b702-329a-8c51-72a27a61f33d",
                                "text": "Blast after blast, fiery outbreak after fiery outbreak, like a flaming barrage from within,[…]most of Edison's grounds soon became an inferno. As though on an incendiary rampage, the fires systematically devoured the contents of Edison's headquarters and facilities."
                            },
                            {
                                "example_id": "f30dc267-c495-421b-a111-bcd66c82192a",
                                "sense_id": "3fd39a18-b702-329a-8c51-72a27a61f33d",
                                "text": "Starting from this base list, a number of databases were systematically searched for terms, with especial effort taken to discover the earliest attestation possible[.]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d71e0d3f-ea2e-49aa-a012-4311bac90016",
                        "source_entry_id": "8d723e19-cafd-3493-bf6d-ee3e4d16f354",
                        "source_sense_id": "3fd39a18-b702-329a-8c51-72a27a61f33d",
                        "source_sense_description": "in an organized manner",
                        "target_lang_word": "systématiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "systématiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9a85640-9657-3364-af6a-0ea3ac62329b",
                                        "entry_id": "c6a2388b-04d5-3a0f-8772-c62a5091b642",
                                        "glosses": [
                                            "De manière complète et avec une méthode précise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a589693c-1ca7-4d9c-9a56-c8898465fd0a",
                                                "sense_id": "f9a85640-9657-3364-af6a-0ea3ac62329b",
                                                "text": "Nous allons procéder systématiquement à l’analyse de chaque dossier."
                                            },
                                            {
                                                "example_id": "be40c282-5992-44d5-9550-423b9678b25a",
                                                "sense_id": "f9a85640-9657-3364-af6a-0ea3ac62329b",
                                                "text": "Les enquêteurs ont fouillé la maison du suspect systématiquement, de fond en comble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2884b65b-2afe-39cf-9790-9144e49f1e2a",
                                        "entry_id": "c6a2388b-04d5-3a0f-8772-c62a5091b642",
                                        "glosses": [
                                            "À chaque occasion."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a06d2fdf-c4a8-4e1c-8d36-623001d55421",
                                                "sense_id": "2884b65b-2afe-39cf-9790-9144e49f1e2a",
                                                "text": "Nous employons ici systématiquement comme liquide de contraste des solutions triiodées hydrosolubles de faible concentration (25 % à 35 % max.)."
                                            },
                                            {
                                                "example_id": "f7b74960-9785-4900-a9dd-6c2b1014ba13",
                                                "sense_id": "2884b65b-2afe-39cf-9790-9144e49f1e2a",
                                                "text": "On dit bien souvent que les bons développeurs sont feignants. En effet, ils cherchent systématiquement à réaliser toute tâche en déployant le moins d'effort possible."
                                            },
                                            {
                                                "example_id": "91ca351f-2350-4693-b020-3f3a8fa88a24",
                                                "sense_id": "2884b65b-2afe-39cf-9790-9144e49f1e2a",
                                                "text": "Ainsi, dans de nombreuses institutions, tous les mémoires sont systématiquement soumis au logiciel de détection de plagiat Ephorus avant transmission aux enseignants."
                                            },
                                            {
                                                "example_id": "0ca9ddd6-231c-4d41-b0ad-fe306e3874c4",
                                                "sense_id": "2884b65b-2afe-39cf-9790-9144e49f1e2a",
                                                "text": "Au cours de cette campagne 2024, Donald Trump a d’ailleurs systématiquement refusé de s’engager à reconnaître le résultat du scrutin, s’il ne lui était pas favorable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "476e03d4-f783-4acc-87db-898bdcaa36fc",
                        "source_entry_id": "8d723e19-cafd-3493-bf6d-ee3e4d16f354",
                        "source_sense_id": "3fd39a18-b702-329a-8c51-72a27a61f33d",
                        "source_sense_description": "in an organized manner",
