                    },
                    {
                        "translation_id": "f723bb92-37b2-4c01-9aed-80503ceca2f4",
                        "source_entry_id": "0d197ff4-11d6-379c-a85c-dd59c3b78db2",
                        "source_sense_id": "dee15931-770e-36e7-b1e7-ac44d319365d",
                        "source_sense_description": "iets waarmee iemand zijn brood verdient",
                        "target_lang_word": "livelihood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "livelihood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a146866-d921-3408-a678-9df77935081d",
                                        "entry_id": "79526d57-bb56-3c75-a158-1e2649b956f9",
                                        "glosses": [
                                            "A means of providing the necessities of life for oneself (for example, a job or income)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0186fe06-0ff7-4924-9d84-61d49f6a393b",
                                                "sense_id": "1a146866-d921-3408-a678-9df77935081d",
                                                "text": "an independent livelihood;  to make / earn / gain / win a good livelihood by the sweat of one's brow"
                                            },
                                            {
                                                "example_id": "c0858803-ff5d-4b0c-912a-7106c694f3c4",
                                                "sense_id": "1a146866-d921-3408-a678-9df77935081d",
                                                "text": "But now when Philtra ſaw my lands decay,\nAnd former liuelod fayle, ſhe left me quight[…]."
                                            },
                                            {
                                                "example_id": "fbc83a11-9791-4220-a5b6-f52e520e67d9",
                                                "sense_id": "1a146866-d921-3408-a678-9df77935081d",
                                                "text": "[…] a Man may as easily know where to find one, to teach him to Debauch, Whore, Game, and Blaspheme, as to teach him to Write, or Cast Accompt: ’Tis their Support, and Business; nay, their very Profession, and Livelihood; getting their Living by those Practices, for which they deserve to forfeit their Lives."
                                            },
                                            {
                                                "example_id": "ce1593e5-76fd-430f-a759-eb46189524ea",
                                                "sense_id": "1a146866-d921-3408-a678-9df77935081d",
                                                "text": "1716, Joseph Addison, The Free-Holder, London: D. Midwinter and J. Tonson, No. 42, Monday May 14, p. 245,\nTrade […] employs Multitudes of Hands both by Sea and Land, and furnishes the poorest of our Fellow-Subjects with the Opportunities of gaining an honest Livelihood."
                                            },
                                            {
                                                "example_id": "1cab6939-7b5d-4d1b-af95-7c5d02de09a2",
                                                "sense_id": "1a146866-d921-3408-a678-9df77935081d",
                                                "text": "And now he’s dead, and left her a widow, and she is staying here; and we are racking our brains to find out some way of helping her to a livelihood without parting her from her child."
                                            },
                                            {
                                                "example_id": "1d243c23-22ad-4485-8d74-9ba81dee8d98",
                                                "sense_id": "1a146866-d921-3408-a678-9df77935081d",
                                                "text": "[The Orthodox Jewish shopkeepers] could be seen behind their counters, wearing black skullcaps, full beards, and long earlocks, eking out their meager livelihoods and dreaming of Shabbat and festivals when they could close their stores and turn their attention to their prayers, their rabbi, their God."
                                            },
                                            {
                                                "example_id": "e04ee330-045b-4e21-9639-98e53f985f06",
                                                "sense_id": "1a146866-d921-3408-a678-9df77935081d",
                                                "text": "Broad, flat marshes on the Loughor Estuary provide Pen-clawdd with its basic livelihood - cockles. The cockle-women jog out over the marshes at low tide, riding on flat, horse-drawn carts."
                                            },
                                            {
                                                "example_id": "45d4018c-5917-43d6-81c7-b07b7451dac7",
                                                "sense_id": "1a146866-d921-3408-a678-9df77935081d",
                                                "text": "The legal profession believes that client choice is the best way of ensuring standards remain high, because a lawyer's livelihood depends upon their reputation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "501b1193-a6e4-3125-8c8b-61ba664a67e4",
                                        "entry_id": "79526d57-bb56-3c75-a158-1e2649b956f9",
                                        "glosses": [
                                            "Property which brings in an income; an estate."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0b93930-79a5-4fdc-98aa-e040da7e22a0",
                                                "sense_id": "501b1193-a6e4-3125-8c8b-61ba664a67e4",
                                                "text": "Then ſayde Peter: Ananias how is it that ſatan hath filled thyne hert\nthatt thou ſhuldeſt lye vnto the holy gooſt\nand kepe awaye parte off the pryce off the lyvelod[…]?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "723a86b6-1300-3d58-b414-29fe6fa46077",
                                        "entry_id": "79526d57-bb56-3c75-a158-1e2649b956f9",
                                        "glosses": [
                                            "Liveliness; appearance of life."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14b27c89-1bae-4be3-92b9-4a16b902be82",
                                                "sense_id": "723a86b6-1300-3d58-b414-29fe6fa46077",
                                                "text": "[…] the tiranny of her ſorrowes takes all liuelihood from her cheeke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5636f904-e113-3959-8516-445297eaa5a0",
                                        "entry_id": "79526d57-bb56-3c75-a158-1e2649b956f9",
                                        "glosses": [
                                            "The course of someone's life; a person's lifetime, or their manner of living; conduct, behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8fc50d5-1985-4859-9a0b-49fc73e8c87a",
                                                "sense_id": "5636f904-e113-3959-8516-445297eaa5a0",
                                                "text": "wel said Merlyn I knowe a lord of yours in this land that is a passyng true man & a feithful\n& he shal haue the nourysshyng of your child\n& his name is sir Ector\n& he is a lord of fair lyuelode in many partyes in Englond & walys"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
