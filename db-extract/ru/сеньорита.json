                                                "sense_id": "aa7d4882-31b3-3c07-ac94-3bb7e45c79d3",
                                                "text": "I love it when you call me señorita."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40a0d612-0649-3bc8-a3dc-537ee81817c3",
