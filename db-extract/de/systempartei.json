                "senses": [
                    {
                        "sense_id": "5dbfe24a-2290-3376-bf5f-a77793f36909",
                        "entry_id": "46137c09-db83-3c3d-9c7c-c9445c78cfc5",
                        "glosses": [
                            "conformist political party"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "c5ef13fe-f250-497e-9599-a328766606e2",
                                "sense_id": "5dbfe24a-2290-3376-bf5f-a77793f36909",
                                "text": "Da die Nationalsozialisten “das System” weit schärfer und offener bekämpften, strömten ihnen die in der Krise verunsicherten und deklassierten kleinbürgerlichen Massen zu. Die als “Systempartei” diskreditierte Deutsche Volkspartei verlor den größten Teil ihrer Wähler und folglich auch die finanzielle Unterstützung der Großindustrie."
                            },
                            {
                                "example_id": "d02612dd-1179-4930-9482-54ee8894c987",
                                "sense_id": "5dbfe24a-2290-3376-bf5f-a77793f36909",
                                "text": "Die Botschaft an AfD-Anhänger lautet: Es ist okay, wenn ihr euch umentscheidet. Wenn ihr Positionen von SPD, CDU, FDP Grünen oder Linken zustimmen könnt, obwohl euch eingeredet wurde, dass das stinkende Systemparteien sind."
                            },
                            {
                                "example_id": "38d83e17-c1b3-4219-b911-5ef4a1097e66",
                                "sense_id": "5dbfe24a-2290-3376-bf5f-a77793f36909",
                                "text": "Die Parteien KPRF, LDPR und Gerechtes Russland gelten als Systemparteien, die die Entscheidungen der ER mittragen. Insgesamt dürfte dieser Block auf eine komfortable Mehrheit von mindestens 85 Prozent kommen."
                            }
                        ]
                    }
