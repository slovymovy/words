                    }
                ],
                "senses": [
                    {
                        "sense_id": "e71fddc3-2fce-3558-9d39-f454dbe6d600",
                        "entry_id": "c0a4802f-61f0-38d4-a1b1-eac4146f10bb",
                        "glosses": [
                            "festlich begangenes Ostern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e10e6b1f-43df-465c-a869-c88bcbd6e5d3",
                                "sense_id": "e71fddc3-2fce-3558-9d39-f454dbe6d600",
                                "text": "Er hatte schon viele Osterfeste erlebt."
                            },
                            {
                                "example_id": "cda22825-ec97-4dbf-9ffa-20ae389b0116",
                                "sense_id": "e71fddc3-2fce-3558-9d39-f454dbe6d600",
                                "text": "Der Sinn des Osterfestes gerät immer mehr in Vergessenheit."
                            },
                            {
                                "example_id": "0d8d39fa-39d4-491c-a7d7-2f08f03c6aa7",
                                "sense_id": "e71fddc3-2fce-3558-9d39-f454dbe6d600",
                                "text": "„Dieses Osterfest würden sie sicher so schnell nicht vergessen.“"
                            },
                            {
                                "example_id": "ceef3673-a29c-4850-af7a-446238a6163e",
                                "sense_id": "e71fddc3-2fce-3558-9d39-f454dbe6d600",
                                "text": "„Mit dem Osterfest und seinen hauptsächlich christlichen, aber eben auch moslemischen Feiern, Prozessionen und Darbietungen war die Festsaison aber nicht zu Ende.“"
                            },
                            {
                                "example_id": "91b64a57-242c-42f0-b608-ff6db5647057",
                                "sense_id": "e71fddc3-2fce-3558-9d39-f454dbe6d600",
                                "text": "„Ganz und gar ungewöhnlich war sein Religionshaß seit der Affäre von Arcueil geworden, die ja besonders dadurch aufgebauscht und so gefährlich für ihn geworden war, weil man ihm vorwarf, er habe absichtlich das Osterfest entheiligt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "581b2f6f-f502-489e-90fd-4c506d11af07",
                        "source_entry_id": "c0a4802f-61f0-38d4-a1b1-eac4146f10bb",
                        "source_sense_id": "e71fddc3-2fce-3558-9d39-f454dbe6d600",
                        "source_sense_description": "festlich begangenes Ostern",
                        "target_lang_word": "Easter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Easter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d76dc09-1627-3513-b3bf-feeae6c6c7d8",
                                        "entry_id": "0de24cfe-a196-33b6-8ddf-9a2b73eb043d",
                                        "glosses": [
                                            "A Christian feast commemorating the resurrection of Jesus Christ. It is celebrated on the first Sunday (and Monday) following the full moon that occurs on or next after the vernal equinox, ranging in most of Western Christianity (such as Protestantism and Roman Catholicism) from March 22 to April 25, and in Eastern Christianity (such as the Coptic Church and Eastern Orthodox Church) from April 4 to May 8."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42dbfc02-4acc-4d8c-ba3e-b96f78099095",
                                                "sense_id": "5d76dc09-1627-3513-b3bf-feeae6c6c7d8",
                                                "text": "We spent each of the past five Easters together as a family."
                                            },
                                            {
                                                "example_id": "ce479722-eb08-4df8-b695-92df09a8684e",
                                                "sense_id": "5d76dc09-1627-3513-b3bf-feeae6c6c7d8",
                                                "text": "During the Easter season, the Russians are planning “a great battle in Donbas,” the Russian-occupied region in Ukraine’s far east. “This is not Christian behavior at all, as I understand it. On Easter they will kill, and they will be killed.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc043bea-d606-30a4-8b7b-c532ecb2d5c5",
                                        "entry_id": "0de24cfe-a196-33b6-8ddf-9a2b73eb043d",
                                        "glosses": [
                                            "Eastertide (“the period from Easter to Whitsun”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65ad875e-179c-45dc-af4c-6a3450e50b84",
                                                "sense_id": "bc043bea-d606-30a4-8b7b-c532ecb2d5c5",
                                                "text": "Meronyms: Easter Day, Easter Sunday"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf3c17e5-dddc-3398-930d-d0e045bfa861",
                                        "entry_id": "0de24cfe-a196-33b6-8ddf-9a2b73eb043d",
                                        "glosses": [
                                            "Usually preceded by an inflection of make: the act of receiving the Eucharist during Easter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "figuratively",
                                            "specifically",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04ac534b-98fd-3d11-ab2e-7b14d0cb2e6d",
                                        "entry_id": "0de24cfe-a196-33b6-8ddf-9a2b73eb043d",
                                        "glosses": [
                                            "Ellipsis of Easter term."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e1c468b-dd8e-3874-abe5-7e5046529e50",
                                        "entry_id": "0de24cfe-a196-33b6-8ddf-9a2b73eb043d",
                                        "glosses": [
                                            "A festival held in honour of the goddess Eostre or Ostara, celebrated at the vernal equinox or within the month of April; Eostre, Ostara."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5afc52ab-df74-3c6d-8fca-7fb1ab244a0c",
                                        "entry_id": "0de24cfe-a196-33b6-8ddf-9a2b73eb043d",
                                        "glosses": [
                                            "The Jewish Passover."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fdc3726-85a2-49df-a3c5-a34daeff25f8",
                                                "sense_id": "5afc52ab-df74-3c6d-8fca-7fb1ab244a0c",
                                                "text": "After two dayes folowed eſter⸝ and the dayes of ſwete breed. And the hye preſtꝭ [prestis] and ſcrybꝭ [scrybis] ſought meanes⸝ howe they myght take hym [Jesus] by crafte and putt hym to deeth."
                                            }
                                        ]
                                    }
