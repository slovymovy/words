                                            {
                                                "example_id": "c934d649-94df-49a8-885c-88007abb865e",
                                                "sense_id": "f0b1439b-a0d4-3100-805c-a5b21eea86be",
                                                "text": "Het grootste gedeelte van de peuken wordt geraapt in Nederland, zegt mede-organisator Anton Damen, die zichzelf online de 'Plandelman' noemt."
                                            },
                                            {
                                                "example_id": "8a58add7-3c1f-456c-ae59-6beaba5d3d8b",
                                                "sense_id": "f0b1439b-a0d4-3100-805c-a5b21eea86be",
                                                "text": "Toen Anton een kind van zes, zeven jaar was knutselde hij, zoals zoveel kinderen, van een afwasmiddelfles en aluminiumfolie een ruimteschip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ed503c-b701-3c16-9e2b-ff63481912f5",
                                        "entry_id": "101ce8ad-80e1-3c9f-b915-8a2f066a8a07",
