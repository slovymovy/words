                ],
                "senses": [
                    {
                        "sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                        "entry_id": "ae8cefba-285d-38c8-b975-a5762eaf8d1e",
                        "glosses": [
                            "mit dem Kamin verbundenes Rohr am Ofen, durch das der Rauch abzieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26c11c3d-3f4f-4a1e-af76-b62bd930cced",
                                "sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                                "text": "Das Ofenrohr ist ein metallisches Rundrohr und verbindet den Ofen mit dem Kamin."
                            },
                            {
                                "example_id": "92ab59d6-adcf-4c9d-a0c5-8e996f3076af",
                                "sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                                "text": "„Das Rauchrohr ist die Verbindung zwischen Schornstein und Kaminofen, teilweise wird es auch als Ofenrohr bezeichnet. “"
                            },
                            {
                                "example_id": "6bcd3a52-8361-4ba2-b2b7-1ad3712dcb62",
                                "sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                                "text": "„Das Kniestück des Ofenrohrs führte durch einen Blechkranz ins Freie.“"
                            },
                            {
                                "example_id": "23ac7238-c49d-43a4-9ad0-f8befbc07aed",
                                "sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                                "text": "„In manchen Zimmern ist das Ofenrohr so geschickt angebracht, daß man selbst in den entfernten Ecken nicht friert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "98291da7-7515-3304-bb6f-e099539ba384",
                        "entry_id": "ae8cefba-285d-38c8-b975-a5762eaf8d1e",
                        "glosses": [
                            "elektrisches oder gasbetriebenes Küchengerät, in dem Lebensmittel gebacken oder gebraten werden, meist als Teil eines Herdes"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "c638eedf-3381-4933-bf12-18e3ad32d2e7",
                                "sense_id": "98291da7-7515-3304-bb6f-e099539ba384",
                                "text": "„Mir jedenfalls schmeckt mein in meinem düsteren Ofenrohr schlaff aufgewärmtes Biokipferl nach wie vor nicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e6ed331-e42f-4e26-a87d-9428ab734f13",
                        "source_entry_id": "ae8cefba-285d-38c8-b975-a5762eaf8d1e",
                        "source_sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                        "source_sense_description": "mit dem Kamin verbundenes Rohr am Ofen, durch das der Rauch abzieht",
                        "target_lang_word": "stovepipe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stovepipe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33450735-542e-349a-bbcb-4c9c5b94230c",
                                        "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                                        "glosses": [
                                            "Sheet-metal tubing used as a chimney for a stove or furnace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02567b47-ec6a-4157-ba7c-da94afc391fe",
                                                "sense_id": "33450735-542e-349a-bbcb-4c9c5b94230c",
                                                "text": "On the Visby-Västerhejde Railway there is a steam car. [...] The upperworks consist of a short clerestory coach body with end platforms and the engine chimney protruding from the roof like a stovepipe."
                                            },
                                            {
                                                "example_id": "8632a228-9e8d-4a07-86cb-bd7e13d1d042",
                                                "sense_id": "33450735-542e-349a-bbcb-4c9c5b94230c",
                                                "text": "Glass windows replaced the old tiny windows of selenite (crystallized gypsum), and stovepipe replaced adobe chimneys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4e7b24b-88d3-39d8-8c04-528ed079cf32",
                                        "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                                        "glosses": [
                                            "A channel for information which is compartmentalized in such a manner that some parties who might be interested in its use or able to make use of it are restricted from accessing it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88715d64-7778-38a1-a18e-df29a7b2b29e",
                                        "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                                        "glosses": [
                                            "A stovepipe hat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8008256d-6007-4b9c-88b1-cf6b03bb899e",
                                                "sense_id": "88715d64-7778-38a1-a18e-df29a7b2b29e",
                                                "text": "I'm sure the Brunel-designed stone-built structure would have had a hatstand for his trademark stovepipe. I can picture him rocking up there of a morning and lobbing it nonchalantly onto the hatstand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c640bf3a-4bdc-3c0c-a733-17cd331cf215",
                                        "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                                        "glosses": [
                                            "A type of malfunction affecting breechloading firearms, where a spent cartridge casing fails to eject completely, instead becoming stuck in the firearm's ejection port, usually oriented vertically or nearly so."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71eb85ad-a30d-3b8f-9760-5c394780a025",
                                        "entry_id": "f6fc5904-fa13-3a09-b2cb-78a1b5bb9417",
                                        "glosses": [
                                            "A trench mortar such as the Stokes mortar."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stovepipe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4548de5b-554d-31c0-bc71-749ea4b798a4",
                                        "entry_id": "cab1e417-7153-35e9-80b0-676df22070d0",
                                        "glosses": [
                                            "To collect or store (information) in a compartmentalized manner, so that some parties who might be interested in its use or able to make use of it are restricted from accessing it."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2659dad1-6a36-3330-b0d6-36091e37d7f3",
                                        "entry_id": "cab1e417-7153-35e9-80b0-676df22070d0",
                                        "glosses": [
                                            "Of a cartridge case, to become wedged vertically in the ejection port of a breechloading firearm, rather than ejecting completely from the weapon."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4079f70a-7cf3-4fb4-9a89-b912f775a007",
                        "source_entry_id": "ae8cefba-285d-38c8-b975-a5762eaf8d1e",
                        "source_sense_id": "72db93e5-58c7-3ab6-b1e0-f97184095d78",
                        "source_sense_description": "mit dem Kamin verbundenes Rohr am Ofen, durch das der Rauch abzieht",
                        "target_lang_word": "tuyau de poêle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tuyau de poêle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8620c537-034e-3f18-a723-fa2a51abe04e",
                                        "entry_id": "8f7b37d1-8828-3ab8-8e73-dd1b1c8ccea3",
                                        "glosses": [
                                            "Tuyau, presque toujours en métal, qui sert à l’évacuation de la fumée d'un poêle."
                                        ],
                                        "tags": [
                                            "generically",
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08d5908c-c6fd-4671-93d7-630f67883c14",
                                                "sense_id": "8620c537-034e-3f18-a723-fa2a51abe04e",
                                                "text": "On aura grand soin d’avoir dans les endroits où ils seront ainsi tenus, des ventilateurs pour changer l’air autant qu’il sera nécessaire , un tuyau de poêle pour éviter la grande rigueur du froid, […]"
                                            },
                                            {
                                                "example_id": "c770312c-5fe6-467e-b4e8-1b3c80313ea3",
                                                "sense_id": "8620c537-034e-3f18-a723-fa2a51abe04e",
                                                "text": "Du bas de la salle, où il ne voyait plus que des dos, sur qui planait le noir tuyau de poêle attaché au plafond par des bouts de fil de fer, il passa lentement au tableau, saisit un tronçon de craie rouge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25d1032d-ebe6-3e5f-a357-7c71c696a322",
                                        "entry_id": "8f7b37d1-8828-3ab8-8e73-dd1b1c8ccea3",
                                        "glosses": [
                                            "Chapeau haut-de-forme à coiffe cylindrique."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1be7c60e-324b-4e8f-b3d8-dc49b0e9668c",
                                                "sense_id": "25d1032d-ebe6-3e5f-a357-7c71c696a322",
                                                "text": "Il montra l’affreux chapeau en usage aujourd’hui.\n— Voilà l’ennemi, messieurs, reprit-il. Dire que le peuple le plus spirituel de la terre consent à porter sur la tête ce morceau de tuyau de poêle ! a dit un de nos écrivains."
                                            },
                                            {
                                                "example_id": "59b420a1-ea9e-4218-b3ae-b3da696d8232",
                                                "sense_id": "25d1032d-ebe6-3e5f-a357-7c71c696a322",
                                                "text": "Les légers canotiers, les souples panamas, les feutres confortables, les demi-cloches, les galurins à la tyrolienne, les « toitures » de chaume et d’étoffe avaient régné à souhait. Le tuyau de poêle semblait déjà à nos yeux comme un phénomène d’absurdité, ainsi que fut pour la femme la crinoline. On pouvait espérer ne revoir cette colossale capsule que dans les cérémonies villageoises ou sur la scène de nos plus désopilants vaudevilles."
                                            },
                                            {
                                                "example_id": "32e9ce08-8c15-48e9-a183-e3e14965e396",
                                                "sense_id": "25d1032d-ebe6-3e5f-a357-7c71c696a322",
                                                "text": "— Et vous autres ! Qu’est-ce que vous avez à me regarder ? Parce que je n’ai pas de redingote ni de tuyau de poêle ? Tas de bouffis, va ! Attendez que je vous décolle le cul de vos chaises !"
                                            },
                                            {
                                                "example_id": "db1baeb2-f0fc-443b-b14e-c939bc48d461",
                                                "sense_id": "25d1032d-ebe6-3e5f-a357-7c71c696a322",
                                                "text": "Énorme sous l’amplitude de sa jaquette et sous son tuyau de poêle café au lait, il m’avait semblé avoir pour l’auteur des Insomnies beaucoup de sympathie et autant d’admiration que de sympathie."
                                            },
                                            {
                                                "example_id": "421cefa4-9260-42c5-898b-65c7430f86db",
                                                "sense_id": "25d1032d-ebe6-3e5f-a357-7c71c696a322",
                                                "text": "Derrière lui marchait le secrétaire Schwân, le chapeau en tuyau de poêle tout droit sur sa grosse figure bourgeonnée, et le registre sous le bras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9fa73d-d52b-38a1-a7b0-a805436a8c4e",
                                        "entry_id": "8f7b37d1-8828-3ab8-8e73-dd1b1c8ccea3",
                                        "glosses": [
                                            "Pantalon sans style."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "265af462-3b7e-4a25-8e9c-f3b6d3c48453",
                                                "sense_id": "bf9fa73d-d52b-38a1-a7b0-a805436a8c4e",
                                                "text": "Un pantalon d’habit, raide et lisse, n’était-il pas préférable à de ridicules tuyaux de poêle, parfois trop courts, cachant à peine les chaussettes et la tige disgracieuse des souliers neufs insuffisamment imprégnés de cirage, parfois trop longs, et vrillant alors en larges rides, comme une défroque de saltimbanque ?"
                                            }
                                        ]
                                    }
                                ]
                            }
