                "senses": [
                    {
                        "sense_id": "f73a6143-caa9-3140-b53e-c06b1c13d342",
                        "entry_id": "43227003-f8d9-3145-8b71-1d0e776cf9ea",
                        "glosses": [
                            "Pittoresque, joli, attractif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79866f38-e6b4-4782-9577-4af781025628",
                                "sense_id": "f73a6143-caa9-3140-b53e-c06b1c13d342",
                                "text": "Je faisais systématiquement attention à la sélection des lieux où j'animais, en m'assurant qu'ils étaient « instagramables » et connus."
                            },
                            {
                                "example_id": "851e407c-46e2-4527-bda5-d194e4db3a52",
                                "sense_id": "f73a6143-caa9-3140-b53e-c06b1c13d342",
                                "text": "Un art calculé/spontané qui ne s'embarrasse pas d'emphase intellectuelle, s'expose sans interprétation complexe, se regarde sans distance nécessaire pour générer des likes. C'est de l'art instagramable par excellence, un art emoji qui suscite des réactions instinctives."
                            },
                            {
                                "example_id": "2c64b918-9885-4975-85af-920b6c7918bd",
                                "sense_id": "f73a6143-caa9-3140-b53e-c06b1c13d342",
                                "text": "Regarde où j'en suis, ça fait des mois que je suis sensée être devenue millionnaire et j'en suis toujours rendue à bouffer des coquillettes au beurre, dans un appartement qui ne contient pas le moindre élément instagramable."
                            },
                            {
                                "example_id": "90149658-97d3-4b00-a2bb-32b7fd82be8e",
                                "sense_id": "f73a6143-caa9-3140-b53e-c06b1c13d342",
                                "text": "Au-delà de son efficacité, c’est aussi son côté instagramable qui fait des émules."
                            }
                        ]
                    }
                ],
