{
    "word_family": [
        "debt",
        "debtor",
        "indebtedness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e9ff3c48-0558-34e4-9551-8accc35b2a4e",
                    "sense_definition": "Owing gratitude for a service or favour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gratitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are <w>indebted</w> to our neighbors for their help during the storm.",
                            "target_lang_translations": {
                                "de": "Wir sind unseren Nachbarn für ihre Hilfe während des Sturms <w>zu Dank verpflichtet</w>."
                            }
                        },
                        {
                            "text": "The author is <w>indebted</w> to his editor for the many helpful suggestions.",
                            "target_lang_translations": {
                                "de": "Der Autor ist seinem Lektor für die vielen hilfreichen Vorschläge <w>zu Dank verpflichtet</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "obliged"
                    ],
                    "common_phrases": [
                        "deeply indebted"
                    ],
                    "target_lang_definitions": {
                        "de": "Dankbarkeit für einen Dienst oder eine Gefälligkeit schulden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zu Dank verpflichtet",
                                "target_lang_sense_clarification": "Ausdruck von Dankbarkeit gegenüber jemandem."
                            },
                            {
                                "target_lang_word": "jemandem etwas schulden",
                                "target_lang_sense_clarification": "Im übertragenen Sinne für Hilfe oder Unterstützung."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22b44dc0-a4bb-35a5-8090-22af63117c9a",
                    "sense_definition": "Obligated, especially financially.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>indebted</w> company struggled to pay back its massive loans.",
                            "target_lang_translations": {
                                "de": "Das <w>verschuldete</w> Unternehmen hatte Schwierigkeiten, seine massiven Kredite zurückzuzahlen."
                            }
                        },
                        {
                            "text": "Many <w>indebted</w> nations are seeking financial assistance from international banks.",
                            "target_lang_translations": {
                                "de": "Viele <w>verschuldete</w> Nationen suchen finanzielle Unterstützung bei internationalen Banken."
                            }
                        }
                    ],
                    "synonyms": [
                        "beholden"
                    ],
                    "common_phrases": [
                        "heavily indebted"
                    ],
                    "target_lang_definitions": {
                        "de": "Verpflichtet, insbesondere in finanzieller Hinsicht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschuldet",
                                "target_lang_sense_clarification": "Finanziell belastet durch Schulden."
                            },
                            {
                                "target_lang_word": "hoch verschuldet",
                                "target_lang_sense_clarification": "Betont eine sehr hohe finanzielle Belastung."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8457fac-d41a-34a2-9c3b-651636b90024",
                    "sense_definition": "Simple past and past participle of <w>indebt</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government has <w>indebted</w> the country through excessive borrowing.",
                            "target_lang_translations": {
                                "de": "Die Regierung hat das Land durch übermäßige Kreditaufnahme <w>verschuldet</w>."
                            }
                        },
                        {
                            "text": "He <w>indebted</w> himself to his friends by asking for too many favors.",
                            "target_lang_translations": {
                                "de": "Er hat sich bei seinen Freunden <w>verschuldet</w>, indem er um zu viele Gefallen bat."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb indebt."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Vergangenheit und Partizip Perfekt von 'indebt' (verschulden)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschuldet",
                                "target_lang_sense_clarification": "Die Handlung, jemanden oder sich selbst in Schulden zu bringen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}