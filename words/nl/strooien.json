                {
                    "sense_id": "6e20d237-75c8-32f8-adf9-8643683811f0",
                    "sense_definition": "In kleine hoeveelheden over iets heen gieten of werpen, met name van poeders of vloeistoffen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verspreiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt een beetje poedersuiker op de pannenkoek <w>strooien</w> voor extra smaak.",
                            "target_lang_translations": {
                                "en": "You can <w>sprinkle</w> a little powdered sugar on the pancake for extra flavor."
                            }
                        },
                        {
                            "text": "Vergeet niet om wat zout over de frites te <w>strooien</w> voordat je ze serveert.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>sprinkle</w> some salt over the fries before serving them."
                            }
