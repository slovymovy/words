                        "examples": [
                            {
                                "example_id": "a026bb16-b83c-40ed-b1dd-c478ab4b7847",
                                "sense_id": "7db00762-8399-303f-9d5f-1d97888605a2",
                                "text": "Большую популярность среди читателей завоевала безлимитная подписка на произведения из золотого фонда русской и советской классики."
                            },
                            {
                                "example_id": "a5d23225-b2cf-4226-b58a-cc6ae5998860",
                                "sense_id": "7db00762-8399-303f-9d5f-1d97888605a2",
                                "text": "― Тебе позвонить надо? ― Ну, в общем, да… ― На мобильный, не стесняйся, он безлимитный, болтай сколько хочешь."
                            }
                        ]
                    }
