                "senses": [
                    {
                        "sense_id": "bd548c7a-9111-33df-ab27-988ed245c41a",
                        "entry_id": "30d27813-4280-3310-85b2-ceee07e62178",
                        "glosses": [
                            "Synonym of extraspect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d703147d-70c5-470e-9b2f-4c08a00d1756",
                                "sense_id": "bd548c7a-9111-33df-ab27-988ed245c41a",
                                "text": "To conform myself to the other is not merely to alter my moods and desires, but to enter into another field, to decenter myself, to extrospect."
                            },
                            {
                                "example_id": "7e5c4056-f641-47c1-b81e-913ee64caa79",
                                "sense_id": "bd548c7a-9111-33df-ab27-988ed245c41a",
                                "text": "All of us know our respective minds and mental states directly by introspection. But one cannot extrospect the minds of others, having no scope to directly know what is going on there."
                            },
                            {
                                "example_id": "ee2d667c-2dc6-4fba-a14d-917e2de85d35",
                                "sense_id": "bd548c7a-9111-33df-ab27-988ed245c41a",
                                "text": "I can introspect into my own mind to see whether I am in pain or angry or fearful, but I cannot extrospect into my neighbor's mind to see whether he or she is in pain or angry or fearful."
                            }
                        ]
                    }
                ],
