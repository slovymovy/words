                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремиться",
                                "target_lang_sense_clarification": "настойчиво добиваться чего-либо, желать достижения цели"
                            },
                            {
                                "target_lang_word": "целиться",
                                "target_lang_sense_clarification": "иметь целью достижение чего-либо"
                            }
