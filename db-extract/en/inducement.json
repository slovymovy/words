                                        "glosses": [
                                            "etwas, das eine Veranlassung/Motivation darstellt, etwas Bestimmtes zu tun oder zu lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9aa465-0e57-44a2-bc37-377c81f42ca6",
                                                "sense_id": "c0a1740b-af17-31f2-9abe-58a4c600aecf",
                                                "text": "Das Spiel gab keinen Anreiz, sich noch weitere anzusehen."
                                            },
                                            {
                                                "example_id": "bd7aa5f0-611c-4acf-9237-5b38ef9d07a3",
                                                "sense_id": "c0a1740b-af17-31f2-9abe-58a4c600aecf",
                                                "text": "„Bislang erzielten Investoren mit kurzfristigen Anlagen so hohe Renditen, dass sie keinen Anreiz hatten, in längerfristige Infrastrukturprojekte einzusteigen.“"
                                            }
                                        ],
