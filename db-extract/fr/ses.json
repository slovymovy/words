                        "examples": [
                            {
                                "example_id": "27d1a35a-d2e7-49c0-84f4-620d18c9dcbe",
                                "sense_id": "22800bbb-e411-32fc-af41-3d5394a56935",
                                "text": "Ceux qui ont choisi une spécialité très demandée, comme mathématiques, SES ou histoire-géographie, géopolitique et sciences politiques paient le plus lourd tribut."
                            },
                            {
                                "example_id": "d515afd7-8e47-42ce-946b-92b735f45c63",
                                "sense_id": "22800bbb-e411-32fc-af41-3d5394a56935",
                                "text": "Les programmes de l’enseignement de sciences économiques et sociales (SES) de la classe de seconde générale et technologique et de spécialité des classes de première et terminale de la voie générale sont présentés en lien avec des ressources pour accompagner leur mise en œuvre."
                            },
                            {
                                "example_id": "603d17c7-54e5-46c0-a3c8-5188384063a2",
                                "sense_id": "22800bbb-e411-32fc-af41-3d5394a56935",
                                "text": "Quel sera le programme de la spécialité SES en classe de première ?"
