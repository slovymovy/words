                "senses": [
                    {
                        "sense_id": "671dac5f-a6b0-3294-9719-6b5379c6400e",
                        "entry_id": "cfb0f63a-955f-3cc4-b82e-c4655d24caa3",
                        "glosses": [
                            "Sweatshirt mit integrierter Kapuze"
                        ],
                        "tags": [
                            "Bekleidung"
                        ],
                        "examples": [
                            {
                                "example_id": "6dcee1c8-fa1a-4171-8a75-8dfbc0f7ecc0",
                                "sense_id": "671dac5f-a6b0-3294-9719-6b5379c6400e",
                                "text": "„Ein 14-Jähriger, ganz neuzeitlich im Kapuzenshirt, sitzt auf dem, was einmal die Beine einer mannshohen Bärenskulptur werden sollen, treibt dem Holzblock mit Stemmeisen und Gummihammer Konturen in den Leib.“"
                            },
                            {
                                "example_id": "c3778cba-a6dc-4f56-965d-c2bafae53f0f",
                                "sense_id": "671dac5f-a6b0-3294-9719-6b5379c6400e",
                                "text": "„Die Zeugen haben dunkle Augenbrauen beobachtet, der mit dem Kapuzenshirt hatte wohl auch dunkle Haare.“"
                            },
                            {
                                "example_id": "ef0fa9e1-8226-44b0-881d-02e69989a8ab",
                                "sense_id": "671dac5f-a6b0-3294-9719-6b5379c6400e",
                                "text": "„Sein Kopf ist kahl rasiert, in einem schwarzen Kapuzenshirt sitzt er am Küchentisch in seiner Wohnung und raucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
