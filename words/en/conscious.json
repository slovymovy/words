{
    "word_family": [
        "consciousness",
        "unconscious",
        "subconscious",
        "unconsciously",
        "self-conscious"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8701941a-87df-34f4-a317-5ddc035b0d9e",
                    "sense_definition": "Alert, awake, and able to understand what is happening around you.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "state_of_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The noise woke me, but it was another few minutes before I was fully <w>conscious</w>.",
                            "target_lang_translations": {
                                "ru": "Шум разбудил меня, но прошло ещё несколько минут, прежде чем я окончательно <w>пришёл в себя</w>.",
                                "zh": "噪音把我吵醒了，但又过了几分钟我才完全<w>清醒</w>过来。"
                            }
                        },
                        {
                            "text": "The patient remained <w>conscious</w> throughout the minor surgery.",
                            "target_lang_translations": {
                                "ru": "Пациент оставался <w>в сознании</w> на протяжении всей малой операции.",
                                "zh": "病人在整个小手术过程中一直保持<w>清醒</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unconscious",
                        "asleep"
                    ],
                    "common_phrases": [
                        "fully conscious",
                        "barely conscious",
                        "remain conscious"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в сознании, бодрствующий и способный понимать происходящее вокруг.",
                        "zh": "清醒的，能够感知周围发生的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "находящийся в сознании",
                                "target_lang_sense_clarification": "о физическом состоянии"
                            },
                            {
                                "target_lang_word": "в сознании",
                                "target_lang_sense_clarification": "предикативное употребление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清醒的",
                                "target_lang_sense_clarification": "指神志清醒的状态"
                            },
                            {
                                "target_lang_word": "有意识的",
                                "target_lang_sense_clarification": "指处于知觉状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0484ce0b-3b2e-37d4-add4-6fe1e7ea7923",
                    "sense_definition": "Noticing or realizing something; aware of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>conscious</w> of a strange noise coming from the engine.",
                            "target_lang_translations": {
                                "ru": "Я <w>осознавал</w>, что из двигателя доносится странный шум.",
                                "zh": "我<w>意识到</w>引擎里传出一种奇怪的声音。"
                            }
                        },
                        {
                            "text": "She is very <w>conscious</w> of how she dresses for work.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>озабочена</w> тем, как одевается на работу.",
                                "zh": "她非常<w>在意</w>自己上班时的着装。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unaware"
                    ],
                    "common_phrases": [
                        "conscious of",
                        "socially conscious",
                        "health-conscious"
                    ],
                    "target_lang_definitions": {
                        "ru": "Замечающий или осознающий что-либо; отдающий себе отчёт в чём-либо.",
                        "zh": "察觉到或意识到某事；对某事有感知。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осознающий",
                                "target_lang_sense_clarification": "понимающий происходящее"
                            },
                            {
                                "target_lang_word": "понимающий",
                                "target_lang_sense_clarification": "отдающий себе отчет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意识到",
                                "target_lang_sense_clarification": "指对某事有明确的认知"
                            },
                            {
                                "target_lang_word": "察觉到",
                                "target_lang_sense_clarification": "指感知到某事的存在"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ba504b4-17e6-3d28-8fe1-cac213028bcd",
                    "sense_definition": "Done intentionally or with full awareness of what one is doing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deliberate_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make a <w>conscious</w> effort to be a better listener.",
                            "target_lang_translations": {
                                "ru": "Сделайте <w>сознательное</w> усилие, чтобы стать лучшим слушателем.",
                                "zh": "要<w>自觉</w>地努力做一个更好的倾听者。"
                            }
                        },
                        {
                            "text": "It was a <w>conscious</w> decision to leave the company.",
                            "target_lang_translations": {
                                "ru": "Это было <w>осознанное</w> решение уйти из компании.",
                                "zh": "离开这家公司是一个<w>经过深思熟虑</w>的决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intentional",
                        "voluntary",
                        "wilful"
                    ],
                    "common_phrases": [
                        "conscious decision",
                        "conscious effort",
                        "conscious choice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный намеренно или с полным осознанием своих действий.",
                        "zh": "蓄意的，或在完全了解自己行为的情况下进行的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сознательный",
                                "target_lang_sense_clarification": "намеренный (об усилиях, действиях)"
                            },
                            {
                                "target_lang_word": "осознанный",
                                "target_lang_sense_clarification": "осмысленный (о решениях, выборе)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有意识的",
                                "target_lang_sense_clarification": "指经过思考的、主动的"
                            },
                            {
                                "target_lang_word": "自觉的",
                                "target_lang_sense_clarification": "指主动且有目的地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b326524b-49fb-3c21-b609-7e5e05595ce8",
                    "sense_definition": "Aware of one's own existence and thoughts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state_of_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only highly intelligent beings are considered fully <w>conscious</w>.",
                            "target_lang_translations": {
                                "ru": "Только высокоинтеллектуальные существа считаются полностью <w>разумными</w>.",
                                "zh": "只有高智商的生物才被认为完全具备<w>意识</w>。"
                            }
                        },
                        {
                            "text": "Is the machine actually <w>conscious</w>, or just simulating thought?",
                            "target_lang_translations": {
                                "ru": "Машина действительно <w>обладает сознанием</w> или просто имитирует мышление?",
                                "zh": "这台机器是真的有<w>意识</w>，还是仅仅在模拟思维？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "conscious being",
                        "conscious mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осознающий собственное существование и мысли; обладающий сознанием.",
                        "zh": "意识到自身存在和思想的；具有意识的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обладающий сознанием",
                                "target_lang_sense_clarification": "о живых существах или ИИ"
                            },
                            {
                                "target_lang_word": "разумный",
                                "target_lang_sense_clarification": "мыслящий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有意识的",
                                "target_lang_sense_clarification": "指具备自我意识"
                            },
                            {
                                "target_lang_word": "有知觉的",
                                "target_lang_sense_clarification": "指具备感知能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e772eb4-c4f8-30c3-94c7-d9cd54f4ea10",
                    "sense_definition": "Known or felt personally and internally by a person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "internal_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a <w>conscious</w> guilt for lying to his friend.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал <w>осознанную</w> вину за ложь другу.",
                                "zh": "因为对朋友撒谎，他感到一种<w>明确的</w>内疚。"
                            }
                        },
                        {
                            "text": "Her <w>conscious</w> fear kept her from speaking up.",
                            "target_lang_translations": {
                                "ru": "Её <w>осознанный</w> страх не давал ей высказаться.",
                                "zh": "她内心<w>明确的</w>恐惧使她不敢开口。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "conscious guilt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Известный или ощущаемый человеком лично и внутренне.",
                        "zh": "个人内心深处所感知或体验到的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осознанный",
                                "target_lang_sense_clarification": "о чувствах и эмоциях"
                            },
                            {
                                "target_lang_word": "явный",
                                "target_lang_sense_clarification": "отчетливый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自觉的",
                                "target_lang_sense_clarification": "指内心明确感受到的"
                            },
                            {
                                "target_lang_word": "明确的",
                                "target_lang_sense_clarification": "指清晰可感的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4ae7a30-67cf-39ab-9df9-89a32ca85dfd",
                    "sense_definition": "Showing awareness of one's own wrongdoing or embarrassment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "guilt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>conscious</w> smile when asked about the letter.",
                            "target_lang_translations": {
                                "ru": "Она <w>смущённо</w> улыбнулась, когда её спросили о письме.",
                                "zh": "当被问及那封信时，她露出了<w>尴尬</w>的微笑。"
                            }
                        },
                        {
                            "text": "He looked <w>conscious</w> and uncomfortable under their gaze.",
                            "target_lang_translations": {
                                "ru": "Он выглядел <w>смущённым</w> и чувствовал себя неловко под их взглядами.",
                                "zh": "在他们的注视下，他显得<w>局促不安</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Modern usage typically prefers 'self-conscious' or 'guilty'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий осознание своей вины или смущение.",
                        "zh": "表现出意识到自己的错误或感到尴尬。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смущённый",
                                "target_lang_sense_clarification": "испытывающий неловкость"
                            },
                            {
                                "target_lang_word": "виноватый",
                                "target_lang_sense_clarification": "выражающий вину"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "局促不安的",
                                "target_lang_sense_clarification": "指因尴尬而表现出的状态"
                            },
                            {
                                "target_lang_word": "难为情的",
                                "target_lang_sense_clarification": "指感到羞愧或尴尬"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "228c8abf-55bc-314c-875a-ad2929bf5913",
                    "sense_definition": "The part of the mind that is aware of itself and the world.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "psychoanalysis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thoughts move from the unconscious to the <w>conscious</w>.",
                            "target_lang_translations": {
                                "ru": "Мысли переходят из бессознательного в <w>сознательное</w>.",
                                "zh": "思想从潜意识转移到<w>意识</w>层面。"
                            }
                        },
                        {
                            "text": "He tried to bring the memory into his <w>conscious</w>.",
                            "target_lang_translations": {
                                "ru": "Он пытался перенести воспоминание в своё <w>сознание</w>.",
                                "zh": "他试图将这段记忆带入自己的<w>意识</w>中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the conscious"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть психики, которая осознаёт саму себя и окружающий мир.",
                        "zh": "心理中能够感知自身及外部世界的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сознание",
                                "target_lang_sense_clarification": "психологический термин"
                            },
                            {
                                "target_lang_word": "сознательное",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意识",
                                "target_lang_sense_clarification": "心理学概念"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}