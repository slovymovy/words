                        "glosses": [
                            "Pessimisme qui frappe les pays européens en ce qui concerne l’avenir de la construction européenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab32f3ad-a575-4281-8ae9-f618694cbf05",
                                "sense_id": "578f5433-fe6b-3c03-a72d-3249cbc0fe2f",
                                "text": "Un spectre hante l’Europe : celui de l’europessimisme."
                            },
                            {
                                "example_id": "b00dc3bc-1687-4b5b-9ede-f06af59ed7c6",
                                "sense_id": "578f5433-fe6b-3c03-a72d-3249cbc0fe2f",
                                "text": "Le début de la décennie 90 est marqué par un certain europessimisme."
                            }
                        ]
                    }
                ],
