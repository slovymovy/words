                "senses": [
                    {
                        "sense_id": "dc7ff37a-d501-36b0-9670-aec98a657c5f",
                        "entry_id": "7e70f384-c673-35c2-b6c2-aba2cc65a76d",
                        "glosses": [
                            "Donner un caractère propre à Noël à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8540744b-c790-4931-a6ec-0c61a43e8844",
                                "sense_id": "dc7ff37a-d501-36b0-9670-aec98a657c5f",
                                "text": "Tu as choisi de très bons ingrédients pour noëliser ce rôti de porc."
                            },
                            {
                                "example_id": "3d9e1ccb-4f3c-48e6-81b5-569d04c824f4",
                                "sense_id": "dc7ff37a-d501-36b0-9670-aec98a657c5f",
                                "text": "[…] nous avons pensé que ces blouses étaient le plus gai moyen de « noëliser » le pantalon ou la jupe en satin noir de l’an dernier."
                            },
                            {
                                "example_id": "07e8b104-4044-416f-b066-7ca61b1d4e12",
                                "sense_id": "dc7ff37a-d501-36b0-9670-aec98a657c5f",
                                "text": "Pour les autres, vous pourrez acheter une couronne les deux premiers dimanches de l’Avent à la sortie du culte. Histoire de « noëliser » votre maison !"
                            },
                            {
                                "example_id": "dcca1ffa-2a3e-4c3d-b095-465edb4a0e6c",
                                "sense_id": "dc7ff37a-d501-36b0-9670-aec98a657c5f",
                                "text": "Le but du jeu est de noëliser votre avatar, c’est à dire qu’il doit être aux couleurs de Noël ; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "44dbeb4a-85b2-3b9c-95a8-84a6baac5932",
                        "entry_id": "7e70f384-c673-35c2-b6c2-aba2cc65a76d",
                        "glosses": [
                            "Offrir un cadeau de Noël à."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7f05b554-66ed-4987-b796-be2c8a207d92",
                                "sense_id": "44dbeb4a-85b2-3b9c-95a8-84a6baac5932",
                                "text": "Je cherchais un ordi portable pour noëliser un proche."
                            }
                        ]
                    }
