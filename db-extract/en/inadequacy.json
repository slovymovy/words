                                            {
                                                "example_id": "3692d71a-c68a-4e91-b564-24ca8bbcbea9",
                                                "sense_id": "413dadb4-1af9-3cba-b468-97dc4b42dd19",
                                                "text": "ABN Amro laat weten dat het de eigen ontoereikendheid betreurt. De bank zegt inmiddels maatregelen te hebben genomen om dit in de toekomst te voorkomen."
                                            },
                                            {
                                                "example_id": "f4e9082d-3bea-4ce5-9562-3ebcc63b9f78",
                                                "sense_id": "413dadb4-1af9-3cba-b468-97dc4b42dd19",
                                                "text": "Alsof ik een glimp van iets moois had gezien maar er niet bij kon komen, en dat ik alleen mijn eigen ontoereikendheid daarvan de schuld kon geven"
                                            }
                                        ]
                                    }
                                ]
                            }
