                "senses": [
                    {
                        "sense_id": "d36b74f5-db8b-39cb-b1c5-48606c218d30",
                        "entry_id": "05ecca3d-be33-3882-9106-619715e94913",
                        "glosses": [
                            "Hauptstadt eines deutschen oder österreichischen Bundeslandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30158c9f-705a-4ec2-8fed-61023105e6b6",
                                "sense_id": "d36b74f5-db8b-39cb-b1c5-48606c218d30",
                                "text": "Linz ist die Landeshauptstadt von Oberösterreich."
                            },
                            {
                                "example_id": "13be63e1-7b79-4081-bf42-12bb79bb6796",
                                "sense_id": "d36b74f5-db8b-39cb-b1c5-48606c218d30",
                                "text": "„Potsdams Oberbürgermeister drohte die Abwahl per Bürgerentscheid, was kurz darauf auch geschah — ein bislang einmaliger Vorgang in einer deutschen Landeshauptstadt!“"
                            },
                            {
                                "example_id": "a1386a54-154f-4b10-97dd-7cf39f225cb5",
                                "sense_id": "d36b74f5-db8b-39cb-b1c5-48606c218d30",
                                "text": "„Im Februar 1959 eröffnete Karla Castrup ihr, dass ihr Mann weitere vier Jahre in Düsseldorf arbeiten würde und sie sich entschieden hätten, das Haus zu verkaufen und ihren Wohnsitz in die Landeshauptstadt zu verlegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8f17059e-af2d-39ca-8379-3009c0b36865",
                        "entry_id": "05ecca3d-be33-3882-9106-619715e94913",
                        "glosses": [
                            "Hauptstadt eines souveränen Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15cbc091-d855-4d42-b8f2-a9f7b6810676",
                                "sense_id": "8f17059e-af2d-39ca-8379-3009c0b36865",
                                "text": "„Dessen Landeshauptstadt wurde die 1784 gegründete Festung mit dem programmatischen Namen Wladikawkas (»Beherrsche den Kaukasus!«.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
