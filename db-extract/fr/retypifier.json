                "senses": [
                    {
                        "sense_id": "3e7029e0-b970-3540-9d5a-cd72ea8efd85",
                        "entry_id": "8c15b1fe-afb3-3526-a821-ebb52d79a7ac",
                        "glosses": [
                            "Reclassifier sous un nouveau type."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "617ed5bf-5062-4df4-a33d-6a0ee1ae8afb",
                                "sense_id": "3e7029e0-b970-3540-9d5a-cd72ea8efd85",
                                "text": "Espèce de Métrod invalide, qu'il conviendrait de retypifier."
                            },
                            {
                                "example_id": "d9f3d5fa-2ec4-49d9-9b4c-a65a719ee735",
                                "sense_id": "3e7029e0-b970-3540-9d5a-cd72ea8efd85",
                                "text": "Il a été retypifié l'an dernier, très facile à reconnaître à ses feuilles très peu découpées, coriaces, ses bractées fortement corniculées (sect. obovata) et sa pilosité sur les feuilles."
                            },
                            {
                                "example_id": "a2c8c823-c069-47eb-abe9-d45628e85aa7",
                                "sense_id": "3e7029e0-b970-3540-9d5a-cd72ea8efd85",
                                "text": "Le genre Phymatolithon, bien que retypifié récemment […], n’avait pu, jusqu’à présent, être caractérisé par sa reproduction sexuée."
                            }
                        ]
                    }
