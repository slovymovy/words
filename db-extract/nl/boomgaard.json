                    },
                    {
                        "translation_id": "3c29afbc-2279-4567-8d12-4be5406e4df6",
                        "source_entry_id": "eafcf07d-fab8-3baa-8082-0c180543ce44",
                        "source_sense_id": "4fccd347-fe2e-3efb-aea7-4b6c84edc4c3",
