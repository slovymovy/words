                    },
                    {
                        "translation_id": "e9a00609-7b6e-4d30-a538-4f60c42cb677",
                        "source_entry_id": "bf4065f2-e87b-30d4-9cbc-8ceaa77af3c0",
                        "source_sense_id": "8e6e5075-8b3c-36ec-aa97-02838f2c186e",
                        "source_sense_description": "Beverage from pears",
                        "target_lang_word": "poiré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poiré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                                        "entry_id": "a944874c-0fe5-3585-bf93-7f50b6f51066",
                                        "glosses": [
                                            "Boisson faite par fermentation alcoolique de jus de poires pressurées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbd8f3b3-4ec7-4ec4-a25f-5ac4df8a92d9",
                                                "sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                                                "text": "Alors il chercha l’oubli tour à tour dans le cidre normand, le poiré manceau, l’hydromel gaulois, le cognac français, le genièvre hollandais, le gin anglais, le wiskey écossais, le kirsch germain."
                                            },
                                            {
                                                "example_id": "e68d4265-1683-4051-99b1-8ce390a394da",
                                                "sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                                                "text": "D’une façon succincte, l’opinion des cidrologues de tous les temps, qu’ils soient médecins, savants ou praticiens, est qu’il existe une catégorie de poirés qui, soigneusement préparés avec des poires de choix, constituent une boisson très agréable et rivalisant avec les meilleurs cidres au point de vue des qualités intrinsèques."
                                            },
                                            {
                                                "example_id": "86525118-067f-45d5-adb6-4a4775c5bfc4",
                                                "sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                                                "text": "Aucune boisson alcoolisée autre que le vin, la bière, le cidre et le poiré n’est autorisée sur le lieu de travail."
                                            },
                                            {
                                                "example_id": "cee26251-626c-4126-8d9a-edbb00a5bba3",
                                                "sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                                                "text": "Nous avons beaucoup pressé de fruits cet hiver, dit Christel ; cela nous fait au moins dix mesures de cidre et vingt de poiré. C’est une boisson plus rafraîchissante que le vin, pendant les moissons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poiré",
                                "target_lang_code": "fr",
                                "target_senses": [
