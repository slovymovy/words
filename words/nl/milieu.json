                    "sense_id": "646e77b7-b9fa-39b4-b961-baf6d9e70984",
                    "sense_definition": "De natuurlijke leefomgeving op aarde, vooral met betrekking tot de kwaliteit van lucht, water en bodem.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten beter voor het <w>milieu</w> zorgen door minder afval te produceren.",
                            "target_lang_translations": {
                                "en": "We must take better care of the <w>environment</w> by producing less waste.",
                                "ru": "Мы должны лучше заботиться об <w>окружающей среде</w>, производя меньше отходов.",
                                "pl": "Musimy lepiej dbać o <w>środowisko</w>, produkując mniej odpadów.",
                                "de": "Wir müssen uns besser um die <w>Umwelt</w> kümmern, indem wir weniger Abfall produzieren.",
                                "fr": "Nous devons mieux prendre soin de l'<w>environnement</w> en produisant moins de déchets.",
                                "it": "Dobbiamo prenderci cura dell'<w>ambiente</w> in modo migliore producendo meno rifiuti.",
                                "cs": "Musíme se lépe starat o <w>životní prostředí</w> tím, že budeme produkovat méně odpadu.",
                                "tr": "Daha az atık üreterek <w>çevreye</w> daha iyi bakmalıyız.",
                                "es": "Debemos cuidar mejor el <w>medio ambiente</w> produciendo menos residuos."
                            }
                        },
                        {
                            "text": "De uitstoot van fabrieken is vaak slecht voor het <w>milieu</w>.",
                            "target_lang_translations": {
                                "en": "Factory emissions are often bad for the <w>environment</w>.",
                                "ru": "Выбросы заводов часто вредны для <w>окружающей среды</w>.",
                                "pl": "Emisje z fabryk są często szkodliwe dla <w>środowiska</w>.",
                                "de": "Die Emissionen von Fabriken sind oft schlecht für die <w>Umwelt</w>.",
                                "fr": "Les émissions des usines sont souvent nocives pour l'<w>environnement</w>.",
                                "it": "Le emissioni delle fabbriche sono spesso dannose per l'<w>ambiente</w>.",
                                "cs": "Emise z továren jsou často škodlivé pro <w>životní prostředí</w>.",
                                "tr": "Fabrika emisyonları genellikle <w>çevre</w> için zararlıdır.",
                                "es": "Las emisiones de las fábricas suelen ser malas para el <w>medio ambiente</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "leefomgeving",
                        "natuur"
                    ],
                    "common_phrases": [
                        "slecht voor het milieu",
                        "beter milieu",
                        "zorg voor het milieu",
                        "het milieu beschermen"
                    ],
                    "target_lang_definitions": {
                        "en": "The natural living environment on earth, especially regarding the quality of air, water, and soil.",
                        "ru": "Природная среда обитания на Земле, особенно в отношении качества воздуха, воды и почвы.",
                        "pl": "Naturalne środowisko życia na Ziemi, szczególnie w odniesieniu do jakości powietrza, wody i gleby.",
                        "de": "Die natürliche Lebensumwelt auf der Erde, insbesondere im Hinblick auf die Qualität von Luft, Wasser und Boden.",
                        "fr": "L'environnement naturel sur Terre, en particulier en ce qui concerne la qualité de l'air, de l'eau et du sol.",
                        "it": "L'ambiente naturale sulla terra, in particolare per quanto riguarda la qualità dell'aria, dell'acqua e del suolo.",
                        "cs": "Přírodní životní prostředí na Zemi, zejména s ohledem na kvalitu ovzduší, vody a půdy.",
                        "tr": "Dünya üzerindeki, özellikle hava, su ve toprak kalitesiyle ilgili olan doğal yaşam alanı.",
                        "es": "El entorno natural de la Tierra, especialmente en relación con la calidad del aire, el agua y el suelo."
