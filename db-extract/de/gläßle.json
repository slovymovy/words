                ],
                "senses": [
                    {
                        "sense_id": "f0e7d7c2-605a-3218-9f61-99da40dcb174",
                        "entry_id": "194dfa4e-d99a-365a-bd40-682fe8d2512b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8930b8c8-69e7-41f4-ac12-eb9fc7b2266f",
                                "sense_id": "f0e7d7c2-605a-3218-9f61-99da40dcb174",
                                "text": "Frau Gläßle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2afaef2e-89e2-4e40-9f3c-46f5820cbd3c",
                                "sense_id": "f0e7d7c2-605a-3218-9f61-99da40dcb174",
                                "text": "Herr Gläßle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9a368afb-a2e5-4474-ba01-6334941265e5",
                                "sense_id": "f0e7d7c2-605a-3218-9f61-99da40dcb174",
                                "text": "Die Gläßles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "91815556-b6f0-40a2-8467-4f717b15ebed",
                                "sense_id": "f0e7d7c2-605a-3218-9f61-99da40dcb174",
                                "text": "Der Gläßle trägt nie die Pullover, die die Gläßle ihm strickt."
                            },
                            {
                                "example_id": "0b3e09bb-3950-4039-ad9c-426d509b898e",
                                "sense_id": "f0e7d7c2-605a-3218-9f61-99da40dcb174",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gläßle kommt, geht der Herr Gläßle.“"
                            },
                            {
                                "example_id": "98320b34-b546-4514-a349-3c34fa06dc8b",
                                "sense_id": "f0e7d7c2-605a-3218-9f61-99da40dcb174",
                                "text": "Gläßle kommt und geht."
                            },
                            {
                                "example_id": "dc4eff67-a1e9-47f3-967e-54a7ab79479c",
                                "sense_id": "f0e7d7c2-605a-3218-9f61-99da40dcb174",
                                "text": "Gläßles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
