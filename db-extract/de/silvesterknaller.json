                        "entry_id": "0b5c061e-e31e-37d7-8a7d-515c0d0050a8",
                        "glosses": [
                            "Feuerwerkskörper, der zu Silvester abgebrannt wird und der ein lautes Geräusch verursacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a8f9fcc-1c94-4604-8d89-c2a9014b32fc",
                                "sense_id": "d244c80f-a45a-3568-8ce7-e87be407dfd0",
                                "text": "„Im ganzen Land fuhren Menschen mit ihren Autos hupend durch die Straßen und zündeten Silvesterknaller.“"
                            },
                            {
                                "example_id": "ca795da5-38d9-4b2e-8950-d27d82058711",
                                "sense_id": "d244c80f-a45a-3568-8ce7-e87be407dfd0",
                                "text": "„Silvesterknaller sollten möglichst nicht in der Nähe der Ohren explodieren, da sie diese dauerhaft schädigen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
