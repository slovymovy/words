                        "zh": [
                            {
                                "target_lang_word": "香葱土豆泥",
                                "target_lang_sense_clarification": "爱尔兰特色菜"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "champ",
                                "target_lang_sense_clarification": "plato tradicional irlandés"
                            },
                            {
                                "target_lang_word": "puré de patatas con cebolleta",
                                "target_lang_sense_clarification": "traducción descriptiva"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb7f3b06-73ee-3344-8251-cd0986f29a84",
                    "sense_definition": "The background field of a shield in heraldry or the ground on which a relief carving appears.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms featured a red lion rampant on a silver <w>champ</w>.",
                            "target_lang_translations": {
                                "ru": "На гербе был изображен красный лев, стоящий на задних лапах, на серебряном <w>поле</w>.",
                                "zh": "纹章上绘有一只红狮，立于银色的<w>底色</w>之上。",
                                "es": "El escudo de armas presentaba un león rojo rampante sobre un <w>campo</w> plateado."
                            }
                        },
                        {
                            "text": "The intricate carving stood out clearly against the smooth <w>champ</w>.",
                            "target_lang_translations": {
                                "ru": "Сложная резьба четко выделялась на гладком <w>фоне</w>.",
                                "zh": "精美的雕刻在平滑的<w>底色</w>衬托下显得格外清晰。",
                                "es": "La intrincada talla destacaba claramente sobre el <w>fondo</w> liso."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical or heraldic context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фон щита в геральдике или фон, на котором выполнен рельеф.",
                        "zh": "纹章学中盾牌的背景底色，或浮雕的背景。",
                        "es": "El campo de fondo de un escudo en heráldica o el fondo sobre el que aparece una talla en relieve."
                    },
                    "translations": {
