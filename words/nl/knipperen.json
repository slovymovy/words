{
    "word_family": [
        "knippering",
        "knipperlicht",
        "geknipper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1ad76c7-5e41-34a6-8ebd-e9b8574a605f",
                    "sense_definition": "het snel openen en sluiten van de oogleden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "oogbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het plotseling doorbrekende zonlicht deed de kinderen <w>knipperen</w> met de ogen.",
                            "target_lang_translations": {
                                "en": "The sudden breaking sunlight made the children <w>blink</w> their eyes."
                            }
                        },
                        {
                            "text": "Zij moest even met haar ogen <w>knipperen</w> om aan het felle licht te wennen.",
                            "target_lang_translations": {
                                "en": "She had to <w>blink</w> her eyes for a moment to get used to the bright light."
                            }
                        }
                    ],
                    "synonyms": [
                        "pinken",
                        "knipperogen"
                    ],
                    "common_phrases": [
                        "met de ogen knipperen"
                    ],
                    "target_lang_definitions": {
                        "en": "the rapid opening and closing of the eyelids"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blink",
                                "target_lang_sense_clarification": "to close and open the eyes quickly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0336c936-2d4c-312c-97cd-2334292f7025",
                    "sense_definition": "het snel en herhaaldelijk aan- en uitgaan van een lichtbron",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichtsignaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het rode lampje <w>knipperde</w> en hij kreeg een zinkend gevoel dat er iets mis was.",
                            "target_lang_translations": {
                                "en": "The red light <w>flashed</w> and he got a sinking feeling that something was wrong."
                            }
                        },
                        {
                            "text": "De auto voor ons liet zijn richtingaanwijzer voortdurend <w>knipperen</w>.",
                            "target_lang_translations": {
                                "en": "The car in front of us kept its turn signal <w>blinking</w> continuously."
                            }
                        }
                    ],
                    "synonyms": [
                        "flikkeren",
                        "pinken"
                    ],
                    "common_phrases": [
                        "knipperend licht"
                    ],
                    "target_lang_definitions": {
                        "en": "the rapid and repeated turning on and off of a light source"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flash",
                                "target_lang_sense_clarification": "to shine with a sudden light"
                            },
                            {
                                "target_lang_word": "blink",
                                "target_lang_sense_clarification": "to flash on and off at regular intervals"
                            },
                            {
                                "target_lang_word": "flicker",
                                "target_lang_sense_clarification": "to shine unsteadily"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}