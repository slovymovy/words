                                        "entry_id": "a7f05407-4f6f-3e1c-b2cb-5c3182fb34f8",
                                        "glosses": [
                                            "kdo páchá zlé skutky; kdo je zlý, ničemný"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdbcf408-ccbb-4bba-8b6d-03982c007f64",
                                                "sense_id": "2e4e417b-ae99-37e7-963a-0ca8c4cc6e1d",
                                                "text": "Šerif neváhal a po zlosynovi třikrát vystřelil."
                                            },
                                            {
                                                "example_id": "60f57054-854f-49e1-8cad-a4664d716c37",
                                                "sense_id": "2e4e417b-ae99-37e7-963a-0ca8c4cc6e1d",
                                                "text": "Milejší je mi zlosyn, který se přiznává, že zlosynem je, nežli světec, jenž si je vědom své svatosti."
                                            }
                                        ]
                                    }
                                ]
                            }
