                    {
                        "form_id": "fce67933-b267-40f1-9684-5b479aff5dba",
                        "entry_id": "adb20338-5552-3b37-89f0-d3b022f1bf0d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Außenwelt"
                    },
                    {
                        "form_id": "cf141c7f-e0dc-4500-8119-5e9b958b4273",
                        "entry_id": "adb20338-5552-3b37-89f0-d3b022f1bf0d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Außenwelten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc854727-5db6-3eb8-9bb0-777812fb5456",
                        "entry_id": "adb20338-5552-3b37-89f0-d3b022f1bf0d",
                        "glosses": [
                            "die Welt außerhalb der eigenen Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db01f14-9f41-4eff-8de6-858bf38e80e2",
                                "sense_id": "bc854727-5db6-3eb8-9bb0-777812fb5456",
                                "text": "„Das entscheidende Geschehen dieses Romans spielt sich nicht in der Außenwelt, sondern im Kopf des Erzählers ab.“"
                            },
                            {
                                "example_id": "9c560d19-d7e3-49cb-a4f2-fea65e937eaf",
                                "sense_id": "bc854727-5db6-3eb8-9bb0-777812fb5456",
                                "text": "Der Artikel „Augenblicke zur Außenwelt“ berichtet über eine Studentin, die sich nur mit Hilfe eines Computers mit anderen Personen verständigen kann."
                            },
                            {
                                "example_id": "7b4c1a50-11a7-4321-87e6-e7daf534f081",
                                "sense_id": "bc854727-5db6-3eb8-9bb0-777812fb5456",
                                "text": "Die Außenwelt nimmt ihn anders wahr, als er sich selbst."
                            },
                            {
                                "example_id": "f16862f1-a49a-4b5e-bfdc-36ba91e14503",
                                "sense_id": "bc854727-5db6-3eb8-9bb0-777812fb5456",
                                "text": "„Das Unbewußte findet in den Interpretationen des Agitators das Echo seiner eigenen primitiven Reaktionen auf die Außenwelt; der Zuhörer spielt die Rolle des kleinen Kindes, dem seine Verfolgung durch Gespenster angedroht wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eeb8ceb1-7cd3-3524-a51e-f6d782687455",
                        "entry_id": "adb20338-5552-3b37-89f0-d3b022f1bf0d",
                        "glosses": [
                            "die Welt außerhalb eines abgeschlossenen Bereichs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5146efae-4cf1-483e-9ebf-1645e484d1bf",
                                "sense_id": "eeb8ceb1-7cd3-3524-a51e-f6d782687455",
                                "text": "„Dort legten hohe Schneeverwehungen den Verkehr weitgehend lahm und schnitten Dutzende Dörfer von der Außenwelt ab.“"
                            },
                            {
                                "example_id": "84c5efe1-9446-4421-ab0a-a29990b7f724",
                                "sense_id": "eeb8ceb1-7cd3-3524-a51e-f6d782687455",
                                "text": "„Die Ferieninsel Hiddensee bleibt von der Außenwelt vorerst weiter abgeschnitten.“"
                            },
                            {
                                "example_id": "87896c96-aaee-4c4a-8e05-110ee00d1fd7",
                                "sense_id": "eeb8ceb1-7cd3-3524-a51e-f6d782687455",
                                "text": "„In den letzten Tagen hatte man mich erfolgreich von der Außenwelt abgeschirmt.“"
                            },
                            {
                                "example_id": "6bdb9f6d-5f88-47e5-be85-72cc822a3e0f",
                                "sense_id": "eeb8ceb1-7cd3-3524-a51e-f6d782687455",
                                "text": "„In seinem ersten Winter, als das Städtchen im Schnee versunken war und Ari sich beinahe von der Dunkelheit und der Einsamkeit hatte unterkriegen lassen, war die einzige Landverbindung des Fjordes zur Außenwelt der Tunnel Strákagöng gewesen, der bei starkem Schneefall regelmäßig gesperrt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc6a3180-881d-402b-86b6-83081d3fe0bc",
                        "source_entry_id": "adb20338-5552-3b37-89f0-d3b022f1bf0d",
                        "source_sense_id": "bc854727-5db6-3eb8-9bb0-777812fb5456",
                        "source_sense_description": "die Welt außerhalb der eigenen Person",
                        "target_lang_word": "outside world",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outside world",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31b90190-6e33-3d06-aa3f-1643a38b67e7",
                                        "entry_id": "aa0bac58-7776-30ed-93db-aa3c09388b05",
                                        "glosses": [
                                            "The rest of the world outside of some closed, restricted, or remote environment."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd1555f6-8a7d-4bcd-9d0a-acbe403ddf3f",
                                                "sense_id": "31b90190-6e33-3d06-aa3f-1643a38b67e7",
                                                "text": "The people of Tibet represent a separate case. Conquered by the Chinese in 1950, occupied brutally by troops who killed thousands, desecrated local cultural and religious sites, and denied reasonable demands for autonomy, Tibetans have elicited much sympathy but little support from the outside world."
                                            }
                                        ]
                                    },
                                    {
