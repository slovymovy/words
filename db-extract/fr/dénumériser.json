                ],
                "senses": [
                    {
                        "sense_id": "4e2a59e0-a2d4-37bc-8ff4-1e3afff71656",
                        "entry_id": "5555b38c-023b-3a7b-be11-ba8275b78b20",
                        "glosses": [
                            "Faire perdre son caractère numérique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34b59eda-78e3-4b4f-b0d3-8518377b6d3f",
                                "sense_id": "4e2a59e0-a2d4-37bc-8ff4-1e3afff71656",
                                "text": "Moi à l’isolement, et eux tous, ici et en bas, tétanisés, sans voix, dénumérisés, dédigitalisés comme ils disent."
                            },
                            {
                                "example_id": "1b8392b7-3dfb-4a9c-a7df-2eae55db6945",
                                "sense_id": "4e2a59e0-a2d4-37bc-8ff4-1e3afff71656",
                                "text": "Dans la première la disposition romanesque installe une structure symétrique qui met en valeur un ou plusieurs éléments 'centraux' ; c’est sur ce mode qu’opèrent les constructions de Defoe et Fielding (lesquelles, comme le montre Brooks, tendent à se simplifier, à se dénumériser, de Robinson Crusoë à Roxana, et de Joseph Andrews à Amelia) puis, plus tard dans le siècle, celles de Smollett (qui au contraire se complexifient, de Roderick Random à Humphry Clincker)."
                            }
                        ]
                    }
