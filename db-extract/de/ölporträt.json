                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c69f5d3-4187-41d0-b3cd-f01d992553cf",
                                "sense_id": "c567aa3a-d2d3-3940-8fa4-ed68c6ae882f",
                                "text": "„Nach einigen weiteren vorsichtigen Versuchen mit einem dünnen Messer wusste er, dass er auf ein Ölporträt von beträchtlichen Ausmaßen gestoßen war.“"
                            },
                            {
                                "example_id": "b7914f90-eff1-45fb-b043-39e4aab348f2",
                                "sense_id": "c567aa3a-d2d3-3940-8fa4-ed68c6ae882f",
                                "text": "„Am Ende der Reihe hing ein großes Ölporträt von Muhammad Ali Jinnah, dem Gründer Pakistans, auf dem er einen adretten Savile-Row-Anzug trug und in einem Dokument las.“"
                            },
                            {
                                "example_id": "8edab97d-af84-4ebe-ac24-2b87573dee13",
                                "sense_id": "c567aa3a-d2d3-3940-8fa4-ed68c6ae882f",
                                "text": "„Durch die Tür hindurch blickte ein vierzig Jahre altes Ölporträt von Richard Helms mit klarer, skeptischer Miene auf sie herab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
