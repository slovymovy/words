                ],
                "senses": [
                    {
                        "sense_id": "2c80cdd8-006b-3a1b-bd14-e7450c858475",
                        "entry_id": "db8466a2-d676-3e35-9e53-d1d9051d57ed",
                        "glosses": [
                            "A (Japanese) hot spring."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56162506-3467-4071-ba61-159319f59efb",
                                "sense_id": "2c80cdd8-006b-3a1b-bd14-e7450c858475",
                                "text": "The hottest springs in Japan aren't in the north but at the Obama Onsen outside Nagasaki."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b1c4e3b-d961-3215-8b0b-4e02af2899ab",
                        "entry_id": "db8466a2-d676-3e35-9e53-d1d9051d57ed",
                        "glosses": [
                            "A Japanese-style resort hotel at a natural hot spring, offering on-site bathing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d0e1fa3-61f2-49e6-b2fb-3a088736f398",
                                "sense_id": "7b1c4e3b-d961-3215-8b0b-4e02af2899ab",
                                "text": "We stayed at a traditional onsen with tatami, yukata, and kaiseki at Onyang outside Seoul."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "428e8e7d-80b0-4609-aef8-5b1269417a3f",
                        "source_entry_id": "db8466a2-d676-3e35-9e53-d1d9051d57ed",
                        "source_sense_description": "a Japanese hot spring; a Japanese-style resort hotel at a hot spring",
                        "target_lang_word": "onsen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onsen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95001435-4b06-378e-9863-26049cc0625e",
                                        "entry_id": "90fbb48c-8285-3bc3-b6e5-9fe2b24bd7aa",
                                        "glosses": [
                                            "Bain thermal public japonais, destiné à la détente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe9302f3-9a46-4fb8-8976-adf18b09db1a",
                                                "sense_id": "95001435-4b06-378e-9863-26049cc0625e",
                                                "text": "Récemment, il avait parlé de l’emmener dans un merveilleux onsen à Kyoto, mais elle s’était défilée, prétextant les repas de son frère à préparer."
                                            },
                                            {
                                                "example_id": "9b028ec9-6db6-4fe3-aaf5-acbb46aa723e",
                                                "sense_id": "95001435-4b06-378e-9863-26049cc0625e",
                                                "text": "À cette heure-là, l’onsen n’était fréquenté que par des mères de famille et leurs très jeunes enfants."
                                            },
                                            {
                                                "example_id": "5e411cf9-021d-4410-b2fb-52a891c654ae",
                                                "sense_id": "95001435-4b06-378e-9863-26049cc0625e",
                                                "text": "Fukushima, la porte du Tohoku, à 240 km de Tokyo, désignait jusque-là une ville agréable au cœur de la paisible préfecture éponyme, appréciée des amateurs de retour à la nature pour ses nombreux lacs et onsen en plein air, où l’on tombait parfois nez à nez avec les singes des montagnes avoisinantes."
                                            },
                                            {
                                                "example_id": "752d9283-6138-4343-b9f8-672fce17a612",
                                                "sense_id": "95001435-4b06-378e-9863-26049cc0625e",
                                                "text": "Des sources thermales, les onsen, jaillissent d’un bout à l'autre du pays, qui en compte plus de 3000, dépassant de loin le nombre de sources chaudes d’Islande."
                                            },
                                            {
                                                "example_id": "8c69d78b-e62c-4d97-9350-191793423da1",
                                                "sense_id": "95001435-4b06-378e-9863-26049cc0625e",
                                                "text": "De même que dans les sentos, on retrouve voisins et amis du quartier, les onsens ont donc une dimension sociale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
