                "senses": [
                    {
                        "sense_id": "b97481d1-3fa2-315f-9ceb-58b91d8ca77e",
                        "entry_id": "bac3a321-012e-301c-9848-0727e0f047aa",
                        "glosses": [
                            "религ. в православной и католической традиции — совершать у постели тяжелобольного или умирающего обряд с чтением молитв и помазанием тела елеем"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dc28f49-2006-4af7-8616-3644defff8b3",
                        "source_entry_id": "bac3a321-012e-301c-9848-0727e0f047aa",
                        "source_sense_id": "b97481d1-3fa2-315f-9ceb-58b91d8ca77e",
                        "target_lang_word": "anoint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anoint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9711926d-e81c-3b1f-98bf-a4f794f2a188",
                                        "entry_id": "4da17dcc-1e92-33d2-a056-8eb50b66c27b",
                                        "glosses": [
                                            "To smear or rub over with oil or an unctuous substance; also, to spread over, as oil."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a9827df-367e-4fdc-8016-8ca2f548b723",
                                                "sense_id": "9711926d-e81c-3b1f-98bf-a4f794f2a188",
                                                "text": "He anointed the eyes of the blind man with the clay."
                                            },
                                            {
                                                "example_id": "8d2bd9bd-1626-4b20-b7c1-82e6c26fedfc",
                                                "sense_id": "9711926d-e81c-3b1f-98bf-a4f794f2a188",
                                                "text": "And Fragrant Oils the ſtiffen'd Limbs anoint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c600a1fd-35c5-3d8b-88fb-3f4666e295bd",
                                        "entry_id": "4da17dcc-1e92-33d2-a056-8eb50b66c27b",
                                        "glosses": [
                                            "To apply oil to or to pour oil upon, etc., as a sacred rite, especially for consecration."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5cb516f-2c1b-4929-8d20-c4a3c5ca0a68",
                                                "sense_id": "c600a1fd-35c5-3d8b-88fb-3f4666e295bd",
                                                "text": "Then shalt thou take the anointing oil, and pour it upon his [Aaron's] head and anoint him."
                                            },
                                            {
                                                "example_id": "f8d80c3b-4c1d-4169-baca-a1a8584c9e19",
                                                "sense_id": "c600a1fd-35c5-3d8b-88fb-3f4666e295bd",
                                                "text": "Anoint Hazael to be king over Syria."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef86e77-491c-3265-9a31-c242980d679f",
                                        "entry_id": "4da17dcc-1e92-33d2-a056-8eb50b66c27b",
                                        "glosses": [
                                            "To choose or nominate somebody for a leading or otherwise important position, especially formally or officially, or as an intended successor."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1bd475a-52d6-44ad-b2db-fca91376cb8c",
                                                "sense_id": "4ef86e77-491c-3265-9a31-c242980d679f",
                                                "text": "Unlike other previous Prelates, who were swiftly anointed bishops, Francis did not follow suit. Ocáriz remained a Monsignor. In the eyes of many observers, it was a demotion of Opus Dei."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a6f03b2-d11d-3ebc-b684-7eb0fe639456",
                                        "entry_id": "4da17dcc-1e92-33d2-a056-8eb50b66c27b",
                                        "glosses": [
                                            "To mark somebody as an official ruler, especially a king or queen, as a part of a religious ceremony."
                                        ],
                                        "tags": [
                                            "historical",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
