                "senses": [
                    {
                        "sense_id": "f8034086-0876-33bc-8208-a61607fc776a",
                        "entry_id": "d621850e-af72-3044-b934-a413c0a600b6",
                        "glosses": [
                            "Qui est sans religion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "567e8678-a05f-442b-a68a-eca67014c85d",
                                "sense_id": "f8034086-0876-33bc-8208-a61607fc776a",
                                "text": "Je ne croyais plus depuis longtemps. Mais je ne suis pas antireligieux, non, je suis areligieux."
                            },
                            {
                                "example_id": "6f8b3c32-28c9-4525-b939-64f672672da1",
                                "sense_id": "f8034086-0876-33bc-8208-a61607fc776a",
                                "text": "Même si sa recherche a porté d’abord sur des aspects solidement « incarnés » de la culture indienne, il n’a pas voulu opposer une Inde positiviste, ou rationaliste, voire areligieuse et cynique, à l’Inde mystique que l’on propose trop souvent à l’Occident."
                            },
                            {
                                "example_id": "6d2d44cd-f9ca-47d2-9554-509f3b744aa8",
                                "sense_id": "f8034086-0876-33bc-8208-a61607fc776a",
                                "text": "Tous les poètes dans le monde arabo-musulman ont été areligieux, comme je le suis, ne serait-ce que parce que le Coran attaque les poètes encore plus durement que ne les attaquait Platon."
                            }
                        ]
                    }
                ],
