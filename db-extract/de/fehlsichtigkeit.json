                "senses": [
                    {
                        "sense_id": "0d5f41d9-ddd0-3cdc-b9df-b8ddb701e754",
                        "entry_id": "35386e3b-1fde-39d3-954a-57a2c96e187a",
                        "glosses": [
                            "Beeinträchtigung der Sehleistung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d57d12a7-7581-414f-abc3-46ffa90a224d",
                                "sense_id": "0d5f41d9-ddd0-3cdc-b9df-b8ddb701e754",
                                "text": "„Bei Fehlsichtigkeiten ist die Linse nicht in der Lage, die Strahlen im Brennpunkt auf der Netzhaut zu bündeln.“"
                            },
                            {
                                "example_id": "588ab72c-6a9d-4762-8ccb-ed93515556bb",
                                "sense_id": "0d5f41d9-ddd0-3cdc-b9df-b8ddb701e754",
                                "text": "„Im Gegensatz hierzu ist eine Kurzoder Weitsichtigkeit, also eine Fehlsichtigkeit, die durch die Augen bedingt ist, eine statische Sehbeeinträchtigung.“"
                            },
                            {
                                "example_id": "2faf3a66-211d-4d6b-96d4-c3414c4a9215",
                                "sense_id": "0d5f41d9-ddd0-3cdc-b9df-b8ddb701e754",
                                "text": "„Er hatte mit uns Sehtests durchgeführt und stieß anscheinend bei meinem Bruder auf eine Fehlsichtigkeit.“"
                            },
                            {
                                "example_id": "efd96c22-1f23-4639-a4b7-1812b04136f1",
                                "sense_id": "0d5f41d9-ddd0-3cdc-b9df-b8ddb701e754",
                                "text": "„Über 700 Millionen Menschen auf der Welt leiden unter einer Fehlsichtigkeit, die mit einer einfachen Sehhilfe behoben werden könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
