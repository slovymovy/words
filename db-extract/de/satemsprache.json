                "senses": [
                    {
                        "sense_id": "368c2ea4-aa62-31bf-88ab-95a7f769eae2",
                        "entry_id": "76d2354f-38a4-35d5-b69a-cbdd3566e410",
                        "glosses": [
                            "inzwischen als überholt geltende Bezeichnung für eine Reihe östlicher indogermanischer Sprachen nach dem Anlaut im altiranischen Wort satem für 100 (hundert), bei dem der für das Urindogermanische erschlossene Verschlusslaut durch ein s ersetzt worden ist, während bei Kentumsprachen ein k erhalten blieb."
                        ],
                        "tags": [
                            "speziell Indogermanistik"
                        ],
                        "examples": [
                            {
                                "example_id": "b24cfc58-bf6d-4b33-aaae-a2ee3a85681f",
                                "sense_id": "368c2ea4-aa62-31bf-88ab-95a7f769eae2",
                                "text": "„Die früher weit verbreitete Scheidung in eine westliche und eine östliche Gruppe, die auf der unterschiedlichen Vertretung ursprünglicher Velarkonsonanten beruht und sich nach dem Wort für ›100‹, lateinisch ‚centum‘ und altiranisch (avestisch) ‚satəm‘, in der Dichotomie von »Kentumsprachen« und Satemsprachen niedergeschlagen hat, kann heute mangels sonstiger tragfähiger Übereinstimmungen keine Gültigkeit mehr beanspruchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
