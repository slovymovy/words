                    {
                        "translation_id": "1cae3d04-cb5b-4f91-9d0d-bef0649a88c2",
                        "source_entry_id": "ec4c6a1d-0b93-3d71-ab80-ad15f07b8097",
                        "source_sense_description": "the wood from any dicotyledonous tree",
