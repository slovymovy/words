                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Следствие <необходимо> вытекает из причины.",
                            "target_lang_translations": {
                                "en": "The consequence <necessarily> follows from the cause.",
                                "zh": "结果<w>必然</w>由原因引起。",
                                "nl": "Het gevolg vloeit <w>noodzakelijkerwijs</w> voort uit de oorzaak.",
                                "pl": "Skutek <w>koniecznie</w> wynika z przyczyny.",
                                "de": "Die Folge ergibt sich <w>notwendigerweise</w> aus der Ursache.",
                                "fr": "La conséquence découle <w>nécessairement</w> de la cause.",
                                "it": "La conseguenza deriva <w>necessariamente</w> dalla causa.",
                                "cs": "Důsledek <w>nutně</w> vyplývá z příčiny.",
                                "tr": "Sonuç, nedenden <w>kaçınılmaz olarak</w> doğar.",
                                "es": "La consecuencia se deriva <w>necesariamente</w> de la causa."
                            }
