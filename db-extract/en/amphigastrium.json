                        "glosses": [
                            "A small scale-like leaf on the underside of stems of certain liverworts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76f7b8c9-3a08-4af3-90e2-73d3691b98db",
                                "sense_id": "333da92f-40e8-3adb-bfc3-9a2e8648fc29",
                                "text": "CHILOSCYPHUS. — Plant ; portion of the stem, with involucral leaves, perianth, and calyptra ; […] portion of the stem, with a leaf and an amphigastrium"
                            },
                            {
                                "example_id": "f880cc48-26d6-4eae-a702-da77dca1cb57",
                                "sense_id": "333da92f-40e8-3adb-bfc3-9a2e8648fc29",
                                "text": "Stems more or less regularly pinnate, more rarely dichotomously branched. Leaves incubous, conduplicate, the hinder lobe smallest—saccate, galeate, cucullate or flattish. Amphigastria mostly present, rarely wanting."
                            },
                            {
                                "example_id": "7e903476-e379-4d1d-903c-a994cd5d0363",
                                "sense_id": "333da92f-40e8-3adb-bfc3-9a2e8648fc29",
                                "text": "Key to the South African species of Lejeunea.\n[…]\nd. Base of the amphigastrium with rounded appendages below the insertion, the sinus of which thus is more than semicircular. L. isomorpha."
                            }
                        ]
                    }
