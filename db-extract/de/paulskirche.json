                "senses": [
                    {
                        "sense_id": "082d5b8a-8ab6-3b09-ae29-c29b869cb800",
                        "entry_id": "d58ef862-9855-33bd-b85c-8f6ddb14b52b",
                        "glosses": [
                            "meistens dem heiligen Paulus ^(→ WP) geweihtes Gotteshaus, das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d319ec1-abbe-45c2-afce-ce346e1bdc3d",
                                "sense_id": "082d5b8a-8ab6-3b09-ae29-c29b869cb800",
                                "text": "„Anfang des 14. Jahrhunderts wurde in Mellenthin eine Kapelle als Filial der Usedomer Paulskirche errichtet.“"
                            },
                            {
                                "example_id": "4bc5e2da-6ed5-4d5e-9b41-96902b3d6a42",
                                "sense_id": "082d5b8a-8ab6-3b09-ae29-c29b869cb800",
                                "text": "„Neben diesen Kirchen, die dem Apostel Paulus geweiht sind, gibt es in folgenden Städten Paulskirchen: Bielefeld, Darmstadt, Dessau […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f8ac179b-93ca-3823-80ae-9c98fcd4160f",
                        "entry_id": "d58ef862-9855-33bd-b85c-8f6ddb14b52b",
                        "glosses": [
                            "Kirche in Frankfurt am Main, in der infolge der Märzrevolution 1848 das erste gesamtdeutsche Parlament, die (Frankfurter) Nationalversammlung, tagte"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "d44c6ba9-6ba6-46be-86fe-25263f614c02",
                                "sense_id": "f8ac179b-93ca-3823-80ae-9c98fcd4160f",
                                "text": "„Das Aids-Memorial wurde in räumlicher Nähe zum Frankfurter Engel, dem Mahnmal, das den Opfern der Homosexuellen-Verfolgung gewidmet ist, und auch in zeitlicher Nähe zu dem Engel im Dezember 1994 errichtet und in einer Feierstunde in der Paulskirche der Öffentlichkeit übergeben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
