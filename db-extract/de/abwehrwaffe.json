                "senses": [
                    {
                        "sense_id": "29be9a87-1991-3a13-a955-6332a4661d8a",
                        "entry_id": "08ade44b-e06b-3621-b3ed-33a79381f6cc",
                        "glosses": [
                            "Objekt, das einen Angriff abwehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fb1b674-075a-49a9-a800-57cd8557d878",
                                "sense_id": "29be9a87-1991-3a13-a955-6332a4661d8a",
                                "text": "„Weichtiere haben ihre harte Schale vielleicht gar nicht als Panzer gegen große Feinde, sondern als Abwehrwaffe gegen winzige Würmer entwickelt.“"
                            },
                            {
                                "example_id": "96cc979c-8c23-4ac5-8039-1df5cb666fcd",
                                "sense_id": "29be9a87-1991-3a13-a955-6332a4661d8a",
                                "text": "„Fettzellen reagieren auf Angreifer und bilden eigene molekulare Abwehrwaffen.“"
                            },
                            {
                                "example_id": "df100b72-ea21-4d64-8e2e-7a91f87b1409",
                                "sense_id": "29be9a87-1991-3a13-a955-6332a4661d8a",
                                "text": "„Die Amerikaner haben nach fünfjähriger Entwicklungszeit eine neue Abwehrwaffe konstruiert, die nach Ansicht von US-Experten mit hoher Wahrscheinlichkeit das Ende des Panzers als beherrschende Kriegsmaschine im Bodenkampf bedeutet.“"
                            },
                            {
                                "example_id": "7a3fd2eb-a13f-48f1-a984-848ca20efd08",
                                "sense_id": "29be9a87-1991-3a13-a955-6332a4661d8a",
                                "text": "„Schon die Lieferung von Abwehrwaffen in ein Kriegsgebiet kam für die Bundesregierung einer Zeitenwende gleich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
