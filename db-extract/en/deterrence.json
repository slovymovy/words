                    {
                        "sense_id": "d671048d-4ef7-384b-b93d-484cfe05febf",
                        "entry_id": "44e94377-e943-3489-9fbf-6caf980bdfeb",
                        "glosses": [
                            "Dissuasion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec81537-ef5e-4c05-b01d-6843640d1c22",
                                "sense_id": "d671048d-4ef7-384b-b93d-484cfe05febf",
                                "text": "Deterrence, often contrasted with retributivism, holds that punishment is a necessary consequence of a crime and should be calculated based on the gravity of the wrong done"
                            }
                        ]
                    },
                    {
                        "sense_id": "e81ebee5-de4a-34ea-a52d-b9a5d23da924",
                        "entry_id": "44e94377-e943-3489-9fbf-6caf980bdfeb",
                        "glosses": [
                            "Dissuasion militaire."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "9637e315-404c-4eb4-8365-ed74eb5e6d8b",
                                "sense_id": "e81ebee5-de4a-34ea-a52d-b9a5d23da924",
                                "text": "United States policy of deterrence during the Cold War was characterized by ideology of containment, an aggressive stance regarding developing nations under their sphere of influence."
                            }
                        ]
                    }
