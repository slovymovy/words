                    },
                    {
                        "translation_id": "01a30ae0-7cb8-43aa-a7e1-a9a52e824f75",
                        "source_entry_id": "b1e58994-c890-33a1-bd6e-e51b7af69c34",
                        "source_sense_description": "разгульное, разнузданное пиршество",
                        "target_lang_word": "orgy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ba36fb2-5e9d-3d25-ba2b-4c76cab15315",
                                        "entry_id": "6ab3d82c-34bf-3799-b737-0e65ca360f3b",
                                        "glosses": [
                                            "A secret rite or ceremony, typically involving riotous and dissolute behavior, including dancing, drunkenness and indiscriminate sexual activity, undertaken in honor of various pagan gods or goddesses (such as Attis, Bacchus, Ceres, Dionysus, Osiris, etc)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9628806b-3f24-49d0-85f3-6acf279df119",
                                                "sense_id": "2ba36fb2-5e9d-3d25-ba2b-4c76cab15315",
                                                "text": "Human sacrifices of a definitely black magical order took place at the tomb of Osiris, while similar orgies with human victims were performed at Heliopolis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79ca2bbf-f112-388b-ab8b-cc6b2d567dd3",
                                        "entry_id": "6ab3d82c-34bf-3799-b737-0e65ca360f3b",
                                        "glosses": [
                                            "A gathering of people to engage in group sex."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3da6455f-e487-3392-a62a-4e42093b8291",
                                        "entry_id": "6ab3d82c-34bf-3799-b737-0e65ca360f3b",
                                        "glosses": [
                                            "An instance or period of excessive indulgence in a specified activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6499e3c0-e320-491c-a795-702ce2777c2d",
                                                "sense_id": "3da6455f-e487-3392-a62a-4e42093b8291",
                                                "text": "Gorea 07: 'OUR DEFENSES WERE USELESS AGAINST GOREA AS IT SWEPT THROUGH OUR EMPIRE IN AN ORGY OF ANNIHILATION.'"
                                            },
                                            {
                                                "example_id": "99ca7ec0-4461-45ce-9612-ab05049fe538",
                                                "sense_id": "3da6455f-e487-3392-a62a-4e42093b8291",
                                                "text": "It's an orgy of perfectly choreographed cartoon uber violence and is the game the Devil May Cry series always promised but never delivered."
                                            },
                                            {
                                                "example_id": "c0975d6d-b6c9-4bfd-aad8-1767fc0a3b5f",
                                                "sense_id": "3da6455f-e487-3392-a62a-4e42093b8291",
                                                "text": "The wails of the injured and the roars of the dead-on-the-march overwhelmed the tinny speakers in the cell, and they all watched as nearly one thousand people reduced themselves to a few frantic hundred in less than an hour, then settled into a sustained orgy of battery, rapine and rape with no end in sight but the total depopulation of the entire facility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
