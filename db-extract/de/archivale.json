                "senses": [
                    {
                        "sense_id": "561e1f67-e7c0-3f8b-8d8b-1e9f1f786987",
                        "entry_id": "12604289-cd39-3993-a3ab-cd01fe880ec3",
                        "glosses": [
                            "ein in einem Archiv aufbewahrtes Dokument, ein einzelnes Informationsstück aus der Menge des Archivguts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c257a0e-47ee-473b-b27a-c0c7cff7e4a9",
                                "sense_id": "561e1f67-e7c0-3f8b-8d8b-1e9f1f786987",
                                "text": "Jedes Archivale ist ein Unikat."
                            },
                            {
                                "example_id": "f11d53a3-a211-4754-a0d2-ff2436af69c8",
                                "sense_id": "561e1f67-e7c0-3f8b-8d8b-1e9f1f786987",
                                "text": "„Erst zweieinhalb Jahre nach dem Einsturz des Kölner Stadtarchivs ist die Bergung der verschütteten Archivalien abgeschlossen worden.“"
                            },
                            {
                                "example_id": "098cf906-0dbd-4d21-8ae5-6323fa79ec13",
                                "sense_id": "561e1f67-e7c0-3f8b-8d8b-1e9f1f786987",
                                "text": "„Ziel der Deutschen Digitalen Bibliothek (DDB) ist es, jedem über das Internet freien Zugang zum kulturellen und wissenschaftlichen Erbe Deutschlands zu eröffnen, also zu Millionen von Büchern, Archivalien, Bildern, Skulpturen, Musikstücken und anderen Tondokumenten, Filmen und Noten.“"
                            },
                            {
                                "example_id": "bcca1a87-9a0c-4251-8aef-b44ff4fd89c7",
                                "sense_id": "561e1f67-e7c0-3f8b-8d8b-1e9f1f786987",
                                "text": "„Und schließlich sind in Datenbanken verankerte Texte nicht Teil eines Kommunikationsprozesses, sondern so etwas wie leblose Archivalien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
