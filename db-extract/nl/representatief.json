                "senses": [
                    {
                        "sense_id": "fd281b64-f61e-31bb-a1dc-194cf382421a",
                        "entry_id": "9869393c-5927-3bcd-a915-1b96520f0c50",
                        "glosses": [
                            "met bepaalde kenmerken een groep of geheel vertegenwoordigend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e22b29f-4caf-4a22-95c7-b9922f7b5463",
                                "sense_id": "fd281b64-f61e-31bb-a1dc-194cf382421a",
                                "text": "Dat vonden we toch wel een representatieve steekproef."
                            }
                        ]
                    },
                    {
                        "sense_id": "5df53ced-c304-3a9e-9ee3-37213bf9fc42",
                        "entry_id": "9869393c-5927-3bcd-a915-1b96520f0c50",
                        "glosses": [
                            "een goede indruk makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c6fe301-87df-4e79-a854-a6466c6bfab7",
                                "sense_id": "5df53ced-c304-3a9e-9ee3-37213bf9fc42",
                                "text": "Hij had een representatief uiterlijk."
                            },
                            {
                                "example_id": "63013a8f-7e9c-480d-adae-1396fddbeb5a",
                                "sense_id": "5df53ced-c304-3a9e-9ee3-37213bf9fc42",
                                "text": "Het was onduidelijker wat ze bedoelde met er representatief uitzien. Waarschijnlijk waren het gewoon ingewikkelde woorden voor heel mooi zijn."
                            }
                        ]
                    }
