    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "59fce078-0c03-3b59-a4c1-46e41132a187",
                "word": "yabby",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c585d0a9-c4cf-4fa2-8c99-fd54f487a6a8",
                        "entry_id": "59fce078-0c03-3b59-a4c1-46e41132a187",
                        "tags": [
                            "plural"
                        ],
                        "form": "yabbies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "959f2529-1069-3ffe-b6af-7ee598230696",
                        "entry_id": "59fce078-0c03-3b59-a4c1-46e41132a187",
                        "glosses": [
                            "Any of various freshwater crayfish, typically of the genus Cherax, valued as food, especially Cherax destructor of southeastern Australia."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "5bbaa1ce-dae1-499c-bb1a-e2bb662080c0",
                                "sense_id": "959f2529-1069-3ffe-b6af-7ee598230696",
                                "text": "Having arrived at night I can speak with some authority on the desolate feeling the road produces: the white fire-scarred trunks, the unsettling vision of yabbies moving from one side of the road to the other."
                            },
                            {
                                "example_id": "d99a4dc6-bdba-44ad-bfd6-8267a9199854",
                                "sense_id": "959f2529-1069-3ffe-b6af-7ee598230696",
                                "text": "Wiradjuri people in New South Wales also built large dams, and then carried fish and yabbies in coolamons over large distances to stock the new waterholes."
                            }
                        ]
                    },
                    {
                        "sense_id": "dced1008-0f57-3264-81e0-7837ada3ed68",
                        "entry_id": "59fce078-0c03-3b59-a4c1-46e41132a187",
                        "glosses": [
                            "A species of marine ghost shrimp, Trypaea australiensis, widely harvested by recreational anglers as bait; a nipper."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "60f35c1b-7367-47ad-a288-8395aa681df0",
                                "sense_id": "dced1008-0f57-3264-81e0-7837ada3ed68",
                                "text": "Callianassa australiensis is known in southern New South Wales as the \"ghost-nipper\" (Dakin, Bennett and Pope, 1952), and in northern New South Wales and Queensland as the \"yabby\" (a word of aboriginal origin also applied to freshwater crayfish)."
                            },
                            {
                                "example_id": "6c4ef28e-9f9b-45b1-98a0-f12def457a53",
                                "sense_id": "dced1008-0f57-3264-81e0-7837ada3ed68",
                                "text": "Putting the yabby on a hook takes a little care and hook sizes need to match the physical dimensions of the yabby."
                            },
                            {
                                "example_id": "4903af30-79f1-41db-94db-e0bf0fd48d59",
                                "sense_id": "dced1008-0f57-3264-81e0-7837ada3ed68",
                                "text": "Now she held the net in front of the pump so Penny could empty its contents. The first suck was mud, the second sometimes yielded a couple of yabbies but on the third, three or four yabbies nearly always spurted out, flicking their tails, weakly opening and closing their nippers."
                            }
                        ]
                    }
                ],
