                "senses": [
                    {
                        "sense_id": "27d5e6f2-2baf-300f-b7ba-00e02ae686e1",
                        "entry_id": "ced4ea16-28a8-3e38-9272-f0fb58029fa5",
                        "glosses": [
                            "wenig Plastik/Kunststoff enthaltend, aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18590b33-27e6-43ec-8b76-e92da86d9388",
                                "sense_id": "27d5e6f2-2baf-300f-b7ba-00e02ae686e1",
                                "text": "„Dabei sollte man sich jedoch nicht ansehen, wie tugendhaft die Menschen sind, wie sehr sie sich anstrengen, klimaneutral und plastikarm zu leben.“"
                            },
                            {
                                "example_id": "a317bf13-0d4d-4742-b768-3a5b626ae4ba",
                                "sense_id": "27d5e6f2-2baf-300f-b7ba-00e02ae686e1",
                                "text": "„Eine plastikarme Umgebung ist für Kinder und ihre Entwicklung besonders wichtig.“"
                            }
                        ],
