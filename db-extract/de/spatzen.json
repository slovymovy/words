                ],
                "senses": [
                    {
                        "sense_id": "9afe3e9d-c6b5-3f16-adb5-ca76e6e7d069",
                        "entry_id": "85fb3bba-5eca-3eff-a581-6768310ecc85",
                        "glosses": [
                            "(als Beilage oder Hauptspeise) in Wasser durch Kochen zubereitete kleine ovale oder längliche Teigstücke"
                        ],
                        "tags": [
                            "Austrian German",
                            "South German"
                        ],
                        "examples": [
                            {
                                "example_id": "f16c6a54-11dd-40e3-90e9-21894f890cc6",
                                "sense_id": "9afe3e9d-c6b5-3f16-adb5-ca76e6e7d069",
                                "text": "„Sobald die Spatzen im kochenden Wasser aufsteigen, mit einem Sieblöffel aus dem Wasser heben und mit kaltem Wasser abschwemmen.“"
                            },
                            {
                                "example_id": "75fa8647-3785-4f30-8771-a3aa422987d7",
                                "sense_id": "9afe3e9d-c6b5-3f16-adb5-ca76e6e7d069",
                                "text": "„In der Zwischenzeit den Spatzenteig aus Mehl, Salz und Wasser zubereiten. Die Spatzen im gesalzenen kochenden Wasser gar werden lassen.“"
                            },
                            {
                                "example_id": "cca461e7-287b-4938-909d-6e85f15ab7f2",
                                "sense_id": "9afe3e9d-c6b5-3f16-adb5-ca76e6e7d069",
                                "text": "„Für die Spatzen Mehl, Eier, Wasser, Öl und Salz mit einem Kochlöffel zu einem glatten, zähen Spätzleteig abschlagen. […] Spatzen einige Minuten kochen lassen, in ein Sieb leeren, abschrecken und gut abtropfen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "38d04cc2-3ba3-3f07-9139-c583dc6b9b06",
                        "entry_id": "85fb3bba-5eca-3eff-a581-6768310ecc85",
                        "glosses": [
                            "vorübergehende Schmerzen in den Muskeln, die, nach (ungewohnter) körperlicher Anstrengung, durch zur Verhärtung des Muskelgewebes führende kleine Risse in Teilen der Muskelfasern sowie nachfolgender Bildung lokaler Ödeme entstehen"
                        ],
                        "tags": [
                            "südostösterreichisch"
                        ],
                        "examples": [
                            {
                                "example_id": "3260c76d-be90-45c1-aaa7-03a1a293c8ac",
                                "sense_id": "38d04cc2-3ba3-3f07-9139-c583dc6b9b06",
                                "text": "„Die Sportmassage dient zudem der Muskelentspannung, einer gesteigerten Blutzirkulation und einem besseren Stoffwechsel der Muskulatur. Muskelschmerzen (Spatzen) können dadurch vermieden werden.“"
                            },
                            {
                                "example_id": "e9cb12f5-dbc1-4488-9b42-2ccdd1deedef",
                                "sense_id": "38d04cc2-3ba3-3f07-9139-c583dc6b9b06",
                                "text": "„Man tritt nach langer Winterruhepause zu kräftig in die Pedale – was folgt, ist ein Muskelkater, sind ‚Spatzen‘. […] Schmerzhafte Wadenkrämpfe, die typischerweise in der Nacht auftreten und den Schlaf empfindlich stören, gelten als charakteristisches Symptom für einen ausgeprägten Magnesiummangel, ‚Spatzen‘ sind die Folge von sportlicher Überanstrengung einzelner Muskeln.“"
                            },
                            {
                                "example_id": "ac7f505e-5530-48ad-adb9-d8b7808066b8",
                                "sense_id": "38d04cc2-3ba3-3f07-9139-c583dc6b9b06",
                                "text": "„Spatzen sollte man nach dem Training keine haben. Sie sind ein Zeichen dafür, dass beim Sport übertrieben wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
