    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dc0995f8-bf2c-3d12-9044-dff36ae151a4",
                "word": "hipster",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "65f8d865-ea79-42eb-a0b6-7c19ebf75ec0",
                        "entry_id": "dc0995f8-bf2c-3d12-9044-dff36ae151a4",
                        "tags": [
                            "plural"
                        ],
                        "form": "hipsters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b8467ce-03f8-38e0-ab85-37732d2651ce",
                        "entry_id": "dc0995f8-bf2c-3d12-9044-dff36ae151a4",
                        "glosses": [
                            "A person who is keenly interested in the latest trends or fashions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec4d83f-daab-4aa5-90ec-fa66a3858bb1",
                                "sense_id": "9b8467ce-03f8-38e0-ab85-37732d2651ce",
                                "text": "c. 1954, Jack Kerouac, Untitled poem, in Book of Sketches, 1952-57, Penguin, 2006, p. 239,\nI, poor French Canadian Ti Jean become / a big sophisticated hipster esthete in / the homosexual arts […]"
                            },
                            {
                                "example_id": "06bad4c6-72cb-4020-9205-d0b1ac8e10ed",
                                "sense_id": "9b8467ce-03f8-38e0-ab85-37732d2651ce",
                                "text": "Clare grapples with the idea that she, a well-dressed city hipster, will soon be in the boondocks raising a child with two men who are as much in love with each other as with her: \"I'm not this unusual,\" she stammers. \"It's just my hair.\""
                            },
                            {
                                "example_id": "821ad1c4-9ba9-4bfc-8c56-0894fc3b8c7b",
                                "sense_id": "9b8467ce-03f8-38e0-ab85-37732d2651ce",
                                "text": "Donald Fagen and Walter Becker seem like the kind of late-1960s hypercerebral born-cynical East Coast hipsters who are often found valorizing authenticity in aesthetic expression."
                            },
                            {
                                "example_id": "ff541343-9209-469e-ba27-f89861cbd473",
                                "sense_id": "9b8467ce-03f8-38e0-ab85-37732d2651ce",
                                "text": "And his conclusion is that in a vast range of scenarios, the hipster population always undergoes a kind of phase transition in which members become synchronized with each other in opposing the mainstream. In other words, the hipster effect is the inevitable outcome of the behavior of large numbers of people."
                            }
                        ]
                    },
                    {
                        "sense_id": "5772dd82-4523-3574-8f7b-d59261a7bd33",
                        "entry_id": "dc0995f8-bf2c-3d12-9044-dff36ae151a4",
                        "glosses": [
                            "A member of Bohemian counterculture."
                        ],
                        "tags": [],
                        "examples": []
                    },
