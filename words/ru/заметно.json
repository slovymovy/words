                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По твоему лицу сразу <w>заметно</w>, что ты очень рад.",
                            "target_lang_translations": {
                                "en": "It is immediately <w>evident</w> from your face that you are very happy.",
                                "de": "An deinem Gesicht <w>sieht man</w> sofort, dass du dich sehr freust.",
                                "nl": "Aan je gezicht is meteen <w>duidelijk</w> te zien dat je erg blij bent.",
                                "pl": "Po twojej twarzy od razu <w>widać</w>, że bardzo się cieszysz.",
                                "fr": "À ton visage, il est tout de suite <w>évident</w> que tu es très heureux.",
                                "it": "Dalla tua faccia è subito <w>evidente</w> che sei molto felice.",
                                "cs": "Na tvém obličeji je hned <w>znát</w>, že máš velkou radost.",
                                "tr": "Yüzünden çok mutlu olduğun hemen <w>belli</w> oluyor.",
                                "es": "Por tu cara es <w>evidente</w> que estás muy contento.",
                                "zh": "从你的脸上马上就能<w>看出</w>你很高兴。"
                            }
                        },
                        {
                            "text": "Это маленькое пятно на рубашке почти не <w>заметно</w>.",
                            "target_lang_translations": {
                                "en": "This small stain on the shirt is almost not <w>visible</w>.",
                                "de": "Dieser kleine Fleck auf dem Hemd ist fast nicht <w>sichtbar</w>.",
                                "nl": "Dit kleine vlekje op het overhemd is bijna niet <w>zichtbaar</w>.",
                                "pl": "Ta mała plama na koszuli jest prawie nie <w>widoczna</w>.",
                                "fr": "Cette petite tache sur la chemise est presque <w>invisible</w>.",
                                "it": "Questa piccola macchia sulla camicia è quasi non <w>visibile</w>.",
                                "cs": "Tahle malá skvrna na košili skoro není <w>vidět</w>.",
                                "tr": "Gömlekteki bu küçük leke neredeyse hiç <w>görünmüyor</w>.",
                                "es": "Esta pequeña mancha en la camisa es casi <w>invisible</w>.",
                                "zh": "衬衫上的这个小污点几乎<w>看不见</w>。"
                            }
                        }
