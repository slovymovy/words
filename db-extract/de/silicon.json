                "senses": [
                    {
                        "sense_id": "694db282-4aae-3da7-8136-0695380181e3",
                        "entry_id": "2a4ca5f7-845b-334c-ad14-1d14a10feaee",
                        "glosses": [
                            "aus Silicium hergestellter dauerelastischer Kunststoff"
                        ],
                        "tags": [
                            "fachsprachlich Chemie"
                        ],
                        "examples": [
                            {
                                "example_id": "2cd8256c-c2c8-46e5-b404-21d544232fdf",
                                "sense_id": "694db282-4aae-3da7-8136-0695380181e3",
                                "text": "„Der teilweise anorganische Charakter der Silicone bewirkt eine höhere Wärmebeständigkeit als die der rein organischen Polymere.“"
                            },
                            {
                                "example_id": "f97b8edb-d4b0-4bca-8f70-36d0ce01daf8",
                                "sense_id": "694db282-4aae-3da7-8136-0695380181e3",
                                "text": "„Die englische Übersetzung für Silicium lautet silicon, z. B. im Begriff Silicon Valley (dt. ‚Silicium-Tal‘) zu finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
