                "senses": [
                    {
                        "sense_id": "fcde2706-ec71-3dc0-b129-093d5fbca719",
                        "entry_id": "d78ea713-1b8c-3331-96dd-062dfdda42d5",
                        "glosses": [
                            "Made of leather."
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "923a2ed5-6c2e-41db-8565-20ac3adc6dce",
                                "sense_id": "fcde2706-ec71-3dc0-b129-093d5fbca719",
                                "text": "Except for his leathern harness, covered thick with jewels and metal, […]"
                            },
                            {
                                "example_id": "7344ea1e-5dd3-4c64-9d89-072f862e16c7",
                                "sense_id": "fcde2706-ec71-3dc0-b129-093d5fbca719",
                                "text": "For the doing of this matter, he ordered a great many leathern bottles and sacks to be got together; […]"
                            },
                            {
                                "example_id": "3176bc93-6d43-4ace-9f69-ce468f2592e8",
                                "sense_id": "fcde2706-ec71-3dc0-b129-093d5fbca719",
                                "text": "He had his tea and hot rolls in a morning, while we were battening upon our quarter of a penny loaf—our crug—moistened with attenuated small beer, in wooden piggins, smacking of the pitched leathern jack it was poured from."
                            },
                            {
                                "example_id": "dd0ce114-4687-491d-89d9-b1c9e613f8c1",
                                "sense_id": "fcde2706-ec71-3dc0-b129-093d5fbca719",
                                "text": "[A] street door was torn open to admit four boys, with their leathern straps of books over their shoulders."
                            },
                            {
                                "example_id": "282a71bb-8287-4155-88e5-98851eafa231",
                                "sense_id": "fcde2706-ec71-3dc0-b129-093d5fbca719",
                                "text": "Still more pleased was he when, inverting a leathern pouch over the end of the reed, and so filling it with the gas, he was able to send it soaring up into the air."
                            }
                        ]
                    }
                ],
