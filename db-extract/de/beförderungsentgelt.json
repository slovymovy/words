                                        "sense_id": "5c078f2c-ad06-3dc3-b6f5-bcb9736be307",
                                        "entry_id": "014caa25-a185-3f1e-bbc3-ced1194d3344",
                                        "glosses": [
                                            "Food and drink."
                                        ],
                                        "tags": [
