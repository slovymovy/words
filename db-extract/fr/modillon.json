        "fr-extract.jsonl": [
            {
                "entry_id": "255cb9d1-a534-38e5-9a6f-a5ff3faf133a",
                "word": "modillon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7f37b3fe-ee8a-49be-acbe-4af11777b618",
                        "entry_id": "255cb9d1-a534-38e5-9a6f-a5ff3faf133a",
                        "tags": [
                            "plural"
                        ],
                        "form": "modillons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6cc702c-235a-3905-bfc6-a6d5ebff97d1",
                        "entry_id": "255cb9d1-a534-38e5-9a6f-a5ff3faf133a",
                        "glosses": [
                            "Chacune des consoles décoratives disposées régulièrement sous une corniche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5db4c555-58c8-417f-bed9-6a7a07915923",
                                "sense_id": "d6cc702c-235a-3905-bfc6-a6d5ebff97d1",
                                "text": "En traversant le bourg de Garchy, on s’arrête pour jeter un coup-d’œil sur l’abside à pans coupés de son église, et pour considérer l’entablement garni de têtes de clous et soutenu par des modillons ornés de feuilles de fantaisie et de figures bizarres d’animaux."
                            },
                            {
                                "example_id": "7260d31b-1ab4-4edc-b7f0-14e8af90bffe",
                                "sense_id": "d6cc702c-235a-3905-bfc6-a6d5ebff97d1",
                                "text": "Les deux tours … se couronnent d’un diadème de mâchicoulis exhaussé sur un parapet dont les modillons rappellent le style rapporté des croisades."
                            },
                            {
                                "example_id": "40f80d6a-688a-4b7d-9509-15863c948db2",
                                "sense_id": "d6cc702c-235a-3905-bfc6-a6d5ebff97d1",
                                "text": "L’auteur des étranges modillons d’Ardentes est venu à Sassierges-Saint-Germain, petite localité voisine, pour réaliser le décor de la porte occidentale de l’église. Celle-ci est un reflet parfait, quoique plus simple, du portail nord de Saint-Martin : même archivolte sculptée de demi-cercles opposés deux à deux, même alignement de rosaces sur les claveaux de la voussure médiane à l'arête torique, même mouluration complexe des tailloirs."
                            }
                        ]
                    },
                    {
                        "sense_id": "e43e4ef3-abb3-33c2-9851-160c3f1a312b",
                        "entry_id": "255cb9d1-a534-38e5-9a6f-a5ff3faf133a",
                        "glosses": [
                            "Ornement propre aux ordres ionique, corinthien et composite, placé sous le larmier de la corniche et figurant l’extrémité des chevrons du comble."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1590c19b-bb5b-41e0-b835-175187cb6e7c",
                        "source_entry_id": "255cb9d1-a534-38e5-9a6f-a5ff3faf133a",
                        "target_lang_word": "modillion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modillion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "742e99f2-8fea-3a3c-8cb5-4d2d118c63b2",
                                        "entry_id": "e459657c-8802-3573-a5c7-b916f365d043",
                                        "glosses": [
                                            "A decoratively carved supporting block atop a column, often underneath a cornice, and usually smaller and more ornamental in function than a corbel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d88fa2a-237e-48d3-9e1b-661c6f9b4f7f",
                                                "sense_id": "742e99f2-8fea-3a3c-8cb5-4d2d118c63b2",
                                                "text": "It is a large square structure, two and a half stories in height, with a hipped roof rising above a handsome cornice with prominent modillions and surmounted by a balustraded belvedere."
                                            },
                                            {
                                                "example_id": "8eb42d4d-502d-4cc0-8ec0-cee58da551a9",
                                                "sense_id": "742e99f2-8fea-3a3c-8cb5-4d2d118c63b2",
                                                "text": "The familiar classic console or modillion is an example: although in general contour it is well adapted to its function as a supporting bracket, embedded in, and projecting from a wall, yet the scroll-like ornament with which its sides are embellished gives it the appearance of not entering the wall at all, but of being stuck against it in some miraculous manner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec188986-a2c8-47c2-89a0-db6fb9131ded",
                        "source_entry_id": "255cb9d1-a534-38e5-9a6f-a5ff3faf133a",
                        "target_lang_word": "corbel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corbel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06defcee-0c40-3ed4-868f-a1b6ebcf206a",
                                        "entry_id": "97c32452-9556-35a6-8166-934cca551e30",
                                        "glosses": [
                                            "A structural member jutting out of a wall to carry a superincumbent weight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "858b3c91-89f5-4726-945d-5b302ee7889b",
                                                "sense_id": "06defcee-0c40-3ed4-868f-a1b6ebcf206a",
                                                "text": "The booking hall is lofty and of peculiar design, the roof being carried on timbered beams set in pairs rising from carved corbels."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corbel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d1b582f-65a3-3fe4-9e18-825aa11a59e5",
                                        "entry_id": "26814ba3-dfab-307f-81d2-77eacbcda0df",
                                        "glosses": [
                                            "To furnish with a corbel or corbels; to support by a corbel; to make in the form of a corbel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
