                "senses": [
                    {
                        "sense_id": "aadb2b7f-6508-36af-8270-075fcd700de2",
                        "entry_id": "0cfab692-35a8-3934-9ce0-b4c1aa298480",
                        "glosses": [
                            "истор. военно-политический блок Англии, Франции и России, сложившийся в 1904–1907 годах и созданный в качестве противовеса Тройственному (позднее — Четверному) союзу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60680352-94f2-4d5f-8261-f72b5c2b4bf1",
                                "sense_id": "aadb2b7f-6508-36af-8270-075fcd700de2",
                                "text": "В ответ Антанта поддержала Белое движение, поскольку его руководители обязались исполнять свой союзнический долг и сражаться против кайзеровской Германии и Австро-Венгрии."
                            }
                        ]
                    }
