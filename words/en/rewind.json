{
    "word_family": [
        "wind",
        "unwind",
        "rewinder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51866e91-a24d-34ee-8bc9-0b26a1cb211f",
                    "sense_definition": "To wind something back, such as a video or audio recording, to an earlier point.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "media_playback",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I missed that last sentence, so please <w>rewind</w> the video a few seconds.",
                            "target_lang_translations": {
                                "ru": "Я пропустил последнее предложение, поэтому, пожалуйста, <w>перемотай</w> видео на несколько секунд назад."
                            }
                        },
                        {
                            "text": "You should <w>rewind</w> the tape before returning it to the rental store.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>перемотать</w> кассету перед тем, как возвращать её в прокат."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "fast-forward"
                    ],
                    "common_phrases": [
                        "rewind the tape",
                        "rewind the video"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перематывать что-либо назад, например видео- или аудиозапись, к более раннему моменту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перематывать",
                                "target_lang_sense_clarification": "процесс перемотки видео или аудио"
                            },
                            {
                                "target_lang_word": "отматывать",
                                "target_lang_sense_clarification": "назад к определенному моменту"
                            },
                            {
                                "target_lang_word": "перемотать",
                                "target_lang_sense_clarification": "завершить перемотку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3439ab01-5e9f-3c42-9f64-bdea01d783df",
                    "sense_definition": "To go back or think back to a previous moment, place, or point in time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temporal_recollection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's <w>rewind</w> to the beginning of the conversation to see where we went wrong.",
                            "target_lang_translations": {
                                "ru": "Давайте <w>вернемся</w> к началу разговора, чтобы понять, в какой момент всё пошло не так."
                            }
                        },
                        {
                            "text": "If I could <w>rewind</w> to last year, I would make a completely different choice.",
                            "target_lang_translations": {
                                "ru": "Если бы я мог <w>отмотать</w> время к прошлому году, я бы сделал совсем другой выбор."
                            }
                        }
                    ],
                    "synonyms": [
                        "revisit",
                        "retrace",
                        "go back"
                    ],
                    "common_phrases": [
                        "rewind to the beginning",
                        "rewind a few years"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used metaphorically in conversation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуться или мысленно перенестись к предыдущему моменту, месту или моменту времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отмотать",
                                "target_lang_sense_clarification": "мысленно вернуться назад во времени"
                            },
                            {
                                "target_lang_word": "вернуться",
                                "target_lang_sense_clarification": "к началу разговора или события"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78b2235f-65e0-38cb-9e15-eee8f478f030",
                    "sense_definition": "To <w>wind</w> something again, such as a spring, a bandage, or a mechanical device.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_winding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier had to <w>rewind</w> the mechanism of his crossbow before he could fire again.",
                            "target_lang_translations": {
                                "ru": "Солдату пришлось заново <w>взвести</w> механизм своего арбалета, прежде чем он смог выстрелить снова."
                            }
                        },
                        {
                            "text": "She spent the afternoon <w>rewinding</w> the long bandages to keep them organized for the doctor.",
                            "target_lang_translations": {
                                "ru": "Она провела весь день, <w>перематывая</w> длинные бинты, чтобы они лежали аккуратно для врача."
                            }
                        }
                    ],
                    "antonyms": [
                        "unwind"
                    ],
                    "common_phrases": [
                        "rewind the mechanism",
                        "rewind the spring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заново намотать что-либо, например пружину, бинт или механическое устройство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перематывать",
                                "target_lang_sense_clarification": "наматывать заново или иначе"
                            },
                            {
                                "target_lang_word": "перемотать",
                                "target_lang_sense_clarification": "заново наложить бинт или взвести механизм"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dda2dbc5-5851-3718-9207-e0a16328e496",
                    "sense_definition": "A button or mechanism used to move a recording or film backward.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_controls",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I meant to pause the movie, but I hit the <w>rewind</w> by mistake.",
                            "target_lang_translations": {
                                "ru": "Я хотел поставить фильм на паузу, но по ошибке нажал на <w>перемотку</w>."
                            }
                        },
                        {
                            "text": "The <w>rewind</w> on this old camera is broken, so I cannot take the film out.",
                            "target_lang_translations": {
                                "ru": "Механизм <w>перемотки</w> на этой старой камере сломан, поэтому я не могу вытащить пленку."
                            }
                        }
                    ],
                    "antonyms": [
                        "fast-forward"
                    ],
                    "common_phrases": [
                        "press the rewind",
                        "hit the rewind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кнопка или механизм, используемый для перемещения записи или пленки назад."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемотка",
                                "target_lang_sense_clarification": "кнопка или функция на устройстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28956a37-6266-31ea-9582-bdbe12d0a235",
                    "sense_definition": "The act or process of winding something back.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rewind</w> of the film took much longer than we expected.",
                            "target_lang_translations": {
                                "ru": "<w>Перемотка</w> фильма заняла гораздо больше времени, чем мы ожидали."
                            }
                        },
                        {
                            "text": "A quick <w>rewind</w> of the tape confirmed that we had recorded the right show.",
                            "target_lang_translations": {
                                "ru": "Быстрая <w>перемотка</w> записи подтвердила, что мы записали нужную передачу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick rewind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс сматывания чего-либо назад."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемотка",
                                "target_lang_sense_clarification": "сам процесс движения назад"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}