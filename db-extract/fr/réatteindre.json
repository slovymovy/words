                        "glosses": [
                            "Atteindre de nouveau quelque chose qu’on avait déjà atteint une première fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7775a793-03d2-4014-9338-9b2ee6beca61",
                                "sense_id": "92f447fc-ffb3-392c-b9ca-51943261f37c",
                                "text": "Un minimum de travail lui permettra de réatteindre le niveau qu’il avait autrefois."
                            },
