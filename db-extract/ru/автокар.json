                "senses": [
                    {
                        "sense_id": "f5f90c82-198f-37bd-8a86-92ebd5060bdf",
                        "entry_id": "56cf1510-e3bd-335d-8044-747b8055a180",
                        "glosses": [
                            "самодвижущаяся тележка с двигателем внутреннего сгорания, используемая для безрельсовой перевозки грузов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d645d3b8-376e-4409-a514-912856d8fff4",
                                "sense_id": "f5f90c82-198f-37bd-8a86-92ebd5060bdf",
                                "text": "Вера встала на автокар и, слегка повернув рукоятку управления, покатилась к яркому пятну света."
                            },
                            {
                                "example_id": "1557e70f-e59d-4c1b-9e55-e685f177e2eb",
                                "sense_id": "f5f90c82-198f-37bd-8a86-92ebd5060bdf",
                                "text": "— Гады, — сказал он про рабочих, грузивших телевизоры на автокар."
                            }
                        ]
                    }
                ],
