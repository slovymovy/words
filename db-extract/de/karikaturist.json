                    {
                        "form_id": "85c01c2c-3c60-4795-995d-16a73011e7d3",
                        "entry_id": "d7ce6d78-5cfd-3527-b2b8-74c2ea4b3191",
                        "tags": [
                            "accusative",
                            "plural"
