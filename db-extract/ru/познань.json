                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0763d945-e296-4154-8772-8a8db177956d",
                                                "sense_id": "e4a09345-3a0f-308f-b512-43026ffecf9b",
                                                "text": "Le diocèse de Poznan."
                                            },
                                            {
                                                "example_id": "ccf05e75-3f5f-4a80-80f2-d4282742244b",
                                                "sense_id": "e4a09345-3a0f-308f-b512-43026ffecf9b",
                                                "text": "La Grande-Pologne, avec sa richesse agricole et sa métropole de Poznan, est la région d'origine du fondateur de la première dynastie royale polonaise, celle des Piast."
                                            },
                                            {
