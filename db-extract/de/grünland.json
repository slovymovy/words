                "senses": [
                    {
                        "sense_id": "e8251893-4e72-3459-bb75-c6f75067d917",
                        "entry_id": "6d377806-fbe8-3621-978e-aa451297f99e",
                        "glosses": [
                            "landwirtschaftlich genutzte Fläche, die von Gräsern oder Kräutern bewachsen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "475c267c-2b78-4728-85d7-d1af0f2bec0d",
                                "sense_id": "e8251893-4e72-3459-bb75-c6f75067d917",
                                "text": "„Wird das Grünland geopfert, gelangt der im Erdreich gespeicherte Kohlenstoff als Kohlendioxid nach wenigen Monaten in die Atmosphäre.“"
                            },
                            {
                                "example_id": "ff4b3a7d-26ab-4362-8c8f-d4e9889d9a59",
                                "sense_id": "e8251893-4e72-3459-bb75-c6f75067d917",
                                "text": "„Bevor die europäischen Siedler nach Nordamerika kamen, durchstreiften Bisonherden das Grünland.“"
                            },
                            {
                                "example_id": "b47f8532-8ca7-4395-9a8c-fe067e5a017f",
                                "sense_id": "e8251893-4e72-3459-bb75-c6f75067d917",
                                "text": "„Wer etwas gegen den Klimawandel tun möchte, sollte Grünland erhalten oder neues, am besten artenreiches Grünland, schaffen.“"
                            },
                            {
                                "example_id": "11c50b08-2097-410d-892a-79bae2b70452",
                                "sense_id": "e8251893-4e72-3459-bb75-c6f75067d917",
                                "text": "„Glaubt man der Literatur, dann ist Grünland der wichtigste Lebensraum für den Weißstorch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
