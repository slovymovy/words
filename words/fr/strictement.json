{
    "word_family": [
        "strict"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d8db61dc-2fa6-3e51-ac4b-d781b49e12dc",
                    "sense_definition": "D'une manière stricte, rigoureuse ou exacte.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rigueur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est <w>strictement</w> interdit de fumer dans tous les lieux publics fermés."
                        },
                        {
                            "text": "Les médecins appliquent <w>strictement</w> ce protocole sanitaire afin d'éviter toute contamination."
                        }
                    ],
                    "synonyms": [
                        "rigoureusement"
                    ],
                    "common_phrases": [
                        "strictement interdit",
                        "appliquer strictement"
                    ]
                },
                {
                    "sense_id": "83d8e05c-4b50-34cf-a6e3-786a542a1d31",
                    "sense_definition": "Absolument, sans aucune exception, souvent employé avec une valeur de négation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "absolu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je t'assure que je n'ai <w>strictement</w> rien compris à ses explications compliquées."
                        },
                        {
                            "text": "Il n'y a <w>strictement</w> aucune raison de s'inquiéter pour cet examen."
                        }
                    ],
                    "common_phrases": [
                        "strictement rien",
                        "strictement impossible"
                    ]
                },
                {
                    "sense_id": "a1b969e4-7401-3937-bd38-84034192cc0c",
                    "sense_definition": "En excluant formellement le cas d'égalité, dans un contexte mathématique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un nombre <w>strictement</w> positif ne peut jamais être égal à zéro."
                        },
                        {
                            "text": "Cette fonction continue est <w>strictement</w> croissante sur l'ensemble des réels."
                        }
                    ],
                    "common_phrases": [
                        "strictement positif",
                        "strictement supérieur"
                    ]
                }
            ]
        }
    ]
}