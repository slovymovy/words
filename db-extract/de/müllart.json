                "senses": [
                    {
                        "sense_id": "70435433-30ed-331b-8666-139a2dfc0d7d",
                        "entry_id": "c83a0c20-7322-371f-a51b-432d6e452a38",
                        "glosses": [
                            "Unterscheidung des Mülls nach dem Material und die Zuordnung in Recyclingsysteme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc40f31a-21e6-4cce-a7b8-234117c88843",
                                "sense_id": "70435433-30ed-331b-8666-139a2dfc0d7d",
                                "text": "„Überall, wo Symbole (Icons) für die Darstellung von Müllarten verwendet werden, können Sie mit dem Mauszeiger über das Symbol fahren, um Hinweise zur Müllart zu sehen.“"
                            },
                            {
                                "example_id": "0f70aef7-5638-42d1-912a-341530c8c9b3",
                                "sense_id": "70435433-30ed-331b-8666-139a2dfc0d7d",
                                "text": "„Dank der durchdachten Erinnerungsfunktion und der Unterstützung aller wichtigen Müllarten, erhalten Sie einen ausgereiften Entsorgungs-Helfer für Ihr iPhone.“"
                            },
                            {
                                "example_id": "7d27be97-360c-40f6-8fce-6c575451c08a",
                                "sense_id": "70435433-30ed-331b-8666-139a2dfc0d7d",
                                "text": "„Nachfolgende Auflistung zeigt Ihnen die Gebühren bei Anlieferung unterschiedlicher Müllarten auf unseren Entsorgungsanlagen auf einen Blick.“"
                            },
                            {
                                "example_id": "ed7e4304-a860-49db-a7e0-c3359c54bbb6",
                                "sense_id": "70435433-30ed-331b-8666-139a2dfc0d7d",
                                "text": "„Hier wird ganz ausführlich beschrieben, welche Müllarten es gibt und wie getrennt werden muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
