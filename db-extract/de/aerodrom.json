                "senses": [
                    {
                        "sense_id": "67d6930f-90a0-3157-b9e2-e2b6f8453a7f",
                        "entry_id": "6ecf4a27-5da0-325c-bd72-b52697e557ad",
                        "glosses": [
                            "Areal, auf dem Flugzeuge starten und wieder landen"
                        ],
                        "tags": [
                            "outdated",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "94832931-10c2-49b1-85e1-40a48859a66b",
                                "sense_id": "67d6930f-90a0-3157-b9e2-e2b6f8453a7f",
                                "text": "„Wir sind angekommen. Vor dem Aerodrom liegt noch ein großer Platz mit verdächtigen Holzhäuschen, für die wir andere Aufschriften erwartet hätten, als: Garage, Grand Büfett International und so weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3a6fe7af-567a-34a8-8d41-8754ad7b4705",
