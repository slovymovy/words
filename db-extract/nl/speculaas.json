                "senses": [
                    {
                        "sense_id": "14b7cf1d-8496-31a8-9503-81d0a0b3a001",
                        "entry_id": "2fd5da80-ca12-30d0-b9ce-5d040fa59e14",
                        "glosses": [
                            "een harde, droge kruidkoek, die vooral rond Sinterklaas gegeten wordt, soms gevuld met amandelspijs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc934906-3ff5-4bcf-88e7-d81e6f636f2f",
                                "sense_id": "14b7cf1d-8496-31a8-9503-81d0a0b3a001",
                                "text": "Alleen al het inkopen doen voor de kerstmaaltijd. En het je herinneren hoe het zat met dadels en speculaas, het dopen van stukjes brood in hambouillon, varkenspootjes, stokvis met piment en witte saus op Zweedse wijze of spek in eigen vet, mosterd en doperwtenpuree op Noorse wijze, welke soorten noten verplicht waren — en op het laatste moment op kerstavond zelf notenkrakers aanschaffen —, rolham, haring en rijstebrij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1eca0a0-e700-4e88-be1f-6650f04a4b5e",
                        "source_entry_id": "2fd5da80-ca12-30d0-b9ce-5d040fa59e14",
                        "source_sense_id": "14b7cf1d-8496-31a8-9503-81d0a0b3a001",
                        "source_sense_description": "een harde, droge kruidkoek, die vooral rond Sinterklaas gegeten wordt, soms gevuld met amandelspijs",
                        "target_lang_word": "Spekulatius",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spekulatius",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9244188a-7481-370f-b5f6-ab7bb2f742e9",
                                        "entry_id": "c80fac34-1875-3362-93bc-03ab6dd6136a",
                                        "glosses": [
                                            "gewürztes und flaches Weihnachtsgebäck aus Mürbeteig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34870844-4882-4b8f-9205-afc379052341",
                                                "sense_id": "9244188a-7481-370f-b5f6-ab7bb2f742e9",
                                                "text": "Zu Weihnachten gibt es immer Lebkuchen und Spekulatius."
                                            },
                                            {
                                                "example_id": "f3e02413-d5e7-4046-a494-6e8d14297053",
                                                "sense_id": "9244188a-7481-370f-b5f6-ab7bb2f742e9",
                                                "text": "Die Kinder haben schon wieder alle Spekulatius vertilgt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e8d9116-34c2-4894-b837-8ba0a3aef794",
                        "source_entry_id": "2fd5da80-ca12-30d0-b9ce-5d040fa59e14",
                        "source_sense_id": "14b7cf1d-8496-31a8-9503-81d0a0b3a001",
                        "source_sense_description": "een harde, droge kruidkoek, die vooral rond Sinterklaas gegeten wordt, soms gevuld met amandelspijs",
                        "target_lang_word": "spéculoos",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spéculoos",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48c0d9aa-9f6a-3ce8-8714-dc7da5ba88da",
                                        "entry_id": "d70c5f77-d1a3-35e9-839b-74ce793b780e",
                                        "glosses": [
                                            "Biscuit ou gâteau sec de froment agrémenté de cassonade et parfumé d’épices (en particulier de cannelle), qui était traditionnellement moulée en forme de personnages, d’animaux ou d’objets."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b63d1b-0ef9-4f0d-9dc2-03d1d497c1d6",
                                                "sense_id": "48c0d9aa-9f6a-3ce8-8714-dc7da5ba88da",
                                                "text": "Comme les années précédentes, les vieillards des hospices et les orphelins ont bénéficié de distributions de friandises à l'occasion des fêtes nationales. Le Collège a décidé, en outre, de continuer les distributions annuelles de spéculoos aux mêmes intéressés à l'occasion de la Saint-Nicolas."
                                            },
                                            {
                                                "example_id": "617ad7ec-f525-4e8b-9bd6-84b16d7cb305",
                                                "sense_id": "48c0d9aa-9f6a-3ce8-8714-dc7da5ba88da",
                                                "text": "Une autre grande spécialité de la cuisine bruxelloise est le spéculoos, qui remonte au Moyen Âge. On travaille la veille, on laisse reposer la nuit et on cuit le jour même du repas. Les vrais grands spéculoos se cuisent dans de grandes formes en bois sculpté, représentant des scènes du folklore, surtout en fin d'année, au moment de la Saint-Nicolas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
