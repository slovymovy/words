{
    "word_family": [
        "patch",
        "patchy",
        "patchwork"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8d3df718-3b01-3816-8dd7-4cf365d3f8d7",
                    "sense_definition": "Having been repaired with a patch or patches.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "repaired",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a pair of <w>patched</w> jeans to the garden.",
                            "target_lang_translations": {
                                "zh": "他穿着一条<w>打着补丁的</w>牛仔裤去了花园。"
                            }
                        },
                        {
                            "text": "The <w>patched</w> roof finally stopped leaking during the heavy rain.",
                            "target_lang_translations": {
                                "zh": "那扇<w>修补过的</w>屋顶在大雨中终于不再漏水了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mended",
                        "repaired"
                    ],
                    "common_phrases": [
                        "patched jeans",
                        "patched roof"
                    ],
                    "target_lang_definitions": {
                        "zh": "指用补丁修补过的，或带有补丁的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打补丁的",
                                "target_lang_sense_clarification": "形容衣物或物品表面有补丁。"
                            },
                            {
                                "target_lang_word": "修补过的",
                                "target_lang_sense_clarification": "形容物品经过修补，强调其状态。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "642a8c1d-cb1e-39e2-8a01-16305113a722",
                    "sense_definition": "Simple past and past participle of <w>patch</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "repaired",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>patched</w> the hole in her favorite sweater.",
                            "target_lang_translations": {
                                "zh": "她把最喜欢的那件毛衣上的洞<w>补</w>好了。"
                            }
                        },
                        {
                            "text": "The mechanic <w>patched</w> the tire after finding a nail.",
                            "target_lang_translations": {
                                "zh": "修理工发现钉子后，把轮胎<w>补</w>上了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mended",
                        "repaired"
                    ],
                    "common_phrases": [
                        "patched up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 patch 的过去式或过去分词，意为修补、补缀。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "修补",
                                "target_lang_sense_clarification": "指修复破损处。"
                            },
                            {
                                "target_lang_word": "打补丁",
                                "target_lang_sense_clarification": "特指在破洞处缝上布块。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}