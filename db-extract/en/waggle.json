                    {
                        "translation_id": "cb2e51d2-fa23-4aa2-a325-4bde284d4656",
                        "source_entry_id": "6da56ff5-770c-36b2-9145-e2b56dcc18be",
                        "source_sense_description": "move with short, quick motions; wobble",
                        "target_lang_word": "frétiller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frétiller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f60c0ed-a226-38d5-8d5d-98c872e2010a",
                                        "entry_id": "9e511d34-9188-3dbb-8084-1b3ac582a780",
                                        "glosses": [
                                            "Se remuer ; s’agiter par des mouvements vifs et courts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad37ed16-647a-4a3d-b547-01a388d7c9e3",
                                                "sense_id": "2f60c0ed-a226-38d5-8d5d-98c872e2010a",
                                                "text": "Pour votre malheur, vous vous souvenez de la joyeuse et perverse fille qui avait un petit chapeau rose et qui frétillait dans votre tilbury quand, six ans auparavant, vous aviez passé par là pour aller manger une matelote."
                                            },
                                            {
                                                "example_id": "6c70d296-5f86-4b2b-9955-cfa8bdff04af",
                                                "sense_id": "2f60c0ed-a226-38d5-8d5d-98c872e2010a",
                                                "text": "Il se prit à marcher devant nous en compagnie de son chien qui frétillait de la queue et jappait joyeusement."
                                            },
                                            {
                                                "example_id": "c3937064-366e-4ab7-983a-00a7bfeb7615",
                                                "sense_id": "2f60c0ed-a226-38d5-8d5d-98c872e2010a",
                                                "text": "Les filoches à mailles fines suspendues par une cordelette baignent dans l’eau, et les prises y frétillent."
                                            },
                                            {
                                                "example_id": "6c9fef90-74bd-4cc6-9a20-aa30ea1f1276",
                                                "sense_id": "2f60c0ed-a226-38d5-8d5d-98c872e2010a",
                                                "text": "Cet enfant me fatigue, il frétille sans cesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38db5ea9-f1fa-306d-a862-8845b2d9c3ad",
                                        "entry_id": "9e511d34-9188-3dbb-8084-1b3ac582a780",
                                        "glosses": [
                                            "Être pris d'agitation."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a51168ad-4a86-4f97-9180-431107f7cb32",
                                                "sense_id": "38db5ea9-f1fa-306d-a862-8845b2d9c3ad",
                                                "text": "Rien n'arrête le zèle des recruteurs monastiques. Vous les voyez frétiller autour des héritiers, des héritières…"
                                            },
                                            {
                                                "example_id": "f5d71abb-b7c6-42c2-910e-09f3bd9843d7",
                                                "sense_id": "38db5ea9-f1fa-306d-a862-8845b2d9c3ad",
                                                "text": "Les pieds lui frétillent, il a impatience de marcher, de partir."
                                            },
                                            {
                                                "example_id": "a928ff00-6db8-402e-9512-c4c168c6a270",
                                                "sense_id": "38db5ea9-f1fa-306d-a862-8845b2d9c3ad",
                                                "text": "La langue lui frétille, il a grande envie de parler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd2ae7d4-814c-4e96-bfe5-920f0bcb96af",
