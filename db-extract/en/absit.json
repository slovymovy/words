                "senses": [
                    {
                        "sense_id": "cf4d6dd3-963b-3df3-b773-895e72409034",
                        "entry_id": "394ab176-b435-3c2b-a97e-c817099d1dc7",
                        "glosses": [
                            "Formal permission to be away from a college for the greater part of the day or more."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "0d04e3e6-dd9b-4a94-902a-895ea59edbce",
                                "sense_id": "cf4d6dd3-963b-3df3-b773-895e72409034",
                                "text": "In the evening, after some difficulty, he persuaded his tutor to give him an absit to sleep at Huntingdon that night, and drove over there after dinner in a fly with Egerton, Castleton, and Grey."
                            },
                            {
                                "example_id": "28e62188-92f7-44dd-898d-3600ec82e844",
                                "sense_id": "cf4d6dd3-963b-3df3-b773-895e72409034",
                                "text": "Another associated matter was the subject of a discussion, on one occasion only, on the effect of an absit on a student's residence if he used it to be away from Cambridge from Saturday to Monday 'as is allowed at at least one College'."
                            },
                            {
                                "example_id": "380511a3-7aef-4978-90d0-8047e7d7e2cb",
                                "sense_id": "cf4d6dd3-963b-3df3-b773-895e72409034",
                                "text": "An exeat was needed to be away for the night and, in theory at least, an absit for the greater part of the day."
                            },
                            {
                                "example_id": "7f692406-29ab-4c73-a0f4-913ccf588eed",
                                "sense_id": "cf4d6dd3-963b-3df3-b773-895e72409034",
                                "text": "The following week he wrot her. 'It is a most shameful thing that he should keep me on like this...I am awfully cross because now I am not able to come home for an absit [overnight leave] on Thursday which I very much wanted to do.'"
                            }
                        ]
                    }
                ],
