                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "927e7a69-5ed1-4f2c-9796-8998b0754433",
                                                "sense_id": "ae1412ec-c05f-3107-8cbd-74659f774a0c",
                                                "text": "Die Erörterung stellt einen wichtigen Teil meiner Arbeit dar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e760ec6-f63b-3ab9-9da7-7b8bf7dfa153",
                                        "entry_id": "a970e1c2-e7fb-3486-a324-5d8153a92f3d",
                                        "glosses": [
                                            "sachbezogene sprachliche Schülerarbeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33a6d8c8-8c37-4acc-a904-29c30e1c0b2b",
                                                "sense_id": "7e760ec6-f63b-3ab9-9da7-7b8bf7dfa153",
                                                "text": "„Prozessorientiertes Schreiben, informierende und meinungsbildende Textsorten wie Erörterung, Textinterpretation, Meinungsrede, kreative Textformen, …“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1af2ccb-a26d-4964-8bd7-d366ebb3570b",
                        "source_entry_id": "9a922453-3de1-349c-ad1c-e2bd1e74ed4c",
                        "source_sense_id": "e52455a3-c886-30dd-a835-534488cc559f",
                        "target_lang_word": "Ausführung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausführung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0dfd8af-eb93-3eca-a948-96d584ed1208",
                                        "entry_id": "eae5c1a8-78a7-3322-b5a6-ff6d87b4fc62",
                                        "glosses": [
                                            "Umsetzung einer Tat, eines Plans, einer Arbeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b10d343-906c-44ba-ade1-27ff3d950c5e",
                                                "sense_id": "f0dfd8af-eb93-3eca-a948-96d584ed1208",
                                                "text": "Die beiden Männer planten einen Überfall, aber die Ausführung der Tat bereitete ihnen Probleme."
                                            },
                                            {
                                                "example_id": "b542c7bc-fd54-46ad-9b43-5b08394dcd74",
                                                "sense_id": "f0dfd8af-eb93-3eca-a948-96d584ed1208",
                                                "text": "„In den letzten Jahren seiner Regierung plante Konstantin eine groß angelegte Militäraktion gegen die Perser, die aber durch seinen plötzlichen Tod nicht zur Ausführung kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7e15134-d84b-37bc-afa3-a0c080e49d45",
                                        "entry_id": "eae5c1a8-78a7-3322-b5a6-ff6d87b4fc62",
                                        "glosses": [
                                            "Art der Herstellung, Fertigung eines Produktes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d55fcaf5-a858-4eef-8c88-62251f527023",
                                                "sense_id": "a7e15134-d84b-37bc-afa3-a0c080e49d45",
                                                "text": "Dieses Produkt ist eine besonders robuste Ausführung unserer Serie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fcd763fc-a615-3edd-9821-fda600c65560",
                                        "entry_id": "eae5c1a8-78a7-3322-b5a6-ff6d87b4fc62",
                                        "glosses": [
                                            "(Aus)gestaltung, Entwurf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c932b00-59ad-4486-8779-ba7f7f3f2e56",
                                                "sense_id": "fcd763fc-a615-3edd-9821-fda600c65560",
                                                "text": "Die Ausführung seiner neuen Idee ist sehr interessant."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "27a58be7-5111-3bb9-bfc8-02cafd91129c",
                                        "entry_id": "eae5c1a8-78a7-3322-b5a6-ff6d87b4fc62",
                                        "glosses": [
                                            "Erklärung, Schilderung"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af709313-59aa-42c3-befa-2e0a47a44ba2",
                                                "sense_id": "27a58be7-5111-3bb9-bfc8-02cafd91129c",
                                                "text": "Wie Sie meinen Ausführungen entnehmen konnten, sind wir betrogen worden."
                                            },
                                            {
                                                "example_id": "7bd89661-8313-4e28-97a9-6ca82df544f1",
                                                "sense_id": "27a58be7-5111-3bb9-bfc8-02cafd91129c",
                                                "text": "„Indem sich die Generationen nach Augustus sein Axiom der Machterhaltung zu Eigen machten, zeigen uns die Ausführungen des Tacitus, wie sehr die Wirkung der augusteischen Gedankengänge über ihren Schöpfer hinaus in Geltung blieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8e65bb2-9bc9-4187-a429-8d2525a1c13d",
                        "source_entry_id": "9a922453-3de1-349c-ad1c-e2bd1e74ed4c",
                        "source_sense_id": "e52455a3-c886-30dd-a835-534488cc559f",
                        "target_lang_word": "Plädoyer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plädoyer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8c91213-4b7c-31e1-a64f-0aa68cde8a0d",
                                        "entry_id": "bdaab5c5-7777-367b-87c4-fde13f02ed46",
                                        "glosses": [
                                            "zusammenfassende Rede vor Gericht, die von Rechtsanwälten und Staatsanwälten gehalten wird"
                                        ],
                                        "tags": [
                                            "Rechtssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85632609-c765-4c73-a04d-4c6daf7f9c31",
                                                "sense_id": "a8c91213-4b7c-31e1-a64f-0aa68cde8a0d",
                                                "text": "„Im Prozess um den Mord an der Schülerin Sonja vor 22 Jahren wird am Freitag das Plädoyer der Verteidigung vor dem Landgericht Stade erwartet.“"
                                            },
                                            {
                                                "example_id": "d236610e-29b9-4e6f-9f04-fc70acf50269",
                                                "sense_id": "a8c91213-4b7c-31e1-a64f-0aa68cde8a0d",
                                                "text": "Im Plädoyer beweist der Staatsanwalt die Schuld des Angeklagten und weist darauf hin, daß eine Bestrafung für die begangene Straftat unabwendbar ist."
                                            },
                                            {
                                                "example_id": "32dc6ee2-d738-4ce1-a5d6-989146764af3",
                                                "sense_id": "a8c91213-4b7c-31e1-a64f-0aa68cde8a0d",
                                                "text": "„Seine millionenschweren Manipulationen werteten die Staatsanwälte in ihrem Plädoyer jedenfalls nicht als organisierte Kriminalität, sondern als dreistes Bubenstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "521b619d-1455-3060-a5a5-8c57d7c15324",
                                        "entry_id": "bdaab5c5-7777-367b-87c4-fde13f02ed46",
                                        "glosses": [
                                            "ausführlicher Appell, mit dem jemand etwas entschieden befürwortet oder ablehnt"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3d73a58-6fa0-4e13-8fe1-e9d4b7292ec1",
                                                "sense_id": "521b619d-1455-3060-a5a5-8c57d7c15324",
                                                "text": "„Die Stadt Nagold liegt ihm am Herzen. Und so verwundert es auch nicht, dass Altstadtrat Paul Baitinger seine Abschiedsrede nicht nur dazu nutzte, den Weggefährten zu danken. Mit einem flammenden Plädoyer für eine bessere Sicht- und Wegebeziehung zur Ruine auf dem Schlossberg setzte er zum Abschluss noch mal ein Ausrufezeichen.“."
                                            },
                                            {
                                                "example_id": "6ff3b10e-478b-47b6-838b-24492166a714",
                                                "sense_id": "521b619d-1455-3060-a5a5-8c57d7c15324",
                                                "text": "„Gaucks Plädoyer für die Freiheit steht auf Platz eins der Bestsellerliste, aber er weiß, dass die Deutschen die Freiheit ähnlich achten wie einen alten Gebrauchtwagen.“"
                                            },
                                            {
                                                "example_id": "138ccb12-361d-4b6a-95b8-4aecd4aaa927",
                                                "sense_id": "521b619d-1455-3060-a5a5-8c57d7c15324",
                                                "text": "„Seine Rede ist ein Plädoyer für Europa aus reinen Vernunftgründen.“"
                                            },
                                            {
                                                "example_id": "32fd48f1-4d63-42f2-82cf-e9b55560ae95",
                                                "sense_id": "521b619d-1455-3060-a5a5-8c57d7c15324",
                                                "text": "„Weder ein Plädoyer für eine Alleinherrschaft ohne Wenn und Aber und ohne verfassungsmäßige Einhegung noch jakobinische Parteigängerei konnte er seinen Figuren in den Mund legen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27fae2cb-6f57-4317-a65f-805c8c56f6fc",
                        "source_entry_id": "9a922453-3de1-349c-ad1c-e2bd1e74ed4c",
                        "source_sense_id": "e52455a3-c886-30dd-a835-534488cc559f",
