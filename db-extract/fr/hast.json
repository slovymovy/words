                            {
                                "example_id": "cb7bfb45-fc0f-4ff9-8db5-28b915884ab9",
                                "sense_id": "fbe93c41-c89e-3c18-a1b8-8e56ddf1f392",
                                "text": "Ils grimpèrent un petit escalier de pierre, en vis, à l’aide d’une corde servant d’écuyer et luisante par le frottement, comme la hast d’une pertuisane."
                            }
                        ]
                    },
                    {
