                "senses": [
                    {
                        "sense_id": "b20c0d12-b637-316d-b7d9-3a4b4781699e",
                        "entry_id": "2b1e43cc-6582-36a8-abd8-5c8ac19922e3",
                        "glosses": [
                            "von Hand gefertigte, aus Russland stammende Schachtelpuppe aus Birken- oder Lindenholz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1469e6c2-a58c-4349-98f4-207479ef9f5a",
                                "sense_id": "b20c0d12-b637-316d-b7d9-3a4b4781699e",
                                "text": "Sie stellt die Matroschka zur Dekoration aus."
                            },
                            {
                                "example_id": "2fbe002d-3242-464e-9d8a-b4953da8e42a",
                                "sense_id": "b20c0d12-b637-316d-b7d9-3a4b4781699e",
                                "text": "Sie schachtelt die Matroschka ineinander."
                            },
                            {
                                "example_id": "9d06bdec-de5f-4a1a-a861-301d0226cade",
                                "sense_id": "b20c0d12-b637-316d-b7d9-3a4b4781699e",
                                "text": "„Wir hatten, wenn überhaupt, unterwegs nur sehr leise miteinander gesprochen, nicht mit Wodkaflaschen gewunken und weder Matroschkas noch Balaleikas in den Händen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38e15a77-293b-4bf9-abc7-c3cd85096ad0",
                        "source_entry_id": "2b1e43cc-6582-36a8-abd8-5c8ac19922e3",
                        "source_sense_id": "b20c0d12-b637-316d-b7d9-3a4b4781699e",
                        "source_sense_description": "von Hand gefertigte, aus Russland stammende Schachtelpuppe aus Holz",
                        "target_lang_word": "matryoshka",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matryoshka",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0be3da59-53b1-39b5-9b57-ac62b6cfe01a",
                                        "entry_id": "ae996ab7-b0f3-3f38-b3f2-35243c117308",
                                        "glosses": [
                                            "One of a set of wooden Russian dolls of different sizes, designed such that each fits inside the next."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ac7d05-755b-475d-9ac3-ab94b5e91fa0",
                                                "sense_id": "0be3da59-53b1-39b5-9b57-ac62b6cfe01a",
                                                "text": "The past is not only a foreign country that we half knew existed; it is hiding another concealed country behind it, and behind that one, another, and another – like a set of Russian matryoshki, in which larger dolls conceal smaller."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba94061d-dec7-4941-97c0-7e65c1fbd84c",
                        "source_entry_id": "2b1e43cc-6582-36a8-abd8-5c8ac19922e3",
                        "source_sense_id": "b20c0d12-b637-316d-b7d9-3a4b4781699e",
                        "source_sense_description": "von Hand gefertigte, aus Russland stammende Schachtelpuppe aus Holz",
                        "target_lang_word": "poupée russe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poupée russe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e9f3e67-313f-3da4-a902-c4e07a90f8c5",
                                        "entry_id": "396ff181-ed8a-309d-8ef9-7364e0aa3ab1",
                                        "glosses": [
                                            "Une des poupées d’un jeu de poupées russes dont les éléments, de taille décroissante, se placent les uns à l’intérieur des autres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c09d9e34-ce9a-3151-ae4f-8ca359e88cd4",
                                        "entry_id": "396ff181-ed8a-309d-8ef9-7364e0aa3ab1",
                                        "glosses": [
                                            "Structure de type gigogne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "note": "Ce terme est généralement utilisé au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "ac0cb665-265a-4537-8389-dec94bfcfb22",
                                                "sense_id": "c09d9e34-ce9a-3151-ae4f-8ca359e88cd4",
                                                "text": "Enfin, bon, j’ai tellement râlé, à la maison, que les profs étaient des aztèques et des dégénérés (dégénéré, c’était le mot à la mode), que j’en avais archimarre de perdre mon temps à des conneries (je faisais l’école buissonnière au moins deux jours par semaine, pas par plaisir mais à cause de devoirs que je pouvais pas rendre parce que pas faits, ce qui entraînait un enchaînement de mensonges, de signatures truquées et de remords en poupées russes…), qu’à la fin maman m’a dit :\n« Tu préfères aller travailler ? »"
                                            },
                                            {
                                                "example_id": "fb357749-654e-4ea2-a7d4-c61cc3ba5051",
                                                "sense_id": "c09d9e34-ce9a-3151-ae4f-8ca359e88cd4",
                                                "text": "La logique qui sous-tendait la stratégie des poupées russes consistait à s’appuyer sur les mandats accordés à la CE pour la construction du marché unique pour glisser vers des domaines relevant de la construction étatique."
                                            },
                                            {
                                                "example_id": "657ab228-b54d-44ae-a3d9-7c70e191c67e",
                                                "sense_id": "c09d9e34-ce9a-3151-ae4f-8ca359e88cd4",
                                                "text": "L’organisation en poupées russes que propose Riley est contredite par les propositions de deux modes parallèles de production langagière ; il n’y a pas emboîtement, mais fonctionnement parallèle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
