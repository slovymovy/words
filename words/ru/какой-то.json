{
    "word_family": [
        "какой",
        "никакой",
        "всякий",
        "некоторый"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "7bda28a7-7154-3cb3-99ae-85e2156f3a1c",
                    "sense_definition": "Указывает на неопределенный, неизвестный или не названный предмет или лицо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "indefinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По <w>какой-то</w> причине он сегодня не пришел на работу.",
                            "target_lang_translations": {
                                "cs": "Z <w>nějakého</w> důvodu dnes nepřišel do práce."
                            }
                        },
                        {
                            "text": "Вас спрашивает <w>какой-то</w> человек, он ждет у входа.",
                            "target_lang_translations": {
                                "cs": "Ptá se na vás <w>nějaký</w> člověk, čeká u vchodu."
                            }
                        }
                    ],
                    "synonyms": [
                        "некий"
                    ],
                    "common_phrases": [
                        "по какой-то причине"
                    ],
                    "target_lang_definitions": {
                        "cs": "Označuje neurčitý, neznámý nebo nejmenovaný předmět či osobu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nějaký",
                                "target_lang_sense_clarification": "obecné vyjádření neurčitosti"
                            },
                            {
                                "target_lang_word": "kdosi",
                                "target_lang_sense_clarification": "pouze pro osoby"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6256dac0-631c-3b8e-b7c3-dbe2187d926b",
                    "sense_definition": "Указывает на неясное качество, подобие или неопределенный характер чего-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "indefinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это <w>какая-то</w> странная мания, я не понимаю её смысла.",
                            "target_lang_translations": {
                                "cs": "Je to <w>nějaká</w> divná mánie, nechápu její smysl."
                            }
                        },
                        {
                            "text": "В комнате стоял <w>какой-то</w> неприятный запах.",
                            "target_lang_translations": {
                                "cs": "V pokoji byl cítit <w>nějaký</w> nepříjemný zápach."
                            }
                        }
                    ],
                    "synonyms": [
                        "неопределённый"
                    ],
                    "target_lang_definitions": {
                        "cs": "Označuje nejasnou kvalitu, podobu nebo neurčitý charakter něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nějaký",
                                "target_lang_sense_clarification": "vyjádření neurčité vlastnosti"
                            },
                            {
                                "target_lang_word": "podivný",
                                "target_lang_sense_clarification": "v kontextu nejasného či neobvyklého charakteru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "785f6069-c3aa-341c-83f6-78e2cd843d1c",
                    "sense_definition": "Используется для сравнения, подчеркивая сходство с кем-то или чем-то.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он ведет себя как <w>какой-то</w> герой из старой книги.",
                            "target_lang_translations": {
                                "cs": "Chová se jako <w>nějaký</w> hrdina ze staré knihy."
                            }
                        },
                        {
                            "text": "Это не просто дождь, а <w>какой-то</w> настоящий ураган.",
                            "target_lang_translations": {
                                "cs": "To není jen déšť, ale <w>nějaký</w> skutečný uragán."
                            }
                        }
                    ],
                    "synonyms": [
                        "словно"
                    ],
                    "target_lang_definitions": {
                        "cs": "Používá se pro přirovnání, zdůrazňuje podobnost s někým nebo něčím."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jako nějaký",
                                "target_lang_sense_clarification": "zdůraznění přirovnání"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19b1f3f7-239f-3ed8-b860-32e11c247095",
                    "sense_definition": "Указывает на пренебрежительное отношение к неизвестному лицу или предмету.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "indefinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он опять связался с <w>каким-то</w> шалопаем.",
                            "target_lang_translations": {
                                "cs": "Zase se zapletl s <w>nějakým</w> uličníkem."
                            }
                        },
                        {
                            "text": "Не хочу слушать советы от <w>какого-то</w> незнакомца.",
                            "target_lang_translations": {
                                "cs": "Nechci poslouchat rady od <w>nějakého</w> cizince."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Označuje pohrdavý postoj k neznámé osobě nebo předmětu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nějaký",
                                "target_lang_sense_clarification": "v pejorativním smyslu"
                            },
                            {
                                "target_lang_word": "kdovíkdo",
                                "target_lang_sense_clarification": "vyjádření nedůležitosti či pochybnosti o osobě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50862167-9467-311d-a66f-aabaac501be9",
                    "sense_definition": "Используется в вопросах для выражения неясности или сомнения относительно качества.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "question",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Лето было дождливое, <w>какая-то</w> будет осень?",
                            "target_lang_translations": {
                                "cs": "Léto bylo deštivé, <w>jaký</w> bude podzim?"
                            }
                        },
                        {
                            "text": "Ты купил подарок, но <w>какой-то</w> он странный?",
                            "target_lang_translations": {
                                "cs": "Koupil jsi dárek, ale <w>jaký</w> je divný?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Používá se v otázkách k vyjádření nejasnosti nebo pochybnosti ohledně kvality."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jaký",
                                "target_lang_sense_clarification": "tázací zájmeno pro vlastnost"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}