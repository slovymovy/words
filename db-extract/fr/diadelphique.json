                        "examples": [
                            {
                                "example_id": "c4ee72fd-5b9c-4d94-b438-433a142d9590",
                                "sense_id": "bdbf3ee0-7e4c-332d-97e6-b340bf84b1ba",
                                "text": "Cette classe comprend les plantes diadelphiques, c’est-à-dire, celle qui ont deux frères, ou leur étamines réunis en deux corps par leurs filets."
                            },
                            {
                                "example_id": "194e838a-05e1-4039-8752-b4e46e576fde",
                                "sense_id": "bdbf3ee0-7e4c-332d-97e6-b340bf84b1ba",
                                "text": "Ce genre fait partie de la 22ᵉ classe de Tournefort, qui comprend les arbres à fleurs papilionnacés , de la 17ᵉ de Linné, destinée aux plantes diadelphiques décandriques, et de la 14ᵉ de Jussieu, ordre 11 , famille des légumineuses."
                            }
                        ]
