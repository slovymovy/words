                    {
                        "translation_id": "d98c6026-b81f-421c-a3c6-f914bd5b993d",
                        "source_entry_id": "7358d9c8-5a2f-3190-98d3-ed8a2dd566fc",
                        "source_sense_id": "cb575898-ae4e-34b7-924e-678af39df455",
                        "source_sense_description": "Désorienté.",
                        "target_lang_word": "ratlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ratlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "579bc538-3b76-3515-a5e6-d916d82564f5",
                                        "entry_id": "37873a92-7d41-3807-8771-9e99fb691fdc",
                                        "glosses": [
                                            "unsicher, nicht wissend, was zu tun ist; keinen Rat wissend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b8a7a5-c9e9-4705-92cb-9452cea4cafa",
                                                "sense_id": "579bc538-3b76-3515-a5e6-d916d82564f5",
                                                "text": "Seit Wochen überlege ich, welches Geschenk meiner Mutter Freude machen würde, aber ich bin völlig ratlos."
                                            },
                                            {
                                                "example_id": "4d975d42-f3bf-4e07-ba25-d32934227adb",
                                                "sense_id": "579bc538-3b76-3515-a5e6-d916d82564f5",
                                                "text": "Sie brach in Tränen aus und ließ mich ratlos zurück."
                                            },
                                            {
                                                "example_id": "22437112-415f-427e-9665-d8c6b2a2352a",
                                                "sense_id": "579bc538-3b76-3515-a5e6-d916d82564f5",
                                                "text": "Der Lehrer fragte seine Schüler nach ihrem Lieblingsphilosophen und sah sich nur ratlosen Gesichtern gegenüber."
                                            },
                                            {
                                                "example_id": "2d29e40f-a29d-46dc-be4d-90cf297dae25",
                                                "sense_id": "579bc538-3b76-3515-a5e6-d916d82564f5",
                                                "text": "„Die Forscher der Nasa sind ratlos. Sie haben einen neuen Planeten entdeckt, der bislang nie beobachtete Eigenschaften aufweist: Auf 18 Stunden Sonnenschein folgen genau 6 Stunden Dunkelheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fda4fde-f96b-4861-9cb0-7515c3af0c7d",
                        "source_entry_id": "7358d9c8-5a2f-3190-98d3-ed8a2dd566fc",
                        "source_sense_id": "cb575898-ae4e-34b7-924e-678af39df455",
                        "source_sense_description": "Désorienté.",
                        "target_lang_word": "hilflos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hilflos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c81a56f-2cc8-3222-826b-7dbfc60e8f90",
                                        "entry_id": "d658fb20-aa9a-3289-b8ee-81f21faef271",
                                        "glosses": [
                                            "nicht in der Lage, allein zurechtzukommen/sich selbst zu helfen; auf Hilfe angewiesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2b0bc04-ab56-486f-acb4-9b61072c3f10",
                                                "sense_id": "4c81a56f-2cc8-3222-826b-7dbfc60e8f90",
                                                "text": "„Mein Vater muss sich sehr hilflos vorgekommen sein, abhängig von seinen halbwüchsigen Kindern.“"
                                            },
                                            {
                                                "example_id": "0470cb6b-4ac2-4236-aefe-e31fc4117aa4",
                                                "sense_id": "4c81a56f-2cc8-3222-826b-7dbfc60e8f90",
                                                "text": "„Kinder sind ausgeprägte Sinnsucher; insofern ist auch bei diesem unglückseligen Vorfall zunächst nicht von einem Wegwerfen des Lebens auszugehen, sondern von einer – wenn auch hilflosen, vielleicht pervertierten- Sinnsuche, die in einem tödlichen Unfall endete.“"
                                            },
                                            {
                                                "example_id": "e0d30d85-cc83-4126-90e7-89aa7006c92a",
                                                "sense_id": "4c81a56f-2cc8-3222-826b-7dbfc60e8f90",
                                                "text": "„Der Vogel, von der Größe einer Taube, schüttelte die verstaubten Federn seines seit einer Ewigkeit unbenutzten Gefieders, stakste unsicher auf dem Fußboden umher, machte einen hilflosen Flugversuch und hüpfte schließlich durch eine Tür, die sich rechts des gewaltigen Kamins auftat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7dd68591-44f3-3e08-8bb4-0032d863fba8",
                                        "entry_id": "d658fb20-aa9a-3289-b8ee-81f21faef271",
                                        "glosses": [
                                            "nicht in der Lage, jemandem zu helfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d40764a-1bb5-4988-9a10-7f4d39d0a6b3",
                                                "sense_id": "7dd68591-44f3-3e08-8bb4-0032d863fba8",
                                                "text": "„Die Bevölkerung wurde grosso modo mit hilflosen Ratschlägen und finanziellen Zuschüssen für Privatbunker unter dem Eigenheim abgespeist, zudem entstand hier und da ein Notbehelf in Bahnhöfen und Parkhäusern, U-Bahnschächten und Schulen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d36228f6-7619-3a77-865f-ffc7cd630c91",
                                        "entry_id": "d658fb20-aa9a-3289-b8ee-81f21faef271",
                                        "glosses": [
                                            "intellektuell überfordert"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
