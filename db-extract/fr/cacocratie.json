                                "target_senses": [
                                    {
                                        "sense_id": "46f9490f-b695-3faa-8601-0176611f1161",
                                        "entry_id": "af87eeb4-ca60-39fb-8842-5669f95f4352",
                                        "glosses": [
                                            "Rule or government by the worst of the people."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncommon",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dcd6b80-65b0-4697-b2f4-61da2479d494",
                                                "sense_id": "46f9490f-b695-3faa-8601-0176611f1161",
                                                "text": "[T]he degrading sentiments of the mere rabble are unblushingly avowed in their Legislature. The constitution of the United States seems on the eve of changing from a democracy—for demos elevates the whole people—to a kakocracy."
                                            },
                                            {
                                                "example_id": "b0249ff5-ab8f-4e1a-ad6d-aae993df5e28",
                                                "sense_id": "46f9490f-b695-3faa-8601-0176611f1161",
                                                "text": "In other words, we have developed a kakocracy, or government by the worst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
