                "senses": [
                    {
                        "sense_id": "bab87dcc-9e16-39aa-8eb3-bc91458884f3",
                        "entry_id": "816560ee-affe-3030-82a5-714b50954fe9",
                        "glosses": [
                            "To take away; rob; deprive; ravish"
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "761e6041-12bb-4741-8c2b-18d0e1d0d21e",
                                "sense_id": "bab87dcc-9e16-39aa-8eb3-bc91458884f3",
                                "text": "And on the right hand were two flowers like a lily, and the one would have benome the others whiteness, but a good man departed them that the one touched not the other; and then out of every flower came out many flowers, and fruit great plenty."
                            },
                            {
                                "example_id": "d81cf6a2-1473-4701-b610-759090bd5ed2",
                                "sense_id": "bab87dcc-9e16-39aa-8eb3-bc91458884f3",
                                "text": "Benombe of ones lymbes […]\n[…] He is now benomme of his lymmes."
                            },
                            {
                                "example_id": "5d8edd58-02d1-4faf-8a59-5ff037e4a409",
                                "sense_id": "bab87dcc-9e16-39aa-8eb3-bc91458884f3",
                                "text": "Alas ! it benimeth from man his wit and his reason, and all his debonaire life spiritual that should keep his soul. Certes it benimeth also God's due lordship (and that is man's soul) and the love of his neighbours : […]"
                            },
                            {
                                "example_id": "ae54e877-0101-4982-ba38-16cd354a4e72",
                                "sense_id": "bab87dcc-9e16-39aa-8eb3-bc91458884f3",
                                "text": "To visit I should much prefer\nSome sick but wealthy usurer :\nWith patience would I comfort him,\nIn hope some deniers to benimme,\nAnd when pale death steals o'er his face,\nTransport him to the burial-place."
                            },
                            {
                                "example_id": "20e6f36b-2fd8-4eb5-a475-2ff4f739396b",
                                "sense_id": "bab87dcc-9e16-39aa-8eb3-bc91458884f3",
                                "text": "[…] by his name maketh clepe him and name him Rude Intendment hath made him an espier of ways and a waiter [waylayer] of pilgrims and will benim [rob] them their burdons and unscrip them of their scrips, beguiling them with lying words."
                            }
                        ]
                    }
