                "senses": [
                    {
                        "sense_id": "20d491e7-155d-36a5-ac66-7ef526f0626b",
                        "entry_id": "01e798ef-9eaf-3d5d-9b11-f017ebf035c2",
                        "glosses": [
                            "Enfant la plus âgée d’une famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1547f66-47f0-461e-ab21-aa66b2fbe901",
                                "sense_id": "20d491e7-155d-36a5-ac66-7ef526f0626b",
                                "text": "Mon arrière-grand-mère juive et mon arrière-grand-père palestinien ont eu neuf enfants. Ma grand-mère était l’aînée. L’histoire s'est vraiment compliquée pendant la grande révolte arabe."
                            },
                            {
                                "example_id": "5f97a241-4b4f-4e63-99a8-a08753ae2f5c",
                                "sense_id": "20d491e7-155d-36a5-ac66-7ef526f0626b",
                                "text": "Vous souvient-il d’un jour, le premier de l’année,\nOù le divin sourire illumina les yeux,\nOù mon âme en votre âme adora son aînée,\nOù votre cœur m’aime, doux et silencieux..?\nVous souvient-il un jour, le premier de l’année."
                            }
                        ]
                    }
                ],
