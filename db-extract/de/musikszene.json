                "senses": [
                    {
                        "sense_id": "c34615bf-4772-37e9-b245-efd02766089b",
                        "entry_id": "6afcb7e1-5914-385b-a4d0-3f8b9c3f7224",
                        "glosses": [
                            "das Umfeld, in dem Musik gemacht und konsumiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d627035-8e08-45be-95cf-26eb39470a79",
                                "sense_id": "c34615bf-4772-37e9-b245-efd02766089b",
                                "text": "„In der gegenwärtigen Musikszene findet er \"das Ungewöhnliche in solchem Überfluß\", daß er \"wieder mehr zu den Wurzeln zurückgehen wollte\". Aus seinen früheren Images hat sich Bowie, so schätzt er, endgültig gehäutet.“"
                            },
                            {
                                "example_id": "0ff5985b-01b1-4d43-b75c-1115acd30d77",
                                "sense_id": "c34615bf-4772-37e9-b245-efd02766089b",
                                "text": "„Sie schien aus der Musikszene abgetaucht zu sein.“"
                            },
                            {
                                "example_id": "db69625e-ef19-4bcb-a82d-6be00a78a90e",
                                "sense_id": "c34615bf-4772-37e9-b245-efd02766089b",
                                "text": "„Seine Verse fanden zudem weite Verwendung in Filmen und der Musikszene.“"
                            }
                        ],
