                        "form_id": "b61e3a89-2ca4-49c2-89e5-4be690d9307b",
                        "entry_id": "5869a8b6-1fd2-3f36-9b84-442a1429fa21",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "vised"
                    },
                    {
                        "form_id": "032ed80a-9e32-40da-96f3-d09fc253f75b",
                        "entry_id": "5869a8b6-1fd2-3f36-9b84-442a1429fa21",
                        "tags": [
                            "past"
                        ],
                        "form": "vised"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac40a25b-4d57-320d-aa4f-8304ca9dc5dd",
                        "entry_id": "5869a8b6-1fd2-3f36-9b84-442a1429fa21",
                        "glosses": [
                            "To clamp with or as with a vise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463df4bd-861b-4794-8e0d-23444ecca438",
                                "sense_id": "ac40a25b-4d57-320d-aa4f-8304ca9dc5dd",
                                "text": "He looked to see the secretary, vised and crackled in those arms, drop limp and senseless."
                            },
                            {
                                "example_id": "5595b100-2934-4924-ba93-5026a8438c23",
                                "sense_id": "ac40a25b-4d57-320d-aa4f-8304ca9dc5dd",
                                "text": "Repeat this step to make the bend at the other 39-inch mark being careful that it is also at a 90° angle to the vised pipe, and also parallel to the first bend."
                            },
                            {
                                "example_id": "ab0954f4-8cf6-4e62-a41f-5e246144b974",
                                "sense_id": "ac40a25b-4d57-320d-aa4f-8304ca9dc5dd",
                                "text": "“There's my girl,” he whispered. He reached back to lift each of her legs to vise her knees under his arms."
                            },
                            {
                                "example_id": "522f628a-f107-4b4f-a464-3eb44c673709",
                                "sense_id": "ac40a25b-4d57-320d-aa4f-8304ca9dc5dd",
                                "text": "I do clearly remember the last part of that conversation, because it involved Athena promising that the next time she saw me, she was going to vise my jaws open and shit down my throat."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f99f70ff-5a48-3c74-9b92-dde9694e4557",
