                "senses": [
                    {
                        "sense_id": "f0b7323d-58b6-3c53-9789-36789067eb6b",
                        "entry_id": "a9f0737d-4bbe-320e-b3d0-66f91313c740",
                        "glosses": [
                            "to cut off"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ab27187c-3191-46da-9801-adba5c09c025",
                                "sense_id": "f0b7323d-58b6-3c53-9789-36789067eb6b",
                                "text": "— Колбаса́ отврати́тельная, — помо́рщился он, отре́зывая себе́ кусо́чек. — В зде́шней ла́вочке продаю́т дрянь, но деру́т ужа́сно… Я бы вам одолжи́л кусо́чек, но вы едва́ ли согласи́тесь ку́шать. Хоти́те?",
                                "translation": "\"The sausage is disgusting,\" he said, frowning and cutting himself off a little bit. \"In the shop here they sell you rubbish and fleece you horribly. . . . I would offer you a piece, but you would scarcely care to consume it. Will you have some?\"",
                                "english": "\"The sausage is disgusting,\" he said, frowning and cutting himself off a little bit. \"In the shop here they sell you rubbish and fleece you horribly. . . . I would offer you a piece, but you would scarcely care to consume it. Will you have some?\""
                            }
                        ]
                    }
