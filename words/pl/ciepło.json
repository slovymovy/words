                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przyjęła nas z wielkim <w>ciepłem</w> w swoim domu.",
                            "target_lang_translations": {
                                "en": "She welcomed us into her home with great <w>warmth</w>.",
                                "ru": "Она приняла нас в своём доме с большой <w>теплотой</w>.",
                                "nl": "Ze ontving ons met grote <w>hartelijkheid</w> in haar huis.",
                                "de": "Sie empfing uns mit großer <w>Wärme</w> in ihrem Haus.",
                                "fr": "Elle nous a accueillis avec beaucoup de <w>chaleur</w> chez elle.",
                                "it": "Ci ha accolto con grande <w>calore</w> nella sua casa.",
                                "cs": "Přivítala nás ve svém domě s velkou <w>srdečností</w>.",
                                "tr": "Bizi evinde büyük bir <w>sıcaklıkla</w> karşıladı.",
                                "es": "Nos acogió con gran <w>calidez</w> en su casa.",
                                "zh": "她在家里以极大的<w>温情</w>接待了我们。"
                            }
                        },
                        {
                            "text": "W jej głosie słychać było <w>ciepło</w> i troskę.",
                            "target_lang_translations": {
                                "en": "One could hear <w>warmth</w> and care in her voice.",
                                "ru": "В её голосе слышались <w>тепло</w> и забота.",
                                "nl": "In haar stem klonken <w>warmte</w> en bezorgdheid door.",
                                "de": "In ihrer Stimme waren <w>Wärme</w> und Fürsorge zu hören.",
                                "fr": "On pouvait entendre de la <w>chaleur</w> et de la sollicitude dans sa voix.",
                                "it": "Nella sua voce si percepivano <w>calore</w> e premura.",
                                "cs": "V jejím hlase bylo slyšet <w>teplo</w> a starost.",
                                "tr": "Sesinde <w>sıcaklık</w> ve şefkat duyuluyordu.",
                                "es": "En su voz se notaba <w>calidez</w> y preocupación.",
                                "zh": "从她的声音里可以听出<w>温暖</w>与关切。"
                            }
