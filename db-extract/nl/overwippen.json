                        "glosses": [
                            "even ergens naartoe gaan; even bezoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bdf3be4-e291-4eb0-a37e-35a1075f9429",
                                "sense_id": "c542bc08-4208-3a1a-8016-c03c414fff65",
                                "text": "Agendamatig is een bezoek aan de Vierdaagse voor Willem-Alexander lastig, want dit nationale breedtesportevenement valt precies in de schoolvakantie van zijn dochters. Maar daar valt wel een mouw aan te passen. Met het regeringsvliegtuig kan de koning even van zijn Griekse vakantievilla naar Nijmegen overwippen. Als hij tenminste vakantie houdt in Griekenland, want de koninklijke vakantieplannen zijn geheim."
                            }
                        ]
                    }
