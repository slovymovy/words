{
    "word_family": [
        "idool",
        "idolatrie"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "84dda123-fdaa-339b-9ec2-6dfa3f79a513",
                    "sense_definition": "iets of iemand overdreven bewonderen en daar op een emotionele manier uiting aan geven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewondering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge voetballer is helemaal <w>idolaat</w> van Ruud Gullit.",
                            "target_lang_translations": {
                                "en": "The young football player is completely <w>infatuated</w> with Ruud Gullit."
                            }
                        },
                        {
                            "text": "Zij is al jarenlang <w>idolaat</w> van die zanger en heeft al zijn posters.",
                            "target_lang_translations": {
                                "en": "She has been <w>crazy about</w> that singer for years and has all his posters."
                            }
                        }
                    ],
                    "synonyms": [
                        "afgodisch",
                        "dweperig",
                        "verzot",
                        "weg"
                    ],
                    "common_phrases": [
                        "idolaat van iemand"
                    ],
                    "target_lang_definitions": {
                        "en": "to admire something or someone excessively and express it in an emotional way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "infatuated",
                                "target_lang_sense_clarification": "with someone or something"
                            },
                            {
                                "target_lang_word": "crazy about",
                                "target_lang_sense_clarification": "informal, intense liking"
                            },
                            {
                                "target_lang_word": "besotted",
                                "target_lang_sense_clarification": "blindly in love or admiring"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "018e48bb-8509-3975-899e-05d09cc1d2eb",
                    "sense_definition": "met een blinde of overdreven verering voor een persoon of zaak",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bewondering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>idolate</w> verering voor de leider werd door velen bekritiseerd.",
                            "target_lang_translations": {
                                "en": "His <w>idolatrous</w> worship of the leader was criticized by many."
                            }
                        },
                        {
                            "text": "De fans gedroegen zich bijna <w>idolaat</w> tijdens het concert van hun held.",
                            "target_lang_translations": {
                                "en": "The fans behaved almost <w>adoringly</w> during their hero's concert."
                            }
                        }
                    ],
                    "synonyms": [
                        "afgodisch"
                    ],
                    "target_lang_definitions": {
                        "en": "with a blind or excessive worship for a person or cause"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idolatrous",
                                "target_lang_sense_clarification": "excessive devotion"
                            },
                            {
                                "target_lang_word": "adoring",
                                "target_lang_sense_clarification": "showing deep love and respect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dcb25ac-8b48-3cd1-a5a6-d17ba2f9234c",
                    "sense_definition": "betrekking hebbend op de verering van afgoden",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de oudheid werden vaak <w>idolate</w> praktijken uitgevoerd in deze tempels.",
                            "target_lang_translations": {
                                "en": "In ancient times, <w>idolatrous</w> practices were often carried out in these temples."
                            }
                        },
                        {
                            "text": "De missionarissen probeerden de <w>idolate</w> gewoonten van de lokale bevolking te veranderen.",
                            "target_lang_translations": {
                                "en": "The missionaries tried to change the <w>idolatrous</w> habits of the local population."
                            }
                        }
                    ],
                    "synonyms": [
                        "afgodisch"
                    ],
                    "target_lang_definitions": {
                        "en": "relating to the worship of idols"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idolatrous",
                                "target_lang_sense_clarification": "pertaining to idol worship"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}