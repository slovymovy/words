                                        "examples": [
                                            {
                                                "example_id": "759ba5fd-d8f4-4714-9301-d9c745e723c4",
                                                "sense_id": "e4062ccb-2e34-38b5-b0fd-32949b646ea2",
                                                "text": "All societies have three key interlocking elements: Religion, economics, and politics."
                                            }
                                        ]
