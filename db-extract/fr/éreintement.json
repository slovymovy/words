        "fr-extract.jsonl": [
            {
                "entry_id": "d87ed659-f24e-3a92-b0a0-e8dcd8293bb9",
                "word": "éreintement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ee21b283-87c9-4bba-961a-afaf03cd94b3",
                        "entry_id": "d87ed659-f24e-3a92-b0a0-e8dcd8293bb9",
                        "tags": [
