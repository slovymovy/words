                                "sense_id": "bdd14ba5-53da-3575-87cf-b45915fd9075",
                                "text": "„Erst nach einer längeren Inkubationszeit wurden die Impulse Freges aufgegriffen und in größerem Umfang realisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
