                    {
                        "translation_id": "a4997a87-2b51-450a-babd-fa47a8e80f33",
                        "source_entry_id": "ccc0dd98-b96d-30e2-a826-5cc1a5bae20c",
                        "source_sense_id": "0d8658eb-20df-3e6c-8173-208ecbc459c0",
                        "source_sense_description": "translucent gemstone",
                        "target_lang_word": "maansteen",
