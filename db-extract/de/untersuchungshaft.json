                "senses": [
                    {
                        "sense_id": "35d9819f-2d1a-3c5d-ac79-205918932363",
                        "entry_id": "d74602c6-d164-3606-9859-f080e409e47d",
                        "glosses": [
                            "Freiheitsentzug vor oder während polizeilicher Ermittlungen oder einer gerichtlichen Verhandlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66472790-4f80-4214-9e6b-70dc662302cf",
                                "sense_id": "35d9819f-2d1a-3c5d-ac79-205918932363",
                                "text": "Vom Staatsanwalt wurde Untersuchungshaft beantragt, da Fluchtgefahr bestand."
                            },
                            {
                                "example_id": "b818b6e6-a134-4949-a344-ea2f87d46150",
                                "sense_id": "35d9819f-2d1a-3c5d-ac79-205918932363",
                                "text": "„Der Traum aus den ersten Wochen seiner Untersuchungshaft ist wiedergekommen, jetzt in dieser Nacht.“"
                            },
                            {
                                "example_id": "a5927e4a-237d-4af0-b2ac-9e571643d7a9",
                                "sense_id": "35d9819f-2d1a-3c5d-ac79-205918932363",
                                "text": "„Wie man mit ihm umging, machte deutlich, daß die Sache mehr als eine bloße Untersuchungshaft war.“"
                            },
                            {
                                "example_id": "421ae2dc-222b-464e-8254-c74a6ad08093",
                                "sense_id": "35d9819f-2d1a-3c5d-ac79-205918932363",
                                "text": "„Am Abend wurde Untersuchungshaft angeordnet.“"
                            },
                            {
                                "example_id": "7ee88f64-4115-4b1e-b5e4-5743dd87958e",
                                "sense_id": "35d9819f-2d1a-3c5d-ac79-205918932363",
                                "text": "„Du mußt deinen Freund innerhalb zwölf Stunden gegen Kaution aus der Untersuchungshaft herausholen, es sei denn, er hat jemand aus deiner Familie umgebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
