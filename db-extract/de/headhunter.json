                "senses": [
                    {
                        "sense_id": "6a886754-06e2-3e90-b3fe-69981c7bde90",
                        "entry_id": "3bb01a6d-7a05-312c-a04d-3d5a9f4c9812",
                        "glosses": [
                            "eine Person, die gesuchte Fachkräfte an Arbeitgeber vermittelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fae8e077-5c89-4949-b13a-9442bed852ef",
                                "sense_id": "6a886754-06e2-3e90-b3fe-69981c7bde90",
                                "text": "„Am Anfang reagierte sie noch wie üblich: Sie rief Headhunter an, die sie in Vorstellungsgespräche brachten; sie baute auf ihr Netzwerk, aber es war vorbei, keiner konnte mehr irgendwem helfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27576d16-7cfb-4df1-afb1-19df6b28a1ca",
                        "source_entry_id": "3bb01a6d-7a05-312c-a04d-3d5a9f4c9812",
                        "source_sense_id": "6a886754-06e2-3e90-b3fe-69981c7bde90",
                        "source_sense_description": "eine Person, die gesuchte Fachkräfte an Arbeitgeber vermittelt",
                        "target_lang_word": "headhunter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headhunter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce73516a-6391-3c93-82dd-269b044d3e79",
                                        "entry_id": "b64d2bc5-41b1-3d28-8e14-e9ddaf55e402",
                                        "glosses": [
                                            "A person who practises headhunting, the taking and preserving of a person's head after killing them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b0edf13-de62-4ecc-b09f-0905b11d3944",
                                                "sense_id": "ce73516a-6391-3c93-82dd-269b044d3e79",
                                                "text": "Theirs was the spirit which upheld Darwin among the gauchos of the Argentine or Wallace among the head-hunters of Malaya."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bada4bd-1e7f-3f67-aed0-b85cc28f3761",
                                        "entry_id": "b64d2bc5-41b1-3d28-8e14-e9ddaf55e402",
                                        "glosses": [
                                            "One who recruits skilled personnel, especially executive-level ones, for a company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aed638ae-7108-4278-8d37-9e738f3b2d05",
                                                "sense_id": "8bada4bd-1e7f-3f67-aed0-b85cc28f3761",
                                                "text": "Near-synonyms: recruiter, talent scout"
                                            },
                                            {
                                                "example_id": "93409954-8799-49fa-8ce1-a930b61ad2ac",
                                                "sense_id": "8bada4bd-1e7f-3f67-aed0-b85cc28f3761",
                                                "text": "A headhunter called me out of the blue with an offer I couldn't refuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c53d037-8365-3e81-a9a2-aaae1fedbf94",
                                        "entry_id": "b64d2bc5-41b1-3d28-8e14-e9ddaf55e402",
                                        "glosses": [
                                            "A pitcher who throws at the batter's head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0701d93c-589a-4570-b880-563268d65e8f",
                                                "sense_id": "9c53d037-8365-3e81-a9a2-aaae1fedbf94",
                                                "text": "Thankfully, there aren't many headhunters in the modern game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c1b36dc-f98a-3746-bf9a-0da1fef0d4bb",
                                        "entry_id": "b64d2bc5-41b1-3d28-8e14-e9ddaf55e402",
                                        "glosses": [
                                            "A player who uses a hockey stick to attempt to strike an opponent's head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "151db6b2-bd25-4c8b-923d-5b9863992f45",
                                                "sense_id": "5c1b36dc-f98a-3746-bf9a-0da1fef0d4bb",
                                                "text": "He is known as a goon and a headhunter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
