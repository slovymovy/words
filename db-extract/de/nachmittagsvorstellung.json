                "senses": [
                    {
                        "sense_id": "34633cb1-c95a-3af3-8146-ce7b22fc8572",
                        "entry_id": "75200569-50ab-3122-95eb-a3d8b11ded44",
                        "glosses": [
                            "während eines Nachmittags stattfindende Vorstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85fe3a0f-f7b2-4266-86db-90350d110913",
                                "sense_id": "34633cb1-c95a-3af3-8146-ce7b22fc8572",
                                "text": "„Ein paar Minuten ist Herr M. hier mit seinem Pkw gestanden, um die Kinder von der Nachmittagsvorstellung abzuholen.“"
                            },
                            {
                                "example_id": "e9f4574c-db2c-4805-a9d2-637a86e7f0fa",
                                "sense_id": "34633cb1-c95a-3af3-8146-ce7b22fc8572",
                                "text": "„In einer halben Stunde beginnt die erste Nachmittagsvorstellung des Zirkus auf dem Kasernenareal.“"
                            },
                            {
                                "example_id": "7799128c-788d-4736-b86d-ec2582d08703",
                                "sense_id": "34633cb1-c95a-3af3-8146-ce7b22fc8572",
                                "text": "„Anschließend Anweisungen für einen Lüftungstechniker, dazwischen schlendert ein älteres Paar gemütlich nach der Nachmittagsvorstellung an Pfeil vorbei ins Freie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
