                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72668a5b-07db-38dc-8634-7c9ebe2ec8b0",
                                        "entry_id": "35558464-7369-326e-b030-c3a73bec4c98",
                                        "glosses": [
                                            "agent noun of off"
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ee26b88-3689-41f3-b3e7-6582dfa93735",
                                                "sense_id": "72668a5b-07db-38dc-8634-7c9ebe2ec8b0",
                                                "text": "Once you finally discover yourself a dismember-er, a de-limber, a fucking head-cutter-offer, the most simple of tasks — enjoying a long walk outside, seeing a movie, conversing with a stranger in the library — all become prized and over-inflated moments of elation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "offer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b70a6770-9bb7-379d-9c4a-a40878437998",
                                        "entry_id": "1821da75-49ca-3919-ad56-b64632818746",
                                        "glosses": [
                                            "A proposal that has been made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9e6342-f690-4093-8ceb-0bdd37cbd045",
                                                "sense_id": "b70a6770-9bb7-379d-9c4a-a40878437998",
                                                "text": "What's in his offer?"
                                            },
                                            {
                                                "example_id": "fde729a5-2aa4-40fc-a65f-f8a1edd0573e",
                                                "sense_id": "b70a6770-9bb7-379d-9c4a-a40878437998",
                                                "text": "I decline your offer to contract."
                                            },
                                            {
                                                "example_id": "4dec8e23-69a5-4a9b-8d30-6e40cf42dcd9",
                                                "sense_id": "b70a6770-9bb7-379d-9c4a-a40878437998",
                                                "text": "One morning I had been driven to the precarious refuge afforded by the steps of the inn, after rejecting offers from the Celebrity to join him in a variety of amusements. But even here I was not free from interruption, for he was seated on a horse-block below me, playing with a fox terrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f785390b-067d-3f01-9e01-31a10c84f20d",
                                        "entry_id": "1821da75-49ca-3919-ad56-b64632818746",
                                        "glosses": [
                                            "Something put forth, bid, proffered or tendered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc773656-57c5-4d3f-8c67-799d28d3d893",
                                                "sense_id": "f785390b-067d-3f01-9e01-31a10c84f20d",
                                                "text": "His offer was $3.50 per share."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c37981a7-1b8e-30a9-966f-d23a17975f16",
                                        "entry_id": "1821da75-49ca-3919-ad56-b64632818746",
                                        "glosses": [
                                            "An invitation to enter into a binding contract communicated to another party which contains terms sufficiently definite to create an enforceable contract if the other party accepts the invitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf30d93a-ed50-48d6-b287-627c8be673c1",
                                                "sense_id": "c37981a7-1b8e-30a9-966f-d23a17975f16",
                                                "text": "His first letter was not a real offer, but an attempt to determine interest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "offer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7045863-b32a-3964-9e39-1065143b2588",
                                        "entry_id": "0b9d1860-f0fe-361e-8df1-83fecbb48d84",
                                        "glosses": [
                                            "To propose or express one's willingness (to do something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48012e73-ceec-476f-9a58-ac3d30e162d8",
                                                "sense_id": "d7045863-b32a-3964-9e39-1065143b2588",
                                                "text": "She offered to help with her homework."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f3082f4-0f51-36ad-aa5d-ebc590f189e2",
                                        "entry_id": "0b9d1860-f0fe-361e-8df1-83fecbb48d84",
                                        "glosses": [
                                            "To present in words; to proffer; to make a proposal of; to suggest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3227f2e-203b-48e5-8316-24c7b985aba4",
                                                "sense_id": "1f3082f4-0f51-36ad-aa5d-ebc590f189e2",
                                                "text": "Everybody offered an opinion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc99b2a0-d82a-3985-b6fa-e81584d7cc88",
                                        "entry_id": "0b9d1860-f0fe-361e-8df1-83fecbb48d84",
                                        "glosses": [
                                            "To place at someone’s disposal; to present (something) to be either accepted or turned down."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b76a74-c7b6-46f6-9db5-24bc53137428",
                                                "sense_id": "fc99b2a0-d82a-3985-b6fa-e81584d7cc88",
                                                "text": "He offered use of his car for the week."
                                            },
                                            {
                                                "example_id": "0aee7eca-f821-4d8c-959a-597c334189d1",
                                                "sense_id": "fc99b2a0-d82a-3985-b6fa-e81584d7cc88",
                                                "text": "He offered his good will for the Councilman's vote."
                                            },
                                            {
                                                "example_id": "86cebd50-d33b-406c-ba88-bd9b0350a2b5",
                                                "sense_id": "fc99b2a0-d82a-3985-b6fa-e81584d7cc88",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers,[…]. Even such a boat as the Mount Vernon offered a total deck space so cramped as to leave secrecy or privacy well out of the question, even had the motley and democratic assemblage of passengers been disposed to accord either."
                                            },
                                            {
                                                "example_id": "a4c94646-7060-4ac9-9bbc-34d5e961d751",
                                                "sense_id": "fc99b2a0-d82a-3985-b6fa-e81584d7cc88",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic[…]. Until 2008 there was denial over what finance had become.[…]But the scandals kept coming,[…]. A broad section of the political class now recognises the need for change but remains unable to see the necessity of a fundamental overhaul. Instead it offers fixes and patches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28f03f36-2351-3be9-8466-3705b593c3ce",
                                        "entry_id": "0b9d1860-f0fe-361e-8df1-83fecbb48d84",
                                        "glosses": [
                                            "To place at someone’s disposal; to present (something) to be either accepted or turned down.",
                                            "To present (something) for sale."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c94ffc8e-fa5e-3291-8856-137976a99cdb",
                                        "entry_id": "0b9d1860-f0fe-361e-8df1-83fecbb48d84",
                                        "glosses": [
                                            "To present (something) to God or gods, as a gesture of worship or as a sacrifice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66320671-db91-49ec-9013-eb1e53d805c0",
                                                "sense_id": "c94ffc8e-fa5e-3291-8856-137976a99cdb",
                                                "text": "Thou shalt offer every day a bullock for a sin offering for atonement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16660476-b698-3fa6-acc2-00b81859a350",
                                        "entry_id": "0b9d1860-f0fe-361e-8df1-83fecbb48d84",
                                        "glosses": [
                                            "To present (something) to the sight etc.; to provide for use, consideration etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75261534-c43c-4b14-8f44-cfbfa3dadf1d",
                                                "sense_id": "16660476-b698-3fa6-acc2-00b81859a350",
                                                "text": "The city offers beautiful architecture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae557c78-f742-3932-a811-c0b67f5acb23",
                                        "entry_id": "0b9d1860-f0fe-361e-8df1-83fecbb48d84",
                                        "glosses": [
                                            "To place (something) in a position where it can be added to an existing mechanical assembly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32d8ced5-f71a-4c72-a963-35d6f2882ec6",
                                                "sense_id": "ae557c78-f742-3932-a811-c0b67f5acb23",
                                                "text": "The next stage is to remove and replace the top part of the right side lip, and offer the lid to the car to ensure all the shapes and gaps are okay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62280e53-7d50-3bf8-94ad-86f78a1ea92c",
                                        "entry_id": "0b9d1860-f0fe-361e-8df1-83fecbb48d84",
                                        "glosses": [
                                            "To bid, as a price, reward, or wages."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7010c3f0-fa70-43e0-ab1f-f3be55150174",
                                                "sense_id": "62280e53-7d50-3bf8-94ad-86f78a1ea92c",
                                                "text": "I offered twenty dollars for it. The company is offering a salary of £30,000 a year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a007874-885d-3ebd-8d25-d348e166008c",
                                        "entry_id": "0b9d1860-f0fe-361e-8df1-83fecbb48d84",
                                        "glosses": [
                                            "To happen, to present itself."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9089dcc-5c9a-4982-86e3-c18350fa353e",
                                                "sense_id": "1a007874-885d-3ebd-8d25-d348e166008c",
                                                "text": "The occasion offers, and the youth complies."
                                            },
                                            {
                                                "example_id": "bbdfeaaf-4d8c-4cbc-85a1-f1bdb498a247",
                                                "sense_id": "1a007874-885d-3ebd-8d25-d348e166008c",
                                                "text": "The opportunity however did not offer till next morning, for Phœbe did not come to bed till long after I was gone to ſleep:",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "1f719ab1-6069-4f96-933b-dc08aba2de9f",
                                                "sense_id": "1a007874-885d-3ebd-8d25-d348e166008c",
                                                "text": "Much was I disappointed upon learning that the little packet for Nantucket had already sailed, and that no way of reaching that place would offer, till the following Monday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dea4d466-5f24-31bb-9697-55253927c391",
                                        "entry_id": "0b9d1860-f0fe-361e-8df1-83fecbb48d84",
                                        "glosses": [
                                            "To make an attempt; typically used with at."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4aabbec-cfd0-4a88-b6de-04cf3a50bcb0",
                                                "sense_id": "dea4d466-5f24-31bb-9697-55253927c391",
                                                "text": "I will not offer at that I cannot master."
                                            },
                                            {
                                                "example_id": "61261d2f-d6e2-404c-a1f8-06d2500079fe",
                                                "sense_id": "dea4d466-5f24-31bb-9697-55253927c391",
                                                "text": "He would be offering at the shepherd's voice."
                                            },
                                            {
                                                "example_id": "04704bdf-e9f9-4bd7-b363-149b7b21f9ff",
                                                "sense_id": "dea4d466-5f24-31bb-9697-55253927c391",
                                                "text": "[W]ithout offering at any other Remedy, without taking time to conſider the Conſequences, or to reflect on our own Condition, we haſtily engaged in a War which hath coſt us ſixty Millions; […]"
                                            },
                                            {
                                                "example_id": "230fdcdd-af73-4e8d-8180-433c9ec5cc86",
                                                "sense_id": "dea4d466-5f24-31bb-9697-55253927c391",
                                                "text": "Here Jones, after expressing the utmost uneasiness, offered to stop her mouth:—“Hey-day! why sure, Mr Jones, you will let me speak; I speaks no scandal, for I only says what I heard from others […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f10fd1e-c259-3772-bb9e-b5698aed8c56",
                                        "entry_id": "0b9d1860-f0fe-361e-8df1-83fecbb48d84",
                                        "glosses": [
                                            "To put in opposition to; to manifest in an offensive or defensive way; to threaten."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69d74623-99c6-4fe5-8d4c-5729d71cd882",
                                                "sense_id": "9f10fd1e-c259-3772-bb9e-b5698aed8c56",
                                                "text": "to offer violence to somebody"
                                            },
                                            {
                                                "example_id": "8194d3ad-4f51-411d-9fef-0e9985811d6a",
                                                "sense_id": "9f10fd1e-c259-3772-bb9e-b5698aed8c56",
                                                "text": "The peasants offered no resistance as they were rounded up."
                                            },
                                            {
                                                "example_id": "a1af1739-e3c0-466e-9130-d816e1fff0dc",
                                                "sense_id": "9f10fd1e-c259-3772-bb9e-b5698aed8c56",
                                                "text": "A car turned the corner and stopped, and three or four people emerged and approached her, grabbing her purse. When she offered resistance, one of the assailants took out a knife and stabbed her in the lower abdomen and legs."
                                            },
                                            {
                                                "example_id": "0fef82a5-921c-476b-9c01-ca04cf130a4f",
                                                "sense_id": "9f10fd1e-c259-3772-bb9e-b5698aed8c56",
                                                "text": "The Viet Cong and NVA tended to offer battle only when they felt that they held a tactical advantage – if they didn't they usually hunkered down in their nearly invisible bunkers and let the Americans pass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
