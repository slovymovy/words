                                    {
                                        "sense_id": "370f63e3-83c7-3350-ab21-55c72293c305",
                                        "entry_id": "22efd5b9-e382-3839-b7ce-c2ed8dafb687",
                                        "glosses": [
                                            "onverbogen vorm van de vergrotende trap van laag"
