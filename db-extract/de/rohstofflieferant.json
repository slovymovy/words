                        "glosses": [
                            "Stoff, Konzern, Staat oder Kontinent, der Rohstoffe für etwas liefert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3722b040-a4dc-47b9-9dbd-b5841acac4e1",
                                "sense_id": "5f065978-0e24-30cb-b0f2-338c7b6d1147",
                                "text": "„Die Industriestaaten der Welt nutzen Afrika als kostengünstigen Rohstofflieferanten, lukrativen Absatzmarkt und nicht zuletzt als gigantische Müllhalde schwer zu entsorgender Wohlstandsprodukte.“"
                            },
                            {
                                "example_id": "e0f9155d-1bde-41e1-9a95-084ca5123297",
                                "sense_id": "5f065978-0e24-30cb-b0f2-338c7b6d1147",
                                "text": "„Die Pflanze ist der wichtigste Rohstofflieferant für die Herstellung von Haushaltszucker (Saccharose) und in wachsendem Maße auch für die Herstellung von Bioethanol.“"
                            }
                        ],
