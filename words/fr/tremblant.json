        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b73b6659-65b8-3f57-94a6-875f63b2ff21",
                    "sense_definition": "Participe présent de <w>trembler</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune enfant avançait dans le couloir sombre en <w>tremblant</w> de peur.",
                            "target_lang_translations": {
                                "en": "The young child walked down the dark corridor, <w>trembling</w> with fear.",
                                "ru": "Маленький ребёнок шёл по тёмному коридору, <w>дрожа</w> от страха.",
                                "de": "Das kleine Kind ging <w>zitternd</w> vor Angst den dunklen Flur entlang.",
                                "es": "El niño pequeño avanzaba por el pasillo oscuro <w>temblando</w> de miedo.",
                                "zh": "那个小男孩吓得<w>哆嗦</w>着，走在昏暗的走廊里。"
                            }
                        },
                        {
                            "text": "Tout en <w>tremblant</w> sous le vent glacial, ils attendaient l'ouverture du refuge.",
                            "target_lang_translations": {
                                "en": "<w>Trembling</w> in the icy wind, they waited for the shelter to open.",
                                "ru": "<w>Дрожа</w> на ледяном ветру, они ждали открытия приюта.",
                                "de": "<w>Zitternd</w> im eisigen Wind warteten sie auf die Öffnung der Schutzhütte.",
                                "es": "<w>Temblando</w> bajo el viento helado, esperaban la apertura del refugio.",
                                "zh": "在刺骨的寒风中<w>颤抖</w>着，他们等待避难所开门。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "en tremblant de peur",
                        "en tremblant de froid"
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of trembler, meaning to shake or tremble.",
                        "ru": "Причастие настоящего времени глагола «trembler».",
                        "de": "Partizip Präsens von „trembler“.",
                        "es": "Participio presente de «trembler».",
                        "zh": "法语动词trembler（颤抖）的现在分词。"
                    },
