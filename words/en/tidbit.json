    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe0095db-24a0-37e4-9316-151a28fd1679",
                    "sense_definition": "A small, tasty piece of food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She offered the dog a small <w>tidbit</w> of cheese from her plate.",
                            "target_lang_translations": {
                                "de": "Sie bot dem Hund einen kleinen <w>Leckerbissen</w> Käse von ihrem Teller an."
                            }
                        },
                        {
                            "text": "The chef prepared a delicious <w>tidbit</w> for the guests to sample before dinner.",
                            "target_lang_translations": {
                                "de": "Der Koch bereitete einen köstlichen <w>Leckerbissen</w> für die Gäste zum Probieren vor dem Abendessen zu."
                            }
                        }
                    ],
                    "synonyms": [
                        "morsel",
                        "delicacy",
                        "treat"
                    ],
                    "common_phrases": [
                        "tasty tidbit"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleines, schmackhaftes Stück Essen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Leckerbissen",
                                "target_lang_sense_clarification": "Ein besonders köstliches Stück Nahrung."
                            },
                            {
                                "target_lang_word": "Happen",
                                "target_lang_sense_clarification": "Ein kleiner Bissen oder eine kleine Portion Essen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98fbf8bf-a5a3-3420-a7c3-d74875359dd5",
                    "sense_definition": "A small, interesting piece of information, news, or gossip.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article included a fascinating <w>tidbit</w> about the author's early life.",
                            "target_lang_translations": {
                                "de": "Der Artikel enthielt ein faszinierendes <w>Detail</w> über das frühe Leben des Autors."
                            }
                        },
                        {
                            "text": "She shared a juicy <w>tidbit</w> of gossip during our coffee break.",
                            "target_lang_translations": {
                                "de": "Sie teilte während unserer Kaffeepause ein saftiges <w>Klatsch-Häppchen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "snippet",
                        "detail",
                        "factoid"
                    ],
                    "common_phrases": [
                        "interesting tidbit",
                        "juicy tidbit"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleines, interessantes Stück Information, Neuigkeit oder Klatsch."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Detail",
                                "target_lang_sense_clarification": "Eine kleine, spezifische Information."
                            },
                            {
                                "target_lang_word": "Häppchen",
                                "target_lang_sense_clarification": "Übertragen für eine kleine, leicht verdauliche Information."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be2c87c3-1926-36ff-a4c4-c90349e1ff8d",
                    "sense_definition": "A choice or particularly desirable part of poultry or meat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cook carefully carved the chicken to save the best <w>tidbit</w> for the guest of honor.",
                            "target_lang_translations": {
                                "de": "Der Koch zerlegte das Huhn sorgfältig, um den besten <w>Leckerbissen</w> für den Ehrengast aufzuheben."
                            }
                        },
                        {
                            "text": "He enjoyed the succulent <w>tidbit</w> found under the thigh of the roasted bird.",
                            "target_lang_translations": {
                                "de": "Er genoss den saftigen <w>Leckerbissen</w>, der sich unter der Keule des gebratenen Vogels befand."
                            }
                        }
                    ],
                    "synonyms": [
                        "delicacy"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein besonders begehrtes oder schmackhaftes Stück Fleisch oder Geflügel."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Delikatesse",
                                "target_lang_sense_clarification": "Ein besonders feines oder seltenes Stück Essen."
                            },
                            {
                                "target_lang_word": "Leckerbissen",
                                "target_lang_sense_clarification": "Ein besonders schmackhaftes Stück Fleisch."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7054feb8-f36b-3e61-930f-8359aaeef619",
                    "sense_definition": "Any small, minor, or insignificant thing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "small_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collection of poems is a charming literary <w>tidbit</w> for any reader.",
                            "target_lang_translations": {
                                "de": "Die Gedichtsammlung ist eine charmante literarische <w>Kleinigkeit</w> für jeden Leser."
                            }
                        },
                        {
                            "text": "He gathered various <w>tidbit</w> items from the antique shop.",
                            "target_lang_translations": {
                                "de": "Er sammelte verschiedene kleine <w>Gegenstände</w> aus dem Antiquitätenladen."
                            }
                        }
                    ],
                    "synonyms": [
                        "trifle",
                        "trinket"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine kleine, unbedeutende Sache oder Kleinigkeit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kleinigkeit",
                                "target_lang_sense_clarification": "Etwas von geringer Bedeutung oder Größe."
                            },
                            {
                                "target_lang_word": "Trinket",
                                "target_lang_sense_clarification": "Ein kleiner, oft wertloser Gegenstand."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}