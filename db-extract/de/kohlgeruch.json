                "senses": [
                    {
                        "sense_id": "9db1316c-48be-3562-b3e7-3544c0a4e67b",
                        "entry_id": "e93ea816-94bb-31d7-9de5-5c1e4b8d607c",
                        "glosses": [
                            "starker Geruch, der beim Kochen verschiedener Kohlsorten entsteht und sich penetrant über längere Zeit hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41b7c76-cb06-49bc-b027-a97b457e5933",
                                "sense_id": "9db1316c-48be-3562-b3e7-3544c0a4e67b",
                                "text": "„Dieser bestimmte Kohlgeruch, der im Treppenhaus hängt, wenn der Eintopf fertig ist, erinnert einige an ihre Kindheit mit Couchgarnitur und einem mürrischen Vater, der immer das größte Stück vom Braten bekam.“"
                            },
                            {
                                "example_id": "39a90b4d-7a16-4938-a606-abfedc7c8a35",
                                "sense_id": "9db1316c-48be-3562-b3e7-3544c0a4e67b",
                                "text": "„Lüften allein reicht beim Kochen oft nicht aus. Wir haben getestet, mit welchen Mitteln sich Kohlgeruch am besten aus der Küche vertreiben lässt.“"
                            },
                            {
                                "example_id": "ff370f27-cd7f-4ee2-bb5a-d5751e8331ec",
                                "sense_id": "9db1316c-48be-3562-b3e7-3544c0a4e67b",
                                "text": "„Ich bin sehr geruchsempfindlich, und der intensive Kohlgeruch hatte mein vegetatives Nervensystem mobilisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
