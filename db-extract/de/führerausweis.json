                "senses": [
                    {
                        "sense_id": "817bb477-ff8b-3e9a-8602-7dfcb596e38a",
                        "entry_id": "ec988c18-7cf5-3f72-9db2-9c72075d8d37",
                        "glosses": [
                            "Dokument, das dem Besitzer amtlich bescheinigt, ein Kraftfahrzeug führen zu dürfen"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "fbe78ba4-4079-46fa-a385-40b4b6cc680d",
                                "sense_id": "817bb477-ff8b-3e9a-8602-7dfcb596e38a",
                                "text": "„Die Luzerner Polizei hat vor einer Woche einen Mann erwischt, der seit 22 Jahren ohne Führerausweis ein Auto gelenkt hatte.“"
                            },
                            {
                                "example_id": "dea0eded-f7ec-43bd-a154-cf37b84dcb37",
                                "sense_id": "817bb477-ff8b-3e9a-8602-7dfcb596e38a",
                                "text": "„Die Geldbuße war Kai Koch so was von schnurzegal gewesen, dass man ihm aber den Führerausweis für drei Monate entzog, tat ihm richtig weh.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
