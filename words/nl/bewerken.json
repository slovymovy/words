                },
                {
                    "sense_id": "c7b7f0df-b4c8-3a9c-9e30-2e83929e143d",
                    "sense_definition": "materiaal veranderen of behandelen om het voor een bepaald doel geschikt te maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verwerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ruwe ijzer werd eerst in de fabriek <w>bewerkt</w> tot sterke staven.",
                            "target_lang_translations": {
                                "en": "The raw iron was first <w>processed</w> into strong bars in the factory."
                            }
                        },
                        {
                            "text": "De vakman moet het <w>materiaal bewerken</w> voordat het in de machine kan.",
                            "target_lang_translations": {
