                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "titre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bonjour <w>Maître</w>, j'aimerais obtenir des conseils juridiques sur ce contrat."
                        },
                        {
                            "text": "Le client a remis les pièces du dossier directement à son <w>maître</w>."
                        }
                    ],
                    "synonyms": [
