                "senses": [
                    {
                        "sense_id": "59cfb870-68b3-363f-b5ea-2d0a343e9107",
                        "entry_id": "7759fcfa-3274-3a35-92e1-5b369f78ea01",
                        "glosses": [
                            "Coucher de vermeil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b323197b-bb24-4b21-8624-428a5a6d9118",
                                "sense_id": "59cfb870-68b3-363f-b5ea-2d0a343e9107",
                                "text": "Vermeillonner. C'est coucher de vermeil, pour donner à l'ouvrage du reflet et une couleur d'or moulu."
                            },
                            {
                                "example_id": "e5fb65fa-55e3-44d4-b289-e3bc36b45873",
                                "sense_id": "59cfb870-68b3-363f-b5ea-2d0a343e9107",
                                "text": "Il y a dix-sept opérations principales pour finir un ouvrage de dorure en détrempe : savoir, encoller, blanchir, reboucher & peau-de-chienner, adoucir & poncer, réparer, dégraisser, préler, jaunir, égrainer, coucher d'assiette, frotter, dorer, brunir, matter, ramender, vermeillonner & repasser."
                            }
                        ]
                    }
