                "senses": [
                    {
                        "sense_id": "808d4394-2845-3052-be9d-c3edc6450be8",
                        "entry_id": "fcdff0af-30d8-3fd2-a932-53c7e5c795f6",
                        "glosses": [
                            "bezeichnet einen Ort"
                        ],
                        "tags": [
                            "häufig mit Verben der Bewegung"
                        ],
                        "examples": [
                            {
                                "example_id": "b2bd9d0d-8daf-403c-9dc8-e99e7002e20c",
                                "sense_id": "808d4394-2845-3052-be9d-c3edc6450be8",
                                "text": "Kommst du mal bitte hierhin - das könnte dich interessieren!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "490f7d9d-08dd-3cd5-87a6-c3babedf9727",
                        "entry_id": "fcdff0af-30d8-3fd2-a932-53c7e5c795f6",
                        "glosses": [
                            "bezeichnet eine konkrete und auch abstrakte Richtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e2c43e5-2de1-4737-87ab-c7a195e724c8",
                                "sense_id": "490f7d9d-08dd-3cd5-87a6-c3babedf9727",
                                "text": "Bis hierhin stimme ich dir voll und ganz zu."
                            },
                            {
                                "example_id": "70faf851-e68f-44d8-838c-1f591d9e6bd6",
                                "sense_id": "490f7d9d-08dd-3cd5-87a6-c3babedf9727",
                                "text": "Bis hierhin kann ich dir noch folgen, aber danach wird es mir zu kompliziert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c623c36-6871-4441-a800-ee3d09b63625",
                        "source_entry_id": "fcdff0af-30d8-3fd2-a932-53c7e5c795f6",
                        "source_sense_id": "808d4394-2845-3052-be9d-c3edc6450be8",
                        "source_sense_description": "bezeichnet einen Ort (häufig mit Verben der Bewegung)",
                        "target_lang_word": "par ici",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "par ici",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7c9bd1d-653e-3768-bd53-6d9c2d9fc083",
                                        "entry_id": "007de66a-4fe9-3cec-8dc1-ef75dfa7e47d",
                                        "glosses": [
                                            "À l’endroit, ou autour de l’endroit où l’on est, ou que l’on désigne précisément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8a1cf6-4c04-4e61-84e8-32123fc1b86f",
                                                "sense_id": "b7c9bd1d-653e-3768-bd53-6d9c2d9fc083",
                                                "text": "Ceux-là, les rouges, t’en trouveras des nuées par ici, ça pullule comme les mouches à merde sur une charogne."
                                            },
                                            {
                                                "example_id": "9f6f399c-67e0-4f9a-a124-21351653da85",
                                                "sense_id": "b7c9bd1d-653e-3768-bd53-6d9c2d9fc083",
                                                "text": "Il y a une drôle de lumière par ici."
                                            },
                                            {
                                                "example_id": "36ba1820-06b5-409a-9a08-4bd8326a4717",
                                                "sense_id": "b7c9bd1d-653e-3768-bd53-6d9c2d9fc083",
                                                "text": "Viens par ici tout de suite !"
                                            },
                                            {
                                                "example_id": "282914bd-5c30-486e-b451-fbaf1c27d386",
                                                "sense_id": "b7c9bd1d-653e-3768-bd53-6d9c2d9fc083",
                                                "text": "« Vous pouvez passer par ici. » dit-il en pointant du doigt la carte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "par ici",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a86e9892-2a0f-3e68-b4eb-0dfadf648780",
                                        "entry_id": "24d3655f-7d6a-3c75-9e13-741da87e67e3",
                                        "glosses": [
                                            "En passant par l’endroit où l’on est, ou par un lieu que l’on désigne précisément (sur une carte par exemple)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7f9768-699d-4bf6-9eec-23a3b3dbf777",
                                                "sense_id": "a86e9892-2a0f-3e68-b4eb-0dfadf648780",
                                                "text": "Par où faut-il aller ? - Par ici !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb510cc2-983c-32e0-9ce8-238a2d5d34a9",
                                        "entry_id": "24d3655f-7d6a-3c75-9e13-741da87e67e3",
                                        "glosses": [
                                            "Ici. Permet de se signaler à une personne qui nous cherche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9839afec-a6c2-4fdf-9e28-f4929e01acdb",
                                                "sense_id": "bb510cc2-983c-32e0-9ce8-238a2d5d34a9",
                                                "text": "Où êtes-vous ? - Par ici !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3913a2e2-752b-4f79-8ec3-6d8d40f01317",
                        "source_entry_id": "fcdff0af-30d8-3fd2-a932-53c7e5c795f6",
                        "source_sense_id": "808d4394-2845-3052-be9d-c3edc6450be8",
                        "source_sense_description": "bezeichnet einen Ort (häufig mit Verben der Bewegung)",
                        "target_lang_word": "buraya",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f5eb7f8b-c420-4953-8f0c-48c168a7a8a6",
                        "source_entry_id": "fcdff0af-30d8-3fd2-a932-53c7e5c795f6",
                        "source_sense_id": "490f7d9d-08dd-3cd5-87a6-c3babedf9727",
                        "source_sense_description": "bezeichnet eine konkrete und auch abstrakte Richtung",
                        "target_lang_word": "par là",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "par là",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56c386d1-78fa-307e-b58d-e068d707913f",
                                        "entry_id": "8d4417d6-075e-387c-878b-bba07d46aede",
                                        "glosses": [
                                            "Par ce lieu-là ; par ce point-là."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290e3443-9412-4de3-8666-352c7e50e465",
                                                "sense_id": "56c386d1-78fa-307e-b58d-e068d707913f",
                                                "text": "Par où dois-je continuer ? — Par là ! dit-il en indiquant l’entrée de la forêt."
                                            },
                                            {
                                                "example_id": "c287a848-22aa-4566-a815-43dd9625f7f1",
                                                "sense_id": "56c386d1-78fa-307e-b58d-e068d707913f",
                                                "text": "Passez par là."
                                            },
                                            {
                                                "example_id": "ee21098d-4565-4994-90e0-56946cd1b835",
                                                "sense_id": "56c386d1-78fa-307e-b58d-e068d707913f",
                                                "text": "Par là : par conséquent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56006b01-a10e-3fea-ac52-3b885cafa884",
                                        "entry_id": "8d4417d6-075e-387c-878b-bba07d46aede",
                                        "glosses": [
                                            "Par ce parti, par ce moyen, par ces paroles."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1239bfb0-b119-4ee4-a66c-f33a2b90f206",
                                                "sense_id": "56006b01-a10e-3fea-ac52-3b885cafa884",
                                                "text": "Parce qu'elle est mutilation psychologique, et s'accompagne généralement de pratiques mortificatoires, l’adhésion idéologique doit être considérée comme un état morbide, même si elle est socialement acceptée, devenant par là psychose socialisée."
                                            },
                                            {
                                                "example_id": "6ac30aac-7251-4dd3-80e0-22200c1150da",
                                                "sense_id": "56006b01-a10e-3fea-ac52-3b885cafa884",
                                                "text": "Il a été forcé d’en passer par là. — Qu’entendez-vous par là ? — Il désignait par là son ami."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8180daf1-3b21-31c5-98e9-df5ab91fca41",
                                        "entry_id": "8d4417d6-075e-387c-878b-bba07d46aede",
                                        "glosses": [
                                            "Abréviation ou simplification de la locution adverbiale par là même, équivalent des locutions suivantes : de ce fait, pour cette raison, en conséquence de cela."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1affcecd-5e75-4b04-97fb-757c1ab58cf5",
                                                "sense_id": "8180daf1-3b21-31c5-98e9-df5ab91fca41",
                                                "text": "… Les nombres algébriques apparaissent donc comme réunion dénombrable d'ensembles finis, ce qui assure leur dénombrabilité et, par là, la non dénombrabilité de l'ensemble des nombres transcendants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "201e1a69-d659-3859-8cdc-054917438fcd",
                                        "entry_id": "8d4417d6-075e-387c-878b-bba07d46aede",
                                        "glosses": [
                                            "Environ, à peu près."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e51cf8b6-e3e5-42c0-a2d6-d92e00422876",
                                                "sense_id": "201e1a69-d659-3859-8cdc-054917438fcd",
                                                "text": "Enfin, à neuf heures, par là, au bar en question, il a dû avoir plus de chance, sans exulter, il semblait content."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
