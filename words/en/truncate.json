    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc441c32-5723-3e0e-991e-e9948203edd8",
                    "sense_definition": "To shorten something by cutting off a part of it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shorten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor had to <w>truncate</w> the long article to fit it on the page."
                        },
                        {
                            "text": "The speech was <w>truncated</w> because the event ran out of time."
                        }
                    ],
                    "antonyms": [
                        "extend",
                        "lengthen"
                    ],
                    "common_phrases": [
