                            },
                            {
                                "target_lang_word": "焦躁",
                                "target_lang_sense_clarification": "急躁不安，难以平静"
                            },
                            {
                                "target_lang_word": "不安",
                                "target_lang_sense_clarification": "心里忐忑，不踏实"
                            }
                        ]
                    }
