{
    "word_family": [
        "uitstoot",
        "uitstoting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e053208-f890-35dc-b27b-3f00a85e2af2",
                    "sense_definition": "Het in de lucht of het milieu vrijlaten van gassen of stoffen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "milieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fabrieken moeten proberen om minder schadelijke gassen <w>uit</w> te <w>stoten</w>.",
                            "target_lang_translations": {
                                "en": "Factories must try to <w>emit</w> fewer harmful gases."
                            }
                        },
                        {
                            "text": "Deze auto <w>stoot</w> veel CO2 <w>uit</w> tijdens het rijden.",
                            "target_lang_translations": {
                                "en": "This car <w>emits</w> a lot of CO2 while driving."
                            }
                        }
                    ],
                    "synonyms": [
                        "emitteren"
                    ],
                    "common_phrases": [
                        "schadelijke gassen uitstoten",
                        "minder CO2 uitstoten"
                    ],
                    "target_lang_definitions": {
                        "en": "To release gases or substances into the air or environment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "emit",
                                "target_lang_sense_clarification": "of gases, radiation, or substances"
                            },
                            {
                                "target_lang_word": "discharge",
                                "target_lang_sense_clarification": "of waste or pollutants"
                            },
                            {
                                "target_lang_word": "release",
                                "target_lang_sense_clarification": "of emissions into the atmosphere"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fa5ea73-5377-3444-8ffb-5e0bf6b9357a",
                    "sense_definition": "Iemand of iets dwingen om een groep of gemeenschap te verlaten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge man werd uit de gemeenschap <w>uitgestoten</w> na zijn slechte gedrag.",
                            "target_lang_translations": {
                                "en": "The young man was <w>expelled</w> from the community after his bad behavior."
                            }
                        },
                        {
                            "text": "Op een bepaalde leeftijd worden mannetjesolifanten uit de kudde <w>uitgestoten</w>.",
                            "target_lang_translations": {
                                "en": "At a certain age, male elephants are <w>cast out</w> of the herd."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uit de groep uitstoten"
                    ],
                    "target_lang_definitions": {
                        "en": "To force someone or something to leave a group or community."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expel",
                                "target_lang_sense_clarification": "from a community, school, or group"
                            },
                            {
                                "target_lang_word": "ostracize",
                                "target_lang_sense_clarification": "socially exclude from a group"
                            },
                            {
                                "target_lang_word": "cast out",
                                "target_lang_sense_clarification": "banish or reject from a society or herd"
                            },
                            {
                                "target_lang_word": "reject",
                                "target_lang_sense_clarification": "exclude or push away"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86437372-dd26-36b2-abc2-2c189f46d806",
                    "sense_definition": "Plotseling en met kracht een geluid, kreet of schreeuw laten horen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij zijn teen stootte, <w>stootte</w> hij een luide kreet <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "When he stubbed his toe, he <w>let out</w> a loud cry."
                            }
                        },
                        {
                            "text": "Zonder na te denken <w>stootte</w> zij een schreeuw van schrik <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "Without thinking, she <w>uttered</w> a scream of fright."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een kreet uitstoten",
                        "een schreeuw uitstoten"
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly and forcefully make a sound, cry, or scream."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "utter",
                                "target_lang_sense_clarification": "a sound, cry, or sigh"
                            },
                            {
                                "target_lang_word": "let out",
                                "target_lang_sense_clarification": "a scream or shout"
                            },
                            {
                                "target_lang_word": "emit",
                                "target_lang_sense_clarification": "a sound or cry"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c7c466e-e886-3d63-8add-7ec56db3b96f",
                    "sense_definition": "Het meervoud van het zelfstandig naamwoord <w>uitstoot</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verschillende <w>uitstoten</w> van de fabrieken werden nauwkeurig gemeten.",
                            "target_lang_translations": {
                                "en": "The various <w>emissions</w> from the factories were accurately measured."
                            }
                        },
                        {
                            "text": "We moeten alle schadelijke <w>uitstoten</w> in de regio verminderen.",
                            "target_lang_translations": {
                                "en": "We must reduce all harmful <w>emissions</w> in the region."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of uitstoot"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The plural form of the noun 'emission' (uitstoot)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "emissions",
                                "target_lang_sense_clarification": "plural of emission, referring to discharged substances"
                            },
                            {
                                "target_lang_word": "discharges",
                                "target_lang_sense_clarification": "plural, referring to released pollutants"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}