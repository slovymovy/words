                        "examples": [
                            {
                                "example_id": "e80bf369-ac54-4b40-aa38-fd481f2b8e57",
                                "sense_id": "332eba90-f4e4-36e3-8108-7802048b0e6a",
                                "text": "The following Play…The Prologist and Epilogist represent the whole Course of Literature."
                            },
                            {
                                "example_id": "2d99074f-e012-4292-a309-bfb25e6f0250",
                                "sense_id": "332eba90-f4e4-36e3-8108-7802048b0e6a",
                                "text": "Such a prologist as Sir Dudley seemed scarcely to threaten."
                            },
                            {
                                "example_id": "615ecb6d-f866-40d8-aec5-b006d5eee26f",
                                "sense_id": "332eba90-f4e4-36e3-8108-7802048b0e6a",
                                "text": "The principal characters in the play appear to have been grouped in a kind of tableau on the stage while the prologue was delivered, in this as in some other plays. The prologist informs the audience that the two captives who stand in chains on his right and left, are Philocrates, a young noble of Elis, and his slave Tyndarus."
                            }
