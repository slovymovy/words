                        "entry_id": "5f51d89c-493d-3ad1-87e1-56dd4afd51d9",
                        "glosses": [
                            "Eigenschaft einer Person, sich nach den herrschenden Vorstellungen von Moral und Anstand (Tugend) zu verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26e3d125-43e3-4ad1-9a31-60f868c73c14",
                                "sense_id": "4af0983f-680a-3961-9616-e2dd842d3428",
                                "text": "Ihre Tugendhaftigkeit stand außer Frage."
                            }
