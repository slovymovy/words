                                                "sense_id": "ef30f5d7-1ca4-3044-b8d3-a996ab23564b",
                                                "text": "Nail down the shelf, then paint it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4302c2d1-8ef4-34af-ada3-37169b84369f",
                                        "entry_id": "a4669b49-23c0-3a88-b21c-b8d9dfebc514",
                                        "glosses": [
                                            "to make something (e.g. a decision or plan) firm or certain"
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
