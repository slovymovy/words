                "senses": [
                    {
                        "sense_id": "d46bec5c-f2db-3a1d-9c0f-b11ffc8b5787",
                        "entry_id": "9da7a26e-260e-3581-b1f7-85d06eb8aacf",
                        "glosses": [
                            "sehr energiereiches Nahrungsmittel in Riegelform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478c001f-35b6-4afe-bac7-d67e65783f0d",
                                "sense_id": "d46bec5c-f2db-3a1d-9c0f-b11ffc8b5787",
                                "text": "„Überall in seinem Kit steckten Energieriegel, die ausreichten um ihn mit den notwendigsten Kalorien zu versorgen, aber nicht, um seinen Hunger zu stillen.“"
                            },
                            {
                                "example_id": "ad20dc5a-887e-4af5-9412-0828aa92f654",
                                "sense_id": "d46bec5c-f2db-3a1d-9c0f-b11ffc8b5787",
                                "text": "„Colter fand Energieriegel vor, einen Sägedraht, zusätzliche Streichhölzer, eine Karte, einen Kompass und einen Thermoschlafsack.“"
                            },
                            {
                                "example_id": "fed8b677-698f-45f6-bebc-7bc130e318bc",
                                "sense_id": "d46bec5c-f2db-3a1d-9c0f-b11ffc8b5787",
                                "text": "„Noch einmal öffne ich den Reißverschluss des Überlebenspakets und inspiziere den Inhalt, die Dinge, die mich am Leben halten werden. Vier Energieriegel.“"
                            },
                            {
                                "example_id": "5b46b7a0-58f1-4f63-a13d-c782434d1aa1",
                                "sense_id": "d46bec5c-f2db-3a1d-9c0f-b11ffc8b5787",
                                "text": "„Oryx war eingedöst und Court nutzte die Gelegenheit, um in Ruhe etwas Wasser zu trinken und einen Energieriegel zu essen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
