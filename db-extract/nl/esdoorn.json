                    {
                        "sense_id": "c38f046d-a223-3ccc-bc03-34e93cf3c0bc",
                        "entry_id": "df552f54-b2a3-39ca-ab69-46033331273a",
                        "glosses": [
                            "een geslacht Acer van loofbomen en heesters. Afhankelijk van de taxonomische opvatting wordt dit geslacht ingedeeld bij de esdoornfamilie (Aceraceae) of de zeepboomfamilie (Sapindaceae). Esdoorns komen voor in de gematigde streken van het noordelijk halfrond. Enkele soorten komen voor in Zuidoost-Azië en Indonesië. Het geslacht zal zo'n 120 soorten tellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a06b7164-938a-432e-8889-a4857aeed7c3",
                                "sense_id": "c38f046d-a223-3ccc-bc03-34e93cf3c0bc",
                                "text": "Er hangen nog twee blaren aan mijn esdoorn."
                            }
                        ]
                    },
                    {
                        "sense_id": "97e6f01e-1d94-3175-a916-f3d1fe178247",
                        "entry_id": "df552f54-b2a3-39ca-ab69-46033331273a",
                        "glosses": [
                            "hout, afkomstig van bomen uit het geslacht Acer"
                        ],
                        "tags": [
                            "materiaalkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "d73eb19b-cf2b-41ff-a9e1-6acdd136a6b2",
                                "sense_id": "97e6f01e-1d94-3175-a916-f3d1fe178247",
                                "text": "Esdoorn is, zowel met de hand als machinaal, gemakkelijk te bewerken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aae7b0c2-13c5-4c24-832b-d7f281f84d0e",
