                        "source_sense_description": "Bildung: zu eine berufliche Qualifizierung führend; qualifizierend",
                        "target_lang_word": "qualifizieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qualifizieren",
