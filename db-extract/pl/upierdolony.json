                        "cross_references": [
                            {
                                "target_word": "грязный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1b639e0f-a2ea-3de0-a207-99fad7399c07",
                                        "entry_id": "4eda1c09-36b0-3fa5-9626-ad04e2a76b19",
                                        "glosses": [
                                            "запачканный, не чистый, покрытый или пропитанный грязью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c46560c-c1d6-4fd2-9b2b-09cc1cc15c3d",
                                                "sense_id": "1b639e0f-a2ea-3de0-a207-99fad7399c07",
                                                "text": "Грязные сапоги."
                                            },
                                            {
                                                "example_id": "6600e39a-bec2-4433-9073-6d7ac642fb38",
                                                "sense_id": "1b639e0f-a2ea-3de0-a207-99fad7399c07",
                                                "text": "Грязная улица."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d3adbd3-a4e5-37b6-bd10-76773abffd66",
                                        "entry_id": "4eda1c09-36b0-3fa5-9626-ad04e2a76b19",
                                        "glosses": [
                                            "перен. низкий, подлый, недостойный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd3f2a17-8710-4f2b-8efb-a916f2b499a1",
                                                "sense_id": "8d3adbd3-a4e5-37b6-bd10-76773abffd66",
                                                "text": "Грязный поступок."
                                            },
                                            {
                                                "example_id": "1a65051a-811f-4d2b-89e7-7f05d4f354ea",
                                                "sense_id": "8d3adbd3-a4e5-37b6-bd10-76773abffd66",
                                                "text": "Грязная ложь."
                                            },
                                            {
                                                "example_id": "5529bd37-a762-4e8c-a612-0f3ad4990b66",
                                                "sense_id": "8d3adbd3-a4e5-37b6-bd10-76773abffd66",
                                                "text": "Итак, Марк Крысобой, холодный и убеждённый палач, люди, которые, как я вижу, ― прокуратор указал на изуродованное лицо Иешуа, ― тебя били за твои проповеди, разбойники Дисмас и Гестас, убившие со своими присными четырёх солдат, и, наконец, грязный предатель Иуда― все они добрые люди?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e974ffe-6981-37eb-bfd1-fd9549646ce0",
                                        "entry_id": "4eda1c09-36b0-3fa5-9626-ad04e2a76b19",
                                        "glosses": [
                                            "серовато-мутный (о цвете)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bedecc2f-559d-4ee4-bd4d-d00a5c9e7c4c",
                                                "sense_id": "2e974ffe-6981-37eb-bfd1-fd9549646ce0",
                                                "text": "Грязный цвет."
                                            },
                                            {
                                                "example_id": "b90fe942-b4df-4bbe-90e6-a22696efaed7",
                                                "sense_id": "2e974ffe-6981-37eb-bfd1-fd9549646ce0",
                                                "text": "Грязный колер (в живописи)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b311ea8-1d46-3615-ac17-6b795b9bdc73",
                                        "entry_id": "4eda1c09-36b0-3fa5-9626-ad04e2a76b19",
                                        "glosses": [
                                            "предназначенный для нечистот, отбросов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67064c17-9b5c-453b-903b-21a46c1ab2a7",
                                                "sense_id": "1b311ea8-1d46-3615-ac17-6b795b9bdc73",
                                                "text": "Грязное ведро стоит на кухне."
                                            }
                                        ]
                                    },
