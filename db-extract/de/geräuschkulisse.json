                ],
                "senses": [
                    {
                        "sense_id": "293d444a-7c49-3b15-a547-069ef7291c25",
                        "entry_id": "30c9b3f0-ef92-38c6-9e62-6f489e58c94c",
                        "glosses": [
                            "im Hintergrund vorhandene Geräusche (= viele Arten von Tönen: Lärm, Baulärm, Musik, Vogelgezwitscher, Meeresrauschen, Verkehrslärm, menschliches Gemurmel und so weiter), die meist nicht bewusst wahrgenommen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bb84dca-671e-4408-8a4c-acb7c8c7c0a0",
                                "sense_id": "293d444a-7c49-3b15-a547-069ef7291c25",
                                "text": "„Die Geräuschkulisse ist ziemlich laut.“"
                            },
                            {
                                "example_id": "343ba459-05f0-462e-b0d8-1e5f9c21c5d8",
                                "sense_id": "293d444a-7c49-3b15-a547-069ef7291c25",
                                "text": "Diese permanente Geräuschkulisse von Straßenlärm und Radiomusik stört mich beim Lernen!"
                            },
                            {
                                "example_id": "fb285c15-2a8e-4846-b014-0f860ca45834",
                                "sense_id": "293d444a-7c49-3b15-a547-069ef7291c25",
                                "text": "Die Geräuschkulisse eines Bahnhofs mit ratternden Güterzügen und quietschenden Bremsen ist unerträglich."
                            },
                            {
                                "example_id": "f447c20d-e9da-47e9-9add-dc70694e5846",
                                "sense_id": "293d444a-7c49-3b15-a547-069ef7291c25",
                                "text": "„Die Geräuschkulisse des Regenwalds ist beeindruckend: es zirpt, quakt und zwitschert von überall her.“"
                            },
                            {
                                "example_id": "b243a5c5-cb59-4afe-9733-54198da452bd",
                                "sense_id": "293d444a-7c49-3b15-a547-069ef7291c25",
                                "text": "„Schätzungsweise 113 Millionen Menschen in Europa müssten dauerhaft mit einer von Autos verursachten Geräuschkulisse jenseits von 55 Dezibel klar kommen […].“"
                            },
                            {
                                "example_id": "2f6c0a61-f71e-49c4-9e32-11a9dc7c8f97",
                                "sense_id": "293d444a-7c49-3b15-a547-069ef7291c25",
                                "text": "[Schwerhörigkeit:] „Gespräche in lauter Umgebung werden immer schwieriger, weil die Geräuschkulisse das schon eingeschränkte Sprachverstehen zusätzlich behindert.“"
                            },
                            {
                                "example_id": "2d668c06-8682-45d1-a3d5-673dcd3179c1",
                                "sense_id": "293d444a-7c49-3b15-a547-069ef7291c25",
                                "text": "[Corona-Pandemie:] „Wenn die Fußball-Bundesliga am Wochenende im Geister-Modus wieder an den Start geht, wird […] die übliche Geräuschkulisse von den Rängen fehlen.“"
                            },
                            {
                                "example_id": "aaee1b38-a3fa-4a41-a578-0980aad0fbb1",
                                "sense_id": "293d444a-7c49-3b15-a547-069ef7291c25",
                                "text": "„Begleitet von einer beeindruckenden Geräuschkulisse aus lauten Trommeln und Hörnern protestierten Tausende Israelis im ganzen Land gegen Arbeitslosigkeit, Korruption und den Umgang von Regierungschef Benjamin Netanjahu mit der Corona-Pandemie.“"
                            },
                            {
                                "example_id": "c64d2349-fe68-4fb5-8b43-716e37fb9437",
                                "sense_id": "293d444a-7c49-3b15-a547-069ef7291c25",
                                "text": "[Mein Mann war entsetzt,] „als er sich bei seinem ersten Restaurant-Besuch in Peking von einer Geräuschkulisse aus Schmatzen, Schlürfen und Rülpsen umgeben sah.“"
                            },
                            {
                                "example_id": "8ea5cb5f-e971-44f7-9485-367753e5f2b3",
                                "sense_id": "293d444a-7c49-3b15-a547-069ef7291c25",
                                "text": "„Während wir durch diesen Gang hinab gehen, sorgt eine diffuse Geräuschkulisse aus Wasserrauschen und Stimmengewirr für Desorientierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5b99b440-a55f-30a4-8f2e-0e73781d2fcf",
                        "entry_id": "30c9b3f0-ef92-38c6-9e62-6f489e58c94c",
                        "glosses": [
                            "in Radio, Fernsehen oder Film zur Schaffung einer bestimmten Stimmung eingespielte Töne, häufig in Form von Musik, auch musikähnlich"
                        ],
                        "tags": [
                            "Radio",
                            "Fernsehen",
                            "Film"
                        ],
                        "examples": [
                            {
                                "example_id": "680ff89c-e357-4d30-9366-8f12a1d32925",
                                "sense_id": "5b99b440-a55f-30a4-8f2e-0e73781d2fcf",
                                "text": "„Ein lautes, metallisches Kreischen im Theater macht deutlich, wie sich die Lage auf der havarierten Fähre dramatisch zuspitzt. Vor tösender und bedrohlich werdender Geräuschkulisse lesen die Schauspieler […] aus den Gesprächen vom Unglückstag vor.“"
                            },
                            {
                                "example_id": "3b047615-f6bf-4273-9088-bd1dd819b074",
                                "sense_id": "5b99b440-a55f-30a4-8f2e-0e73781d2fcf",
                                "text": "„Der Frage, ob ein Naturfilm überhaupt Musik und Soundeffekte braucht, oder ob die original Geräuschkulisse nicht völlig ausreicht, gehen Experten in [Anmerkung: dem Film] ‚Wenn der Wolf tanzt und der Bär steppt‘ nach.“"
                            },
                            {
                                "example_id": "33ccd360-d625-4af0-b0a4-08cdf84e5f20",
                                "sense_id": "5b99b440-a55f-30a4-8f2e-0e73781d2fcf",
                                "text": "„Weniger martialisch dagegen ist Sound für brechendes Eis. »Dazu kann man zwei Gelatineplatten aneinander reiben«, weiß der Soundtüftler. Aufgefallen ist ihm das daheim - beim Kochen. Aufgenommen hat er es später im Tonstudio. Dort entstehen all die Geräuschkulissen, die Zuhörern später einen Schauer über den Rücken jagen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
