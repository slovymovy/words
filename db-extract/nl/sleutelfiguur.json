                "senses": [
                    {
                        "sense_id": "cf2bbc8d-1162-390d-b64b-3ecf544361f5",
                        "entry_id": "6cb4117a-2fcb-34b5-a6d0-1ad5268e3a7d",
                        "glosses": [
                            "een belangrijk, centraal persoon in een bepaalde kwestie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b718e7-32a6-4e56-bcb7-0b45947d83f1",
                                "sense_id": "cf2bbc8d-1162-390d-b64b-3ecf544361f5",
                                "text": "De ene schatting legde de afstanden in ons zonnestelsel vast, de andere de afstand tot de sterren. In beide schattingen was een speciale rol weggelegd voor een sleutelfiguur in de ontwikkeling van de moderne wetenschap — een Hollandse klokkenmaker."
                            },
                            {
                                "example_id": "5f147a89-db49-4ba7-a47d-0a4080c58be9",
                                "sense_id": "cf2bbc8d-1162-390d-b64b-3ecf544361f5",
                                "text": "Daarnaast zijn ook een aantal sleutelfiguren van de oppositie, waaronder voormalige presidentskandidaten Henrique Capriles en Leopoldo Lopez - buitenspel gezet: ze werden verbannen uit publieke ambten of zijn aangehouden op verdenking van onder andere corruptie en het plannen van een staatsgreep."
                            }
                        ]
                    }
                ],
