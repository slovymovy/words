                        "entry_id": "83dc553a-9637-3617-94a1-2b406a1de614",
                        "glosses": [
                            "Any of various fungi that produce a cloud of brown dust-like spores from their mature fruiting bodies."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3b79cc1e-64fa-3a5a-8808-f38078ea9288",
                        "entry_id": "83dc553a-9637-3617-94a1-2b406a1de614",
                        "glosses": [
                            "A dandelion flower that has gone to seed, a dandelion clock."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "80321cc9-e2e3-3469-8a31-0575a1acb5b9",
                        "entry_id": "83dc553a-9637-3617-94a1-2b406a1de614",
                        "glosses": [
                            "Something lacking substance."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f3bd2ac3-abf3-4af1-9b6b-bcaaad56c31c",
                                "sense_id": "80321cc9-e2e3-3469-8a31-0575a1acb5b9",
                                "text": "Scads of souls thought the record was yet another puffball from ex-Beatle Paul."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24e716ad-f7bf-4fad-be16-61807e893c8c",
