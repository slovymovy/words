                "senses": [
                    {
                        "sense_id": "444f0bd4-854f-3fc5-924a-bff40bd59061",
                        "entry_id": "bbbbe0ec-d7d0-37a5-aae0-4ced05071f54",
                        "glosses": [
                            "Prävalenzeinbildung in der Konkurrenz der Fächer; Anmaßung, Borniertheit, Überheblichkeit, die das eigene Arbeitsgebiet als anspruchsvoller, wertvoller oder wichtiger über andere stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58898647-ccd2-4c30-a023-1bda7a915d9e",
                                "sense_id": "444f0bd4-854f-3fc5-924a-bff40bd59061",
                                "text": "„Sie irritieren ihre Kollegen mit gespreiztem Computer-Chinesisch und provozieren sie nur allzu häufig mit einer aufreizenden Facharroganz.“"
                            },
                            {
                                "example_id": "f6f4d69e-8806-489e-b497-ab76e57485d7",
                                "sense_id": "444f0bd4-854f-3fc5-924a-bff40bd59061",
                                "text": "„Die Physiker, die soziale Interaktion meist als notwendiges Übel ansehen und vor Facharroganz strotzen, besinnen sich heute allein auf den Kampf.“"
                            },
                            {
                                "example_id": "ea016c40-f904-4c42-9462-a5264bf6b8b1",
                                "sense_id": "444f0bd4-854f-3fc5-924a-bff40bd59061",
                                "text": "„Sich über Facharroganz hinwegzusetzen, war eine Zeitlang Hitlers Stärke, bis er eines Tages selber zum Fachsimpel wurde.“"
                            },
                            {
                                "example_id": "f75e7641-6369-4d42-acd2-bb2586734af6",
                                "sense_id": "444f0bd4-854f-3fc5-924a-bff40bd59061",
                                "text": "„Bei solchen großen Erscheinungen von Facharroganz zu sprechen, wäre höchst unangebracht; aber im allgemeinen kommt mit der Würde der Dünkel.“"
                            },
                            {
                                "example_id": "5b31743e-0e53-4542-9e53-16fc28e2cc2e",
                                "sense_id": "444f0bd4-854f-3fc5-924a-bff40bd59061",
                                "text": "„Facharroganz soll – so Bercht – durch eine transdisziplinäre Begegnung am Problem ersetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
