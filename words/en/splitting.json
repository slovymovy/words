        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1080011a-5c27-3a03-8da2-8c4bc29fc857",
                    "sense_definition": "Present participle and gerund of <w>split</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are <w>splitting</w> the bill evenly between the four of us.",
                            "target_lang_translations": {
                                "ru": "Мы <w>делим</w> счет поровну на четверых.",
                                "pl": "Dzielimy rachunek po równo na czworo."
                            }
                        },
                        {
                            "text": "He spent the whole afternoon <w>splitting</w> logs for the fireplace.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, <w>коля</w> дрова для камина.",
                                "pl": "Spędził całe popołudnie, <w>rozłupując</w> kłody do kominka."
                            }
