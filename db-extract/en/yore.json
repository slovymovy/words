                                    {
                                        "sense_id": "66d3525e-7dfc-3e3b-aefd-0a5567121633",
                                        "entry_id": "06561c64-c4cf-3a1e-a722-501164d3bb4e",
                                        "glosses": [
                                            "in lang vervlogen dagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24433339-0a82-45d3-be35-f095ecc3a13f",
                                                "sense_id": "66d3525e-7dfc-3e3b-aefd-0a5567121633",
                                                "text": "Dat is weleer ooit wel de gewoonte geweest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fefdfaa6-51e3-4d4c-b63f-a30d205613e0",
                        "source_entry_id": "f2797f09-4150-3e42-8472-8afe7d04da85",
                        "source_sense_id": "91bb6b3d-d299-348b-859a-76c6cb91ec83",
                        "source_sense_description": "time long past",
                        "target_lang_word": "eertijds",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eertijds",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fb7cbf3a-0ef1-3bf5-9af9-066a2052f1f0",
                                        "entry_id": "20ef2656-cf09-3e2a-a551-0da4e0cbd33c",
                                        "glosses": [
                                            "in de genoemde periode van het verleden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "160a3e30-abc4-4061-af46-02201ad804ac",
                                                "sense_id": "fb7cbf3a-0ef1-3bf5-9af9-066a2052f1f0",
                                                "text": "Daar werd eertijds geen rekening mee gehouden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d14dd76-9c0a-4782-bf87-4e456347d6a7",
                        "source_entry_id": "f2797f09-4150-3e42-8472-8afe7d04da85",
                        "source_sense_id": "91bb6b3d-d299-348b-859a-76c6cb91ec83",
                        "source_sense_description": "time long past",
                        "target_lang_word": "jadis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jadis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4926d5b8-362a-39da-abe3-6461ef862c10",
                                        "entry_id": "7bc26fea-3950-3369-9f7c-b542bc816301",
                                        "glosses": [
                                            "Autrefois, au temps passé, dans le passé lointain, il y a longtemps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a3a75f-8dce-4408-98fe-2d28859084cf",
                                                "sense_id": "4926d5b8-362a-39da-abe3-6461ef862c10",
                                                "text": "Nous sommes arrivés, de critique en critique, à cette triste conclusion : que le juste et l'injuste, dont nous pensions jadis avoir le discernement, sont termes de convention, vagues, indéter­minables ; […]."
                                            },
                                            {
                                                "example_id": "b12e0555-3fff-4087-a376-07932999ba6f",
                                                "sense_id": "4926d5b8-362a-39da-abe3-6461ef862c10",
                                                "text": "La navigation cesse aussitôt que le soleil est couché et à bord des bateaux amarrés le long des rives, les mariniers éteignent leurs falots à l'heure où jadis on sonnait le couvre-feu."
                                            },
                                            {
                                                "example_id": "ae3d8884-e252-4d0b-b025-aa12ee14f8f2",
                                                "sense_id": "4926d5b8-362a-39da-abe3-6461ef862c10",
                                                "text": "[…] ; jadis, on croyait que la férule était l’outil le plus nécessaire pour le maître d'école ; aujourd'hui, les peines corporelles ont disparu de notre enseignement public."
                                            },
                                            {
                                                "example_id": "11d0381b-8813-4c96-99fe-1e2a26f5bd9c",
                                                "sense_id": "4926d5b8-362a-39da-abe3-6461ef862c10",
                                                "text": "Les Mangaréviens, qui chantaient harmonieusement, se servaient fort mal de la mandoline et de l’accordéon, et jadis leurs instruments préférés pour les danses étaient les tambours en bois."
                                            },
                                            {
                                                "example_id": "fe475c8f-d148-4b93-8c71-990d5ffa681f",
                                                "sense_id": "4926d5b8-362a-39da-abe3-6461ef862c10",
                                                "text": "Stérilité –\nJadis masculin,\n« COVID-19 » est féminin !\n« Malade » ? Épicène !"
                                            },
                                            {
                                                "example_id": "9fb528b0-0a48-4801-a652-7149871a36ad",
                                                "sense_id": "4926d5b8-362a-39da-abe3-6461ef862c10",
                                                "text": "Ils possèdent des armes numériques et ils ont de puissants alliés à l’intérieur et à l’extérieur de l’Europe. Mais nous les battrons, comme nous les avons battus jadis"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jadis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "affff99a-670c-33a7-b492-2f705ef2a3ad",
                                        "entry_id": "2bd642a1-155b-3511-9806-6ebab58810d1",
                                        "glosses": [
                                            "Le passé."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e387d113-9279-44e9-9cfb-8cf91b84ac0d",
                                                "sense_id": "affff99a-670c-33a7-b492-2f705ef2a3ad",
                                                "text": "Tu dois savoir, Haig, mon fils, qu’à partir d’aujourd’hui, à l’instar d’un jadis pas si lointain, la mort raccourt ici, rôdant tout autour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jadis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d4629e9-323c-3f13-838a-31cf1074fc41",
                                        "entry_id": "85072bd3-6fc8-3044-a8f0-6e54ff2b3da2",
                                        "glosses": [
                                            "D’autrefois, du temps passé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf320eba-55c9-41b8-a52d-e03922691f1b",
                                                "sense_id": "8d4629e9-323c-3f13-838a-31cf1074fc41",
                                                "text": "Quelles douces surprises, quelles fêtes intimes, que d'émotions délicieuses on éprouve en ouvrant un beau volume du temps jadis, du XVIIIᵉ siècle, par exemple (le siècle des élégances)!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66a6d601-f35f-4b55-8d4a-58f763ca98be",
                        "source_entry_id": "f2797f09-4150-3e42-8472-8afe7d04da85",
                        "source_sense_id": "91bb6b3d-d299-348b-859a-76c6cb91ec83",
                        "source_sense_description": "time long past",
                        "target_lang_word": "antan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "691ac25b-ce98-348b-bcbf-12b9705da497",
                                        "entry_id": "c30d70c1-ab06-37f9-bd1e-e5ab4b4cad89",
                                        "glosses": [
                                            "L’année dernière."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0bcfb99-cd13-4eb5-87b6-64813c64d391",
                                                "sense_id": "691ac25b-ce98-348b-bcbf-12b9705da497",
                                                "text": "Avec trois brins de sauge, une figue d’antan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "837d21ce-6f48-300a-bfcd-d4a686d3a47f",
                                        "entry_id": "c30d70c1-ab06-37f9-bd1e-e5ab4b4cad89",
                                        "glosses": [
                                            "Autrefois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a6db86c-f7b4-4f89-a63d-55648f771984",
                                                "sense_id": "837d21ce-6f48-300a-bfcd-d4a686d3a47f",
                                                "text": "La neige est plus que jamais d’antan comme chez François Villon : elle a partie liée avec la nostalgie."
                                            },
                                            {
                                                "example_id": "211002cd-f6ed-4ae2-b382-a1ad7cc8477a",
                                                "sense_id": "837d21ce-6f48-300a-bfcd-d4a686d3a47f",
                                                "text": "A l'instar de sa localisation, une vieille bâtisse fougeraise, la Tivabro est décorée à la mode Bretagne d’antan, avec goût et sans folklore tartignole."
                                            },
                                            {
                                                "example_id": "52b39bef-0190-4e6d-8dca-9241d419e4ae",
                                                "sense_id": "837d21ce-6f48-300a-bfcd-d4a686d3a47f",
                                                "text": "Louis XVIII […] avait appris et retenu cette leçon : ce qui bouge trop meurt vite, et s’était enfermé dans l’étiquette, les usages râpés et les habitudes hiératiques d’antan."
                                            },
                                            {
                                                "example_id": "6e04d716-8dc2-4e40-b252-329f32a0e144",
                                                "sense_id": "837d21ce-6f48-300a-bfcd-d4a686d3a47f",
                                                "text": "En prenant ses distances avec la droite religieuse, en accédant aux demandes du nationalisme caquiste et en se recentrant économiquement, O’Toole semble vouloir recréer ce « progressisme conservateur » d’antan."
                                            },
                                            {
                                                "example_id": "3d492b8c-07ea-45e9-b4d2-e168bee27df0",
                                                "sense_id": "837d21ce-6f48-300a-bfcd-d4a686d3a47f",
                                                "text": "Un amour d’antan."
                                            },
                                            {
                                                "example_id": "71972108-a376-4c6a-ab07-01978383c35b",
                                                "sense_id": "837d21ce-6f48-300a-bfcd-d4a686d3a47f",
                                                "text": "Mais où sont les neiges d’antan ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
