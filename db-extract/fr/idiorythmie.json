                        "glosses": [
                            "Rythme propre à une personne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "78d7f04b-45c8-3a9e-9562-9c00d79dff94",
                        "entry_id": "02a7cb3e-fbca-39b5-aab7-5abfa3191b17",
                        "glosses": [
                            "Régime de certains monastères orthodoxes permettant aux moines de s’organiser à leur propre rythme et de posséder des biens propres."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ec287d73-b705-4b3b-8621-55e99a3b37a4",
                                "sense_id": "78d7f04b-45c8-3a9e-9562-9c00d79dff94",
                                "text": "« Trouver son rythme propre » renvoie à l’appellation un peu barbare d’« idiorythmie ». Appartenant au vocabulaire religieux, ce mot désigne précisément une autre organisation monacale, largement minorisée et radicalement critiquée en Occident. Il renvoie au mode de vie de moines orientaux vivant au mont Athos, chacun selon son rythme propre."
                            }
                        ]
                    }
