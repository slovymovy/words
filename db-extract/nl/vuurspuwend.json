                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "99bbe12a-7465-3f12-830e-796001d7805f",
                        "entry_id": "096367ae-ce08-3dd0-b7d6-1e68f33fab67",
                        "glosses": [
                            "vlammen uitbrakend; lava uitbrakend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19ca83ba-371c-461c-881d-8599f4ab3e8d",
                                "sense_id": "99bbe12a-7465-3f12-830e-796001d7805f",
                                "text": "Bij Hawaï denken de meeste mensen niet meteen aan voedsel. Vuurspuwende vulkanen, vrouwen met bloemenkransen om de nek en het woord aloha schieten eerder te binnen."
                            },
                            {
                                "example_id": "dfa1e36d-88fd-4f76-9490-a7d1ad2fd548",
                                "sense_id": "99bbe12a-7465-3f12-830e-796001d7805f",
                                "text": "Het zou ook kunnen duiden op een duidelijkere strijd tussen vuur en ijs. In dat geval zou er gedoeld worden op de vuurspuwende draken van Daenerys Targaryen, de ogenschijnlijk grootste concurrent van de White Walkers."
                            }
                        ]
                    },
                    {
                        "sense_id": "0226f12c-d044-3ae5-bbd4-a9d3c85823d7",
                        "entry_id": "096367ae-ce08-3dd0-b7d6-1e68f33fab67",
                        "glosses": [
                            "heel erg boos"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "39a0cc8b-b8fe-4792-800c-3048223478c3",
                                "sense_id": "0226f12c-d044-3ae5-bbd4-a9d3c85823d7",
                                "text": "Hirscher, die onder het kunstlicht op de Oostenrijkse piste zijn zesde seizoenszege, behaalde, verontschuldigde zich voor het wangedrag van zijn landgenoten bij Kristoffersen. \"Beschamend\", verzuchtte de winnaar. Kristoffersen kwam met vuurspuwende ogen en woedend over de finish."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1a7aada-b9b8-4b53-9a0b-8135daa05993",
                        "source_entry_id": "096367ae-ce08-3dd0-b7d6-1e68f33fab67",
                        "source_sense_id": "99bbe12a-7465-3f12-830e-796001d7805f",
                        "source_sense_description": "vlammen uitbrakend; lava uitbrakend",
                        "target_lang_word": "fire-breathing",
