                ],
                "senses": [
                    {
                        "sense_id": "2ed329d5-9d9c-3007-b525-c4c7bba23220",
                        "entry_id": "b2df8ab7-a49b-3b1b-a20a-d5fc9d734772",
                        "glosses": [
                            "Verhältnis/Gegebenheiten, welche die Beleuchtung betreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72060073-35c3-45b2-8a59-97e3fa14d6b3",
                                "sense_id": "2ed329d5-9d9c-3007-b525-c4c7bba23220",
                                "text": "„Nun, die Niere ist durch eine Membran vollständig verdeckt. Wer sie in Minutenschnelle bei schlechten Lichtverhältnissen entfernen will, muss chirurgisches Geschick besitzen.“"
                            },
                            {
                                "example_id": "1ba74aef-3b42-46ea-8b83-a07c0d5b2816",
                                "sense_id": "2ed329d5-9d9c-3007-b525-c4c7bba23220",
                                "text": "„Die Lichtverhältnisse mussten ihm einen Streich spielen, denn im ersten Moment kam es ihm fast so vor, als habe jemand ein zuckendes Gesicht in den Stamm geschnitzt, ebenso lang und schmal wie der Torweg.“"
                            },
                            {
                                "example_id": "9fff92a3-0630-4fa8-ab40-02265dd7cefd",
                                "sense_id": "2ed329d5-9d9c-3007-b525-c4c7bba23220",
                                "text": "„Nachdem sie sich hinter ihnen wieder geschlossen hatte, dauerte es ein paar Wimpernschläge, bis ihre Augen sich an die Lichtverhältnisse gewöhnt hatten.“"
                            },
                            {
                                "example_id": "0b518226-5992-4661-afc2-b94655820212",
                                "sense_id": "2ed329d5-9d9c-3007-b525-c4c7bba23220",
                                "text": "„Kurze Zeit nach der Veränderung der Lichtverhältnisse kamen wir aus dem Tunnel heraus, und die Vibrationen, die uns während der letzten zwei Tage begleitet hatten, ließen nach.“"
                            },
                            {
                                "example_id": "053848e6-1772-4b38-9176-0241e6134190",
                                "sense_id": "2ed329d5-9d9c-3007-b525-c4c7bba23220",
                                "text": "„Das ist die perfekte Kamera für alle Arten von Lichtverhältnissen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
