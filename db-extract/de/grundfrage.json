                        "entry_id": "d2a9bfa3-4eb7-32c2-9671-5d412f520068",
                        "glosses": [
                            "etwas, das für nachrangige Fragen/Probleme grundlegend ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41b27ef0-a15c-42ac-beb4-271e006e96d9",
                                "sense_id": "6c67c9b3-0d3c-3378-8c27-d1133872aac1",
                                "text": "„Mathematik hat es schon in vorgriechischer Zeit gegeben; ebenso wurde auch die religiöse Grundfrage nach Schöpfung und Schöpfer nicht erst in der klassischen Antike gestellt.“"
                            },
                            {
                                "example_id": "18249590-172a-439a-ad9a-01a87260b7a1",
                                "sense_id": "6c67c9b3-0d3c-3378-8c27-d1133872aac1",
                                "text": "„Gleichzeitig beantragte sie, das Verfahren vorläufig »auf diese Grundfrage des Bestehens der Ehe« einzuschränken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
