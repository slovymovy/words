                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc655808-69d9-32c3-ae4a-1b69e620682b",
                        "entry_id": "edf01796-8764-3583-a0cc-622cd0825644",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd73bca3-fa5d-4f53-b0ea-0c85460220df",
                                "sense_id": "bc655808-69d9-32c3-ae4a-1b69e620682b",
                                "text": "Samochód Edwarda stoi w garażu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dc1f564-41e2-4445-94c6-818066572461",
                        "source_entry_id": "edf01796-8764-3583-a0cc-622cd0825644",
                        "source_sense_id": "bc655808-69d9-32c3-ae4a-1b69e620682b",
                        "target_lang_word": "Edward",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Edward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                        "entry_id": "827c856f-25f4-3948-9a5e-725a2739cd5a",
                                        "glosses": [
                                            "A male given name from Old English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ee615e3-3d65-4883-96c1-3a26ffb9f458",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "The Christian humility of King Edward the Confessour brought such credit to this name, that since that time it hath been most usual in all estates."
                                            },
                                            {
                                                "example_id": "65c70d7d-98bb-4f61-abd8-3b37b1689e7e",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "Heaven is my witness! that in the warmest transport of my wishes for the prosperity of my child, I never once wished to crown his head with more glory and honour than what George or Edward would have spread around it."
                                            },
                                            {
                                                "example_id": "623d78e9-1a28-4dc0-aad3-8b3d93a25084",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "There's a world of difference between the name Edward, which sounds rather regal and stuffy (Edwardian) and the name Eddie, which sounds like a guy on the bus."
                                            },
                                            {
                                                "example_id": "29072844-ccca-49f4-b690-7bafdd34d26a",
                                                "sense_id": "73c48691-3812-3f6f-aea3-13610c7942d3",
                                                "text": "The engineers are Akash Bobba, Edward Coristine, Luke Farritor, Gautier Cole Killian, Gavin Kliger, and Ethan Shaotran."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3adad8b9-2738-3613-bcc6-58147661063d",
                                        "entry_id": "827c856f-25f4-3948-9a5e-725a2739cd5a",
                                        "glosses": [
                                            "A surname. See also Edwards."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Edward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b96408b-30f1-32da-a20d-baa3011a4f10",
                                        "entry_id": "a840541c-3bea-3e0f-8108-1d25a296272a",
                                        "glosses": [
                                            "A gold coin produced in the reign of King Edward."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbcf2cec-2edd-4620-9972-a582644ff30f",
                                                "sense_id": "8b96408b-30f1-32da-a20d-baa3011a4f10",
                                                "text": "It is indeed the same golden Edward, with three holes in it, with which I presented my Mary on her birthday, in her eighteenth year, to buy a new suit for the holidays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06d43ccd-5685-4081-a31c-47091d3c9226",
                        "source_entry_id": "edf01796-8764-3583-a0cc-622cd0825644",
                        "source_sense_id": "bc655808-69d9-32c3-ae4a-1b69e620682b",
