                "senses": [
                    {
                        "sense_id": "3ab166e0-8287-3b27-b99d-1f9624129ac8",
                        "entry_id": "0971eecd-8846-302d-bac9-17588977cdad",
                        "glosses": [
                            "Instrument de percussion composé d’un disque de bronze à bords relevés qui rend, lorsqu’on le frappe avec un maillet recouvert de peau, un son très retentissant et indéterminé, contrairement au gong."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "389e9734-4837-4ac8-a4b9-ab72ce25abf8",
                                "sense_id": "3ab166e0-8287-3b27-b99d-1f9624129ac8",
                                "text": "Un coup de tamtam."
                            },
                            {
                                "example_id": "59c934a9-72e3-474b-9111-307a3f90356e",
                                "sense_id": "3ab166e0-8287-3b27-b99d-1f9624129ac8",
                                "text": "Le bruit du tamtam est lugubre."
                            }
                        ]
                    },
                    {
                        "sense_id": "36489914-7e72-3ff2-9c6f-4b04133898a1",
                        "entry_id": "0971eecd-8846-302d-bac9-17588977cdad",
                        "glosses": [
                            "Tambour africain, lequel est un cylindre recouvert de peau. (Voir précisions dans l’article tam-tam)"
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f56c0138-0dca-42b4-88cc-ada2b5681006",
                                "sense_id": "36489914-7e72-3ff2-9c6f-4b04133898a1",
                                "text": "Le tamtam résonne dans la savane."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f59dda78-86f0-427b-9d3b-5d020c4f99be",
                        "source_entry_id": "0971eecd-8846-302d-bac9-17588977cdad",
                        "source_sense_description": "instrument en forme de disque",
                        "target_lang_word": "Tamtam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tamtam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c4e1504-361c-3535-8f6c-cf7dd5730a2d",
                                        "entry_id": "e5845340-6b27-3957-ad11-4ee7ba889a67",
                                        "glosses": [
                                            "großer, meist bronzener Gong mit umgeschlagenem Rand, der ursprünglich aus Asien stammt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3b95f68-ff4e-4fc0-83b6-3070015072c9",
                                                "sense_id": "9c4e1504-361c-3535-8f6c-cf7dd5730a2d",
                                                "text": "Zu Beginn des Stückes ertönt krachend das Tamtam."
                                            },
                                            {
                                                "example_id": "9d5186cf-1469-4fcd-b83a-701b8c6347a1",
                                                "sense_id": "9c4e1504-361c-3535-8f6c-cf7dd5730a2d",
                                                "text": "„Der Pompon wird das Tamtam und das Tamtam der Pompon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b80f24f-5ea5-3bc7-803d-d599e5874ada",
                                        "entry_id": "e5845340-6b27-3957-ad11-4ee7ba889a67",
                                        "glosses": [
                                            "großes Aufsehen, viel Getöse um eine unbedeutende Sache"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c3533bf-e197-4855-9feb-e338926d1eac",
                                                "sense_id": "5b80f24f-5ea5-3bc7-803d-d599e5874ada",
                                                "text": "Macht nicht so viel Tamtam um diese Kleinigkeit."
                                            },
                                            {
                                                "example_id": "3b46d2ec-9a89-46a1-8f73-bc32485b85d0",
                                                "sense_id": "5b80f24f-5ea5-3bc7-803d-d599e5874ada",
                                                "text": "Der mit viel Tamtam angekündigte Neuanfang entpuppte sich als Luftnummer."
                                            },
                                            {
                                                "example_id": "24a6f562-049c-4b19-8f25-3fb87123ec7d",
                                                "sense_id": "5b80f24f-5ea5-3bc7-803d-d599e5874ada",
                                                "text": "„Darin kündigte er mit großem Tamtam seinen Deutschlandbesuch an und wollte wissen, ob er zweimal bei uns übernachten dürfe.“"
                                            },
                                            {
                                                "example_id": "ae19aee6-66b0-4892-a3e3-31bc2515e1dd",
                                                "sense_id": "5b80f24f-5ea5-3bc7-803d-d599e5874ada",
                                                "text": "„Das 100-jährige Jubiläum steht kurz bevor. Mit viel Tamtam will die Stiftung Bauhaus 2019 an die glorreiche Zeit der Kunst- und Designschule zwischen 1919 bis 1933 erinnern, die von den Nationalsozialisten geschlossen wurde.“"
                                            },
                                            {
                                                "example_id": "e6009f06-2cca-421c-92d9-ec7b1a47f857",
                                                "sense_id": "5b80f24f-5ea5-3bc7-803d-d599e5874ada",
                                                "text": "„Vor einem Jahr hat die Afrikanische Union in Niamey mit viel Tamtam die Afrikanische Freihandelszone AfCFTA ins Leben gerufen.“"
                                            },
                                            {
                                                "example_id": "07822d34-d8f9-4508-b647-e7338ff3d760",
                                                "sense_id": "5b80f24f-5ea5-3bc7-803d-d599e5874ada",
                                                "text": "„Pippa wünscht sich eine Luxus-Hochzeit mit allem Tamtam, das dazugehört. Und sie bekommt sie.“"
                                            },
                                            {
                                                "example_id": "f36fd599-9b38-4fe1-8bdf-f69f7e207a7c",
                                                "sense_id": "5b80f24f-5ea5-3bc7-803d-d599e5874ada",
                                                "text": "„All das massenkulturelle Tamtam kümmert Paul Henreid jedoch wenig.“"
                                            },
                                            {
                                                "example_id": "c6690c24-83c4-46df-b39c-9746e596d964",
                                                "sense_id": "5b80f24f-5ea5-3bc7-803d-d599e5874ada",
                                                "text": "„Kein großes Tamtam mit Picknickkorb oder Tellern oder so, nur Wurst und dunkles Brot und Margarinesandwiches, eingewickelt in Packpapier.“"
                                            },
                                            {
                                                "example_id": "e5bb9c7c-ba5f-40a7-aff6-408bc2386ffb",
                                                "sense_id": "5b80f24f-5ea5-3bc7-803d-d599e5874ada",
                                                "text": "[Fußball:] „Der zurückhaltende Schweizer [Anmerkung: der Trainer Lucien Favre] ist ein Anti-Klopp. Er agiert zurückhaltend, leise, ohne großes Tamtam, das sich die Anhänger der Borussen aber aus vollem Herzen wünschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fd7de3b8-9a6c-32de-9d52-6b7f9a85222b",
                                        "entry_id": "e5845340-6b27-3957-ad11-4ee7ba889a67",
                                        "glosses": [
                                            "afrikanische Trommel aus Holz"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
