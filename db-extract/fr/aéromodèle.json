                        "sense_id": "a91f3444-bb7f-3dc6-95ad-82767c2d9d13",
                        "entry_id": "dd3e0ab3-5e2b-3a05-9199-05563a2fe65a",
                        "glosses": [
                            "Modèle réduit d'aéronef conçu pour voler."
                        ],
                        "tags": [
                            "Modélisme"
                        ],
                        "examples": [
                            {
                                "example_id": "557f8379-a37d-4a56-84b1-d4efb4f153b9",
                                "sense_id": "a91f3444-bb7f-3dc6-95ad-82767c2d9d13",
                                "text": "L’Italie a organisé deux concours d’aéromodèles, l’un la Journée Ambrosiane pour l’aéromodélisme et l’autre, la Coupe Stella d’Italie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "463ec9b5-0d03-44ee-a51e-a50e566963b9",
                        "source_entry_id": "dd3e0ab3-5e2b-3a05-9199-05563a2fe65a",
                        "source_sense_id": "a91f3444-bb7f-3dc6-95ad-82767c2d9d13",
                        "target_lang_word": "Modellflugzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Modellflugzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                        "entry_id": "f05aee01-97a1-38a9-863e-4fa5f36ce42e",
                                        "glosses": [
                                            "kleines Flugzeug, das dem Vergnügen und einer Beschäftigung in der Freizeit dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e4424d-5cbf-4177-bcb1-d52b4e01dafe",
                                                "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                                "text": "Es macht viel Spaß, ein Modellflugzeug zusammenzubauen."
                                            },
                                            {
                                                "example_id": "db09585b-b0fe-4c32-a99e-dbf9f537b2fa",
                                                "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                                "text": "„Für den Sohn Bruce war es […] schwierig, Freunde zu finden, er blieb für sich, las viel und baute Modellflugzeuge.“"
                                            },
                                            {
                                                "example_id": "5e934cd5-eb61-4bc2-b22f-a44abf4c525d",
                                                "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                                "text": "„»Mein Vater hat mir alles beigebracht, was das Modellfliegen und die Konstruktionen betrifft, also das Zusammenbauen und das Beherrschen von Materialien, Techniken, Elektrotechnik, also alles, was mit dem Modellflugzeug in Verbindung steht, bis es in der Luft fliegt.« (Emil Zubalič)“"
                                            },
                                            {
                                                "example_id": "a25b2d7c-cd4d-4c4e-920a-2a6c90ce8405",
                                                "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                                "text": "„Das Modellflugzeug, das Roland seinem Sohn Jakob geschenkt hat, ist endlich fertig.“"
                                            },
                                            {
                                                "example_id": "20f04055-77d2-42e0-a6ba-bea133455286",
                                                "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                                "text": "„Wann immer seine Freizeit es zulässt, stellt sich Wolfgang Auth auf eine Wiese und lässt kleine Flugzeuge fliegen. Der Polizist steuert seit 30 Jahren Modellflugzeuge durch die Luft.“"
                                            },
                                            {
                                                "example_id": "0a87b335-cecf-4ac9-8cbb-aad877539aa4",
                                                "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                                "text": "„Bereits als Jugendlicher hantiert er in Bozen mit einem Modellflugzeug, das er mit Feuerwerkskörpern bestückt - bis erboste Nachbarn die Polizei rufen.“"
                                            },
                                            {
                                                "example_id": "d44b88f8-aafd-42de-b90d-c553e97e643b",
                                                "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                                "text": "„Die Technik des FPV-Fliegens eröffnet neue Möglichkeiten. Das Konzept ist verblüffend einfach: mit einer speziellen Videobrille kann der Pilot das Videosignal aus einer Kamera empfangen. Die ist eingebaut in seinem ferngesteuerten Modellflugzeug. So erlebt der Pilot den Flug wie aus dem Cockpit des Fliegers, obwohl er am Boden in seinem Sessel sitzt.“"
                                            },
                                            {
                                                "example_id": "20d492ca-bfa3-4267-a457-be78664ffe4d",
                                                "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                                "text": "„Am Freitagnachmittag ist ein turbinenbetriebenes Modellflugzeug im Bereich des Segelflughafens beim Landeanflug abgestürzt und hat Feuer gefangen.“"
                                            },
                                            {
                                                "example_id": "3376c4b0-80e6-48d4-bb83-26f787ded0d2",
                                                "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                                "text": "„Modellflugzeuge oder Mini-Drohnen dürfen während des Weltwirtschaftsforums in der ganzen Gegend um Davos und Teilen des Prättigaus nicht gestartet werden.“"
                                            },
                                            {
                                                "example_id": "382da538-a940-40a0-9f9c-1972933d8d88",
                                                "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                                "text": "„Die Modelfluggruppe Fricktal wehrt sich gegen die Aargauer Regierung und das Verwaltungsgericht. Auch in Zukunft sollen auf der Graspiste im Rheinfelder «Grossgrüt» Modellflugzeuge starten und landen dürfen. Das Bundesgericht, so hofft die Modelfluggruppe, soll die Vorinstanzen zurückpfeifen.“"
                                            },
                                            {
                                                "example_id": "c7dd7b89-1d32-4b64-a0c8-f46beb0533d2",
                                                "sense_id": "e12843d6-5853-3fc2-a727-04bd903871af",
                                                "text": "„Über Anschläge mit Modellflugzeugen war in Sicherheitskreisen in der Vergangenheit immer wieder spekuliert worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
