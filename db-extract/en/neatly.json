                "senses": [
                    {
                        "sense_id": "2b6c948a-2f32-3236-bc71-07f898b07b0f",
                        "entry_id": "54bd1aa9-30d8-3d00-b235-b473fc8c0e60",
                        "glosses": [
                            "In a neat manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea2c2358-3a91-4640-8bdf-7a4a75fec481",
                                "sense_id": "2b6c948a-2f32-3236-bc71-07f898b07b0f",
                                "text": "I was delighted to see A Woman's Place take a stand against censorship. But I noted with some cynicism that the exhibit failed to include any of the numerous publications suppressed by institutions of the feminist community. It thus neatly avoided acknowledging the role being played by the women's movement as a force for censorship (and the rather sordid past of A Woman's Place itself)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "156bb4b3-ea82-4ec4-b3d2-a6c930e74554",
                        "source_entry_id": "54bd1aa9-30d8-3d00-b235-b473fc8c0e60",
                        "source_sense_id": "2b6c948a-2f32-3236-bc71-07f898b07b0f",
                        "source_sense_description": "in a neat manner",
                        "target_lang_word": "proprement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proprement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0c1e517-4272-383e-88ae-3d9c3531cb9d",
                                        "entry_id": "27d3d850-7738-3921-b8a2-5da2832c994c",
                                        "glosses": [
                                            "Précisément, exactement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0672a2e4-9a8c-44bb-b82b-53a6a64e4c95",
                                                "sense_id": "d0c1e517-4272-383e-88ae-3d9c3531cb9d",
                                                "text": "Sparte était proprement un camp où les citoyens, abandonnant aux esclaves la culture des terres, s’exerçaient uniquement au métier des armes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02398f8-3db8-3be1-bdf2-b9093539ccca",
                                        "entry_id": "27d3d850-7738-3921-b8a2-5da2832c994c",
                                        "glosses": [
                                            "Dans le sens propre, par opposition à : au sens figuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbd1d576-bba3-40d1-b74c-d7255107d825",
                                                "sense_id": "e02398f8-3db8-3be1-bdf2-b9093539ccca",
                                                "text": "Le tour de passe-passe imaginé par son frère était proprement stupéfiant."
                                            },
                                            {
                                                "example_id": "c381fbab-ddf6-4ab5-88ed-cff3f41f026b",
                                                "sense_id": "e02398f8-3db8-3be1-bdf2-b9093539ccca",
                                                "text": "Ce mot s’emploie proprement et figurément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e5d5ce1-2478-3901-b679-1a034bb59122",
                                        "entry_id": "27d3d850-7738-3921-b8a2-5da2832c994c",
                                        "glosses": [
                                            "D’une manière bienséante, convenable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e992b65-3406-4810-aec7-9c150825e030",
                                                "sense_id": "9e5d5ce1-2478-3901-b679-1a034bb59122",
                                                "text": "J'ai fait dessein de me mettre aujourd'hui un peu proprement. - Toi, proprement ! et avec quoi ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5a82fc7-4e2b-3842-8cc6-5176988334b8",
                                        "entry_id": "27d3d850-7738-3921-b8a2-5da2832c994c",
                                        "glosses": [
                                            "Avec régularité et netteté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "922b657d-3db7-4cdb-b1d0-02c0798e3228",
                                                "sense_id": "b5a82fc7-4e2b-3842-8cc6-5176988334b8",
                                                "text": "Au-dessus de l’arc de la porte, […], se voient, sur les flancs de chacune des deux tours, trois entailles proprement faites ; […]."
                                            },
                                            {
                                                "example_id": "a90a3da1-2a01-4918-85f0-c1ef6350dfbb",
                                                "sense_id": "b5a82fc7-4e2b-3842-8cc6-5176988334b8",
                                                "text": "Travailler proprement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f871727d-152b-30e2-be38-e2c8c208c1b9",
                                        "entry_id": "27d3d850-7738-3921-b8a2-5da2832c994c",
                                        "glosses": [
                                            "Avec grâce et adresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d704d3-8cd2-4325-ac1c-4a9d832e95ea",
                                                "sense_id": "f871727d-152b-30e2-be38-e2c8c208c1b9",
                                                "text": "Chanter ou jouer proprement, c’est exécuter une mélodie française avec les ornements qui lui conviennent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8f4050c-86e2-35fd-82d2-30915cade482",
                                        "entry_id": "27d3d850-7738-3921-b8a2-5da2832c994c",
                                        "glosses": [
                                            "Avec propreté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38c9b34a-ad59-442e-89bf-03ad4b1524c1",
                                                "sense_id": "c8f4050c-86e2-35fd-82d2-30915cade482",
                                                "text": "Cette maison est tenue proprement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "843c67d6-a29b-45a1-92d9-63a415a80d5d",
                        "source_entry_id": "54bd1aa9-30d8-3d00-b235-b473fc8c0e60",
                        "source_sense_id": "2b6c948a-2f32-3236-bc71-07f898b07b0f",
                        "source_sense_description": "in a neat manner",
                        "target_lang_word": "élégamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élégamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "035f2e5d-0f5b-332a-9c9a-edd2063c8be8",
                                        "entry_id": "037ca322-0b6b-3423-ab5f-583b35d2f985",
                                        "glosses": [
                                            "Avec élégance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89e45058-a88c-4e51-b1c3-c2490756dd94",
                                                "sense_id": "035f2e5d-0f5b-332a-9c9a-edd2063c8be8",
                                                "text": "« Avec l’élégance actuelle de nos façons polies, qu’est-ce qu’une femme peut connaître d’un jeune homme correct, après cinquante visites, si ce n’est son degré d’esprit et le plus ou moins de progrès qu’il a pu faire dans l’art de dire élégamment des choses insignifiantes ? Mais de son cœur, de sa façon particulière d’aller à la chasse du bonheur ? Rien, ou il n’est pas correct. »"
                                            },
                                            {
                                                "example_id": "d3d9d18f-4403-4056-8a78-d94ad7f55983",
                                                "sense_id": "035f2e5d-0f5b-332a-9c9a-edd2063c8be8",
                                                "text": "Il était simplement mis, mais élégamment vêtu d’un pourpoint de drap violet foncé avec de légères broderies de soie de même couleur."
                                            },
                                            {
                                                "example_id": "966b5ebb-42c3-415d-b6e8-b6fb84082d7c",
                                                "sense_id": "035f2e5d-0f5b-332a-9c9a-edd2063c8be8",
                                                "text": "Chacun mange élégamment avec le pouce et l'index, ce qui se nomme en langage vulgaire les fourchettes du père Adam."
                                            },
                                            {
                                                "example_id": "8d82cfc9-f6ab-4987-a242-ca0e36a545e7",
                                                "sense_id": "035f2e5d-0f5b-332a-9c9a-edd2063c8be8",
                                                "text": "Je sais bien que Votre Majesté n'a que faire de toutes nos dédicaces, et que ces prétendus devoirs dont on lui dit élégamment qu’on s'acquitte envers elle, sont des hommages, à dire vrai, dont elle nous dispenserait très volontiers,"
                                            },
                                            {
                                                "example_id": "127209b7-96a0-45f5-8bf3-cc33e1841708",
                                                "sense_id": "035f2e5d-0f5b-332a-9c9a-edd2063c8be8",
                                                "text": "Ah ! voilà parler d’amour bien élégamment, repartit Collantine, ce langage me plaît,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc8af26b-b600-4f64-b9b6-6f1bb604017b",
                        "source_entry_id": "54bd1aa9-30d8-3d00-b235-b473fc8c0e60",
                        "source_sense_id": "2b6c948a-2f32-3236-bc71-07f898b07b0f",
                        "source_sense_description": "in a neat manner",
                        "target_lang_word": "чисто",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чисто",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "98ebbf5e-0bbf-3f41-bd8e-93bcc072a28a",
                                        "entry_id": "cef1b932-be44-39c6-bda4-357d710ead6d",
                                        "glosses": [
                                            "наречие к чистый; без грязи, примесей или посторонних нежелательных объектов"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c07162e1-342b-4ae8-ae0c-1aaf52ccd218",
                                                "sense_id": "98ebbf5e-0bbf-3f41-bd8e-93bcc072a28a",
                                                "text": "В комнате чисто."
                                            },
                                            {
                                                "example_id": "f612bf72-972e-4074-8578-88e387f8700c",
                                                "sense_id": "98ebbf5e-0bbf-3f41-bd8e-93bcc072a28a",
                                                "text": "Он чисто вымыл пол."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bee054c1-bde0-3a18-8c44-58362a86399a",
                                        "entry_id": "cef1b932-be44-39c6-bda4-357d710ead6d",
                                        "glosses": [
                                            "перен. непорочно, возвышенно, целомудренно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7effb85c-bc29-41b2-8c26-43c688543e00",
                                                "sense_id": "bee054c1-bde0-3a18-8c44-58362a86399a",
                                                "text": "Он любил её так чисто!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1120be0-1078-3f42-a5b8-ef4cfc079485",
                                        "entry_id": "cef1b932-be44-39c6-bda4-357d710ead6d",
                                        "glosses": [
                                            "перен. без единой ошибки, аккуратно, безупречно, искусно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "947d41a2-bc80-46c6-9de0-5d3dde1d025d",
                                                "sense_id": "a1120be0-1078-3f42-a5b8-ef4cfc079485",
                                                "text": "Чисто выполненная работа."
                                            },
                                            {
                                                "example_id": "1a01dace-a429-4cf6-9e3d-ce5bba733626",
                                                "sense_id": "a1120be0-1078-3f42-a5b8-ef4cfc079485",
                                                "text": "Первый раз такую штуку вижу. ― Чисто сделано, ― тихонько подтвердил Карась. ― Что же теперь делать?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6d2d804-ae3b-3764-bd6f-b8244c062cdc",
                                        "entry_id": "cef1b932-be44-39c6-bda4-357d710ead6d",
                                        "glosses": [
                                            "перен. совершенно, полностью, типично, сугубо"
                                        ],
                                        "tags": [
                                            ", в знач. частицы"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51eed9bb-ed70-40a0-af35-60bb6669caf6",
                                                "sense_id": "d6d2d804-ae3b-3764-bd6f-b8244c062cdc",
                                                "text": "Чисто английское убийство."
                                            },
                                            {
                                                "example_id": "bded36b3-6b05-456f-86ed-684c8010f98e",
                                                "sense_id": "d6d2d804-ae3b-3764-bd6f-b8244c062cdc",
                                                "text": "Чисто научный опыт, как нельзя лучше доказывающий, что никаких чудес и магии не существует."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "747c83c2-a513-354a-aaf2-4d28a25051ff",
                                        "entry_id": "cef1b932-be44-39c6-bda4-357d710ead6d",
                                        "glosses": [
                                            "разг. исключительно, не более чем, только, просто"
                                        ],
                                        "tags": [
                                            ", в знач. частицы"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bbc0390-6828-40bb-8cfe-70b1b4416397",
                                                "sense_id": "747c83c2-a513-354a-aaf2-4d28a25051ff",
                                                "text": "Потом мы зашли в гости, чисто чайку попить."
                                            },
                                            {
                                                "example_id": "b6002c7a-5cb2-4de8-93ff-eb43164c9e68",
                                                "sense_id": "747c83c2-a513-354a-aaf2-4d28a25051ff",
                                                "text": "Предположим чисто теоретически."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a006187-1887-384a-bd08-4ae478277d0b",
                                        "entry_id": "cef1b932-be44-39c6-bda4-357d710ead6d",
                                        "glosses": [
                                            "прост. словно, как, как будто, точь-в-точь, ровно"
                                        ],
                                        "tags": [
                                            ", в знач. союза"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c57e4469-7013-4bd9-8ccc-7e32c7e3c965",
                                                "sense_id": "1a006187-1887-384a-bd08-4ae478277d0b",
                                                "text": "Встретил я вчера кого-то, так он был чёрен чисто галка!"
                                            },
                                            {
                                                "example_id": "9fa4f749-d8c8-40ce-8edf-270212978683",
                                                "sense_id": "1a006187-1887-384a-bd08-4ae478277d0b",
                                                "text": "Зина сейчас придёт. Что ты, чисто тебя тоже омолодили? ― Нам это ни к чему, ― плохо владея собой и хрипло отвечал черноусый."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa76718f-f8fd-3676-bc71-35bdc6eba9f2",
                                        "entry_id": "cef1b932-be44-39c6-bda4-357d710ead6d",
                                        "glosses": [
                                            "жарг. используется для придания большего веса последующему выражению"
                                        ],
                                        "tags": [
                                            ", в знач. частицы"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aad7d912-d488-4569-8c52-8ae6c1605bd6",
                                                "sense_id": "aa76718f-f8fd-3676-bc71-35bdc6eba9f2",
                                                "text": "Вован — чисто крутой пацан."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
