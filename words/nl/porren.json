{
    "word_family": [
        "por",
        "gepor",
        "porder",
        "porring"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7bc87d2b-a81e-32bc-a325-8125532e9214",
                    "sense_definition": "stoten met de hand, een stok of ander langwerpig voorwerp",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>porde</w> eens flink in de verstopte afvoer en de verstopping schoot los.",
                            "target_lang_translations": {
                                "en": "He gave the clogged drain a good <w>poke</w> and the blockage came loose.",
                                "fr": "Il a bien <w>tringlé</w> dans l'évacuation bouchée et le bouchon est parti."
                            }
                        },
                        {
                            "text": "Zij <w>porde</w> hem met haar elleboog in zijn zij om zijn aandacht te trekken.",
                            "target_lang_translations": {
                                "en": "She <w>nudged</w> him in the side with her elbow to get his attention.",
                                "fr": "Elle lui a <w>donné un coup de coude</w> dans les côtes pour attirer son attention."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoten",
                        "prikken",
                        "duwen"
                    ],
                    "common_phrases": [
                        "in de zij porren",
                        "met een stok porren"
                    ],
                    "target_lang_definitions": {
                        "en": "to push or jab with a hand, a stick, or another long object",
                        "fr": "pousser ou piquer avec la main, un bâton ou un autre objet allongé"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "poke",
                                "target_lang_sense_clarification": "to prod with a finger or object"
                            },
                            {
                                "target_lang_word": "prod",
                                "target_lang_sense_clarification": "to push or jab, often to get a reaction"
                            },
                            {
                                "target_lang_word": "nudge",
                                "target_lang_sense_clarification": "to push gently, especially with the elbow"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "tisonner",
                                "target_lang_sense_clarification": "remuer avec un tisonnier ou un bâton"
                            },
                            {
                                "target_lang_word": "donner un coup de coude",
                                "target_lang_sense_clarification": "pousser légèrement pour attirer l'attention"
                            },
                            {
                                "target_lang_word": "pousser",
                                "target_lang_sense_clarification": "donner un coup avec un objet ou la main"
                            },
                            {
                                "target_lang_word": "toucher",
                                "target_lang_sense_clarification": "piquer ou pousser du doigt ou avec un objet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f45e217-1ccb-3a78-bff1-d78bc657a32f",
                    "sense_definition": "iemand in alle vroegte wakker maken",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zal je morgenochtend wel <w>porren</w> als het tijd is om op te staan.",
                            "target_lang_translations": {
                                "en": "I will <w>wake</w> you <w>up</w> tomorrow morning when it is time to get up.",
                                "fr": "Je te <w>réveillerai</w> demain matin quand il sera l'heure de se lever."
                            }
                        },
                        {
                            "text": "Hij moest zijn broer vroeg <w>porren</w> om de trein niet te missen.",
                            "target_lang_translations": {
                                "en": "He had to <w>rouse</w> his brother early so as not to miss the train.",
                                "fr": "Il a dû <w>tirer</w> son frère <w>du lit</w> tôt pour ne pas rater le train."
                            }
                        }
                    ],
                    "synonyms": [
                        "wekken",
                        "wakker maken"
                    ],
                    "common_phrases": [
                        "iemand wakker porren"
                    ],
                    "target_lang_definitions": {
                        "en": "to wake someone up very early in the morning",
                        "fr": "réveiller quelqu'un de très bon matin"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wake up",
                                "target_lang_sense_clarification": "to cause someone to stop sleeping"
                            },
                            {
                                "target_lang_word": "rouse",
                                "target_lang_sense_clarification": "to wake someone from a deep sleep"
                            },
                            {
                                "target_lang_word": "knock up",
                                "target_lang_sense_clarification": "British English: to wake someone by knocking on their door"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "réveiller",
                                "target_lang_sense_clarification": "faire sortir du sommeil"
                            },
                            {
                                "target_lang_word": "tirer du lit",
                                "target_lang_sense_clarification": "réveiller quelqu'un, souvent tôt ou brusquement"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a280bdd-8e74-3295-9d41-789f71a3bb10",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>por</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gaf hem een paar flinke <w>porren</w> om hem wakker te schudden.",
                            "target_lang_translations": {
                                "en": "He gave him a few hard <w>pokes</w> to shake him awake.",
                                "fr": "Il lui a donné quelques bonnes <w>secousses</w> pour le réveiller."
                            }
                        },
                        {
                            "text": "Na enkele <w>porren</w> in zijn rug draaide hij zich eindelijk om.",
                            "target_lang_translations": {
                                "en": "After a few <w>prods</w> in his back, he finally turned around.",
                                "fr": "Après quelques <w>coups</w> dans le dos, il s'est enfin retourné."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoten",
                        "duwen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of the noun 'por' (a poke or jab)",
                        "fr": "forme plurielle du nom « por » (un coup sec, une bourrade)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pokes",
                                "target_lang_sense_clarification": "plural of a quick push with a finger or object"
                            },
                            {
                                "target_lang_word": "prods",
                                "target_lang_sense_clarification": "plural of a stimulating poke"
                            },
                            {
                                "target_lang_word": "nudges",
                                "target_lang_sense_clarification": "plural of gentle pushes"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "coups de coude",
                                "target_lang_sense_clarification": "légères poussées données avec le coude"
                            },
                            {
                                "target_lang_word": "bourrades",
                                "target_lang_sense_clarification": "poussées un peu brusques de la main ou du coude"
                            },
                            {
                                "target_lang_word": "coups",
                                "target_lang_sense_clarification": "pressions ou poussées nettes"
                            }
                        ]
                    }
                }
            ]
        }
