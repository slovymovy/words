                                "target_word": "marginal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a1500d5-02c5-39cb-85e2-df0986e778a0",
                                        "entry_id": "1f21a3ba-4528-313e-9963-d4dac49ed411",
                                        "glosses": [
                                            "Of, relating to, or located at or near a margin or edge; also figurative usages of location and margin (edge)."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5609523e-4cd0-43b1-b7c7-4328e6b20f7f",
                                                "sense_id": "7a1500d5-02c5-39cb-85e2-df0986e778a0",
                                                "text": "The marginal area at the edge of the salt-marsh has its own plants."
                                            },
                                            {
                                                "example_id": "24aa7013-42fb-45ce-b33f-9ce9542976da",
                                                "sense_id": "7a1500d5-02c5-39cb-85e2-df0986e778a0",
                                                "text": "In recent years there has been an increase in violence against marginal groups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6924b25b-9066-3865-bc72-c58a89953db0",
                                        "entry_id": "1f21a3ba-4528-313e-9963-d4dac49ed411",
                                        "glosses": [
                                            "Of, relating to, or located at or near a margin or edge; also figurative usages of location and margin (edge).",
                                            "Written in the margin of a book."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11605748-4e97-4432-933c-804a8263a733",
                                                "sense_id": "6924b25b-9066-3865-bc72-c58a89953db0",
                                                "text": "There were more marginal notes than text."
                                            },
                                            {
                                                "example_id": "67fe0787-48e7-4d46-b128-87a70d9e09c4",
                                                "sense_id": "6924b25b-9066-3865-bc72-c58a89953db0",
                                                "text": "The early pages had marginal notes most of which were lost when rats nibbled away the manuscript edges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "855f2381-9d5b-3875-a54e-dfbd7e5f33b8",
                                        "entry_id": "1f21a3ba-4528-313e-9963-d4dac49ed411",
                                        "glosses": [
                                            "Of, relating to, or located at or near a margin or edge; also figurative usages of location and margin (edge).",
                                            "Sharing a border; geographically adjacent."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a91b36d8-b6b5-4835-9b0b-e68dfffd79c4",
                                                "sense_id": "855f2381-9d5b-3875-a54e-dfbd7e5f33b8",
                                                "text": "Monmouthshire is a Welsh county marginal to England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea45507b-20c0-3bad-b25b-8e27ac20c8cf",
                                        "entry_id": "1f21a3ba-4528-313e-9963-d4dac49ed411",
                                        "glosses": [
                                            "Determined by a small margin; having a salient characteristic determined by a small margin.",
                                            "Of a value, or having a characteristic that is of a value, that is close to being unacceptable or leading to exclusion from a group or category."
                                        ],
                                        "tags": [
                                            "comparable",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e6640c7-998f-4e2c-85a6-7a893fca7bd9",
                                                "sense_id": "ea45507b-20c0-3bad-b25b-8e27ac20c8cf",
                                                "text": "His writing ability was marginal at best."
                                            },
                                            {
                                                "example_id": "730ab1b8-d0cd-426f-85d0-11b91224ad1b",
                                                "sense_id": "ea45507b-20c0-3bad-b25b-8e27ac20c8cf",
                                                "text": "Having reviewed the test, there are two students below the required standard and three more who are marginal."
                                            },
                                            {
                                                "example_id": "450d32a3-1fac-466e-9743-7a25f06e7ed1",
                                                "sense_id": "ea45507b-20c0-3bad-b25b-8e27ac20c8cf",
                                                "text": "The pilots lacked experience flying in marginal weather conditions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e16139b-9358-3f4f-af0f-a0c7b00622d6",
                                        "entry_id": "1f21a3ba-4528-313e-9963-d4dac49ed411",
                                        "glosses": [
                                            "Determined by a small margin; having a salient characteristic determined by a small margin.",
                                            "Barely productive."
                                        ],
                                        "tags": [
                                            "comparable",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "521eff68-8fc9-431a-95db-7e9f9cabf72c",
                                                "sense_id": "8e16139b-9358-3f4f-af0f-a0c7b00622d6",
                                                "text": "He farmed his marginal land with difficulty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69051457-1d17-3768-9593-2796c117bc37",
                                        "entry_id": "1f21a3ba-4528-313e-9963-d4dac49ed411",
                                        "glosses": [
                                            "Determined by a small margin; having a salient characteristic determined by a small margin.",
                                            "Subject to a change in sitting member with only a small change in voting behaviour, this usually being inferred from the small winning margin of the previous election."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "comparable",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3cce1f9-c93e-42ff-a47a-f0716020a23a",
                                                "sense_id": "69051457-1d17-3768-9593-2796c117bc37",
                                                "text": "In Bristol West, Labour had a majority of only 1,000, so the seat is considered highly marginal this time around."
                                            },
                                            {
                                                "example_id": "b517ddfc-820b-4246-a1f1-9e4ef4c247cc",
                                                "sense_id": "69051457-1d17-3768-9593-2796c117bc37",
                                                "text": "In ‘battleground’ seats with the Conservatives, Liberal Democrat vote shares increased most in the most marginal seats."
                                            },
                                            {
                                                "example_id": "a047bcbe-ca52-4fef-968b-307ebfe829e5",
                                                "sense_id": "69051457-1d17-3768-9593-2796c117bc37",
                                                "text": "In Outer London, Harrow East is now a more marginal Labour hold than Harrow West."
                                            },
                                            {
                                                "example_id": "e678decb-a3cf-4e91-a0d1-39442f893928",
                                                "sense_id": "69051457-1d17-3768-9593-2796c117bc37",
                                                "text": "The pendulum lists the seats from least marginal to most marginal for the government on one side, and least marginal to most marginal for the opposition on the other side."
                                            },
                                            {
                                                "example_id": "58c8e349-3787-4862-aceb-eb3c07c025c2",
                                                "sense_id": "69051457-1d17-3768-9593-2796c117bc37",
                                                "text": "He justified his comment by noting that the Labour Party had quickly committed to delivering a high-speed Leeds-Manchester line, and argued that pressure would grow on the Government because there were several marginal parliamentary seats around Leeds and Bradford."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd02a20-5952-333c-a049-5661d35a3c61",
                                        "entry_id": "1f21a3ba-4528-313e-9963-d4dac49ed411",
                                        "glosses": [
                                            "Pertaining to changes resulting from a unit increase in production or consumption of a good."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "996cb116-48c6-3b39-a002-f444c584ca9b",
                                        "entry_id": "1f21a3ba-4528-313e-9963-d4dac49ed411",
                                        "glosses": [
                                            "Marginalized."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dff7ca34-0a2d-44a1-875b-784e18b2a074",
                                                "sense_id": "996cb116-48c6-3b39-a002-f444c584ca9b",
                                                "text": "The caseworker couldn't understand how I could have stretched out my last bit of money for so long. She seemed convinced that I was \"hiding\" income from her and interrogated me for I don't know how long. […] The system seems based on the assumption that people are \"welfare cheats.\" If you don't speak English or are marginal in some other way, it's worse."
                                            }
                                        ]
                                    }
                                ]
                            },
