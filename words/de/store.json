                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fensterschutz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als die Mittagssonne ins Zimmer schien, ließen wir den <w>Store</w> herunter."
                        },
                        {
                            "text": "Im modernen Bürogebäude lässt sich jeder <w>Store</w> automatisch per Knopfdruck steuern."
                        }
                    ],
                    "synonyms": [
                        "Jalousie",
                        "Rollladen",
                        "Rollo",
                        "Storen"
                    ],
                    "common_phrases": [
                        "die Store herunterlassen",
                        "die Store hochziehen"
                    ],
                    "traits": [
