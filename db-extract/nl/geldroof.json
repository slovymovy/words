                        "examples": [
                            {
                                "example_id": "eca30b30-d3de-4d6d-a673-bc354b4d09e4",
                                "sense_id": "af428215-a905-3526-8efd-1c5348f1b0b8",
                                "text": "De Chileense politie is een klopjacht begonnen, maar tot nu toe ontbreekt van de daders ieder spoor. De geldroof is de grootste uit de Chileense geschiedenis."
                            },
                            {
                                "example_id": "cf7ca252-7c2f-4157-ab23-25cee954fe57",
                                "sense_id": "af428215-a905-3526-8efd-1c5348f1b0b8",
                                "text": "De politie hoopt al meer dan een jaar op een doorbraak in het onderzoek naar de daders van de gewelddadige geldroof bij Brinks, in Amsterdam, vorig jaar juni. 12 miljoen euro was destijds de buit waarmee zes daders ervan door gingen. Nog niemand is voor die overval veroordeeld. Na een tip over een hennepplantage, leidt een aanhouding daar mogelijk toch tot een oplossing van de zaak."
                            },
                            {
                                "example_id": "da96a558-e3e7-42f9-bd76-4d610b351746",
                                "sense_id": "af428215-a905-3526-8efd-1c5348f1b0b8",
                                "text": "De geldroof bij G4S vond vannacht plaats. De daders bliezen met een explosief een deur op, waarna ze naar binnen gingen. Het personeel kon zich in veiligheid brengen. Er vielen geen gewonden."
                            }
                        ]
                    }
