                        "sense_id": "5526c3cf-6808-3b52-a511-0f74b845d8ca",
                        "entry_id": "f0a318dc-6f1c-3ae1-b171-ee14d551a960",
                        "glosses": [
                            "Obsolete spelling of high."
                        ],
                        "tags": [
