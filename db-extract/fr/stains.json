                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36720683-bbf8-4228-8444-483cf7692b5b",
                                "sense_id": "b88e625c-a2ba-3254-b0f9-5b3808b64596",
                                "text": "À Stains, en Seine-Saint-Denis, une femme a été retrouvée, lundi soir, nue et brûlée à 40 %, a-t-on appris auprès du parquet de Bobigny."
                            },
                            {
                                "example_id": "98074d7f-c296-4256-bcd8-394c2c5980b4",
                                "sense_id": "b88e625c-a2ba-3254-b0f9-5b3808b64596",
                                "text": "« Je choisis de m’intéresser aux classes sociales modestes, à ces individus enfermés dans cette gravité-là », estime le réalisateur Cédric Ido, originaire de Stains (Seine-Saint-Denis)."
                            },
                            {
                                "example_id": "063a3ce2-5243-4d3b-b4fc-21d4c266c316",
                                "sense_id": "b88e625c-a2ba-3254-b0f9-5b3808b64596",
                                "text": "La banlieue, ça use. Les profs du lycée Maurice-Utrillo, à Stains (Seine-Saint-Denis), n’en peuvent plus. Les jeunes non plus. Et les parents pareils."
                            }
                        ]
                    }
