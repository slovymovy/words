            {
                "entry_id": "5b5248c6-73db-3837-943f-ecc740dec353",
                "word": "Tarin",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c4260035-c7c5-3d94-aed2-9f138f7f2143",
                        "entry_id": "5b5248c6-73db-3837-943f-ecc740dec353",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19adb650-b9e3-4be3-9683-62ecc1338b4b",
                                "sense_id": "c4260035-c7c5-3d94-aed2-9f138f7f2143",
                                "text": "Il a été inauguré samedi 10 septembre 1994 à l’occasion du cinquantenaire de la libération de la ville par le maire et conseiller général de Saint-Jean-d’Angély Claude Tarin et l’ancien maire de Saintes André Maudet, ancien résistant qu’Henriette Favier a caché pendant l’occupation allemande."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8cd6fbcb-56f5-3cae-99be-7a534c418c5d",
                "word": "tarin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7c4effb3-2cee-4a49-b00f-dde9ff6df30f",
                        "entry_id": "8cd6fbcb-56f5-3cae-99be-7a534c418c5d",
                        "tags": [
                            "plural"
                        ],
                        "form": "tarins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "208c72e1-28fa-34b2-964c-0274d2ebbd08",
                        "entry_id": "8cd6fbcb-56f5-3cae-99be-7a534c418c5d",
                        "glosses": [
                            "Petit passereau chanteur, à bec conique et pointu et à plumage verdâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51a0eeb3-e32b-46b5-ad7f-192e88d31020",
                                "sense_id": "208c72e1-28fa-34b2-964c-0274d2ebbd08",
                                "text": "[…] Le verd Tarin gentil, cigalant ſon ramage; […]"
                            },
                            {
                                "example_id": "91874c12-8f03-4699-9fec-55be9353a8b6",
                                "sense_id": "208c72e1-28fa-34b2-964c-0274d2ebbd08",
                                "text": "Le serin, la linotte, le tarin, le bouvreuil semblent être naturellement musiciens."
                            },
                            {
                                "example_id": "c04e8b78-8024-4445-b340-006d6936c23b",
                                "sense_id": "208c72e1-28fa-34b2-964c-0274d2ebbd08",
                                "text": "Le tarin, espiègle et confiant, venait se poser au front immobile des statues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72d5b73e-3ded-48fe-9e1a-ef86e65cba8b",
                        "source_entry_id": "8cd6fbcb-56f5-3cae-99be-7a534c418c5d",
                        "source_sense_id": "208c72e1-28fa-34b2-964c-0274d2ebbd08",
                        "target_lang_word": "Zeisig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeisig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec658c26-ae0d-3023-b2b0-82f2921c4769",
                                        "entry_id": "0447c96c-1669-32a2-aaa7-72256ab52a49",
                                        "glosses": [
                                            "körnerfressender Singvogel"
                                        ],
                                        "tags": [
                                            "Carduelis spinus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dae91ae-e4e7-4435-98eb-1658ed7310cf",
                                                "sense_id": "ec658c26-ae0d-3023-b2b0-82f2921c4769",
                                                "text": "Der Zeisig lebt im Winter in Erlen, im Sommer in Nadelbäumen."
                                            },
                                            {
                                                "example_id": "abdde7c6-97a2-4bfe-9768-24917e787dc1",
                                                "sense_id": "ec658c26-ae0d-3023-b2b0-82f2921c4769",
                                                "text": "„Fast jede Familie hatte im Käfig vor dem Fenster einen Stieglitz oder einen Zeisig, um sich an seinem Gesang zu erfreuen.“"
                                            },
                                            {
                                                "example_id": "641a3588-186f-49dc-9589-08646c9652b3",
                                                "sense_id": "ec658c26-ae0d-3023-b2b0-82f2921c4769",
                                                "text": "„Ihr folgte gleich darauf mit einem großen Karton eine Frau wie ein Zeisig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d0bb33a-235d-3e3a-8e08-eab94c759f3a",
                                        "entry_id": "0447c96c-1669-32a2-aaa7-72256ab52a49",
                                        "glosses": [
                                            "deutscher Name für die Gattung Carduelis"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "003cb0e5-d4f7-4acc-9cf8-68770653cd09",
                                                "sense_id": "2d0bb33a-235d-3e3a-8e08-eab94c759f3a",
                                                "text": "Der Grünfink gehört zu den Zeisigen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3f1cb6ab-8d15-33eb-a001-6373cb01cf82",
                                        "entry_id": "0447c96c-1669-32a2-aaa7-72256ab52a49",
                                        "glosses": [
                                            "volkstümlich auch für den Stieglitz"
                                        ],
                                        "tags": [
                                            "Carduelis carduelis"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd0387e8-9b81-4c9b-99d3-d691852089b9",
                        "source_entry_id": "8cd6fbcb-56f5-3cae-99be-7a534c418c5d",
                        "source_sense_id": "208c72e1-28fa-34b2-964c-0274d2ebbd08",
                        "target_lang_word": "siskin",
