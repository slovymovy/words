                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8551191b-cfcb-374a-b3f1-380bc17a6c07",
                                        "entry_id": "5989fba1-3331-37c6-83d5-621e8f2e58ac",
                                        "glosses": [
                                            "A prison."
                                        ],
                                        "tags": [
                                            "US",
