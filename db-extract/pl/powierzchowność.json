                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a935917d-a323-4206-8762-5a0735179294",
                                "sense_id": "53ac07dd-4019-3600-9c9a-3c284d6d691e",
                                "text": "Prawda, że my obydwa tylko z teorji znamy kobiety, przecież ja zacząłem nie ufać tym wszystkim powierzchownościom, któremi ta panienka potrafi obudzać i utrzymać pasją."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9a283b3-2f81-4aaf-83e6-87df65ce8930",
