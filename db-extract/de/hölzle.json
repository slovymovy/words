                ],
                "senses": [
                    {
                        "sense_id": "4d5f17da-f3f6-3e1d-93a8-9de9c0950cf2",
                        "entry_id": "b48dd58b-335c-3196-9281-e7f8722b1bec",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3123dd3-6679-4157-a30d-6cd6da491eb0",
                                "sense_id": "4d5f17da-f3f6-3e1d-93a8-9de9c0950cf2",
                                "text": "Frau Hölzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "34a41437-749b-4465-966f-41c1c5fc98e5",
                                "sense_id": "4d5f17da-f3f6-3e1d-93a8-9de9c0950cf2",
                                "text": "Herr Hölzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ebaaa572-1182-4b63-bcda-32bbcd4f3d47",
                                "sense_id": "4d5f17da-f3f6-3e1d-93a8-9de9c0950cf2",
                                "text": "Die Hölzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "17a67e94-4fec-4713-a893-eefd84ad1b60",
                                "sense_id": "4d5f17da-f3f6-3e1d-93a8-9de9c0950cf2",
                                "text": "Der Hölzle trägt nie die Schals, die die Hölzle ihm strickt."
                            },
                            {
                                "example_id": "1144501a-af81-48df-8c74-92881a6dd16e",
                                "sense_id": "4d5f17da-f3f6-3e1d-93a8-9de9c0950cf2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hölzle kommt, geht der Herr Hölzle.“"
                            },
                            {
                                "example_id": "5a10109e-dbaa-4f18-8851-1652494796b4",
                                "sense_id": "4d5f17da-f3f6-3e1d-93a8-9de9c0950cf2",
                                "text": "Hölzle kommt und geht."
                            },
                            {
                                "example_id": "b0fa8db7-2504-4fab-9c71-11fc83619fd7",
                                "sense_id": "4d5f17da-f3f6-3e1d-93a8-9de9c0950cf2",
                                "text": "Hölzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
