                ],
                "senses": [
                    {
                        "sense_id": "afd0d8ed-2b82-35db-942d-4aee11a166bb",
                        "entry_id": "f8615891-1c2d-3f4f-a2e4-b4303020e110",
                        "glosses": [
                            "anticline"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "670fabb3-5520-4c25-9b5b-599378aa9b1b",
                                "sense_id": "afd0d8ed-2b82-35db-942d-4aee11a166bb",
                                "text": "Przekrój poprzeczny obu powyższych podolsko-karpackich antyklin wielkopromieniowych odpowiada zarówno na Podolu, podług hipsometryj pokryw skalnych, jak i na Podkarpaciu, podług seismiki podłoża, osobliwszemu typowi antyklin.",
                                "translation": "The transverse intersection of both of the above Podolian-Carpathian mutli-layered anticlines is responsible both in both Podole, along the hypsometric rocky covers, and in Sub-Carpathia, along the seismic substrate, for more particular types of anticlines.",
                                "english": "The transverse intersection of both of the above Podolian-Carpathian mutli-layered anticlines is responsible both in both Podole, along the hypsometric rocky covers, and in Sub-Carpathia, along the seismic substrate, for more particular types of anticlines."
                            },
                            {
                                "example_id": "e465a534-f703-49e0-a659-241aa5aa3559",
                                "sense_id": "afd0d8ed-2b82-35db-942d-4aee11a166bb",
                                "text": "Na południe od elewacji radomszczańskiej znajduje się niecka włoszczowska wypełniona spokojnie zalegającymi osadami kredowymi. Jedynie w jej centralnej części, w pobliżu Secemina, znajduje się słabo zaznaczona antyklina.",
                                "translation": "Towards the south from the elevation of Radomsko, the Włoszczowa basin, filled peacefully with default chalk settlements, can be found. Only in its central aprt, near Secemin, a weakly marked anticline can be found.",
                                "english": "Towards the south from the elevation of Radomsko, the Włoszczowa basin, filled peacefully with default chalk settlements, can be found. Only in its central aprt, near Secemin, a weakly marked anticline can be found."
                            },
                            {
                                "example_id": "04f4fdec-1522-44bd-a7a8-c617f9e615c8",
                                "sense_id": "afd0d8ed-2b82-35db-942d-4aee11a166bb",
                                "text": "Obecnie stwierdza się 32 wychodnie utworów mioceńskich powyżej zwierciadła wód zbiornika. Bieg osi antyklin i synklin wykazuje generalnie kierunek NW-SE.",
                                "translation": "Currently it is claimed that 32 outcroppings of Miocene pieces above the water collecter's mirror. The anticlines' and synclines' tilt generally show a direcetion of NW-SE.",
                                "english": "Currently it is claimed that 32 outcroppings of Miocene pieces above the water collecter's mirror. The anticlines' and synclines' tilt generally show a direcetion of NW-SE."
                            }
                        ]
                    }
