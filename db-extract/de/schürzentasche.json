                "senses": [
                    {
                        "sense_id": "0724fb98-5947-3d55-97bf-39b41ac1c6cb",
                        "entry_id": "cc39e1ab-16e6-3ab6-a25a-42de23e4b9dc",
                        "glosses": [
                            "Tasche, die an oder in einer Schürze angebracht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70c118af-af6b-4db5-9aee-e8ef9c93a809",
                                "sense_id": "0724fb98-5947-3d55-97bf-39b41ac1c6cb",
                                "text": "„Die Mutter unterbrach sich, legte das Messer beiseite, tastete in die Schürzentasche, lief hinaus und kam mit einem Taschentuch wieder.“"
                            },
                            {
                                "example_id": "d2524cb3-0d09-49f0-b053-c09f90a5e7e0",
                                "sense_id": "0724fb98-5947-3d55-97bf-39b41ac1c6cb",
                                "text": "„Er sagte ihr das Gleiche auf Spanisch, und sie nickte, steckte das Geld in ihre Schürzentasche und schob ihren Wagen über den Gehweg zurück, während er noch einen Moment stehenblieb, die Autos auf dem Parkplatz musterte und dann die Tür schloss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
