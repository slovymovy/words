                        ],
                        "examples": [
                            {
                                "example_id": "32c4f8f6-d5a7-44f9-b4fa-6e5722a1f1b2",
                                "sense_id": "1f091dc9-a3ab-383f-b3a5-26e6edd0eb01",
                                "text": "Viserys unsheathes his dagger and says he’ll have his tongue for this, but his brother is quicker. In a classic Game Of Thrones gasper of a moment, Daemon whips out his sword and slices the top half of Vaemond’s head off like a watermelon. “He can keep his tongue,” the prince remarks, in a savage mic drop."
                            }
                        ]
