                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07ce2d90-9dbb-4dc3-a6fe-bf7969fb7183",
                        "source_entry_id": "0e9fdd8e-0c88-3ffd-8046-2020e61729b7",
                        "source_sense_id": "dc414d89-d8d5-36f0-a087-8c8b42265cc3",
