                                        "entry_id": "28a6f89a-a620-3673-b29d-84f85afc9d1f",
                                        "glosses": [
                                            "Zusammenkunft von Menschen oder Verbänden zu einem bestimmten Zweck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f229e7f9-fd5d-4e23-9f67-1af81451e178",
                                                "sense_id": "0d81a6d8-b67d-3122-8924-3dd8479820ed",
                                                "text": "Sie organisierten das Treffen sich um die Angelegenheit zu besprechen."
                                            },
                                            {
                                                "example_id": "20054606-f481-4741-a6f7-8c9cc3f380ed",
                                                "sense_id": "0d81a6d8-b67d-3122-8924-3dd8479820ed",
                                                "text": "„Für das Treffen haben sich die beiden Widersacher jeweils die Gefolgschaft angesehener Bauern gesichert.“"
                                            },
                                            {
                                                "example_id": "aa31a622-7d7f-419f-9b3d-224c2f84bedc",
                                                "sense_id": "0d81a6d8-b67d-3122-8924-3dd8479820ed",
                                                "text": "„Bestes Beispiel dafür sind die regelmäßigen Treffen in einem Rauchclub, in dem trotz Ächtung des Blauen Dunstes in der Tradition von historisch überlieferten Tabakkollegs noch immer unverdrossen debattiert und gestritten wird.“"
                                            },
                                            {
                                                "example_id": "244c34a3-e3a1-4ae6-9d72-c5ba4ce112a2",
                                                "sense_id": "0d81a6d8-b67d-3122-8924-3dd8479820ed",
                                                "text": "„Elma verstand nicht, warum Sandra unbedingt wissen wollte, ob sie zu dem Treffen kam oder nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "721d705f-4af1-3b1e-a948-78bd3f9c2ec4",
                                        "entry_id": "28a6f89a-a620-3673-b29d-84f85afc9d1f",
                                        "glosses": [
                                            "kleine Kampfhandlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7fdc435-fe53-4d96-8dfe-313584e2d980",
                                                "sense_id": "721d705f-4af1-3b1e-a948-78bd3f9c2ec4",
                                                "text": "Das Treffen ging ohne Verluste für beide Seiten aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e893a211-3ecd-3ca7-bbdc-42116b43929a",
                                        "entry_id": "28a6f89a-a620-3673-b29d-84f85afc9d1f",
                                        "glosses": [
                                            "Wettkampf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "477c6a9d-29bb-4844-bd11-b316bc13672f",
                                                "sense_id": "e893a211-3ecd-3ca7-bbdc-42116b43929a",
                                                "text": "Die Mannschaft gewann das Treffen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5fbdaca0-d61f-347a-882e-2d8142bff9ba",
                                        "entry_id": "28a6f89a-a620-3673-b29d-84f85afc9d1f",
                                        "glosses": [
                                            "selbständiger Truppenkörper bei der Treffentaktik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd10ced-27b8-46d3-8ada-bb14bc9ecc13",
                                                "sense_id": "5fbdaca0-d61f-347a-882e-2d8142bff9ba",
                                                "text": "Das zweite Treffen warf sich dem einbrechenden Feind entgegen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
