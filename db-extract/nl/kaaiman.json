                        ],
                        "examples": [
                            {
                                "example_id": "7fdd50f0-8049-4194-8a66-fbb8ddd701ae",
                                "sense_id": "5707ecfc-fa72-3412-b659-20e73d3bdf7b",
                                "text": "Ga niet baden daar in de kali / en ga niet trouwen daar in Pesapen / Laat je raden, m’n kleine Ali / wanneer ik jou met raad van dienst wil zijn / (...) / Want een kaaiman zit in de kali / en ook een kaaiman zit in Pesapen / ’t Is je schoonma, m′n kleine Ali / die erop loert dat jij getrouwd zal zijn",
                                "translation": "Don't go bathing out there in the river / and don't get married out there in Pesapen / Take good counsel, my little Ali / when I wish to be of service to you with advice / (...) / Because there's a caiman in the river/ and there's also a caiman in Pesapen / It's your mother-in-law, my little Ali / who's lying in wait for you to have gotten married",
                                "english": "Don't go bathing out there in the river / and don't get married out there in Pesapen / Take good counsel, my little Ali / when I wish to be of service to you with advice / (...) / Because there's a caiman in the river/ and there's also a caiman in Pesapen / It's your mother-in-law, my little Ali / who's lying in wait for you to have gotten married"
                            }
                        ]
                    }
