                    {
                        "sense_id": "63ed6401-e09b-3516-88d4-7e2c72af3989",
                        "entry_id": "3065e3f2-05b7-3537-8f61-6e7b24a28312",
                        "glosses": [
                            "Alternative form of FedEx."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "2d2d8823-4259-4271-8d16-b11a6f76d9e3",
                                "sense_id": "63ed6401-e09b-3516-88d4-7e2c72af3989",
                                "text": "When it's over, delivered, faxed and Fedexed then reality sets in and the mood du jour takes over."
                            },
                            {
                                "example_id": "3531e414-6936-454e-b792-786ba2b3cea4",
                                "sense_id": "63ed6401-e09b-3516-88d4-7e2c72af3989",
                                "text": "My junior editor had Fedexed deadline items from my in-box to Iowa."
                            },
                            {
                                "example_id": "1dea4fc7-6c42-44bc-a2ea-e8d8e670eff6",
                                "sense_id": "63ed6401-e09b-3516-88d4-7e2c72af3989",
                                "text": "Well, I think he could have had the contract Fedexed here and then he could have signed it and sent it home."
                            }
                        ]
                    }
                ],
