                ],
                "senses": [
                    {
                        "sense_id": "159cf703-b40e-3210-869c-8ce57a91c4f9",
                        "entry_id": "77158917-bfd6-3d41-a13d-a684a1d95586",
                        "glosses": [
                            "Qui comprend plusieurs nations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8309cc0-e95c-4959-9e29-6757d9b11e38",
                                "sense_id": "159cf703-b40e-3210-869c-8ce57a91c4f9",
                                "text": "La solidarité des peuples de l'État-nation fait de leur « vouloir vivre ensemble » un substitut possible à l'unité obligatoire dans la personne du chef (laquelle reste plus longtemps indispensable aux États pluri-nationaux)."
                            },
                            {
                                "example_id": "3aa1fefc-6b41-4fb9-b1f7-4091f2a33e8a",
                                "sense_id": "159cf703-b40e-3210-869c-8ce57a91c4f9",
                                "text": "Ces « mini-constitutions » ou « chartes locales », formant les assises d'un autogouvernement démocratique, jetteraient ainsi les bases d'une nouvelle société, qui demanderait à être instituée à plus large échelle au sein d'une communauté politique plurinationale et pluriterritoriale."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecbc23f2-0773-36fa-8cde-cfeaa2b9ecfd",
                        "entry_id": "77158917-bfd6-3d41-a13d-a684a1d95586",
                        "glosses": [
                            "Qui implique la participation de plusieurs nations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54aba013-58ac-4751-8a32-5cc521b4cac8",
                                "sense_id": "ecbc23f2-0773-36fa-8cde-cfeaa2b9ecfd",
                                "text": "Un office inter-états du tourisme africain (...), organisme pluri-national dont le siège est à Yaoundé."
                            }
                        ]
                    },
                    {
                        "sense_id": "8aee13bb-6036-3670-9ae1-49742ddd4115",
                        "entry_id": "77158917-bfd6-3d41-a13d-a684a1d95586",
                        "glosses": [
                            "Dont les activités s'exercent dans plusieurs pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71418176-578d-4ffa-ad2b-628ce6e44ae6",
                                "sense_id": "8aee13bb-6036-3670-9ae1-49742ddd4115",
                                "text": "Monopole plurinational."
                            },
                            {
                                "example_id": "0b32e761-8ec6-4ce2-b7de-54a1719e055e",
                                "sense_id": "8aee13bb-6036-3670-9ae1-49742ddd4115",
                                "text": "Entreprise plurinationale."
                            }
                        ]
                    }
