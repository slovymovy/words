                                        "glosses": [
                                            "Person, die schlafwandelt, das heißt, im Schlaf herumgeht, ohne sich später daran zu erinnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b2ec040-f1eb-4c39-a2e1-397979801a13",
                                                "sense_id": "afbd082e-fcf8-36bc-b8b2-7ae408cf06dc",
                                                "text": "„Giacomo Bertini machte die ganze Zeit über den Eindruck eines Schlafwandlers.“"
                                            },
                                            {
                                                "example_id": "6589dfb8-b4b7-4ba4-a814-204ed056ffb8",
                                                "sense_id": "afbd082e-fcf8-36bc-b8b2-7ae408cf06dc",
                                                "text": "„Eines Nachts hatte er sich wie ein Schlafwandler mit einem der Stricke, deren man sich zum Gewehrreinigen bedient, auf den Boden geschlichen und dort einen kräftigen Balken ausgesucht.“"
                                            },
                                            {
                                                "example_id": "43a36200-8091-439d-8d1b-ee187f72edf5",
                                                "sense_id": "afbd082e-fcf8-36bc-b8b2-7ae408cf06dc",
                                                "text": "„Ich ziehe durch diese Stadt wie ein Schlafwandler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
