                    "sense_id": "0f0d0890-f5ea-392b-a189-a31d7febff5c",
                    "sense_definition": "simple past and past participle of <w>labor</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "labor_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers <w>labored</w> for hours under the hot summer sun to finish the road.",
                            "target_lang_translations": {
                                "pl": "Robotnicy <w>harowali</w> godzinami w gorącym letnim słońcu, aby ukończyć drogę."
                            }
                        },
                        {
                            "text": "She has <w>labored</w> tirelessly to ensure the success of the charity project.",
                            "target_lang_translations": {
                                "pl": "Niestrudzenie <w>trudziła się</w>, aby zapewnić sukces projektu charytatywnego."
                            }
                        }
                    ],
                    "synonyms": [
                        "toiled",
                        "worked",
                        "struggled"
                    ],
                    "antonyms": [
                        "rested",
                        "relaxed"
                    ],
                    "common_phrases": [
                        "labored under the delusion",
                        "labored long and hard"
                    ],
                    "target_lang_definitions": {
