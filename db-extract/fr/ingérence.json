                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c76687ac-ade0-469a-90c0-c3923970663e",
                        "entry_id": "51c95e8d-4688-3f5f-b6ea-069489904258",
                        "tags": [
                            "plural"
                        ],
                        "form": "ingérences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "946b05da-8936-3005-83dd-cd6a8ba2e167",
                        "entry_id": "51c95e8d-4688-3f5f-b6ea-069489904258",
                        "glosses": [
                            "Action de s’ingérer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84899d33-9f60-4dba-ad49-2006e154ab70",
                                "sense_id": "946b05da-8936-3005-83dd-cd6a8ba2e167",
                                "text": "Cette mainmise sur la liberté d'autrui, cette ingérence dans ses pensées et ses actions l'étonnaient désagréablement..."
                            },
                            {
                                "example_id": "5b8d8b2f-74e1-4084-991b-efa3983c4ca9",
                                "sense_id": "946b05da-8936-3005-83dd-cd6a8ba2e167",
                                "text": "Mais à cause des évangélistes radicaux, l'influence du christianisme était maintenant perçue par les ultranationalistes hindous comme une ingérence étrangère et une menace pour la nature hindoue de leur pays."
                            },
                            {
                                "example_id": "a54d4089-3642-43e3-a868-dbf9e450ea6c",
                                "sense_id": "946b05da-8936-3005-83dd-cd6a8ba2e167",
                                "text": "Nous avons vu les mêmes semer dans nos démocraties, par les armes de la propagande, des ingérences et du mensonge, le ferment de la division et de la haine, espérant, ce faisant, affaiblir notre souveraineté et nos libertés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "231405b7-1abc-4746-994a-d0e05df59578",
                        "source_entry_id": "51c95e8d-4688-3f5f-b6ea-069489904258",
                        "source_sense_id": "946b05da-8936-3005-83dd-cd6a8ba2e167",
                        "target_lang_word": "Einmischung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einmischung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f17b9fb0-a283-3f46-bf36-921672df82bb",
                                        "entry_id": "0d681713-9480-3ef9-b3cb-1e2b0090e4d1",
                                        "glosses": [
                                            "eine ungefragte, ungebetene Beteiligung an etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c3392a1-dd5f-40f4-8b81-e4d2a3efef4a",
                                                "sense_id": "f17b9fb0-a283-3f46-bf36-921672df82bb",
                                                "text": "„Diese Einmischung brachte mich in wahrhaft teuflische Wut. Ich entwand mich ihrem Griff und schlug die Axt tief in ihren Schädel ein. Sie brach lautlos zusammen.“"
                                            },
                                            {
                                                "example_id": "705ef0ce-3202-46d2-ba0f-f34de98d0b45",
                                                "sense_id": "f17b9fb0-a283-3f46-bf36-921672df82bb",
                                                "text": "„Die Regierung in Teheran hat hinreichend deutlich gemacht: Jede Einwirkung gilt ihr als Einmischung, jede Intervention als Beweis, daß Bonn nur den eigenen Agenten rauspauken will.“"
                                            },
                                            {
                                                "example_id": "19625164-7406-4cd1-8aa2-d567278f3334",
                                                "sense_id": "f17b9fb0-a283-3f46-bf36-921672df82bb",
                                                "text": "Noch einmal: \"Nicht-Einmischung\" lieferte das spanische Volk auf Gedeih und Verderb an Franco aus und schützte Hitler in der taktilsten Phase seiner Kriegsvorbereitung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d53cd493-a722-48d0-bb15-b8e4073aa827",
                        "source_entry_id": "51c95e8d-4688-3f5f-b6ea-069489904258",
