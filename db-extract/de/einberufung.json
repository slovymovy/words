                "senses": [
                    {
                        "sense_id": "f8d93d58-6dba-3ade-a160-d9042be21648",
                        "entry_id": "a2938025-b085-3616-bc45-6f8b036b112b",
                        "glosses": [
                            "Einladung zu einer Versammlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1836d66-742e-4ff1-a4b7-dddb3374f1b1",
                                "sense_id": "f8d93d58-6dba-3ade-a160-d9042be21648",
                                "text": "Die Einberufung der Versammlung muss fristgerecht erfolgen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "84fe170c-4cde-39e1-bbae-d81bbb90f06b",
                        "entry_id": "a2938025-b085-3616-bc45-6f8b036b112b",
                        "glosses": [
                            "amtliche Anweisung, den Dienst beim Militär anzutreten, um seine Wehrpflicht zu erfüllen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "622def87-121b-47fd-8a21-10095fe0dc53",
                                "sense_id": "84fe170c-4cde-39e1-bbae-d81bbb90f06b",
                                "text": "Die Einberufung kam sehr ungelegen, da er kurz vor den Prüfungen stand."
                            },
                            {
                                "example_id": "14a40f9f-a559-4490-9248-3b59bb8e3a5d",
                                "sense_id": "84fe170c-4cde-39e1-bbae-d81bbb90f06b",
                                "text": "[Russlands Krieg gegen die Ukraine 2022:] „Viele Männer, die sich seit Ende September vor einer Einberufung verstecken, haben inzwischen Russland verlassen.“"
                            },
                            {
                                "example_id": "fec0400f-9ebe-41d4-bb17-56cd7dd00259",
                                "sense_id": "84fe170c-4cde-39e1-bbae-d81bbb90f06b",
                                "text": "„1914, als sich Kaiser Wilhelm II. für die Beschießung der Kathedrale von Reims erklärte, entzog Jahnn sich der Einberufung und verließ empört Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7deb4deb-9803-4eef-b383-0ee52fa9c6c9",
                        "source_entry_id": "a2938025-b085-3616-bc45-6f8b036b112b",
