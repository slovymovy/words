        "fr-extract.jsonl": [
            {
                "entry_id": "eb398224-d18b-3aad-98c8-3d247cd7edc2",
                "word": "catégorisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d983fb11-edb2-485f-847e-63902402e89c",
                        "entry_id": "eb398224-d18b-3aad-98c8-3d247cd7edc2",
                        "tags": [
                            "plural"
                        ],
                        "form": "catégorisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5dca0639-7228-3dd9-a49c-460ae8cfecfc",
                        "entry_id": "eb398224-d18b-3aad-98c8-3d247cd7edc2",
                        "glosses": [
                            "Action de catégoriser, de ranger, de classer par catégories."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afbd6a50-4584-4e25-aab4-fda2038303a6",
                                "sense_id": "5dca0639-7228-3dd9-a49c-460ae8cfecfc",
                                "text": "… dans la même claie, l’éducation présente beaucoup d’inégalités : des vers plus avancés les uns que les autres, des vers qui dorment, d’autres qui vont dormir, et d’autres enfin qui s’éveillent, ces caractères, dans une éducation, sont des caractères funestes, et il faut procéder à une catégorisation ou renoncer à toute réussite."
                            },
                            {
                                "example_id": "61b1da05-1206-42fb-8829-ca10c06c0574",
                                "sense_id": "5dca0639-7228-3dd9-a49c-460ae8cfecfc",
                                "text": "La catégorisation sociale est un processus qui consiste à organiser les éléments de notre environnement."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b77685b-a8ee-3918-92ec-1013e0fd0a80",
                        "entry_id": "eb398224-d18b-3aad-98c8-3d247cd7edc2",
                        "glosses": [
                            "Résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9aa2958-acbc-4435-b58b-d27dc7ab239a",
                                "sense_id": "6b77685b-a8ee-3918-92ec-1013e0fd0a80",
                                "text": "Il vise aussi à supprimer la catégorisation des chiens « dits dangereux », fondée sur des critères morphotypaux et raciaux, lui substituant l’objectivation des critères d’une catégorisation comportementale."
                            },
                            {
                                "example_id": "6df1ae92-0f58-48ba-b15a-204eced289bf",
                                "sense_id": "6b77685b-a8ee-3918-92ec-1013e0fd0a80",
                                "text": "Si Daria et les membres de sa famille ne m’ont jamais livré de catégorisation précise de la vie onirique chez les Even, une première chose est certaine : lorsqu’ils considèrent leur trajectoire autobiographique, ils n'en excluent pas les rêves."
                            }
                        ]
                    }
                ],
