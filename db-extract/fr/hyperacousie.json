                        "entry_id": "eb75b647-48ca-31a4-a09a-e41154d152b5",
                        "glosses": [
                            "Dysfonctionnement de l’audition, caractérisé par une hypersensibilité de l’ouïe à certaines fréquences."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ff4d22cd-c429-4834-b70f-bb07c78f22e8",
                                "sense_id": "447a3aab-d6b8-3fef-a02c-918de7051067",
                                "text": "Si l’hyperacousie est clairement signalée sur une seule oreille, sans comportement d’évitement et récente (moins de 6 mois), un seul bruiteur est adapté."
                            },
                            {
                                "example_id": "48f10454-726f-4764-b191-804c21aa8a98",
                                "sense_id": "447a3aab-d6b8-3fef-a02c-918de7051067",
                                "text": "Je me moque de moi et de mon hyperacousie, par exemple."
                            }
                        ]
                    }
                ],
