                "senses": [
                    {
                        "sense_id": "b37d1872-c196-3ede-b4d1-99c657ac6c54",
                        "entry_id": "d5260a03-f65a-355f-9549-bfbc9d3956b8",
                        "glosses": [
                            "bairisch, wertloses, unnützes Zeug"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "8ce0bdfa-53d0-410d-88a4-818a915e68c6",
                                "sense_id": "b37d1872-c196-3ede-b4d1-99c657ac6c54",
                                "text": "„Denn offensichtlich hatte ein Ramschdesigner aus Leonardo da Vincis Abendmahlsbild ein Glumpert zum Hinstellen gemacht.“"
                            },
                            {
                                "example_id": "4dceb98a-1b88-4cac-9ac6-2bcc0bf0e64e",
                                "sense_id": "b37d1872-c196-3ede-b4d1-99c657ac6c54",
                                "text": "„Wer von Ihnen jemals eine Zeitungsredaktion besucht hat, wird sicherlich erstaunt gewesen sein über das viele Glumpert, das sich auf den Schreibtischen der Redakteure anhäufen kann, ohne den Tisch selbst ob des Gewichts zum Einsturz zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
