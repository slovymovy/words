                                        "entry_id": "dece85a4-a819-3fc4-957f-8a67fccbe74b",
                                        "glosses": [
                                            "Sulphurous."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d855cbd8-e53a-4366-be2c-eeb0756176be",
                                                "sense_id": "6a6c7352-69cc-3d75-a638-c6c846c210f9",
                                                "text": "Thy blazing hearths, / From deep sulphureous pits, consumeless stores / Of fuel boast."
                                            },
                                            {
                                                "example_id": "680d766a-b851-4d2b-97c7-dffb57a421ec",
                                                "sense_id": "6a6c7352-69cc-3d75-a638-c6c846c210f9",
                                                "text": "The plain of Naples is the image of human passions; sulphureous and fertile; its dangers and its pleasures seem born of these fiery volcanoes, which give the air so many charms, and cause the thunderbolt to growl beneath our feet."
                                            },
                                            {
                                                "example_id": "547525a7-a3c3-4199-beff-176874a85c56",
                                                "sense_id": "6a6c7352-69cc-3d75-a638-c6c846c210f9",
                                                "text": "An excited and highly distempered ideality threw a sulphureous lustre over all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
