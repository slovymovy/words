                    {
                        "translation_id": "63aab9bb-88c0-4036-b0f7-7e981b12a67a",
                        "source_entry_id": "0d20c2b1-b69d-3148-8fba-2e0e4678867a",
                        "source_sense_description": "person who practices nudism",
