                "word": "fiscalisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e186e910-12e6-4f58-a9a3-b1edce908b90",
                        "entry_id": "6d4a3ac0-ddbf-3491-9ef9-bcf7a057436b",
