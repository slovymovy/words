                "senses": [
                    {
                        "sense_id": "ab8b5112-dcb3-3bb0-b90f-068cdf373eac",
                        "entry_id": "e08a0306-628f-34ae-835c-295a431ad4ba",
                        "glosses": [
                            "Grill mit Deckel, dessen Garraum von der Form her an eine Kugel erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c40c0396-b77a-4591-b6de-3a58eade5082",
                                "sense_id": "ab8b5112-dcb3-3bb0-b90f-068cdf373eac",
                                "text": "„Und obwohl es im fünften Stock heißer ist als in einem Kugelgrill an einem Nationalfeiertag, trägt er immer noch seine Krawatte.“"
                            },
                            {
                                "example_id": "456645e0-68c2-4f44-acda-680d5b3664d6",
                                "sense_id": "ab8b5112-dcb3-3bb0-b90f-068cdf373eac",
                                "text": "„Er blieb zurück, und von der kleinen Terrasse aus spähte er neben dem großen Kugelgrill auf Rädern durch den einzigen Schlitz zwischen den Gardinen.“"
                            }
                        ],
