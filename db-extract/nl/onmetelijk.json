                "senses": [
                    {
                        "sense_id": "8f01da86-81df-33d2-abf8-234a076f9a0f",
                        "entry_id": "fd7b173f-7bba-3fc9-8be0-214b266fef4c",
                        "glosses": [
                            "zo groot of zoveel dat het niet te meten of te tellen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe62ef2a-b658-4a34-b565-82f1313bd5e4",
                                "sense_id": "8f01da86-81df-33d2-abf8-234a076f9a0f",
                                "text": "Volgens de rechtbank is A. „kil en berekenend” te werk gegaan en heeft hij zijn slachtoffers „onmetelijk veel leed” berokkend. De levenslange celstraf moet duidelijk maken, vindt de rechtbank, hoe ernstig de door A. gepleegde misdaden worden getaxeerd."
                            },
                            {
                                "example_id": "ff2ea34d-6e1f-46e1-8741-603c2d41dfaa",
                                "sense_id": "8f01da86-81df-33d2-abf8-234a076f9a0f",
                                "text": ",,Anders dan veel mensen denken, waren veel gladiatoren profs die vaak meer dan honderd wedstrijden afwerkten en dus niet zomaar in de pan gehakt werden\", zegt econoom Geert Noels in de Belgische krant. ,,Sommigen bereikten een sterrenstatus die vergelijkbaar is met een voetballer van nu. De besten werden onmetelijk rijk en kregen hele landerijen toebedeeld.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "737375a7-5d67-4179-9817-a4297aa31cbe",
                        "source_entry_id": "fd7b173f-7bba-3fc9-8be0-214b266fef4c",
                        "source_sense_id": "8f01da86-81df-33d2-abf8-234a076f9a0f",
                        "target_lang_word": "gigantic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gigantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e8c9307-c470-3340-a69b-15cd77f9e6c0",
                                        "entry_id": "0fd6f71e-1bc0-36a0-838d-3c3932acd1ed",
                                        "glosses": [
                                            "Very large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "624239e8-e18a-42d6-94c6-0c50211e5802",
                                                "sense_id": "2e8c9307-c470-3340-a69b-15cd77f9e6c0",
                                                "text": "Thou Genius of the place (this most renowned Ile)\nWhich livedst long before the All-earth-drowning Flood,\nWhilst yet the world did swarme with her Gigantick brood;"
                                            },
                                            {
                                                "example_id": "d893b783-29d1-4085-a95b-7ef474ae7c84",
                                                "sense_id": "2e8c9307-c470-3340-a69b-15cd77f9e6c0",
                                                "text": "It is in solitude that the imagination exercises its gigantic power; and where are a woman's feelings nurtured but in solitude?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f557100-f4f9-3d85-a370-66cc19db2d6d",
                                        "entry_id": "0fd6f71e-1bc0-36a0-838d-3c3932acd1ed",
                                        "glosses": [
                                            "Excellent; very good or exciting."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a655ec7e-19e7-4ee2-9b91-51f79eb88625",
                                                "sense_id": "6f557100-f4f9-3d85-a370-66cc19db2d6d",
                                                "text": "This band is going to be gigantic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3204b4d9-9321-3a7e-8bff-db67ce8271a0",
                                        "entry_id": "0fd6f71e-1bc0-36a0-838d-3c3932acd1ed",
                                        "glosses": [
                                            "In the manner of a giant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "796ceb6d-7440-4d1c-ba95-1c36e7220024",
                        "source_entry_id": "fd7b173f-7bba-3fc9-8be0-214b266fef4c",
                        "source_sense_id": "8f01da86-81df-33d2-abf8-234a076f9a0f",
                        "target_lang_word": "infinite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infinite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9ce0f00-5c30-3db2-99d4-8c32a5bb2152",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Indefinably large, countlessly great; immense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "631c9765-cfdd-408f-8ad1-08a75143ad55",
                                                "sense_id": "f9ce0f00-5c30-3db2-99d4-8c32a5bb2152",
                                                "text": "The number is so infinite, that verily it would be an easier matter for me to reckon up those that have feared the same."
                                            },
                                            {
                                                "example_id": "ecf376fb-0bc6-4e16-baef-e65954eea58d",
                                                "sense_id": "f9ce0f00-5c30-3db2-99d4-8c32a5bb2152",
                                                "text": "Whatever is finite, as finite, will admit of no comparative relation with infinity; for whatever is less than infinite is still infinitely distant from infinity; and lower than infinite distance the lowest or least cannot sink."
                                            },
                                            {
                                                "example_id": "d75abdcd-8101-44cf-a528-31a10ca2275e",
                                                "sense_id": "f9ce0f00-5c30-3db2-99d4-8c32a5bb2152",
                                                "text": "infinite riches in a little room"
                                            },
                                            {
                                                "example_id": "f5799593-fb0c-49d0-84fc-31450c22b767",
                                                "sense_id": "f9ce0f00-5c30-3db2-99d4-8c32a5bb2152",
                                                "text": "which infinite calamity shall cause to human life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9589ef1c-3d82-3713-b686-1450987cd5d4",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Boundless, endless, without end or limits; innumerable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f306ccec-93e6-4dfc-a1fc-efd32c71cdaa",
                                                "sense_id": "9589ef1c-3d82-3713-b686-1450987cd5d4",
                                                "text": "Great is our Lord, and of great power; his understanding is infinite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2228defa-528c-35fd-bb59-c4f648ca97d8",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Infinitely many."
                                        ],
                                        "tags": [
                                            "with plural noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec3a044d-d73a-4e69-9596-78c6a59c72b4",
                                                "sense_id": "2228defa-528c-35fd-bb59-c4f648ca97d8",
                                                "text": "Huxley's theory says that if you provide infinite monkeys with infinite typewriters, some monkey somewhere will eventually create a masterpiece – a play by Shakespeare, a Platonic dialogue, or an economic treatise by Adam Smith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d436a436-fd8e-3ff4-a7a6-90c013516506",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Greater than any positive quantity or magnitude; limitless."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ba1b5e8-388e-399c-b01e-af0f3c7a658c",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Having infinitely many elements."
                                        ],
                                        "tags": [
                                            "of a set"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "296a91bd-6667-45c3-a912-29916d03b350",
                                                "sense_id": "6ba1b5e8-388e-399c-b01e-af0f3c7a658c",
                                                "text": "For any infinite set, there is a 1-1 correspondence between it and at least one of its proper subsets. For example, there is a 1-1 correspondence between the set of natural numbers and the set of squares of natural numbers, which is a proper subset of the set of natural numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "108a4be3-85e9-38e6-9954-4aa94272c210",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Not limited by person or number."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58a54ab3-6e2b-3eac-ad61-d2fdd36e85c3",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Capable of endless repetition; said of certain forms of the canon, also called perpetual fugues, constructed so that their ends lead to their beginnings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "infinite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a3869a4-122d-3d73-ae9e-c5b558a7f543",
                                        "entry_id": "790e323a-01ef-32dc-a97a-c39d4da68b24",
                                        "glosses": [
                                            "Infinitely many."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "infinite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd65d847-7ab1-326d-9612-ea4b14f203c9",
                                        "entry_id": "46b65a2c-66e7-386b-942c-d6391de5d304",
                                        "glosses": [
                                            "Something that is infinite in nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f64a78-56cf-4c5b-a471-8f6d48d3f0af",
                                                "sense_id": "cd65d847-7ab1-326d-9612-ea4b14f203c9",
                                                "text": "Sooner Earth / Might go round Heaven, and the strait girth of Time / Inswathe the fulness of Eternity, / Than language grasp the infinite of Love."
                                            },
                                            {
                                                "example_id": "ef05bb74-53eb-4a94-af83-559a687b0bd6",
                                                "sense_id": "cd65d847-7ab1-326d-9612-ea4b14f203c9",
                                                "text": "Cautiously, Hobbes avoided asserting the equality of these infinites, and explicitly characterized the relation between them as non-inequality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1ff5e5b-902d-3f30-95df-ddb828e68a58",
                                        "entry_id": "46b65a2c-66e7-386b-942c-d6391de5d304",
                                        "glosses": [
                                            "A combo that can be used repeatedly without interruption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "445303a1-3336-4ec0-b758-25d7c5fba8e9",
                                                "sense_id": "d1ff5e5b-902d-3f30-95df-ddb828e68a58",
                                                "text": "[…] prevents overpowered combos and infinites […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "648ab2e2-ad96-4218-bb02-380b45a4f597",
                        "source_entry_id": "fd7b173f-7bba-3fc9-8be0-214b266fef4c",
                        "source_sense_id": "8f01da86-81df-33d2-abf8-234a076f9a0f",
                        "target_lang_word": "colossal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colossal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                        "entry_id": "5f056fa4-88d5-3c84-80e2-2876c8809d66",
                                        "glosses": [
                                            "Extremely large or on a great scale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72454110-5d2b-4d10-8578-17265690b6f4",
                                                "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                                "text": "A single puppy can make a colossal mess."
                                            },
                                            {
                                                "example_id": "b1b65ea9-eac6-4c08-93e3-3929f3a7de0b",
                                                "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            },
                                            {
                                                "example_id": "7c26a2ae-992b-4886-9bc1-5010e0f05976",
                                                "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                                "text": "What is wrong with you, you colossal fucking creep⁉ You found the only possible wrong answer to that question! “What’s your favorite color? Hitler.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9421876-b10e-32e3-8e6d-a9cd231461d7",
                                        "entry_id": "5f056fa4-88d5-3c84-80e2-2876c8809d66",
                                        "glosses": [
                                            "Amazingly spectacular; extraordinary; epic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37153e2a-c473-48a5-a43e-6ee174b171be",
                                                "sense_id": "a9421876-b10e-32e3-8e6d-a9cd231461d7",
                                                "text": "\"It's just the very biggest thing that I ever heard of!\" said I, though it was my journalistic rather than my scientific enthusiasm that was roused. \"It is colossal. You are a Columbus of science who has discovered a lost world.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7e0be55-bf95-40fc-a220-855685a0395f",
                        "source_entry_id": "fd7b173f-7bba-3fc9-8be0-214b266fef4c",
                        "source_sense_id": "8f01da86-81df-33d2-abf8-234a076f9a0f",
                        "target_lang_word": "vast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8749e49b-3435-3695-9788-3b53fc476509",
                                        "entry_id": "ff35927b-8665-38e9-b64a-ae23b58a6df0",
                                        "glosses": [
                                            "Very large or wide (literally or figuratively)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1014edba-356b-4e6d-9779-1ab2de5371d0",
                                                "sense_id": "8749e49b-3435-3695-9788-3b53fc476509",
                                                "text": "The Sahara desert is vast."
                                            },
                                            {
                                                "example_id": "05e0a350-7fe4-447b-a2eb-2a867b451169",
                                                "sense_id": "8749e49b-3435-3695-9788-3b53fc476509",
                                                "text": "There is a vast difference between them."
                                            },
                                            {
                                                "example_id": "2512db8f-f9b8-420d-98ba-f467bca440e0",
                                                "sense_id": "8749e49b-3435-3695-9788-3b53fc476509",
                                                "text": "They and the airline itself described an internal process that requires multiple departments to manually redesign the airline’s schedule – a system that works “the vast majority of the time,” Southwest said in a statement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1bf7b01-885e-3ecb-9168-ca8099e041c6",
                                        "entry_id": "ff35927b-8665-38e9-b64a-ae23b58a6df0",
                                        "glosses": [
                                            "Very great in size, amount, degree, intensity, or especially extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03be4272-b6d7-44df-a819-d3e2ccc8a845",
                                                "sense_id": "d1bf7b01-885e-3ecb-9168-ca8099e041c6",
                                                "text": "The exiguity and ſmallneſſe of ſome ſeeds extending to large productions is one of the magnalities of nature, ſomewhat illuſtrating the work of the Creation, and vaſt production from nothing."
                                            },
                                            {
                                                "example_id": "3272f3f7-45ce-4930-896e-e6ddd96ddb6f",
                                                "sense_id": "d1bf7b01-885e-3ecb-9168-ca8099e041c6",
                                                "text": "Another place where, from the aesthetic point of view, a long tunnel would have been a real blessing, is East London as viewed from the carriage window on the old Great Eastern line. Despite a vast change from crowded slums to tracts of wasteland, due to its grim wartime experience, this approach still provides a shabby and unworthy introduction to the great capital."
                                            },
                                            {
                                                "example_id": "4e951119-0f4e-4ebe-bbd5-c309807667ec",
                                                "sense_id": "d1bf7b01-885e-3ecb-9168-ca8099e041c6",
                                                "text": "Last spring, the periodical cicadas emerged across eastern North America. Their vast numbers and short above-ground life spans inspired awe and irritation in humans—and made for good meals for birds and small mammals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "389dd74e-84aa-3f8d-a809-5fe8f5c59586",
                                        "entry_id": "ff35927b-8665-38e9-b64a-ae23b58a6df0",
                                        "glosses": [
                                            "Waste; desert; desolate; lonely."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65af9778-ed3c-490d-afcf-1ca8f509891b",
