                    {
                        "sense_id": "e6978a6d-13dd-3ab7-87e0-151bdeffb5b9",
                        "entry_id": "a314f50f-8426-3a02-9e1a-bc23b0fe0fbd",
                        "glosses": [
                            "korte weergave met de voornaamste punten uit een langere tekst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65d26ee6-1508-4dff-b30b-47b1854a73a2",
                                "sense_id": "e6978a6d-13dd-3ab7-87e0-151bdeffb5b9",
                                "text": "In zijn uiteindelijke resumé constateerde Philips dat kleurentelevisie in de toekomst in elk huisgezin haar plaats zou krijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b078d7ab-1675-3585-a481-517b7f94c35c",
                        "entry_id": "a314f50f-8426-3a02-9e1a-bc23b0fe0fbd",
                        "glosses": [
                            "kort, beargumenteerd overzicht van eigenschappen en ervaringen die iemand geschikt maken om een bepaalde functie te vervullen (als alternatief voor een complete puntsgewijze levensbeschrijving bij een sollicitatie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c3b0774-52b2-4955-bc07-7f1e4c3a3ea0",
                                "sense_id": "b078d7ab-1675-3585-a481-517b7f94c35c",
                                "text": "Dus is een document nodig waaruit blijkt wat je met je toekomst wilt en welke talenten je wilt inzetten. Met daarnaast natuurlijk een overzicht van je relevante werk- en studieverleden. Dat is een resumé."
                            }
                        ]
                    }
