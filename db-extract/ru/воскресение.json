                    }
                ],
                "senses": [
                    {
                        "sense_id": "1bbabfad-ba64-38fe-b57f-000a5f97f7c8",
                        "entry_id": "94a4d140-ee64-3db2-bfbf-81b4a836921d",
                        "glosses": [
                            "религ. действие по значению гл. воскресать; возвращение к жизни, обретение жизни после смерти"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02c5ae68-3186-49f4-811e-17d9c5298379",
                                "sense_id": "1bbabfad-ba64-38fe-b57f-000a5f97f7c8",
                                "text": "Воскресение Iисуса Христа есть нашего падения востание."
                            },
                            {
                                "example_id": "1327e363-8833-423e-af29-764fc25319b9",
                                "sense_id": "1bbabfad-ba64-38fe-b57f-000a5f97f7c8",
                                "text": "В знак веры в жизнь вечную, в воскресение из мёртвых, клали на Востоке в древности Розу Иерихона в гроба, в могилы."
                            }
                        ]
                    },
                    {
                        "sense_id": "987e96d6-9347-3df5-92eb-a1ea6fae4942",
                        "entry_id": "94a4d140-ee64-3db2-bfbf-81b4a836921d",
                        "glosses": [
                            "перен. восстановление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d6879d0-1bf3-41b8-ba0a-1820c16f853c",
                                "sense_id": "987e96d6-9347-3df5-92eb-a1ea6fae4942",
                                "text": "Грядут со мною чудеса // И воскресение свободы!"
                            }
                        ]
                    },
                    {
                        "sense_id": "299a278c-afd3-3a0a-a579-c42a7b0a5f38",
                        "entry_id": "94a4d140-ee64-3db2-bfbf-81b4a836921d",
                        "glosses": [
                            "перен. внутреннее духовное обновление, возрождение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5da426f0-559c-4204-bdcb-86dafad2bce7",
                                "sense_id": "299a278c-afd3-3a0a-a579-c42a7b0a5f38",
                                "text": "Мы войдём в воскресение, только если сами вырастем в меру истинного, подлинного человечества…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab2216f8-4c71-4e16-810a-22c566e0f476",
                        "source_entry_id": "94a4d140-ee64-3db2-bfbf-81b4a836921d",
                        "target_lang_word": "resurrection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resurrection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30538927-eeec-31c0-80b1-db03fbe8b096",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "The act of arising from the dead and becoming alive again."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b14f9e0-7265-3f01-b3bf-7b04a941d06d",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "The general resurrection."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "accfbeeb-32c4-4b82-aec1-87c9e8d08b2d",
                                                "sense_id": "2b14f9e0-7265-3f01-b3bf-7b04a941d06d",
                                                "text": "But the rest of the dead lived not again until the thousand years were finished. This is the first resurrection.\nBlessed and holy is he that hath part in the first resurrection: on such the second death hath no power, but they shall be priests of God and of Christ, and shall reign with him a thousand years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c00426ea-c98f-34d6-8fb0-76d17f950352",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "A miraculous comeback or revival (e.g., of a TV series); recovery from a dire predicament."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4785a6e-6cc1-3373-a7fa-2723b308aeae",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "The act of bodysnatching (illicitly exhuming a cadaver)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1af9dfd3-2485-49b4-9563-b1f2d8cc7e14",
