                    "sense_id": "434f3e07-1372-338e-af20-4b37cf8c4e4a",
                    "sense_definition": "Known about and recognized by many people.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is <w>famous</w> for its beautiful old architecture.",
                            "target_lang_translations": {
                                "ru": "Этот город <w>знаменит</w> своей красивой старинной архитектурой.",
                                "nl": "De stad is <w>beroemd</w> om haar prachtige oude architectuur.",
                                "pl": "Miasto jest <w>słynne</w> ze swojej pięknej, starej architektury.",
                                "de": "Die Stadt ist <w>berühmt</w> für ihre schöne alte Architektur.",
                                "fr": "La ville est <w>célèbre</w> pour sa belle architecture ancienne.",
                                "it": "La città è <w>famosa</w> per la sua bellissima architettura antica.",
                                "cs": "Město je <w>slavné</w> svou krásnou starobylou architekturou.",
                                "tr": "Şehir, güzel eski mimarisiyle <w>ünlüdür</w>.",
                                "es": "La ciudad es <w>famosa</w> por su hermosa arquitectura antigua.",
                                "zh": "这座城市以其美丽的古建筑而<w>闻名</w>。"
                            }
                        },
                        {
                            "text": "She wants to become a <w>famous</w> singer when she grows up.",
                            "target_lang_translations": {
                                "ru": "Она хочет стать <w>известной</w> певицей, когда вырастет.",
                                "nl": "Ze wil een <w>beroemde</w> zangeres worden als ze groot is.",
                                "pl": "Ona chce zostać <w>sławną</w> piosenkarką, kiedy dorośnie.",
                                "de": "Sie möchte eine <w>berühmte</w> Sängerin werden, wenn sie groß ist.",
                                "fr": "Elle veut devenir une chanteuse <w>célèbre</w> quand elle sera grande.",
                                "it": "Vuole diventare una cantante <w>famosa</w> da grande.",
                                "cs": "Až vyroste, chce se stát <w>slavnou</w> zpěvačkou.",
                                "tr": "Büyüdüğünde <w>ünlü</w> bir şarkıcı olmak istiyor.",
                                "es": "Ella quiere convertirse en una cantante <w>famosa</w> cuando crezca.",
                                "zh": "她长大后想成为一名<w>著名</w>的歌手。"
                            }
                        }
