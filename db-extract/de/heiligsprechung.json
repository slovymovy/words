                                        "entry_id": "c158caf1-e956-3336-be31-998f199f1ce6",
                                        "glosses": [
                                            "The state of being canonized or sainted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06d2f56c-d13b-43cb-83ef-6cc82742b00a",
                                                "sense_id": "da482a0e-99ed-36a0-ba35-e659ffa3bb52",
                                                "text": "Following the attribution of two miracles, the next step is for the Pope to convene a meeting of cardinals to agree on Acutis’ sainthood and decide on a date for the canonization."
                                            }
                                        ]
