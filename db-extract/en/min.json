                                "target_senses": [
                                    {
                                        "sense_id": "6ff7ef84-7e20-3b3d-a91c-23ac9d635455",
                                        "entry_id": "afd09ac4-860f-3101-becd-0252317afd3e",
                                        "glosses": [
                                            "Sprachvariante des Chinesischen; Min-Dialekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03224c53-22eb-405c-b9e5-19dc488bf1fd",
                                                "sense_id": "6ff7ef84-7e20-3b3d-a91c-23ac9d635455",
                                                "text": "Rund 60 Millionen Menschen sprechen Min."
                                            },
                                            {
                                                "example_id": "32ceb2e9-dfa1-4666-bf3a-f60ec431a119",
                                                "sense_id": "6ff7ef84-7e20-3b3d-a91c-23ac9d635455",
                                                "text": "„Linguisten sehen Min Bei als einen der Hauptdialekte von Min an, wobei der zweite wesentliche Teil Min Nan ist.“"
