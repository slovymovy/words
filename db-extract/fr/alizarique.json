                "senses": [
                    {
                        "sense_id": "4f0f6f33-8525-3ae7-911d-88af3fa2acde",
                        "entry_id": "095e34f4-0087-3a72-a80b-f6ef9b5edbd4",
                        "glosses": [
                            "Relatif à l’alizarine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6304c975-f2ad-49de-b512-b776048c22bd",
                                "sense_id": "4f0f6f33-8525-3ae7-911d-88af3fa2acde",
                                "text": "Recette pour préparer l’encre alizarique, par Bley (Boettger, Polytech. Notix blatt., 1857, page 203). À moins de supposer que l’auteur de cette encre ait voulu, par ce nom d’alizarique, rendre l’imitation de son encre moins facile, en déroutant les contrefacteurs, il est très difficile de deviner les raisons pour lesquelles il a choisi ce nom d’alizarine, car l’alizarine est la matière colorante rouge, extraite de la garance, et le nom serait plutôt appropriée à une encre rouge."
                            }
                        ]
                    },
                    {
                        "sense_id": "462e914c-f04e-3a05-956a-91847bab84cf",
                        "entry_id": "095e34f4-0087-3a72-a80b-f6ef9b5edbd4",
                        "glosses": [
                            "Qualifiait l’acide, à présent appelé acide phtalique, isolé après traitement de l’alizarine par l’acide nitrique."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e18199d1-d913-4297-bdf3-47d849ebc184",
                                "sense_id": "462e914c-f04e-3a05-956a-91847bab84cf",
                                "text": "Acide alizarique. J’ai annoncé ci-dessus que l’alizarine décomposée par l’acide azotique étendu se transformait en un acide particulier auquel j’ai donné le nom d’acide alizarique."
                            },
                            {
                                "example_id": "a8bbb962-ad91-42e9-91ef-dadc20e3ec3e",
                                "sense_id": "462e914c-f04e-3a05-956a-91847bab84cf",
                                "text": "D’après M. Gerhardt, l’acide alizarique est identique avec l’acide phtalique."
                            }
                        ]
                    }
                ],
