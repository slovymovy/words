                    "frequency": "Low",
                    "semantic_group_id": "impressive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team played a <w>sizzling</w> match that kept everyone on the edge of their seats.",
                            "target_lang_translations": {
                                "cs": "Tým odehrál <w>strhující</w> zápas, který všechny udržoval v napětí."
                            }
