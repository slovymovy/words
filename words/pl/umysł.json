                    "frequency": "Middle",
                    "semantic_group_id": "osoba",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mikołaj Kopernik był jednym z najwybitniejszych <w>umysłów</w> swojej epoki.",
                            "target_lang_translations": {
                                "ru": "Николай Коперник был одним из величайших <w>умов</w> своей эпохи."
                            }
                        },
                        {
                            "text": "Na tej konferencji spotkały się najtęższe <w>umysły</w> z całego świata.",
                            "target_lang_translations": {
                                "ru": "На этой конференции собрались светлейшие <w>умы</w> со всего мира."
                            }
                        }
                    ],
                    "common_phrases": [
