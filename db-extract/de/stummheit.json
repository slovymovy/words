                        "entry_id": "ae9b8844-29f0-3768-aec3-b1c1e668a020",
                        "glosses": [
                            "Unfähigkeit, sich äußern zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc4f01c1-097e-4eb4-8896-0f931999044e",
                                "sense_id": "74b8c0e4-dac0-35c9-b9f1-e81ce2f6f0ef",
                                "text": "„An der Stummheit meiner Eltern, an ihrer Sprachlosigkeit hatte ich mitzutragen.“"
                            },
                            {
                                "example_id": "7fc8a987-84cb-4df7-8852-aed346153da4",
                                "sense_id": "74b8c0e4-dac0-35c9-b9f1-e81ce2f6f0ef",
                                "text": "„Der Zeichner stand in beredter Stummheit neben ihm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
