                    },
                    {
                        "translation_id": "3ff2da69-2654-42cc-93d2-75f08a06f604",
                        "source_entry_id": "20b77f01-e245-3550-b951-95567d79f0b9",
                        "source_sense_id": "50611514-5884-301f-9f6f-936fcbc414b1",
                        "source_sense_description": "in an unwilling manner",
                        "target_lang_word": "involontairement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "involontairement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e528f08-3dd7-3dd2-9d50-48cf82bd402f",
                                        "entry_id": "7a693b80-fa4e-3f1e-9b11-2cb8aa834bf3",
                                        "glosses": [
                                            "Sans le vouloir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b46d510-27b0-43eb-b7b9-3676a89a8f8e",
                                                "sense_id": "9e528f08-3dd7-3dd2-9d50-48cf82bd402f",
                                                "text": "Il laissa Rébecca en la société de la vieille femme, à qui elle avait été ainsi involontairement imposée."
                                            },
                                            {
                                                "example_id": "5ca474d6-8842-4342-ad76-5dbf4c3d9306",
                                                "sense_id": "9e528f08-3dd7-3dd2-9d50-48cf82bd402f",
                                                "text": "Sans doute une des lanternes qui, heurtée involontairement contre la muraille, avait pirouetté sur elle-même et présenté en arrière la vitre lumineuse."
                                            },
                                            {
                                                "example_id": "40df1d1d-1359-45fc-8a64-c3177cdc84db",
                                                "sense_id": "9e528f08-3dd7-3dd2-9d50-48cf82bd402f",
                                                "text": "Comme la plupart des jeunes femmes réellement innocentes et sans expérience, elle voyait une faute dans un amour involontairement inspiré à un homme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4790491b-3514-4d7a-a821-2028bf0e4871",
                        "source_entry_id": "20b77f01-e245-3550-b951-95567d79f0b9",
                        "source_sense_id": "50611514-5884-301f-9f6f-936fcbc414b1",
                        "source_sense_description": "in an unwilling manner",
                        "target_lang_word": "widerwillig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "widerwillig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e8777af-4824-3569-ac07-312d381218df",
                                        "entry_id": "131aa229-99c5-3426-93d0-05dcfac4402e",
                                        "glosses": [
                                            "ohne Lust, ohne Freude, sehr ungern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3795c2-1d62-4148-8f6f-d41471df9244",
                                                "sense_id": "5e8777af-4824-3569-ac07-312d381218df",
                                                "text": "Widerwillig begann sie mit der Arbeit."
                                            },
                                            {
                                                "example_id": "12a2f074-6259-4489-9cda-1617908b0039",
                                                "sense_id": "5e8777af-4824-3569-ac07-312d381218df",
                                                "text": "Er begleitete sie nur widerwillig zum Arzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9273e6a-a176-3474-8be8-63db113b4230",
                                        "entry_id": "131aa229-99c5-3426-93d0-05dcfac4402e",
                                        "glosses": [
                                            "Unmut, Abneigung, Abscheu zum Ausdruck bringend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9555a2c3-76e3-40ce-907c-e3d926942052",
                                                "sense_id": "f9273e6a-a176-3474-8be8-63db113b4230",
                                                "text": "Beim Anblick des Abendessens machte sie ein widerwilliges Gesicht."
                                            },
                                            {
                                                "example_id": "cc7c4686-2ba6-42bd-9844-6362ceb9e143",
                                                "sense_id": "f9273e6a-a176-3474-8be8-63db113b4230",
                                                "text": "Sie reagierte mit einer widerwilligen Geste."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "08c49b3b-2c50-30f5-9106-5d651c0550c8",
                                        "entry_id": "131aa229-99c5-3426-93d0-05dcfac4402e",
                                        "glosses": [
                                            "feindlich entzweit"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf1fb709-7015-4367-9b71-a27972e2f493",
                                                "sense_id": "08c49b3b-2c50-30f5-9106-5d651c0550c8",
                                                "text": "Es gelang niemandem, die widerwilligen Brüder zu versöhnen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05971ced-206f-402a-87fa-b745b9b4da4a",
                        "source_entry_id": "20b77f01-e245-3550-b951-95567d79f0b9",
                        "source_sense_id": "50611514-5884-301f-9f6f-936fcbc414b1",
                        "source_sense_description": "in an unwilling manner",
                        "target_lang_word": "unwillig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwillig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45a2bc3d-24fb-3930-b99f-32ef4915d075",
                                        "entry_id": "db464410-44fc-38f5-99d1-c260f4499fe4",
                                        "glosses": [
                                            "so, dass man Verärgerung/Ablehnung bei jemandem erkennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "879e69fa-86e2-47a1-b360-5533d26665a4",
                                                "sense_id": "45a2bc3d-24fb-3930-b99f-32ef4915d075",
                                                "text": "„Sie schüttelt unwillig den Kopf: Sie macht dies einfach nicht mehr mit.“"
                                            },
                                            {
                                                "example_id": "8c69085e-d57a-4790-8ae5-8ffed25a4b25",
                                                "sense_id": "45a2bc3d-24fb-3930-b99f-32ef4915d075",
                                                "text": "„Unwillig die Argumente des Gegenübers anzuhören, eskaliert die Situation und sie geben einander mit Schirmen aufs «Dach».“"
                                            },
                                            {
                                                "example_id": "8be56261-b255-496d-bbf9-1658e1dd7f8d",
                                                "sense_id": "45a2bc3d-24fb-3930-b99f-32ef4915d075",
                                                "text": "[DDR, Ostblock:] „Der unwillige Teil der Bevölkerung, der zum Teil lieber ausgewandert wäre, wurde oft durch Sperranlagen und strenge Visa-Bestimmungen am Verlassen des Staates gehindert.“"
                                            },
                                            {
                                                "example_id": "a36e880d-9e76-4423-9d69-c1fefaae54cb",
                                                "sense_id": "45a2bc3d-24fb-3930-b99f-32ef4915d075",
                                                "text": "„Der Chefcoach des russischen Teams und viele Athleten waren unwillig, das Ausmass des Dopingproblems in der Leichtathletik ihres Landes zu erkennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                        "entry_id": "db464410-44fc-38f5-99d1-c260f4499fe4",
                                        "glosses": [
                                            "nicht bereit/willens, etwas zu tun; ohne Bereitwilligkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca1a9763-b0e8-464b-9ec1-a4d923b7fab9",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "„Unwillig die Argumente des Gegenübers anzuhören, eskaliert die Situation und sie geben einander mit Schirmen aufs «Dach».“"
                                            },
                                            {
                                                "example_id": "ca0f604a-82ad-45f3-903c-8cc5ba21fdae",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "„Dabei konnte man Mirko keineswegs unwillig oder widerspenstig nennen. Er tat gehorsam, was man ihm gebot,“ […]."
                                            },
                                            {
                                                "example_id": "30710135-be03-43fa-88aa-de0605e3cce8",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "„Ein Pferd ist kein unwilliger Gaul, den du dominieren musst. Es geht vielmehr um eine Zusammenarbeit, die du anleiten solltest.“"
                                            },
                                            {
                                                "example_id": "a62cc540-0c34-4f9e-9403-053449414dab",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "[Heinrich VIII.:] „Tatsächlich war Heinrich so unwillig, sich extra Zeit für die Lektüre seiner Korrespondenz zu nehmen, dass er sie während der Abendmesse erledigte.“"
                                            },
                                            {
                                                "example_id": "1c051924-263e-4c06-ac7f-975f70ab585c",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "[Maria Theresia:] „Die Aufhebung des Jesuitenordens 1773 ging nicht von ihr aus, sondern sie vollzog das päpstliche Verbot eher unwillig.“"
                                            },
                                            {
                                                "example_id": "2a4568c7-0ed1-424f-9559-68ec44233c2f",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "„Im Zuge seiner Untersuchungen bemüht er sich weiter um die Kooperation bisher unwilliger Zeugen.“"
                                            },
                                            {
                                                "example_id": "4bae3344-c31d-41ad-be02-07cb180f285e",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "„Wer sich nach Ansicht der Jobcenter unwillig zeigt, der muss mit Sanktionen rechnen.“"
                                            },
                                            {
                                                "example_id": "0508b8bc-3e64-4b30-9b75-edd077afb60f",
                                                "sense_id": "ebe6dd8c-b39e-32cb-9184-661fd08999ef",
                                                "text": "Unwillige Staaten der Europäischen Union, sich für Rechtsstaatlichkeit, Presse- und Demonstrationsfreiheit und gegen Korruption und Behördenwillkür einzusetzen, gehören mindestens finanziell sanktioniert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
