                                "target_senses": [
                                    {
                                        "sense_id": "4dacb909-c8f9-359a-b77b-ecea65d895fc",
                                        "entry_id": "5b422306-d349-37ca-bcf6-48c4882e97a3",
                                        "glosses": [
                                            "A telegrapher or telegraph operator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46a05ad7-6396-4005-9eba-288af70ef5ec",
                                                "sense_id": "4dacb909-c8f9-359a-b77b-ecea65d895fc",
                                                "text": "He had taken the wife to his raw new palace in San Diego, where she and her people occupied a wing of great price, and Cheyne, in a veranda-room, between a secretary and a typewriter, who was also a telegraphist, toiled along wearily from day to day."
                                            },
                                            {
                                                "example_id": "824bcfc2-1b65-4673-8b9c-49a7746cf156",
                                                "sense_id": "4dacb909-c8f9-359a-b77b-ecea65d895fc",
                                                "text": "But the next stations, Wamphray, and Dinwoodie, were small places, very probably with no night telegraphists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
