                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf59e7f5-72c0-4f9e-b0ea-18792068c047",
                        "source_entry_id": "73968d9c-7485-3ba7-98b8-c99ae7f6d19b",
