                    "semantic_group_id": "fate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Злой <w>рок</w> преследовал его всю жизнь.",
                            "target_lang_translations": {
                                "en": "An evil <w>fate</w> pursued him all his life.",
                                "nl": "Het boze <w>noodlot</w> achtervolgde hem zijn hele leven."
                            }
                        },
                        {
                            "text": "По иронии <w>рока</w> они встретились снова.",
                            "target_lang_translations": {
