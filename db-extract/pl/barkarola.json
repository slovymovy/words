        "pl-extract.jsonl": [
            {
                "entry_id": "f9eae262-e7ea-38c7-940c-14b1d7318877",
                "word": "barkarola",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "394faf37-c526-389a-944f-3ae05e361e51",
                        "entry_id": "f9eae262-e7ea-38c7-940c-14b1d7318877",
                        "glosses": [
                            "liryczna pieśń gondolierów w Wenecji"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "86a40c98-0abf-39b8-82a1-273d9a7da42c",
                        "entry_id": "f9eae262-e7ea-38c7-940c-14b1d7318877",
                        "glosses": [
                            "utwór muzyczny przypominający barkarolę (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "771918ea-1a84-4943-81d0-04abd9c98c4c",
                                "sense_id": "86a40c98-0abf-39b8-82a1-273d9a7da42c",
                                "text": "Wytarł smyczek kalafonią, brzęknął na strunach, pokręcił klucze i w chwilę później spod delikatnych palców rozległy się dźwięki barkaroli."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a064ecb-d2a7-4033-a07c-076cf77e37a3",
                        "source_entry_id": "f9eae262-e7ea-38c7-940c-14b1d7318877",
                        "source_sense_id": "394faf37-c526-389a-944f-3ae05e361e51",
                        "target_lang_word": "barcarolle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barcarolle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13ee6da6-9bc8-325c-b589-9358d54f3fe7",
                                        "entry_id": "e98ae8a8-e433-3fd7-96cc-d8a9d514d5fd",
                                        "glosses": [
                                            "Alternative spelling of barcarole."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c44f4994-8808-49e7-bf08-841428b73bc0",
                                                "sense_id": "13ee6da6-9bc8-325c-b589-9358d54f3fe7",
                                                "text": "A Barcarolle, with variations for the Pianoforte and flute, ad lib. by [Jean Théodore] Latour, opens with an introduction of great feeling and elegance. The Barcarolle is composed by [Jacques Féréol] Mazas, the great violinist, and has been played by him at the Philharmonic Concerts, and is original and graceful."
                                            },
                                            {
                                                "example_id": "d658d561-8d0f-42d1-9717-d59d2e084736",
                                                "sense_id": "13ee6da6-9bc8-325c-b589-9358d54f3fe7",
                                                "text": "Venice! dear beautiful Venice! scene of harmony and love! where all was gayety and mirth, revelry and pleasure, with what warm feelings do I recall thee to my memory; day and night were the gondoliers singing barcarolles, or the verses of [Torquato] Tasso and [Ludovico] Ariosto to Venetian airs; […]"
                                            },
                                            {
                                                "example_id": "418ead41-44aa-416e-8948-10064c11f903",
                                                "sense_id": "13ee6da6-9bc8-325c-b589-9358d54f3fe7",
                                                "text": "Later in the evening Mr. [Anton] Rubinstein played his smaller pieces, such as the march from \"The Ruins of Athens,\" his own \"Barcarolle,\" and \"Valse Caprice,\" and the enthusiasm and appreciation of his intelligent audience grew greater and greater."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02e58f3e-90e4-407f-92b1-612eda123421",
                        "source_entry_id": "f9eae262-e7ea-38c7-940c-14b1d7318877",
                        "source_sense_id": "394faf37-c526-389a-944f-3ae05e361e51",
