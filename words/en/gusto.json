                    "frequency": "VeryLow",
                    "semantic_group_id": "flavor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exotic fruit had a unique <w>gusto</w> that was hard to describe.",
                            "target_lang_translations": {
                                "nl": "Het exotische fruit had een unieke <w>smaak</w> die moeilijk te omschrijven was."
                            }
                        },
                        {
                            "text": "The chef enhanced the <w>gusto</w> of the soup with fresh herbs.",
                            "target_lang_translations": {
