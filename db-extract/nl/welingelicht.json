                                "sense_id": "cbbaa931-92aa-3f2f-804a-880d042f365a",
                                "text": "Het was niet zo dat ik door dit soort welingelichte verslagen van Joar 's nachts goed sliep."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "391477b5-4b26-472f-965f-5a1bf45e1c4c",
                        "source_entry_id": "fef39bcc-e330-33ff-9321-159663191db6",
                        "source_sense_id": "cbbaa931-92aa-3f2f-804a-880d042f365a",
                        "target_lang_word": "abreast",
                        "target_lang_code": "en",
