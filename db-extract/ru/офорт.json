                                        "sense_id": "5663b9c7-f4b5-3aa2-b981-3501e0e93f22",
                                        "entry_id": "59cc3f0f-9d80-34c0-b0f0-78dc9b986db4",
                                        "glosses": [
                                            "The image created by this process."
                                        ],
                                        "tags": [
