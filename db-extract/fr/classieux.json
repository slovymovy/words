                                                "sense_id": "80e72f22-8893-3ce5-8731-e689347d8a72",
                                                "text": "Sie ist eine ausgesprochen schicke Person."
                                            },
                                            {
                                                "example_id": "ef1f69d5-98b7-44a3-9c07-a1d6e6a5f9c3",
                                                "sense_id": "80e72f22-8893-3ce5-8731-e689347d8a72",
                                                "text": "Der neue Laden ist sehr schick aufgemacht."
                                            },
                                            {
                                                "example_id": "1c28395d-c201-4242-ba57-dd32c3caadc1",
                                                "sense_id": "80e72f22-8893-3ce5-8731-e689347d8a72",
                                                "text": "„Wir hatten uns schick gemacht am ersten Tag nach den großen Ferien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa6fe3a3-24e2-3f05-9180-1953d3a55dce",
