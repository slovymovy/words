                                                "sense_id": "2aa4e8d7-adf1-3763-b766-b4007ae6c7fe",
                                                "text": "You have brought dishonour upon the family."
                                            },
                                            {
                                                "example_id": "0bfc359c-badc-4528-8c21-7692ee2e9ae6",
                                                "sense_id": "2aa4e8d7-adf1-3763-b766-b4007ae6c7fe",
