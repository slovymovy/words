                                "target_senses": [
                                    {
                                        "sense_id": "1f03d96b-c86b-3a18-ba5c-cc6da78f926b",
                                        "entry_id": "16335fb3-0d2a-30a8-9bd5-19a7bf41b5e7",
                                        "glosses": [
                                            "A colourant, especially one that has an affinity to the substrate to which it is applied."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
