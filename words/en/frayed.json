{
    "word_family": [
        "fray",
        "fraying"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "37437e90-ad16-369b-921c-66ef42d0de29",
                    "sense_definition": "Unravelled or worn at the end or edge.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a <w>frayed</w> jacket with <w>frayed</w> cuffs.",
                            "target_lang_translations": {
                                "zh": "他穿着一件<w>磨损</w>的夹克，袖口也已经<w>磨损</w>了。"
                            }
                        },
                        {
                            "text": "The <w>frayed</w> rope snapped under the heavy weight.",
                            "target_lang_translations": {
                                "zh": "那根<w>磨损</w>的绳子在重压下断了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tattered",
                        "worn"
                    ],
                    "antonyms": [
                        "intact"
                    ],
                    "common_phrases": [
                        "frayed cuffs",
                        "frayed edges"
                    ],
                    "target_lang_definitions": {
                        "zh": "指织物或绳索的边缘磨损、散线。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "磨损的",
                                "target_lang_sense_clarification": "形容物体表面或边缘因摩擦而破损。"
                            },
                            {
                                "target_lang_word": "磨破的",
                                "target_lang_sense_clarification": "形容边缘因长期使用而变得破烂。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "639d4a64-6f26-334f-9d5a-2b47ba0763f4",
                    "sense_definition": "Exhausted, strained, or suffering from stress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long project, her <w>frayed</w> nerves finally calmed down.",
                            "target_lang_translations": {
                                "zh": "漫长的项目结束后，她那<w>紧绷</w>的神经终于放松了下来。"
                            }
                        },
                        {
                            "text": "The <w>frayed</w> team struggled to finish the difficult task on time.",
                            "target_lang_translations": {
                                "zh": "这支<w>疲惫</w>的团队努力按时完成了艰巨的任务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strained",
                        "exhausted"
                    ],
                    "antonyms": [
                        "relaxed"
                    ],
                    "common_phrases": [
                        "frayed nerves"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人的神经或情绪因压力而紧张、疲惫。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "紧张的",
                                "target_lang_sense_clarification": "形容因压力大而紧绷的状态。"
                            },
                            {
                                "target_lang_word": "疲惫的",
                                "target_lang_sense_clarification": "形容因长期劳累而导致的精神状态。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6cb6a1a6-c054-3428-92ae-d639e99ce944",
                    "sense_definition": "Simple past and past participle of <w>fray</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant rubbing <w>frayed</w> the fabric of the old curtains.",
                            "target_lang_translations": {
                                "zh": "不断的摩擦使旧窗帘的布料<w>磨损</w>了。"
                            }
                        },
                        {
                            "text": "Years of heavy use have <w>frayed</w> the edges of the carpet.",
                            "target_lang_translations": {
                                "zh": "多年的高强度使用已经使地毯的边缘<w>磨损</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使磨损、使散线（fray的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "磨损",
                                "target_lang_sense_clarification": "指因摩擦导致物体边缘破损。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}