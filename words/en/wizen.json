    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "57951427-a3d1-35ec-88f2-a9725b366da2",
                    "sense_definition": "Withered, lean, and wrinkled due to age or illness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "withered",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man had a <w>wizen</w> face that showed every year of his long life.",
                            "target_lang_translations": {
                                "fr": "Le vieil homme avait un visage <w>flétri</w> qui témoignait de chaque année de sa longue vie."
                            }
                        },
                        {
                            "text": "After the long drought, the <w>wizen</w> fruit hung limply from the dry branches.",
                            "target_lang_translations": {
                                "fr": "Après la longue sécheresse, les fruits <w>ratatinés</w> pendaient mollement aux branches sèches."
                            }
                        }
                    ],
                    "synonyms": [
                        "withered",
                        "shriveled",
                        "wrinkled"
                    ],
                    "antonyms": [
                        "plump",
                        "smooth"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is rarely used in modern English, with 'wizened' being the standard form."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Flétri, maigre et ridé en raison de l'âge ou de la maladie."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "flétri",
                                "target_lang_sense_clarification": "se dit d'une personne ou d'une chose ayant perdu sa fraîcheur"
                            },
                            {
                                "target_lang_word": "ridé",
                                "target_lang_sense_clarification": "se dit spécifiquement de la peau marquée par des rides"
                            },
                            {
                                "target_lang_word": "desséché",
                                "target_lang_sense_clarification": "qui a perdu son humidité et son volume"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "53f59f91-f7b1-3c10-99a1-5d07fdbc9cca",
                    "sense_definition": "To become or make lean and wrinkled by shrinkage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "withered",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat caused the leaves to <w>wizen</w> and turn brown within days.",
                            "target_lang_translations": {
                                "fr": "La chaleur intense a fait <w>se flétrir</w> les feuilles, qui sont devenues brunes en quelques jours."
                            }
                        },
                        {
                            "text": "Exposure to the harsh winter wind began to <w>wizen</w> the exposed skin on his cheeks.",
                            "target_lang_translations": {
                                "fr": "L'exposition au vent glacial de l'hiver a commencé à <w>faire se rider</w> la peau exposée de ses joues."
                            }
                        }
                    ],
                    "synonyms": [
                        "wither",
                        "shrivel",
                        "shrink"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Devenir ou rendre maigre et ridé par le rétrécissement."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se flétrir",
                                "target_lang_sense_clarification": "perdre sa vitalité et se ratatiner"
                            },
                            {
                                "target_lang_word": "se ratatiner",
                                "target_lang_sense_clarification": "se contracter et devenir ridé"
                            },
                            {
                                "target_lang_word": "se dessécher",
                                "target_lang_sense_clarification": "perdre son eau et durcir"
                            }
                        ]
                    }
                }
            ]
        }
    ]
