    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a526d34-ca9b-3054-8b92-bdf0d9887849",
                    "sense_definition": "kawałek miękkiego kauczuku lub tworzywa sztucznego służący do ścierania śladów ołówka z papieru",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "artykuły papiernicze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W piórniku zawsze noszę dwa ołówki oraz małą <w>gumkę</w> do ścierania.",
                            "target_lang_translations": {
                                "ru": "В пенале я всегда ношу два карандаша и маленький <w>ластик</w>."
                            }
                        },
                        {
                            "text": "Poprawiłem błąd w rysunku za pomocą miękkiej <w>gumki</w>.",
                            "target_lang_translations": {
                                "ru": "Я исправил ошибку в рисунке с помощью мягкой <w>резинки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gumka do ścierania"
                    ],
                    "common_phrases": [
                        "gumka do ścierania",
                        "miękka gumka"
                    ],
                    "target_lang_definitions": {
                        "ru": "кусочек мягкого каучука или полимерного материала, служащий для стирания карандашных следов с бумаги"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ластик",
                                "target_lang_sense_clarification": "канцелярский предмет для стирания"
                            },
                            {
                                "target_lang_word": "резинка",
                                "target_lang_sense_clarification": "стирательная резинка"
                            },
                            {
                                "target_lang_word": "стирательная резинка",
                                "target_lang_sense_clarification": "канцелярская принадлежность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bef08501-f09f-33d9-a2c9-bcd6dfc77bc5",
                    "sense_definition": "elastyczna opaska używana do wiązania i upinania włosów",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "akcesoria fryzjerskie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Związała długie włosy w kucyk za pomocą kolorowej <w>gumki</w>.",
                            "target_lang_translations": {
                                "ru": "Она завязала длинные волосы в хвост с помощью цветной <w>резинки</w>."
                            }
                        },
                        {
                            "text": "Kupiłam w sklepie zestaw kilku elastycznych <w>gumek</w> do włosów.",
                            "target_lang_translations": {
                                "ru": "Я купила в магазине набор из нескольких эластичных <w>резинок для волос</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "frotka"
                    ],
                    "common_phrases": [
                        "gumka do włosów"
                    ],
                    "target_lang_definitions": {
                        "ru": "эластичная повязка, кольцо для собирания и закрепления волос"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резинка для волос",
                                "target_lang_sense_clarification": "аксессуар для причёски"
                            },
                            {
                                "target_lang_word": "резинка",
                                "target_lang_sense_clarification": "для волос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7358f6c6-fe7f-34ad-8255-33c0398c4a14",
                    "sense_definition": "rozciągliwy pasek lub pętla z elastycznego materiału, używany do spinania lub podtrzymywania przedmiotów",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przedmioty użytkowe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Listy na biurku były spięte cienką <w>gumką</w> recepturką.",
                            "target_lang_translations": {
                                "ru": "Письма на столе были скреплены тонкой банковской <w>резинкой</w>."
                            }
                        },
                        {
                            "text": "Stara <w>gumka</w> w tych spodniach zupełnie straciła elastyczność.",
                            "target_lang_translations": {
                                "ru": "Старая <w>резинка</w> в этих брюках совсем потеряла эластичность."
                            }
                        }
                    ],
                    "synonyms": [
                        "recepturka"
                    ],
                    "common_phrases": [
                        "gumka recepturka"
                    ],
                    "target_lang_definitions": {
                        "ru": "растягивающаяся полоска или петля из эластичного материала, используемая для скрепления предметов или в одежде"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резинка",
                                "target_lang_sense_clarification": "эластичная лента или кольцо"
                            },
                            {
                                "target_lang_word": "канцелярская резинка",
                                "target_lang_sense_clarification": "для скрепления купюр или бумаг"
                            },
                            {
                                "target_lang_word": "эластичная тесьма",
                                "target_lang_sense_clarification": "в одежде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da7a9c36-2820-3ce2-9f47-ab0d1709e7ef",
                    "sense_definition": "mechaniczny środek antykoncepcyjny nakładany na męski członek",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "antykoncepcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyjazdem na wakacje kupił w aptece całą paczkę <w>gumek</w>.",
                            "target_lang_translations": {
                                "ru": "Перед поездкой в отпуск он купил в аптеке целую пачку <w>резинок</w>."
                            }
                        },
                        {
                            "text": "Używanie <w>gumki</w> chroni nie tylko przed ciążą, ale też przed chorobami.",
                            "target_lang_translations": {
                                "ru": "Использование <w>презерватива</w> защищает не только от беременности, но и от болезней."
                            }
                        }
                    ],
                    "synonyms": [
                        "prezerwatywa"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie prezerwatywy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "барьерное противозачаточное средство (разговорное обозначение)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резинка",
                                "target_lang_sense_clarification": "разговорное название презерватива"
                            },
                            {
                                "target_lang_word": "презерватив",
                                "target_lang_sense_clarification": "контрацептив"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cb9e855-b670-3933-a416-c0a838276f31",
                    "sense_definition": "narzędzie w programie graficznym przeznaczone do usuwania elementów obrazu",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "oprogramowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wybrałem z menu narzędzie <w>gumki</w>, aby usunąć niepotrzebną linię na projekcie.",
                            "target_lang_translations": {
                                "ru": "Я выбрал в меню инструмент <w>«Ластик»</w>, чтобы удалить ненужную линию на чертеже."
                            }
                        },
                        {
                            "text": "W tym programie możesz łatwo zmienić rozmiar wirtualnej <w>gumki</w>.",
                            "target_lang_translations": {
                                "ru": "В этой программе ты можешь легко изменить размер виртуального <w>ластика</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "narzędzie gumka"
                    ],
                    "target_lang_definitions": {
                        "ru": "инструмент в графическом редакторе, предназначенный для удаления элементов изображения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ластик",
                                "target_lang_sense_clarification": "инструмент в графическом редакторе"
                            },
                            {
                                "target_lang_word": "ластик-стёрка",
                                "target_lang_sense_clarification": "в компьютерной программе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
