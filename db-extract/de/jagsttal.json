                "senses": [
                    {
                        "sense_id": "cb58f4cf-233a-3376-bd1f-ceab2b474dee",
                        "entry_id": "7c1cd2b1-9b88-3530-aa1f-f0c67b0ef72b",
                        "glosses": [
                            "das Tal, in dem die Jagst fließt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "224d2e31-2eb5-4108-826b-93a2674cf5c6",
                                "sense_id": "cb58f4cf-233a-3376-bd1f-ceab2b474dee",
                                "text": "„Der russische Multimillionär Alexander Dragilev hat eine Burg im Jagsttal in einen Ashram verwandelt.“"
                            },
                            {
                                "example_id": "d00195fe-b9ad-43d1-bc6a-b45eef27e6e5",
                                "sense_id": "cb58f4cf-233a-3376-bd1f-ceab2b474dee",
                                "text": "„Im idyllischen Jagsttal gibt es neben zahlreichen spirituellen Orten auch manche mystische Geschichte aus der Vergangenheit.“"
                            },
                            {
                                "example_id": "edf80de9-7f09-40ce-ae1d-81be10dcf1dc",
                                "sense_id": "cb58f4cf-233a-3376-bd1f-ceab2b474dee",
                                "text": "„Danach wandern wir durch das völlig ebene Jagsttal zurück.“"
                            },
                            {
                                "example_id": "1196bb24-b4e4-4c42-90fd-1126ecba600c",
                                "sense_id": "cb58f4cf-233a-3376-bd1f-ceab2b474dee",
                                "text": "„Im kleinen Ort im Jagsttal leben nur rund 60 Einwohner.“"
                            },
                            {
                                "example_id": "126e9732-d1b8-4552-8c6f-653ae880c754",
                                "sense_id": "cb58f4cf-233a-3376-bd1f-ceab2b474dee",
                                "text": "„Die Klassen 7c und 8b waren kürzlich im Waldschulheim Kloster Schöntal ins Jagsttal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
