                "senses": [
                    {
                        "sense_id": "41a47cf7-89fe-3139-bffd-336e7a6471cc",
                        "entry_id": "90db8c21-eb90-3e23-ac94-0cfc9a65d5fd",
                        "glosses": [
                            "Eigenschaft, aus Erfahrung schlau, geschickt zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "694896a1-bc20-4400-86fc-a741b2e1ff2e",
                                "sense_id": "41a47cf7-89fe-3139-bffd-336e7a6471cc",
                                "text": "„Seine Worte sind begleitet von einem gewissen Hohn gegenüber Goran und Respekt für Finéras Gewieftheit.“"
                            },
                            {
                                "example_id": "b94ae8b8-3d77-4b47-9b9f-05134543e983",
                                "sense_id": "41a47cf7-89fe-3139-bffd-336e7a6471cc",
                                "text": "„Mir gefielen seine Gewieftheit und seine Geistesschärfe Auszeichnungen eines Mannes der Tat.“"
                            },
                            {
                                "example_id": "e7204c84-4e43-49f3-a5c1-3db08e0009ab",
                                "sense_id": "41a47cf7-89fe-3139-bffd-336e7a6471cc",
                                "text": "„Trump ist vor allem Geschäftsmann, der König der Gewieftheit, ein ausgezeichneter Verkäufer und Schwätzer.“"
                            },
                            {
                                "example_id": "5274d1a8-5b19-42fa-9a3f-1e3684eda834",
                                "sense_id": "41a47cf7-89fe-3139-bffd-336e7a6471cc",
                                "text": "„Er hatte auch ein Auge für die Gewieftheiten auf dem Platz, die wir später in unser Positionsspiel aufgenommen haben.“"
                            },
                            {
                                "example_id": "f2cec61d-9243-4d7d-804c-35d4315aeef6",
                                "sense_id": "41a47cf7-89fe-3139-bffd-336e7a6471cc",
                                "text": "„So heißt es bei Evelyn Roll über die Gewieftheiten der Angela Merkel, sich an offiziellen Propaganda-Veranstaltungen, wie etwa den 1. Mai-Demonstrationen, vorbeizumogeln: ‚Sie hat sich gedrückt, wann immer es ging […].‘“"
                            },
                            {
                                "example_id": "fa2d8e44-1891-4565-aa82-84bdd05103fe",
                                "sense_id": "41a47cf7-89fe-3139-bffd-336e7a6471cc",
                                "text": "„Ich hatte mir ein paar Gewieftheiten ausgedacht, auch alles hübsch frei vorgetragen, und es fand nun tatsächlich auch sowas wie eine Unglückskompensation statt.“"
                            },
                            {
                                "example_id": "a6c4067c-cca0-4d18-94b1-4aa36e1afa1d",
                                "sense_id": "41a47cf7-89fe-3139-bffd-336e7a6471cc",
                                "text": "„Zusammen mit den serienmäßigen Carbon-Keramik-Bremsen, die auch zur Gewichtsminimierung beitragen, dem Sperrdifferenzial und vielen weiteren technischen Gewieftheiten, beweist der Aston Martin Vantage AMR, dass er sich unterm Strich doch den Titel ‚Performance-Version’ verdient – auch, wenn das manuelle Schaltgetriebe Zeit kostet.“"
                            },
                            {
                                "example_id": "bb4e8649-a037-45f9-a969-b8cab404105b",
                                "sense_id": "41a47cf7-89fe-3139-bffd-336e7a6471cc",
                                "text": "„Diplomatische Formulierungen, Gewieftheiten, verschwurbelte Sprechblasen und Nicht-Ausgesprochenes - das alles mag ein unausweichlicher Teil des politischen Geschäfts sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
