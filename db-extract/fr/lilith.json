            {
                "entry_id": "c47bffda-7a57-3925-ab53-cc0e1af09114",
                "word": "Lilith",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d94934f-693b-36ec-b57f-e284cc026583",
                        "entry_id": "c47bffda-7a57-3925-ab53-cc0e1af09114",
                        "glosses": [
                            "Démon féminin de la tradition juive, présentée depuis le Moyen Âge comme la première compagne d’Adam, avant Ève."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f01ab9f7-2b69-4d08-aca8-ec61f12ee4f6",
                                "sense_id": "1d94934f-693b-36ec-b57f-e284cc026583",
                                "text": "Étrangement, on trouve également en bonne place une « démone », Lilith (Is 34,14), ce qui est curieux quand on songe que les anges ne sont pas censés avoir de sexe, mais qui est compréhensible quand on sait que ces noms attribués à certains anges sont empruntés à des divinités païenne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82a6dbb2-ad4b-409c-9f36-71d37b3b85ea",
                        "source_entry_id": "c47bffda-7a57-3925-ab53-cc0e1af09114",
                        "source_sense_id": "1d94934f-693b-36ec-b57f-e284cc026583",
                        "target_lang_word": "Lilith",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lilith",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5aa5fdd0-3653-3845-a98a-2800f2f7ca6d",
                                        "entry_id": "445260cb-eea0-3126-8300-18b94e4143a6",
                                        "glosses": [
                                            "weiblicher Dämon sumerischer Herkunft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "907a1847-305a-41bc-ba06-6ee5404a5b21",
                                                "sense_id": "5aa5fdd0-3653-3845-a98a-2800f2f7ca6d",
                                                "text": "„Der Satan hielt hier seinen babylonischen Hof, und mit dem Blut unbefleckter Kindheit wurden die leprösen Glieder Liliths gewaschen.“"
                                            },
                                            {
                                                "example_id": "0db23929-066d-4b87-ada8-68b8a0c6dfdf",
                                                "sense_id": "5aa5fdd0-3653-3845-a98a-2800f2f7ca6d",
                                                "text": "„Auch sie war böse und ihre Schönheit war die Schönheit der Lilith.“"
                                            },
                                            {
                                                "example_id": "2fab2249-c34d-4caa-9a66-0bb3be8b63fc",
                                                "sense_id": "5aa5fdd0-3653-3845-a98a-2800f2f7ca6d",
                                                "text": "„Wir folgen dem geschlängelten Weg, und Leonard zählt noch immer Dämonen auf, denen wir begegnen könnten: Mevet, der judaische Totengott; Lilith, die Kinder stiehlt; Reshef, der Dämon der Plagen; Azazel, Dämon der Wüsten; Astaroth ... Robert Mapplethorpe ... Luzifer ... Behemoth ...“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acfa7810-011a-450c-b5c9-597176f5796f",
                        "source_entry_id": "c47bffda-7a57-3925-ab53-cc0e1af09114",
                        "source_sense_id": "1d94934f-693b-36ec-b57f-e284cc026583",
                        "target_lang_word": "Lilith",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lilith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07fea10f-eb7b-3dcc-bd8b-90ab24621f12",
                                        "entry_id": "1afd5de4-5baf-3941-9f4d-0dcf6fe38689",
                                        "glosses": [
                                            "A Mesopotamian storm demon, a bearer of disease and death."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f00514c-1c0a-37ae-80b8-84c66c29107a",
                                        "entry_id": "1afd5de4-5baf-3941-9f4d-0dcf6fe38689",
                                        "glosses": [
                                            "The first wife of Adam in Jewish folklore."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef3cc6ef-4665-47da-9701-8250213e415b",
                                                "sense_id": "4f00514c-1c0a-37ae-80b8-84c66c29107a",
                                                "text": "Of Adam's first wife, Lilith, it is told / (The witch he loved before the gift of Eve,) / That, ere the snake's, her sweet tongue could deceive, / And her enchanted hair was the first gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acb87dee-9f09-3035-81b2-3fb6183633ef",
                                        "entry_id": "1afd5de4-5baf-3941-9f4d-0dcf6fe38689",
                                        "glosses": [
                                            "The \\\"dark moon\\\" or \\\"black moon\\\", a fictitious invisible second moon of Earth proposed by astrologers in the early 20th century. Now often interpreted as the position of the apogee of the actual Moon, or as the empty focus of the Moon's elliptical orbit (Earth occupying the other focus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89c0e629-03f5-31c5-8685-96038f8d62b2",
                                        "entry_id": "1afd5de4-5baf-3941-9f4d-0dcf6fe38689",
                                        "glosses": [
                                            "A female given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
