                "senses": [
                    {
                        "sense_id": "73e535f3-7ab3-3d61-8285-215ff162bf78",
                        "entry_id": "63798b9e-30ab-30ce-94d6-33a1db68768a",
                        "glosses": [
                            "het inwinnen van informatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d736b2-69cf-48ed-befe-3f1620d59623",
                                "sense_id": "73e535f3-7ab3-3d61-8285-215ff162bf78",
                                "text": "Bij navorsing bleek dat Lustig op de site van Elite Bouw & Advies onterecht het Politie Keurmerk Veilig Wonen voerde. Ook schreef hij ‘tevens gespecialiseerd te zijn in financieringen en hypotheken’ maar kon dat niet hard maken met een vergunning van de Autoriteit Financiële Markten. Na publicatie verdween deze zinsnede van de site."
                            },
                            {
                                "example_id": "5c0a9dcf-ef48-4728-b7c8-95bac6d5a8c5",
                                "sense_id": "73e535f3-7ab3-3d61-8285-215ff162bf78",
                                "text": "Ook stellen die vrijdag een avondje uitgaan, merken dit in hun portemonnee. Kaartjes voor bioscoop, theater en concert werden het afgelopen jaar een stuk duurder, blijkt uit navorsing van ING. De entreeprijzen stegen gemiddeld 4,9 procent. Voor een etentje buiten de deur moet tegenwoordig door de bank genomen 1,2 procent meer worden neergeteld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "726acfa4-910a-41b5-ac5d-474e71ed55bb",
                        "source_entry_id": "63798b9e-30ab-30ce-94d6-33a1db68768a",
                        "source_sense_id": "73e535f3-7ab3-3d61-8285-215ff162bf78",
                        "source_sense_description": "het inwinnen van informatie",
                        "target_lang_word": "check up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "check up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94287b6f-f5d0-32f9-a0ad-eb215311a65f",
                                        "entry_id": "7da6dc76-5ecf-3731-8a91-28de31103a21",
                                        "glosses": [
                                            "To verify through brief investigation or revisit for assurance that there are no problems."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f78119f-8b9b-4ffa-9205-008b9b883a8a",
                                                "sense_id": "94287b6f-f5d0-32f9-a0ad-eb215311a65f",
                                                "text": "I dropped by to check up on my friend."
                                            },
                                            {
                                                "example_id": "f3805a60-ba39-4d5a-8894-962bb555ea78",
                                                "sense_id": "94287b6f-f5d0-32f9-a0ad-eb215311a65f",
                                                "text": "Before when he just gave her money and checked up on her his visits where few and far between unless she called and asked for something, which she didn't like doing too much."
                                            },
                                            {
                                                "example_id": "f5c98ec1-6167-4776-a818-b08666427c01",
                                                "sense_id": "94287b6f-f5d0-32f9-a0ad-eb215311a65f",
                                                "text": "So instead she checked up on them and discovered that they were very respectable, which made her much happier."
                                            },
                                            {
                                                "example_id": "1264c301-7038-4bba-a58e-2cf0692a351a",
                                                "sense_id": "94287b6f-f5d0-32f9-a0ad-eb215311a65f",
                                                "text": "Every three months, I checked up with Dr. Ma and took a blood sample test to check on my diabetic HGBA1c, glucose fasting data range, and my lipid data for my blood test results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0c3829c-15b9-3cb9-b199-63776b45a3b7",
                                        "entry_id": "7da6dc76-5ecf-3731-8a91-28de31103a21",
                                        "glosses": [
                                            "To verify something's accuracy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca018f8b-f751-4e91-a1f6-d235c084899a",
                                                "sense_id": "f0c3829c-15b9-3cb9-b199-63776b45a3b7",
                                                "text": "He's checking up the figures."
                                            },
                                            {
                                                "example_id": "cf0b8598-03b1-4724-b23f-80d06e4414c0",
                                                "sense_id": "f0c3829c-15b9-3cb9-b199-63776b45a3b7",
                                                "text": "The impression of her familiarity was misty and dreamlike. He might have dreamed he thought of such a girl as she. But no! His sober, cool-headed sense checked him up sharply."
                                            },
                                            {
                                                "example_id": "0614ea8a-7440-4f78-8969-d8edb35946b0",
                                                "sense_id": "f0c3829c-15b9-3cb9-b199-63776b45a3b7",
                                                "text": "I hated myself, but I called up the almanac, and for the very first time ever, I checked up on something Perry had told me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ff771e9-11a8-3043-b271-ca7f00811313",
                                        "entry_id": "7da6dc76-5ecf-3731-8a91-28de31103a21",
                                        "glosses": [
                                            "To seem correct or plausible; to comport with known facts; to check out (with other facts)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e465a976-bf88-48ac-8fd3-d2e0565b4a4e",
                                                "sense_id": "0ff771e9-11a8-3043-b271-ca7f00811313",
                                                "text": "The numbers she provided check up with my own data."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4711821-bd0b-4324-83b1-66b3632f2cc2",
                        "source_entry_id": "63798b9e-30ab-30ce-94d6-33a1db68768a",
