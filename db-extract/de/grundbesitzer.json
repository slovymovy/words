                            {
                                "example_id": "82542d22-5b18-45cc-b941-948c3c278d37",
                                "sense_id": "7469d078-0e83-38a0-adab-fb8d8f45d4c0",
                                "text": "„Als sein Vater 1811 starb, war der Sechsundzwanzigjährige über Nacht Herr von Branitz und Muskau und damit einer der reichsten Grundbesitzer der Lausitz.“"
                            },
                            {
                                "example_id": "d09b0730-c1e5-42e4-9d3f-c69f60095590",
                                "sense_id": "7469d078-0e83-38a0-adab-fb8d8f45d4c0",
                                "text": "„Geboren wurde Jefferson am 13. April 1743 als Sohn eines wohlhabenden Grundbesitzers in Shadwell bei Charlottesville.“"
                            }
                        ],
