                                                "sense_id": "01ece702-9311-3fd8-8763-cac20834175a",
                                                "text": "In unserem Vorzimmer steht ein Schrank aus Kiefernholz."
                                            },
                                            {
                                                "example_id": "12aeff80-098d-485e-beb0-22df1a9a3b6d",
                                                "sense_id": "01ece702-9311-3fd8-8763-cac20834175a",
                                                "text": "„Der Seemann entschied sich für Kiefernholz als Baumaterial.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
