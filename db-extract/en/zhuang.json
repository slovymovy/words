                                        "entry_id": "1297b1c5-812b-391d-9076-fdd9e816e4ae",
                                        "glosses": [
                                            "Langue parlée principalement par les Zhuang, qui appartient au sous-groupe tai de la famille des langues taï-kadaï."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81e27a66-4c20-4e87-b057-c6308c7db07f",
                                                "sense_id": "a28ff92c-d169-3ceb-8a9a-38319ad001e5",
                                                "text": "Le zhuang recule rapidement au profit du chinois, avec l’assimilation des Zhuang par les Han."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "385033a2-5723-4a99-9eb2-7dfed824d56a",
                        "source_entry_id": "35f0df03-fcfb-380a-b934-dacd397ec4ec",
                        "source_sense_id": "708fc933-da6a-3bd2-a7ff-332cd81ed470",
                        "source_sense_description": "language",
                        "target_lang_word": "Zhuang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zhuang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7864aa5b-0377-3107-98c4-ccc526839f89",
                                        "entry_id": "aae81de2-9ac1-3092-a593-cf48e101364a",
                                        "glosses": [
                                            "Sprache, die vom gleichnamigen chinesischen Volk gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b233d966-7bf6-4ff9-b1a9-318b07ecd10f",
                                                "sense_id": "7864aa5b-0377-3107-98c4-ccc526839f89",
                                                "text": "„Zhuang wurde über tausend Jahre lang mit chinesischen Schriftzeichen geschrieben.“"
                                            },
                                            {
                                                "example_id": "3567dbd3-8a11-4035-9d80-b984454aa25d",
                                                "sense_id": "7864aa5b-0377-3107-98c4-ccc526839f89",
                                                "text": "„In den Straßen hört man Zhuang oder Vietnamesisch, und diese Sprachen teilen sich auch den Platz auf den Straßenschildern mit den chinesischen Schriftzeichen.“"
                                            },
                                            {
                                                "example_id": "09a7ed84-6df1-4afd-af76-e85d5043dadb",
                                                "sense_id": "7864aa5b-0377-3107-98c4-ccc526839f89",
                                                "text": "„Ihre Sprache [Anmerkung: die Sprache der Bouyei] gehört zum Zweig des Zhuang-Dong der sino-tibetischen Sprachfamilie und ist dem Zhuang sehr ähnlich.“"
                                            },
                                            {
                                                "example_id": "a622016d-67a8-4d84-8d60-0ac458af3b56",
                                                "sense_id": "7864aa5b-0377-3107-98c4-ccc526839f89",
                                                "text": "„Alle Thai-Dialekte gehören zum Thai-Zweig, der Thai-Kadai-Sprachfamilie. Als solche sind sie eng verwandt mit den Sprachen in Laos (Lao, Nord-Thai, Thai-Lü), im nördlichen Myanmar (Shan, Nord-Thai), im nordwestlichen Vietnam (Nung, Tho), in Assam (Ahom) und in Enklaven im südlichen China (Zhuang, Thai Lü).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
