                        "sense_id": "c910e27c-1846-390d-8185-aa04bb61b670",
                        "entry_id": "1291e456-e132-3dd3-981c-6197ef0b8c9a",
                        "glosses": [
                            "The downgrading or dissolution of something that had been established.",
                            "Specifically, the removal of state privileges or patronage from a given church; the removal of a policy of having an official governing religion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "23877cee-7573-4558-a665-71c5497ad74c",
                                "sense_id": "c910e27c-1846-390d-8185-aa04bb61b670",
                                "text": "Disestablishment of the church would deprive the gentry of another property right – the right of presentation to a living, a right for which they or their ancestors had paid hard cash and which gave them useful opportunities of providing for a younger son or a poor relation."
                            },
                            {
                                "example_id": "a3ba0393-98e9-4cfb-a63d-d601e1735dc4",
                                "sense_id": "c910e27c-1846-390d-8185-aa04bb61b670",
                                "text": "As evangelicals defect in one direction and traditionalists in the other, and disestablishment beckons with the reform of the House of Lords […]."
                            }
                        ]
                    }
                ],
