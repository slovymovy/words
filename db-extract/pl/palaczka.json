                                        "glosses": [
                                            "weibliche Person, die regelmäßig Tabak raucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75704b88-9d7d-48bd-b639-226e46d97c9a",
                                                "sense_id": "6d6cc33a-bbc2-3a06-a7ff-d0bee528fc2c",
                                                "text": "Eine der beiden Raucherinnen neben ihm nahm noch einen tiefen Zug aus ihrer Zigarette und drückte sie dann im Aschenbecher aus."
                                            },
                                            {
                                                "example_id": "7071bf34-5eba-4f41-8b27-ab5bbaaf9b7f",
                                                "sense_id": "6d6cc33a-bbc2-3a06-a7ff-d0bee528fc2c",
                                                "text": "Sieglinde ist schon lange starke Raucherin."
                                            },
                                            {
                                                "example_id": "4da2507c-df1e-4231-b5f4-d7380c0f69d5",
                                                "sense_id": "6d6cc33a-bbc2-3a06-a7ff-d0bee528fc2c",
                                                "text": "„Kinder von Raucherinnen wiegen bei der Geburt im Durchschnitt 200 bis 300 Gramm weniger als die Kinder von Nichtraucherinnen, wobei diese Werte auch von der Zahl der gerauchten Zigaretten abhängen.“"
                                            }
                                        ],
