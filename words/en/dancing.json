                            }
                        },
                        {
                            "text": "Many old-fashioned <w>dancings</w> have closed down in recent years.",
                            "target_lang_translations": {
                                "ru": "Многие старомодные <w>дансинги</w> закрылись в последние годы.",
                                "zh": "近年来许多老式的<w>舞厅</w>都已经关闭了。"
                            }
