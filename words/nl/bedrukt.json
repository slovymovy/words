                {
                    "sense_id": "c0ac6d53-dae1-3274-91f8-f0ca2104ffbe",
                    "sense_definition": "voorzien van een tekst, afbeelding of patroon door middel van een druktechniek",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "printing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>bedrukte</w> vellen papier lagen op de tafel te drogen na het printen.",
                            "target_lang_translations": {
                                "en": "The <w>printed</w> sheets of paper were lying on the table to dry after printing.",
                                "ru": "<w>Напечатанные</w> листы бумаги лежали на столе, подсыхая после печати."
                            }
                        },
                        {
                            "text": "Zij draagt vandaag een <w>bedrukt</w> T-shirt met een vrolijke afbeelding.",
                            "target_lang_translations": {
                                "en": "She is wearing a <w>printed</w> T-shirt with a cheerful image today.",
                                "ru": "На ней сегодня футболка <w>с принтом</w> в виде веселой картинки."
                            }
                        }
                    ],
                    "synonyms": [
                        "geprint"
                    ],
                    "antonyms": [
                        "onbedrukt"
                    ],
                    "common_phrases": [
                        "bedrukt papier",
                        "bedrukt textiel",
                        "bedrukt T-shirt"
                    ],
                    "target_lang_definitions": {
                        "en": "provided with text, an image, or a pattern using a printing technique",
                        "ru": "снабженный текстом, изображением или узором с помощью техники печати"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "printed",
                                "target_lang_sense_clarification": "general term for text or images on a surface"
                            },
