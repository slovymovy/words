                "senses": [
                    {
                        "sense_id": "4bc33b89-6688-3ed0-bb24-2e2c8454116b",
                        "entry_id": "9a6f4ffa-afec-37ec-b2b9-713296070a93",
                        "glosses": [
                            "A strong, cold wind that blows down the valley of the Sarma river (which acts as a natural wind tunnel), reaching hurricane strength (uprooting trees) by the time it blows across the western shore and into Lake Baikal."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f0ab85af-be5c-422e-833e-5e882b51b0c3",
                                "sense_id": "4bc33b89-6688-3ed0-bb24-2e2c8454116b",
                                "text": "“You see how the wind has pressed it into a hard layer?” “The sarma did it!” one of the children told Alex. “The sarma wind is mighty. It's so strong it turns ships upside down.” “Ah, that's something I didn't know. Well, we can thank the sarma for making excellent material for us.\" \"The mountain hides our homes from the sarma,\" said another."
                            }
                        ]
                    }
