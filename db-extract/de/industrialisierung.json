                ],
                "senses": [
                    {
                        "sense_id": "040a7d93-d09a-33f1-8c46-bddb216b3cfc",
                        "entry_id": "139130a6-e995-31f1-8a45-f9516b27a388",
                        "glosses": [
                            "Einführung und Verbreitung industrieller Formen der Warenproduktion, Erhöhung des Anteils der Industrie in einer Volkswirtschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f85c378-10e7-4488-ab86-476e0e94a2e3",
                                "sense_id": "040a7d93-d09a-33f1-8c46-bddb216b3cfc",
                                "text": "Der Bau der Eisenbahn war eine Voraussetzung für die flächenhafte Industrialisierung."
                            },
                            {
                                "example_id": "41aa6f5b-c600-4c65-bcda-c34d52aa5fa9",
                                "sense_id": "040a7d93-d09a-33f1-8c46-bddb216b3cfc",
                                "text": "„Eine Wechselwirkung liegt zwischen Industrialisierung und Entfaltung von Bädern und Sommerfrischen.“"
                            },
                            {
                                "example_id": "66194391-604c-456c-a56c-2df2df4a2717",
                                "sense_id": "040a7d93-d09a-33f1-8c46-bddb216b3cfc",
                                "text": "„Gleichzeitig nimmt durch die Industrialisierung der technologische Vorsprung der Europäer gegenüber den Afrikanern gewaltig zu: So transportieren mit Kohle befeuerte Dampfschiffe riesige Gütermengen um die Welt.“"
                            },
                            {
                                "example_id": "06f23e35-0041-4bf7-b6bc-d4a889305613",
                                "sense_id": "040a7d93-d09a-33f1-8c46-bddb216b3cfc",
                                "text": "„Aber Dahlerup und seine Beamten wussten, dass im Zuge der Industrialisierung auf dem europäischen Kontinent Kohle gebraucht werden würde.“"
                            },
                            {
                                "example_id": "593eb791-5d89-426e-88d2-63d35d4b200d",
                                "sense_id": "040a7d93-d09a-33f1-8c46-bddb216b3cfc",
                                "text": "„Binnen weniger Jahrzehnte holte das Kaiserreich die Industrialisierung nach, die bis dahin im Vergleich zu anderen Staaten eher schleppend angelaufen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26370c53-35fc-48d1-8327-d0f7d22535b9",
                        "source_entry_id": "139130a6-e995-31f1-8a45-f9516b27a388",
                        "source_sense_id": "040a7d93-d09a-33f1-8c46-bddb216b3cfc",
                        "target_lang_word": "industrialisation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "industrialisation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1b3332e-4429-3fa6-9d85-ae50db1a4830",
                                        "entry_id": "aeb98bc7-3d67-3347-a800-dfacc14ecd22",
                                        "glosses": [
                                            "Non-Oxford British English standard spelling of industrialization."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f21f557c-6ca8-4081-9af8-a2bfb8dea570",
                                                "sense_id": "f1b3332e-4429-3fa6-9d85-ae50db1a4830",
                                                "text": "The great industrialisations of the Midlands, north and Scotland that gave birth to large-scale organised Labour passed most of southern England by."
                                            },
                                            {
                                                "example_id": "4e5c0114-0e01-43d5-8f56-7df479ad8d5b",
                                                "sense_id": "f1b3332e-4429-3fa6-9d85-ae50db1a4830",
                                                "text": "It gave me more of a Cormac McCarthy vibe than a Westworld one, hinting at the death of the old west, the consequences of America’s rapid industrialisation and the death of a way of life, rather than a straightforward romanticisation of the frontier and its outlaw heroes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8699b1e2-5677-4a09-ba46-5a527e084439",
                        "source_entry_id": "139130a6-e995-31f1-8a45-f9516b27a388",
                        "source_sense_id": "040a7d93-d09a-33f1-8c46-bddb216b3cfc",
                        "target_lang_word": "industrialisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "industrialisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52b3aed2-562f-37de-ac44-530bec2ea21a",
                                        "entry_id": "059d27c3-7213-3c27-8251-4b356193ffcb",
                                        "glosses": [
                                            "Processus d’extension et d’intensification des activités industrielles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f873ddb-7f1c-467e-8f7a-2c4d5ff3ac9d",
                                                "sense_id": "52b3aed2-562f-37de-ac44-530bec2ea21a",
                                                "text": "Partout le rail assied la victoire de l’industrialisation, relance toutes les activités de pointe, ancre le capitalisme."
                                            },
                                            {
                                                "example_id": "fb570633-a5b4-4c98-9efc-9bd7fc5c9a40",
                                                "sense_id": "52b3aed2-562f-37de-ac44-530bec2ea21a",
                                                "text": "Les deux vagues d’industrialisation de Mulhouse provoquent l’hyper-densification de la ville historique."
                                            },
                                            {
                                                "example_id": "c07e09e7-e593-4d19-a4ed-c2a590dee9ff",
                                                "sense_id": "52b3aed2-562f-37de-ac44-530bec2ea21a",
                                                "text": "On peut sans doute soutenir aujourd’hui que les dénominateurs de l’industrialisation, de la technologie et autres variables analogues ont la force de l’universalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb12fce-5e4d-3431-ae0a-5f32e8fcd511",
                                        "entry_id": "059d27c3-7213-3c27-8251-4b356193ffcb",
                                        "glosses": [
                                            "Période historique correspondante, caractérisée par le fait que la production industrielle dépasse la production agricole en volume et marquée par des changements sociaux et culturels plus ou moins profonds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "336ee8e1-6915-4502-8f28-98d7296c9a39",
                                                "sense_id": "adb12fce-5e4d-3431-ae0a-5f32e8fcd511",
                                                "text": "Le militant faisait connaissance avec le prolétariat ardennais de la première industrialisation, prompt et quelque peu libertaire, qui put le gêner dans la discussion […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e7aa4f8-a450-3daf-b13a-806ee0221f30",
                                        "entry_id": "059d27c3-7213-3c27-8251-4b356193ffcb",
                                        "glosses": [
                                            "Action de rendre industriel un procédé ou une technique, c’est-à-dire se mettre en mesure de reproduire le bien ou le service à grande échelle, à faible coût et avec un taux réduit de défauts ou d’échecs."
                                        ],
