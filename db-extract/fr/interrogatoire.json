        "fr-extract.jsonl": [
            {
                "entry_id": "2404432f-d228-30aa-8581-3244d256f762",
                "word": "interrogatoire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bac34295-a60a-4d35-b7df-c516a07ed743",
                        "entry_id": "2404432f-d228-30aa-8581-3244d256f762",
                        "tags": [
                            "plural"
                        ],
                        "form": "interrogatoires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25435cb2-8737-3447-bf8d-2a364d179600",
                        "entry_id": "2404432f-d228-30aa-8581-3244d256f762",
                        "glosses": [
                            "Suite des questions que fait un juge sur des faits civils ou criminels, et des réponses que fait celui qui est interrogé."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "6f7fa91b-26d8-42c8-8153-ad576def5e92",
                                "sense_id": "25435cb2-8737-3447-bf8d-2a364d179600",
                                "text": "Sire, ils résultent d’un interrogatoire que j’ai fait subir à un homme de Marseille"
                            },
                            {
                                "example_id": "d5105f8c-5403-48d1-a908-a38cd828b57e",
                                "sense_id": "25435cb2-8737-3447-bf8d-2a364d179600",
                                "text": "Les interrogatoires vont bon train. […]. Les arguments frappants sont de rigueur. Ils veulent les noms des meneurs, le reste ne les intéresse pas. J'apprends par ceux qui ont été interrogés que ce n'est pas de la tarte.\n— Les plus visés sont ceux de la deuxième cour, m'avertit Pénoche. Avant même de t'interroger, ils commencent par te filer une douille, histoire de te mettre dans l'ambiance."
                            },
                            {
                                "example_id": "3cf1b588-862c-47a8-8ced-7535bfb2471a",
                                "sense_id": "25435cb2-8737-3447-bf8d-2a364d179600",
                                "text": "Cédric Hapère claqua violemment la porte de la salle d’interrogatoire et se dirigea vers la machine à café en pestant : cette vieille pie les faisait tourner en bourrique !"
                            }
                        ]
                    },
                    {
                        "sense_id": "854525aa-ba2e-3676-9caa-c3e10f911a26",
                        "entry_id": "2404432f-d228-30aa-8581-3244d256f762",
                        "glosses": [
                            "Série de questions."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7d426d18-6158-4566-83e7-37a11e99d482",
                                "sense_id": "854525aa-ba2e-3676-9caa-c3e10f911a26",
                                "text": "J’ai fait subir à l’enfant un interrogatoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "56094fbb-f36c-3a08-88cd-d31ebc62b135",
                        "entry_id": "2404432f-d228-30aa-8581-3244d256f762",
                        "glosses": [
                            "Procès-verbal qui contient les interrogations du juge et les réponses de l’accusé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0622272-79e0-45b7-99ec-f2a951ea930a",
                                "sense_id": "56094fbb-f36c-3a08-88cd-d31ebc62b135",
                                "text": "Elle prit son temps, elle calcula ses mouvements, et, avec une agilité de chatte, elle saisit les deux interrogatoires et les lança dans le feu ; mais Camusot les y reprit, la comtesse s’élança sur le juge et ressaisit les papiers enflammés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4efceb08-bdae-439c-a1f6-2a66af1db724",
