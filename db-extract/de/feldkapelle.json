                "senses": [
                    {
                        "sense_id": "bd77f6d5-a7c3-3982-b145-22d4b48f034a",
                        "entry_id": "e32bc1f4-5e16-3e6a-ad0d-c7bd52dc2a9b",
                        "glosses": [
                            "kleine Kapelle für die Andacht der Bauern, Mägde und Knechte im Feld, oder Reisenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0f3d9cf-a91d-493f-ba77-49992ce1fcc1",
                                "sense_id": "bd77f6d5-a7c3-3982-b145-22d4b48f034a",
                                "text": "„Feldkapellen sind einräumige Kleinbauten.“"
                            },
                            {
                                "example_id": "0d802e3e-8fae-4bff-b07b-40ed0d8fd3f7",
                                "sense_id": "bd77f6d5-a7c3-3982-b145-22d4b48f034a",
                                "text": "„Im Jahr 1739 entstand – heute am Weg von Schwabmünchen nach Untermeitingen – die Feldkapelle oder „Kapelle zur Schmerzhaften Muttergottes“ unter dem Baumeister Franz Kleinhans.“"
                            },
                            {
                                "example_id": "6f90efbc-b188-4e6b-8bbd-bebcf35a40f3",
                                "sense_id": "bd77f6d5-a7c3-3982-b145-22d4b48f034a",
                                "text": "„Ein Unternehmer hat die moderne »Feldkapelle« der Öffentlichkeit geschenkt.“"
                            },
                            {
                                "example_id": "b06775f6-a736-43c0-9bef-96971e09ad34",
                                "sense_id": "bd77f6d5-a7c3-3982-b145-22d4b48f034a",
                                "text": "„In einem dieser Täler - dem Tennelbachtal - liegt der Ort an dem die Feldkapelle errichtet ist.“"
                            },
                            {
                                "example_id": "3b8e14f8-3b42-4a6d-8118-20c346966351",
                                "sense_id": "bd77f6d5-a7c3-3982-b145-22d4b48f034a",
                                "text": "„Die dem heiligen Nikolaus von Flüe - genannt Bruder Klaus - gewidmete Feldkapelle ist eine privat gestiftete und erbaute Kapelle, ein Ort der Stille, der Meditation und des Gebetes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
