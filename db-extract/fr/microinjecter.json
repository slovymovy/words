                        "glosses": [
                            "Introduire de petites quantités d’un matériel généralement liquide dans un tissu biologique défini ou dans une cellule au moyen d’une aiguille fine et microscopique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1014bae4-0934-4023-80c1-4f1af30629ad",
                                "sense_id": "8036ac8b-fa2d-3eea-9ace-6b5c55f91c5b",
                                "text": "Une variante de la technique consiste à microinjecter le noyau du spermatozoïde directement dans l’ovocyte de hamster afin de vérifier si la décondensation a lieu directement après les traitements de séparation."
                            },
                            {
                                "example_id": "4be4df45-e971-434e-af89-86e065abe1c6",
                                "sense_id": "8036ac8b-fa2d-3eea-9ace-6b5c55f91c5b",
                                "text": "Elle consiste à microinjecter des ARN synthétiques dans le cytoplasme de l’œuf fécondé."
                            },
                            {
                                "example_id": "1ce3ffda-a7d2-4934-9859-9466f0bca147",
                                "sense_id": "8036ac8b-fa2d-3eea-9ace-6b5c55f91c5b",
                                "text": "Elle consiste à microinjecter dans le blastomère une substance de poids moléculaire important qui ne peut pas traverser la membrane plasmique et qui reste donc dans la cellule."
                            }
                        ]
