                "senses": [
                    {
                        "sense_id": "4a5090d1-6aa6-3ef7-b2d7-5d6a360cf6d8",
                        "entry_id": "7b446bb5-d0c4-3293-8e8a-f769c7877c5c",
                        "glosses": [
                            "Rückerstattung eines bereits gezahlten Betrages in Form eines Anrechtes auf etwas (in Form eines Gutscheins) statt in Geld (besonders bei nicht stattgefundenen Pauschalreisen während der Coronapandemie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6866d4db-d046-4354-925b-95d4f405df51",
                                "sense_id": "4a5090d1-6aa6-3ef7-b2d7-5d6a360cf6d8",
                                "text": "„Die Bundesregierung kommt mit der freiwilligen Gutscheinlösung den Vorgaben der EU-Pauschalreiserichtlinie sowie Empfehlungen der EU-Kommission nach. Veranstalter sollen in der aktuellen Krisensituation vor dem Existenzverlust bewahrt werden.“"
                            },
                            {
                                "example_id": "af5064d8-0fa2-481e-8a97-8ce622922619",
                                "sense_id": "4a5090d1-6aa6-3ef7-b2d7-5d6a360cf6d8",
                                "text": "„Die beschlossene Gutscheinlösung gilt auch für Fitnessstudios. Das heißt, Kunden müssen für die Beiträge, die sie während des Lockdowns bezahlt haben, einen Gutschein akzeptieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
