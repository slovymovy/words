                "senses": [
                    {
                        "sense_id": "dca3f7a9-b5c7-306e-b241-65cdb08e8b9a",
                        "entry_id": "23392b88-ab1a-3c21-af30-b596663510b6",
                        "glosses": [
                            "Ensorceler, jeter un sort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "632f9a89-15a3-43f9-8f5d-00961505fa19",
                                "sense_id": "dca3f7a9-b5c7-306e-b241-65cdb08e8b9a",
                                "text": "Elle a fait « empicasser » ces souvenirs pour que je ne les perde jamais."
                            },
                            {
                                "example_id": "a5e23536-98f5-4833-b0ce-e55f5d914ea0",
                                "sense_id": "dca3f7a9-b5c7-306e-b241-65cdb08e8b9a",
                                "text": "Cette femme, dont je ne saurais dire l’âge, m’a toujours fort impressionnée car elle est considérée, au village, comme une « birette », une sorcière, si on préfère, qui peut guérir ou tuer, « empicasser » ou « désempicasser »."
                            }
                        ]
                    }
