                                        "sense_id": "531bf1a7-bd28-3389-9395-dbd571164ec7",
                                        "entry_id": "2c9fc90b-3c73-3ee0-bb5e-d42dc265a21e",
                                        "glosses": [
                                            "sich in Unordnung befindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bab65c3-218e-4b60-bcd9-691b4fc2dc07",
                                                "sense_id": "531bf1a7-bd28-3389-9395-dbd571164ec7",
                                                "text": "Meine Münzsammlung ist noch ungeordnet."
                                            },
                                            {
                                                "example_id": "118dd0db-7441-492a-9574-4106952f2627",
                                                "sense_id": "531bf1a7-bd28-3389-9395-dbd571164ec7",
                                                "text": "Nach dem ersten Gegentor brach die Mannschaft zusammen, besonders die Abwehr war dann sehr ungeordnet und damit löchrig."
                                            },
                                            {
                                                "example_id": "12aa963a-b36f-4527-a03a-e69a8db4f776",
                                                "sense_id": "531bf1a7-bd28-3389-9395-dbd571164ec7",
                                                "text": "Bei einem Brainstorming schreibt man am Anfang seine Ideen ungeordnet auf."
                                            },
                                            {
                                                "example_id": "c4184c67-88c3-45d8-a872-9a124ac08df9",
                                                "sense_id": "531bf1a7-bd28-3389-9395-dbd571164ec7",
                                                "text": "Die Papierberge stapelten sich bei ihm ungeordnet auf dem Schreibtisch."
                                            },
                                            {
                                                "example_id": "7cd5758b-20ea-4461-8c97-2c945f7e7fab",
                                                "sense_id": "531bf1a7-bd28-3389-9395-dbd571164ec7",
                                                "text": "Stromrechnungen, ein Schreiben von der Krankenkasse, Kontoauszüge, ein Brief vom Vermieter – und alles liegt ungeordnet auf dem Schreibtisch. „Was ist das denn für eine Zettelwirtschaft?“, fragen ordentliche Menschen entsetzt."
                                            },
                                            {
                                                "example_id": "6ae6c785-cbfc-4733-ac35-ed89eb47bf7d",
                                                "sense_id": "531bf1a7-bd28-3389-9395-dbd571164ec7",
                                                "text": "„Mobbing“ ist ein Wort, das es in der englischen Sprache nur in einer einzigen Bedeutung gibt: etwas oder jemanden in einer ungeordneten Gruppe umringen – wie Bildreporter einen Filmstar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a784c43-e24f-48ed-92b6-381951bab1fd",
                        "source_entry_id": "c5b33e2d-5077-3ca3-8edc-8144e8fce7a6",
                        "source_sense_id": "c5ac85d5-e917-3ef7-8605-314694123023",
                        "source_sense_description": "ohne Ordnung; ungeordnet, chaotisch, wirr, unordentlich",
                        "target_lang_word": "chaotisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaotisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "277df156-5bc1-369c-989d-4e1bc86710c4",
                                        "entry_id": "d5be905a-83a9-3516-a537-4186067c284e",
                                        "glosses": [
                                            "ohne Ordnung, ungeordnet, wirr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de759d20-13aa-49a9-b731-a1fa21f8f71b",
                                                "sense_id": "277df156-5bc1-369c-989d-4e1bc86710c4",
                                                "text": "Sein Lebenslauf ist sehr chaotisch, er hat schon in fünf verschiedenen Branchen gearbeitet."
                                            },
                                            {
                                                "example_id": "c7778508-24f2-439d-8840-b94972cb1c45",
                                                "sense_id": "277df156-5bc1-369c-989d-4e1bc86710c4",
                                                "text": "„An diesem chaotischen Schreibtisch könnte ich nicht arbeiten.“"
                                            },
                                            {
                                                "example_id": "eaa3e85d-9901-4983-9d9e-9c5e2f409fb4",
                                                "sense_id": "277df156-5bc1-369c-989d-4e1bc86710c4",
                                                "text": "Seit dem Sturz Gaddafis ist die Lage in Libyen chaotisch."
                                            },
                                            {
                                                "example_id": "1fbf8b3d-b89c-439b-8cb8-70c24a02d990",
                                                "sense_id": "277df156-5bc1-369c-989d-4e1bc86710c4",
                                                "text": "Trotz allem: Die Wahlen seien keineswegs zu früh anberaumt worden, sagt Fatoumata Sy Gueye. „Hätte es die Wahlen nicht gegeben, dann hätte sich die Lage in Mali nur weiter verschlimmert, dann wäre es noch chaotischer.“"
                                            },
                                            {
                                                "example_id": "e54071c1-f0c7-40b8-a465-c4148022f351",
                                                "sense_id": "277df156-5bc1-369c-989d-4e1bc86710c4",
                                                "text": "Neapel – Die Stadt am Fuße des Vesuv, gebeutelt von Seuchen, Erdbeben und Vulkanausbrüchen ist für die einen die chaotischste, lärmendste und stinkendste Stadt der Welt, für die anderen die schönste, reichste und lebendigste – auf jeden Fall nie Mittelmaß."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a6ca56d-a65e-455b-ac69-fd3255cdb405",
                        "source_entry_id": "c5b33e2d-5077-3ca3-8edc-8144e8fce7a6",
                        "source_sense_id": "c5ac85d5-e917-3ef7-8605-314694123023",
                        "source_sense_description": "ohne Ordnung; ungeordnet, chaotisch, wirr, unordentlich",
                        "target_lang_word": "wirr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wirr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                        "entry_id": "f9e28542-6fdb-3901-99c1-5ef8fab34081",
                                        "glosses": [
                                            "von Verwirrtheit oder Verworrenheit geprägt; ohne (erkennbare) Ordnung; so, dass etwas durcheinander beziehungsweise nicht durchschaubar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3a6762b-bdb2-49c9-a3bd-eaad8336fdd1",
                                                "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                                "text": "„Im Anfang schuf Gott Himmel und Erde; die Erde aber war wüst und wirr, Finsternis lag über der Urflut und Gottes Geist schwebte über dem Wasser.“"
                                            },
                                            {
                                                "example_id": "db8174e0-c958-41fd-a80d-4e1574543016",
                                                "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                                "text": "Mir wird ganz wirr im Kopf."
                                            },
                                            {
                                                "example_id": "ffbfefbb-5ed3-4482-8f04-dad0c13408a4",
                                                "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                                "text": "Da er seit zwei Tagen nicht mehr geschlafen hatte, redete er nur noch wirres Zeug."
                                            },
                                            {
                                                "example_id": "761d2de4-a5cd-4948-9ab9-4cc4cd633c4c",
                                                "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                                "text": "Was ist denn das für eine wirre Geschichte? Die glaubt dir niemand."
                                            },
                                            {
                                                "example_id": "1b70d62e-7fa3-4b87-bcce-5c53450748ef",
                                                "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                                "text": "„Seine dunklen Haare hingen wirr in sein Gesicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "810fc314-6017-4637-ae05-39eef4390ae4",
                        "source_entry_id": "c5b33e2d-5077-3ca3-8edc-8144e8fce7a6",
