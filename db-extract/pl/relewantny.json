                                        "sense_id": "aa110eb9-a639-3461-afa8-671e9631d799",
                                        "entry_id": "5de326fa-642a-3515-9ccc-714b035391e8",
                                        "glosses": [
                                            "Related, connected, or pertinent to a topic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0164208e-8fb1-393f-84bb-f1bf8297664d",
                                        "entry_id": "5de326fa-642a-3515-9ccc-714b035391e8",
                                        "glosses": [
                                            "Related, connected, or pertinent to a topic.",
                                            "Directly related, connected, or pertinent, with important ramifications or implications."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02130a33-8d61-4252-8292-bf2870ae1f2d",
                                                "sense_id": "0164208e-8fb1-393f-84bb-f1bf8297664d",
                                                "text": "His mother provided some relevant background information concerning his medical condition."
                                            },
                                            {
                                                "example_id": "a4444f40-d0d5-4041-8b9d-dbbed0e8b91c",
                                                "sense_id": "0164208e-8fb1-393f-84bb-f1bf8297664d",
                                                "text": "Although autistic women with AN have cited concerns with weight/shape as less relevant in the development of their ED (Kinnaird, Norton, Stewart, et al., 2019), these could still have been a contributing factor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62a8374b-c235-35ef-9e7a-0733e5d8c530",
                                        "entry_id": "5de326fa-642a-3515-9ccc-714b035391e8",
                                        "glosses": [
                                            "Not out of date; current."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d20c2401-4876-4bc0-a804-ccd02c6cfd30",
                                                "sense_id": "62a8374b-c235-35ef-9e7a-0733e5d8c530",
                                                "text": "The message of Christmas is still relevant as we near the end of a troubled year and the beginning of an uncertain but challenging new year."
                                            },
                                            {
                                                "example_id": "18a1e39a-f3f7-4c9a-982e-a3fd60cc82b2",
                                                "sense_id": "62a8374b-c235-35ef-9e7a-0733e5d8c530",
                                                "text": "Motorola was quickly losing the cell-phone battle to Nokia for a time. When they launched the RAZR phone and combined it with their \"Hello Moto\" campaign, it made the brand relevant again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75d39808-14bc-34a4-b1ec-1d6cf622c4b6",
                                        "entry_id": "5de326fa-642a-3515-9ccc-714b035391e8",
                                        "glosses": [
                                            "Famous, popular, or noteworthy in a contemporary context."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d785fd3-61be-4cc8-a5ec-75fedc87c8bf",
                        "source_entry_id": "500b2661-be98-3fff-a860-e7c3aa31ad43",
                        "source_sense_id": "68efd37b-cd8b-3eb8-b332-fbb5886aaa59",
                        "target_lang_word": "relevant",
