                "senses": [
                    {
                        "sense_id": "3db5d301-c4b9-3d8d-bc71-d5ce6f8706aa",
                        "entry_id": "744b4d1d-9a9d-3381-a60e-c1f247183c8e",
                        "glosses": [
                            "Kosten, die für die Herstellung eines Produkts anfallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0bc15ad-ea16-4ef2-b049-2beb1b018a76",
                                "sense_id": "3db5d301-c4b9-3d8d-bc71-d5ce6f8706aa",
                                "text": "„In die tatsächlichen Herstellungskosten müssen auch Faktoren wie Fertigung, Verpackung, Entwicklung und Logistik einbezogen werden.“"
                            },
                            {
                                "example_id": "caa17c2b-d387-4eca-b23f-5fc17cef4725",
                                "sense_id": "3db5d301-c4b9-3d8d-bc71-d5ce6f8706aa",
                                "text": "„Zur Steigerung der Stückzahlen und zur Senkung der Herstellungskosten greift der japanische Autobauer zu einem Mittel, das für viele Konkurrenten ein Tabu darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
