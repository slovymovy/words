                "senses": [
                    {
                        "sense_id": "538753fa-0e5c-36e3-bdb3-1e2f5d49ffc7",
                        "entry_id": "b2693077-50a9-396b-a24f-6152cdbd739a",
                        "glosses": [
                            "meist mittelloser, stark verarmter Bauer/Landarbeiter"
                        ],
                        "tags": [
                            "Lateinamerika",
                            "Spanien"
                        ],
                        "examples": [
                            {
                                "example_id": "54537154-475c-42f6-bb1b-cd7ff6cd7b03",
                                "sense_id": "538753fa-0e5c-36e3-bdb3-1e2f5d49ffc7",
                                "text": "„Zwei Wochen zuvor hatten die Apatschen eine Gruppe von Campesinos mit deren eigenen Hacken erschlagen; Schweine machten sich bereits über die Landleute her, als die Indianer alles erreichbare Vieh zusammentrieben und dann wieder in den Hügeln verschwanden.“"
                            },
                            {
                                "example_id": "a1a0b1ef-fdeb-48a5-9047-1e19050ddeb1",
                                "sense_id": "538753fa-0e5c-36e3-bdb3-1e2f5d49ffc7",
                                "text": "„Michoacán liegt an der Pazifikküste. Hierher hatten die gomeros von Sinaloa ihr Rohopium transportiert, und sie hatten den Campesinos gezeigt, wie man den Schlafmohn anbaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
