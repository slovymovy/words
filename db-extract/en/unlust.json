                        ],
                        "examples": [
                            {
                                "example_id": "a83f6f8a-189e-4e45-9916-135345cdde54",
                                "sense_id": "83f98025-056f-3f11-a4d4-92e2bd4883ce",
                                "text": "We fynde in oure silves vnlust and tediousnes to do good."
                            },
                            {
                                "example_id": "8ebcc68e-c012-4ebe-8883-a5d05e6a878b",
                                "sense_id": "83f98025-056f-3f11-a4d4-92e2bd4883ce",
                                "text": "In all hys meates lette a litle saffron be put:..but it causeth vnluste in the stomacke."
                            },
                            {
                                "example_id": "3b337b64-b16d-4d3a-b540-202f1481fd27",
                                "sense_id": "83f98025-056f-3f11-a4d4-92e2bd4883ce",
                                "text": "Yf you once fawl to lasynes or unlust..than is the scarby redy to catch you by the bones."
                            }
                        ]
                    }
