{
    "word_family": [
        "leprosy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2063d2ae-1466-39de-864a-19a29783eefd",
                    "sense_definition": "A person who suffers from leprosy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient times, a <w>leper</w> was often forced to live outside the city walls.",
                            "target_lang_translations": {
                                "ru": "В древние времена <w>прокажённый</w> часто был вынужден жить за пределами городских стен."
                            }
                        },
                        {
                            "text": "Modern medicine has made it possible for a <w>leper</w> to be treated effectively.",
                            "target_lang_translations": {
                                "ru": "Современная медицина позволила эффективно лечить <w>больного проказой</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, страдающий проказой (лепрой)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокажённый",
                                "target_lang_sense_clarification": "больной лепрой (мужской род)"
                            },
                            {
                                "target_lang_word": "прокажённая",
                                "target_lang_sense_clarification": "больная лепрой (женский род)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d4e6777-890d-38c5-89f2-511f0136524c",
                    "sense_definition": "A person who is rejected or avoided by others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the scandal, he became a social <w>leper</w> in his own community.",
                            "target_lang_translations": {
                                "ru": "После скандала он стал настоящим <w>изгоем</w> среди своих."
                            }
                        },
                        {
                            "text": "The company treated the whistleblower like a <w>leper</w> for speaking the truth.",
                            "target_lang_translations": {
                                "ru": "В компании относились к разоблачителю как к <w>прокажённому</w> за то, что он сказал правду."
                            }
                        }
                    ],
                    "synonyms": [
                        "outcast"
                    ],
                    "common_phrases": [
                        "social leper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, отвергнутый обществом, которого все избегают."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изгой",
                                "target_lang_sense_clarification": "отверженный человек"
                            },
                            {
                                "target_lang_word": "прокажённый",
                                "target_lang_sense_clarification": "в переносном значении, тот, кого избегают"
                            },
                            {
                                "target_lang_word": "отверженный",
                                "target_lang_sense_clarification": "отвергнутый обществом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11412419-de8b-3e53-a421-5c37c7000e8e",
                    "sense_definition": "To cause someone to have leprosy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh conditions of the camp threatened to <w>leper</w> the prisoners.",
                            "target_lang_translations": {
                                "ru": "Суровые условия лагеря угрожали <w>поразить проказой</w> заключённых."
                            }
                        },
                        {
                            "text": "They feared that the disease would <w>leper</w> the entire village population.",
                            "target_lang_translations": {
                                "ru": "Они боялись, что болезнь <w>заразит проказой</w> всех жителей деревни."
                            }
                        }
                    ],
                    "synonyms": [
                        "infect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заражать или поражать проказой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заразить проказой",
                                "target_lang_sense_clarification": "передать лепру"
                            },
                            {
                                "target_lang_word": "поразить проказой",
                                "target_lang_sense_clarification": "вызвать заболевание лепрой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a83cf32-00c5-3ba2-b844-28838eed38e6",
                    "sense_definition": "To exclude someone from a group or society.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group decided to <w>leper</w> anyone who disagreed with their new rules.",
                            "target_lang_translations": {
                                "ru": "Группа решила <w>делать изгоем</w> всякого, кто был не согласен с их новыми правилами."
                            }
                        },
                        {
                            "text": "They chose to <w>leper</w> the member who broke their strict code of silence.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>подвергнуть остракизму</w> участника, нарушившего строгий кодекс молчания."
                            }
                        }
                    ],
                    "synonyms": [
                        "ostracize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключать человека из группы, подвергать остракизму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бойкотировать",
                                "target_lang_sense_clarification": "прекращать общение или изолировать"
                            },
                            {
                                "target_lang_word": "делать изгоем",
                                "target_lang_sense_clarification": "отвергать и изгонять из коллектива"
                            },
                            {
                                "target_lang_word": "подвергать остракизму",
                                "target_lang_sense_clarification": "выгонять из сообщества"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}