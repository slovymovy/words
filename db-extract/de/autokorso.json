                "senses": [
                    {
                        "sense_id": "aef39b52-1829-3b98-ba62-a317b8f52252",
                        "entry_id": "3fe6c0bb-8418-30ae-8f99-3989ce921983",
                        "glosses": [
                            "meist hupende Autokolonne anlässlich eines festlichen/feierlichen Ereignisses oder einer Demonstration"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e32cf22-277c-40bd-8d51-43c19bf6e6e6",
                                "sense_id": "aef39b52-1829-3b98-ba62-a317b8f52252",
                                "text": "„Viele hundert Autos, geschmückt mit weißen Bändern oder Luftballons, umkreisten am Sonntag die Moskauer Innenstadt. Der gewaltige Autokorso war eine Geste des Protestes gegen Premierminister Wladimir Putin.“"
                            },
                            {
                                "example_id": "411818aa-0325-4809-85a4-1a5eea305648",
                                "sense_id": "aef39b52-1829-3b98-ba62-a317b8f52252",
                                "text": "„Es gab mindestens vier Attentäter auf der Strecke des Autokorsos.“"
                            },
                            {
                                "example_id": "9c9277ad-82b1-4d03-9f36-cdef0a33b4b6",
                                "sense_id": "aef39b52-1829-3b98-ba62-a317b8f52252",
                                "text": "„Als sie am 18./19. Oktober 2007 in Karatschi frenetisch bejubelt wurde, kamen bei einer Bombenexplosion auf ihren Autokorso 139 Menschen ums Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
