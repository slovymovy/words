                ],
                "senses": [
                    {
                        "sense_id": "18c4f1cb-894e-390f-b2d9-502cd50d50fc",
                        "entry_id": "2c4a8d2f-3227-3d09-858e-0ab67af7200a",
                        "glosses": [
                            "Gesamtheit aller Zweige (einer Hecke, eines Baumes oder Ähnlichem)"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "2d9e12d9-f926-44b2-aa0a-8af57ecbb5ba",
                                "sense_id": "18c4f1cb-894e-390f-b2d9-502cd50d50fc",
                                "text": "„Im dichten, dunklen Gezweig brüten Vögel und bauen Spinnen ihre Netze.“"
                            },
                            {
                                "example_id": "22e601e5-f1c9-4fd0-b860-3ea95de5ade8",
                                "sense_id": "18c4f1cb-894e-390f-b2d9-502cd50d50fc",
                                "text": "„Das Laub raschelte, die Sonne spielte durch das Gezweig, und aus dem Walde her vernahm man den Specht und dann und wann auch den Kuckuck.“"
                            },
                            {
                                "example_id": "d6dcaa34-828a-4b58-b8d6-76aad94a9f94",
                                "sense_id": "18c4f1cb-894e-390f-b2d9-502cd50d50fc",
                                "text": "„Tagsüber hatte ein schwerer Sturm von Nordwesten her durchs Werratal geheult, das trockene Gezweig aus den Bäumen gerissen und den Märzstaub in langen Fahnen über die Landstraßen getrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
