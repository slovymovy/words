                "senses": [
                    {
                        "sense_id": "c21dcbb1-74a5-3a00-83ad-4dd00f740918",
                        "entry_id": "98f718a4-fbbe-3064-859e-f684c2eb8f03",
                        "glosses": [
                            "znajdujący się blisko Moskwy, na przedmieściach Moskwy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4c11f06-0d05-4e63-9c3f-b39cdf5bd0eb",
                                "sense_id": "c21dcbb1-74a5-3a00-83ad-4dd00f740918",
                                "text": "W podmoskiewskim miasteczku w sztuce ataku i przetrwania szkoli się nastolatków."
                            },
                            {
                                "example_id": "9b1fb95a-87ce-4c4f-ba5b-2fa94feb7804",
                                "sense_id": "c21dcbb1-74a5-3a00-83ad-4dd00f740918",
                                "text": "Skierowano nas do pracy przy wyrębie lasów podmoskiewskich."
                            },
                            {
                                "example_id": "92913299-3550-4ea1-8676-282aa8760008",
                                "sense_id": "c21dcbb1-74a5-3a00-83ad-4dd00f740918",
                                "text": "Krwawa wojna o podmoskiewski las."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
