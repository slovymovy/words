                    {
                        "form_id": "3b39668b-ad67-4430-8505-704cb2b993e5",
                        "entry_id": "0fb9f4a7-2119-3cd1-9684-f91e90bd7af3",
                        "tags": [
                            "plural"
                        ],
                        "form": "uts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9605e6e-76b5-3705-aa43-9484780b27f4",
                        "entry_id": "0fb9f4a7-2119-3cd1-9684-f91e90bd7af3",
                        "glosses": [
                            "Syllable (formerly) used in solfège to represent the first note of a major scale."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d64a61ab-0d8a-4643-b83b-c1f1cf12aad9",
                                "sense_id": "c9605e6e-76b5-3705-aa43-9484780b27f4",
                                "text": "Old Mantuam, old Mantuan. Who vnderſtandeth thee not, vt re ſol la mi fa: Vnder pardon sir, What are the contents? […]"
                            },
                            {
                                "example_id": "752f2444-b304-47c1-b801-01fc30984145",
                                "sense_id": "c9605e6e-76b5-3705-aa43-9484780b27f4",
                                "text": "The French added si for the seventh, and the Italians changed ut to do. Modern music-books name the whole thirteen notes of the semi-tone scale, and expect the pupil to learn them all."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "877c9d8a-cb0c-4867-9d9a-97d85ca693f1",
                        "source_entry_id": "0fb9f4a7-2119-3cd1-9684-f91e90bd7af3",
                        "source_sense_id": "c9605e6e-76b5-3705-aa43-9484780b27f4",
                        "source_sense_description": "first note of a major scale",
                        "target_lang_word": "ut",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
