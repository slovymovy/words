                        "glosses": [
                            "Personne qui porte une casquette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30849656-d0f2-45b5-8ef2-e101f981f7d0",
                                "sense_id": "0f2ef2d7-3ba5-3264-81bd-4da7ad89d740",
                                "text": "L’encasquetté ricane méchamment : — Qu’est-ce que tu veux ? On voulait de tes nouvelles."
                            },
                            {
                                "example_id": "be82f0de-a2c8-4123-a844-2ad65c123c6e",
                                "sense_id": "0f2ef2d7-3ba5-3264-81bd-4da7ad89d740",
                                "text": "Sur l’essentiel des images qu’il met en ligne, l’éternel encasquetté s’emploie à se défoncer la tête le plus violemment possible."
                            },
                            {
                                "example_id": "33a5b8ab-05a5-4b29-aee9-d7527cc4ee4e",
                                "sense_id": "0f2ef2d7-3ba5-3264-81bd-4da7ad89d740",
                                "text": "Immense post en effet, la thématique habituelle de l’encasquetté."
                            }
                        ]
                    }
