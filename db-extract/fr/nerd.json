                                    {
                                        "sense_id": "c262d457-e222-3d03-9eef-d979d3960eb4",
                                        "entry_id": "050de30e-49ff-3251-97fd-1d03de77ced2",
                                        "glosses": [
                                            "an Spezialinteressen hängend, typisch für einen Nerd"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6adfacc6-4127-47a4-bbf4-57691a3d8d15",
                                                "sense_id": "c262d457-e222-3d03-9eef-d979d3960eb4",
                                                "text": "„Wie sehr man sich doch täuschen konnte. Und das alles nur wegen einer jungen Frau mit blauen Augen, die die nerdigste Person war, der er jemals begegnet war.”"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0454a6f8-9425-4255-a773-16a8bf1a8b85",
                        "source_entry_id": "ccda6ad2-d12c-3d68-abc8-3ce3e6a00575",
                        "source_sense_id": "fa50672d-ac68-39e2-8556-72af20b09669",
                        "source_sense_description": "Relatif à un nerd",
                        "target_lang_word": "nerdy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nerdy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7809f28-185e-379b-9e0c-85eb8bb0a81e",
                                        "entry_id": "9e119c26-38e5-3075-b28f-351b6c4f0afd",
                                        "glosses": [
                                            "Being or like a nerd."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca9ab8c1-6411-4d65-905e-db9336ec67ef",
                                                "sense_id": "d7809f28-185e-379b-9e0c-85eb8bb0a81e",
                                                "text": "That guy is nerdy and weird."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de1ce128-79d8-3c68-8987-37a2220b1897",
                                        "entry_id": "9e119c26-38e5-3075-b28f-351b6c4f0afd",
                                        "glosses": [
                                            "Of, pertaining to, in the style of, or appealing to nerds."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a68d2db4-7e19-4e8a-9ebc-4ccbd6277e3f",
                                                "sense_id": "de1ce128-79d8-3c68-8987-37a2220b1897",
                                                "text": "That is a nerdy song."
                                            },
                                            {
                                                "example_id": "b3186288-9104-4bb3-9456-d10cf67e92e6",
                                                "sense_id": "de1ce128-79d8-3c68-8987-37a2220b1897",
                                                "text": "I got a pair of nerdy glasses and clothes for Halloween."
                                            },
                                            {
                                                "example_id": "ef71da8d-a62c-4caa-a1c9-cee6c0138ef1",
                                                "sense_id": "de1ce128-79d8-3c68-8987-37a2220b1897",
                                                "text": "The cleverest and most prolific inventors, such as Reiner Knizia (who lives in England) are nerdy superstars. Euro (also “German-style”) games must not be confused with “Ameritrash” games, which generally involve high drama and employ plastic pieces, though arguing over what the difference is seems to be gamers' second-favourite pastime."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "f10ff1cf-3a91-33a0-a263-38c6998d1cfc",
                "word": "nerd",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cce86ed4-9a2e-409e-8a4c-911e2e7784d8",
