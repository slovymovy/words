{
    "word_family": [
        "disburse",
        "disburser"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "469f4b6d-a0f8-3f0f-acb6-2daf1d9670af",
                    "sense_definition": "The act or process of paying out money, especially from a formal or public fund.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "paying_money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>disbursement</w> of funds will begin once all contracts are signed.",
                            "target_lang_translations": {
                                "nl": "De <w>uitbetaling</w> van de fondsen zal beginnen zodra alle contracten zijn ondertekend."
                            }
                        },
                        {
                            "text": "Delays in loan <w>disbursement</w> caused significant problems for the new business.",
                            "target_lang_translations": {
                                "nl": "Vertragingen in de <w>verstrekking</w> van de lening veroorzaakten aanzienlijke problemen voor het nieuwe bedrijf."
                            }
                        }
                    ],
                    "synonyms": [
                        "distribution",
                        "payout",
                        "expenditure"
                    ],
                    "antonyms": [
                        "collection",
                        "receipt"
                    ],
                    "common_phrases": [
                        "disbursement of funds",
                        "loan disbursement"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling of het proces van het uitbetalen van geld, met name uit een formeel of openbaar fonds."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitbetaling",
                                "target_lang_sense_clarification": "het betalen of uitkeren van gelden"
                            },
                            {
                                "target_lang_word": "uitkering",
                                "target_lang_sense_clarification": "proces van toewijzen en uitkeren van fondsen"
                            },
                            {
                                "target_lang_word": "verstrekking",
                                "target_lang_sense_clarification": "het beschikbaar stellen of uitreiken van gelden/leningen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "915fd990-19b8-33f2-b7cb-9e598414f905",
                    "sense_definition": "An amount of money paid out or spent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "paying_money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company recorded each <w>disbursement</w> carefully in the financial ledger.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf noteerde elke <w>uitgave</w> zorgvuldig in het financiële grootboek."
                            }
                        },
                        {
                            "text": "Her total <w>disbursements</w> for travel expenses exceeded the estimated budget.",
                            "target_lang_translations": {
                                "nl": "Haar totale <w>uitgaven</w> voor reiskosten overschreden het geschatte budget."
                            }
                        }
                    ],
                    "synonyms": [
                        "payment",
                        "outlay",
                        "expenditure"
                    ],
                    "antonyms": [
                        "income"
                    ],
                    "common_phrases": [
                        "cash disbursement"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een specifiek bedrag dat is uitbetaald of uitgegeven."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitgave",
                                "target_lang_sense_clarification": "betaald bedrag of onkosten"
                            },
                            {
                                "target_lang_word": "uitbetaling",
                                "target_lang_sense_clarification": "een specifiek uitgekeerd bedrag"
                            },
                            {
                                "target_lang_word": "verschot",
                                "target_lang_sense_clarification": "voorgeschoten onkosten, vaak juridisch of zakelijk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}