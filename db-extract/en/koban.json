                    {
                        "sense_id": "e89b2db6-b57f-3944-8d3c-818cd5a1e4eb",
                        "entry_id": "fb3a4789-4a83-367b-bd1a-575714a84c35",
                        "glosses": [
                            "An oval gold coin in the Edo period of feudal Japan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc8115aa-b41e-4b4e-b0e9-bc2d4b780334",
                                "sense_id": "e89b2db6-b57f-3944-8d3c-818cd5a1e4eb",
                                "text": "Every landlord hath two koban paid him for dinner, and three for supper and lodgings at night."
                            },
                            {
                                "example_id": "7b0ea34c-3044-4b61-859c-bb1766bc22ec",
                                "sense_id": "e89b2db6-b57f-3944-8d3c-818cd5a1e4eb",
                                "text": "“Shall we say two koban for this evening—a measure of my desire to please a Lady of such merit?”"
                            },
                            {
                                "example_id": "45743bc7-a7af-4995-a3b4-e4e2c993b465",
                                "sense_id": "e89b2db6-b57f-3944-8d3c-818cd5a1e4eb",
                                "text": "It contained, as usual, nothing but an invitation to come to Edo to confer on matters respecting which it did not enter into any particulars, with an offer of three koban for the expenses of the journey."
                            }
                        ]
                    }
                ],
