                                        "entry_id": "2eea584c-1e8e-3c16-8241-55cf5b04e480",
                                        "glosses": [
                                            "разг. тот, кому официально отказывают в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
