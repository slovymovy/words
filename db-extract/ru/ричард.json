                                    {
                                        "sense_id": "f0d4956d-1680-3c4d-86ff-e5b0b13fbf50",
                                        "entry_id": "0d6240bd-d895-3efc-bac8-0279df9eba8f",
                                        "glosses": [
                                            "imię męskie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65390f3c-c2b1-4b07-905a-7bd1735e9311",
                                                "sense_id": "f0d4956d-1680-3c4d-86ff-e5b0b13fbf50",
                                                "text": "Ryszard co roku był świętym mikołajem na szkolnej zabawie mikołajkowej."
                                            },
                                            {
                                                "example_id": "8efb7e6c-daf8-4b1f-a8b0-13e70b72bf2c",
                                                "sense_id": "f0d4956d-1680-3c4d-86ff-e5b0b13fbf50",
                                                "text": "Ryszardzie, ależ z ciebie ranny ptaszek, ale czy śniadanko przygotowałeś?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ryszard",
                                "target_lang_code": "pl",
