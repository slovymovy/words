            {
                "entry_id": "5c600a9b-cbc9-3075-b316-a08551617e62",
                "word": "imperator",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f6086881-9e79-4577-94a0-f322b90cc031",
                        "entry_id": "5c600a9b-cbc9-3075-b316-a08551617e62",
