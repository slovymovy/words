                            }
                        ]
                    }
                },
                {
                    "sense_id": "d15e77ef-a666-3d66-b993-1399953cc1cb",
                    "sense_definition": "The inflated ball used to play the game of volleyball.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a new <w>volleyball</w> for the tournament.",
                            "target_lang_translations": {
                                "ru": "Он купил новый <w>волейбольный мяч</w> для турнира.",
                                "zh": "他为这次锦标赛买了一个新的<w>排球</w>。"
                            }
                        },
                        {
                            "text": "Please throw the <w>volleyball</w> back to me so I can serve.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, брось <w>волейбольный мяч</w> мне обратно, чтобы я мог подать.",
