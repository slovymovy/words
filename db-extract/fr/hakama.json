                    {
                        "sense_id": "739a9d84-f683-37fc-9dd0-11e26b33fe68",
                        "entry_id": "184202c6-b5f0-3f46-a768-8f45b06b09a0",
                        "glosses": [
                            "Pantalon large plissé muni d'un dosseret rigide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aea71e3e-043b-4ddb-83d0-a92fd421dc16",
                                "sense_id": "739a9d84-f683-37fc-9dd0-11e26b33fe68",
                                "text": "Au milieu d’une joyeuse cohue, les marchands interpellent couples de retraités attendrissants et jeunes élégants en kimono et hakama (les tenues traditionnelles sont redevenues à la mode)."
                            },
                            {
                                "example_id": "b2a95fb7-9faf-47b2-9757-9ebc1630c6fe",
                                "sense_id": "739a9d84-f683-37fc-9dd0-11e26b33fe68",
                                "text": "En portant le hakama, le Mon toujours cousu au milieu du dos, l’élève doit entendre qu’il est entré dans la voie."
                            },
                            {
                                "example_id": "07318fe0-725d-45ba-96d8-be37c501ed48",
                                "sense_id": "739a9d84-f683-37fc-9dd0-11e26b33fe68",
                                "text": "Sur le chemin du retour, je croise un groupe de filles de mon âge. Toutes habillées d’un kimono et d’un hakama, elle se dirigent vers leur collège."
                            }
                        ]
                    }
                ],
