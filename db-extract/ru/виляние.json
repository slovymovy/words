                "translations": [
                    {
                        "translation_id": "9525c9fe-c9f4-4c6b-9745-da9f21d30a20",
                        "source_entry_id": "fda160d9-cd64-3f67-8106-b338ad4935fe",
                        "source_sense_description": "вихляние",
                        "target_lang_word": "frétillement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frétillement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd7a912-ea94-3181-9aaa-5bd4027e7263",
                                        "entry_id": "352cb900-c5ea-35fd-a5a1-5528306659aa",
                                        "glosses": [
                                            "Mouvement de ce qui frétille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1fb397a-829c-49c1-b342-a2549c45612d",
                                                "sense_id": "9bd7a912-ea94-3181-9aaa-5bd4027e7263",
                                                "text": "Camus […], se saisit de la corde au bout de laquelle Blanchette bêlante, la queue animée d’un perpétuel frétillement, attendait qu’on se mit en route."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec6f2943-ffa0-4faf-9649-313b81ffdbe2",
                        "source_entry_id": "fda160d9-cd64-3f67-8106-b338ad4935fe",
                        "source_sense_description": "уклонение от прямого ответа",
                        "target_lang_word": "tergiversation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tergiversation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d7853b5-bc43-363a-9611-770ee2406e99",
                                        "entry_id": "17f23cfe-fdc5-33fa-ac20-313d7b3d42b3",
                                        "glosses": [
                                            "Action de tergiverser, d'hésiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60686ccd-13a6-44a9-9c53-32aca06b6da8",
                                                "sense_id": "6d7853b5-bc43-363a-9611-770ee2406e99",
                                                "text": "Les Américains s’étaient rendu compte du prix que leur coûteraient leurs tergiversations, et ils voulurent frapper un grand coup, de toutes leurs forces, […]."
                                            },
                                            {
                                                "example_id": "99f516a1-1989-421a-81d0-c9c94b71337e",
                                                "sense_id": "6d7853b5-bc43-363a-9611-770ee2406e99",
                                                "text": "Lorsque nous devons prendre une décision face à une situation imprévue qui évolue très rapidement et n’autorise pas de tergiversations, notre comportement spontané est l’expression de notre état intérieur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0459a772-ddc8-449f-95f8-ff8cec17d8cd",
                        "source_entry_id": "fda160d9-cd64-3f67-8106-b338ad4935fe",
                        "source_sense_description": "уклонение от прямого ответа",
                        "target_lang_word": "louvoiement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "louvoiement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1cac514-a2c3-3f56-98be-83d1b9a48f44",
                                        "entry_id": "03862cbf-e24b-32f2-aa7f-22ae83bae69e",
                                        "glosses": [
                                            "Action de louvoyer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492a0b82-a6e4-4924-b9a9-27247a469ed4",
                                                "sense_id": "c1cac514-a2c3-3f56-98be-83d1b9a48f44",
                                                "text": "Malgré les louvoiements de M. Trump sur ses rapports avec la ­Russie, les expulsions de diplomates russes décidées lundi lèvent les ambiguïtés sur la solidité de la solidarité occidentale face à un acte qualifié par la Maison Blanche d’« attaque odieuse »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb102c5f-4965-3edb-81bb-bc5cb768850d",
                                        "entry_id": "03862cbf-e24b-32f2-aa7f-22ae83bae69e",
                                        "glosses": [
                                            "Lors d’un déplacement, mouvement intermédiaire permettant, suite à un décalage de trajectoire, de revenir à la trajectoire initiale ou à une trajectoire parallèle au déplacement initial."
                                        ],
                                        "tags": [
                                            "Cinématique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0a2b96f-532d-3301-9519-941a649a7a7a",
                                        "entry_id": "03862cbf-e24b-32f2-aa7f-22ae83bae69e",
                                        "glosses": [
                                            "Mouvement ondulatoire partant de l’arrière du véhicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27eebbd4-fcac-49be-80b4-216a4e817f70",
                                                "sense_id": "a0a2b96f-532d-3301-9519-941a649a7a7a",
                                                "text": "Avec la tente et mes affaires sur le porte-bagages, ma moto partait dés 80 km/h dans un louvoiement peu rassurant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fb04e3c-350f-430d-95b3-2c37728e456a",
                        "source_entry_id": "fda160d9-cd64-3f67-8106-b338ad4935fe",
                        "source_sense_description": "уклонение от прямого ответа",
                        "target_lang_word": "détour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ef3a45-e348-360e-ad1d-5aecc7477be2",
                                        "entry_id": "64a9c0fd-d53b-3dac-9d5d-e4e1dd65e55e",
                                        "glosses": [
                                            "Action de s’écarter du chemin direct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5204987f-bbaa-477b-9ec3-f653a2164005",
                                                "sense_id": "c9ef3a45-e348-360e-ad1d-5aecc7477be2",
                                                "text": "Les tourelles connues de deux ou trois châteaux voisins lui faisaient, pour les éviter, décrire quelques détours, puis il se perdait dans la campagne ou dans la forêt, très loin, au diable vert."
                                            },
                                            {
                                                "example_id": "7519592c-f975-4980-b445-27da8e35a703",
                                                "sense_id": "c9ef3a45-e348-360e-ad1d-5aecc7477be2",
                                                "text": "Après le diner M. B., le ministre plénipotentiaire honoraire, me pris à part pour me consulter sur la possibilité de faire un détour pour éviter « cette Moulouya ». — (Frédéric Weisgerber, Au seuil du Maroc Moderne, Institut des Hautes Études Marocaines, Rabat : Les éditions de la porte, 1947, page 268)"
                                            },
                                            {
                                                "example_id": "0d336d31-20eb-400b-b28a-fafaed864c38",
                                                "sense_id": "c9ef3a45-e348-360e-ad1d-5aecc7477be2",
                                                "text": "En effet, en raison d'une fiscalité onéreuse sur les autoroutes allemandes, un flux important de camions effectue le détour par l’Alsace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d54fb9aa-dfcb-32b6-95a7-46125b4415c5",
                                        "entry_id": "64a9c0fd-d53b-3dac-9d5d-e4e1dd65e55e",
                                        "glosses": [
                                            "Endroit où un chemin change de direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ba5615c-c5e1-4da6-b358-06a638cd10e0",
                                                "sense_id": "d54fb9aa-dfcb-32b6-95a7-46125b4415c5",
                                                "text": "Il y a un détour à droite, à gauche."
                                            },
                                            {
                                                "example_id": "16bcb26e-5f73-43dd-913b-9da87f8051ed",
                                                "sense_id": "d54fb9aa-dfcb-32b6-95a7-46125b4415c5",
                                                "text": "Les détours d’un labyrinthe."
                                            },
                                            {
                                                "example_id": "35e976ae-a27b-498d-a4b1-ab738f05318d",
                                                "sense_id": "d54fb9aa-dfcb-32b6-95a7-46125b4415c5",
                                                "text": "Se perdre dans les détours d’un souterrain."
                                            },
                                            {
                                                "example_id": "245dc032-3fd5-4d1f-b82a-609c050e291f",
                                                "sense_id": "d54fb9aa-dfcb-32b6-95a7-46125b4415c5",
                                                "text": "Au bout de quelques pas, à un second détour de la route, je rencontre un autre oiseau."
                                            },
                                            {
                                                "example_id": "d4c07e1a-9bec-4833-8144-933566617c4b",
                                                "sense_id": "d54fb9aa-dfcb-32b6-95a7-46125b4415c5",
                                                "text": "Les détours du cœur, les replis secrets du cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f9056a9-db46-3c29-8a2f-5295632ac0c4",
                                        "entry_id": "64a9c0fd-d53b-3dac-9d5d-e4e1dd65e55e",
                                        "glosses": [
                                            "Chemin qui éloigne du droit chemin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a28247ae-b6e5-4a26-b285-c572b7de0c3c",
                                                "sense_id": "4f9056a9-db46-3c29-8a2f-5295632ac0c4",
                                                "text": "N’allez pas par là, vous prenez un trop grand détour."
                                            },
                                            {
                                                "example_id": "1fadcff1-ec9b-4332-ad11-92e9b1865894",
                                                "sense_id": "4f9056a9-db46-3c29-8a2f-5295632ac0c4",
                                                "text": "C’est un détour de plus d’une lieue, il y a plus d’une lieue de détour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa129f20-eef7-3610-81af-c0d9a4af3ea7",
                                        "entry_id": "64a9c0fd-d53b-3dac-9d5d-e4e1dd65e55e",
                                        "glosses": [
                                            "Longueur, digression inutile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6e9aecd-2fa0-4fce-ac16-b5f3a4064520",
                                                "sense_id": "fa129f20-eef7-3610-81af-c0d9a4af3ea7",
                                                "text": "Il est revenu, pour un long détour, à sa première hypothèse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11e1888e-8367-3428-9abf-0bee350690fa",
                                        "entry_id": "64a9c0fd-d53b-3dac-9d5d-e4e1dd65e55e",
                                        "glosses": [
                                            "Discours dans lesquels on ne s’exprime que d’une manière indirecte, par crainte ou par ménagement, par délicatesse, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76f1012e-1862-4e1f-b6fc-75ad83e66bf1",
                                                "sense_id": "11e1888e-8367-3428-9abf-0bee350690fa",
                                                "text": "Pourquoi ces détours ? Parlez-moi franchement."
                                            },
                                            {
                                                "example_id": "6f9eee34-9dbb-4a1f-8384-374fa1a0778c",
                                                "sense_id": "11e1888e-8367-3428-9abf-0bee350690fa",
                                                "text": "Prendre des détours, de grands, de longs détours."
                                            },
                                            {
                                                "example_id": "5a36b50c-10bf-44f2-b16b-1925d43f917d",
                                                "sense_id": "11e1888e-8367-3428-9abf-0bee350690fa",
                                                "text": "Parler sans détour, sans aucun détour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3883928d-a9ef-38b4-b3db-340657e89328",
                                        "entry_id": "64a9c0fd-d53b-3dac-9d5d-e4e1dd65e55e",
                                        "glosses": [
                                            "Sorte de biais, de moyen adroit, de ruse, de subtilité, pour éluder quelque chose, pour venir à bout de ce qu’on veut faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "392d8d99-192d-4e0c-af2c-bbbfb6b6e2f3",
                                                "sense_id": "3883928d-a9ef-38b4-b3db-340657e89328",
                                                "text": "Je connais ses tours et détours."
                                            },
                                            {
                                                "example_id": "352d5b58-b1d9-4850-b3a9-045aca452015",
                                                "sense_id": "3883928d-a9ef-38b4-b3db-340657e89328",
                                                "text": "User de détours."
                                            },
                                            {
                                                "example_id": "7f3d5ff0-36cd-402a-91f1-2dac936413a7",
                                                "sense_id": "3883928d-a9ef-38b4-b3db-340657e89328",
                                                "text": "— Vous connaissez tous les tours et les détours de la tentation, vous ne vous laisserez plus prendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c648775-54ca-3f51-b023-011922fe06ab",
                                        "entry_id": "64a9c0fd-d53b-3dac-9d5d-e4e1dd65e55e",
                                        "glosses": [
                                            "Environs."
                                        ],
                                        "tags": [
                                            "plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aaa100c-0cc0-4423-922b-a404909018fc",
                                                "sense_id": "2c648775-54ca-3f51-b023-011922fe06ab",
                                                "text": "Certes des boqueteaux peuvent être rencontrés aux détours de Gollainville avec les bois de Châteaugay, près de Fresnay-les-Chaumes avec les bois de Bel-Ebat tous proches, ou vers Fromonvilliers et Baccon. Mais la tendance reste à la rareté de la végétation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
