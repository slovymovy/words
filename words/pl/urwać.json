    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0a117bc-4da5-3b9e-84ca-8154c55b6b37",
                    "sense_definition": "oderwać coś od całości poprzez szarpnięcie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fizyczne_oddzielenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musiała <w>urwać</w> kawałek papieru, żeby zapisać numer telefonu.",
                            "target_lang_translations": {
                                "en": "She had to <w>tear off</w> a piece of paper to write down the phone number."
                            }
                        },
                        {
                            "text": "Dziecko <w>urwało</w> guzik od koszuli podczas zabawy.",
                            "target_lang_translations": {
                                "en": "The child <w>ripped off</w> a button from the shirt while playing."
                            }
                        }
                    ],
                    "synonyms": [
                        "oderwać",
                        "odłamać"
                    ],
                    "common_phrases": [
                        "urwać guzik",
                        "urwać kawałek"
                    ],
                    "target_lang_definitions": {
                        "en": "To detach something from a whole by pulling or jerking."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tear off",
                                "target_lang_sense_clarification": "to remove a piece of something by pulling"
                            },
                            {
                                "target_lang_word": "rip off",
                                "target_lang_sense_clarification": "to remove something forcefully"
                            },
                            {
                                "target_lang_word": "snap off",
                                "target_lang_sense_clarification": "to break something off with a sudden movement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6686b3e7-80bd-323d-b059-e5e3914e6a7c",
                    "sense_definition": "nagle przestać mówić lub przerwać jakąś czynność",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przerwanie_czynnosci",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nagle <w>urwała</w> w pół słowa, gdy do pokoju wszedł szef.",
                            "target_lang_translations": {
                                "en": "She suddenly <w>cut off</w> in mid-sentence when the boss entered the room."
                            }
                        },
                        {
                            "text": "Nie chciała kontynuować tematu i po prostu <w>urwała</w> rozmowę.",
                            "target_lang_translations": {
                                "en": "She didn't want to continue the topic and simply <w>broke off</w> the conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "przerwać",
                        "uciąć"
                    ],
                    "antonyms": [
                        "kontynuować"
                    ],
                    "common_phrases": [
                        "urwać rozmowę",
                        "urwać w pół słowa"
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly stop speaking or interrupt an activity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cut off",
                                "target_lang_sense_clarification": "to stop speaking or interrupt a conversation abruptly"
                            },
                            {
                                "target_lang_word": "break off",
                                "target_lang_sense_clarification": "to stop doing something suddenly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e27d520b-c7c9-308f-81d8-51e56b0d4ee4",
                    "sense_definition": "zmniejszyć kwotę wypłaty lub należności",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "finanse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szef <w>urwał</w> mu z pensji za spóźnienia.",
                            "target_lang_translations": {
                                "en": "The boss <w>deducted</w> money from his salary for being late."
                            }
                        },
                        {
                            "text": "Musieli <w>urwać</w> z ceny, żeby sprzedać stary samochód.",
                            "target_lang_translations": {
                                "en": "They had to <w>knock off</w> some of the price to sell the old car."
                            }
                        }
                    ],
                    "synonyms": [
                        "potrącić",
                        "odliczyć"
                    ],
                    "common_phrases": [
                        "urwać z pensji",
                        "urwać z ceny"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w kontekście nieformalnym"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To reduce an amount of money, such as a salary or a price."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deduct",
                                "target_lang_sense_clarification": "to take away an amount from a total"
                            },
                            {
                                "target_lang_word": "knock off",
                                "target_lang_sense_clarification": "to reduce a price or amount (informal)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bddc7580-0264-3447-b67a-cf66aa74662c",
                    "sense_definition": "potajemnie lub szybko wyjść z jakiegoś miejsca",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ucieczka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Udało mu się <w>urwać</w> z nudnego spotkania przed czasem.",
                            "target_lang_translations": {
                                "en": "He managed to <w>sneak out</w> of the boring meeting early."
                            }
                        },
                        {
                            "text": "Muszę <w>urwać</w> się z pracy wcześniej, żeby odebrać dziecko.",
                            "target_lang_translations": {
                                "en": "I need to <w>slip away</w> from work early to pick up my child."
                            }
                        }
                    ],
                    "synonyms": [
                        "wymknąć się",
                        "uciec"
                    ],
                    "common_phrases": [
                        "urwać się z pracy",
                        "urwać się ze spotkania"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie wyjścia"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To leave a place secretly or quickly, often without permission."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sneak out",
                                "target_lang_sense_clarification": "to leave a place quietly or secretly"
                            },
                            {
                                "target_lang_word": "slip away",
                                "target_lang_sense_clarification": "to leave a place unnoticed"
                            }
                        ]
                    }
                },
