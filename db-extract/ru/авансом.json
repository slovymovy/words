        "ru-extract.jsonl": [
            {
                "entry_id": "fcc7eb11-398d-3503-8221-3ee7924356b2",
                "word": "авансом",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eb8bb646-8c71-3db0-be93-012e3b605c48",
                        "entry_id": "fcc7eb11-398d-3503-8221-3ee7924356b2",
                        "glosses": [
                            "разг. заранее, в счёт будущего"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc283be9-579a-49d9-b5df-6dafb39ed1ea",
                                "sense_id": "eb8bb646-8c71-3db0-be93-012e3b605c48",
                                "text": "Отдежурь за меня авансом, а я за тебя ― когда скажешь."
                            },
                            {
                                "example_id": "7977bce3-f952-4bd8-8acf-cec6c4ff60c1",
                                "sense_id": "eb8bb646-8c71-3db0-be93-012e3b605c48",
                                "text": "Он отвел меня в сторонку и сообщил, что его знакомый аспирант прождал два часа, а затем вычеркнул из ведомости четвёрку, по доброте душевной поставленную Баеву авансом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "505aab48-257b-4ca8-ae19-07604bb4e452",
                        "source_entry_id": "fcc7eb11-398d-3503-8221-3ee7924356b2",
                        "source_sense_id": "eb8bb646-8c71-3db0-be93-012e3b605c48",
                        "target_lang_word": "in advance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in advance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b67dc75-68e7-36a1-9146-82d853005379",
                                        "entry_id": "a92badd5-6026-377c-9ae6-3a5f4bf5226f",
                                        "glosses": [
                                            "Beforehand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2076563-a104-49bf-b107-7fd92b613595",
                                                "sense_id": "8b67dc75-68e7-36a1-9146-82d853005379",
                                                "text": "The money was paid in advance."
                                            },
                                            {
                                                "example_id": "d547f1e6-06c5-4a77-9a8f-979811cb0c9c",
                                                "sense_id": "8b67dc75-68e7-36a1-9146-82d853005379",
                                                "text": "To make matters worse, you did not publish the news note until 5 days before the conference — even though we had submitted it enough in advance to have been included in the previous weeks' paper.!"
                                            },
                                            {
                                                "example_id": "bd7f01be-367a-45d4-9acf-f31ecf790e63",
                                                "sense_id": "8b67dc75-68e7-36a1-9146-82d853005379",
                                                "text": "The chap opposite seems to be trying to pull a fast one, and having seen the guard is trying to buy a ticket online... but doesn't succeed. The guard helpfully sells him one, but not quite at the price of one purchased in advance. In fairness he doesn't kick off, nor does the guard treat him like some common criminal. It's a fair cop - or should that be a fare cop?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "684b64cb-1422-43cc-ac23-556c28acc453",
                        "source_entry_id": "fcc7eb11-398d-3503-8221-3ee7924356b2",
                        "source_sense_id": "eb8bb646-8c71-3db0-be93-012e3b605c48",
