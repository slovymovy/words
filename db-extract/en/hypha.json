                        "entry_id": "319e8e54-de05-34bd-ae3e-20ed5ed0b63b",
                        "glosses": [
                            "Any of the long, threadlike filaments that form the mycelium of a fungus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8ce911-990b-4abf-b320-e0d050902699",
                                "sense_id": "66fd2d94-2010-3a0f-8e5f-a54062b5733c",
                                "text": "She lays out how fungal hyphae—countless miles of filaments folded up in every spoon of soil—coax open tree roots and tap into them."
                            }
                        ]
                    }
                ],
