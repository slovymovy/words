{
    "word_family": [
        "zaufanie",
        "ufność",
        "nieufność",
        "ufny",
        "nieufny",
        "zaufać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "231b14e1-fd9e-3d3b-b53f-70f2af94af7d",
                    "sense_definition": "Być przekonanym o czyjejś uczciwości, szczerości i dobrych intencjach; polegać na kimś.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "trust_belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moi rodzice zawsze mnie wspierają, dlatego bardzo im <ufam>.",
                            "target_lang_translations": {
                                "ru": "Мои родители всегда меня поддерживают, поэтому я им очень <доверяю>.",
                                "en": "My parents always support me, which is why I <w>trust</w> them very much."
                            }
                        },
                        {
                            "text": "Nie można bezgranicznie <ufać> obcym ludziom spotkanym na ulicy.",
                            "target_lang_translations": {
                                "ru": "Нельзя безгранично <доверять> незнакомым людям, встреченным на улице.",
                                "en": "You cannot blindly <w>trust</w> strangers met on the street."
                            }
                        }
                    ],
                    "synonyms": [
                        "wierzyć",
                        "zawierzać",
                        "polegać"
                    ],
                    "common_phrases": [
                        "ufać bezgranicznie",
                        "ufać intuicji",
                        "ufać sobie",
                        "ufać lekarzowi"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть уверенным в чьей-либо честности, искренности и добрых намерениях; полагаться на кого-либо.",
                        "en": "To have confidence in someone's honesty, sincerity, and good intentions; to rely on someone."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доверять",
                                "target_lang_sense_clarification": "полагаться на кого-либо"
                            },
                            {
                                "target_lang_word": "верить",
                                "target_lang_sense_clarification": "быть уверенным в честности"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "trust",
                                "target_lang_sense_clarification": "to have confidence in someone's character or reliability"
                            },
                            {
                                "target_lang_word": "rely on",
                                "target_lang_sense_clarification": "to depend on someone with confidence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89dd46a3-6e45-39bf-b721-6c684c12f79e",
                    "sense_definition": "Wierzyć, że czyjeś słowa, informacje lub zapewnienia są zgodne z prawdą.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "trust_belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trudno jest <ufać> informacjom, które nie zostały oficjalnie potwierdzone.",
                            "target_lang_translations": {
                                "ru": "Трудно <доверять> информации, которая не была официально подтверждена.",
                                "en": "It is difficult to <w>trust</w> information that has not been officially confirmed."
                            }
                        },
                        {
                            "text": "Czy naprawdę <ufasz> temu, co politycy mówią w telewizji?",
                            "target_lang_translations": {
                                "ru": "Ты действительно <веришь> тому, что политики говорят по телевизору?",
                                "en": "Do you really <w>believe</w> what politicians say on television?"
                            }
                        }
                    ],
                    "synonyms": [
                        "wierzyć"
                    ],
                    "antonyms": [
                        "wątpić"
                    ],
                    "common_phrases": [
                        "ufać plotkom",
                        "ufać statystykom",
                        "ufać słowom",
                        "ufać zapewnieniom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верить, что чьи-то слова, информация или заверения соответствуют истине.",
                        "en": "To believe that someone's words, information, or assurances are true."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доверять",
                                "target_lang_sense_clarification": "относиться с доверием к источнику"
                            },
                            {
                                "target_lang_word": "верить",
                                "target_lang_sense_clarification": "принимать за истину"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "trust",
                                "target_lang_sense_clarification": "to accept information or sources as reliable"
                            },
                            {
                                "target_lang_word": "believe",
                                "target_lang_sense_clarification": "to accept statements or words as true"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e1203e4-9b35-3f34-8092-7c6b4c4da737",
                    "sense_definition": "Mieć głęboką nadzieję i przekonanie, że wydarzy się coś pomyślnego.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hope_expectation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy głęboko <ufać>, że nasze plany zakończą się sukcesem.",
                            "target_lang_translations": {
                                "ru": "Мы должны глубоко <верить>, что наши планы увенчаются успехом.",
                                "en": "We must deeply <w>trust</w> that our plans will end in success."
                            }
                        },
                        {
                            "text": "Mimo choroby babcia wciąż <w>ufa</w>, że wkrótce wróci do pełni sił.",
                            "target_lang_translations": {
                                "ru": "Несмотря на болезнь, бабушка всё ещё <w>верит</w>, что скоро полностью поправится.",
                                "en": "Despite her illness, Grandma still <w>has faith</w> that she will soon regain her full strength."
                            }
                        }
                    ],
                    "synonyms": [
                        "wierzyć",
                        "mieć nadzieję"
                    ],
                    "antonyms": [
                        "wątpić"
                    ],
                    "common_phrases": [
                        "ufać w zwycięstwo",
                        "ufać w przyszłość",
                        "ufać Bogu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь глубокую надежду и убежденность в том, что произойдет что-то хорошее.",
                        "en": "To have deep hope and conviction that something favorable will happen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верить",
                                "target_lang_sense_clarification": "иметь твердую уверенность"
                            },
                            {
                                "target_lang_word": "надеяться",
                                "target_lang_sense_clarification": "ожидать благополучного исхода"
                            },
                            {
                                "target_lang_word": "уповать",
                                "target_lang_sense_clarification": "возлагать надежды (книжн.)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "trust",
                                "target_lang_sense_clarification": "to hope confidently in an outcome"
                            },
                            {
                                "target_lang_word": "have faith",
                                "target_lang_sense_clarification": "to maintain deep conviction or hope"
                            },
                            {
                                "target_lang_word": "hope",
                                "target_lang_sense_clarification": "to look forward with expectation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}