                ],
                "senses": [
                    {
                        "sense_id": "a36e9bdc-6203-335c-8bcb-0d8d561a7c5c",
                        "entry_id": "0aa19c60-5bfe-32db-8782-17c34455bc1b",
                        "glosses": [
                            "Verzeichnis von Pflanzen, deren Blumen sich zu bestimmte Stunden öffnen und schließen, oft als Zifferblatt einer Uhr dargestellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7daf118-3435-4ad5-831c-71f2da340a29",
                                "sense_id": "a36e9bdc-6203-335c-8bcb-0d8d561a7c5c",
                                "text": "„Angeblich genügte dem schwedischen Naturforscher Linné im 18. Jahrhundert ein Blick auf seine Blumenuhr, um die Zeit bis auf fünf Minuten genau abzulesen.“"
                            },
                            {
                                "example_id": "db00668a-71e4-4300-8ce8-4f96b34cb025",
                                "sense_id": "a36e9bdc-6203-335c-8bcb-0d8d561a7c5c",
                                "text": "Manche Blumen öffnen sich nur in der Nacht, andere morgens, oft zu ganz bestimmten Stunden. Auf dieser Basis können fähige Gärtner in Beeten eine sogenannte Blumenuhr zusammenstellen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a0031d96-6f30-39f4-92d4-d84402661b02",
                        "entry_id": "0aa19c60-5bfe-32db-8782-17c34455bc1b",
                        "glosses": [
                            "dekorative Uhr, die in ein Blumenbeet eingesetzt ist und deren Zifferblatt teilweise oder gänzlich aus (Blüten-)Pflanzen besteht"
                        ],
                        "tags": [
                            "Gartenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "2889137e-19f0-44af-9787-49717251b51b",
                                "sense_id": "a0031d96-6f30-39f4-92d4-d84402661b02",
                                "text": "„Heute spricht man aber auch von Blumenuhren, wenn ein Beet dekorativ in Uhrform in einem Park aufgepflanzt ist.“"
                            },
                            {
                                "example_id": "67a6669d-a476-4278-b3bf-b5af9cf962dd",
                                "sense_id": "a0031d96-6f30-39f4-92d4-d84402661b02",
                                "text": "Manche Blumen öffnen sich nur in der Nacht, andere morgens, oft zu ganz bestimmten Stunden. Auf dieser Basis können fähige Gärtner in Beeten eine sogenannte Blumenuhr zusammenstellen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
