{
    "word_family": [
        "yon"
    ],
    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                    "sense_definition": "Located at a distance but within sight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "But soft, what light through <w>yonder</w> window breaks?",
                            "target_lang_translations": {
                                "ru": "Но тише! Что за свет пробивается из <w>вон того</w> окна?"
                            }
                        },
                        {
                            "text": "I wish I were on <w>yonder</w> hill and there I would sit.",
                            "target_lang_translations": {
                                "ru": "Хотел бы я быть на <w>вон том</w> холме и там сидеть."
                            }
                        }
                    ],
                    "synonyms": [
                        "yon"
                    ],
                    "common_phrases": [
                        "yonder hill",
                        "yonder window"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Commonly used in older literature and poetry."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся на некотором расстоянии, но в пределах видимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вон тот",
                                "target_lang_sense_clarification": "о видимом предмете, находящемся вдали"
                            },
                            {
                                "target_lang_word": "тот вон",
                                "target_lang_sense_clarification": "нейтр. указание на более удалённый предмет; форма меняется по роду и числу"
                            },
                            {
                                "target_lang_word": "вон та / вон то / вон те",
                                "target_lang_sense_clarification": "для ж. р./ср. р./мн. ч.: вон та, вон то, вон те"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bc1dca88-93d1-351b-8f6d-47c35b110c91",
                    "sense_definition": "At or in a distant but indicated place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Whose house is that over <w>yonder</w>?",
                            "target_lang_translations": {
                                "ru": "Чей это дом <w>вон там</w>?"
                            }
                        },
                        {
                            "text": "Look <w>yonder</w> to see the mountains in the distance.",
                            "target_lang_translations": {
                                "ru": "Посмотри <w>вон туда</w>, чтобы увидеть горы вдали."
                            }
                        }
                    ],
                    "synonyms": [
                        "there",
                        "over there"
                    ],
                    "common_phrases": [
                        "over yonder"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Often used in Southern American English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В или на некотором удалённом, но указанном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вон там",
                                "target_lang_sense_clarification": "в том, указанном месте вдали"
                            },
                            {
                                "target_lang_word": "там",
                                "target_lang_sense_clarification": "в удалённом месте; более общее соответствие"
                            },
                            {
                                "target_lang_word": "вон",
                                "target_lang_sense_clarification": "разг. указание в сторону удалённого места"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac48acac-399e-3bb8-9711-e57d677e0a52",
                    "sense_definition": "To a distant but indicated place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to head <w>yonder</w> to explore the valley.",
                            "target_lang_translations": {
                                "ru": "Они решили направиться <w>вон туда</w>, чтобы исследовать долину."
                            }
                        },
                        {
                            "text": "We will travel <w>yonder</w> where the path ends.",
                            "target_lang_translations": {
                                "ru": "Мы отправимся <w>туда</w>, где кончается тропа."
                            }
                        }
                    ],
                    "synonyms": [
                        "thither"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В направлении к некоторому удалённому, но указанному месту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туда",
                                "target_lang_sense_clarification": "движение к указанному удалённому месту"
                            },
                            {
                                "target_lang_word": "вон туда",
                                "target_lang_sense_clarification": "более наглядное указание направления"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e94f23f5-fc5d-3264-87e1-f58a1281ce94",
                    "sense_definition": "The vast, open distance, especially the sky.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot flew into the wild blue <w>yonder</w>.",
                            "target_lang_translations": {
                                "ru": "Лётчик улетел в бескрайнюю синюю <w>даль</w>."
                            }
                        },
                        {
                            "text": "They looked up at the <w>yonder</w> and felt very small.",
                            "target_lang_translations": {
                                "ru": "Они смотрели в <w>небесную даль</w> и чувствовали себя очень маленькими."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wild blue yonder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкое открытое пространство вдали, особенно небо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "даль",
                                "target_lang_sense_clarification": "обширное далёкое пространство"
                            },
                            {
                                "target_lang_word": "небесная даль",
                                "target_lang_sense_clarification": "о далёком небе, воздушном просторе"
                            },
                            {
                                "target_lang_word": "синева",
                                "target_lang_sense_clarification": "поэт. о бескрайнем синем небе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "47a252b0-55d4-3d79-b3b4-cb1bbf150c64",
                    "sense_definition": "The more distant of two choices.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Between the two boxes, the <w>yonder</w> one is heavier.",
                            "target_lang_translations": {
                                "ru": "Из двух коробок <w>та, что дальше</w>, тяжелее."
                            }
                        },
                        {
                            "text": "Please open the <w>yonder</w> door instead of this one.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, открой <w>ту дальнюю</w> дверь, а не эту."
                            }
                        }
                    ],
                    "synonyms": [
                        "farther"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Более удалённый из двух вариантов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тот, что дальше",
                                "target_lang_sense_clarification": "из двух предметов — тот, который находится дальше"
                            },
                            {
                                "target_lang_word": "дальний",
                                "target_lang_sense_clarification": "более удалённый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2a9cdfde-ffed-34a8-9a24-8b03a6c512a7",
                    "sense_definition": "A person or thing that is located at a distance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>yonder</w> is a mysterious figure in the distance.",
                            "target_lang_translations": {
                                "ru": "Этот <w>кто-то вдалеке</w> — загадочная фигура."
                            }
                        },
                        {
                            "text": "I can barely see the <w>yonder</w> through the fog.",
                            "target_lang_translations": {
                                "ru": "Сквозь туман я едва различаю <w>что-то вдалеке</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Highly unusual usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, находящийся на расстоянии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тот, кто вдалеке",
                                "target_lang_sense_clarification": "о человеке, находящемся вдалеке"
                            },
                            {
                                "target_lang_word": "что-то вдалеке",
                                "target_lang_sense_clarification": "о неясно видимом предмете или фигуре вдали"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}