                    "frequency": "Middle",
                    "semantic_group_id": "viager",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le condamné a reçu une peine de prison <w>perpétuelle</w> pour ses actes criminels."
                        },
                        {
                            "text": "Cette illustre savante a été désignée secrétaire <w>perpétuel</w> de l'Académie des sciences."
