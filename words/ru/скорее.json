                    "semantic_group_id": "preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <скорее> останусь дома, чем пойду гулять в такую погоду.",
                            "target_lang_translations": {
                                "en": "I would <rather> stay home than go for a walk in such weather.",
                                "de": "Ich bleibe <w>lieber</w> zu Hause, als bei diesem Wetter spazieren zu gehen.",
                                "zh": "这种天气我<w>宁可</w>待在家里，也不想出去散步。",
                                "nl": "Ik blijf <w>liever</w> thuis dan dat ik met dit weer ga wandelen.",
                                "pl": "W taką pogodę <w>raczej</w> zostanę w domu, niż pójdę na spacer.",
                                "fr": "Je préfère <w>plutôt</w> rester à la maison que d'aller me promener par ce temps.",
                                "it": "Preferirei <w>piuttosto</w> restare a casa che andare a fare una passeggiata con questo tempo.",
                                "cs": "Já <w>raději</w> zůstanu doma, než abych šel v takovém počasí ven.",
                                "tr": "Bu havada dışarı çıkmaktansa evde kalmayı <w>tercih ederim</w>.",
                                "es": "Yo <w>preferiría</w> quedarme en casa antes que salir a pasear con este tiempo."
                            }
                        },
                        {
                            "text": "Он <скорее> умрёт, чем предаст своих друзей.",
                            "target_lang_translations": {
                                "en": "He would <sooner> die than betray his friends.",
                                "de": "Er würde <w>eher</w> sterben, als seine Freunde zu verraten.",
                                "zh": "他<w>宁愿</w>死也不会背叛朋友。",
                                "nl": "Hij zou <w>eerder</w> sterven dan zijn vrienden verraden.",
                                "pl": "On <w>raczej</w> umrze, niż zdradzi swoich przyjaciół.",
                                "fr": "Il préférerait <w>plutôt</w> mourir que de trahir ses amis.",
                                "it": "Morirebbe <w>piuttosto</w> che tradire i suoi amici.",
                                "cs": "On <w>spíše</w> zemře, než aby zradil své přátele.",
                                "tr": "Arkadaşlarina ihanet etmektense ölmeyi <w>tercih eder</w>.",
                                "es": "Él <w>antes</w> moriría que traicionar a sus amigos."
                            }
