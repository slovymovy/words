                                        "sense_id": "f90f9d9d-9feb-3d06-83c4-8f473cbffd78",
                                        "entry_id": "8be9d255-cc1f-3e68-a958-e27b543ff9ae",
                                        "glosses": [
                                            "One who makes an unreasonable profit not justified by cost or risk, a rent-seeker."
                                        ],
