                "senses": [
                    {
                        "sense_id": "c0934936-d119-3140-8d38-33e2385e1da0",
                        "entry_id": "5082496d-f4b9-3b48-b2bd-624b83b45921",
                        "glosses": [
                            "in der Küche verwendetes Werkzeug zum Zubereiten von Speisen oder Getränken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87d4f16d-1073-4477-ae02-b138d16a0b33",
                                "sense_id": "c0934936-d119-3140-8d38-33e2385e1da0",
                                "text": "„Das einzige Küchenwerkzeug, das sie perfekt bedienen konnte, war der Dosenöffner.“"
                            },
                            {
                                "example_id": "1a15be69-378c-4c00-9e4e-d8e8abc1ba15",
                                "sense_id": "c0934936-d119-3140-8d38-33e2385e1da0",
                                "text": "„Sie sind ein praktisches Küchenwerkzeug, mit dem Sie heiße Kohlestücke, brennende Holzstücke oder Lebensmittel direkt aus dem Feuer nehmen können.“"
                            }
                        ],
