                "senses": [
                    {
                        "sense_id": "eb6ba181-424b-356b-97d9-850ecbc6d6b0",
                        "entry_id": "20678c90-ab5e-3b25-b3b3-1773c9b5add3",
                        "glosses": [
                            "某種語言（尤其是法語）的地區性語言（通常指被認為不標準的方言）"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "830d4ebf-7848-4996-b462-c3a54548c855",
                                "sense_id": "eb6ba181-424b-356b-97d9-850ecbc6d6b0",
                                "text": "[The Sundanese] are regarded as relatively barbarous, and in the company of Malays or Javanese, they are themselves ashamed of their dialect, which is looked on as a sort of rude patois.",
                                "translation": "[巽他族]被認為相對野蠻，而且在馬來人或爪哇人面前，他們也會對自己的方言感到羞愧，將其視為一種粗俗的方言。"
                            },
                            {
                                "example_id": "d05fdd1f-cfd0-412b-99ca-b4c5bbdd5d0e",
                                "sense_id": "eb6ba181-424b-356b-97d9-850ecbc6d6b0",
                                "text": "*The Expanse'*s patois has become, like Klingon and Dothraki, the show's great unifier—the slang all devotees speak.",
                                "translation": "《蒼穹浩瀚》中的方言就像克林貢語和多斯拉克語一樣，成為了這部劇的巨大統一因素——所有狂熱粉絲都會說的俚語。"
                            }
                        ]
                    },
                    {
                        "sense_id": "225300fe-3a55-3d81-9a4c-900b9a53bec9",
                        "entry_id": "20678c90-ab5e-3b25-b3b3-1773c9b5add3",
                        "glosses": [
                            "在法國使用的各種法語或奧克語方言"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9b785581-44cf-3b07-81ba-d0f7ed6f7b3e",
                        "entry_id": "20678c90-ab5e-3b25-b3b3-1773c9b5add3",
                        "glosses": [
                            "加勒比地區（特別是多米尼克、聖露西亞、千里達及托巴哥和海地）的克里奧爾法語"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f79ee8ac-fa63-3ee9-93c8-27b31c3c83cf",
                        "entry_id": "20678c90-ab5e-3b25-b3b3-1773c9b5add3",
                        "glosses": [
                            "Jamaican Patois (“牙買加方言”)的缩略形式"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "eb8d8c64-3358-363d-aa7f-2ac145d5a2dd",
                        "entry_id": "20678c90-ab5e-3b25-b3b3-1773c9b5add3",
                        "glosses": [
                            "行話或黑話"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe21edc0-0772-49e4-9cd3-704b2f6c68a8",
                                "sense_id": "eb8d8c64-3358-363d-aa7f-2ac145d5a2dd",
                                "text": "In the patois of insurance, the winery will go bare into this year’s burning season, which experts predict to be especially fierce.",
                                "translation": "用保險業的行話來說，這家酒莊將在沒有保險保障的情況下進入今年的火災高發季，專家預測今年的火勢將尤為猛烈。"
                            }
                        ]
                    }
