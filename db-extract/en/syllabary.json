                                            {
                                                "example_id": "147c92d7-40f1-471b-83c9-b86ca7aa37e5",
                                                "sense_id": "62a64b9e-776e-344c-ba6e-58090d979e22",
                                                "text": "L’écriture syllabaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "syllabaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "855e73a7-45c5-309b-8b80-8a5cb4c00944",
                                        "entry_id": "800eca95-a574-3777-bfed-6e90e9082f6d",
                                        "glosses": [
                                            "Ensemble de symboles utilisés pour représenter les syllabes d’une langue, à la différence d’un alphabet où les symboles représentent des sons ou des phonèmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b07b4c-9b27-4dc7-bccb-a9a634631d55",
                                                "sense_id": "855e73a7-45c5-309b-8b80-8a5cb4c00944",
                                                "text": "Les hiraganas et les katakanas sont les deux syllabaires japonais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25f70d43-f537-34f1-9f83-60c227f2f0e4",
                                        "entry_id": "800eca95-a574-3777-bfed-6e90e9082f6d",
                                        "glosses": [
                                            "Abécédaire."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cc825c0-1f1d-43d0-a6d9-e4c4ef6d80f1",
                                                "sense_id": "25f70d43-f537-34f1-9f83-60c227f2f0e4",
                                                "text": "Nous avions deux syllabaires, un bleu et un rose. Au début de février, nous étions assez bien débrouillés. L’étude des sons et des difficultés était terminé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a89e5ad-22b5-35e7-887e-9f95a39e082a",
                                        "entry_id": "800eca95-a574-3777-bfed-6e90e9082f6d",
                                        "glosses": [
                                            "Rudiments, connaissances élémentaires. Fondamentaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba66805-9e5a-4952-9b40-79bb4e09f0fc",
                                                "sense_id": "0a89e5ad-22b5-35e7-887e-9f95a39e082a",
                                                "text": "Il ânnonait le syllabaire de la Salpêtrière, sans y changer un mot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
