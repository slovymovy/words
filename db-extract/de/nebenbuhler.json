                                        "sense_id": "3bf60591-0198-3db0-9fe9-7f2f3d4aee0a",
                                        "entry_id": "bd9292f0-fcd3-3f69-a461-4982d2206f55",
                                        "glosses": [
                                            "To be equal to, or match, or to surpass another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71306051-38e5-4824-9888-fc90289e3b98",
                                                "sense_id": "3bf60591-0198-3db0-9fe9-7f2f3d4aee0a",
                                                "text": "But the Waverley is still the best-placed station of any British city, and gives the arriving stranger a first impression rivalled in Europe only by the exclusively watery station approach at Venice."
                                            },
                                            {
                                                "example_id": "66d42cce-153a-4f85-85a4-a478399a989c",
                                                "sense_id": "3bf60591-0198-3db0-9fe9-7f2f3d4aee0a",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53a9eed2-52a5-3a69-bcf5-842e1b608095",
                                        "entry_id": "bd9292f0-fcd3-3f69-a461-4982d2206f55",
                                        "glosses": [
                                            "To strive to equal or excel; to emulate."
                                        ],
