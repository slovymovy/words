                                        "entry_id": "2a2679a4-e5de-3caa-8bf9-836e91e2d2ac",
                                        "glosses": [
                                            "een van de langste en belangrijkste rivieren van Europa die op de grens ligt tussen Midden- en West-Europa"
                                        ],
                                        "tags": [
                                            "toponiem: rivier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8bc8d79-833e-4c1f-a740-30d882e1015d",
                                                "sense_id": "b8703070-be17-30d1-adf9-61cd2b4ebd8e",
                                                "text": "De Rijn ontspringt in Graubünden, in de Zwitserse Alpen, waar twee bronrivieren (de Voor-Rijn en de Achter-Rijn) ontspringen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
