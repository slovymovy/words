{
    "word_family": [
        "stagger",
        "staggeringly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b901207f-dcf0-30c3-9b29-bd72f7abfbe2",
                    "sense_definition": "Arranged in a way that is not uniform or aligned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company holds <w>staggered</w> elections for board members to ensure continuity.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf houdt <w>gespreide</w> verkiezingen voor bestuursleden om continuïteit te waarborgen."
                            }
                        },
                        {
                            "text": "We used <w>staggered</w> start times to prevent overcrowding at the entrance.",
                            "target_lang_translations": {
                                "nl": "We gebruikten <w>gespreide</w> starttijden om drukte bij de ingang te voorkomen."
                            }
                        }
                    ],
                    "synonyms": [
                        "offset"
                    ],
                    "antonyms": [
                        "aligned"
                    ],
                    "common_phrases": [
                        "staggered hours",
                        "staggered terms"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een manier gerangschikt die niet uniform of op één lijn is."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gespreid",
                                "target_lang_sense_clarification": "verwijzend naar tijdstippen of gebeurtenissen die niet tegelijk plaatsvinden"
                            },
                            {
                                "target_lang_word": "verschoven",
                                "target_lang_sense_clarification": "verwijzend naar een niet-gelijke uitlijning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43770ea9-07e0-3deb-8bf7-7409e6c57a09",
                    "sense_definition": "Positioned so that items are not directly opposite each other.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train station has <w>staggered</w> platforms on either side of the tracks.",
                            "target_lang_translations": {
                                "nl": "Het treinstation heeft <w>verspringende</w> perrons aan weerszijden van de sporen."
                            }
                        },
                        {
                            "text": "The bricks were laid in a <w>staggered</w> pattern to increase the wall's strength.",
                            "target_lang_translations": {
                                "nl": "De bakstenen werden in een <w>verspringend</w> patroon gelegd om de sterkte van de muur te vergroten."
                            }
                        }
                    ],
                    "synonyms": [
                        "alternating"
                    ],
                    "common_phrases": [
                        "staggered rows"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zo geplaatst dat items niet direct tegenover elkaar staan."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verspringend",
                                "target_lang_sense_clarification": "verwijzend naar een patroon waarbij elementen niet in een rechte lijn staan"
                            },
                            {
                                "target_lang_word": "afwisselend",
                                "target_lang_sense_clarification": "verwijzend naar een patroon van posities"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbb338ee-bce7-36ad-9ad3-01e02c48e433",
                    "sense_definition": "Feeling deeply shocked or astonished.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>staggered</w> by the sheer scale of the destruction after the storm.",
                            "target_lang_translations": {
                                "nl": "Ik was <w>verbijsterd</w> door de enorme omvang van de verwoesting na de storm."
                            }
                        },
                        {
                            "text": "She was <w>staggered</w> to learn that she had won the national competition.",
                            "target_lang_translations": {
                                "nl": "Ze was <w>verbijsterd</w> om te horen dat ze de nationale competitie had gewonnen."
                            }
                        }
                    ],
                    "synonyms": [
                        "astonished",
                        "amazed",
                        "dumbfounded"
                    ],
                    "target_lang_definitions": {
                        "nl": "Diep geschokt of verbaasd zijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verbijsterd",
                                "target_lang_sense_clarification": "zeer verbaasd of sprakeloos door een gebeurtenis"
                            },
                            {
                                "target_lang_word": "stomverbaasd",
                                "target_lang_sense_clarification": "in hoge mate verrast"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10e9846f-f2d9-34db-b3c6-769bc7b09ef4",
                    "sense_definition": "simple past and past participle of <w>stagger</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured player <w>staggered</w> off the field with help from the trainers.",
                            "target_lang_translations": {
                                "nl": "De geblesseerde speler <w>strompelde</w> van het veld met hulp van de trainers."
                            }
                        },
                        {
                            "text": "He <w>staggered</w> home after a long night of walking in the cold.",
                            "target_lang_translations": {
                                "nl": "Hij <w>wankelde</w> naar huis na een lange nacht lopen in de kou."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Onvast ter been zijn of wankelen, vaak door letsel of vermoeidheid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wankelde",
                                "target_lang_sense_clarification": "onvast lopen of bewegen"
                            },
                            {
                                "target_lang_word": "strompelde",
                                "target_lang_sense_clarification": "moeizaam en onvast lopen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}