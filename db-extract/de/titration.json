                                        "sense_id": "97af8417-6231-3dca-bfa6-4f57eaa391e0",
                                        "entry_id": "f29e18a1-0878-3244-9d83-7d843c8e43f8",
                                        "glosses": [
                                            "Mesure utilisée pour déterminer la finesse des fils."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb393acc-2413-405f-af76-e9f2450e2093",
                                                "sense_id": "97af8417-6231-3dca-bfa6-4f57eaa391e0",
                                                "text": "La finesse des bas nylon est évaluée en deniers et inscrite sur la pochette ; le chiffre correspond au titrage du fil ; plus il est bas, plus le fil, donc le bas, est fin."
                                            }
                                        ]
