                                        "entry_id": "2a1e501b-fdf8-328b-b7fe-851d03e3b625",
                                        "glosses": [
                                            "A roving motion; course without definite direction; lack of rule or method; chance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c6de357-7131-494e-be6a-cba3b3516837",
                                                "sense_id": "784b5676-5126-3bec-a4b2-2676c92cf2e0",
                                                "text": "Still take advice ; though counsels, when they fly / At random, sometimes hit most happily."
                                            },
                                            {
                                                "example_id": "26d19227-bacd-47d8-b489-1c94db221c81",
                                                "sense_id": "784b5676-5126-3bec-a4b2-2676c92cf2e0",
                                                "text": "O ! many a shaft, at random sent, / Finds mark the archer little meant !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ee54353-119f-34ed-ba79-4339c24a401e",
                                        "entry_id": "2a1e501b-fdf8-328b-b7fe-851d03e3b625",
                                        "glosses": [
                                            "Speed, full speed; impetuosity, force."
                                        ],
                                        "tags": [
                                            "countable",
