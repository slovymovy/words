                                    {
                                        "sense_id": "7da6fe6e-47e4-349c-8f81-435d54fdb8aa",
                                        "entry_id": "7d4eaf64-4ca9-31db-953f-ff4467cb8923",
                                        "glosses": [
                                            "Moyen employé pour éviter que des rapports sexuels n’aboutissent à une grossesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ba5422c-86be-421b-bdf0-4df9623067bc",
                                                "sense_id": "7da6fe6e-47e4-349c-8f81-435d54fdb8aa",
                                                "text": "En raison de la connaissance limitée du système humain de reproduction, la distinction entre contraception et avortement demeura floue pendant des siècles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ff8a319-93c9-447d-881d-fb01cea207f6",
                        "source_entry_id": "fbbf0934-7ded-3320-8258-cf280ed5aced",
                        "source_sense_id": "d8f6a070-9236-3450-84b4-c9a9072213b6",
                        "source_sense_description": "use of a device or procedure",
                        "target_lang_word": "Empfängnisverhütung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empfängnisverhütung",
                                "target_lang_code": "de",
