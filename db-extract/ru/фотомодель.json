                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dd929ff-3975-405c-907c-754154023020",
                                "sense_id": "b1867ecb-f425-323d-b38c-551d5b59a5a2",
                                "text": "Требования к фотомодели существенно иные, чем к манекенщице, так как цели съёмки могут быть очень разными."
                            }
                        ]
                    },
