                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e75bc2-2fd7-4bd5-ad82-1fa5ad031a38",
                                "sense_id": "1c99737d-dd72-3996-9dc9-3d008af69e63",
                                "text": "Le voyage ne garantit pas le changement et l'on peut se « resédentariser » tout en voyageant, ont estimé plusieurs intervenants."
                            },
                            {
                                "example_id": "ca6333be-e7f5-4144-bc79-326623ad35f3",
                                "sense_id": "1c99737d-dd72-3996-9dc9-3d008af69e63",
                                "text": "Chazan et son grand ministre eurent à cœur de « refaire la terre », de reconstituer la paysannerie iranienne, de « resédentariser » l'Iran."
                            }
                        ]
