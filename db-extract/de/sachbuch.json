                    {
                        "form_id": "b6db198b-dafe-4f40-af49-c57aed0e5231",
                        "entry_id": "503ea32a-26ae-3775-b1c2-4b117f2eb1bb",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Sachbuch"
                    },
                    {
                        "form_id": "650d19d1-529a-4c40-b9f8-b34eff040798",
                        "entry_id": "503ea32a-26ae-3775-b1c2-4b117f2eb1bb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sachbücher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b794f26-aafd-3636-9e59-949a09c1dfc0",
                        "entry_id": "503ea32a-26ae-3775-b1c2-4b117f2eb1bb",
                        "glosses": [
                            "Buch, das ein sachliches Thema behandelt und nicht ein fiktives, literarisches, und sich dabei an ein breiteres Publikum wendet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d62c3168-12f2-40f4-b041-6237f5bd0910",
                                "sense_id": "4b794f26-aafd-3636-9e59-949a09c1dfc0",
                                "text": "Ein berühmtes Sachbuch ist Ceram, Götter, Gräber und Gelehrte."
                            },
                            {
                                "example_id": "af4ed8cc-956e-464a-9ae8-aee7964d0a4d",
                                "sense_id": "4b794f26-aafd-3636-9e59-949a09c1dfc0",
                                "text": "„Zum Weihnachtsmann existiert bereits einige Spezialliteratur, wobei namentlich die Bücher von Thomas Hauschild und Martina Eberspächer zu nennen sind; daneben sind in Sachbüchern etliche Ausführungen zu finden.“"
                            },
                            {
                                "example_id": "0ad126e7-25ed-4b49-804d-52c0f6cac3a1",
                                "sense_id": "4b794f26-aafd-3636-9e59-949a09c1dfc0",
                                "text": "„Romane, Sachbücher und Werke zu westafrikanischen Kulturen füllten die Wandregale.“"
                            },
                            {
                                "example_id": "f660adb8-2da9-4e30-ac6b-d295ae6faf87",
                                "sense_id": "4b794f26-aafd-3636-9e59-949a09c1dfc0",
                                "text": "„Sie würden eher irgendwelche Krimis oder die Sachbücher von der Bestsellerliste aus der Zelle holen, um zu erfahren, was hier in Deutschland Sache war, überlegte ich.“"
                            },
                            {
                                "example_id": "f9bd193e-db89-44ff-907f-0897ae6f4404",
                                "sense_id": "4b794f26-aafd-3636-9e59-949a09c1dfc0",
                                "text": "„Das entspricht haargenau der Technik des modernen Sachbuchs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
