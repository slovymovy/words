                                "target_senses": [
                                    {
                                        "sense_id": "c587d6d7-1d88-36a9-93cb-cea50fc7d8b0",
                                        "entry_id": "e80fe4cc-ccc0-38d3-ac33-4ddff80f19cd",
                                        "glosses": [
                                            "A hose designed to deliver water to douse a fire, usually much stronger and wider in diameter than a garden hose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "441ef94f-f847-46d8-ab35-e8a9fa5ee89c",
                                                "sense_id": "c587d6d7-1d88-36a9-93cb-cea50fc7d8b0",
                                                "text": "Although the subway structure is of non-combustible material, a fire protection system, with fire hose cabinets on every underground platform, has been provided."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb9eba62-f9a7-3b0c-85a7-6efb3a7204e4",
                                        "entry_id": "e80fe4cc-ccc0-38d3-ac33-4ddff80f19cd",
                                        "glosses": [
                                            "Any fast, heavy stream (e.g. of information)."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "678c2655-c976-4090-9b73-703aa36406b8",
                                                "sense_id": "eb9eba62-f9a7-3b0c-85a7-6efb3a7204e4",
                                                "text": "She felt she was standing in front of a fire hose of instructions, trying to absorb them all with a sponge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14af406b-52af-3152-a673-850c7a4045c7",
                                        "entry_id": "e80fe4cc-ccc0-38d3-ac33-4ddff80f19cd",
                                        "glosses": [
                                            "A feed of all updates to a website."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7228ee8d-e972-4b73-ad56-56aded80749b",
                                                "sense_id": "14af406b-52af-3152-a673-850c7a4045c7",
                                                "text": "Links contained within feeds (RSS, fire hose, syndicated)"
                                            },
                                            {
                                                "example_id": "8e3872de-527e-4471-9abd-cbdc2f0e8ed1",
                                                "sense_id": "14af406b-52af-3152-a673-850c7a4045c7",
                                                "text": "This is cool because, even though the YouTube firehose is on full blast, you only need an instance of the feed and from that firehose, you can filter out what you need for alerts for as many keywords as you like."
                                            },
                                            {
                                                "example_id": "d1887b98-208e-4ca5-b0a0-dedf867e1261",
                                                "sense_id": "14af406b-52af-3152-a673-850c7a4045c7",
                                                "text": "However, it is worth bearing in mind that even those services with access to the Twitter 'firehose' (direct API) do not have anything even approaching a complete Twitter archive."
                                            },
                                            {
                                                "example_id": "9aae4a04-65e3-44c2-895a-568d81639cca",
                                                "sense_id": "14af406b-52af-3152-a673-850c7a4045c7",
                                                "text": "Here we will briefly consider web crawlers, webscraping software, data feeds (RSS and other feeds, firehoses etc), human cutting and pasting, panels, MROCs, Netnography, and text analytics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "158d0208-3be3-3e22-a7a4-3e24edded7e2",
                                        "entry_id": "e80fe4cc-ccc0-38d3-ac33-4ddff80f19cd",
                                        "glosses": [
                                            "A human penis."
                                        ],
