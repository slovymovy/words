                ],
                "senses": [
                    {
                        "sense_id": "005c9db6-a7b9-342c-acc5-03c8943398fc",
                        "entry_id": "3a189fcc-88b6-39b3-bb50-3b1269dd24b0",
                        "glosses": [
                            "Relatif au Mecklembourg et à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d200fae-1acc-4d8a-ad4a-c8dd4da1fbad",
                                "sense_id": "005c9db6-a7b9-342c-acc5-03c8943398fc",
                                "text": "Le brave homme se fit payer deux ducats, mais en compensation il m’enveloppa de sa grosse houppelande, et me chanta deux ou trois chansons mecklembourgeoises qui me parurent assez jolies."
                            }
                        ]
                    },
                    {
                        "sense_id": "4265b53c-76c3-3788-89f8-c184a161175c",
                        "entry_id": "3a189fcc-88b6-39b3-bb50-3b1269dd24b0",
                        "glosses": [
                            "Race de cheval d'origine allemande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f343f70-30df-406d-b7ae-9070fdbfeb30",
                                "sense_id": "4265b53c-76c3-3788-89f8-c184a161175c",
                                "text": "La distance qui sépare la rue des Tournelles, où demeurait le duc de Vallombreuse, de la rue Dauphine, fut bientôt franchie au trot de quatre vigoureux mecklembourgeois touchés par un cocher de grande maison, qui n’eût pas cédé le haut du pavé à un prince du sang, et qui coupait insolemment toutes les voitures."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "fd002f53-5e7c-3c56-a9bf-1b21deeb9103",
                "word": "Mecklembourgeois",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bb2f6bb3-699d-4069-b6a6-9608c24a7109",
                        "entry_id": "fd002f53-5e7c-3c56-a9bf-1b21deeb9103",
                        "tags": [
                            "feminine"
