                        "source_sense_id": "a2826a47-b9a4-3ed4-b9fa-f27557e45a00",
                        "source_sense_description": "Informatik, Digitaltechnik: eine Mengeneinheit, siehe auch Byte",
                        "target_lang_word": "zettabyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zettabyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7390ecc9-8a60-379c-826c-976214d070a9",
                                        "entry_id": "e37d6acd-224e-394c-adc5-a12a0b00e062",
                                        "glosses": [
                                            "One sextillion (10²¹, or 1,000,000,000,000,000,000,000) bytes or 1,000 exabytes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9815db9e-c8fb-486e-a24a-d40b804e9bb5",
                                                "sense_id": "7390ecc9-8a60-379c-826c-976214d070a9",
                                                "text": "Cerberus Scientist: I'm sorry, sir. None of Normandy's surveillance feeds have been responding since Shepard went rogue.\nIllusive Man: I want it back. Retry the remote lockdown protocols.\nCerberus Scientist: After our last attempt, EDI flooded our server with seven zettabytes of explicit images. I think she was making a joke."
                                            },
                                            {
                                                "example_id": "6e83557e-a556-4caf-b681-381bcf4aee0c",
                                                "sense_id": "7390ecc9-8a60-379c-826c-976214d070a9",
                                                "text": "Conservative estimates put data produced in 2020 alone at 44 zettabytes."
                                            },
                                            {
                                                "example_id": "6a12d1cd-7f81-430e-9318-26d1ae4fddb1",
                                                "sense_id": "7390ecc9-8a60-379c-826c-976214d070a9",
                                                "text": "For such quantities, it is necessary to introduce a further unit: the zettabyte which corresponds to 1000 exabytes. The International Data Corporation (IDC) predicts the world's data will grow to 175 zettabytes in 2025."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e37146c2-cb83-33eb-b2be-523b521b4871",
                                        "entry_id": "e37d6acd-224e-394c-adc5-a12a0b00e062",
                                        "glosses": [
                                            "A zebibyte."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
