                                        "entry_id": "14b67ab5-7a8d-31d0-aaab-5fc6ace842c1",
                                        "glosses": [
                                            "Hirnhautentzündung, genauer: Entzündung der Pia mater und der Arachnoidea mater"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e83fdc-dd97-42d5-8c88-5e08596d2f2d",
                                                "sense_id": "bbe7ada2-278e-373a-96d7-7522acf049f4",
                                                "text": "Klinisch unterscheidet man jedoch die weitgehend harmlose lymphozytäre Meningitis durch Viren von der hochgefährlichen und unbehandelt fast stets zum Tode führenden eitrigen Meningitis durch Bakterien."
                                            },
                                            {
                                                "example_id": "2a92b459-0f6e-4480-95f6-6217572124d2",
                                                "sense_id": "bbe7ada2-278e-373a-96d7-7522acf049f4",
                                                "text": "„Pastor lacht glucksend und biegt dabei den Kopf in den Nacken, als litte er an den Symptomen einer akuten Meningitis.“"
                                            },
                                            {
                                                "example_id": "2cba1e29-ae99-4ec1-9f70-bf4b2142aa12",
                                                "sense_id": "bbe7ada2-278e-373a-96d7-7522acf049f4",
                                                "text": "„Eine neue Blutung schwemmt die Tuberkelbazillen in den Blutkreislauf und erzeugt die todbringende Meningitis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
