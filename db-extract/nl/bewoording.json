                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a556176-a679-486a-becc-1878fcbcc12f",
                                "sense_id": "8bf03797-48ee-31f1-8960-26d749ae2837",
                                "text": "Voor die prachtige daad was geen bewoording goed genoeg."
                            },
                            {
                                "example_id": "c9a77adc-5185-4f0b-86c9-db6b41dbbd0f",
                                "sense_id": "8bf03797-48ee-31f1-8960-26d749ae2837",
                                "text": "Zo'n beetje het laatste plekje in Turkije waar hij zijn vakantie door wilde brengen, al zou hij zich natuurlijk tegen de sympathieke Utrechters in geheel andere bewoordingen uitlaten."
                            }
                        ]
                    },
                    {
                        "sense_id": "05ea92e8-65c7-3b38-b3dc-e786b6f51fff",
                        "entry_id": "0b333882-6437-3b7a-b6bc-cc1aed5bb7a3",
                        "glosses": [
                            "de woorden waarmee je iets vertelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6679d058-c8c8-4213-b231-b4e136a90a05",
                                "sense_id": "05ea92e8-65c7-3b38-b3dc-e786b6f51fff",
                                "text": "Zijn bewoording van het probleem was kort- en bondig en voor iedereen begrijpelijk."
                            }
                        ]
                    }
                ],
