                        "target_lang_word": "versunken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versunken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3da9cf7-bd46-3608-b7a3-42bc00e149bc",
                                        "entry_id": "c4947d98-4559-311e-a9e7-b7168264aaf5",
                                        "glosses": [
                                            "irgendwo drin, zum Beispiel unter der Wasseroberfläche, verschwunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70bfe0f2-bded-4b54-841c-53319d60776f",
                                                "sense_id": "d3da9cf7-bd46-3608-b7a3-42bc00e149bc",
                                                "text": "In antiken versunkenen Schiffen findet man manchmal Waffen, Gold oder gar Skelette."
                                            },
                                            {
                                                "example_id": "25b94d69-fb66-4683-a378-55878d9d0166",
                                                "sense_id": "d3da9cf7-bd46-3608-b7a3-42bc00e149bc",
                                                "text": "Der im Treibsand versunkene Mann krallt sich an einem dünnen Ast fest."
                                            },
                                            {
                                                "example_id": "31570bfa-9630-4747-b478-2ff8b16e9b80",
                                                "sense_id": "d3da9cf7-bd46-3608-b7a3-42bc00e149bc",
                                                "text": "Die versunkene Maya-Kultur wird von vielen Personen erforscht."
                                            },
                                            {
                                                "example_id": "3a26d953-27ee-47bd-ab18-6f8764bb07f3",
                                                "sense_id": "d3da9cf7-bd46-3608-b7a3-42bc00e149bc",
                                                "text": "„In der Ostsee ist ein versunkenes russisches U-Boot aus dem Zweiten Weltkrieg entdeckt worden.“"
                                            },
                                            {
                                                "example_id": "8495e6d2-6d38-4615-82d3-ef4ea706096e",
                                                "sense_id": "d3da9cf7-bd46-3608-b7a3-42bc00e149bc",
                                                "text": "„Der Wels ist ein Grundfisch, der sich mit Vorliebe zwischen versunkenem Geäst aufhält.“"
                                            },
                                            {
                                                "example_id": "1d5ff65f-6cab-40d8-b5cb-e3bb935f9066",
                                                "sense_id": "d3da9cf7-bd46-3608-b7a3-42bc00e149bc",
                                                "text": "„Trauer in der Danwon-Schule in der Stadt Ansan: Eine Frau betet bei einer Andacht für die Passagiere in der versunkenen Fähre.“"
                                            },
                                            {
                                                "example_id": "9ab36052-2d22-4337-a1a1-2d4daafbcbd6",
                                                "sense_id": "d3da9cf7-bd46-3608-b7a3-42bc00e149bc",
                                                "text": "„Nicht Schatzsuche, sondern die Wiederentdeckung versunkener Kulturen hat die moderne Archäologie zum Ziel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dff9e33c-5f0f-3aef-856f-5ae26cdb867c",
                                        "entry_id": "c4947d98-4559-311e-a9e7-b7168264aaf5",
                                        "glosses": [
                                            "in etwas sehr vertieft, auf etwas voll konzentriert und die Umwelt nicht beachtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d166956a-56d9-40ce-ae49-087e6d42d77f",
                                                "sense_id": "dff9e33c-5f0f-3aef-856f-5ae26cdb867c",
                                                "text": "Er ist in seinen 1.000 Seiten Wälzer versunken."
                                            },
                                            {
                                                "example_id": "ecde5f1f-53ff-463a-8e30-9594ec76750d",
                                                "sense_id": "dff9e33c-5f0f-3aef-856f-5ae26cdb867c",
                                                "text": "Anne-Marie ist wieder in ihrem Liebesroman versunken."
                                            },
                                            {
                                                "example_id": "804cb507-28a2-4c48-8b5e-b9dc1000695e",
                                                "sense_id": "dff9e33c-5f0f-3aef-856f-5ae26cdb867c",
                                                "text": "„Manager, die normalerweise nur die ‚Financial Times‘ oder das ‚Handelsblatt‘ lesen, sitzen in ein Buch versunken im Flugzeug und reden mit ihren Kollegen über fliegende Besen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
