                ],
                "senses": [
                    {
                        "sense_id": "0bc0c58e-b2d3-34ca-b7c3-f6dd75ff58bd",
                        "entry_id": "4302a145-60c3-3c81-ae2b-89c2cdd48fe0",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd7e61c2-5876-4f90-abd5-9cc58420fb15",
                                "sense_id": "0bc0c58e-b2d3-34ca-b7c3-f6dd75ff58bd",
                                "text": "Frau Hämmerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "18f6cc44-8d69-4336-8611-6093cb385cf9",
                                "sense_id": "0bc0c58e-b2d3-34ca-b7c3-f6dd75ff58bd",
                                "text": "Herr Hämmerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fbb2b68b-1555-4278-8ed3-a40674dd3ba1",
                                "sense_id": "0bc0c58e-b2d3-34ca-b7c3-f6dd75ff58bd",
                                "text": "Die Hämmerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "1249f867-2732-48d2-9b29-c4d25312235a",
                                "sense_id": "0bc0c58e-b2d3-34ca-b7c3-f6dd75ff58bd",
                                "text": "Der Hämmerle trägt nie die Pullover, die die Hämmerle ihm strickt."
                            },
                            {
                                "example_id": "e895d01b-cc1e-4167-83ed-b41de1c8a79b",
                                "sense_id": "0bc0c58e-b2d3-34ca-b7c3-f6dd75ff58bd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hämmerle kommt, geht der Herr Hämmerle.“"
                            },
                            {
                                "example_id": "e1abf9bc-3c1a-47aa-a896-edfdaf9e90af",
                                "sense_id": "0bc0c58e-b2d3-34ca-b7c3-f6dd75ff58bd",
                                "text": "Hämmerle kommt und geht."
                            },
                            {
                                "example_id": "788ac478-eb49-439a-90e5-308a74e23574",
                                "sense_id": "0bc0c58e-b2d3-34ca-b7c3-f6dd75ff58bd",
                                "text": "Hämmerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
