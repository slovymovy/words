                        }
                    ]
                },
                {
                    "sense_id": "91a5136e-b3f5-3435-9886-a6fad5775c15",
                    "sense_definition": "In cellular automata, a pattern of cells that destroys incoming patterns without permanently changing itself.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cellular_automata",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Conway's Game of Life, the mathematician placed an <w>eater</w> to absorb gliders."
                        },
                        {
                            "text": "The simulation stopped growing because the <w>eater</w> consumed every new pattern produced."
                        }
                    ]
                }
            ]
