                {
                    "sense_id": "8092d2f8-4dd4-35fe-b800-9df1e98a4dee",
                    "sense_definition": "That has been bitten and ground with teeth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not stick your <w>chewed</w> gum under the table.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не приклеивай свою <w>жёваную</w> жвачку под стол.",
                                "de": "Bitte klebe deinen <w>gekauten</w> Kaugummi nicht unter den Tisch."
                            }
                        },
                        {
                            "text": "The teacher noticed a <w>chewed</w> pencil on the student's desk.",
                            "target_lang_translations": {
                                "ru": "Учитель заметил <w>погрызенный</w> карандаш на парте ученика.",
                                "de": "Der Lehrer bemerkte einen <w>angekauten</w> Bleistift auf dem Tisch des Schülers."
                            }
                        }
