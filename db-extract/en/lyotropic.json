                        ],
                        "examples": [
                            {
                                "example_id": "6d058052-770a-4fa7-b92b-26cde5b5b444",
                                "sense_id": "b67ee4d5-63c3-3c04-85b1-a608e9458074",
                                "text": "“We can however say that, with electrolytes, the effects are always lyotropic. Sulphates, tartrates, etc., raise the point of solidification, decrease the period of solidification, and increase the rate of change of the viscosity with the time. They therefore help the solidification.”"
                            },
                            {
                                "example_id": "df8adbbe-3f44-4417-8ef7-4c1bd75413e5",
                                "sense_id": "b67ee4d5-63c3-3c04-85b1-a608e9458074",
                                "text": "It is interesting to note that sulphates head one of Freundlich’s lyotropic series; but I fear that this is merely a coincidence."
                            }
                        ]
                    }
