                        "glosses": [
                            "Nom usuel des diverses plantes européennes du genre Lampsana, de la famille des Asteraceae en particulier Lampsana communis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0776631a-ac43-4711-87f2-4e12e33f6340",
                                "sense_id": "cd5aa066-4612-3506-954e-0c03d6a4ab7c",
                                "text": "Suivant les régions, elle peut s’appeler poules grasses ou encore gravelines."
                            },
                            {
                                "example_id": "cb03435e-ff70-44ed-ace5-407197486a94",
                                "sense_id": "cd5aa066-4612-3506-954e-0c03d6a4ab7c",
                                "text": "La lampsane est une plante herbacée annuelle qui apparaît sous la forme d’une rosette de feuilles à bords dentés, munies d’un lobe terminal élargi que précèdent deux petites « oreillettes »."
                            }
                        ]
