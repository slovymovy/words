                                "target_senses": [
                                    {
                                        "sense_id": "f91f6821-79e0-3a64-ae3f-56271ae985e4",
                                        "entry_id": "7131ea3d-7d2b-3b22-952c-6b9305e8fcbd",
                                        "glosses": [
                                            "Action ou manière de frire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5df462a7-19ea-4bf3-9af2-44318942f1f7",
                                                "sense_id": "f91f6821-79e0-3a64-ae3f-56271ae985e4",
                                                "text": "Friture à l’huile."
                                            },
                                            {
                                                "example_id": "6eeabb98-949e-4bef-ad10-672bb0247898",
                                                "sense_id": "f91f6821-79e0-3a64-ae3f-56271ae985e4",
                                                "text": "Friture au beurre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "179f757b-f205-32c9-b4a5-91377b74e12b",
                                        "entry_id": "7131ea3d-7d2b-3b22-952c-6b9305e8fcbd",
                                        "glosses": [
                                            "Beurre, huile, saindoux ou graisse qui sert à frire, et qu’on garde ensuite pour le même usage."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b50fe384-01f3-4fe3-8565-ac3f9ce4176d",
                                                "sense_id": "179f757b-f205-32c9-b4a5-91377b74e12b",
                                                "text": "Acheter de la friture."
                                            },
                                            {
                                                "example_id": "32be708e-cbbb-4eca-8aa8-19bd2ba5bfd1",
                                                "sense_id": "179f757b-f205-32c9-b4a5-91377b74e12b",
                                                "text": "De la friture trop vieille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc4b44c8-b426-32b1-9d57-c71a26b1c668",
                                        "entry_id": "7131ea3d-7d2b-3b22-952c-6b9305e8fcbd",
                                        "glosses": [
                                            "Mets que l’on fait frire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d33f1d70-9e2c-4056-8f94-4c6d09ed9247",
                                                "sense_id": "cc4b44c8-b426-32b1-9d57-c71a26b1c668",
                                                "text": "Quoi ! Sans même tâter de cette friture de goujons de Seine qui est la renommée de cette auberge !"
                                            },
                                            {
                                                "example_id": "ffcc0c31-fcfe-4b7a-806c-310c7dd49de8",
                                                "sense_id": "cc4b44c8-b426-32b1-9d57-c71a26b1c668",
                                                "text": "C’étaient des restes de bœuf bouilli achetés chez un rôtisseur tant soit peu regrattier, et fricassés au beurre avec des oignons coupés en tranches minces, jusqu’à ce que le beurre fût absorbé par la viande et par les oignons, de manière que ce mets de portier présentât l’aspect d’une friture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53307884-d5e3-31a3-84df-30ec7d794dad",
                                        "entry_id": "7131ea3d-7d2b-3b22-952c-6b9305e8fcbd",
                                        "glosses": [
                                            "Poisson frit."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57cc6d72-0cc9-4543-bfda-ff912b4505ff",
                                                "sense_id": "53307884-d5e3-31a3-84df-30ec7d794dad",
                                                "text": "« Une friture de Seine, un lapin sauté, une salade et du dessert », articula Mme Dufour, d’un air important."
                                            },
                                            {
                                                "example_id": "a96af694-3fe8-480c-a4f4-933a6e8acea5",
                                                "sense_id": "53307884-d5e3-31a3-84df-30ec7d794dad",
                                                "text": "Il en résulta qu’avant de se mettre en selle, le chevalier s’attabla dans la grande salle déserte du rez-de-chaussée, et se mit à déjeuner de friture qu’il arrosa de saumur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d766f57-bd40-3195-8e4b-c0cff8268be0",
                                        "entry_id": "7131ea3d-7d2b-3b22-952c-6b9305e8fcbd",
                                        "glosses": [
                                            "Confiserie au chocolat en forme de petit poisson."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d2b0c2a-2273-3dfc-b0ba-ca356488fcc4",
                                        "entry_id": "7131ea3d-7d2b-3b22-952c-6b9305e8fcbd",
                                        "glosses": [
                                            "Grésillement importun qu’on entend dans un appareil de télécommunication, provenant d'une défectuosité dans la communication."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
