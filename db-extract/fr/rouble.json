                                        "entry_id": "7fc22e37-eb4f-3e5a-a2e1-8e0d1a88c5f5",
                                        "glosses": [
                                            "Alternative spelling of ruble."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cd2c36e-c526-4ee8-af1f-1e888ceeda80",
                                                "sense_id": "70f66415-0ca8-3714-a4be-181448a80bca",
                                                "text": "The amount of work required to earn 26 roubles 40 kopeyki was one and a half times more than the physical possibilities of a healthy workman would allow in one day."
                                            },
                                            {
                                                "example_id": "75c6428e-10cb-4248-ae0f-a2484524c212",
                                                "sense_id": "70f66415-0ca8-3714-a4be-181448a80bca",
                                                "text": "With Capital requirements increasing, the number of Commercial Banks is rapidly decreasing. The manta (AZM) of 100 gyapiks replaced the rouble in January, 1994."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
