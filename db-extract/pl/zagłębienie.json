                                "target_senses": [
                                    {
                                        "sense_id": "44072333-227c-334b-ad40-7ec74f88183f",
                                        "entry_id": "cc6085a0-a82d-35d5-be60-bd59618c2795",
                                        "glosses": [
                                            "A small valley between mountains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4befdff2-be40-4390-835f-3d3009680693",
                                                "sense_id": "44072333-227c-334b-ad40-7ec74f88183f",
                                                "text": "He built himself a cabin in a hollow high up in the Rockies."
                                            },
                                            {
                                                "example_id": "472325f1-c04a-4bfc-89eb-4e7449fca11a",
                                                "sense_id": "44072333-227c-334b-ad40-7ec74f88183f",
                                                "text": "c. 1710–20, Matthew Prior, The First Hymn Of Callimachus: To Jupiter\nForests grew upon the barren hollows."
                                            },
                                            {
                                                "example_id": "451f10c9-5c99-4dd4-99b2-bda1a4b275c3",
                                                "sense_id": "44072333-227c-334b-ad40-7ec74f88183f",
                                                "text": "This road leads through a sandy hollow shaded by trees for about a quarter of a mile, where it crosses the bridge famous in goblin story, and just beyond swells the green knoll on which stands the whitewashed church."
                                            },
                                            {
                                                "example_id": "b2908f0a-8c26-4aaa-bf66-9156c2e57c2d",
                                                "sense_id": "44072333-227c-334b-ad40-7ec74f88183f",
                                                "text": "I hate the dreadful hollow behind the little wood, / Its lips in the field above are dabbled with blood-red heath, / The red-ribb'd hedges drip with a silent horror of blood, / And Echo there, whatever is ask'd her, answers 'Death.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc6c29a2-9f4b-3b59-9ec4-ea010687ad75",
                                        "entry_id": "cc6085a0-a82d-35d5-be60-bd59618c2795",
                                        "glosses": [
                                            "A sunken area on a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af71aac-c771-475c-b478-762308bc37e3",
                                                "sense_id": "bc6c29a2-9f4b-3b59-9ec4-ea010687ad75",
                                                "text": "the hollow of the hand"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f67194c3-f691-32bb-9c70-de648bb2ce1d",
                                        "entry_id": "cc6085a0-a82d-35d5-be60-bd59618c2795",
                                        "glosses": [
                                            "An unfilled space in something solid; a cavity, natural or artificial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39ca0524-66e1-4eb2-a8f2-8406a0ab799b",
                                                "sense_id": "f67194c3-f691-32bb-9c70-de648bb2ce1d",
                                                "text": "a hollow in a tree trunk"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f59c1a88-db39-3519-a9bd-0fe4c4d98ac3",
                                        "entry_id": "cc6085a0-a82d-35d5-be60-bd59618c2795",
                                        "glosses": [
                                            "A feeling of emptiness."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
