                "senses": [
                    {
                        "sense_id": "a93bd468-3c1e-3ca3-b9c4-efbe236ba06a",
                        "entry_id": "542b1508-ac3d-3c9e-8df2-fc216c086e03",
                        "glosses": [
                            "der Abstieg in die Hölle, das Reich des Teufels oder des Todes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "691486a3-6757-4856-b228-44a0cd5f2817",
                                "sense_id": "a93bd468-3c1e-3ca3-b9c4-efbe236ba06a",
                                "text": "Die Höllenfahrt Jesu Christi nach seinem irdischen Sterben wurde zu einem wichtigen Thema der Ikonographie."
                            },
                            {
                                "example_id": "7444f36a-4326-4d3c-9b47-70ca84345f99",
                                "sense_id": "a93bd468-3c1e-3ca3-b9c4-efbe236ba06a",
                                "text": "„Dabei erscheint Don Juan fast durchweg als zwar erfolgreicher, aber unsteter und frevelhafter Lebemann, der mit der Höllenfahrt die konsequente und angemessene Strafe erfährt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "de69c582-43ad-3975-92cd-e49131b2cbf1",
                        "entry_id": "542b1508-ac3d-3c9e-8df2-fc216c086e03",
                        "glosses": [
                            "eine schreckliche Reise"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "509ab303-8561-41bb-abc9-afacf0495b19",
                                "sense_id": "de69c582-43ad-3975-92cd-e49131b2cbf1",
                                "text": "Die Achterbahnfart, zu der mich meine Tochter überredet hat, war für mich die reinste Höllenfahrt."
                            },
                            {
                                "example_id": "d2b28991-d154-412e-92ce-4a42d3a00ffe",
                                "sense_id": "de69c582-43ad-3975-92cd-e49131b2cbf1",
                                "text": "„Zwei Frauen und sechs Männer überlebten die Höllenfahrt nicht.“"
                            },
                            {
                                "example_id": "96e5d8cb-9db1-42d9-aeb3-b978888466bd",
                                "sense_id": "de69c582-43ad-3975-92cd-e49131b2cbf1",
                                "text": "„Doch während dieser Höllenfahrt mit den Sanitätern war plötzlich meine Tochter zur Organisatorin meiner Rettung geworden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40537d7f-db54-43a2-9ca0-8567c97941ad",
                        "source_entry_id": "542b1508-ac3d-3c9e-8df2-fc216c086e03",
                        "source_sense_id": "a93bd468-3c1e-3ca3-b9c4-efbe236ba06a",
                        "source_sense_description": "Religion, Mythologie: der Abstieg in die Hölle, das Reich des Teufels oder des Todes",
                        "target_lang_word": "harrowing of hell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harrowing of hell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97c797b4-485c-3fa7-a211-3eb34a7d1eb9",
                                        "entry_id": "0edf26ba-3b29-31ab-9aaf-5778c3d38141",
                                        "glosses": [
                                            "A raid into the underworld by a heroic figure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75a8884-0167-4656-9318-71096723cca3",
                                                "sense_id": "97c797b4-485c-3fa7-a211-3eb34a7d1eb9",
                                                "text": "Not the direct vision of the harrowings of hell as reported, for example, by many Christian visionaries, but accounts given by the departed souls themselves are more frequent and typical features of Jewish moralist writing."
                                            },
                                            {
                                                "example_id": "00723d1d-94f3-4664-b08a-88d554b85b34",
                                                "sense_id": "97c797b4-485c-3fa7-a211-3eb34a7d1eb9",
                                                "text": "Of the four harrowings of hell that are cornerstones of Western literature […], we can eliminate the oldest."
                                            },
                                            {
                                                "example_id": "d53e6303-e4de-43a0-bddb-5241b3cb50e6",
                                                "sense_id": "97c797b4-485c-3fa7-a211-3eb34a7d1eb9",
                                                "text": "[…] the Hero Twins go on to defeat Xibalba and its ghastly denizens, a true Harrowing of Hell."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06330dba-109d-4e3d-8341-c1c95ee785c2",
                        "source_entry_id": "542b1508-ac3d-3c9e-8df2-fc216c086e03",
                        "source_sense_id": "a93bd468-3c1e-3ca3-b9c4-efbe236ba06a",
                        "source_sense_description": "Religion, Mythologie: der Abstieg in die Hölle, das Reich des Teufels oder des Todes",
                        "target_lang_word": "descent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "descent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fbb2155-a792-3129-a4a4-40e9b9a789b9",
                                        "entry_id": "5ed03f30-c12c-3ce0-8e21-73b2e00c1f7a",
                                        "glosses": [
                                            "An instance of descending; act of coming down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b4cc0a-6cab-4545-a191-9a387ff1739b",
                                                "sense_id": "5fbb2155-a792-3129-a4a4-40e9b9a789b9",
                                                "text": "We climbed the mountain with difficulty, but the descent was easier."
                                            },
                                            {
                                                "example_id": "6c80635c-41d9-4f08-aed2-d6fc2b6e1b70",
                                                "sense_id": "5fbb2155-a792-3129-a4a4-40e9b9a789b9",
                                                "text": "The descent continues, still more steeply to Dundee (Tay Bridge), and approaching from the bridge itself this sharp descent gives the curious appearance that the station is below the level of the firth."
                                            },
                                            {
                                                "example_id": "6a90f9ca-4480-4fad-9ad5-c117f33598e8",
                                                "sense_id": "5fbb2155-a792-3129-a4a4-40e9b9a789b9",
                                                "text": "To the north the towering scree-strewn slopes of Saddleback begin to draw nearer as we start the abrupt descent towards Keswick."
                                            },
                                            {
                                                "example_id": "91491b62-2b7c-4f91-bed8-74454de909c4",
                                                "sense_id": "5fbb2155-a792-3129-a4a4-40e9b9a789b9",
                                                "text": "The next one surrendered his bike, only for that, too, to give him a second flat as he started the descent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4d2a925-c435-3652-9c61-b7797beb993f",
                                        "entry_id": "5ed03f30-c12c-3ce0-8e21-73b2e00c1f7a",
                                        "glosses": [
                                            "A way down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19dfc6a4-7ff5-4312-b995-84ed762e136d",
                                                "sense_id": "a4d2a925-c435-3652-9c61-b7797beb993f",
                                                "text": "We had difficulty in finding the correct descent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84d1eeb8-4b2e-3769-b94a-43670236bb96",
                                        "entry_id": "5ed03f30-c12c-3ce0-8e21-73b2e00c1f7a",
                                        "glosses": [
                                            "A sloping passage or incline."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1f3252e-be02-45d3-8a79-ae0f0a637e02",
                                                "sense_id": "84d1eeb8-4b2e-3769-b94a-43670236bb96",
                                                "text": "The descent into the cavern was wet and slippery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c27906a-3745-3fe8-a8ce-b72308be3131",
                                        "entry_id": "5ed03f30-c12c-3ce0-8e21-73b2e00c1f7a",
                                        "glosses": [
                                            "Lineage or hereditary derivation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7459909-1cae-4095-82fe-69a96a0a753f",
                                                "sense_id": "3c27906a-3745-3fe8-a8ce-b72308be3131",
                                                "text": "Our guide was of Welsh descent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b629242b-5d9c-3e36-9090-b6051c0eb1c8",
                                        "entry_id": "5ed03f30-c12c-3ce0-8e21-73b2e00c1f7a",
                                        "glosses": [
                                            "A drop to a lower status or condition; decline."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11bb423d-8e30-4b23-bdfe-b41a6c2e7b39",
                                                "sense_id": "b629242b-5d9c-3e36-9090-b6051c0eb1c8",
                                                "text": "After that, the holiday went into a steep descent."
                                            }
                                        ]
