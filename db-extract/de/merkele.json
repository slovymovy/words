                ],
                "senses": [
                    {
                        "sense_id": "4e1d5c15-2fe8-3902-9388-1fb8a06f5dbf",
                        "entry_id": "98c45cf3-3b3b-316c-b987-65ec20509d99",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40053b19-cbff-44a8-8f7b-cf5ac439f238",
                                "sense_id": "4e1d5c15-2fe8-3902-9388-1fb8a06f5dbf",
                                "text": "Frau Merkele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9b8b5053-cd0b-4a16-94ee-66297dd0c9a7",
                                "sense_id": "4e1d5c15-2fe8-3902-9388-1fb8a06f5dbf",
                                "text": "Herr Merkele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a8bfc3a8-f168-4078-b21f-a8de10802cc6",
                                "sense_id": "4e1d5c15-2fe8-3902-9388-1fb8a06f5dbf",
                                "text": "Die Merkeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7a9a1485-cc82-440e-8b8b-89a81bd27bc7",
                                "sense_id": "4e1d5c15-2fe8-3902-9388-1fb8a06f5dbf",
                                "text": "Der Merkele trägt nie die Schals, die die Merkele ihm strickt."
                            },
                            {
                                "example_id": "13067565-2f04-4d38-ba45-0e05fe9031bb",
                                "sense_id": "4e1d5c15-2fe8-3902-9388-1fb8a06f5dbf",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Merkele kommt, geht der Herr Merkele.“"
                            },
                            {
                                "example_id": "2f93ff89-3b68-4003-9c64-eb9b1e925ae2",
                                "sense_id": "4e1d5c15-2fe8-3902-9388-1fb8a06f5dbf",
                                "text": "Merkele kommt und geht."
                            },
                            {
                                "example_id": "555f092b-e46b-438f-b4e8-9fee3e3a4093",
                                "sense_id": "4e1d5c15-2fe8-3902-9388-1fb8a06f5dbf",
                                "text": "Merkeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
