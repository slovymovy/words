                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diplomat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbd605be-d913-300e-aa4a-a48306892bb0",
                                        "entry_id": "30eb1d59-9315-3027-9f1e-9bce159bcf34",
                                        "glosses": [
                                            "A person, such as an ambassador, who is accredited to represent a government officially in its relations with other governments or international organisations"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdca34ee-1f0e-4438-b4dc-b5700b4d679a",
                                                "sense_id": "bbd605be-d913-300e-aa4a-a48306892bb0",
                                                "text": "The French diplomat negotiated the peace treaty."
                                            },
                                            {
                                                "example_id": "76b8a8e1-ea74-4d4b-9452-b547167a9d1a",
                                                "sense_id": "bbd605be-d913-300e-aa4a-a48306892bb0",
                                                "text": "A career as a diplomat requires cultural awareness and patience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "812211db-f7b4-3c72-8377-05716c31d8b1",
                                        "entry_id": "30eb1d59-9315-3027-9f1e-9bce159bcf34",
                                        "glosses": [
                                            "Someone who uses skill and tact in dealing with other people."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3245b1fa-5000-48c4-a20b-faa745b5563e",
                        "source_entry_id": "2cf7c071-cb91-3a33-ad0a-545679e8261f",
                        "source_sense_id": "8a609d44-59ee-3e88-8d1f-937d4cadf53b",
