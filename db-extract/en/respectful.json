                                            {
                                                "example_id": "63f38cda-168c-43d2-92bd-325a422f462d",
                                                "sense_id": "38c1e01d-b4b1-3947-9388-955127626ea5",
                                                "text": "De leraar was altijd zeer respectvol, ook naar de minder presterende leerlingen."
                                            },
                                            {
                                                "example_id": "5e7f4980-c257-4425-9bbb-fef0a718e9ab",
                                                "sense_id": "38c1e01d-b4b1-3947-9388-955127626ea5",
                                                "text": "Wandelend door de vele kleine bergdorpjes langs de trail heb ik het Amerikaanse volk leren kennen als vriendelijk, respectvol en opvallend gastvrij."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee217b0b-7fa3-4a01-8d45-afbe79530cfe",
                        "source_entry_id": "7ca7a165-647f-3bf4-8d55-19e6fa56757d",
                        "source_sense_id": "71aa3ba7-822e-394d-a9d1-7b8f091b77ea",
                        "source_sense_description": "characterized by respect",
                        "target_lang_word": "respectueux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respectueux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ed64e53-be19-322e-8061-c92566d45f99",
                                        "entry_id": "fecd8ed7-7e2d-36dd-bf01-01e9598ac566",
                                        "glosses": [
                                            "Qui témoigne du respect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a378e12-081a-40cc-8936-dbc14051eb12",
                                                "sense_id": "0ed64e53-be19-322e-8061-c92566d45f99",
                                                "text": "Le vent respectueux, parmi leurs tresses sombres,\nSur leur nuque de marbre errait en frémissant,\nTandis que les parois des rocs couleur de sang,\nComme de grands miroirs suspendus dans les ombres,\nDe la pourpre du soir baignaient leur dos puissant."
                                            },
                                            {
                                                "example_id": "8040e8a9-3633-4161-a090-da46e4a30adf",
                                                "sense_id": "0ed64e53-be19-322e-8061-c92566d45f99",
                                                "text": "Sous la IIIᵉ république, les techniques d’élevage fabriquent en série de petits robots, respectueux des autorités, sexuellement refoulés, bon soldats, excellents travailleurs, anxieux, très portés au suicide. Mais les Français ont alors le droit compensatoire de faire des plaisanteries « gauloises » alors que les Allemands acceptent officiellement leur puritanisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b06d90-06e8-38a1-a203-642231f3bd1c",
                                        "entry_id": "fecd8ed7-7e2d-36dd-bf01-01e9598ac566",
                                        "glosses": [
                                            "Qui marque du respect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d7ba2d-6354-4e4b-bfe0-0acd33f9ccf5",
                                                "sense_id": "69b06d90-06e8-38a1-a203-642231f3bd1c",
                                                "text": "Je craignais que vous ne vinssiez jamais, répondit Popinot d’un air respectueux."
                                            },
                                            {
                                                "example_id": "2427cb51-5b68-457c-a899-44f43652479f",
                                                "sense_id": "69b06d90-06e8-38a1-a203-642231f3bd1c",
                                                "text": "Puis il se releva, croisa les bras sur sa poitrine, et, avec une contenance plutôt respectueuse que craintive, il attendit la réponse de son roi, comme un homme qui sent qu’il peut avoir commis une faute, mais qui se repose sur la droiture de son intention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7ef91a6-411c-4e80-a49f-acf1266ffc87",
                        "source_entry_id": "7ca7a165-647f-3bf4-8d55-19e6fa56757d",
