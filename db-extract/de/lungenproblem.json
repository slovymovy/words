                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lungenprobleme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36ac63f0-bb90-306b-b45d-938a83b9d7af",
                        "entry_id": "4643376e-8605-36dc-b514-901f72abb4fa",
                        "glosses": [
                            "Beeinträchtigung des körperlichen Wohlergehens oder der körperlichen Leistungskraft durch Schädigung am Atmungsorgan (der Lunge)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcad35bb-9b0c-4efc-a581-200a724fc1cc",
                                "sense_id": "36ac63f0-bb90-306b-b45d-938a83b9d7af",
                                "text": "„Den 19-Jährigen, der am ersten Spieltag der Königsklasse gegen Genk mit einem Triplepack glänzte und nach zehn Saisonspielen bei 17 Treffern hält, plagt laut seinem Coach Jesse Marsch ein \"kleines Lungenproblem\".“"
                            },
                            {
                                "example_id": "d6125f23-a779-4141-b689-5e6231a70736",
                                "sense_id": "36ac63f0-bb90-306b-b45d-938a83b9d7af",
                                "text": "„Reizhusten und Atemnot bei Belastung weisen auf ein Lungenproblem hin, das durch eine Lungenfunktionsprüfung und ein hochauflösendes CT (HR-CT) abgeklärt werden muss.“"
                            },
                            {
                                "example_id": "66982f1e-34e2-4c87-bf5e-6bc473ff2ae6",
                                "sense_id": "36ac63f0-bb90-306b-b45d-938a83b9d7af",
                                "text": "„Die meisten Covid-19-Patienten werden in Deutschland, laut Statistik, wieder gesund. Trotzdem haben manche mit Lungenproblemen zu kämpfen – sogar nachdem das Virus wieder verschwunden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
