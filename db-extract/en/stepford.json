                "senses": [
                    {
                        "sense_id": "c9bbf503-8212-3cb9-8fa7-555999221744",
                        "entry_id": "c7f800b5-074b-323f-9c77-d56763caefa6",
                        "glosses": [
                            "Docile, unthinking and conformist."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3e79efc0-9dcc-4499-90d4-465e3d7107c8",
                                "sense_id": "c9bbf503-8212-3cb9-8fa7-555999221744",
                                "text": "“He called you a boring Stepford wife.”\nA boring Stepford wife, Molly thought. For a moment it seemed to her that she was once more in prison, eating the tasteless food, hearing the click of locks, lying awake for sleepless night after sleepless night."
                            },
                            {
                                "example_id": "8dee2bdb-5445-44e2-b473-1e35687a2ea3",
                                "sense_id": "c9bbf503-8212-3cb9-8fa7-555999221744",
                                "text": "So, when in a dorky Christmas town with Stepford people and themed shops, do as they do. Smile and act like you gave two shits about the person next to you."
                            },
                            {
                                "example_id": "dbcce1b5-05d3-4b0a-b336-820bb4c7bb6a",
                                "sense_id": "c9bbf503-8212-3cb9-8fa7-555999221744",
                                "text": "Were the Nazis trying to infiltrate the U.S. Navy with an army of gonorrhea-infected Stepford clones?"
                            }
                        ]
                    },
                    {
                        "sense_id": "6b90fdcf-fcba-3dff-b8d3-c324261b42b6",
                        "entry_id": "c7f800b5-074b-323f-9c77-d56763caefa6",
                        "glosses": [
                            "Attractive but lacking any character."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "37cffe2e-8d40-4d9a-ab97-6bd182f76140",
                                "sense_id": "6b90fdcf-fcba-3dff-b8d3-c324261b42b6",
                                "text": "The woman seated behind the table looked up at him, smiling a Stepford smile. \"Would you like to buy a chance to win a new Blazer? It's only five dollars.\" Rich shook his head, moved away from the table. \"Not today.\""
                            }
                        ]
                    }
