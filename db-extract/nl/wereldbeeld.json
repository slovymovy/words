                "senses": [
                    {
                        "sense_id": "6690109b-1d52-3b97-aafe-7a63f7170b83",
                        "entry_id": "65a73359-5a48-3712-9af9-15f80014aff8",
                        "glosses": [
                            "voorstelling die men heeft omtrent de werkelijke wereld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0956f639-bbf4-4d53-9b0c-9be14ebc96fa",
                                "sense_id": "6690109b-1d52-3b97-aafe-7a63f7170b83",
                                "text": "De meeste theologen en Bijbelonderzoekers stellen dat de schrijvers van de Bijbel een Babylonisch wereldbeeld hadden waarin de Aarde plat is en op een soort van pilaren staat"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22ed801a-87e4-4710-a0a4-64beba47793b",
                        "source_entry_id": "65a73359-5a48-3712-9af9-15f80014aff8",
                        "source_sense_id": "6690109b-1d52-3b97-aafe-7a63f7170b83",
                        "target_lang_word": "Weltanschauung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weltanschauung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37516618-93e6-3912-b577-a98e891df76e",
                                        "entry_id": "c75c583d-58c8-3d97-a403-db9626e3135c",
                                        "glosses": [
                                            "System der Vorstellungen, die jemand sich von der Welt gemacht hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4309dc8b-a465-4a4f-b979-58623adabfcb",
                                                "sense_id": "37516618-93e6-3912-b577-a98e891df76e",
                                                "text": "Es gibt mehrere unterschiedliche Weltanschauungen."
                                            },
                                            {
                                                "example_id": "b18132a7-cb96-47ef-bfcc-c9e786a7e73d",
                                                "sense_id": "37516618-93e6-3912-b577-a98e891df76e",
                                                "text": "Unsere Ausführungen über die mittelalterliche Weltanschauung haben manche Kritiker überrascht."
                                            },
                                            {
                                                "example_id": "a378deb2-d962-4b03-87f4-4112df26ab77",
                                                "sense_id": "37516618-93e6-3912-b577-a98e891df76e",
                                                "text": "„Eine Weltanschauung gibt es eben nicht, weil es viele gibt und alle weder falsch noch wahr sind.“"
                                            },
                                            {
                                                "example_id": "5be950a5-13c2-4136-a2d7-e40048544544",
                                                "sense_id": "37516618-93e6-3912-b577-a98e891df76e",
                                                "text": "„Den Religionsgesellschaften werden die Vereinigungen gleichgestellt, die sich die gemeinschaftliche Pflege einer Weltanschauung zur Aufgabe machen.“"
                                            },
                                            {
                                                "example_id": "51c81a46-631e-479a-9fcd-50a6327e2c8e",
                                                "sense_id": "37516618-93e6-3912-b577-a98e891df76e",
                                                "text": "„Doch anscheinend ist die Umweltbewegung mehr eine Weltanschauung als eine Bewegung zur Lösung anstehender Probleme.“"
                                            },
                                            {
                                                "example_id": "2b53a13c-8f07-47d4-8140-b2be67862f08",
                                                "sense_id": "37516618-93e6-3912-b577-a98e891df76e",
                                                "text": "„Wieland stellt die Weltanschaung des Hippias geschickt zusammen aus dem, was die Überlieferung der Antike in dieser Hinsicht bereitstellt, und dem, was ihm seine philosophische Gegenwart unter den allzu plakativen Stichworten »Materialismus«, »Sensualismus« etc. bietet, sei es französischen (Helvetius, Voltaire), sei es englischen (Hobbes, Locke, Hume) Herkommens.“"
                                            },
                                            {
                                                "example_id": "cb8461d0-dcd0-49b9-bf02-4207f8c2fe12",
                                                "sense_id": "37516618-93e6-3912-b577-a98e891df76e",
                                                "text": "„Jeder hat das Recht auf Gedanken-, Gewissens- und Religionsfreiheit; dieses Recht schließt die Freiheit ein, seine Religion oder seine Weltanschauung zu wechseln, sowie die Freiheit, seine Religion oder seine Weltanschauung allein oder in Gemeinschaft mit anderen, öffentlich oder privat durch Lehre, Ausübung, Gottesdienst und Kulthandlungen zu bekennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
