                "senses": [
                    {
                        "sense_id": "22975f36-d493-31a6-a60d-00cdf1a0020b",
                        "entry_id": "406fff44-fcd7-36b2-bb5e-6064153ccded",
                        "glosses": [
                            "Structure algébrique consistant en un ensemble muni d’une loi de composition interne associative admettant un élément neutre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6def794-d5d9-41e8-a428-76138994c554",
                                "sense_id": "22975f36-d493-31a6-a60d-00cdf1a0020b",
                                "text": "L’ensemble des entiers naturels muni de l’addition (ℕ,+,0) est un monoïde."
                            },
                            {
                                "example_id": "9d1e7b1e-bc72-4327-8532-66742e642510",
                                "sense_id": "22975f36-d493-31a6-a60d-00cdf1a0020b",
                                "text": "Un monoïde engendré par un alphabet, c’est l'ensemble de tous les mots que l’on peut écrire en prenant plusieurs lettres de cet alphabet (avec éventuellement des répétitions)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca9a1a11-9faf-4f06-b254-e3cc1df115be",
                        "source_entry_id": "406fff44-fcd7-36b2-bb5e-6064153ccded",
                        "source_sense_id": "22975f36-d493-31a6-a60d-00cdf1a0020b",
                        "target_lang_word": "Monoid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
