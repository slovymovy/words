                {
                    "sense_id": "5877c816-6e8a-3b09-9080-cfc5452af757",
                    "sense_definition": "Réunir des éléments, des objets ou des personnes en un seul ensemble.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rassembler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a demandé aux élèves de <w>regrouper</w> les documents par thème."
                        },
                        {
                            "text": "Ce nouveau tableau permet de <w>regrouper</w> toutes les informations importantes au même endroit."
                        }
                    ],
                    "synonyms": [
                        "réunir"
                    ],
                    "antonyms": [
                        "disséminer",
                        "disperser"
                    ],
                    "common_phrases": [
