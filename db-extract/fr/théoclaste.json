                "senses": [
                    {
                        "sense_id": "3d8ec0c9-ea67-3b7a-8873-8bb6fda3a46d",
                        "entry_id": "c978fc6d-6575-3efc-9c62-066b0302cda8",
                        "glosses": [
                            "Relatif à la théoclastie, le refus de croire en d’autres dieux que les siens, ou la destruction volontaire de symboles religieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45be606d-fea6-46e4-bc04-19614f84e4d4",
                                "sense_id": "3d8ec0c9-ea67-3b7a-8873-8bb6fda3a46d",
                                "text": "Il me semble évident que ce texte parle des monothéistes iconoclastes/théoclastes, dont le succès final se faisait déjà sentir à l’époque où il a été composé."
                            },
                            {
                                "example_id": "5dde623b-797a-42fa-b96c-1cebdcaae01d",
                                "sense_id": "3d8ec0c9-ea67-3b7a-8873-8bb6fda3a46d",
                                "text": "Après la mort de ce pharaon en 1338 av. J.-C, toute trace de sa réforme théoclaste avait été méthodiquement effacée."
                            },
                            {
                                "example_id": "a8f43e5a-32ab-4111-a314-de3ed475e1c1",
                                "sense_id": "3d8ec0c9-ea67-3b7a-8873-8bb6fda3a46d",
                                "text": "Aménophis IV change son nom de règne en Akhenaton. Il se livre, dès lors, à une grande entreprise iconoclaste ou théoclaste qui vise à effacer toute trace d’Amon, mais aussi d’autres divinités."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9328f59a-bb88-3eeb-a0d9-c8db22649c4c",
                "word": "théoclaste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2b74606d-e84e-45d3-8a12-eebaafff982f",
                        "entry_id": "9328f59a-bb88-3eeb-a0d9-c8db22649c4c",
                        "tags": [
                            "plural"
