                "senses": [
                    {
                        "sense_id": "39019b67-cbc8-3615-b50d-f4607399ce7f",
                        "entry_id": "1e8e7d61-08f2-3dc7-9782-247b8b05fcf5",
                        "glosses": [
                            "Revêtir d’un jupon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9de5a949-ec91-389c-b6ef-106304373292",
                        "entry_id": "1e8e7d61-08f2-3dc7-9782-247b8b05fcf5",
                        "glosses": [
                            "Mettre sous la dépendance d’une femme."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4fae3f8f-9d67-4e1a-93a4-eeb116423902",
                                "sense_id": "9de5a949-ec91-389c-b6ef-106304373292",
                                "text": "Eh bien ! donc, enjuponnez le ministre, chère enfant, je vous y aiderai, c’est dans mon intérêt."
                            },
                            {
                                "example_id": "d1322b54-e5b5-43ff-a499-eaf3ae124d15",
                                "sense_id": "9de5a949-ec91-389c-b6ef-106304373292",
                                "text": "Une vieille moustache comme moi, s’enjuponner, s’acoquiner à une femme !… pourquoi l’emmener ? il faut la quitter."
                            },
                            {
                                "example_id": "21a14081-be90-433f-a722-d281e9f4c60a",
                                "sense_id": "9de5a949-ec91-389c-b6ef-106304373292",
                                "text": "Je rêve d´encore une amourette\nJe rêve d´encor m´enjuponner\nEncore une fois dire: \"Je t´aime\"."
                            }
                        ]
                    }
                ],
