                    {
                        "translation_id": "47247898-f065-4cae-885d-696c04e5870e",
                        "source_entry_id": "f3e17818-d7b8-3382-85bd-7c7a6ef0d3c7",
                        "source_sense_id": "5c5eaad2-87d5-3ea5-a06f-3a2d12e048c5",
