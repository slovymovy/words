                    {
                        "translation_id": "b858a775-798c-4ca8-be3a-e5b6272c2ecf",
                        "source_entry_id": "5d9ef5e6-2577-3892-ad8e-3ebb967283b8",
                        "target_lang_word": "Kommerzialisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommerzialisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "605bb287-abab-3fa8-a157-663f69b799fb",
                                        "entry_id": "61d879df-a43c-39d7-81a0-947b861d95a5",
                                        "glosses": [
                                            "Vorgang, bei dem aus (ideellen) Dingen mehr und mehr ein Geschäft gemacht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24794484-4111-4eb3-9728-2553643a336d",
                                                "sense_id": "605bb287-abab-3fa8-a157-663f69b799fb",
                                                "text": "Die Kommerzialisierung vieler Sportarten stößt auf Kritik."
                                            },
                                            {
                                                "example_id": "3231795f-979c-4695-84c9-d90d437c904f",
                                                "sense_id": "605bb287-abab-3fa8-a157-663f69b799fb",
                                                "text": "„Mit der zunehmenden Kommerzialisierung des Swing kam bei vielen Musikern in den USA das Gefühl auf, als Ensemblemitglied einer Bigband nicht mehr als ein Angestellter zu sein.“"
                                            },
                                            {
                                                "example_id": "e141b680-bc21-4366-a3f5-2a7d6506e5a2",
                                                "sense_id": "605bb287-abab-3fa8-a157-663f69b799fb",
                                                "text": "„Doch verzichtete die Regierung auf derartige Investitionen, möglicherweise um eine Kommerzialisierung der bäuerlichen Regionen zu verhindern.“"
                                            },
                                            {
                                                "example_id": "b0bafb0a-f799-47fa-ac4b-254cca6c5ffc",
                                                "sense_id": "605bb287-abab-3fa8-a157-663f69b799fb",
                                                "text": "„Bereits Konrad Adenauer kritisierte in seiner Weihnachtsansprache 1955 die Kommerzialisierung des Weihnachtsfests.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
