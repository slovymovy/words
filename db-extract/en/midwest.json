                        "sense_id": "a5eea624-a367-38db-8a6f-672b0f061f95",
                        "entry_id": "489ff8e4-ca42-3fc7-9a80-0f2acf7a64ae",
                        "glosses": [
                            "A town in Natrona County, Wyoming, United States."
